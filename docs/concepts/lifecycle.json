      "id": "private-consultation",
      "kind": "sequence",
      "title": "Private consultation, then an explicit decision",
      "description": "The app requests a private audience. Connect retains the organizer leg, prepares private context and media, and observes actual private duplex. The application separately obtains consent and chooses handoff or return under current authority. The media/role outcome must be observed.",
      "sources": [
        {
          "path": "contracts/connect-transitions.md",
          "heading": "Consultation"
        },
        {
          "path": "contracts/connect-transitions.md",
          "heading": "Participant handoff"
        },
