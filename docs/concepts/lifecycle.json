          "path": "contracts/connect-transitions.md",
          "heading": "Native authorized return"
        },
        {
          "path": "contracts/connect-audiences.md",
          "heading": "Media and consultation"
        },
        {
          "path": "contracts/connect-records.md",
          "heading": "Context delivery"
        }
      ],
      "actors": [
        "App / owner",
        "Connect",
        "Private owner + AI",
        "Organizer"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "session.consult \u00b7 original operation ID",
          "example": "consult"
        },
        {
          "from": 1,
          "to": 2,
          "label": "Prepare isolated leg + permitted context"
        },
        {
          "from": 1,
          "to": 3,
          "label": "Hold treatment only \u00b7 retain conn_organizer"
        },
        {
          "from": 2,
          "to": 1,
          "label": "Actual private duplex observed",
          "observation": true
        },
        {
          "from": 0,
          "to": 0,
          "label": "App consent + action-request gates"
        },
        {
          "from": 0,
          "to": 1,
          "label": "Choose handoff OR return; fresh authority",
          "alternatives": [
            "handoff",
            "return"
          ]
        },
        {
          "from": 1,
          "to": 0,
          "label": "Observe outcome, roles and retained IDs",
          "observation": true
        }
      ]
    },
    {
      "id": "failed-move",
      "kind": "sequence",
      "title": "An unconfirmed phone cannot take the route",
      "description": "The original owner and organizer route remains usable while a candidate is prepared. Wrong or missing configured confirmation cannot commit. A known no-commit outcome retires only the candidate; uncertain work stays unknown and is reconciled under the original operation ID.",
