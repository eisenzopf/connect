  "qualified_cases": [
    {
      "case_id": "u6-req-0091",
      "algorithms": [
        "EdDSA",
        "ES256"
      ],
      "tests": [
        "caller_cancellations::original_caller_cancellation_references_require_physical_scope_and_recover_with_logical_replay",
        "caller_cancellations::correlated_cancellation_step_up_keeps_the_owned_reference_and_replays_one_current_authorized_mutation"
      ],
      "profile": "Actual production local native QUIC/public signed Rust SDK caller reference commands and recipient cancellation observations, plus ordinary bearer HTTP logical replay and actual configured human-consent API/step-up.",
      "assertions": [
        "The public native helper sends a fresh signed operation-bearing session.cancel with in_reply_to naming its actual original caller invitation ID, explicit checked by Participant and original reason/CID/SID.",
        "A same-Identity/credential/Device sibling cannot adopt that reference. Wrong Session, spoofed by, superseded request IDs and old physical references after reconnect refuse before creating a mutation receipt.",
        "The caller replays its original logical invitation to register a new reference before ACK, then retries the same logical cancellation. Both pending cancellation and already committed cancellation recover once; ordinary HTTP logical replay returns the same immutable outcome.",
        "Unsigned HTTP cannot supply native reference custody. A verified recipient receives its own forwarded invitation correlation rather than the caller reference.",
        "After acceptance, a correctly correlated new cancellation conflicts at the current revision and requires session.end.",
        "A configured human-consent floor suspends the original correlated command without a receipt. Actual HTTP consent plus explicit successor key enrollment resumes the same held operation on the same physical peer, preserves reference ownership across credential rotation and records exactly one mutation; native and current HTTP replay retain that result."
      ]
    }
  ],
