  "task": "G6-046",
  "title": "Store-authorized native lifecycle and default quality delivery through the actual Connect listener and signed SDK",
  "recorded_at": "2026-10-22T01:51:12.538184+00:00",
  "status": "local-default-native-lifecycle-component-qualified",
  "full_task_complete": false,
  "full_goal_complete": false,
