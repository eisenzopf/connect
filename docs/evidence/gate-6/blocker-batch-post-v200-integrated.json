  "fixes": [
    {
      "id": "B61",
      "title": "Native programme output ownership",
      "change": "Create only the common media parent. The original native workload exclusively creates each cycle leaf.",
      "observed": "All native cycles stopped at EEXIST before AV. The three-cycle controller introduced the conflicting mkdir."
    },
    {
      "id": "B62",
      "title": "Three-cycle browser capture capacity",
      "change": "Scale the capture packet and byte limits by the declared cycle count while retaining completeness and privacy checks.",
      "observed": "The original capture stopped at its 200000-packet one-cycle limit during the three-cycle workload."
    },
    {
      "id": "B63",
      "title": "Local readiness timeout closes shared control",
      "change": "Retire the exact unsubmitted replacement target after local decoder timeout or cancellation while preserving the authenticated control client.",
      "observed": "Actual decoder deadline preceded whole-client closure and failed original Session refresh. Submitted or uncertain continuations retain their original handling."
    },
    {
      "id": "B64",
      "title": "Cross-host fixture lease queue and failure evidence",
      "change": "Use the explicit three-cycle preflight queue budget and preserve actual acquisition failure and process facts.",
      "observed": "The original wait lasted 1200.54 seconds. Five ARM guardians released during that interval. Historical Mac SSH metadata was discarded."
    },
    {
      "id": "B65",
      "title": "Owned three-cycle output transfer capacity",
      "change": "Bind the larger transfer limit to the exact original three-cycle job digest and output directory.",
      "observed": "Static range analysis found the one-cycle transfer bound could reject a permitted three-cycle capture. This was not an observed v200 failure."
    },
    {
      "id": "B66",
      "title": "Nested cross-host browser resource handshake",
      "change": "Exchange the actual cycles/cycle-N resource paths in both directions with fixed names, unchanged clocks and immutable responses.",
      "observed": "Six Mac remote browser cells timed out at the first nested baseline request. Their primary workload did not start."
    },
    {
      "id": "B67",
      "title": "Private delivery outcome attribution",
      "change": "Record fixed per-medium policy outcomes and actual native primary RTP attempts, acceptance and refusal.",
      "observed": "Sources continued producing keyframes while private return targets received sparse or zero video. These counters distinguish the remaining boundaries."
    },
    {
      "id": "B68",
      "title": "Terminal decoder readiness attribution",
      "change": "Emit one bounded scalar terminal observation from existing accepted output and current-identity observations.",
      "observed": "The old snapshots omitted the exact consecutive audio, keyframe, freshness and identity predicates at the deadline."
    },
    {
      "id": "B69",
      "title": "Shared packet observer contention attribution",
      "change": "Separate fixed slot claim phases from actual SQL intervals in the existing runtime retention observation.",
      "observed": "All six Mac WebRTC public receive paths stalled during preparation with repeated observer-slot refusals. No eight-second SQL retention was demonstrated."
    }
  ],
