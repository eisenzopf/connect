{
  "name": "@rudeless/connect",
  "version": "0.1.0",
  "description": "Connect SDK via native QUIC helper or local HTTP/JSON",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "npm run build && node --test ../tests/clients.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eisenzopf/connect.git",
    "directory": "sdk/typescript"
  },
  "dependencies": {
    "@types/node": "26.6.4"
  }
}
