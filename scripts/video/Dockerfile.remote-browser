# Extend only the recorded local ARM64 browser image; no hosted/x86 image pull.
ARG LOCAL_ARM_BROWSER_IMAGE
FROM ${LOCAL_ARM_BROWSER_IMAGE}
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libnss3-tools \
    && dpkg-query -W > /usr/local/share/connect-browser-packages.tsv \
    && rm -rf /var/lib/apt/lists/*
USER connect
