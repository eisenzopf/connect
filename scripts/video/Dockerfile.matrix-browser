# Locally built ARM fixture runtime. The browser executables stay pinned and
# independently verified; this adds the shared libraries needed by Firefox.
ARG LOCAL_ARM_BROWSER_IMAGE
FROM ${LOCAL_ARM_BROWSER_IMAGE}
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libgtk-3-0t64 libdbus-glib-1-2 libasound2t64 libx11-xcb1 libxt6t64 libegl1 \
    && dpkg-query -W > /usr/local/share/connect-matrix-browser-packages.tsv \
    && rm -rf /var/lib/apt/lists/*
USER connect
