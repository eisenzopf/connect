FROM mcr.microsoft.com/playwright@sha256:d65108d1a8095d8b0c4a5e32bf1807a40a5ce90ff0c78473e1116b1c243235e8
USER root
# Owned paced software audio only; no host sound device, profile or credentials.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       pulseaudio=1:16.1+dfsg1-2ubuntu10.1 iproute2=6.1.0-1ubuntu6.4 \
    && dpkg-query -W > /usr/local/share/connect-browser-packages.tsv \
    && rm -rf /var/lib/apt/lists/*
