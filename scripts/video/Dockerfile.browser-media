# Build on the owned local ARM VM using its recorded clean build-image digest.
ARG BUILD_BASE_IMAGE
FROM ${BUILD_BASE_IMAGE}
USER root
COPY package.json package-lock.json /opt/connect-browser-tools/
RUN cd /opt/connect-browser-tools \
    && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci --ignore-scripts --no-audit --no-fund \
    && node node_modules/playwright/cli.js install-deps chromium \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pulseaudio \
    && dpkg-query -W > /usr/local/share/connect-browser-packages.tsv \
    && rm -rf /var/lib/apt/lists/*
# Only the previously verified public ARM Chromium distribution enters the image.
# State, credentials, repository checkouts and Cargo caches are excluded.
COPY chromium-1248/ /ms-playwright/chromium-1248/
USER connect
