    "/v2/enrollments/{id}/claim": {
      "post": {
        "operationId": "claimEnrollment",
        "security": [],
        "description": "Host must match the configured HTTPS authority or concrete loopback listener/localhost:port. Query parameters, X-Call-ID, X-Chat-ID and Upgrade refuse. Closing HTTP/1.1 only; request body collection, Store work and physical response delivery share one five-second deadline. Cache-Control:no-store and Pragma:no-cache. An interrupted response can follow a commit: explicitly recover original intent; no automatic retry or renewal. Application surface only. No bearer is accepted, including operator, ordinary client or task credentials. Exact Origin comes only from the request header; browser Origin must also be allowed by this HTTPS listener and equal the approved serialized HTTPS Origin. QUIC claims require no Origin. Path id must equal body enrollment_id. Verify canonical64-byte raw Ed25519 or ES256(SHA256) signature over ASCII(connect-enrollment-proof/1)||NUL||SHA256(JCS(normalized full offer)); challenge alone grants nothing. Wrong bindings make no effects; five matching invalid signatures exhaust pending approval. Fresh valid claim atomically creates scoped credential, immutable Device/key binding and unverified Endpoint, or reuses the exact active Endpoint for rotation; late conflicts roll back. Completed signed recovery may outlive challenge expiry but rechecks current original issuer, child, key, Device, Endpoint, recipient ceilings and original receipt; it returns the same bearer and absolute expiry. Provider consent, route verification/reachability and media readiness are separate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentClaim"
              }
            }
