  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CredentialIssueOutcome": {
        "description": "Intended protected response only. Persist the original request before IO;\nexact replay never replaces the credential or extends its absolute expiry.",
        "type": "object",
        "properties": {
          "credential": {
            "type": "string"
          },
          "credential_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64"
          },
          "identity_id": {
            "type": "string"
          },
          "installation_id": {
            "type": "string"
          },
          "issued_at": {
            "type": "integer",
            "format": "int64"
          },
          "issuer_credential_id": {
            "type": "string"
          },
          "issuer_identity_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "operation_id",
          "credential_id",
          "identity_id",
          "issuer_identity_id",
          "issuer_credential_id",
          "installation_id",
          "operations",
          "recipients",
          "issued_at",
          "expires_at",
          "credential"
        ]
      },
      "DeviceSpec": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "platform"
        ]
      },
      "EnrollmentClaim": {
        "description": "Unauthenticated claim syntax. Binding checks are not signature verification.",
        "type": "object",
