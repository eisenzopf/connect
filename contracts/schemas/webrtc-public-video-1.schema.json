{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect.invalid/schemas/webrtc-public-video-1.schema.json",
  "title": "Original public video setup, phase and B-only readiness metadata",
  "description": "Wire/schema contract only; current original authorization and opaque Core/native owners remain mandatory. No HTTP native readiness or runtime/media qualification. Standard JSON Schema cannot enforce cross-field identity equality, ID distinctness or nonce/count relations; original typed runtime checks are required.",
  "oneOf": [
    {
      "$ref": "#/$defs/Intent"
    },
    {
      "$ref": "#/$defs/Phase"
    },
    {
      "$ref": "#/$defs/ReadyMarker"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "Opaque": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!-~]+$"
    },
    "PositiveCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Intent": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect/webrtc-public-video-reservation/1"
        },
        "phase": {
          "const": "intent"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "preview_stream_id": {
          "$ref": "#/$defs/Id"
        },
        "preview_role": {
          "const": "receive"
        },
        "public_stream_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "profile",
        "phase",
        "reservation_id",
        "nonce",
        "preview_stream_id",
        "preview_role",
        "public_stream_id"
      ],
      "additionalProperties": false,
      "description": "Original server-issued setup only. Runtime requires distinct frozen preview A/public B stream IDs and exact original mapping; no MID, cut, readiness or authority can be added."
    },
    "Binding": {
      "type": "object",
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/Id"
        },
        "preview_stream_id": {
          "$ref": "#/$defs/Id"
        },
        "mid": {
          "$ref": "#/$defs/Opaque"
        },
        "stream_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "physical_writer_incarnation": {
          "$ref": "#/$defs/Opaque"
        },
        "connection_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "primary_ssrc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "payload_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "clock_rate_hz": {
          "const": 90000
        },
        "codec": {
          "const": "vp8"
        }
      },
      "required": [
        "stream_id",
        "preview_stream_id",
        "mid",
        "stream_generation",
        "physical_writer_incarnation",
        "connection_generation",
        "primary_ssrc",
        "payload_type",
        "clock_rate_hz",
        "codec"
      ],
      "additionalProperties": false,
      "description": "Actual original B native tuple. SSRC zero is valid. Generations are independent namespaces; runtime matches distinct stream IDs/native pointers/current original owners, never infers identity from these data alone."
    },
    "Challenge": {
      "type": "object",
      "properties": {
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "decoder_startup": {
          "const": "fresh-receiver-first-decoded-frame"
        }
      },
      "required": [
        "nonce",
        "decoder_startup"
      ],
      "additionalProperties": false,
      "description": "Runtime requires public nonce distinct from both original Intent and private readiness nonces."
    },
    "NegotiatedNeverFed": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect/webrtc-public-video-phase/1"
        },
        "phase": {
          "const": "negotiated-never-fed"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_record_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "target_connection_id": {
          "$ref": "#/$defs/Id"
        },
        "target_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "profile",
        "phase",
        "reservation_id",
        "operation_record_id",
        "operation_id",
        "target_connection_id",
        "target_generation",
        "binding"
      ],
      "additionalProperties": false
    },
    "CutBoundPostF": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect/webrtc-public-video-phase/1"
        },
        "phase": {
          "const": "cut-bound-post-f"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_record_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "target_connection_id": {
          "$ref": "#/$defs/Id"
        },
        "target_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "source_cut_id": {
          "$ref": "#/$defs/Opaque"
        },
        "public_readiness": {
          "$ref": "#/$defs/Challenge"
        }
      },
      "required": [
        "profile",
        "phase",
        "reservation_id",
        "operation_record_id",
        "operation_id",
        "target_connection_id",
        "target_generation",
        "binding",
        "source_cut_id",
        "public_readiness"
      ],
      "additionalProperties": false
    },
    "DecodedReady": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect/webrtc-public-video-phase/1"
        },
        "phase": {
          "const": "decoded-ready"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_record_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "target_connection_id": {
          "$ref": "#/$defs/Id"
        },
        "target_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "source_cut_id": {
          "$ref": "#/$defs/Opaque"
        },
        "public_readiness": {
          "$ref": "#/$defs/Challenge"
        }
      },
      "required": [
        "profile",
        "phase",
        "reservation_id",
        "operation_record_id",
        "operation_id",
        "target_connection_id",
        "target_generation",
        "binding",
        "source_cut_id",
        "public_readiness"
      ],
      "additionalProperties": false
    },
    "Activated": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect/webrtc-public-video-phase/1"
        },
        "phase": {
          "const": "activated"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_record_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "target_connection_id": {
          "$ref": "#/$defs/Id"
        },
        "target_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "source_cut_id": {
          "$ref": "#/$defs/Opaque"
        },
        "public_readiness": {
          "$ref": "#/$defs/Challenge"
        }
      },
      "required": [
        "profile",
        "phase",
        "reservation_id",
        "operation_record_id",
        "operation_id",
        "target_connection_id",
        "target_generation",
        "binding",
        "source_cut_id",
        "public_readiness"
      ],
      "additionalProperties": false
    },
    "Discarded": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect/webrtc-public-video-phase/1"
        },
        "phase": {
          "const": "discarded"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_record_id": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "target_connection_id": {
          "$ref": "#/$defs/Id"
        },
        "target_generation": {
          "$ref": "#/$defs/PositiveCount"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "source_cut_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Opaque"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "cancelled",
            "expired",
            "refused",
            "owner-retired",
            "binding-changed",
            "cut-unavailable"
          ]
        }
      },
      "required": [
        "profile",
        "phase",
        "reservation_id",
        "operation_record_id",
        "operation_id",
        "target_connection_id",
        "target_generation",
        "binding",
        "source_cut_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "Phase": {
      "oneOf": [
        {
          "$ref": "#/$defs/NegotiatedNeverFed"
        },
        {
          "$ref": "#/$defs/CutBoundPostF"
        },
        {
          "$ref": "#/$defs/DecodedReady"
        },
        {
          "$ref": "#/$defs/Activated"
        },
        {
          "$ref": "#/$defs/Discarded"
        }
      ],
      "description": "Current-authorized original journal projection only. Runtime enforces monotonic chain, exact immutable original IDs/binding/cut, actual owned resources and phase-specific custody. Activated is atomic with ready Completed publication. Discarded needs actual original physical/backend/Core joins; before binding only an internal terminal marker exists and no wire Phase is emitted. No F ordinal is serialized."
    },
    "DecodedObservation": {
      "type": "object",
      "properties": {
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "source_cut_id": {
          "$ref": "#/$defs/Opaque"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "decoded_frames": {
          "$ref": "#/$defs/PositiveCount"
        },
        "decoded_keyframes": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveCount"
            },
            {
              "type": "null"
            }
          ]
        },
        "decoder_startup": {
          "const": "fresh-receiver-first-decoded-frame"
        }
      },
      "required": [
        "reservation_id",
        "source_cut_id",
        "nonce",
        "binding",
        "decoded_frames",
        "decoded_keyframes",
        "decoder_startup"
      ],
      "additionalProperties": false,
      "description": "Actual original B-only observation. Required nullable decoded_keyframes: a missing browser native keyframe counter may be null, a present counter must be positive and at most decoded_frames. Cross-field/keyframe semantics and actual native decoder ownership require runtime validation."
    },
    "ReadyMarker": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "connect-replacement-public-video-ready-v1"
        },
        "operation_record_id": {
          "$ref": "#/$defs/Id"
        },
        "public_video_readiness": {
          "$ref": "#/$defs/DecodedObservation"
        }
      },
      "required": [
        "profile",
        "operation_record_id",
        "public_video_readiness"
      ],
      "additionalProperties": false,
      "description": "Closed marker inside SAME original signed connection.offer. Preserve every other original offer/credential/key/device field. No audio readiness is supplied here. Host must match whole frozen original marker on replay; shape/signature/counters alone confer no media permission or physical proof."
    }
  }
}
