  },
  "paths": {
    "/v1/operations": {
      "post": {
        "operationId": "conversationControl",
        "description": "Shared family wire models. Current named selectors: none. Retired selectors: create, conversations, close. Recognized retired top-level calls return HTTP501 after current authentication, without compatibility/fallback dispatch. Use /v2/commands for canonical communication. Current named calls retain service authorization and business-state checks. See openapi-application-http.json for the consolidated body/result/profile/framework contract; these DTOs may also be used inside separately authorized Task workflows.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
