  "rules": {
    "saved_control_intent_before_first_write": true,
    "stable_logical_id_across_uncertainty": true,
    "wire_attempt_ids_may_change": true,
    "same_id_changed_intent_refuses": true,
    "wait_cancel_is_not_remote_cancel": true,
    "remote_cancel_has_separate_decision_id": true,
    "ack_is_not_media_readiness": true,
    "unknown_is_not_failure_or_success": true,
    "no_implicit_retry_or_transport_downgrade_after_uncertainty": true,
    "current_authorization_on_every_replay": true,
    "ordinary_api_requires_internal_route_ids": false,
    "ordinary_api_requires_store_access": false,
    "ordinary_api_requires_provider_calls": false,
    "admin_client_separate": true,
    "raw_canonical_access_available": true,
    "native_media_frames_are_ephemeral_not_journal_mutations": true,
    "capabilities_advertised_are_not_qualified_media": true
  },
