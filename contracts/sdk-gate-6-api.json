  "remaining": [
    "Runtime implementation, complete per-language event/result validation, migration, conformance and exact installed-package exercises remain assigned G6-060 through G6-070.",
    "Publisher identity, package manifests and release version require G6-069 checks; registry lookup is neither reservation nor ownership. Publication remains separately authorized."
  ],
  "finalized_at": "2026-10-25",
  "operation_scope": {
    "conversation_id": "optional original assertion",
    "session_id": "optional original assertion",
    "connection_id": "optional original assertion",
    "unscoped_create_and_admin_receipts_supported": true,
    "record_id": "opaque SDK-managed correlation, never a public authority"
  },
  "operation_semantics": {
    "mutation_await": "Returns an observable Operation; does not wait for workflow completion.",
    "completion": "Explicit wait with finite timeout returns Completion<T>.",
    "ready": "Explicit waitUntilReady observes state only; no decoded-media assertion.",
    "reference": "referenceJson emits versioned JSON containing original logical ID, command and scope; no secrets. Restore checks schema, command-kind witness, scope and bounded IDs before creating a local status-only handle. Expected command is saved intent, not an invented server echo.",
    "restoration": "SDK-owned OperationKinds cover all 22 mapped mutation commands; a foreign kind or mismatched saved command refuses. recover accepts an existing typed reference. Neither restore nor recover submits a mutation or performs network I/O.",
    "status_fields": "Current canonical operation.updated sends operation_id, optional record_id, state, revision, optional result/problem. Cancellation/expiry observations stay absent unless authoritative data actually supplies them.",
    "scope": "Creating conversations and trusted provisioning may be unscoped. Retain only original asserted scopes; do not invent a Conversation parent.",
    "decision_receipts": "Preserve target_operation_id, state_at_decision, disposition and optional evidence_id. Target submission assertions and the separate decision receipt scope differ: the current decision record carries original cid/sid but no connid. Its status reference must use the decision receipt scope, not copy the target Connection assertion."
  },
  "revision_families": {
    "session": "SessionSnapshot.revision is the observed state_revision, not a command precondition.",
    "topology": "Session accept/reject/cancel/update/end and existing-Session invite, plus consultation/handoff/return/device move. SessionDecision.topology_revision adapts DecisionOutcome.revision. Current TransitionCompletion.session_revision is also this family.",
    "conversation": "Participant add/update/remove and conversation-scoped handoff role assertion",
    "stream": "current native stream controls/subscriptions; absent from a journal Connection observation until negotiated/confirmed, never guessed from its resource revision"
  },
  "wire_rules": {
    "private_send": "message.send with cid only, nonempty Participant audience and original message ID",
    "session_lifecycle": "cid and sid, no connid; invite medium uses voice/video/voice+video/screen-share/text-chat/mixed, not audio",
    "session_invite": "an empty to list permits the canonical single-Participant Session; private sends remain nonempty",
    "participant_admission": "explicit identity_id, kind and role; expected Conversation revision",
    "topology": "all retained/admitted/retired outcomes are preserved; optional Conversation revision preserved",
    "create": "uses configured tenant; convenience identity list maps to initial_participants with participant role and current canonical policy defaults"
  },
  "contract_proofs": {
    "root": "contracts/sdk-api/",
    "checker": "scripts/check-gate6-sdk-outlines.py",
    "runtime_implementation": false,
    "typed_event_boundary": "Journal envelope retains source, actor, original audience and scoped IDs. Specialized incoming invitations carry public Session handles. Kind-specific payload validation follows current protocol events and the shared event matrix; advanced payload/extension data is Json.",
    "media_boundary": "Stream refresh exposes current owned negotiated format/direction/clock and ownership when available; missing metadata cannot be synthesized from capability advertisement. Platform frame IO/capture/renderer implementations remain G6-050/G6-061/062/063."
  },
