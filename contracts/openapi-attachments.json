{
  "openapi": "3.1.0",
  "info": {
    "title": "Connect Gate 6 attachment links and recipient receipts",
    "version": "0.1.0",
    "description": "Current authenticated message/file audiences, short-lived non-bearer references and recipient-specific observations. Local macOS qualification. Read reporting is opt-in; client reports never establish human action. Canonical message.read shares these original-recipient and opt-in checks and the logical operation ledger. Wire read_at is diagnostic; receipt evidence and typed hints retain server observation time and explicit client_reported provenance. Receipt hints precede their conversation.event cursor fact; production canonical native installation remains open."
  },
  "paths": {
    "/v1/operations": {
      "post": {
        "operationId": "attachmentsAndReceiptsControl",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Operation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated artifact/link/evidence result or typed rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed draft"
          },
          "403": {
            "description": "Current authority or reference denied"
          },
          "409": {
            "description": "Changed logical intent or unavailable message ID"
          },
          "503": {
            "description": "Current authority is busy or unavailable. Retry the same logical mutation ID after current delivery owners settle. No new mutation is admitted by this refusal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        },
        "description": "Attachment link redemption rechecks credential, runtime, resource, original epoch, task/grant context and expiry. Receipt reports are self-only original recipient actions; read preference defaults false. Query filters current preferences and recipient scope before paging. Preserve logical IDs across link renewal or transport uncertainty."
      }
    },
    "/v1/conversations/{conversation_id}/artifacts/{artifact_id}/links/{token}": {
      "get": {
        "operationId": "downloadAttachmentLinkBytes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Current ordinary recipient credentials required; exact message and artifact binding is in the signed reference. Delegated clients use Task Invoke. Bounded raw bytes, no-store and nosniff.",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9_-]+\\.[a-f0-9]{64}$"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32768
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized bounded bytes",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "const": "nosniff"
                }
              },
              "X-Connect-Offset": {
                "schema": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "X-Connect-Eof": {
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Current source, credential, purpose or lifetime denied"
          }
        }
      },
      "put": {
        "operationId": "uploadAttachmentLinkBytes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Current original owner required. Keep request_id, offset and bytes across link renewal; one logical chunk is appended once.",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9_-]+\\.[a-f0-9]{64}$"
            }
          },
          {
            "in": "query",
            "name": "request_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary",
                "minLength": 1,
                "maxLength": 32768
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated artifact/link/evidence result or typed rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed draft"
          },
          "403": {
            "description": "Current authority or reference denied"
          },
          "409": {
            "description": "Changed logical intent or unavailable message ID"
          }
        }
      }
    }
  },
