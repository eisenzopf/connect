      "NativeDtmfSubmission": {
        "type": "object",
        "description": "Frozen native DTMF source and per-recipient local writer facts. Store custody supports native and initial SIP recipient bindings; installed physical delivery profiles are qualified separately. Local submission does not prove remote receipt or playback. Exposed only after all owned local jobs stop; uncertain writes stay uncertain and never schedule replay.",
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "stream_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "resources_changed": {
            "const": false
          },
          "signal_source": {
            "const": "uctp-native"
          },
          "source_observation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "local_submission_only": {
            "const": true
          },
          "local_work_complete": {
            "const": true
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "connection_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._~-]+$"
                },
                "participant_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._~-]+$"
                },
                "membership_epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "generation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "disposition": {
                  "enum": [
                    "not_started",
                    "local_submitted",
                    "outcome_unknown"
                  ]
                },
                "frame_id": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9._~-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Reserved local output identity: the signed native frame ID or one stable SIP gateway schedule ID. Reacquisition keeps the same identity; this field does not prove remote receipt or playback."
                }
              },
              "required": [
                "connection_id",
                "participant_id",
                "membership_epoch",
                "generation",
                "disposition",
                "frame_id"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "enum": [
                          "local_submitted",
                          "outcome_unknown"
                        ]
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "frame_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9._~-]+$"
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "required": [
          "connection_id",
          "stream_revision",
          "resources_changed",
