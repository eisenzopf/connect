{
  "openapi": "3.1.0",
  "info": {
    "title": "Connect Gate 6 shared durable operations",
    "version": "0.1.0",
    "description": "Durable admission/status/cancel/reconcile on fresh schema32. Actor and tenant come only from current credentials. Ordinary local mutation receipts and signed canonical operation recovery share this ledger with current HTTP/SDK control. Task internal wire receipts remain private to their task/grant. Production canonical listener/full command coverage, live transition coordinators, providers and Gate6 acceptance remain separate."
  },
  "paths": {
    "/v1/operations": {
      "post": {
        "operationId": "sharedOperationControl",
        "description": "Current typed control facade. Explicit canonical operation.get/cancel/reconcile uses the same current ledger and decision IDs; production listener/full dispatch remains G6-037. The canonical payload ID names the target; cancel/reconcile top-level envelope operation_id names the separate decision. Optional CID/SID/Connection assertions must match stored targets; unsupported expected-revision assertions are refused explicitly. Admission normalizes typed business intent and reserves source epochs/resources before any provider call. Matching stable principal/ID returns the existing authorized record; changed intent conflicts. Cancels/reconciliations use separate operation IDs. Worker/observer/cleanup capabilities are protected backend composition, never accepted as body fields. Reconciliation references attributed existing evidence; it cannot fabricate local commit or provider termination. Readiness stage metadata is not physical-media qualification.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Operation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized current operation, decision receipt, or typed business rejection. Inspect result.Ok/result.Err; acceptance is not route/media completion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "401": {
            "description": "Current authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "413": {
            "description": "Operation body exceeds configured 64KiB bound"
          },
          "422": {
            "description": "Invalid JSON operation shape, unknown/authority selector field, or enum"
          },
          "503": {
            "description": "Bounded HTTP capacity, current authority busy/unavailable, or durable storage unavailability. For an authority refusal retry the same logical mutation ID after delivery owners settle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          },
          "403": {
            "description": "Current principal, original command scope, resource audience or operation owner is not authorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response"
                }
              }
            }
          }
        }
      }
    }
  },
