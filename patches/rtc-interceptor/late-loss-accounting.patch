+#[cfg(test)]
+mod late_loss_regressions {
+    use super::*;
+    fn packet(sequence_number: u16) -> rtp::packet::Packet {
+        rtp::packet::Packet { header: rtp::header::Header {
+            sequence_number, ..Default::default()
+        }, ..Default::default() }
+    }
+    #[test]
+    fn late_reported_loss_corrects_cumulative_and_interval_once_across_wrap() {
+        for base in [1u16, 65535] {
+            let mut stream = ReceiverStream::new(1, 90000);
+            let now = Instant::now();
+            for offset in [0, 2] { stream.process_rtp(now, &packet(base.wrapping_add(offset))); }
+            assert_eq!(stream.generate_report(now).reports[0].total_lost, 1);
+            for offset in [1, 1, 4] { stream.process_rtp(now, &packet(base.wrapping_add(offset))); }
+            let rr = stream.generate_report(now);
+            assert_eq!(rr.reports[0].total_lost, 1, "only the newly missing packet remains");
+            assert_eq!(rr.reports[0].fraction_lost, 0, "one late recovery offsets one new gap");
+            stream.process_rtp(now, &packet(base.wrapping_add(1)));
+            assert_eq!(stream.generate_report(now).reports[0].total_lost, 1, "duplicate cannot recover twice");
+            stream.process_rtp(now, &packet(base.wrapping_add(3)));
+            let rr = stream.generate_report(now);
+            assert_eq!(rr.reports[0].total_lost, 0);
+            assert_eq!(rr.reports[0].fraction_lost, 0);
+            // A report with no advancement consumes its recovery interval.
+            stream.process_rtp(now, &packet(base.wrapping_add(6)));
+            let rr = stream.generate_report(now);
+            assert_eq!(rr.reports[0].total_lost, 1);
+            assert_eq!(rr.reports[0].fraction_lost, 128);
+        }
+    }
+    #[test]
+    fn late_loss_tags_cannot_cancel_a_reused_history_slot() {
+        let mut stream = ReceiverStream::new(1, 90000);
+        let now = Instant::now();
+        for seq in [1, 3] { stream.process_rtp(now, &packet(seq)); }
+        assert_eq!(stream.generate_report(now).reports[0].total_lost, 1);
+        for seq in 4..=8195 { if seq != 8194 { stream.process_rtp(now, &packet(seq)); } }
+        assert_eq!(stream.generate_report(now).reports[0].total_lost, 2);
+        stream.process_rtp(now, &packet(2));
+        assert_eq!(stream.generate_report(now).reports[0].total_lost, 2, "expired gap cannot cancel current slot");
+        stream.process_rtp(now, &packet(8194));
+        assert_eq!(stream.generate_report(now).reports[0].total_lost, 1, "current exact sequence still corrects");
+    }
+    #[test]
+    fn expired_arrival_before_report_cannot_hide_current_aliased_gap() {
+        let mut stream = ReceiverStream::new(1, 90000);
+        let now = Instant::now();
+        for seq in [1, 3] { stream.process_rtp(now, &packet(seq)); }
+        assert_eq!(stream.generate_report(now).reports[0].total_lost, 1);
+        for seq in 4..=8195 { if seq != 8194 { stream.process_rtp(now, &packet(seq)); } }
+        // Packet2 aliases packet8194 but is older than the retained history.
+        // Its arrival must still update jitter timestamps without setting that bit.
+        let later = now + std::time::Duration::from_millis(10);
+        stream.process_rtp(later, &packet(2));
+        assert_eq!(stream.last_rtp_time_time, later);
+        let rr = stream.generate_report(later);
+        assert_eq!(rr.reports[0].total_lost, 2, "current8194 gap must remain visible");
+        stream.process_rtp(later, &packet(8194));
+        assert_eq!(stream.generate_report(later).reports[0].total_lost, 1);
+    }
+    #[test]
+    fn reorder_before_report_does_not_create_recovery_credit() {
+        let mut stream = ReceiverStream::new(1, 90000);
+        let now = Instant::now();
+        for seq in [1,3,2] { stream.process_rtp(now, &packet(seq)); }
+        assert_eq!(stream.generate_report(now).reports[0].total_lost, 0);
+        stream.process_rtp(now, &packet(5));
+        let rr = stream.generate_report(now);
+        assert_eq!(rr.reports[0].total_lost, 1);
+        assert_eq!(rr.reports[0].fraction_lost, 128);
+    }
