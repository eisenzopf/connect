+#[cfg(test)]
+mod lifecycle_regressions {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    fn update(live: Arc<AtomicBool>, anchor: Option<SenderClockAnchor>) -> SenderClockUpdate {
+        SenderClockUpdate {
+            source_id: 1,
+            generation: 1,
+            anchor,
+            rtp_offset: 0,
+            supported: true,
+            is_current: Arc::new(move || live.load(Ordering::Acquire)),
+        }
+    }
+    #[test]
+    fn source_clock_old_retired_cannot_suppress_current_and_replacement_does_not_keep_old_anchor() {
+        let h = SenderClockHandle::default();
+        h.bind(1, 8000);
+        let old = Arc::new(AtomicBool::new(true));
+        let current = Arc::new(AtomicBool::new(true));
+        let a = SenderClockAnchor {
+            ntp_time: 1 << 32,
+            rtp_time: 0,
+            clock_rate: 8000,
+        };
+        h.apply_after_rtp(1, Some(update(old.clone(), Some(a))));
+        old.store(false, Ordering::Release);
+        h.apply_after_rtp(1, Some(update(current.clone(), None)));
+        assert_eq!(h.selection(1), SenderClockSelection::Pending);
+        h.apply_after_rtp(1, Some(update(current.clone(), Some(a))));
+        assert!(!h.permits(1, Some(&update(old.clone(), None))));
+        assert!(!h.apply_after_rtp(1, Some(update(old, None))));
+        assert_eq!(h.selection(1), SenderClockSelection::Source(a));
+        let mut unsupported = update(current, None);
+        unsupported.supported = false;
+        h.apply_after_rtp(1, Some(unsupported));
+        assert_eq!(h.selection(1), SenderClockSelection::Pending);
+    }
+}
