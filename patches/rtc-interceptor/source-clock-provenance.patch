+        assert!(h.apply_after_rtp(1, Some(update(None, live.clone(), 2))));
+        assert_eq!(h.selection(1), SenderClockSelection::Pending);
+        let restarted = anchor(1 << 32, 0);
+        assert!(h.apply_after_rtp(1, Some(update(Some(restarted), live, 2))));
+        assert_eq!(h.selection(1), SenderClockSelection::Source(restarted));
+    }
+}
