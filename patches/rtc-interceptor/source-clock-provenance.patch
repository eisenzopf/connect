+//! Explicit, bounded clock overrides for relayed sender streams.
+//! Native/local streams retain their original report mode until explicitly set.
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+/// One RTP sample paired with the relay's local NTP domain. The source adapter
+/// applies one common domain translation for all synchronized source tracks.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SenderClockAnchor {
+    pub ntp_time: u64,
+    pub rtp_time: u32,
+    pub clock_rate: u32,
+}
+impl SenderClockAnchor {
+    pub fn rtp_at(&self, ntp_time: u64) -> u32 {
+        // Signed modular NTP delta handles the NTP era boundary. Accepted
+        // anchors are in the current source generation, not arbitrary eras.
+        let delta = ntp_time.wrapping_sub(self.ntp_time) as i64;
+        let ticks = i128::from(delta) * i128::from(self.clock_rate) / (1_i128 << 32);
+        self.rtp_time.wrapping_add(ticks as u32)
+    }
+    pub fn translated_rtp(self, source_packet: u32, wire_packet: u32) -> Self {
+        Self {
+            rtp_time: self
+                .rtp_time
+                .wrapping_add(wire_packet.wrapping_sub(source_packet)),
+            ..self
+        }
+    }
+}
+
+/// Kept separate from the anchor: absent authoritative SR must never look like
+/// a native stream, and a retired route must never resume generated timing.
+#[derive(Clone)]
+pub struct SenderClockUpdate {
+    pub source_id: u128,
+    pub generation: u64,
+    pub anchor: Option<SenderClockAnchor>,
+    /// Current source-to-wire translation, distinct from the source SR age.
+    pub rtp_offset: u32,
+    pub supported: bool,
+    /// Source and route lifetime/current-authority predicate. It must be cheap,
+    /// synchronous, and remain false once the represented route is retired.
+    pub is_current: Arc<dyn Fn() -> bool + Send + Sync>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SenderClockSelection {
+    Local,
+    Pending,
+    Retired,
+    Source(SenderClockAnchor),
+}
+struct Slot {
+    rate: u32,
+    external: Option<SenderClockUpdate>,
+}
+/// Shared only with the owning peer driver. Applying updates must occur in the
+/// same serialized core event as the corresponding successful RTP write.
+#[derive(Clone, Default)]
+pub struct SenderClockHandle(Arc<Mutex<HashMap<u32, Slot>>>);
+impl SenderClockHandle {
+    pub(crate) fn bind(&self, ssrc: u32, rate: u32) {
+        let mut slots = self.0.lock().unwrap_or_else(|p| p.into_inner());
+        if slots.get(&ssrc).is_some_and(|s| s.rate == rate) {
+            return;
+        }
+        slots.insert(
+            ssrc,
+            Slot {
+                rate,
+                external: None,
+            },
+        );
+    }
+    pub(crate) fn unbind(&self, ssrc: u32) {
+        self.0
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .remove(&ssrc);
+    }
+    /// Preflight before writing any associated RTP. The driver repeats the
+    /// lifetime check when applying the successful write's mapping.
+    pub fn permits(&self, ssrc: u32, update: Option<&SenderClockUpdate>) -> bool {
+        let slots = self.0.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(slot) = slots.get(&ssrc) else {
+            return false;
+        };
+        update.is_none_or(|u| {
+            (u.is_current)()
+                && (!u.supported
+                    || u.anchor
+                        .is_none_or(|a| a.clock_rate != 0 && a.clock_rate == slot.rate))
+        })
+    }
+    /// Unknown SSRCs never allocate slots. None is an explicit new local/native
+    /// write, not a fallback for pending or invalid external metadata.
+    pub fn apply_after_rtp(&self, ssrc: u32, update: Option<SenderClockUpdate>) -> bool {
+        let mut slots = self.0.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(slot) = slots.get_mut(&ssrc) else {
+            return false;
+        };
+        let Some(mut update) = update else {
+            slot.external = None;
+            return true;
+        };
+        if !(update.is_current)() {
+            if !slot.external.as_ref().is_some_and(|old| (old.is_current)()) {
+                slot.external = Some(update);
+            }
+            return false;
+        }
+        if let Some(anchor) = update.anchor.filter(|_| update.supported) {
+            if anchor.clock_rate == 0 || anchor.clock_rate != slot.rate {
+                return false;
+            }
+        }
+        if let Some(old) = slot.external.as_ref() {
+            if (old.is_current)()
+                && old.source_id == update.source_id
+                && old.generation == update.generation
+            {
+                if let Some(previous) = old.anchor {
+                    // Queued older frames may carry an earlier SR from the
+                    // same clock. Retain the newer authoritative pair.
+                    if update.anchor.is_none_or(|next| {
+                        next.ntp_time.wrapping_sub(previous.ntp_time) as i64 <= 0
+                    }) {
+                        update.anchor = Some(previous);
+                    }
+                }
+            }
+        }
+        slot.external = Some(update);
+        true
+    }
+    pub(crate) fn selection(&self, ssrc: u32) -> SenderClockSelection {
+        let slots = self.0.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(slot) = slots.get(&ssrc) else {
+            return SenderClockSelection::Retired;
+        };
+        match &slot.external {
+            None => SenderClockSelection::Local,
+            Some(update) if !(update.is_current)() => SenderClockSelection::Retired,
+            Some(update) if !update.supported => SenderClockSelection::Pending,
+            Some(update) => update.anchor.map_or(SenderClockSelection::Pending, |a| {
+                SenderClockSelection::Source(SenderClockAnchor {
+                    rtp_time: a.rtp_time.wrapping_add(update.rtp_offset),
+                    ..a
+                })
+            }),
+        }
+    }
+}
