+//! RFC 4588 receive normalization. Install inside transport feedback and outside
+//! primary-stream NACK/reports. SRTP authenticates the separate repair SSRC first.
+use crate::{Interceptor, Packet, StreamInfo, TaggedPacket, interceptor};
+use shared::error::Error;
+use std::{collections::HashMap, marker::PhantomData};
+
+pub struct RtxReceiverBuilder<P>(PhantomData<P>);
+impl<P> Default for RtxReceiverBuilder<P> {
+    fn default() -> Self {
+        Self(PhantomData)
+    }
+}
+impl<P> RtxReceiverBuilder<P> {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn build(self) -> impl FnOnce(P) -> RtxReceiverInterceptor<P> {
+        |inner| RtxReceiverInterceptor {
+            inner,
+            streams: HashMap::new(),
+            primaries: HashMap::new(),
+        }
+    }
+}
+#[derive(Clone)]
+struct RepairStream {
+    ssrc: u32,
+    primary_pt: u8,
+    repair_pt: u8,
+}
+#[derive(Interceptor)]
+pub struct RtxReceiverInterceptor<P> {
+    #[next]
+    inner: P,
+    // Exactly one entry per currently bound primary stream; no per-packet state.
+    streams: HashMap<u32, RepairStream>,
+    primaries: HashMap<u32, u8>,
+}
+#[interceptor]
+impl<P: Interceptor> RtxReceiverInterceptor<P> {
+    #[overrides]
+    fn bind_remote_stream(&mut self, info: &StreamInfo) {
+        self.streams.remove(&info.ssrc);
+        self.primaries.insert(info.ssrc, info.payload_type);
+        if let (Some(ssrc), Some(repair_pt)) = (info.ssrc_rtx, info.payload_type_rtx) {
+            if ssrc != info.ssrc && repair_pt != info.payload_type {
+                self.streams.insert(
+                    info.ssrc,
+                    RepairStream {
+                        ssrc,
+                        primary_pt: info.payload_type,
+                        repair_pt,
+                    },
+                );
+            }
+        }
+        self.inner.bind_remote_stream(info);
+    }
+    #[overrides]
+    fn unbind_remote_stream(&mut self, info: &StreamInfo) {
+        self.streams.remove(&info.ssrc);
+        self.primaries.remove(&info.ssrc);
+        self.inner.unbind_remote_stream(info);
+    }
+    #[overrides]
+    fn handle_read(&mut self, mut msg: TaggedPacket) -> Result<(), Self::Error> {
+        if let Packet::Rtp(ref mut packet) = msg.message {
+            if self.primaries.get(&packet.header.ssrc) == Some(&packet.header.payload_type) {
+                return self.inner.handle_read(msg);
+            }
+            let mut matches = self.streams.iter().filter(|(_, stream)| {
+                stream.ssrc == packet.header.ssrc && stream.repair_pt == packet.header.payload_type
+            });
+            if let Some((&primary, stream)) = matches.next() {
+                if matches.next().is_some() {
+                    return Err(Error::Other("ambiguous RTX association".into()));
+                }
+                // Padding-only repair probes still count for outer TWCC, but are not media.
+                if packet.header.padding && packet.payload.is_empty() {
+                    return Ok(());
+                }
+                if packet.payload.len() < 2 {
+                    return Err(Error::Other("short RTX original sequence number".into()));
+                }
+                let original = u16::from_be_bytes([packet.payload[0], packet.payload[1]]);
+                packet.header.ssrc = primary;
+                packet.header.payload_type = stream.primary_pt;
+                packet.header.sequence_number = original;
+                packet.header.padding = false;
+                packet.payload = packet.payload.slice(2..);
+            } else if self
+                .streams
+                .values()
+                .any(|stream| stream.ssrc == packet.header.ssrc)
+            {
+                return Err(Error::Other("unnegotiated RTX association".into()));
+            }
+        }
+        self.inner.handle_read(msg)
+    }
+}
