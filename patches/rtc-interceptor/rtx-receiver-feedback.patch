+    #[test]
+    fn wire_feedback_observes_rtx_before_primary_nack_and_report_recovery() {
+        let mut chain = Registry::new()
+            .with(
+                NackGeneratorBuilder::new()
+                    .with_interval(Duration::from_millis(10))
+                    .build(),
+            )
+            .with(
+                ReceiverReportBuilder::new()
+                    .with_interval(Duration::from_millis(50))
+                    .build(),
+            )
+            .with(RtxReceiverBuilder::new().build())
+            .with(TwccReceiverBuilder::new().build())
+            .build();
+        chain.bind_remote_stream(&info(1001, 2002));
+        let now = Instant::now();
+        chain
+            .handle_read(packet(now, 1001, 96, 10, 1, &[0x10, 7]))
+            .unwrap();
+        chain
+            .handle_read(packet(
+                now + Duration::from_millis(1),
+                1001,
+                96,
+                12,
+                2,
+                &[0x10, 8],
+            ))
+            .unwrap();
+        chain
+            .handle_timeout(now + Duration::from_millis(20))
+            .unwrap();
+        let mut requested = false;
+        while let Some(p) = chain.poll_write() {
+            if let Packet::Rtcp(ps) = p.message {
+                for p in ps {
+                    if let Some(n)=p.as_any().downcast_ref::<rtcp::transport_feedbacks::transport_layer_nack::TransportLayerNack>() {assert_eq!(n.media_ssrc,1001);requested=true;}
+                }
+            }
+        }
+        assert!(requested);
+        chain
+            .handle_read(packet(
+                now + Duration::from_millis(21),
+                2002,
+                97,
+                400,
+                3,
+                &[0, 11, 0x10, 9],
+            ))
+            .unwrap();
+        chain
+            .handle_timeout(now + Duration::from_millis(100))
+            .unwrap();
+        let mut reports = 0;
+        let mut twcc = 0;
+        while let Some(p) = chain.poll_write() {
+            if let Packet::Rtcp(ps) = p.message {
+                for p in ps {
+                    assert!(!p.as_any().is::<rtcp::transport_feedbacks::transport_layer_nack::TransportLayerNack>());
+                    if let Some(rr) = p
+                        .as_any()
+                        .downcast_ref::<rtcp::receiver_report::ReceiverReport>()
+                    {
+                        for r in &rr.reports {
+                            assert_eq!(r.ssrc, 1001);
+                            assert_eq!(r.total_lost, 0);
+                            assert_eq!(r.last_sequence_number, 12);
+                            reports += 1;
+                        }
+                    }
+                    if let Some(t)=p.as_any().downcast_ref::<rtcp::transport_feedbacks::transport_layer_cc::TransportLayerCc>() {assert_eq!(t.base_sequence_number,1);assert_eq!(t.packet_status_count,3);assert_eq!(t.recv_deltas.len(),3);twcc+=1;}
+                }
+            }
+        }
+        assert_eq!((reports, twcc), (1, 1));
+        let mut media = Vec::new();
+        while let Some(p) = chain.poll_read() {
+            if let Packet::Rtp(p) = p.message {
+                media.push(p.header.sequence_number);
+            }
+        }
+        assert_eq!(media, [10, 12, 11]);
+    }
