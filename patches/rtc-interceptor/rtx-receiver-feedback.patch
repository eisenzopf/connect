+        let Packet::Rtcp(ps) = chain.poll_write().unwrap().message else {
+            panic!()
+        };
+        let t = ps[0]
+            .as_any()
+            .downcast_ref::<rtcp::transport_feedbacks::transport_layer_cc::TransportLayerCc>()
+            .unwrap();
+        assert_eq!(t.recv_deltas.len(), 1);
+    }
