+            transport: TransportContext::default(),
+            message: Packet::Rtp(packet),
+        }
+    }
+    #[test]
+    fn exact_association_restores_original_fields_and_first_rtx_packet() {
+        let mut chain = Registry::new()
+            .with(RtxReceiverBuilder::new().build())
+            .build();
+        chain.bind_remote_stream(&info(1001, 2002));
+        let now = Instant::now();
+        chain
+            .handle_read(packet(now, 2002, 97, 400, 4, &[0, 11, 0x10, 7]))
+            .unwrap();
+        let Packet::Rtp(received) = chain.poll_read().unwrap().message else {
+            panic!()
+        };
+        assert_eq!(
+            (
+                received.header.ssrc,
+                received.header.payload_type,
+                received.header.sequence_number
+            ),
+            (1001, 96, 11)
+        );
+        assert_eq!(received.header.timestamp, 90000);
+        assert!(received.header.marker);
+        assert_eq!(received.payload.as_ref(), &[0x10, 7]);
+        assert_eq!(received.header.get_extension(3).unwrap().as_ref(), &[0, 4]);
+    }
+    #[test]
+    fn rejects_short_wrong_payload_and_ambiguous_association() {
+        let mut chain = Registry::new()
+            .with(RtxReceiverBuilder::new().build())
+            .build();
+        chain.bind_remote_stream(&info(1001, 2002));
+        let now = Instant::now();
+        for bad in [
+            packet(now, 2002, 97, 400, 4, &[0]),
+            packet(now, 2002, 98, 400, 4, &[0, 11, 0x10]),
+        ] {
+            assert!(chain.handle_read(bad).is_err());
+            assert!(chain.poll_read().is_none());
+        }
+        chain.bind_remote_stream(&info(1002, 2002));
+        assert!(
+            chain
+                .handle_read(packet(now, 2002, 97, 400, 4, &[0, 11, 0x10]))
+                .is_err()
