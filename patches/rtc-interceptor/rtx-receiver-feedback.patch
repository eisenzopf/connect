+        let mut packet = rtp::Packet::default();
+        packet.header.ssrc = ssrc;
+        packet.header.payload_type = pt;
+        packet.header.sequence_number = seq;
+        packet.header.timestamp = 90000;
+        packet.header.marker = true;
+        packet
