+#[cfg(test)]
+mod repeated_header_tests {
+    use super::*;
+    #[test]
+    fn connect_round_trip_preserves_each_origin_for_exact_origin_validation() {
+        let mut request = ConnectRequest::from(url::Url::parse("https://localhost:4443/connect").unwrap());
+        request.headers.append("origin", "https://browser.fixture.invalid".parse().unwrap());
+        request.headers.append("origin", "https://browser.fixture.invalid".parse().unwrap());
+        request.headers.append("x-test", "first".parse().unwrap());
+        request.headers.append("x-test", "second".parse().unwrap());
+        let mut bytes = Vec::new();
+        request.encode(&mut bytes).unwrap();
+        let decoded = ConnectRequest::decode(&mut bytes.as_slice()).unwrap();
+        assert_eq!(decoded.headers.get_all("origin").iter().count(), 2);
+        assert_eq!(decoded.headers.get_all("x-test").iter().count(), 2);
+    }
