+#[tokio::test]
+async fn replacement_scene_with_quarantined_video_commits_audio_without_opening_video() {
+    for closed in [false, true] {
+        let mut f = Move::with_media(
+            closed,
+            "alice",
+            false,
+            vec![desired(Medium::Audio), desired(Medium::Video)],
+        )
+        .await;
+        let video = f.room.nodes["device"].adapter.port(Medium::Video);
+        let remote = f.room.nodes["bob"].controller.active_bindings();
+        assert!(video.try_publish(&frame(&video, 1)).is_err());
+        f.io().await;
+        f.confirm().await;
+        let plan = f.plan().unwrap();
+        let (_, handle) = f.commit(plan).await.unwrap();
+        assert!(
+            video.try_publish(&frame(&video, 2)).is_err(),
+            "audio replacement opened video"
+        );
+        let state = f.room.nodes["device"].controller.state.lock().unwrap();
+        let stream = &state.model.streams()[&desired(Medium::Video).logical_id];
+        assert!(stream.source_muted);
+        assert_eq!(stream.state, LogicalStreamState::Active);
+        assert!(stream.hold_direction.is_none());
+        drop(state);
+        assert!(f.room.publish("alice", 800).is_err());
+        f.room.publish("device", 5200).unwrap();
+        f.room.tick();
+        f.room.heard("bob", 5200).await;
+        if closed {
+            f.room.silent(&["public"]);
+        } else {
+            f.room.heard("public", 5200).await;
+        }
+        assert_eq!(
+            f.room.nodes["bob"].controller.active_bindings()[0].transport_id,
+            remote[0].transport_id
+        );
+        assert_eq!(
+            handle.finish_local_media_cleanup(deadline()).await,
+            ReplacementCleanupOutcome::LocalMediaClosed
+        );
+        assert!(video.try_publish(&frame(&video, 3)).is_err());
+    }
