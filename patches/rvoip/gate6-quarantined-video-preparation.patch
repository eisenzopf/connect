 //! Decoder-only endpoint preparation. No sample or packet enters the mixer.
 use super::{audience::*, guarded_audio::Codecs, *};
+
+// Extra negotiated video resources are dormant, not proof of video IO or a
+// public route. Every readiness observation must still find them active/muted.
+pub(super) fn check_quarantined_video(state: &State) -> ControlResult<()> {
+    for (logical, port) in &state.active {
+        let medium = port.binding.negotiated.requested.medium;
+        if medium == Medium::Audio {
+            continue;
+        }
+        if medium != Medium::Video {
+            return Err(StreamControlError::Unsupported);
+        }
+        let stream = state
+            .model
+            .streams()
+            .get(logical)
+            .ok_or(StreamControlError::NotReady)?;
+        if stream.state != LogicalStreamState::Active
+            || !stream.source_muted
+            || stream.hold_direction.is_some()
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let physical = port
+            .state
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        if !physical.ready || physical.status != PortStatus::Active {
+            return Err(StreamControlError::NotReady);
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn check_expected_video(state: &State, ports: &[Weak<Port>]) -> ControlResult<()> {
+    check_quarantined_video(state)?;
+    for original in ports {
+        let port = original.upgrade().ok_or(StreamControlError::NotReady)?;
+        if !state
+            .active
+            .values()
+            .any(|current| Arc::ptr_eq(current, &port))
+        {
+            return Err(StreamControlError::NotReady);
+        }
+    }
+    Ok(())
+}
 
