+impl StreamController {
+    /// Weak observations of actual selected owners, never grants or retained
+    /// receivers. A concurrent metadata mutation is explicitly retryable.
+    pub(crate) fn weak_media_owners_for_test(
+        self: &Arc<Self>,
+    ) -> ControlResult<Vec<(&'static str, Weak<dyn Any + Send + Sync>)>> {
+        let erased: Arc<dyn Any + Send + Sync> = self.clone();
+        let mut owners = vec![("controller", Arc::downgrade(&erased))];
+        drop(erased);
+        {
+            let state = self.state.try_lock().map_err(|error| match error {
+                std::sync::TryLockError::WouldBlock => StreamControlError::MetadataBusy,
+                std::sync::TryLockError::Poisoned(_) => MediaTransitionError::Conflict.into(),
+            })?;
+            for port in state.all.values() {
+                let erased: Arc<dyn Any + Send + Sync> = port.clone();
+                owners.push(("port", Arc::downgrade(&erased)));
+            }
+        }
+        let preparation = {
+            let slot = self
+                .audio_preparation
+                .try_lock()
+                .map_err(|error| match error {
+                    std::sync::TryLockError::WouldBlock => StreamControlError::MetadataBusy,
+                    std::sync::TryLockError::Poisoned(_) => MediaTransitionError::Conflict.into(),
+                })?;
+            slot.as_ref().and_then(Weak::upgrade)
+        };
+        if let Some(preparation) = preparation {
+            let erased: Arc<dyn Any + Send + Sync> = preparation.clone();
+            owners.push(("preparation", Arc::downgrade(&erased)));
+            drop(erased);
+            let codecs = preparation
+                .decoder
+                .try_lock()
+                .map_err(|error| match error {
+                    std::sync::TryLockError::WouldBlock => StreamControlError::MetadataBusy,
+                    std::sync::TryLockError::Poisoned(_) => MediaTransitionError::Conflict.into(),
+                })?;
+            let [decoder, encoder] = codecs.weak_codec_owners_for_test();
+            owners.push(("preparation-decoder", decoder));
+            owners.push(("preparation-encoder", encoder));
+        }
+        Ok(owners)
+    }
+}
