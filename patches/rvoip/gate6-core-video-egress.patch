--- /dev/null
+++ b/crates/webrtc/rvoip-webrtc/src/media/core_video.rs
@@ -0,0 +1,369 @@
+//! Exact Core VP8 delivery and explicit repair through the owned RTC driver.
+//! This consumes one real Core port queue. It does not assert readiness or own
+//! peer/port cleanup; the staged adapter must retain and drain original writes.
+use rtc::{
+    interceptor::{SenderClockHandle, SenderClockUpdate},
+    rtp,
+    shared::marshal::Unmarshal,
+};
+use rvoip_core::{
+    staged_streams::{
+        AdapterMediaPort, ControlResult, MediaDeliveryOrigin, QueuedMedia, StreamControlError,
+        VideoRepair,
+    },
+    stream::{MediaFrame, StreamKind},
+    stream_lifecycle::{MediaFormat, Medium},
+};
+use std::{
+    sync::{Arc, Mutex},
+    time::Instant,
+};
+use tokio::sync::{Mutex as AsyncMutex, OwnedMutexGuard, mpsc};
+use webrtc::media_stream::{
+    Track,
+    track_local::{owned_rtp::*, static_rtp::TrackLocalStaticRTP},
+};
+
+pub struct CoreVideoEgress {
+    output: mpsc::Receiver<QueuedMedia>,
+    track: Arc<TrackLocalStaticRTP>,
+    timeline: Arc<AsyncMutex<Timeline>>,
+    ssrc: u32,
+    payload_type: u8,
+    clock: SenderClockHandle,
+}
+impl CoreVideoEgress {
+    /// Check the exact format and physical track before taking the port queue.
+    /// Actual negotiated direction/encoding and fresh permission are repeated
+    /// inside each driver callback. Metadata alone grants no media authority.
+    pub async fn bind(
+        port: &AdapterMediaPort,
+        track: Arc<TrackLocalStaticRTP>,
+        ssrc: u32,
+        payload_type: u8,
+        clock: SenderClockHandle,
+        deadline: Instant,
+    ) -> ControlResult<Self> {
+        let binding = port.binding();
+        if !matches!(
+            binding.negotiated.requested.medium,
+            Medium::Video | Medium::Screen
+        ) || !binding.sink_ready
+            || payload_type >= 128
+            || !matches!(&binding.negotiated.format,
+                MediaFormat::Encoded{name,clock_rate_hz:90000,channels:0,fmtp}
+                if name.eq_ignore_ascii_case("vp8") && fmtp.as_ref().is_none_or(|f|f.is_empty()))
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let codec = tokio::time::timeout_at(deadline.into(), track.codec(ssrc))
+            .await
+            .map_err(|_| StreamControlError::Deadline)?
+            .ok_or(StreamControlError::NotReady)?;
+        if !codec.mime_type.eq_ignore_ascii_case("video/VP8")
+            || codec.clock_rate != 90000
+            || codec.channels != 0
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let timeline = tokio::time::timeout_at(
+            deadline.into(),
+            track.owned_rtp_timeline::<AsyncMutex<Timeline>>(ssrc),
+        )
+        .await
+        .map_err(|_| StreamControlError::Deadline)?
+        .map_err(|_| StreamControlError::Unsupported)?;
+        let output = port.take_egress()?;
+        Ok(Self {
+            output,
+            track,
+            timeline,
+            ssrc,
+            payload_type,
+            clock,
+        })
+    }
+    /// Waiting and sequence ownership hold no Core permission reader. Retain
+    /// the returned original owner until its actual driver receipt is drained.
+    pub async fn submit_next(&mut self, deadline: Instant) -> ControlResult<Option<OwnedRtpWrite>> {
+        let queued = tokio::time::timeout_at(deadline.into(), self.output.recv())
+            .await
+            .map_err(|_| StreamControlError::Deadline)?;
+        let Some(queued) = queued else {
+            return Ok(None);
+        };
+        let timeline = tokio::time::timeout_at(deadline.into(), self.timeline.clone().lock_owned())
+            .await
+            .map_err(|_| StreamControlError::Deadline)?;
+        let producer = Producer {
+            original: Mutex::new(Some((queued, timeline))),
+            retained: Mutex::new(None),
+            ssrc: self.ssrc,
+            payload_type: self.payload_type,
+            clock: self.clock.clone(),
+        };
+        Ok(Some(self.track.owned_rtp(Arc::new(producer), deadline)))
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+struct Source {
+    origin: MediaDeliveryOrigin,
+    ssrc: u32,
+}
+#[derive(Default)]
+struct Timeline {
+    source: Option<Source>,
+    last_input: Option<u16>,
+    next_output: u16,
+    last_input_timestamp: Option<u32>,
+    last_output_timestamp: Option<u32>,
+    offset: u32,
+}
+#[derive(Clone, Copy)]
+struct Mapping {
+    sequence: u16,
+    timestamp: u32,
+    offset: u32,
+}
+impl Timeline {
+    fn allocate(&mut self, source: Source, packet: &rtp::Packet) -> ControlResult<Mapping> {
+        let sequence = packet.header.sequence_number;
+        let timestamp = packet.header.timestamp;
+        let same = self.source.as_ref() == Some(&source);
+        let output = if same {
+            let delta =
+                sequence.wrapping_sub(self.last_input.ok_or(StreamControlError::NotReady)?) as i16;
+            if delta <= 0
+                || self
+                    .last_input_timestamp
+                    .is_some_and(|last| (timestamp.wrapping_sub(last) as i32) < 0)
+            {
+                return Err(StreamControlError::NotReady);
+            }
+            self.next_output.wrapping_add(delta as u16 - 1)
+        } else if self.source.is_none() {
+            sequence
+        } else {
+            self.next_output
+        };
+        if !same {
+            // A source handoff starts at the next target tick, while the SR
+            // mapping receives this same offset. No frame-rate is invented.
+            self.offset = self
+                .last_output_timestamp
+                .map_or(0, |last| last.wrapping_add(1).wrapping_sub(timestamp));
+        }
+        let wire_timestamp = timestamp.wrapping_add(self.offset);
+        self.source = Some(source);
+        self.last_input = Some(sequence);
+        self.next_output = output.wrapping_add(1);
+        self.last_input_timestamp = Some(timestamp);
+        self.last_output_timestamp = Some(wire_timestamp);
+        Ok(Mapping {
+            sequence: output,
+            timestamp: wire_timestamp,
+            offset: self.offset,
+        })
+    }
+}
+fn primary(frame: &MediaFrame, ssrc: u32, pt: u8) -> ControlResult<rtp::Packet> {
+    if frame.kind != StreamKind::Video {
+        return Err(StreamControlError::Unsupported);
+    }
+    let bytes = rvoip_core::video_bridge::normalize_packet(frame, ssrc, pt)
+        .ok_or(StreamControlError::Unsupported)?;
+    rtp::Packet::unmarshal(&mut bytes.as_ref()).map_err(|_| StreamControlError::Unsupported)
+}
+fn timing(frame: &MediaFrame, offset: u32) -> Option<SenderClockUpdate> {
+    // Core's None means native/local timing. Some without an anchor preserves
+    // authenticated pending provenance and must never fall back to native SR.
+    super::clock::update(frame.source_clock.clone(), 90000).map(|mut update| {
+        update.rtp_offset = update.rtp_offset.wrapping_add(offset);
+        update
+    })
+}
+
+struct Retained {
+    core: Arc<VideoRepair>,
+    source: Source,
+    mapping: Mapping,
+}
+struct Producer {
+    original: Mutex<Option<(QueuedMedia, OwnedMutexGuard<Timeline>)>>,
+    retained: Mutex<Option<Retained>>,
+    ssrc: u32,
+    payload_type: u8,
+    clock: SenderClockHandle,
+}
+#[async_trait::async_trait]
+impl OwnedRtpProducer for Producer {
+    async fn write(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+        let (queued, mut timeline) = self
+            .original
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(OwnedRtpError::Refused)?;
+        let mut metadata = None;
+        let saved = &mut metadata;
+        let core = queued
+            .deliver_video_with_repair(|frame, origin| async move {
+                let origin = origin.ok_or(StreamControlError::Unsupported)?;
+                let mut packet = primary(&frame, self.ssrc, self.payload_type)?;
+                // Read the original source SSRC before hop normalization rewrites it.
+                let source_packet = rtp::Packet::unmarshal(&mut frame.payload.as_ref())
+                    .map_err(|_| StreamControlError::Unsupported)?;
+                let source = Source {
+                    origin,
+                    ssrc: source_packet.header.ssrc,
+                };
+                let mapping = timeline.allocate(source.clone(), &source_packet)?;
+                packet.header.sequence_number = mapping.sequence;
+                packet.header.timestamp = mapping.timestamp;
+                io.write_with_clock(packet, self.clock.clone(), timing(&frame, mapping.offset))
+                    .await
+                    .map_err(|_| StreamControlError::NotReady)?;
+                *saved = Some((source, mapping));
+                Ok(())
+            })
+            .await
+            .map_err(|_| OwnedRtpError::Refused)?;
+        let (source, mapping) = metadata.ok_or(OwnedRtpError::Refused)?;
+        *self.retained.lock().unwrap_or_else(|p| p.into_inner()) = Some(Retained {
+            core: Arc::new(core),
+            source,
+            mapping,
+        });
+        Ok(())
+    }
+    fn repair_deadline(&self) -> Option<Instant> {
+        self.retained
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .map(|r| r.core.expires_at())
+    }
+    async fn repair(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+        let (core, source, mapping) = {
+            let retained = self.retained.lock().unwrap_or_else(|p| p.into_inner());
+            let r = retained.as_ref().ok_or(OwnedRtpError::Refused)?;
+            (r.core.clone(), r.source.clone(), r.mapping)
+        };
+        core.repair(|frame, origin| async move {
+            if origin.as_ref() != Some(&source.origin) {
+                return Err(StreamControlError::Authority);
+            }
+            let input = rtp::Packet::unmarshal(&mut frame.payload.as_ref())
+                .map_err(|_| StreamControlError::Unsupported)?;
+            if input.header.ssrc != source.ssrc {
+                return Err(StreamControlError::Authority);
+            }
+            let mut packet = primary(&frame, self.ssrc, self.payload_type)?;
+            packet.header.sequence_number = mapping.sequence;
+            packet.header.timestamp = mapping.timestamp;
+            // Reuse the original wire mapping. A repair must not advance the
+            // primary timeline or restore an older source's report selection.
+            io.write_with_clock(packet, self.clock.clone(), timing(&frame, mapping.offset))
+                .await
+                .map_err(|_| StreamControlError::NotReady)
+        })
+        .await
+        .map_err(|_| OwnedRtpError::Refused)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn source(generation: u64, ssrc: u32) -> Source {
+        Source {
+            ssrc,
+            origin: MediaDeliveryOrigin {
+                connection: rvoip_core::ids::ConnectionId::from_string("source"),
+                logical: rvoip_core::ids::StreamId::from_string("video"),
+                transport: rvoip_core::ids::StreamId::from_string("transport"),
+                generation,
+            },
+        }
+    }
+    fn packet(sequence: u16, timestamp: u32) -> rtp::Packet {
+        rtp::Packet {
+            header: rtp::Header {
+                version: 2,
+                ssrc: 1,
+                sequence_number: sequence,
+                timestamp,
+                ..Default::default()
+            },
+            payload: vec![0x10, 7].into(),
+        }
+    }
+    #[test]
+    fn mapping_preserves_fragment_ticks_loss_gaps_wrap_and_refuses_duplicates() {
+        let mut t = Timeline::default();
+        let s = source(1, 1);
+        let a = t.allocate(s.clone(), &packet(65534, u32::MAX - 2)).unwrap();
+        assert_eq!((a.sequence, a.timestamp), (65534, u32::MAX - 2));
+        let a = t.allocate(s.clone(), &packet(65535, u32::MAX - 2)).unwrap();
+        assert_eq!((a.sequence, a.timestamp), (65535, u32::MAX - 2));
+        let a = t.allocate(s.clone(), &packet(1, 2)).unwrap();
+        assert_eq!((a.sequence, a.timestamp), (1, 2));
+        assert!(t.allocate(s.clone(), &packet(1, 2)).is_err());
+        assert!(t.allocate(s.clone(), &packet(0, 1)).is_err());
+        assert!(t.allocate(s.clone(), &packet(2, 1)).is_err());
+        let a = t.allocate(s, &packet(2, 3)).unwrap();
+        assert_eq!((a.sequence, a.timestamp), (2, 3));
+    }
+    #[test]
+    fn source_generation_or_ssrc_handoff_keeps_target_timeline_and_same_clock_offset() {
+        let mut t = Timeline::default();
+        t.allocate(source(1, 1), &packet(500, 90000)).unwrap();
+        let a = t.allocate(source(2, 1), &packet(1, 0)).unwrap();
+        assert_eq!((a.sequence, a.timestamp), (501, 90001));
+        assert_eq!(a.offset, 90001);
+        let b = t.allocate(source(2, 2), &packet(600, 180000)).unwrap();
+        assert_eq!((b.sequence, b.timestamp), (502, 90002));
+        assert_eq!(180000u32.wrapping_add(b.offset), 90002);
+        let c = t.allocate(source(2, 2), &packet(601, 183000)).unwrap();
+        assert_eq!((c.sequence, c.timestamp), (503, 93002));
+    }
+}
+
+#[cfg(test)]
+mod clock_tests {
+    use super::*;
+    #[test]
+    fn native_pending_and_retired_clock_provenance_are_distinct_after_translation() {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        let mut frame = MediaFrame {
+            stream_id: rvoip_core::ids::StreamId::from_string("video"),
+            kind: StreamKind::Video,
+            payload: Vec::new().into(),
+            timestamp_rtp: 9000,
+            captured_at: chrono::Utc::now(),
+            payload_type: Some(96),
+            source_clock: None,
+        };
+        assert!(timing(&frame, 500).is_none());
+        let live = Arc::new(AtomicBool::new(true));
+        let current = live.clone();
+        frame.source_clock = Some(rvoip_core::stream::MediaSourceClock {
+            source_id: 99,
+            generation: 7,
+            anchor: None,
+            supported: true,
+            rtp_offset: 100,
+            is_current: Arc::new(move || current.load(Ordering::SeqCst)),
+        });
+        let update = timing(&frame, 500).unwrap();
+        assert_eq!(
+            (update.source_id, update.generation, update.rtp_offset),
+            (99, 7, 600)
+        );
+        assert!(update.anchor.is_none());
+        assert!(update.supported);
+        assert!((update.is_current)());
+        live.store(false, Ordering::SeqCst);
+        assert!(!(update.is_current)());
+    }
+}
