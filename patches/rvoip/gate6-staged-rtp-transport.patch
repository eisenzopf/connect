+/// Runs at physical ingress before any channel buffering. Staged routes use
+/// this to reject packets while their engine generation is still inactive.
+pub trait CheckedMediaIngress: Send + Sync {
+    fn try_send(&self, frame: MediaFrame) -> Result<(), mpsc::error::TrySendError<MediaFrame>>;
+    fn capacity(&self) -> usize;
+    fn max_capacity(&self) -> usize;
+    fn is_closed(&self) -> bool;
+}
+#[derive(Clone)]
+pub enum PeerMediaIngress {
+    Channel(mpsc::Sender<MediaFrame>),
+    Checked(Arc<dyn CheckedMediaIngress>),
+}
+impl PeerMediaIngress {
+    pub fn try_send(&self, frame: MediaFrame) -> Result<(), mpsc::error::TrySendError<MediaFrame>> {
+        match self {
+            Self::Channel(tx) => tx.try_send(frame),
+            Self::Checked(ingress) => ingress.try_send(frame),
+        }
+    }
+    pub fn capacity(&self) -> usize {
+        match self {
+            Self::Channel(tx) => tx.capacity(),
+            Self::Checked(ingress) => ingress.capacity(),
+        }
+    }
+    pub fn max_capacity(&self) -> usize {
+        match self {
+            Self::Channel(tx) => tx.max_capacity(),
+            Self::Checked(ingress) => ingress.max_capacity(),
+        }
+    }
+    pub fn is_closed(&self) -> bool {
+        match self {
+            Self::Channel(tx) => tx.is_closed(),
+            Self::Checked(ingress) => ingress.is_closed(),
+        }
+    }
+}
