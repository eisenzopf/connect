+#[derive(Default)]
+pub struct StagedRtpCounters {
+    accepted: AtomicU64,
+    rejected: AtomicU64,
+    local_sends: AtomicU64,
+    send_errors: AtomicU64,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct StagedRtpSnapshot {
+    pub ingress_accepted: u64,
+    pub ingress_rejected: u64,
+    pub local_sends: u64,
+    pub send_errors: u64,
+}
+impl StagedRtpCounters {
+    pub fn snapshot(&self) -> StagedRtpSnapshot {
+        StagedRtpSnapshot {
+            ingress_accepted: self.accepted.load(Ordering::Acquire),
+            ingress_rejected: self.rejected.load(Ordering::Acquire),
+            local_sends: self.local_sends.load(Ordering::Acquire),
+            send_errors: self.send_errors.load(Ordering::Acquire),
+        }
+    }
+}
+struct PortIngress {
+    port: WeakAdapterMediaPort,
+    counters: Arc<StagedRtpCounters>,
+}
+impl CheckedMediaIngress for PortIngress {
+    fn try_send(&self, frame: MediaFrame) -> Result<(), mpsc::error::TrySendError<MediaFrame>> {
+        let result = self
+            .port
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)
+            .and_then(|p| p.try_publish(&frame));
+        match result {
+            Ok(()) => {
+                self.counters.accepted.fetch_add(1, Ordering::AcqRel);
+                Ok(())
+            }
+            Err(error) => {
+                self.counters.rejected.fetch_add(1, Ordering::AcqRel);
+                if matches!(error, StreamControlError::Backpressure) {
+                    Err(mpsc::error::TrySendError::Full(frame))
+                } else {
+                    Err(mpsc::error::TrySendError::Closed(frame))
+                }
+            }
+        }
+    }
+    fn capacity(&self) -> usize {
+        self.port.upgrade().map_or(0, |p| p.ingress_capacity().1)
+    }
+    fn max_capacity(&self) -> usize {
+        self.port.upgrade().map_or(0, |p| p.ingress_capacity().0)
+    }
+    fn is_closed(&self) -> bool {
+        self.port.upgrade().is_none_or(|p| p.ingress_is_closed())
+    }
+}
+struct RoutedStream {
+    port: AdapterMediaPort,
+    codec: CodecInfo,
+}
+#[async_trait]
+impl MediaStream for RoutedStream {
+    fn retire_delivery(&self) {
+        let _ = self.port.report_terminal();
+    }
+    fn id(&self) -> StreamId {
+        self.port.binding().transport_id.clone()
+    }
+    fn kind(&self) -> StreamKind {
+        match self.port.binding().negotiated.requested.medium {
+            Medium::Audio => StreamKind::Audio,
+            Medium::Video | Medium::Screen => StreamKind::Video,
+            Medium::Data => StreamKind::Data,
+        }
+    }
+    fn codec(&self) -> CodecInfo {
+        self.codec.clone()
+    }
+    fn direction(&self) -> Direction {
+        if self.port.binding().negotiated.requested.direction == StreamDirection::Send {
+            Direction::Outbound
+        } else {
+            Direction::Inbound
+        }
+    }
+    fn source_ready(&self) -> bool {
+        self.port.status() == PortStatus::Active && self.port.binding().source_ready
+    }
+    fn frames_in(&self) -> mpsc::Receiver<MediaFrame> {
+        mpsc::channel(1).1
+    }
+    fn try_frames_in(&self) -> CoreResult<mpsc::Receiver<MediaFrame>> {
+        Err(RvoipError::NotImplemented(
+            "staged ingress requires authorized packets",
+        ))
+    }
+    fn frames_out(&self) -> mpsc::Sender<MediaFrame> {
+        mpsc::channel(1).0
+    }
+    fn try_frames_out(&self) -> CoreResult<mpsc::Sender<MediaFrame>> {
+        Err(RvoipError::NotImplemented(
+            "staged egress requires delivery guards",
+        ))
+    }
+    fn quality_snapshot(&self) -> QualitySnapshot {
+        QualitySnapshot::default()
+    }
+    fn has_quality_measurement(&self) -> bool {
+        false
+    }
+    async fn close(self: Arc<Self>) -> CoreResult<()> {
+        self.port
+            .report_terminal()
+            .map_err(|_| RvoipError::InvalidState("staged terminal failed"))?;
+        Ok(())
+    }
+}
