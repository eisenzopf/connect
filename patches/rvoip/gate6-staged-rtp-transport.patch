+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    f.a_peer
+        .remote
+        .send_datagram(audio_datagram(
+            f.an.binding(Medium::Audio).stream_local_id,
+            160,
+        ))
+        .unwrap();
+    let packet = incoming(&mut input).await;
+    f.policy.0.write().await.private = true;
+    assert!(packet
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .is_err());
+    assert_eq!(f.ba.counters().snapshot().local_sends, 0);
+    f.stop().await;
+}
