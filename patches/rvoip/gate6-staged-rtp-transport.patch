+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rtp_codec_profiles_require_the_actual_negotiated_payload_type() {
+        let audio = MediaFormat::Encoded {
+            name: "opus".into(),
+            clock_rate_hz: 48000,
+            channels: 1,
+            fmtp: None,
+        };
+        assert!(codec(&audio, Medium::Audio, Some(111)).is_ok());
+        assert!(codec(&audio, Medium::Audio, Some(0)).is_err());
+        assert!(codec(&audio, Medium::Video, Some(111)).is_err());
+        assert!(codec(
+            &MediaFormat::ReliableOrdered(rvoip_core::capability::DataProtocol::Json),
+            Medium::Data,
+            None
+        )
+        .is_err());
+    }
+    #[test]
+    fn retired_clock_routes_cannot_reach_the_datagram_transport() {
+        struct NoSend;
+        impl StagedDatagramTransport for NoSend {
+            fn maximum_datagram_bytes(&self) -> Option<usize> {
+                Some(1200)
+            }
+            fn send_datagram(&self, _: Bytes) -> ControlResult<()> {
+                panic!("retired clock route sent")
+            }
+            fn is_closed(&self) -> bool {
+                false
+            }
+        }
+        let binding = ReadyMediaBinding {
+            negotiated: rvoip_core::stream_lifecycle::NegotiatedStream {
+                requested: rvoip_core::stream_lifecycle::DesiredStream {
+                    logical_id: StreamId::new(),
+                    medium: Medium::Audio,
+                    direction: StreamDirection::Both,
+                },
+                format: MediaFormat::Encoded {
+                    name: "pcmu".into(),
+                    clock_rate_hz: 8000,
+                    channels: 1,
+                    fmtp: None,
+                },
+            },
+            transport_id: StreamId::new(),
+            stream_local_id: 1,
+            generation: 1,
+            connection_generation: 1,
+            source_ready: true,
+            sink_ready: true,
+        };
+        let frame = MediaFrame {
+            stream_id: binding.transport_id.clone(),
+            kind: StreamKind::Audio,
+            payload: Bytes::from_static(b"encoded"),
+            timestamp_rtp: 0,
+            captured_at: chrono::Utc::now(),
+            payload_type: Some(0),
+            source_clock: Some(rvoip_core::stream::MediaSourceClock {
+                source_id: 1,
+                generation: 1,
+                anchor: None,
+                supported: true,
+                rtp_offset: 0,
+                is_current: Arc::new(|| false),
+            }),
+        };
+        let mut packetizer = Packetizer {
+            outer: 0,
+            rtp: 0,
+            ssrc: 1,
+            video: Default::default(),
+        };
+        assert!(packetizer.send(frame, &binding, 0, &NoSend).is_err());
+    }
+}
