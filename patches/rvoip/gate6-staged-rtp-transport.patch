+struct PortResources {
+    handle: Arc<RouterHandle>,
+    streams: Arc<DashMap<StreamId, Arc<dyn MediaStream>>>,
+    stream_id: StreamId,
+    stream: Mutex<Option<Weak<dyn MediaStream>>>,
+    cancel: CancellationToken,
+    task: Mutex<Option<Shared<BoxFuture<'static, Result<(), ()>>>>>,
+}
+#[async_trait]
+impl MediaPortCleanup for PortResources {
+    async fn close(&self) -> ControlResult<()> {
+        self.cancel.cancel();
+        self.handle.remove()?;
+        let stream = self
+            .stream
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .and_then(Weak::upgrade);
+        if let Some(stream) = stream {
+            self.streams
+                .remove_if(&self.stream_id, |_, value| Arc::ptr_eq(value, &stream));
+        }
+        let task = self.task.lock().unwrap_or_else(|p| p.into_inner()).clone();
+        if let Some(task) = task {
+            let result = task.await;
+            self.task.lock().unwrap_or_else(|p| p.into_inner()).take();
+            result.map_err(|_| StreamControlError::CleanupUnconfirmed)?;
+        }
+        self.stream.lock().unwrap_or_else(|p| p.into_inner()).take();
+        Ok(())
+    }
+}
+
+pub struct StagedRtpMedia {
+    scope: StagedRtpScope,
+    router: Arc<PeerMediaRouter>,
+    streams: Arc<DashMap<StreamId, Arc<dyn MediaStream>>>,
+    handles: Arc<StreamHandleAllocator>,
+    negotiator: Arc<dyn StagedRtpNegotiator>,
+    transport: Arc<dyn StagedDatagramTransport>,
+    lifetime: CancellationToken,
+    counters: Arc<StagedRtpCounters>,
+}
+impl StagedRtpMedia {
+    pub fn new(
+        scope: StagedRtpScope,
+        router: Arc<PeerMediaRouter>,
+        streams: Arc<DashMap<StreamId, Arc<dyn MediaStream>>>,
+        negotiator: Arc<dyn StagedRtpNegotiator>,
+        transport: Arc<dyn StagedDatagramTransport>,
+        lifetime: CancellationToken,
+    ) -> Arc<Self> {
+        let handles = StreamHandleAllocator::shared(Arc::new(RouterAllocator {
+            router: router.clone(),
+            owner: scope.owner.clone(),
+        }));
+        Arc::new(Self {
+            scope,
+            router,
+            streams,
+            handles,
+            negotiator,
+            transport,
+            lifetime,
+            counters: Arc::new(StagedRtpCounters::default()),
+        })
+    }
+    pub fn handle_allocator(&self) -> Arc<StreamHandleAllocator> {
+        self.handles.clone()
+    }
+    pub fn counters(&self) -> Arc<StagedRtpCounters> {
+        self.counters.clone()
+    }
+}
+fn codec(format: &MediaFormat, medium: Medium, pt: Option<u8>) -> ControlResult<CodecInfo> {
+    let MediaFormat::Encoded {
+        name,
+        clock_rate_hz,
+        channels,
+        fmtp,
+    } = format
+    else {
+        return Err(StreamControlError::Unsupported);
+    };
+    let name = name.to_ascii_lowercase();
+    let valid = match (medium, name.as_str()) {
+        (Medium::Audio, "pcmu") => {
+            *clock_rate_hz == 8000
+                && *channels == 1
+                && pt.is_none_or(|p| p == 0 || p >= 96 && p < 128)
+        }
+        (Medium::Audio, "pcma") => {
+            *clock_rate_hz == 8000
+                && *channels == 1
+                && pt.is_none_or(|p| p == 8 || p >= 96 && p < 128)
+        }
+        (Medium::Audio, "opus") => {
+            *clock_rate_hz == 48000 && *channels == 1 && pt.is_none_or(|p| p >= 96 && p < 128)
+        }
+        (Medium::Video | Medium::Screen, "vp8") => {
+            *clock_rate_hz == 90000 && *channels == 0 && pt.is_none_or(|p| p >= 96 && p < 128)
+        }
+        _ => false,
+    };
+    if !valid {
+        return Err(StreamControlError::Unsupported);
+    }
+    Ok(CodecInfo {
+        name: name.clone(),
+        clock_rate_hz: *clock_rate_hz,
+        channels: *channels,
+        fmtp: fmtp.clone(),
+        payload_type: pt,
+    })
+}
+struct Packetizer {
+    outer: u32,
+    rtp: u16,
+    ssrc: u32,
+    video: rvoip_core::video_packetizer::Vp8Packetizer,
+}
+impl Packetizer {
+    fn send(
+        &mut self,
+        frame: MediaFrame,
+        binding: &ReadyMediaBinding,
+        pt: u8,
+        transport: &dyn StagedDatagramTransport,
+    ) -> ControlResult<usize> {
+        if frame
+            .source_clock
+            .as_ref()
+            .is_some_and(|clock| !(clock.is_current)())
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let maximum = transport
+            .maximum_datagram_bytes()
+            .ok_or(StreamControlError::NotReady)?;
+        let packets = if frame.kind == StreamKind::Video {
+            let input = rvoip_core::video_bridge::normalize_packet(&frame, self.ssrc, pt)
+                .ok_or(StreamControlError::NotReady)?;
+            let packets = self
+                .video
+                .packetize(input, maximum.saturating_sub(8).min(1180))
+                .ok_or(StreamControlError::NotReady)?;
+            packets
+                .into_iter()
+                .map(|packet| {
+                    observe_rtp(packet).and_then(|rtp| {
+                        pack_observed_rtp_datagram(&ObservedRtpDatagram {
+                            flags: 0,
+                            stream_local_id: binding.stream_local_id,
+                            seq: {
+                                let seq = self.outer;
+                                self.outer = self.outer.wrapping_add(1);
+                                seq
+                            },
+                            rtp,
+                        })
+                    })
+                })
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|_| StreamControlError::NotReady)?
+        } else {
+            let packet = pack_rtp_datagram(&RtpDatagram {
+                flags: 0,
+                stream_local_id: binding.stream_local_id,
+                seq: self.outer,
+                rtp: RtpMediaPayload {
+                    payload: frame.payload,
+                    payload_type: pt,
+                    sequence_number: self.rtp,
+                    timestamp: frame.timestamp_rtp,
+                    ssrc: self.ssrc,
+                },
+            })
+            .map_err(|_| StreamControlError::NotReady)?;
+            self.outer = self.outer.wrapping_add(1);
+            self.rtp = self.rtp.wrapping_add(1);
+            vec![packet]
+        };
+        let count = packets.len();
+        for packet in packets {
+            if packet.len() > maximum {
+                return Err(StreamControlError::NotReady);
+            }
+            transport.send_datagram(packet)?;
+        }
+        Ok(count)
+    }
+}
+#[async_trait]
+impl StagedMediaAdapter for StagedRtpMedia {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<()> {
+        if self.lifetime.is_cancelled() || self.transport.is_closed() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let mut pending = Vec::new();
+        for preparation in &ports {
+            let port = &preparation.port;
+            let (_, session, connection) = port.context_ids()?;
+            if session != self.scope.session || connection != self.scope.connection {
+                return Err(StreamControlError::Authority);
+            }
+            codec(
+                &port.binding().negotiated.format,
+                port.binding().negotiated.requested.medium,
+                None,
+            )?;
+            let allocation = port
+                .allocation_owner()?
+                .downcast::<RouterHandle>()
+                .map_err(|_| StreamControlError::Authority)?;
+            if allocation.id.get() != port.binding().stream_local_id
+                || allocation.owner != self.scope.owner
+                || allocation
+                    .router
+                    .upgrade()
+                    .is_none_or(|router| !Arc::ptr_eq(&router, &self.router))
+            {
+                return Err(StreamControlError::Authority);
+            }
+            if !preparation.is_new {
+                continue;
+            }
+            // Cleanup owns only this candidate, and is registered before peer
+            // negotiation, task creation or router publication.
+            let cancel = allocation.cancellation.child_token();
+            let resources = Arc::new(PortResources {
+                handle: allocation,
+                streams: self.streams.clone(),
+                stream_id: port.binding().transport_id.clone(),
+                stream: Mutex::new(None),
+                cancel,
+                task: Mutex::new(None),
+            });
+            port.install_cleanup(resources.clone())?;
+            pending.push((port.clone(), resources));
+        }
+        if pending.is_empty() {
+            return Ok(());
+        }
+        let offers = pending
+            .iter()
+            .map(|(p, _)| p.binding().clone())
+            .collect::<Vec<_>>();
+        let answers = self
+            .negotiator
+            .prepare(&self.scope, &offers, deadline, cancellation.clone())
+            .await?;
+        if answers.len() != offers.len() {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut used = std::collections::HashSet::new();
+        for answer in &answers {
+            if !used.insert(answer.binding.transport_id.clone())
+                || !offers
+                    .iter()
+                    .any(|offer| same_binding(offer, &answer.binding))
+            {
+                return Err(StreamControlError::NotReady);
+            }
+            codec(
+                &answer.binding.negotiated.format,
+                answer.binding.negotiated.requested.medium,
+                Some(answer.payload_type),
+            )?;
+        }
+        if cancellation.is_cancelled() || self.lifetime.is_cancelled() || self.transport.is_closed()
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        for (port, resources) in pending {
+            let answer = answers
+                .iter()
+                .find(|a| a.binding.transport_id == port.binding().transport_id)
+                .ok_or(StreamControlError::NotReady)?;
+            let descriptor = codec(
+                &answer.binding.negotiated.format,
+                answer.binding.negotiated.requested.medium,
+                Some(answer.payload_type),
+            )?;
+            if self.streams.contains_key(&port.binding().transport_id) {
+                return Err(StreamControlError::NotReady);
+            }
+            let stream: Arc<dyn MediaStream> = Arc::new(RoutedStream {
+                port: port.clone(),
+                codec: descriptor,
+            });
+            let registration = PeerMediaRegistration::checked(
+                self.scope.owner.clone(),
+                PeerMediaRouteKey::new(
+                    self.scope.session.clone(),
+                    self.scope.connection.clone(),
+                    port.binding().transport_id.clone(),
+                ),
+                stream.clone(),
+                Arc::new(PortIngress {
+                    port: port.downgrade(),
+                    counters: self.counters.clone(),
+                }),
+            );
+            resources.handle.commit(registration)?;
+            *resources.stream.lock().unwrap_or_else(|p| p.into_inner()) =
+                Some(Arc::downgrade(&stream));
+            self.streams
+                .insert(port.binding().transport_id.clone(), stream);
+            let binding = port.binding().clone();
+            let pt = answer.payload_type;
+            let transport = self.transport.clone();
+            let cancel = resources.cancel.clone();
+            let lifetime = self.lifetime.clone();
+            let weak = port.downgrade();
+            let counters = self.counters.clone();
+            let mut receiver = if binding.sink_ready {
+                Some(port.take_egress()?)
+            } else {
+                None
+            };
+            let task = tokio::spawn(async move {
+                let mut packetizer = Packetizer {
+                    outer: 0,
+                    rtp: 0,
+                    ssrc: u32::from_be_bytes(
+                        uuid::Uuid::new_v4().as_bytes()[..4].try_into().unwrap(),
+                    ),
+                    video: Default::default(),
+                };
+                loop {
+                    let next = async {
+                        match receiver.as_mut() {
+                            Some(receiver) => receiver.recv().await,
+                            None => std::future::pending().await,
+                        }
+                    };
+                    let queued = tokio::select! {biased;_=cancel.cancelled()=>break,_=lifetime.cancelled()=>break,next=next=>match next {Some(value)=>value,None=>break}};
+                    let result = queued
+                        .deliver(|frame| {
+                            let result = packetizer
+                                .send(frame, &binding, pt, transport.as_ref())
+                                .map(|count| {
+                                    counters
+                                        .local_sends
+                                        .fetch_add(count as u64, Ordering::AcqRel);
+                                });
+                            std::future::ready(result)
+                        })
+                        .await;
+                    if result.is_err() {
+                        counters.send_errors.fetch_add(1, Ordering::AcqRel);
+                    }
+                    if transport.is_closed() {
+                        break;
+                    }
+                }
+                if let Some(port) = weak.upgrade() {
+                    let _ = port.report_terminal();
+                }
+            });
+            *resources.task.lock().unwrap_or_else(|p| p.into_inner()) =
+                Some(async move { task.await.map_err(|_| ()) }.boxed().shared());
+            port.observe_ready(
+                &answer.binding.negotiated.format,
+                answer.binding.source_ready,
+                answer.binding.sink_ready,
+                Some(pt),
+            )?;
+        }
+        self.negotiator
+            .confirm(&self.scope, &answers, deadline, cancellation)
+            .await?;
+        if self.lifetime.is_cancelled() || self.transport.is_closed() {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(())
+    }
+}
+fn same_binding(a: &ReadyMediaBinding, b: &ReadyMediaBinding) -> bool {
+    a.negotiated == b.negotiated
+        && a.transport_id == b.transport_id
+        && a.stream_local_id == b.stream_local_id
+        && a.generation == b.generation
+        && a.connection_generation == b.connection_generation
+        && (!a.source_ready || b.source_ready)
+        && (!a.sink_ready || b.sink_ready)
+}
