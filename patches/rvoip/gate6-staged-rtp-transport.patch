+//! Actual local QUIC/RTP routing with a controlled readiness provider. This is
+//! not public envelope-v2 authentication or a browser/provider qualification.
+use async_trait::async_trait;
+use bytes::Bytes;
+use dashmap::DashMap;
+use rvoip_core::{
+    connection::Transport,
+    identity::{AuthenticatedPrincipal, AuthenticationMethod, IdentityAssurance},
+    ids::*,
+    participant::{ParticipantKind, ParticipantRole},
+    relationships::*,
+    staged_streams::*,
+    stream_lifecycle::*,
+};
+use rvoip_uctp::{
+    staged_media::*,
+    substrate::{
+        dev_client_config_trusting, make_server_endpoint, observe_rtp, observe_rtp_datagram,
+        pack_observed_rtp_datagram, pack_rtp_datagram, self_signed_for_dev, ObservedRtpDatagram,
+        PeerMediaRouter, RtpDatagram, RtpMediaPayload,
+    },
+};
+use std::{
+    collections::{BTreeMap, BTreeSet, HashMap},
+    net::SocketAddr,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc, Mutex,
+    },
+    time::Duration,
+};
+use tokio::sync::{mpsc, Notify, OwnedRwLockReadGuard, RwLock};
+use tokio_util::sync::CancellationToken;
+
+fn pcmu() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "pcmu".into(),
+        clock_rate_hz: 8000,
+        channels: 1,
+        fmtp: None,
+    }
+}
+fn vp8() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "vp8".into(),
+        clock_rate_hz: 90000,
+        channels: 0,
+        fmtp: None,
+    }
+}
+fn desired(kind: Medium) -> DesiredStream {
+    DesiredStream {
+        logical_id: StreamId::from_string(match kind {
+            Medium::Audio => "audio",
+            Medium::Video => "video",
+            Medium::Screen => "screen",
+            Medium::Data => "data",
+        }),
+        medium: kind,
+        direction: StreamDirection::Both,
+    }
+}
+fn profile() -> EndpointMediaCapabilities {
+    let values = vec![
+        MediaCapability {
+            medium: Medium::Audio,
+            formats: vec![pcmu()],
+        },
+        MediaCapability {
+            medium: Medium::Video,
+            formats: vec![vp8()],
+        },
+        MediaCapability {
+            medium: Medium::Screen,
+            formats: vec![vp8()],
+        },
+    ];
