+struct PolicyState {
+    owners: HashMap<String, MediaOwner>,
+    private: bool,
+}
+struct Policy(Arc<RwLock<PolicyState>>);
+struct Lease {
+    owner: MediaOwner,
+    _guard: OwnedRwLockReadGuard<PolicyState>,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+impl MediaPolicy for Policy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        let mut owner = guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        if let MediaPurpose::Receive { source } = scope.purpose {
+            let original = guard
+                .owners
+                .get(source.connection.as_str())
+                .ok_or(StreamControlError::Authority)?;
+            if source.participant != *original.member.participant()
+                || source.membership_epoch != original.member.epoch()
+                || source.connection_generation != original.connection.generation()
+                || source.session != *scope.session
+                || source.conversation != *scope.conversation
+            {
+                return Err(StreamControlError::Authority);
+            }
+            owner.may_route_source = !guard.private;
+        }
+        Ok(Box::new(Lease {
+            owner,
+            _guard: guard,
+        }))
+    }
+}
+struct Negotiator {
+    offers: Mutex<BTreeMap<StreamId, ReadyMediaBinding>>,
+    hold: AtomicBool,
+    wrong: AtomicBool,
+    entered: Notify,
+    release: Notify,
+    video_pt: u8,
+}
+impl Negotiator {
+    fn new(video_pt: u8) -> Arc<Self> {
+        Arc::new(Self {
+            offers: Mutex::new(BTreeMap::new()),
+            hold: AtomicBool::new(false),
+            wrong: AtomicBool::new(false),
+            entered: Notify::new(),
+            release: Notify::new(),
+            video_pt,
+        })
+    }
+    fn binding(&self, kind: Medium) -> ReadyMediaBinding {
+        self.offers
+            .lock()
+            .unwrap()
+            .get(&desired(kind).logical_id)
+            .unwrap()
+            .clone()
+    }
+}
+#[async_trait]
+impl StagedRtpNegotiator for Negotiator {
+    async fn prepare(
+        &self,
+        _: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<Vec<PreparedRtpAnswer>> {
+        let mut answers = Vec::new();
+        for binding in offers {
+            self.offers.lock().unwrap().insert(
+                binding.negotiated.requested.logical_id.clone(),
+                binding.clone(),
+            );
+            let mut binding = binding.clone();
+            if self.wrong.load(Ordering::Acquire) {
+                binding.connection_generation += 1;
+            }
+            let pt = if binding.negotiated.requested.medium == Medium::Audio {
+                0
+            } else {
+                self.video_pt
+            };
+            answers.push(PreparedRtpAnswer {
+                binding,
+                payload_type: pt,
+            });
+        }
+        Ok(answers)
+    }
+    async fn confirm(
+        &self,
+        _: &StagedRtpScope,
+        _: &[PreparedRtpAnswer],
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<()> {
+        if self.hold.load(Ordering::Acquire) {
+            self.entered.notify_one();
+            self.release.notified().await;
+        }
+        Ok(())
+    }
+}
+struct Carrier(quinn::Connection);
+impl StagedDatagramTransport for Carrier {
+    fn maximum_datagram_bytes(&self) -> Option<usize> {
+        self.0.max_datagram_size()
+    }
+    fn send_datagram(&self, bytes: Bytes) -> ControlResult<()> {
+        self.0
+            .send_datagram(bytes)
+            .map_err(|_| StreamControlError::Backpressure)
+    }
+    fn is_closed(&self) -> bool {
+        self.0.close_reason().is_some()
+    }
+}
+struct Peer {
+    host: quinn::Connection,
+    remote: quinn::Connection,
+    _server: quinn::Endpoint,
+    _client: quinn::Endpoint,
+    router: Arc<PeerMediaRouter>,
+    lifetime: CancellationToken,
+    reader: Option<tokio::task::JoinHandle<()>>,
+}
+impl Peer {
+    async fn new() -> Self {
+        let _ = rustls::crypto::ring::default_provider().install_default();
+        let (cert, key) = self_signed_for_dev(&["localhost".into()]).unwrap();
+        let mut server_tls = rustls::ServerConfig::builder()
+            .with_no_client_auth()
+            .with_single_cert(vec![cert.clone()], key)
+            .unwrap();
+        server_tls.alpn_protocols = vec![b"staged-rtp-fixture".to_vec()];
+        let server = make_server_endpoint(
+            "127.0.0.1:0".parse::<SocketAddr>().unwrap(),
+            Arc::new(server_tls),
+            quinn::TransportConfig::default(),
+        )
+        .unwrap();
+        let mut client_tls = dev_client_config_trusting(&cert).unwrap();
+        client_tls.alpn_protocols = vec![b"staged-rtp-fixture".to_vec()];
+        let crypto = quinn::crypto::rustls::QuicClientConfig::try_from(client_tls).unwrap();
+        let mut client = quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+        client.set_default_client_config(quinn::ClientConfig::new(Arc::new(crypto)));
+        let connecting = client
+            .connect(server.local_addr().unwrap(), "localhost")
+            .unwrap();
+        let accept = async { server.accept().await.unwrap().await.unwrap() };
+        let (remote, host) = tokio::join!(connecting, accept);
+        let remote = remote.unwrap();
+        Self {
+            host,
+            remote,
+            _server: server,
+            _client: client,
+            router: PeerMediaRouter::new(),
+            lifetime: CancellationToken::new(),
+            reader: None,
+        }
+    }
+    fn start(&mut self) {
+        self.reader = Some(rvoip_quic::spawn_datagram_reader_with_cancel(
+            self.host.clone(),
+            self.router.clone(),
+            None,
+            self.lifetime.clone(),
+        ));
+    }
+    async fn stop(&mut self) {
+        self.lifetime.cancel();
+        self.router.shutdown();
+        if let Some(reader) = self.reader.take() {
+            reader.await.unwrap();
+        }
+        self.remote.close(0u32.into(), b"fixture complete");
+    }
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.lifetime.cancel();
+        if let Some(reader) = self.reader.take() {
+            reader.abort();
+        }
+    }
+}
