+//! Shared staged RTP port integration for QUIC and WebTransport adapters.
+//! Negotiation is supplied by the authenticated application profile; this
+//! module never invents peer readiness or translates legacy control commands.
+use crate::substrate::{
+    observe_rtp, pack_observed_rtp_datagram, pack_rtp_datagram, CheckedMediaIngress,
+    ObservedRtpDatagram, PeerMediaRegistration, PeerMediaReservation, PeerMediaRouteKey,
+    PeerMediaRouter, RtpDatagram, RtpMediaPayload,
+};
+use async_trait::async_trait;
+use bytes::Bytes;
+use dashmap::DashMap;
+use futures::{
+    future::{BoxFuture, Shared},
+    FutureExt,
+};
+use rvoip_core::{
+    capability::CodecInfo,
+    connection::Direction,
+    error::{Result as CoreResult, RvoipError},
+    identity::PrincipalOwnershipKey,
+    ids::{ConnectionId, SessionId, StreamId},
+    staged_streams::*,
+    stream::{MediaFrame, MediaStream, QualitySnapshot, StreamKind},
+    stream_lifecycle::{MediaFormat, Medium, ReadyMediaBinding, StreamDirection},
+};
+use std::{
+    num::NonZeroU16,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, Mutex, Weak,
+    },
+};
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+pub struct StagedRtpScope {
+    pub session: SessionId,
+    pub connection: ConnectionId,
+    pub owner: PrincipalOwnershipKey,
+    pub wire_conversation: Option<String>,
+    pub wire_session: String,
+    pub wire_connection: String,
+}
+impl std::fmt::Debug for StagedRtpScope {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("StagedRtpScope(redacted)")
+    }
+}
+#[derive(Clone, Debug)]
+pub struct PreparedRtpAnswer {
+    pub binding: ReadyMediaBinding,
+    pub payload_type: u8,
+}
+#[async_trait]
+pub trait StagedRtpNegotiator: Send + Sync {
+    /// The installed profile must validate authenticated version, exact scope,
+    /// correlation, capabilities and actual peer readiness before returning.
+    /// Offers are provisional: cancellation must leave existing media intact.
+    async fn prepare(
+        &self,
+        scope: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<Vec<PreparedRtpAnswer>>;
+    /// Confirm the peer's exact prepared routes after server ingress/egress
+    /// exist. Media received in this phase is checked and discarded, not
+    /// buffered for a later grant. This is not a public activation outcome.
+    async fn confirm(
+        &self,
+        scope: &StagedRtpScope,
+        answers: &[PreparedRtpAnswer],
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<()>;
+}
+pub trait StagedDatagramTransport: Send + Sync {
+    fn maximum_datagram_bytes(&self) -> Option<usize>;
+    /// Nonblocking local transport admission only, not remote delivery.
+    fn send_datagram(&self, bytes: Bytes) -> ControlResult<()>;
+    fn is_closed(&self) -> bool;
+}
+
+struct RouterHandle {
+    router: Weak<PeerMediaRouter>,
+    owner: PrincipalOwnershipKey,
+    id: NonZeroU16,
+    reservation: Mutex<Option<PeerMediaReservation>>,
+    committed: Mutex<bool>,
+    cancellation: CancellationToken,
+}
+impl RouterHandle {
+    fn commit(&self, registration: PeerMediaRegistration) -> ControlResult<()> {
+        let reservation = self
+            .reservation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(StreamControlError::NotReady)?;
+        reservation
+            .commit(registration)
+            .map_err(|_| StreamControlError::NotReady)?;
+        *self.committed.lock().unwrap_or_else(|p| p.into_inner()) = true;
+        Ok(())
+    }
+    fn remove(&self) -> ControlResult<()> {
+        self.reservation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take();
+        if let Some(router) = self.router.upgrade() {
+            router
+                .remove_local_id_owned(self.id, &self.owner)
+                .map_err(|_| StreamControlError::Authority)?;
+        }
+        *self.committed.lock().unwrap_or_else(|p| p.into_inner()) = false;
+        Ok(())
+    }
+}
+#[async_trait]
+impl MediaPortCleanup for RouterHandle {
+    async fn close(&self) -> ControlResult<()> {
+        // Fallback only for a port whose adapter preparation never began.
+        if *self.committed.lock().unwrap_or_else(|p| p.into_inner()) {
+            return Err(StreamControlError::CleanupUnconfirmed);
+        }
+        self.remove()
+    }
+}
+struct RouterAllocator {
+    router: Arc<PeerMediaRouter>,
+    owner: PrincipalOwnershipKey,
+}
+impl StreamHandleReserver for RouterAllocator {
+    fn reserve(&self) -> ControlResult<StreamHandleAllocation> {
+        let reservation = self.router.reserve().map_err(|_| {
+            StreamControlError::from(rvoip_core::stream_lifecycle::MediaTransitionError::Capacity)
+        })?;
+        let handle = Arc::new(RouterHandle {
+            router: Arc::downgrade(&self.router),
+            owner: self.owner.clone(),
+            id: reservation.local_id(),
+            cancellation: reservation.cancellation_token(),
+            reservation: Mutex::new(Some(reservation)),
+            committed: Mutex::new(false),
+        });
+        Ok(
+            StreamHandleAllocation::new(handle.id.get(), handle.clone())?
+                .with_unprepared_cleanup(handle),
+        )
+    }
+}
