+        scopes: vec![],
+        issuer: Some("local-fixture".into()),
+        expires_at: Some(chrono::Utc::now() + chrono::Duration::hours(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Anonymous,
+    }
