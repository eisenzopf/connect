+async fn picture_feedback(
+    pictures: PictureRequests,
+    requests: Arc<tokio::sync::Notify>,
+    routes: Weak<DashMap<ConnectionId, Arc<Route>>>,
+    picture_next: Arc<tokio::sync::Mutex<tokio::time::Instant>>,
+    stop: CancellationToken,
+) -> ControlResult<()> {
+    loop {
+        tokio::select! {biased; _=stop.cancelled()=>return Ok(()), _=requests.notified()=>{}}
+        // Coalesce while waiting without retaining a Core/Store reader.
+        let mut next = tokio::select! {biased; _=stop.cancelled()=>return Ok(()), next=picture_next.lock()=>next};
+        tokio::select! {biased; _=stop.cancelled()=>return Ok(()), _=tokio::time::sleep_until(*next)=>{}}
+        *next = tokio::time::Instant::now() + Duration::from_millis(250);
+        drop(next);
+        let routes = routes.clone();
+        let forward = pictures.forward(move |origin, ssrc| async move {
+            let routes = routes.upgrade().ok_or(StreamControlError::Cancelled)?;
+            let route = routes
+                .get(&origin.connection)
+                .map(|entry| entry.value().clone())
+                .ok_or(StreamControlError::NotReady)?;
+            let backend = route
+                .installation
+                .try_lock()
+                .map_err(|_| StreamControlError::NotReady)?
+                .as_ref()
+                .map(|installation| installation.backend.clone())
+                .ok_or(StreamControlError::NotReady)?;
+            if !backend.current() || route.cancel.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            let io = backend
+                .ports
+                .get(&origin.transport)
+                .map(|entry| entry.value().clone())
+                .ok_or(StreamControlError::NotReady)?;
+            let current = || {
+                backend.current()
+                    && !route.cancel.is_cancelled()
+                    && routes
+                        .get(&origin.connection)
+                        .is_some_and(|entry| Arc::ptr_eq(entry.value(), &route))
+                    && io.binding.transport_id == origin.transport
+                    && io.binding.negotiated.requested.logical_id == origin.logical
+                    && io.binding.generation == origin.generation
+                    && io.binding.source_ready
+                    && io.health.ready.load(Ordering::Acquire)
+                    && !io.health.stop.is_cancelled()
+                    && io
+                        .port
+                        .upgrade()
+                        .is_some_and(|port| port.status() == PortStatus::Active)
+            };
+            if !current() {
+                return Err(StreamControlError::NotReady);
+            }
+            let peer = backend
+                .physical
+                .peer(tokio::time::Instant::now() + Duration::from_millis(100))
+                .await
+                .map_err(|_| StreamControlError::NotReady)?;
+            if !current() {
+                return Err(StreamControlError::NotReady);
+            }
+            // This queues only PLI on the exact original DTLS peer. Subsequent
+            // source media still needs its ordinary fresh guarded delivery.
+            peer.request_picture_for_source(ssrc)
+                .await
+                .map_err(|_| StreamControlError::NotReady)
+        });
+        tokio::select! {biased; _=stop.cancelled()=>return Ok(()), _=tokio::time::timeout(Duration::from_millis(100), forward)=>{}}
+    }
+}
