+/// One latest successful delivery, with no idle permission reader. A picture
+/// request is a bounded control hint, not a media delivery or replay grant.
+/// Reuse the existing original-age/attempt bound and fresh Core route checks.
+#[derive(Clone, Default)]
+pub(crate) struct PictureRequests(Arc<Mutex<Option<Retained>>>);
+impl PictureRequests {
+    pub(crate) async fn forward<F, Fut>(&self, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(MediaDeliveryOrigin, u32) -> Fut + Send,
+        Fut: std::future::Future<Output = ControlResult<()>> + Send,
+    {
+        let retained = self
+            .0
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .clone()
+            .ok_or(StreamControlError::NotReady)?;
+        let source = retained.source;
+        retained
+            .core
+            .repair(move |frame, origin| async move {
+                if origin.as_ref() != Some(&source.origin) {
+                    return Err(StreamControlError::Authority);
+                }
+                let packet = rtp::Packet::unmarshal(&mut frame.payload.as_ref())
+                    .map_err(|_| StreamControlError::Unsupported)?;
+                if packet.header.ssrc != source.ssrc {
+                    return Err(StreamControlError::Authority);
+                }
+                send(source.origin, source.ssrc).await
+            })
+            .await
+    }
 }
