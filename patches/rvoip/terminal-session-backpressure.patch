+#[tokio::test(start_paused = true)]
+async fn terminal_backpressure_has_one_bounded_budget_and_fails_closed() {
+    for (wire_full, events_full) in [(true, false), (false, true), (true, true)] {
+        let bindings = PeerResourceBindings::new(Arc::new(TerminalResolver {
+            current: Arc::new(AtomicBool::new(true)),
+            ended: Arc::new(AtomicBool::new(true)),
+        }));
+        bindings
+            .authenticate(AuthenticatedPrincipal::anonymous())
+            .unwrap();
+        let terminal = SessionId::from_string("terminal");
+        bindings.bind_session(&terminal).unwrap();
+        bindings
+            .bind_session(&SessionId::from_string("other"))
+            .unwrap();
+        let (_in_tx, in_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+        let (out_tx, _out_rx) = mpsc::channel(1);
+        let (events_tx, _events_rx) = mpsc::channel(1);
+        if wire_full {
+            out_tx
+                .try_send(crate::envelope::UctpEnvelope::new(
+                    crate::types::MessageType::Ack,
+                    serde_json::json!({}),
+                ))
+                .unwrap();
+        }
+        if events_full {
+            events_tx
+                .try_send(UctpSessionEvent::SessionEnded {
+                    sid: SessionId::from_string("occupied"),
+                    reason: "fixture".into(),
+                })
+                .unwrap();
+        }
+        let coordinator = UctpCoordinator::start(
+            "test",
+            in_rx,
+            out_tx,
+            events_tx,
+            rvoip_auth_core::bearer_stub(),
+        );
+        coordinator.set_resource_bindings(bindings.clone()).unwrap();
+        let started = tokio::time::Instant::now();
+        let result = tokio::time::timeout(
+            Duration::from_secs(4),
+            coordinator.retire_authorized_terminal_session(&terminal),
+        )
+        .await
+        .expect("critical backpressure must not consume ordinary signaling timeouts");
+        assert!(result.is_err());
+        assert!(started.elapsed() <= Duration::from_secs(3));
+        // Critical delivery failure fails the whole peer closed: no retained
+        // sibling media survives and cancellation wakes its coupled supervisor.
+        assert!(bindings.core_session(&terminal).is_none());
+        assert!(bindings
+            .core_session(&SessionId::from_string("other"))
+            .is_none());
+        assert_eq!(coordinator.resource_snapshot().connections, 0);
+        tokio::time::timeout(Duration::ZERO, coordinator.cancelled())
+            .await
+            .unwrap();
+    }
+}
