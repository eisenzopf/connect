+#[tokio::test(start_paused = true)]
+async fn terminal_adapter_event_is_independent_of_a_saturated_wire_queue() {
+    let bindings = PeerResourceBindings::new(Arc::new(TerminalResolver {
+        current: Arc::new(AtomicBool::new(true)),
+        ended: Arc::new(AtomicBool::new(true)),
+    }));
+    bindings
+        .authenticate(AuthenticatedPrincipal::anonymous())
+        .unwrap();
+    let terminal = SessionId::from_string("terminal");
+    bindings.bind_session(&terminal).unwrap();
+    let (_in_tx, in_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let (out_tx, _out_rx) = mpsc::channel(1);
+    let (events_tx, mut events_rx) = mpsc::channel(1);
+    out_tx
+        .try_send(crate::envelope::UctpEnvelope::new(
+            crate::types::MessageType::Ack,
+            serde_json::json!({}),
+        ))
+        .unwrap();
+    let coordinator = UctpCoordinator::start(
+        "test",
+        in_rx,
+        out_tx,
+        events_tx,
+        rvoip_auth_core::bearer_stub(),
+    );
+    coordinator.set_resource_bindings(bindings.clone()).unwrap();
+    let retirement = coordinator.clone();
+    let task = tokio::spawn(async move {
+        retirement
+            .retire_authorized_terminal_session(&terminal)
+            .await
+    });
+    let event = tokio::time::timeout(Duration::from_millis(100), events_rx.recv())
+        .await
+        .expect("media teardown event must not wait for wire capacity")
+        .unwrap();
+    assert!(
+        matches!(event, UctpSessionEvent::SessionEnded { sid, .. } if sid.as_str() == "terminal")
+    );
+    assert!(!task.is_finished());
+    assert!(bindings
+        .core_session(&SessionId::from_string("terminal"))
+        .is_none());
+    assert!(tokio::time::timeout(Duration::from_secs(3), task)
+        .await
+        .unwrap()
+        .unwrap()
+        .is_err());
+}
