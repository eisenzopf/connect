     /// terminal signaling and adapter-event delivery. Other Sessions and
     /// application pending replies remain owned by the existing coordinator.
     pub async fn retire_authorized_terminal_session(&self, sid: &SessionId) -> Result<()> {
+        // One shared two-second budget covers both independent deliveries.
+        // The adapter event must not wait behind a congested wire queue:
+        // it owns route/stream cancellation even if the peer ignores signaling.
+        let started = tokio::time::Instant::now();
+        let delivery_deadline = started + Duration::from_secs(2);
+        let terminal_deadline = started + Duration::from_secs(3);
         self.remove_session_resources(sid);
         let payload = payloads::session::SessionEnd {
             by: "local".into(),
             reason_code: 0,
             reason: "durable-session-ended".into(),
         };
-        self.send_out(
-            UctpEnvelope::new(MessageType::SessionEnd, serde_json::to_value(payload)?)
-                .with_sid(sid.to_string()),
-        )
-        .await?;
-        self.emit_event(UctpSessionEvent::SessionEnded {
+        let envelope = UctpEnvelope::new(MessageType::SessionEnd, serde_json::to_value(payload)?)
+            .with_sid(sid.to_string());
+        let event = UctpSessionEvent::SessionEnded {
             sid: sid.clone(),
             reason: "durable-session-ended".into(),
+        };
+        let delivery = tokio::time::timeout_at(delivery_deadline, async {
+            tokio::join!(self.send_out(envelope), self.emit_event(event))
         })
-        .await
+        .await;
+        if matches!(delivery, Ok((Ok(()), Ok(())))) {
+            return Ok(());
+        }
+        // Critical backpressure cannot retain old media or consume the
+        // ordinary ten-second signaling drain. Abort the peer immediately;
+        // its supervisor observes completed shutdown and cancels all pumps.
+        self.cancel.cancel();
+        // The absolute terminal budget also bounds the owned driver abort.
+        // Cancellation is already visible to the coupled peer supervisor and
+        // its media workers even if an application callback delays its driver.
+        let _ = tokio::time::timeout_at(terminal_deadline, self.abort()).await;
+        Err(UctpError::Closed)
     }
 
