+use super::*;
+use crate::staged_streams::{audio_subscriptions::*, media_scene::GuardedMediaScene};
+struct Scene {
+    f: Fixture,
+    scene: Arc<GuardedMediaScene>,
+}
+impl Scene {
+    async fn new() -> Self {
+        Self::with_policy(None).await
+    }
+    async fn with_policy(
+        factory: Option<Box<dyn FnOnce(Arc<Policy>) -> Arc<dyn MediaPolicy>>>,
+    ) -> Self {
+        let f = Fixture::with_policy(16, factory);
+        f.start_unsubscribed(&[Medium::Data]).await;
+        let scene = GuardedMediaScene::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            f.a.policy.clone(),
+            8000,
+        );
+        for c in [&f.a, &f.b] {
+            let mut m = scene.prepare(c.clone()).unwrap();
+            m.quiesce(deadline(), CancellationToken::new())
+                .await
+                .unwrap();
+            scene.insert(c.connection.clone(), m, true);
+        }
+        Self { f, scene }
+    }
+    fn person(&self) -> AudioSubscription {
+        AudioSubscription::Participant(self.f.a.origin_member.participant().clone())
+    }
+    async fn change(&self, change: AudioSubscriptionChange) -> ControlResult<u64> {
+        self.scene
+            .change_subscriptions(
+                &self.f.b.connection,
+                self.f.b.revision(),
+                change,
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+    }
+    async fn add(&self, controller: &Arc<StreamController>, logical: &str) {
+        self.add_unadopted(controller, logical).await;
+        self.scene.tick();
+    }
+    async fn add_unadopted(&self, controller: &Arc<StreamController>, logical: &str) {
+        controller
+            .change(
+                controller.revision(),
+                &[
+                    desired(Medium::Data),
+                    DesiredStream {
+                        logical_id: StreamId::from_string(logical),
+                        medium: Medium::Audio,
+                        direction: StreamDirection::Both,
+                    },
+                ],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+    }
+    fn port(&self, controller: &StreamController, logical: &str) -> AdapterMediaPort {
+        AdapterMediaPort(
+            controller.state.lock().unwrap().active[&StreamId::from_string(logical)].clone(),
+        )
+    }
+    fn signal(&self, logical: &str, value: i16) -> ControlResult<()> {
+        let port = self.port(&self.f.a, logical);
+        let mut value_frame = frame(&port, 160);
+        let mut codec =
+            rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1))
+                .unwrap();
+        value_frame.payload = codec
+            .encode(&rvoip_media_core::AudioFrame {
+                samples: vec![value; 160],
+                sample_rate: 8000,
+                channels: 1,
+                duration: Duration::from_millis(20),
+                timestamp: 160,
+            })
+            .unwrap()
+            .into();
+        port.try_publish(&value_frame)
+    }
