+async fn heard(out: &mut mpsc::Receiver<QueuedMedia>, expected: i16) {
+    outgoing(out)
+        .await
+        .deliver(|f| async move {
+            let mut codec = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                0,
+                Some(8000),
+                Some(1),
+            )
+            .unwrap();
+            let samples = codec.decode(&f.payload).unwrap().samples;
+            assert_eq!(samples.len(), 160);
+            assert!((i32::from(samples[80]) - i32::from(expected)).abs() < 350);
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
