+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        if guard.denied.contains(scope.connection) || guard.denied.contains(&source.connection) {
+            return Err(StreamControlError::Authority);
+        }
+        let original = guard
+            .owners
+            .get(&source.connection)
+            .ok_or(StreamControlError::Authority)?;
+        original
+            .member
+            .revalidate_principal(&source.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        if source.conversation != *scope.conversation
+            || source.session != *scope.session
+            || source.conversation != *original.member.conversation()
+            || source.session != *original.presence.session()
+            || source.connection != *original.connection.connection()
+            || source.participant != *original.member.participant()
+            || source.membership_epoch != original.member.epoch()
+            || source.identity != *original.member.identity()
+            || original.connection.state() != BindingState::Active
+            || source.medium != Medium::Audio
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut owner = guard
+            .owners
+            .get(scope.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        owner.may_route_source = !guard.private;
+        Ok(Box::new(MediaLease {
+            owner,
+            _guard: guard,
+        }))
+    }
