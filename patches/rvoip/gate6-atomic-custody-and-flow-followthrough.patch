+
+#[tokio::test]
+async fn combined_native_rtp_observation_counts_each_acceptance_once_across_quality_reset() {
+    for kind in ["quic", "wt"] {
+        let (mut s, handle, mut input) = prepare(kind).await;
+        gate_reply(&mut s, tune(300), "ack").await;
+        // Readiness has already been proved by the original accepted packet.
+        // Subsequent IO must count once, without requiring another ready event.
+        for (sequence, count) in [(2_u16, 3_u64), (5, 2)] {
+            let mut expected_bytes = 0_u64;
+            for offset in 0..count {
+                let frame = audio_sequence(handle, sequence + offset as u16);
+                expected_bytes += frame.len() as u64;
+                send(&s.wire, frame);
+                let _original = packet(&mut input).await;
+            }
+            let report = quality(&mut s.wire).await;
+            s.f.verify_server(&report).await;
+            let payload = &report.original()["payload"];
+            let stream = &payload["streams"][0];
+            assert_eq!(payload["streams"].as_array().unwrap().len(), 1);
+            assert_eq!(stream["packets_received"], count);
+            assert_eq!(stream["packets_sent"], 0);
+            assert_eq!(
+                stream["bitrate_bps"],
+                expected_bytes * 8000 / payload["interval_ms"].as_u64().unwrap()
+            );
+        }
+        s.wire.server.shutdown().await.unwrap();
+    }
+}
