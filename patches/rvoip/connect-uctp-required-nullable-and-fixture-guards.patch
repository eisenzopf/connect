 #[test]
+fn active_speaker_typed_payload_requires_explicit_nullable_participant() {
+    let mut value = sample("stream.active-speaker")["payload"].clone();
+    value["active_participant"] = Value::Null;
+    let silence: super::payloads::StreamActiveSpeaker =
+        serde_json::from_value(value.clone()).unwrap();
+    assert!(silence.active_participant.is_none());
+    let serialized = serde_json::to_value(silence).unwrap();
+    assert!(serialized.as_object().unwrap().contains_key("active_participant"));
+    assert!(serialized["active_participant"].is_null());
+
+    value["active_participant"] = json!("participant_actual");
+    let active: super::payloads::StreamActiveSpeaker =
+        serde_json::from_value(value.clone()).unwrap();
+    assert_eq!(
+        active.active_participant.as_ref().unwrap().as_str(),
+        "participant_actual"
+    );
+    for invalid in [json!(37), json!("invalid/participant"), json!(true)] {
+        value["active_participant"] = invalid;
+        assert!(serde_json::from_value::<super::payloads::StreamActiveSpeaker>(value.clone())
+            .is_err());
+    }
+    value.as_object_mut().unwrap().remove("active_participant");
+    assert!(serde_json::from_value::<super::payloads::StreamActiveSpeaker>(value).is_err());
+}
