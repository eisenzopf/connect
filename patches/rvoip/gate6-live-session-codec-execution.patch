+}
+impl NativeSessionCodecInvocation {
+    pub(crate) fn new(
+        plan: NativeSessionCodecPlan,
+        operation: String,
+        authority: super::auth_dispatch::AuthorityLease,
+    ) -> Arc<Self> {
+        let deadline = authority
+            .deadline()
+            .unwrap_or(plan.origin.deadline())
+            .min(plan.origin.deadline())
+            .min(tokio::time::Instant::now() + std::time::Duration::from_secs(30));
+        let cancel = plan.origin.cancellation().child_token();
+        Arc::new(Self {
+            plan,
+            operation,
+            authority,
+            deadline,
+            cancel,
+            confirmation: std::sync::Mutex::new(None),
+        })
+    }
+    pub fn plan(&self) -> &NativeSessionCodecPlan {
+        &self.plan
+    }
+    pub fn scope(&self) -> &NativeRequestScope {
+        self.plan.scope()
+    }
+    pub fn operation(&self) -> &str {
+        &self.operation
+    }
+    pub fn current(&self) -> bool {
+        self.plan.origin.current()
+            && self.authority.current()
+            && !self.cancel.is_cancelled()
+            && tokio::time::Instant::now() < self.deadline
+            && self
+                .confirmation
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .is_none_or(|f| f.current())
+    }
+    pub fn authority<T: std::any::Any + Send + Sync>(&self) -> Option<&T> {
+        self.current()
+            .then(|| self.authority.authority::<T>())
+            .flatten()
+    }
+    pub fn deadline(&self) -> tokio::time::Instant {
+        self.deadline
+    }
+    pub fn cancellation(&self) -> tokio_util::sync::CancellationToken {
+        self.cancel.child_token()
+    }
+    pub(crate) fn committed(&self) {
+        self.confirmation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take();
+    }
