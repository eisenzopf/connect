+    async fn authorize_codec(
+        &self,
+        scope: &NativeRequestScope,
+        plan: &NativeSessionCodecPlan,
+        operation: &str,
+    ) -> Result<super::auth_dispatch::AuthorityLease, super::auth_dispatch::DispatchError>;
+}
+/// Historical metadata sealed only after a confirmed local commit, or a
