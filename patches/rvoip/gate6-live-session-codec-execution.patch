+    fn current(&self) -> bool {
+        self.current()
+    }
+    fn origin(&self) -> &Arc<NativeRequestOrigin> {
+        &self.plan.origin
+    }
+    fn lease(&self) -> super::auth_dispatch::AuthorityLease {
+        self.authority.retained()
+    }
+    fn cancellation(&self) -> tokio_util::sync::CancellationToken {
+        self.cancellation()
+    }
+    fn confirmed(
+        &self,
+        reply: &super::native_requests::NativeRequestReply,
+    ) -> Result<(), NativeOfferError> {
+        if !reply.current() || reply.scope().stream_revision != self.scope().stream_revision {
+            return Err(NativeOfferError::Cancelled);
