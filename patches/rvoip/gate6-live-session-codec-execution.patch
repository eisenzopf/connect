+#[async_trait]
+impl NativeSessionCodecPolicy for Policy {
+    async fn authorize_codec(
+        &self,
+        scope: &NativeRequestScope,
+        plan: &NativeSessionCodecPlan,
+        operation: &str,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let wire = self.wire.grants.clone().read_owned().await;
+        let guard = self.domain.0.clone().read_owned().await;
+        let proof = FreshProof {
+            domain: self.domain.clone(),
+            wire_domain: self.wire.clone(),
+            guard,
+            wire,
+            principal: scope.origin.principal.clone(),
+            plan: plan.media().clone(),
+            expected: plan.expected_revision(),
+            operation: operation.into(),
+            proposal: Mutex::new(None),
+        };
+        validate(&proof, scope)?;
+        // This controlled fixture models once-only admission. Production must
+        // use its durable journal; no test reader is kept between attempts.
+        if !self.operations.lock().unwrap().insert(operation.into()) {
+            return Err(DispatchError::SubmissionUnknown);
+        }
+        self.reads.fetch_add(1, Ordering::AcqRel);
+        Ok(AuthorityLease::holding(proof))
+    }
+}
+#[async_trait]
+impl NativeRequestPolicy for Policy {
+    async fn authorize(
+        &self,
+        scope: &NativeRequestScope,
+        proposal: &Envelope,
+        held: Option<&AuthorityLease>,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let held = held.ok_or(DispatchError::Authority)?;
+        let p = held
+            .authority::<FreshProof>()
+            .ok_or(DispatchError::Authority)?;
+        validate(p, scope)?;
+        if !held.current()
+            || !Arc::ptr_eq(&self.domain, &p.domain)
+            || !Arc::ptr_eq(&self.wire, &p.wire_domain)
+            || proposal.kind() != "connection.offer"
+            || proposal.expected_revision() != Some(scope.stream_revision)
+            || proposal.scope(Scope::Operation) != Some(p.operation.as_str())
+            || proposal.scope(Scope::Conversation) != Some("conversation")
+            || proposal.scope(Scope::Session) != Some("session")
+            || proposal.scope(Scope::Connection)
+                != Some(scope.origin.media.wire_connection.as_str())
+        {
+            return Err(DispatchError::Authority);
+        }
+        let mut recorded = p.proposal.lock().unwrap();
+        if recorded
+            .as_ref()
+            .is_some_and(|old| !server_requests::matches_proposal(old, proposal))
+        {
+            return Err(DispatchError::Authority);
+        }
+        *recorded = Some(proposal.clone());
+        self.held.fetch_add(1, Ordering::AcqRel);
+        Ok(held.retained())
+    }
+}
+pub(super) fn reply(
+    c: &ValidatedBearer,
+    request: &Envelope,
+    response: &Envelope,
+    held: &AuthorityLease,
+) -> Option<Result<ExchangeReplyAuthority, DispatchError>> {
+    let p = held.authority::<FreshProof>()?;
+    Some((|| {
+        if !held.current()
+            || p.guard.denied
+            || p.wire.denied
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &c.principal,
+                &p.principal,
+            )
+            || !p
+                .proposal
+                .lock()
+                .unwrap()
+                .as_ref()
+                .is_some_and(|v| server_requests::matches_proposal(v, request))
+            || response.scope(Scope::Reply) != Some(request.id())
+            || [
+                Scope::Conversation,
+                Scope::Session,
+                Scope::Connection,
+                Scope::Operation,
+            ]
+            .into_iter()
+            .any(|s| request.scope(s) != response.scope(s))
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        let key = PrincipalVerificationKey::from_current(
+            &c.principal,
+            "client".into(),
+            p.guard.key.clone(),
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        Ok(ExchangeReplyAuthority {
+            lease: held.retained(),
+            key,
+        })
+    })())
+}
+
+struct Held {
+    inv: Arc<NativeSessionCodecInvocation>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for Held {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        if !self.inv.current() {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(Box::new(self.owner.clone()))
+    }
+    fn control_receive(&self, source: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        let p = self
+            .inv
+            .authority::<FreshProof>()
+            .ok_or(StreamControlError::Authority)?;
+        subscriptions::receive(&p.guard, *self.control_owner()?, source)
+    }
+}
+pub(super) fn held(
+    domain: &Grants,
+    scope: &MediaScope<'_>,
+    intent: &MediaControlIntent<'_>,
+    held: &(dyn Any + Send + Sync),
+) -> Option<ControlResult<MediaControl>> {
+    let inv = held.downcast_ref::<Arc<NativeSessionCodecInvocation>>()?;
+    Some((|| {
+        let p = inv
+            .authority::<FreshProof>()
+            .ok_or(StreamControlError::Authority)?;
+        validate(p, inv.scope()).map_err(|_| StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&domain.0, &p.domain.0)
+            || scope.connection != &inv.scope().origin.media.connection
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                scope.principal,
+                &inv.scope().origin.principal,
+            )
+            || inv.plan().media().selected() != p.plan.selected()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        match intent {
+            MediaControlIntent::Change {
+                expected,
+                desired,
+                replace,
+            } if *expected == p.expected
+                && replace.is_empty()
+                && desired
+                    .iter()
+                    .eq(p.plan.selected().iter().map(|s| &s.requested)) =>
+            {
+                ()
+            }
+            _ => return Err(StreamControlError::Authority),
+        }
+        let mut owner = credential_owner(
+            p.guard
+                .owners
+                .get(scope.connection)
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            scope.principal,
+        )?;
+        if let Some(a) = p.guard.activations.lock().unwrap().get(scope.connection) {
+            owner = a.current(owner)?;
+        }
+        owner.remote = p.plan.remote_capabilities().clone();
+        MediaControl::new(
+            Box::new(Held {
+                inv: inv.clone(),
+                owner,
+            }),
+            inv.cancellation(),
+            inv.deadline(),
+        )
+    })())
+}
+async fn setup(kind: &str) -> (Scene, Arc<NativeRequestOrigin>, Arc<Policy>) {
+    let mut s = Scene::new(kind, false).await;
+    s.record.server_requests.store(true, Ordering::Release);
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendrecv")).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    core_fixture::until(|| s.record.request_origins.lock().unwrap().contains_key(&s.id)).await;
+    let origin = s.record.request_origins.lock().unwrap()[&s.id].clone();
+    core_fixture::until(|| origin.ready()).await;
+    let policy = Policy::new(&s);
+    (s, origin, policy)
+}
+fn execute(
+    s: &Scene,
+    plan: NativeSessionCodecPlan,
+    operation: &str,
+    policy: Arc<Policy>,
+) -> tokio::task::JoinHandle<Result<NativeSessionCodecOutcome, NativeSessionCodecError>> {
+    let adapter = s.native.adapters[&s.kind].clone();
+    let id = s.id.clone();
+    let operation = operation.to_owned();
+    tokio::spawn(async move {
+        adapter
+            .execute_native_session_codecs(&id, plan, operation, policy)
+            .await
+    })
+}
+fn plan(s: &Scene, origin: &Arc<NativeRequestOrigin>, codec: &str) -> NativeSessionCodecPlan {
+    s.native.adapters[&s.kind]
+        .plan_native_session_codecs(&s.id, origin, &[codec.into()])
+        .unwrap()
+}
+#[tokio::test]
+async fn actual_session_codec_execution_confirms_live_replacement_preserves_old_audio_and_has_noop_without_io(
+) {
+    for kind in ["quic", "wt"] {
+        let (mut s, origin, policy) = setup(kind).await;
+        let controller = s.controller();
+        let old = controller.active_bindings()[0].clone();
+        let first = StreamId::from_string("first");
+        let mut input = controller.take_ingress(&first).unwrap();
+        let selected = plan(&s, &origin, "pcma");
+        assert!(selected.changes_resources());
+        let task = execute(&s, selected, "live_pcma", policy.clone());
+        let callback = s.wire.read().await;
+        s.f.verify_server(&callback).await;
+        assert_eq!(callback.kind(), "connection.offer");
+        assert_eq!(callback.scope(Scope::Operation), Some("live_pcma"));
+        assert_eq!(callback.original()["expected_revision"], 1);
+        assert_eq!(
+            callback.original()["payload"]["streams_offered"][0]["codec_preferences"],
+            json!(["pcma"])
+        );
+        assert_eq!(controller.revision(), 1);
+        assert_eq!(
+            controller.active_bindings()[0].transport_id,
+            old.transport_id
+        );
+        send(&s.wire, encoded_audio(old.stream_local_id, 0, 1));
+        packet(&mut input)
+            .await
+            .try_forward_to(&controller, &first)
+            .unwrap();
+        decoded_codec(&received(&s.wire).await, 0);
+        let domain = s.grants.0.clone();
+        let writer = tokio::spawn(async move { domain.write_owned().await });
+        tokio::task::yield_now().await;
+        assert!(!writer.is_finished());
+        s.confirm(&callback).await;
+        let outcome = task.await.unwrap().unwrap();
+        assert_eq!(outcome.revision(), 2);
+        assert!(outcome.resources_changed());
+        assert_eq!(outcome.operation(), "live_pcma");
+        assert_eq!(outcome.scope().stream_revision, 1);
+        assert_eq!(controller.revision(), 2);
+        drop(
+            tokio::time::timeout(Duration::from_secs(1), writer)
+                .await
+                .unwrap()
+                .unwrap(),
+        );
+        let current = controller.active_bindings()[0].clone();
+        assert_ne!(old.stream_local_id, current.stream_local_id);
+        assert_eq!(outcome.bindings()[0].transport_id, current.transport_id);
+        let mut input = controller.take_ingress(&first).unwrap();
+        send(&s.wire, encoded_audio(old.stream_local_id, 0, 2));
+        assert!(
+            tokio::time::timeout(Duration::from_millis(50), input.recv())
+                .await
+                .is_err()
+        );
+        send(&s.wire, encoded_audio(current.stream_local_id, 8, 3));
+        packet(&mut input)
+            .await
+            .try_forward_to(&controller, &first)
+            .unwrap();
+        decoded_codec(&received(&s.wire).await, 8);
+        let selected = plan(&s, &origin, "pcma");
+        assert!(!selected.changes_resources());
+        let budget = controller.stream_open_budget();
+        let nochange = execute(&s, selected, "live_pcma_nochange", policy.clone())
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(!nochange.resources_changed());
+        assert_eq!(nochange.revision(), 2);
+        assert_eq!(controller.stream_open_budget(), budget);
+        assert!(
+            tokio::time::timeout(Duration::from_millis(50), s.wire.reader.next())
+                .await
+                .is_err()
+        );
+        let repeated = execute(&s, plan(&s, &origin, "pcmu"), "live_pcma", policy.clone())
+            .await
+            .unwrap()
+            .unwrap_err();
+        assert!(!repeated.effect_possible);
+        assert_eq!(controller.revision(), 2);
+        assert!(policy.held.load(Ordering::Acquire) > 0);
+        assert_eq!(policy.reads.load(Ordering::Acquire), 2);
+        // Retaining historical outcomes keeps neither authorization reader nor
+        // an exchange alive, even though the physical origin remains usable.
+        drop(s.grants.0.clone().try_write_owned().unwrap());
+        drop(s.wire_policy.grants.clone().try_write_owned().unwrap());
+        assert_eq!(outcome.revision(), 2);
+        assert_eq!(nochange.revision(), 2);
+        s.wire.server.shutdown().await.unwrap();
+    }
+}
+#[tokio::test]
+async fn actual_session_codec_execution_refuses_current_denial_stale_revision_and_mismatched_confirmation_without_retry(
+) {
+    let (mut s, origin, policy) = setup("quic").await;
+    let controller = s.controller();
+    let first = StreamId::from_string("first");
+    let selected = plan(&s, &origin, "pcma");
+    s.grants.0.write().await.denied = true;
+    let denial = execute(&s, selected, "denied", policy.clone())
+        .await
+        .unwrap()
+        .unwrap_err();
+    assert!(!denial.effect_possible);
+    assert_eq!(controller.revision(), 1);
+    s.grants.0.write().await.denied = false;
+    let stale = plan(&s, &origin, "pcma");
+    gate_reply(
+        &mut s,
+        gate_command("mute", 1, Some(&["first"]), None),
+        "ack",
+    )
+    .await;
+    let failure = execute(&s, stale, "stale", policy.clone())
+        .await
+        .unwrap()
+        .unwrap_err();
+    assert!(!failure.effect_possible);
+    assert_eq!(controller.revision(), 2);
+    gate_reply(
+        &mut s,
+        gate_command("unmute", 2, Some(&["first"]), None),
+        "ack",
+    )
+    .await;
+    let old = controller.active_bindings()[0].clone();
+    let mut input = controller.take_ingress(&first).unwrap();
+    let task = execute(
+        &s,
+        plan(&s, &origin, "pcma"),
+        "bad_confirmation",
+        policy.clone(),
+    );
+    let callback = s.wire.read().await;
+    s.f.verify_server(&callback).await;
+    let mut bad = s.confirmation(&callback);
+    bad["payload"]["substrate_setup"]["revision"] = json!(999);
+    s.wire.send(s.f.sign(bad)).await;
+    let failure = task.await.unwrap().unwrap_err();
+    assert!(failure.effect_possible);
+    assert_eq!(failure.error, NativeOfferError::Confirmation);
+    assert_eq!(controller.revision(), 3);
+    assert_eq!(
+        controller.active_bindings()[0].transport_id,
+        old.transport_id
+    );
+    send(&s.wire, encoded_audio(old.stream_local_id, 0, 1));
+    packet(&mut input)
+        .await
+        .try_forward_to(&controller, &first)
+        .unwrap();
+    decoded_codec(&received(&s.wire).await, 0);
+    assert!(
+        tokio::time::timeout(Duration::from_millis(100), s.wire.reader.next())
+            .await
+            .is_err()
+    );
+    let replay = execute(
+        &s,
+        plan(&s, &origin, "pcma"),
+        "bad_confirmation",
+        policy.clone(),
+    )
+    .await
+    .unwrap()
+    .unwrap_err();
+    assert!(!replay.effect_possible);
+    assert_eq!(controller.revision(), 3);
+    s.wire.server.shutdown().await.unwrap();
+}
