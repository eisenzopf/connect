+        &self.scope
+    }
+    pub fn operation(&self) -> &str {
+        &self.operation
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn resources_changed(&self) -> bool {
+        self.changed
+    }
+    pub fn bindings(&self) -> &[rvoip_core::stream_lifecycle::ReadyMediaBinding] {
+        &self.bindings
+    }
+}
+impl std::fmt::Debug for NativeSessionCodecOutcome {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeSessionCodecOutcome(historical metadata)")
