+//! Staged, generation-fenced media port ownership. Adapters explicitly opt in;
+//! the old live-mutating renegotiation API is never used as a fallback.
+//! Connect still owns durable operations and installs current policy. Built-in
+//! transport adapters must implement this contract before advertising it.
+
+use crate::{
+    identity::AuthenticatedPrincipal,
+    ids::{ConnectionId, ConversationId, SessionId, StreamId},
+    relationships::{ConnectionBinding, EndpointBinding, Membership, SessionAppearance},
+    stream::{MediaFrame, StreamKind},
+    stream_lifecycle::*,
+};
+use rvoip_core_traits::peer_switch::PeerRouteTicket;
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    future::Future,
+    sync::{
+        atomic::{AtomicU32, Ordering},
+        Arc, Mutex, Weak,
+    },
+    time::{Duration, Instant},
+};
+use tokio::sync::{mpsc, OwnedSemaphorePermit, Semaphore};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Debug, thiserror::Error)]
+pub enum StreamControlError {
+    #[error(transparent)]
+    Model(#[from] MediaTransitionError),
+    #[error("staged media is unsupported")]
+    Unsupported,
+    #[error("staged media authority denied")]
+    Authority,
+    #[error("staged media cancelled")]
+    Cancelled,
+    #[error("staged media deadline expired")]
+    Deadline,
+    #[error("staged media is not ready")]
+    NotReady,
+    #[error("staged media backpressure")]
+    Backpressure,
+    #[error("staged media cleanup is unconfirmed")]
+    CleanupUnconfirmed,
+}
+pub type ControlResult<T> = std::result::Result<T, StreamControlError>;
+
+/// Share exactly one allocator across all Connections on one physical peer.
+/// Failed candidates burn handles. Exhaustion never wraps or reuses a handle.
+pub struct StreamHandleAllocator(AtomicU32);
+impl Default for StreamHandleAllocator {
+    fn default() -> Self {
+        Self(AtomicU32::new(1))
+    }
+}
+impl StreamHandleAllocator {
+    fn allocate(&self) -> ControlResult<u16> {
+        self.0
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                (n <= u16::MAX as u32).then_some(n + 1)
+            })
+            .map(|n| n as u16)
+            .map_err(|_| MediaTransitionError::Capacity.into())
+    }
+}
+
+#[derive(Clone)]
+pub struct MediaOwner {
+    pub actor: Membership,
+    pub member: Membership,
+    pub presence: SessionAppearance,
+    pub endpoint: EndpointBinding,
+    pub connection: ConnectionBinding,
+    pub may_control: bool,
+    pub send_media: BTreeSet<Medium>,
+    pub receive_media: BTreeSet<Medium>,
+    pub local: EndpointMediaCapabilities,
+    pub remote: EndpointMediaCapabilities,
+    /// Current source audience permission, separately from receive capability.
+    pub may_route_source: bool,
+}
+impl MediaOwner {
+    fn current(&self) -> CurrentMediaAuthority<'_> {
+        CurrentMediaAuthority {
+            member: &self.member,
+            presence: &self.presence,
+            endpoint: &self.endpoint,
+            connection: &self.connection,
+            may_negotiate: self.may_control,
+            send_media: self.send_media.clone(),
+            receive_media: self.receive_media.clone(),
+        }
+    }
+}
+#[derive(Clone, Debug)]
+pub struct MediaSource {
+    pub conversation: ConversationId,
+    pub session: SessionId,
+    pub connection: ConnectionId,
+    pub participant: crate::ids::ParticipantId,
+    pub membership_epoch: u64,
+    pub connection_generation: u64,
+    pub logical_id: StreamId,
+    pub transport_id: StreamId,
+    pub stream_generation: u64,
+}
+pub enum MediaPurpose<'a> {
+    Control,
+    Publish,
+    Receive { source: &'a MediaSource },
+}
+pub struct MediaScope<'a> {
+    pub conversation: &'a ConversationId,
+    pub session: &'a SessionId,
+    pub connection: &'a ConnectionId,
+    pub principal: &'a AuthenticatedPrincipal,
+    pub purpose: MediaPurpose<'a>,
+}
+/// Owned, Send authority lease. Retain the policy's generation/authorization
+/// fence through a bounded local send. Queued permission snapshots are invalid.
+pub trait MediaAuthorityLease: Send {
+    fn authority(&self) -> &MediaOwner;
+}
+pub trait MediaPolicy: Send + Sync {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>>;
+}
