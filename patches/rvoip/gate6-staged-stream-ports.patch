+#[async_trait::async_trait]
+pub trait MediaPortCleanup: Send + Sync {
+    /// Idempotent and exact-port scoped. Success confirms owned local resources
+    /// have stopped; it must not end an unchanged route on the same Connection.
+    async fn close(&self) -> ControlResult<()>;
+}
+#[async_trait::async_trait]
+pub trait StagedMediaAdapter: Send + Sync {
+    /// Register cleanup before allocating resources. Report readiness only
+    /// from the exact negotiated route. Dropping this future must release its
+    /// own provisional work; engine ports are fenced immediately on failure.
+    /// Existing ports are read-only and must remain untouched during prepare.
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<()>;
+}
+#[derive(Clone)]
+pub struct PortPreparation {
+    pub port: AdapterMediaPort,
+    pub is_new: bool,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PortStatus {
+    Prepared,
+    Active,
+    Paused,
+    Retired,
+    Quarantined,
+    Closed,
+}
+struct PortState {
+    status: PortStatus,
+    ready: bool,
+    payload_type: Option<u8>,
+    cleanup: Option<Arc<dyn MediaPortCleanup>>,
+}
+struct Port {
+    owner: Weak<StreamController>,
+    binding: ReadyMediaBinding,
+    baseline: PeerRouteTicket,
+    ticket: Mutex<PeerRouteTicket>,
+    state: Mutex<PortState>,
+    ingress: mpsc::Sender<MediaPacket>,
+    input: Mutex<Option<mpsc::Receiver<MediaPacket>>>,
+    egress: mpsc::Sender<QueuedMedia>,
+    output: Mutex<Option<mpsc::Receiver<QueuedMedia>>>,
+    slot: Mutex<Option<OwnedSemaphorePermit>>,
+}
+impl Port {
+    fn retire(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if matches!(
+            state.status,
+            PortStatus::Closed | PortStatus::Retired | PortStatus::Quarantined
+        ) {
+            return;
+        }
+        let ticket = self.ticket.lock().unwrap_or_else(|p| p.into_inner());
+        if !ticket.retire_if_current() {
+            self.baseline.retire_if_current();
+        }
+        state.status = PortStatus::Retired;
+    }
+    fn kind(&self) -> StreamKind {
+        match self.binding.negotiated.requested.medium {
+            Medium::Audio => StreamKind::Audio,
+            Medium::Video | Medium::Screen => StreamKind::Video,
+            Medium::Data => StreamKind::Data,
+        }
+    }
+    fn validate(&self, frame: &MediaFrame) -> ControlResult<()> {
+        let maximum = match self.kind() {
+            StreamKind::Audio => 16 * 1024,
+            StreamKind::Video => 1180,
+            StreamKind::Data => 16 * 1024,
+        };
+        if frame.stream_id != self.binding.transport_id
+            || frame.kind != self.kind()
+            || frame.payload.is_empty()
+            || frame.payload.len() > maximum
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if !state.ready || frame.payload_type != state.payload_type {
+            return Err(StreamControlError::NotReady);
+        }
+        if let MediaFormat::ReliableOrdered(protocol) = &self.binding.negotiated.format {
+            use crate::capability::DataProtocol;
+            match protocol {
+                DataProtocol::Text => {
+                    std::str::from_utf8(&frame.payload)
+                        .map_err(|_| StreamControlError::NotReady)?;
+                }
+                DataProtocol::Json => {
+                    serde_json::from_slice::<serde_json::Value>(&frame.payload)
+                        .map_err(|_| StreamControlError::NotReady)?;
+                }
+                DataProtocol::Binary => {}
+            }
+        }
+        if self.kind() == StreamKind::Video {
+            let packet = rvoip_rtp_core::RtpPacket::parse(&frame.payload)
+                .map_err(|_| StreamControlError::NotReady)?;
+            if Some(packet.header.payload_type) != state.payload_type
+                || packet.header.timestamp != frame.timestamp_rtp
+            {
+                return Err(StreamControlError::NotReady);
+            }
+        }
+        Ok(())
+    }
+    fn ticket(&self) -> PeerRouteTicket {
+        self.ticket
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .clone()
+    }
+}
+#[derive(Clone)]
+pub struct AdapterMediaPort(Arc<Port>);
+impl AdapterMediaPort {
+    pub fn binding(&self) -> &ReadyMediaBinding {
+        &self.0.binding
+    }
+    pub fn install_cleanup(&self, cleanup: Arc<dyn MediaPortCleanup>) -> ControlResult<()> {
+        let mut state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.cleanup.is_some() || state.status != PortStatus::Prepared {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        state.cleanup = Some(cleanup);
+        Ok(())
+    }
+    pub fn observe_ready(
+        &self,
+        format: &MediaFormat,
+        source_ready: bool,
+        sink_ready: bool,
+        payload_type: Option<u8>,
+    ) -> ControlResult<()> {
+        let mut state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.status != PortStatus::Prepared
+            || state.cleanup.is_none()
+            || format != &self.0.binding.negotiated.format
+            || (!source_ready && self.0.binding.source_ready)
+            || (!sink_ready && self.0.binding.sink_ready)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        if (self.0.kind() == StreamKind::Data && payload_type.is_some())
+            || (self.0.kind() != StreamKind::Data && !payload_type.is_some_and(|pt| pt < 128))
+            || (state.ready && state.payload_type != payload_type)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        state.payload_type = payload_type;
+        state.ready = true;
+        Ok(())
+    }
+    /// Source perspective is the core: Receive means endpoint -> core.
+    /// A full queue is explicit backpressure. Reliable data adapters must stop
+    /// reading/retry the same message; they must never acknowledge a drop.
+    pub fn try_publish(&self, frame: &MediaFrame) -> ControlResult<()> {
+        self.0.validate(frame)?;
+        let owner = self
+            .0
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let ticket = self.0.ticket();
+        let (_lease, _delivery) = owner.admit(&self.0, &ticket, false, None)?;
+        self.0
+            .ingress
+            .try_send(MediaPacket {
+                frame: frame.clone(),
+                source: self.0.clone(),
+                ticket,
+                admitted_at: Instant::now(),
+            })
+            .map_err(|error| match error {
+                mpsc::error::TrySendError::Full(_) => StreamControlError::Backpressure,
+                mpsc::error::TrySendError::Closed(_) => StreamControlError::NotReady,
+            })
+    }
+    pub fn take_egress(&self) -> ControlResult<mpsc::Receiver<QueuedMedia>> {
+        self.0
+            .output
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(MediaTransitionError::Conflict.into())
+    }
+    /// Exact protected adapter callback. A terminal callback for an old
+    /// transport cannot end the replacement sharing its logical stream ID.
+    pub fn report_terminal(&self) -> ControlResult<bool> {
+        let Some(owner) = self.0.owner.upgrade() else {
+            self.0.retire();
+            return Ok(false);
+        };
+        let mut state = owner.state.lock().unwrap_or_else(|p| p.into_inner());
+        self.0.retire();
+        let logical = &self.0.binding.negotiated.requested.logical_id;
+        if !state
+            .active
+            .get(logical)
+            .is_some_and(|current| Arc::ptr_eq(current, &self.0))
+        {
+            return Ok(false);
+        }
+        state.active.remove(logical);
+        Ok(state.model.observe_ended(
+            logical,
+            &self.0.binding.transport_id,
+            self.0.binding.stream_local_id,
+            self.0.binding.generation,
+            self.0.binding.connection_generation,
+        )?)
+    }
+}
+
+pub struct MediaPacket {
+    frame: MediaFrame,
+    source: Arc<Port>,
+    ticket: PeerRouteTicket,
+    admitted_at: Instant,
+}
+impl MediaPacket {
+    pub fn try_forward_to(
+        &self,
+        destination: &Arc<StreamController>,
+        logical: &StreamId,
+    ) -> ControlResult<()> {
+        if self.source.kind() != StreamKind::Data
+            && self.admitted_at.elapsed() > Duration::from_millis(200)
+        {
+            return Err(StreamControlError::Deadline);
+        }
+        let source = self
+            .source
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if source.conversation != destination.conversation
+            || source.session != destination.session
+            || !Arc::ptr_eq(&source.policy, &destination.policy)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let target = {
+            let state = destination.state.lock().unwrap_or_else(|p| p.into_inner());
+            state
+                .active
+                .get(logical)
+                .cloned()
+                .ok_or(StreamControlError::NotReady)?
+        };
+        if self.source.binding.negotiated.requested.medium
+            != target.binding.negotiated.requested.medium
+            || self.source.binding.negotiated.format != target.binding.negotiated.format
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let descriptor = source.descriptor(&self.source)?;
+        let (_source_lease, _source_guard) =
+            source.admit(&self.source, &self.ticket, false, None)?;
+        let ticket = target.ticket();
+        let (_target_lease, _target_guard) =
+            destination.admit(&target, &ticket, true, Some(&descriptor))?;
+        let mut frame = self.frame.clone();
+        frame.stream_id = target.binding.transport_id.clone();
+        target
+            .egress
+            .try_send(QueuedMedia {
+                frame,
+                source: self.source.clone(),
+                source_ticket: self.ticket.clone(),
+                target: target.clone(),
+                target_ticket: ticket,
+                descriptor,
+                admitted_at: self.admitted_at,
+            })
+            .map_err(|error| match error {
+                mpsc::error::TrySendError::Full(_) => StreamControlError::Backpressure,
+                mpsc::error::TrySendError::Closed(_) => StreamControlError::NotReady,
+            })
+    }
+}
+/// No raw payload accessor: admission is repeated after dequeue, and the
+/// current policy plus both route-generation guards live through the send.
+pub struct QueuedMedia {
+    frame: MediaFrame,
+    source: Arc<Port>,
+    source_ticket: PeerRouteTicket,
+    target: Arc<Port>,
+    target_ticket: PeerRouteTicket,
+    descriptor: MediaSource,
+    admitted_at: Instant,
+}
+impl QueuedMedia {
+    pub async fn deliver<F, Fut>(self, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(MediaFrame) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        if self.source.kind() != StreamKind::Data
+            && self.admitted_at.elapsed() > Duration::from_millis(200)
+        {
+            return Err(StreamControlError::Deadline);
+        }
+        let source = self
+            .source
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let target = self
+            .target
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let (_source_lease, _source_guard) =
+            source.admit(&self.source, &self.source_ticket, false, None)?;
+        let (_target_lease, _target_guard) = target.admit(
+            &self.target,
+            &self.target_ticket,
+            true,
+            Some(&self.descriptor),
+        )?;
+        tokio::time::timeout(Duration::from_millis(200), send(self.frame))
+            .await
+            .map_err(|_| StreamControlError::Deadline)?
+    }
+}
+
+struct State {
+    model: StreamLifecycle,
+    active: BTreeMap<StreamId, Arc<Port>>,
+    all: BTreeMap<StreamId, Arc<Port>>,
+    closed: bool,
+}
+pub struct StreamController {
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    principal: AuthenticatedPrincipal,
+    policy: Arc<dyn MediaPolicy>,
+    adapter: Arc<dyn StagedMediaAdapter>,
+    handles: Arc<StreamHandleAllocator>,
+    slots: Arc<Semaphore>,
+    state: Mutex<State>,
+    cleanup_lock: tokio::sync::Mutex<()>,
+    inflight: Arc<Semaphore>,
+    shutdown: CancellationToken,
+}
+struct Candidate {
+    owner: Arc<StreamController>,
+    ticket: Option<PreparedMediaChange>,
+    ports: Vec<Arc<Port>>,
+    committed: bool,
+    cancellation: CancellationToken,
+    _flight: OwnedSemaphorePermit,
+}
+impl Drop for Candidate {
+    fn drop(&mut self) {
+        if self.committed {
+            return;
+        }
+        self.cancellation.cancel();
+        for port in &self.ports {
+            port.retire();
+        }
+        if let Some(ticket) = self.ticket.take() {
+            let _ = self
+                .owner
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .model
+                .abort(ticket);
+        }
+    }
+}
+impl StreamController {
+    pub fn new(
+        conversation: ConversationId,
+        session: SessionId,
+        connection: ConnectionId,
+        principal: AuthenticatedPrincipal,
+        policy: Arc<dyn MediaPolicy>,
+        adapter: Arc<dyn StagedMediaAdapter>,
+        handles: Arc<StreamHandleAllocator>,
+        maximum_ports: usize,
+    ) -> ControlResult<Arc<Self>> {
+        if !(1..=512).contains(&maximum_ports) {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+        let scope = MediaScope {
+            conversation: &conversation,
+            session: &session,
+            connection: &connection,
+            principal: &principal,
+            purpose: MediaPurpose::Control,
+        };
+        let lease = policy.current(&scope)?;
+        let authority = lease.authority();
+        Self::check(&scope, authority)?;
+        let model = StreamLifecycle::new(&authority.current())?;
+        drop(lease);
+        Ok(Arc::new(Self {
+            conversation,
+            session,
+            connection,
+            principal,
+            policy,
+            adapter,
+            handles,
+            slots: Arc::new(Semaphore::new(maximum_ports)),
+            state: Mutex::new(State {
+                model,
+                active: BTreeMap::new(),
+                all: BTreeMap::new(),
+                closed: false,
+            }),
+            cleanup_lock: tokio::sync::Mutex::new(()),
+            inflight: Arc::new(Semaphore::new(1)),
+            shutdown: CancellationToken::new(),
+        }))
+    }
+    fn scope<'a>(&'a self, purpose: MediaPurpose<'a>) -> MediaScope<'a> {
+        MediaScope {
+            conversation: &self.conversation,
+            session: &self.session,
+            connection: &self.connection,
+            principal: &self.principal,
+            purpose,
+        }
+    }
+    fn check(scope: &MediaScope<'_>, authority: &MediaOwner) -> ControlResult<()> {
+        authority
+            .actor
+            .revalidate_principal(scope.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        if authority.member.conversation() != scope.conversation
+            || authority.presence.session() != scope.session
+            || authority.connection.connection() != scope.connection
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    pub fn revision(&self) -> u64 {
+        self.state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .model
+            .revision()
+    }
+    pub fn cleanup_status(&self) -> Vec<(StreamId, PortStatus)> {
+        self.state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .all
+            .values()
+            .map(|p| {
+                (
+                    p.binding.transport_id.clone(),
+                    p.state.lock().unwrap_or_else(|p| p.into_inner()).status,
+                )
+            })
+            .collect()
