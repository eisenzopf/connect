+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let started = entered.clone();
+    let finish = release.clone();
+    let queued = outgoing(&mut output).await;
+    let send = tokio::spawn(async move {
+        queued
+            .deliver(|_| async move {
