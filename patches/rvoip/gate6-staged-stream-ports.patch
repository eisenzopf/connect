+            .try_forward_to(&f.b, &desired(Medium::Data).logical_id)
+            .unwrap();
+    }
+    source.try_publish(&frame(&source, 64)).unwrap();
+    let retry = receive(&mut input).await;
+    assert!(matches!(
+        retry.try_forward_to(&f.b, &desired(Medium::Data).logical_id),
+        Err(StreamControlError::Backpressure)
+    ));
+    outgoing(&mut output)
+        .await
+        .deliver(|frame| async move {
+            assert_eq!(
+                serde_json::from_slice::<serde_json::Value>(&frame.payload).unwrap()["sequence"],
+                0
+            );
+            Ok(())
+        })
+        .await
+        .unwrap();
+    retry
+        .try_forward_to(&f.b, &desired(Medium::Data).logical_id)
+        .unwrap();
+    for sequence in 1..=64 {
+        outgoing(&mut output)
+            .await
+            .deliver(|frame| async move {
+                assert_eq!(
+                    serde_json::from_slice::<serde_json::Value>(&frame.payload).unwrap()
+                        ["sequence"],
+                    sequence
+                );
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+}
