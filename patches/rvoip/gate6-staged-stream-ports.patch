+fn deadline() -> tokio::time::Instant {
+    tokio::time::Instant::now() + Duration::from_secs(2)
+}
+fn frame(port: &AdapterMediaPort, sequence: u32) -> MediaFrame {
+    let medium = port.binding().negotiated.requested.medium;
+    let payload = match medium {
+        Medium::Audio => {
+            use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+            let mut encoder = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+            encoder
+                .encode(&AudioFrame {
+                    samples: vec![1800; 160],
+                    sample_rate: 8000,
+                    channels: 1,
+                    duration: Duration::from_millis(20),
+                    timestamp: sequence,
+                })
+                .unwrap()
+        }
+        Medium::Video | Medium::Screen => {
+            let mut packet = vec![0x80, 96, 0, 1];
+            packet.extend_from_slice(&sequence.to_be_bytes());
+            packet.extend_from_slice(&1u32.to_be_bytes());
+            packet.extend_from_slice(&[0x10, 0, 1, 2]);
+            packet
+        }
+        Medium::Data => format!("{{\"sequence\":{sequence}}}").into_bytes(),
+    };
+    MediaFrame {
+        stream_id: port.binding().transport_id.clone(),
+        kind: port.0.kind(),
+        payload: Bytes::from(payload),
+        timestamp_rtp: sequence,
+        source_clock: None,
+        captured_at: chrono::Utc::now(),
+        payload_type: if medium == Medium::Data {
+            None
+        } else if medium == Medium::Audio {
+            Some(0)
+        } else {
+            Some(96)
+        },
+    }
+}
+async fn receive(receiver: &mut mpsc::Receiver<MediaPacket>) -> MediaPacket {
+    tokio::time::timeout(Duration::from_secs(1), receiver.recv())
+        .await
+        .unwrap()
+        .unwrap()
+}
+async fn outgoing(receiver: &mut mpsc::Receiver<QueuedMedia>) -> QueuedMedia {
+    tokio::time::timeout(Duration::from_secs(1), receiver.recv())
+        .await
+        .unwrap()
+        .unwrap()
+}
+async fn assert_audio(queued: QueuedMedia) {
+    queued
+        .deliver(|frame| async move {
+            let mut decoder = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                0,
+                Some(8000),
+                Some(1),
+            )
+            .unwrap();
+            assert!(decoder
+                .decode(&frame.payload)
+                .unwrap()
+                .samples
+                .iter()
+                .any(|s| s.unsigned_abs() > 500));
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
