+        may_control: true,
+        send_media: [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+            .into_iter()
+            .collect(),
+        receive_media: [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+            .into_iter()
+            .collect(),
+        local: profile(),
+        remote: profile(),
+        may_route_source: true,
+    }
+}
+struct PolicyState {
+    owners: HashMap<String, MediaOwner>,
+    revoked: HashSet<String>,
+    private: bool,
+}
+struct Policy(Arc<RwLock<PolicyState>>);
+struct Lease {
+    authority: MediaOwner,
+    _guard: OwnedRwLockReadGuard<PolicyState>,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        &self.authority
+    }
+}
+impl MediaPolicy for Policy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        if guard.revoked.contains(&scope.principal.subject) {
+            return Err(StreamControlError::Authority);
+        }
+        let mut authority = guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        if let MediaPurpose::Receive { source } = scope.purpose {
+            let original = guard
+                .owners
+                .get(source.connection.as_str())
+                .ok_or(StreamControlError::Authority)?;
+            if source.conversation != *scope.conversation
+                || source.session != *scope.session
+                || source.participant != *original.member.participant()
+                || source.membership_epoch != original.member.epoch()
+                || source.connection_generation != original.connection.generation()
+            {
+                return Err(StreamControlError::Authority);
+            }
+            authority.may_route_source = !guard.private;
+        }
+        Ok(Box::new(Lease {
+            authority,
+            _guard: guard,
+        }))
+    }
+}
+struct Cleanup {
+    outstanding: Arc<AtomicUsize>,
+    closed: AtomicBool,
+    uncertain: Arc<AtomicBool>,
+}
+#[async_trait::async_trait]
+impl MediaPortCleanup for Cleanup {
+    async fn close(&self) -> ControlResult<()> {
+        if self.uncertain.load(Ordering::Acquire) {
+            return Err(StreamControlError::CleanupUnconfirmed);
+        }
+        if !self.closed.swap(true, Ordering::AcqRel) {
+            self.outstanding.fetch_sub(1, Ordering::AcqRel);
+        }
+        Ok(())
+    }
+}
+struct Adapter {
+    ports: Mutex<BTreeMap<StreamId, AdapterMediaPort>>,
+    mode: AtomicUsize,
+    entered: Notify,
+    release: Notify,
+    outstanding: Arc<AtomicUsize>,
+    uncertain: Arc<AtomicBool>,
+}
+impl Adapter {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            ports: Mutex::new(BTreeMap::new()),
+            mode: AtomicUsize::new(0),
+            entered: Notify::new(),
+            release: Notify::new(),
+            outstanding: Arc::new(AtomicUsize::new(0)),
+            uncertain: Arc::new(AtomicBool::new(false)),
+        })
+    }
+    fn port(&self, kind: Medium) -> AdapterMediaPort {
+        self.ports
+            .lock()
+            .unwrap()
+            .get(&desired(kind).logical_id)
+            .unwrap()
+            .clone()
+    }
+}
+#[async_trait::async_trait]
+impl StagedMediaAdapter for Adapter {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<()> {
+        let mode = self.mode.load(Ordering::Acquire);
+        for preparation in ports {
+            if preparation.is_new {
+                if mode == 3 {
+                    return Err(StreamControlError::Unsupported);
+                }
+                let cleanup = Arc::new(Cleanup {
+                    outstanding: self.outstanding.clone(),
+                    closed: AtomicBool::new(false),
+                    uncertain: self.uncertain.clone(),
+                });
+                preparation.port.install_cleanup(cleanup)?;
+                self.outstanding.fetch_add(1, Ordering::AcqRel);
+                let format = preparation.port.binding().negotiated.format.clone();
+                let pt = match preparation.port.binding().negotiated.requested.medium {
+                    Medium::Audio => Some(0),
+                    Medium::Video | Medium::Screen => Some(96),
+                    Medium::Data => None,
+                };
+                if mode != 4 {
+                    preparation.port.observe_ready(&format, true, true, pt)?;
+                }
+            }
+            self.ports.lock().unwrap().insert(
+                preparation
+                    .port
+                    .binding()
+                    .negotiated
+                    .requested
+                    .logical_id
+                    .clone(),
+                preparation.port,
+            );
+        }
+        if mode == 1 {
+            self.entered.notify_one();
+            self.release.notified().await;
+        }
+        if mode == 2 {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(())
+    }
+}
+struct Fixture {
+    policy: Arc<Policy>,
+    a: Arc<StreamController>,
+    b: Arc<StreamController>,
+    aa: Arc<Adapter>,
+    ba: Arc<Adapter>,
