+    pub fn take_ingress(&self, logical: &StreamId) -> ControlResult<mpsc::Receiver<MediaPacket>> {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let port = state
+            .active
+            .get(logical)
+            .ok_or(StreamControlError::NotReady)?;
+        let result = port
+            .input
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(MediaTransitionError::Conflict.into());
+        result
+    }
+    fn descriptor(&self, port: &Port) -> ControlResult<MediaSource> {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let lease = self.policy.current(&self.scope(MediaPurpose::Publish))?;
+        let auth = lease.authority();
+        Self::check(&self.scope(MediaPurpose::Publish), auth)?;
+        state.model.authorize_binding(&auth.current())?;
+        Ok(MediaSource {
+            conversation: self.conversation.clone(),
+            session: self.session.clone(),
+            connection: self.connection.clone(),
+            participant: auth.member.participant().clone(),
+            membership_epoch: auth.member.epoch(),
+            connection_generation: auth.connection.generation(),
+            logical_id: port.binding.negotiated.requested.logical_id.clone(),
+            transport_id: port.binding.transport_id.clone(),
+            stream_generation: port.binding.generation,
+        })
+    }
+    fn admit(
+        &self,
+        port: &Arc<Port>,
+        ticket: &PeerRouteTicket,
+        sending: bool,
+        source: Option<&MediaSource>,
+    ) -> ControlResult<(
+        Box<dyn MediaAuthorityLease>,
+        rvoip_core_traits::peer_switch::PeerDeliveryGuard,
+    )> {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.closed
+            || !state
+                .active
+                .get(&port.binding.negotiated.requested.logical_id)
+                .is_some_and(|p| Arc::ptr_eq(p, port))
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        if state
+            .model
+            .streams()
+            .get(&port.binding.negotiated.requested.logical_id)
+            .is_none_or(|s| s.state != LogicalStreamState::Active)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let scope = self.scope(match source {
+            Some(source) => MediaPurpose::Receive { source },
+            None => MediaPurpose::Publish,
+        });
+        let lease = self.policy.current(&scope)?;
+        let auth = lease.authority();
+        Self::check(&scope, auth)?;
+        state.model.authorize_binding(&auth.current())?;
+        let medium = port.binding.negotiated.requested.medium;
+        let direction = port.binding.negotiated.requested.direction;
+        if (sending
+            && (direction == StreamDirection::Receive
+                || !auth.send_media.contains(&medium)
+                || !auth.may_route_source))
+            || (!sending
+                && (direction == StreamDirection::Send || !auth.receive_media.contains(&medium)))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let guard = ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)?;
+        Ok((lease, guard))
+    }
+    pub async fn change(
+        self: &Arc<Self>,
+        expected: u64,
+        desired: &[DesiredStream],
+        replace: &BTreeSet<StreamId>,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<()> {
+        if cancellation.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let deadline = deadline.min(tokio::time::Instant::now() + Duration::from_secs(30));
+        let now = Instant::now();
+        let ticket = {
+            let state = &mut *self.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state.closed {
+                return Err(StreamControlError::Cancelled);
+            }
+            let scope = self.scope(MediaPurpose::Control);
+            let lease = self.policy.current(&scope)?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            state.model.prepare(
+                &auth.current(),
+                expected,
+                &auth.local,
+                &auth.remote,
+                desired,
+                now,
+                deadline.into_std(),
+            )?
+        };
+        let mut candidate = Candidate {
+            owner: self.clone(),
+            ticket: Some(ticket),
+            ports: vec![],
+            committed: false,
+            cancellation: CancellationToken::new(),
+            _flight: flight,
+        };
+        if replace
+            .iter()
+            .any(|id| !desired.iter().any(|s| &s.logical_id == id))
+        {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        let mut selected = Vec::new();
+        for plan in candidate.ticket.as_ref().unwrap().streams() {
+            let existing = {
+                self.state
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .active
+                    .get(&plan.requested.logical_id)
+                    .cloned()
+            };
+            if let Some(old) = existing.as_ref().filter(|old| {
+                old.binding.negotiated == *plan && !replace.contains(&plan.requested.logical_id)
+            }) {
+                selected.push(PortPreparation {
+                    port: AdapterMediaPort(old.clone()),
+                    is_new: false,
+                });
+                continue;
+            }
+            let slot = self
+                .slots
+                .clone()
+                .try_acquire_owned()
+                .map_err(|_| MediaTransitionError::Capacity)?;
+            let handle = self.handles.allocate()?;
+            let baseline = PeerRouteTicket::initial();
+            let ticket = baseline.stage().ok_or(MediaTransitionError::Capacity)?;
+            let capacity = if plan.requested.medium == Medium::Audio {
+                10
+            } else {
+                64
+            };
+            let (ingress, input) = mpsc::channel(capacity);
+            let (egress, output) = mpsc::channel(capacity);
+            let binding = ReadyMediaBinding {
+                negotiated: plan.clone(),
+                transport_id: StreamId::new(),
+                stream_local_id: handle,
+                generation: existing.as_ref().map_or(1, |p| p.binding.generation + 1),
+                connection_generation: {
+                    let scope = self.scope(MediaPurpose::Control);
+                    let lease = self.policy.current(&scope)?;
+                    lease.authority().connection.generation()
+                },
+                source_ready: plan.requested.direction != StreamDirection::Send,
+                sink_ready: plan.requested.direction != StreamDirection::Receive,
+            };
+            let port = Arc::new(Port {
+                owner: Arc::downgrade(self),
+                binding,
+                baseline,
+                ticket: Mutex::new(ticket),
+                state: Mutex::new(PortState {
+                    status: PortStatus::Prepared,
+                    ready: false,
+                    payload_type: None,
+                    cleanup: None,
+                }),
+                ingress,
+                input: Mutex::new(Some(input)),
+                egress,
+                output: Mutex::new(Some(output)),
+                slot: Mutex::new(Some(slot)),
+            });
+            self.state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .all
+                .insert(port.binding.transport_id.clone(), port.clone());
+            candidate.ports.push(port.clone());
+            selected.push(PortPreparation {
+                port: AdapterMediaPort(port),
+                is_new: true,
+            });
+        }
+        tokio::select! {biased;_ = cancellation.cancelled()=>return Err(StreamControlError::Cancelled),_=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),result=tokio::time::timeout_at(deadline,self.adapter.prepare(selected.clone(),deadline,candidate.cancellation.clone()))=>result.map_err(|_|StreamControlError::Deadline)??}
+        let removed = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            state
+                .active
+                .values()
+                .filter(|old| !selected.iter().any(|p| Arc::ptr_eq(&p.port.0, old)))
+                .cloned()
+                .collect::<Vec<_>>()
+        };
+        let mut quiesced = Vec::new();
+        for old in &removed {
+            let ticket = old.ticket();
+            let guard = tokio::select! {biased;_=cancellation.cancelled()=>return Err(StreamControlError::Cancelled),_=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),result=tokio::time::timeout_at(deadline,ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(StreamControlError::NotReady)?};
+            quiesced.push(guard);
+        }
+        {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(MediaPurpose::Control);
+            let lease = self.policy.current(&scope)?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            if state.closed || cancellation.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(StreamControlError::Deadline);
+            }
+            if selected.iter().any(|p| {
+                let s = p.port.0.state.lock().unwrap_or_else(|p| p.into_inner());
+                !s.ready
+                    || (p.is_new && s.status != PortStatus::Prepared)
+                    || (!p.is_new && !matches!(s.status, PortStatus::Active | PortStatus::Paused))
+            }) {
+                return Err(StreamControlError::NotReady);
+            }
+            let bindings = selected
+                .iter()
+                .map(|p| p.port.0.binding.clone())
+                .collect::<Vec<_>>();
+            state.model.commit(
+                &auth.current(),
+                candidate.ticket.as_ref().unwrap(),
+                &bindings,
+                Instant::now(),
+            )?;
+            for port in &candidate.ports {
+                let mut status = port.state.lock().unwrap_or_else(|p| p.into_inner());
+                let ticket = port.ticket();
+                assert!(
+                    ticket.commit_from(&port.baseline),
+                    "private staged port generation changed outside controller"
+                );
+                status.status = PortStatus::Active;
+            }
+            for old in &removed {
+                old.retire();
+            }
+            state.active = selected
+                .into_iter()
+                .map(|p| {
+                    (
+                        p.port.0.binding.negotiated.requested.logical_id.clone(),
+                        p.port.0,
+                    )
+                })
+                .collect();
+            candidate.committed = true;
+        }
+        drop(quiesced);
+        Ok(())
+    }
+    /// Drain admitted local sends, then advance the private delivery generation
+    /// with the logical pause/resume. Frames buffered before either edge expire.
+    pub async fn set_paused(
+        &self,
+        logical: &StreamId,
+        expected: u64,
+        paused: bool,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<()> {
+        let _flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let port = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(MediaPurpose::Control);
+            let lease = self.policy.current(&scope)?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            state.model.authorize_binding(&auth.current())?;
+            if state.closed || !auth.may_control {
+                return Err(StreamControlError::Authority);
+            }
+            if state.model.revision() != expected {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            state
+                .active
+                .get(logical)
+                .cloned()
+                .ok_or(StreamControlError::NotReady)?
+        };
+        let old = port.ticket();
+        let next = old.stage().ok_or(MediaTransitionError::Capacity)?;
+        let drained = tokio::select! {biased;_=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),result=tokio::time::timeout_at(deadline,old.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(StreamControlError::NotReady)?};
+        {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(MediaPurpose::Control);
+            let lease = self.policy.current(&scope)?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            if state.closed {
+                return Err(StreamControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(StreamControlError::Deadline);
+            }
+            state
+                .model
+                .set_paused(&auth.current(), expected, logical, paused)?;
+            assert!(
+                next.commit_from(&old),
+                "private paused delivery generation changed outside controller"
+            );
+            *port.ticket.lock().unwrap_or_else(|p| p.into_inner()) = next;
+            port.state.lock().unwrap_or_else(|p| p.into_inner()).status = if paused {
+                PortStatus::Paused
+            } else {
+                PortStatus::Active
+            };
+        }
+        drop(drained);
+        Ok(())
+    }
+    /// End one logical stream after its admitted local sends drain. The
+    /// Session and its unrelated ports remain; resource cleanup is separate.
+    pub async fn end_stream(
+        &self,
+        logical: &StreamId,
+        expected: u64,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<()> {
+        let _flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let port = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(MediaPurpose::Control);
+            let lease = self.policy.current(&scope)?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            state.model.authorize_binding(&auth.current())?;
+            if state.closed || !auth.may_control {
+                return Err(StreamControlError::Authority);
+            }
+            if state.model.revision() != expected {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            state
+                .active
+                .get(logical)
+                .cloned()
+                .ok_or(StreamControlError::NotReady)?
+        };
+        let ticket = port.ticket();
+        let drained = tokio::select! {biased;_=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),result=tokio::time::timeout_at(deadline,ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(StreamControlError::NotReady)?};
+        {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(MediaPurpose::Control);
+            let lease = self.policy.current(&scope)?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            if state.closed {
+                return Err(StreamControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(StreamControlError::Deadline);
+            }
+            state.model.end_stream(&auth.current(), expected, logical)?;
+            port.retire();
+            state.active.remove(logical);
+        }
+        drop(drained);
+        Ok(())
+    }
+    /// One bounded cleanup attempt per retired port. Quarantined ports retain
+    /// their capacity and exact resources until cleanup actually confirms.
+    pub async fn reconcile_cleanup(&self, deadline: tokio::time::Instant) -> usize {
+        let _cleanup = match tokio::time::timeout_at(deadline, self.cleanup_lock.lock()).await {
+            Ok(guard) => guard,
+            Err(_) => {
+                return self
+                    .cleanup_status()
+                    .iter()
+                    .filter(|(_, status)| {
+                        matches!(status, PortStatus::Retired | PortStatus::Quarantined)
+                    })
+                    .count()
+            }
+        };
+        let ports = {
+            self.state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .all
+                .values()
+                .filter(|p| {
+                    matches!(
+                        p.state.lock().unwrap_or_else(|p| p.into_inner()).status,
+                        PortStatus::Retired | PortStatus::Quarantined
+                    )
+                })
+                .cloned()
+                .collect::<Vec<_>>()
+        };
+        for port in ports {
+            let cleanup = port
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .cleanup
+                .clone();
+            let drained = matches!(
+                tokio::time::timeout_at(deadline, port.ticket().wait_retired_drained()).await,
+                Ok(true)
+            );
+            let confirmed = if let Some(cleanup) = cleanup {
+                drained
+                    && matches!(
+                        tokio::time::timeout_at(
+                            deadline.min(tokio::time::Instant::now() + Duration::from_secs(1)),
+                            cleanup.close()
+                        )
+                        .await,
+                        Ok(Ok(()))
+                    )
+            } else {
+                false
+            };
+            if confirmed {
+                port.state.lock().unwrap_or_else(|p| p.into_inner()).status = PortStatus::Closed;
+                port.slot.lock().unwrap_or_else(|p| p.into_inner()).take();
+                self.state
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .all
+                    .remove(&port.binding.transport_id);
+            } else {
+                port.state.lock().unwrap_or_else(|p| p.into_inner()).status =
+                    PortStatus::Quarantined;
+            }
+        }
+        self.state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .all
+            .values()
+            .filter(|p| {
+                matches!(
+                    p.state.lock().unwrap_or_else(|p| p.into_inner()).status,
+                    PortStatus::Retired | PortStatus::Quarantined
+                )
+            })
+            .count()
+    }
+    pub async fn shutdown(&self, deadline: tokio::time::Instant) -> usize {
+        self.shutdown.cancel();
+        {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            state.closed = true;
+            for port in state.active.values() {
+                port.retire();
+            }
+            state.active.clear();
+        }
+        let _flight =
+            match tokio::time::timeout_at(deadline, self.inflight.clone().acquire_owned()).await {
+                Ok(Ok(permit)) => permit,
+                _ => return self.cleanup_status().len(),
+            };
+        self.reconcile_cleanup(deadline).await
+    }
+}
+impl Drop for StreamController {
+    fn drop(&mut self) {
+        for port in self
+            .state
+            .get_mut()
+            .unwrap_or_else(|p| p.into_inner())
+            .all
+            .values()
+        {
+            port.retire();
+        }
+    }
+}
