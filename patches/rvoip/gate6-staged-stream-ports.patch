+    let revoked = tokio::spawn(async move {
+        policy.0.write().await.private = true;
+    });
+    tokio::task::yield_now().await;
+    assert!(!revoked.is_finished());
+    release.notify_one();
+    send.await.unwrap().unwrap();
+    revoked.await.unwrap();
