+#[cfg(test)]
+mod final_guard_tests {
+    use super::*;
+
+    #[test]
+    fn final_guard_busy_releases_all_prior_metadata_guards() {
+        let a = PeerRouteTicket::initial();
+        let b = PeerRouteTicket::initial();
+        let mut tickets = vec![a, b];
+        tickets.sort_by_key(|ticket| Arc::as_ptr(&ticket.state) as usize);
+        let busy = tickets[1].state.lock().unwrap();
+        assert!(matches!(PeerRouteGuardSet::try_acquire(&tickets), Err(PeerRouteGuardError::MetadataBusy)));
+        // The first actual switch was acquired before the contended second one.
+        assert!(tickets[0].state.try_lock().is_ok());
+        let healthy_send = tickets[0].try_begin_delivery().unwrap();
+        drop(healthy_send);
+        drop(busy);
+        assert!(tickets[1].try_begin_delivery().is_some());
+    }
+
+    #[test]
+    fn final_guard_delivery_busy_never_partially_pauses_other_peers() {
+        let a = PeerRouteTicket::initial();
+        let b = PeerRouteTicket::initial();
+        let sending = b.try_begin_delivery().unwrap();
+        let tickets = vec![a.clone(), b.clone()];
+        let mut held = PeerRouteGuardSet::try_acquire(&tickets).unwrap();
+        assert_eq!(held.try_quiesce(&tickets), Err(PeerRouteGuardError::DeliveryBusy));
+        assert!(!held.get(&a).unwrap().paused);
+        assert!(!held.get(&b).unwrap().paused);
+        drop(held);
+        assert!(a.try_begin_delivery().is_some());
+        drop(sending);
+        let mut held = PeerRouteGuardSet::try_acquire(&tickets).unwrap();
+        held.try_quiesce(&tickets).unwrap();
+        assert!(held.get(&a).unwrap().paused && held.get(&b).unwrap().paused);
+        drop(held);
+        assert!(a.try_begin_delivery().is_some());
+        assert!(b.try_begin_delivery().is_some());
+    }
+
+    #[tokio::test]
+    async fn final_guard_preserves_an_existing_original_pause_on_refusal() {
+        let original = PeerRouteTicket::initial();
+        let freeze = original.quiesce().await.unwrap();
+        let tickets = vec![original.clone()];
+        let mut held = PeerRouteGuardSet::try_acquire(&tickets).unwrap();
+        assert_eq!(held.try_quiesce(&tickets), Err(PeerRouteGuardError::AlreadyPaused));
+        assert!(held.is_current(&original));
+        drop(held);
+        assert!(original.is_current());
+        assert!(!original.is_active());
+        assert!(original.try_begin_delivery().is_none());
+        drop(freeze);
+        assert!(original.try_begin_delivery().is_some());
+    }
+
+    #[test]
+    fn final_guard_deduplicates_switches_and_commits_only_the_original_successor() {
+        let original = PeerRouteTicket::initial();
+        let next = original.stage().unwrap();
+        let later = original.stage().unwrap();
+        let foreign = PeerRouteTicket::initial();
+        let tickets = vec![original.clone(), original.clone(), next.clone(), later.clone()];
+        let mut held = PeerRouteGuardSet::try_acquire(&tickets).unwrap();
+        assert_eq!(held.states.len(), 1);
+        held.try_quiesce(&[original.clone(), original.clone()]).unwrap();
+        assert!(!held.can_commit(&foreign, &original));
+        assert!(!held.can_commit(&original, &original));
+        assert!(!held.is_current(&foreign));
+        assert!(held.can_commit(&next, &original));
+        assert!(held.commit_from(&next, &original));
+        assert!(held.is_current(&next));
+        assert!(!held.retire_if_current(&original));
+        assert!(!held.commit_from(&later, &original));
+        assert!(!held.commit_from(&original, &next));
+        drop(held);
+        assert!(next.try_begin_delivery().is_some());
+        assert!(original.try_begin_delivery().is_none());
+    }
+
+    #[test]
+    fn final_guard_retirement_preserves_successor_and_stale_cleanup_rules() {
+        let original = PeerRouteTicket::initial();
+        let next = original.stage().unwrap();
+        let tickets = vec![original.clone(), next.clone()];
+        let mut held = PeerRouteGuardSet::try_acquire(&tickets).unwrap();
+        assert!(held.retire_if_current(&original));
+        assert!(!held.can_commit(&next, &original));
+        assert!(!held.retire_if_current(&original));
+        drop(held);
+        assert!(original.try_begin_delivery().is_none());
+        assert!(next.try_begin_delivery().is_none());
+        assert!(!next.commit_from(&original));
+    }
+}
