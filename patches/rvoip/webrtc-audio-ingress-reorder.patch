+//! Reorder audio before stripping RTP sequence information. Otherwise a late
+//! packet appears to the next hop as a source-clock reset and stretches time.
+//! Only gaps wait: ten packets and 100ms, preserving original capture time.
+use chrono::{DateTime, Utc};
+use rtc::rtp;
+use std::time::{Duration, Instant};
+
+const CAPACITY: usize = 10;
+const GAP_WAIT: Duration = Duration::from_millis(100);
+
+pub(super) struct ReceivedAudio {
+    pub packet: rtp::Packet,
+    pub captured_at: DateTime<Utc>,
+    inserted: Instant,
+}
+impl ReceivedAudio {
+    pub fn new(packet: rtp::Packet, now: Instant) -> Self {
+        Self {
+            packet,
+            captured_at: Utc::now(),
+            inserted: now,
+        }
+    }
+}
+#[derive(Default)]
+pub(super) struct AudioRelease {
+    pub packets: Vec<ReceivedAudio>,
+    pub peak_depth: usize,
+    pub discarded: usize,
+}
+#[derive(Default)]
+pub(super) struct AudioReorder {
+    ssrc: Option<u32>,
+    next: Option<u16>,
+    pending: Vec<ReceivedAudio>,
+}
+impl AudioReorder {
+    pub fn next_deadline(&self) -> Option<Instant> {
+        self.pending
+            .iter()
+            .map(|item| item.inserted + GAP_WAIT)
+            .min()
+    }
+    pub fn push(&mut self, packet: ReceivedAudio, now: Instant) -> AudioRelease {
+        let mut reset = 0;
+        if self.ssrc != Some(packet.packet.header.ssrc) {
+            reset = self.pending.len();
+            self.pending.clear();
+            self.ssrc = Some(packet.packet.header.ssrc);
+            self.next = Some(packet.packet.header.sequence_number);
+        }
+        let mut output = self.expire(now);
+        output.discarded += reset;
+        let sequence = packet.packet.header.sequence_number;
+        let expected = self.next.unwrap_or(sequence);
+        if (sequence.wrapping_sub(expected) as i16) < 0
+            || self
+                .pending
+                .iter()
+                .any(|item| item.packet.header.sequence_number == sequence)
+        {
+            output.discarded += 1;
+            return output;
+        }
+        if sequence == expected {
+            output.packets.push(packet);
+            self.next = Some(expected.wrapping_add(1));
+            self.drain(&mut output);
+            return output;
+        }
+        if self.pending.len() == CAPACITY {
+            let nearest = self
+                .pending
+                .iter()
+                .map(|item| item.packet.header.sequence_number.wrapping_sub(expected))
+                .min()
+                .expect("full queue");
+            if sequence.wrapping_sub(expected) < nearest {
+                // Pressure may skip a missing packet, but must never skip over
+                // this nearer input and emit it after the buffered future.
+                output.packets.push(packet);
+                self.next = Some(sequence.wrapping_add(1));
+                self.drain(&mut output);
+                return output;
+            }
+            self.advance(&mut output);
+        }
+        self.pending.push(packet);
+        output.peak_depth = output.peak_depth.max(self.pending.len());
+        self.drain(&mut output);
+        output
+    }
+    pub fn expire(&mut self, now: Instant) -> AudioRelease {
+        let mut output = AudioRelease {
+            peak_depth: self.pending.len(),
+            ..Default::default()
+        };
+        while self.next_deadline().is_some_and(|deadline| now >= deadline) {
+            self.advance(&mut output);
+        }
+        output
+    }
+    fn advance(&mut self, output: &mut AudioRelease) {
+        let Some(expected) = self.next else { return };
+        self.next = self
+            .pending
+            .iter()
+            .map(|item| item.packet.header.sequence_number)
+            .min_by_key(|sequence| sequence.wrapping_sub(expected));
+        self.drain(output);
+    }
+    fn drain(&mut self, output: &mut AudioRelease) {
+        while let Some(expected) = self.next {
+            let Some(index) = self
+                .pending
+                .iter()
+                .position(|item| item.packet.header.sequence_number == expected)
+            else {
+                break;
+            };
+            output.packets.push(self.pending.remove(index));
+            self.next = Some(expected.wrapping_add(1));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn packet(sequence: u16, now: Instant) -> ReceivedAudio {
+        ReceivedAudio::new(
+            rtp::Packet {
+                header: rtp::Header {
+                    sequence_number: sequence,
+                    ssrc: 7,
+                    timestamp: u32::from(sequence).wrapping_mul(160),
+                    ..Default::default()
+                },
+                payload: vec![sequence as u8; 160].into(),
+            },
+            now,
+        )
+    }
+    fn sequences(output: &AudioRelease) -> Vec<u16> {
+        output
+            .packets
+            .iter()
+            .map(|item| item.packet.header.sequence_number)
+            .collect()
+    }
+    #[test]
+    fn reordered_audio_preserves_source_timestamps_and_capture_time() {
+        let now = Instant::now();
+        let mut queue = AudioReorder::default();
+        assert_eq!(sequences(&queue.push(packet(10, now), now)), [10]);
+        let later = packet(12, now);
+        let captured = later.captured_at;
+        assert!(queue.push(later, now).packets.is_empty());
+        let output = queue.push(packet(11, now), now + Duration::from_millis(80));
+        assert_eq!(sequences(&output), [11, 12]);
+        assert_eq!(output.packets[1].packet.header.timestamp, 1920);
+        assert_eq!(output.packets[1].captured_at, captured);
+        assert!(queue.next_deadline().is_none());
+    }
+    #[test]
+    fn missing_packet_expires_without_traffic_and_late_packet_cannot_reset_clock() {
+        let now = Instant::now();
+        let mut queue = AudioReorder::default();
+        queue.push(packet(65534, now), now);
+        assert!(queue.push(packet(0, now), now).packets.is_empty());
+        assert!(queue
+            .expire(now + Duration::from_millis(99))
+            .packets
+            .is_empty());
+        assert_eq!(sequences(&queue.expire(now + GAP_WAIT)), [0]);
+        let late = queue.push(packet(65535, now), now + GAP_WAIT);
+        assert!(late.packets.is_empty());
+        assert_eq!(late.discarded, 1);
+        assert_eq!(sequences(&queue.push(packet(1, now), now + GAP_WAIT)), [1]);
+    }
+    #[test]
+    fn duplicates_capacity_and_source_switch_remain_bounded() {
+        let now = Instant::now();
+        let mut queue = AudioReorder::default();
+        queue.push(packet(10, now), now);
+        queue.push(packet(12, now), now);
+        assert_eq!(queue.push(packet(12, now), now).discarded, 1);
+        for sequence in 13..23 {
+            let output = queue.push(packet(sequence, now), now);
+            assert!(output.peak_depth <= CAPACITY);
+            assert!(queue.pending.len() <= CAPACITY);
+        }
+        queue.push(packet(25, now), now);
+        let mut replacement = packet(1, now);
+        replacement.packet.header.ssrc = 9;
+        let output = queue.push(replacement, now);
+        assert_eq!(sequences(&output), [1]);
+        assert!(output.discarded > 0);
+        assert!(queue.pending.is_empty());
+    }
+    #[test]
+    fn missing_head_arriving_at_capacity_precedes_every_buffered_packet() {
+        let now = Instant::now();
+        let mut queue = AudioReorder::default();
+        queue.push(packet(10, now), now);
+        for sequence in 12..22 {
+            queue.push(packet(sequence, now), now);
+        }
+        assert_eq!(queue.pending.len(), CAPACITY);
+        let output = queue.push(packet(11, now), now);
+        assert_eq!(sequences(&output), (11..22).collect::<Vec<_>>());
+        assert!(queue.pending.is_empty());
+    }
+    #[test]
+    fn nearer_gap_fill_at_capacity_precedes_future_packets_even_across_wrap() {
+        let now = Instant::now();
+        for first in [10u16, 65530] {
+            let mut queue = AudioReorder::default();
+            queue.push(packet(first, now), now);
+            for offset in 3..13 {
+                queue.push(packet(first.wrapping_add(offset), now), now);
+            }
+            assert_eq!(queue.pending.len(), CAPACITY);
+            let nearer = first.wrapping_add(2);
+            let output = queue.push(packet(nearer, now), now);
+            assert_eq!(
+                sequences(&output),
+                (2..13)
+                    .map(|offset| first.wrapping_add(offset))
+                    .collect::<Vec<_>>()
+            );
+            assert!(output.peak_depth <= CAPACITY);
+            assert!(queue.pending.is_empty());
+            assert!(queue.expire(now + GAP_WAIT).packets.is_empty());
+            let late = queue.push(packet(first.wrapping_add(1), now), now + GAP_WAIT);
+            assert!(late.packets.is_empty());
+            assert_eq!(late.discarded, 1);
+            assert_eq!(queue.push(packet(nearer, now), now + GAP_WAIT).discarded, 1);
+        }
+    }
+}
