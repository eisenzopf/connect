+#[cfg(test)]
+mod managed_final_metadata_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize,Ordering};
+    #[test]
+    fn exact_final_lifecycle_fence_is_try_only_and_retains_actual_original_incarnation() {
+        let authority=SessionLeaseAuthority::new();
+        let lease=authority.admit(SessionId::from("managed-final-real-cell")).unwrap();
+        let cell=Arc::clone(authority.cells.get(lease.key()).unwrap().value());
+        let calls=AtomicUsize::new(0);
+        let held=cell.state.lock().unwrap();
+        assert!(matches!(authority.try_with_current_exact(lease.key(),||{calls.fetch_add(1,Ordering::SeqCst);Ok(())}),Err(CurrentMetadataError::Busy)));
+        assert_eq!(calls.load(Ordering::SeqCst),0);
+        drop(held);
+        authority.try_with_current_exact(lease.key(),|| {
+            assert!(cell.state.try_lock().is_err(),"the callback borrows the real lifetime fence");
+            calls.fetch_add(1,Ordering::SeqCst);Ok(())
+        }).unwrap();
+        assert_eq!(calls.load(Ordering::SeqCst),1);
+        authority.retire(lease.key()).unwrap();
+        assert!(matches!(authority.try_with_current_exact(lease.key(),||{calls.fetch_add(1,Ordering::SeqCst);Ok(())}),Err(CurrentMetadataError::Unavailable)));
+        assert_eq!(calls.load(Ordering::SeqCst),1);
+    }
+    #[test]
+    fn final_lifecycle_poison_is_immediately_fatal_before_owned_notification_is_finished() {
+        let authority=SessionLeaseAuthority::new();
+        let lease=authority.admit(SessionId::from("managed-final-poison")).unwrap();
+        let cell=Arc::clone(authority.cells.get(lease.key()).unwrap().value());
+        let mut cancelled=cell.cancel.subscribe();
+        assert!(std::panic::catch_unwind(AssertUnwindSafe(||{let _held=cell.state.lock().unwrap();panic!("controlled actual cell poison")})).is_err());
+        let error=authority.try_with_current_exact(lease.key(),||Ok(())).unwrap_err();
+        assert!(!authority.final_metadata_healthy());
+        assert_eq!(authority.fatal_reason(),Some(AuthorityFatalReason::CellPoisoned));
+        assert!(!*cancelled.borrow_and_update(),"notification has not run under final grants");
+        assert!(matches!(authority.try_with_current_exact(lease.key(),||Ok(())),Err(CurrentMetadataError::Unavailable)));
+        match error {CurrentMetadataError::Fatal(deferred)=>deferred.finish(),other=>panic!("unexpected failure: {other:?}")}
+        assert!(*cancelled.borrow_and_update());
+        assert!(!authority.final_metadata_healthy());
+    }
+    #[test]
+    fn final_lifecycle_panicking_cut_releases_real_fence_and_next_turn_fails_closed() {
+        let authority=SessionLeaseAuthority::new();
+        let lease=authority.admit(SessionId::from("managed-final-panic")).unwrap();
+        let cell=Arc::clone(authority.cells.get(lease.key()).unwrap().value());
+        assert!(std::panic::catch_unwind(AssertUnwindSafe(|| {
+            let _:Result<(),CurrentMetadataError>=authority.try_with_current_exact(lease.key(),||panic!("actual final callback"));
+        })).is_err());
+        assert!(matches!(cell.state.try_lock(),Err(std::sync::TryLockError::Poisoned(_))),"guard was released, not left locked");
+        let failure=authority.try_with_current_exact(lease.key(),||Ok(())).unwrap_err();
+        assert!(!authority.final_metadata_healthy());
+        if let CurrentMetadataError::Fatal(deferred)=failure {deferred.finish()}else{panic!("missing owned fatal notification")}
+    }
