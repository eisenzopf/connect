+//! Actual try-only SIP route custody. Never Store or publication authority.
+use super::*;
+use crate::session_lifecycle::CurrentMetadataError;
+use rvoip_core::capability::CodecInfo;
+use std::marker::PhantomData;
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum SipManagedRouteRole { ReplacementSource, ReplacementTarget }
+/// Exact attribution and original physical incarnation; not current permission.
+#[derive(Clone,PartialEq,Eq)]
+pub struct SipManagedRouteScope {
+    record:String, attempt:String, effect:String,
+    connection:ConnectionId, generation:u64, role:SipManagedRouteRole,
+}
+impl SipManagedRouteScope {
+    pub fn new(binding:(&str,&str,&str),connection:ConnectionId,generation:u64,role:SipManagedRouteRole)->rvoip_core::staged_streams::ControlResult<Self> {
+        if binding.0.is_empty()||binding.1.is_empty()||binding.2.is_empty()||generation==0 {
+            return Err(rvoip_core::staged_streams::StreamControlError::Authority);
+        }
+        Ok(Self {record:binding.0.into(),attempt:binding.1.into(),effect:binding.2.into(),connection,generation,role})
+    }
+    pub fn attempt_binding(&self)->(&str,&str,&str) {(&self.record,&self.attempt,&self.effect)}
+    pub fn role(&self)->SipManagedRouteRole {self.role}
+    pub fn connection(&self)->&ConnectionId {&self.connection}
+    pub fn generation(&self)->u64 {self.generation}
+}
+/// Own outside the complete final turn: even fatal notification may enter maps
+/// and watches. The fatal bit has ALREADY failed closed before this is returned.
+pub struct SipFinalRouteFailure { inner:Option<CurrentMetadataError> }
+impl std::fmt::Debug for SipFinalRouteFailure {
+    fn fmt(&self,f:&mut fmt::Formatter<'_>)->fmt::Result {f.write_str("SipFinalRouteFailure(redacted)")}
+}
+impl SipFinalRouteFailure {
+    pub fn is_busy(&self)->bool {matches!(self.inner,Some(CurrentMetadataError::Busy))}
+    pub fn error(&self)->rvoip_core::staged_streams::StreamControlError {
+        if self.is_busy() {rvoip_core::staged_streams::StreamControlError::MetadataBusy}
+        else {rvoip_core::staged_streams::StreamControlError::NotReady}
+    }
+    /// Call after every Writer/Core/role/SIP guard drops.
+    pub fn finish(mut self) {
+        if let Some(CurrentMetadataError::Fatal(fatal))=self.inner.take() {fatal.finish();}
+    }
+}
+impl Drop for SipFinalRouteFailure {
+    fn drop(&mut self) {
+        // Service owns this in its OUTER cleanup frame, so unwind drops all
+        // actual final-turn guards first. No fatal notification is discarded.
+        if let Some(CurrentMetadataError::Fatal(fatal))=self.inner.take() {fatal.finish();}
+    }
+}
+/// Grant-free lifetime custody captured into the caller OUTER frame before
+/// final admission. No Reader, route guard, permission or currentness snapshot.
+/// Even a stale partial capture retains every upgraded owner until the caller
+/// releases ALL final aliases; helper errors/panics cannot trigger last-owner
+/// route/adapter Drop beneath a Writer. Never construct as a temporary argument.
+pub struct SipManagedRouteResource {
+    context:Weak<Context>,
+    route:Option<Arc<SipOutboundRoute>>,
+    adapter:Option<Arc<SipAdapter>>,
+}
+/// Static nonowning view for existing Any callbacks. Every clone invalidates
+/// BEFORE any real guard releases, including on a panicking cut. This flag is
+/// never final publication authority: the final witness borrows the real proof.
+#[derive(Clone)]
+pub struct SipFinalRouteView {
+    context:Weak<Context>, route:Weak<SipOutboundRoute>, scope:SipManagedRouteScope,
+    codec:CodecInfo, turn:Weak<AtomicBool>,
+    authority:Weak<crate::session_lifecycle::SessionLeaseAuthority>,
+}
+impl std::fmt::Debug for SipFinalRouteView {
+    fn fmt(&self,f:&mut fmt::Formatter<'_>)->fmt::Result {f.write_str("SipFinalRouteView(redacted)")}
+}
+impl SipFinalRouteView {
+    pub fn is_current_for(&self,context:&SipDeviceReplacementContext,scope:&SipManagedRouteScope)->bool {
+        self.authority.upgrade().is_some_and(|authority|authority.final_metadata_healthy())
+            && self.scope==*scope && Weak::ptr_eq(&self.context,&Arc::downgrade(&context.inner))
+            && self.turn.upgrade().is_some_and(|turn|turn.load(Ordering::Acquire))
+            && !context.inner.principal.is_expired() && replacement_lifetime_current(&context.inner)
+            && self.route.upgrade().is_some_and(|route|
+                route.connection_id==self.scope.connection && !route.final_cancelled.load(Ordering::Acquire))
+    }
+    pub fn scope(&self)->&SipManagedRouteScope {&self.scope}
+    pub fn codec(&self)->&CodecInfo {&self.codec}
+}
+/// Borrowed lexical proof, never queued/installed in an invocation. Actual
+/// guards stay on the helper stack through this synchronous callback only.
+pub struct SipCurrentMediaRoute<'a> {
+    context:&'a SipDeviceReplacementContext, scope:&'a SipManagedRouteScope,
+    codec:&'a CodecInfo, view:SipFinalRouteView, _guard_scope:PhantomData<&'a mut ()>,
+}
+impl SipCurrentMediaRoute<'_> {
+    pub fn view(&self)->SipFinalRouteView {self.view.clone()}
+    pub fn is_current(&self)->bool {self.is_current_for(self.context,self.scope)}
+    pub fn scope(&self)->&SipManagedRouteScope {self.scope}
+    pub fn belongs_to(&self,controller:&Arc<rvoip_core::staged_streams::StreamController>)->bool {
+        self.context.inner.media.get().is_some_and(|media|Arc::ptr_eq(&media.controller,controller))
+    }
+    pub fn is_current_for(&self,context:&SipDeviceReplacementContext,scope:&SipManagedRouteScope)->bool {
+        Arc::ptr_eq(&self.context.inner,&context.inner)&&self.scope==scope&&self.codec==self.view.codec()
+            && self.view.is_current_for(context,scope)
+    }
+    pub fn codec(&self)->&CodecInfo {self.codec}
+}
+struct Turn(Arc<AtomicBool>);
+impl Drop for Turn {fn drop(&mut self){self.0.store(false,Ordering::Release);}}
+
+impl SipDeviceReplacementContext {
+    /// Infallible grant-free capture: absent owners remain absent, never current.
+    /// There is no fallible early return that could drop a partial last owner.
+    pub fn capture_managed_route_resource(&self)->SipManagedRouteResource {
+        SipManagedRouteResource {
+            context:Arc::downgrade(&self.inner),
+            route:self.inner.route.get().and_then(Weak::upgrade),
+            adapter:self.inner.adapter.upgrade(),
+        }
+    }
+    /// Busy NEVER invokes cut. No ordinary map/codec lookup is reentered while
+    /// these guards are held; only the exact proof/view may guide callbacks.
+    pub fn try_with_managed_final_route<T>(&self,resource:&SipManagedRouteResource,scope:&SipManagedRouteScope,
+        cut:impl for<'a> FnOnce(SipCurrentMediaRoute<'a>)->T)->Result<T,SipFinalRouteFailure> {
+        let context=&self.inner;
+        let attempt=||->Result<T,CurrentMetadataError> {
+            if !replacement_lifetime_current(context)||context.principal.is_expired()
+                ||scope.connection!=context.pending.intent().replacement||scope.generation!=context.pending.generation()
+            {return Err(CurrentMetadataError::Unavailable);}
+            if !Weak::ptr_eq(&resource.context,&Arc::downgrade(context))
+                || !Weak::ptr_eq(&context.adapter,&resource.adapter.as_ref().map(Arc::downgrade).unwrap_or_default())
+            {return Err(CurrentMetadataError::Unavailable);}
+            let route=resource.route.as_ref().ok_or(CurrentMetadataError::Unavailable)?;
+            let adapter=resource.adapter.as_ref().ok_or(CurrentMetadataError::Unavailable)?;
+            if !context.route.get().is_some_and(|original|Weak::ptr_eq(original,&Arc::downgrade(route)))
+            {return Err(CurrentMetadataError::Unavailable);}
+            if !route.replacement.get().is_some_and(|original|Arc::ptr_eq(original,context)) {return Err(CurrentMetadataError::Unavailable);}
+            let handle=route.lifecycle_handle().ok_or(CurrentMetadataError::Unavailable)?;
+            adapter.coordinator.helpers.state_machine.store.try_with_current_snapshot(&handle,|_| {
+                let _mapping=match adapter.mapping_lock.try_lock() {
+                    Ok(v)=>v, Err(std::sync::TryLockError::WouldBlock)=>return Err(CurrentMetadataError::Busy),
+                    Err(std::sync::TryLockError::Poisoned(e))=>e.into_inner(),
+                };
+                let by_session=match adapter.by_session.try_get(&route.session_id) {
+                    dashmap::try_result::TryResult::Present(v)=>v,
+                    dashmap::try_result::TryResult::Locked=>return Err(CurrentMetadataError::Busy),
+                    dashmap::try_result::TryResult::Absent=>return Err(CurrentMetadataError::Unavailable),
+                };
+                let by_connection=match adapter.by_connection.try_get(&route.connection_id) {
+                    dashmap::try_result::TryResult::Present(v)=>v,
+                    dashmap::try_result::TryResult::Locked=>return Err(CurrentMetadataError::Busy),
+                    dashmap::try_result::TryResult::Absent=>return Err(CurrentMetadataError::Unavailable),
+                };
+                let outbound=match adapter.outbound_routes.try_get(&route.connection_id) {
+                    dashmap::try_result::TryResult::Present(v)=>v,
+                    dashmap::try_result::TryResult::Locked=>return Err(CurrentMetadataError::Busy),
+                    dashmap::try_result::TryResult::Absent=>return Err(CurrentMetadataError::Unavailable),
+                };
+                if by_session.connection_id!=route.connection_id||by_connection.session_id!=route.session_id
+                    ||!matches!(&by_session.owner,SipRouteBindingOwner::Admitted(v)if v==&handle)
+                    ||!matches!(&by_connection.owner,SipRouteBindingOwner::Admitted(v)if v==&handle)
+                    ||!Arc::ptr_eq(outbound.value(),route) {return Err(CurrentMetadataError::Unavailable);}
+                let state=match route.state.try_lock() {
+                    Ok(v)=>v,Err(std::sync::TryLockError::WouldBlock)=>return Err(CurrentMetadataError::Busy),
+                    Err(std::sync::TryLockError::Poisoned(e))=>e.into_inner(),
+                };
+                if !matches!(state.phase,SipOutboundRoutePhase::Prepared|SipOutboundRoutePhase::Activating|SipOutboundRoutePhase::Flushing|SipOutboundRoutePhase::Active)
+                    ||route.final_cancelled.load(Ordering::Acquire) {return Err(CurrentMetadataError::Unavailable);}
+                route.stream.try_with_current_bound_codec(|codec| {
+                    let alive=Arc::new(AtomicBool::new(true));
+                    // Last declared: invalidates before ALL preceding real guards.
+                    let _turn=Turn(alive.clone());
+                    let view=SipFinalRouteView {context:Arc::downgrade(context),route:Arc::downgrade(route),
+                        scope:scope.clone(),codec:codec.clone(),turn:Arc::downgrade(&alive),
+                        authority:Arc::downgrade(adapter.coordinator.helpers.state_machine.store.authority())};
+                    let proof=SipCurrentMediaRoute {context:self,scope,codec,view,_guard_scope:PhantomData};
+                    if !proof.is_current_for(self,scope) {return Err(CurrentMetadataError::Unavailable);}
+                    Ok(cut(proof))
+                })
+            })
+        };
+        attempt().map_err(|error|SipFinalRouteFailure {inner:Some(error)})
+    }
+}
