+//! Owned initial canonical audio ports on one actual RTC peer. No signaling
+//! answer or remote declaration alone establishes a source/sink resource.
+use super::*;
+use crate::media::core_audio::CoreAudioEgress;
+use crate::peer::source_clock::InboundClockLease;
+use chrono::Utc;
+use rvoip_core::{
+    staged_streams::*,
+    stream::{MediaFrame, StreamKind},
+    stream_lifecycle::*,
+};
+use std::{
+    sync::atomic::{AtomicBool, AtomicU32},
+    time::{Duration, Instant},
+};
+use tokio::{
+    sync::{mpsc, watch},
+    task::JoinHandle,
+};
+use webrtc::media_stream::{
+    Track,
+    track_remote::{TrackRemote, TrackRemoteEvent},
+};
+type Done = Shared<BoxFuture<'static, std::result::Result<(), ()>>>;
+struct Reservation {
+    peer: Weak<PeerAdmission>,
+    id: u16,
+    claimed: AtomicBool,
+}
+#[async_trait::async_trait]
+impl MediaPortCleanup for Reservation {
+    async fn close(&self) -> ControlResult<()> {
+        if self.claimed.load(Ordering::Acquire) {
+            Err(StreamControlError::CleanupUnconfirmed)
+        } else {
+            Ok(())
+        }
+    }
+}
+struct Handles {
+    peer: Weak<PeerAdmission>,
+    next: AtomicU32,
+}
+impl StreamHandleReserver for Handles {
+    fn reserve(&self) -> ControlResult<StreamHandleAllocation> {
+        if self.peer.upgrade().is_none_or(|p| p.is_closed()) {
+            return Err(StreamControlError::Cancelled);
+        }
+        let id = self
+            .next
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                (n <= u16::MAX as u32).then_some(n + 1)
+            })
+            .map_err(|_| StreamControlError::from(MediaTransitionError::Capacity))?
+            as u16;
+        let owner = Arc::new(Reservation {
+            peer: self.peer.clone(),
+            id,
+            claimed: AtomicBool::new(false),
+        });
+        Ok(StreamHandleAllocation::new(id, owner.clone())?.with_unprepared_cleanup(owner))
+    }
+}
+pub(super) fn handles(peer: &Arc<PeerAdmission>) -> Arc<StreamHandleAllocator> {
+    StreamHandleAllocator::shared(Arc::new(Handles {
+        peer: Arc::downgrade(peer),
+        next: AtomicU32::new(1),
+    }))
+}
+#[derive(Clone)]
+struct Received {
+    packet: rtc::rtp::Packet,
+    at: Instant,
+}
+struct Source {
+    format: MediaFormat,
+    ssrc: u32,
+    payload_type: u8,
+    lease: Arc<InboundClockLease>,
+}
+struct SourceJob {
+    ready: watch::Receiver<Option<std::result::Result<Arc<Source>, ()>>>,
+    done: Done,
+}
+// Resource lifetime only. Panic/abort must invalidate readiness; this does
+// not acknowledge cleanup or release any original join/capacity owner.
+struct JobLifetime {
+    ready: Option<Arc<AtomicBool>>,
+    stop: CancellationToken,
+}
+impl Drop for JobLifetime {
+    fn drop(&mut self) {
+        if let Some(ready) = &self.ready {
+            ready.store(false, Ordering::Release);
+        }
+        self.stop.cancel();
+    }
+}
+struct Setup {
+    closing: bool,
+    tasks: Vec<JoinHandle<ControlResult<()>>>,
+}
+struct PortIo {
+    port: WeakAdapterMediaPort,
+    binding: ReadyMediaBinding,
+    physical: Arc<WebRtcPhysicalBinding>,
+    stop: CancellationToken,
+    input: mpsc::Sender<Received>,
+    setup: Arc<Mutex<Setup>>,
+    close: OnceLock<Done>,
+    ready: Arc<AtomicBool>,
+    map: Weak<DashMap<StreamId, Arc<PortIo>>>,
+}
+impl PortIo {
+    fn start(
+        &self,
+        f: impl std::future::Future<Output = ControlResult<()>> + Send + 'static,
+    ) -> ControlResult<()> {
+        let mut setup = self.setup.lock().unwrap_or_else(|p| p.into_inner());
+        if setup.closing || self.stop.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let state = self.setup.clone();
+        let ready = self.ready.clone();
+        let port = self.port.clone();
+        let stop = self.stop.clone();
+        setup.tasks.push(tokio::spawn(async move {
+            let _lifetime = JobLifetime {
+                ready: Some(ready.clone()),
+                stop: stop.clone(),
+            };
+            let result = std::panic::AssertUnwindSafe(f)
+                .catch_unwind()
+                .await
+                .unwrap_or(Err(StreamControlError::CleanupUnconfirmed));
+            ready.store(false, Ordering::Release);
+            {
+                let mut state = state.lock().unwrap_or_else(|p| p.into_inner());
+                state.closing = true;
+            }
+            if !stop.is_cancelled() {
+                stop.cancel();
+                if let Some(port) = port.upgrade() {
+                    let _ = port.report_terminal();
+                }
+            }
+            result
+        }));
+        Ok(())
+    }
+}
+impl Drop for PortIo {
+    fn drop(&mut self) {
+        self.stop.cancel();
+    }
+}
+#[async_trait::async_trait]
+impl MediaPortCleanup for PortIo {
+    async fn close(&self) -> ControlResult<()> {
+        self.stop.cancel();
+        let done = self.close.get_or_init(|| {
+            let tasks = {
+                let mut setup = self.setup.lock().unwrap_or_else(|p| p.into_inner());
+                setup.closing = true;
+                std::mem::take(&mut setup.tasks)
+            };
+            let task = tokio::spawn(async move {
+                let mut clean = true;
+                for task in tasks {
+                    if !matches!(task.await, Ok(Ok(()))) {
+                        clean = false;
+                    }
+                }
+                if clean { Ok(()) } else { Err(()) }
+            });
+            async move { task.await.unwrap_or(Err(())) }
+                .boxed()
+                .shared()
+        });
+        let result = done.clone().await;
+        // This is actual original parent-driver destruction, not an inferred
+        // packet result. It resolves no-IO cleanup while preserving uncertainty
+        // about a write whose original receipt was lost.
+        if result.is_err() && !self.physical.actual_close_confirmed() {
+            return Err(StreamControlError::CleanupUnconfirmed);
+        }
+        if let Some(map) = self.map.upgrade() {
+            map.remove_if(&self.binding.transport_id, |_, v| {
+                std::ptr::eq(self, Arc::as_ptr(v))
+            });
+        }
+        Ok(())
+    }
+}
+pub(super) struct Backend {
+    id: ConnectionId,
+    physical: Arc<WebRtcPhysicalBinding>,
+    lifetime: CancellationToken,
+    ports: Arc<DashMap<StreamId, Arc<PortIo>>>,
+    source: OnceLock<SourceJob>,
+    close: OnceLock<Done>,
+    source_lock: Mutex<()>,
+}
+impl Drop for Backend {
+    fn drop(&mut self) {
+        self.lifetime.cancel();
+    }
+}
+impl Backend {
+    pub(super) fn new(
+        id: ConnectionId,
+        physical: Arc<WebRtcPhysicalBinding>,
+        lifetime: CancellationToken,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            id,
+            physical,
+            lifetime,
+            ports: Arc::new(DashMap::new()),
+            source: OnceLock::new(),
+            close: OnceLock::new(),
+            source_lock: Mutex::new(()),
+        })
+    }
+    fn current(&self) -> bool {
+        !self.lifetime.is_cancelled()
+            && self.physical.owner_current()
+            && self.physical.rtc_current()
+    }
+    pub(super) async fn close(&self) -> ControlResult<()> {
+        let original = {
+            let _source_guard = self.source_lock.lock().unwrap_or_else(|p| p.into_inner());
+            self.lifetime.cancel();
+            self.close
+                .get_or_init(|| {
+                    let ports = self
+                        .ports
+                        .iter()
+                        .map(|p| p.value().clone())
+                        .collect::<Vec<_>>();
+                    let source = self.source.get().map(|s| s.done.clone());
+                    let physical = self.physical.clone();
+                    let task = tokio::spawn(async move {
+                        let mut clean = true;
+                        for port in ports {
+                            if port.close().await.is_err() {
+                                clean = false;
+                            }
+                        }
+                        if let Some(source) = source {
+                            if source.await.is_err() {
+                                clean = false;
+                            }
+                        }
+                        if clean || physical.actual_close_confirmed() {
+                            Ok(())
+                        } else {
+                            Err(())
+                        }
+                    });
+                    async move { task.await.unwrap_or(Err(())) }
+                        .boxed()
+                        .shared()
+                })
+                .clone()
+        };
+        original
+            .await
+            .map_err(|_| StreamControlError::CleanupUnconfirmed)
+    }
+    fn source(
+        &self,
+        peer: Arc<RvoipPeerConnection>,
+        payload_type: u8,
+        format: MediaFormat,
+    ) -> ControlResult<watch::Receiver<Option<std::result::Result<Arc<Source>, ()>>>> {
+        let _guard = self.source_lock.lock().unwrap_or_else(|p| p.into_inner());
+        if self.lifetime.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let source = self.source.get_or_init(|| {
+            let (tx, ready) = watch::channel(None);
+            let stop = self.lifetime.clone();
+            let ports = self.ports.clone();
+            let task = tokio::spawn(async move {
+                let _lifetime = JobLifetime {
+                    ready: None,
+                    stop: stop.clone(),
+                };
+                let result =
+                    source_loop(peer, payload_type, format, stop.clone(), ports, &tx).await;
+                if tx.borrow().is_none() {
+                    tx.send_replace(Some(Err(())));
+                }
+                if result.is_err() {
+                    stop.cancel();
+                }
+                result.map_err(|_| ())
+            });
+            let done = async move { task.await.unwrap_or(Err(())) }
+                .boxed()
+                .shared();
+            SourceJob { ready, done }
+        });
+        Ok(source.ready.clone())
+    }
+    async fn source_ready(
+        &self,
+        peer: Arc<RvoipPeerConnection>,
+        pt: u8,
+        format: &MediaFormat,
+        deadline: tokio::time::Instant,
+        cancel: &CancellationToken,
+    ) -> ControlResult<Arc<Source>> {
+        let mut ready = self.source(peer, pt, format.clone())?;
+        loop {
+            if let Some(result) = ready.borrow().clone() {
+                let source = result.map_err(|_| StreamControlError::NotReady)?;
+                if source.payload_type != pt || source.format != *format {
+                    return Err(StreamControlError::Unsupported);
+                }
+                return Ok(source);
+            }
+            tokio::select! {biased;
+                _=self.lifetime.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=tokio::time::sleep_until(deadline)=>return Err(StreamControlError::Deadline),
+                r=ready.changed()=>if r.is_err(){return Err(StreamControlError::NotReady);},
+            }
+        }
+    }
+    fn confirms(&self, bindings: &[ReadyMediaBinding]) -> bool {
+        self.current()
+            && !bindings.is_empty()
+            && bindings.iter().all(|b| {
+                self.ports.get(&b.transport_id).is_some_and(|p| {
+                    p.ready.load(Ordering::Acquire)
+                        && !p.stop.is_cancelled()
+                        && same_binding(&p.binding, b)
+                        && p.setup.try_lock().is_ok_and(|setup| {
+                            !setup.closing
+                                && !setup.tasks.is_empty()
+                                && setup.tasks.iter().all(|task| !task.is_finished())
+                        })
+                })
+            })
+    }
+}
+fn same_binding(a: &ReadyMediaBinding, b: &ReadyMediaBinding) -> bool {
+    a.transport_id == b.transport_id
+        && a.stream_local_id == b.stream_local_id
+        && a.generation == b.generation
+        && a.connection_generation == b.connection_generation
+        && a.negotiated == b.negotiated
+        && a.source_ready == b.source_ready
+        && a.sink_ready == b.sink_ready
+}
+async fn shape(peer: &RvoipPeerConnection) -> ControlResult<(MediaFormat, u8, bool, bool)> {
+    if !peer.core_transport_current() || !peer.signaling_is_stable().await {
+        return Err(StreamControlError::NotReady);
+    }
+    let pc = peer.peer_connection();
+    let local = pc
+        .local_description()
+        .await
+        .ok_or(StreamControlError::NotReady)?;
+    let remote = pc
+        .remote_description()
+        .await
+        .ok_or(StreamControlError::NotReady)?;
+    let (offer, answer) = match (local.sdp_type, remote.sdp_type) {
+        (
+            webrtc::peer_connection::RTCSdpType::Offer,
+            webrtc::peer_connection::RTCSdpType::Answer,
+        ) => (&local.sdp, &remote.sdp),
+        (
+            webrtc::peer_connection::RTCSdpType::Answer,
+            webrtc::peer_connection::RTCSdpType::Offer,
+        ) => (&remote.sdp, &local.sdp),
+        _ => return Err(StreamControlError::NotReady),
+    };
+    let mapping = crate::sdp::negotiated_single_audio_payload(offer, answer)
+        .map_err(|_| StreamControlError::Unsupported)?;
+    if !matches!(mapping.codec.name.as_str(), "g.711-mu" | "g.711-a")
+        || mapping.codec.clock_rate_hz != 8000
+        || mapping.codec.channels != 1
+    {
+        return Err(StreamControlError::Unsupported);
+    }
+    fn direction(s: &str) -> ControlResult<(bool, bool)> {
+        let parsed = s
+            .parse::<rvoip_sip_core::types::sdp::SdpSession>()
+            .map_err(|_| StreamControlError::Unsupported)?;
+        let mut audio = parsed
+            .media_descriptions
+            .iter()
+            .filter(|m| m.media == "audio" && m.port != 0);
+        let one = audio.next().ok_or(StreamControlError::NotReady)?;
+        if audio.next().is_some() {
+            return Err(StreamControlError::Unsupported);
+        }
+        let direction = one
+            .direction
+            .as_ref()
+            .or(parsed.direction.as_ref())
+            .map(ToString::to_string)
+            .unwrap_or_else(|| "sendrecv".into());
+        match direction.as_str() {
+            "sendrecv" => Ok((true, true)),
+            "sendonly" => Ok((true, false)),
+            "recvonly" => Ok((false, true)),
+            "inactive" => Ok((false, false)),
+            _ => Err(StreamControlError::Unsupported),
+        }
+    }
+    let (ls, lr) = direction(&local.sdp)?;
+    let (rs, rr) = direction(&remote.sdp)?;
+    if !peer.core_transport_current() || !peer.signaling_is_stable().await {
+        return Err(StreamControlError::NotReady);
+    }
+    Ok((
+        MediaFormat::Encoded {
+            name: match mapping.codec.name.as_str() {
+                "g.711-mu" => "pcmu",
+                "g.711-a" => "pcma",
+                _ => return Err(StreamControlError::Unsupported),
+            }
+            .into(),
+            clock_rate_hz: 8000,
+            channels: 1,
+            fmtp: mapping.codec.fmtp,
+        },
+        mapping.payload_type,
+        lr && rs,
+        ls && rr,
+    ))
+}
+#[async_trait::async_trait]
+impl StagedMediaAdapter for Backend {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        if self.lifetime.is_cancelled() || !self.physical.owner_current() {
+            return Err(StreamControlError::Cancelled);
+        }
+        // This initial backend is one logical G.711 audio source, not an
+        // implicit codec/transport fallback for unsupported media.
+        if ports.len() != 1 {
+            return Err(StreamControlError::Unsupported);
+        }
+        let prepared = &ports[0];
+        let b = prepared.port.binding();
+        if !prepared.is_new {
+            return if self.confirms(std::slice::from_ref(b)) {
+                Ok(())
+            } else {
+                Err(StreamControlError::NotReady)
+            };
+        }
+        let allocation = prepared
+            .port
+            .allocation_owner()?
+            .downcast::<Reservation>()
+            .map_err(|_| StreamControlError::Authority)?;
+        {
+            let owner = self
+                .physical
+                .owner
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            if allocation.id != b.stream_local_id
+                || !owner
+                    .as_ref()
+                    .is_some_and(|o| Weak::ptr_eq(&o.peer, &allocation.peer))
+            {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        let (_, _, connection) = prepared.port.context_ids()?;
+        if connection != self.id {
+            return Err(StreamControlError::Authority);
+        }
+        let (tx, rx) = mpsc::channel(10);
+        let io = Arc::new(PortIo {
+            port: prepared.port.downgrade(),
+            binding: b.clone(),
+            physical: self.physical.clone(),
+            stop: self.lifetime.child_token(),
+            input: tx,
+            setup: Arc::new(Mutex::new(Setup {
+                closing: false,
+                tasks: vec![],
+            })),
+            close: OnceLock::new(),
+            ready: Arc::new(AtomicBool::new(false)),
+            map: Arc::downgrade(&self.ports),
+        });
+        prepared.port.install_cleanup(io.clone())?;
+        if allocation.claimed.swap(true, Ordering::AcqRel) {
+            return Err(StreamControlError::Authority);
+        }
+        match self.ports.entry(b.transport_id.clone()) {
+            dashmap::mapref::entry::Entry::Vacant(e) => {
+                e.insert(io.clone());
+            }
+            _ => return Err(StreamControlError::Authority),
+        }
+        if io.stop.is_cancelled() || cancel.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let peer = tokio::select! {biased;_=cancel.cancelled()=>return Err(StreamControlError::Cancelled),_=io.stop.cancelled()=>return Err(StreamControlError::Cancelled),p=self.physical.peer(deadline)=>p.map_err(|_|StreamControlError::NotReady)?};
+        tokio::select! {biased;
+            _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=io.stop.cancelled()=>return Err(StreamControlError::Cancelled),
+            r=peer.wait_connected(deadline.saturating_duration_since(tokio::time::Instant::now()))=>r.map_err(|_|StreamControlError::NotReady)?,
+        }
+        let (format, pt, can_receive, can_send) = tokio::time::timeout_at(deadline, shape(&peer))
+            .await
+            .map_err(|_| StreamControlError::Deadline)??;
+        if b.negotiated.requested.medium != Medium::Audio
+            || b.negotiated.format != format
+            || b.source_ready && !can_receive
+            || b.sink_ready && !can_send
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let source = if b.source_ready {
+            Some(
+                self.source_ready(peer.clone(), pt, &format, deadline, &cancel)
+                    .await?,
+            )
+        } else {
+            None
+        };
+        let egress = if b.sink_ready {
+            Some(
+                peer.core_audio_egress(&prepared.port, deadline.into_std())
+                    .await?,
+            )
+        } else {
+            None
+        };
+        if let Some(source) = source {
+            io.start(ingress(io.port.clone(), io.stop.clone(), rx, source))?;
+        }
+        if let Some(egress) = egress {
+            io.start(egress_loop(egress, io.stop.clone()))?;
+        }
+        if !self.current() || cancel.is_cancelled() || io.stop.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let setup = io.setup.lock().unwrap_or_else(|p| p.into_inner());
+        if setup.closing || io.stop.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        prepared.port.observe_ready(
+            &format,
+            b.source_ready && can_receive,
+            b.sink_ready && can_send,
+            Some(pt),
+        )?;
+        io.ready.store(true, Ordering::Release);
+        drop(setup);
+        Ok(())
+    }
+}
+async fn source_loop(
+    peer: Arc<RvoipPeerConnection>,
+    pt: u8,
+    format: MediaFormat,
+    stop: CancellationToken,
+    ports: Arc<DashMap<StreamId, Arc<PortIo>>>,
+    ready: &watch::Sender<Option<std::result::Result<Arc<Source>, ()>>>,
+) -> ControlResult<()> {
+    let track = loop {
+        let track = tokio::select! {biased;_=stop.cancelled()=>return Ok(()),_=peer.wait_failed()=>return Err(StreamControlError::NotReady),t=peer.recv_remote_track()=>t.ok_or(StreamControlError::NotReady)?};
+        if track.kind().await == rtc::rtp_transceiver::rtp_sender::RtpCodecKind::Audio {
+            break track;
+        }
+    };
+    let ssrcs = track.ssrcs().await;
+    if ssrcs.len() != 1 {
+        return Err(StreamControlError::Unsupported);
+    }
+    let ssrc = ssrcs[0];
+    let codec = track
+        .codec(ssrc)
+        .await
+        .ok_or(StreamControlError::NotReady)?;
+    let expected = match &format {
+        MediaFormat::Encoded { name, .. } if name == "pcmu" => "audio/pcmu",
+        MediaFormat::Encoded { name, .. } if name == "pcma" => "audio/pcma",
+        _ => return Err(StreamControlError::Unsupported),
+    };
+    if !codec.mime_type.eq_ignore_ascii_case(expected)
+        || codec.clock_rate != 8000
+        || codec.channels != 1
+    {
+        return Err(StreamControlError::Unsupported);
+    }
+    let identity: Arc<dyn Send + Sync> = track.clone();
+    let lease = Arc::new(peer.source_clock.lease_identity(&ssrcs, &identity));
+    // Advanced synchronized A/V needs its independently qualified source-clock
+    // profile; never silently remove that requirement for this initial audio.
+    if lease.required {
+        return Err(StreamControlError::Unsupported);
+    }
+    let source = Arc::new(Source {
+        format,
+        ssrc,
+        payload_type: pt,
+        lease,
+    });
+    loop {
+        let event = tokio::select! {biased;_=stop.cancelled()=>return Ok(()),_=peer.wait_failed()=>return Err(StreamControlError::NotReady),e=track.poll()=>e};
+        match event {
+            Some(TrackRemoteEvent::OnRtpPacket(packet, at)) => {
+                if packet.header.ssrc != ssrc
+                    || packet.header.payload_type != pt
+                    || at.elapsed() >= Duration::from_millis(200)
+                {
+                    continue;
+                }
+                if ready.borrow().is_none() {
+                    ready.send_replace(Some(Ok(source.clone())));
+                }
+                for entry in ports.iter() {
+                    let io = entry.value();
+                    // Arrival before activation can establish resources but
+                    // cannot be replayed as a new generation's publication.
+                    if !io.ready.load(Ordering::Acquire)
+                        || io.stop.is_cancelled()
+                        || io
+                            .port
+                            .upgrade()
+                            .is_none_or(|p| p.status() != PortStatus::Active)
+                    {
+                        continue;
+                    }
+                    let _ = io.input.try_send(Received {
+                        packet: packet.clone(),
+                        at,
+                    });
+                }
+            }
+            None | Some(TrackRemoteEvent::OnError | TrackRemoteEvent::OnEnded) => {
+                return if stop.is_cancelled() {
+                    Ok(())
+                } else {
+                    Err(StreamControlError::NotReady)
+                };
+            }
+            _ => {}
+        }
+    }
+}
+async fn ingress(
+    port: WeakAdapterMediaPort,
+    stop: CancellationToken,
+    mut input: mpsc::Receiver<Received>,
+    source: Arc<Source>,
+) -> ControlResult<()> {
+    loop {
+        let received = tokio::select! {biased;_=stop.cancelled()=>return Ok(()),p=input.recv()=>match p{Some(p)=>p,None=>return Ok(())}};
+        let Some(port) = port.upgrade() else {
+            return Ok(());
+        };
+        let frame = MediaFrame {
+            stream_id: port.binding().transport_id.clone(),
+            kind: StreamKind::Audio,
+            payload: received.packet.payload.clone(),
+            timestamp_rtp: received.packet.header.timestamp,
+            captured_at: Utc::now()
+                .checked_sub_signed(
+                    chrono::Duration::from_std(received.at.elapsed())
+                        .unwrap_or(chrono::Duration::MAX),
+                )
+                .unwrap_or(chrono::DateTime::<Utc>::MIN_UTC),
+            payload_type: Some(source.payload_type),
+            source_clock: None,
+        };
+        loop {
+            if stop.is_cancelled() {
+                return Ok(());
+            };
+            if received.at.elapsed() >= Duration::from_millis(200) {
+                break;
+            }
+            let result = port.try_publish_clocked_received(&frame, received.at, |_| {
+                source.lease.capture(source.ssrc)
+            });
+            match result {
+                Ok(()) => break,
+                Err(StreamControlError::Backpressure) => {
+                    tokio::select! {biased;_=stop.cancelled()=>return Ok(()),_=tokio::time::sleep_until(tokio::time::Instant::from_std(received.at+Duration::from_millis(200)))=>break,_=tokio::time::sleep(Duration::from_millis(2))=>{}}
+                }
+                Err(_) => break,
+            }
+        }
+    }
+}
+async fn egress_loop(mut egress: CoreAudioEgress, stop: CancellationToken) -> ControlResult<()> {
+    loop {
+        let write = tokio::select! {biased;_=stop.cancelled()=>return Ok(()),w=egress.submit_next(Instant::now()+Duration::from_millis(100))=>match w {
+            Ok(Some(w))=>w,Ok(None)=>return Ok(()),Err(StreamControlError::Deadline)=>continue,Err(e)=>return Err(e),
+        }};
+        let _ = tokio::select! {biased;_=stop.cancelled()=>None,r=write.result()=>Some(r)};
+        // Original submission custody never moves into an observation waiter.
+        write
+            .cancel_and_drain()
+            .await
+            .map_err(|_| StreamControlError::CleanupUnconfirmed)?;
+    }
+}
+/// Metadata-only initial activation. Fresh host authority is still mandatory.
+pub struct RtcMediaActivation {
+    controller: Weak<StreamController>,
+    backend: Weak<Backend>,
+    prepared: Mutex<Option<Arc<PreparedMediaObservation>>>,
+}
+impl RtcMediaActivation {
+    pub(super) fn new(controller: &Arc<StreamController>, backend: &Arc<Backend>) -> Arc<Self> {
+        Arc::new(Self {
+            controller: Arc::downgrade(controller),
+            backend: Arc::downgrade(backend),
+            prepared: Mutex::new(None),
+        })
+    }
+}
+impl MediaActivation for RtcMediaActivation {
+    fn prepare(
+        &self,
+        prepared: &Arc<PreparedMediaObservation>,
+        current: MediaOwner,
+    ) -> ControlResult<MediaOwner> {
+        let controller = self
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let backend = self
+            .backend
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if !prepared.belongs_to(&controller) || !backend.confirms(prepared.bindings()) {
+            return Err(StreamControlError::NotReady);
+        }
+        let owner = prepared.activate_for_commit(current)?;
+        *self.prepared.lock().unwrap_or_else(|p| p.into_inner()) = Some(prepared.clone());
+        Ok(owner)
+    }
+    fn current(&self, current: MediaOwner) -> ControlResult<MediaOwner> {
+        let backend = self
+            .backend
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let prepared = self
+            .prepared
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .clone()
+            .ok_or(StreamControlError::NotReady)?;
+        if !backend.confirms(prepared.bindings()) {
+            return Err(StreamControlError::NotReady);
+        }
+        prepared.current(current)
+    }
+    fn confirmed_generation(&self) -> Option<u64> {
+        self.prepared
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()?
+            .committed_generation()
+    }
+}
+
+impl Backend {
+    pub(super) async fn initial_resources(
+        &self,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        tokio::select! { biased;
+            _=self.physical.lifetime.cancelled()=>Err(StreamControlError::Cancelled),
+            result=async {
+        if self.lifetime.is_cancelled() || !self.physical.owner_current() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let peer = tokio::select! {biased;
+            _=self.lifetime.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            p=self.physical.peer(deadline)=>p.map_err(|_|StreamControlError::NotReady)?,
+        };
+        tokio::select! {biased;
+            _=self.lifetime.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            r=peer.wait_connected(deadline.saturating_duration_since(tokio::time::Instant::now()))=>r.map_err(|_|StreamControlError::NotReady)?,
+        }
+        let (format, pt, receive, send) = tokio::time::timeout_at(deadline, shape(&peer))
+            .await
+            .map_err(|_| StreamControlError::Deadline)??;
+        if !receive && !send {
+            return Err(StreamControlError::Unsupported);
+        }
+        if receive {
+            // Start/reuse the original actor. It may observe a real source but
+            // dispatches nothing until an actual Core port is active. Its
+            // original join remains owned by Backend through every observer.
+            self.source_ready(peer, pt, &format, deadline, &cancel)
+                .await?;
+        }
+        if !self.current() || cancel.is_cancelled() || tokio::time::Instant::now() >= deadline {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(())
+            }=>result,
+        }
+    }
+}
