+                let _ = feedback.published(ssrc, clock, sequence, frame.timestamp_rtp);
+            }
+        }
+        match result {
+            Ok(()) => {
+                self.counters.accepted.fetch_add(1, Ordering::AcqRel);
+                if let (Some(flow), Some(port)) = (&self.flow, self.port.upgrade()) {
+                    flow.received(&port);
+                    flow.record_rtp(&port, true, datagram_bytes);
+                }
+                Ok(())
+            }
+            Err(e) => {
+                self.counters.rejected.fetch_add(1, Ordering::AcqRel);
+                if matches!(e, StreamControlError::Backpressure) {
+                    Err(mpsc::error::TrySendError::Full(frame))
+                } else {
+                    Err(mpsc::error::TrySendError::Closed(frame))
+                }
+            }
+        }
+    }
