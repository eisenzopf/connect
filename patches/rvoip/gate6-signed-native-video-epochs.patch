+//! Actual signed native lifecycle writer on two real local physical peers.
+//! Relationship authority is controlled; no Connect Store/SDK quality claim.
+use super::*;
+async fn epoch(f: &Fixture, wire: &mut Wire) -> Value {
+    let event = tokio::time::timeout(Duration::from_secs(3), wire.read())
+        .await
+        .unwrap();
+    assert_eq!(event.kind(), "stream.epoch", "unexpected event {event:?}");
+    f.verify_server(&event).await;
+    assert!(event.scope(Scope::Reply).is_none());
+    assert!(event.scope(Scope::Operation).is_none());
+    assert_eq!(event.scope(Scope::Conversation), Some("conversation"));
+    assert_eq!(event.scope(Scope::Session), Some("session"));
+    event.original().clone()
+}
+fn feedback_request(handle: u16, notice: &Value, seq: u32) -> Bytes {
+    pack_video_feedback_datagram(&VideoFeedbackDatagram {
+        stream_local_id: handle,
+        seq,
+        sender_ssrc: 83,
+        media_ssrc: notice["payload"]["ssrc"].as_u64().unwrap() as u32,
+        activation_epoch: u128::from_str_radix(notice["payload"]["epoch"].as_str().unwrap(), 16)
+            .unwrap(),
+    })
+    .unwrap()
+}
+async fn source_feedback(s: &Scene) -> VideoFeedbackDatagram {
+    let raw = tokio::time::timeout(
+        Duration::from_secs(2),
+        s.wire.quic.as_ref().unwrap().2.read_datagram(),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    observe_video_feedback_datagram(&raw).unwrap()
+}
+#[tokio::test]
+async fn signed_video_epochs_bind_original_operations_physical_peers_and_reselected_packet_boundaries(
+) {
+    let profile = Arc::new((*profile(false)).clone().with_video_feedback());
+    let mut s = Scene::new_profiled("quic", false, true, true, profile, None).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    let mut offer = lifecycle_offer(&s, 0, 0, "sendonly");
+    offer["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}));
+    let (answer, callback) = s.prepared(offer.clone()).await;
+    let vh = subscriptions::stream_handle(&callback, "camera");
+    // Preparation traffic has no epoch notice and cannot initialize history.
+    send(&s.wire, subscriptions::video_sequence(vh, 1, 3000));
+    no_event(&mut s.wire).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    assert!(s.record.results.lock().unwrap()[0].is_ok());
+    let mut other = s.second_wire().await;
+    let (_, cb) = other_prepared(&s, &mut other, lifecycle_offer(&s, 1, 0, "recvonly")).await;
+    other.send(s.f.sign(s.confirmation(&cb))).await;
+    s.wait(2).await;
+    let receiver = s.native.adapters[&s.kind]
+        .media_controller(&s.second_id)
+        .unwrap();
+    let subscribe = || {
+        subscriptions::command(
+            "stream.subscribe",
+            receiver.revision(),
+            json!({"subscriptions":[{"strm_id":"camera"}]}),
+        )
+    };
+    let selection = subscribe();
+    other.send(s.f.sign(selection.clone())).await;
+    let cb = other.read().await;
+    assert_eq!(cb.kind(), "connection.offer");
+    s.f.verify_server(&cb).await;
+    let bh = subscriptions::stream_handle(&cb, "camera");
+    other.send(s.f.sign(s.confirmation(&cb))).await;
+    assert_eq!(other.read().await.kind(), "ack");
+    no_event(&mut other).await;
+    no_event(&mut s.wire).await;
+    send(&s.wire, subscriptions::video_sequence(vh, 2, 6000));
+    let delivered = received(&other).await;
+    let source = epoch(&s.f, &mut s.wire).await;
+    let target = epoch(&s.f, &mut other).await;
+    let sp = &source["payload"];
+    let tp = &target["payload"];
+    assert_eq!(source["connid"], "native_0");
+    assert_eq!(target["connid"], "native_1");
+    assert_ne!(sp["incarnation"], tp["incarnation"]);
+    assert_eq!(sp["original_operation"], offer["operation_id"]);
+    assert_eq!(
+        sp["original_offer"],
+        answer.original()["payload"]["substrate_setup"]["offer_id"]
+    );
+    assert_eq!(tp["original_operation"], selection["operation_id"]);
+    assert_eq!(
+        tp["original_offer"],
+        cb.original()["payload"]["substrate_setup"]["offer_id"]
+    );
+    assert_eq!(sp["first_sequence"], 2);
+    assert_eq!(sp["first_timestamp"], 6000);
+    assert_eq!(tp["first_sequence"], delivered.seq);
+    assert_eq!(tp["first_timestamp"], 6000);
+    assert_eq!(tp["ssrc"], delivered.rtp.packet().header.ssrc);
+    assert_eq!(tp["stream_local_id"], bh);
+    assert_eq!(sp["stream_local_id"], vh);
+    assert_eq!(sp["direction"], "publisher");
+    assert_eq!(tp["direction"], "receiver");
+    assert_ne!(sp["epoch"], tp["epoch"]);
+    send(&other, feedback_request(bh, &target, 1));
+    let pli = source_feedback(&s).await;
+    assert_eq!(pli.stream_local_id, vh);
+    assert_eq!(pli.media_ssrc, 7);
+    assert_eq!(
+        format!("{:032x}", pli.activation_epoch),
+        sp["epoch"].as_str().unwrap()
+    );
+    // Reselect exactly the same source/handle/SSRC. Epoch and first sequence
+    // must still distinguish the histories; codec/clock/old media stay intact.
+    other
+        .send(s.f.sign(subscriptions::command(
+            "stream.unsubscribe",
+            receiver.revision(),
+            json!({"strm_ids":["camera"]}),
+        )))
+        .await;
+    assert_eq!(other.read().await.kind(), "ack");
+    other.send(s.f.sign(subscribe())).await;
+    assert_eq!(other.read().await.kind(), "ack");
+    send(&s.wire, subscriptions::video_sequence(vh, 3, 9000));
+    let second = received(&other).await;
+    let next = epoch(&s.f, &mut other).await;
+    let np = &next["payload"];
+    assert_eq!(np["ssrc"], tp["ssrc"]);
+    assert_eq!(np["stream_local_id"], tp["stream_local_id"]);
+    assert_eq!(np["original_operation"], tp["original_operation"]);
+    assert_eq!(np["incarnation"], tp["incarnation"]);
+    assert_eq!(np["stream_generation"], tp["stream_generation"]);
+    assert_ne!(np["epoch"], tp["epoch"]);
+    assert!(np["revision"].as_u64() > tp["revision"].as_u64());
+    assert_eq!(np["first_sequence"], second.seq);
+    assert!(second.seq > delivered.seq);
+    assert_eq!(np["first_timestamp"], 9000);
+    let media = s.native.adapters[&s.kind]
+        .physical_source(&s.second_id)
+        .unwrap()
+        .media()
+        .unwrap();
+    let rejected = media.snapshot().feedback_rejected;
+    send(&other, feedback_request(bh, &target, 2));
+    core_fixture::until(|| media.snapshot().feedback_rejected > rejected).await;
+    tokio::time::sleep(Duration::from_millis(110)).await;
+    send(&other, feedback_request(bh, &next, 2));
+    assert_eq!(source_feedback(&s).await.stream_local_id, vh);
+    assert!(s.grants.0.try_write().is_ok());
+    s.wire.server.shutdown().await.unwrap();
+    other.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn signed_video_feedback_requires_explicit_peer_confirmation_before_activation() {
+    let profile = Arc::new((*profile(false)).clone().with_video_feedback());
+    let mut s = Scene::new_profiled("quic", false, true, true, profile, None).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    let mut offer = lifecycle_offer(&s, 0, 0, "sendonly");
+    offer["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}));
+    let (_, cb) = s.prepared(offer).await;
+    let handle = subscriptions::stream_handle(&cb, "camera");
+    let mut reply = s.confirmation(&cb);
+    reply["payload"]["capabilities"]
+        .as_object_mut()
+        .unwrap()
+        .remove("video_feedback");
+    s.wire.send(s.f.sign(reply)).await;
+    s.wait(1).await;
+    assert!(s.record.results.lock().unwrap()[0].is_err());
+    assert_eq!(s.wire.read().await.kind(), "error");
+    assert_eq!(s.controller().revision(), 0);
+    assert!(s.controller().active_bindings().is_empty());
+    send(&s.wire, subscriptions::video_sequence(handle, 2, 6000));
+    no_event(&mut s.wire).await;
+    s.wire.server.shutdown().await.unwrap();
+}
