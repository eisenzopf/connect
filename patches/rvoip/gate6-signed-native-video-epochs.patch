+//! Bounded metadata for the existing owned signed lifecycle writer. No media,
+//! retained authority or additional task lives in this registry.
+use super::*;
+use crate::staged_media::{same_binding, VideoFeedbackEpoch, VideoFeedbackProfile};
+use std::sync::Weak;
+type Current = Arc<dyn Fn() -> bool + Send + Sync>;
+#[derive(Clone)]
+pub struct VideoEpochObservation {
+    pub(crate) binding: ReadyMediaBinding,
+    pub(crate) operation: String,
+    pub(crate) offer: String,
+    pub(crate) revision: u64,
+    pub(crate) epoch: VideoFeedbackEpoch,
+    current: Current,
+}
+impl std::fmt::Debug for VideoEpochObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("VideoEpochObservation(redacted)")
+    }
+}
+impl VideoEpochObservation {
+    pub fn binding(&self) -> &ReadyMediaBinding {
+        &self.binding
+    }
+    pub fn original_operation(&self) -> &str {
+        &self.operation
+    }
+    pub fn original_offer(&self) -> &str {
+        &self.offer
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn epoch(&self) -> VideoFeedbackEpoch {
+        self.epoch
+    }
+    pub(crate) fn key(&self) -> (StreamId, bool) {
+        (self.binding.transport_id.clone(), self.epoch.publisher)
+    }
+}
+#[derive(Default)]
+struct State {
+    revision: u64,
+    values: BTreeMap<(StreamId, bool), VideoEpochObservation>,
+}
+#[derive(Default)]
+pub(crate) struct Registry(Mutex<State>);
+struct Profile {
+    flow: Weak<NativeFlow>,
+    binding: ReadyMediaBinding,
+    operation: String,
+    offer: String,
+}
+impl VideoFeedbackProfile for Profile {
+    fn announce(
+        &self,
+        binding: &ReadyMediaBinding,
+        epoch: VideoFeedbackEpoch,
+        current: Current,
+    ) -> ControlResult<()> {
+        let flow = self.flow.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if !flow.current() || !same_binding(binding, &self.binding) || !current() {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut state = flow
+            .video_epochs
+            .0
+            .try_lock()
+            .map_err(|_| StreamControlError::Backpressure)?;
+        state.values.retain(|_, v| (v.current)());
+        let key = (binding.transport_id.clone(), epoch.publisher);
+        if state.values.get(&key).is_some_and(|v| v.epoch == epoch) {
+            return Ok(());
+        }
+        if state.values.len() >= 128 || state.revision >= crate::v2::MAX_SAFE_REVISION {
+            return Err(StreamControlError::Backpressure);
+        }
+        state.revision += 1;
+        let revision = state.revision;
+        state.values.insert(
+            key,
+            VideoEpochObservation {
+                binding: binding.clone(),
+                operation: self.operation.clone(),
+                offer: self.offer.clone(),
+                revision,
+                epoch,
+                current,
+            },
+        );
+        drop(state);
+        flow.changed.notify_waiters();
+        Ok(())
+    }
+}
+impl NativeFlow {
+    pub(crate) fn video_feedback_profile(
+        self: &Arc<Self>,
+        binding: &ReadyMediaBinding,
+        operation: &str,
+        offer: &str,
+    ) -> Arc<dyn VideoFeedbackProfile> {
+        Arc::new(Profile {
+            flow: Arc::downgrade(self),
+            binding: binding.clone(),
+            operation: operation.into(),
+            offer: offer.into(),
+        })
+    }
+    pub(crate) fn next_video_epoch(
+        &self,
+        active: &[ReadyMediaBinding],
+        sent: &BTreeMap<(StreamId, bool), u64>,
+    ) -> Option<VideoEpochObservation> {
+        if !self.current() {
+            return None;
+        }
+        let state = self.video_epochs.0.try_lock().ok()?;
+        state
+            .values
+            .values()
+            .filter(|v| {
+                (v.current)()
+                    && sent.get(&v.key()).is_none_or(|old| *old < v.revision)
+                    && active.iter().any(|b| same_binding(b, &v.binding))
+            })
+            .min_by_key(|v| v.revision)
+            .cloned()
+    }
+    pub(crate) fn video_epoch_current(&self, value: &VideoEpochObservation) -> bool {
+        self.current()
+            && (value.current)()
+            && self.video_epochs.0.try_lock().ok().is_some_and(|state| {
+                state
+                    .values
+                    .get(&value.key())
+                    .is_some_and(|v| v.revision == value.revision && (v.current)())
+            })
+    }
+}
