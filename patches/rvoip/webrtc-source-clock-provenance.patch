+#[cfg(test)]
+mod source_clock_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    #[test]
+    fn source_clock_translation_preserves_authoritative_anchor_across_wrap() {
+        let anchor = MediaClockAnchor {
+            ntp_time: 123,
+            rtp_time: u32::MAX - 20,
+            clock_rate: 90_000,
+        };
+        let clock = MediaSourceClock {
+            source_id: 3,
+            supported: true,
+            generation: 2,
+            anchor: Some(anchor),
+            rtp_offset: 0,
+            is_current: Arc::new(|| true),
+        };
+        let clock = clock.translated_rtp(u32::MAX - 5, 14).translated_rtp(14, 9);
+        assert_eq!(clock.rtp_offset, 15);
+        assert_eq!(clock.anchor, Some(anchor));
+        assert_eq!(anchor.rtp_time.wrapping_add(clock.rtp_offset), u32::MAX - 5);
+        assert!((clock.is_current)());
+        let unsupported = clock.unsupported().translated_rtp(9, 33);
+        assert!(!unsupported.supported);
+        assert!(unsupported.anchor.is_none());
+        assert_eq!(unsupported.source_id, 3);
+        assert_eq!(unsupported.generation, 2);
+        assert!((unsupported.is_current)());
+    }
+
+    #[test]
+    fn source_clock_requires_both_source_generation_and_route_liveness() {
+        let source = Arc::new(AtomicBool::new(true));
+        let route = Arc::new(AtomicBool::new(true));
+        let source_check = Arc::clone(&source);
+        let route_check = Arc::clone(&route);
+        let clock = MediaSourceClock {
+            source_id: 3,
+            supported: true,
+            generation: 2,
+            anchor: None,
+            rtp_offset: 0,
+            is_current: Arc::new(move || source_check.load(Ordering::Acquire)),
+        }
+        .with_route_liveness(Arc::new(move || route_check.load(Ordering::Acquire)));
+        assert!((clock.is_current)());
+        route.store(false, Ordering::Release);
+        assert!(!(clock.is_current)());
+        route.store(true, Ordering::Release);
+        source.store(false, Ordering::Release);
+        assert!(!(clock.is_current)());
+    }
+}
