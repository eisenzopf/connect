+    #[test]
+    fn source_clock_supplemental_event_decodes_without_replacing_primary_mapping() {
+        use crate::media::dtmf::{DtmfDecoder, TelephoneEventCodec};
+        let c = SourceClock::default();
+        let primary: Arc<dyn Send + Sync> = Arc::new(());
+        let events: Arc<dyn Send + Sync> = Arc::new(());
+        c.bind_identity(ClockTrack::Audio, 1, 8000, &primary);
+        c.cname(1, b"same");
+        assert!(c.sender_report(1, 10 << 32, 0, 1, 100 << 32));
+        let before = c.snapshot(1).unwrap();
+        let event_lease = c.lease_identity(&[2], &events);
+        assert!(event_lease.required);
+        assert!(event_lease.capture(2).is_none());
+        assert!(event_lease.permits_supplemental());
+        let mut decoder = DtmfDecoder::new(vec![TelephoneEventCodec::new(101, 8000)]);
+        assert!(decoder.accepts_payload_type(101));
+        assert!(!decoder.accepts_payload_type(0));
+        let event = decoder
+            .decode_packet(123, 101, &[1, 0x80, 0x03, 0x20])
+            .unwrap();
+        assert_eq!(event.digit, '1');
+        assert_eq!(event.duration_ms, 100);
+        let after = c.snapshot(1).unwrap();
+        assert_eq!(after.source_id, before.source_id);
+        assert_eq!(after.anchor, before.anchor);
+        assert!((before.is_current)());
+        c.retire();
+        assert!(!event_lease.permits_supplemental());
+        assert!(event_lease.required);
+    }
