+pub(crate) fn update(
+    clock: Option<rvoip_core::stream::MediaSourceClock>,
+    rate: u32,
+) -> Option<rtc::interceptor::SenderClockUpdate> {
+    clock.map(|c| rtc::interceptor::SenderClockUpdate {
+        source_id: c.source_id,
+        generation: c.generation,
+        rtp_offset: c.rtp_offset,
+        supported: c.supported && c.anchor.is_none_or(|a| a.clock_rate == rate),
+        anchor: c.anchor.map(|a| rtc::interceptor::SenderClockAnchor {
+            ntp_time: a.ntp_time,
+            rtp_time: a.rtp_time,
+            clock_rate: a.clock_rate,
+        }),
+        is_current: c.is_current,
+    })
+}
