+#[cfg(test)]
+mod source_clock_identity_tests {
+    use super::*;
+    #[test]
+    fn source_clock_real_arc_identity_preserves_repeat_and_rejects_same_ssrc_replacement_and_late_old_task()
+     {
+        let c = SourceClock::default();
+        let first: Arc<dyn Send + Sync> = Arc::new(());
+        let second: Arc<dyn Send + Sync> = Arc::new(());
+        c.bind_identity(ClockTrack::Audio, 1, 8000, &first);
+        let old_lease = c.lease_identity(&[1], &first);
+        let old = old_lease.capture(1).unwrap();
+        c.bind_identity(ClockTrack::Audio, 1, 8000, &first);
+        assert!((old.is_current)());
+        assert_eq!(c.snapshot(1).unwrap().source_id, old.source_id);
+        c.bind_identity(ClockTrack::Audio, 1, 8000, &second);
+        let current = c.lease_identity(&[1], &second);
+        let new = current.capture(1).unwrap();
+        assert!(!(old.is_current)());
