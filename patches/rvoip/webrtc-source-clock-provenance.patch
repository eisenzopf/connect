+//! One authenticated peer's bounded, shared audio/video sender clock.
+use rvoip_core::stream::{MediaClockAnchor, MediaSourceClock};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ClockTrack {
+    Audio,
+    Video,
+}
+impl ClockTrack {
+    fn index(self) -> usize {
+        match self {
+            Self::Audio => 0,
+            Self::Video => 1,
+        }
+    }
+}
+struct Track {
+    binding_id: u128,
+    identity: Option<Weak<dyn Send + Sync>>,
+    ssrc: u32,
+    rate: u32,
+    cname: Option<Vec<u8>>,
+    anchor: Option<MediaClockAnchor>,
+    active: bool,
+    revision: Arc<AtomicU64>,
+}
+struct State {
+    tracks: [Option<Track>; 2],
+    offset: Option<u64>,
+}
+struct Inner {
+    configured: bool,
+    live: AtomicBool,
+    generation: AtomicU64,
+    state: Mutex<State>,
+}
+#[derive(Clone)]
+pub(crate) struct SourceClock(Arc<Inner>);
+impl Default for SourceClock {
+    fn default() -> Self {
+        Self(Arc::new(Inner {
+            configured: true,
+            live: AtomicBool::new(true),
+            generation: AtomicU64::new(1),
+            state: Mutex::new(State {
+                tracks: [None, None],
+                offset: None,
+            }),
+        }))
+    }
+}
+impl SourceClock {
+    pub(crate) fn configured(enabled: bool) -> Self {
+        let mut value = Self::default();
+        Arc::get_mut(&mut value.0).unwrap().configured = enabled;
+        value
+    }
+    #[cfg(test)]
+    pub(crate) fn bind(&self, kind: ClockTrack, ssrc: u32, rate: u32) {
+        self.bind_inner(kind, ssrc, rate, None)
+    }
+    pub(crate) fn bind_identity(
+        &self,
+        kind: ClockTrack,
+        ssrc: u32,
+        rate: u32,
+        identity: &Arc<dyn Send + Sync>,
+    ) {
+        self.bind_inner(kind, ssrc, rate, Some(Arc::downgrade(identity)))
+    }
+    fn bind_inner(
+        &self,
+        kind: ClockTrack,
+        ssrc: u32,
+        rate: u32,
+        identity: Option<Weak<dyn Send + Sync>>,
+    ) {
+        if (!self.0.configured || !self.0.live.load(Ordering::Acquire)) || rate == 0 {
+            return;
+        }
+        let mut state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        if !self.0.configured || !self.0.live.load(Ordering::Acquire) {
+            return;
+        }
+        let slot = &mut state.tracks[kind.index()];
+        if slot.as_ref().is_some_and(|t| {
+            t.ssrc == ssrc
+                && t.rate == rate
+                && match (&t.identity, &identity) {
+                    (Some(old), Some(new)) => old
+                        .upgrade()
+                        .zip(new.upgrade())
+                        .is_some_and(|(old, new)| Arc::ptr_eq(&old, &new)),
+                    _ => false,
+                }
+        }) {
+            return;
+        }
+        if let Some(old) = slot {
+            old.revision.fetch_add(1, Ordering::AcqRel);
+        }
+        *slot = Some(Track {
+            binding_id: rand::random(),
+            identity,
+            ssrc,
+            rate,
+            cname: None,
+            anchor: None,
+            active: false,
+            revision: Arc::new(AtomicU64::new(1)),
+        });
+    }
+    #[cfg(test)]
+    pub(crate) fn lease(&self, ssrcs: &[u32]) -> InboundClockLease {
+        self.lease_inner(ssrcs, None)
+    }
+    pub(crate) fn lease_identity(
+        &self,
+        ssrcs: &[u32],
+        identity: &Arc<dyn Send + Sync>,
+    ) -> InboundClockLease {
+        self.lease_inner(ssrcs, Some(identity))
+    }
+    fn lease_inner(
+        &self,
+        ssrcs: &[u32],
+        identity: Option<&Arc<dyn Send + Sync>>,
+    ) -> InboundClockLease {
+        let state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        let bindings = state
+            .tracks
+            .iter()
+            .flatten()
+            .filter(|t| {
+                ssrcs.contains(&t.ssrc)
+                    && match (&t.identity, identity) {
+                        (Some(bound), Some(requested)) => bound
+                            .upgrade()
+                            .is_some_and(|bound| Arc::ptr_eq(&bound, requested)),
+                        (None, None) => true,
+                        _ => false,
+                    }
+            })
+            .map(|t| (t.ssrc, t.binding_id))
+            .collect();
+        InboundClockLease {
+            clock: self.clone(),
+            bindings,
+            required: self.0.configured,
+        }
+    }
+    pub(crate) fn retire(&self) {
+        self.0.live.store(false, Ordering::Release);
+        let mut state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        self.0.generation.fetch_add(1, Ordering::AcqRel);
+        state.tracks = [None, None];
+        state.offset = None;
+    }
+    fn observe_binding(&self, ssrc: u32, binding_id: u128) -> bool {
+        let mut state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(track) = state
+            .tracks
+            .iter_mut()
+            .flatten()
+            .find(|t| t.ssrc == ssrc && t.binding_id == binding_id)
+        else {
+            return false;
+        };
+        track.active = true;
+        true
+    }
+    #[cfg(test)]
+    pub(crate) fn observe_rtp(&self, ssrc: u32) {
+        let mut s = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        if let Some(t) = s.tracks.iter_mut().flatten().find(|t| t.ssrc == ssrc) {
+            t.active = true;
+        }
+    }
+    pub(crate) fn cname(&self, ssrc: u32, cname: &[u8]) {
+        if cname.is_empty() || cname.len() > 255 {
+            return;
+        }
+        let mut s = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(i) = s
+            .tracks
+            .iter()
+            .position(|t| t.as_ref().is_some_and(|t| t.ssrc == ssrc))
+        else {
+            return;
+        };
+        let changed = s.tracks[i]
+            .as_ref()
+            .unwrap()
+            .cname
+            .as_ref()
+            .is_some_and(|old| old.as_slice() != cname);
+        let first_conflict = s.tracks[i].as_ref().unwrap().cname.is_none()
+            && s.tracks.iter().enumerate().any(|(n, t)| {
+                n != i
+                    && t.as_ref()
+                        .and_then(|t| t.cname.as_ref())
+                        .is_some_and(|c| c.as_slice() != cname)
+            });
+        if changed || first_conflict {
+            self.0.generation.fetch_add(1, Ordering::AcqRel);
+            s.offset = None;
+            for t in s.tracks.iter_mut().flatten() {
+                t.anchor = None;
+            }
+        }
+        s.tracks[i].as_mut().unwrap().cname = Some(cname.to_vec());
+    }
+    pub(crate) fn sender_report(
+        &self,
+        ssrc: u32,
+        ntp: u64,
+        rtp: u32,
+        packets: u32,
+        local_ntp: u64,
+    ) -> bool {
+        if ntp == 0 {
+            return false;
+        } // RFC3550 permits absent source wallclock.
+        let mut s = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(i) = s
+            .tracks
+            .iter()
+            .position(|t| t.as_ref().is_some_and(|t| t.ssrc == ssrc))
+        else {
+            return false;
+        };
+        let t = s.tracks[i].as_ref().unwrap();
+        if t.cname.is_none() || (!t.active && packets == 0) {
+            return false;
+        }
+        if s.tracks.iter().flatten().any(|other| {
+            other
+                .cname
+                .as_ref()
+                .is_some_and(|c| Some(c) != t.cname.as_ref())
+        }) {
+            return false;
+        }
+        let offset = *s.offset.get_or_insert_with(|| local_ntp.wrapping_sub(ntp));
+        let t = s.tracks[i].as_mut().unwrap();
+        let translated = ntp.wrapping_add(offset);
+        if t.anchor
+            .as_ref()
+            .is_some_and(|a| translated.wrapping_sub(a.ntp_time) as i64 <= 0)
+        {
+            return false;
+        }
+        t.active = true;
+        t.anchor = Some(MediaClockAnchor {
+            ntp_time: translated,
+            rtp_time: rtp,
+            clock_rate: t.rate,
+        });
+        true
+    }
+    pub(crate) fn snapshot(&self, ssrc: u32) -> Option<MediaSourceClock> {
+        let s = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        let t = s.tracks.iter().flatten().find(|t| t.ssrc == ssrc)?;
+        let source: Weak<Inner> = Arc::downgrade(&self.0);
+        let generation = self.0.generation.load(Ordering::Acquire);
+        let revision = Arc::downgrade(&t.revision);
+        let expected = t.revision.load(Ordering::Acquire);
+        let identity = t.identity.clone();
+        Some(MediaSourceClock {
+            source_id: t.binding_id,
+            generation,
+            anchor: t.anchor,
+            rtp_offset: 0,
+            supported: true,
+            is_current: Arc::new(move || {
+                source.upgrade().is_some_and(|s| {
+                    s.live.load(Ordering::Acquire)
+                        && s.generation.load(Ordering::Acquire) == generation
+                }) && identity.as_ref().is_none_or(|i| i.upgrade().is_some())
+                    && revision
+                        .upgrade()
+                        .is_some_and(|r| r.load(Ordering::Acquire) == expected)
+            }),
+        })
+    }
+}
+#[cfg(test)]
+mod source_clock_tests {
+    use super::*;
+    fn clock() -> SourceClock {
+        let c = SourceClock::default();
+        c.bind(ClockTrack::Audio, 1, 8_000);
+        c.bind(ClockTrack::Video, 2, 90_000);
+        c.cname(1, b"one-clock");
+        c.cname(2, b"one-clock");
+        c
+    }
+    #[test]
+    fn source_clock_common_offset_survives_intertrack_and_later_arrival_jitter() {
+        let c = clock();
+        assert!(c.sender_report(1, 10 << 32, 0, 1, 100 << 32));
+        assert!(c.sender_report(2, 10 << 32, 90_000, 1, (100 << 32) + (1 << 31)));
+        let a = c.snapshot(1).unwrap().anchor.unwrap();
+        let v = c.snapshot(2).unwrap().anchor.unwrap();
+        assert_eq!(a.ntp_time, v.ntp_time);
+        assert_eq!(a.ntp_time, 100 << 32);
+        assert!(c.sender_report(1, 11 << 32, 8000, 2, 102 << 32));
+        assert!(c.sender_report(2, 11 << 32, 180_000, 2, 105 << 32));
+        assert_eq!(c.snapshot(1).unwrap().anchor.unwrap().ntp_time, 101 << 32);
+        assert_eq!(c.snapshot(2).unwrap().anchor.unwrap().ntp_time, 101 << 32);
+        assert!(!c.sender_report(2, 10 << 32, 90_000, 1, 106 << 32));
+    }
+    #[test]
+    fn source_clock_first_anchor_is_atomic_and_shared() {
+        let c = clock();
+        let c2 = c.clone();
+        let gate = Arc::new(std::sync::Barrier::new(2));
+        let g = gate.clone();
+        let task = std::thread::spawn(move || {
+            g.wait();
+            c2.sender_report(1, 10 << 32, 0, 1, 100 << 32)
+        });
+        gate.wait();
+        assert!(c.sender_report(2, 10 << 32, 0, 1, 101 << 32));
+        assert!(task.join().unwrap());
+        assert_eq!(
+            c.snapshot(1).unwrap().anchor.unwrap().ntp_time,
+            c.snapshot(2).unwrap().anchor.unwrap().ntp_time
+        );
+    }
+    #[test]
+    fn source_clock_generation_retirement_unknown_zero_and_fallback() {
+        let c = clock();
+        assert!(!c.sender_report(9, 1 << 32, 0, 1, 2 << 32));
+        assert!(!c.sender_report(1, 0, 0, 1, 2 << 32));
+        assert!(!c.sender_report(1, 1 << 32, 0, 0, 2 << 32));
+        c.observe_rtp(1);
+        assert!(c.sender_report(1, 1 << 32, 0, 0, 2 << 32)); // counter wrap after actual media
+        let old = c.snapshot(1).unwrap();
+        c.cname(2, b"new-clock");
+        assert!(!(old.is_current)());
+        assert!(c.snapshot(1).unwrap().anchor.is_none());
+        assert!(c.snapshot(2).unwrap().anchor.is_none());
+        assert!(!c.sender_report(1, 2 << 32, 8000, 2, 3 << 32));
+        c.cname(1, b"new-clock");
+        assert!(c.sender_report(1, 2 << 32, 8000, 2, 3 << 32));
+        let prior = c.snapshot(1).unwrap();
+        c.bind(ClockTrack::Audio, 3, 8000);
+        assert!(!(prior.is_current)());
+        assert!(c.snapshot(1).is_none());
+        let disabled = SourceClock::configured(false);
+        disabled.bind(ClockTrack::Audio, 1, 8000);
+        assert!(disabled.snapshot(1).is_none());
+    }
+}
