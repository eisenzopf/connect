+/// Authoritative source RTP/NTP pair, translated into one shared local AV
+/// clock domain by the authenticated source adapter. RTP remains source-domain.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct MediaClockAnchor {
+    pub ntp_time: u64,
+    pub rtp_time: u32,
+    pub clock_rate: u32,
+}
+
+/// In-process clock provenance; never serialized into a Connect protocol.
+/// `Some` with no anchor means an authenticated browser source is waiting for
+/// its sender report. `None` on MediaFrame selects the existing native fallback.
+#[derive(Clone)]
+pub struct MediaSourceClock {
+    pub source_id: u128,
+    pub generation: u64,
+    pub anchor: Option<MediaClockAnchor>,
+    /// False after an unsupported clock-domain transform: retain provenance
+    /// and suppress sender reports rather than inventing a local clock.
+    pub supported: bool,
+    /// Wrapping source-to-current-wire RTP translation. Keep this independent
+    /// of anchor age: a route can rebase while retaining a newer source SR.
+    pub rtp_offset: u32,
+    pub is_current: Arc<dyn Fn() -> bool + Send + Sync>,
+}
+
+impl MediaSourceClock {
+    #[must_use]
+    pub fn unsupported(mut self) -> Self {
+        self.supported = false;
+        self.anchor = None;
+        self
+    }
+
+    #[must_use]
+    pub fn translated_rtp(mut self, source: u32, wire: u32) -> Self {
+        self.rtp_offset = self.rtp_offset.wrapping_add(wire.wrapping_sub(source));
+        self
+    }
+
+    #[must_use]
+    pub fn with_route_liveness(mut self, route: Arc<dyn Fn() -> bool + Send + Sync>) -> Self {
+        let source = self.is_current;
+        self.is_current = Arc::new(move || source() && route());
+        self
+    }
+}
+
+impl fmt::Debug for MediaSourceClock {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("MediaSourceClock")
+            .field("source_id", &self.source_id)
+            .field("generation", &self.generation)
+            .field("anchor", &self.anchor)
+            .field("supported", &self.supported)
+            .field("rtp_offset", &self.rtp_offset)
+            .finish_non_exhaustive()
+    }
+}
