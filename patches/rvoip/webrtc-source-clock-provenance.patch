+    #[test]
+    fn source_clock_translation_matches_actual_audio_zero_wrap_handoff_and_dtmf_allocator() {
+        let mut state = OutboundAudioRtpState::default();
+        for source in [u32::MAX - 159, 0, 160, 40, 200] {
+            let wire = state.allocate_audio_timestamp(source, 160);
+            let clock = MediaSourceClock {
+                source_id: 1,
+                generation: 1,
+                anchor: Some(MediaClockAnchor {
+                    ntp_time: 10 << 32,
+                    rtp_time: source,
+                    clock_rate: 8000,
+                }),
+                rtp_offset: 0,
+                supported: true,
+                is_current: Arc::new(|| true),
+            };
+            let update =
+                crate::media::clock::update(Some(clock.translated_rtp(source, wire)), 8000)
+                    .unwrap();
+            assert_eq!(
+                update
+                    .anchor
+                    .unwrap()
+                    .rtp_at(10 << 32)
+                    .wrapping_add(update.rtp_offset),
+                wire
+            );
+        }
+        let before = state.last_wire_timestamp.unwrap();
+        let event = state.reserve_telephone_event_timestamp(8000, 8000, 800);
+        assert_eq!(event, before.wrapping_add(160));
+        let wire = state.allocate_audio_timestamp(360, 160);
+        assert_eq!(wire, event.wrapping_add(960));
+        let clock = MediaSourceClock {
+            source_id: 1,
+            generation: 1,
+            anchor: Some(MediaClockAnchor {
+                ntp_time: 10 << 32,
+                rtp_time: 360,
+                clock_rate: 8000,
+            }),
+            rtp_offset: 0,
+            supported: true,
+            is_current: Arc::new(|| true),
+        };
+        let update =
+            crate::media::clock::update(Some(clock.translated_rtp(360, wire)), 8000).unwrap();
+        assert_eq!(
+            update
+                .anchor
+                .unwrap()
+                .rtp_at(10 << 32)
+                .wrapping_add(update.rtp_offset),
+            wire
+        );
+    }
