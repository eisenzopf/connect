+        c.cname(1, b"wrap");
+        assert!(c.sender_report(1, u64::MAX - (1 << 32) + 1, u32::MAX - 7999, 1, 100 << 32));
+        assert!(c.sender_report(1, 1, 0, 2, 103 << 32));
+        let a = c.snapshot(1).unwrap().anchor.unwrap();
+        assert_eq!(a.rtp_time, 0);
