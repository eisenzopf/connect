+++ b/crates/foundation/rvoip-core/src/clock_route.rs
@@ -0,0 +1,31 @@
+//! Route-scoped clock liveness. Payload queues never keep a retired clock alive.
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+
+pub(crate) struct ClockRouteLease(Arc<AtomicBool>);
+impl ClockRouteLease {
+    pub(crate) fn new() -> Self {
+        Self(Arc::new(AtomicBool::new(true)))
+    }
+    /// Either the synchronous route owner or its task can retire the mapping.
+    pub(crate) fn task_guard(&self) -> Self {
+        Self(Arc::clone(&self.0))
+    }
+    pub(crate) fn predicate(&self) -> Arc<dyn Fn() -> bool + Send + Sync> {
+        let weak = Arc::downgrade(&self.0);
+        Arc::new(move || {
+            weak.upgrade()
+                .is_some_and(|live| live.load(Ordering::Acquire))
+        })
+    }
+    pub(crate) fn retire(&self) {
+        self.0.store(false, Ordering::Release);
+    }
+}
+impl Drop for ClockRouteLease {
+    fn drop(&mut self) {
+        self.retire();
+    }
+}
