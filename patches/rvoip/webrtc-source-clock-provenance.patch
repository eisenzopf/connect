+/// An inbound task can retire only its original negotiated binding; an old
+/// track's completion cannot retire a newer source reusing the same SSRC.
+pub(crate) struct InboundClockLease {
+    clock: SourceClock,
+    bindings: Vec<(u32, u128)>,
+    pub(crate) required: bool,
+}
+impl InboundClockLease {
+    pub(crate) fn permits_supplemental(&self) -> bool {
+        self.clock.0.live.load(Ordering::Acquire)
+    }
+    pub(crate) fn capture(&self, ssrc: u32) -> Option<MediaSourceClock> {
+        let snapshot = self
+            .clock
+            .snapshot(ssrc)
+            .filter(|c| self.bindings.contains(&(ssrc, c.source_id)))?;
+        if !self.clock.observe_binding(ssrc, snapshot.source_id) {
+            return None;
+        }
+        Some(snapshot)
+    }
+}
+impl Drop for InboundClockLease {
+    fn drop(&mut self) {
+        let mut s = self.clock.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        for slot in &mut s.tracks {
+            if slot
+                .as_ref()
+                .is_some_and(|t| self.bindings.contains(&(t.ssrc, t.binding_id)))
+            {
+                *slot = None;
+            }
+        }
+        if s.tracks.iter().all(Option::is_none) {
+            s.offset = None;
+            self.clock.0.generation.fetch_add(1, Ordering::AcqRel);
+        }
+    }
+}
+#[cfg(test)]
+mod source_clock_lifecycle_tests {
+    use super::*;
+    #[test]
+    fn source_clock_first_conflicting_cname_retires_prior_anchor_and_recovers_common_domain() {
+        let c = SourceClock::default();
+        c.bind(ClockTrack::Audio, 1, 8000);
+        c.bind(ClockTrack::Video, 2, 90000);
+        c.cname(1, b"A");
+        assert!(c.sender_report(1, 10 << 32, 0, 1, 100 << 32));
+        let old = c.snapshot(1).unwrap();
+        c.cname(2, b"B");
+        assert!(!(old.is_current)());
+        assert!(c.snapshot(1).unwrap().anchor.is_none());
+        assert!(!c.sender_report(1, 11 << 32, 8000, 2, 101 << 32));
+        c.cname(1, b"B");
+        assert!(c.sender_report(1, 12 << 32, 16000, 3, 103 << 32));
+        assert!(c.sender_report(2, 12 << 32, 0, 3, 104 << 32));
+        assert_eq!(
+            c.snapshot(1).unwrap().anchor.unwrap().ntp_time,
+            c.snapshot(2).unwrap().anchor.unwrap().ntp_time
+        );
+    }
+    #[test]
+    fn source_clock_track_lease_and_peer_close_retire_without_retiring_replacement() {
+        let c = SourceClock::default();
+        c.bind(ClockTrack::Audio, 1, 8000);
+        let lease = c.lease(&[1]);
+        let old = lease.capture(1).unwrap();
+        c.bind(ClockTrack::Audio, 3, 8000);
+        let current = c.snapshot(3).unwrap();
+        drop(lease);
+        assert!(!(old.is_current)());
+        assert!((current.is_current)());
+        assert!(c.snapshot(3).is_some());
+        c.retire();
+        assert!(!(current.is_current)());
+        c.bind(ClockTrack::Audio, 4, 8000);
+        assert!(c.snapshot(4).is_none());
+    }
+}
