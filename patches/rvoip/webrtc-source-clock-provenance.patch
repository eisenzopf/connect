+        drop(old_lease);
+        assert!(current.capture(1).is_some());
+        drop(second);
+        assert!(!(new.is_current)()); // bounded state owns only Weak identity
+    }
+    #[test]
+    fn source_clock_authoritative_ntp_era_wrap_preserves_valid_zero_rtp() {
+        let c = SourceClock::default();
