+//! Gap-triggered RTP ordering before variable-width sequence translation.
+//! In-order traffic never waits. A detected gap retains at most 64 bounded RTP
+//! packets for 100ms, below the 200ms media age ceiling. Expiry/capacity pressure
+//! advances to a real retained packet; missing sequence slots remain missing.
+use chrono::{DateTime, Utc};
+use rtc::rtp;
+use std::time::{Duration, Instant};
+
+pub(super) const REORDER_LIMIT: usize = 64;
+pub(super) const REORDER_DELAY: Duration = Duration::from_millis(100);
+
+pub(super) struct ReceivedPacket {
+    pub packet: rtp::Packet,
+    pub received_at: DateTime<Utc>,
+    inserted: Instant,
+}
+impl ReceivedPacket {
+    pub fn new(packet: rtp::Packet, now: Instant) -> Self {
+        Self {
+            packet,
+            received_at: Utc::now(),
+            inserted: now,
+        }
+    }
+}
+#[derive(Default)]
+pub(super) struct ReorderOutput {
+    pub packets: Vec<ReceivedPacket>,
+    pub depth: usize,
+    pub expired: usize,
+    pub source_reset_discards: usize,
+    pub duplicate_or_conflicting: usize,
+}
+#[derive(Default)]
+pub(super) struct PacketReorder {
+    ssrc: Option<u32>,
+    next: Option<u16>,
+    pending: Vec<ReceivedPacket>,
+}
+impl PacketReorder {
+    pub fn next_deadline(&self) -> Option<Instant> {
+        self.pending
+            .iter()
+            .map(|item| item.inserted + REORDER_DELAY)
+            .min()
+    }
+    pub fn push(&mut self, packet: ReceivedPacket, now: Instant) -> ReorderOutput {
+        let mut output = self.expire(now);
+        if self.ssrc != Some(packet.packet.header.ssrc) {
+            output.source_reset_discards = self.pending.len();
+            self.pending.clear();
+            self.ssrc = Some(packet.packet.header.ssrc);
+            self.next = Some(packet.packet.header.sequence_number);
+        }
+        let sequence = packet.packet.header.sequence_number;
+        let expected = self.next.unwrap_or(sequence);
+        let distance = sequence.wrapping_sub(expected) as i16;
+        if distance < 0 {
+            // The mapper accepts only an exact remembered duplicate. Unknown
+            // late packets cannot overwrite already published fragment ranges.
+            output.packets.push(packet);
+        } else if self
+            .pending
+            .iter()
+            .any(|item| item.packet.header.sequence_number == sequence)
+        {
+            output.duplicate_or_conflicting += 1;
+        } else {
+            if self.pending.len() == REORDER_LIMIT {
+                self.advance(&mut output);
+            }
+            self.pending.push(packet);
+            output.depth = self.pending.len();
+            self.drain(&mut output);
+        }
+        output
+    }
+    pub fn expire(&mut self, now: Instant) -> ReorderOutput {
+        let mut output = ReorderOutput::default();
+        while self.next_deadline().is_some_and(|deadline| now >= deadline) {
+            output.expired += 1;
+            self.advance(&mut output);
+        }
+        output.depth = self.pending.len();
+        output
+    }
+    fn advance(&mut self, output: &mut ReorderOutput) {
+        let Some(expected) = self.next else {
+            return;
+        };
+        let Some(next) = self
+            .pending
+            .iter()
+            .map(|item| item.packet.header.sequence_number)
+            .min_by_key(|sequence| sequence.wrapping_sub(expected))
+        else {
+            return;
+        };
+        self.next = Some(next);
+        self.drain(output);
+    }
+    fn drain(&mut self, output: &mut ReorderOutput) {
+        while let Some(expected) = self.next {
+            let Some(index) = self
+                .pending
+                .iter()
+                .position(|item| item.packet.header.sequence_number == expected)
+            else {
+                break;
+            };
+            output.packets.push(self.pending.remove(index));
+            self.next = Some(expected.wrapping_add(1));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn packet(sequence: u16, ssrc: u32, now: Instant) -> ReceivedPacket {
+        ReceivedPacket::new(
+            rtp::Packet {
+                header: rtp::Header {
+                    version: 2,
+                    ssrc,
+                    sequence_number: sequence,
+                    ..Default::default()
+                },
+                payload: vec![0x10, 1].into(),
+            },
+            now,
+        )
+    }
+    fn sequences(output: ReorderOutput) -> Vec<u16> {
+        output
+            .packets
+            .into_iter()
+            .map(|item| item.packet.header.sequence_number)
+            .collect()
+    }
+    #[test]
+    fn in_order_is_immediate_and_gap_closes_without_fabrication() {
+        let now = Instant::now();
+        let mut reorder = PacketReorder::default();
+        assert_eq!(sequences(reorder.push(packet(10, 7, now), now)), [10]);
+        assert!(reorder.push(packet(12, 7, now), now).packets.is_empty());
+        assert_eq!(sequences(reorder.push(packet(11, 7, now), now)), [11, 12]);
+        assert!(reorder.next_deadline().is_none());
+    }
+    #[test]
+    fn expiry_preserves_real_sequence_gap_and_wrap() {
+        let now = Instant::now();
+        let mut reorder = PacketReorder::default();
+        assert_eq!(sequences(reorder.push(packet(65534, 7, now), now)), [65534]);
+        assert!(reorder.push(packet(0, 7, now), now).packets.is_empty());
+        assert!(reorder
+            .expire(now + REORDER_DELAY - Duration::from_nanos(1))
+            .packets
+            .is_empty());
+        let expired = reorder.expire(now + REORDER_DELAY);
+        assert_eq!(expired.expired, 1);
+        assert_eq!(sequences(expired), [0]);
+    }
+    #[test]
+    fn bounded_pressure_duplicate_and_new_source_never_invent_payloads() {
+        let now = Instant::now();
+        let mut reorder = PacketReorder::default();
+        let _ = reorder.push(packet(10, 7, now), now);
+        let _ = reorder.push(packet(12, 7, now), now);
+        assert_eq!(
+            reorder
+                .push(packet(12, 7, now), now)
+                .duplicate_or_conflicting,
+            1
+        );
+        for sequence in 13..76 {
+            let output = reorder.push(packet(sequence, 7, now), now);
+            assert!(output.depth <= REORDER_LIMIT);
+        }
+        assert_eq!(reorder.pending.len(), REORDER_LIMIT);
+        let released = reorder.push(packet(76, 7, now), now);
+        assert_eq!(released.packets.len(), 65);
+        assert!(reorder.pending.is_empty());
+        let _ = reorder.push(packet(78, 7, now), now);
+        let switched = reorder.push(packet(3, 8, now), now);
+        assert_eq!(switched.source_reset_discards, 1);
+        assert_eq!(sequences(switched), [3]);
+    }
+}
