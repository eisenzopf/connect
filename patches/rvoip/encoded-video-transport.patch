+/// Queues are aggregated by static stage, never by participant, credential or stream ID.
+#[derive(Clone, Copy, Debug)]
+#[repr(usize)]
+pub enum QueueStage {
+    QuicAudioIn,
+    QuicAudioOut,
+    QuicAudioPeerOut,
