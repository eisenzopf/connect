+//! Fixed numeric observations before WebRTC video normalization/publication.
+//! Gaps count observed forward sequence skips, not proven network packet loss.
+use super::MediaDiagnostics;
+
+/// Process aggregate, independent of source identities, RTP timestamps or media.
+#[derive(Clone, Debug, Default)]
+pub struct WebRtcVideoInputObservation {
+    pub source_packets: u64,
+    pub maximum_source_payload_bytes: usize,
+    pub source_sequence_gap_events: u64,
+    pub missing_sequence_slots: u64,
+    pub source_reordered_packets: u64,
+    pub padding_packets: u64,
+    pub oversize_payload: u64,
+    pub invalid_descriptor: u64,
+    pub late_or_conflicting_mapping: u64,
+    pub marshal_failed: u64,
+    pub normalized_oversize: u64,
+    pub reorder_expirations: u64,
+    pub source_reset_discards: u64,
+}
+/// Static reject reasons never carry packet bytes or private identifiers.
+#[derive(Clone, Copy, Debug)]
+pub enum WebRtcVideoReject {
+    OversizePayload,
+    InvalidDescriptor,
+    LateOrConflictingMapping,
+    MarshalFailed,
+    NormalizedOversize,
+}
+impl MediaDiagnostics {
+    pub fn webrtc_video_source(&self, payload_bytes: usize, forward_gap: u16, reordered: bool) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.webrtc_video_input;
+        value.source_packets = value.source_packets.saturating_add(1);
+        value.maximum_source_payload_bytes = value.maximum_source_payload_bytes.max(payload_bytes);
+        if forward_gap > 0 {
+            value.source_sequence_gap_events = value.source_sequence_gap_events.saturating_add(1);
+            value.missing_sequence_slots = value
+                .missing_sequence_slots
+                .saturating_add(u64::from(forward_gap));
+        }
+        if reordered {
+            value.source_reordered_packets = value.source_reordered_packets.saturating_add(1);
+        }
+    }
+    pub fn webrtc_video_padding(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.webrtc_video_input.padding_packets =
+            state.webrtc_video_input.padding_packets.saturating_add(1);
+    }
+    pub fn webrtc_video_reject(&self, reason: WebRtcVideoReject) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.webrtc_video_input;
+        let count = match reason {
+            WebRtcVideoReject::OversizePayload => &mut value.oversize_payload,
+            WebRtcVideoReject::InvalidDescriptor => &mut value.invalid_descriptor,
+            WebRtcVideoReject::LateOrConflictingMapping => &mut value.late_or_conflicting_mapping,
+            WebRtcVideoReject::MarshalFailed => &mut value.marshal_failed,
+            WebRtcVideoReject::NormalizedOversize => &mut value.normalized_oversize,
+        };
+        *count = count.saturating_add(1);
+    }
+    pub fn webrtc_video_reorder_outcome(&self, expirations: usize, source_reset_discards: usize) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.webrtc_video_input;
+        value.reorder_expirations = value.reorder_expirations.saturating_add(expirations as u64);
+        value.source_reset_discards = value
+            .source_reset_discards
+            .saturating_add(source_reset_discards as u64);
+    }
+}
+#[cfg(test)]
+mod tests {
+    #![allow(clippy::unwrap_used)]
+    use super::*;
+    #[test]
+    fn fixed_reasons_and_source_observations_remain_numeric() {
+        let diagnostics = MediaDiagnostics::default();
+        assert!(diagnostics.snapshot().webrtc_video_input.is_none());
+        diagnostics.webrtc_video_source(1200, 2, false);
+        diagnostics.webrtc_video_source(20, 0, true);
+        diagnostics.webrtc_video_padding();
+        diagnostics.webrtc_video_reject(WebRtcVideoReject::OversizePayload);
+        diagnostics.webrtc_video_reorder_outcome(1, 2);
+        let snapshot = diagnostics.snapshot().webrtc_video_input.unwrap();
+        assert_eq!(snapshot.source_packets, 2);
+        assert_eq!(snapshot.maximum_source_payload_bytes, 1200);
+        assert_eq!(snapshot.source_sequence_gap_events, 1);
+        assert_eq!(snapshot.missing_sequence_slots, 2);
+        assert_eq!(snapshot.source_reordered_packets, 1);
+        assert_eq!(snapshot.padding_packets, 1);
+        assert_eq!(snapshot.oversize_payload, 1);
+        assert_eq!(snapshot.reorder_expirations, 1);
+        assert_eq!(snapshot.source_reset_discards, 2);
+    }
+}
