+async fn last_owned_connection_retirement_allows_fresh_invite_and_preserves_live_sibling() {
+    tokio::time::timeout(Duration::from_secs(2), async {
+        let (in_tx, in_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+        let (out_tx, mut out_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+        let (events_tx, mut events_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+        let coord = UctpCoordinator::start_with_descriptor(
+            "quic",
+            in_rx,
+            out_tx,
+            events_tx,
+            Arc::new(StablePrincipalValidator),
+            answerer_with(&["opus"]),
+        );
+        drive_auth_handshake(&in_tx, &mut out_rx).await;
+        let _ = events_rx.recv().await;
+        establish_session(&in_tx, "reusable-session").await;
+        assert!(matches!(
+            events_rx.recv().await,
+            Some(UctpSessionEvent::InboundInvite { .. })
+        ));
+        for id in ["owned-one", "owned-sibling"] {
+            in_tx
+                .send(connection_offer_env("reusable-session", id, &["opus"]))
+                .await
+                .unwrap();
+            assert!(matches!(
+                events_rx.recv().await,
+                Some(UctpSessionEvent::ConnectionOpened { .. })
+            ));
+        }
+        // A foreign SID cannot retire the addressed owned connection, its sibling,
+        // or the wire Session. A foreign connection ID likewise owns nothing.
+        for (sid, connid) in [
+            ("foreign-session", "owned-one"),
+            ("reusable-session", "foreign-connection"),
+        ] {
+            in_tx
+                .send(
+                    UctpEnvelope::new(MessageType::ConnectionEnd, serde_json::json!({}))
+                        .with_sid(sid)
+                        .with_connid(connid),
+                )
+                .await
+                .unwrap();
+            assert_eq!(out_rx.recv().await.unwrap().msg_type, MessageType::Error);
+            assert_eq!(coord.resource_snapshot().connections, 2);
+            assert_eq!(coord.resource_snapshot().sessions, 1);
+            assert!(events_rx.try_recv().is_err());
+        }
+        in_tx
+            .send(
+                UctpEnvelope::new(MessageType::ConnectionEnd, serde_json::json!({}))
+                    .with_sid("reusable-session")
+                    .with_connid("owned-one"),
+            )
+            .await
+            .unwrap();
+        assert!(matches!(
+            events_rx.recv().await,
+            Some(UctpSessionEvent::ConnectionEnded { .. })
+        ));
+        assert_eq!(coord.resource_snapshot().connections, 1);
+        assert_eq!(coord.resource_snapshot().sessions, 1);
+        // Synchronize a duplicate invite followed by an addressable sibling command.
+        establish_session(&in_tx, "reusable-session").await;
+        in_tx
+            .send(
+                UctpEnvelope::new(
+                    MessageType::DtmfSend,
+                    serde_json::json!({"digits":"5","duration_ms":80,"method":"rfc4733"}),
+                )
+                .with_sid("reusable-session")
+                .with_connid("owned-sibling"),
+            )
+            .await
+            .unwrap();
+        assert!(
+            matches!(events_rx.recv().await, Some(UctpSessionEvent::Dtmf { .. })),
+            "live sibling must keep its Session; duplicate invite must not allocate a replacement"
+        );
+        in_tx
+            .send(
+                UctpEnvelope::new(MessageType::ConnectionEnd, serde_json::json!({}))
+                    .with_sid("reusable-session")
+                    .with_connid("owned-sibling"),
+            )
+            .await
+            .unwrap();
+        assert!(matches!(
+            events_rx.recv().await,
+            Some(UctpSessionEvent::ConnectionEnded { .. })
+        ));
+        tokio::time::timeout(Duration::from_millis(100), async {
+            while coord.resource_snapshot().sessions != 0 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        assert_eq!(coord.resource_snapshot().connections, 0);
+        assert!(
+            events_rx.try_recv().is_err(),
+            "detached wire cleanup must not emit SessionEnded"
+        );
+        establish_session(&in_tx, "reusable-session").await;
+        assert!(matches!(
+            events_rx.recv().await,
+            Some(UctpSessionEvent::InboundInvite { .. })
+        ));
+        in_tx
+            .send(connection_offer_env(
+                "reusable-session",
+                "fresh-owned",
+                &["opus"],
+            ))
+            .await
+            .unwrap();
+        assert!(matches!(
+            events_rx.recv().await,
+            Some(UctpSessionEvent::ConnectionOpened { .. })
+        ));
+        assert_eq!(coord.resource_snapshot().sessions, 1);
+        assert_eq!(coord.resource_snapshot().connections, 1);
+    })
+    .await
+    .expect("coordinator retirement and reattachment must complete promptly");
