+use super::*;
+fn packet(sequence: u16, body: usize) -> Bytes {
+    let mut value = vec![0x80, 0xe0, 0, 0, 0, 0, 0, 42, 0, 0, 0, 1, 0x10];
+    value[2..4].copy_from_slice(&sequence.to_be_bytes());
+    value.extend(vec![0x33; body]);
+    value.into()
+}
+fn sequence(packet: &[u8]) -> u16 {
+    u16::from_be_bytes([packet[2], packet[3]])
+}
+#[test]
+fn actual_quic_budget_refragments_a_full_profile_packet_losslessly() {
+    let mut mapper = Vp8Packetizer::default();
+    let source = packet(100, 1167); // 1180 RTP + 8 UCTP exceeds a 1186 path.
+    let fragments = mapper.packetize(source.clone(), 1178).unwrap();
+    assert_eq!(fragments.len(), 2);
+    assert!(fragments.iter().all(|fragment| fragment.len() + 8 <= 1186));
+    assert_eq!(fragments[0][1] & 0x80, 0);
+    assert_eq!(fragments[1][1] & 0x80, 0x80);
+    assert_eq!(fragments[0][12] & 0x10, 0x10);
+    assert_eq!(fragments[1][12] & 0x10, 0);
+    let reconstructed: Vec<_> = fragments
+        .iter()
+        .flat_map(|fragment| fragment[13..].iter().copied())
+        .collect();
+    assert_eq!(reconstructed, source[13..]);
+    assert_eq!(mapper.packetize(source.clone(), 1178).unwrap(), fragments);
+    assert_eq!(mapper.packetize(source, 1180).unwrap(), fragments); // repeat exact mapping
+    assert_eq!(
+        sequence(&mapper.packetize(packet(101, 1), 1178).unwrap()[0]),
+        102
+    );
+}
+#[test]
+fn source_loss_late_input_and_budget_change_cannot_hide_a_missing_fragment() {
+    let mut mapper = Vp8Packetizer::default();
+    let first = packet(u16::MAX, 1167);
+    mapper.packetize(first.clone(), 1178).unwrap();
+    assert!(mapper.packetize(first, 1177).is_none()); // smaller budget cannot mutate duplicate
+    let next = mapper.packetize(packet(1, 1), 1178).unwrap();
+    assert_eq!(sequence(&next[0]), 2); // reserve output sequence 1 for missing original 0
+    assert!(mapper.packetize(packet(0, 1), 1178).is_none());
+    assert_eq!(mapper.packetize(packet(1, 1), 1178).unwrap(), next);
+    assert!(mapper.packetize(packet(1, 2), 1178).is_none());
+    assert!(mapper.packetize(packet(2, 1167), 14).is_none()); // at most 64 fragments
+    assert_eq!(mapper.recent.len(), 2);
+}
+#[test]
+fn malformed_descriptor_and_extremely_small_budget_reject_without_state_mutation() {
+    let mut mapper = Vp8Packetizer::default();
+    let mut invalid = packet(5, 1).to_vec();
+    invalid[12] = 0x80;
+    assert!(mapper.packetize(invalid.into(), 1180).is_none());
+    assert!(mapper.packetize(packet(5, 1), 13).is_none());
+    assert!(mapper.last.is_none());
+    assert_eq!(mapper.packetize(packet(5, 1), 14).unwrap()[0].len(), 14);
+}
