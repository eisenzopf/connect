+    pub fn name(self) -> &'static str {
+        match self {
+            Self::QuicAudioIn => "quic-audio-ingress",
+            Self::QuicAudioOut => "quic-audio-egress",
+            Self::QuicAudioPeerOut => "quic-audio-peer-egress",
+            Self::QuicVideoIn => "quic-video-ingress",
