+//! Real QUIC peer budget regression. Fixture bytes prove framing, not decoding.
+use rvoip_core::{
+    capability::CodecInfo,
+    connection::Direction,
+    ids::StreamId,
+    stream::{MediaFrame, MediaStream, StreamKind},
+};
+use rvoip_quic::{apply_encoded_video_transport_budget, media_stream::QuicDatagramMediaStream};
+use std::{sync::Arc, time::Duration};
+fn frame(sequence: u16, body: usize) -> MediaFrame {
+    let mut rtp = vec![0x80, 0xe0, 0, 0, 0, 0, 0, 42, 0, 0, 0, 1, 0x10];
+    rtp[2..4].copy_from_slice(&sequence.to_be_bytes());
+    rtp.extend(vec![0x33; body]);
+    MediaFrame {
+        stream_id: StreamId::from_string("budget-camera"),
+        kind: StreamKind::Video,
+        payload: rtp.into(),
+        timestamp_rtp: 42,
+        captured_at: chrono::Utc::now(),
+        payload_type: Some(96),
+    }
+}
+#[tokio::test]
+async fn real_quic_egress_refragments_to_current_peer_budget_and_preserves_loss_gap() {
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let (cert, key) = rvoip_uctp::substrate::self_signed_for_dev(&["localhost".into()]).unwrap();
+    let mut tls = rustls::ServerConfig::builder()
+        .with_no_client_auth()
+        .with_single_cert(vec![cert.clone()], key)
+        .unwrap();
+    tls.alpn_protocols = vec![rvoip_uctp::UCTP_RAW_QUIC_ALPN_BYTES.to_vec()];
+    let mut transport = quinn::TransportConfig::default();
+    transport.initial_mtu(1200).mtu_discovery_config(None);
+    let capacity = apply_encoded_video_transport_budget(&mut transport);
+    let server = rvoip_uctp::substrate::make_server_endpoint(
+        "127.0.0.1:0".parse().unwrap(),
+        Arc::new(tls),
+        transport,
+    )
+    .unwrap();
+    let mut tls = rvoip_uctp::substrate::dev_client_config_trusting(&cert).unwrap();
+    tls.alpn_protocols = vec![rvoip_uctp::UCTP_RAW_QUIC_ALPN_BYTES.to_vec()];
+    let crypto = quinn::crypto::rustls::QuicClientConfig::try_from(tls).unwrap();
+    let mut config = quinn::ClientConfig::new(Arc::new(crypto));
+    let mut transport = quinn::TransportConfig::default();
+    transport.initial_mtu(1200).mtu_discovery_config(None);
+    apply_encoded_video_transport_budget(&mut transport);
+    config.transport_config(Arc::new(transport));
+    let client = quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+    let connecting = client
+        .connect_with(config, server.local_addr().unwrap(), "localhost")
+        .unwrap();
+    let (receiver, sender) =
+        tokio::join!(connecting, async { server.accept().await.unwrap().await });
+    let receiver = receiver.unwrap();
+    let sender = sender.unwrap();
+    let maximum = sender.max_datagram_size().unwrap();
+    assert!(maximum < 1188 && maximum > 1100);
+    assert_eq!(sender.datagram_send_buffer_space(), capacity);
+    let diagnostics = Arc::new(rvoip_core::media_diagnostics::MediaDiagnostics::default());
+    diagnostics.configure_quic_send_buffer(capacity);
+    let stream = QuicDatagramMediaStream::start_with_cancel(
+        StreamId::from_string("budget-camera"),
+        StreamKind::Video,
+        CodecInfo {
+            name: "vp8".into(),
+            clock_rate_hz: 90000,
+            channels: 0,
+            fmtp: None,
+            payload_type: Some(96),
+        },
+        Direction::Outbound,
+        8,
+        sender.clone(),
