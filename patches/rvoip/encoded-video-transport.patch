+use super::*;
+use bytes::Bytes;
+fn frame(sequence: u16) -> MediaFrame {
+    MediaFrame {
+        stream_id: StreamId::from_string("private-stream"),
+        kind: StreamKind::Video,
+        payload: Bytes::from(vec![0x80, 96, (sequence >> 8) as u8, sequence as u8]),
+        timestamp_rtp: 42,
+        captured_at: chrono::Utc::now(),
+        payload_type: Some(96),
+    }
+}
+#[test]
+fn missing_and_expired_receipts_do_not_become_zero_forwarding_samples() {
+    let collector = MediaDiagnostics::default();
+    let frame = frame(1);
+    collector.handoff(ForwardStage::VideoBridge, &frame);
+    collector.ingress(&frame);
+    {
+        let mut state = collector.state.lock().unwrap();
+        state.ingress[0].1 = Instant::now() - Duration::from_secs(2);
+    }
+    collector.handoff(ForwardStage::VideoBridge, &frame);
+    let observation = &collector.snapshot().forwarding[0].1;
+    assert_eq!(observation.samples, 0);
+    assert_eq!(observation.missing_ingress_observations, 2);
+}
+#[test]
+fn receipt_registry_and_histograms_are_bounded_and_metadata_only() {
+    let collector = MediaDiagnostics::default();
+    for sequence in 0..600 {
+        collector.ingress(&frame(sequence));
+    }
+    assert_eq!(collector.state.lock().unwrap().ingress.len(), 512);
+    assert_eq!(collector.state.lock().unwrap().forward[0].bins.len(), 65);
+    let recent = frame(601);
+    collector.ingress(&recent);
+    collector.handoff(ForwardStage::VideoFanout, &recent);
+    assert_eq!(collector.snapshot().forwarding[0].1.samples, 1);
+    assert!(!format!("{collector:?}").contains("private-stream"));
+    assert!(std::mem::size_of::<FrameKey>() < 128);
+}
+#[test]
+fn percentile_reports_bucket_upper_bound_and_precise_max() {
+    let mut histogram = ForwardHistogram::default();
+    for us in [0, 1, 2, 8, 100] {
+        histogram.add(Duration::from_micros(us));
+    }
+    let value = histogram.snapshot();
+    assert_eq!(value.p50_us, 3);
+    assert_eq!(value.p95_us, 127);
+    assert_eq!(value.max_us, 100);
+}
+#[test]
+fn queue_samples_and_each_quinn_failure_are_distinct() {
+    let collector = MediaDiagnostics::default();
+    collector.observe_queue(QueueStage::QuicVideoOut, 64, 17);
+    collector.observe_queue(QueueStage::QuicVideoOut, 64, 2);
+    collector.enqueue_full(QueueStage::QuicVideoOut);
+    collector.stale_discard(QueueStage::QuicVideoOut);
+    collector.quic_path(Some(1186), 1200, 1188);
+    collector.quic_path(Some(1400), 1420, 1190);
+    for outcome in [
+        QuicSendResult::TooLarge,
+        QuicSendResult::Accepted,
+        QuicSendResult::ConnectionLost,
+        QuicSendResult::Disabled,
+        QuicSendResult::UnsupportedByPeer,
+    ] {
+        collector.quic_send(outcome);
+    }
+    let snapshot = collector.snapshot();
+    let queue = &snapshot.queues[0].1;
+    assert_eq!(queue.sampled_high_water_packets, 17);
+    assert_eq!(queue.capacity_packets, 64);
+    assert_eq!(queue.observations, 2);
+    assert_eq!(queue.enqueue_full_observations, 1);
+    assert_eq!(queue.stale_forwarding_discards, 1);
+    let quic = snapshot.quic.unwrap();
+    assert_eq!(quic.min_max_datagram_size_bytes, Some(1186));
+    assert_eq!(quic.max_max_datagram_size_bytes, Some(1400));
+    assert_eq!(quic.maximum_attempted_datagram_bytes, 1190);
+    assert_eq!(
+        (
+            quic.accepted_datagrams,
+            quic.too_large,
+            quic.disabled,
+            quic.connection_lost,
+            quic.unsupported_by_peer
+        ),
+        (1, 1, 1, 1, 1)
+    );
+}
+#[test]
+fn shared_byte_buffer_reports_samples_and_capacity_mismatch_without_fake_packet_counts() {
+    let collector = MediaDiagnostics::default();
+    collector.configure_quic_send_buffer(76032);
+    collector.observe_quic_send_buffer(76032, 1188);
+    collector.observe_quic_send_buffer(75000, 1200);
+    collector.observe_quic_send_buffer(100, 1188);
+    collector.observe_quic_send_buffer(76033, 0);
+    let state = collector.state.lock().unwrap();
+    let buffer = state.quic.send_buffer.as_ref().unwrap();
+    assert_eq!(buffer.capacity_bytes, 76032);
+    assert_eq!(buffer.sampled_high_water_bytes, 75932);
+    assert_eq!(buffer.minimum_available_bytes, 100);
+    assert_eq!(buffer.maximum_available_bytes, 76033);
+    assert_eq!(buffer.send_exceeded_sampled_available_bytes, 1);
+    assert_eq!(buffer.capacity_mismatch_observations, 1);
+    assert_eq!(buffer.observations, 4);
+}
