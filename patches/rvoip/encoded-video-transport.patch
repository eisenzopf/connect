+//! Per-destination VP8 RTP budget adaptation after hop-local normalization.
+//! The sequence map preserves missing-source gaps rather than presenting a
+//! partial frame as complete. No decoder, camera or network state lives here.
+use bytes::Bytes;
+use std::{
+    collections::VecDeque,
+    time::{Duration, Instant},
+};
+#[derive(Default)]
+pub struct Vp8Packetizer {
+    last: Option<u16>,
+    next: u16,
+    ssrc: Option<u32>,
+    recent: VecDeque<Mapping>,
+}
+struct Mapping {
+    input: Bytes,
+    source: u16,
+    base: u16,
+    capacity: usize,
+    inserted: Instant,
+}
+impl Vp8Packetizer {
+    /// Input must be a normalized complete RTP packet (12-byte header).
+    /// Packet history is limited to 64 inputs and 200ms. Late unknown inputs or
+    /// conflicting duplicates are discarded. Repeated known inputs reuse the
+    /// exact prior fragments, provided those still fit the current budget.
+    pub fn packetize(&mut self, input: Bytes, maximum_rtp: usize) -> Option<Vec<Bytes>> {
+        if input.len() > crate::video_bridge::MAX_VIDEO_RTP_BYTES
+            || input.len() <= 13
+            || input[0] != 0x80
+        {
+            return None;
+        }
+        let descriptor = descriptor_len(&input[12..])?;
+        let capacity = maximum_rtp.checked_sub(12 + descriptor)?;
+        if capacity == 0 {
+            return None;
+        }
+        let source = u16::from_be_bytes([input[2], input[3]]);
+        let ssrc = u32::from_be_bytes(input[8..12].try_into().ok()?);
+        if self.ssrc != Some(ssrc) {
+            self.last = None;
+            self.recent.clear();
+            self.ssrc = Some(ssrc);
+        }
+        while self
+            .recent
+            .front()
+            .is_some_and(|entry| entry.inserted.elapsed() > Duration::from_millis(200))
+        {
+            self.recent.pop_front();
+        }
+        let body = &input[12 + descriptor..];
+        let (base, capacity) =
+            if let Some(existing) = self.recent.iter().find(|entry| entry.source == source) {
+                if existing.input != input
+                    || (12 + descriptor + body.len().min(existing.capacity)) > maximum_rtp
+                {
+                    return None;
+                }
+                (existing.base, existing.capacity)
+            } else {
+                let count = body.len().div_ceil(capacity);
+                // Reject pathological tiny peer budgets without allocating unbounded
+                // fragment vectors or consuming the sequence map.
+                if count == 0 || count > 64 {
+                    return None;
+                }
+                let base = if let Some(last) = self.last {
+                    let delta = source.wrapping_sub(last) as i16;
+                    if delta <= 0 {
+                        return None;
+                    }
+                    self.next.wrapping_add(delta as u16 - 1)
+                } else {
+                    source
+                };
+                self.last = Some(source);
+                self.next = base.wrapping_add(count as u16);
+                if self.recent.len() == 64 {
+                    self.recent.pop_front();
+                }
+                self.recent.push_back(Mapping {
+                    input: input.clone(),
+                    source,
+                    base,
+                    capacity,
+                    inserted: Instant::now(),
+                });
+                (base, capacity)
+            };
+        let count = body.len().div_ceil(capacity);
+        let mut packets = Vec::with_capacity(count);
+        for (index, chunk) in body.chunks(capacity).enumerate() {
+            let mut packet = input[..12 + descriptor].to_vec();
+            packet[2..4].copy_from_slice(&base.wrapping_add(index as u16).to_be_bytes());
+            if index + 1 != count {
+                packet[1] &= 0x7f;
+            }
+            if index != 0 {
+                packet[12] &= !0x10;
+            }
+            packet.extend_from_slice(chunk);
+            packets.push(packet.into());
+        }
+        Some(packets)
+    }
+}
+fn descriptor_len(payload: &[u8]) -> Option<usize> {
+    let first = *payload.first()?;
+    if first & 0x40 != 0 || first & 0x0f > 8 {
+        return None;
+    }
+    let mut pos = 1;
+    if first & 0x80 != 0 {
+        let ext = *payload.get(pos)?;
+        pos += 1;
+        if ext & 0x0f != 0 {
+            return None;
+        }
+        if ext & 0x80 != 0 {
+            let picture = *payload.get(pos)?;
+            pos += 1;
+            if picture & 0x80 != 0 {
+                payload.get(pos)?;
+                pos += 1;
+            }
+        }
+        if ext & 0x40 != 0 {
+            payload.get(pos)?;
+            pos += 1;
+        }
+        if ext & 0x30 != 0 {
+            payload.get(pos)?;
+            pos += 1;
+        }
+    }
+    (pos < payload.len()).then_some(pos)
+}
