+//! Bounded VP8 normalization with loss-preserving variable-width mappings.
+use rtc::rtp;
+#[cfg(test)]
+use rtc::shared::marshal::Marshal;
+use rvoip_core::media_diagnostics::WebRtcVideoReject;
+use std::time::Duration;
+
+/// Bounded sequence translation for VP8 repacketization. Missing source packets
+/// reserve at least one output gap; unresolved late packets are dropped, while
+/// duplicates repeat their exact mapping. History expires after 200ms / 64 inputs.
+#[derive(Default)]
+pub(super) struct SequenceMapper {
+    last: Option<u16>,
+    next: u16,
+    ssrc: Option<u32>,
+    recent: std::collections::VecDeque<SequenceMapping>,
+}
+struct SequenceMapping {
+    source: u16,
+    timestamp: u32,
+    payload: bytes::Bytes,
+    marker: bool,
+    payload_type: u8,
+    output: u16,
+    inserted: std::time::Instant,
+}
+impl SequenceMapper {
+    fn allocate(&mut self, packet: &rtp::Packet, count: u16) -> Option<u16> {
+        if self.ssrc != Some(packet.header.ssrc) {
+            self.last = None;
+            self.recent.clear();
+            self.ssrc = Some(packet.header.ssrc);
+        }
+        while self
+            .recent
+            .front()
+            .is_some_and(|entry| entry.inserted.elapsed() > Duration::from_millis(200))
+        {
+            self.recent.pop_front();
+        }
+        if let Some(entry) = self
+            .recent
+            .iter()
+            .find(|entry| entry.source == packet.header.sequence_number)
+        {
+            return (entry.timestamp == packet.header.timestamp
+                && entry.payload == packet.payload
+                && entry.marker == packet.header.marker
+                && entry.payload_type == packet.header.payload_type)
+                .then_some(entry.output);
+        }
+        let base = if let Some(last) = self.last {
+            let delta = packet.header.sequence_number.wrapping_sub(last) as i16;
+            if delta <= 0 {
+                return None;
+            }
+            self.next.wrapping_add(delta as u16 - 1)
+        } else {
+            packet.header.sequence_number
+        };
+        self.last = Some(packet.header.sequence_number);
+        self.next = base.wrapping_add(count);
+        if self.recent.len() == 64 {
+            self.recent.pop_front();
+        }
+        self.recent.push_back(SequenceMapping {
+            source: packet.header.sequence_number,
+            timestamp: packet.header.timestamp,
+            payload: packet.payload.clone(),
+            marker: packet.header.marker,
+            payload_type: packet.header.payload_type,
+            output: base,
+            inserted: std::time::Instant::now(),
+        });
+        Some(base)
+    }
+}
+
+/// Split only oversized VP8 payloads and preserve every descriptor byte.
+/// Marker stays on the final fragment; continuation fragments clear partition S.
+pub(super) fn normalize(
+    packet: rtp::Packet,
+    sequence: &mut SequenceMapper,
+) -> Result<Vec<rtp::Packet>, WebRtcVideoReject> {
+    // Parsed padding-only RTP occupies a source sequence slot, but has no VP8
+    // fragment. Consume zero output sequence slots so probe padding cannot
+    // create a false media gap inside an otherwise complete frame.
+    if packet.payload.is_empty() && packet.header.padding {
+        sequence
+            .allocate(&packet, 0)
+            .ok_or(WebRtcVideoReject::LateOrConflictingMapping)?;
+        return Ok(Vec::new());
+    }
+    let mut packet = packet;
+    packet.header.extension = false;
+    packet.header.extensions.clear();
+    packet.header.csrc.clear();
+    packet.header.padding = false;
+    let descriptor =
+        vp8_descriptor_len(&packet.payload).ok_or(WebRtcVideoReject::InvalidDescriptor)?;
+    let body = packet
+        .payload
+        .get(descriptor..)
+        .ok_or(WebRtcVideoReject::InvalidDescriptor)?;
+    if body.is_empty() {
+        return Err(WebRtcVideoReject::InvalidDescriptor);
+    }
+    if body.len() > 1500 {
+        return Err(WebRtcVideoReject::OversizePayload);
+    }
+    let capacity = rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES - 12 - descriptor;
+    let count = body.len().div_ceil(capacity);
+    let base = sequence
+        .allocate(&packet, count as u16)
+        .ok_or(WebRtcVideoReject::LateOrConflictingMapping)?;
+    let mut packets = Vec::with_capacity(count);
+    for (index, chunk) in body.chunks(capacity).enumerate() {
+        let mut fragment = packet.clone();
+        let mut payload = packet.payload[..descriptor].to_vec();
+        if index != 0 {
+            payload[0] &= !0x10;
+        }
+        payload.extend_from_slice(chunk);
+        fragment.header.sequence_number = base.wrapping_add(index as u16);
+        fragment.header.marker = packet.header.marker && index + 1 == count;
+        fragment.payload = payload.into();
+        packets.push(fragment);
+    }
+    Ok(packets)
+}
+
+fn vp8_descriptor_len(payload: &[u8]) -> Option<usize> {
+    let first = *payload.first()?;
+    if first & 0x40 != 0 || first & 0x0f > 8 {
+        return None;
+    }
+    let mut pos = 1;
+    if first & 0x80 != 0 {
+        let ext = *payload.get(pos)?;
+        pos += 1;
+        if ext & 0x0f != 0 {
+            return None;
+        }
+        if ext & 0x80 != 0 {
+            let picture = *payload.get(pos)?;
+            pos += 1;
+            if picture & 0x80 != 0 {
+                payload.get(pos)?;
+                pos += 1;
+            }
+        }
+        if ext & 0x40 != 0 {
+            payload.get(pos)?;
+            pos += 1;
+        }
+        if ext & 0x30 != 0 {
+            payload.get(pos)?;
+            pos += 1;
+        }
+    }
+    (pos < payload.len()).then_some(pos)
+}
+
+#[cfg(test)]
+fn repacketize(packet: rtp::Packet, sequence: &mut SequenceMapper) -> Option<Vec<rtp::Packet>> {
+    normalize(packet, sequence).ok()
+}
+#[cfg(test)]
+mod fragment_tests {
+    use super::*;
+    #[test]
+    fn splits_extended_vp8_without_losing_bytes_markers_or_sequence_gaps() {
+        let mut payload = vec![0x90, 0xf0, 0x81, 2, 3, 4];
+        let body: Vec<u8> = (0..1400).map(|n| (n % 251) as u8).collect();
+        payload.extend_from_slice(&body);
+        let input = rtp::Packet {
+            header: rtp::Header {
+                version: 2,
+                sequence_number: u16::MAX,
+                timestamp: 90000,
+                payload_type: 96,
+                marker: true,
+                ssrc: 7,
+                ..Default::default()
+            },
+            payload: payload.into(),
+        };
+        let fragments = repacketize(input.clone(), &mut SequenceMapper::default()).unwrap();
+        assert_eq!(fragments[0].header.sequence_number, 65535);
+        assert_eq!(fragments[1].header.sequence_number, 0);
+        assert!(!fragments[0].header.marker);
+        assert!(fragments[1].header.marker);
+        assert_eq!(fragments[0].header.timestamp, 90000);
+        assert_eq!(fragments[1].payload[0] & 0x10, 0);
+        let joined: Vec<u8> = fragments
+            .iter()
+            .flat_map(|packet| packet.payload[6..].iter().copied())
+            .collect();
+        assert_eq!(joined, body);
+        for packet in fragments {
+            assert!(
+                packet.marshal().unwrap().len() <= rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES
+            );
+        }
+        let mut mapping = SequenceMapper::default();
+        let mut tiny = input.clone();
+        tiny.payload = vec![0x10, 7].into();
+        tiny.header.sequence_number = 10;
+        let first = repacketize(tiny.clone(), &mut mapping).unwrap();
+        assert_eq!(first.len(), 1);
+        assert_eq!(first[0].payload.as_ref(), &[0x10, 7]);
+        assert_eq!(
+            repacketize(tiny.clone(), &mut mapping).unwrap()[0]
+                .header
+                .sequence_number,
+            10
+        );
+        tiny.header.sequence_number = 12;
+        assert_eq!(
+            repacketize(tiny.clone(), &mut mapping).unwrap()[0]
+                .header
+                .sequence_number,
+            12
+        );
+        tiny.header.sequence_number = 11;
+        assert!(repacketize(tiny, &mut mapping).is_none());
+        let mut mapping = SequenceMapper::default();
+        let mut expanded = input.clone();
+        expanded.header.sequence_number = 10;
+        let mapped = repacketize(expanded.clone(), &mut mapping).unwrap();
+        assert_eq!(mapped.len(), 2);
+        assert_eq!(mapped[1].header.sequence_number, 11);
+        let repeated = repacketize(expanded.clone(), &mut mapping).unwrap();
+        assert_eq!(repeated[1].header.sequence_number, 11);
+        expanded.header.marker = false;
+        assert!(repacketize(expanded.clone(), &mut mapping).is_none());
+        expanded.header.sequence_number = 12;
+        expanded.payload = vec![0x10, 7].into();
+        assert_eq!(
+            repacketize(expanded.clone(), &mut mapping).unwrap()[0]
+                .header
+                .sequence_number,
+            13
+        );
+        expanded.header.sequence_number = 11;
+        assert!(repacketize(expanded, &mut mapping).is_none());
+        assert_eq!(vp8_descriptor_len(&[0x90, 0x80, 0x81]), None);
+        assert_eq!(vp8_descriptor_len(&[0x40, 1, 2]), None);
+    }
+}
