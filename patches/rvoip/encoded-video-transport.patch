+/// Bounded optional selector and negotiated profile for a new authenticated offer.
+/// IDs remain untrusted routing hints. This type deliberately has no Debug output.
+pub struct WebRtcInboundSessionRequest<'a> {
+    pub conversation_id: Option<&'a str>,
+    pub session_id: Option<&'a str>,
+    pub audio_video: bool,
+}
+/// Host policy runs before PeerConnection/UDP media allocation for every new
+/// offer, including a configured audio/AV default. Default None preserves
+/// upstream behavior; explicit selectors require a policy and fail closed.
+pub trait WebRtcInboundSessionAuthorizer: Send + Sync {
+    fn authorize(
+        &self,
+        principal: &rvoip_core::identity::AuthenticatedPrincipal,
+        request: &WebRtcInboundSessionRequest<'_>,
+    ) -> crate::errors::Result<()>;
+}
+impl<F> WebRtcInboundSessionAuthorizer for F
+where
+    F: Send
+        + Sync
+        + Fn(
+            &rvoip_core::identity::AuthenticatedPrincipal,
+            &WebRtcInboundSessionRequest<'_>,
+        ) -> crate::errors::Result<()>,
+{
+    fn authorize(
+        &self,
+        principal: &rvoip_core::identity::AuthenticatedPrincipal,
+        request: &WebRtcInboundSessionRequest<'_>,
+    ) -> crate::errors::Result<()> {
+        self(principal, request)
+    }
+}
