+//! Bounded encoded VP8 transport. Video MediaFrames carry complete RTP packets;
+//! audio keeps its existing codec-payload convention. Preserving the marker and
+//! sequence gaps is essential for independently decoded multi-packet video frames.
+//! Oversized browser packets are split with bounded sequence translation.
+use super::pump::MediaTaskGuard;
+use chrono::Utc;
+use rtc::{
+    rtp,
+    shared::marshal::{Marshal, Unmarshal},
+};
+use rvoip_core::{
+    ids::StreamId,
+    stream::{MediaFrame, StreamKind},
+};
+use std::{
+    sync::{atomic::AtomicUsize, Arc},
+    time::Duration,
+};
+use tokio::{
+    sync::{mpsc, Notify},
+    task::JoinHandle,
+};
+use webrtc::media_stream::{
+    track_local::{static_rtp::TrackLocalStaticRTP, TrackLocal},
+    track_remote::{TrackRemote, TrackRemoteEvent},
+};
+
+/// Select the VP8 mapping only within an active video SDP section.
+pub(crate) fn vp8_payload_type(sdp: &str) -> Option<u8> {
+    let mut video = false;
+    let mut offered = Vec::new();
+    for line in sdp.lines().map(str::trim) {
+        if let Some(media) = line.strip_prefix("m=") {
+            let mut fields = media.split_whitespace();
+            video = fields.next() == Some("video") && fields.next() != Some("0");
+            fields.next();
+            offered = fields.filter_map(|p| p.parse::<u8>().ok()).collect();
+        }
+        if video {
+            if let Some(mapping) = line.strip_prefix("a=rtpmap:") {
+                let (pt, codec) = mapping.split_once(' ')?;
+                let pt = pt.parse::<u8>().ok()?;
+                if pt <= 127 && codec.eq_ignore_ascii_case("VP8/90000") && offered.contains(&pt) {
+                    return Some(pt);
+                }
+            }
+        }
+    }
+    None
+}
+
+/// One duplex audio section and one duplex VP8 camera section, with no simulcast.
+pub(crate) fn valid_audio_video_offer(sdp: &str) -> bool {
+    let mut sections: Vec<(&str, bool, Option<&str>)> = Vec::new();
+    let mut session_direction = None;
+    for line in sdp.lines().map(str::trim) {
+        if let Some(media) = line.strip_prefix("m=") {
+            let mut fields = media.split_whitespace();
+            let kind = fields.next().unwrap_or("");
+            let active = fields.next().is_some_and(|port| port != "0");
+            sections.push((kind, active, None));
+        } else if let Some(direction) = line
+            .strip_prefix("a=")
+            .filter(|value| matches!(*value, "sendrecv" | "sendonly" | "recvonly" | "inactive"))
+        {
+            if let Some(section) = sections.last_mut() {
+                section.2 = Some(direction);
+            } else {
+                session_direction = Some(direction);
+            }
+        }
+        if line.starts_with("a=rid:") || line.starts_with("a=simulcast:") {
+            return false;
+        }
+    }
+    let active: Vec<_> = sections
+        .iter()
+        .filter(|section| section.1 && matches!(section.0, "audio" | "video"))
+        .collect();
+    active.iter().filter(|section| section.0 == "audio").count() == 1
+        && active.iter().filter(|section| section.0 == "video").count() == 1
+        && active
+            .iter()
+            .all(|section| section.2.or(session_direction).unwrap_or("sendrecv") == "sendrecv")
+        && vp8_payload_type(sdp).is_some()
+}
+
+pub(crate) fn inbound(
+    track: Arc<dyn TrackRemote>,
+    id: StreamId,
+    tx: mpsc::Sender<MediaFrame>,
+    cancel: Arc<Notify>,
+    counter: Option<Arc<AtomicUsize>>,
+    diagnostics: super::stream::MediaDiagnosticsSlot,
+) -> JoinHandle<()> {
+    let guard = MediaTaskGuard::new(counter);
+    tokio::spawn(async move {
+        let _guard = guard;
+        let mut sequence = super::video_normalize::SequenceMapper::default();
+        let mut reorder = super::video_reorder::PacketReorder::default();
+        let mut observed_source: Option<(u32, u16)> = None;
+        loop {
+            let collector = super::stream::media_diagnostics(&diagnostics);
+            publish_reordered(
+                reorder.expire(std::time::Instant::now()),
+                &mut sequence,
+                &id,
+                &tx,
+                collector.as_ref(),
+            );
+            if let Some(collector) = collector.as_ref() {
+                if let Some((depth, capacity)) = track.queue_observation().await {
+                    collector.observe_queue(
+                        rvoip_core::media_diagnostics::QueueStage::WebRtcVideoRaw,
+                        capacity,
+                        depth,
+                    );
+                }
+            }
+            let wait = reorder
+                .next_deadline()
+                .map(|deadline| deadline.saturating_duration_since(std::time::Instant::now()))
+                .unwrap_or(Duration::from_millis(100))
+                .min(Duration::from_millis(100));
+            let event = tokio::select! {
+                _ = cancel.notified() => break,
+                event = tokio::time::timeout(wait, track.poll()) => match event { Ok(Some(event)) => event, _ => continue },
+            };
+            match event {
+                TrackRemoteEvent::OnRtpPacket(packet) => {
+                    let (gap, out_of_order) = observed_source
+                        .filter(|(ssrc, _)| *ssrc == packet.header.ssrc)
+                        .map(|(_, last)| {
+                            let delta = packet.header.sequence_number.wrapping_sub(last) as i16;
+                            (if delta > 1 { delta as u16 - 1 } else { 0 }, delta <= 0)
+                        })
+                        .unwrap_or((0, false));
+                    if !out_of_order {
+                        observed_source = Some((packet.header.ssrc, packet.header.sequence_number));
+                    }
+                    if let Some(collector) = collector.as_ref() {
+                        collector.webrtc_video_source(packet.payload.len(), gap, out_of_order);
+                    }
+                    if packet.payload.len() > 1500 {
+                        if let Some(collector) = collector.as_ref() {
+                            collector.webrtc_video_reject(
+                                rvoip_core::media_diagnostics::WebRtcVideoReject::OversizePayload,
+                            );
+                        }
+                        continue;
+                    }
+                    let now = std::time::Instant::now();
+                    let output =
+                        reorder.push(super::video_reorder::ReceivedPacket::new(packet, now), now);
+                    publish_reordered(output, &mut sequence, &id, &tx, collector.as_ref());
+                }
+                TrackRemoteEvent::OnEnded | TrackRemoteEvent::OnError => break,
+                _ => {}
+            }
+        }
+    })
+}
+
+fn publish_reordered(
+    output: super::video_reorder::ReorderOutput,
+    sequence: &mut super::video_normalize::SequenceMapper,
+    id: &StreamId,
+    tx: &mpsc::Sender<MediaFrame>,
+    collector: Option<&Arc<rvoip_core::media_diagnostics::MediaDiagnostics>>,
+) {
+    use rvoip_core::media_diagnostics::{QueueStage, WebRtcVideoReject};
+    if let Some(collector) = collector {
+        collector.observe_queue(
+            QueueStage::WebRtcVideoReorder,
+            super::video_reorder::REORDER_LIMIT,
+            output.depth,
+        );
+        collector.webrtc_video_reorder_outcome(output.expired, output.source_reset_discards);
+        for _ in 0..output.duplicate_or_conflicting {
+            collector.webrtc_video_reject(WebRtcVideoReject::LateOrConflictingMapping);
+        }
+    }
+    for received in output.packets {
+        let age = (Utc::now() - received.received_at).num_milliseconds();
+        if age > 200 {
+            if let Some(collector) = collector {
+                collector.stale_discard(QueueStage::WebRtcVideoReorder);
+            }
+            continue;
+        }
+        let padding = received.packet.payload.is_empty() && received.packet.header.padding;
+        let packets = match super::video_normalize::normalize(received.packet, sequence) {
+            Ok(packets) => packets,
+            Err(reason) => {
+                if let Some(collector) = collector {
+                    collector.webrtc_video_reject(reason);
+                }
+                continue;
+            }
+        };
+        if let Some(collector) = collector {
+            collector.forwarded_age(QueueStage::WebRtcVideoReorder, age);
+            if padding {
+                collector.webrtc_video_padding();
+            }
+        }
+        for packet in packets {
+            let wire = match packet.marshal() {
+                Ok(wire) => wire,
+                Err(_) => {
+                    if let Some(collector) = collector {
+                        collector.webrtc_video_reject(WebRtcVideoReject::MarshalFailed);
+                    }
+                    continue;
+                }
+            };
+            if wire.len() > rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES {
+                if let Some(collector) = collector {
+                    collector.webrtc_video_reject(WebRtcVideoReject::NormalizedOversize);
+                }
+                continue;
+            }
+            let frame = MediaFrame {
+                stream_id: id.clone(),
+                kind: StreamKind::Video,
+                payload: wire.into(),
+                timestamp_rtp: packet.header.timestamp,
+                captured_at: received.received_at,
+                payload_type: Some(packet.header.payload_type),
+            };
+            if let Some(collector) = collector {
+                collector.ingress(&frame);
+                collector.observe_queue(
+                    QueueStage::WebRtcVideoIn,
+                    tx.max_capacity(),
+                    tx.max_capacity() - tx.capacity(),
+                );
+            }
+            if matches!(tx.try_send(frame), Err(mpsc::error::TrySendError::Full(_))) {
+                if let Some(collector) = collector {
+                    collector.enqueue_full(QueueStage::WebRtcVideoIn);
+                }
+            }
+            if let Some(collector) = collector {
+                collector.observe_queue(
+                    QueueStage::WebRtcVideoIn,
+                    tx.max_capacity(),
+                    tx.max_capacity() - tx.capacity(),
+                );
+            }
+        }
+    }
+}
+
+pub(crate) fn outbound(
+    track: Arc<TrackLocalStaticRTP>,
+    mut rx: mpsc::Receiver<MediaFrame>,
+    ssrc: u32,
+    pt: u8,
+    counter: Option<Arc<AtomicUsize>>,
+    diagnostics: super::stream::MediaDiagnosticsSlot,
+) -> JoinHandle<()> {
+    let guard = MediaTaskGuard::new(counter);
+    tokio::spawn(async move {
+        let _guard = guard;
+        while let Some(frame) = rx.recv().await {
+            let collector = super::stream::media_diagnostics(&diagnostics);
+            if let Some(collector) = collector.as_ref() {
+                collector.observe_queue(
+                    rvoip_core::media_diagnostics::QueueStage::WebRtcVideoOut,
+                    rx.max_capacity(),
+                    rx.len(),
+                );
+            }
+            let age_ms = (Utc::now() - frame.captured_at).num_milliseconds();
+            if frame.kind != StreamKind::Video
+                || frame.payload.len() > rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES
+                || age_ms > 200
+            {
+                if age_ms > 200 {
+                    if let Some(collector) = collector.as_ref() {
+                        collector.stale_discard(
+                            rvoip_core::media_diagnostics::QueueStage::WebRtcVideoOut,
+                        );
+                    }
+                }
+                continue;
+            }
+            let Some(mut bytes) = rvoip_core::video_bridge::normalize_packet(&frame, ssrc, pt)
+            else {
+                continue;
+            };
+            let Ok(mut packet) = rtp::Packet::unmarshal(&mut bytes) else {
+                continue;
+            };
+            packet.header.ssrc = ssrc;
+            packet.header.payload_type = pt;
+            // RTP extensions and CSRCs describe the source hop, not this hop.
+            packet.header.extension = false;
+            packet.header.extensions.clear();
+            packet.header.csrc.clear();
+            if !matches!(
+                tokio::time::timeout(Duration::from_millis(100), track.write_rtp(packet)).await,
+                Ok(Ok(_))
+            ) {
+                break;
+            }
+            if let Some(collector) = collector.as_ref() {
+                collector.forwarded_age(
+                    rvoip_core::media_diagnostics::QueueStage::WebRtcVideoOut,
+                    age_ms,
+                );
+            }
+        }
+    })
+}
