+struct ForwardHistogram {
+    bins: [u64; 65],
+    samples: u64,
+    max_us: u64,
+    missing: u64,
+    timeouts: u64,
+}
+impl Default for ForwardHistogram {
+    fn default() -> Self {
+        Self {
+            bins: [0; 65],
+            samples: 0,
+            max_us: 0,
+            missing: 0,
+            timeouts: 0,
+        }
+    }
+}
+impl ForwardHistogram {
+    fn add(&mut self, duration: Duration) {
+        let us = u64::try_from(duration.as_nanos().div_ceil(1000)).unwrap_or(u64::MAX);
+        let bin = (64 - us.leading_zeros()) as usize;
+        self.bins[bin] = self.bins[bin].saturating_add(1);
+        self.samples = self.samples.saturating_add(1);
+        self.max_us = self.max_us.max(us);
+    }
+    fn percentile(&self, percent: u64) -> u64 {
+        let threshold = (u128::from(self.samples) * u128::from(percent)).div_ceil(100) as u64;
+        let mut total: u64 = 0;
+        for (bin, count) in self.bins.iter().enumerate() {
+            total = total.saturating_add(*count);
+            if total >= threshold {
+                return match bin {
+                    0 => 0,
+                    64 => u64::MAX,
+                    _ => (1_u64 << bin) - 1,
+                };
+            }
+        }
+        self.max_us
+    }
+    fn snapshot(&self) -> ForwardObservation {
+        ForwardObservation {
+            samples: self.samples,
+            p50_us: self.percentile(50),
+            p95_us: self.percentile(95),
+            max_us: self.max_us,
+            missing_ingress_observations: self.missing,
+            handoff_timeouts: self.timeouts,
+        }
+    }
+}
+// Match an owned frame clone without retaining media bytes. Private bounded
+// receipt keys never appear in public snapshots or Debug output.
+// Receipt DateTime is locally supplied by the adapter, not by the RTP wire.
+#[derive(PartialEq, Eq)]
+struct FrameKey {
+    captured_at: chrono::DateTime<chrono::Utc>,
+    stream: StreamId,
+    timestamp: u32,
+    sequence: Option<u16>,
+}
+impl FrameKey {
+    fn of(frame: &MediaFrame) -> Self {
+        Self {
+            captured_at: frame.captured_at,
+            stream: frame.stream_id.clone(),
+            timestamp: frame.timestamp_rtp,
+            sequence: frame
+                .payload
+                .get(2..4)
+                .map(|bytes| u16::from_be_bytes([bytes[0], bytes[1]])),
+        }
+    }
+}
+struct State {
+    queues: [QueueObservation; 12],
+    forward: [ForwardHistogram; 2],
+    ingress: VecDeque<(FrameKey, Instant)>,
+    quic: QuicTransmissionObservation,
+    webrtc_video_input: WebRtcVideoInputObservation,
+}
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            queues: std::array::from_fn(|_| QueueObservation::default()),
+            forward: std::array::from_fn(|_| ForwardHistogram::default()),
+            ingress: VecDeque::new(),
+            quic: QuicTransmissionObservation::default(),
+            webrtc_video_input: WebRtcVideoInputObservation::default(),
+        }
+    }
+}
+/// One server's metadata collector. At most 512 frame receipt keys survive for
+/// one second; two fixed logarithmic histograms and twelve static queue stages
+/// cannot grow with packet count, identifiers or Session history.
+#[derive(Default)]
+pub struct MediaDiagnostics {
+    state: Mutex<State>,
+}
+impl std::fmt::Debug for MediaDiagnostics {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("MediaDiagnostics([numeric observations])")
+    }
+}
+impl MediaDiagnostics {
+    fn prune(state: &mut State, now: Instant) {
+        state.ingress.retain(|(_, received)| {
+            now.saturating_duration_since(*received) <= Duration::from_secs(1)
+        });
+    }
+    /// A nonblocking channel-capacity observation at enqueue or pump poll. This
+    /// is sampled occupancy, never an assertion of the exact event peak.
+    pub fn observe_queue(&self, stage: QueueStage, capacity: usize, queued: usize) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.queues[stage as usize];
+        value.capacity_packets = value.capacity_packets.max(capacity);
+        value.sampled_high_water_packets = value.sampled_high_water_packets.max(queued);
+        value.observations = value.observations.saturating_add(1);
+    }
+    pub fn enqueue_full(&self, stage: QueueStage) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.queues[stage as usize];
+        value.enqueue_full_observations = value.enqueue_full_observations.saturating_add(1);
+    }
+    pub fn stale_discard(&self, stage: QueueStage) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.queues[stage as usize];
+        value.stale_forwarding_discards = value.stale_forwarding_discards.saturating_add(1);
+    }
+    pub fn forwarded_age(&self, stage: QueueStage, age_ms: i64) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.queues[stage as usize];
+        let age = u64::try_from(age_ms.max(0)).unwrap_or(u64::MAX);
+        value.max_forwarded_frame_age_ms =
+            Some(value.max_forwarded_frame_age_ms.unwrap_or(0).max(age));
+    }
+    /// Called immediately before adapter publication, after raw RTP event poll.
+    pub fn ingress(&self, frame: &MediaFrame) {
+        if frame.kind != StreamKind::Video {
+            return;
+        }
+        let now = Instant::now();
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        Self::prune(&mut state, now);
+        let key = FrameKey::of(frame);
+        if state.ingress.iter().any(|(existing, _)| existing == &key) {
+            return;
+        }
+        if state.ingress.len() == 512 {
+            state.ingress.pop_front();
+        }
+        state.ingress.push_back((key, now));
+    }
+    /// Successful destination queue handoff; includes adapter and Core queue
+    /// waiting. It excludes remote transport, decoder and physical playout.
+    pub fn handoff(&self, stage: ForwardStage, frame: &MediaFrame) {
+        let now = Instant::now();
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        Self::prune(&mut state, now);
+        let key = FrameKey::of(frame);
+        let received = state
+            .ingress
+            .iter()
+            .find(|(existing, _)| existing == &key)
+            .map(|(_, time)| *time);
+        let histogram = &mut state.forward[stage as usize];
+        if let Some(received) = received {
+            histogram.add(now.saturating_duration_since(received));
+        } else {
+            histogram.missing = histogram.missing.saturating_add(1);
+        }
+    }
+    pub fn handoff_timeout(&self, stage: ForwardStage) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.forward[stage as usize];
+        value.timeouts = value.timeouts.saturating_add(1);
+    }
+    /// Record the explicitly applied endpoint policy, not a guessed Quinn default.
+    pub fn configure_quic_send_buffer(&self, capacity: usize) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.quic.send_buffer = Some(QuicSendBufferObservation {
+            capacity_bytes: capacity,
+            observations: 0,
+            minimum_available_bytes: capacity,
+            maximum_available_bytes: 0,
+            sampled_high_water_bytes: 0,
+            capacity_mismatch_observations: 0,
+            send_exceeded_sampled_available_bytes: 0,
+        });
+    }
+    pub fn observe_quic_send_buffer(&self, available: usize, attempted: usize) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(value) = state.quic.send_buffer.as_mut() else {
+            return;
+        };
+        value.observations = value.observations.saturating_add(1);
+        value.minimum_available_bytes = value.minimum_available_bytes.min(available);
+        value.maximum_available_bytes = value.maximum_available_bytes.max(available);
+        if let Some(depth) = value.capacity_bytes.checked_sub(available) {
+            value.sampled_high_water_bytes = value.sampled_high_water_bytes.max(depth);
+        } else {
+            value.capacity_mismatch_observations =
+                value.capacity_mismatch_observations.saturating_add(1);
+        }
+        if attempted > available {
+            value.send_exceeded_sampled_available_bytes = value
+                .send_exceeded_sampled_available_bytes
+                .saturating_add(1);
+        }
+    }
+    pub fn quic_path(&self, max_datagram: Option<usize>, path_mtu: u16, attempted_bytes: usize) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.quic;
+        value.samples = value.samples.saturating_add(1);
+        if let Some(maximum) = max_datagram {
+            value.min_max_datagram_size_bytes = Some(
+                value
+                    .min_max_datagram_size_bytes
+                    .unwrap_or(maximum)
+                    .min(maximum),
+            );
+            value.max_max_datagram_size_bytes = Some(
+                value
+                    .max_max_datagram_size_bytes
+                    .unwrap_or(maximum)
+                    .max(maximum),
+            );
+        }
+        value.min_path_mtu_bytes = Some(value.min_path_mtu_bytes.unwrap_or(path_mtu).min(path_mtu));
+        value.max_path_mtu_bytes = Some(value.max_path_mtu_bytes.unwrap_or(path_mtu).max(path_mtu));
+        value.maximum_attempted_datagram_bytes =
+            value.maximum_attempted_datagram_bytes.max(attempted_bytes);
+    }
+    pub fn quic_video_budget(
+        &self,
+        budget: Option<usize>,
+        source_bytes: usize,
+        output_count: Option<usize>,
+    ) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.quic;
+        value.video_budget_observations = value.video_budget_observations.saturating_add(1);
+        value.maximum_source_video_rtp_bytes =
+            value.maximum_source_video_rtp_bytes.max(source_bytes);
+        if let Some(budget) = budget {
+            value.min_video_rtp_budget_bytes = Some(
+                value
+                    .min_video_rtp_budget_bytes
+                    .unwrap_or(budget)
+                    .min(budget),
+            );
+            value.max_video_rtp_budget_bytes = Some(
+                value
+                    .max_video_rtp_budget_bytes
+                    .unwrap_or(budget)
+                    .max(budget),
+            );
+            if output_count.is_none() {
+                value.video_packetizer_discards = value.video_packetizer_discards.saturating_add(1);
+            } else if output_count.is_some_and(|count| count > 1) {
+                value.video_repacketized_inputs = value.video_repacketized_inputs.saturating_add(1);
+            }
+        } else {
+            value.video_no_datagram_budget = value.video_no_datagram_budget.saturating_add(1);
+        }
+    }
+    pub fn quic_send(&self, result: QuicSendResult) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = match result {
+            QuicSendResult::Accepted => &mut state.quic.accepted_datagrams,
+            QuicSendResult::TooLarge => &mut state.quic.too_large,
+            QuicSendResult::UnsupportedByPeer => &mut state.quic.unsupported_by_peer,
+            QuicSendResult::Disabled => &mut state.quic.disabled,
+            QuicSendResult::ConnectionLost => &mut state.quic.connection_lost,
+        };
+        *value = value.saturating_add(1);
+    }
+    pub fn snapshot(&self) -> MediaDiagnosticsSnapshot {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        Self::prune(&mut state, Instant::now());
+        MediaDiagnosticsSnapshot {
+            webrtc_video_input: (state.webrtc_video_input.source_packets > 0)
+                .then(|| state.webrtc_video_input.clone()),
+            quic: (state.quic.samples > 0 || state.quic.video_budget_observations > 0)
+                .then(|| state.quic.clone()),
+            queues: QUEUE_STAGES
+                .into_iter()
+                .filter_map(|stage| {
+                    let value = &state.queues[stage as usize];
+                    (value.observations > 0).then(|| (stage, value.clone()))
+                })
+                .collect(),
+            forwarding: [ForwardStage::VideoBridge, ForwardStage::VideoFanout]
+                .into_iter()
+                .filter_map(|stage| {
+                    let value = &state.forward[stage as usize];
+                    (value.samples > 0 || value.missing > 0 || value.timeouts > 0)
+                        .then(|| (stage, value.snapshot()))
+                })
+                .collect(),
+        }
+    }
+}
