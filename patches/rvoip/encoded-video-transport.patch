@@ -0,0 +1,352 @@
+//! Owned forwarding for negotiated encoded video. This complements the audio
+//! media graph without decoding or reinterpreting video as an audio codec.
+use crate::{
+    error::{Result, RvoipError},
+    stream::{MediaFrame, MediaStream, StreamKind},
+};
+use std::{sync::Arc, time::Duration};
+use tokio::{sync::mpsc, task::JoinHandle};
+
+/// Owns the two forwarding tasks for one compatible encoded-video pairing.
+/// Drop cancels promptly; [`Self::shutdown`] also joins both owned tasks.
+pub struct EncodedVideoBridge {
+    tasks: Vec<JoinHandle<()>>,
+}
+impl EncodedVideoBridge {
+    pub(crate) fn start(
+        a: Vec<Arc<dyn MediaStream>>,
+        b: Vec<Arc<dyn MediaStream>>,
+        diagnostics: Arc<crate::media_diagnostics::MediaDiagnostics>,
+    ) -> Result<Option<Self>> {
+        let a = a.into_iter().find(|s| s.kind() == StreamKind::Video);
+        let b = b.into_iter().find(|s| s.kind() == StreamKind::Video);
+        let (Some(a), Some(b)) = (a, b) else {
+            return Ok(None);
+        };
+        a.set_media_diagnostics(Arc::clone(&diagnostics));
+        b.set_media_diagnostics(Arc::clone(&diagnostics));
+        let ast = a.media_queue_stages();
+        let bst = b.media_queue_stages();
+        let ac = a.codec();
+        let bc = b.codec();
+        if !ac.name.eq_ignore_ascii_case("vp8")
+            || !bc.name.eq_ignore_ascii_case("vp8")
+            || ac.clock_rate_hz != 90_000
+            || bc.clock_rate_hz != 90_000
+        {
+            return Err(RvoipError::UnsupportedCodec(
+                "incompatible encoded video".into(),
+            ));
+        }
+        // Reserve both receivers before committing either; a rejected second
+        // reservation restores the first source instead of stranding it.
+        let ar = a.reserve_frames_in()?;
+        let br = b.reserve_frames_in()?;
+        let mut tasks = vec![
+            forward(
+                ar.commit(),
+                b.frames_out(),
+                Arc::clone(&diagnostics),
+                ast.map(|s| s.0),
+                bst.map(|s| s.1),
+            ),
+            forward(
+                br.commit(),
+                a.frames_out(),
+                diagnostics,
+                bst.map(|s| s.0),
+                ast.map(|s| s.1),
+            ),
+        ];
+        if let Some(requests) = a.video_keyframe_requests() {
+            tasks.push(feedback(requests, Arc::clone(&b)));
+        }
+        if let Some(requests) = b.video_keyframe_requests() {
+            tasks.push(feedback(requests, Arc::clone(&a)));
+        }
+        Ok(Some(Self { tasks }))
+    }
+    /// Cancel and join all owned forwarding tasks before releasing the pairing.
+    pub async fn shutdown(mut self) {
+        for task in &self.tasks {
+            task.abort();
+        }
+        for task in self.tasks.drain(..) {
+            let _ = task.await;
+        }
+    }
+}
+impl Drop for EncodedVideoBridge {
+    fn drop(&mut self) {
+        for task in &self.tasks {
+            task.abort();
+        }
+    }
+}
+/// Maximum complete RTP packet under the qualified native QUIC MTU budget.
+pub const MAX_VIDEO_RTP_BYTES: usize = 1180;
+
+/// Validate encoded-video frame metadata and remove hop-local RTP fields.
+/// Source sequence, timestamp and marker survive; destination PT/SSRC are local.
+pub fn normalize_packet(frame: &MediaFrame, ssrc: u32, pt: u8) -> Option<bytes::Bytes> {
+    if frame.kind != StreamKind::Video || frame.payload.len() > MAX_VIDEO_RTP_BYTES {
+        return None;
+    }
+    let mut packet = rvoip_rtp_core::RtpPacket::parse(&frame.payload).ok()?;
+    if packet.payload.is_empty()
+        || packet.header.timestamp != frame.timestamp_rtp
+        || frame
+            .payload_type
+            .is_some_and(|pt| pt != packet.header.payload_type)
+        || pt > 127
+    {
+        return None;
+    }
+    packet.header.ssrc = ssrc;
+    packet.header.payload_type = pt;
+    packet.header.extension = false;
+    packet.header.extensions = None;
+    packet.header.cc = 0;
+    packet.header.csrc.clear();
+    packet.clear_padding();
+    packet.serialize().ok()
+}
+
+fn forward(
+    mut rx: mpsc::Receiver<MediaFrame>,
+    tx: mpsc::Sender<MediaFrame>,
+    diagnostics: Arc<crate::media_diagnostics::MediaDiagnostics>,
+    source: Option<crate::media_diagnostics::QueueStage>,
+    destination: Option<crate::media_diagnostics::QueueStage>,
+) -> JoinHandle<()> {
+    tokio::spawn(async move {
+        while let Some(frame) = rx.recv().await {
+            if let Some(stage) = source {
+                diagnostics.observe_queue(stage, rx.max_capacity(), rx.len());
+            }
+            let age = (chrono::Utc::now() - frame.captured_at).num_milliseconds();
+            if age > 200 {
+                if let Some(stage) = source {
+                    diagnostics.stale_discard(stage);
+                }
+                continue;
+            }
+            if frame.kind != StreamKind::Video || frame.payload.len() > MAX_VIDEO_RTP_BYTES {
+                continue;
+            }
+            if let Some(stage) = destination {
+                diagnostics.observe_queue(
+                    stage,
+                    tx.max_capacity(),
+                    tx.max_capacity() - tx.capacity(),
+                );
+            }
+            // A metadata-only clone key is enough to measure the original
+            // adapter publication. Never retain payload bytes for telemetry.
+            let observed = frame.clone();
+            match tokio::time::timeout(Duration::from_millis(10), tx.send(frame)).await {
+                Ok(Ok(())) => {
+                    diagnostics.handoff(
+                        crate::media_diagnostics::ForwardStage::VideoBridge,
+                        &observed,
+                    );
+                    if let Some(stage) = source {
+                        diagnostics.forwarded_age(stage, age);
+                    }
+                    if let Some(stage) = destination {
+                        diagnostics.observe_queue(
+                            stage,
+                            tx.max_capacity(),
+                            tx.max_capacity() - tx.capacity(),
+                        );
+                    }
+                }
+                Ok(Err(_)) => break,
+                Err(_) => {
+                    diagnostics.handoff_timeout(crate::media_diagnostics::ForwardStage::VideoBridge)
+                }
+            }
+        }
+    })
+}
+
+// Coalescing keeps one pending request and the rate bound is per bridge direction.
+// Native peers have no UCTP feedback wire profile and use periodic keyframes.
+fn feedback(requests: Arc<tokio::sync::Notify>, source: Arc<dyn MediaStream>) -> JoinHandle<()> {
+    tokio::spawn(async move {
+        let mut next = tokio::time::Instant::now();
+        loop {
+            requests.notified().await;
+            tokio::time::sleep_until(next).await;
+            let _ =
+                tokio::time::timeout(Duration::from_millis(100), source.request_video_keyframe())
+                    .await;
+            next = tokio::time::Instant::now() + Duration::from_millis(250);
+        }
+    })
+}
