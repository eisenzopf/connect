+    /// Every policy/generation reader is destroyed before Pending or return.
+    /// The actual transport must use deliver_ready_with_origin afterwards.
+    pub async fn prepare_delivery(mut self, deadline: Instant) -> ControlResult<Self> {
+        if self.data.is_some() || self.frame.kind == StreamKind::Data {
+            return Err(StreamControlError::Unsupported);
+        }
