+// Actual queued Core metadata; no frame/permission escapes prepare and no
+// factory/encoder runs again when the final current attempt defers.
+#[tokio::test]
+async fn prepared_delivery_releases_readers_and_final_busy_retains_same_original() {
+    let (f, armed, busy) = fixture(Medium::Video).await;
+    let work = catch_future(async {
+        let packet = queued(&f, Medium::Video).await;
+        let expected = packet.frame.clone();
+        let original_age = packet.admitted_at;
+        armed.store(true, Ordering::Release);
+        let mut preparation =
+            Box::pin(packet.prepare_delivery(original_age + Duration::from_millis(200)));
+        let first = std::future::poll_fn(|cx| Poll::Ready(preparation.as_mut().poll(cx))).await;
+        assert!(first.is_pending(), "actual current metadata did not defer");
+        assert!(
+            f.policy.0.try_write().is_ok(),
+            "prepare held current readers while Pending"
+        );
+        let packet = preparation.await.unwrap();
+        assert_eq!(packet.admitted_at, original_age);
+        assert!(
+            f.policy.0.try_write().is_ok(),
+            "prepared hint retained permission"
+        );
+        armed.store(true, Ordering::Release); // race after hint, before actual IO.
+        let packet = match packet
+            .deliver_ready_with_origin(|_, _| async {
+                panic!("final temporary refusal entered IO")
+            })
+            .await
+        {
+            ReadyMediaDelivery::Deferred {
+                queued,
+                problem: StreamControlError::MetadataBusy,
+            } => queued,
+            _ => panic!("final refusal lost the same original"),
+        };
+        assert!(f.policy.0.try_write().is_ok());
+        assert_eq!(packet.admitted_at, original_age);
+        let packet = packet
+            .prepare_delivery(original_age + Duration::from_millis(200))
+            .await
+            .unwrap();
+        let mut writes = 0;
+        let result = packet
+            .deliver_ready_with_origin(|frame, _| {
+                writes += 1;
+                async move {
+                    assert_eq!(frame.payload, expected.payload);
+                    assert_eq!(frame.timestamp_rtp, expected.timestamp_rtp);
+                    assert_eq!(frame.captured_at, expected.captured_at);
+                    assert_eq!(frame.stream_id, expected.stream_id);
+                    Ok(())
+                }
+            })
+            .await;
+        assert!(matches!(result, ReadyMediaDelivery::Complete(Ok(()))));
+        assert_eq!(writes, 1);
+        assert_eq!(busy.load(Ordering::Acquire), 2);
+    })
+    .await;
+    let joined = close(&f).await;
+    assert!(
+        joined,
+        "original Core controllers must close before two-phase oracle"
+    );
+    if let Err(error) = work {
+        std::panic::resume_unwind(error);
+    }
+}
