+//! Two bounded lanes with one original queued256+active1 resident budget.
+//! Capacity tokens are not permission and survive every metadata preparation.
+use super::PeerConnectionDriverEvent as Event;
+use crate::runtime::{Receiver, SendError, Sender, TryRecvError, TrySendError, channel};
+use std::sync::Arc;
+use tokio::sync::{OwnedSemaphorePermit, Semaphore, TryAcquireError};
+
+pub(super) const RESIDENT_LIMIT: usize = 257;
+pub(super) const MEDIA_LIMIT: usize = 255;
+const RING_CAPACITY: usize = super::PEER_CONNECTION_DRIVER_EVENT_CHANNEL_CAPACITY;
+
+pub(crate) struct DriverEnvelope {
+    pub(super) event: Event,
+    pub(super) admission: DriverAdmission,
+}
+pub(super) struct DriverAdmission {
+    _resident: OwnedSemaphorePermit,
+    _media: Option<OwnedSemaphorePermit>,
+}
+#[derive(Clone)]
+pub(crate) struct DriverEventSender {
+    control: Sender<DriverEnvelope>,
+    media: Sender<DriverEnvelope>,
+    resident: Arc<Semaphore>,
+    media_quota: Arc<Semaphore>,
+}
+pub(crate) struct DriverEventReceivers {
+    pub(super) control: Receiver<DriverEnvelope>,
+    pub(super) media: Receiver<DriverEnvelope>,
+    resident: Arc<Semaphore>,
+    media_quota: Arc<Semaphore>,
+}
+fn media(event: &Event) -> bool {
+    matches!(
+        event,
+        Event::OwnedRtp(..)
+            | Event::OwnedDtmf(..)
+            | Event::SenderRtp(..)
+            | Event::SenderRtpWithClock(..)
+    )
+}
+pub(crate) fn driver_channel() -> (DriverEventSender, DriverEventReceivers) {
+    driver_channel_with_capacity(RING_CAPACITY)
+}
+fn driver_channel_with_capacity(capacity: usize) -> (DriverEventSender, DriverEventReceivers) {
+    let (control, control_rx) = channel(capacity);
+    let (media_tx, media_rx) = channel(capacity);
+    let resident = Arc::new(Semaphore::new(RESIDENT_LIMIT));
+    let media_quota = Arc::new(Semaphore::new(MEDIA_LIMIT));
+    (
+        DriverEventSender {
+            control,
+            media: media_tx,
+            resident: resident.clone(),
+            media_quota: media_quota.clone(),
+        },
+        DriverEventReceivers {
+            control: control_rx,
+            media: media_rx,
+            resident,
+            media_quota,
+        },
+    )
+}
+impl DriverEventSender {
+    pub async fn send(&self, event: Event) -> Result<(), SendError<Event>> {
+        let is_media = media(&event);
+        let quota = if is_media {
+            match self.media_quota.clone().acquire_owned().await {
+                Ok(value) => Some(value),
+                Err(_) => return Err(SendError(event)),
+            }
+        } else {
+            None
+        };
+        let resident = match self.resident.clone().acquire_owned().await {
+            Ok(value) => value,
+            Err(_) => return Err(SendError(event)),
+        };
+        let envelope = DriverEnvelope {
+            event,
+            admission: DriverAdmission {
+                _resident: resident,
+                _media: quota,
+            },
+        };
+        let tx = if is_media { &self.media } else { &self.control };
+        tx.send(envelope)
+            .await
+            .map_err(|error| SendError(error.0.event))
+    }
+    pub fn try_send(&self, event: Event) -> Result<(), TrySendError<Event>> {
+        let is_media = media(&event);
+        let quota = if is_media {
+            match self.media_quota.clone().try_acquire_owned() {
+                Ok(value) => Some(value),
+                Err(TryAcquireError::Closed) => return Err(TrySendError::Disconnected(event)),
+                Err(TryAcquireError::NoPermits) => return Err(TrySendError::Full(event)),
+            }
+        } else {
+            None
+        };
+        let resident = match self.resident.clone().try_acquire_owned() {
+            Ok(value) => value,
+            Err(TryAcquireError::Closed) => return Err(TrySendError::Disconnected(event)),
+            Err(TryAcquireError::NoPermits) => return Err(TrySendError::Full(event)),
+        };
+        let envelope = DriverEnvelope {
+            event,
+            admission: DriverAdmission {
+                _resident: resident,
+                _media: quota,
+            },
+        };
+        let tx = if is_media { &self.media } else { &self.control };
+        tx.try_send(envelope).map_err(|error| match error {
+            TrySendError::Full(value) => TrySendError::Full(value.event),
+            TrySendError::Disconnected(value) => TrySendError::Disconnected(value.event),
+        })
+    }
+}
+impl DriverEventReceivers {
+    #[cfg(test)]
+    pub(crate) async fn recv_media_for_test(&mut self) -> Option<Event> {
+        self.media.recv().await.map(|envelope| envelope.event)
+    }
+    pub(super) fn close(&mut self) {
+        // Wake ALL original senders, including ones waiting on shared capacity.
+        self.control.0.close();
+        self.media.0.close();
+        self.resident.close();
+        self.media_quota.close();
+    }
+    pub(super) fn drain_one(&mut self) -> Option<DriverEnvelope> {
+        self.control
+            .try_recv()
+            .ok()
+            .or_else(|| self.media.try_recv().ok())
+    }
+}
+
+#[cfg(test)]
+mod tests;
+
+#[cfg(test)]
+pub(crate) fn one_slot_driver_channel_for_test() -> (DriverEventSender, DriverEventReceivers) {
+    driver_channel_with_capacity(1)
+}
+
+impl Drop for DriverEventReceivers {
+    fn drop(&mut self) {
+        // Original-driver errors/aborts also wake every capacity waiter. No
+        // abandoned sender may report Full indefinitely after both lanes die.
+        self.close();
+    }
+}
