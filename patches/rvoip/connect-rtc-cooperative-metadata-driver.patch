+struct PendingRtp {
+    sender: RTCRtpSenderId,
+    request: Option<OwnedRtpRequest>,
+    admission: Option<DriverAdmission>,
+    preparing: Option<std::pin::Pin<Box<dyn std::future::Future<Output = OwnedRtpResult> + Send>>>,
+}
+impl PendingRtp {
+    fn new(sender: RTCRtpSenderId, request: OwnedRtpRequest, admission: DriverAdmission) -> Self {
+        let producer = request.producer.clone();
+        let control = request.control.clone();
+        let preparing = Box::pin(async move {
+            use crate::media_stream::track_local::owned_rtp::stopped;
+            tokio::select! { biased;
+                _ = tokio::time::sleep_until(tokio::time::Instant::from_std(control.deadline())) => Err(stopped(&control)),
+                _ = control.cancelled() => Err(stopped(&control)),
+                result = producer.prepare(control.clone()) => result,
+            }
+        });
+        Self {
+            sender,
+            request: Some(request),
+            admission: Some(admission),
+            preparing: Some(preparing),
+        }
+    }
+    fn into_ready(mut self) -> (RTCRtpSenderId, OwnedRtpRequest, DriverAdmission) {
+        drop(self.preparing.take());
+        (
+            self.sender,
+            self.request.take().expect("original request"),
+            self.admission.take().expect("same admission"),
+        )
+    }
+    fn refuse(mut self) {
+        drop(self.preparing.take());
+        if let Some(request) = self.request.take() {
+            refuse_rtp(request);
+        }
+        drop(self.admission.take());
+    }
+}
+impl Drop for PendingRtp {
+    fn drop(&mut self) {
+        // Forced original-driver destruction gives NO positive receipt. Its
+        // original worker still observes OutcomeUnknown/drained=false. Keep
+        // the capacity token until the exact future and request are destroyed.
+        if let Some(request) = &self.request {
+            request.control.cancel();
+        }
+        drop(self.preparing.take());
+        drop(self.request.take());
+        drop(self.admission.take());
+    }
+}
+
+fn refuse_rtp(request: OwnedRtpRequest) {
+    use crate::media_stream::track_local::owned_rtp::stopped;
+    let OwnedRtpRequest {
+        producer,
+        control,
+        completion,
+    } = request;
+    let error = stopped(&control);
+    drop(producer);
+    let _ = completion.send(Err(error));
+}
+fn refuse_queued(envelope: DriverEnvelope) {
+    let DriverEnvelope { event, admission } = envelope;
+    match event {
+        PeerConnectionDriverEvent::OwnedRtp(_, request) => refuse_rtp(request),
+        PeerConnectionDriverEvent::OwnedDtmf(_, request) => {
+            let OwnedDtmfRequest {
+                packet,
+                authority,
+                control,
+                completion,
+                ..
+            } = request;
+            let error = stopped(&control);
+            drop(packet);
+            drop(authority);
+            let _ = completion.send(Err(error));
+        }
+        _ => {}
+    }
+    drop(admission);
+}
