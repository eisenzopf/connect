+use super::*;
+use std::future::Future;
+use std::task::Poll;
+fn packet() -> Event {
+    Event::SenderRtp(Default::default(), rtc::rtp::Packet::default())
+}
+
+#[test]
+fn media_saturation_keeps_control_reserve_inside_same_resident_budget() {
+    let (tx, mut rx) = driver_channel();
+    for _ in 0..MEDIA_LIMIT {
+        tx.try_send(packet()).unwrap();
+    }
+    let active = rx.media.try_recv().unwrap();
+    assert!(matches!(tx.try_send(packet()), Err(TrySendError::Full(_))));
+    tx.try_send(Event::WriteNotify).unwrap();
+    tx.try_send(Event::Close).unwrap();
+    assert_eq!(tx.resident.available_permits(), 0);
+    assert!(matches!(
+        tx.try_send(Event::WriteNotify),
+        Err(TrySendError::Full(_))
+    ));
+    assert!(matches!(
+        rx.control.try_recv().unwrap().event,
+        Event::WriteNotify
+    ));
+    assert!(matches!(rx.control.try_recv().unwrap().event, Event::Close));
+    assert_eq!(tx.resident.available_permits(), 2);
+    // Dequeue is not settlement; the same pending/ready/active token stays held.
+    assert_eq!(tx.media_quota.available_permits(), 0);
+    drop(active);
+    assert_eq!(tx.media_quota.available_permits(), 1);
+    tx.try_send(packet()).unwrap();
+    rx.close();
+    while rx.drain_one().is_some() {}
+    assert_eq!(tx.resident.available_permits(), RESIDENT_LIMIT);
+    assert_eq!(tx.media_quota.available_permits(), MEDIA_LIMIT);
+}
+
+#[tokio::test]
+async fn cancelled_send_and_close_release_capacity_without_losing_original_event() {
+    let (tx, mut rx) = driver_channel();
+    for _ in 0..MEDIA_LIMIT {
+        tx.try_send(packet()).unwrap();
+    }
+    let mut waiting = Box::pin(tx.send(packet()));
+    let first = std::future::poll_fn(|cx| Poll::Ready(waiting.as_mut().poll(cx))).await;
+    assert!(first.is_pending());
+    drop(waiting);
+    assert_eq!(
+        tx.resident.available_permits(),
+        RESIDENT_LIMIT - MEDIA_LIMIT
+    );
+    assert_eq!(tx.media_quota.available_permits(), 0);
+    rx.close();
+    let error = tx.send(packet()).await.unwrap_err();
+    assert!(matches!(error.0, Event::SenderRtp(..)));
+    assert!(matches!(
+        tx.try_send(Event::Close),
+        Err(TrySendError::Disconnected(Event::Close))
+    ));
+    while rx.drain_one().is_some() {}
+    assert_eq!(tx.resident.available_permits(), RESIDENT_LIMIT);
+    assert_eq!(tx.media_quota.available_permits(), MEDIA_LIMIT);
+}
