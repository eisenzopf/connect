+//! Real ICE/DTLS/SRTP/SRTCP progress with a held fail-closed producer preparation.
+//! This checks driver scheduling/custody; Core policy/IO guards have separate controls.
+use super::*;
+use crate::media_stream::track_local::owned_rtp::*;
+use crate::media_stream::track_local::{TrackLocal, static_rtp::TrackLocalStaticRTP};
+use crate::peer_connection::{
+    PeerConnection, PeerConnectionBuilder, PeerConnectionEventHandler, RTCPeerConnectionState,
+};
+use rtc::peer_connection::configuration::media_engine::MediaEngine;
+use rtc::rtp_transceiver::rtp_sender::{
+    RTCRtpCodec, RTCRtpCodecParameters, RTCRtpCodingParameters, RTCRtpEncodingParameters,
+    RtpCodecKind,
+};
+use std::future::Future;
+use std::sync::{
+    Mutex,
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+};
+use tokio::sync::{Notify, mpsc};
+use tokio::time::timeout;
+
+struct Preparation {
+    entered: Arc<Notify>,
+    release: Arc<Notify>,
+    events: Arc<Mutex<Vec<&'static str>>>,
+}
+struct FutureDropped(Arc<Mutex<Vec<&'static str>>>);
+impl Drop for FutureDropped {
+    fn drop(&mut self) {
+        self.0.lock().unwrap().push("preparation-dropped");
+    }
+}
+impl Drop for Preparation {
+    fn drop(&mut self) {
+        self.events.lock().unwrap().push("producer-dropped");
+    }
+}
+#[async_trait::async_trait]
+impl OwnedRtpProducer for Preparation {
+    async fn prepare(&self, _: OwnedRtpControl) -> OwnedRtpResult {
+        let _original = FutureDropped(self.events.clone());
+        self.entered.notify_one();
+        self.release.notified().await;
+        Err(OwnedRtpError::Refused)
+    }
+    async fn write(&self, _: &mut dyn OwnedRtpIo) -> OwnedRtpAttempt {
+        OwnedRtpAttempt::DeferredNoIo
+    }
+}
+#[tokio::test]
+async fn pending_prepare_normal_refusal_destroys_future_before_original_receipt_and_token() {
+    for forced in [false, true] {
+        let (tx, mut rx) = mailbox::driver_channel();
+        let events = Arc::new(Mutex::new(Vec::new()));
+        let producer = Arc::new(Preparation {
+            entered: Arc::new(Notify::new()),
+            release: Arc::new(Notify::new()),
+            events: events.clone(),
+        });
+        let control = OwnedRtpControl::new(Instant::now() + Duration::from_secs(1));
+        assert!(control.claim());
+        let (completion, receipt) = tokio::sync::oneshot::channel();
+        tx.send(PeerConnectionDriverEvent::OwnedRtp(
+            Default::default(),
+            OwnedRtpRequest {
+                producer,
+                control,
+                completion,
+            },
+        ))
+        .await
+        .unwrap();
+        let DriverEnvelope { event, admission } = rx.media.recv().await.unwrap();
+        let PeerConnectionDriverEvent::OwnedRtp(sender, request) = event else {
+            panic!("owned original");
+        };
+        let mut pending = PendingRtp::new(sender, request, admission);
+        let first = std::future::poll_fn(|cx| {
+            std::task::Poll::Ready(pending.preparing.as_mut().unwrap().as_mut().poll(cx))
+        })
+        .await;
+        assert!(first.is_pending());
+        if forced {
+            drop(pending);
+            assert!(receipt.await.is_err());
+        } else {
+            pending.refuse();
+            assert_eq!(
+                receipt.await.unwrap(),
+                Err(OwnedRtpError::DeadlineBeforeWrite)
+            );
+        }
+        assert_eq!(
+            *events.lock().unwrap(),
+            vec!["preparation-dropped", "producer-dropped"]
+        );
+        // Normal delivers an exact refusal; forced destruction sends no positive
+        // driver receipt, so the existing original worker reports unknown drain.
+        rx.close();
+        while rx.drain_one().is_some() {}
+    }
+}
+
+struct Handler {
+    gathered: mpsc::Sender<()>,
+    connected: mpsc::Sender<()>,
+    track: mpsc::Sender<Arc<dyn TrackRemote>>,
+    rtcp: mpsc::Sender<()>,
+    block: Arc<AtomicBool>,
+    blocked: Arc<Notify>,
+    release: Arc<Notify>,
+}
+#[async_trait::async_trait]
+impl PeerConnectionEventHandler for Handler {
+    async fn on_ice_gathering_state_change(&self, state: RTCIceGatheringState) {
+        if state == RTCIceGatheringState::Complete {
+            let _ = self.gathered.try_send(());
+        }
+    }
+    async fn on_connection_state_change(&self, state: RTCPeerConnectionState) {
+        if state == RTCPeerConnectionState::Connected {
+            let _ = self.connected.try_send(());
+        }
+    }
+    async fn on_track(&self, track: Arc<dyn TrackRemote>) {
+        let _ = self.track.try_send(track);
+    }
+    async fn on_rtcp_packet(&self, packet: &dyn rtc::rtcp::Packet) -> bool {
+        if packet
+            .as_any()
+            .is::<rtc::rtcp::payload_feedbacks::picture_loss_indication::PictureLossIndication>()
+        {
+            let _ = self.rtcp.try_send(());
+            if self.block.load(Ordering::Acquire) {
+                self.blocked.notify_one();
+                self.release.notified().await;
+            }
+            return true;
+        }
+        false
+    }
+}
+fn codec() -> RTCRtpCodecParameters {
+    RTCRtpCodecParameters {
+        payload_type: 0,
+        rtp_codec: RTCRtpCodec {
+            mime_type: "audio/PCMU".into(),
+            clock_rate: 8000,
+            ..Default::default()
+        },
+    }
+}
+fn media() -> MediaEngine {
+    let mut m = MediaEngine::default();
+    m.register_codec(codec(), RtpCodecKind::Audio).unwrap();
+    m
+}
+fn local(ssrc: u32) -> Arc<TrackLocalStaticRTP> {
+    Arc::new(TrackLocalStaticRTP::new(MediaStreamTrack::new(
+        "s".into(),
+        format!("t{ssrc}").into(),
+        "cooperative".into(),
+        RtpCodecKind::Audio,
+        vec![RTCRtpEncodingParameters {
+            rtp_coding_parameters: RTCRtpCodingParameters {
+                ssrc: Some(ssrc),
+                ..Default::default()
+            },
+            codec: codec().rtp_codec,
+            ..Default::default()
+        }],
+    )))
+}
+fn packet(ssrc: u32, sequence: u16) -> rtp::Packet {
+    rtp::Packet {
+        header: rtp::Header {
+            version: 2,
+            ssrc,
+            payload_type: 0,
+            sequence_number: sequence,
+            timestamp: u32::from(sequence) * 160,
+            ..Default::default()
+        },
+        payload: bytes::Bytes::from_static(&[0xff; 160]),
+    }
+}
+async fn receive(track: &Arc<dyn TrackRemote>, sequence: u16) -> rtp::Packet {
+    loop {
+        if let Some(TrackRemoteEvent::OnRtpPacket(packet, _)) = track.poll().await {
+            if packet.header.sequence_number == sequence {
+                return packet;
+            }
+        }
+    }
+}
