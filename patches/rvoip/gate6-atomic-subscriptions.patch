+//! Ports must already be confirmed. Resource preparation is a separate concern.
+use super::{
+    audio_subscriptions::{self, AudioPlan, AudioSubscriptionChange},
+    direct_subscriptions::{self, DirectSubscriptionChange},
+    media_scene::{GuardedMediaScene, SceneMember},
+    *,
+};
+use std::collections::HashMap;
+
+/// None preserves that routing program. At least one change is required.
+#[derive(Clone, PartialEq, Eq)]
+pub struct MediaSubscriptionChange {
+    pub selection: Option<Arc<super::selection_intent::SelectionMutation>>,
+    pub audio: Option<AudioSubscriptionChange>,
+    pub direct: Option<DirectSubscriptionChange>,
+}
+impl GuardedMediaScene {
+    pub(crate) async fn change_media_subscriptions(
+        &self,
+        target: &ConnectionId,
+        expected: u64,
+        change: MediaSubscriptionChange,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<u64> {
+        super::media_subscriptions::change(
+            self.controller(target)?,
+            Some(self),
+            expected,
+            change,
+            deadline,
+            cancel,
+            held,
+        )
+        .await
+    }
+}
+
+// Scene -> controller -> route gates is the same order as media admission.
+// A removed/replaced member cannot acquire the old routing program at commit.
+fn with_member<T>(
+    scene: Option<&GuardedMediaScene>,
+    controller: &Arc<StreamController>,
+    f: impl FnOnce(Option<(&HashMap<ConnectionId, SceneMember>, &SceneMember)>) -> ControlResult<T>,
+) -> ControlResult<T> {
+    match scene {
+        Some(scene) => {
+            let members = scene.members.lock().unwrap_or_else(|p| p.into_inner());
+            let target = members
+                .get(&controller.connection)
+                .ok_or(StreamControlError::NotReady)?;
+            if !Arc::ptr_eq(&target.controller, controller) {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            f(Some((&members, target)))
+        }
+        None => f(None),
+    }
+}
+fn validate_members(
+    member: Option<(&HashMap<ConnectionId, SceneMember>, &SceneMember)>,
+    change: &MediaSubscriptionChange,
+) -> ControlResult<()> {
+    if let (Some((members, _)), Some(DirectSubscriptionChange::Subscribe(items))) =
+        (member, &change.direct)
+    {
+        for selection in items {
+            let source = selection.publisher().ok_or(StreamControlError::NotReady)?;
+            if !members
+                .get(&selection.source.connection)
+                .is_some_and(|m| Arc::ptr_eq(&m.controller, &source))
+            {
+                return Err(StreamControlError::Authority);
+            }
+        }
+    }
+    Ok(())
+}
+fn invocation(
+    controller: &StreamController,
+    credential: &CredentialSnapshot,
+    control: Option<&MediaControl>,
+    deadline: tokio::time::Instant,
+    cancel: &CancellationToken,
+) -> ControlResult<()> {
+    if cancel.is_cancelled() || controller.shutdown.is_cancelled() {
+        return Err(StreamControlError::Cancelled);
+    }
+    if tokio::time::Instant::now() >= deadline {
+        return Err(StreamControlError::Deadline);
+    }
+    if let Some(control) = control {
+        control.valid()?;
+    }
+    controller.check_credential_snapshot(credential)
+}
+pub(super) async fn change(
+    controller: Arc<StreamController>,
+    scene: Option<&GuardedMediaScene>,
+    expected: u64,
+    change: MediaSubscriptionChange,
+    deadline: tokio::time::Instant,
+    cancel: CancellationToken,
+    held: Option<&(dyn Any + Send + Sync)>,
+) -> ControlResult<u64> {
+    if change.audio.is_none() && change.direct.is_none() && change.selection.is_none() {
+        return Err(MediaTransitionError::Invalid.into());
+    }
+    if let Some(audio) = &change.audio {
+        audio_subscriptions::validate(audio)?;
+        if scene.is_none() {
+            return Err(StreamControlError::NotReady);
+        }
+    }
+    if let Some(direct) = &change.direct {
+        direct_subscriptions::validate(direct)?;
+    }
+    let _flight = controller
+        .inflight
+        .clone()
+        .try_acquire_owned()
+        .map_err(|_| MediaTransitionError::Conflict)?;
+    let credential = controller.credential_snapshot();
+    let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+    let intent = if change.selection.is_some() {
+        MediaControlIntent::Subscriptions {
+            expected,
+            change: &change,
+        }
+    } else {
+        match (&change.audio, &change.direct) {
+            (Some(change), None) => MediaControlIntent::AudioSubscriptions { expected, change },
+            (None, Some(change)) => MediaControlIntent::DirectSubscriptions { expected, change },
+            _ => MediaControlIntent::Subscriptions {
+                expected,
+                change: &change,
+            },
+        }
+    };
+    let control = held
+        .map(|held| controller.policy.current_control(&scope, &intent, held))
+        .transpose()?;
+    let deadline = StreamController::command_deadline(&credential.principal, deadline)
+        .min(control.as_ref().map_or(deadline, |c| c.deadline));
+    invocation(
+        &controller,
+        &credential,
+        control.as_ref(),
+        deadline,
+        &cancel,
+    )?;
+    let (audio, direct) = with_member(scene, &controller, |member| {
+        validate_members(member, &change)?;
+        if let Some(selection) = &change.selection {
+            selection.validate_scope(
+                scene.ok_or(StreamControlError::NotReady)?,
+                &controller,
+                expected,
+            )?;
+        }
+        let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        let lease = control_read(controller.policy.as_ref(), &scope, control.as_ref())?;
+        StreamController::check(&scope, lease.authority())?;
+        if state.closed {
+            return Err(StreamControlError::Cancelled);
+        }
+        state
+            .model
+            .check_routing(&lease.authority().current(), expected)?;
+        let _selection_receive = if let Some(selection) = &change.selection {
+            let (members, _) = member.ok_or(StreamControlError::NotReady)?;
+            selection.receive(members, &controller, &scope, control.as_ref())?
+        } else {
+            Vec::new()
+        };
+        let audio = change
+            .audio
+            .as_ref()
+            .map(|change| {
+                let (members, target) = member.ok_or(StreamControlError::NotReady)?;
+                AudioPlan::prepare(
+                    scene.ok_or(StreamControlError::NotReady)?,
+                    members,
+                    target,
+                    &state,
+                    &scope,
+                    lease.authority(),
+                    change,
+                    control.as_ref(),
+                    None,
+                )
+            })
+            .transpose()?;
+        let direct = change
+            .direct
+            .as_ref()
+            .map(|change| controller.prepare_direct(&state, &scope, change, control.as_ref(), None))
+            .transpose()?;
+        invocation(
+            &controller,
+            &credential,
+            control.as_ref(),
+            deadline,
+            &cancel,
+        )?;
+        Ok((audio, direct))
+    })?;
+    let tickets = audio
+        .as_ref()
+        .map_or_else(Vec::new, |p| p.tickets())
+        .into_iter()
+        .chain(direct.as_ref().map_or_else(Vec::new, |p| p.tickets()))
+        .collect::<Vec<_>>();
+    let mut tokens = vec![
+        cancel.clone(),
+        controller.shutdown.clone(),
+        controller.direct_subscriptions.cancel.clone(),
+    ];
+    if let Some(control) = &control {
+        tokens.push(control.cancellation.clone());
+    }
+    if let Some(audio) = &audio {
+        tokens.push(audio.cancellation());
+    }
+    let mut drained = Vec::new();
+    for ticket in tickets {
+        drained.push(tokio::select! { biased;
+            _=audio_consumer::any_cancelled(tokens.clone())=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        });
+    }
+    with_member(scene, &controller, |member| {
+        validate_members(member, &change)?;
+        let mut state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        let lease = control_read(controller.policy.as_ref(), &scope, control.as_ref())?;
+        StreamController::check(&scope, lease.authority())?;
+        if state.closed {
+            return Err(StreamControlError::Cancelled);
+        }
+        let _audio_receive = if let Some(audio) = &audio {
+            let (members, target) = member.ok_or(StreamControlError::NotReady)?;
+            audio.validate(
+                scene.ok_or(StreamControlError::NotReady)?,
+                members,
+                target,
+                &state,
+                &scope,
+                lease.authority(),
+                control.as_ref(),
+                None,
+            )?
+        } else {
+            Vec::new()
+        };
+        let _direct_receive = direct
+            .as_ref()
+            .map(|p| p.validate(&controller, &state, &scope, control.as_ref(), None))
+            .transpose()?;
+        // Both programs remain locked through the one model revision commit.
+        // No new media admission can see one half of a mixed change.
+        let _selection_receive = if let Some(selection) = &change.selection {
+            let (members, _) = member.ok_or(StreamControlError::NotReady)?;
+            selection.receive(members, &controller, &scope, control.as_ref())?
+        } else {
+            Vec::new()
+        };
+        let mut selection_commit = change
+            .selection
+            .as_ref()
+            .map(|p| {
+                p.lock(
+                    scene.ok_or(StreamControlError::NotReady)?,
+                    &controller,
+                    expected,
+                )
+            })
+            .transpose()?;
+        let mut audio_commit = audio.as_ref().map(|p| p.lock()).transpose()?;
+        let mut direct_commit = direct.as_ref().map(|p| p.lock(&controller)).transpose()?;
+        invocation(
+            &controller,
+            &credential,
+            control.as_ref(),
+            deadline,
+            &cancel,
+        )?;
+        let changed = change.selection.as_ref().is_some_and(|p| p.changed())
+            || audio.as_ref().is_some_and(|p| p.changed())
+            || direct.as_ref().is_some_and(|p| p.changed());
+        let revision =
+            state
+                .model
+                .commit_routing(&lease.authority().current(), expected, changed)?;
+        if let (Some(plan), Some(commit)) = (&audio, audio_commit.as_mut()) {
+            commit.commit(plan);
+        }
+        if let (Some(plan), Some(commit)) = (&direct, direct_commit.as_mut()) {
+            commit.commit(plan);
+        }
+        if let Some(commit) = selection_commit.as_mut() {
+            commit.commit();
+        }
+        if let Some(scene) = scene {
+            scene.selection_changed.notify_waiters();
+        }
+        Ok(revision)
+    })
+}
+
+/// Staged alongside the real media candidate. Owns no publication permission;
+/// validation uses that candidate's actual held operation at prepare and commit.
+pub(super) struct PreparedRoutes {
+    scene: Arc<GuardedMediaScene>,
+    change: MediaSubscriptionChange,
+    audio: Option<AudioPlan>,
+    direct: Option<direct_subscriptions::DirectPlan>,
+    drained: Vec<rvoip_core_traits::peer_switch::PeerQuiescenceGuard>,
+}
+impl PreparedRoutes {
+    pub(super) fn prepare(
+        scene: Arc<GuardedMediaScene>,
+        controller: &Arc<StreamController>,
+        change: &MediaSubscriptionChange,
+        credential: &CredentialSnapshot,
+        control: Option<&MediaControl>,
+        bindings: &[ReadyMediaBinding],
+    ) -> ControlResult<Self> {
+        if change.audio.is_none() && change.direct.is_none() && change.selection.is_none() {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        if let Some(audio) = &change.audio {
+            audio_subscriptions::validate(audio)?;
+        }
+        if let Some(direct) = &change.direct {
+            direct_subscriptions::validate(direct)?;
+        }
+        let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+        let (audio, direct) = with_member(Some(&scene), controller, |member| {
+            validate_members(member, change)?;
+            let (members, target) = member.ok_or(StreamControlError::NotReady)?;
+            let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+            let lease = control_read(controller.policy.as_ref(), &scope, control)?;
+            StreamController::check(&scope, lease.authority())?;
+            if state.closed {
+                return Err(StreamControlError::Cancelled);
+            }
+            let _selection_receive = if let Some(selection) = &change.selection {
+                selection.validate_scope(&scene, controller, state.model.revision())?;
+                selection.receive(members, controller, &scope, control)?
+            } else {
+                Vec::new()
+            };
+            let audio = change
+                .audio
+                .as_ref()
+                .map(|change| {
+                    AudioPlan::prepare(
+                        &scene,
+                        members,
+                        target,
+                        &state,
+                        &scope,
+                        lease.authority(),
+                        change,
+                        control,
+                        Some(bindings),
+                    )
+                })
+                .transpose()?;
+            let direct = change
+                .direct
+                .as_ref()
+                .map(|change| {
+                    controller.prepare_direct(&state, &scope, change, control, Some(bindings))
+                })
+                .transpose()?;
+            Ok((audio, direct))
+        })?;
+        Ok(Self {
+            scene,
+            change: change.clone(),
+            audio,
+            direct,
+            drained: Vec::new(),
+        })
+    }
+    pub(super) async fn quiesce(
+        &mut self,
+        controller: &StreamController,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        authority_cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        let tickets = self
+            .audio
+            .as_ref()
+            .map_or_else(Vec::new, |p| p.tickets())
+            .into_iter()
+            .chain(self.direct.as_ref().map_or_else(Vec::new, |p| p.tickets()));
+        let mut tokens = vec![
+            cancel,
+            authority_cancel,
+            controller.shutdown.clone(),
+            controller.direct_subscriptions.cancel.clone(),
+        ];
+        if let Some(audio) = &self.audio {
+            tokens.push(audio.cancellation());
+        }
+        for ticket in tickets {
+            self.drained.push(tokio::select!{biased;
+                _=audio_consumer::any_cancelled(tokens.clone())=>return Err(StreamControlError::Cancelled),
+                result=tokio::time::timeout_at(deadline,ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+            });
+        }
+        Ok(())
+    }
+    pub(super) fn scene(&self) -> &GuardedMediaScene {
+        &self.scene
+    }
+    pub(super) fn lock<'a>(
+        &'a self,
+        controller: &'a StreamController,
+        state: &State,
+        scope: &MediaScope<'_>,
+        owner: &MediaOwner,
+        control: Option<&MediaControl>,
+        member: Option<(&HashMap<ConnectionId, SceneMember>, &SceneMember)>,
+        bindings: &[ReadyMediaBinding],
+    ) -> ControlResult<RoutingCommit<'a>> {
+        validate_members(member, &self.change)?;
+        let (members, target) = member.ok_or(StreamControlError::NotReady)?;
+        let mut receive = if let Some(audio) = &self.audio {
+            audio.validate(
+                &self.scene,
+                members,
+                target,
+                state,
+                scope,
+                owner,
+                control,
+                Some(bindings),
+            )?
+        } else {
+            Vec::new()
+        };
+        if let Some(direct) = &self.direct {
+            receive.extend(direct.validate(controller, state, scope, control, Some(bindings))?);
+        }
+        if let Some(selection) = &self.change.selection {
+            receive.extend(selection.receive(members, controller, scope, control)?);
+        }
+        let target = target.controller.clone();
+        let selection = self
+            .change
+            .selection
+            .as_ref()
+            .map(|p| p.lock(&self.scene, &target, state.model.revision()))
+            .transpose()?;
+        let audio = self.audio.as_ref().map(|p| p.lock()).transpose()?;
+        let direct = self
+            .direct
+            .as_ref()
+            .map(|p| p.lock(controller))
+            .transpose()?;
+        Ok(RoutingCommit {
+            selection,
+            audio,
+            direct,
+            _receive: receive,
+        })
+    }
+}
+pub(super) struct RoutingCommit<'a> {
+    selection: Option<super::selection_intent::SelectionCommit<'a>>,
+    audio: Option<audio_subscriptions::AudioCommit<'a>>,
+    direct: Option<direct_subscriptions::DirectCommit<'a>>,
+    _receive: Vec<ControlRead>,
+}
+impl RoutingCommit<'_> {
+    pub(super) fn commit(&mut self, routes: &PreparedRoutes) {
+        if let (Some(plan), Some(commit)) = (&routes.audio, self.audio.as_mut()) {
+            commit.commit(plan);
+        }
+        if let (Some(plan), Some(commit)) = (&routes.direct, self.direct.as_mut()) {
+            commit.commit(plan);
+        }
+        if let Some(commit) = self.selection.as_mut() {
+            commit.commit();
+        }
+        routes.scene.selection_changed.notify_waiters();
+    }
+}
