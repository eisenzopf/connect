+//! Signed public subscription selectors over an admitted native media scene.
+use super::{native_negotiation::*, payloads::*, Envelope, Scope};
+use rvoip_core::{ids::*, staged_streams::subscription_plan::*, stream_lifecycle::*};
+use std::collections::BTreeSet;
+#[derive(Clone)]
+pub struct NativeSubscriptionPlan {
+    pub(crate) selection: MediaSubscriptionPlan,
+    pub(crate) media: NativeOfferPlan,
+    pub(crate) resources: bool,
+}
+impl NativeSubscriptionPlan {
+    pub fn selection(&self) -> &MediaSubscriptionPlan {
+        &self.selection
+    }
+    pub fn media(&self) -> &NativeOfferPlan {
+        &self.media
+    }
+    pub fn changes_resources(&self) -> bool {
+        self.resources
+    }
+}
+#[derive(Clone)]
+pub struct NativeSubscriptionOutcome {
+    pub revision: u64,
+    pub resources_changed: bool,
+}
+pub(crate) fn parse(
+    e: &Envelope,
+    participant: &ParticipantId,
+) -> Result<MediaSelectionChange, NativeOfferError> {
+    if e.expected_revision().is_none()
+        || e.scope(Scope::Operation).is_none()
+        || e.scope(Scope::Reply).is_some()
+    {
+        return Err(NativeOfferError::Invalid);
+    }
+    let mut seen = BTreeSet::new();
+    match e.payload() {
+        Payload::StreamSubscribe(input) => {
+            if input
+                .by_participant
+                .as_ref()
+                .is_some_and(|id| id.as_str() != participant.as_str())
+            {
+                return Err(NativeOfferError::Authority);
+            }
+            if input.subscriptions.is_empty() || input.subscriptions.len() > 128 {
+                return Err(NativeOfferError::Invalid);
+            }
+            let mut selections = Vec::new();
+            for s in &input.subscriptions {
+                match (&s.strm_id, &s.from_participant, &s.kinds) {
+                    (Some(id), None, None) if seen.insert(format!("stream:{}", id.as_str())) => {
+                        selections.push(MediaSelection::Stream(StreamId::from_string(id.as_str())))
+                    }
+                    (None, Some(id), kinds)
+                        if seen.insert(format!("participant:{}", id.as_str())) =>
+                    {
+                        let mut media = BTreeSet::new();
+                        match kinds {
+                            None => {
+                                media.extend([
+                                    Medium::Audio,
+                                    Medium::Video,
+                                    Medium::Screen,
+                                    Medium::Data,
+                                ]);
+                            }
+                            Some(kinds) if !kinds.is_empty() && kinds.len() <= 4 => {
+                                for kind in kinds {
+                                    let medium = match kind.as_str() {
+                                        "audio" => Medium::Audio,
+                                        "video" => Medium::Video,
+                                        "screen" => Medium::Screen,
+                                        "data" => Medium::Data,
+                                        _ => return Err(NativeOfferError::Invalid),
+                                    };
+                                    if !media.insert(medium) {
+                                        return Err(NativeOfferError::Invalid);
+                                    }
+                                }
+                            }
+                            _ => return Err(NativeOfferError::Invalid),
+                        }
+                        selections.push(MediaSelection::Participant {
+                            participant: ParticipantId::from_string(id.as_str()),
+                            media,
+                        });
+                    }
+                    _ => return Err(NativeOfferError::Invalid),
+                }
+            }
+            Ok(MediaSelectionChange::Subscribe(selections))
+        }
+        Payload::StreamUnsubscribe(input) => {
+            if input.strm_ids.is_empty()
+                || input.strm_ids.len() > 128
+                || input
+                    .strm_ids
+                    .iter()
+                    .any(|id| !seen.insert(id.as_str().to_owned()))
+            {
+                return Err(NativeOfferError::Invalid);
+            }
+            Ok(MediaSelectionChange::Unsubscribe(
+                input
+                    .strm_ids
+                    .iter()
+                    .map(|id| StreamId::from_string(id.as_str()))
+                    .collect(),
+            ))
+        }
+        _ => Err(NativeOfferError::Unsupported),
+    }
+}
+pub(crate) fn core_error(
+    e: rvoip_core::orchestrator::participant_control::ParticipantControlError,
+) -> NativeOfferError {
+    use rvoip_core::orchestrator::participant_control::ParticipantControlError as E;
+    match e {
+        E::Media(e) => e.into(),
+        E::Unsupported => NativeOfferError::Unsupported,
+        E::Deadline => NativeOfferError::Deadline,
+        E::Cancelled => NativeOfferError::Cancelled,
+        _ => NativeOfferError::Authority,
+    }
+}
+
+pub struct NativeSubscriptionAuthority {
+    pub operation: String,
+    pub lease: super::auth_dispatch::AuthorityLease,
+}
+/// Installed by the host that owns current grants and its operation journal.
+/// Metadata and wake hints never replace this fresh authorization step.
+#[async_trait::async_trait]
+pub trait NativeSubscriptionPolicy: super::native_requests::NativeRequestPolicy {
+    async fn reconcile(
+        &self,
+        scope: &super::native_requests::NativeRequestScope,
+        plan: &NativeSubscriptionPlan,
+        pending_operation: Option<&str>,
+    ) -> Result<NativeSubscriptionAuthority, super::auth_dispatch::DispatchError>;
+    /// Record the exact local/uncertain outcome in the host's existing journal.
+    /// Reuse held authority; never reenter its domain behind a queued writer.
+    async fn observe(
+        &self,
+        scope: &super::native_requests::NativeRequestScope,
+        operation: &str,
+        result: &Result<NativeSubscriptionOutcome, NativeOfferError>,
+        held: Option<&super::auth_dispatch::AuthorityLease>,
+    ) -> Result<(), super::auth_dispatch::DispatchError>;
+    fn changes(&self) -> Option<std::sync::Arc<tokio::sync::Notify>> {
+        None
+    }
+}
+/// One actively authorized server reconciliation. It is not a client invocation
+/// and cannot be manufactured from stored command fields or a ready boolean.
+pub struct NativeSubscriptionInvocation {
+    pub(crate) origin: std::sync::Arc<super::native_requests::NativeRequestOrigin>,
+    scope: super::native_requests::NativeRequestScope,
+    plan: NativeSubscriptionPlan,
+    operation: String,
+    authority: super::auth_dispatch::AuthorityLease,
+    deadline: tokio::time::Instant,
+    cancel: tokio_util::sync::CancellationToken,
+    confirmation: std::sync::Mutex<
+        Option<std::sync::Arc<dyn super::auth_dispatch::lifecycle::NativeLifecycleFence>>,
+    >,
+}
+impl NativeSubscriptionInvocation {
+    pub(crate) fn new(
+        origin: std::sync::Arc<super::native_requests::NativeRequestOrigin>,
+        plan: NativeSubscriptionPlan,
+        operation: String,
+        authority: super::auth_dispatch::AuthorityLease,
+    ) -> std::sync::Arc<Self> {
+        let scope = origin.request_scope(plan.selection.expected_revision());
+        let deadline = authority
+            .deadline()
+            .unwrap_or(origin.deadline())
+            .min(origin.deadline())
+            .min(tokio::time::Instant::now() + std::time::Duration::from_secs(30));
+        let cancel = origin.cancellation().child_token();
+        std::sync::Arc::new(Self {
+            origin,
+            scope,
+            plan,
+            operation,
+            authority,
+            deadline,
+            cancel,
+            confirmation: std::sync::Mutex::new(None),
+        })
+    }
+    pub fn scope(&self) -> &super::native_requests::NativeRequestScope {
+        &self.scope
+    }
+    pub fn plan(&self) -> &NativeSubscriptionPlan {
+        &self.plan
+    }
+    pub fn operation(&self) -> &str {
+        &self.operation
+    }
+    pub fn deadline(&self) -> tokio::time::Instant {
+        self.deadline
+    }
+    pub fn cancellation(&self) -> tokio_util::sync::CancellationToken {
+        self.cancel.child_token()
+    }
+    pub fn current(&self) -> bool {
+        self.origin.current()
+            && self.authority.current()
+            && !self.cancel.is_cancelled()
+            && tokio::time::Instant::now() < self.deadline
+            && self
+                .confirmation
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .is_none_or(|proof| proof.current())
+    }
+    pub(crate) fn confirmed(
+        &self,
+        reply: &super::native_requests::NativeRequestReply,
+    ) -> Result<(), NativeOfferError> {
+        if !reply.current() || reply.scope().stream_revision != self.scope.stream_revision {
+            return Err(NativeOfferError::Cancelled);
+        }
+        *self.confirmation.lock().unwrap_or_else(|p| p.into_inner()) = Some(reply.commit_fence());
+        Ok(())
+    }
+    pub(crate) fn committed(&self) {
+        self.confirmation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take();
+    }
+    pub fn authority<T: std::any::Any + Send + Sync>(&self) -> Option<&T> {
+        self.current()
+            .then(|| self.authority.authority::<T>())
+            .flatten()
+    }
+    pub(crate) fn lease(&self) -> super::auth_dispatch::AuthorityLease {
+        self.authority.retained()
+    }
+}
+pub(crate) struct ReconcileRequestPolicy(pub std::sync::Arc<dyn NativeSubscriptionPolicy>);
+#[async_trait::async_trait]
+impl super::native_requests::NativeRequestPolicy for ReconcileRequestPolicy {
+    async fn authorize(
+        &self,
+        scope: &super::native_requests::NativeRequestScope,
+        proposal: &Envelope,
+        held: Option<&super::auth_dispatch::AuthorityLease>,
+    ) -> Result<super::auth_dispatch::AuthorityLease, super::auth_dispatch::DispatchError> {
+        self.0.authorize(scope, proposal, held).await
+    }
+}
