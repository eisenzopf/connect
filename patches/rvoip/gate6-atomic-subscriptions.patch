+    gate: Arc<SubscriptionGate>,
+    old: SubscriptionStamp,
+    next: Option<PeerRouteTicket>,
+    program: Program,
+    change: AudioSubscriptionChange,
+}
+impl AudioPlan {
+    pub(super) fn prepare(
+        scene: &GuardedMediaScene,
+        members: &std::collections::HashMap<ConnectionId, SceneMember>,
+        target: &SceneMember,
+        state: &State,
+        scope: &MediaScope<'_>,
+        owner: &MediaOwner,
+        change: &AudioSubscriptionChange,
+        control: Option<&MediaControl>,
+        prepared: Option<&[ReadyMediaBinding]>,
+    ) -> ControlResult<Self> {
+        let gate = target.audio_consumer.subscriptions.clone();
+        let mut program = gate
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .program
+            .clone();
+        match change {
+            AudioSubscriptionChange::Clear => program = Program::default(),
+            AudioSubscriptionChange::Unsubscribe(keys) => {
+                for key in keys {
+                    program.selections.retain(|selection| {
+                        selection.request != AudioSubscription::Stream(key.clone())
+                    });
+                    program.excluded.insert(key.clone());
+                }
+            }
+            AudioSubscriptionChange::Subscribe(selections) => {
+                for request in selections {
+                    let source = members
+                        .values()
+                        .find(|member| match request {
+                            AudioSubscription::Stream(key) => {
+                                member.controller.connection == key.connection
+                                    && member.current_logical().as_ref() == Some(&key.logical)
+                            }
+                            AudioSubscription::Participant(id) => {
+                                member.controller.origin_member.participant() == id
+                            }
+                        })
+                        .ok_or(StreamControlError::NotReady)?;
+                    let selection = Selection {
+                        request: request.clone(),
+                        origin: source.controller.origin_member.clone(),
+                        owner: source.controller.credential_snapshot().principal,
+                        publisher: Arc::downgrade(&source.controller),
+                    };
+                    program.selections.retain(|old| old.request != *request);
+                    program.selections.push(selection);
+                    match request {
+                        AudioSubscription::Stream(key) => {
+                            program.excluded.remove(key);
+                        }
+                        AudioSubscription::Participant(id) => {
+                            program.excluded.retain(|key| {
+                                members.get(&key.connection).is_none_or(|member| {
+                                    member.controller.origin_member.participant() != id
+                                })
+                            });
+                        }
+                    }
+                }
+            }
+        }
+        if program.selections.len() > 128 || program.excluded.len() > 4096 {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+
+        let _receive = scene.validate_program(
+            members,
+            target,
+            scope,
+            &program,
+            change,
+            control,
+            Some(state),
+            owner,
+            prepared,
+        )?;
+        let old = gate.stamp();
+        let changed = !gate
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .program
+            .same(&program);
+        let next = if changed {
+            Some(old.ticket.stage().ok_or(MediaTransitionError::Capacity)?)
+        } else {
+            None
+        };
+        Ok(Self {
+            gate,
+            old,
+            next,
+            program,
+            change: change.clone(),
+        })
+    }
+    pub(super) fn validate(
+        &self,
+        scene: &GuardedMediaScene,
+        members: &std::collections::HashMap<ConnectionId, SceneMember>,
+        target: &SceneMember,
+        state: &State,
+        scope: &MediaScope<'_>,
+        owner: &MediaOwner,
+        control: Option<&MediaControl>,
+        prepared: Option<&[ReadyMediaBinding]>,
+    ) -> ControlResult<Vec<ControlRead>> {
+        if !Arc::ptr_eq(&target.audio_consumer.subscriptions, &self.gate) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        scene.validate_program(
+            members,
+            target,
+            scope,
+            &self.program,
+            &self.change,
+            control,
+            Some(state),
+            owner,
+            prepared,
+        )
+    }
+    pub(super) fn tickets(&self) -> Vec<PeerRouteTicket> {
+        if self.next.is_some() {
+            vec![self.old.ticket.clone()]
+        } else {
+            vec![]
+        }
+    }
+    pub(super) fn cancellation(&self) -> CancellationToken {
+        self.gate.cancel.clone()
+    }
+    pub(super) fn changed(&self) -> bool {
+        self.next.is_some()
+    }
+    pub(super) fn lock(&self) -> ControlResult<AudioCommit<'_>> {
+        let state = self.gate.state.lock().unwrap_or_else(|p| p.into_inner());
+        if self.gate.cancel.is_cancelled() || !self.old.ticket.is_current() {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(AudioCommit(state))
+    }
+}
+pub(super) struct AudioCommit<'a>(std::sync::MutexGuard<'a, GateState>);
+impl AudioCommit<'_> {
+    pub(super) fn commit(&mut self, plan: &AudioPlan) {
+        if let Some(next) = &plan.next {
+            assert!(
+                next.commit_from(&plan.old.ticket),
+                "audio routing changed outside controller fence"
+            );
+            self.0.ticket = next.clone();
+            self.0.program = plan.program.clone();
+            self.0.started = Instant::now();
+        }
+    }
+}
