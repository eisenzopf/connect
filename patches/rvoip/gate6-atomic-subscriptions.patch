+#[tokio::test]
+async fn retained_participant_selector_does_not_follow_readmitted_epoch_or_another_scene() {
+    use crate::staged_streams::subscription_plan::MediaSelectionChange;
+    let mut s = Scene::new(&[Medium::Audio]).await;
+    apply(&s, planned(&s, &future_video(&s)).routing().clone())
+        .await
+        .unwrap();
+    let foreign = Scene::new(&[Medium::Audio]).await;
+    assert!(apply(
+        &foreign,
+        planned(&s, &MediaSelectionChange::Reconcile)
+            .routing()
+            .clone()
+    )
+    .await
+    .is_err());
+    s.scene.remove(&s.f.a.connection);
+    s.f.a.retire();
+    let mut next = owner("alice");
+    let identity = IdentityBinding::from_authenticated(
+        &principal("alice"),
+        IdentityId::from_string("alice"),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    next.member.remove(next.member.revision()).unwrap();
+    next.member
+        .readmit(&identity, next.member.revision())
+        .unwrap();
+    next.actor = next.member.clone();
+    next.presence =
+        SessionAppearance::admit(&next.member, SessionId::from_string("session"), None).unwrap();
+    next.connection = ConnectionBinding::prepare(
+        &next.member,
+        &next.presence,
+        &next.endpoint,
+        ConnectionId::from_string("alice"),
+    )
+    .unwrap();
+    next.connection
+        .observe_ready(&next.member, &next.presence, &next.endpoint, 1)
+        .unwrap();
+    next.connection
+        .activate(&next.member, &next.presence, &next.endpoint)
+        .unwrap();
+    s.f.policy
+        .0
+        .write()
+        .await
+        .owners
+        .insert("alice".into(), next);
+    s.f.a = StreamController::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        ConnectionId::from_string("alice"),
+        principal("alice"),
+        s.f.policy.clone(),
+        s.f.aa.clone(),
+        Arc::new(StreamHandleAllocator::default()),
+        16,
+    )
+    .unwrap();
+    s.f.a
+        .change(
+            0,
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+    let mut member = s.scene.prepare(s.f.a.clone()).unwrap();
+    member
+        .quiesce(deadline(), CancellationToken::new())
+        .await
+        .unwrap();
+    s.scene.insert(s.f.a.connection.clone(), member, true);
+    let old = planned(&s, &MediaSelectionChange::Reconcile);
+    assert!(old.future_media().is_empty());
+    assert_eq!(apply(&s, old.routing().clone()).await.unwrap(), 2);
+    // Fresh explicit intent can select the readmitted member, but the old pin
+    // cannot silently grant audience to the new epoch.
+    let current = planned(&s, &future_video(&s));
+    assert_eq!(current.future_media().len(), 2);
+    assert_eq!(apply(&s, current.routing().clone()).await.unwrap(), 3);
+    assert_eq!(s.f.b.active_bindings().len(), 1);
+}
