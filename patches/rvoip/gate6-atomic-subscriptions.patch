+use super::*;
+use rvoip_uctp::v2::native_subscriptions::*;
+struct Invocation {
+    a: Arc<AuthorizedEnvelope>,
+    domain: Arc<Grants>,
+    connection: ConnectionId,
+    plan: NativeSubscriptionPlan,
+}
+pub(super) fn receive(
+    state: &State,
+    owner: MediaOwner,
+    source: &MediaSource,
+) -> ControlResult<Box<MediaOwner>> {
+    let mut publisher = state
+        .owners
+        .get(&source.connection)
+        .ok_or(StreamControlError::Authority)?
+        .clone();
+    if let Some(activation) = state.activations.lock().unwrap().get(&source.connection) {
+        publisher = activation.current(publisher)?;
+    }
+    publisher
+        .connection
+        .require_current(&publisher.member, &publisher.presence)
+        .map_err(|_| StreamControlError::Authority)?;
+    if state.denied
+        || !owner.may_route_source
+        || source.conversation != *publisher.member.conversation()
+        || source.session != *publisher.presence.session()
+        || source.participant != *publisher.member.participant()
+        || source.membership_epoch != publisher.member.epoch()
+        || source.connection_generation != publisher.connection.generation()
+        || owner.member.conversation() != publisher.member.conversation()
+        || owner.presence.session() != publisher.presence.session()
+    {
+        return Err(StreamControlError::Authority);
+    }
+    Ok(Box::new(owner))
+}
+pub(super) fn held(
+    domain: &Grants,
+    scope: &MediaScope<'_>,
+    intent: &MediaControlIntent<'_>,
+    held: &(dyn Any + Send + Sync),
+) -> Option<ControlResult<MediaControl>> {
+    let i = held.downcast_ref::<Invocation>()?;
+    Some((|| {
+        let proof =
+            i.a.authority::<Proof>()
+                .ok_or(StreamControlError::Authority)?;
+        let wire = proof
+            .base
+            .authority::<WireProof>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&domain.0, &i.domain.0)
+            || proof.guard.denied
+            || &i.connection != scope.connection
+            || i.a
+                .envelope()
+                .scope(Scope::Connection)
+                .and_then(|id| wire._guard.connections.get(id))
+                != Some(scope.connection)
+            || i.a.envelope().scope(Scope::Conversation) != Some("conversation")
+            || i.a.envelope().scope(Scope::Session) != Some("session")
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                i.a.principal(),
+                scope.principal,
+            )
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let plan = i.plan.selection();
+        let actual = plan.routing();
+        let matches = match intent {
+            MediaControlIntent::ChangeSubscriptions {
+                expected,
+                desired,
+                replace,
+                change,
+            } => {
+                i.plan.changes_resources()
+                    && *expected == plan.expected_revision()
+                    && replace.is_empty()
+                    && *change == actual
+                    && desired
+                        .iter()
+                        .eq(i.plan.media().selected().iter().map(|s| &s.requested))
+            }
+            MediaControlIntent::Subscriptions { expected, change } => {
+                !i.plan.changes_resources()
+                    && *expected == plan.expected_revision()
+                    && *change == actual
+            }
+            MediaControlIntent::AudioSubscriptions { expected, change } => {
+                !i.plan.changes_resources()
+                    && *expected == plan.expected_revision()
+                    && actual.direct.is_none()
+                    && actual.audio.as_ref() == Some(*change)
+            }
+            MediaControlIntent::DirectSubscriptions { expected, change } => {
+                !i.plan.changes_resources()
+                    && *expected == plan.expected_revision()
+                    && actual.audio.is_none()
+                    && actual.direct.as_ref() == Some(*change)
+            }
+            _ => false,
+        };
+        if !matches {
+            return Err(StreamControlError::Authority);
+        }
+        let mut owner = credential_owner(
+            proof
+                .guard
+                .owners
+                .get(scope.connection)
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            scope.principal,
+        )?;
+        owner.remote = i.plan.media().remote_capabilities().clone();
+        MediaControl::new(
+            Box::new(Lease {
+                owner,
+                _proof: i.a.clone(),
+                activation: proof
+                    .guard
+                    .activations
+                    .lock()
+                    .unwrap()
+                    .get(scope.connection)
+                    .cloned(),
+            }),
+            i.a.invocation_cancellation(),
+            deadline(),
+        )
+    })())
+}
+pub(super) async fn handle(
+    h: &OfferHandler,
+    a: Arc<AuthorizedEnvelope>,
+    id: &ConnectionId,
+) -> Result<HandlerReplies, DispatchError> {
+    let adapter = &h.native.adapters[&h.physical.transport()];
+    let plan = match adapter.plan_native_subscriptions(&h.native.core.orch, id, &a) {
+        Ok(plan) => plan,
+        Err(e) => {
+            h.record.controls.lock().unwrap().push(Err(e));
+            return refusal(h, &a, e, true);
+        }
+    };
+    let invocation = Arc::new(Invocation {
+        a: a.clone(),
+        domain: h.grants.clone(),
+        connection: id.clone(),
+        plan,
+    });
+    let outcome = match adapter
+        .subscribe_native_media(&h.native.core.orch, id, a.clone(), invocation, deadline())
+        .await
+    {
+        Ok(outcome) => outcome,
+        Err(e) => {
+            h.record.controls.lock().unwrap().push(Err(e));
+            return refusal(h, &a, e, false);
+        }
+    };
+    h.record.controls.lock().unwrap().push(Ok(outcome.revision));
+    let mut reply = envelope(
+        "ack",
+        json!({"details":{"local_subscription_commit":{"revision":outcome.revision,"resources_changed":outcome.resources_changed}}}),
+    );
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        reply[field] = a.envelope().original()[field].clone();
+    }
+    reply["in_reply_to"] = json!(a.envelope().id());
+    HandlerReplies::new(vec![Envelope::from_value(reply)?])
+}
+fn refusal(
+    h: &OfferHandler,
+    a: &AuthorizedEnvelope,
+    error: NativeOfferError,
+    planning: bool,
+) -> Result<HandlerReplies, DispatchError> {
+    let missing_future_policy = matches!(a.envelope().payload(),Payload::StreamSubscribe(p) if p.subscriptions.iter().any(|s|s.from_participant.is_some()))
+        && h.record.future_subscriptions.lock().unwrap().is_none();
+    let (code, category, reason) = match error {
+        NativeOfferError::NotReady if planning => (404, "protocol", "not-found"),
+        NativeOfferError::Unsupported if missing_future_policy => {
+            (501, "protocol", "not-implemented")
+        }
+        NativeOfferError::Unsupported => (488, "media", "incompatible-capabilities"),
+        NativeOfferError::Conflict => (409, "protocol", "conflict"),
+        NativeOfferError::Invalid => (400, "protocol", "invalid-selection"),
+        NativeOfferError::Authority
+        | NativeOfferError::Scope
+        | NativeOfferError::Dispatch(DispatchError::Authority | DispatchError::ScopeDenied) => {
+            (403, "auth", "forbidden")
+        }
+        NativeOfferError::Cancelled => (487, "transient", "request-cancelled"),
+        NativeOfferError::Deadline => (408, "transient", "timeout"),
+        NativeOfferError::Confirmation => (409, "media", "invalid-confirmation"),
+        _ => (503, "transient", "unavailable"),
+    };
+    let mut reply = envelope(
+        "error",
+        json!({"code":code,"category":category,"reason":reason}),
+    );
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        reply[field] = a.envelope().original()[field].clone();
+    }
+    reply["in_reply_to"] = json!(a.envelope().id());
+    HandlerReplies::new(vec![Envelope::from_value(reply)?])
+}
+async fn setup(kind: &str) -> (Scene, Wire, u16, u16) {
+    let mut s = Scene::new_bootstrap(kind).await;
+    let mut offer = lifecycle_offer(&s, 0, 0, "sendonly");
+    offer["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}));
+    offer["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"display","kind":"screen","direction":"sendonly","codec_preferences":["vp8"]}));
+    let (answer, callback) = s.prepared(offer).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let mut other = s.second_wire().await;
+    other
+        .send(s.f.sign(lifecycle_offer(&s, 1, 0, "recvonly")))
+        .await;
+    let answer_b = other.read().await;
+    assert_eq!(answer_b.kind(), "connection.answer");
+    let callback = other.read().await;
+    assert_eq!(callback.kind(), "connection.offer");
+    other.send(s.f.sign(s.confirmation(&callback))).await;
+    s.wait(2).await;
+    core_fixture::until(|| {
+        s.native
+            .core
+            .orch
+            .session(&s.native.core.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .connections
+            .len()
+            == 2
+    })
+    .await;
+    let streams = answer.original()["payload"]["substrate_setup"]["streams"]
+        .as_array()
+        .unwrap();
+    let handle = |id: &str| {
+        streams.iter().find(|s| s["strm_id"] == id).unwrap()["stream_local_id"]
+            .as_u64()
+            .unwrap() as u16
+    };
+    let ah = handle("first");
+    let vh = handle("camera");
+    (s, other, ah, vh)
+}
+pub(super) fn command(kind: &str, revision: u64, payload: Value) -> Value {
+    let mut v = envelope(kind, payload);
+    v["cid"] = json!("conversation");
+    v["sid"] = json!("session");
+    v["connid"] = json!("native_1");
+    v["operation_id"] = json!(format!("sub_{}", uuid::Uuid::new_v4().simple()));
+    v["expected_revision"] = json!(revision);
+    v
+}
+fn select(revision: u64) -> Value {
+    command(
+        "stream.subscribe",
+        revision,
+        json!({"by_participant":core_fixture::participant("alice").as_str(),"subscriptions":[{"strm_id":"first"},{"strm_id":"camera"}]}),
+    )
+}
+pub(super) fn stream_handle(callback: &Envelope, id: &str) -> u16 {
+    callback.original()["payload"]["substrate_setup"]["streams"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|s| s["strm_id"] == id)
+        .unwrap()["stream_local_id"]
+        .as_u64()
+        .unwrap() as u16
+}
+pub(super) fn video_sequence(id: u16, sequence: u16, timestamp: u32) -> Bytes {
+    let mut packet = vec![0x80, 0x80 | 96];
+    packet.extend_from_slice(&sequence.to_be_bytes());
+    packet.extend_from_slice(&timestamp.to_be_bytes());
+    packet.extend_from_slice(&7u32.to_be_bytes());
+    packet.extend_from_slice(&[0x10, 1, 2, 3]);
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {
+        flags: 0,
+        stream_local_id: id,
+        seq: u32::from(sequence),
+        rtp: observe_rtp(packet.into()).unwrap(),
+    })
+    .unwrap()
+}
