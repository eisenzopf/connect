+            "stream.subscribe",
+            before,
+            json!({"subscriptions":[{"strm_id":"camera"},{"strm_id":"camera"}]}),
+        ),
+        command(
+            "stream.subscribe",
+            before,
+            json!({"subscriptions":[{"from_participant":core_fixture::participant("alice").as_str()}]}),
+        ),
+    ];
+    let mut foreign = select(before);
+    foreign["cid"] = json!("foreign");
+    cases.push(foreign);
+    let mut physical = select(before);
+    physical["connid"] = json!("native_0");
+    cases.push(physical);
+    for (request, code) in cases.into_iter().zip([409, 404, 403, 400, 501, 403, 403]) {
+        other.send(s.f.sign(request)).await;
+        let refused = other.read().await;
+        assert_eq!(refused.kind(), "error");
+        s.f.verify_server(&refused).await;
+        assert_eq!(refused.original()["payload"]["code"], code);
+        assert_eq!(before, receiver.revision());
+        assert_eq!(budget, receiver.stream_open_budget());
+    }
+    s.grants.0.write().await.denied = true;
+    other.send(s.f.sign(select(before))).await;
+    assert_eq!(other.read().await.kind(), "error");
+    s.grants.0.write().await.denied = false;
+    assert_eq!(before, receiver.revision());
+    assert_eq!(budget, receiver.stream_open_budget());
+    // A second real publishing binding with the same public ID makes the
+    // source ambiguous. The receiver must never pick an arbitrary publisher.
+    let mut collision = lifecycle_offer(&s, 1, receiver.revision(), "recvonly");
+    collision["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}));
+    other.send(s.f.sign(collision)).await;
+    assert_eq!(other.read().await.kind(), "connection.answer");
+    let callback = other.read().await;
+    assert_eq!(callback.kind(), "connection.offer");
+    other.send(s.f.sign(s.confirmation(&callback))).await;
+    s.wait(3).await;
+    let revision = receiver.revision();
+    let budget = receiver.stream_open_budget();
+    other.send(s.f.sign(select(revision))).await;
+    assert_eq!(other.read().await.kind(), "error");
+    assert_eq!(revision, receiver.revision());
+    assert_eq!(budget, receiver.stream_open_budget());
+    s.wire.server.shutdown().await.unwrap();
+    other.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_public_subscription_confirmation_and_atomic_commit_use_held_grant_under_queued_writer(
+) {
+    let (s, mut other, _, _) = setup("quic").await;
+    let receiver = s.native.adapters[&s.kind]
+        .media_controller(&s.second_id)
+        .unwrap();
+    let before = receiver.revision();
+    other.send(s.f.sign(select(before))).await;
+    let callback = other.read().await;
+    assert_eq!(callback.kind(), "connection.offer");
+    let writer = tokio::spawn({
+        let domain = s.grants.0.clone();
+        async move {
+            domain.write().await.denied = true;
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    assert!(!writer.is_finished());
+    other.send(s.f.sign(s.confirmation(&callback))).await;
+    assert_eq!(other.read().await.kind(), "ack");
+    assert_eq!(receiver.revision(), before + 1);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    s.wire.server.shutdown().await.unwrap();
+    other.server.shutdown().await.unwrap();
+}
