+//! Retained Participant intent reconciled through fresh authority and physical IO.
+use super::*;
+use rvoip_uctp::v2::native_subscriptions::*;
+struct FreshProof {
+    domain: Arc<Grants>,
+    wire_domain: Arc<WirePolicy>,
+    guard: OwnedRwLockReadGuard<State>,
+    wire: OwnedRwLockReadGuard<WireGrants>,
+    principal: AuthenticatedPrincipal,
+    plan: NativeSubscriptionPlan,
+    operation: String,
+    proposal: Mutex<Option<Envelope>>,
+}
+pub(super) struct Policy {
+    domain: Arc<Grants>,
+    wire: Arc<WirePolicy>,
+    changed: Arc<tokio::sync::Notify>,
+    operations: Mutex<Vec<(String, Result<u64, NativeOfferError>)>>,
+    fail_observation: AtomicBool,
+    failed_observations: AtomicUsize,
+    attempts: AtomicUsize,
+    reads: AtomicUsize,
+    held: AtomicUsize,
+}
+impl Policy {
+    fn new(s: &Scene) -> Arc<Self> {
+        Arc::new(Self {
+            domain: s.grants.clone(),
+            wire: s.wire_policy.clone(),
+            changed: Arc::new(tokio::sync::Notify::new()),
+            operations: Mutex::new(Vec::new()),
+            fail_observation: AtomicBool::new(false),
+            failed_observations: AtomicUsize::new(0),
+            attempts: AtomicUsize::new(0),
+            reads: AtomicUsize::new(0),
+            held: AtomicUsize::new(0),
+        })
+    }
+}
+fn validate(p: &FreshProof, scope: &NativeRequestScope) -> Result<(), DispatchError> {
+    let origin = &scope.origin;
+    let id = &origin.media.connection;
+    let owner = credential_owner(
+        p.guard
+            .owners
+            .get(id)
+            .ok_or(DispatchError::Authority)?
+            .clone(),
+        &origin.principal,
+    )
+    .map_err(|_| DispatchError::Authority)?;
+    if p.guard.denied
+        || p.guard.event_denied.contains(id)
+        || p.wire.denied
+        || p.guard.key.revoked
+        || !owner.may_control
+        || p.wire.connections.get(&origin.media.wire_connection) != Some(id)
+        || p.guard.wires.get(&origin.media.wire_connection) != Some(id)
+        || owner.member.conversation() != &scope.conversation
+        || owner.presence.session() != &origin.media.session
+        || owner.member.participant() != &origin.participant
+        || owner.member.epoch() != origin.membership_epoch
+        || owner.member.identity() != &origin.identity
+        || owner.member.identity() != p.wire.member.identity()
+        || owner.endpoint.device() != &origin.device
+        || owner.endpoint.endpoint() != &origin.endpoint
+        || owner.endpoint.state() != EndpointState::Verified
+        || owner.connection.generation() != scope.connection_generation
+        || origin.media.owner != origin.principal.ownership_key()
+        || scope.stream_revision != p.plan.selection().expected_revision()
+    {
+        return Err(DispatchError::Authority);
+    }
+    owner
+        .connection
+        .require_current(&owner.member, &owner.presence)
+        .map_err(|_| DispatchError::Authority)?;
+    Ok(())
+}
+#[async_trait]
+impl NativeSubscriptionPolicy for Policy {
+    async fn reconcile(
+        &self,
+        scope: &NativeRequestScope,
+        plan: &NativeSubscriptionPlan,
+        pending: Option<&str>,
+    ) -> Result<NativeSubscriptionAuthority, DispatchError> {
+        self.attempts.fetch_add(1, Ordering::AcqRel);
+        let wire = self.wire.grants.clone().read_owned().await;
+        let guard = self.domain.0.clone().read_owned().await;
+        let operation = pending
+            .map(str::to_owned)
+            .unwrap_or_else(|| format!("future_{}", uuid::Uuid::new_v4().simple()));
+        let p = FreshProof {
+            domain: self.domain.clone(),
+            wire_domain: self.wire.clone(),
+            guard,
+            wire,
+            principal: scope.origin.principal.clone(),
+            plan: plan.clone(),
+            operation: operation.clone(),
+            proposal: Mutex::new(None),
+        };
+        validate(&p, scope)?;
+        self.reads.fetch_add(1, Ordering::AcqRel);
+        Ok(NativeSubscriptionAuthority {
+            operation,
+            lease: AuthorityLease::holding(p),
+        })
+    }
+    async fn observe(
+        &self,
+        scope: &NativeRequestScope,
+        operation: &str,
+        result: &Result<NativeSubscriptionOutcome, NativeOfferError>,
+        held: Option<&AuthorityLease>,
+    ) -> Result<(), DispatchError> {
+        let lease = held.ok_or(DispatchError::Authority)?;
+        let p = lease
+            .authority::<FreshProof>()
+            .ok_or(DispatchError::Authority)?;
+        validate(p, scope)?;
+        if !lease.current() || operation != p.operation {
+            return Err(DispatchError::Authority);
+        }
+        if result.as_ref().is_ok_and(|o| o.resources_changed)
+            && self.fail_observation.swap(false, Ordering::AcqRel)
+        {
+            self.failed_observations.fetch_add(1, Ordering::AcqRel);
+            return Err(DispatchError::SubmissionUnknown);
+        }
+        self.operations.lock().unwrap().push((
+            operation.into(),
+            result.as_ref().map(|o| o.revision).map_err(Clone::clone),
+        ));
+        Ok(())
+    }
+    fn changes(&self) -> Option<Arc<tokio::sync::Notify>> {
+        Some(self.changed.clone())
+    }
+}
+#[async_trait]
+impl NativeRequestPolicy for Policy {
+    async fn authorize(
+        &self,
+        scope: &NativeRequestScope,
+        proposal: &Envelope,
+        held: Option<&AuthorityLease>,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let held = held.ok_or(DispatchError::Authority)?;
+        let p = held
+            .authority::<FreshProof>()
+            .ok_or(DispatchError::Authority)?;
+        validate(p, scope)?;
+        if !held.current()
+            || !Arc::ptr_eq(&self.domain, &p.domain)
+            || !Arc::ptr_eq(&self.wire, &p.wire_domain)
+            || proposal.kind() != "connection.offer"
+            || proposal.expected_revision() != Some(scope.stream_revision)
+            || proposal.scope(Scope::Operation) != Some(p.operation.as_str())
+            || proposal.scope(Scope::Conversation) != Some("conversation")
+            || proposal.scope(Scope::Session) != Some("session")
+            || proposal.scope(Scope::Connection)
+                != Some(scope.origin.media.wire_connection.as_str())
+        {
+            return Err(DispatchError::Authority);
+        }
+        let mut recorded = p.proposal.lock().unwrap();
+        if recorded
+            .as_ref()
+            .is_some_and(|old| !server_requests::matches_proposal(old, proposal))
+        {
+            return Err(DispatchError::Authority);
+        }
+        *recorded = Some(proposal.clone());
+        self.held.fetch_add(1, Ordering::AcqRel);
+        Ok(held.retained())
+    }
+}
+pub(super) fn reply(
+    c: &ValidatedBearer,
+    request: &Envelope,
+    response: &Envelope,
+    held: &AuthorityLease,
+) -> Option<Result<ExchangeReplyAuthority, DispatchError>> {
+    let p = held.authority::<FreshProof>()?;
+    Some((|| {
+        if !held.current()
+            || p.guard.denied
+            || p.wire.denied
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &c.principal,
+                &p.principal,
+            )
+            || !p
+                .proposal
+                .lock()
+                .unwrap()
+                .as_ref()
+                .is_some_and(|v| server_requests::matches_proposal(v, request))
+            || response.scope(Scope::Reply) != Some(request.id())
+            || [
+                Scope::Conversation,
+                Scope::Session,
+                Scope::Connection,
+                Scope::Operation,
+            ]
+            .into_iter()
+            .any(|s| request.scope(s) != response.scope(s))
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        let key = PrincipalVerificationKey::from_current(
+            &c.principal,
+            "client".into(),
+            p.guard.key.clone(),
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        Ok(ExchangeReplyAuthority {
+            lease: held.retained(),
+            key,
+        })
+    })())
+}
+struct Held {
+    inv: Arc<NativeSubscriptionInvocation>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for Held {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        if !self.inv.current() {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(Box::new(self.owner.clone()))
+    }
+    fn control_receive(&self, source: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        let p = self
+            .inv
+            .authority::<FreshProof>()
+            .ok_or(StreamControlError::Authority)?;
+        subscriptions::receive(&p.guard, *self.control_owner()?, source)
+    }
+    fn control_participant_receive(
+        &self,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<MediaOwner>> {
+        let p = self
+            .inv
+            .authority::<FreshProof>()
+            .ok_or(StreamControlError::Authority)?;
+        participant_receive(&p.guard, *self.control_owner()?, source)
+    }
+}
+pub(super) fn participant_receive(
+    state: &State,
+    receiver: MediaOwner,
+    source: &MediaParticipantSource,
+) -> ControlResult<Box<MediaOwner>> {
+    let mut publisher = credential_owner(
+        state
+            .owners
+            .get(&source.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone(),
+        &source.principal,
+    )?;
+    if let Some(a) = state.activations.lock().unwrap().get(&source.connection) {
+        publisher = a.current(publisher)?;
+    }
+    publisher
+        .connection
+        .require_current(&publisher.member, &publisher.presence)
+        .map_err(|_| StreamControlError::Authority)?;
+    if state.denied
+        || !receiver.may_route_source
+        || !receiver.send_media.contains(&source.medium)
+        || source.conversation != *publisher.member.conversation()
+        || source.session != *publisher.presence.session()
+        || source.participant != *publisher.member.participant()
+        || source.membership_epoch != publisher.member.epoch()
+        || source.identity != *publisher.member.identity()
+        || receiver.member.conversation() != publisher.member.conversation()
+        || receiver.presence.session() != publisher.presence.session()
+    {
+        return Err(StreamControlError::Authority);
+    }
+    Ok(Box::new(receiver))
+}
+pub(super) fn held(
+    domain: &Grants,
+    scope: &MediaScope<'_>,
+    intent: &MediaControlIntent<'_>,
+    held: &(dyn Any + Send + Sync),
+) -> Option<ControlResult<MediaControl>> {
+    let inv = held.downcast_ref::<Arc<NativeSubscriptionInvocation>>()?;
+    Some((|| {
+        let p = inv
+            .authority::<FreshProof>()
+            .ok_or(StreamControlError::Authority)?;
+        validate(p, inv.scope()).map_err(|_| StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&domain.0, &p.domain.0)
+            || scope.connection != &inv.scope().origin.media.connection
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                scope.principal,
+                &inv.scope().origin.principal,
+            )
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let plan = inv.plan();
+        let selection = plan.selection();
+        let matches = match intent {
+            MediaControlIntent::ChangeSubscriptions {
+                expected,
+                desired,
+                replace,
+                change,
+            } => {
+                plan.changes_resources()
+                    && *expected == selection.expected_revision()
+                    && replace.is_empty()
+                    && *change == selection.routing()
+                    && desired
+                        .iter()
+                        .eq(plan.media().selected().iter().map(|s| &s.requested))
+            }
+            MediaControlIntent::Subscriptions { expected, change } => {
+                !plan.changes_resources()
+                    && *expected == selection.expected_revision()
+                    && *change == selection.routing()
+            }
+            _ => false,
+        };
+        if !matches {
+            return Err(StreamControlError::Authority);
+        }
+        let mut o = credential_owner(
+            p.guard
+                .owners
+                .get(scope.connection)
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            scope.principal,
+        )?;
+        if let Some(a) = p.guard.activations.lock().unwrap().get(scope.connection) {
+            o = a.current(o)?;
+        }
+        o.remote = plan.media().remote_capabilities().clone();
+        MediaControl::new(
+            Box::new(Held {
+                inv: inv.clone(),
+                owner: o,
+            }),
+            inv.cancellation(),
+            inv.deadline(),
+        )
+    })())
+}
+async fn setup(kind: &str) -> (Scene, Wire, Arc<Policy>) {
+    setup_profile(kind, false).await
+}
+async fn setup_profile(kind: &str, data: bool) -> (Scene, Wire, Arc<Policy>) {
+    let mut s = Scene::new_mode(kind, data, true).await;
+    let policy = Policy::new(&s);
+    *s.record.future_subscriptions.lock().unwrap() = Some(policy.clone());
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let mut other = s.second_wire().await;
+    other
+        .send(s.f.sign(lifecycle_offer(&s, 1, 0, "recvonly")))
+        .await;
+    assert_eq!(other.read().await.kind(), "connection.answer");
+    let callback = other.read().await;
+    other.send(s.f.sign(s.confirmation(&callback))).await;
+    s.wait(2).await;
+    core_fixture::until(|| {
+        s.native
+            .core
+            .orch
+            .session(&s.native.core.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .connections
+            .len()
+            == 2
+    })
+    .await;
+    (s, other, policy)
+}
+fn select(revision: u64) -> Value {
+    subscriptions::command(
+        "stream.subscribe",
+        revision,
+        json!({"subscriptions":[{"from_participant":core_fixture::participant("alice").as_str(),"kinds":["video","screen"]}]}),
+    )
+}
+fn add_video(s: &Scene, revision: u64, screen: bool) -> Value {
+    let mut offer = lifecycle_offer(s, 0, revision, "sendonly");
+    let streams = offer["payload"]["streams_offered"].as_array_mut().unwrap();
+    streams.push(json!({"id":"future_camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}));
+    if screen {
+        streams.push(json!({"id":"future_display","kind":"screen","direction":"sendonly","codec_preferences":["vp8"]}));
+    }
+    offer
+}
+#[tokio::test]
+async fn actual_future_participant_video_and_screen_reconcile_after_original_command_grant_releases(
+) {
+    for kind in ["quic", "wt"] {
+        let (mut s, mut other, policy) = setup(kind).await;
+        let receiver = s.native.adapters[&s.kind]
+            .media_controller(&s.second_id)
+            .unwrap();
+        other.send(s.f.sign(select(receiver.revision()))).await;
+        let ack = other.read().await;
+        assert_eq!(ack.kind(), "ack");
+        s.f.verify_server(&ack).await;
+        assert_eq!(receiver.revision(), 2);
+        assert_eq!(receiver.active_bindings().len(), 1);
+        // Writers can acquire after the signed command has returned, while
+        // retained intent is idle. No original authorization reader is cached.
+        drop(
+            tokio::time::timeout(Duration::from_secs(1), s.grants.0.write())
+                .await
+                .unwrap(),
+        );
+        policy.fail_observation.store(true, Ordering::Release);
+        let (_, source_callback) = s.prepared(add_video(&s, 1, false)).await;
+        let source_video = subscriptions::stream_handle(&source_callback, "future_camera");
+        s.confirm(&source_callback).await;
+        s.wait(3).await;
+        let callback = other.read().await;
+        assert_eq!(callback.kind(), "connection.offer");
+        s.f.verify_server(&callback).await;
+        assert_eq!(receiver.revision(), 2);
+        assert_eq!(receiver.active_bindings().len(), 1);
+        let target_video = subscriptions::stream_handle(&callback, "future_camera");
+        other.send(s.f.sign(s.confirmation(&callback))).await;
+        core_fixture::until(|| receiver.revision() == 3).await;
+        send(&s.wire, subscriptions::video_sequence(source_video, 1, 501));
+        let video = received(&other).await;
+        assert_eq!(video.stream_local_id, target_video);
+        assert_eq!(video.rtp.packet().header.timestamp, 501);
+        core_fixture::until(|| {
+            policy
+                .operations
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|(_, v)| matches!(v, Ok(3)))
+        })
+        .await;
+        assert!(policy.held.load(Ordering::Acquire) > 0);
+        assert_eq!(policy.failed_observations.load(Ordering::Acquire), 1);
+        let (_, source_callback) = s.prepared(add_video(&s, 2, true)).await;
+        let source_screen = subscriptions::stream_handle(&source_callback, "future_display");
+        s.confirm(&source_callback).await;
+        s.wait(4).await;
+        let callback = other.read().await;
+        assert_eq!(callback.kind(), "connection.offer");
+        let target_screen = subscriptions::stream_handle(&callback, "future_display");
+        other.send(s.f.sign(s.confirmation(&callback))).await;
+        core_fixture::until(|| receiver.revision() == 4).await;
+        send(&s.wire, subscriptions::video_sequence(source_video, 2, 502));
+        send(
+            &s.wire,
+            subscriptions::video_sequence(source_screen, 1, 503),
+        );
+        let mut seen = Vec::new();
+        for _ in 0..2 {
+            let frame = received(&other).await;
+            seen.push((frame.stream_local_id, frame.rtp.packet().header.timestamp));
+        }
+        assert!(seen.contains(&(target_video, 502)));
+        assert!(seen.contains(&(target_screen, 503)));
+        assert_eq!(receiver.active_bindings().len(), 3);
+        // End a publishing stream without disturbing the existing camera.
+        let (_, ended) = s.prepared(add_video(&s, 3, false)).await;
+        s.confirm(&ended).await;
+        s.wait(5).await;
+        send(&s.wire, subscriptions::video_sequence(source_video, 3, 504));
+        send(
+            &s.wire,
+            subscriptions::video_sequence(source_screen, 2, 505),
+        );
+        let frame = received(&other).await;
+        assert_eq!(
+            (frame.stream_local_id, frame.rtp.packet().header.timestamp),
+            (target_video, 504)
+        );
+        assert!(
+            tokio::time::timeout(Duration::from_millis(75), received(&other))
+                .await
+                .is_err()
+        );
+        // A later distinct logical screen still joins the retained selector;
+        // the ended source and retained unused receiver cannot block it.
+        let mut later = add_video(&s, 4, true);
+        later["payload"]["streams_offered"][2]["id"] = json!("future_display_2");
+        let (_, new_source) = s.prepared(later).await;
+        let source_screen_2 = subscriptions::stream_handle(&new_source, "future_display_2");
+        s.confirm(&new_source).await;
+        s.wait(6).await;
+        let callback = other.read().await;
+        assert_eq!(callback.kind(), "connection.offer");
+        let screen_2 = subscriptions::stream_handle(&callback, "future_display_2");
+        other.send(s.f.sign(s.confirmation(&callback))).await;
+        core_fixture::until(|| receiver.revision() == 5).await;
+        send(
+            &s.wire,
