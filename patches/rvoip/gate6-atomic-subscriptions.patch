+pub(super) struct DirectPlan {
+    program: BTreeMap<StreamId, DirectSubscription>,
+    old: BTreeMap<StreamId, Arc<Route>>,
+    changed: BTreeSet<StreamId>,
+    staged: BTreeMap<StreamId, PeerRouteTicket>,
+    change: DirectSubscriptionChange,
+}
+impl StreamController {
+    pub(super) fn prepare_direct(
+        &self,
+        state: &State,
+        scope: &MediaScope<'_>,
+        change: &DirectSubscriptionChange,
+        control: Option<&MediaControl>,
+        prepared: Option<&[ReadyMediaBinding]>,
+    ) -> ControlResult<DirectPlan> {
+        let routing = self
+            .direct_subscriptions
+            .routing
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let old = routing.program.clone();
+        let mut program = old
+            .iter()
+            .map(|(id, r)| (id.clone(), r.selection.clone()))
+            .collect::<BTreeMap<_, _>>();
+        drop(routing);
+        match change {
+            DirectSubscriptionChange::Subscribe(items) => {
+                for selection in items {
+                    program.insert(selection.receiver.clone(), selection.clone());
+                }
+            }
+            DirectSubscriptionChange::Unsubscribe(items) => {
+                for id in items {
+                    program.remove(id);
+                }
+            }
+            DirectSubscriptionChange::Clear => program.clear(),
+        }
+        if program.len() > 32 {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+
+        let _receive = self.validate_direct(state, scope, change, control, prepared)?;
+        let changed = old
+            .keys()
+            .chain(program.keys())
+            .filter(|id| match (old.get(*id), program.get(*id)) {
+                (Some(old), Some(next)) => !old.selection.same(next),
+                _ => true,
+            })
+            .cloned()
+            .collect::<BTreeSet<_>>();
+        let mut staged = BTreeMap::new();
+        for id in &changed {
+            if program.contains_key(id) {
+                let ticket = match old.get(id) {
+                    Some(old) => old.ticket.stage().ok_or(MediaTransitionError::Capacity)?,
+                    None => PeerRouteTicket::initial(),
+                };
+                staged.insert(id.clone(), ticket);
+            }
+        }
+
+        Ok(DirectPlan {
+            program,
+            old,
+            changed,
+            staged,
+            change: change.clone(),
+        })
+    }
+}
+impl DirectPlan {
+    pub(super) fn validate(
+        &self,
+        controller: &StreamController,
+        state: &State,
+        scope: &MediaScope<'_>,
+        control: Option<&MediaControl>,
+        prepared: Option<&[ReadyMediaBinding]>,
+    ) -> ControlResult<Vec<ControlRead>> {
+        controller.validate_direct(state, scope, &self.change, control, prepared)
+    }
+    pub(super) fn tickets(&self) -> Vec<PeerRouteTicket> {
+        self.changed
+            .iter()
+            .filter_map(|id| self.old.get(id).map(|r| r.ticket.clone()))
+            .collect()
+    }
+    pub(super) fn changed(&self) -> bool {
+        !self.changed.is_empty()
+    }
+    pub(super) fn lock<'a>(
+        &self,
+        controller: &'a StreamController,
+    ) -> ControlResult<DirectCommit<'a>> {
+        let gate = &controller.direct_subscriptions;
+        let routing = gate.routing.lock().unwrap_or_else(|p| p.into_inner());
+        if gate.cancel.is_cancelled() || self.old.values().any(|r| !r.ticket.is_current()) {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(DirectCommit(routing))
+    }
+}
+pub(super) struct DirectCommit<'a>(std::sync::MutexGuard<'a, Routing>);
+impl DirectCommit<'_> {
+    pub(super) fn commit(&mut self, plan: &DirectPlan) {
+        for id in &plan.changed {
+            match plan.program.get(id) {
+                Some(selection) => {
+                    let next = plan
+                        .staged
+                        .get(id)
+                        .expect("changed route staged its ticket")
+                        .clone();
+                    if let Some(previous) = plan.old.get(id) {
+                        assert!(
+                            next.commit_from(&previous.ticket),
+                            "direct routing changed outside controller fence"
+                        );
+                    }
+                    self.0.program.insert(
+                        id.clone(),
+                        Arc::new(Route {
+                            selection: selection.clone(),
+                            ticket: next,
+                            started: Instant::now(),
+                        }),
+                    );
+                }
+                None => {
+                    if let Some(previous) = plan.old.get(id) {
+                        assert!(
+                            previous.ticket.retire_if_current(),
+                            "direct route retired outside controller fence"
+                        );
+                    }
+                    self.0.program.remove(id);
+                }
+            }
+        }
+    }
+}
