+    assert_eq!(callback.kind(), "connection.offer");
+    assert_eq!(callback.scope(Scope::Operation), Some(operation.as_str()));
+    let target = subscriptions::stream_handle(&callback, "future_camera");
+    assert_ne!(failed, target);
+    let writer = tokio::spawn({
+        let domain = s.grants.0.clone();
+        async move {
+            domain
+                .write()
+                .await
+                .event_denied
+                .insert(ConnectionId::from_string("writer-completed"));
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    assert!(!writer.is_finished());
+    other.send(s.f.sign(s.confirmation(&callback))).await;
+    core_fixture::until(|| receiver.revision() == 3).await;
+    tokio::time::timeout(Duration::from_secs(1), writer)
