+struct Held {
+    domain: Arc<Policy>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    target: ConnectionId,
+    expected: u64,
+    change: MediaSubscriptionChange,
+    selected: Option<Vec<NegotiatedStream>>,
+}
+struct HeldLease {
+    held: Arc<Held>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for HeldLease {
+    fn control_participant_receive(
+        &self,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<MediaOwner>> {
+        future_participant_owner(&self.held.guard, &self.held.target, source).map(Box::new)
+    }
+
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_receive(&self, source: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        let guard = &self.held.guard;
+        let original = guard
+            .owners
+            .get(source.connection.as_str())
+            .ok_or(StreamControlError::Authority)?;
+        original
+            .connection
+            .require_current(&original.member, &original.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if guard.private
+            || guard
+                .revoked
+                .contains(&original.actor.identity().to_string())
+            || source.conversation != *original.member.conversation()
+            || source.session != *original.presence.session()
+            || source.participant != *original.member.participant()
+            || source.membership_epoch != original.member.epoch()
+            || source.connection_generation != original.connection.generation()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut owner = self.owner.clone();
+        owner.may_route_source = true;
+        Ok(Box::new(owner))
+    }
+}
+struct HeldPolicy {
+    base: Arc<Policy>,
+    fresh: AtomicUsize,
+}
+impl MediaPolicy for HeldPolicy {
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.base.current_participant_receive(scope, source)
+    }
+
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.fresh.fetch_add(1, Ordering::AcqRel);
+        self.base.current(scope)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<Arc<Held>>()
+            .ok_or(StreamControlError::Authority)?;
+        let (expected, change) = match intent {
+            MediaControlIntent::Subscriptions { expected, change } if held.selected.is_none() => {
+                (expected, *change)
+            }
+            MediaControlIntent::ChangeSubscriptions {
+                expected,
+                desired,
+                replace,
+                change,
+            } if replace.is_empty()
+                && held
+                    .selected
+                    .as_ref()
+                    .is_some_and(|s| s.iter().map(|s| &s.requested).eq(desired.iter())) =>
+            {
+                (expected, *change)
+            }
+            _ => return Err(StreamControlError::Authority),
+        };
+        if !Arc::ptr_eq(&self.base, &held.domain)
+            || scope.connection != &held.target
+            || *expected != held.expected
+            || change != &held.change
+            || held.guard.revoked.contains(&scope.principal.subject)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = held
+            .guard
+            .owners
+            .get(held.target.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        owner
+            .actor
+            .revalidate_principal(scope.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        MediaControl::new(
+            Box::new(HeldLease {
+                held: held.clone(),
+                owner,
+            }),
+            CancellationToken::new(),
+            deadline(),
+        )
+    }
+}
