+//! Retained participant selectors are model metadata, never authority.
+use super::{
+    media_scene::{GuardedMediaScene, SceneMember},
+    *,
+};
+use crate::ids::ParticipantId;
+use std::collections::HashMap;
+#[derive(Clone)]
+pub(super) struct ParticipantSelection {
+    pub member: Membership,
+    pub owner: Arc<AuthenticatedPrincipal>,
+    pub media: BTreeSet<Medium>,
+}
+impl ParticipantSelection {
+    pub(super) fn matches(&self, source: &StreamController) -> bool {
+        self.member.identity() == source.origin_member.identity()
+            && self.member.participant() == source.origin_member.participant()
+            && self.member.epoch() == source.origin_member.epoch()
+            && self
+                .owner
+                .has_same_owner(&source.credential_snapshot().principal)
+    }
+    fn same(&self, other: &Self) -> bool {
+        self.member.identity() == other.member.identity()
+            && self.member.participant() == other.member.participant()
+            && self.member.epoch() == other.member.epoch()
+            && self.owner.has_same_owner(&other.owner)
+            && self.media == other.media
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+pub(super) struct KnownSource {
+    pub participant: ParticipantId,
+    pub medium: Medium,
+}
+#[derive(Clone, Default)]
+pub(super) struct SelectionProgram {
+    pub participants: BTreeMap<ParticipantId, ParticipantSelection>,
+    pub excluded: BTreeSet<(ParticipantId, StreamId)>,
+    pub known: BTreeMap<StreamId, KnownSource>,
+}
+impl SelectionProgram {
+    pub(super) fn same(&self, other: &Self) -> bool {
+        self.excluded == other.excluded
+            && self.known == other.known
+            && self.participants.len() == other.participants.len()
+            && self
+                .participants
+                .iter()
+                .all(|(id, item)| other.participants.get(id).is_some_and(|o| item.same(o)))
+    }
+    pub(super) fn validate(&self) -> ControlResult<()> {
+        if self.participants.len() > 128 || self.excluded.len() > 4096 || self.known.len() > 4096 {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+        Ok(())
+    }
+}
+/// A scene-issued metadata delta. It can only be committed against the exact
+/// prior program, controller and revision, with newly checked current authority.
+#[derive(Clone)]
+pub struct SelectionMutation {
+    scene: u128,
+    target: Weak<StreamController>,
+    expected: u64,
+    previous: Option<Arc<SelectionProgram>>,
+    pub(super) next: Arc<SelectionProgram>,
+    requested: Vec<ParticipantSelection>,
+}
+impl PartialEq for SelectionMutation {
+    fn eq(&self, other: &Self) -> bool {
+        self.scene == other.scene
+            && self.expected == other.expected
+            && Weak::ptr_eq(&self.target, &other.target)
+            && same_previous(self.previous.as_ref(), other.previous.as_ref())
+            && self.next.same(&other.next)
+            && self.requested.len() == other.requested.len()
+            && self
+                .requested
+                .iter()
+                .all(|s| other.requested.iter().any(|o| s.same(o)))
+    }
+}
+impl Eq for SelectionMutation {}
+fn same_previous(a: Option<&Arc<SelectionProgram>>, b: Option<&Arc<SelectionProgram>>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+        _ => false,
+    }
+}
+impl SelectionMutation {
+    pub(super) fn new(
+        scene: &GuardedMediaScene,
+        target: &Arc<StreamController>,
+        expected: u64,
+        previous: Option<Arc<SelectionProgram>>,
+        next: SelectionProgram,
+        requested: Vec<ParticipantSelection>,
+    ) -> ControlResult<Arc<Self>> {
+        next.validate()?;
+        Ok(Arc::new(Self {
+            scene: scene.id,
+            target: Arc::downgrade(target),
+            expected,
+            previous,
+            next: Arc::new(next),
+            requested,
+        }))
+    }
+    pub fn requested_media(&self) -> BTreeSet<Medium> {
+        self.requested
+            .iter()
+            .flat_map(|p| p.media.iter().copied())
+            .collect()
+    }
+    pub(super) fn changed(&self) -> bool {
+        !self.previous.as_deref().map_or_else(
+            || SelectionProgram::default().same(&self.next),
+            |p| p.same(&self.next),
+        )
+    }
+    pub(super) fn validate_scope(
+        &self,
+        scene: &GuardedMediaScene,
+        target: &Arc<StreamController>,
+        expected: u64,
+    ) -> ControlResult<()> {
+        if scene.id != self.scene
+            || !Weak::ptr_eq(&self.target, &Arc::downgrade(target))
+            || self.expected != expected
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.next.validate()
+    }
+    pub(super) fn receive(
+        &self,
+        members: &HashMap<ConnectionId, SceneMember>,
+        target: &StreamController,
+        scope: &MediaScope<'_>,
+        control: Option<&MediaControl>,
+    ) -> ControlResult<Vec<ControlRead>> {
+        let mut leases = Vec::new();
+        for request in &self.requested {
+            let Some(source) = members
+                .values()
+                .find(|s| request.matches(&s.controller) && !s.controller.shutdown.is_cancelled())
+            else {
+                return Err(StreamControlError::NotReady);
+            };
+            let credential = source.controller.credential_snapshot();
+            source.controller.check_credential_snapshot(&credential)?;
+            if source.controller.shutdown.is_cancelled()
+                || StreamController::principal_expiry(&credential.principal)
+                    .is_some_and(|e| e <= chrono::Utc::now())
+            {
+                return Err(StreamControlError::Authority);
+            }
+            for medium in &request.media {
+                let descriptor = MediaParticipantSource {
+                    conversation: source.controller.conversation.clone(),
+                    session: source.controller.session.clone(),
+                    connection: source.controller.connection.clone(),
+                    participant: source.controller.origin_member.participant().clone(),
+                    membership_epoch: source.controller.origin_member.epoch(),
+                    identity: source.controller.origin_member.identity().clone(),
+                    principal: credential.principal.clone(),
+                    medium: *medium,
+                };
+                let lease = match control {
+                    Some(control) => {
+                        control.valid()?;
+                        ControlRead::Held(control.lease.control_participant_receive(&descriptor)?)
+                    }
+                    None => ControlRead::Current(
+                        target
+                            .policy
+                            .current_participant_receive(scope, &descriptor)?,
+                    ),
+                };
+                StreamController::check(scope, lease.authority())?;
+                if !lease.authority().may_route_source
+                    || !lease.authority().send_media.contains(medium)
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                leases.push(lease);
+            }
+        }
+        Ok(leases)
+    }
+    pub(super) fn lock<'a>(
+        &'a self,
+        scene: &'a GuardedMediaScene,
+        target: &Arc<StreamController>,
+        expected: u64,
+    ) -> ControlResult<SelectionCommit<'a>> {
+        self.validate_scope(scene, target, expected)?;
+        let programs = scene.selections.lock().unwrap_or_else(|p| p.into_inner());
+        if !same_previous(programs.get(&target.connection), self.previous.as_ref()) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        Ok(SelectionCommit {
+            programs,
+            connection: target.connection.clone(),
+            mutation: self,
+        })
+    }
+}
+pub(super) struct SelectionCommit<'a> {
+    programs: std::sync::MutexGuard<'a, BTreeMap<ConnectionId, Arc<SelectionProgram>>>,
+    connection: ConnectionId,
+    mutation: &'a SelectionMutation,
+}
+impl SelectionCommit<'_> {
+    pub(super) fn commit(&mut self) {
+        if self.mutation.changed() {
+            self.programs
+                .insert(self.connection.clone(), self.mutation.next.clone());
+        }
+    }
+}
diff --git a/crates/foundation/rvoip-core/src/staged_streams/subscription_plan.rs b/crates/foundation/rvoip-core/src/staged_streams/subscription_plan.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/subscription_plan.rs
@@ -0,0 +1,426 @@
+//! Selectors are resolved against admitted sources and pinned owner metadata.
+use super::{
+    audio_subscriptions::*, direct_subscriptions::*, media_scene::GuardedMediaScene,
+    media_subscriptions::*, selection_intent::*, *,
+};
+use crate::ids::ParticipantId;
+#[derive(Clone, PartialEq, Eq)]
+pub enum MediaSelection {
+    Stream(StreamId),
+    Participant {
+        participant: ParticipantId,
+        media: BTreeSet<Medium>,
+    },
+}
+#[derive(Clone)]
+pub enum MediaSelectionChange {
+    Subscribe(Vec<MediaSelection>),
+    Unsubscribe(Vec<StreamId>),
+    /// Rebuild the materialized routes from already committed pinned intent.
+    Reconcile,
+}
+#[derive(Clone)]
+struct SourceSnapshot {
+    publisher: Weak<StreamController>,
+    binding: ReadyMediaBinding,
+}
+#[derive(Clone)]
+pub struct MediaSubscriptionPlan {
+    expected: u64,
+    change: MediaSubscriptionChange,
+    desired: Vec<DesiredStream>,
+    exact: BTreeMap<StreamId, MediaFormat>,
+    sources: Vec<SourceSnapshot>,
+    intent: Option<Arc<SelectionProgram>>,
+    future: bool,
+}
+fn same_binding(a: &ReadyMediaBinding, b: &ReadyMediaBinding) -> bool {
+    a.negotiated == b.negotiated
+        && a.transport_id == b.transport_id
+        && a.stream_local_id == b.stream_local_id
+        && a.generation == b.generation
+        && a.connection_generation == b.connection_generation
+        && a.source_ready == b.source_ready
+        && a.sink_ready == b.sink_ready
+}
+impl MediaSubscriptionPlan {
+    pub fn expected_revision(&self) -> u64 {
+        self.expected
+    }
+    pub fn routing(&self) -> &MediaSubscriptionChange {
+        &self.change
+    }
+    pub fn desired(&self) -> &[DesiredStream] {
+        &self.desired
+    }
+    pub fn required_formats(&self) -> &BTreeMap<StreamId, MediaFormat> {
+        &self.exact
+    }
+    pub fn requires_reconciliation(&self) -> bool {
+        self.future
+    }
+    pub fn future_media(&self) -> BTreeSet<Medium> {
+        self.change
+            .selection
+            .as_ref()
+            .map_or_else(BTreeSet::new, |s| s.requested_media())
+    }
+    /// Compare authoritative source/selector metadata, ignoring a receiver's
+    /// unrelated gate revision. No permission or readiness is inferred here.
+    pub fn same_catalog(&self, other: &Self) -> bool {
+        let same_intent = match (&self.intent, &other.intent) {
+            (None, None) => true,
+            (Some(a), Some(b)) => a.same(b),
+            _ => false,
+        };
+        same_intent
+            && self.sources.len() == other.sources.len()
+            && self.sources.iter().all(|a| {
+                other.sources.iter().any(|b| {
+                    Weak::ptr_eq(&a.publisher, &b.publisher) && same_binding(&a.binding, &b.binding)
+                })
+            })
+    }
+}
+impl GuardedMediaScene {
+    pub(crate) fn plan_selection(
+        &self,
+        target_id: &ConnectionId,
+        expected: u64,
+        input: &MediaSelectionChange,
+    ) -> ControlResult<MediaSubscriptionPlan> {
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let target = members.get(target_id).ok_or(StreamControlError::NotReady)?;
+        let state = target
+            .controller
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        if state.closed || state.model.revision() != expected {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let previous = self
+            .selections
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .get(target_id)
+            .cloned();
+        let mut next = previous.as_deref().cloned().unwrap_or_default();
+        let mut desired = state
+            .active
+            .values()
+            .map(|p| p.binding.negotiated.requested.clone())
+            .collect::<Vec<_>>();
+        let mut exact = state
+            .active
+            .values()
+            .map(|p| {
+                (
+                    p.binding.negotiated.requested.logical_id.clone(),
+                    p.binding.negotiated.format.clone(),
+                )
+            })
+            .collect::<BTreeMap<_, _>>();
+        let mut catalog = Vec::new();
+        for member in members.values() {
+            let bindings = if Arc::ptr_eq(&member.controller, &target.controller) {
+                state
+                    .active
+                    .values()
+                    .filter(|p| {
+                        state
+                            .model
+                            .streams()
+                            .get(&p.binding.negotiated.requested.logical_id)
+                            .is_some_and(|s| s.state != LogicalStreamState::Ended)
+                    })
+                    .map(|p| p.binding.clone())
+                    .collect::<Vec<_>>()
+            } else {
+                let source = member
+                    .controller
+                    .state
+                    .try_lock()
+                    .map_err(|_| MediaTransitionError::Conflict)?;
+                if source.closed || member.controller.shutdown.is_cancelled() {
+                    continue;
+                }
+                source
+                    .active
+                    .values()
+                    .filter(|p| {
+                        source
+                            .model
+                            .streams()
+                            .get(&p.binding.negotiated.requested.logical_id)
+                            .is_some_and(|s| s.state != LogicalStreamState::Ended)
+                    })
+                    .map(|p| p.binding.clone())
+                    .collect()
+            };
+            for binding in bindings {
+                if binding.negotiated.requested.direction != StreamDirection::Send {
+                    catalog.push((member.controller.clone(), binding));
+                }
+            }
+        }
+        let mut selected = Vec::new();
+        let mut audio = Vec::new();
+        let mut requested = Vec::new();
+        let mut participant_intent = false;
+        if let MediaSelectionChange::Subscribe(items) = input {
+            if items.is_empty() || items.len() > 128 {
+                return Err(MediaTransitionError::Invalid.into());
+            }
+            for item in items {
+                match item {
+                    MediaSelection::Stream(id) => {
+                        let found = catalog
+                            .iter()
+                            .filter(|(_, b)| &b.negotiated.requested.logical_id == id)
+                            .collect::<Vec<_>>();
+                        if found.len() != 1 {
+                            return Err(if found.is_empty() {
+                                StreamControlError::NotReady
+                            } else {
+                                MediaTransitionError::Invalid.into()
+                            });
+                        }
+                        let (publisher, binding) = found[0];
+                        selected.push((publisher.clone(), binding.clone()));
+                        next.excluded
+                            .remove(&(publisher.origin_member.participant().clone(), id.clone()));
+                    }
+                    MediaSelection::Participant { participant, media } => {
+                        if media.is_empty() {
+                            return Err(MediaTransitionError::Invalid.into());
+                        }
+                        let source = members
+                            .values()
+                            .find(|s| {
+                                s.controller.origin_member.participant() == participant
+                                    && !s.controller.shutdown.is_cancelled()
+                            })
+                            .ok_or(StreamControlError::NotReady)?;
+                        let request = ParticipantSelection {
+                            member: source.controller.origin_member.clone(),
+                            owner: source.controller.credential_snapshot().principal,
+                            media: media.clone(),
+                        };
+                        if members.values().any(|s| {
+                            s.controller.origin_member.participant() == participant
+                                && !request.matches(&s.controller)
+                        }) {
+                            return Err(StreamControlError::Authority);
+                        }
+                        match next.participants.get_mut(participant) {
+                            Some(old)
+                                if request.matches(&source.controller)
+                                    && old.matches(&source.controller) =>
+                            {
+                                old.media.extend(media.iter().copied())
+                            }
+                            _ => {
+                                next.participants
+                                    .insert(participant.clone(), request.clone());
+                                next.known.retain(|_, s| &s.participant != participant);
+                                next.excluded.retain(|(p, _)| p != participant);
+                            }
+                        }
+                        next.excluded.retain(|(p, id)| {
+                            p != participant
+                                || next
+                                    .known
+                                    .get(id)
+                                    .is_none_or(|s| !media.contains(&s.medium))
+                        });
+                        if media.contains(&Medium::Audio) {
+                            audio.push(AudioSubscription::Participant(participant.clone()));
+                        }
+                        requested.push(request);
+                        participant_intent = true;
+                    }
+                }
+            }
+        }
+        // A reconcile uses only the previously committed owner/epoch pins. It
+        // cannot relabel an old selector onto a readmitted member or new owner.
+        if !matches!(input, MediaSelectionChange::Unsubscribe(_)) {
+            for token in next.participants.values() {
+                if matches!(input, MediaSelectionChange::Reconcile) {
+                    if members.values().any(|s| token.matches(&s.controller)) {
+                        requested.push(token.clone());
+                    }
+                }
+                for (publisher, binding) in &catalog {
+                    let id = &binding.negotiated.requested.logical_id;
+                    let medium = binding.negotiated.requested.medium;
+                    if token.matches(publisher)
+                        && token.media.contains(&medium)
+                        && !next
+                            .excluded
+                            .contains(&(token.member.participant().clone(), id.clone()))
+                    {
+                        if catalog
+                            .iter()
+                            .filter(|(_, b)| &b.negotiated.requested.logical_id == id)
+                            .count()
+                            != 1
+                        {
+                            return Err(MediaTransitionError::Invalid.into());
+                        }
+                        next.known.insert(
+                            id.clone(),
+                            KnownSource {
+                                participant: token.member.participant().clone(),
+                                medium,
+                            },
+                        );
+                        selected.push((publisher.clone(), binding.clone()));
+                    }
+                }
+            }
+        }
+        let mut direct = Vec::new();
+        let mut snapshot = Vec::new();
+        let mut ids = BTreeSet::new();
+        for (publisher, binding) in &selected {
+            let id = &binding.negotiated.requested.logical_id;
+            let medium = binding.negotiated.requested.medium;
+            if !ids.insert(id.clone()) {
+                continue;
+            }
+            snapshot.push(SourceSnapshot {
+                publisher: Arc::downgrade(publisher),
+                binding: binding.clone(),
+            });
+            if medium == Medium::Audio {
+                // Participant audio already retains its full owner/epoch pin;
+                // exact audio selection remains tied to this actual publisher.
+                if !next
+                    .participants
+                    .values()
+                    .any(|p| p.media.contains(&Medium::Audio) && p.matches(publisher))
+                {
+                    audio.push(AudioSubscription::Stream(MediaStreamRef {
+                        connection: publisher.connection.clone(),
+                        logical: id.clone(),
+                    }));
+                }
+            } else {
+                direct.push(DirectSubscription::new(publisher, id.clone(), id.clone()));
+                if let Some(port) = desired.iter_mut().find(|p| &p.logical_id == id) {
+                    if port.medium != medium {
+                        return Err(StreamControlError::Unsupported);
+                    }
+                    if port.direction == StreamDirection::Receive {
+                        port.direction = StreamDirection::Both;
+                    }
+                } else {
+                    desired.push(DesiredStream {
+                        logical_id: id.clone(),
+                        medium,
+                        direction: StreamDirection::Send,
+                    });
+                }
+                exact.insert(id.clone(), binding.negotiated.format.clone());
+            }
+        }
+        if !audio.is_empty() {
+            if let Some(port) = desired.iter_mut().find(|p| p.medium == Medium::Audio) {
+                if port.direction == StreamDirection::Receive {
+                    port.direction = StreamDirection::Both;
+                }
+            } else {
+                let id = StreamId::from_string("subscription-mix");
+                if desired.iter().any(|p| p.logical_id == id) {
+                    return Err(StreamControlError::Unsupported);
+                }
+                desired.push(DesiredStream {
+                    logical_id: id,
+                    medium: Medium::Audio,
+                    direction: StreamDirection::Send,
+                });
+            }
+        }
+        let mut change = match input {
+            MediaSelectionChange::Unsubscribe(ids) => {
+                if ids.is_empty() || ids.len() > 128 {
+                    return Err(MediaTransitionError::Invalid.into());
+                }
+                let mut keys = Vec::new();
+                for (publisher, binding) in &catalog {
+                    let id = &binding.negotiated.requested.logical_id;
+                    if ids.contains(id) {
+                        if binding.negotiated.requested.medium == Medium::Audio {
+                            keys.push(MediaStreamRef {
+                                connection: publisher.connection.clone(),
+                                logical: id.clone(),
+                            });
+                        }
+                        let part = publisher.origin_member.participant();
+                        if next.participants.contains_key(part) {
+                            next.known.insert(
+                                id.clone(),
+                                KnownSource {
+                                    participant: part.clone(),
+                                    medium: binding.negotiated.requested.medium,
+                                },
+                            );
+                        }
+                    }
+                }
+                for id in ids {
+                    if let Some(source) = next.known.get(id) {
+                        next.excluded
+                            .insert((source.participant.clone(), id.clone()));
+                    }
+                }
+                keys.extend(target.audio_consumer.subscriptions.exact_keys(ids));
+                keys.sort();
+                keys.dedup();
+                MediaSubscriptionChange {
+                    selection: None,
+                    audio: (!keys.is_empty()).then_some(AudioSubscriptionChange::Unsubscribe(keys)),
+                    direct: Some(DirectSubscriptionChange::Unsubscribe(ids.clone())),
+                }
+            }
+            _ => MediaSubscriptionChange {
+                selection: None,
+                audio: (!audio.is_empty()).then_some(AudioSubscriptionChange::Subscribe(audio)),
+                direct: (!direct.is_empty()).then_some(DirectSubscriptionChange::Subscribe(direct)),
+            },
+        };
+        let future = next
+            .participants
+            .values()
+            .any(|p| p.media.iter().any(|m| *m != Medium::Audio));
+        let intent = if previous.is_some()
+            || participant_intent
+            || matches!(input, MediaSelectionChange::Reconcile)
+        {
+            let mutation = SelectionMutation::new(
+                self,
+                &target.controller,
+                expected,
+                previous,
+                next,
+                requested,
+            )?;
+            let intent = mutation.next.clone();
+            change.selection = Some(mutation);
+            Some(intent)
+        } else {
+            None
+        };
+        Ok(MediaSubscriptionPlan {
+            expected,
+            change,
+            desired,
+            exact,
+            sources: snapshot,
+            intent,
+            future,
+        })
+    }
+}
