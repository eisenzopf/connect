--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/tests/media_scene/subscriptions.rs
@@ -0,0 +1,1016 @@
+use super::*;
+use crate::staged_streams::media_subscriptions::MediaSubscriptionChange;
+fn mixed(s: &Scene) -> MediaSubscriptionChange {
+    MediaSubscriptionChange {
+        selection: None,
+        audio: Some(AudioSubscriptionChange::Subscribe(vec![
+            AudioSubscription::Stream(MediaStreamRef {
+                connection: s.f.a.connection.clone(),
+                logical: desired(Medium::Audio).logical_id,
+            }),
+        ])),
+        direct: Some(DirectSubscriptionChange::Subscribe(
+            [Medium::Video, Medium::Screen, Medium::Data]
+                .into_iter()
+                .map(|medium| {
+                    DirectSubscription::new(
+                        &s.f.a,
+                        desired(medium).logical_id.clone(),
+                        desired(medium).logical_id,
+                    )
+                })
+                .collect(),
+        )),
+    }
+}
+fn clear() -> MediaSubscriptionChange {
+    MediaSubscriptionChange {
+        selection: None,
+        audio: Some(AudioSubscriptionChange::Clear),
+        direct: Some(DirectSubscriptionChange::Clear),
+    }
+}
+async fn apply(s: &Scene, change: MediaSubscriptionChange) -> ControlResult<u64> {
+    s.scene
+        .change_media_subscriptions(
+            &s.f.b.connection,
+            s.f.b.revision(),
+            change,
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+}
+fn outputs(s: &Scene) -> Vec<(Medium, mpsc::Receiver<QueuedMedia>)> {
+    [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+        .into_iter()
+        .map(|k| (k, s.f.ba.port(k).take_egress().unwrap()))
+        .collect()
+}
+fn publish(s: &Scene, seq: u32) {
+    for k in [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data] {
+        s.publish(k, seq);
+    }
+    s.scene.tick();
+}
+async fn heard_all(out: &mut [(Medium, mpsc::Receiver<QueuedMedia>)], seq: u32) {
+    for (medium, receiver) in out {
+        let medium = *medium;
+        outgoing(receiver)
+            .await
+            .deliver(move |frame| async move {
+                if medium == Medium::Audio {
+                    use rvoip_media_core::codec::factory::CodecFactory;
+                    let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+                    let decoded = codec.decode(&frame.payload).unwrap();
+                    assert!(decoded.samples.iter().any(|x| *x > 1000));
+                } else {
+                    assert_eq!(frame.timestamp_rtp, seq);
+                }
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+}
+fn silent(out: &mut [(Medium, mpsc::Receiver<QueuedMedia>)]) {
+    for (_, r) in out {
+        assert!(r.try_recv().is_err());
+    }
+}
+async fn setup() -> Scene {
+    Scene::new(&[Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]).await
+}
+
+#[tokio::test]
+async fn mixed_subscriptions_commit_one_revision_and_clear_all_fences_without_reopening_ports() {
+    let s = setup().await;
+    let mut out = outputs(&s);
+    let budget = s.f.b.stream_open_budget();
+    let revision = s.f.b.revision();
+    publish(&s, 1);
+    silent(&mut out);
+    assert_eq!(apply(&s, mixed(&s)).await.unwrap(), revision + 1);
+    assert_eq!(apply(&s, mixed(&s)).await.unwrap(), revision + 1);
+    publish(&s, 2);
+    heard_all(&mut out, 2).await;
+    publish(&s, 3);
+    let queued = out
+        .iter_mut()
+        .map(|(_, r)| r.try_recv().unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(apply(&s, clear()).await.unwrap(), revision + 2);
+    for packet in queued {
+        assert!(packet
+            .deliver(|_| async { panic!("old mixed routing reached IO") })
+            .await
+            .is_err());
+    }
+    publish(&s, 4);
+    silent(&mut out);
+    assert_eq!(apply(&s, clear()).await.unwrap(), revision + 2);
+    assert_eq!(budget, s.f.b.stream_open_budget());
+}
+#[tokio::test]
+async fn mixed_subscriptions_validate_entire_audio_and_direct_request_before_changing_either() {
+    let s = setup().await;
+    let mut out = outputs(&s);
+    apply(&s, mixed(&s)).await.unwrap();
+    let before = s.f.b.revision();
+    let mut wrong = DirectSubscription::new(
+        &s.f.a,
+        desired(Medium::Video).logical_id,
+        desired(Medium::Screen).logical_id,
+    );
+    wrong.source.logical = StreamId::from_string("unknown");
+    assert!(apply(
+        &s,
+        MediaSubscriptionChange {
+            selection: None,
+            audio: Some(AudioSubscriptionChange::Clear),
+            direct: Some(DirectSubscriptionChange::Subscribe(vec![wrong]))
+        }
+    )
+    .await
+    .is_err());
+    assert!(apply(
+        &s,
+        MediaSubscriptionChange {
+            selection: None,
+            audio: Some(AudioSubscriptionChange::Subscribe(vec![
+                AudioSubscription::Stream(MediaStreamRef {
+                    connection: s.f.a.connection.clone(),
+                    logical: StreamId::from_string("missing")
+                })
+            ])),
+            direct: Some(DirectSubscriptionChange::Clear)
+        }
+    )
+    .await
+    .is_err());
+    let foreign = setup().await;
+    assert!(apply(
+        &s,
+        MediaSubscriptionChange {
+            selection: None,
+            audio: Some(AudioSubscriptionChange::Clear),
+            direct: Some(DirectSubscriptionChange::Subscribe(vec![
+                DirectSubscription::new(
+                    &foreign.f.a,
+                    desired(Medium::Video).logical_id.clone(),
+                    desired(Medium::Video).logical_id
+                )
+            ]))
+        }
+    )
+    .await
+    .is_err());
+    assert_eq!(before, s.f.b.revision());
+    publish(&s, 5);
+    heard_all(&mut out, 5).await;
+    assert!(s
+        .scene
+        .change_media_subscriptions(
+            &s.f.b.connection,
+            before - 1,
+            clear(),
+            deadline(),
+            CancellationToken::new(),
+            None
+        )
+        .await
+        .is_err());
+    assert!(apply(
+        &s,
+        MediaSubscriptionChange {
+            selection: None,
