@@ -0,0 +1,235 @@
+//! A wake hint triggers a fresh read of committed intent and current authority.
+use super::*;
+use crate::v2::{
+    auth_dispatch::*, native::CanonicalNativeAdapter, native_requests::NativeRequestOrigin,
+};
+use rvoip_core::orchestrator::Orchestrator;
+use std::{
+    sync::{Arc, Mutex, Weak},
+    time::Duration,
+};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) struct NativeSubscriptionRuntime {
+    core: Weak<Orchestrator>,
+    adapter: Weak<CanonicalNativeAdapter>,
+    connection: ConnectionId,
+    origin: Arc<NativeRequestOrigin>,
+    policy: Arc<dyn NativeSubscriptionPolicy>,
+    changed: Arc<tokio::sync::Notify>,
+    cancel: CancellationToken,
+    task: Mutex<Option<tokio::task::JoinHandle<()>>>,
+    quiet: Arc<tokio::sync::Notify>,
+}
+impl NativeSubscriptionRuntime {
+    pub(crate) fn spawn(
+        core: &Arc<Orchestrator>,
+        adapter: &Arc<CanonicalNativeAdapter>,
+        connection: ConnectionId,
+        origin: Arc<NativeRequestOrigin>,
+        policy: Arc<dyn NativeSubscriptionPolicy>,
+        changed: Arc<tokio::sync::Notify>,
+    ) -> Arc<Self> {
+        let runtime = Arc::new(Self {
+            core: Arc::downgrade(core),
+            adapter: Arc::downgrade(adapter),
+            connection,
+            cancel: origin.cancellation().child_token(),
+            origin,
+            policy,
+            changed,
+            task: Mutex::new(None),
+            quiet: Arc::new(tokio::sync::Notify::new()),
+        });
+        let weak = Arc::downgrade(&runtime);
+        let task = tokio::spawn(async move {
+            Self::run(weak).await;
+        });
+        *runtime.task.lock().unwrap_or_else(|p| p.into_inner()) = Some(task);
+        runtime
+    }
+    pub(crate) fn retire(&self) {
+        self.cancel.cancel();
+        self.origin.retire();
+        if let Some(task) = self.task.lock().unwrap_or_else(|p| p.into_inner()).take() {
+            task.abort();
+        }
+    }
+    async fn run(weak: Weak<Self>) {
+        let mut last: Option<NativeSubscriptionPlan> = None;
+        let mut pending: Option<String> = None;
+        let mut known: Option<NativeSubscriptionOutcome> = None;
+        let mut committed_plan: Option<NativeSubscriptionPlan> = None;
+        let mut retry = false;
+        let mut authorization_pending = false;
+        loop {
+            let Some(runtime) = weak.upgrade() else {
+                return;
+            };
+            if runtime.cancel.is_cancelled() || !runtime.origin.current() {
+                return;
+            }
+            let Some(core) = runtime.core.upgrade() else {
+                return;
+            };
+            let Some(adapter) = runtime.adapter.upgrade() else {
+                return;
+            };
+            let changed = runtime.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            let policy_changes = runtime
+                .policy
+                .changes()
+                .unwrap_or_else(|| runtime.quiet.clone());
+            let policy_changed = policy_changes.notified();
+            tokio::pin!(policy_changed);
+            policy_changed.as_mut().enable();
+            let plan =
+                adapter.plan_native_reconciliation(&core, &runtime.connection, &runtime.origin);
+            let wanted = match plan {
+                Ok(Some(plan))
+                    if runtime.origin.ready()
+                        && (known.is_some()
+                            || retry
+                            || authorization_pending
+                            || last.as_ref().is_none_or(|old| {
+                                !old.selection.same_catalog(&plan.selection)
+                                    || capabilities_changed(
+                                        old.media.remote_capabilities(),
+                                        plan.media.remote_capabilities(),
+                                    )
+                            })) =>
+                {
+                    Some(plan)
+                }
+                Ok(Some(_)) | Ok(None) => None,
+                Err(NativeOfferError::Conflict) | Err(NativeOfferError::Capacity) => {
+                    retry = true;
+                    None
+                }
+                Err(_) => None,
+            };
+            // A local commit followed by an observer/journal failure retries
+            // that exact historical operation and plan, never a new revision.
+            let wanted = if known.is_some() {
+                committed_plan.clone()
+            } else {
+                wanted
+            };
+            if let Some(plan) = wanted {
+                let deadline = runtime
+                    .origin
+                    .deadline()
+                    .min(Instant::now() + Duration::from_secs(30));
+                match runtime.origin.reserve() {
+                    Ok(slot) => {
+                        let scope = runtime
+                            .origin
+                            .request_scope(plan.selection.expected_revision());
+                        let authority = tokio::select! {biased;
+                            _=runtime.cancel.cancelled()=>return,
+                            _=tokio::time::sleep_until(deadline)=>Err(DispatchError::Closed),
+                            result=runtime.policy.reconcile(&scope,&plan,pending.as_deref())=>result,
+                        };
+                        if let Ok(authority) = authority {
+                            authorization_pending = false;
+                            let operation = authority.operation;
+                            if operation.is_empty()
+                                || operation.len() > 128
+                                || !operation
+                                    .bytes()
+                                    .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+                                || pending.as_ref().is_some_and(|old| old != &operation)
+                            {
+                                retry = false;
+                                last = Some(plan);
+                            } else {
+                                pending = Some(operation.clone());
+                                let invocation = NativeSubscriptionInvocation::new(
+                                    runtime.origin.clone(),
+                                    plan.clone(),
+                                    operation.clone(),
+                                    authority.lease,
+                                );
+                                let outcome = match known.clone() {
+                                    Some(known) => Ok(known),
+                                    None => {
+                                        adapter
+                                            .reconcile_native_subscriptions(
+                                                &core,
+                                                &runtime.connection,
+                                                invocation.clone(),
+                                                runtime.policy.clone(),
+                                                slot.clone(),
+                                            )
+                                            .await
+                                    }
+                                };
+                                if let Ok(outcome) = &outcome {
+                                    known = Some(outcome.clone());
+                                    committed_plan = Some(plan.clone());
+                                }
+                                let held = invocation.lease();
+                                let observed = tokio::select! {biased;
+                                    _=runtime.cancel.cancelled()=>return,
+                                    _=tokio::time::sleep_until(invocation.deadline())=>Err(DispatchError::Closed),
+                                    result=runtime.policy.observe(invocation.scope(),&operation,&outcome,Some(&held))=>result,
+                                };
+                                if observed.is_ok() {
+                                    authorization_pending =
+                                        matches!(outcome, Err(NativeOfferError::Authority));
+                                    retry = matches!(
+                                        outcome,
+                                        Err(NativeOfferError::Conflict
+                                            | NativeOfferError::Capacity
+                                            | NativeOfferError::Dispatch(
+                                                DispatchError::SubmissionUnknown
+                                            ))
+                                    );
+                                    if outcome.is_ok() {
+                                        pending = None;
+                                        known = None;
+                                        committed_plan = None;
+                                    }
+                                    last = Some(plan);
+                                } else {
+                                    retry = true;
+                                }
+                                // Only metadata remains between attempts. The real lease,
+                                // reply custody and reservation leave this active scope.
+                            }
+                        } else {
+                            // Policy hints accelerate this retry. A missed hint
+                            // cannot make a transient denial authoritative forever.
+                            authorization_pending = true;
+                            retry = false;
+                            last = Some(plan);
+                        }
+                    }
+                    Err(DispatchError::Capacity) => retry = true,
+                    Err(_) => return,
+                }
+            }
+            drop(adapter);
+            drop(core);
+            tokio::select! {biased;
+                _=runtime.cancel.cancelled()=>return,
+                _=&mut changed=>{},
+                _=&mut policy_changed=>{last=None;},
+                _=tokio::time::sleep(if retry || !runtime.origin.ready(){Duration::from_millis(25)}else{Duration::from_millis(500)})=>{},
+            }
+        }
+    }
+}
+
+fn capabilities_changed(
+    a: &rvoip_core::stream_lifecycle::EndpointMediaCapabilities,
+    b: &rvoip_core::stream_lifecycle::EndpointMediaCapabilities,
+) -> bool {
+    a.send != b.send
+        || a.receive != b.receive
+        || a.max_streams != b.max_streams
+        || a.renegotiation != b.renegotiation
+}
