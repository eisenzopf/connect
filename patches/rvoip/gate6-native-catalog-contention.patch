+/// A read-only catalog can be temporarily occupied without a stale revision,
+/// missing source or exhausted resource budget. Only this pre-effect boundary
+/// maps that pressure to current metadata unavailability.
+pub(crate) fn catalog_error(
+    e: rvoip_core::orchestrator::participant_control::ParticipantControlError,
+) -> NativeOfferError {
+    use rvoip_core::{
+        orchestrator::participant_control::ParticipantControlError as E,
+        staged_streams::StreamControlError,
+    };
+    match e {
+        E::Media(StreamControlError::Backpressure) => {
+            NativeOfferError::Dispatch(super::auth_dispatch::DispatchError::StorageUnavailable)
+        }
+        e => core_error(e),
+    }
+}
