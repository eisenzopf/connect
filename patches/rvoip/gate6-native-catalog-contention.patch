+#[tokio::test]
+async fn subscription_catalog_contention_preserves_original_revision_and_has_no_effect() {
+    use crate::staged_streams::subscription_plan::*;
+    let s = wildcard_scene().await;
+    let expected = s.f.b.revision();
+    let budget = s.f.b.stream_open_budget();
+    let input = MediaSelectionChange::Subscribe(vec![MediaSelection::Participant {
+        participant: s.f.a.origin_member.participant().clone(),
+        media: BTreeSet::from([Medium::Audio]),
+    }]);
+    let held = s.f.a.state.lock().unwrap();
+    assert!(matches!(
+        s.scene.plan_selection(&s.f.b.connection, expected, &input),
+        Err(StreamControlError::Backpressure)
+    ));
+    assert!(matches!(
+        s.scene
+            .plan_selection(&s.f.b.connection, expected + 1, &input),
+        Err(StreamControlError::Model(MediaTransitionError::Conflict))
+    ));
+    assert_eq!(s.f.b.revision(), expected);
+    assert_eq!(s.f.b.stream_open_budget(), budget);
+    drop(held);
+    let plan = s
+        .scene
+        .plan_selection(&s.f.b.connection, expected, &input)
+        .unwrap();
+    assert_eq!(
+        s.f.b.revision(),
+        expected,
+        "a recovered read is still not a mutation"
+    );
+    assert_eq!(
+        apply(&s, plan.routing().clone()).await.unwrap(),
+        expected + 1
+    );
+    assert_eq!(s.f.b.stream_open_budget(), budget);
+}
