+    pub fn new(already_exposed: bool) -> Self {
+        Self { state: AtomicU64::new(u64::from(already_exposed)), next_token: AtomicU64::new(5) }
+    }
+    /// True permits this SAME original capability to escape; false requires
+    /// the accessor to return unavailable without returning any raw handle.
+    /// Preexisting escape is permanent. A concurrent seal and escape cannot
+    /// both win. Ordinary retired peers retain their prior raw-access behavior.
+    pub fn mark_escaped(&self) -> bool {
+        self.state.fetch_update(Ordering::AcqRel, Ordering::Acquire, |state| match state {
+            0 => Some(1), 1 => Some(1), 2 => Some(3), 3 => Some(3), _ => None,
+        }).is_ok()
+    }
+    pub fn escaped(&self) -> bool { matches!(self.state.load(Ordering::Acquire), 1 | 3 | 4) }
+    pub fn try_seal(self: &Arc<Self>) -> Result<PhysicalVideoExposureSeal, PhysicalVideoSealUnavailable> {
+        let token = self.next_token.fetch_update(Ordering::Relaxed, Ordering::Relaxed,
+            |next| next.checked_add(1)).map_err(|_| PhysicalVideoSealUnavailable::Exhausted)?;
+        self.state.compare_exchange(0, token, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|state| match state {
+                1 | 3 => PhysicalVideoSealUnavailable::Escaped,
+                2 | 4 => PhysicalVideoSealUnavailable::Retired,
+                _ => PhysicalVideoSealUnavailable::AlreadySealed,
+            })?;
+        Ok(PhysicalVideoExposureSeal { coverage: self.clone(), token })
+    }
+    /// Called synchronously before original native close/Drop. An outstanding
+    /// lease can never abort or Drop back to an alive/unexposed state afterward.
+    pub fn retire(&self) {
+        let _ = self.state.fetch_update(Ordering::AcqRel, Ordering::Acquire, |state| match state {
+            0 => Some(2), 1 => Some(3), 2..=4 => Some(state), _ => Some(4),
+        });
+    }
+}
+impl PhysicalVideoExposureSeal {
+    pub fn is_current(&self) -> bool { self.coverage.state.load(Ordering::Acquire) == self.token }
+    pub fn covers(&self, coverage: &Arc<PhysicalVideoExposureCoverage>) -> bool {
+        Arc::ptr_eq(&self.coverage, coverage) && self.is_current()
+    }
+    /// Abort releases only this exact live token. Drop has identical behavior.
+    pub fn abort(self) { drop(self); }
+    /// Terminal lease retirement never reopens raw access to this strict peer.
+    pub fn retire(self) {
+        let _ = self.coverage.state.compare_exchange(self.token, 4, Ordering::AcqRel, Ordering::Acquire);
+    }
