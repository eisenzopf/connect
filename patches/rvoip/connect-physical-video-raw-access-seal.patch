+        // Original native setup stays nonescaping, even after seal creation.
+        peer.add_local_audio_track().await.unwrap();peer.add_local_video_track().await.unwrap();
+        assert!(peer.local_audio_track_internal().is_some());
+        assert!(peer.local_video_track_internal().is_some());
+        assert!(peer.peer_connection().is_none());
+        assert!(peer.local_audio_track().is_none());
+        assert!(peer.local_video_track().is_none());
