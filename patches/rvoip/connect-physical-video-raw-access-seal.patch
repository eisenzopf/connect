+/// Peer-wide control-plane coverage root. Every raw capability accessor must
+/// linearize here BEFORE returning a peer/track/sender/transceiver capability.
+/// This never runs on a packet path and does not quiesce or deny ordinary IO.
+/// State: 0 unexposed, 1 escaped, 2 retired-unexposed, 3 retired-escaped,
+/// 4 retired-sealed; >=5 is the unique live owned seal token.
+pub struct PhysicalVideoExposureCoverage { state: AtomicU64, next_token: AtomicU64 }
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum PhysicalVideoSealUnavailable { Escaped, Retired, AlreadySealed, Exhausted }
+/// Nonclone owned no-escape lease. This is NOT an IO drain, source cut, F,
+/// authorization, or readiness certificate. It owns only this metadata root.
