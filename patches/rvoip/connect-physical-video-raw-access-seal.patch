+#[tokio::test]
+async fn original_scalar_control_seal_binds_connected_peer_and_native_close_retires_same_lease() {
+    let mut config=WebRtcConfig::loopback();config.trickle_ice=false;
+    let a=RvoipPeerConnection::new_canonical(&config,PeerRole::Offerer).await.unwrap();
+    let b=match RvoipPeerConnection::new_canonical(&config,PeerRole::Answerer).await {
+        Ok(b)=>b,Err(error)=>{a.close().await.unwrap();panic!("second original owner setup: {error}")}
+    };
+    let mut a_closed=false;
+    let work=std::panic::AssertUnwindSafe(async {
+        let control=OriginalWebRtcIceControl {peer:a.clone()};
+        assert!(control.try_seal_raw_access().is_err(),"unconnected owner cannot mint a live seal");
+        let offer=a.create_offer_and_gather().await.unwrap();
+        let answer=b.accept_offer_and_gather(&offer).await.unwrap();
+        a.set_remote_answer(&answer).await.unwrap();
+        a.wait_connected(std::time::Duration::from_secs(5)).await.unwrap();
+        b.wait_connected(std::time::Duration::from_secs(5)).await.unwrap();
+        let other=OriginalWebRtcIceControl {peer:b.clone()};
+        let seal=control.try_seal_raw_access().unwrap();
+        assert!(seal.covers(&a.video_exposure_coverage()));
+        assert!(!seal.covers(&b.video_exposure_coverage()));
+        assert!(!control.same_physical(&other));
+        assert!(control.descriptions().await.0.is_some());
+        assert!(a.peer_connection().is_none());
+        assert!(a.local_audio_track().is_none());
+        a.close().await.unwrap();a_closed=true;
+        assert!(!seal.is_current());drop(seal);
+        assert!(a.peer_connection().is_none());
+        assert!(control.try_seal_raw_access().is_err());
+    }).catch_unwind().await;
+    // Attempt BOTH original joins even if work or the first close fails.
+    let close_a=if a_closed {Ok(())} else {a.close().await};let close_b=b.close().await;
+    assert!(close_a.is_ok() && close_b.is_ok(),"both original native drivers join before outcome");
+    if let Err(error)=work {std::panic::resume_unwind(error)}
+}
