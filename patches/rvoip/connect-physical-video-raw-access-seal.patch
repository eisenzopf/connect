+#[tokio::test]
+async fn original_native_raw_getters_refuse_during_seal_including_late_tracks_then_abort() {
+    let peer=RvoipPeerConnection::new_canonical(&WebRtcConfig::loopback(),PeerRole::Offerer).await.unwrap();
+    let work=std::panic::AssertUnwindSafe(async {
+        let root=peer.video_exposure_coverage();
