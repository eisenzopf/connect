+//! Decoder-only endpoint preparation. No sample or packet enters the mixer.
+use super::{audience::*, guarded_audio::Codecs, *};
+
+/// Owns a scene-issued closed preparation and its actual decoder lifetime.
+/// Dropping it invalidates observed input and any uncommitted readiness plan.
+/// It neither changes a speaking role nor unmutes the endpoint.
+pub struct AudioEndpointPreparation {
+    pub(super) audience: AudioAudienceHandle,
+    pub(super) probe: Arc<Probe>,
+}
+impl AudioEndpointPreparation {
+    pub fn audience(&self) -> &AudioAudienceHandle {
+        &self.audience
+    }
+    /// Current sealed local IO metadata only, never a handoff grant.
+    pub fn has_duplex_io(&self) -> bool {
+        let Some(controller) = self.probe.controller.upgrade() else {
+            return false;
+        };
+        let Ok(state) = controller.state.try_lock() else {
+            return false;
+        };
+        !self.probe.cancel.is_cancelled()
+            && self
+                .probe
+                .consumer
+                .duplex_since(&controller, self.audience.committed_at, &state)
+                .is_ok()
+    }
+}
+impl Drop for AudioEndpointPreparation {
+    fn drop(&mut self) {
+        self.probe.cancel.cancel();
+    }
+}
+pub(super) struct Probe {
+    pub(super) controller: Weak<StreamController>,
+    pub(super) port: Weak<Port>,
+    pub(super) group: Arc<ClosedAudience>,
+    pub(super) registry: Arc<Mutex<AudienceState>>,
+    pub(super) consumer: Arc<audio_consumer::AudioConsumer>,
+    pub(super) decoder: Mutex<Codecs>,
+    pub(super) cancel: CancellationToken,
+}
+impl Probe {
+    pub(super) fn output_scope(
+        &self,
+        purpose: &local_audio::LocalAudioPurpose,
+    ) -> ControlResult<CancellationToken> {
+        let local_audio::LocalAudioPurpose::EndpointPreparation { operation_id } = purpose;
+        let registry = self
+            .registry
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        if self.cancel.is_cancelled()
+            || operation_id != &self.group.operation
+            || !registry
+                .groups
+                .get(operation_id)
+                .is_some_and(|g| Arc::ptr_eq(g, &self.group))
+            || !self.controller.upgrade().is_some_and(|c| {
+                registry
+                    .preparations
+                    .get(&c.connection)
+                    .is_some_and(|g| Arc::ptr_eq(g, &self.group))
+            })
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(self.cancel.clone())
+    }
+    /// None means the exact closed preparation was consumed/retired. Ordinary
+    /// input still has to pass its own role, gate and current publication policy.
+    pub(super) fn observe(
+        &self,
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        frame: &MediaFrame,
+    ) -> Option<ControlResult<()>> {
+        if self.cancel.is_cancelled() {
+            return None;
+        }
+        let registry = match self.registry.try_lock() {
+            Ok(r) => r,
+            Err(_) => return Some(Err(MediaTransitionError::Conflict.into())),
+        };
+        if !registry
+            .preparations
+            .get(&controller.connection)
+            .is_some_and(|g| Arc::ptr_eq(g, &self.group))
+            || !registry
+                .groups
+                .get(&self.group.operation)
+                .is_some_and(|g| Arc::ptr_eq(g, &self.group))
+        {
+            return None;
+        }
+        Some(self.decode(controller, port, frame))
+    }
+    fn decode(
+        &self,
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        frame: &MediaFrame,
+    ) -> ControlResult<()> {
+        if !Weak::ptr_eq(&self.controller, &Arc::downgrade(controller))
+            || !Weak::ptr_eq(&self.port, &Arc::downgrade(port))
+            || self.cancel.is_cancelled()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let state = controller
+            .state
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let stream = state
+            .model
+            .streams()
+            .get(&port.binding.negotiated.requested.logical_id)
+            .ok_or(StreamControlError::NotReady)?;
+        if state.closed
+            || controller.shutdown.is_cancelled()
+            || !state.active.values().any(|p| Arc::ptr_eq(p, port))
+            || stream.state != LogicalStreamState::Active
+            || !stream.source_muted
+            || stream.negotiated.requested.direction == StreamDirection::Send
+            || stream.hold_direction == Some(StreamDirection::Send)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        {
+            let ps = port
+                .state
+                .try_lock()
+                .map_err(|_| MediaTransitionError::Conflict)?;
+            if !ps.ready || ps.status != PortStatus::Active {
+                return Err(StreamControlError::NotReady);
+            }
+        }
+        let credential = controller.credential_snapshot();
+        let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+        let purpose = local_audio::LocalAudioPurpose::EndpointPreparation {
+            operation_id: self.group.operation.clone(),
+        };
+        let lease = controller
+            .policy
+            .current_audio_preparation(&scope, &purpose)?;
+        let owner = lease.authority();
+        StreamController::check(&scope, owner)?;
+        state.model.authorize_binding(&owner.current())?;
+        if !owner.may_control || !owner.receive_media.contains(&Medium::Audio) {
+            return Err(StreamControlError::Authority);
+        }
+        let ticket = port.ticket();
+        let _port = ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)?;
+        let stamp = self.consumer.stamp();
+        // This fence checks the active consumer incarnation, not permission to
+        // speak. Only this separately authorized discard-only decoder uses it.
+        let _consumer = self.consumer.begin(&stamp, true)?;
+        let (scene, _scene) = controller.scene_admission(scene_consumer::SceneCheck::publish())?;
+        let admitted_at = Instant::now();
+        let deadline = StreamController::command_deadline(
+            &credential.principal,
+            tokio::time::Instant::now() + Duration::from_millis(200),
+        );
+        let samples = self
+            .decoder
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?
+            .decode(frame)?;
+        if samples.is_empty()
+            || tokio::time::Instant::now() >= deadline
+            || self.cancel.is_cancelled()
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        controller.check_credential_snapshot(&credential)?;
+        self.consumer.observed_preparation(
+            &MediaPacket {
+                frame: frame.clone(),
+                data: None,
+                source: port.clone(),
+                ticket,
+                admitted_at,
+                consumer: Some(stamp),
+                scene,
+            },
+            self.cancel.clone(),
+        );
+        Ok(())
+    }
+}
