+//! Real muted/Observer decoding and guarded output, without readiness flags.
+use super::*;
+use crate::staged_streams::{
+    endpoint_preparation::AudioEndpointPreparation, local_audio::LocalAudioPurpose,
+};
+struct Target {
+    room: Room,
+    preparation: AudioEndpointPreparation,
+}
+impl Target {
+    async fn new(observer: bool) -> Self {
+        let mut room = Room::new().await;
+        room.add("fresh", Some("public"), true).await;
+        if observer {
+            room.scene
+                .role_targets(&[ConnectionId::from_string("fresh")])
+                .remove(0)
+                .prepare_role(deadline(), CancellationToken::new())
+                .await
+                .unwrap()
+                .commit(false);
+        }
+        assert!(room.publish("fresh", 12000).is_err());
+        let id = ConnectionId::from_string("fresh");
+        assert!(room
+            .scene
+            .prepare_audio_endpoint(&id, "prepare-fresh")
+            .is_err());
+        room.domain
+            .local_preparations
+            .lock()
+            .unwrap()
+            .insert(id.clone(), "prepare-fresh".into());
+        assert!(room
+            .scene
+            .prepare_audio_endpoint(&id, "wrong-operation")
+            .is_err());
+        let preparation = room
+            .scene
+            .prepare_audio_endpoint(&id, "prepare-fresh")
+            .unwrap();
+        assert!(room
+            .scene
+            .prepare_audio_endpoint(&id, "prepare-fresh")
+            .is_err());
+        Self { room, preparation }
+    }
+    fn plan(&self) -> ControlResult<AudioHandoffPlan> {
+        let mut r = self.room.handoff_request(OldHandoffDisposition::Observer);
+        r.admitted = ConnectionId::from_string("fresh");
+        self.room
+            .scene
+            .plan_prepared_audio_handoff(self.preparation.audience(), None, r)
+    }
+    fn queue(&mut self) {
+        use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+        let n = self.room.nodes.get_mut("fresh").unwrap();
+        n.sequence += 1;
+        let p = n.adapter.port(Medium::Audio);
+        let mut f = frame(&p, n.sequence);
+        f.payload = CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap()
+            .encode(&AudioFrame {
+                samples: vec![0; 160],
+                sample_rate: 8000,
+                channels: 1,
+                duration: Duration::from_millis(20),
+                timestamp: n.sequence,
+            })
+            .unwrap()
+            .into();
+        n.controller
+            .try_queue_local_audio(
+                &desired(Medium::Audio).logical_id,
+                f,
+                LocalAudioPurpose::EndpointPreparation {
+                    operation_id: "prepare-fresh".into(),
+                },
+            )
+            .unwrap();
+    }
+}
+#[tokio::test]
+async fn endpoint_preparation_muted_and_observer_proof_discards_input_and_requires_completed_output(
+) {
+    for observer in [false, true] {
+        let mut t = Target::new(observer).await;
+        assert!(matches!(t.plan(), Err(StreamControlError::NotReady)));
+        t.room.publish("fresh", 12000).unwrap();
+        t.room.tick();
+        t.room.silent(&["alice", "bob", "public", "hold", "fresh"]);
+        assert!(matches!(t.plan(), Err(StreamControlError::NotReady)));
+        t.queue();
+        assert!(
+            matches!(t.plan(), Err(StreamControlError::NotReady)),
+            "queued is not delivered"
+        );
+        t.room.heard("fresh", 0).await;
+        assert!(t.plan().is_ok());
+        let c = &t.room.nodes["fresh"].controller;
+        assert!(
+            c.state.lock().unwrap().model.streams()[&desired(Medium::Audio).logical_id]
+                .source_muted
+        );
+        assert_eq!(
+            c.audio_consumer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .unwrap()
+                .upgrade()
+                .unwrap()
+                .role_snapshot()
+                .0,
+            !observer
+        );
+        t.room.publish("alice", 800).unwrap();
+        t.room.tick();
+        t.room.heard("bob", 800).await;
+        t.room.heard("public", 800).await;
+        t.room.silent(&["fresh"]);
+    }
+}
+#[tokio::test]
+async fn endpoint_preparation_current_denial_drop_and_physical_epoch_invalidate_proof_without_opening_routes(
+) {
+    for change in ["permission", "port", "role"] {
+        let mut t = Target::new(true).await;
+        t.room.publish("fresh", 12000).unwrap();
+        t.queue();
+        t.room.heard("fresh", 0).await;
+        let stale = t.plan().unwrap();
+        match change {
+            "permission" => {
+                t.room
+                    .domain
+                    .local_preparations
+                    .lock()
+                    .unwrap()
+                    .remove(&ConnectionId::from_string("fresh"));
+                assert!(t.room.publish("fresh", 12000).is_err());
+            }
+            "port" => {
+                t.room.nodes["fresh"]
+                    .adapter
+                    .port(Medium::Audio)
+                    .report_terminal()
+                    .unwrap();
+                assert!(t.plan().is_err());
+            }
+            _ => {
+                t.room
+                    .scene
+                    .role_targets(&[ConnectionId::from_string("fresh")])
+                    .remove(0)
+                    .prepare_role(deadline(), CancellationToken::new())
+                    .await
+                    .unwrap()
+                    .commit(false);
+                assert!(t.plan().is_err());
+            }
+        }
+        if change != "permission" {
+            assert!(t.room.handoff(stale).await.is_err());
+        }
+        t.room.publish("alice", 800).unwrap();
+        t.room.tick();
+        t.room.heard("bob", 800).await;
+        t.room.heard("public", 800).await;
+        t.room.silent(&["fresh"]);
+    }
+}
+#[tokio::test]
+async fn endpoint_preparation_atomic_handoff_unmutes_only_at_commit() {
+    for observer in [false, true] {
+        let mut t = Target::new(observer).await;
+        t.room.publish("fresh", 12000).unwrap();
+        t.queue();
+        t.room.heard("fresh", 0).await;
+        let plan = t.plan().unwrap();
+        assert_eq!(
+            plan.audience().request().activate_muted,
+            Some(ConnectionId::from_string("fresh"))
+        );
+        t.room.handoff(plan).await.unwrap();
+        assert!(t.plan().is_err());
+        if observer {
+            assert!(
+                t.room.publish("fresh", 7600).is_err(),
+                "a media-only commit cannot promote the managed Participant role"
+            );
+        } else {
+            t.room.publish("fresh", 7600).unwrap();
+            t.room.tick();
+            t.room.heard("bob", 7600).await;
+            t.room.heard("alice", 7600).await;
+            t.room.silent(&["public", "fresh"]);
+        }
+        t.room.publish("bob", 2400).unwrap();
+        t.room.tick();
+        t.room.heard("fresh", 2400).await;
+        t.room.heard("alice", 2400).await;
+        t.room.silent(&["public", "bob"]);
+    }
+}
+
+#[tokio::test]
+async fn endpoint_preparation_owned_drop_invalidates_a_cloned_handle_and_old_plan() {
+    let mut t = Target::new(true).await;
+    t.room.publish("fresh", 12000).unwrap();
+    t.queue();
+    t.room.heard("fresh", 0).await;
+    let stale = t.plan().unwrap();
+    let audience = t.preparation.audience().clone();
+    t.queue();
+    let queued = t
+        .room
+        .nodes
+        .get_mut("fresh")
+        .unwrap()
+        .out
+        .try_recv()
+        .unwrap();
+    drop(t.preparation);
+    assert!(queued
+        .deliver(|_| async { panic!("dropped preparation emitted an old prompt") })
+        .await
+        .is_err());
+    assert!(t.room.publish("fresh", 12000).is_err());
+    let mut request = t.room.handoff_request(OldHandoffDisposition::Observer);
+    request.admitted = ConnectionId::from_string("fresh");
+    assert!(t
+        .room
+        .scene
+        .plan_prepared_audio_handoff(&audience, None, request)
+        .is_err());
+    assert!(t.room.handoff(stale).await.is_err());
+    t.room.publish("alice", 800).unwrap();
+    t.room.tick();
+    t.room.heard("bob", 800).await;
+    t.room.heard("public", 800).await;
+    t.room.silent(&["fresh"]);
+}
