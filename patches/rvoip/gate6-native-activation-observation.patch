+#[tokio::test]
+async fn cancelled_native_resources_have_no_publication_generation_while_adapter_route_is_retained()
+{
+    use rvoip_core::adapter::ConnectionAdapter;
+    let mut s = Scene::new_bootstrap("quic").await;
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    let proof = activation(&s).await;
+    assert_eq!(proof.try_confirmed_generation().unwrap(), None);
+    s.confirm(&callback).await;
+    admitted(&s).await;
+    assert_eq!(proof.try_confirmed_generation().unwrap(), Some(1));
+    let controller = s.controller();
+    let adapter = &s.native.adapters[&s.kind];
+    assert!(adapter.is_connection_live(&s.id));
+    // Actual Core resource cancellation precedes the adapter's asynchronous
+    // route removal. Presence alone cannot authorize Ready publication here.
+    controller.retire();
+    assert!(adapter.is_connection_live(&s.id));
+    assert!(controller.active_bindings().is_empty());
+    assert_eq!(proof.try_confirmed_generation().unwrap(), None);
+    s.wire.server.shutdown().await.unwrap();
+    assert_eq!(proof.try_confirmed_generation().unwrap(), None);
+}
