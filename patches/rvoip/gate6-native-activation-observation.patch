+    /// Nonblocking current resource observation for host publication metadata.
+    /// Busy metadata is retryable; missing, aborted or cancelled resources have
+    /// no confirmed generation. This returns no current permission or IO lease.
+    pub fn try_confirmed_generation(&self) -> ControlResult<Option<u64>> {
+        let prepared = self.prepared.try_lock().map_err(|error| match error {
+            std::sync::TryLockError::WouldBlock => StreamControlError::NotReady,
+            std::sync::TryLockError::Poisoned(_) => StreamControlError::Authority,
+        })?;
+        Ok(prepared.as_ref().and_then(|p| p.committed_generation()))
+    }
     pub fn confirmed_generation(&self) -> Option<u64> {
         self.prepared
             .lock()
