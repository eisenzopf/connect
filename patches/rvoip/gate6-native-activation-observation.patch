+#[cfg(test)]
+mod publication_tests {
+    use super::*;
+
+    #[test]
+    fn publication_observation_never_waits_for_busy_metadata_or_accepts_poison() {
+        let activation = Arc::new(NativeMediaActivation {
+            controller: Weak::new(),
+            broker: Weak::new(),
+            source: "controlled-publication-observation".into(),
+            prepared: Mutex::new(None),
+        });
+        assert_eq!(activation.try_confirmed_generation().unwrap(), None);
+        let held = activation.prepared.lock().unwrap();
+        let began = std::time::Instant::now();
+        for _ in 0..16 {
+            assert!(matches!(
+                activation.try_confirmed_generation(),
+                Err(StreamControlError::NotReady)
+            ));
+        }
+        assert!(began.elapsed() < std::time::Duration::from_millis(50));
+        drop(held);
+        assert_eq!(activation.try_confirmed_generation().unwrap(), None);
+        let other = activation.clone();
+        assert!(std::thread::spawn(move || {
+            let _held = other.prepared.lock().unwrap();
+            panic!("controlled activation metadata poison");
+        })
+        .join()
+        .is_err());
+        assert!(matches!(
+            activation.try_confirmed_generation(),
+            Err(StreamControlError::Authority)
+        ));
+    }
+}
