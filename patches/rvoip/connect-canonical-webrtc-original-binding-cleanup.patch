+#[tokio::test]
+async fn wrong_original_connection_refuses_without_cancelling_or_closing_owner() {
+    let id = ConnectionId::new();
+    let adapter = CanonicalWebRtcAdapter::new();
+    let (_owner, binding) = bound_original(&adapter, &id);
+    assert!(matches!(
+        adapter
+            .end_original_binding(ConnectionId::new(), &binding, EndReason::Normal)
+            .await,
+        Err(RvoipError::AdmissionRejected(
+            "Original WebRTC cleanup binding differs"
+        ))
+    ));
+    assert!(!binding.lifetime.is_cancelled());
+    assert!(binding.completion.get().is_none());
+    binding.shutdown().await.unwrap();
+    assert!(binding.actual_close_confirmed());
+}
+
+#[tokio::test]
+async fn unbound_pre_core_binding_is_not_a_route_cleanup_capability() {
+    let id = ConnectionId::new();
+    let adapter = CanonicalWebRtcAdapter::new();
+    let (owner, bound) = bound_original(&adapter, &id);
+    let unbound = WebRtcPhysicalBinding::new(&owner.peer(), CancellationToken::new());
+    assert!(matches!(
+        adapter
+            .end_original_binding(id, &unbound, EndReason::Normal)
+            .await,
+        Err(RvoipError::AdmissionRejected(
+            "Original WebRTC cleanup binding differs"
+        ))
+    ));
+    assert!(!unbound.lifetime.is_cancelled());
+    assert!(unbound.completion.get().is_none());
+    // A pre-Core factory owner has its own physical-only cancellation path.
+    // It cannot select a route via an unbound historical capability.
+    unbound.shutdown().await.unwrap();
+    bound.shutdown().await.unwrap();
+    assert!(unbound.actual_close_confirmed());
+    assert!(bound.actual_close_confirmed());
+}
