+#[tokio::test]
+async fn absent_route_with_only_physical_close_never_confirms_terminal_retirement() {
+    let id = ConnectionId::new();
+    let adapter = CanonicalWebRtcAdapter::new();
+    let (_owner, binding) = bound_original(&adapter, &id);
+    binding.shutdown().await.unwrap();
+    assert!(binding.actual_close_confirmed());
+    assert!(matches!(
+        adapter
+            .end_original_binding(id, &binding, EndReason::Normal)
+            .await,
+        Err(RvoipError::InvalidState(
+            "Original WebRTC terminal receipt is unavailable"
+        ))
+    ));
+    assert!(binding.terminal.lock().unwrap().is_none());
+}
