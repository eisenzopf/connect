+#[tokio::test]
+async fn same_adapter_same_id_different_binding_cannot_close_current_route() {
+    use rvoip_core::{
+        participant::{ParticipantKind, ParticipantRole},
+        relationships::IdentityBinding,
+    };
+    let id = ConnectionId::new();
+    let adapter = CanonicalWebRtcAdapter::new();
+    let (owner, current) = bound_original(&adapter, &id);
+    let slots = Arc::new(tokio::sync::Semaphore::new(1));
+    *current.capacity.lock().unwrap() = Some(slots.clone().acquire_owned().await.unwrap());
+    let shadow = WebRtcPhysicalBinding::new(&owner.peer(), CancellationToken::new());
+    shadow
+        .bind(
+            &owner.peer(),
+            &id,
+            CancellationToken::new(),
+            &adapter.identity,
+        )
+        .unwrap();
+    let principal = AuthenticatedPrincipal {
+        subject: "original-cleanup-fixture".into(),
+        tenant: Some("fixture-tenant".into()),
+        issuer: Some("fixture-issuer".into()),
+        scopes: vec![],
+        expires_at: Some(chrono::Utc::now() + chrono::Duration::minutes(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Identified {
+            credential_kind: CredentialKind::Oidc,
+        },
+    };
+    let identity =
+        IdentityBinding::from_authenticated(&principal, IdentityId::new(), chrono::Utc::now())
+            .unwrap();
+    let member = Membership::admit(
+        identity.clone(),
+        ConversationId::new(),
+        ParticipantId::new(),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+    )
+    .unwrap();
+    let endpoint = EndpointBinding::provision(
+        identity,
+        EndpointId::new(),
+        DeviceId::new(),
+        Transport::WebRtc,
+        "isolated-cleanup-control".into(),
+    )
+    .unwrap();
+    // Exercise the exact-binding check independently of the adapter identity
+    // check, including a failed/conflicting reservation's bound context.
+    let route = Arc::new(Route {
+        session: SessionId::new(),
+        member,
+        endpoint,
+        installation: Mutex::new(None),
+        binding: current.clone(),
+        peer: Arc::downgrade(&owner.peer()),
+        cancel: CancellationToken::new(),
+    });
+    adapter.routes.insert(id.clone(), route.clone());
+    assert!(matches!(
+        adapter
+            .end_original_binding(id.clone(), &shadow, EndReason::Normal)
+            .await,
+        Err(RvoipError::AdmissionRejected(
+            "Original WebRTC cleanup binding differs"
+        ))
+    ));
+    assert!(!current.lifetime.is_cancelled());
+    assert!(!shadow.lifetime.is_cancelled());
+    assert!(Arc::ptr_eq(
+        adapter.routes.get(&id).unwrap().value(),
+        &route
+    ));
+    assert!(current.completion.get().is_none());
+    assert!(shadow.completion.get().is_none());
+    // This isolated guard fixture has no registered Core sink. Its exact
+    // owner must now refuse terminal admission BEFORE releasing the route.
+    // It is not permitted to manufacture an acknowledgment from an empty queue.
+    assert!(matches!(
+        adapter
+            .end_original_binding(id.clone(), &current, EndReason::Normal)
+            .await,
+        Err(RvoipError::InvalidState(
+            "RTC Core terminal delivery unconfirmed"
+        ))
+    ));
+    assert_eq!(adapter.route_count(), 1);
+    assert_eq!(
+        slots.available_permits(),
+        0,
+        "failed terminal admission retains original quota"
+    );
+    assert!(current.terminal.lock().unwrap().is_none());
+    shadow.shutdown().await.unwrap();
+    assert!(current.actual_close_confirmed());
+    assert!(shadow.actual_close_confirmed());
+    // No Core relationship was installed by this internal identity-only test.
+    // Drop its deliberately private Route after the refusal has been checked.
+    drop(route);
+    drop(current);
+    drop(adapter);
+    assert_eq!(slots.available_permits(), 1);
+}
