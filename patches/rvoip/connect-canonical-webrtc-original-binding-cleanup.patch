+//! Cleanup failures must retain the original owner even when no route remains.
+use super::*;
+use rvoip_core::{
+    identity::{AuthenticationMethod, CredentialKind},
+    peer_admission::PeerAdmissionOwner,
+};
+
+fn bound_original(
+    adapter: &CanonicalWebRtcAdapter,
+    id: &ConnectionId,
+) -> (PeerAdmissionOwner, Arc<WebRtcPhysicalBinding>) {
+    let principal = AuthenticatedPrincipal {
+        subject: "original-cleanup-fixture".into(),
+        tenant: Some("fixture-tenant".into()),
+        issuer: Some("fixture-issuer".into()),
+        scopes: vec![],
+        expires_at: Some(chrono::Utc::now() + chrono::Duration::minutes(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Identified {
+            credential_kind: CredentialKind::Oidc,
+        },
+    };
+    let physical = CancellationToken::new();
+    let owner = PeerAdmissionOwner::new(
+        &principal,
+        IdentityId::new(),
+        DeviceId::new(),
+        physical.child_token(),
+        Default::default(),
+    )
+    .unwrap();
+    let binding = WebRtcPhysicalBinding::new(&owner.peer(), physical.child_token());
+    binding
+        .bind(&owner.peer(), id, physical.child_token(), &adapter.identity)
+        .unwrap();
+    (owner, binding)
+}
+
+#[tokio::test]
+async fn absent_route_rejoins_original_close_failure_without_retry_or_success() {
+    let id = ConnectionId::new();
+    let adapter = CanonicalWebRtcAdapter::new();
+    let (_owner, binding) = bound_original(&adapter, &id);
+    let original_joined = Arc::new(AtomicUsize::new(0));
+    let joined = original_joined.clone();
+    // The actual retained allocation task returned an ownership failure.
+    // Its completion must be joined once and cannot be replaced by absence.
+    let original_task = tokio::spawn(async move {
+        joined.fetch_add(1, Ordering::AcqRel);
+        Err(AllocationError::Worker)
+    });
+    *binding.allocation.lock().unwrap() = Some(
+        async move { original_task.await.unwrap_or(Err(AllocationError::Worker)) }
+            .boxed()
+            .shared(),
+    );
+    assert!(matches!(
+        binding.shutdown().await,
+        Err(RvoipError::InvalidState("WebRTC cleanup unconfirmed"))
+    ));
+    let completion = binding.completion.get().unwrap() as *const Completion;
+    assert_eq!(adapter.route_count(), 0);
+    for _ in 0..2 {
+        assert!(matches!(
+            adapter
+                .end_original_binding(id.clone(), &binding, EndReason::Normal)
+                .await,
+            Err(RvoipError::InvalidState("WebRTC cleanup unconfirmed"))
+        ));
+        assert_eq!(
+            binding.completion.get().unwrap() as *const Completion,
+            completion
+        );
+    }
+    assert_eq!(original_joined.load(Ordering::Acquire), 1);
+    assert!(!binding.actual_close_confirmed());
+    assert_eq!(adapter.total_allocations(), 0);
+}
