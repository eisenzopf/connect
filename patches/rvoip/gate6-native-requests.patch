@@ -0,0 +1,484 @@
+//! Actual idle-origin server offers, fresh domain authority and signed replies.
+use super::*;
+
+struct RequestProof {
+    domain: Arc<Grants>,
+    wire_domain: Arc<WirePolicy>,
+    guard: OwnedRwLockReadGuard<State>,
+    wire: OwnedRwLockReadGuard<WireGrants>,
+    principal: AuthenticatedPrincipal,
+    proposal: Envelope,
+}
+struct RequestPolicy {
+    domain: Arc<Grants>,
+    wire: Arc<WirePolicy>,
+    reads: AtomicUsize,
+    held: AtomicUsize,
+}
+impl RequestPolicy {
+    fn new(s: &Scene) -> Arc<Self> {
+        Arc::new(Self {
+            domain: s.grants.clone(),
+            wire: s.wire_policy.clone(),
+            reads: AtomicUsize::new(0),
+            held: AtomicUsize::new(0),
+        })
+    }
+}
+fn matches_proposal(template: &Envelope, request: &Envelope) -> bool {
+    template.kind() == request.kind()
+        && template.expected_revision() == request.expected_revision()
+        && template.original()["payload"] == request.original()["payload"]
+        && [
+            Scope::Conversation,
+            Scope::Session,
+            Scope::Connection,
+            Scope::Operation,
+        ]
+        .into_iter()
+        .all(|scope| template.scope(scope) == request.scope(scope))
+}
+fn validate(
+    proof: &RequestProof,
+    scope: &NativeRequestScope,
+    proposal: &Envelope,
+) -> Result<(), DispatchError> {
+    let origin = &scope.origin;
+    let id = proof
+        .wire
+        .connections
+        .get(&origin.media.wire_connection)
+        .ok_or(DispatchError::Authority)?;
+    let owner = proof.guard.owners.get(id).ok_or(DispatchError::Authority)?;
+    if owner.member.conversation() != &scope.conversation
+        || owner.presence.session() != &origin.media.session
+        || owner.connection.generation() != scope.connection_generation
+        || proof.wire.member.identity() != owner.member.identity()
+        || proof.guard.key.revoked
+    {
+        return Err(DispatchError::Authority);
+    }
+    owner
+        .connection
+        .require_current(&owner.member, &owner.presence)
+        .map_err(|_| DispatchError::Authority)?;
+    let actual =
+        credential_owner(owner.clone(), &origin.principal).map_err(|_| DispatchError::Authority)?;
+    actual
+        .actor
+        .revalidate_principal(&origin.principal, Utc::now())
+        .map_err(|_| DispatchError::Authority)?;
+    if let Payload::ConnectionOffer(offer) = proposal.payload() {
+        for stream in &offer.streams_offered {
+            use rvoip_uctp::v2::payloads::{StreamOfferDirection as D, StreamOfferKind as K};
+            let medium = match stream.kind {
+                K::Audio => Medium::Audio,
+                K::Video => Medium::Video,
+                K::Screen => Medium::Screen,
+                K::Data => Medium::Data,
+            };
+            if (matches!(stream.direction, D::Sendonly | D::Sendrecv)
+                && !actual.send_media.contains(&medium))
+                || (matches!(stream.direction, D::Recvonly | D::Sendrecv)
+                    && !actual.receive_media.contains(&medium))
+                || stream.direction == D::Inactive
+            {
+                return Err(DispatchError::Authority);
+            }
+        }
+    }
+    if proof.guard.denied
+        || proof.wire.denied
+        || !owner.may_control
+        || origin.media.connection != *id
+        || proof.guard.wires.get(&origin.media.wire_connection) != Some(id)
+        || !rvoip_core::staged_streams::reliable_data::same_credential(
+            &origin.principal,
+            &proof.principal,
+        )
+        || origin.participant != *owner.member.participant()
+        || origin.membership_epoch != owner.member.epoch()
+        || origin.identity != *owner.member.identity()
+        || origin.device != *owner.endpoint.device()
+        || origin.endpoint != *owner.endpoint.endpoint()
+        || owner.endpoint.state() != EndpointState::Verified
+        || origin.media.owner != origin.principal.ownership_key()
+        || scope.stream_revision != proposal.expected_revision().unwrap_or(u64::MAX)
+        || proposal.kind() != "connection.offer"
+        || proposal.scope(Scope::Conversation) != Some("conversation")
+        || proposal.scope(Scope::Session) != Some("session")
+        || !matches_proposal(&proof.proposal, proposal)
+        || proposal.original()["payload"]["by_participant"] != origin.participant.as_str()
+    {
+        return Err(DispatchError::Authority);
+    }
+    credential_owner(owner.clone(), &origin.principal).map_err(|_| DispatchError::Authority)?;
+    Ok(())
+}
+#[async_trait]
+impl NativeRequestPolicy for RequestPolicy {
+    async fn authorize(
+        &self,
+        scope: &NativeRequestScope,
+        proposal: &Envelope,
+        held: Option<&AuthorityLease>,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if let Some(held) = held {
+            let proof = held
+                .authority::<RequestProof>()
+                .ok_or(DispatchError::Authority)?;
+            if !Arc::ptr_eq(&self.domain, &proof.domain)
+                || !Arc::ptr_eq(&self.wire, &proof.wire_domain)
+                || !held.current()
+            {
+                return Err(DispatchError::Authority);
+            }
+            validate(proof, scope, proposal)?;
+            self.held.fetch_add(1, Ordering::AcqRel);
+            return Ok(held.retained());
+        }
+        let wire = self.wire.grants.clone().read_owned().await;
+        let guard = self.domain.0.clone().read_owned().await;
+        let proof = RequestProof {
+            domain: self.domain.clone(),
+            wire_domain: self.wire.clone(),
+            guard,
+            wire,
+            principal: scope.origin.principal.clone(),
+            proposal: proposal.clone(),
+        };
+        validate(&proof, scope, proposal)?;
+        self.reads.fetch_add(1, Ordering::AcqRel);
+        Ok(AuthorityLease::holding(proof))
+    }
+}
+pub(super) fn reply(
+    c: &ValidatedBearer,
+    request: &Envelope,
+    response: &Envelope,
+    held: &AuthorityLease,
+) -> Option<Result<ExchangeReplyAuthority, DispatchError>> {
+    let proof = held.authority::<RequestProof>()?;
+    Some((|| {
+        if !held.current()
+            || proof.guard.denied
+            || proof.wire.denied
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &proof.principal,
+                &c.principal,
+            )
+            || !matches_proposal(&proof.proposal, request)
+            || response.scope(Scope::Reply) != Some(request.id())
+            || [
+                Scope::Conversation,
+                Scope::Session,
+                Scope::Connection,
+                Scope::Operation,
+            ]
+            .into_iter()
+            .any(|scope| request.scope(scope) != response.scope(scope))
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        let key = PrincipalVerificationKey::from_current(
+            &c.principal,
+            "client".into(),
+            proof.guard.key.clone(),
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        Ok(ExchangeReplyAuthority {
+            lease: held.retained(),
+            key,
+        })
+    })())
+}
+async fn setup(
+    kind: &str,
+    source_window: u64,
+) -> (Scene, Arc<NativeRequestOrigin>, Arc<RequestPolicy>) {
+    let mut s = Scene::new_bootstrap(kind).await;
+    s.record.server_requests.store(true, Ordering::Release);
+    s.grants.0.write().await.source_lease_ms = source_window;
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    s.confirm(&callback).await;
+    core_fixture::until(|| s.record.request_origins.lock().unwrap().contains_key(&s.id)).await;
+    let origin = s.record.request_origins.lock().unwrap()[&s.id].clone();
+    core_fixture::until(|| origin.ready()).await;
+    let policy = RequestPolicy::new(&s);
+    (s, origin, policy)
+}
+fn proposal(s: &Scene, revision: u64, operation: &str) -> Envelope {
+    let mut request = lifecycle_offer(s, 0, revision, "recvonly");
+    request["operation_id"] = json!(operation);
+    let binding = s.controller().active_bindings()[0].clone();
+    request["payload"]["substrate_setup"] = json!({"kind":"native-prepared/1","revision":revision+1,
+        "offer_id":operation,"streams":[{"strm_id":"first","kind":"audio","direction":"recvonly",
+        "stream_local_id":binding.stream_local_id,"codec":{"name":"pcmu","params":{"sample_rate":8000,"channels":1,"payload_type":0}}}]});
+    Envelope::from_value(request).unwrap()
+}
+async fn callback(s: &mut Scene) -> Envelope {
+    let callback = s.wire.read().await;
+    assert_eq!(callback.kind(), "connection.offer");
+    s.f.verify_server(&callback).await;
+    callback
+}
+#[tokio::test]
+async fn actual_native_server_request_uses_fresh_authority_after_source_deadline_and_retains_no_idle_reader(
+) {
+    for kind in ["quic", "wt"] {
+        let (mut s, origin, policy) = setup(kind, 400).await;
+        tokio::time::sleep(Duration::from_millis(450)).await;
+        let wire = s.wire_policy.grants.clone().try_write_owned().unwrap();
+        drop(wire);
+        let domain = s.grants.0.clone().try_write_owned().unwrap();
+        drop(domain);
+        let request = proposal(&s, 1, "future_subscription");
+        let o = origin.clone();
+        let p = policy.clone();
+        let task = tokio::spawn(async move {
+            o.request(request, p, deadline(), CancellationToken::new())
+                .await
+        });
+        let offer = callback(&mut s).await;
+        assert_eq!(offer.scope(Scope::Operation), Some("future_subscription"));
+        s.confirm(&offer).await;
+        let reply = task.await.unwrap().unwrap();
+        assert!(reply.current());
+        assert!(reply.authority::<RequestProof>().is_some());
+        assert_eq!(reply.response().scope(Scope::Reply), Some(offer.id()));
+        assert_eq!(policy.reads.load(Ordering::Acquire), 1);
+        let gate = s.grants.0.clone();
+        let writer = tokio::spawn(async move { gate.write_owned().await });
+        tokio::task::yield_now().await;
+        assert!(!writer.is_finished());
+        drop(reply);
+        drop(
+            tokio::time::timeout(Duration::from_millis(500), writer)
+                .await
+                .unwrap()
+                .unwrap(),
+        );
+        assert!(origin.ready());
+        s.wire.server.shutdown().await.unwrap();
+    }
+}
+#[tokio::test]
+async fn actual_native_server_request_refuses_foreign_stale_denied_and_bad_reply_scopes_without_consuming_valid_reply(
+) {
+    let (mut s, origin, policy) = setup("quic", 0).await;
+    let stale = proposal(&s, 0, "stale_server_proposal");
+    assert!(origin
+        .request(stale, policy.clone(), deadline(), CancellationToken::new())
+        .await
+        .is_err());
+    let mut foreign = proposal(&s, 1, "foreign_server_proposal")
+        .original()
+        .clone();
+    foreign["connid"] = json!("native_1");
+    assert!(origin
+        .request(
+            Envelope::from_value(foreign).unwrap(),
+            policy.clone(),
+            deadline(),
+            CancellationToken::new()
+        )
+        .await
+        .is_err());
+    s.grants.0.write().await.denied = true;
+    assert!(matches!(
+        origin
+            .request(
+                proposal(&s, 1, "denied_server_proposal"),
+                policy.clone(),
+                deadline(),
+                CancellationToken::new()
+            )
+            .await,
+        Err(DispatchError::Authority)
+    ));
+    s.grants.0.write().await.denied = false;
+    s.wire_policy.grants.write().await.denied = true;
+    assert!(origin
+        .request(
+            proposal(&s, 1, "denied_wire_proposal"),
+            policy.clone(),
+            deadline(),
+            CancellationToken::new()
+        )
+        .await
+        .is_err());
+    s.wire_policy.grants.write().await.denied = false;
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&s.id)
+        .unwrap()
+        .receive_media
+        .remove(&Medium::Audio);
+    assert!(origin
+        .request(
+            proposal(&s, 1, "denied_media_proposal"),
+            policy.clone(),
+            deadline(),
+            CancellationToken::new()
+        )
+        .await
+        .is_err());
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&s.id)
+        .unwrap()
+        .receive_media
+        .insert(Medium::Audio);
+    let p = policy.clone();
+    let o = origin.clone();
+    let request = proposal(&s, 1, "retry_valid_server_proposal");
+    let task = tokio::spawn(async move {
+        o.request(request, p, deadline(), CancellationToken::new())
+            .await
+    });
+    let offer = callback(&mut s).await;
+    let mut wrong = s.confirmation(&offer);
+    wrong["sid"] = json!("foreign");
+    s.wire.send(s.f.sign(wrong)).await;
+    let error = s.wire.read().await;
+    assert_eq!(error.kind(), "error");
+    s.f.verify_server(&error).await;
+    assert!(!task.is_finished());
+    s.confirm(&offer).await;
+    drop(task.await.unwrap().unwrap());
+    assert_eq!(s.controller().revision(), 1);
+    assert_eq!(s.controller().stream_open_budget().0, 1);
+    s.wire.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_server_request_held_fresh_grant_survives_queued_writer_without_storage_reentry(
+) {
+    let (mut s, origin, policy) = setup("quic", 0).await;
+    let request = proposal(&s, 1, "held_server_proposal");
+    let scope = origin.request_scope(1);
+    let held = policy.authorize(&scope, &request, None).await.unwrap();
+    let gate = s.grants.0.clone();
+    let writer = tokio::spawn(async move { gate.write_owned().await });
+    tokio::task::yield_now().await;
+    assert!(!writer.is_finished());
+    let o = origin.clone();
+    let p = policy.clone();
+    let task = tokio::spawn(async move {
+        o.request_with_held(request, p, held, deadline(), CancellationToken::new())
+            .await
+    });
+    let offer = callback(&mut s).await;
+    s.confirm(&offer).await;
+    let reply = tokio::time::timeout(Duration::from_secs(1), task)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert!(reply.current());
+    assert_eq!(policy.reads.load(Ordering::Acquire), 1);
+    assert_eq!(policy.held.load(Ordering::Acquire), 1);
+    assert!(!writer.is_finished());
+    drop(reply);
+    drop(
+        tokio::time::timeout(Duration::from_millis(500), writer)
+            .await
+            .unwrap()
+            .unwrap(),
+    );
+    s.wire.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_server_request_serializes_negotiation_and_cancellation_is_uncertain_after_write(
+) {
+    let (mut s, origin, policy) = setup("quic", 0).await;
+    let request = proposal(&s, 1, "stable_server_operation");
+    let cancel = CancellationToken::new();
+    let stop = cancel.clone();
+    let o = origin.clone();
+    let p = policy.clone();
+    let task = tokio::spawn(async move { o.request(request, p, deadline(), stop).await });
+    let offer = callback(&mut s).await;
+    gate_reply(
+        &mut s,
+        gate_command("mute", 1, Some(&["first"]), None),
+        "error",
+    )
+    .await;
+    assert_eq!(s.controller().revision(), 1);
+    assert!(matches!(
+        s.record.controls.lock().unwrap().last().unwrap(),
+        Err(NativeOfferError::Conflict)
+    ));
+    let second = origin
+        .request(
+            proposal(&s, 1, "overlapping_server_operation"),
+            policy.clone(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await;
+    assert!(matches!(second, Err(DispatchError::Capacity)));
+    cancel.cancel();
+    assert!(matches!(
+        task.await.unwrap(),
+        Err(DispatchError::SubmissionUnknown)
+    ));
+    s.confirm(&offer).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    gate_reply(
+        &mut s,
+        gate_command("mute", 1, Some(&["first"]), None),
+        "ack",
+    )
+    .await;
+    assert_eq!(s.controller().revision(), 2);
+    let request = proposal(&s, 2, "stable_server_operation");
+    let o = origin.clone();
+    let p = policy.clone();
+    let task = tokio::spawn(async move {
+        o.request(request, p, deadline(), CancellationToken::new())
+            .await
+    });
+    let offer = callback(&mut s).await;
+    s.confirm(&offer).await;
+    drop(task.await.unwrap().unwrap());
+    assert_eq!(s.controller().revision(), 2);
+    s.wire.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_server_request_cancel_before_submission_and_eof_release_active_authority() {
+    let (mut s, origin, policy) = setup("quic", 0).await;
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(matches!(
+        origin
+            .request(
+                proposal(&s, 1, "cancelled_server_operation"),
+                policy.clone(),
+                deadline(),
+                cancel
+            )
+            .await,
+        Err(DispatchError::Closed)
+    ));
+    assert_eq!(policy.reads.load(Ordering::Acquire), 0);
+    let o = origin.clone();
+    let p = policy.clone();
+    let request = proposal(&s, 1, "eof_server_operation");
+    let task = tokio::spawn(async move {
+        o.request(request, p, deadline(), CancellationToken::new())
+            .await
+    });
+    let _offer = callback(&mut s).await;
+    s.wire.server.shutdown().await.unwrap();
+    assert!(task.await.unwrap().is_err());
+    core_fixture::until(|| !origin.current()).await;
+    drop(s.grants.0.clone().try_write_owned().unwrap());
+    drop(s.wire_policy.grants.clone().try_write_owned().unwrap());
+}
