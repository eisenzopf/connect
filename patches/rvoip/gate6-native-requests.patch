+            domain: domain.clone(),
+            live: live.clone(),
+            entered: entered.clone(),
+        };
+        let epoch = CancellationToken::new();
+        let started = Arc::new(AtomicBool::new(false));
+        let permit = AnswerPermit::request(
+            AuthorityLease::holding(domain.clone().read_owned().await),
+            epoch.child_token(),
+            Instant::now() + Duration::from_secs(1),
