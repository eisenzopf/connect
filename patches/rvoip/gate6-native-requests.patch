+//! Fresh scoped server requests for native parameter reconciliation.
+//! An idle origin carries metadata; an active exchange owns its current grant.
+use super::{
+    auth_dispatch::lifecycle::NativeLifecycleFence, auth_dispatch::*,
+    native_lifecycle::NativeLifecycleScope, Envelope, Scope,
+};
+use crate::{native_flow::NativeFlow, staged_media::StagedRtpScope};
+use async_trait::async_trait;
+use rvoip_core::{
+    relationships::{EndpointBinding, Membership},
+    staged_streams::StreamController,
+};
+use std::{
+    sync::{Arc, Weak},
+    time::Duration,
+};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+pub struct NativeRequestScope {
+    pub origin: Arc<NativeLifecycleScope>,
+    pub stream_revision: u64,
+    pub conversation: rvoip_core::ids::ConversationId,
+    pub connection_generation: u64,
+    pub credential_revision: u64,
+}
+#[async_trait]
+pub trait NativeRequestPolicy: Send + Sync {
+    /// Derive current exact actor/resource/operation/key authority. With held
+    /// authority, verify this same domain and intent without storage reentry.
+    /// The original request grant is never inferred from the retained origin.
+    async fn authorize(
+        &self,
+        scope: &NativeRequestScope,
+        proposal: &Envelope,
+        held: Option<&AuthorityLease>,
+    ) -> Result<AuthorityLease, DispatchError>;
+}
+struct RequestFence {
+    origin: DataOrigin,
+    controller: Weak<StreamController>,
+    flow: Arc<NativeFlow>,
+    revision: u64,
+    epoch: CancellationToken,
+}
+impl NativeLifecycleFence for RequestFence {
+    fn current(&self) -> bool {
+        !self.epoch.is_cancelled()
+            && self.origin.current()
+            && self
+                .controller
+                .upgrade()
+                .is_some_and(|c| c.revision() == self.revision)
+            && self.flow.confirmed_at(self.revision)
+            && !self.epoch.is_cancelled()
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.epoch.child_token()
+    }
+}
+pub struct NativeRequestOrigin {
+    origin: DataOrigin,
+    context: super::auth_peer::exchange::ExchangeContext,
+    controller: Weak<StreamController>,
+    flow: Arc<NativeFlow>,
+    scope: Arc<NativeLifecycleScope>,
+    substrate: &'static str,
+    request_slot: Arc<tokio::sync::Semaphore>,
+    conversation: rvoip_core::ids::ConversationId,
+    connection_generation: u64,
+    credential_revision: u64,
+}
+impl std::fmt::Debug for NativeRequestOrigin {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeRequestOrigin(redacted)")
+    }
+}
+/// Exact signed reply plus the active exchange's real current grant. This is
+/// bounded mutation custody, not an idle registration or durable receipt.
+pub struct NativeRequestReply {
+    origin: Arc<NativeRequestOrigin>,
+    fence: Arc<RequestFence>,
+    scope: NativeRequestScope,
+    proposal: Envelope,
+    response: Envelope,
+    authority: AuthorityLease,
+    deadline: Instant,
+    cancel: CancellationToken,
+    _request_slot: tokio::sync::OwnedSemaphorePermit,
+}
+impl std::fmt::Debug for NativeRequestReply {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeRequestReply(redacted)")
+    }
+}
+impl NativeRequestReply {
+    pub fn proposal(&self) -> &Envelope {
+        &self.proposal
+    }
+    pub fn response(&self) -> &Envelope {
+        &self.response
+    }
+    pub fn scope(&self) -> &NativeRequestScope {
+        &self.scope
+    }
+    pub fn current(&self) -> bool {
+        !self.cancel.is_cancelled()
+            && Instant::now() < self.deadline
+            && self.origin.current()
+            && self.fence.current()
+            && self.authority.current()
+    }
+    /// Borrow only during the checked mutation. No new authorization proof is
+    /// fabricated; the value is the actual policy's retained current guard.
+    pub fn authority<T: std::any::Any + Send + Sync>(&self) -> Option<&T> {
+        self.current()
+            .then(|| self.authority.authority::<T>())
+            .flatten()
+    }
+}
+impl NativeRequestOrigin {
+    pub(crate) fn new(
+        a: &AuthorizedEnvelope,
+        controller: &Arc<StreamController>,
+        flow: Arc<NativeFlow>,
+        scope: StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        substrate: &'static str,
+        request_slot: Arc<tokio::sync::Semaphore>,
+    ) -> Result<Arc<Self>, DispatchError> {
+        if !flow.confirmed_for(controller.revision(), a.envelope().id()) {
+            return Err(DispatchError::Authority);
+        }
+        let origin = DataOrigin::seal(a, controller, scope.clone(), member, endpoint)?;
+        let context = a.native_exchange_context(origin.cancellation(), origin.deadline())?;
+        Ok(Arc::new(Self {
+            origin,
+            context,
+            controller: Arc::downgrade(controller),
+            flow,
+            scope: Arc::new(NativeLifecycleScope {
+                principal: a.principal().clone(),
+                media: scope,
+                participant: member.participant().clone(),
+                membership_epoch: member.epoch(),
+                device: endpoint.device().clone(),
+                endpoint: endpoint.endpoint().clone(),
+                identity: member.identity().clone(),
+            }),
+            substrate,
+            request_slot,
+            conversation: member.conversation().clone(),
+            connection_generation: controller
+                .active_bindings()
+                .first()
+                .ok_or(DispatchError::Authority)?
+                .connection_generation,
+            credential_revision: controller.credential_revision(),
+        }))
+    }
+    pub fn request_scope(&self, stream_revision: u64) -> NativeRequestScope {
+        NativeRequestScope {
+            origin: self.scope.clone(),
+            stream_revision,
+            conversation: self.conversation.clone(),
+            connection_generation: self.connection_generation,
+            credential_revision: self.credential_revision,
+        }
+    }
+    pub fn current(&self) -> bool {
+        self.origin.current()
+    }
+    pub fn ready(&self) -> bool {
+        self.origin.is_ready() && self.current()
+    }
+    pub fn retire(&self) {
+        self.origin.retire()
+    }
+    pub async fn request(
+        self: &Arc<Self>,
+        proposal: Envelope,
+        policy: Arc<dyn NativeRequestPolicy>,
+        deadline: Instant,
+        cancel: CancellationToken,
+    ) -> Result<NativeRequestReply, DispatchError> {
+        self.request_inner(proposal, policy, None, deadline, cancel)
+            .await
+    }
+    /// A server mutation may already own a freshly acquired guard. The explicit
+    /// policy hook must validate it instead of reacquiring behind a queued writer.
+    pub async fn request_with_held(
+        self: &Arc<Self>,
+        proposal: Envelope,
+        policy: Arc<dyn NativeRequestPolicy>,
+        held: AuthorityLease,
+        deadline: Instant,
+        cancel: CancellationToken,
+    ) -> Result<NativeRequestReply, DispatchError> {
+        self.request_inner(proposal, policy, Some(held), deadline, cancel)
+            .await
+    }
+    async fn request_inner(
+        self: &Arc<Self>,
+        proposal: Envelope,
+        policy: Arc<dyn NativeRequestPolicy>,
+        held: Option<AuthorityLease>,
+        requested: Instant,
+        cancel: CancellationToken,
+    ) -> Result<NativeRequestReply, DispatchError> {
+        if !self.ready() {
+            return Err(DispatchError::Authority);
+        }
+        let revision = proposal
+            .expected_revision()
+            .ok_or(DispatchError::ReplyMismatch)?;
+        if proposal.kind() != "connection.offer"
+            || proposal.scope(Scope::Reply).is_some()
+            || proposal.scope(Scope::Operation).is_none()
+            || proposal.scope(Scope::Conversation) != self.scope.media.wire_conversation.as_deref()
+            || proposal.scope(Scope::Session) != Some(self.scope.media.wire_session.as_str())
+            || proposal.scope(Scope::Connection) != Some(self.scope.media.wire_connection.as_str())
+            || proposal.original()["payload"]["substrate"] != self.substrate
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        super::scope_policy::require(&self.scope.principal, proposal.payload())?;
+        let deadline = requested
+            .min(self.origin.deadline())
+            .min(Instant::now() + Duration::from_secs(30));
+        let fence = Arc::new(RequestFence {
+            origin: self.origin.clone(),
+            controller: self.controller.clone(),
+            flow: self.flow.clone(),
+            revision,
+            epoch: self.flow.epoch(),
+        });
+        if !fence.current() || deadline <= Instant::now() {
+            return Err(DispatchError::Closed);
+        }
+        let request_slot = self
+            .request_slot
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| DispatchError::Capacity)?;
+        let scoped = self.request_scope(revision);
+        let retired = self.origin.cancellation();
+        let changed = fence.cancellation();
+        let authority = tokio::select! {biased;
+            _=retired.cancelled()=>return Err(DispatchError::Closed),
+            _=changed.cancelled()=>return Err(DispatchError::Closed),
+            _=cancel.cancelled()=>return Err(DispatchError::Closed),
+            _=tokio::time::sleep_until(deadline)=>return Err(DispatchError::Closed),
+            r=policy.authorize(&scoped,&proposal,held.as_ref())=>r?,
+        };
+        if !authority.current() || !fence.current() {
+            return Err(DispatchError::Authority);
+        }
+        let (response, authority, deadline) = self
+            .context
+            .native_request(
+                proposal.clone(),
+                authority,
+                deadline,
+                cancel.clone(),
+                fence.clone(),
+                self.origin.incarnation(),
+            )
+            .await?;
+        let reply = NativeRequestReply {
+            origin: self.clone(),
+            fence,
+            scope: scoped,
+            proposal,
+            response,
+            authority,
+            deadline,
+            cancel,
+            _request_slot: request_slot,
+        };
+        if !reply.current() {
+            return Err(DispatchError::SubmissionUnknown);
+        }
+        Ok(reply)
+    }
+}
+impl Drop for NativeRequestOrigin {
+    fn drop(&mut self) {
+        self.origin.retire();
+    }
+}
