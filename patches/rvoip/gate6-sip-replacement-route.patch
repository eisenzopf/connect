+//! Actual loopback SIP signaling through the reserved Core adapter hooks.
+//! No guarded SIP media/movement or public Connect projection is claimed here.
+use super::*;
+use rvoip_core::adapter::ConnectionAdapter;
+use rvoip_sip::{
+    api::unified::{Config as SipConfig, UnifiedCoordinator},
+    SipAdapter, SipDeviceReplacementContext, SipDeviceReplacementSignal, SipOriginateContext,
+};
+use rvoip_sip_core::{
+    parser::parse_message,
+    prelude::{Contact, HeaderName, Message, Method, StatusCode, TypedHeader},
+    types::headers::HeaderAccess,
+};
+use rvoip_sip_dialog::transaction::utils::response_builders::create_response;
+use std::{net::SocketAddr, str::FromStr};
+use tokio::net::UdpSocket;
+struct Dialog {
+    remote: SocketAddr,
+    from: String,
+    to: String,
+    call_id: String,
+}
+struct Peer {
+    socket: Arc<UdpSocket>,
+    _media: UdpSocket,
+    dialog: Arc<Mutex<Option<Dialog>>>,
+    invites: Arc<Mutex<Vec<String>>>,
+    methods: Arc<Mutex<Vec<Method>>>,
+    task: tokio::task::JoinHandle<()>,
+}
+impl Peer {
+    async fn new(answer: bool) -> Self {
+        let socket = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+        let address = socket.local_addr().unwrap();
+        let media = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let media_port = media.local_addr().unwrap().port();
+        let dialog = Arc::new(Mutex::new(None));
+        let invites = Arc::new(Mutex::new(Vec::new()));
+        let methods = Arc::new(Mutex::new(Vec::new()));
+        let wire = socket.clone();
+        let seen_dialog = dialog.clone();
+        let seen_invites = invites.clone();
+        let seen_methods = methods.clone();
+        let task = tokio::spawn(async move {
+            let mut packet = [0u8; 16_384];
+            let mut original = None;
+            loop {
+                let (n, remote) = wire.recv_from(&mut packet).await.unwrap();
+                let Ok(Message::Request(request)) = parse_message(&packet[..n]) else {
+                    continue;
+                };
+                seen_methods.lock().unwrap().push(request.method());
+                if request.method() == Method::Ack {
+                    continue;
+                }
+                let mut response = create_response(
+                    &request,
+                    if request.method() == Method::Invite && !answer {
+                        StatusCode::Ringing
+                    } else {
+                        StatusCode::Ok
+                    },
+                );
+                if request.method() == Method::Invite {
+                    original = Some(request.clone());
+                    seen_invites
+                        .lock()
+                        .unwrap()
+                        .push(request.call_id().unwrap().value());
+                    if let Some(TypedHeader::To(to)) = response
+                        .headers
+                        .iter_mut()
+                        .find(|h| matches!(h, TypedHeader::To(_)))
+                    {
+                        to.set_tag("replacement-sip-peer");
+                    }
+                    *seen_dialog.lock().unwrap() = Some(Dialog {
+                        remote,
+                        from: request.raw_header_value(&HeaderName::From).unwrap(),
+                        to: response.raw_header_value(&HeaderName::To).unwrap(),
+                        call_id: request.call_id().unwrap().value(),
+                    });
+                    if answer {
+                        response.headers.push(TypedHeader::Contact(
+                            Contact::from_str(&format!("<sip:peer@{address}>")).unwrap(),
+                        ));
+                        response.headers.push(TypedHeader::ContentType(
+                            rvoip_sip_core::types::ContentType::sdp(),
+                        ));
+                        response.body=bytes::Bytes::from(format!("v=0\r\no=replacement 1 1 IN IP4 127.0.0.1\r\ns=replacement\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\nm=audio {media_port} RTP/AVP 0 101\r\na=rtpmap:0 PCMU/8000\r\na=rtpmap:101 telephone-event/8000\r\na=fmtp:101 0-15\r\na=sendrecv\r\n"));
+                        response
+                            .headers
+                            .retain(|h| !matches!(h, TypedHeader::ContentLength(_)));
+                        response.headers.push(TypedHeader::ContentLength(
+                            rvoip_sip_core::types::ContentLength::new(response.body.len() as u32),
+                        ));
+                    }
+                }
+                wire.send_to(&Message::Response(response).to_bytes(), remote)
+                    .await
+                    .unwrap();
+                if request.method() == Method::Cancel {
+                    let mut final_response =
+                        create_response(original.as_ref().unwrap(), StatusCode::RequestTerminated);
+                    if let Some(TypedHeader::To(to)) = final_response
+                        .headers
+                        .iter_mut()
+                        .find(|h| matches!(h, TypedHeader::To(_)))
+                    {
+                        to.set_tag("replacement-sip-peer");
+                    }
+                    wire.send_to(&Message::Response(final_response).to_bytes(), remote)
+                        .await
+                        .unwrap();
+                }
+            }
+        });
+        Self {
+            socket,
+            _media: media,
+            dialog,
+            invites,
+            methods,
+            task,
+        }
+    }
+    fn address(&self) -> SocketAddr {
+        self.socket.local_addr().unwrap()
+    }
+    fn calls(&self) -> usize {
+        self.invites
+            .lock()
+            .unwrap()
+            .iter()
+            .collect::<BTreeSet<_>>()
+            .len()
+    }
+    async fn digit(&self, digit: &str) {
+        let (remote, from, to, call_id) = {
+            let guard = self.dialog.lock().unwrap();
+            let d = guard.as_ref().unwrap();
+            (d.remote, d.to.clone(), d.from.clone(), d.call_id.clone())
+        };
+        let body = format!("Signal={digit}\r\nDuration=160\r\n");
+        let message=format!("INFO sip:replacement@{remote} SIP/2.0\r\nVia: SIP/2.0/UDP {};branch=z9hG4bK-replacement-{};rport\r\nMax-Forwards: 70\r\nFrom: {from}\r\nTo: {to}\r\nCall-ID: {call_id}\r\nCSeq: 2 INFO\r\nContent-Type: application/dtmf-relay\r\nContent-Length: {}\r\n\r\n{body}",self.address(),uuid::Uuid::new_v4().simple(),body.len());
+        self.socket
+            .send_to(message.as_bytes(), remote)
+            .await
+            .unwrap();
+    }
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+struct Candidate {
+    pending: Arc<DeviceReplacementPreparation>,
+    adapter: Arc<SipAdapter>,
+    coordinator: Arc<UnifiedCoordinator>,
+    context: Arc<SipDeviceReplacementContext>,
+    signals: mpsc::Receiver<SipDeviceReplacementSignal>,
+    principal: AuthenticatedPrincipal,
+}
+impl Candidate {
+    async fn new(s: &Scene, peer: &Peer) -> Self {
+        let old = s.grants.0.read().await.owners[&s.live[0].leg.id].clone();
+        let principal = named_actor("alice");
+        let identity = IdentityBinding::from_authenticated(
+            &principal,
+            old.member.identity().clone(),
+            Utc::now(),
+        )
+        .unwrap();
+        let mut endpoint = EndpointBinding::provision(
+            identity.clone(),
+            EndpointId::from_string("endpoint_alice_actual_sip"),
+            DeviceId::from_string("device_alice_actual_sip"),
+            Transport::Sip,
+            format!("sip:peer@{}", peer.address()),
+        )
+        .unwrap();
+        endpoint
+            .verify(&identity, "actual-loopback-sip-route".into(), Utc::now())
+            .unwrap();
+        let id = ConnectionId::new();
+        let intent = ParticipantReplacementMutation {
+            operation_id: "actual-sip-replacement".into(),
+            correlation_id: "actual-sip-replacement".into(),
+            expected_revision: s.core.orch.participant_revision(&s.core.session).unwrap(),
+            participant: old.member.participant().clone(),
+            source: s.live[0].leg.id.clone(),
+            replacement: id.clone(),
+            retained: s.live[1].leg.id.clone(),
+            endpoint: endpoint.endpoint().clone(),
+            device: endpoint.device().clone(),
+            confirmation: EndpointConfirmationPolicy::AnsweredDtmf { digits: "5".into() },
+        };
+        let mut planned = old.clone();
+        planned.endpoint = endpoint.clone();
+        planned.connection =
+            ConnectionBinding::prepare(&old.member, &old.presence, &endpoint, id.clone()).unwrap();
+        s.grants.0.write().await.owners.insert(id.clone(), planned);
+        let coordinator = UnifiedCoordinator::new(SipConfig::local("replacement-uac", 0))
+            .await
+            .unwrap();
+        let adapter = SipAdapter::new(coordinator.clone()).await.unwrap();
+        s.core.orch.register(adapter.clone()).unwrap();
+        let g = grant(s, &intent, &principal, Approval::Prepare).await;
+        let pending = s
+            .core
+            .orch
+            .prepare_staged_device_replacement_with_held(
+                &s.core.session,
+                principal.clone(),
+                intent.clone(),
+                tokio::time::Instant::now() + Duration::from_secs(15),
+                CancellationToken::new(),
+                &g,
+            )
+            .unwrap();
+        drop(g);
+        let prepared = pending.prepared_binding();
+        {
+            let mut state = s.grants.0.write().await;
+            let owner = state.owners.get_mut(&id).unwrap();
+            owner.connection = prepared.binding().clone();
+            owner.presence = prepared.appearance().clone();
+        }
+        s.replacement_media
+            .as_ref()
+            .unwrap()
+            .resources
+            .lock()
+            .unwrap()
+            .insert(
+                id.clone(),
+                Resources {
+                    pending: prepared,
+                    proof: None,
+                },
+            );
+        let context = adapter
+            .device_replacement_context(
+                &s.core.orch,
+                &pending,
+                principal.clone(),
+                endpoint,
+                SipOriginateContext::default(),
+            )
+            .unwrap();
+        assert!(context.prepared_call_reference().is_err());
+        let signals = context.take_signals().unwrap();
+        assert!(context.take_signals().is_err());
+        let g = grant(s, &intent, &principal, Approval::Allocate).await;
+        assert_eq!(
+            s.core
+                .orch
+                .prepare_adapter_device_replacement_with_held(&pending, context.clone(), &g)
+                .unwrap(),
+            id
+        );
+        drop(g);
+        assert!(adapter.is_connection_live(&id));
+        assert_eq!(
+            context.prepared_call_reference().unwrap().kind(),
+            "sip.call-id"
+        );
+        assert!(adapter.streams(id.clone()).await.is_err());
+        assert!(adapter
+            .device_replacement_signal_principal(&id, context.as_ref())
+            .is_none());
+        assert_eq!(peer.calls(), 0);
+        assert!(peer.methods.lock().unwrap().is_empty());
+        assert!(coordinator.list_sessions().await.is_empty());
+        Self {
+            pending,
+            adapter,
+            coordinator,
+            context,
+            signals,
+            principal,
+        }
+    }
+    async fn signal(&mut self, s: &Scene) -> Observation {
+        let signal = tokio::time::timeout(Duration::from_secs(3), self.signals.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(signal.connection(), &self.pending.intent().replacement);
+        let g = grant(
+            s,
+            self.pending.intent(),
+            &self.principal,
+            Approval::Signal(signal.event().clone()),
+        )
+        .await;
+        signal.into_event().observe_with_held(&g).unwrap()
+    }
+    async fn stop(&self, peer: &Peer, terminal: Option<Method>) {
+        self.pending.cancel();
+        if let Some(method) = terminal {
+            core_fixture::until(|| peer.methods.lock().unwrap().contains(&method)).await;
+        }
+        core_fixture::until(|| {
+            !self
+                .adapter
+                .is_connection_live(&self.pending.intent().replacement)
+        })
+        .await;
+        self.adapter.drain().await.unwrap();
+        self.coordinator
+            .shutdown_gracefully(Some(Duration::from_secs(3)))
+            .await
+            .unwrap();
+        assert!(!self
+            .adapter
+            .is_connection_live(&self.pending.intent().replacement));
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_sip_replacement_reserved_route_answers_and_captures_only_real_dialog_dtmf() {
+    let s = Scene::new_replacement("quic").await;
+    let peer = Peer::new(true).await;
+    let mut c = Candidate::new(&s, &peer).await;
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert_eq!(peer.calls(), 0);
+    let before_submit = c.context.prepared_call_reference().unwrap();
+    let g = grant(&s, c.pending.intent(), &c.principal, Approval::Start).await;
+    let receipt = s
+        .core
+        .orch
+        .start_adapter_device_replacement_with_held(&c.pending, &g)
+        .await
+        .unwrap();
+    drop(g);
+    assert_eq!(receipt.external_references().len(), 1);
+    assert_eq!(
+        receipt.external_references()[0].expose_secret(),
+        before_submit.expose_secret()
+    );
+    assert_eq!(
+        peer.dialog.lock().unwrap().as_ref().unwrap().call_id,
+        before_submit.expose_secret()
+    );
+    assert_eq!(c.signal(&s).await, Observation::Answered);
+    core_fixture::until(|| peer.methods.lock().unwrap().contains(&Method::Ack)).await;
+    peer.digit("5").await;
+    let signal = tokio::time::timeout(Duration::from_secs(3), c.signals.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        signal.event(),
+        &DeviceReplacementEndpointEvent::Dtmf { digits: "5".into() }
+    );
+    let captured = signal.into_event();
+    let event = DeviceReplacementEndpointEvent::Dtmf { digits: "5".into() };
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.principal,
+        Approval::Signal(event.clone()),
+    )
+    .await;
+    assert_eq!(
+        captured.observe_with_held(&g).unwrap(),
+        Observation::BeforeAnswerOrMedia
+    );
+    drop(g);
+    assert!(s
+        .core
+        .orch
+        .plan_staged_device_replacement(&c.pending)
+        .is_err());
+    for _ in 0..2 {
+        let g = grant(&s, c.pending.intent(), &c.principal, Approval::Start).await;
+        let replay = s
+            .core
+            .orch
+            .start_adapter_device_replacement_with_held(&c.pending, &g)
+            .await
+            .unwrap();
+        assert_eq!(
+            replay.external_references()[0].expose_secret(),
+            receipt.external_references()[0].expose_secret()
+        );
+    }
+    assert_eq!(peer.calls(), 1);
+    assert_eq!(
+        format!("{:?}", c.context),
+        "SipDeviceReplacementContext(redacted)"
+    );
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    c.stop(&peer, Some(Method::Bye)).await;
+    assert!(peer.methods.lock().unwrap().contains(&Method::Bye));
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.principal,
+        Approval::Signal(event),
+    )
+    .await;
+    assert!(
+        captured.observe_with_held(&g).is_err(),
+        "late exact-dialog digits cannot revive the retired candidate"
+    );
+    drop(g);
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    s.stop().await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_sip_replacement_lost_wait_no_answer_and_cancel_do_not_create_another_call() {
+    let s = Scene::new_replacement("quic").await;
+    let peer = Peer::new(false).await;
+    let mut c = Candidate::new(&s, &peer).await;
