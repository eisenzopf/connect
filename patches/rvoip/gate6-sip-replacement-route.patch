+    s.tone(1, 0).await;
+    c.stop(&peer, Some(Method::Cancel)).await;
+    assert!(peer.methods.lock().unwrap().contains(&Method::Cancel));
+    assert_eq!(peer.calls(), 1);
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    s.stop().await;
+}
