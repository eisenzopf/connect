+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn delayed_pre_answer_or_media_dtmf_cannot_become_confirmation_after_readiness() {
+    for mode in ["before-media", "before-answer"] {
+        let s = Scene::new_replacement("quic").await;
+        let mut c = Candidate::new(&s, Transport::Sip).await;
+        if mode == "before-media" {
+            assert_eq!(
+                c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+                Observation::Answered
+            );
+        } else {
+            c.prompt().await;
+        }
+        let event = DeviceReplacementEndpointEvent::Dtmf {
+            digits: "5#".into(),
+        };
+        let captured = s
+            .core
+            .orch
+            .capture_device_replacement_event(
+                &c.pending,
+                DeviceReplacementSignalSource::Adapter(c.adapter.context.clone()),
+                event.clone(),
+            )
+            .unwrap();
+        if mode == "before-media" {
+            c.prompt().await;
+        } else {
+            assert_eq!(
+                c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+                Observation::Answered
+            );
+        }
+        let g = grant(
+            &s,
+            c.pending.intent(),
+            &c.adapter.context.principal,
+            Approval::Signal(event),
+        )
+        .await;
+        assert_eq!(
+            captured.observe_with_held(&g).unwrap(),
+            Observation::BeforeAnswerOrMedia,
+            "{mode}"
+        );
+        drop(g);
+        assert!(s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .is_err());
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf {
+                    digits: "5#".into()
+                }
+            )
+            .await,
+            Observation::Confirmed
+        );
+        c.pending.cancel();
+        s.tone(0, 1).await;
+        s.tone(1, 0).await;
+        s.stop().await;
+    }
+}
