+++ b/crates/sip/rvoip-sip/src/adapter/device_replacement.rs
@@ -0,0 +1,359 @@
+//! Reserved SIP replacement routes and sealed actual route observations.
+//! These facts never grant current host authority or assert media readiness.
+use super::*;
+use rvoip_core::{
+    orchestrator::participant_control::{
+        DeviceReplacementAdapterRequest, DeviceReplacementAdapterRoute,
+        DeviceReplacementEndpointEvent, DeviceReplacementEvent, DeviceReplacementPreparation,
+        DeviceReplacementSignalSource,
+    },
+    participant_transitions::PreparedParticipantReplacement,
+    relationships::{EndpointBinding, EndpointState},
+    Orchestrator,
+};
+use tokio_util::sync::CancellationToken;
+
+/// Created by the installed adapter from the actual Core preparation and a
+/// protected host's current verified endpoint/principal. It cannot be built
+/// from a wire callback or consumed by ordinary origination.
+#[derive(Clone)]
+pub struct SipDeviceReplacementContext {
+    inner: Arc<Context>,
+}
+pub(super) struct Context {
+    adapter: Weak<SipAdapter>,
+    core: Weak<Orchestrator>,
+    preparation: Weak<DeviceReplacementPreparation>,
+    pending: PreparedParticipantReplacement,
+    endpoint: EndpointBinding,
+    principal: AuthenticatedPrincipal,
+    originate: Arc<SipOriginateContext>,
+    claimed: AtomicBool,
+    lifetime: OnceLock<CancellationToken>,
+    route: OnceLock<Weak<SipOutboundRoute>>,
+    signals: mpsc::Sender<SipDeviceReplacementSignal>,
+    receiver: StdMutex<Option<mpsc::Receiver<SipDeviceReplacementSignal>>>,
+}
+impl fmt::Debug for SipDeviceReplacementContext {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SipDeviceReplacementContext(redacted)")
+    }
+}
+impl SipDeviceReplacementContext {
+    /// Take the bounded exact-route observation receiver once. No permission
+    /// reader is retained by this receiver or its captured Core events.
+    pub fn take_signals(&self) -> CoreResult<mpsc::Receiver<SipDeviceReplacementSignal>> {
+        self.inner
+            .receiver
+            .lock()
+            .unwrap_or_else(|v| v.into_inner())
+            .take()
+            .ok_or(RvoipError::InvalidState(
+                "SIP replacement observations already taken",
+            ))
+    }
+    /// The exact Call-ID assigned by dormant allocation, so a host can persist
+    /// correlation before submitting any INVITE. This is planned identity,
+    /// not evidence of submission, answer, successful activation or media.
+    pub fn prepared_call_reference(&self) -> CoreResult<ExternalConnectionReference> {
+        let route =
+            self.inner
+                .route
+                .get()
+                .and_then(Weak::upgrade)
+                .ok_or(RvoipError::InvalidState(
+                    "SIP replacement route not allocated",
+                ))?;
+        let adapter = self
+            .inner
+            .adapter
+            .upgrade()
+            .ok_or(RvoipError::InvalidState("SIP replacement adapter retired"))?;
+        let _mapping = adapter
+            .mapping_lock
+            .lock()
+            .unwrap_or_else(|v| v.into_inner());
+        if !adapter
+            .outbound_routes
+            .get(&route.connection_id)
+            .is_some_and(|r| Arc::ptr_eq(r.value(), &route))
+        {
+            return Err(RvoipError::InvalidState("SIP replacement route retired"));
+        }
+        ExternalConnectionReference::new("sip.call-id", Arc::clone(&route.sip_call_id))
+            .map_err(|_| RvoipError::InvalidState("SIP replacement Call-ID invalid"))
+    }
+}
+/// Captured synchronously by the real exact-route event translator. The host
+/// receives an opaque Core event, including its actual capture-time media
+/// eligibility, rather than a reusable signal credential or caller-ready flag.
+/// Recording still needs fresh current host signal authority.
+pub struct SipDeviceReplacementSignal {
+    connection: ConnectionId,
+    event: DeviceReplacementEndpointEvent,
+    captured: DeviceReplacementEvent,
+}
+impl fmt::Debug for SipDeviceReplacementSignal {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SipDeviceReplacementSignal(redacted)")
+    }
+}
+impl SipDeviceReplacementSignal {
+    /// The exact never-reused reserved candidate that produced this signal.
+    pub fn connection(&self) -> &ConnectionId {
+        &self.connection
+    }
+    /// The actual captured dialog observation, for selecting current authority.
+    pub fn event(&self) -> &DeviceReplacementEndpointEvent {
+        &self.event
+    }
+    /// Consume this observation into its sealed Core event. Applying it still
+    /// requires fresh current signal authority and the original live route.
+    pub fn into_event(self) -> DeviceReplacementEvent {
+        self.captured
+    }
+}
+// Only this adapter can construct the exact route/epoch source accepted by
+// device_replacement_signal_principal. Context configuration alone is not one.
+struct SignalSource {
+    route: Weak<SipOutboundRoute>,
+    context: Weak<Context>,
+    session: SessionId,
+    admitted: Option<SessionRegistryHandle>,
+}
+impl SipAdapter {
+    /// Bind this installed adapter to one actual Core preparation and the
+    /// protected host's verified target endpoint/principal. This allocates no
+    /// route, sends no packet and grants no current execution authority.
+    pub fn device_replacement_context(
+        self: &Arc<Self>,
+        core: &Arc<Orchestrator>,
+        preparation: &Arc<DeviceReplacementPreparation>,
+        principal: AuthenticatedPrincipal,
+        endpoint: EndpointBinding,
+        originate: SipOriginateContext,
+    ) -> CoreResult<Arc<SipDeviceReplacementContext>> {
+        let pending = preparation.prepared_binding();
+        validate_sip_principal_at(&principal, Utc::now())
+            .map_err(|_| RvoipError::AdmissionRejected("SIP replacement principal invalid"))?;
+        if principal.method == rvoip_core::identity::AuthenticationMethod::Anonymous
+            || endpoint.state() != EndpointState::Verified
+            || endpoint.transport() != Transport::Sip
+            || endpoint.endpoint() != &pending.intent().endpoint
+            || endpoint.device() != &pending.intent().device
+            || preparation.is_committed()
+            || preparation.cancellation().is_cancelled()
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "SIP replacement context does not match preparation",
+            ));
+        }
+        Self::validate_outbound_target(endpoint.address())?;
+        originate.validate().map_err(|_| {
+            RvoipError::AdmissionRejected("SIP replacement originate context invalid")
+        })?;
+        let (signals, receiver) = mpsc::channel(SIP_OUTBOUND_EVENT_STAGE_CAPACITY);
+        Ok(Arc::new(SipDeviceReplacementContext {
+            inner: Arc::new(Context {
+                adapter: Arc::downgrade(self),
+                core: Arc::downgrade(core),
+                preparation: Arc::downgrade(preparation),
+                pending,
+                endpoint,
+                principal,
+                originate: Arc::new(originate),
+                claimed: AtomicBool::new(false),
+                lifetime: OnceLock::new(),
+                route: OnceLock::new(),
+                signals,
+                receiver: StdMutex::new(Some(receiver)),
+            }),
+        }))
+    }
+    pub(super) fn prepare_replacement_route(
+        &self,
+        request: &DeviceReplacementAdapterRequest,
+    ) -> CoreResult<DeviceReplacementAdapterRoute> {
+        let public = request.context::<SipDeviceReplacementContext>().ok_or(
+            RvoipError::AdmissionRejected("foreign SIP replacement context"),
+        )?;
+        let context = &public.inner;
+        let ep = request.frozen_endpoint();
+        let expected = &context.endpoint;
+        if !context
+            .adapter
+            .upgrade()
+            .is_some_and(|a| std::ptr::eq(a.as_ref(), self))
+            || context.pending.intent() != request.pending().intent()
+            || !context
+                .pending
+                .binding()
+                .same_incarnation(request.pending().binding())
+            || ep.endpoint() != expected.endpoint()
+            || ep.device() != expected.device()
+            || ep.identity() != expected.identity()
+            || ep.transport() != Transport::Sip
+            || ep.state() != EndpointState::Verified
+            || ep.address() != expected.address()
+            || request.session() != context.pending.appearance().session()
+            || request.resource_lifetime().is_cancelled()
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "SIP replacement reservation mismatch",
+            ));
+        }
+        request
+            .frozen_member()
+            .revalidate_principal(&context.principal, Utc::now())
+            .map_err(|_| {
+                RvoipError::AdmissionRejected("SIP replacement target principal mismatch")
+            })?;
+        if context.claimed.swap(true, Ordering::AcqRel) {
+            return Err(RvoipError::AdmissionRejected(
+                "SIP replacement allocation already attempted",
+            ));
+        }
+        context
+            .lifetime
+            .set(request.resource_lifetime())
+            .map_err(|_| RvoipError::InvalidState("SIP replacement lifetime already installed"))?;
+        let id = request.pending().intent().replacement.clone();
+        let stream = crate::media_stream::SipMediaStream::dormant_deferred_with_capacity(
+            Direction::Outbound,
+            self.audio_queue_capacity,
+        );
+        let route = SipOutboundRoute::new(
+            id.clone(),
+            SessionId::new(),
+            ep.address().to_owned(),
+            context.originate.clone(),
+            stream,
+        );
+        route
+            .replacement
+            .set(context.clone())
+            .map_err(|_| RvoipError::InvalidState("SIP replacement route already installed"))?;
+        // This synchronous step allocates only dormant state: no SIP packet,
+        // event, callback, task, timer or ordinary Participant binding.
+        self.reserve_outbound_route(route.clone())?;
+        context
+            .route
+            .set(Arc::downgrade(&route))
+            .map_err(|_| RvoipError::InvalidState("SIP replacement route already captured"))?;
+        Ok(DeviceReplacementAdapterRoute {
+            principal: context.principal.clone(),
+            handle: ConnectionHandle::new(Connection {
+                id,
+                session_id: request.session().clone(),
+                participant_id: request.frozen_member().participant().clone(),
+                transport: Transport::Sip,
+                direction: Direction::Outbound,
+                state: ConnectionState::Connecting,
+                capabilities: CapabilityDescriptor::default(),
+                negotiated_codecs: NegotiatedCodecs::default(),
+                streams: vec![],
+                messaging_enabled: false,
+                transport_handle: TransportHandle(public),
+                opened_at: Utc::now(),
+                closed_at: None,
+            }),
+        })
+    }
+    pub(super) fn replacement_signal_principal(
+        &self,
+        id: &ConnectionId,
+        source: &(dyn std::any::Any + Send + Sync),
+    ) -> Option<AuthenticatedPrincipal> {
+        let source = source.downcast_ref::<SignalSource>()?;
+        let route = source.route.upgrade()?;
+        let context = source.context.upgrade()?;
+        // A captured observation never strongly owns its prepared route:
+        // the bounded context queue must not form a route/context cycle.
+        let epoch = SipRouteEpoch {
+            session_id: source.session.clone(),
+            connection_id: id.clone(),
+            owner: source
+                .admitted
+                .clone()
+                .map(SipRouteEpochOwner::Admitted)
+                .unwrap_or_else(|| SipRouteEpochOwner::Prepared(route.clone())),
+        };
+        let _mapping = self.mapping_lock.lock().unwrap_or_else(|v| v.into_inner());
+        if &route.connection_id != id
+            || !self.epoch_is_current_locked(&epoch)
+            || !self
+                .outbound_routes
+                .get(id)
+                .is_some_and(|r| Arc::ptr_eq(r.value(), &route))
+            || !route
+                .replacement
+                .get()
+                .is_some_and(|c| Arc::ptr_eq(c, &context))
+            || !route.is_publicly_live()
+            || !replacement_lifetime_current(&context)
+            || context.principal.is_expired()
+        {
+            return None;
+        }
+        Some(context.principal.clone())
+    }
+}
+fn replacement_lifetime_current(context: &Context) -> bool {
+    context.lifetime.get().is_some_and(|v| !v.is_cancelled())
+}
+impl SipOutboundRoute {
+    pub(super) fn replacement_is_current(&self) -> bool {
+        self.replacement
+            .get()
+            .is_none_or(|c| replacement_lifetime_current(c))
+    }
+    /// Called only after releasing mapping_lock: Core capture synchronously
+    /// rechecks the exact epoch through the installed adapter hook.
+    pub(super) fn capture_replacement_signal(
+        self: &Arc<Self>,
+        epoch: &SipRouteEpoch,
+        event: &AdapterEvent,
+    ) -> bool {
+        let Some(context) = self.replacement.get() else {
+            return true;
+        };
+        let event = match event {
+            AdapterEvent::Connected { .. } => DeviceReplacementEndpointEvent::Answered,
+            AdapterEvent::Dtmf { digits, .. } => DeviceReplacementEndpointEvent::Dtmf {
+                digits: digits.clone(),
+            },
+            _ => return true,
+        };
+        let Some(preparation) = context.preparation.upgrade() else {
+            return true;
+        };
+        if preparation.is_committed() {
+            return true;
+        }
+        let Some(core) = context.core.upgrade() else {
+            return false;
+        };
+        let source = Arc::new(SignalSource {
+            route: Arc::downgrade(self),
+            context: Arc::downgrade(context),
+            session: epoch.session_id.clone(),
+            admitted: epoch.admitted_handle().cloned(),
+        });
+        let captured = match core.capture_device_replacement_event(
+            &preparation,
+            DeviceReplacementSignalSource::Adapter(source),
+            event.clone(),
+        ) {
+            Ok(v) => v,
+            Err(_) => return false,
+        };
+        context
+            .signals
+            .try_send(SipDeviceReplacementSignal {
+                connection: self.connection_id.clone(),
+                event,
+                captured,
+            })
+            .is_ok()
+    }
+}
