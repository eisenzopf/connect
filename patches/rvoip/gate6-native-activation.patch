--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/activation.rs
@@ -0,0 +1,119 @@
+//! Sealed resource observation for an explicitly authorized initial activation.
+//! It carries no grant and cannot publish a preparing Connection before commit.
+use super::*;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+pub struct PreparedMediaObservation {
+    controller: Weak<StreamController>,
+    expected: u64,
+    generation: u64,
+    bindings: Vec<ReadyMediaBinding>,
+    cancelled: CancellationToken,
+    committed: AtomicBool,
+}
+impl std::fmt::Debug for PreparedMediaObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PreparedMediaObservation")
+            .field("bindings", &self.bindings.len())
+            .finish_non_exhaustive()
+    }
+}
+impl PreparedMediaObservation {
+    pub(super) fn new(
+        controller: &Arc<StreamController>,
+        expected: u64,
+        bindings: Vec<ReadyMediaBinding>,
+        cancelled: CancellationToken,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            controller: Arc::downgrade(controller),
+            expected,
+            generation: bindings[0].connection_generation,
+            bindings,
+            cancelled,
+            committed: AtomicBool::new(false),
+        })
+    }
+    pub fn expected_revision(&self) -> u64 {
+        self.expected
+    }
+    pub fn bindings(&self) -> &[ReadyMediaBinding] {
+        &self.bindings
+    }
+    pub fn belongs_to(&self, controller: &Arc<StreamController>) -> bool {
+        Weak::ptr_eq(&self.controller, &Arc::downgrade(controller))
+    }
+    fn controller(&self) -> ControlResult<Arc<StreamController>> {
+        let controller = self
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if controller.shutdown.is_cancelled() || self.cancelled.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(controller)
+    }
+    pub fn is_committed(&self) -> bool {
+        self.committed.load(Ordering::Acquire) && self.controller().is_ok()
+    }
+    pub fn committed_generation(&self) -> Option<u64> {
+        self.is_committed().then_some(self.generation)
+    }
+    /// Use only inside the same current control lease after its protocol has
+    /// independently verified required endpoint confirmation. This changes no
+    /// permissions and supplies no publication authority before engine commit.
+    pub fn activate_for_commit(&self, mut current: MediaOwner) -> ControlResult<MediaOwner> {
+        let controller = self.controller()?;
+        if self.expected != 0
+            || self.bindings.is_empty()
+            || !controller.is_bound_to(&current.member, &current.endpoint)
+            || !current
+                .connection
+                .same_incarnation(&controller.origin_binding)
+            || current.connection.connection() != &controller.connection
+            || current.connection.session() != &controller.session
+            || current.connection.generation() != self.generation
+            || self
+                .bindings
+                .iter()
+                .any(|b| b.connection_generation != self.generation)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        current
+            .endpoint
+            .usable_by(&current.member)
+            .map_err(|_| StreamControlError::Authority)?;
+        current
+            .connection
+            .require_current(&current.member, &current.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if current.connection.state() != crate::relationships::BindingState::Active {
+            current
+                .connection
+                .observe_ready(
+                    &current.member,
+                    &current.presence,
+                    &current.endpoint,
+                    self.generation,
+                )
+                .map_err(|_| StreamControlError::Authority)?;
+            current
+                .connection
+                .activate(&current.member, &current.presence, &current.endpoint)
+                .map_err(|_| StreamControlError::Authority)?;
+        }
+        Ok(current)
+    }
+    /// Merge an already committed resource fact with fresh current authority.
+    /// A cached candidate or aborted transaction cannot activate publication.
+    pub fn current(&self, current: MediaOwner) -> ControlResult<MediaOwner> {
+        if !self.is_committed() {
+            return Err(StreamControlError::NotReady);
+        }
+        self.activate_for_commit(current)
+    }
+    pub(super) fn commit(&self) {
+        self.committed.store(true, Ordering::Release);
+    }
+}
