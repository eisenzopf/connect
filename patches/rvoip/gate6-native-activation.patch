+//! Actual native parameter confirmation, protected preparing binding, then the
+//! real managed Participant admission. Domain permission storage is controlled.
+use super::*;
+use rvoip_core::orchestrator::participant_control::{
+    ControlResult as ParticipantResult, ParticipantAuthority, ParticipantAuthorityLease,
+    ParticipantControl, ParticipantControlError, ParticipantControlLease, ParticipantPolicy,
+    ParticipantScope,
+};
+use rvoip_core::participant_transitions::{ParticipantChange, ParticipantMutation};
+
+pub(super) fn preparing_owner(
+    core: &core_fixture::Fixture,
+    id: &ConnectionId,
+    kind: Transport,
+) -> MediaOwner {
+    let member = core.policy.0.read().unwrap().members[&core_fixture::participant("alice")].clone();
+    // Accepted room membership/endpoint intent is private authorization context,
+    // not a committed managed Participant or a public presence event.
+    let presence = SessionAppearance::admit(&member, core.session.clone(), None).unwrap();
+    let endpoint = endpoint("alice", kind);
+    let connection = ConnectionBinding::prepare(&member, &presence, &endpoint, id.clone()).unwrap();
+    MediaOwner {
+        actor: member.clone(),
+        member,
+        presence,
+        endpoint,
+        connection,
+        may_control: true,
+        send_media: [Medium::Audio, Medium::Video, Medium::Screen]
+            .into_iter()
+            .collect(),
+        receive_media: [Medium::Audio, Medium::Video, Medium::Screen]
+            .into_iter()
+            .collect(),
+        local: capabilities(),
+        remote: capabilities(),
+        may_route_source: true,
+    }
+}
+pub(super) struct Policy(pub Arc<Grants>);
+fn authority(
+    state: &State,
+    scope: &ParticipantScope<'_>,
+) -> ParticipantResult<ParticipantAuthority> {
+    let ParticipantChange::Admit { connection, .. } = &scope.mutation.change else {
+        return Err(ParticipantControlError::Unsupported);
+    };
+    let owner = credential_owner(
+        state
+            .owners
+            .get(connection)
+            .ok_or(ParticipantControlError::Authority)?
+            .clone(),
+        scope.principal,
+    )
+    .map_err(|_| ParticipantControlError::Authority)?;
+    if state.denied
+        || !owner.may_control
+        || owner.member.participant() != &scope.mutation.participant
+        || owner.member.conversation() != scope.conversation
+        || owner.presence.session() != scope.session
+    {
+        return Err(ParticipantControlError::Authority);
+    }
+    owner
+        .actor
+        .revalidate_principal(scope.principal, Utc::now())
+        .map_err(|_| ParticipantControlError::Authority)?;
+    let generation = state
+        .activations
+        .lock()
+        .unwrap()
+        .get(connection)
+        .and_then(|a| a.confirmed_generation());
+    Ok(ParticipantAuthority {
+        actor: owner.actor.clone(),
+        target: owner.member.clone(),
+        endpoint: Some(owner.endpoint.clone()),
+        may_send_audio: owner.receive_media.contains(&Medium::Audio),
+        may_receive_audio: owner.send_media.contains(&Medium::Audio),
+        confirmation_required: true,
+        confirmed_generation: generation,
+    })
+}
+struct Current {
+    authority: ParticipantAuthority,
+    _guard: OwnedRwLockReadGuard<State>,
+}
+impl ParticipantAuthorityLease for Current {
+    fn authority(&self) -> &ParticipantAuthority {
+        &self.authority
+    }
+}
+struct Held(Invocation);
+impl ParticipantControlLease for Held {
+    fn current(&self, scope: &ParticipantScope<'_>) -> ParticipantResult<ParticipantAuthority> {
+        let i = &self.0;
+        let proof =
+            i.a.authority::<Proof>()
+                .ok_or(ParticipantControlError::Authority)?;
+        let wire = proof
+            .base
+            .authority::<WireProof>()
+            .ok_or(ParticipantControlError::Authority)?;
+        let ParticipantChange::Admit {
+            connection,
+            role_override,
+        } = &scope.mutation.change
+        else {
+            return Err(ParticipantControlError::Unsupported);
+        };
+        if role_override.is_some()
+            || i.a.envelope().kind() != "connection.offer"
+            || i.participant_revision != Some(scope.mutation.expected_revision)
+            || i.a.envelope().scope(Scope::Operation) != Some(scope.mutation.operation_id.as_str())
+            || i.a.envelope().id() != scope.mutation.correlation_id
+            || i.a.envelope().scope(Scope::Conversation) != Some("conversation")
+            || i.a.envelope().scope(Scope::Session) != Some("session")
+            || i.a
+                .envelope()
+                .scope(Scope::Connection)
+                .and_then(|id| wire._guard.connections.get(id))
+                != Some(connection)
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                i.a.principal(),
+                scope.principal,
+            )
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        authority(&proof.guard, scope)
+    }
+}
+impl ParticipantPolicy for Policy {
+    fn current(
+        &self,
+        scope: &ParticipantScope<'_>,
+    ) -> ParticipantResult<Box<dyn ParticipantAuthorityLease + '_>> {
+        let guard = self
+            .0
+             .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| ParticipantControlError::Authority)?;
+        let authority = authority(&guard, scope)?;
+        Ok(Box::new(Current {
+            authority,
+            _guard: guard,
+        }))
+    }
+    fn current_control(
+        &self,
+        scope: &ParticipantScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ParticipantResult<ParticipantControl> {
+        let i = held
+            .downcast_ref::<Invocation>()
+            .ok_or(ParticipantControlError::Authority)?;
+        if !Arc::ptr_eq(&self.0, &i.domain) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let lease = Held(i.clone());
+        let _ = lease.current(scope)?;
+        ParticipantControl::new(Box::new(lease), i.a.invocation_cancellation(), deadline())
+    }
+}
+pub(super) async fn admit(
+    handler: &OfferHandler,
+    id: &ConnectionId,
+    invocation: &Invocation,
+) -> Result<(), DispatchError> {
+    let proof = invocation
+        .a
+        .authority::<Proof>()
+        .ok_or(DispatchError::Authority)?;
+    let owner = proof.guard.owners.get(id).ok_or(DispatchError::Authority)?;
+    let mutation = ParticipantMutation {
+        operation_id: invocation
+            .a
+            .envelope()
+            .scope(Scope::Operation)
+            .ok_or(DispatchError::Authority)?
+            .into(),
+        correlation_id: invocation.a.envelope().id().into(),
+        expected_revision: invocation
+            .participant_revision
+            .ok_or(DispatchError::Authority)?,
+        participant: owner.member.participant().clone(),
+        change: ParticipantChange::Admit {
+            connection: id.clone(),
+            role_override: None,
+        },
+    };
+    handler
+        .native
+        .core
+        .orch
+        .admit_peer_session_connection_with_held(
+            invocation
+                .a
+                .peer_admission()
+                .ok_or(DispatchError::Authority)?
+                .clone(),
+            &handler.native.core.session,
+            invocation.a.principal().clone(),
+            mutation,
+            deadline(),
+            invocation.a.invocation_cancellation(),
+            invocation,
+        )
+        .await
+        .map_err(|_| DispatchError::Authority)?;
+    Ok(())
+}
+async fn admitted(s: &Scene) {
+    core_fixture::until(|| {
+        s.native
+            .core
+            .orch
+            .session(&s.native.core.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .connections
+            .contains_key(&s.id)
+    })
+    .await;
+    let session = s.native.core.orch.session(&s.native.core.session).unwrap();
+    let session = session.read().unwrap();
+    assert_eq!(session.participants.len(), 1);
+    assert_eq!(session.state, rvoip_core::session::SessionState::Active);
+}
+fn empty(s: &Scene) {
+    let session = s.native.core.orch.session(&s.native.core.session).unwrap();
+    let session = session.read().unwrap();
+    assert!(session.participants.is_empty());
+    assert!(session.connections.is_empty());
+}
+async fn activation(s: &Scene) -> Arc<NativeMediaActivation> {
+    s.grants.0.read().await.activations.lock().unwrap()[&s.id].clone()
+}
+#[tokio::test]
+async fn actual_native_initial_activation_enters_managed_scene_after_signed_confirmation_and_observes_real_flow(
+) {
+    for kind in ["quic", "wt"] {
+        let mut s = Scene::new_bootstrap(kind).await;
+        s.record.lifecycle.store(true, Ordering::Release);
+        empty(&s);
+        let (answer, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+        let handle = answer.original()["payload"]["substrate_setup"]["streams"][0]
+            ["stream_local_id"]
+            .as_u64()
+            .unwrap() as u16;
+        let proof = activation(&s).await;
+        assert_eq!(proof.confirmed_generation(), None);
+        assert_eq!(s.controller().revision(), 0);
+        empty(&s);
+        send(&s.wire, audio_sequence(handle, 1));
+        no_event(&mut s.wire).await;
+        s.confirm(&callback).await;
+        admitted(&s).await;
+        assert_eq!(proof.confirmed_generation(), Some(1));
+        assert_eq!(s.controller().revision(), 1);
+        assert_eq!(
+            s.grants.0.read().await.owners[&s.id].connection.state(),
+            BindingState::Preparing
+        );
+        no_event(&mut s.wire).await;
+        send(&s.wire, audio_sequence(handle, 2));
+        ready_opened(&s.f, &mut s.wire, handle).await;
+        let participant_revision = s
+            .native
+            .core
+            .orch
+            .participant_revision(&s.native.core.session)
+            .unwrap();
+        let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 1, "sendonly")).await;
+        s.confirm(&callback).await;
+        s.wait(2).await;
+        assert_eq!(s.controller().revision(), 2);
+        assert_eq!(
+            s.native
+                .core
+                .orch
+                .participant_revision(&s.native.core.session)
+                .unwrap(),
+            participant_revision
+        );
+        assert_eq!(proof.confirmed_generation(), Some(1));
+        admitted(&s).await;
+        s.wire.server.shutdown().await.unwrap();
+        core_fixture::until(|| proof.confirmed_generation().is_none()).await;
+    }
+}
+#[tokio::test]
+async fn actual_native_initial_activation_bad_confirmation_keeps_public_session_empty_and_retry_uses_new_handle(
+) {
+    let mut s = Scene::new_bootstrap("quic").await;
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    let failed = activation(&s).await;
+    let old =
+        callback.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"].clone();
+    let mut answer = s.confirmation(&callback);
+    answer["payload"]["substrate_setup"]["revision"] = json!(99);
+    s.wire.send(s.f.sign(answer)).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.wait(1).await;
+    empty(&s);
+    assert_eq!(failed.confirmed_generation(), None);
+    assert_eq!(s.controller().revision(), 0);
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    assert_ne!(
+        callback.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"],
+        old
+    );
+    s.confirm(&callback).await;
+    admitted(&s).await;
+    assert_eq!(failed.confirmed_generation(), None);
+    assert_eq!(s.controller().stream_open_budget().0, 2);
+    s.wire.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_initial_activation_and_participant_commit_do_not_reenter_a_queued_grant_writer_or_retain_idle_reader(
+) {
+    let mut s = Scene::new_bootstrap("quic").await;
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    let gate = s.grants.0.clone();
+    let writer = tokio::spawn(async move {
+        let mut guard = gate.write_owned().await;
+        guard.denied = true;
+    });
+    tokio::task::yield_now().await;
+    assert!(!writer.is_finished());
+    s.confirm(&callback).await;
+    tokio::time::timeout(Duration::from_secs(2), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    admitted(&s).await;
+    assert_eq!(activation(&s).await.confirmed_generation(), Some(1));
+    s.wire.server.shutdown().await.unwrap();
+}
