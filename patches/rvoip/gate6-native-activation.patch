+struct ActivationPolicy {
+    base: Arc<Policy>,
+    prepared: Arc<Mutex<Option<Arc<PreparedMediaObservation>>>>,
+    cancel_after_prepare: Arc<AtomicBool>,
+}
+struct ActivationLease {
+    owner: MediaOwner,
+    _guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    prepared: Arc<Mutex<Option<Arc<PreparedMediaObservation>>>>,
+    cancellation: CancellationToken,
+    cancel_after_prepare: Arc<AtomicBool>,
+}
+impl MediaAuthorityLease for ActivationLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        Ok(Box::new(self.owner.clone()))
+    }
+    fn control_prepared(
+        &self,
+        proof: &Arc<PreparedMediaObservation>,
+    ) -> ControlResult<Box<MediaOwner>> {
+        assert!(!proof.is_committed());
+        assert!(proof.current(self.owner.clone()).is_err());
+        let owner = proof.activate_for_commit(self.owner.clone())?;
+        *self.prepared.lock().unwrap() = Some(proof.clone());
+        if self.cancel_after_prepare.load(Ordering::Acquire) {
+            self.cancellation.cancel();
+        }
+        Ok(Box::new(owner))
+    }
+}
+impl MediaPolicy for ActivationPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self.base.current(scope)?;
+        let owner = self
+            .prepared
+            .lock()
+            .unwrap()
+            .as_ref()
+            .ok_or(StreamControlError::NotReady)?
+            .current(guard.authority().clone())?;
+        Ok(Box::new(PhaseCurrentLease {
+            owner,
+            _guard: guard,
+        }))
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        _: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<HeldControlContext>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&held.domain, &self.base)
+            || held.connection != *scope.connection
+            || !held.principal.has_same_owner(scope.principal)
+            || held.guard.revoked.contains(&scope.principal.subject)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        MediaControl::new(
+            Box::new(ActivationLease {
+                owner: held.guard.owners[scope.connection.as_str()].clone(),
+                _guard: held.guard.clone(),
+                prepared: self.prepared.clone(),
+                cancellation: held.cancellation.clone(),
+                cancel_after_prepare: self.cancel_after_prepare.clone(),
+            }),
+            held.cancellation.clone(),
+            held.deadline,
+        )
+    }
+}
+async fn activation_policy(f: &Fixture) -> Arc<ActivationPolicy> {
+    let _preparing = PhasePolicy::new(f).await;
+    Arc::new(ActivationPolicy {
+        base: f.policy.clone(),
+        prepared: Arc::new(Mutex::new(None)),
+        cancel_after_prepare: Arc::new(AtomicBool::new(false)),
+    })
+}
+#[tokio::test]
+async fn initial_activation_observation_cannot_publish_before_commit_and_keeps_only_resource_metadata(
+) {
+    let mut f = Fixture::new(8);
+    let policy = activation_policy(&f).await;
+    let held = held_context(&f, CancellationToken::new(), deadline()).await;
+    f.a = held_controller(&f, policy.clone(), held.as_ref()).unwrap();
+    f.a.change_with_held(
+        0,
+        &[desired(Medium::Audio)],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+        held.clone(),
+    )
+    .await
+    .unwrap();
+    let proof = policy.prepared.lock().unwrap().clone().unwrap();
+    assert!(proof.is_committed());
+    assert_eq!(proof.committed_generation(), Some(1));
+    assert!(proof.belongs_to(&f.a));
+    assert!(!proof.belongs_to(&f.b));
+    assert_eq!(f.a.revision(), 1);
+    let gate = f.policy.0.clone();
+    let writer = tokio::spawn(async move { gate.write_owned().await });
+    tokio::task::yield_now().await;
+    assert!(!writer.is_finished());
+    drop(held);
+    let guard = tokio::time::timeout(Duration::from_millis(300), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    drop(guard);
+    let port = f.aa.port(Medium::Audio);
+    port.try_publish(&frame(&port, 160)).unwrap();
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+    assert!(!proof.is_committed());
+}
+#[tokio::test]
+async fn initial_activation_cancelled_after_observation_never_promotes_cached_candidate_and_retry_burns_handle(
+) {
+    let mut f = Fixture::new(8);
+    let policy = activation_policy(&f).await;
+    let held = held_context(&f, CancellationToken::new(), deadline()).await;
+    f.a = held_controller(&f, policy.clone(), held.as_ref()).unwrap();
+    policy.cancel_after_prepare.store(true, Ordering::Release);
+    assert!(matches!(
+        f.a.change_with_held(
+            0,
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+            held.clone()
+        )
+        .await,
+        Err(StreamControlError::Cancelled)
+    ));
+    let failed = policy.prepared.lock().unwrap().clone().unwrap();
+    let old = f.aa.port(Medium::Audio);
+    assert!(!failed.is_committed());
+    assert_eq!(f.a.revision(), 0);
+    assert!(old.try_publish(&frame(&old, 160)).is_err());
+    drop(held);
+    policy.cancel_after_prepare.store(false, Ordering::Release);
+    let held = held_context(&f, CancellationToken::new(), deadline()).await;
+    f.a.change_with_held(
+        0,
+        &[desired(Medium::Audio)],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+        held,
+    )
+    .await
+    .unwrap();
+    let new = f.aa.port(Medium::Audio);
+    assert_ne!(old.binding().stream_local_id, new.binding().stream_local_id);
+    assert!(!failed.is_committed());
+    assert_eq!(f.a.stream_open_budget().0, 2);
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+}
+#[tokio::test]
+async fn initial_activation_observation_cannot_relabel_owner_retired_binding_or_membership() {
+    let mut f = Fixture::new(8);
+    let policy = activation_policy(&f).await;
+    let held = held_context(&f, CancellationToken::new(), deadline()).await;
+    f.a = held_controller(&f, policy.clone(), held.as_ref()).unwrap();
+    f.a.change_with_held(
+        0,
+        &[desired(Medium::Audio)],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+        held.clone(),
+    )
+    .await
+    .unwrap();
+    let proof = policy.prepared.lock().unwrap().clone().unwrap();
+    assert!(proof.current(owner("bob")).is_err());
+    let mut recreated = held.guard.owners["alice"].clone();
+    recreated.connection = ConnectionBinding::prepare(
+        &recreated.member,
+        &recreated.presence,
+        &recreated.endpoint,
+        recreated.connection.connection().clone(),
+    )
+    .unwrap();
+    assert!(proof.current(recreated).is_err());
+    let mut retired = held.guard.owners["alice"].clone();
+    retired.connection.retire();
+    assert!(proof.current(retired).is_err());
+    let mut revoked = held.guard.owners["alice"].clone();
+    revoked.endpoint.revoke();
+    assert!(proof.current(revoked).is_err());
+    drop(held);
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+}
