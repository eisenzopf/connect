@@ -0,0 +1,82 @@
+//! Native parameter confirmation composed with sealed Core resource readiness.
+//! Retained state is metadata only; every use needs the host's current grant.
+use super::*;
+
+pub struct NativeMediaActivation {
+    controller: Weak<StreamController>,
+    broker: Weak<NativeNegotiation>,
+    source: String,
+    prepared: Mutex<Option<Arc<PreparedMediaObservation>>>,
+}
+impl std::fmt::Debug for NativeMediaActivation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeMediaActivation(redacted)")
+    }
+}
+impl NativeMediaActivation {
+    pub(crate) fn new(
+        controller: &Arc<StreamController>,
+        broker: &Arc<NativeNegotiation>,
+        source: &str,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            controller: Arc::downgrade(controller),
+            broker: Arc::downgrade(broker),
+            source: source.into(),
+            prepared: Mutex::new(None),
+        })
+    }
+    /// Called only from the original control lease's control_prepared hook.
+    /// Local port readiness alone is insufficient: the ongoing native broker
+    /// must have verified a signed answer for this exact source and full batch.
+    pub fn prepare(
+        &self,
+        prepared: &Arc<PreparedMediaObservation>,
+        current: MediaOwner,
+    ) -> ControlResult<MediaOwner> {
+        let controller = self
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let broker = self.broker.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let operation = broker.active().map_err(|_| StreamControlError::Authority)?;
+        if operation.invocation.envelope().id() != self.source
+            || operation.expected != prepared.expected_revision()
+            || !prepared.belongs_to(&controller)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let progress = operation.progress.lock().unwrap_or_else(|p| p.into_inner());
+        if !progress.confirmed
+            || progress.bindings.len() != prepared.bindings().len()
+            || progress.bindings.iter().any(|b| {
+                !prepared
+                    .bindings()
+                    .iter()
+                    .any(|p| crate::staged_media::same_binding(b, p))
+            })
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let owner = prepared.activate_for_commit(current)?;
+        *self.prepared.lock().unwrap_or_else(|p| p.into_inner()) = Some(prepared.clone());
+        Ok(owner)
+    }
+    /// Merge only a committed resource observation with newly derived authority.
+    /// No original invocation/reader is retained in this idle handle.
+    pub fn current(&self, current: MediaOwner) -> ControlResult<MediaOwner> {
+        self.prepared
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .ok_or(StreamControlError::NotReady)?
+            .current(current)
+    }
+    pub fn confirmed_generation(&self) -> Option<u64> {
+        self.prepared
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()?
+            .committed_generation()
+    }
+}
