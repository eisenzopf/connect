+/// Optional host authorization at the final REST dispatch boundary.
+/// The host owns durable intent and must reject repeated possibly-sent attempts.
+/// Defaults to absent, preserving existing call creation behavior.
+#[async_trait::async_trait]
+pub trait VapiCallAdmission: Send + Sync {
+    /// Revalidate current authority and durably admit one request. This runs
+    /// after request preparation and immediately before the HTTP send.
+    async fn admit(&self) -> Result<()>;
+}
+
