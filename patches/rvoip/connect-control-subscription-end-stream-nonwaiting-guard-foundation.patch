+//! Control-only acquisition helpers. No permission, policy cache or new timer.
+use super::*;
+pub(super) fn try_lock<T>(mutex:&Mutex<T>)->ControlResult<std::sync::MutexGuard<'_,T>> {
+    match mutex.try_lock() {
+        Ok(guard)=>Ok(guard),
+        Err(std::sync::TryLockError::WouldBlock)=>Err(StreamControlError::MetadataBusy),
+        Err(std::sync::TryLockError::Poisoned(error))=>Ok(error.into_inner()),
+    }
+}
+impl StreamController {
+    pub(super) fn try_control_state(&self,stage:&'static str)->ControlResult<std::sync::MutexGuard<'_,State>> {
+        try_lock(&self.state).inspect_err(|error|self.note_control_metadata(stage,error))
+    }
+    pub(super) fn note_control_metadata(&self,stage:&'static str,error:&StreamControlError) {
+        #[cfg(test)]
+        if matches!(error,StreamControlError::MetadataBusy) {
+            self.observe_control_stage(stage);
+        }
+        #[cfg(not(test))]
+        let _=(stage,error);
+    }
+    #[cfg(test)]
+    pub(super) fn observe_control_stage(&self,stage:&'static str) {
+        if let Ok(slot)=self.control_metadata_observer.try_lock() {
+            if let Some(observer)=slot.as_ref() {let _=observer.try_send(stage);}
+        }
+    }
+
+}
