+//! Actual mutex/IO controls for the first guard foundation only. These do not
+//! qualify the unresolved Service Writer/policy or compound audience boundary.
+use super::*;
+
+async fn extra_video_member(s:&Scene,name:&str)->(Arc<StreamController>,Arc<Adapter>) {
+    s.f.policy.0.write().await.owners.insert(name.into(),owner(name));
+    let adapter=Adapter::new();
+    let controller=StreamController::new(s.f.a.conversation.clone(),s.f.a.session.clone(),ConnectionId::from_string(name),principal(name),s.f.a.policy.clone(),adapter.clone(),s.f.a.handles.clone(),16).unwrap();
+    controller.change(0,&[desired(Medium::Video)],&BTreeSet::new(),deadline(),CancellationToken::new()).await.unwrap();
+    let mut member=s.scene.prepare(controller.clone()).unwrap();
+    member.quiesce(deadline(),CancellationToken::new()).await.unwrap();
+    assert!(member.ready());s.scene.insert(controller.connection.clone(),member,true);
+    (controller,adapter)
+}
+async fn receive_alice_video(s:&Scene,target:&Arc<StreamController>) {
+    s.scene.change_direct_subscriptions(&target.connection,target.revision(),DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&s.f.a,desired(Medium::Video).logical_id.clone(),desired(Medium::Video).logical_id)]),deadline(),CancellationToken::new(),None).await.unwrap();
+}
+fn observe(controller:&Arc<StreamController>)->std::sync::mpsc::Receiver<&'static str> {
+    let (send,receive)=std::sync::mpsc::sync_channel(256);
+    *controller.control_metadata_observer.lock().unwrap()=Some(send);receive
+}
+fn control_thread<T:Send+'static,F:std::future::Future<Output=ControlResult<T>>>(make:impl FnOnce()->F+Send+'static)->(std::thread::JoinHandle<ControlResult<T>>,std::sync::mpsc::Receiver<()>) {
+    let runtime=tokio::runtime::Handle::current();let (send,done)=std::sync::mpsc::sync_channel(1);
+    let worker=std::thread::spawn(move||{let value=runtime.block_on(make());let _=send.send(());value});
+    (worker,done)
+}
+fn tick_thread(scene:Arc<GuardedMediaScene>)->(std::thread::JoinHandle<()>,std::sync::mpsc::Receiver<()>) {
+    let runtime=tokio::runtime::Handle::current();let(send,done)=std::sync::mpsc::sync_channel(1);
+    let worker=std::thread::spawn(move||{let _entered=runtime.enter();for _ in 0..8 {scene.tick();std::thread::yield_now();}let _=send.send(());});
+    (worker,done)
+}
+fn publication(s:&Scene,medium:Medium,sequence:u32)->ControlResult<()> {
+    let port=s.f.aa.port(medium);port.try_publish(&frame(&port,sequence))
+}
+async fn actual_video(packet:Option<QueuedMedia>)->(bool,Option<MediaFrame>) {
+    let captured=Arc::new(Mutex::new(None));let sink=captured.clone();
+    let result=match packet {
+        Some(packet)=>packet.deliver(move|frame|{let sink=sink.clone();async move{*sink.lock().unwrap()=Some(frame);Ok(())}}).await.is_ok(),
+        None=>false,
+    };
+    let frame=captured.lock().unwrap().take();(result,frame)
+}
+async fn cleanup(controllers:&[Arc<StreamController>])->Vec<usize> {
+    let mut remaining=Vec::new();for controller in controllers {remaining.push(controller.shutdown(deadline()).await);}remaining
+}
+
+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn subscription_target_metadata_busy_releases_scene_and_commits_original_once() {
+    let s=Scene::new(&[Medium::Video]).await;
+    let (third,adapter)=extra_video_member(&s,"charlie").await;receive_alice_video(&s,&third).await;
+    let mut healthy=adapter.port(Medium::Video).take_egress().unwrap();
+    let mut target=s.f.ba.port(Medium::Video).take_egress().unwrap();s.scene.tick();
+    let before=s.f.b.revision();let opened=s.f.ba.prepare_calls.load(Ordering::Acquire);
+    let events=observe(&s.f.b);let held=s.f.b.state.lock().unwrap();
+    let scene=s.scene.clone();let receiver=s.f.b.connection.clone();let publisher=s.f.a.clone();
+    let(worker,_done)=control_thread(move||async move{scene.change_direct_subscriptions(&receiver,before,DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&publisher,desired(Medium::Video).logical_id.clone(),desired(Medium::Video).logical_id)]),deadline(),CancellationToken::new(),None).await});
+    let collision=events.recv_timeout(Duration::from_secs(2));
+    let published=publication(&s,Medium::Video,31000);let(tick,finished)=tick_thread(s.scene.clone());
+    let progressed=finished.recv_timeout(Duration::from_millis(500));
+    let io=actual_video(healthy.try_recv().ok()).await;
+    drop(held);let tick_join=tick.join();let outcome=worker.join();
+    let revision=s.f.b.revision();let no_old_target=target.try_recv().is_err();
+    let published_fresh=publication(&s,Medium::Video,32000);s.scene.tick();let fresh=actual_video(target.try_recv().ok()).await;
+    let no_duplicate=target.try_recv().is_err();let opens_after=s.f.ba.prepare_calls.load(Ordering::Acquire);
+    let remaining=cleanup(&[s.f.a.clone(),s.f.b.clone(),third]).await;
+    assert_eq!(collision.ok(),Some("subscription-prepare-state"));
+    assert!(published.is_ok()&&published_fresh.is_ok());
+    assert!(progressed.is_ok()&&tick_join.is_ok(),"one target metadata reader excluded healthy scene IO");
+    assert!(io.0&&io.1.as_ref().is_some_and(|frame|frame.timestamp_rtp==31000));
+    assert!(outcome.is_ok_and(|result|matches!(result,Ok(revision) if revision==before+1)),"same original routing command did not recover once");
+    assert_eq!(revision,before+1);assert_eq!(opened,opens_after,"physical prepare was reissued");
+    assert!(no_old_target,"new route captured a packet admitted before its original commit");
+    assert!(fresh.0&&fresh.1.as_ref().is_some_and(|frame|frame.timestamp_rtp==32000)&&no_duplicate);
+    assert!(remaining.iter().all(|count|*count==0));
+}
+
+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn subscription_sibling_metadata_busy_preserves_one_original_audio_plan() {
+    let s=Scene::new(&[Medium::Audio,Medium::Video]).await;
+    let (source,_source_adapter)=extra_video_member(&s,"charlie").await;
+    let (healthy_target,healthy_adapter)=extra_video_member(&s,"dave").await;
+    receive_alice_video(&s,&healthy_target).await;
+    let mut healthy=healthy_adapter.port(Medium::Video).take_egress().unwrap();s.scene.tick();
+    let before=s.f.b.revision();let opened=s.f.ba.prepare_calls.load(Ordering::Acquire);
+    let events=observe(&s.f.b);let held=source.state.lock().unwrap();
+    let change=MediaSubscriptionChange {selection:None,audio:Some(AudioSubscriptionChange::Subscribe(vec![AudioSubscription::Stream(MediaStreamRef {connection:s.f.a.connection.clone(),logical:desired(Medium::Audio).logical_id})])),direct:Some(DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&source,desired(Medium::Video).logical_id.clone(),desired(Medium::Video).logical_id)]))};
+    let scene=s.scene.clone();let receiver=s.f.b.connection.clone();
+    let(worker,_done)=control_thread(move||async move{scene.change_media_subscriptions(&receiver,before,change,deadline(),CancellationToken::new(),None).await});
+    let mut seen=Vec::new();let bound=Instant::now()+Duration::from_secs(1);
+    while seen.iter().filter(|event|**event=="subscription-prepare-retry").count()<2&&Instant::now()<bound {
+        match events.recv_timeout(bound.saturating_duration_since(Instant::now())) {Ok(event)=>seen.push(event),Err(_)=>break}
+    }
+    let published=publication(&s,Medium::Video,41000);let(tick,finished)=tick_thread(s.scene.clone());let progressed=finished.recv_timeout(Duration::from_millis(500));let io=actual_video(healthy.try_recv().ok()).await;
+    drop(held);let tick_join=tick.join();let outcome=worker.join();seen.extend(events.try_iter());
+    let revision=s.f.b.revision();let opens_after=s.f.ba.prepare_calls.load(Ordering::Acquire);
+    let remaining=cleanup(&[s.f.a.clone(),s.f.b.clone(),source,healthy_target]).await;
+    assert!(published.is_ok());
+    assert!(seen.iter().filter(|event|**event=="subscription-prepare-retry").count()>=2,"actual Direct source exclusion never retried");
+    assert_eq!(seen.iter().filter(|event|**event=="subscription-audio-prepared").count(),1,"sibling metadata retry recreated original AudioPlan ticket");
+    assert!(progressed.is_ok()&&tick_join.is_ok()&&io.0&&io.1.as_ref().is_some_and(|frame|frame.timestamp_rtp==41000));
+    assert!(outcome.is_ok_and(|result|matches!(result,Ok(revision) if revision==before+1)));assert_eq!(revision,before+1);assert_eq!(opened,opens_after);
+    assert!(remaining.iter().all(|count|*count==0));
+}
+
+async fn end_port_case(mode:&str) {
+    let s=Scene::new(&[Medium::Audio,Medium::Video]).await;
+    apply(&s,MediaSubscriptionChange {selection:None,audio:Some(AudioSubscriptionChange::Subscribe(vec![AudioSubscription::Stream(MediaStreamRef {connection:s.f.a.connection.clone(),logical:desired(Medium::Audio).logical_id})])),direct:None}).await.unwrap();
+    let(third,adapter)=extra_video_member(&s,"charlie").await;receive_alice_video(&s,&third).await;
+    let mut healthy=adapter.port(Medium::Video).take_egress().unwrap();s.scene.tick();
+    let port=s.f.ba.port(Medium::Audio);let original_ticket=port.0.ticket_snapshot();
+    let consumer=s.scene.members.lock().unwrap().get(&s.f.b.connection).unwrap().audio_consumer.clone();let original_consumer=consumer.stamp();
+    let before=s.f.b.revision();let opened=s.f.ba.prepare_calls.load(Ordering::Acquire);let events=observe(&s.f.b);
+    let held=port.0.state.lock().unwrap();let controller=s.f.b.clone();let logical=desired(Medium::Audio).logical_id;let until=deadline();
+    let(worker,done)=control_thread(move||async move{controller.end_stream(&logical,before,until).await});
+    let collision=events.recv_timeout(Duration::from_secs(1));
+    let audio_published=publication(&s,Medium::Audio,480);let video_published=publication(&s,Medium::Video,51000);let(tick,finished)=tick_thread(s.scene.clone());let progressed=finished.recv_timeout(Duration::from_millis(500));let io=actual_video(healthy.try_recv().ok()).await;
+    let returned=if mode=="cancel" {s.f.b.shutdown.cancel();Some(done.recv_timeout(Duration::from_millis(500)))} else if mode=="deadline" {Some(done.recv_timeout(until.saturating_duration_since(tokio::time::Instant::now())+Duration::from_millis(500)))} else {None};
+    drop(held);let tick_join=tick.join();let outcome=worker.join();
+    let state=s.f.b.state.lock().unwrap();let revision=state.model.revision();let same_port=state.active.get(&desired(Medium::Audio).logical_id).is_some_and(|actual|Arc::ptr_eq(actual,&port.0));drop(state);
+    let same_ticket=Arc::ptr_eq(&original_ticket,&port.0.ticket_snapshot());let port_current=[TicketSide::Ingress,TicketSide::Egress].into_iter().all(|side|original_ticket.ticket(side).is_current());let consumer_current=original_consumer.is_current();let opened_after=s.f.ba.prepare_calls.load(Ordering::Acquire);
+    let remaining=cleanup(&[s.f.a.clone(),s.f.b.clone(),third]).await;
+    assert!(audio_published.is_ok()&&video_published.is_ok());
+    assert_eq!(collision.ok(),Some("end-stream-port"),"actual final retirement PortState exclusion was not reached");
+    assert!(progressed.is_ok()&&tick_join.is_ok()&&io.0&&io.1.as_ref().is_some_and(|frame|frame.timestamp_rtp==51000),"retirement metadata held audio consumer and blocked healthy actual video");
+    assert_eq!(opened,opened_after,"end-stream reissued physical prepare");
+    let outcome=outcome.expect("same original control thread panicked");
+    match mode {
+        "recover"=>{assert!(outcome.is_ok());assert_eq!(revision,before+1);assert!(!same_port&&!consumer_current);},
+        "cancel"=>{assert!(matches!(outcome,Err(StreamControlError::Cancelled)));assert_eq!(revision,before);assert!(same_port&&same_ticket&&port_current&&consumer_current);assert!(returned.unwrap().is_ok());},
+        "deadline"=>{assert!(matches!(outcome,Err(StreamControlError::Deadline)));assert!(tokio::time::Instant::now()>=until);assert_eq!(revision,before);assert!(same_port&&same_ticket&&port_current&&consumer_current);assert!(returned.unwrap().is_ok());},
+        _=>unreachable!(),
+    }
+    assert!(remaining.iter().all(|count|*count==0));
+}
+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn end_stream_port_metadata_busy_keeps_consumer_free_and_recovers_original() {end_port_case("recover").await;}
+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn end_stream_port_metadata_busy_preserves_original_cancel_and_deadline() {for mode in ["cancel","deadline"] {end_port_case(mode).await;}}
