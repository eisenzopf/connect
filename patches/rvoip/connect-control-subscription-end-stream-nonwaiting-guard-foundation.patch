+    pub(super) fn try_lock<'a>(
+        &self,
+        controller: &'a StreamController,
+    ) -> ControlResult<DirectCommit<'a>> {
+        let gate = &controller.direct_subscriptions;
+        let routing = super::control_metadata::try_lock(&gate.routing)?;
+        if gate.cancel.is_cancelled() || self.old.values().any(|r| !r.ticket.is_current()) {
+            return Err(StreamControlError::Cancelled);
+        }
+        for id in &self.changed {
+            match (self.private.get(id), routing.preparation.get(id)) {
+                (None, None) => {}
+                (Some(original), Some(current))
+                    if Arc::ptr_eq(original, current)
+                        && original.ticket.is_current()
+                        && original
+                            .preparation
+                            .as_ref()
+                            .is_some_and(|p| p.is_current()) => {}
+                _ => return Err(StreamControlError::Cancelled),
+            }
+        }
+        Ok(DirectCommit(routing))
+    }
 }
