+#[tokio::test]
+async fn ordinary_video_receive_policy_refuses_model_aba_credential_and_original_port_changes() {
+    for changed in 0..5 {
+        let (f, actions) = receive_fixture();
+        f.start(&[Medium::Video]).await;
+        let source = f.aa.port(Medium::Video);
+        let mut input =
+            f.a.take_ingress(&desired(Medium::Video).logical_id)
+                .unwrap();
+        let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+        source.try_publish(&frame(&source, 902)).unwrap();
+        let packet = receive(&mut input).await;
+        let authority = f.policy.0.try_read().unwrap().owners["bob"].clone();
+        *actions.lock().unwrap() = Some(Box::new(move |controller| {
+            assert!(
+                controller.state.try_lock().is_ok(),
+                "ordinary Receive policy owns State"
+            );
+            match changed {
+                0 => {
+                    let mut state = controller.state.lock().unwrap();
+                    for paused in [true, false] {
+                        let expected = state.model.revision();
+                        state
+                            .model
+                            .set_paused(
+                                &authority.current(),
+                                expected,
+                                &desired(Medium::Video).logical_id,
+                                paused,
+                            )
+                            .unwrap();
+                    }
+                }
+                1 => controller.credential.lock().unwrap().revision += 1,
+                2 => controller.state.lock().unwrap().closed = true,
+                3 => controller.state.lock().unwrap().active[&desired(Medium::Video).logical_id]
+                    .retire(),
+                4 => controller.shutdown.cancel(),
+                _ => unreachable!(),
+            }
+        }));
+        assert!(
+            packet
+                .try_forward_to(&f.b, &desired(Medium::Video).logical_id)
+                .is_err(),
+            "changed={changed}"
+        );
+        assert!(actions.lock().unwrap().is_none(), "Receive callback was not entered");
+        assert!(
+            output.try_recv().is_err(),
+            "changed={changed} reached egress"
+        );
+        assert!(
+            f.policy.0.try_write().is_ok(),
+            "refusal retained a policy reader"
+        );
+    }
