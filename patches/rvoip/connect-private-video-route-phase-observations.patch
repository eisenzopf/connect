+#[tokio::test]
+async fn private_video_phase_current_source_and_target_refusals_remain_distinct() {
+    for (actor, phase) in [("bob", "source-admission"), ("alice", "target-admission")] {
+        let mut f = Preroll::new().await;
+        let prepared = f.prepare(CancellationToken::new()).await;
+        f.publish_video("bob", 303);
+        let queued = outgoing(&mut f.target_output).await;
+        f.movement
+            .room
+            .domain
+            .base
+            .0
+            .write()
+            .await
+            .revoked
+            .insert(actor.into());
+        assert!(matches!(
+            queued
+                .deliver_video_with_feedback(|_, _, _| async {
+                    panic!("revoked original private route reached writer")
+                })
+                .await,
+            Err(StreamControlError::Authority)
+        ));
+        let observed = prepared.delivery_observations();
+        assert_eq!(phase_sample(&observed[0], phase).outcomes[4], 1, "{actor}");
+        assert_eq!(
+            phase_sample(&observed[0], "queued-admission").outcomes[4],
+            1
+        );
+        assert_eq!(
+            phase_sample(&observed[0], "feedback-issuance").outcomes,
+            [0; 12]
+        );
+        assert_eq!(phase_sample(&observed[0], "io-result").outcomes, [0; 12]);
+        assert!(
+            f.movement.room.domain.base.0.try_write().is_ok(),
+            "refusal retained policy reader"
+        );
+    }
+}
