+//! Numeric observations of one exact private video route. No permission or IO.
+use super::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub(super) const PHASES: [&str; 13] = [
+    "enqueue",
+    "delivery-entry",
+    "source-admission",
+    "target-admission",
+    "target-policy",
+    "queued-admission",
+    "delivery-fence",
+    "feedback-issuance",
+    "io-result",
+    "forward-source-admission",
+    "forward-target-admission",
+    "forward-result",
+    "adapter-dequeue",
+];
+const OUTCOMES: [&str; 12] = [
+    "entered",
+    "ok",
+    "model",
+    "unsupported",
+    "authority",
+    "not-recipient",
+    "cancelled",
+    "deadline",
+    "not-ready",
+    "metadata-busy",
+    "backpressure",
+    "cleanup-unconfirmed",
+];
+// Inclusive microsecond upper bounds. Last bucket includes every older age.
+const AGE_UPPER_US: [u64; 9] = [
+    1_000,
+    5_000,
+    10_000,
+    20_000,
+    50_000,
+    100_000,
+    150_000,
+    199_999,
+    u64::MAX,
+];
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub(in crate::staged_streams) enum Phase {
+    Enqueue,
+    Dequeue,
+    SourceAdmission,
+    TargetAdmission,
+    TargetPolicy,
+    QueuedAdmission,
+    DeliveryFence,
+    FeedbackIssuance,
+    IoResult,
+    ForwardSourceAdmission,
+    ForwardTargetAdmission,
+    ForwardResult,
+    AdapterDequeue,
+}
+#[derive(Default)]
+struct Row {
+    outcomes: [AtomicU64; 12],
+    ages: [AtomicU64; 9],
+    maximum_age_us: AtomicU64,
+}
+#[derive(Default)]
+pub(in crate::staged_streams) struct Counters {
+    rows: [Row; 13],
+}
+#[derive(Debug, PartialEq, Eq)]
+pub struct PrivateVideoPhaseObservation {
+    pub phase: &'static str,
+    pub time_basis: &'static str,
+    pub outcomes: [u64; 12],
+    pub ages: [u64; 9],
+    pub maximum_age_us: u64,
+}
+/// A concurrent numeric sample, not a terminal join or a delivery assertion.
+#[derive(Debug, PartialEq, Eq)]
+pub struct PrivateVideoDeliveryObservation {
+    pub outcome_names: [&'static str; 12],
+    pub age_upper_us: [u64; 9],
+    pub phases: [PrivateVideoPhaseObservation; 13],
+    pub saturated: bool,
+}
+fn increment(counter: &AtomicU64) {
+    let _ = counter.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+        Some(n.saturating_add(1))
+    });
+}
+fn outcome<T>(result: Option<&ControlResult<T>>) -> usize {
+    match result {
+        None => 0,
+        Some(Ok(_)) => 1,
+        Some(Err(problem)) => {
+            2 + match problem {
+                StreamControlError::Model(_) => 0,
+                StreamControlError::Unsupported => 1,
+                StreamControlError::Authority => 2,
+                StreamControlError::NotRecipient => 3,
+                StreamControlError::Cancelled => 4,
+                StreamControlError::Deadline => 5,
+                StreamControlError::NotReady => 6,
+                StreamControlError::MetadataBusy => 7,
+                StreamControlError::Backpressure => 8,
+                StreamControlError::CleanupUnconfirmed => 9,
+            }
+        }
+    }
+}
+impl Counters {
+    pub(in crate::staged_streams) fn record<T>(&self, phase: Phase, at: Instant, result: Option<&ControlResult<T>>) {
+        let age = at.elapsed().as_micros().min(u64::MAX as u128) as u64;
+        self.record_age(phase, age, result);
+    }
+    fn record_age<T>(&self, phase: Phase, age: u64, result: Option<&ControlResult<T>>) {
+        let row = &self.rows[phase as usize];
+        increment(&row.outcomes[outcome(result)]);
+        increment(&row.ages[AGE_UPPER_US.iter().position(|upper| age <= *upper).unwrap()]);
+        row.maximum_age_us.fetch_max(age, Ordering::Relaxed);
+    }
+    pub(super) fn snapshot(&self) -> PrivateVideoDeliveryObservation {
+        let phases = std::array::from_fn(|i| PrivateVideoPhaseObservation {
+            phase: PHASES[i],
+            time_basis: if i == Phase::TargetPolicy as usize {
+                "policy-call-elapsed-us"
+            } else {
+                "original-packet-age-us"
+            },
+            outcomes: std::array::from_fn(|j| self.rows[i].outcomes[j].load(Ordering::Relaxed)),
+            ages: std::array::from_fn(|j| self.rows[i].ages[j].load(Ordering::Relaxed)),
+            maximum_age_us: self.rows[i].maximum_age_us.load(Ordering::Relaxed),
+        });
+        let saturated = phases
+            .iter()
+            .any(|p| p.outcomes.contains(&u64::MAX) || p.ages.contains(&u64::MAX));
+        PrivateVideoDeliveryObservation {
+            outcome_names: OUTCOMES,
+            age_upper_us: AGE_UPPER_US,
+            phases,
+            saturated,
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn private_video_phase_bins_and_original_errors_are_exact() {
+        let counters = Counters::default();
+        let errors = [
+            StreamControlError::Model(MediaTransitionError::Invalid),
+            StreamControlError::Unsupported,
+            StreamControlError::Authority,
+            StreamControlError::NotRecipient,
+            StreamControlError::Cancelled,
+            StreamControlError::Deadline,
+            StreamControlError::NotReady,
+            StreamControlError::MetadataBusy,
+            StreamControlError::Backpressure,
+            StreamControlError::CleanupUnconfirmed,
+        ];
+        for (i, error) in errors.into_iter().enumerate() {
+            let result: ControlResult<()> = Err(error);
+            counters.record_age(Phase::TargetAdmission, i as u64, Some(&result));
+            assert_eq!(outcome(Some(&result)), i + 2);
+        }
+        for (i, age) in [
+            0, 1_001, 5_001, 10_001, 20_001, 50_001, 100_001, 150_001, 200_000,
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            counters.record_age::<()>(Phase::Enqueue, age, None);
+            assert_eq!(counters.snapshot().phases[0].ages[i], 1);
+        }
+        let snapshot = counters.snapshot();
+        assert_eq!(snapshot.phases[0].maximum_age_us, 200_000);
+        assert_eq!(snapshot.phases[3].outcomes[2..], [1; 10]);
+        assert!(!snapshot.saturated);
+    }
+    #[test]
+    fn private_video_phase_accounting_is_saturating_and_owns_only_numbers() {
+        let counters = Arc::new(Counters::default());
+        counters.rows[0].outcomes[0].store(u64::MAX, Ordering::Relaxed);
+        counters.record_age::<()>(Phase::Enqueue, 5, None);
+        let snapshot = counters.snapshot();
+        assert!(snapshot.saturated);
+        assert_eq!(snapshot.phases[0].outcomes[0], u64::MAX);
+        assert_eq!(Arc::strong_count(&counters), 1);
+        let weak = Arc::downgrade(&counters);
+        drop(counters);
+        assert!(weak.upgrade().is_none());
+        assert_eq!(snapshot.phases[0].ages[0], 1);
+    }
+}
