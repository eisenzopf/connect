+        let mut output = f.ba.port(medium).take_egress().unwrap();
+        source.try_publish(&frame(&source, 901)).unwrap();
+        let packet = receive(&mut input).await;
+        let admitted = packet.admitted_at;
+        *actions.lock().unwrap() = Some(Box::new(|controller| {
