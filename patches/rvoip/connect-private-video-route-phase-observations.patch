+#[tokio::test]
+async fn ordinary_video_receive_busy_postpolicy_state_keeps_original_packet_and_deadline() {
+    let (f, actions) = receive_fixture();
+    f.start(&[Medium::Video]).await;
+    let source = f.aa.port(Medium::Video);
+    let target = f.ba.port(Medium::Video).0;
+    let ticket = target.ticket();
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Video).logical_id)
+            .unwrap();
+    let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+    source.try_publish(&frame(&source, 907)).unwrap();
+    let packet = receive(&mut input).await;
+    let admitted = packet.admitted_at;
+    let initial_deadline = tokio::time::Instant::from_std(admitted + Duration::from_millis(200));
+    let mut original_deadline = initial_deadline;
+    let (release, released) = std::sync::mpsc::channel();
+    let holder = Arc::new(Mutex::new(None));
+    *actions.lock().unwrap() = Some(Box::new({
+        let holder = holder.clone();
+        move |controller| {
+            assert!(controller.state.try_lock().is_ok());
+            let controller = controller.clone();
+            let (ready, waiting) = std::sync::mpsc::channel();
+            *holder.lock().unwrap() = Some(std::thread::spawn(move || {
+                let held = controller.state.lock().unwrap();
+                let _ = ready.send(());
+                let _ = released.recv_timeout(Duration::from_secs(2));
+                drop(held);
+            }));
+            let _ = waiting.recv_timeout(Duration::from_secs(1));
+        }
+    }));
+    let refused = packet.try_forward_to_pending(
+        &f.b,
+        &desired(Medium::Video).logical_id,
+        &target,
+        &ticket,
+        &mut original_deadline,
+    );
+    let readers_dropped = f.policy.0.try_write().is_ok();
+    let _ = release.send(());
+    holder.lock().unwrap().take().unwrap().join().unwrap();
+    assert!(actions.lock().unwrap().is_none(), "Receive callback was not entered");
+    assert!(matches!(refused, Err(StreamControlError::NotReady)));
+    assert!(
+        readers_dropped,
+        "refused attempt kept current policy readers"
+    );
+    assert!(output.try_recv().is_err());
+    assert!(original_deadline <= initial_deadline);
+    assert_eq!(packet.admitted_at, admitted);
+    packet
+        .try_forward_to_pending(
+            &f.b,
+            &desired(Medium::Video).logical_id,
+            &target,
+            &ticket,
+            &mut original_deadline,
+        )
+        .unwrap();
+    assert_eq!(packet.admitted_at, admitted);
+    assert!(original_deadline <= initial_deadline);
+    assert_video_packet(outgoing(&mut output).await).await;
+}
