+#[tokio::test]
+async fn private_video_phase_feedback_refusal_never_calls_writer_and_recovers_next_packet() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 304);
+    let queued = outgoing(&mut f.target_output).await;
+    let cache = queued.direct.as_ref().unwrap().feedback.clone();
+    let held = cache.hold_metadata_for_test();
+    assert!(matches!(
+        queued
+            .deliver_video_with_feedback(|_, _, _| async {
+                panic!("feedback refusal reached writer")
+            })
+            .await,
+        Err(StreamControlError::Backpressure)
+    ));
+    drop(held);
+    let observed = prepared.delivery_observations();
+    assert_eq!(
+        phase_sample(&observed[0], "queued-admission").outcomes[1],
+        1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "feedback-issuance").outcomes[10],
+        1
+    );
+    assert_eq!(phase_sample(&observed[0], "io-result").outcomes[10], 1);
+    f.publish_video("bob", 305);
+    outgoing(&mut f.target_output)
+        .await
+        .deliver_video_with_feedback(|_, _, _| std::future::ready(Ok(())))
+        .await
+        .unwrap();
+    assert_eq!(
+        phase_sample(&prepared.delivery_observations()[0], "feedback-issuance").outcomes[1],
+        1
+    );
+    assert!(prepared.is_current());
+}
