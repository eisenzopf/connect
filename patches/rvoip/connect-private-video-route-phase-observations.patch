+
+fn phase_sample<'a>(
+    observation: &'a crate::staged_streams::direct_subscriptions::PrivateVideoDeliveryObservation,
+    phase: &str,
+) -> &'a crate::staged_streams::direct_subscriptions::PrivateVideoPhaseObservation {
+    observation
+        .phases
+        .iter()
+        .find(|row| row.phase == phase)
+        .unwrap()
+}
+
+#[tokio::test]
+async fn private_video_phase_success_observes_original_route_and_excludes_public_delivery() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 301);
+    let before = prepared.delivery_observations();
+    assert_eq!(before.len(), 1);
+    assert_eq!(phase_sample(&before[0], "enqueue").outcomes[0..2], [1, 1]);
+    assert_eq!(phase_sample(&before[0], "delivery-entry").outcomes, [0; 12]);
+    delivered(&mut f.old_output, 301).await;
+    assert_eq!(
+        prepared.delivery_observations(),
+        before,
+        "public old route changed private counters"
+    );
+    let queued = outgoing(&mut f.target_output).await;
+    let original_timestamp = queued.frame.timestamp_rtp;
+    let original_admitted_at = queued.admitted_at;
+    queued.observe_private_video_adapter_dequeue();
+    assert_eq!(queued.frame.timestamp_rtp, original_timestamp);
+    assert_eq!(queued.admitted_at, original_admitted_at);
+    assert!(prepared.is_current());
+    let dequeued = prepared.delivery_observations();
+    assert_eq!(phase_sample(&dequeued[0], "adapter-dequeue").outcomes[0], 1);
+    assert_eq!(
+        phase_sample(&dequeued[0], "delivery-entry").outcomes,
+        [0; 12]
+    );
+    queued
+        .deliver_video_with_feedback(|frame, origin, _| {
+            assert_eq!(frame.timestamp_rtp, 301);
+            assert_eq!(origin.unwrap().connection, ConnectionId::from_string("bob"));
+            std::future::ready(Ok(()))
+        })
+        .await
+        .unwrap();
+    let after = prepared.delivery_observations();
+    for phase in [
+        "source-admission",
+        "target-admission",
+        "queued-admission",
+        "feedback-issuance",
+        "io-result",
+    ] {
+        assert_eq!(phase_sample(&after[0], phase).outcomes[1], 1, "{phase}");
+    }
+    assert_eq!(phase_sample(&after[0], "delivery-entry").outcomes[0], 1);
+    assert!(prepared.is_current());
+    f.assert_target_quarantined();
+}
