+#[tokio::test]
+async fn ordinary_video_receive_policy_allows_an_existing_queued_writer_to_drain() {
+    let (f, actions) = receive_fixture();
+    f.start(&[Medium::Video]).await;
+    let source = f.aa.port(Medium::Video);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Video).logical_id)
+            .unwrap();
+    let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+    let first = queued_video(&f, &source, &mut input, &mut output, 905).await;
+    source.try_publish(&frame(&source, 906)).unwrap();
+    let second = receive(&mut input).await;
+    let (entered, waiting) = std::sync::mpsc::channel();
+    let (release, released) = std::sync::mpsc::channel();
+    *actions.lock().unwrap() = Some(Box::new(move |controller| {
+        let available = controller.state.try_lock().is_ok();
+        entered.send(available).unwrap();
+        // Pause before acquiring this target's policy grant, bounded even if a
+        // regression prevents the other writer. This is not production pacing.
+        let _ = released.recv_timeout(Duration::from_secs(2));
+    }));
+    let target = f.b.clone();
+    let worker = std::thread::spawn(move || {
+        second.try_forward_to(&target, &desired(Medium::Video).logical_id)
+    });
+    let state_available = waiting.recv_timeout(Duration::from_secs(1));
+    let wrote = AtomicBool::new(false);
+    let drained = if matches!(state_available, Ok(true)) {
+        first.deliver(|_| async {
+            wrote.store(true, Ordering::Release);
+            Ok(())
+        }).await
+    } else {
+        Err(StreamControlError::NotReady)
+    };
+    let _ = release.send(());
+    let second_result = worker.join().unwrap();
+    assert!(
+        matches!(state_available, Ok(true)),
+        "ordinary Receive policy excluded queued target admission"
+    );
+    assert!(
+        drained.is_ok(),
+        "existing queued packet did not drain while policy was paused"
+    );
+    assert!(wrote.load(Ordering::Acquire));
+    second_result.unwrap();
+    assert_video_packet(outgoing(&mut output).await).await;
+    assert!(f.policy.0.try_write().is_ok());
+}
