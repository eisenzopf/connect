+#[tokio::test]
+async fn private_video_phase_feedback_refusal_never_calls_writer_and_recovers_next_packet() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 304);
+    let queued = outgoing(&mut f.target_output).await;
+    let cache = queued.direct.as_ref().unwrap().feedback.clone();
+    let held = cache.hold_metadata_for_test();
+    assert!(matches!(
+        queued
+            .deliver_video_with_feedback(|_, _, _| async {
+                panic!("feedback refusal reached writer")
+            })
+            .await,
+        Err(StreamControlError::Backpressure)
+    ));
+    drop(held);
+    let observed = prepared.delivery_observations();
+    assert_eq!(
+        phase_sample(&observed[0], "queued-admission").outcomes[1],
+        1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "feedback-issuance").outcomes[10],
+        1
+    );
+    assert_eq!(phase_sample(&observed[0], "io-result").outcomes[10], 1);
+    f.publish_video("bob", 305);
+    outgoing(&mut f.target_output)
+        .await
+        .deliver_video_with_feedback(|_, _, _| std::future::ready(Ok(())))
+        .await
+        .unwrap();
+    assert_eq!(
+        phase_sample(&prepared.delivery_observations()[0], "feedback-issuance").outcomes[1],
+        1
+    );
+    assert!(prepared.is_current());
+}
+
+#[tokio::test]
+async fn private_video_phase_cancelled_original_route_never_reenters_writer() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 306);
+    let queued = outgoing(&mut f.target_output).await;
+    prepared.close();
+    assert!(matches!(
+        queued
+            .deliver_video_with_feedback(|_, _, _| async {
+                panic!("cancelled original private route reached writer")
+            })
+            .await,
+        Err(StreamControlError::Cancelled)
+    ));
+    let observed = prepared.delivery_observations();
+    assert_eq!(
+        phase_sample(&observed[0], "queued-admission").outcomes[6],
+        1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "feedback-issuance").outcomes,
+        [0; 12]
+    );
+    delivered(&mut f.old_output, 306).await;
+    f.assert_target_quarantined();
+}
+
+#[tokio::test]
+async fn private_video_phase_writer_error_is_preserved_after_successful_feedback_admission() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 307);
+    assert!(matches!(
+        outgoing(&mut f.target_output)
+            .await
+            .deliver_video_with_feedback(|_, _, _| std::future::ready(Err(
+                StreamControlError::Unsupported
+            )))
+            .await,
+        Err(StreamControlError::Unsupported)
+    ));
+    let observed = prepared.delivery_observations();
+    assert_eq!(
+        phase_sample(&observed[0], "feedback-issuance").outcomes[1],
+        1
+    );
+    assert_eq!(phase_sample(&observed[0], "delivery-fence").outcomes[1], 1);
+    assert_eq!(phase_sample(&observed[0], "io-result").outcomes[3], 1);
+    assert!(prepared.is_current());
+    f.assert_target_quarantined();
+}
