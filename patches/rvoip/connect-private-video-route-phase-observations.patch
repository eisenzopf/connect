+#[tokio::test]
+async fn private_video_phase_cancelled_original_route_never_reenters_writer() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 306);
+    let queued = outgoing(&mut f.target_output).await;
+    let private_ticket = queued.direct.as_ref().unwrap().delivery_ticket();
+    assert!(private_ticket.is_current());
+    let policy_before = prepared.delivery_observations();
+    let policy_ok_before = phase_sample(&policy_before[0], "target-policy").outcomes[1];
+    prepared.close();
+    // Closing this private preparation retires its selection ticket. The
+    // existing direct-guard preflight refuses that ticket with Authority;
+    // source/target scene lifetime cancellation is a distinct later boundary.
+    assert!(!private_ticket.is_current());
+    assert!(queued.sources[0].ticket.is_current());
+    assert!(queued.target_ticket.is_current());
+    assert!(!prepared.is_current());
+    assert!(matches!(
+        queued
+            .deliver_video_with_feedback(|_, _, _| async {
+                panic!("cancelled original private route reached writer")
+            })
+            .await,
+        Err(StreamControlError::Authority)
+    ));
+    let observed = prepared.delivery_observations();
+    assert_eq!(
+        phase_sample(&observed[0], "queued-admission").outcomes[4],
+        1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "source-admission").outcomes[1],
+        1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "target-policy").outcomes[1],
+        policy_ok_before + 1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "target-admission").outcomes[4],
+        1
+    );
+    assert_eq!(
+        phase_sample(&observed[0], "delivery-fence").outcomes,
+        [0; 12]
+    );
+    assert_eq!(phase_sample(&observed[0], "io-result").outcomes, [0; 12]);
+    assert_eq!(
+        phase_sample(&observed[0], "feedback-issuance").outcomes,
+        [0; 12]
+    );
+    delivered(&mut f.old_output, 306).await;
+    f.assert_target_quarantined();
+}
+
+#[tokio::test]
+async fn private_video_phase_writer_error_is_preserved_after_successful_feedback_admission() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 307);
+    assert!(matches!(
+        outgoing(&mut f.target_output)
+            .await
+            .deliver_video_with_feedback(|_, _, _| std::future::ready(Err(
+                StreamControlError::Unsupported
+            )))
+            .await,
+        Err(StreamControlError::Unsupported)
+    ));
+    let observed = prepared.delivery_observations();
+    assert_eq!(
+        phase_sample(&observed[0], "feedback-issuance").outcomes[1],
+        1
+    );
+    assert_eq!(phase_sample(&observed[0], "delivery-fence").outcomes[1], 1);
+    assert_eq!(phase_sample(&observed[0], "io-result").outcomes[3], 1);
+    assert!(prepared.is_current());
+    f.assert_target_quarantined();
+}
