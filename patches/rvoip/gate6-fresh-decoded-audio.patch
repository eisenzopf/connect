+#[tokio::test]
+async fn guarded_mixer_burst_plays_newest_decoded_packet_without_replaying_backlog() {
+    let s = Scene::new(&four()[..2], 8000).await;
+    s.bind(0, true).await;
+    s.bind(1, true).await;
+    let mut output = s.port(1).take_egress().unwrap();
+    for value in [1000, 3000, 7000] {
+        s.publish(0, value);
+    }
+    s.mixer.tick();
+    heard(output.try_recv().unwrap(), 7000).await;
+    s.mixer.tick();
+    assert!(output.try_recv().is_err(), "older decoded backlog replayed");
+    drop(
+        s.policy
+            .0
+            .try_write()
+            .expect("idle decoded metadata retained authority"),
+    );
+}
+#[tokio::test]
+async fn guarded_mixer_long_original_packet_keeps_remaining_samples_without_new_input() {
+    let s = Scene::new(&four()[..2], 8000).await;
+    s.bind(0, true).await;
+    s.bind(1, true).await;
+    let mut output = s.port(1).take_egress().unwrap();
+    let port = s.port(0);
+    let mut packet = frame(&port, 0);
+    packet.payload = packet.payload.repeat(2).into();
+    port.try_publish(&packet).unwrap();
+    for _ in 0..2 {
+        s.mixer.tick();
+        heard(output.try_recv().unwrap(), 1800).await;
+    }
+    s.mixer.tick();
+    assert!(
+        output.try_recv().is_err(),
+        "long packet replayed beyond its samples"
+    );
+}
+#[tokio::test]
+async fn guarded_mixer_new_decoded_packet_supersedes_older_partial_audio() {
+    let s = Scene::new(&four()[..2], 8000).await;
+    s.bind(0, true).await;
+    s.bind(1, true).await;
+    let mut output = s.port(1).take_egress().unwrap();
+    let port = s.port(0);
+    let mut packet = frame(&port, 0);
+    packet.payload = packet.payload.repeat(2).into();
+    port.try_publish(&packet).unwrap();
+    s.mixer.tick();
+    heard(output.try_recv().unwrap(), 1800).await;
+    s.publish(0, 7000);
+    s.mixer.tick();
+    heard(output.try_recv().unwrap(), 7000).await;
+    s.mixer.tick();
+    assert!(
+        output.try_recv().is_err(),
+        "superseded partial audio replayed"
+    );
+}
