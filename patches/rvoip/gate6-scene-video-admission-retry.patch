+#[tokio::test]
+async fn scene_video_retry_cannot_follow_a_replaced_receiver_port() {
+    let (s, blocked, _) = setup().await;
+    let mut old = s.f.ba.port(Medium::Video).take_egress().unwrap();
+    s.publish(Medium::Video, 9000);
+    blocked.store(2, Ordering::Release);
+    s.scene.tick();
+    s.f.b
+        .change(
+            s.f.b.revision(),
+            &[desired(Medium::Video)],
+            &[desired(Medium::Video).logical_id].into_iter().collect(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+    let mut new = s.f.ba.port(Medium::Video).take_egress().unwrap();
+    blocked.store(0, Ordering::Release);
+    s.scene.tick();
+    assert!(old.try_recv().is_err());
+    assert!(
+        new.try_recv().is_err(),
+        "pending packet followed a new receiver generation"
+    );
+    s.publish(Medium::Video, 18000);
+    s.scene.tick();
+    new.try_recv()
+        .unwrap()
+        .deliver(|f| async move {
+            assert_eq!(f.timestamp_rtp, 18000);
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn scene_video_retry_carries_earliest_authority_expiry_into_queued_delivery() {
+    let (s, blocked, expiry) = setup().await;
+    let mut out = s.f.ba.port(Medium::Video).take_egress().unwrap();
+    s.publish(Medium::Video, 9000);
+    *expiry.lock().unwrap() = Some(chrono::Utc::now() + chrono::Duration::milliseconds(120));
+    blocked.store(2, Ordering::Release);
+    s.scene.tick();
+    *expiry.lock().unwrap() = None;
+    blocked.store(0, Ordering::Release);
+    s.scene.tick();
+    let packet = out
+        .try_recv()
+        .expect("original current video did not recover");
+    tokio::time::sleep(Duration::from_millis(140)).await;
+    assert!(matches!(
+        packet
+            .deliver(|_| async { panic!("queued retry refreshed earlier authority expiry") })
+            .await,
+        Err(StreamControlError::Deadline)
+    ));
+}
