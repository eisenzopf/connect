+#[cfg(test)]
+mod public_route_refresh_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    fn binding() -> ReadyMediaBinding {
+        ReadyMediaBinding { negotiated: NegotiatedStream { requested: DesiredStream {
+            logical_id: StreamId::from_string("camera"), medium: Medium::Video, direction: StreamDirection::Both,
+        }, format: MediaFormat::Encoded {name:"vp8".into(),clock_rate_hz:90000,channels:0,fmtp:None}},
+        transport_id:StreamId::from_string("physical-camera"),stream_local_id:7,generation:3,connection_generation:2,source_ready:true,sink_ready:true }
+    }
+    fn history() -> VideoFeedbackEpoch { VideoFeedbackEpoch {publisher:false,epoch:41,ssrc:83,first_sequence:71,first_timestamp:9000} }
+    #[test]
+    fn same_receiver_history_rebinds_only_new_current_scope_without_new_revision_or_old_scope_revival() {
+        let flow=NativeFlow::new(CancellationToken::new());let binding=binding();
+        let profile=flow.video_feedback_profile(&binding,"original-op","original-offer");
+        let private=Arc::new(AtomicBool::new(true));let old=private.clone();
+        profile.announce(&binding,history(),Arc::new(move||old.load(Ordering::Acquire))).unwrap();
+        let before=flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).unwrap();
+        private.store(false,Ordering::Release);
+        assert!(!flow.video_epoch_current(&before));
+        let public=Arc::new(AtomicBool::new(true));let next=public.clone();
+        profile.announce(&binding,history(),Arc::new(move||next.load(Ordering::Acquire))).unwrap();
+        let after=flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).unwrap();
+        assert!(flow.video_epoch_current(&after));assert!(!flow.video_epoch_current(&before));
+        assert_eq!(after.revision(),before.revision());assert_eq!(after.epoch(),before.epoch());
+        assert_eq!(after.original_operation(),before.original_operation());assert_eq!(after.original_offer(),before.original_offer());
+        assert_eq!(after.epoch().first_sequence,71);assert_eq!(after.epoch().first_timestamp,9000);
+        let sent=BTreeMap::from([(before.key(),before.revision())]);
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&sent,true).is_none(),"same history was reannounced");
+        public.store(false,Ordering::Release);
+        assert!(!flow.video_epoch_current(&after));
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).is_none());
+    }
+    #[test]
+    fn receiver_history_refresh_refuses_stale_or_foreign_binding_and_changed_provenance_is_new_revision() {
+        let flow=NativeFlow::new(CancellationToken::new());let binding=binding();
+        let profile=flow.video_feedback_profile(&binding,"original-op","original-offer");
+        let live=Arc::new(AtomicBool::new(true));let current=live.clone();
+        profile.announce(&binding,history(),Arc::new(move||current.load(Ordering::Acquire))).unwrap();
+        let before=flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).unwrap();
+        live.store(false,Ordering::Release);
+        assert!(profile.announce(&binding,history(),Arc::new(||false)).is_err());
+        let mut foreign=binding.clone();foreign.generation+=1;
+        assert!(profile.announce(&foreign,history(),Arc::new(||true)).is_err());
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).is_none());
+        // A new negotiated original operation/offer must never inherit the old
+        // announcement revision just because a supplied epoch value matches.
+        flow.video_feedback_profile(&binding,"other-op","other-offer")
+            .announce(&binding,history(),Arc::new(||true)).unwrap();
+        let changed=flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).unwrap();
+        assert!(changed.revision()>before.revision());assert_eq!(changed.original_operation(),"other-op");
+        assert_eq!(changed.original_offer(),"other-offer");assert!(!flow.video_epoch_current(&before));
+    }
+}
