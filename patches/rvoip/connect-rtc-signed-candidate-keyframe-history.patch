+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rvoip_core::{
+        ids::{ConversationId, SessionId},
+        staged_streams::frame_realm::FrameRealmTestOwner,
+    };
+
+    #[test]
+    fn pre_cut_keyframe_snapshot_keeps_exact_first_and_recent_submissions_across_wrap() {
+        let realm = FrameRealmTestOwner::new(ConversationId::new(), SessionId::new());
+        let source = realm.handle();
+        let point = |index: u32| {
+            OriginalVideoFrame::observed_in_realm(19, 7, index, u64::from(index), Some(&source))
+                .frame_realm()
+                .unwrap()
+        };
+        let retained = PreCutKeyframes::default();
+        assert!(retained.timestamps().is_none());
+        for n in 0..20 {
+            retained.retain(ReceiverReleaseFrame {
+                point: point(n),
+                timestamp: (u32::MAX - 4).wrapping_add(n),
+            });
+        }
+        retained.retain(ReceiverReleaseFrame {
+            point: point(20),
+            timestamp: 14,
+        });
+        let timestamps = retained.timestamps().unwrap();
+        assert_eq!(timestamps.len(), PRE_CUT_HISTORY);
+        assert_eq!(timestamps[0], u32::MAX - 4);
+        assert_eq!(&timestamps[1..], &(0..=14).collect::<Vec<_>>());
+        assert!(retained.exact(u32::MAX).is_none());
+        assert_eq!(retained.exact(0).unwrap().original_point().ordinal(), 6);
+        assert_eq!(retained.exact(14).unwrap().original_point().ordinal(), 20);
+    }
+}
