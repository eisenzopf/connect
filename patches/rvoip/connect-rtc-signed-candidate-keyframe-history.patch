+const PRE_CUT_HISTORY: usize = 16;
+
+#[derive(Default)]
+struct PreCutKeyframes(ArcSwap<Vec<Arc<ReceiverReleaseFrame>>>);
+
+impl PreCutKeyframes {
+    // The existing writer timeline is the sole writer. Status consumers
+    // take immutable snapshots without acquiring a packet-path mutex.
+    fn retain(&self, frame: ReceiverReleaseFrame) {
+        let current = self.0.load_full();
+        if current.iter().any(|old| old.timestamp == frame.timestamp) {
+            return;
+        }
+        let mut next = current.as_ref().clone();
+        if next.len() == PRE_CUT_HISTORY {
+            // Keep the first startup picture and the most recent whole keys.
+            next.remove(1);
+        }
+        next.push(Arc::new(frame));
+        self.0.store(Arc::new(next));
+    }
+
+    fn timestamps(&self) -> Option<Vec<u32>> {
+        let current = self.0.load();
+        (!current.is_empty()).then(|| current.iter().map(|frame| frame.timestamp).collect())
+    }
+
+    fn exact(&self, timestamp: u32) -> Option<Arc<ReceiverReleaseFrame>> {
+        self.0
+            .load()
+            .iter()
+            .find(|frame| frame.timestamp == timestamp)
+            .cloned()
+    }
+}
