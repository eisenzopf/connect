+use super::*;
+use rvoip_core::adapter::TerminalDelivery;
+use rvoip_core::operational_events::OperationalEvent;
+
+struct BlockedTerminal {
+    core: Arc<Orchestrator>,
+    sender: StubEventSender,
+    connection: ConnectionId,
+    operational: mpsc::Receiver<OperationalEvent>,
+    receipt: Option<rvoip_core::adapter::TerminalDeliveryReceipt>,
+}
+
+impl BlockedTerminal {
+    async fn new() -> Self {
+        Self::new_with_reserved_terminal(false).await
+    }
+
+    async fn new_with_reserved_terminal(reserved: bool) -> Self {
+        let core = Orchestrator::new(Config::default());
+        let operational = core.install_operational_event_stream(1).unwrap();
+        let (adapter, sender, _) = StubAdapter::new();
+        core.register(adapter.clone()).unwrap();
+        let connection = publish_operational_test_connection(
+            &core,
+            &adapter,
+            &sender,
+            Transport::Sip,
+            "tenant-drain-custody",
+        )
+        .await;
+        sender
+            .send(AdapterEvent::Dtmf {
+                connection_id: connection.clone(),
+                digits: "1".into(),
+                duration_ms: 40,
+            })
+            .await
+            .unwrap();
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while operational.len() != 1 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("first original event filled the real authoritative queue");
+        sender
+            .send(AdapterEvent::Dtmf {
+                connection_id: connection.clone(),
+                digits: "2".into(),
+                duration_ms: 50,
+            })
+            .await
+            .unwrap();
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while sender.0.capacity() != sender.0.max_capacity() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("normalizer consumed the second original event into its blocked handler");
+        // The single normalizer has dequeued DTMF 2 while DTMF 1 still occupies
+        // its capacity-one destination. The actual accepted terminal is next.
+        let terminal = AdapterEvent::Ended {
+            connection_id: connection.clone(),
+            reason: EndReason::Normal,
+        };
+        let receipt = if reserved {
+            let prepared = adapter
+                .lifecycle
+                .reserve_orchestrator_terminal(&sender.0, terminal)
+                .unwrap();
+            let receipt = prepared.receipt();
+            adapter.mark_ended(&connection);
+            prepared.activate().unwrap();
+            Some(receipt)
+        } else {
+            adapter.mark_ended(&connection);
+            sender
+                .0
+                .try_send(OrchestratorAdapterEvent::Public(terminal))
+                .unwrap();
+            None
+        };
+        Self {
+            core,
+            sender,
+            connection,
+            operational,
+            receipt,
+        }
+    }
+
+    fn assert_retained(&self) {
+        assert_eq!(
+            self.core.connection_lifecycle_task_count(),
+            1 + usize::from(self.receipt.is_some()),
+            "the original normalizer and any reserved terminal remain owned"
+        );
+        assert!(
+            self.core.connection_transport(&self.connection).is_ok(),
+            "queued terminal remains pending behind actual publication backpressure"
+        );
+        assert_eq!(
+            self.core.operational_event_stream_health(),
+            OperationalEventStreamHealth::Healthy,
+            "drain must not cancel the accepted in-flight send"
+        );
+        assert!(
+            self.sender.0.is_closed(),
+            "stop seals original intake even while its handler is blocked"
+        );
+    }
+
+    async fn release_and_join(mut self) {
+        let core = self.core.clone();
+        let original = tokio::spawn(async move {
+            core.drain_connection_lifecycle_tasks_until(
+                tokio::time::Instant::now() + Duration::from_secs(1),
+            )
+            .await
+        });
+        let first = self.operational.recv().await.unwrap();
+        let second = self.operational.recv().await.unwrap();
+        let terminal = self.operational.recv().await.unwrap();
+        assert!(
+            matches!(first.kind, OperationalEventKind::Dtmf { ref digits, .. } if digits == "1")
+        );
+        assert!(
+            matches!(second.kind, OperationalEventKind::Dtmf { ref digits, .. } if digits == "2")
+        );
+        assert!(matches!(terminal.kind, OperationalEventKind::Ended { .. }));
+        assert_eq!(terminal.connection_id, self.connection);
+        assert!(first.sequence < second.sequence && second.sequence < terminal.sequence);
+        original.await.unwrap().unwrap();
+        if let Some(receipt) = self.receipt.as_ref() {
+            receipt.wait().await.unwrap();
+        }
+        assert_eq!(self.core.connection_lifecycle_task_count(), 0);
+        assert!(matches!(
+            self.core.connection_transport(&self.connection),
+            Err(RvoipError::ConnectionNotFound(_))
+        ));
+        assert!(
+            self.operational.try_recv().is_err(),
+            "original FIFO events delivered exactly once"
+        );
+        self.core.drain_connection_lifecycle_tasks().await.unwrap();
+        assert_eq!(
+            self.core.operational_event_stream_health(),
+            OperationalEventStreamHealth::Healthy
+        );
+    }
+}
