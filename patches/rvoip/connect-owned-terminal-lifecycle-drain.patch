+#[tokio::test(flavor = "current_thread")]
+async fn terminal_admission_has_independent_bounded_capacity_and_abandonment_joins() {
+    let core = Orchestrator::new(Config::default());
+    let supervisor = &core.connection_lifecycle_tasks;
+    for _ in 0..supervisor.capacity {
+        assert!(supervisor.spawn(std::future::pending()));
+    }
+    assert!(
+        !supervisor.spawn(std::future::pending()),
+        "ordinary task capacity is actually full"
+    );
+    let sink = OrchestratorLifecycleSink {
+        orchestrator: Arc::downgrade(&core),
+        transport: Transport::Sip,
+    };
+    let mut held = Vec::new();
+    let mut receipts = Vec::new();
+    for _ in 0..supervisor.capacity {
+        let prepared = sink
+            .reserve_terminal(AdapterEvent::Ended {
+                connection_id: ConnectionId::new(),
+                reason: EndReason::Normal,
+            })
+            .expect("original terminal capacity is independent of abortable activity");
+        receipts.push(prepared.receipt());
+        held.push(prepared);
+    }
+    assert!(matches!(
+        sink.reserve_terminal(AdapterEvent::Ended {
+            connection_id: ConnectionId::new(),
+            reason: EndReason::Normal
+        }),
+        Err(TerminalDeliveryError::Capacity)
+    ));
+    assert_eq!(supervisor.task_count(), 2 * supervisor.capacity);
+    drop(held);
+    for receipt in receipts {
+        assert_eq!(receipt.wait().await, Err(TerminalDeliveryError::Cancelled));
+    }
+    core.drain_connection_lifecycle_tasks().await.unwrap();
+    assert_eq!(supervisor.task_count(), 0);
+}
