+                event,
+                activation: Arc::new(Mutex::new(Some(start))),
+                failure: finished.clone(),
+                receipt: TerminalDeliveryReceipt { finished: receipt },
+            },
+            started,
+            TerminalCompletion {
+                finished,
+                armed: true,
+            },
+        )
