+    struct OriginalOwner(Option<oneshot::Sender<()>>);
+    impl Drop for OriginalOwner {
+        fn drop(&mut self) {
+            if let Some(tx) = self.0.take() {
+                let _ = tx.send(());
+            }
+        }
+    }
+    let original_owner = OriginalOwner(Some(drop_tx));
+    assert!(supervisor.spawn(async move {
