+use super::*;
+
+/// This source is intentionally valid against both the original void drain
+/// API and the corrected Result API. The negative-control assertion is the
+/// actual retained Core connection, not an API-shape or compilation failure.
+#[tokio::test(flavor = "current_thread")]
+async fn queued_terminal_is_retired_before_lifecycle_drain_returns() {
+    let orchestrator = Orchestrator::new(Config::default());
+    let mut operational = orchestrator.install_operational_event_stream(4).unwrap();
+    let (adapter, sender, _) = StubAdapter::new();
+    orchestrator.register(adapter.clone()).unwrap();
+    let connection_id = publish_operational_test_connection(
+        &orchestrator,
+        &adapter,
+        &sender,
+        Transport::Sip,
+        "tenant-queued-drain",
+    )
+    .await;
+    let mut public = orchestrator.subscribe_events();
+    assert_eq!(sender.0.capacity(), sender.0.max_capacity());
+    adapter.mark_ended(&connection_id);
+    sender
+        .0
+        .try_send(OrchestratorAdapterEvent::Public(AdapterEvent::Ended {
+            connection_id: connection_id.clone(),
+            reason: EndReason::Normal,
+        }))
+        .expect("original adapter queue accepted the terminal event");
+    // No await/yield between enqueue and drain: on this current-thread runtime
+    // the original normalizer cannot dequeue the terminal before drain starts.
+    let _completion = tokio::time::timeout(
+        Duration::from_secs(1),
+        orchestrator.drain_connection_lifecycle_tasks(),
+    )
+    .await
+    .expect("original drain observer completed");
+    assert!(
+        matches!(
+            orchestrator.connection_transport(&connection_id),
+            Err(RvoipError::ConnectionNotFound(_))
+        ),
+        "accepted terminal was discarded before Core logical retirement"
+    );
+    assert_eq!(orchestrator.connection_lifecycle_task_count(), 0);
+    assert_eq!(
+        orchestrator.operational_event_stream_health(),
+        OperationalEventStreamHealth::Healthy
+    );
+    let terminal = operational
+        .try_recv()
+        .expect("original authoritative terminal delivered");
+    assert_eq!(terminal.connection_id, connection_id);
+    assert!(matches!(terminal.kind, OperationalEventKind::Ended { .. }));
+    assert!(
+        operational.try_recv().is_err(),
+        "no duplicate authoritative terminal"
+    );
+    assert!(
+        matches!(public.try_recv(), Ok(Event::ConnectionEnded { connection_id: observed, .. }) if observed == connection_id)
+    );
+    assert!(public.try_recv().is_err(), "no duplicate public terminal");
+    assert!(
+        sender.0.is_closed(),
+        "normalizer intake is closed after joined drain"
+    );
+}
