+impl TerminalCompletion {
+    pub(crate) fn finish(mut self, result: std::result::Result<(), TerminalDeliveryError>) {
+        self.finished.send_if_modified(|finished| {
+            if finished.is_none() {
+                *finished = Some(result);
+                true
+            } else {
+                false
+            }
+        });
+        self.armed = false;
+    }
