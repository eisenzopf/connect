+    }));
+    let failed_commit = catch_unwind(AssertUnwindSafe(|| {
+        let _: Result<()> = supervisor.spawn_with_commit(std::future::pending(), || {
+            panic!("intentional synchronous ownership-commit failure")
+        });
+    }));
+    assert!(failed_commit.is_err());
+    assert_eq!(
+        supervisor.task_count(),
+        1,
+        "poison does not erase the actual original side-effect owner"
+    );
+    assert!(matches!(
+        supervisor.drain(None).await,
+        Err(RvoipError::InvalidState("connection lifecycle task failed"))
+    ));
+    dropped
+        .await
+        .expect("the original side-effect owner actually dropped during abort/join");
+    assert_eq!(supervisor.task_count(), 0);
