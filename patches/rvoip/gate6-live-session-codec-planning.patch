+fn live_session_codec_plan_preserves_unrequested_video_and_existing_data_without_new_support() {
+    let initial = NativeOfferPlan::parse(&offer(), &profile(), &actor()).unwrap();
+    for medium in [Medium::Video, Medium::Data] {
+        let mut bindings = codec_bindings(&initial);
+        bindings[1].negotiated.requested.medium = medium;
+        bindings[1].negotiated.format = if medium == Medium::Data {
+            MediaFormat::ReliableOrdered(rvoip_core::capability::DataProtocol::Binary)
+        } else {
+            MediaFormat::Encoded {
+                name: "vp8".into(),
+                clock_rate_hz: 90000,
+                channels: 0,
+                fmtp: None,
+            }
+        };
+        let remote = NativeOfferPlan::declaration(
+            &json!({"audio_codecs":[{"name":"pcmu","params":{}},{"name":"pcma","params":{}}]}),
+            &profile(),
+            &actor(),
+        )
+        .unwrap();
+        let selected =
+            NativeOfferPlan::session_codec_update(&["pcmu".into()], &profile(), &remote, &bindings)
+                .unwrap();
+        assert_eq!(selected.selected()[0].format, audio("pcmu"));
+        assert_eq!(selected.selected()[1], bindings[1].negotiated);
+        if medium == Medium::Data {
+            let unchanged = NativeOfferPlan::session_codec_update(
+                &["reliable-ordered".into()],
+                &profile(),
+                &remote,
+                &bindings,
+            )
