+    pub(crate) fn plan_session_codecs(
+        &self,
+        preferences: &[String],
+        bindings: &[ReadyMediaBinding],
+    ) -> Result<NativeOfferPlan, NativeOfferError> {
+        let retained = self.retained.lock().unwrap_or_else(|p| p.into_inner());
+        let retained = retained.as_ref().ok_or(NativeOfferError::NotReady)?;
+        NativeOfferPlan::session_codec_update(preferences, &self.profile, retained.future_capabilities(), bindings)
+            .map(|plan| Self::stamp_declaration(plan, retained.declaration_generation))
     }
