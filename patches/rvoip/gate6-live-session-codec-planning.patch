+#[test]
+fn live_session_codec_plan_respects_both_directions_and_does_not_invent_a_peer_format() {
+    let initial = NativeOfferPlan::parse(&offer(), &profile(), &actor()).unwrap();
+    let bindings = codec_bindings(&initial);
+    let mut remote = initial.remote_capabilities().clone();
+    for cap in &mut remote.receive {
+        if cap.medium == Medium::Audio {
+            cap.formats = vec![audio("pcmu")];
+        }
+    }
+    let selected =
+        NativeOfferPlan::session_codec_update(&["pcma".into()], &profile(), &remote, &bindings)
+            .unwrap();
+    assert_eq!(selected.selected()[0].format, audio("pcmu"));
+    // The second Stream is local receive-only; the peer may still send PCMA.
+    assert_eq!(selected.selected()[1].format, audio("pcma"));
+}
