+//! A controller-bound live codec proposal. This retains metadata, never grants.
+use super::{
+    native_negotiation::NativeOfferPlan,
+    native_requests::{NativeRequestOrigin, NativeRequestScope},
+};
+use std::sync::Arc;
+/// Planning alone cannot perform IO, advance a revision or create a receipt.
+/// Execution must independently reauthorize and fence this exact current origin,
+/// revision, peer capability declaration and complete selected binding set.
+pub struct NativeSessionCodecPlan {
+    pub(crate) origin: Arc<NativeRequestOrigin>,
+    scope: NativeRequestScope,
+    media: NativeOfferPlan,
+    resources: bool,
+}
+impl NativeSessionCodecPlan {
+    pub(crate) fn new(
+        origin: Arc<NativeRequestOrigin>,
+        revision: u64,
+        media: NativeOfferPlan,
+        resources: bool,
+    ) -> Self {
+        Self {
+            scope: origin.request_scope(revision),
+            origin,
+            media,
+            resources,
+        }
+    }
+    pub fn scope(&self) -> &NativeRequestScope {
+        &self.scope
+    }
+    pub fn expected_revision(&self) -> u64 {
+        self.scope.stream_revision
+    }
+    pub fn media(&self) -> &NativeOfferPlan {
+        &self.media
+    }
+    pub fn changes_resources(&self) -> bool {
+        self.resources
+    }
+}
+impl std::fmt::Debug for NativeSessionCodecPlan {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeSessionCodecPlan(metadata)")
+    }
+}
