+    /// Pure live Session codec planning. The returned revision/capability
+    /// snapshot is neither an execution lease nor a readiness/authorization grant.
+    pub fn plan_native_session_codecs(
+        &self,
+        id: &ConnectionId,
+        origin: &Arc<super::native_requests::NativeRequestOrigin>,
+        preferences: &[String],
+    ) -> std::result::Result<super::native_session_codecs::NativeSessionCodecPlan, super::native_negotiation::NativeOfferError> {
+        use super::native_negotiation::NativeOfferError;
+        let (controller, broker, flow, _) = self.reconciliation_parts(id, origin)?;
+        if broker.is_busy() { return Err(NativeOfferError::Conflict); }
+        let revision = controller.revision();
+        if !flow.confirmed_at(revision) { return Err(NativeOfferError::NotReady); }
+        let bindings = controller.active_bindings();
+        let media = broker.plan_session_codecs(preferences, &bindings)?;
+        let resources = media.selected().len() != bindings.len()
+            || media.selected().iter().any(|s| !bindings.iter().any(|b| &b.negotiated == s));
+        Ok(super::native_session_codecs::NativeSessionCodecPlan::new(origin.clone(), revision, media, resources))
+    }
