+    /// Plan a Session policy against existing bindings. This is metadata only.
+    /// Unrequested media and data encodings keep their exact current bindings.
+    pub(crate) fn session_codec_update(
+        preferences: &[String],
+        profile: &NativeMediaProfile,
+        remote: &EndpointMediaCapabilities,
+        bindings: &[ReadyMediaBinding],
+    ) -> Result<Self, NativeOfferError> {
+        if preferences.is_empty() || bindings.is_empty() {
+            return Err(NativeOfferError::Invalid);
+        }
+        if bindings.len() > 32 {
+            return Err(NativeOfferError::Capacity);
+        }
+        let validated = profile.clone().with_codec_preferences(preferences)?;
+        let preferences = &validated.codec_preferences;
+        let mut kinds = BTreeSet::new();
+        for name in preferences {
+            match name.as_str() {
+                "pcmu" | "pcma" | "opus" => {
+                    kinds.insert(Medium::Audio);
+                }
+                "vp8" => {
+                    kinds.extend([Medium::Video, Medium::Screen]);
+                }
+                "reliable-ordered" => {
+                    kinds.insert(Medium::Data);
+                }
+                _ => return Err(NativeOfferError::Unsupported),
+            }
+        }
+        let mut effective = remote.clone();
+        let mut selected = Vec::with_capacity(bindings.len());
+        let mut retained = 0;
+        for binding in bindings {
+            let previous = &binding.negotiated;
+            let medium = previous.requested.medium;
+            if medium == Medium::Data || !kinds.contains(&medium) {
+                retain_binding(&mut effective, previous);
+                selected.push(previous.clone());
+                retained += 1;
+                continue;
+            }
+            let usable = |format: &MediaFormat| {
+                validate_selected_streams(
+                    &profile.local,
+                    remote,
+                    &[NegotiatedStream {
+                        requested: previous.requested.clone(),
+                        format: format.clone(),
+                    }],
+                )
+                .is_ok()
+            };
+            let formats = remote
+                .send
+                .iter()
+                .chain(&remote.receive)
+                .filter(|c| c.medium == medium)
+                .flat_map(|c| &c.formats)
+                .collect::<Vec<_>>();
+            let mut chosen = None;
+            for preference in preferences {
+                if format_name(&previous.format) == *preference && usable(&previous.format) {
+                    chosen = Some(previous.format.clone());
+                    break;
+                }
+                if let Some(format) = formats
+                    .iter()
+                    .find(|f| format_name(f) == *preference && usable(f))
+                {
+                    chosen = Some((*format).clone());
+                    break;
+                }
+            }
+            // A soft preference cannot authorize a withdrawn format. Preserve
+            // a still-compatible current format before choosing another fallback.
+            if chosen.is_none() && usable(&previous.format) {
+                chosen = Some(previous.format.clone());
+            }
+            if chosen.is_none() {
+                chosen = formats.iter().find(|f| usable(f)).map(|f| (*f).clone());
+            }
+            selected.push(NegotiatedStream {
+                requested: previous.requested.clone(),
+                format: chosen.ok_or(NativeOfferError::Unsupported)?,
+            });
+        }
+        effective.max_streams = effective.max_streams.max(retained);
+        validate_selected_streams(&profile.local, &effective, &selected)
+            .map_err(|_| NativeOfferError::Unsupported)?;
+        Ok(Self {
+            selected,
+            rejected: Vec::new(),
             remote: effective,
             declaration_generation: None,
         })
