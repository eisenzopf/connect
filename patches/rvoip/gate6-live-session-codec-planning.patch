+#[test]
+fn live_session_codec_plan_prefers_current_policy_without_changing_identity_or_direction() {
+    let initial = NativeOfferPlan::parse(&offer(), &profile(), &actor()).unwrap();
+    let bindings = codec_bindings(&initial);
+    let selected = NativeOfferPlan::session_codec_update(
+        &["g.711-a".into()],
+        &profile(),
+        initial.remote_capabilities(),
+        &bindings,
+    )
+    .unwrap();
+    for (before, after) in bindings.iter().zip(selected.selected()) {
+        assert_eq!(before.negotiated.requested, after.requested);
+        assert_eq!(after.format, audio("pcma"));
+    }
+    assert_eq!(bindings[1].negotiated.format, audio("pcmu"));
+}
