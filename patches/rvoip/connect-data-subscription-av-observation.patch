+#[tokio::test]
+async fn av_change_cancelled_commit_and_old_observer_cannot_issue_data_continuity() {
+    for medium in [Medium::Audio, Medium::Video, Medium::Screen] {
+        let f = fixture();
+        let work = AssertUnwindSafe(async {
+            let scene = scene(&f, true).await;
+            let expected = f.b.revision();
+            let observer = Arc::new(SubscriptionCommitObservation::new(&f.b, expected));
+            let change = if medium == Medium::Audio {
+                MediaSubscriptionChange {
+                    selection: None,
+                    audio: Some(AudioSubscriptionChange::Clear),
+                    direct: None,
+                }
+            } else {
+                MediaSubscriptionChange {
+                    selection: None,
+                    audio: None,
+                    direct: Some(DirectSubscriptionChange::Unsubscribe(vec![
+                        desired(medium).logical_id,
+                    ])),
+                }
+            };
+            let h = held(&f, &change, None, observer.clone()).await;
+            let revision = scene
+                .change_media_subscriptions(
+                    &f.b.connection,
+                    expected,
+                    change,
+                    deadline(),
+                    CancellationToken::new(),
+                    Some(&h),
+                )
+                .await
+                .unwrap();
+            drop(h);
+            assert!(observer.unchanged_av(expected, revision).is_none());
+            // The earlier successful AV-changing commit permanently closed this
+            // collector. A later harmless Data call cannot promote its history.
+            let change = data(&f);
+            let h = held(&f, &change, None, observer.clone()).await;
+            let next = scene
+                .change_media_subscriptions(
+                    &f.b.connection,
+                    revision,
+                    change,
+                    deadline(),
+                    CancellationToken::new(),
+                    Some(&h),
+                )
+                .await
+                .unwrap();
+            drop(h);
+            assert!(observer.unchanged_av(revision, next).is_none());
+            let cancelled = Arc::new(SubscriptionCommitObservation::new(&f.b, next));
+            let change = data(&f);
+            let h = held(&f, &change, None, cancelled.clone()).await;
+            let stop = CancellationToken::new();
+            stop.cancel();
+            assert!(scene
+                .change_media_subscriptions(
+                    &f.b.connection,
+                    next,
+                    change,
+                    deadline(),
+                    stop,
+                    Some(&h)
+                )
+                .await
+                .is_err());
+            drop(h);
+            assert!(cancelled.unchanged_av(next, next).is_none());
+            assert_eq!(f.b.revision(), next);
+        })
+        .catch_unwind()
+        .await;
+        finish(&f, work).await;
+    }
+}
