+#[test]
+fn selection_continuity_keeps_future_wildcards_membership_and_unknown_exclusions_exact() {
+    use crate::staged_streams::selection_intent::{
+        KnownSource, ParticipantSelection, SelectionProgram,
+    };
+    let member = owner("alice").member;
+    let participant = member.participant().clone();
+    let video = StreamId::from_string("future-video");
+    let data = StreamId::from_string("new-data");
+    let mut original = SelectionProgram::default();
+    original.participants.insert(
+        participant.clone(),
+        ParticipantSelection {
+            member: member.clone(),
+            media: [Medium::Video].into_iter().collect(),
+            wildcard: false,
+        },
+    );
+    original.known.insert(
+        video.clone(),
+        KnownSource {
+            participant: participant.clone(),
+            medium: Medium::Video,
+        },
+    );
+    original
+        .excluded
+        .insert((participant.clone(), video.clone()));
+    // Only a source already known as Data in BOTH snapshots may have its
+    // Data exclusion changed without changing AV continuity.
+    original.known.insert(
+        data.clone(),
+        KnownSource {
+            participant: participant.clone(),
+            medium: Medium::Data,
+        },
+    );
+    let mut next = original.clone();
+    next.excluded.insert((participant.clone(), data));
+    assert!(original.av_same(&next));
+    // Data may be ignored only while BOTH snapshots identify the source as
+    // Data. A changed exclusion on either unknown/missing side can affect a
+    // future AV source and must remain part of the continuity comparison.
+    let one_sided = StreamId::from_string("one-sided-data");
+    let mut known_data = original.clone();
+    known_data.known.insert(
+        one_sided.clone(),
+        KnownSource {
+            participant: participant.clone(),
+            medium: Medium::Data,
+        },
+    );
+    let mut missing_with_exclusion = original.clone();
+    missing_with_exclusion
+        .excluded
+        .insert((participant.clone(), one_sided));
+    assert!(!known_data.av_same(&missing_with_exclusion));
+    assert!(!missing_with_exclusion.av_same(&known_data));
+    for mode in [
+        "wildcard",
+        "membership",
+        "future-audio",
+        "video-exclusion",
+        "unknown-exclusion",
+        "known-medium",
+    ] {
+        let mut bad = next.clone();
+        match mode {
+            "wildcard" => bad.participants.get_mut(&participant).unwrap().wildcard = true,
+            "membership" => {
+                bad.participants.get_mut(&participant).unwrap().member = owner("bob").member
+            }
+            "future-audio" => {
+                bad.participants
+                    .get_mut(&participant)
+                    .unwrap()
+                    .media
+                    .insert(Medium::Audio);
+            }
+            "video-exclusion" => {
+                bad.excluded.remove(&(participant.clone(), video.clone()));
+            }
+            "unknown-exclusion" => {
+                bad.excluded
+                    .insert((participant.clone(), StreamId::from_string("unknown")));
+            }
+            "known-medium" => bad.known.get_mut(&video).unwrap().medium = Medium::Data,
+            _ => unreachable!(),
+        }
+        assert!(!original.av_same(&bad), "changed AV/future meaning: {mode}");
+    }
+}
