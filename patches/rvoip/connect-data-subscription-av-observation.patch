+}
+async fn deliver_av(packets: Vec<(Medium, QueuedMedia)>, sequence: u32) {
+    for (medium, packet) in packets {
+        if medium == Medium::Audio {
+            assert_audio(packet).await;
+        } else {
+            packet
+                .deliver(|f| async move {
+                    assert_eq!(f.timestamp_rtp, sequence);
+                    Ok(())
+                })
+                .await
+                .unwrap();
+        }
+    }
+}
+async fn finish(f: &Fixture, work: std::thread::Result<()>) {
+    // Both original controller shutdowns are polled and joined even if either
+    // panics. Report the original work failure before secondary cleanup failure.
+    let (b, a) = tokio::join!(
+        AssertUnwindSafe(f.b.shutdown(deadline())).catch_unwind(),
+        AssertUnwindSafe(f.a.shutdown(deadline())).catch_unwind(),
+    );
+    if let Err(panic) = work {
+        std::panic::resume_unwind(panic);
+    }
+    let b = b.unwrap_or_else(|p| std::panic::resume_unwind(p));
+    let a = a.unwrap_or_else(|p| std::panic::resume_unwind(p));
+    assert_eq!((b, a), (0, 0));
+    assert_eq!(f.ba.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 0);
+}
