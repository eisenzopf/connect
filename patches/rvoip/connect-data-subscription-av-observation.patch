+        let receipt = observer
+            .unchanged_av(expected, revision)
+            .expect("actual Data-only commit witness");
+        assert!(receipt.matches("conversation", "session", "bob", 1, expected, revision));
+        assert!(receipt.matches_owner(&f.b));
+        assert!(receipt.matches_data_sources(&["data".into()]));
+        for wrong in ["local-data", "video", "unknown"] {
+            assert!(!receipt.matches_data_sources(&[wrong.into()]));
+        }
+        assert!(receipt
+            .bindings()
+            .iter()
+            .any(|b| b.negotiated.requested.logical_id.as_str() == "local-data"));
+        assert!(!receipt
+            .bindings()
+            .iter()
+            .any(|b| b.negotiated.requested.logical_id.as_str() == "data"));
+
+        assert!(!receipt.matches_owner(&f.a));
+        assert!(observer.unchanged_av(expected + 1, revision).is_none());
+        assert!(observer.unchanged_av(expected, revision + 1).is_none());
+        assert!(!receipt.matches("conversation", "other", "bob", 1, expected, revision));
+        assert!(!receipt.matches("conversation", "session", "bob", 2, expected, revision));
+        deliver_av(old, 410).await;
+        deliver_av(queued_av(&f, &scene, &mut out, 411).await, 411).await;
+        // Same identifiers/generation with a DIFFERENT exact controller marker
+        // cannot manufacture a receipt for the real target's next commit.
+        let foreign = StreamController::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            ConnectionId::from_string("bob"),
+            principal("bob"),
+            f.a.policy.clone(),
+            Adapter::new(),
+            Arc::new(StreamHandleAllocator::default()),
+            16,
+        )
+        .unwrap();
+        let expected = f.b.revision();
+        let observer = Arc::new(SubscriptionCommitObservation::new(&foreign, expected));
+        let change = data(&f);
+        let h = held(&f, &change, None, observer.clone()).await;
+        let result = scene
+            .change_media_subscriptions(
+                &f.b.connection,
+                expected,
+                change,
+                deadline(),
+                CancellationToken::new(),
+                Some(&h),
+            )
+            .await;
+        drop(h);
+        assert_eq!(foreign.shutdown(deadline()).await, 0);
+        assert!(result.is_ok());
+        assert!(observer.unchanged_av(expected, result.unwrap()).is_none());
+    })
+    .catch_unwind()
+    .await;
+    finish(&f, work).await;
+}
