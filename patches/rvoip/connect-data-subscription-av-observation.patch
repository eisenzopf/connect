+//! Historical subscription commit observations. Neither collector nor receipt
+//! retains a media/control lease, a ticket, or permission to run another effect.
+use super::*;
+
+/// One original invocation's observer. There is deliberately no public writer.
+/// The first successful Core commit closes it even when that commit changed AV.
+pub struct SubscriptionCommitObservation {
+    owner: Weak<()>,
+    expected: u64,
+    result: std::sync::OnceLock<Observed>,
+}
+struct Observed {
+    revision: u64,
+    unchanged: Option<UnchangedAvSubscriptionCommit>,
+}
+#[derive(Clone)]
+pub struct UnchangedAvSubscriptionCommit {
+    owner: Weak<()>,
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    generation: u64,
+    expected: u64,
+    revision: u64,
+    bindings: Vec<ReadyMediaBinding>,
+    data_sources: Vec<StreamId>,
+}
+impl SubscriptionCommitObservation {
+    pub fn new(owner: &Arc<StreamController>, expected: u64) -> Self {
+        Self {
+            owner: Arc::downgrade(&owner.subscription_commit_identity),
+            expected,
+            result: std::sync::OnceLock::new(),
+        }
+    }
+    /// Historical result only, for this exact original expected/returned pair.
+    /// A failed call, foreign owner, AV-changing commit or later revision is None.
+    pub fn unchanged_av(
+        &self,
+        expected: u64,
+        revision: u64,
+    ) -> Option<UnchangedAvSubscriptionCommit> {
+        let observed = self.result.get()?;
+        if expected != self.expected || revision != observed.revision {
+            return None;
+        }
+        observed.unchanged.clone()
+    }
+    pub(super) fn publish(
+        &self,
+        owner: &Arc<StreamController>,
+        expected: u64,
+        revision: u64,
+        generation: u64,
+        unchanged: bool,
+        bindings: Vec<ReadyMediaBinding>,
+        data_sources: Vec<StreamId>,
+    ) {
+        let unchanged = (unchanged
+            && self.expected == expected
+            && Weak::ptr_eq(
+                &self.owner,
+                &Arc::downgrade(&owner.subscription_commit_identity),
+            )
+            && revision >= expected
+            && revision <= expected.saturating_add(1))
+        .then(|| UnchangedAvSubscriptionCommit {
+            owner: Arc::downgrade(&owner.subscription_commit_identity),
+            conversation: owner.conversation.clone(),
+            session: owner.session.clone(),
+            connection: owner.connection.clone(),
+            generation,
+            expected,
+            revision,
+            bindings,
+            data_sources,
+        });
+        // No overwrite or promotion after an earlier successful AV-changing call.
+        let _ = self.result.set(Observed {
+            revision,
+            unchanged,
+        });
+    }
+}
+impl UnchangedAvSubscriptionCommit {
+    pub fn matches(
+        &self,
+        conversation: &str,
+        session: &str,
+        connection: &str,
+        generation: u64,
+        expected: u64,
+        revision: u64,
+    ) -> bool {
+        self.conversation.as_str() == conversation
+            && self.session.as_str() == session
+            && self.connection.as_str() == connection
+            && self.generation == generation
+            && self.expected == expected
+            && self.revision == revision
+    }
+    pub fn matches_owner(&self, owner: &Arc<StreamController>) -> bool {
+        Weak::ptr_eq(
+            &self.owner,
+            &Arc::downgrade(&owner.subscription_commit_identity),
+        )
+    }
+    pub fn bindings(&self) -> &[ReadyMediaBinding] {
+        &self.bindings
+    }
+    /// Remote source IDs of actual validated Data routes, not local receiver IDs.
+    pub fn data_sources(&self) -> &[StreamId] {
+        &self.data_sources
+    }
+    pub fn matches_data_sources(&self, requested: &[String]) -> bool {
+        !requested.is_empty()
+            && requested
+                .iter()
+                .all(|id| self.data_sources.iter().any(|source| source.as_str() == id))
+    }
+}
+
+pub(super) fn av(medium: Medium) -> bool {
+    matches!(medium, Medium::Audio | Medium::Video | Medium::Screen)
+}
+/// A local comparison under the already-held controller state guard. These
+/// temporary Arc copies die before returning; none enters the historical receipt.
+pub(super) struct AvState {
+    model: BTreeMap<StreamId, LogicalStream>,
+    ports: BTreeMap<StreamId, Arc<Port>>,
+}
+impl AvState {
+    pub(super) fn capture(state: &State) -> Self {
+        Self {
+            model: state
+                .model
+                .streams()
+                .iter()
+                .filter(|(_, s)| av(s.negotiated.requested.medium))
+                .map(|(id, s)| (id.clone(), s.clone()))
+                .collect(),
+            ports: state
+                .active
+                .iter()
+                .filter(|(_, p)| av(p.binding.negotiated.requested.medium))
+                .map(|(id, p)| (id.clone(), p.clone()))
+                .collect(),
+        }
+    }
+    pub(super) fn unchanged(&self, state: &State) -> bool {
+        let now = Self::capture(state);
+        self.model == now.model
+            && self.ports.len() == now.ports.len()
+            && self
+                .ports
+                .iter()
+                .all(|(id, p)| now.ports.get(id).is_some_and(|n| Arc::ptr_eq(p, n)))
+    }
+}
