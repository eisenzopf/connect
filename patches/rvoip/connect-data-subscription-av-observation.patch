+}
+async fn queued_av(
+    f: &Fixture,
+    scene: &GuardedMediaScene,
+    out: &mut [(Medium, mpsc::Receiver<QueuedMedia>)],
+    sequence: u32,
+) -> Vec<(Medium, QueuedMedia)> {
+    for medium in [Medium::Audio, Medium::Video, Medium::Screen] {
+        let port = f.aa.port(medium);
+        port.try_publish(&frame(&port, sequence)).unwrap();
+    }
+    scene.tick();
+    let mut result = Vec::new();
+    for (medium, r) in out {
