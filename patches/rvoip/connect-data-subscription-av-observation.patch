+//! Actual Core routing/resource commits and independent AV IO. Relationship
+//! fixtures are synthetic; no signed transport/Store epoch/VP8 decode claim.
+use super::*;
+use crate::staged_streams::subscription_observation::SubscriptionCommitObservation;
+use futures_util::FutureExt;
+use std::panic::AssertUnwindSafe;
+
+struct ObservedHeld {
+    held: Arc<Held>,
+    observation: Arc<SubscriptionCommitObservation>,
+}
+struct ObservingPolicy(Arc<HeldPolicy>);
+impl MediaPolicy for ObservingPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.0.current(scope)
+    }
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.0.current_participant_receive(scope, source)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        if let Some(h) = held.downcast_ref::<ObservedHeld>() {
+            // The actual entrypoint uses component intents for pure Audio or
+            // Direct changes. Normalize only the EXACT original component to
+            // the parent's held full-intent validator; never infer permission.
+            let component = match intent {
+                MediaControlIntent::DirectSubscriptions { expected, change }
+                    if h.held.selected.is_none()
+                        && h.held.change.selection.is_none()
+                        && h.held.change.audio.is_none()
+                        && h.held.change.direct.as_ref() == Some(*change) =>
+                {
+                    Some(MediaControlIntent::Subscriptions {
+                        expected: *expected,
+                        change: &h.held.change,
+                    })
+                }
+                MediaControlIntent::AudioSubscriptions { expected, change }
+                    if h.held.selected.is_none()
+                        && h.held.change.selection.is_none()
+                        && h.held.change.direct.is_none()
+                        && h.held.change.audio.as_ref() == Some(*change) =>
+                {
+                    Some(MediaControlIntent::Subscriptions {
+                        expected: *expected,
+                        change: &h.held.change,
+                    })
+                }
+                _ => None,
+            };
+            self.0
+                .current_control(scope, component.as_ref().unwrap_or(intent), &h.held)
+                .map(|c| c.with_subscription_observation(h.observation.clone()))
+        } else {
+            self.0.current_control(scope, intent, held)
+        }
+    }
+}
