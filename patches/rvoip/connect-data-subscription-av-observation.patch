+#[tokio::test]
+async fn prepared_data_resource_commit_observes_same_original_av_ports_and_no_adapter_replay() {
+    let f = fixture();
+    let work = AssertUnwindSafe(async {
+        let scene = scene(&f, false).await;
+        let mut out = [Medium::Audio, Medium::Video, Medium::Screen]
+            .into_iter()
+            .map(|m| (m, f.ba.port(m).take_egress().unwrap()))
+            .collect::<Vec<_>>();
+        let old = queued_av(&f, &scene, &mut out, 510).await;
+        let expected = f.b.revision();
+        let observer = Arc::new(SubscriptionCommitObservation::new(&f.b, expected));
+        let mut selected =
+            f.b.active_bindings()
+                .into_iter()
+                .map(|b| b.negotiated)
+                .collect::<Vec<_>>();
+        let mut binding = f.aa.port(Medium::Data).binding().negotiated.clone();
+        binding.requested.direction = StreamDirection::Send;
+        binding.requested.logical_id = StreamId::from_string("local-data");
+        selected.push(binding);
+        let change = data(&f);
+        let h = held(&f, &change, Some(selected.clone()), observer.clone()).await;
+        let original = f.b.active_bindings();
+        let calls = f.ba.prepare_calls.load(Ordering::Acquire);
+        let staged =
+            f.b.stage_selected_subscriptions_with_held(
+                expected,
+                &selected,
+                &BTreeSet::new(),
+                scene.clone(),
+                &change,
+                deadline(),
+                CancellationToken::new(),
+                Arc::new(h),
+            )
+            .await
+            .unwrap();
+        let prepared = staged.prepare().await.unwrap();
+        assert!(observer.unchanged_av(expected, expected + 1).is_none());
+        let h = held(&f, &change, Some(selected), observer.clone()).await;
+        prepared.activate_with_held(Arc::new(h)).await.unwrap();
+        let revision = f.b.revision();
+        let receipt = observer.unchanged_av(expected, revision).unwrap();
+        assert_eq!(f.ba.prepare_calls.load(Ordering::Acquire), calls + 1);
+        assert!(receipt.matches_data_sources(&["data".into()]));
+        assert!(!receipt.matches_data_sources(&["local-data".into()]));
+        assert!(receipt
+            .bindings()
+            .iter()
+            .any(|b| b.negotiated.requested.logical_id.as_str() == "local-data"));
+
+        assert!(original
+            .iter()
+            .all(|b| receipt
+                .bindings()
+                .iter()
+                .any(|n| n.transport_id == b.transport_id
+                    && n.stream_local_id == b.stream_local_id
+                    && n.generation == b.generation
+                    && n.negotiated == b.negotiated)));
+        deliver_av(old, 510).await;
+        deliver_av(queued_av(&f, &scene, &mut out, 511).await, 511).await;
+    })
+    .catch_unwind()
+    .await;
+    finish(&f, work).await;
+}
