+#[test]
+fn each_logical_stream_honors_peer_order_and_inverts_its_endpoint_direction() {
+    let plan = NativeOfferPlan::parse(&offer(), &profile(), &actor()).unwrap();
+    assert_eq!(plan.selected[0].format, audio("pcma"));
+    assert_eq!(plan.selected[1].format, audio("pcmu"));
+    assert_eq!(
+        plan.selected[1].requested.direction,
+        StreamDirection::Receive
+    );
+    assert_eq!(plan.remote.max_streams, 32);
+}
+#[test]
+fn unsupported_new_stream_is_rejected_but_zero_usable_streams_refuse() {
+    let mut o = offer();
+    o.streams_offered[1] = serde_json::from_value(
+        json!({"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp9"]}),
+    )
+    .unwrap();
+    let p = NativeOfferPlan::parse(&o, &profile(), &actor()).unwrap();
+    assert_eq!(p.selected.len(), 1);
+    assert_eq!(p.rejected[0].as_str(), "camera");
+    o.streams_offered.remove(0);
+    assert!(matches!(
+        NativeOfferPlan::parse(&o, &profile(), &actor()),
+        Err(NativeOfferError::Unsupported)
+    ));
+}
+#[test]
+fn malformed_codec_numbers_duplicate_ids_and_flat_legacy_catalogs_fail_before_preparation() {
+    for which in 0..4 {
+        let mut o = offer();
+        match which {
+            0 => o.capabilities["audio_codecs"][0]["params"]["sample_rate"] = json!(u64::MAX),
+            1 => o.capabilities["audio_codecs"][0]["params"]["channels"] = json!(256),
+            2 => o.streams_offered[1].id = o.streams_offered[0].id.clone(),
+            _ => {
+                o.capabilities["audio_codecs"][0]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("params");
+            }
+        }
