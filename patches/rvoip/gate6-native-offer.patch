+#[tokio::test]
+async fn wrong_scope_or_signature_does_not_consume_pending_native_confirmation() {
+    let mut s = Scene::new("quic", false).await;
+    let (_, callback) = s.prepared(s.offer(0, false)).await;
+    let mut wrong = s.confirmation(&callback);
+    wrong["connid"] = json!("foreign");
+    s.wire.send(s.f.sign(wrong)).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    let mut wrong: Value = serde_json::from_slice(&s.f.sign(s.confirmation(&callback))).unwrap();
+    wrong["signature"]["sig"] = json!("invalid");
+    s.wire.send(serde_json::to_vec(&wrong).unwrap()).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    assert_eq!(s.controller().revision(), 0);
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    assert!(s.record.results.lock().unwrap()[0].is_ok());
+    s.wire.server.shutdown().await.unwrap();
+}
