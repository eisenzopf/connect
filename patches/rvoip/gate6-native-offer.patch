+    }
+}
+#[test]
+fn screen_support_and_directional_catalogs_are_not_inferred_from_generic_video() {
+    let mut o = offer();
+    o.streams_offered = vec![serde_json::from_value(
+        json!({"id":"screen","kind":"screen","direction":"sendrecv","codec_preferences":["vp8"]}),
+    )
+    .unwrap()];
+    assert!(matches!(
+        NativeOfferPlan::parse(&o, &profile(), &actor()),
+        Err(NativeOfferError::Unsupported)
+    ));
+    let mut o = offer();
+    o.capabilities["native_media"] = json!({"version":1,"send":[{"kind":"audio","formats":[{"name":"pcmu","params":{"sample_rate":8000,"channels":1}}]}],"receive":[]});
+    o.streams_offered.truncate(1);
+    assert!(matches!(
+        NativeOfferPlan::parse(&o, &profile(), &actor()),
+        Err(NativeOfferError::Unsupported)
+    ));
+    o.streams_offered[0].direction = StreamOfferDirection::Sendonly;
+    let p = NativeOfferPlan::parse(&o, &profile(), &actor()).unwrap();
+    assert_eq!(p.selected[0].requested.direction, StreamDirection::Receive);
+}
+#[test]
+fn claimed_assurance_does_not_replace_current_authentication_and_peer_floor_is_enforced() {
+    let mut o = offer();
+    o.capabilities["identity_assurance_offered"] = json!("user-authorized");
+    assert!(matches!(
+        NativeOfferPlan::parse(&o, &profile(), &actor()),
+        Err(NativeOfferError::Authority)
+    ));
+    let mut o = offer();
+    o.capabilities["identity_assurance_required"] = json!("user-authorized");
+    assert!(matches!(
+        NativeOfferPlan::parse(&o, &profile(), &actor()),
+        Err(NativeOfferError::Authority)
+    ));
+}
+#[test]
+fn data_requires_explicit_reliable_protocol_and_local_capacity_is_preserved() {
+    let mut o = offer();
+    o.streams_offered = vec![serde_json::from_value(
+        json!({"id":"data","kind":"data","direction":"sendrecv","codec_preferences":["binary"]}),
+    )
+    .unwrap()];
+    let p = NativeOfferPlan::parse(&o, &profile(), &actor()).unwrap();
+    assert!(matches!(
+        p.selected[0].format,
+        MediaFormat::ReliableOrdered(_)
+    ));
+    o.streams_offered[0].codec_preferences = vec!["unordered".into()];
+    assert!(matches!(
+        NativeOfferPlan::parse(&o, &profile(), &actor()),
+        Err(NativeOfferError::Unsupported)
