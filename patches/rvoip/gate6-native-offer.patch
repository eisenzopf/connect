+/// Validate an offerer's per-logical-stream selection against every current
+/// directional capability set. Selection never creates a capability or grant.
+pub fn validate_selected_streams(
+    local: &EndpointMediaCapabilities,
+    remote: &EndpointMediaCapabilities,
+    selected: &[NegotiatedStream],
+) -> Result<Vec<NegotiatedStream>> {
+    let desired = selected
+        .iter()
+        .map(|s| s.requested.clone())
+        .collect::<Vec<_>>();
+    let mut result = negotiate_streams(local, remote, &desired)?;
+    for (chosen, validated) in selected.iter().zip(result.iter_mut()) {
+        chosen.format.validate(chosen.requested.medium)?;
+        let mut sets = Vec::new();
+        if chosen.requested.direction.sends() {
+            sets.push(&local.send);
+            sets.push(&remote.receive);
+        }
+        if chosen.requested.direction.receives() {
+            sets.push(&local.receive);
+            sets.push(&remote.send);
+        }
+        if !sets.iter().all(|set| {
+            set.iter()
+                .find(|cap| cap.medium == chosen.requested.medium)
+                .is_some_and(|cap| {
+                    cap.formats
+                        .iter()
+                        .any(|format| format.matches(&chosen.format))
+                })
+        }) {
+            return Err(MediaTransitionError::Unsupported);
+        }
+        validated.format = chosen.format.clone();
+    }
+    Ok(result)
+}
