+fn credential_owner(
+    mut owner: MediaOwner,
+    principal: &AuthenticatedPrincipal,
+) -> ControlResult<MediaOwner> {
+    let binding =
+        IdentityBinding::from_authenticated(principal, owner.actor.identity().clone(), Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+    owner.actor = owner
+        .actor
+        .with_authenticated_identity(&binding)
+        .map_err(|_| StreamControlError::Authority)?;
+    if owner.member.identity() == owner.actor.identity() {
+        owner.member = owner
+            .member
+            .with_authenticated_identity(&binding)
+            .map_err(|_| StreamControlError::Authority)?;
+    }
+    Ok(owner)
+}
