+#[test]
+fn selected_formats_preserve_each_stream_choice_without_weakening_directional_intersection() {
+    let local = profile();
+    let mut remote = profile();
+    let selected = vec![
+        NegotiatedStream {
+            requested: desired("first", Medium::Audio),
+            format: audio(),
+        },
+        NegotiatedStream {
+            requested: desired("second", Medium::Audio),
+            format: opus(),
+        },
+    ];
+    assert_eq!(
+        validate_selected_streams(&local, &remote, &selected).unwrap(),
+        selected
+    );
+    remote.receive = vec![capability(Medium::Audio, vec![audio()])];
+    assert_eq!(
+        validate_selected_streams(&local, &remote, &selected),
+        Err(MediaTransitionError::Unsupported)
+    );
+    let mut receive_only = selected[1].clone();
+    receive_only.requested.direction = StreamDirection::Receive;
+    assert!(validate_selected_streams(&local, &remote, &[receive_only]).is_ok());
+}
+#[test]
+fn selected_transaction_rejects_stale_revision_and_revoked_grants_before_mutation() {
+    let f = Fixture::new();
+    let mut state = initial(&f);
+    let p = profile();
+    let now = Instant::now();
+    let selected = [NegotiatedStream {
+        requested: desired("audio", Medium::Audio),
+        format: opus(),
+    }];
+    let revision = state.revision();
+    assert!(matches!(
+        state.prepare_selected(
+            &f.authority(),
+            revision + 1,
+            &p,
+            &p,
+            &selected,
+            now,
+            now + Duration::from_secs(1)
+        ),
+        Err(MediaTransitionError::Conflict)
+    ));
+    let mut denied = f.authority();
+    denied.send_media.clear();
+    assert!(matches!(
+        state.prepare_selected(
+            &denied,
+            revision,
+            &p,
+            &p,
+            &selected,
+            now,
+            now + Duration::from_secs(1)
+        ),
+        Err(MediaTransitionError::Authority)
+    ));
+    assert_eq!(state.revision(), revision);
+    let prepared = state
+        .prepare_selected(
+            &f.authority(),
+            revision,
+            &p,
+            &p,
+            &selected,
+            now,
+            now + Duration::from_secs(1),
+        )
+        .unwrap();
+    assert_eq!(prepared.streams(), &selected);
+}
