+//! Public native offer selection and one owned, atomic RTP/data negotiation.
+//! Prepared endpoint confirmation is not a media-flow or presence observation.
+use super::{auth_dispatch::*, payloads::*, Envelope, Identifier, Scope};
+use crate::{
+    staged_data::{NativeDataOutcome, StagedDataNegotiator},
+    staged_media::*,
+};
+use async_trait::async_trait;
+use rvoip_core::{ids::*, staged_streams::*, stream_lifecycle::*};
+use serde_json::{json, Value};
+use std::{
+    collections::BTreeSet,
+    sync::{Arc, Mutex, Weak},
+};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+mod catalog;
+use catalog::{codec_wire, direction, format_name, kind, payload_type, peer_direction};
+pub use catalog::{NativeMediaProfile, NativeOfferPlan};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum NativeOfferError {
+    #[error("invalid native media offer")]
+    Invalid,
+    #[error("native media offer has no supported profile")]
+    Unsupported,
+    #[error("native media scope denied")]
+    Scope,
+    #[error("native media authority denied")]
+    Authority,
+    #[error("native media capacity exhausted")]
+    Capacity,
+    #[error("native media revision conflicts")]
+    Conflict,
+    #[error("native media operation cancelled")]
+    Cancelled,
+    #[error("native media operation expired")]
+    Deadline,
+    #[error("native media resource is not ready")]
+    NotReady,
+    #[error("native endpoint confirmation does not match preparation")]
+    Confirmation,
+    #[error("native cleanup remains unconfirmed")]
+    CleanupUnconfirmed,
+    #[error(transparent)]
+    Dispatch(#[from] DispatchError),
+}
+impl From<StreamControlError> for NativeOfferError {
+    fn from(e: StreamControlError) -> Self {
+        match e {
+            StreamControlError::Model(MediaTransitionError::Conflict) => Self::Conflict,
+            StreamControlError::Model(MediaTransitionError::Capacity)
+            | StreamControlError::Backpressure => Self::Capacity,
+            StreamControlError::Model(MediaTransitionError::Unsupported)
+            | StreamControlError::Unsupported => Self::Unsupported,
+            StreamControlError::Authority
+            | StreamControlError::NotRecipient
+            | StreamControlError::Model(MediaTransitionError::Authority) => Self::Authority,
+            StreamControlError::Cancelled => Self::Cancelled,
+            StreamControlError::Deadline
+            | StreamControlError::Model(MediaTransitionError::Expired) => Self::Deadline,
+            StreamControlError::NotReady
+            | StreamControlError::Model(MediaTransitionError::NotReady) => Self::NotReady,
+            StreamControlError::CleanupUnconfirmed => Self::CleanupUnconfirmed,
+            StreamControlError::Model(MediaTransitionError::Invalid) => Self::Invalid,
+        }
+    }
+}
+/// Record local data outcomes in the host's existing journal/outbox. This is
+/// deliberately required when a data profile is installed; it is not an ACK.
+pub trait NativeDataObserver: Send + Sync {
+    fn observe(&self, scope: &StagedRtpScope, outcome: &NativeDataOutcome) -> ControlResult<()>;
+}
+/// Observed local graph commit only. These bindings and revision are metadata,
+/// not a fresh grant, current ready event, media-flow or durable receipt.
+pub struct NativeOfferOutcome {
+    pub revision: u64,
+    pub accepted: Vec<StreamId>,
+    pub rejected: Vec<Identifier>,
+    pub bindings: Vec<ReadyMediaBinding>,
+}
+impl std::fmt::Debug for NativeOfferOutcome {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeOfferOutcome")
+            .field("revision", &self.revision)
+            .field("accepted_count", &self.accepted.len())
+            .field("rejected_count", &self.rejected.len())
+            .finish()
+    }
+}
+struct Progress {
+    bindings: Vec<ReadyMediaBinding>,
+    setup: Option<Value>,
+    confirmed: bool,
+    error: Option<NativeOfferError>,
+}
+struct Operation {
+    invocation: Arc<AuthorizedEnvelope>,
+    plan: NativeOfferPlan,
+    expected: u64,
+    cancel: CancellationToken,
+    progress: Mutex<Progress>,
+}
+pub(crate) struct NativeNegotiation {
+    pub(crate) scope: StagedRtpScope,
+    pub(crate) profile: Arc<NativeMediaProfile>,
+    participant: ParticipantId,
+    observer: Option<Arc<dyn NativeDataObserver>>,
+    lifetime: CancellationToken,
+    current: Mutex<Option<Weak<Operation>>>,
+}
+pub(crate) struct NegotiationGuard {
+    broker: Arc<NativeNegotiation>,
+    operation: Arc<Operation>,
+}
+impl Drop for NegotiationGuard {
+    fn drop(&mut self) {
+        self.operation.cancel.cancel();
+        let mut current = self
+            .broker
+            .current
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        if current
+            .as_ref()
+            .is_some_and(|p| Weak::ptr_eq(p, &Arc::downgrade(&self.operation)))
+        {
+            current.take();
+        }
+    }
+}
+impl NegotiationGuard {
+    pub(crate) fn plan(&self) -> &NativeOfferPlan {
+        &self.operation.plan
+    }
+    pub(crate) fn result(
+        &self,
+        controller: &StreamController,
+    ) -> Result<NativeOfferOutcome, NativeOfferError> {
+        self.broker.active()?;
+        let state = self
+            .operation
+            .progress
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        if !state.confirmed {
+            return Err(NativeOfferError::Conflict);
+        }
+        // change_selected returned success for this exact expected revision. This is
+        // historical commit metadata even if a later authorized change has begun.
+        let _ = controller;
+        Ok(NativeOfferOutcome {
+            revision: self.operation.expected + 1,
+            accepted: self
+                .operation
+                .plan
+                .selected
+                .iter()
+                .map(|s| s.requested.logical_id.clone())
+                .collect(),
+            rejected: self.operation.plan.rejected.clone(),
+            bindings: state.bindings.clone(),
+        })
+    }
+    pub(crate) fn error(&self, error: StreamControlError) -> NativeOfferError {
+        self.operation
+            .progress
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .error
+            .take()
+            .unwrap_or_else(|| error.into())
+    }
+}
+impl NativeNegotiation {
+    pub(crate) fn new(
+        scope: StagedRtpScope,
+        profile: Arc<NativeMediaProfile>,
+        participant: ParticipantId,
+        observer: Option<Arc<dyn NativeDataObserver>>,
+        lifetime: CancellationToken,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            scope,
+            profile,
+            participant,
+            observer,
+            lifetime,
+            current: Mutex::new(None),
+        })
+    }
+    pub(crate) fn plan(&self, a: &AuthorizedEnvelope) -> Result<NativeOfferPlan, NativeOfferError> {
+        if !a.supports_native_negotiation() || !scope_matches(a.envelope(), &self.scope) {
+            return Err(NativeOfferError::Scope);
+        }
+        let Payload::ConnectionOffer(offer) = a.envelope().payload() else {
+            return Err(NativeOfferError::Unsupported);
+        };
+        if offer
+            .by_participant
+            .as_ref()
+            .is_some_and(|p| p.as_str() != self.participant.as_str())
+        {
+            return Err(NativeOfferError::Authority);
+        }
+        NativeOfferPlan::parse(offer, &self.profile, a.principal())
+    }
+    pub(crate) fn begin(
+        self: &Arc<Self>,
+        invocation: Arc<AuthorizedEnvelope>,
+        expected: u64,
+    ) -> Result<NegotiationGuard, NativeOfferError> {
+        let plan = self.plan(&invocation)?;
+        let mut current = self.current.lock().unwrap_or_else(|p| p.into_inner());
+        if self.lifetime.is_cancelled() {
+            return Err(NativeOfferError::Cancelled);
+        }
+        // Cancellation does not release the operation slot. Its owner may
+        // still be unwinding a native batch; only the RAII guard's drop can
+        // make the broker available to a later invocation.
+        if current.as_ref().and_then(Weak::upgrade).is_some() {
+            return Err(NativeOfferError::Conflict);
+        }
+        let operation = Arc::new(Operation {
+            cancel: invocation.invocation_cancellation(),
+            invocation,
+            plan,
+            expected,
+            progress: Mutex::new(Progress {
+                bindings: vec![],
+                setup: None,
+                confirmed: false,
+                error: None,
+            }),
+        });
+        *current = Some(Arc::downgrade(&operation));
+        Ok(NegotiationGuard {
+            broker: self.clone(),
+            operation,
+        })
+    }
+    fn active(&self) -> Result<Arc<Operation>, NativeOfferError> {
+        let op = self
+            .current
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .ok_or(NativeOfferError::NotReady)?;
+        if self.lifetime.is_cancelled()
+            || op.cancel.is_cancelled()
+            || !op.invocation.supports_native_negotiation()
+        {
+            return Err(NativeOfferError::Cancelled);
+        }
+        Ok(op)
+    }
+    pub(crate) fn batch_started(&self, ports: &[PortPreparation]) -> ControlResult<()> {
+        let op = self.active().map_err(|_| StreamControlError::NotReady)?;
+        let bindings = ports
+            .iter()
+            .map(|p| p.port.binding().clone())
+            .collect::<Vec<_>>();
+        let mut seen = BTreeSet::new();
+        if bindings.len() != op.plan.selected.len()
+            || bindings.iter().any(|b| {
+                !seen.insert(b.negotiated.requested.logical_id.clone())
+                    || b.stream_local_id == 0
+                    || b.generation == 0
+                    || b.connection_generation == 0
+                    || !op.plan.selected.contains(&b.negotiated)
+                    || b.source_ready != (b.negotiated.requested.direction != StreamDirection::Send)
+                    || b.sink_ready
+                        != (b.negotiated.requested.direction != StreamDirection::Receive)
+            })
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut state = op.progress.lock().unwrap_or_else(|p| p.into_inner());
+        if !state.bindings.is_empty() {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        state.bindings = bindings;
+        Ok(())
+    }
+    pub(crate) async fn batch_finished(
+        &self,
+        ports: &[PortPreparation],
+        deadline: Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        let result = self.finish(ports, deadline, cancel).await;
+        if let Err(e) = result {
+            if let Ok(op) = self.active() {
+                op.progress.lock().unwrap_or_else(|p| p.into_inner()).error = Some(e);
+            }
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(())
+    }
+    async fn finish(
+        &self,
+        ports: &[PortPreparation],
+        deadline: Instant,
+        cancel: CancellationToken,
+    ) -> Result<(), NativeOfferError> {
+        let op = self.active()?;
+        if cancel.is_cancelled() {
+            return Err(NativeOfferError::Cancelled);
+        }
+        if ports.iter().any(|p| {
+            !matches!(
+                p.port.status(),
+                PortStatus::Prepared | PortStatus::Active | PortStatus::Paused
+            )
+        }) {
+            return Err(NativeOfferError::NotReady);
+        }
+        let bindings = op
+            .progress
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .bindings
+            .clone();
+        let wire = bindings.iter().map(binding_wire).collect::<Vec<_>>();
+        let setup = json!({"kind":"native-prepared/1","revision":op.expected+1,"offer_id":op.invocation.envelope().id(),"streams":wire});
+        let answered=bindings.iter().map(|b|json!({"id":b.negotiated.requested.logical_id.as_str(),"kind":kind(b.negotiated.requested.medium),"direction":direction(b.negotiated.requested.direction),"codec":codec_wire(&b.negotiated.format,payload_type(&b.negotiated.format))})).collect::<Vec<_>>();
+        let substrate = op.invocation.envelope().original()["payload"]["substrate"].clone();
+        let answer = message(
+            &op.invocation,
+            "connection.answer",
+            json!({"by_participant":self.participant.as_str(),"substrate":substrate,"capabilities":self.profile.wire,"streams_answered":answered,"substrate_setup":setup}),
+            true,
+        )?;
+        tokio::select! {biased;_=cancel.cancelled()=>return Err(NativeOfferError::Cancelled),_=self.lifetime.cancelled()=>return Err(NativeOfferError::Cancelled),r=op.invocation.answer_offer(answer,deadline)=>{r?;}}
+        // One server offer after both families have actually installed their local
+        // provisional resources. The peer confirms these exact parameters through
+        // the actor's current signed reply lane; no client-ready boolean is accepted.
+        let offered=bindings.iter().map(|b|json!({"id":b.negotiated.requested.logical_id.as_str(),"kind":kind(b.negotiated.requested.medium),"direction":direction(b.negotiated.requested.direction),"codec_preferences":[format_name(&b.negotiated.format)]})).collect::<Vec<_>>();
+        let request = message(
+            &op.invocation,
+            "connection.offer",
+            json!({"by_participant":self.participant.as_str(),"substrate":substrate,"capabilities":self.profile.wire,"streams_offered":offered,"substrate_setup":setup}),
+            false,
+        )?;
+        let reply = tokio::select! {biased;_=cancel.cancelled()=>return Err(NativeOfferError::Cancelled),_=self.lifetime.cancelled()=>return Err(NativeOfferError::Cancelled),r=op.invocation.exchange(request,deadline)=>r?};
+        self.active()?;
+        let Payload::ConnectionAnswer(answer) = reply.payload() else {
+            return Err(NativeOfferError::Confirmation);
+        };
+        let expected=bindings.iter().map(|b|json!({"id":b.negotiated.requested.logical_id.as_str(),"kind":kind(b.negotiated.requested.medium),"direction":peer_direction(b.negotiated.requested.direction),"codec":codec_wire(&b.negotiated.format,payload_type(&b.negotiated.format))})).collect::<Vec<_>>();
+        if answer.by_participant.as_ref().map(Identifier::as_str) != Some(self.participant.as_str())
+            || answer.substrate != substrate.as_str().ok_or(NativeOfferError::Invalid)?
+            || answer.substrate_setup.as_ref() != Some(&setup)
+            || serde_json::to_value(&answer.streams_answered)
+                .map_err(|_| NativeOfferError::Invalid)?
+                != json!(expected)
+        {
+            return Err(NativeOfferError::Confirmation);
+        }
+        let mut state = op.progress.lock().unwrap_or_else(|p| p.into_inner());
+        state.setup = Some(setup);
+        state.confirmed = true;
+        Ok(())
+    }
+    fn subset(
+        &self,
+        scope: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+    ) -> ControlResult<Vec<ReadyMediaBinding>> {
+        let op = self.active().map_err(|_| StreamControlError::NotReady)?;
+        if !same_scope(scope, &self.scope) {
+            return Err(StreamControlError::Authority);
+        }
+        let state = op.progress.lock().unwrap_or_else(|p| p.into_inner());
+        if offers.iter().any(|p| {
+            !state
+                .bindings
+                .iter()
+                .any(|b| crate::staged_media::same_binding(b, p))
+        }) {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(offers.to_vec())
+    }
+}
+#[async_trait]
+impl StagedRtpNegotiator for NativeNegotiation {
+    async fn prepare(
+        &self,
+        s: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        _: Instant,
+        c: CancellationToken,
+    ) -> ControlResult<Vec<PreparedRtpAnswer>> {
+        if c.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        self.subset(s, offers)?
+            .into_iter()
+            .map(|binding| {
+                let pt = payload_type(&binding.negotiated.format)
+                    .ok_or(StreamControlError::Unsupported)?;
+                Ok(PreparedRtpAnswer {
+                    binding,
+                    payload_type: pt,
+                })
+            })
+            .collect()
+    }
+    async fn confirm(
+        &self,
+        s: &StagedRtpScope,
+        answers: &[PreparedRtpAnswer],
+        _: Instant,
+        c: CancellationToken,
+    ) -> ControlResult<()> {
+        if c.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        self.subset(
+            s,
+            &answers
+                .iter()
+                .map(|a| a.binding.clone())
+                .collect::<Vec<_>>(),
+        )
+        .map(|_| ())
+    }
+}
+#[async_trait]
+impl StagedDataNegotiator for NativeNegotiation {
+    fn observe(&self, s: &StagedRtpScope, o: &NativeDataOutcome) -> ControlResult<()> {
+        self.observer
+            .as_ref()
+            .ok_or(StreamControlError::Unsupported)?
+            .observe(s, o)
+    }
+    async fn prepare(
+        &self,
+        s: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        _: Instant,
+        c: CancellationToken,
+    ) -> ControlResult<Vec<ReadyMediaBinding>> {
+        if c.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        self.subset(s, offers)
+    }
+    async fn confirm(
+        &self,
+        s: &StagedRtpScope,
+        answers: &[ReadyMediaBinding],
+        _: Instant,
+        c: CancellationToken,
+    ) -> ControlResult<()> {
+        if c.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        self.subset(s, answers).map(|_| ())
+    }
+}
+pub(crate) fn scope_matches(e: &Envelope, s: &StagedRtpScope) -> bool {
+    s.wire_conversation.is_some()
+        && e.kind() == "connection.offer"
+        && e.scope(Scope::Reply).is_none()
+        && e.scope(Scope::Operation).is_some()
+        && e.scope(Scope::Conversation) == s.wire_conversation.as_deref()
+        && e.scope(Scope::Session) == Some(s.wire_session.as_str())
+        && e.scope(Scope::Connection) == Some(s.wire_connection.as_str())
+}
+fn same_scope(a: &StagedRtpScope, b: &StagedRtpScope) -> bool {
+    a.connection == b.connection
+        && a.session == b.session
+        && a.owner == b.owner
+        && a.wire_conversation == b.wire_conversation
+        && a.wire_session == b.wire_session
+        && a.wire_connection == b.wire_connection
+}
+fn binding_wire(b: &ReadyMediaBinding) -> Value {
+    json!({"strm_id":b.negotiated.requested.logical_id.as_str(),"kind":kind(b.negotiated.requested.medium),"direction":direction(b.negotiated.requested.direction),"stream_local_id":b.stream_local_id,"codec":codec_wire(&b.negotiated.format,payload_type(&b.negotiated.format))})
+}
+fn message(
+    a: &AuthorizedEnvelope,
+    kind: &str,
+    payload: Value,
+    reply: bool,
+) -> Result<Envelope, NativeOfferError> {
+    let mut v = json!({"v":2,"type":kind,"id":format!("negotiation_{}",uuid::Uuid::new_v4().simple()),"ts":chrono::Utc::now(),"payload":payload});
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        v[field] = a.envelope().original()[field].clone();
+    }
+    if reply {
+        v["in_reply_to"] = json!(a.envelope().id());
+    }
+    Envelope::from_value(v).map_err(|_| NativeOfferError::Invalid)
+}
+
+#[cfg(test)]
+mod tests;
