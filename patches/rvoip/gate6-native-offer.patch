+    NativeMediaProfile::new(
+        EndpointMediaCapabilities {
+            send: caps.clone(),
+            receive: caps,
+            max_streams: 8,
+            renegotiation: true,
+        },
+        AssuranceLevel::Identified,
+        AssuranceLevel::Identified,
+    )
+    .unwrap()
+}
+fn offer() -> ConnectionOffer {
