+use super::*;
+use rvoip_core::capability::{AssuranceLevel, DataProtocol};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+
+/// Trusted server capability configuration. It grants no media permission.
+#[derive(Clone)]
+pub struct NativeMediaProfile {
+    pub(crate) local: EndpointMediaCapabilities,
+    pub(crate) wire: Value,
+    pub(crate) server_assurance: AssuranceLevel,
+    pub(crate) required_peer: AssuranceLevel,
+}
+impl NativeMediaProfile {
+    pub fn new(
+        local: EndpointMediaCapabilities,
+        server_assurance: AssuranceLevel,
+        required_peer: AssuranceLevel,
+    ) -> Result<Self, NativeOfferError> {
+        if local.max_streams == 0 || local.max_streams > 32 {
+            return Err(NativeOfferError::Capacity);
+        }
+        let mut catalogs: BTreeMap<Medium, Vec<MediaFormat>> = BTreeMap::new();
+        for set in [&local.send, &local.receive] {
+            let mut kinds = BTreeSet::new();
+            for cap in set {
+                if !kinds.insert(cap.medium) || cap.formats.is_empty() || cap.formats.len() > 32 {
+                    return Err(NativeOfferError::Invalid);
+                }
+                for (index, f) in cap.formats.iter().enumerate() {
+                    if cap.formats[..index].contains(f) {
+                        return Err(NativeOfferError::Invalid);
+                    }
+                    if let MediaFormat::Encoded { fmtp, .. } = f {
+                        if fmtp.is_some() {
+                            return Err(NativeOfferError::Unsupported);
+                        }
+                    }
+                    check_native(f, cap.medium)?;
+                    let values = catalogs.entry(cap.medium).or_default();
+                    if !values.contains(f) {
+                        values.push(f.clone());
+                    }
+                }
+            }
+        }
+        if catalogs.is_empty() {
+            return Err(NativeOfferError::Unsupported);
+        }
+        let encoded = |m| {
+            catalogs
+                .get(&m)
+                .into_iter()
+                .flatten()
+                .map(|f| codec_wire(f, None))
+                .collect::<Vec<_>>()
+        };
+        let mut video = encoded(Medium::Video);
+        for codec in encoded(Medium::Screen) {
+            if !video.contains(&codec) {
+                video.push(codec);
+            }
+        }
+        let data = catalogs
+            .get(&Medium::Data)
+            .into_iter()
+            .flatten()
+            .map(|f| format_name(f))
+            .collect::<Vec<_>>();
+        let direction = |set: &Vec<MediaCapability>| {
+            set.iter().map(|cap|json!({"kind":kind(cap.medium),"formats":cap.formats.iter().map(|f|codec_wire(f,None)).collect::<Vec<_>>()})).collect::<Vec<_>>()
+        };
+        let mut wire = json!({"audio_codecs":encoded(Medium::Audio),"video_codecs":video,"data_protocols":data,"max_streams_per_connection":local.max_streams,
+            "identity_assurance_offered":server_assurance,"identity_assurance_required":required_peer,
+            "native_media":{"version":1,"send":direction(&local.send),"receive":direction(&local.receive)}});
+        if required_peer == AssuranceLevel::Anonymous {
+            wire.as_object_mut()
+                .unwrap()
+                .remove("identity_assurance_required");
+        }
+        Ok(Self {
+            local,
+            wire,
+            server_assurance,
+            required_peer,
+        })
+    }
+    pub fn capabilities(&self) -> &Value {
+        &self.wire
+    }
+    pub fn engine_capabilities(&self) -> &EndpointMediaCapabilities {
+        &self.local
+    }
+    pub fn supports_data(&self) -> bool {
+        self.local
+            .send
+            .iter()
+            .chain(&self.local.receive)
+            .any(|c| c.medium == Medium::Data)
+    }
+    pub fn supports_rtp(&self) -> bool {
+        self.local
+            .send
+            .iter()
+            .chain(&self.local.receive)
+            .any(|c| c.medium != Medium::Data)
+    }
+}
+#[derive(Clone)]
+pub struct NativeOfferPlan {
+    pub(crate) selected: Vec<NegotiatedStream>,
+    pub(crate) rejected: Vec<super::super::Identifier>,
+    pub(crate) remote: EndpointMediaCapabilities,
+}
+impl NativeOfferPlan {
+    pub fn selected(&self) -> &[NegotiatedStream] {
+        &self.selected
+    }
+    pub fn rejected(&self) -> &[super::super::Identifier] {
+        &self.rejected
+    }
+    pub fn remote_capabilities(&self) -> &EndpointMediaCapabilities {
+        &self.remote
+    }
+    pub fn parse(
+        offer: &super::super::payloads::ConnectionOffer,
+        profile: &NativeMediaProfile,
+        principal: &rvoip_core::identity::AuthenticatedPrincipal,
+    ) -> Result<Self, NativeOfferError> {
+        let v = &offer.capabilities;
+        if !v.is_object() {
+            return Err(NativeOfferError::Invalid);
+        }
+        let actual = assurance(principal.assurance.kind())?;
+        if rank(actual) < rank(profile.required_peer) {
+            return Err(NativeOfferError::Authority);
+        }
+        if let Some(level) = v.get("identity_assurance_offered") {
+            if assurance(level.as_str().ok_or(NativeOfferError::Invalid)?)? != actual {
+                return Err(NativeOfferError::Authority);
+            }
+        }
+        if let Some(level) = v.get("identity_assurance_required") {
+            if rank(profile.server_assurance)
+                < rank(assurance(level.as_str().ok_or(NativeOfferError::Invalid)?)?)
+            {
+                return Err(NativeOfferError::Authority);
+            }
+        }
+        let maximum = v
+            .get("max_streams_per_connection")
+            .and_then(Value::as_u64)
+            .ok_or(NativeOfferError::Invalid)?;
+        if maximum == 0
+            || maximum > 65535
+            || offer.streams_offered.is_empty()
+            || offer.streams_offered.len() > 32
+            || offer.streams_offered.len() > maximum as usize
+        {
+            return Err(NativeOfferError::Capacity);
+        }
+        let audio = codecs(v.get("audio_codecs"), Medium::Audio)?;
+        let video = codecs(v.get("video_codecs"), Medium::Video)?;
+        let mut data = Vec::new();
+        if let Some(values) = v.get("data_protocols") {
+            let values = values.as_array().ok_or(NativeOfferError::Invalid)?;
+            if values.len() > 3 {
+                return Err(NativeOfferError::Capacity);
+            }
+            for value in values {
+                let format = MediaFormat::ReliableOrdered(match value.as_str() {
+                    Some("text") => DataProtocol::Text,
+                    Some("json") => DataProtocol::Json,
+                    Some("binary") => DataProtocol::Binary,
+                    _ => return Err(NativeOfferError::Invalid),
+                });
+                if data.contains(&format) {
+                    return Err(NativeOfferError::Invalid);
+                }
+                data.push(format);
+            }
+        }
+        let caps = vec![
+            (Medium::Audio, audio),
+            (Medium::Video, video.clone()),
+            (Medium::Screen, video),
+            (Medium::Data, data),
+        ]
+        .into_iter()
+        .filter(|(_, f)| !f.is_empty())
+        .map(|(medium, formats)| MediaCapability { medium, formats })
+        .collect::<Vec<_>>();
+        let (send, receive) = if let Some(native) = v.get("native_media") {
+            if native.get("version").and_then(Value::as_u64) != Some(1) {
+                return Err(NativeOfferError::Unsupported);
+            }
+            (
+                directional(native.get("send"), &caps)?,
+                directional(native.get("receive"), &caps)?,
+            )
+        } else {
+            (caps.clone(), caps)
+        };
+        let remote = EndpointMediaCapabilities {
+            send,
+            receive,
+            max_streams: maximum.min(32) as usize,
+            renegotiation: true,
+        };
+        let mut selected = Vec::new();
+        let mut rejected = Vec::new();
+        let mut ids = BTreeSet::new();
+        for stream in &offer.streams_offered {
+            if !ids.insert(stream.id.clone()) {
+                return Err(NativeOfferError::Invalid);
+            }
+            let medium = match stream.kind {
+                super::super::payloads::StreamOfferKind::Audio => Medium::Audio,
+                super::super::payloads::StreamOfferKind::Video => Medium::Video,
+                super::super::payloads::StreamOfferKind::Screen => Medium::Screen,
+                super::super::payloads::StreamOfferKind::Data => Medium::Data,
+            };
+            // Directions describe their emitting endpoint. Peer sendonly is
+            // local receive; it cannot silently acquire a local publish port.
+            let direction = match stream.direction {
+                super::super::payloads::StreamOfferDirection::Sendrecv => StreamDirection::Both,
+                super::super::payloads::StreamOfferDirection::Sendonly => StreamDirection::Receive,
+                super::super::payloads::StreamOfferDirection::Recvonly => StreamDirection::Send,
+                super::super::payloads::StreamOfferDirection::Inactive => {
+                    return Err(NativeOfferError::Unsupported);
+                }
+            };
+            if stream.codec_preferences.len() > 32 {
+                return Err(NativeOfferError::Capacity);
+            }
+            let formats = Some(
+                remote
+                    .send
+                    .iter()
+                    .chain(&remote.receive)
+                    .filter(|c| c.medium == medium)
+                    .flat_map(|c| c.formats.iter())
+                    .collect::<Vec<_>>(),
+            );
+            let desired = DesiredStream {
+                logical_id: rvoip_core::ids::StreamId::from_string(stream.id.as_str()),
+                medium,
+                direction,
+            };
+            let mut chosen = None;
+            for preference in &stream.codec_preferences {
+                let name = normalize(preference);
+                if let Some(formats) = &formats {
+                    for format in formats {
+                        if format_name(format) != name {
+                            continue;
+                        }
+                        let candidate = NegotiatedStream {
+                            requested: desired.clone(),
+                            format: (**format).clone(),
+                        };
+                        if validate_selected_streams(
+                            &profile.local,
+                            &remote,
+                            std::slice::from_ref(&candidate),
+                        )
+                        .is_ok()
+                        {
+                            chosen = Some(candidate);
+                            break;
+                        }
+                    }
+                }
+                if chosen.is_some() {
+                    break;
+                }
+            }
+            if let Some(choice) = chosen {
+                selected.push(choice);
+            } else {
+                rejected.push(stream.id.clone());
+            }
+        }
+        if selected.is_empty() {
+            return Err(NativeOfferError::Unsupported);
+        }
+        validate_selected_streams(&profile.local, &remote, &selected)
+            .map_err(|_| NativeOfferError::Capacity)?;
+        Ok(Self {
+            selected,
+            rejected,
+            remote,
+        })
+    }
+}
+pub(crate) fn check_native(format: &MediaFormat, medium: Medium) -> Result<(), NativeOfferError> {
+    match format {
+        MediaFormat::ReliableOrdered(_) if medium == Medium::Data => Ok(()),
+        _ => crate::staged_media::codec(format, medium, None)
+            .map(|_| ())
+            .map_err(|_| NativeOfferError::Unsupported),
+    }
+}
+fn codecs(v: Option<&Value>, medium: Medium) -> Result<Vec<MediaFormat>, NativeOfferError> {
+    let Some(v) = v else { return Ok(vec![]) };
+    let values = v.as_array().ok_or(NativeOfferError::Invalid)?;
+    if values.len() > 32 {
+        return Err(NativeOfferError::Capacity);
+    }
+    let mut formats = Vec::new();
+    for value in values {
+        let name = value
+            .get("name")
+            .and_then(Value::as_str)
+            .ok_or(NativeOfferError::Invalid)?;
+        if name.is_empty()
+            || name.len() > 64
+            || !name
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"-._/".contains(&c))
+        {
+            return Err(NativeOfferError::Invalid);
+        }
+        let params = value
+            .get("params")
+            .and_then(Value::as_object)
+            .ok_or(NativeOfferError::Invalid)?;
+        if params.len() > 16 {
+            return Err(NativeOfferError::Capacity);
+        }
+        let name = normalize(name);
+        let (rate, channels) = match (medium, name.as_str()) {
+            (Medium::Audio, "pcmu" | "pcma") => (8000, 1),
+            (Medium::Audio, "opus") => (48000, 1),
+            (Medium::Video | Medium::Screen, "vp8") => (90000, 0),
+            _ => continue,
+        };
+        let number = |key: &str, default: u64| -> Result<u64, NativeOfferError> {
+            match params.get(key) {
+                None => Ok(default),
+                Some(v) => v.as_u64().ok_or(NativeOfferError::Invalid),
+            }
+        };
+        let rate = number("sample_rate", rate)?;
+        let channels = number("channels", channels)?;
+        if rate > 192000 || channels > 8 {
+            return Err(NativeOfferError::Invalid);
+        }
+        if let Some(pt) = params.get("payload_type") {
+            if pt.as_u64().is_none_or(|n| n > 127) {
+                return Err(NativeOfferError::Invalid);
+            }
+        }
+        if params.keys().any(|key| {
+            !matches!(
+                key.as_str(),
+                "sample_rate" | "channels" | "payload_type" | "fmtp"
+            )
+        }) {
+            continue;
+        }
+        let fmtp = match params.get("fmtp") {
+            None => None,
+            Some(Value::String(v)) if v.is_empty() => None,
+            Some(Value::String(v)) if v.len() <= 1024 && !v.chars().any(char::is_control) => {
+                Some(v.clone())
+            }
+            _ => return Err(NativeOfferError::Invalid),
+        };
+        let format = MediaFormat::Encoded {
+            name,
+            clock_rate_hz: rate as u32,
+            channels: channels as u8,
+            fmtp,
+        };
+        if check_native(&format, medium).is_err() {
+            continue;
+        }
+        if formats.contains(&format) {
+            return Err(NativeOfferError::Invalid);
+        }
+        formats.push(format);
+    }
+    Ok(formats)
+}
+fn directional(
+    value: Option<&Value>,
+    catalog: &[MediaCapability],
+) -> Result<Vec<MediaCapability>, NativeOfferError> {
+    let values = value
+        .and_then(Value::as_array)
+        .ok_or(NativeOfferError::Invalid)?;
+    if values.len() > 4 {
+        return Err(NativeOfferError::Capacity);
+    }
+    let mut kinds = BTreeSet::new();
+    let mut result = Vec::new();
+    for value in values {
+        let medium = match value.get("kind").and_then(Value::as_str) {
+            Some("audio") => Medium::Audio,
+            Some("video") => Medium::Video,
+            Some("screen") => Medium::Screen,
+            Some("data") => Medium::Data,
+            _ => return Err(NativeOfferError::Invalid),
+        };
+        if !kinds.insert(medium) {
+            return Err(NativeOfferError::Invalid);
+        }
+        let formats = if medium == Medium::Data {
+            let entries = value
+                .get("formats")
+                .and_then(Value::as_array)
+                .ok_or(NativeOfferError::Invalid)?;
+            if entries.len() > 3 {
+                return Err(NativeOfferError::Capacity);
+            }
+            let mut data = Vec::new();
+            for entry in entries {
+                if entry["params"]["reliability"] != "reliable_ordered" {
+                    return Err(NativeOfferError::Unsupported);
+                }
+                let format =
+                    MediaFormat::ReliableOrdered(match entry.get("name").and_then(Value::as_str) {
+                        Some("text") => DataProtocol::Text,
+                        Some("json") => DataProtocol::Json,
+                        Some("binary") => DataProtocol::Binary,
+                        _ => return Err(NativeOfferError::Invalid),
+                    });
+                if data.contains(&format) {
+                    return Err(NativeOfferError::Invalid);
+                }
+                data.push(format);
+            }
+            data
+        } else {
+            codecs(value.get("formats"), medium)?
+        };
+        if formats.is_empty()
+            || formats.iter().any(|f| {
+                !catalog
+                    .iter()
+                    .find(|c| c.medium == medium)
+                    .is_some_and(|c| c.formats.contains(f))
+            })
+        {
+            return Err(NativeOfferError::Invalid);
+        }
+        result.push(MediaCapability { medium, formats });
+    }
+    Ok(result)
+}
+pub(crate) fn normalize(name: &str) -> String {
+    match name.to_ascii_lowercase().as_str() {
+        "g.711-mu" => "pcmu".into(),
+        "g.711-a" => "pcma".into(),
+        other => other.into(),
+    }
+}
+pub(crate) fn format_name(format: &MediaFormat) -> String {
+    match format {
+        MediaFormat::Encoded { name, .. } => normalize(name),
+        MediaFormat::ReliableOrdered(p) => match p {
+            DataProtocol::Text => "text",
+            DataProtocol::Json => "json",
+            DataProtocol::Binary => "binary",
+        }
+        .into(),
+    }
+}
+pub(crate) fn payload_type(format: &MediaFormat) -> Option<u8> {
+    match format_name(format).as_str() {
+        "pcmu" => Some(0),
+        "pcma" => Some(8),
+        "opus" => Some(111),
+        "vp8" => Some(96),
+        _ => None,
+    }
+}
+pub(crate) fn codec_wire(format: &MediaFormat, pt: Option<u8>) -> Value {
+    match format {
+        MediaFormat::Encoded {
+            name,
+            clock_rate_hz,
+            channels,
+            fmtp,
+        } => {
+            let mut params = json!({"sample_rate":clock_rate_hz,"channels":channels});
+            if let Some(pt) = pt {
+                params["payload_type"] = json!(pt);
+            }
+            if let Some(fmtp) = fmtp {
+                params["fmtp"] = json!(fmtp);
+            }
+            json!({"name":name,"params":params})
+        }
+        MediaFormat::ReliableOrdered(_) => {
+            json!({"name":format_name(format),"params":{"reliability":"reliable_ordered"}})
+        }
+    }
+}
+pub(crate) fn kind(m: Medium) -> &'static str {
+    match m {
+        Medium::Audio => "audio",
+        Medium::Video => "video",
+        Medium::Screen => "screen",
+        Medium::Data => "data",
+    }
+}
+pub(crate) fn direction(d: StreamDirection) -> &'static str {
+    match d {
+        StreamDirection::Send => "sendonly",
+        StreamDirection::Receive => "recvonly",
+        StreamDirection::Both => "sendrecv",
+    }
+}
+pub(crate) fn peer_direction(d: StreamDirection) -> &'static str {
+    direction(match d {
+        StreamDirection::Send => StreamDirection::Receive,
+        StreamDirection::Receive => StreamDirection::Send,
+        StreamDirection::Both => StreamDirection::Both,
+    })
+}
+fn assurance(v: &str) -> Result<AssuranceLevel, NativeOfferError> {
+    match v {
+        "none" | "anonymous" => Ok(AssuranceLevel::Anonymous),
+        "pseudonymous" => Ok(AssuranceLevel::Pseudonymous),
+        "identified" => Ok(AssuranceLevel::Identified),
+        "task-scoped" => Ok(AssuranceLevel::TaskScoped),
+        "user-authorized" => Ok(AssuranceLevel::UserAuthorized),
+        _ => Err(NativeOfferError::Invalid),
+    }
+}
+fn rank(a: AssuranceLevel) -> u8 {
+    match a {
+        AssuranceLevel::Anonymous => 0,
+        AssuranceLevel::Pseudonymous => 1,
+        AssuranceLevel::Identified => 2,
+        AssuranceLevel::TaskScoped => 3,
+        AssuranceLevel::UserAuthorized => 4,
+    }
+}
