@@ -0,0 +1,733 @@
+//! Real signed offers, actual staged codecs/handles and endpoint parameter
+//! confirmation. The relationship/store policy is controlled; no public Ready,
+//! Participant admission or durable Connect receipt is claimed here.
+use super::*;
+use rvoip_auth_core::sig9421::PrincipalVerificationKey;
+use rvoip_core::capability::{AssuranceLevel, DataProtocol};
+use rvoip_uctp::{
+    staged_data::NativeDataOutcome,
+    v2::{native_negotiation::*, payloads::Payload},
+};
+use std::{any::Any, sync::Mutex};
+
+struct State {
+    owners: HashMap<ConnectionId, MediaOwner>,
+    denied: bool,
+    key: ResolvedVerificationKey,
+}
+struct Grants(Arc<RwLock<State>>);
+struct Proof {
+    base: AuthorityLease,
+    guard: Arc<OwnedRwLockReadGuard<State>>,
+}
+struct Invocation {
+    a: Arc<AuthorizedEnvelope>,
+    domain: Arc<Grants>,
+    plan: NativeOfferPlan,
+}
+struct Lease {
+    owner: MediaOwner,
+    _proof: Arc<AuthorizedEnvelope>,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+struct FreshLease {
+    owner: MediaOwner,
+    _guard: OwnedRwLockReadGuard<State>,
+}
+impl MediaAuthorityLease for FreshLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+impl MediaPolicy for Grants {
+    fn current(&self, s: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        if guard.denied {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = credential_owner(
+            guard
+                .owners
+                .get(s.connection)
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            s.principal,
+        )?;
+        Ok(Box::new(FreshLease {
+            owner,
+            _guard: guard,
+        }))
+    }
+    fn current_control(
+        &self,
+        s: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let i = held
+            .downcast_ref::<Invocation>()
+            .ok_or(StreamControlError::Authority)?;
+        let proof =
+            i.a.authority::<Proof>()
+                .ok_or(StreamControlError::Authority)?;
+        let wire = proof
+            .base
+            .authority::<WireProof>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.0, &i.domain.0)
+            || proof.guard.denied
+            || wire.connection.as_ref() != Some(s.connection)
+            || i.a.envelope().scope(Scope::Conversation) != Some("conversation")
+            || i.a.envelope().scope(Scope::Session) != Some("session")
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                i.a.principal(),
+                s.principal,
+            )
+        {
+            return Err(StreamControlError::Authority);
+        }
+        match intent {
+            MediaControlIntent::Initialize => {}
+            MediaControlIntent::Change {
+                expected,
+                desired,
+                replace,
+            } if *expected == i.a.envelope().expected_revision().unwrap_or(0)
+                && desired
+                    .iter()
+                    .eq(i.plan.selected().iter().map(|s| &s.requested))
+                && replace.is_empty() => {}
+            _ => return Err(StreamControlError::Authority),
+        }
+        let mut owner = credential_owner(
+            proof
+                .guard
+                .owners
+                .get(s.connection)
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            s.principal,
+        )?;
+        owner.remote = i.plan.remote_capabilities().clone();
+        MediaControl::new(
+            Box::new(Lease {
+                owner,
+                _proof: i.a.clone(),
+            }),
+            i.a.invocation_cancellation(),
+            deadline(),
+        )
+    }
+}
+struct Authority {
+    base: Arc<WirePolicy>,
+    grants: Arc<Grants>,
+}
+#[async_trait]
+impl PeerAuthority for Authority {
+    fn authority_lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        h: &AuthorityLease,
+    ) -> Result<AuthorityLifetime, DispatchError> {
+        self.base.authority_lifetime(c, d, i, h)
+    }
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let base = self.base.acquire(c, d, i, e).await?;
+        if e.kind() != "connection.offer" {
+            return Ok(base);
+        }
+        let guard = Arc::new(self.grants.0.clone().read_owned().await);
+        if guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(Proof { base, guard }))
+    }
+    async fn refresh(
+        &self,
+        a: &ValidatedBearer,
+        b: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.base.refresh(a, b, d, i, e).await
+    }
+    fn negotiation_answer(
+        &self,
+        _: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        offer: &Envelope,
+        answer: &Envelope,
+        h: &AuthorityLease,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let p = h.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if p.guard.denied
+            || offer.kind() != "connection.offer"
+            || answer.original()["payload"]["substrate_setup"]["offer_id"] != offer.id()
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(h.retained())
+    }
+    fn exchange_request(
+        &self,
+        _: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        offer: &Envelope,
+        request: &Envelope,
+        h: &AuthorityLease,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let p = h.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if p.guard.denied
+            || request.kind() != "connection.offer"
+            || request.original()["payload"]["substrate_setup"]["offer_id"] != offer.id()
+        {
+            return Err(DispatchError::Authority);
+        }
+        for scope in [
+            Scope::Conversation,
+            Scope::Session,
+            Scope::Connection,
+            Scope::Operation,
+        ] {
+            if offer.scope(scope) != request.scope(scope) {
+                return Err(DispatchError::ScopeDenied);
+            }
+        }
+        Ok(h.retained())
+    }
+    fn exchange_reply(
+        &self,
+        c: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        _: &Envelope,
+        _: &Envelope,
+        h: &AuthorityLease,
+    ) -> Result<ExchangeReplyAuthority, DispatchError> {
+        let p = h.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if p.guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        let key = PrincipalVerificationKey::from_current(
+            &c.principal,
+            "client".into(),
+            p.guard.key.clone(),
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        Ok(ExchangeReplyAuthority {
+            lease: h.retained(),
+            key,
+        })
+    }
+}
+#[derive(Default)]
+struct Record {
+    results: Mutex<Vec<Result<NativeOfferOutcome, NativeOfferError>>>,
+    media: Mutex<Option<Arc<NativePeerMedia>>>,
+}
+struct Observer;
+impl NativeDataObserver for Observer {
+    fn observe(&self, _: &StagedRtpScope, _: &NativeDataOutcome) -> ControlResult<()> {
+        Err(StreamControlError::Unsupported)
+    }
+}
+struct OfferFactory {
+    native: Arc<Factory>,
+    grants: Arc<Grants>,
+    profile: Arc<NativeMediaProfile>,
+    record: Arc<Record>,
+}
+struct OfferHandler {
+    native: Arc<Factory>,
+    physical: Arc<NativePhysicalBinding>,
+    grants: Arc<Grants>,
+    profile: Arc<NativeMediaProfile>,
+    record: Arc<Record>,
+}
+impl PhysicalHandlerFactory for OfferFactory {
+    fn handler(
+        &self,
+        context: NativeTransportContext,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        *self.record.media.lock().unwrap() = context.media();
+        let physical = NativePhysicalBinding::new(context);
+        physical.with_data_handler(Arc::new(OfferHandler {
+            native: self.native.clone(),
+            physical: physical.clone(),
+            grants: self.grants.clone(),
+            profile: self.profile.clone(),
+            record: self.record.clone(),
+        }))
+    }
+}
+#[async_trait]
+impl AuthenticatedHandler for OfferHandler {
+    async fn handle(&self, _: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+    async fn handle_replies(&self, a: AuthorizedEnvelope) -> Result<HandlerReplies, DispatchError> {
+        let a = Arc::new(a);
+        let proof = a.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        let wire = proof
+            .base
+            .authority::<WireProof>()
+            .ok_or(DispatchError::Authority)?;
+        let id = wire.connection.clone().ok_or(DispatchError::Authority)?;
+        let Payload::ConnectionOffer(offer) = a.envelope().payload() else {
+            return Err(DispatchError::Unsupported);
+        };
+        let plan = NativeOfferPlan::parse(offer, &self.profile, a.principal())
+            .map_err(|_| DispatchError::Unsupported)?;
+        let invocation = Arc::new(Invocation {
+            a: a.clone(),
+            domain: self.grants.clone(),
+            plan,
+        });
+        let kind = self.physical.transport();
+        let adapter = &self.native.adapters[&kind];
+        if adapter.media_controller(&id).is_err() {
+            let view = View(&wire.authorities[&kind]);
+            self.native
+                .core
+                .orch
+                .prepare_peer_native_connection(
+                    a.peer_admission().ok_or(DispatchError::Authority)?.clone(),
+                    a.principal(),
+                    PeerNativeIntent {
+                        session: self.native.core.session.clone(),
+                        connection: id.clone(),
+                        transport: kind,
+                    },
+                    &view,
+                    self.physical.clone(),
+                )
+                .map_err(|_| DispatchError::Authority)?
+                .retain(a.principal(), &view)
+                .map_err(|_| DispatchError::Authority)?;
+            adapter
+                .configure_negotiated_media_with_held(
+                    &id,
+                    &a,
+                    self.native.core.conversation.clone(),
+                    StagedRtpScope {
+                        session: self.native.core.session.clone(),
+                        connection: id.clone(),
+                        owner: a.principal().ownership_key(),
+                        wire_conversation: Some("conversation".into()),
+                        wire_session: "session".into(),
+                        wire_connection: a.envelope().scope(Scope::Connection).unwrap().into(),
+                    },
+                    self.grants.clone(),
+                    self.profile.clone(),
+                    Some(Arc::new(Observer)),
+                    16,
+                    invocation.as_ref(),
+                )
+                .map_err(|e| {
+                    self.record.results.lock().unwrap().push(Err(e));
+                    DispatchError::Authority
+                })?;
+        }
+        let result = adapter
+            .negotiate_native_offer(&id, a.clone(), invocation, deadline())
+            .await;
+        let ok = result.is_ok();
+        self.record.results.lock().unwrap().push(result);
+        if !ok {
+            return Err(DispatchError::Authority);
+        }
+        a.finish_answered_offer()
+    }
+}
+fn profile(data: bool) -> Arc<NativeMediaProfile> {
+    let mut local = capabilities();
+    local.send[0].formats.push(MediaFormat::Encoded {
+        name: "pcma".into(),
+        clock_rate_hz: 8000,
+        channels: 1,
+        fmtp: None,
+    });
+    if data {
+        local.send.push(MediaCapability {
+            medium: Medium::Data,
+            formats: vec![MediaFormat::ReliableOrdered(DataProtocol::Binary)],
+        });
+    }
+    local.receive = local.send.clone();
+    Arc::new(
+        NativeMediaProfile::new(
+            local,
+            AssuranceLevel::Identified,
+            AssuranceLevel::Identified,
+        )
+        .unwrap(),
+    )
+}
+struct Scene {
+    f: Fixture,
+    wire: Wire,
+    native: Arc<Factory>,
+    grants: Arc<Grants>,
+    record: Arc<Record>,
+    id: ConnectionId,
+    kind: Transport,
+    profile: Arc<NativeMediaProfile>,
+}
+impl Scene {
+    async fn new(kind: &str, data: bool) -> Self {
+        let (mut f, native, policy) = wire_setup().await;
+        let transport = if kind == "wt" {
+            Transport::WebTransport
+        } else {
+            Transport::Quic
+        };
+        let id = policy.grants.read().await.connections["native_0"].clone();
+        let profile = profile(data);
+        let mut owner = media_owner(&native.core, &id, transport);
+        owner.local = profile.engine_capabilities().clone();
+        owner.remote = owner.local.clone();
+        if data {
+            owner.send_media.insert(Medium::Data);
+            owner.receive_media.insert(Medium::Data);
+        }
+        let grants = Arc::new(Grants(Arc::new(RwLock::new(State {
+            owners: HashMap::from([(id.clone(), owner)]),
+            denied: false,
+            key: ResolvedVerificationKey {
+                public_key: f.client_public.clone(),
+                algorithm: "EdDSA".into(),
+                not_before: None,
+                expires_at: None,
+                revoked: false,
+            },
+        }))));
+        Arc::get_mut(&mut f.config).unwrap().authority = Arc::new(Authority {
+            base: policy,
+            grants: grants.clone(),
+        });
+        let record = Arc::new(Record::default());
+        let factory = Arc::new(OfferFactory {
+            native: native.clone(),
+            grants: grants.clone(),
+            profile: profile.clone(),
+            record: record.clone(),
+        });
+        let canonical = CanonicalProfile::new(f.config.clone(), Arc::new(Handler::default()), 8)
+            .unwrap()
+            .with_physical_handlers(factory);
+        let mut wire = wire(kind, canonical, "/uctp", Some("https://allowed.example"))
+            .await
+            .unwrap();
+        authenticate_wire(&mut wire, &f).await;
+        Self {
+            f,
+            wire,
+            native,
+            grants,
+            record,
+            id,
+            kind: transport,
+            profile,
+        }
+    }
+    fn controller(&self) -> Arc<StreamController> {
+        self.native.adapters[&self.kind]
+            .media_controller(&self.id)
+            .unwrap()
+    }
+    fn offer(&self, revision: u64, data: bool) -> Value {
+        let mut v = native_offer(
+            0,
+            if self.kind == Transport::Quic {
+                "quic"
+            } else {
+                "wt"
+            },
+        );
+        v["id"] = json!(format!("offer_{}", uuid::Uuid::new_v4().simple()));
+        v["operation_id"] = json!(format!("op_{}", uuid::Uuid::new_v4().simple()));
+        v["expected_revision"] = json!(revision);
+        v["payload"]["by_participant"] = json!(core_fixture::participant("alice").as_str());
+        v["payload"]["capabilities"] = self.profile.capabilities().clone();
+        v["payload"]["streams_offered"] = json!([
+            {"id":"first","kind":"audio","direction":"sendrecv","codec_preferences":["pcma","pcmu"]},
+            {"id":"second","kind":"audio","direction":"sendonly","codec_preferences":["pcmu","pcma"]}]);
+        if data {
+            v["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"data","kind":"data","direction":"sendrecv","codec_preferences":["binary"]}));
+        }
+        v
+    }
+    async fn prepared(&mut self, offer: Value) -> (Envelope, Envelope) {
+        self.wire.send(self.f.sign(offer)).await;
+        let answer = self.wire.read().await;
+        assert_eq!(answer.kind(), "connection.answer", "{answer:?}");
+        self.f.verify_server(&answer).await;
+        let callback = self.wire.read().await;
+        assert_eq!(callback.kind(), "connection.offer");
+        self.f.verify_server(&callback).await;
+        assert_eq!(
+            answer.original()["payload"]["substrate_setup"],
+            callback.original()["payload"]["substrate_setup"]
+        );
+        (answer, callback)
+    }
+    fn confirmation(&self, callback: &Envelope) -> Value {
+        let p = &callback.original()["payload"];
+        let streams=p["substrate_setup"]["streams"].as_array().unwrap().iter().map(|s|json!({"id":s["strm_id"],"kind":s["kind"],"direction":match s["direction"].as_str().unwrap(){"sendonly"=>"recvonly","recvonly"=>"sendonly",_=>"sendrecv"},"codec":s["codec"]})).collect::<Vec<_>>();
+        let mut answer = envelope(
+            "connection.answer",
+            json!({"by_participant":core_fixture::participant("alice").as_str(),"substrate":p["substrate"],"capabilities":self.profile.capabilities(),"streams_answered":streams,"substrate_setup":p["substrate_setup"]}),
+        );
+        for field in ["cid", "sid", "connid", "operation_id"] {
+            answer[field] = callback.original()[field].clone();
+        }
+        answer["in_reply_to"] = json!(callback.id());
+        answer
+    }
+    async fn confirm(&mut self, callback: &Envelope) {
+        self.wire
+            .send(self.f.sign(self.confirmation(callback)))
+            .await;
+    }
+    async fn wait(&self, count: usize) {
+        core_fixture::until(|| self.record.results.lock().unwrap().len() >= count).await;
+    }
+}
+#[tokio::test]
+async fn signed_native_offers_commit_per_stream_peer_codec_order_and_actual_rtp_on_tls_transports()
+{
+    for kind in ["quic", "wt"] {
+        let mut s = Scene::new(kind, false).await;
+        let (answer, callback) = s.prepared(s.offer(0, false)).await;
+        let setup = &answer.original()["payload"]["substrate_setup"];
+        assert_eq!(setup["streams"][0]["codec"]["name"], "pcma");
+        assert_eq!(setup["streams"][1]["codec"]["name"], "pcmu");
+        let handle = setup["streams"][1]["stream_local_id"].as_u64().unwrap() as u16;
+        assert_eq!(
+            s.controller().revision(),
+            0,
+            "prepared parameters must not commit early"
+        );
+        s.confirm(&callback).await;
+        s.wait(1).await;
+        assert!(s.record.results.lock().unwrap()[0].is_ok());
+        assert_eq!(s.controller().revision(), 1);
+        let mut input = s
+            .controller()
+            .take_ingress(&StreamId::from_string("second"))
+            .unwrap();
+        send(&s.wire, audio(handle, 0));
+        let _packet = packet(&mut input).await;
+        s.wire.server.shutdown().await.unwrap();
+    }
+}
