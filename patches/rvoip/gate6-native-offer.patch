+#[tokio::test]
+async fn incompatible_upgrade_preserves_old_audio_and_partial_new_stream_rejection_is_truthful() {
+    let mut s = Scene::new("quic", false).await;
+    let (_, callback) = s.prepared(s.offer(0, false)).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let initial = s.controller().active_bindings();
+    let original = initial
+        .iter()
+        .find(|b| b.negotiated.requested.logical_id.as_str() == "second")
+        .unwrap()
+        .stream_local_id;
+    let mut input = s
+        .controller()
+        .take_ingress(&StreamId::from_string("second"))
+        .unwrap();
+    let mut partial = s.offer(1, false);
+    partial["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"new-video","kind":"video","direction":"sendrecv","codec_preferences":["vp9"]}));
+    let (answer, callback) = s.prepared(partial).await;
+    assert_eq!(
+        answer.original()["payload"]["streams_answered"]
+            .as_array()
+            .unwrap()
+            .len(),
+        2
+    );
+    s.confirm(&callback).await;
+    s.wait(2).await;
+    {
+        let results = s.record.results.lock().unwrap();
+        let outcome = results[1].as_ref().unwrap();
+        assert_eq!(outcome.rejected[0].as_str(), "new-video");
+    }
+    assert_eq!(s.controller().revision(), 2);
+    let mut incompatible = s.offer(2, false);
+    incompatible["payload"]["streams_offered"][1]["codec_preferences"] = json!(["missing-codec"]);
+    s.wire.send(s.f.sign(incompatible)).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.wait(3).await;
+    assert!(matches!(
+        s.record.results.lock().unwrap()[2],
+        Err(NativeOfferError::Unsupported)
+    ));
+    assert_eq!(s.controller().revision(), 2);
+    send(&s.wire, audio(original, 0));
+    let _packet = packet(&mut input).await;
+    s.wire.server.shutdown().await.unwrap();
+}
