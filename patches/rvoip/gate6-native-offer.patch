+#[tokio::test]
+async fn queued_current_grant_writer_cannot_deadlock_native_parameter_confirmation() {
+    use std::future::Future;
+    let mut s = Scene::new("quic", false).await;
+    let (_, callback) = s.prepared(s.offer(0, false)).await;
+    let grants = s.grants.0.clone();
+    let queued = Arc::new(Notify::new());
+    let notify = queued.clone();
+    let writer = tokio::spawn(async move {
+        let mut future = Box::pin(grants.write_owned());
+        let mut guard = futures::future::poll_fn(|cx| {
+            let p = future.as_mut().poll(cx);
+            if p.is_pending() {
+                notify.notify_one();
+            }
+            p
+        })
+        .await;
+        guard.denied = true;
+    });
+    queued.notified().await;
+    assert!(s.grants.0.try_read().is_err());
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    assert!(s.record.results.lock().unwrap()[0].is_ok());
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(s.grants.0.read().await.denied);
+    let mut input = s
+        .controller()
+        .take_ingress(&StreamId::from_string("second"))
+        .unwrap();
+    let handle = s
+        .controller()
+        .active_bindings()
+        .iter()
+        .find(|b| b.negotiated.requested.logical_id.as_str() == "second")
+        .unwrap()
+        .stream_local_id;
+    send(&s.wire, audio(handle, 0));
+    assert!(
+        tokio::time::timeout(Duration::from_millis(100), input.recv())
+            .await
+            .is_err()
+    );
+    s.wire.server.shutdown().await.unwrap();
+}
