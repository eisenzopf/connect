+#[tokio::test]
+async fn original_native_audio_contention_queue_never_exceeds_ten_original_frames() {
+    let mut network = Network::new("quic").await;
+    let policy = Arc::new(TemporaryMetadata {
+        policy: network.grants.clone(),
+        gate: std::sync::Mutex::new(()),
+        only: std::sync::Mutex::new(None),
+        entered: Notify::new(),
+        refused: std::sync::atomic::AtomicUsize::new(0),
+    });
+    let source = network.configure_policy(0, policy.clone()).await;
+    let target = network.configure_policy(1, policy.clone()).await;
+    network.start(&source, &[Medium::Audio]).await;
+    network.start(&target, &[Medium::Audio]).await;
+    *policy.only.lock().unwrap() = Some(source.id.clone());
+    let mut input = source
+        .controller
+        .take_ingress(&StreamId::from_string("audio"))
+        .unwrap();
+    let stream = binding(&source, Medium::Audio).stream_local_id;
+    let held = policy.gate.lock().unwrap();
+    send(&network.wire, ordered_audio(stream, 1));
+    tokio::time::timeout(Duration::from_secs(1), policy.entered.notified())
+        .await
+        .unwrap();
+    for sequence in 2..=20 {
+        send(&network.wire, ordered_audio(stream, sequence));
+    }
+    // All twenty datagrams have reached the sole reader once ten are refused.
+    // Nothing is accepted while the first original remains metadata-blocked.
+    let saturated = tokio::time::timeout(Duration::from_millis(100), async {
+        while source.media.snapshot().ingress_rejected < 10 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .is_ok();
+    let before = source.media.snapshot();
+    drop(held);
+    let mut originals = true;
+    for sequence in 1..=10 {
+        let packet = tokio::time::timeout(Duration::from_millis(100), input.recv())
+            .await
+            .ok()
+            .flatten();
+        originals &= observed_original(&network, &target, packet, sequence * 160).await;
+    }
+    let no_extra = input.try_recv().is_err();
+    send(&network.wire, ordered_audio(stream, 21));
+    let fresh = tokio::time::timeout(Duration::from_millis(100), input.recv())
+        .await
+        .ok()
+        .flatten();
+    let fresh = observed_original(&network, &target, fresh, 21 * 160).await;
+    let after = source.media.snapshot();
+    network.stop().await;
+    println!("saturated={saturated} accepted_before={} rejected_before={} accepted_after={} rejected_after={} originals={originals} no_extra={no_extra} fresh={fresh}", before.ingress_accepted,before.ingress_rejected,after.ingress_accepted,after.ingress_rejected);
+    assert!(!source.media.snapshot().reader_running && source.media.router().is_shutdown());
+    assert!(saturated && before.ingress_accepted == 0 && before.ingress_rejected == 10);
+    assert!(originals && no_extra && fresh);
+    assert_eq!(after.ingress_accepted, 11);
+    assert_eq!(after.ingress_rejected, 10);
+}
