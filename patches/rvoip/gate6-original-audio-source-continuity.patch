+            .unwrap();
+    }
+    let mut mixed = s.port(2).take_egress().unwrap();
+    let mut healthy = s.port(3).take_egress().unwrap();
+    let mut last_healthy = None;
+    for n in 0..3 {
+        mode.store(0, Ordering::Release);
+        publish(&s, 0, n, 2000 + n as i16 * 2000, true);
+        publish(&s, 1, n, 1000, false);
