+//! Fixed numeric lifecycle summaries; no packet log, payload or authority.
+use super::*;
+#[derive(Default)]
+struct Distribution {
+    count: u64,
+    total_us: u64,
+    maximum_us: u64,
+    over_20ms: u64,
+    over_200ms: u64,
+    first_over_20ms_at_us: Option<u64>,
+    last_over_20ms_at_us: Option<u64>,
+}
+fn micros(duration: Duration) -> u64 {
+    duration.as_micros().min(u128::from(u64::MAX)) as u64
+}
+impl Distribution {
+    fn record(&mut self, duration: Duration, at: Duration) {
+        let us = micros(duration);
+        self.count = self.count.saturating_add(1);
+        self.total_us = self.total_us.saturating_add(us);
+        self.maximum_us = self.maximum_us.max(us);
+        if us > 20_000 {
+            self.over_20ms = self.over_20ms.saturating_add(1);
+            self.first_over_20ms_at_us.get_or_insert(micros(at));
+            self.last_over_20ms_at_us = Some(micros(at));
+        }
+        self.over_200ms = self.over_200ms.saturating_add(u64::from(us > 200_000));
+    }
+}
+pub(super) struct TickSummary {
+    started: Instant,
+    created_unix_us: i64,
+    previous_wake: Option<Instant>,
+    stages: [Distribution; 6],
+}
+impl Default for TickSummary {
+    fn default() -> Self {
+        Self {
+            started: Instant::now(),
+            created_unix_us: chrono::Utc::now().timestamp_micros(),
+            previous_wake: None,
+            stages: std::array::from_fn(|_| Distribution::default()),
+        }
+    }
+}
+impl TickSummary {
+    pub(super) fn record(
+        &mut self,
+        woke: Instant,
+        acquired: Instant,
+        audio: Instant,
+        direct: Instant,
+        ended: Instant,
+    ) {
+        let at = woke.saturating_duration_since(self.started);
+        if let Some(previous) = self.previous_wake.replace(woke) {
+            self.stages[0].record(woke.saturating_duration_since(previous), at);
+        }
+        for (index, duration) in [
+            acquired.saturating_duration_since(woke),
+            ended.saturating_duration_since(acquired),
+            audio.saturating_duration_since(acquired),
+            direct.saturating_duration_since(audio),
+            ended.saturating_duration_since(direct),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            self.stages[index + 1].record(duration, at);
+        }
+    }
+    pub(super) fn emit(&self, scene: u128, session: &SessionId) {
+        for (stage, value) in [
+            "wake-gap",
+            "members-lock-wait",
+            "members-lock-held",
+            "adopt-metadata",
+            "audio",
+            "direct",
+        ]
+        .into_iter()
+        .zip(&self.stages)
+        {
+            if value.count == 0 {
+                continue;
+            }
+            tracing::debug!(target: "rvoip_core::scene_summary", scene = %scene, %session, stage,
+                created_unix_us = self.created_unix_us,
+                lifetime_us = micros(self.started.elapsed()), count = value.count,
+                total_us = value.total_us, maximum_us = value.maximum_us,
+                over_20ms = value.over_20ms, over_200ms = value.over_200ms,
+                first_over_20ms_at_us = ?value.first_over_20ms_at_us,
+                last_over_20ms_at_us = ?value.last_over_20ms_at_us,
+                "Guarded media scene terminal timing summary");
+        }
+    }
+}
