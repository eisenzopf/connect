+    use crate::staged_streams::audio_subscriptions::{AudioSubscription, AudioSubscriptionChange};
+    let (s, mode) = room().await;
+    let controller = &s.controllers[3];
+    for change in [
+        AudioSubscriptionChange::Clear,
