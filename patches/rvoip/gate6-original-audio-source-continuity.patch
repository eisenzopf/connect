+//! Actual codec/route witnesses for late source capture, not synthetic outputs.
+use super::*;
+const BASE: u64 = 200u64 << 32;
+fn cadence(s: &Scene, quanta: u64) {
+    let now = Instant::now();
+    s.mixer
+        .observe_audio_tick_for_test(now, now - Duration::from_millis((quanta - 1) * 20));
+}
+fn publish(s: &Scene, index: usize, ordinal: u32, value: i16, known: bool) {
+    s.publish_clocked_ms(
+        index,
+        value,
+        ordinal.wrapping_mul(160),
+        20,
+        known.then(|| {
+            source_clock(
+                900 + index as u128,
+                8000,
+                0,
+                BASE,
+                Arc::new(std::sync::atomic::AtomicBool::new(true)),
+            )
+        }),
+    );
+}
+async fn frame_value(queued: QueuedMedia, value: i16, ordinal: Option<u32>) -> MediaFrame {
+    let frame = mixed_frame(queued).await;
+    let mut decoder =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap();
+    let decoded = decoder.decode(&frame.payload).unwrap();
+    assert_eq!(decoded.samples.len(), 160);
+    assert!(
+        (i32::from(decoded.samples[80]) - i32::from(value)).abs() < 350,
+        "exact original PCM lost: expected {value}, got {}",
+        decoded.samples[80]
+    );
+    if let Some(ordinal) = ordinal {
+        let clock = frame
+            .source_clock
+            .as_ref()
+            .expect("original source clock lost");
+        assert!(clock.supported && (clock.is_current)());
+        same_ntp(
+            clock.anchor.unwrap().ntp_time,
+            ntp_ms(BASE, u64::from(ordinal) * 20),
+        );
+    }
+    frame
+}
+async fn pair() -> Scene {
+    let s = Scene::new(&four()[..2], 8000).await;
+    s.bind(0, true).await;
+    s.bind(1, false).await;
+    s
+}
+#[tokio::test]
+async fn late_source_catchup_unblocked_original_control() {
+    let s = pair().await;
+    let mut out = s.port(1).take_egress().unwrap();
+    for n in 0..3 {
+        publish(&s, 0, n, 1000 + n as i16 * 2000, true);
+        cadence(&s, 1);
+        s.mixer.tick();
+        frame_value(out.try_recv().unwrap(), 1000 + n as i16 * 2000, Some(n)).await;
+        assert!(out.try_recv().is_err());
+        drop(s.policy.0.try_write().expect("current reader retained"));
+    }
+}
+#[tokio::test]
+async fn late_source_catchup_late_wake_keeps_each_original_quantum() {
+    let s = pair().await;
+    let mut out = s.port(1).take_egress().unwrap();
+    for n in 0..3 {
+        publish(&s, 0, n, 1000 + n as i16 * 2000, true);
+    }
+    cadence(&s, 3);
+    s.mixer.tick();
+    // On unchanged production this receives ordinal2/value5000: the two
+    // original, current, young quanta were discarded before target capture.
+    frame_value(
+        out.try_recv().expect("first original absent"),
+        1000,
+        Some(0),
+    )
+    .await;
+    frame_value(
+        out.try_recv().expect("bounded second round absent"),
+        3000,
+        Some(1),
+    )
+    .await;
+    assert!(
+        out.try_recv().is_err(),
+        "more than two source rounds escaped"
+    );
+    drop(
+        s.policy
+            .0
+            .try_write()
+            .expect("late capture retained authority"),
+    );
+    cadence(&s, 1);
+    s.mixer.tick();
+    frame_value(out.try_recv().unwrap(), 5000, Some(2)).await;
+    assert!(out.try_recv().is_err());
+    cadence(&s, 1);
+    s.mixer.tick();
+    assert!(out.try_recv().is_err());
+}
+#[tokio::test]
+async fn late_source_catchup_seven_originals_survive_sub_budget_burst() {
+    let s = pair().await;
+    let mut out = s.port(1).take_egress().unwrap();
+    for n in 0..7 {
+        publish(&s, 0, n, 1000 + n as i16 * 1000, true);
+    }
+    let mut next = 0;
+    for _ in 0..7 {
+        cadence(&s, 1);
+        s.mixer.tick();
+        let mut per_wake = 0;
+        while let Ok(queued) = out.try_recv() {
+            frame_value(queued, 1000 + next as i16 * 1000, Some(next)).await;
+            next += 1;
+            per_wake += 1;
+        }
+        assert!(per_wake <= 2);
+        drop(s.policy.0.try_write().expect("burst retained authority"));
+    }
+    assert_eq!(next, 7, "sub-budget original PCM was trimmed");
+}
+struct Busy {
+    inner: Arc<Policy>,
+    mode: Arc<AtomicUsize>,
+}
+impl MediaPolicy for Busy {
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current_participant_receive(scope, source)
+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let mode = self.mode.load(Ordering::Acquire);
+        if (mode == 1
+            && scope.connection.as_str() == "a"
+            && matches!(scope.purpose, MediaPurpose::Publish))
+            || (mode == 2
+                && scope.connection.as_str() == "c"
+                && matches!(scope.purpose, MediaPurpose::Receive { .. }))
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        self.inner.current(scope)
+    }
