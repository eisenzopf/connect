+#[tokio::test]
+async fn late_source_catchup_repeated_source_contention_clears_continuous_debt_and_tail() {
+    let (s, mode) = room().await;
+    let mut primary = s.port(2).take_egress().unwrap();
+    let mut sibling = s.port(3).take_egress().unwrap();
+    let mut received = 0u32;
+    let mut last = None;
+    for n in 0..36u32 {
+        mode.store(0, Ordering::Release);
+        publish(&s, 0, n, 1000 + (n % 6) as i16 * 1000, true);
+        mode.store(usize::from(n % 9 < 2), Ordering::Release);
+        cadence(&s, if n % 9 == 2 { 3 } else { 1 });
+        s.mixer.tick();
+        let mut count = 0;
+        while let Ok(queued) = primary.try_recv() {
+            let value = 1000 + (received % 6) as i16 * 1000;
+            let frame = frame_value(queued, value, Some(received)).await;
+            frame_value(
+                sibling.try_recv().expect("independent recipient stalled"),
+                value,
+                Some(received),
+            )
+            .await;
+            if let Some(previous) = last {
+                assert_eq!(frame.timestamp_rtp.wrapping_sub(previous), 160);
+            }
+            last = Some(frame.timestamp_rtp);
+            received += 1;
+            count += 1;
+        }
+        assert!(count <= 2 && sibling.try_recv().is_err());
+        if n % 9 >= 3 {
+            assert_eq!(received, n + 1, "permanent source recovery backlog");
+        }
+        drop(
+            s.policy
+                .0
+                .try_write()
+                .expect("deferred source retained current authority"),
+        );
+    }
+    assert_eq!(received, 36);
+    cadence(&s, 1);
+    s.mixer.tick();
+    assert!(
+        primary.try_recv().is_err() && sibling.try_recv().is_err(),
+        "tail repeated"
+    );
+}
