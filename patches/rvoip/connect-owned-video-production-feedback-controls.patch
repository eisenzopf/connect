+// A two-socket loopback NAT. The ordinary peer still writes and receives real
+// authenticated UDP. Only one exact clear RTP header is dropped; no protected
+// byte is rewritten, and the server has already completed its real send_to.
+#[derive(Clone, Copy)]
+struct Lost {
+    ssrc: u32,
+    seq: u16,
+    timestamp: u32,
+    at: Instant,
+}
+#[derive(Default)]
+struct Loss {
+    armed: Option<(u32, u16, bool)>,
+    lost: Option<Lost>,
+    feedback_packets_held: usize,
+    feedback_packets_released: usize,
+}
+struct Proxy {
+    a: Arc<UdpSocket>,
+    b: Arc<UdpSocket>,
+    state: Arc<Mutex<Loss>>,
+    dropped: Arc<Notify>,
+    stop: CancellationToken,
+    task: Option<tokio::task::JoinHandle<std::io::Result<()>>>,
+}
+impl Proxy {
+    async fn new() -> Self {
+        Self {
+            a: Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap()),
+            b: Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap()),
+            state: Arc::new(Mutex::new(Loss::default())),
+            dropped: Arc::new(Notify::new()),
+            stop: CancellationToken::new(),
+            task: None,
+        }
+    }
+    fn rewrite(sdp: &str, proxy: SocketAddr) -> (String, SocketAddr) {
+        let mut original = None;
+        let mut output = String::new();
+        for line in sdp.lines() {
+            if line.starts_with("a=candidate:") {
+                let mut fields = line
+                    .split_whitespace()
+                    .map(str::to_owned)
+                    .collect::<Vec<_>>();
+                assert!(
+                    fields.len() >= 8
+                        && fields[1] == "1"
+                        && fields[2].eq_ignore_ascii_case("udp")
+                        && fields[6] == "typ"
+                        && fields[7] == "host",
+                    "isolated single-host UDP candidate required"
+                );
+                let address: SocketAddr = format!("{}:{}", fields[4], fields[5]).parse().unwrap();
+                assert!(address.ip().is_loopback());
+                assert!(
+                    original
+                        .replace(address)
+                        .is_none_or(|previous| previous == address)
+                );
+                fields[4] = proxy.ip().to_string();
+                fields[5] = proxy.port().to_string();
+                output.push_str(&fields.join(" "));
+            } else {
+                output.push_str(line);
+            }
+            output.push_str("\r\n");
+        }
+        (output, original.expect("actual ICE host candidate"))
+    }
+    fn start(&mut self, server: SocketAddr, client: SocketAddr) {
+        let (a, b, state, dropped, stop) = (
+            self.a.clone(),
+            self.b.clone(),
+            self.state.clone(),
+            self.dropped.clone(),
+            self.stop.clone(),
+        );
+        self.task = Some(tokio::spawn(async move {
+            let mut from_server = [0u8; 2048];
+            let mut from_client = [0u8; 2048];
+            let mut held: VecDeque<Vec<u8>> = VecDeque::new();
+            let mut release = None;
+            loop {
+                let wake = release
+                    .unwrap_or_else(|| tokio::time::Instant::now() + Duration::from_secs(86400));
+                tokio::select! {
+                    _=stop.cancelled()=>return Ok(()),
+                    received=b.recv_from(&mut from_server)=>{
+                        let (size,owner)=received?; if owner!=server {continue;}
+                        let bytes=&from_server[..size];
+                        let skip={let mut current=state.lock().unwrap();
+                            if let Some((ssrc,seq,late))=current.armed {
+                                if size>=12 && bytes[0]>>6==2 && bytes[1]&127==96
+                                    &&u32::from_be_bytes(bytes[8..12].try_into().unwrap())==ssrc
+                                    &&u16::from_be_bytes(bytes[2..4].try_into().unwrap())==seq {
+                                    current.armed=None;
+                                    current.lost=Some(Lost{ssrc,seq,timestamp:u32::from_be_bytes(bytes[4..8].try_into().unwrap()),at:Instant::now()});
+                                    if late {release=Some(tokio::time::Instant::now()+Duration::from_millis(250));}
+                                    true
+                                } else {false}
+                            } else {false}};
+                        if skip {dropped.notify_one();} else {a.send_to(bytes,client).await?;}
+                    },
+                    received=a.recv_from(&mut from_client)=>{
+                        let (size,owner)=received?; if owner!=client {continue;}
+                        if release.is_some_and(|at|at>tokio::time::Instant::now()) {
+                            if held.len()>=64 {return Err(std::io::Error::other("bounded original feedback queue exhausted"));}
+                            held.push_back(from_client[..size].to_vec());
+                            state.lock().unwrap().feedback_packets_held+=1;
+                        } else {b.send_to(&from_client[..size],server).await?;}
+                    },
+                    _=tokio::time::sleep_until(wake),if release.is_some()=>{
+                        while let Some(bytes)=held.pop_front(){b.send_to(&bytes,server).await?;state.lock().unwrap().feedback_packets_released+=1;}
+                        release=None;
+                    },
+                }
+            }
+        }));
+    }
+    fn arm(&self, ssrc: u32, seq: u16, late: bool) {
+        let mut s = self.state.lock().unwrap();
+        assert!(s.armed.is_none() && s.lost.is_none());
+        s.armed = Some((ssrc, seq, late));
+    }
+    async fn lost(&self) -> Lost {
+        loop {
+            let notice = self.dropped.notified();
+            if let Some(value) = self.state.lock().unwrap().lost {
+                return value;
+            }
+            tokio::time::timeout_at(until(), notice)
+                .await
+                .expect("actual proxy did not observe/drop exact original SRTP");
+        }
+    }
+    async fn close(&mut self) -> bool {
+        self.stop.cancel();
+        match self.task.take() {
+            Some(task) => matches!(task.await, Ok(Ok(()))),
+            None => true,
+        }
+    }
+}
