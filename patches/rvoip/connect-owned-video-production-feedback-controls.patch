+#[tokio::test]
+async fn canonical_expired_fragment_feedback_refuses_revoked_paused_generation_foreign_and_cancelled_source()
+ {
+    let mut observations = vec![];
+    for action in 0..5 {
+        let mut h = Harness::new();
+        let result = std::panic::AssertUnwindSafe(async {
+            h.setup().await;
+            h.baseline().await;
+            let output_ssrc = h.physical[1]
+                .peer(until())
+                .await
+                .unwrap()
+                .local_video_ssrc()
+                .unwrap();
+            let lost_seq = h.next_sequence.wrapping_add(1);
+            // A foreign NACK needs no genuine hole: otherwise the receiver's
+            // legitimate automatic NACK would independently request recovery.
+            if action == 3 {
+                h.actual_nack(output_ssrc ^ 1, h.next_sequence.wrapping_sub(1))
+                    .await;
+                let pli = tokio::time::timeout(
+                    Duration::from_millis(600),
+                    h.remote[0].video_keyframe_requests().notified(),
+                )
+                .await
+                .is_ok();
+                return (pli, false, Duration::ZERO);
+            }
+            h.proxy.as_ref().unwrap().arm(output_ssrc, lost_seq, true);
+            let (ts, seq) = h.send_key().await;
+            let lost = h.proxy.as_ref().unwrap().lost().await;
+            match action {
+                0 => h.policy.mode.store(3, Ordering::SeqCst),
+                1 => {
+                    h.controllers[0]
+                        .set_paused(
+                            &desired(Medium::Video).logical_id,
+                            h.controllers[0].revision(),
+                            true,
+                            until(),
+                        )
+                        .await
+                        .unwrap();
+                }
+                2 => {
+                    h.controllers[0]
+                        .change(
+                            h.controllers[0].revision(),
+                            &[desired(Medium::Video)],
+                            &[desired(Medium::Video).logical_id].into_iter().collect(),
+                            until(),
+                            CancellationToken::new(),
+                        )
+                        .await
+                        .unwrap();
+                }
+                3 => {}
+                4 => {
+                    h.routes
+                        .get(&ConnectionId::from_string("alice"))
+                        .unwrap()
+                        .cancel
+                        .cancel();
+                }
+                _ => unreachable!(),
+            }
+            h.actual_nack(output_ssrc, lost_seq).await;
+            let pli = tokio::time::timeout(
+                Duration::from_millis(600),
+                h.remote[0].video_keyframe_requests().notified(),
+            )
+            .await
+            .is_ok();
+            let old = h
+                .collect(
+                    ts,
+                    &seq,
+                    tokio::time::Instant::now() + Duration::from_millis(10),
+                )
+                .await;
+            (
+                pli,
+                old.iter().any(|p| p.header.sequence_number == lost_seq),
+                lost.at.elapsed(),
+            )
+        })
+        .catch_unwind()
+        .await;
+        let clean = h.close().await;
+        if let Err(panic) = result {
+            std::panic::resume_unwind(panic);
+        }
+        let (pli, replayed, age) = result.unwrap();
+        observations.push((action, clean, pli, replayed, age.as_micros()));
+    }
+    println!("canonical_feedback_negative {observations:?}");
+    assert!(
+        observations
+            .iter()
+            .all(|(_, clean, pli, replayed, _)| *clean && !*pli && !*replayed),
+        "wrong or stale source acquired repair/PLI authority"
+    );
+}
