+// Every resource is registered before its first awaited setup operation. A
+// work panic therefore cannot bypass the original controllers/peers/proxy joins.
+struct Harness {
+    policy: Arc<Policy>,
+    routes: Arc<DashMap<ConnectionId, Arc<Route>>>,
+    identity: Arc<()>,
+    owners: Vec<PeerAdmissionOwner>,
+    physical: Vec<Arc<WebRtcPhysicalBinding>>,
+    remote: Vec<Arc<RvoipPeerConnection>>,
+    backends: Vec<Arc<Backend>>,
+    controllers: Vec<Arc<StreamController>>,
+    proxy: Option<Proxy>,
+    input: Option<mpsc::Receiver<MediaPacket>>,
+    source_track: Option<Arc<webrtc::media_stream::track_local::static_rtp::TrackLocalStaticRTP>>,
+    target_track: Option<Arc<dyn TrackRemote>>,
+    observed: Vec<(u32, u16)>,
+    next_sequence: u16,
+    next_timestamp: u32,
+}
+impl Harness {
+    fn new() -> Self {
+        Self {
+            policy: Arc::new(Policy {
+                owners: [
+                    ("alice".into(), owner("alice")),
+                    ("bob".into(), owner("bob")),
+                ]
+                .into(),
+                guard: Arc::new(RwLock::new(())),
+                mode: AtomicUsize::new(0),
+                attempts: AtomicUsize::new(0),
+                original_attempts: AtomicUsize::new(0),
+                grant_until: Mutex::new(None),
+            }),
+            routes: Arc::new(DashMap::new()),
+            identity: Arc::new(()),
+            owners: vec![],
+            physical: vec![],
+            remote: vec![],
+            backends: vec![],
+            controllers: vec![],
+            proxy: None,
+            input: None,
+            source_track: None,
+            target_track: None,
+            observed: vec![],
+            next_sequence: 0,
+            next_timestamp: 0,
+        }
+    }
+    async fn pair(&mut self, name: &str, loss: bool) {
+        let facts = self.policy.owners[name].clone();
+        let principal = principal(name);
+        let cancel = CancellationToken::new();
+        let owner = PeerAdmissionOwner::new(
+            &principal,
+            facts.member.identity().clone(),
+            facts.endpoint.device().clone(),
+            cancel.child_token(),
+            Default::default(),
+        )
+        .unwrap();
+        let physical = WebRtcPhysicalBinding::new(&owner.peer(), cancel.child_token());
+        physical
+            .bind(
+                &owner.peer(),
+                &ConnectionId::from_string(name),
+                cancel.child_token(),
+                &self.identity,
+            )
+            .unwrap();
+        self.owners.push(owner);
+        self.physical.push(physical.clone());
+        let mut config = WebRtcConfig::loopback();
+        config.require_vp8_audio_video_profile = true;
+        physical
+            .start_peer(config.clone(), PeerRole::Offerer)
+            .unwrap();
+        let server = physical.peer(until()).await.unwrap();
+        let client = RvoipPeerConnection::new(&config, PeerRole::Answerer)
+            .await
+            .unwrap();
+        self.remote.push(client.clone());
+        server.add_local_audio_track().await.unwrap();
+        server.add_local_video_track().await.unwrap();
+        let offer = server.create_offer_and_gather().await.unwrap();
+        let answer = if loss {
+            self.proxy = Some(Proxy::new().await);
+            let proxy = self.proxy.as_mut().unwrap();
+            let (offered, server_address) = Proxy::rewrite(&offer, proxy.a.local_addr().unwrap());
+            let answer = client.accept_offer_and_gather(&offered).await.unwrap();
+            let (answered, client_address) = Proxy::rewrite(&answer, proxy.b.local_addr().unwrap());
+            proxy.start(server_address, client_address);
+            answered
+        } else {
+            client.accept_offer_and_gather(&offer).await.unwrap()
+        };
+        server.set_remote_answer(&answer).await.unwrap();
+        tokio::try_join!(
+            server.wait_connected(Duration::from_secs(3)),
+            client.wait_connected(Duration::from_secs(3))
+        )
+        .unwrap();
+        // Fixed genuine negotiation media sequence1 in each direction. No
+        // unrelated missing priming slots or sequence guesses enter the test.
+        prime_exact(&server, &client).await;
+        prime_exact(&client, &server).await;
+        let backend = Backend::new(
+            ConnectionId::from_string(name),
+            physical.clone(),
+            cancel.child_token(),
+            Arc::downgrade(&self.routes),
+        );
+        self.backends.push(backend.clone());
+        let controller = StreamController::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            ConnectionId::from_string(name),
+            principal,
+            self.policy.clone(),
+            backend.clone(),
+            handles(&self.owners.last().unwrap().peer()),
+            8,
+        )
+        .unwrap();
+        self.controllers.push(controller.clone());
+        let route = Arc::new(Route {
+            session: SessionId::from_string("session"),
+            member: facts.member,
+            endpoint: facts.endpoint,
+            installation: Mutex::new(Some(Installation {
+                activation: RtcMediaActivation::new(&controller, &backend),
+                controller: controller.clone(),
+                backend,
+            })),
+            binding: physical,
+            peer: Arc::downgrade(&self.owners.last().unwrap().peer()),
+            cancel,
+        });
+        self.routes.insert(ConnectionId::from_string(name), route);
+        controller
+            .change(
+                controller.revision(),
+                &[desired(Medium::Video)],
+                &BTreeSet::new(),
+                until(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+    }
+    async fn setup(&mut self) {
+        self.pair("alice", false).await;
+        self.pair("bob", true).await;
+        self.controllers[1]
+            .change_direct_subscriptions(
+                self.controllers[1].revision(),
+                DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                    &self.controllers[0],
+                    desired(Medium::Video).logical_id.clone(),
+                    desired(Medium::Video).logical_id,
+                )]),
+                until(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+            .unwrap();
+        self.input = Some(
+            self.controllers[0]
+                .take_ingress(&desired(Medium::Video).logical_id)
+                .unwrap(),
+        );
+        while self.input.as_mut().unwrap().try_recv().is_ok() {}
+        self.source_track = self.remote[0].local_video_track();
+        self.target_track = self.remote[1].discover_remote_video_track().await;
+        let track = self.target_track.as_ref().unwrap();
+        let limit = tokio::time::Instant::now() + Duration::from_millis(100);
+        let mut last = None;
+        loop {
+            match tokio::time::timeout_at(limit, track.poll()).await {
+                Ok(Some(TrackRemoteEvent::OnRtpPacket(packet, _))) => {
+                    last = Some(packet.header.sequence_number)
+                }
+                Err(_) | Ok(None) => break,
+                _ => {}
+            }
+        }
+        while self.input.as_mut().unwrap().try_recv().is_ok() {}
+        self.next_sequence = last
+            .expect("target original negotiation RTP")
+            .wrapping_add(1);
+        self.next_timestamp = u32::from(self.next_sequence) * 3000;
+    }
+    async fn send_key(&mut self) -> (u32, Vec<u16>) {
+        let timestamp = self.next_timestamp;
+        self.next_timestamp = self.next_timestamp.wrapping_add(3000);
+        let source_ssrc = self.remote[0].local_video_ssrc().unwrap();
+        let mut sequences = vec![];
+        for fragment in crate::media::packetize::vp8::packetize_vp8(KEY, 120) {
+            let sequence = self.next_sequence;
+            self.next_sequence = self.next_sequence.wrapping_add(1);
+            sequences.push(sequence);
+            self.source_track
+                .as_ref()
+                .unwrap()
+                .write_rtp(rtc::rtp::Packet {
+                    header: rtc::rtp::Header {
+                        version: 2,
+                        payload_type: 96,
+                        ssrc: source_ssrc,
+                        sequence_number: sequence,
+                        timestamp,
+                        marker: fragment.marker,
+                        ..Default::default()
+                    },
+                    payload: fragment.payload,
+                })
+                .await
+                .unwrap();
+            let packet = tokio::time::timeout_at(until(), self.input.as_mut().unwrap().recv())
+                .await
+                .unwrap()
+                .unwrap();
+            packet
+                .try_forward_to(&self.controllers[1], &desired(Medium::Video).logical_id)
+                .unwrap();
+        }
+        assert!(sequences.len() >= 3);
+        (timestamp, sequences)
+    }
+    async fn collect(
+        &mut self,
+        timestamp: u32,
+        sequences: &[u16],
+        bound: tokio::time::Instant,
+    ) -> Vec<rtc::rtp::Packet> {
+        let mut packets = BTreeMap::new();
+        let track = self.target_track.as_ref().unwrap().clone();
+        while packets.len() < sequences.len() {
+            match tokio::time::timeout_at(bound, track.poll()).await {
+                Ok(Some(TrackRemoteEvent::OnRtpPacket(packet, _))) => {
+                    assert!(self.observed.len() < 128, "bounded original receiver facts");
+                    self.observed
+                        .push((packet.header.timestamp, packet.header.sequence_number));
+                    if packet.header.timestamp == timestamp
+                        && sequences.contains(&packet.header.sequence_number)
+                    {
+                        packets.insert(packet.header.sequence_number, packet);
+                    }
+                }
+                Ok(None) | Err(_) => break,
+                _ => {}
+            }
+        }
+        sequences.iter().filter_map(|n| packets.remove(n)).collect()
+    }
+    async fn drain_hints(&self) {
+        let notice = self.remote[0].video_keyframe_requests();
+        for _ in 0..16 {
+            if tokio::time::timeout(Duration::from_millis(2), notice.notified())
+                .await
+                .is_err()
+            {
+                break;
+            }
+        }
+    }
+    async fn actual_nack(&self, ssrc: u32, sequence: u16) {
+        self.target_track
+            .as_ref()
+            .unwrap()
+            .write_rtcp(vec![Box::new(
+                rtc::rtcp::transport_feedbacks::transport_layer_nack::TransportLayerNack {
+                    sender_ssrc: self.remote[1].local_video_ssrc().unwrap_or(0),
+                    media_ssrc: ssrc,
+                    nacks: vec![
+                        rtc::rtcp::transport_feedbacks::transport_layer_nack::NackPair {
+                            packet_id: sequence,
+                            lost_packets: 0,
+                        },
+                    ],
+                },
+            )])
+            .await
+            .unwrap();
+    }
+    async fn baseline(&mut self) {
+        let (ts, seq) = self.send_key().await;
+        let packets = self.collect(ts, &seq, until()).await;
+        assert_eq!(assemble(&packets), Some(KEY.to_vec()));
+        tokio::time::sleep(Duration::from_millis(300)).await;
+        self.drain_hints().await;
+    }
+    async fn close(&mut self) -> bool {
+        self.policy.mode.store(0, Ordering::SeqCst);
+        let mut clean = true;
+        for backend in &self.backends {
+            clean &= matches!(
+                std::panic::AssertUnwindSafe(backend.close())
+                    .catch_unwind()
+                    .await,
+                Ok(Ok(()))
+            );
+        }
+        for controller in &self.controllers {
+            clean &= matches!(
+                std::panic::AssertUnwindSafe(controller.shutdown(until()))
+                    .catch_unwind()
+                    .await,
+                Ok(0)
+            );
+        }
+        for binding in &self.physical {
+            clean &= matches!(
+                std::panic::AssertUnwindSafe(binding.shutdown())
+                    .catch_unwind()
+                    .await,
+                Ok(Ok(()))
+            );
+        }
+        for client in &self.remote {
+            clean &= matches!(
+                std::panic::AssertUnwindSafe(client.close())
+                    .catch_unwind()
+                    .await,
+                Ok(Ok(()))
+            );
+        }
+        if let Some(proxy) = &mut self.proxy {
+            clean &= matches!(
+                std::panic::AssertUnwindSafe(proxy.close())
+                    .catch_unwind()
+                    .await,
+                Ok(true)
+            );
+        }
+        self.input = None;
+        self.target_track = None;
+        self.source_track = None;
+        self.routes.clear();
+        self.controllers.clear();
+        self.backends.clear();
+        self.physical.clear();
+        self.remote.clear();
+        self.owners.clear();
+        clean && self.policy.guard.clone().try_write_owned().is_ok()
+    }
+}
+fn assemble(packets: &[rtc::rtp::Packet]) -> Option<Vec<u8>> {
+    if packets.len() < 3
+        || packets.first()?.payload.first()? & 0x10 == 0
+        || !packets.last()?.header.marker
+    {
+        return None;
+    }
+    let mut bytes = vec![];
+    for (index, packet) in packets.iter().enumerate() {
+        if packet.payload.is_empty()
+            || packet.payload[0] & 0x80 != 0
+            || index > 0
+                && (packet.payload[0] & 0x10 != 0
+                    || packet.header.sequence_number
+                        != packets[index - 1].header.sequence_number.wrapping_add(1))
+        {
+            return None;
+        }
+        bytes.extend_from_slice(&packet.payload[1..]);
+    }
+    Some(bytes)
+}
+// One actual codec child, after every RTC/Core/proxy owner has drained. No
+// output becomes RTP/decoder timing credit or a renewed permission lifetime.
+async fn decoded_key(bytes: &[u8]) -> (bool, bool) {
+    let mut ivf = b"DKIF\0\0\x20\0VP80".to_vec();
+    ivf.extend(640u16.to_le_bytes());
+    ivf.extend(360u16.to_le_bytes());
+    for n in [90000u32, 1, 1, 0] {
+        ivf.extend(n.to_le_bytes());
+    }
+    ivf.extend((bytes.len() as u32).to_le_bytes());
+    ivf.extend(0u64.to_le_bytes());
+    ivf.extend(bytes);
+    let mut child = tokio::process::Command::new("ffmpeg")
+        .args([
+            "-nostdin",
+            "-hide_banner",
+            "-loglevel",
+            "error",
+            "-f",
+            "ivf",
+            "-i",
+            "pipe:0",
+            "-vf",
+            "crop=16:16:0:0",
+            "-pix_fmt",
+            "yuv420p",
+            "-frames:v",
+            "1",
+            "-f",
+            "rawvideo",
+            "pipe:1",
+        ])
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .unwrap();
+    let cutoff = until();
+    let mut input = child.stdin.take().unwrap();
+    let mut output = child.stdout.take().unwrap();
+    let work = tokio::time::timeout_at(cutoff, input.write_all(&ivf)).await;
+    drop(input);
+    let (status, joined, forced) = match tokio::time::timeout_at(cutoff, child.wait()).await {
+        Ok(Ok(status)) => (Some(status), true, false),
+        Ok(Err(_)) | Err(_) => {
+            // Always attempt the same original child wait after failed/timed
+            // observation. A forced outcome is never a successful codec proof.
+            let _ = child.start_kill();
+            match child.wait().await {
+                Ok(status) => (Some(status), true, true),
+                Err(_) => (None, false, true),
+            }
+        }
+    };
+    if !joined {
+        return (false, false);
+    }
+    let mut pixels = vec![];
+    let read = output.take(385).read_to_end(&mut pixels).await;
+    (
+        joined,
+        !forced
+            && matches!(work, Ok(Ok(())))
+            && status.is_some_and(|v| v.success())
+            && read.is_ok()
+            && pixels.len() == 384,
+    )
+}
