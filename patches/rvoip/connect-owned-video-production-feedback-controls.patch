+#[tokio::test]
+async fn canonical_expired_vp8_fragment_nack_drives_production_feedback_and_fresh_key_recovery() {
+    let mut h = Harness::new();
+    let result = std::panic::AssertUnwindSafe(async {
+        h.setup().await;
+        h.baseline().await;
+        let output_ssrc = h.physical[1]
+            .peer(until())
+            .await
+            .unwrap()
+            .local_video_ssrc()
+            .unwrap();
+        let lost_seq = h.next_sequence.wrapping_add(1);
+        h.proxy.as_ref().unwrap().arm(output_ssrc, lost_seq, true);
+        let (old_ts, old_seq) = h.send_key().await;
+        let lost = h.proxy.as_ref().unwrap().lost().await;
+        h.actual_nack(output_ssrc, lost_seq).await;
+        // All reverse packets remain in the exact original proxy until250ms
+        // after successful original send: beyond both100ms submission and200ms
+        // original Core packet custody. No old budget is renewed.
+        let source_pli =
+            tokio::time::timeout_at(until(), h.remote[0].video_keyframe_requests().notified())
+                .await
+                .is_ok();
+        let age = lost.at.elapsed();
+        let _old = h
+            .collect(
+                old_ts,
+                &old_seq,
+                tokio::time::Instant::now() + Duration::from_millis(10),
+            )
+            .await;
+        let fresh_at = Instant::now();
+        let (fresh_ts, fresh_seq) = h.send_key().await;
+        let fresh = h.collect(fresh_ts, &fresh_seq, until()).await;
+        let fresh_age = fresh_at.elapsed();
+        let state = h.proxy.as_ref().unwrap().state.lock().unwrap();
+        (
+            source_pli,
+            age,
+            h.observed.contains(&(old_ts, lost_seq)),
+            assemble(&fresh),
+            fresh_ts != old_ts,
+            fresh_age,
+            state.feedback_packets_held,
+            state.feedback_packets_released,
+        )
+    })
+    .catch_unwind()
+    .await;
+    let clean = h.close().await;
+    if let Err(panic) = result {
+        std::panic::resume_unwind(panic);
+    }
+    let (pli, age, stale, bytes, new_timestamp, fresh_age, held, released) = result.unwrap();
+    let (codec_joined, codec) = match &bytes {
+        Some(bytes) => decoded_key(bytes).await,
+        None => (true, false),
+    };
+    println!(
+        "canonical_expired_recovery joined={clean} source_pli={pli} original_age_us={} stale_fragment={stale} fresh_rtp_us={} held={held} released={released} codec_joined={codec_joined} codec={codec}",
+        age.as_micros(),
+        fresh_age.as_micros()
+    );
+    assert!(clean && codec_joined);
+    assert!(
+        pli && age >= Duration::from_millis(250) && held > 0 && released == held && !stale,
+        "expired original fragment was replayed or actual production feedback did not reach current source"
+    );
+    assert!(
+        new_timestamp
+            && fresh_age < Duration::from_millis(200)
+            && bytes.as_deref() == Some(KEY)
+            && codec,
+        "fresh source keyframe did not recover actual selected receiver under new original input custody"
+    );
+}
