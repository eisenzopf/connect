+#[tokio::test]
+async fn canonical_owned_vp8_fragment_loss_repairs_before_original_expiry_without_source_pli() {
+    let mut h = Harness::new();
+    let result = std::panic::AssertUnwindSafe(async {
+        h.setup().await;
+        h.baseline().await;
+        let output_ssrc = h.physical[1]
+            .peer(until())
+            .await
+            .unwrap()
+            .local_video_ssrc()
+            .unwrap();
+        let lost_seq = h.next_sequence.wrapping_add(1);
+        h.proxy.as_ref().unwrap().arm(output_ssrc, lost_seq, false);
+        let (ts, seq) = h.send_key().await;
+        let lost = h.proxy.as_ref().unwrap().lost().await;
+        assert_eq!(
+            (lost.ssrc, lost.seq, lost.timestamp),
+            (output_ssrc, lost_seq, ts)
+        );
+        h.actual_nack(output_ssrc, lost_seq).await;
+        let packets = h.collect(ts, &seq, until()).await;
+        let repaired = packets.iter().any(|p| p.header.sequence_number == lost_seq);
+        let repair_arrival_us = lost.at.elapsed().as_micros();
+        let pli = tokio::time::timeout(
+            Duration::from_millis(150),
+            h.remote[0].video_keyframe_requests().notified(),
+        )
+        .await
+        .is_ok();
+        (
+            assemble(&packets),
+            repaired,
+            pli,
+            lost.at.elapsed().as_micros(),
+            repair_arrival_us,
+        )
+    })
+    .catch_unwind()
+    .await;
+    let clean = h.close().await;
+    if let Err(panic) = result {
+        std::panic::resume_unwind(panic);
+    }
+    let (bytes, repaired, pli, elapsed, repair_arrival_us) = result.unwrap();
+    let (codec_joined, codec) = match &bytes {
+        Some(bytes) => decoded_key(bytes).await,
+        None => (true, false),
+    };
+    println!(
+        "canonical_fragment_repair joined={clean} repaired={repaired} source_pli={pli} repair_arrival_us={repair_arrival_us} receive_to_terminal_us={elapsed} codec_joined={codec_joined} codec={codec}"
+    );
+    assert!(clean && codec_joined);
+    assert!(
+        repaired && !pli && bytes.as_deref() == Some(KEY) && codec,
+        "current original fragment did not repair through actual owned RTP without source PLI"
+    );
+}
