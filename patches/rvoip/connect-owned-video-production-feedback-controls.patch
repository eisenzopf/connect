+async fn prime_exact(sender: &Arc<RvoipPeerConnection>, receiver: &Arc<RvoipPeerConnection>) {
+    let until = tokio::time::Instant::now() + Duration::from_secs(3);
+    let writer = sender.outbound_audio_writer().unwrap();
+    let video = sender.local_video_track().unwrap();
+    loop {
+        let (audio, picture) = receiver.remote_media_ready().await;
+        if audio && picture {
+            return;
+        }
+        assert!(
+            tokio::time::Instant::now() < until,
+            "actual negotiation media timed out"
+        );
+        writer
+            .write_audio(
+                crate::peer::builder::OPUS_PAYLOAD_TYPE,
+                0,
+                crate::media::pump::silent_opus_payload(),
+            )
+            .await
+            .unwrap();
+        video
+            .write_rtp(crate::media::pump::silent_vp8_rtp_packet_for_ssrc(
+                sender.local_video_ssrc().unwrap(),
+                1,
+                3000,
+            ))
+            .await
+            .unwrap();
+        tokio::time::sleep(Duration::from_millis(20)).await;
+    }
+}
