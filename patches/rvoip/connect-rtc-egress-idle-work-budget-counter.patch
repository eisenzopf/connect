+                }
+                obs.old_poll_expired_before_worker = Instant::now() >= poll_until;
+                obs.age_ms = queued_at.elapsed().as_millis();
+                obs.delivery = Some(original.result().await);
+            }
+            {
+                let track = if medium == Medium::Audio {
+                    audio.unwrap()
+                } else {
+                    video.unwrap()
+                };
+                let receive_bound = if obs.delivery == Some(Ok(())) {
+                    Duration::from_millis(500)
+                } else {
+                    Duration::from_millis(50)
+                };
+                obs.received_exact = tokio::time::timeout(receive_bound, async {
+                    loop {
+                        match track.poll().await {
+                            Some(TrackRemoteEvent::OnRtpPacket(packet, _))
+                                if packet.header.ssrc == ssrc
+                                    && packet.payload.as_ref() == expected.as_slice() =>
+                            {
+                                break true
+                            }
+                            None | Some(TrackRemoteEvent::OnEnded | TrackRemoteEvent::OnError) => {
+                                break false
+                            }
+                            _ => {}
+                        }
+                    }
+                })
+                .await
+                .unwrap_or(false);
+            }
+        })
+        .catch_unwind()
+        .await;
+        // Every original owner is attempted even if work failed or panicked.
+        drop(submitting.take());
+        drop(held_timeline.take());
+        obs.write_joined = match write.take() {
+            Some(original) => original.cancel_and_drain().await.is_ok(),
+            None => true,
+        };
+        drop(room.take());
+        obs.core_joined = true;
+        for owner in core_owners {
+            obs.core_joined &= owner.shutdown(deadline()).await == 0;
+        }
+        obs.peers_joined = true;
+        for peer in peer_owners {
+            obs.peers_joined &= peer.close().await.is_ok();
+        }
+        println!(
+            "POLL_WORK_BOUNDARY medium={medium:?} case={case:?} observed={obs:?} work_completed={}",
+            work.is_ok()
+        );
+        assert!(
+            obs.write_joined && obs.core_joined && obs.peers_joined,
+            "original cleanup incomplete"
+        );
+        if let Err(panic) = work {
+            std::panic::resume_unwind(panic);
+        }
+        obs
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn canonical_video_idle_poll_does_not_spend_fresh_original_write_budget() {
+        let obs = exercise(Medium::Video, Case::LatePoll).await;
+        assert!(
+            obs.poll_pending
+                && obs.idle_ms >= 70
+                && obs.age_ms < 100
+                && obs.submitted
+                && obs.old_poll_expired_before_worker
+        );
+        assert!(obs.delivery == Some(Ok(())) && obs.received_exact,
+            "fresh video original lost its work budget to idle polling before its original worker could claim");
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn canonical_audio_idle_poll_does_not_spend_fresh_original_write_budget() {
+        let obs = exercise(Medium::Audio, Case::LatePoll).await;
+        assert!(
+            obs.poll_pending
+                && obs.idle_ms >= 70
+                && obs.age_ms < 100
+                && obs.submitted
+                && obs.old_poll_expired_before_worker
+        );
+        assert!(obs.delivery == Some(Ok(())) && obs.received_exact,
+            "fresh audio original lost its work budget to idle polling before its original worker could claim");
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn canonical_poll_keeps_explicit_caller_cutoff_and_never_renews_chosen_work_cutoff() {
+        for medium in [Medium::Audio, Medium::Video] {
+            for case in [Case::Absolute, Case::WorkExpired] {
+                let obs = exercise(medium, case).await;
+                assert!(obs.submitted && obs.old_poll_expired_before_worker,
+                    "original expiry control was not created before the controlled first-poll barrier");
+                assert!(
+                    matches!(
+                        obs.delivery,
+                        Some(Err(
+                            OwnedRtpError::Refused | OwnedRtpError::DeadlineBeforeWrite
+                        ))
+                    ) && !obs.received_exact,
+                    "expired original control was renewed or actual IO became uncertain"
+                );
+            }
+        }
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn canonical_poll_keeps_original_age_and_fresh_revocation_or_cancellation_refusals() {
+        for medium in [Medium::Audio, Medium::Video] {
+            for case in [
+                Case::OriginalAge,
+                Case::Revoked,
+                Case::GrantExpired,
+                Case::Cancelled,
+            ] {
+                let obs = exercise(medium, case).await;
+                if !matches!(case, Case::OriginalAge) {
+                    assert!(
+                        obs.submitted,
+                        "original authority/cancellation control was not created"
+                    );
+                }
+                assert!(
+                    (matches!(
+                        obs.delivery,
+                        Some(Err(
+                            OwnedRtpError::Refused | OwnedRtpError::DeadlineBeforeWrite
+                        ))
+                    ) || matches!(obs.submit_problem, Some(StreamControlError::Deadline)))
+                        && !obs.received_exact,
+                    "stale or refused original entered media IO or became uncertain"
+                );
+            }
+        }
+    }
+    #[tokio::test(flavor = "current_thread")]
+    async fn canonical_video_sequence_owner_wait_spends_the_same_once_chosen_packet_budget() {
+        let obs = exercise(Medium::Video, Case::TimelineBusy).await;
+        assert!(
+            (matches!(obs.submit_problem, Some(StreamControlError::Deadline))
+                || matches!(
+                    obs.delivery,
+                    Some(Err(
+                        OwnedRtpError::Refused | OwnedRtpError::DeadlineBeforeWrite
+                    ))
+                ))
+                && !obs.received_exact,
+            "sequence ownership renewed the original packet budget"
+        );
+    }
+}
