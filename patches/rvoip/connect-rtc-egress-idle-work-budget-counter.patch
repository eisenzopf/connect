+#[cfg(test)]
+pub(crate) enum PollEgressForTest {
+    Audio(crate::media::core_audio::CoreAudioEgress),
+    Video(crate::media::core_video::CoreVideoEgress),
+}
+#[cfg(test)]
+pub(crate) async fn canonical_poll_submission_for_test(
+    output: PollEgressForTest,
+    poll_until: Instant,
+    explicit_caller_cutoff: bool,
+) -> ControlResult<Option<webrtc::media_stream::track_local::owned_rtp::OwnedRtpWrite>> {
+    let mut egress = match output {
+        PollEgressForTest::Audio(output) => Egress::Audio(output),
+        PollEgressForTest::Video(output) => Egress::Video(output),
+    };
+    // This calls the ORIGINAL canonical dispatcher on OLD and fixed alike.
+    // No receipt, frame, clock, authorization or timeout is synthesized here.
+    if explicit_caller_cutoff {
+        match &mut egress {
+            Egress::Audio(output) => output.submit_next(poll_until).await,
+            Egress::Video(output) => output.submit_next(poll_until).await,
+        }
+    } else {
+        egress.submit_next(poll_until).await
+    }
+}
