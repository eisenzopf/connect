diff --git a/crates/webrtc/rvoip-webrtc/src/media/core_refusal.rs b/crates/webrtc/rvoip-webrtc/src/media/core_refusal.rs
new file mode 100644
--- /dev/null
+++ b/crates/webrtc/rvoip-webrtc/src/media/core_refusal.rs
@@ -0,0 +1,73 @@
+//! Exact typed Core error classification before the legacy Refused collapse.
+use rvoip_core::staged_streams::{MediaDeliveryOrigin, StreamControlError};
+use webrtc::media_stream::track_local::owned_rtp::{
+    OwnedRtpControl,
+    diagnostics::{self, RefusalCause, RefusalContext, RefusalMedium, RefusalStage},
+};
+
+pub(super) fn cause(error: &StreamControlError) -> RefusalCause {
+    match error {
+        StreamControlError::Model(_) => RefusalCause::Model,
+        StreamControlError::Unsupported => RefusalCause::Unsupported,
+        StreamControlError::Authority => RefusalCause::Authority,
+        StreamControlError::NotRecipient => RefusalCause::NotRecipient,
+        StreamControlError::Cancelled => RefusalCause::Cancelled,
+        StreamControlError::Deadline => RefusalCause::Deadline,
+        StreamControlError::NotReady => RefusalCause::NotReady,
+        StreamControlError::MetadataBusy => RefusalCause::MetadataBusy,
+        StreamControlError::Backpressure => RefusalCause::Backpressure,
+        StreamControlError::CleanupUnconfirmed => RefusalCause::CleanupUnconfirmed,
+    }
+}
+pub(super) fn record(
+    control: &OwnedRtpControl,
+    stage: RefusalStage,
+    error: &StreamControlError,
+    context: RefusalContext<'_>,
+) {
+    diagnostics::record_refusal(control, stage, cause(error), context);
+}
+pub(super) fn frame_context<'a>(
+    origin: Option<&'a MediaDeliveryOrigin>,
+    medium: RefusalMedium,
+    egress_ssrc: u32,
+    source_timestamp: u32,
+    captured: chrono::DateTime<chrono::Utc>,
+) -> RefusalContext<'a> {
+    RefusalContext {
+        medium,
+        egress_ssrc: Some(egress_ssrc),
+        source_timestamp: Some(source_timestamp),
+        source_connection: origin.map(|o| o.connection.as_str()),
+        source_logical: origin.map(|o| o.logical.as_str()),
+        source_transport: origin.map(|o| o.transport.as_str()),
+        source_generation: origin.map(|o| o.generation),
+        captured_age_us: chrono::Utc::now()
+            .signed_duration_since(captured)
+            .num_microseconds(),
+        ..Default::default()
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn typed_core_failures_remain_distinct_without_raw_model_or_error_text() {
+        for (error, expected) in [
+            (StreamControlError::Unsupported, RefusalCause::Unsupported),
+            (StreamControlError::Authority, RefusalCause::Authority),
+            (StreamControlError::NotRecipient, RefusalCause::NotRecipient),
+            (StreamControlError::Cancelled, RefusalCause::Cancelled),
+            (StreamControlError::Deadline, RefusalCause::Deadline),
+            (StreamControlError::NotReady, RefusalCause::NotReady),
+            (StreamControlError::MetadataBusy, RefusalCause::MetadataBusy),
+            (StreamControlError::Backpressure, RefusalCause::Backpressure),
+            (
+                StreamControlError::CleanupUnconfirmed,
+                RefusalCause::CleanupUnconfirmed,
+            ),
+        ] {
+            assert_eq!(cause(&error), expected);
+        }
+    }
+}
