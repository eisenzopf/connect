+    pub captured_age_us: Option<i64>,
+    pub attempted: Option<bool>,
+    pub written: Option<bool>,
+}
+// One shared budget for all drivers, producers and repairs in THIS process.
+// Failure-only globals avoid a new per-driver owner, allocation or hot lock.
+struct Budget {
+    seen: AtomicU64,
+    emitted: AtomicU64,
+    limit: u64,
+}
+impl Budget {
+    const fn new(limit: u64) -> Self {
+        Self {
+            seen: AtomicU64::new(0),
+            emitted: AtomicU64::new(0),
+            limit,
+        }
+    }
+    fn reserve(&self) -> Option<(u64, u64)> {
+        // Saturating counts never wrap into another first32 window.
+        let old = self
+            .seen
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+                Some(n.saturating_add(1))
+            })
+            .ok()?;
+        if old == u64::MAX {
+            return None;
+        }
+        let count = old + 1;
+        if count > FIRST_FAILURES && !count.is_power_of_two() {
+            return None;
+        }
+        let row = self
+            .emitted
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+                (n < self.limit).then_some(n + 1)
+            })
+            .ok()?
+            + 1;
+        Some((count, row))
+    }
+}
+static BUDGET: Budget = Budget::new(MAX_PROCESS_ROWS);
+fn safe_id(value: Option<&str>) -> Option<&str> {
+    value.filter(|s| {
+        let Some((prefix, uuid)) = s.split_once('_') else {
+            return false;
+        };
+        matches!(prefix, "conn" | "strm")
+            && uuid.len() == 36
+            && uuid.bytes().enumerate().all(|(i, c)| {
+                if matches!(i, 8 | 13 | 18 | 23) {
+                    c == b'-'
+                } else {
+                    c.is_ascii_hexdigit()
+                }
+            })
+    })
+}
+struct Record<'a> {
+    count: u64,
+    row: u64,
+    request: u64,
+    started: bool,
+    pending: bool,
+    remaining_us: u64,
+    context: RefusalContext<'a>,
+}
+fn record<'a>(
+    budget: &Budget,
+    control: &OwnedRtpControl,
+    mut context: RefusalContext<'a>,
+) -> Option<Record<'a>> {
+    let (count, row) = budget.reserve()?;
+    context.source_connection = safe_id(context.source_connection);
+    context.source_logical = safe_id(context.source_logical);
+    context.source_transport = safe_id(context.source_transport);
+    context.captured_age_us = context
+        .captured_age_us
+        .filter(|n| (-300_000_000..=300_000_000).contains(n));
+    Some(Record {
+        count,
+        row,
+        request: control.inner.failure_diagnostic_id(row),
+        started: control.inner.started(),
+        pending: control.inner.pending(),
+        remaining_us: control
+            .deadline()
+            .saturating_duration_since(std::time::Instant::now())
+            .as_micros()
+            .min(1_000_000) as u64,
+        context,
+    })
+}
+/// Call ONLY on an already-established failure. No formatting/clock/atomic on
+/// the successful path. Missing coordinates stay None, never parsed or guessed.
+pub fn record_refusal(
+    control: &OwnedRtpControl,
+    stage: RefusalStage,
+    cause: RefusalCause,
+    context: RefusalContext<'_>,
+) {
+    if !log::log_enabled!(target: TARGET, log::Level::Debug) {
+        return;
+    }
+    let Some(r) = record(&BUDGET, control, context) else {
+        return;
+    };
+    log::debug!(target: TARGET,
+        "Original RTP refusal row={} failure_count={} process={} request={} stage={:?} cause={:?} started={} pending={} remaining_us={} medium={:?} sender={:?} egress_ssrc={:?} argument_ssrc={:?} argument_seq={:?} argument_ts={:?} argument_pt={:?} cached_primary_ssrc={:?} cached_primary_seq={:?} cached_primary_ts={:?} source_ssrc={:?} source_seq={:?} source_ts={:?} source_connection={:?} source_logical={:?} source_transport={:?} source_generation={:?} captured_age_us={:?} attempted={:?} written={:?}",
+        r.row, r.count, std::process::id(), r.request, stage, cause, r.started, r.pending, r.remaining_us,
+        r.context.medium, r.context.sender, r.context.egress_ssrc, r.context.argument_ssrc, r.context.argument_sequence,
+        r.context.argument_timestamp, r.context.argument_payload_type, r.context.cached_primary_ssrc,
+        r.context.cached_primary_sequence, r.context.cached_primary_timestamp, r.context.source_ssrc,
+        r.context.source_sequence, r.context.source_timestamp, r.context.source_connection,
+        r.context.source_logical, r.context.source_transport, r.context.source_generation,
+        r.context.captured_age_us, r.context.attempted, r.context.written);
+}
+pub fn claim_cause(control: &OwnedRtpControl) -> RefusalCause {
+    if std::time::Instant::now() >= control.deadline() {
+        RefusalCause::Deadline
+    } else if !control.current() {
+        RefusalCause::Cancelled
+    } else {
+        RefusalCause::ClaimUnavailable
+    }
+}
+pub fn driver_cause(error: &rtc::shared::error::Error) -> RefusalCause {
+    use rtc::shared::error::Error;
+    match error {
+        Error::ErrConnectionClosed => RefusalCause::ConnectionClosed,
+        Error::ErrRTPTransceiverCodecUnsupported => RefusalCause::CodecUnsupported,
+        Error::ErrSenderWithNoSSRCs => RefusalCause::SenderMissingSsrc,
+        Error::ErrRTPSenderNoBaseEncoding => RefusalCause::SenderMissingEncoding,
+        _ => RefusalCause::OtherDriverError,
+    }
+}
