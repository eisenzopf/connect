+    #[test]
+    fn sampler_uses_first32_and_power_two_without_wrapping() {
+        let b = Budget::new(MAX_PROCESS_ROWS);
+        let got = (1..=130)
+            .filter_map(|_| b.reserve().map(|r| r.0))
+            .collect::<Vec<_>>();
+        assert_eq!(got, (1..=32).chain([64, 128]).collect::<Vec<_>>());
+        b.seen.store(u64::MAX, Ordering::Relaxed);
+        assert!(b.reserve().is_none());
+        assert!(b.reserve().is_none());
+    }
+    #[test]
+    fn shared_failure_budget_has_atomic_hard_cap_across_concurrent_owners() {
+        let b = Arc::new(Budget::new(8));
+        let owners = (0..16)
+            .map(|_| {
+                let b = b.clone();
+                std::thread::spawn(move || {
+                    (0..2048).filter_map(|_| b.reserve()).collect::<Vec<_>>()
+                })
+            })
+            .collect::<Vec<_>>();
+        let joined = owners.into_iter().map(|h| h.join()).collect::<Vec<_>>();
+        let all_joined = joined.iter().all(|r| r.is_ok());
+        let mut rows = joined
+            .into_iter()
+            .filter_map(|r| r.ok())
+            .flatten()
+            .map(|r| r.1)
+            .collect::<Vec<_>>();
+        rows.sort_unstable();
+        assert!(all_joined);
+        assert_eq!(rows, (1..=8).collect::<Vec<_>>());
+        assert_eq!(b.emitted.load(Ordering::Relaxed), 8);
+    }
