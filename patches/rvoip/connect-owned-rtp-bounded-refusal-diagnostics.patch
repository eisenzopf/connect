+#[derive(Clone, Copy, Debug, Default)]
+pub struct RefusalContext<'a> {
+    pub medium: RefusalMedium,
+    pub sender: Option<u64>,
+    /// Producer writer binding, not proof of a submitted or socket packet.
+    pub egress_ssrc: Option<u32>,
+    /// Actual RtpIo::submit ARGUMENT header. Repair input is primary, NOT RTX wire.
+    pub argument_ssrc: Option<u32>,
+    pub argument_sequence: Option<u16>,
+    pub argument_timestamp: Option<u32>,
+    pub argument_payload_type: Option<u8>,
+    pub cached_primary_ssrc: Option<u32>,
