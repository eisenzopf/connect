+    OriginalClaim,
+    InvalidDeferral,
+    EmptySuccess,
+    AudioPacketUnavailable,
+    AudioPrepare,
+    AudioStamp,
+    AudioFinal,
+    AudioFrame,
+    VideoPacketUnavailable,
+    VideoPrepare,
+    VideoFinal,
+    VideoOrigin,
+    VideoPacket,
+    VideoTimeline,
+    VideoIo,
