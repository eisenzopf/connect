+#[tokio::test]
+async fn replacement_preroll_compound_swap_waits_for_original_inflight_private_write() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 60);
+    delivered(&mut f.old_output, 60).await;
+    let queued = outgoing(&mut f.target_output).await;
+    let target = f.movement.room.nodes["device"].controller.clone();
+    let receiver = request().receivers[0].replacement.clone();
+    let private_ticket = target
+        .direct_subscriptions
+        .stamp(
+            &f.movement.room.nodes["bob"].controller,
+            &desired(Medium::Video).logical_id,
+            &receiver,
+            Instant::now(),
+        )
+        .unwrap()
+        .delivery_ticket();
+    let target_ticket = f.movement.room.nodes["device"]
+        .adapter
+        .ports
+        .lock()
+        .unwrap()[&receiver]
+        .0
+        .ticket();
+    let (entered, entered_rx) = tokio::sync::oneshot::channel();
+    let (release, released) = tokio::sync::oneshot::channel();
+    let writing = tokio::spawn(async move {
+        queued
+            .deliver(|_| async move {
+                entered.send(()).unwrap();
+                released.await.unwrap();
+                Ok(())
+            })
+            .await
+    });
+    entered_rx.await.unwrap();
+    let plan = f.movement.plan_with_video(Some(request())).unwrap();
+    let grant = f
+        .movement
+        .room
+        .grant(Approval::Audience(plan.audience().clone()))
+        .await;
+    let scene = f.movement.room.scene.clone();
+    let committing = tokio::spawn(async move {
+        scene
+            .commit_audio_device_replacement(plan, deadline(), CancellationToken::new(), &grant)
+            .await
+    });
+    tokio::time::timeout(Duration::from_millis(100), async {
+        while target_ticket.is_active() && private_ticket.is_active() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(
+        !committing.is_finished(),
+        "compound swap published while original private write was in flight"
+    );
+    assert!(
+        !f.movement.room.nodes["alice"]
+            .controller
+            .shutdown
+            .is_cancelled()
+    );
+    release.send(()).unwrap();
+    writing.await.unwrap().unwrap();
+    let (_, handle) = committing.await.unwrap().unwrap();
+    assert!(!private_ticket.is_current());
+    assert!(!prepared.is_current());
+    assert!(
+        f.movement.room.nodes["alice"]
+            .controller
+            .shutdown
+            .is_cancelled()
+    );
+    prepared.close();
+    assert!(!target.shutdown.is_cancelled());
+    f.publish_video("bob", 61);
+    delivered(&mut f.target_output, 61).await;
+    f.publish_video("device", 62);
+    delivered(&mut f.bob_output, 62).await;
+    assert_eq!(
+        handle.finish_local_media_cleanup(deadline()).await,
+        ReplacementCleanupOutcome::LocalMediaClosed
+    );
+}
