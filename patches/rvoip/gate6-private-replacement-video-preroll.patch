+//! Receive-only preparation retains the old selection and its delivery fence.
+//! It never enters the new connection's saved public subscription programme.
+use super::*;
+use crate::staged_streams::device_replacement::{video::VideoPlan, ReplacementVideoRequest};
+
+pub(super) struct PrerollBinding {
+    original: DirectStamp,
+    source: Weak<Port>,
+    source_ticket: PeerRouteTicket,
+    target: Weak<Port>,
+    target_ticket: PeerRouteTicket,
+    cancel: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl PrerollBinding {
+    pub(super) fn is_current(&self) -> bool {
+        !self.cancel.is_cancelled()
+            && tokio::time::Instant::now() < self.deadline
+            && self.original.is_current()
+            && self.source.upgrade().is_some()
+            && self.target.upgrade().is_some()
+            && self.source_ticket.is_current()
+            && self.target_ticket.is_current()
+    }
+    pub(super) fn begin(&self) -> ControlResult<PeerDeliveryGuard> {
+        if !self.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        // Keep the original selection fenced through the actual target write.
+        // An unsubscribe must drain these writes before it publishes retirement.
+        let held = self
+            .original
+            .ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)?;
+        if !self.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(held)
+    }
+}
+
+/// A sealed route owner. Descriptors are metadata, not retained permission.
+/// Dropping it retires only these private routes, including queued packets.
+pub struct VideoReplacementPreparation {
+    gate: Weak<DirectGate>,
+    routes: BTreeMap<StreamId, Arc<Route>>,
+    sources: Vec<MediaSource>,
+    cancel: CancellationToken,
+}
+impl VideoReplacementPreparation {
+    pub fn sources(&self) -> &[MediaSource] {
+        &self.sources
+    }
+    pub fn permits(&self, source: &MediaSource) -> bool {
+        self.is_current()
+            && self.sources.iter().any(|s| {
+                s.conversation == source.conversation
+                    && s.session == source.session
+                    && s.connection == source.connection
+                    && s.participant == source.participant
+                    && s.membership_epoch == source.membership_epoch
+                    && s.connection_generation == source.connection_generation
+                    && s.logical_id == source.logical_id
+                    && s.transport_id == source.transport_id
+                    && s.stream_generation == source.stream_generation
+            })
+    }
+
+    pub fn cancellation(&self) -> CancellationToken {
+        self.cancel.child_token()
+    }
+    /// Retires only the temporary copy; the installed replacement remains live.
+    pub fn close(&self) {
+        self.cancel.cancel();
+        for route in self.routes.values() {
+            route.ticket.retire_if_current();
+        }
+        if let Some(gate) = self.gate.upgrade() {
+            let mut state = gate.routing.lock().unwrap_or_else(|p| p.into_inner());
+            state.preparation.retain(|id, route| {
+                !self
+                    .routes
+                    .get(id)
+                    .is_some_and(|original| Arc::ptr_eq(route, original))
+            });
+        }
+    }
+    pub fn is_current(&self) -> bool {
+        self.gate
+            .upgrade()
+            .is_some_and(|gate| !gate.cancel.is_cancelled())
+            && !self.cancel.is_cancelled()
+            && !self.routes.is_empty()
+            && self.routes.values().all(|route| {
+                route.ticket.is_current()
+                    && route.preparation.as_ref().is_some_and(|p| p.is_current())
+            })
+    }
+}
+impl Drop for VideoReplacementPreparation {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+impl StreamController {
+    pub(crate) fn prepare_replacement_video(
+        self: &Arc<Self>,
+        old: &Arc<Self>,
+        request: &ReplacementVideoRequest,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<VideoReplacementPreparation> {
+        if request.receivers.is_empty()
+            || Arc::ptr_eq(self, old)
+            || self.conversation != old.conversation
+            || self.session != old.session
+            || !Arc::ptr_eq(&self.policy, &old.policy)
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        // Owning this preparation never owns cancellation of its caller.
+        let cancel = cancel.child_token();
+        let expected = self.revision();
+        let credential = self.credential_snapshot();
+        let scope = self.scope(&credential.principal, MediaPurpose::Control);
+        let control = self.policy.current_control(
+            &scope,
+            &MediaControlIntent::PrepareReplacementVideo {
+                source: &old.connection,
+                expected,
+                request,
+            },
+            held,
+        )?;
+        let deadline = deadline.min(control.deadline);
+        control.valid()?;
+        if cancel.is_cancelled() || tokio::time::Instant::now() >= deadline {
+            return Err(StreamControlError::Cancelled);
+        }
+        // This checks both original and replacement logical video directions,
+        // current binding generations, muted target inputs and explicit mapping.
+        let plan = VideoPlan::prepare(old, self, request)?;
+        let change = DirectSubscriptionChange::Subscribe(plan.incoming.clone());
+        let state = self
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if state.closed || state.model.revision() != expected {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let owner = control.authority()?;
+        Self::check(&scope, &owner)?;
+        state.model.authorize_binding(&owner.current())?;
+        if !owner.may_control {
+            return Err(StreamControlError::Authority);
+        }
+        let _receive = self.validate_direct(&state, &scope, &change, Some(&control), None)?;
+        let mut routes = BTreeMap::new();
+        let mut sources = Vec::new();
+        for selection in plan.incoming {
+            let publisher = selection.publisher().ok_or(StreamControlError::NotReady)?;
+            let previous = request
+                .receivers
+                .iter()
+                .find(|m| m.replacement == selection.receiver)
+                .ok_or(StreamControlError::Authority)?;
+            let original = old.direct_subscriptions.stamp(
+                &publisher,
+                &selection.source.logical,
+                &previous.previous,
+                Instant::now(),
+            )?;
+            // Private preparations cannot be chained to extend a revoked root.
+            if original.preparation.is_some() {
+                return Err(StreamControlError::Authority);
+            }
+            let source_state = publisher
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::NotReady)?;
+            let source = Self::direct_port(&source_state, &selection.source.logical)?;
+            let binding = &source.binding;
+            sources.push(MediaSource {
+                conversation: publisher.conversation.clone(),
+                session: publisher.session.clone(),
+                connection: publisher.connection.clone(),
+                participant: publisher.origin_member.participant().clone(),
+                membership_epoch: publisher.origin_member.epoch(),
+                connection_generation: binding.connection_generation,
+                logical_id: selection.source.logical.clone(),
+                transport_id: binding.transport_id.clone(),
+                stream_generation: binding.generation,
+            });
+            let source_port = Arc::downgrade(source);
+            let source_ticket = source.ticket();
+            let target_port = Self::direct_port(&state, &selection.receiver)?;
+            let target = Arc::downgrade(target_port);
+            let target_ticket = target_port.ticket();
+            drop(source_state);
+            routes.insert(
+                selection.receiver.clone(),
+                Arc::new(Route {
+                    feedback: Arc::new(super::super::video_feedback::FeedbackCache::default()),
+                    selection,
+                    ticket: PeerRouteTicket::initial(),
+                    started: Instant::now(),
+                    preparation: Some(Arc::new(PrerollBinding {
+                        original,
+                        source: source_port,
+                        source_ticket,
+                        target,
+                        target_ticket,
+                        cancel: cancel.clone(),
+                        deadline,
+                    })),
+                }),
+            );
+        }
+        let mut routing = self
+            .direct_subscriptions
+            .routing
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if !routing.program.is_empty()
+            || !routing.preparation.is_empty()
+            || self.direct_subscriptions.cancel.is_cancelled()
+            || self.shutdown.is_cancelled()
+            || old.shutdown.is_cancelled()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        control.valid()?;
+        self.check_credential_snapshot(&credential)?;
+        if routes
+            .values()
+            .any(|r| !r.preparation.as_ref().unwrap().is_current())
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        routing.preparation = routes.clone();
+        Ok(VideoReplacementPreparation {
+            gate: Arc::downgrade(&self.direct_subscriptions),
+            routes,
+            sources,
+            cancel,
+        })
+    }
+}
