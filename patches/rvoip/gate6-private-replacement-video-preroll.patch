+#[tokio::test]
+async fn replacement_preroll_source_or_target_transport_replacement_invalidates_readiness_descriptors()
+ {
+    for name in ["bob", "device"] {
+        let mut f = Preroll::new().await;
+        let prepared = f.prepare(CancellationToken::new()).await;
+        f.publish_video("bob", 40);
+        let queued = outgoing(&mut f.target_output).await;
+        delivered(&mut f.old_output, 40).await;
+        let controller = f.movement.room.nodes[name].controller.clone();
+        let logical = if name == "bob" {
+            desired(Medium::Video).logical_id
+        } else {
+            request().receivers[0].replacement.clone()
+        };
+        let before = controller
+            .active_bindings()
+            .into_iter()
+            .find(|binding| binding.negotiated.requested.logical_id == logical)
+            .unwrap();
+        let media = controller
+            .active_bindings()
+            .into_iter()
+            .map(|binding| binding.negotiated.requested)
+            .collect::<Vec<_>>();
+        controller
+            .change(
+                controller.revision(),
+                &media,
+                &BTreeSet::from([logical.clone()]),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        let after = controller
+            .active_bindings()
+            .into_iter()
+            .find(|binding| binding.negotiated.requested.logical_id == logical)
+            .unwrap();
+        assert_ne!(after.transport_id, before.transport_id);
+        assert!(after.generation > before.generation);
+        assert!(
+            !prepared.is_current(),
+            "{name} new transport borrowed the original readiness descriptor"
+        );
+        assert!(
+            queued
+                .deliver(|_| async { panic!("queued old-generation preparation delivered") })
+                .await
+                .is_err()
+        );
+        assert!(
+            !f.movement.room.nodes["alice"]
+                .controller
+                .shutdown
+                .is_cancelled()
+        );
+    }
+}
