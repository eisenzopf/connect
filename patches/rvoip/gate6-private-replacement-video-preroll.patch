+#[tokio::test]
+async fn replacement_preroll_commits_through_existing_compound_swap_and_close_keeps_target_running()
+{
+    let mut f = Preroll::new().await;
+    let cancellation = CancellationToken::new();
+    let prepared = f.prepare(cancellation.clone()).await;
+    f.publish_video("bob", 50);
+    delivered(&mut f.old_output, 50).await;
+    delivered(&mut f.target_output, 50).await;
+    f.assert_target_quarantined();
+    let target = f.movement.room.nodes["device"].controller.clone();
+    let original_bindings = bindings(&target);
+    let plan = f.movement.plan_with_video(Some(request())).unwrap();
+    let (_, handle) = f.movement.commit(plan).await.unwrap();
+    assert!(
+        f.movement.room.nodes["alice"]
+            .controller
+            .shutdown
+            .is_cancelled()
+    );
+    assert!(!prepared.is_current());
+    assert_eq!(target.direct_subscriptions.saved_selections().len(), 1);
+    assert_eq!(
+        bindings(&target),
+        original_bindings,
+        "commit rebuilt prepared target resources"
+    );
+    prepared.close();
+    drop(prepared);
+    assert!(!cancellation.is_cancelled());
+    assert!(
+        !target.shutdown.is_cancelled(),
+        "private route cleanup retired admitted target"
+    );
+    f.publish_video("bob", 51);
+    delivered(&mut f.target_output, 51).await;
+    f.publish_video("device", 52);
+    delivered(&mut f.bob_output, 52).await;
+    f.movement.room.publish("device", 5200).unwrap();
+    f.movement.room.tick();
+    f.movement.room.heard("bob", 5200).await;
+    f.movement.room.heard("public", 5200).await;
+    assert_eq!(
+        handle.finish_local_media_cleanup(deadline()).await,
+        ReplacementCleanupOutcome::LocalMediaClosed
+    );
+}
