+#[tokio::test]
+async fn replacement_preroll_cancel_and_drop_fence_original_queued_private_frames_only() {
+    for mode in ["cancel", "drop"] {
+        let mut f = Preroll::new().await;
+        let cancellation = CancellationToken::new();
+        let prepared = f.prepare(cancellation.clone()).await;
+        f.publish_video("bob", 20);
+        let queued = outgoing(&mut f.target_output).await;
+        if mode == "cancel" {
+            cancellation.cancel();
+            assert!(!prepared.is_current());
+        }
+        drop(prepared);
+        if mode == "drop" {
+            assert!(!cancellation.is_cancelled());
+        }
+        assert!(
+            queued
+                .deliver(|_| async { panic!("retired private frame reached sink") })
+                .await
+                .is_err()
+        );
+        delivered(&mut f.old_output, 20).await;
+        f.publish_video("bob", 21);
+        delivered(&mut f.old_output, 21).await;
+        assert!(f.target_output.try_recv().is_err());
+        f.assert_target_quarantined();
+        assert!(
+            !f.movement.room.nodes["alice"]
+                .controller
+                .shutdown
+                .is_cancelled()
+        );
+    }
+}
