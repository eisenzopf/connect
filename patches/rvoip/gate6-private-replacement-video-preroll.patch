+#[tokio::test]
+async fn replacement_preroll_original_unsubscribe_retires_queued_copies_and_cannot_be_resurrected()
+{
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 30);
+    let queued = outgoing(&mut f.target_output).await;
+    let old_queued = outgoing(&mut f.old_output).await;
+    let old = f.movement.room.nodes["alice"].controller.clone();
+    let logical = desired(Medium::Video).logical_id;
+    old.change_direct_subscriptions(
+        old.revision(),
+        DirectSubscriptionChange::Unsubscribe(vec![logical.clone()]),
+        deadline(),
+        CancellationToken::new(),
+        None,
+    )
+    .await
+    .unwrap();
+    assert!(!prepared.is_current());
+    assert!(
+        queued
+            .deliver(|_| async { panic!("unsubscribed private source delivered") })
+            .await
+            .is_err()
+    );
+    assert!(
+        old_queued
+            .deliver(|_| async { panic!("unsubscribed original source delivered") })
+            .await
+            .is_err()
+    );
+    old.change_direct_subscriptions(
+        old.revision(),
+        DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+            &f.movement.room.nodes["bob"].controller,
+            logical.clone(),
+            logical,
+        )]),
+        deadline(),
+        CancellationToken::new(),
+        None,
+    )
+    .await
+    .unwrap();
+    assert!(
+        !prepared.is_current(),
+        "new subscription borrowed a retired preparation fence"
+    );
+    f.publish_video("bob", 31);
+    delivered(&mut f.old_output, 31).await;
+    assert!(f.target_output.try_recv().is_err());
+    f.assert_target_quarantined();
+}
