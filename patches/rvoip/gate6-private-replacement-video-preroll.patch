+#[tokio::test]
+async fn replacement_preroll_copies_only_existing_selected_video_and_keeps_old_audio_and_video_live()
+ {
+    let mut f = Preroll::new().await;
+    let cancellation = CancellationToken::new();
+    let prepared = f.prepare(cancellation.clone()).await;
+    assert!(prepared.is_current());
+    assert_eq!(prepared.sources().len(), 1);
+    let descriptor = &prepared.sources()[0];
+    let bob = f.movement.room.nodes["bob"].adapter.port(Medium::Video);
+    assert_eq!(descriptor.connection, ConnectionId::from_string("bob"));
+    assert_eq!(
+        descriptor.logical_id,
+        bob.binding().negotiated.requested.logical_id
+    );
+    assert_eq!(descriptor.transport_id, bob.binding().transport_id);
+    assert_eq!(descriptor.stream_generation, bob.binding().generation);
+    assert!(prepared.permits(descriptor));
+    let mut wrong = descriptor.clone();
+    wrong.stream_generation += 1;
+    assert!(!prepared.permits(&wrong));
+    let mut wrong = descriptor.clone();
+    wrong.transport_id = StreamId::new();
+    assert!(!prepared.permits(&wrong));
+    let mut wrong = descriptor.clone();
+    wrong.connection_generation += 1;
+    assert!(!prepared.permits(&wrong));
+    f.assert_target_quarantined();
+    f.publish_video("bob", 10);
+    delivered(&mut f.old_output, 10).await;
+    delivered(&mut f.target_output, 10).await;
+    f.publish_video("alice", 11);
+    delivered(&mut f.bob_output, 11).await;
+    assert!(
+        f.target_output.try_recv().is_err(),
+        "preparation selected a new publisher"
+    );
+    f.movement.room.publish("alice", 800).unwrap();
+    f.movement.room.tick();
+    f.movement.room.heard("bob", 800).await;
+    f.movement.room.heard("public", 800).await;
+    assert!(
+        !f.movement.room.nodes["alice"]
+            .controller
+            .shutdown
+            .is_cancelled()
+    );
+    prepared.close();
+    assert!(
+        !cancellation.is_cancelled(),
+        "private close cancelled the original replacement owner"
+    );
+    assert!(!prepared.is_current());
+    f.assert_target_quarantined();
+    f.publish_video("bob", 12);
+    delivered(&mut f.old_output, 12).await;
+    assert!(
+        f.target_output.try_recv().is_err(),
+        "closed private route still queues video"
+    );
+}
