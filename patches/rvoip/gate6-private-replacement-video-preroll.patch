+    movement: Move,
+    old_output: mpsc::Receiver<QueuedMedia>,
+    target_output: mpsc::Receiver<QueuedMedia>,
+    bob_output: mpsc::Receiver<QueuedMedia>,
+}
+
+impl Preroll {
+    async fn new() -> Self {
+        let mut camera = desired(Medium::Video);
+        camera.direction = StreamDirection::Receive;
+        let mut receiver = desired(Medium::Video);
+        receiver.logical_id = request().receivers[0].replacement.clone();
+        receiver.direction = StreamDirection::Send;
+        let mut movement = Move::with_media(
+            false,
+            "alice",
+            false,
+            vec![desired(Medium::Audio), camera, receiver.clone()],
+        )
+        .await;
+        for name in ["alice", "bob", "public"] {
+            let controller = &movement.room.nodes[name].controller;
+            controller
+                .change(
+                    controller.revision(),
+                    &[desired(Medium::Audio), desired(Medium::Video)],
+                    &BTreeSet::new(),
+                    deadline(),
+                    CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+        }
+        let old = &movement.room.nodes["alice"].controller;
+        let bob = &movement.room.nodes["bob"].controller;
+        let public = &movement.room.nodes["public"].controller;
+        for (receiver, publisher) in [(old, bob), (bob, old), (public, old)] {
+            receiver
+                .change_direct_subscriptions(
+                    receiver.revision(),
+                    DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                        publisher,
+                        desired(Medium::Video).logical_id,
+                        desired(Medium::Video).logical_id,
+                    )]),
+                    deadline(),
+                    CancellationToken::new(),
+                    None,
+                )
+                .await
+                .unwrap();
+        }
+        let old_output = movement.room.nodes["alice"]
+            .adapter
+            .port(Medium::Video)
+            .take_egress()
+            .unwrap();
+        let bob_output = movement.room.nodes["bob"]
+            .adapter
+            .port(Medium::Video)
+            .take_egress()
+            .unwrap();
+        let target_output = movement.room.nodes["device"].adapter.ports.lock().unwrap()
+            [&receiver.logical_id]
+            .take_egress()
+            .unwrap();
+        movement.io().await;
+        movement.confirm().await;
+        Self {
+            movement,
+            old_output,
+            target_output,
+            bob_output,
+        }
+    }
+
+    async fn prepare(&self, cancellation: CancellationToken) -> VideoReplacementPreparation {
+        let old = &self.movement.room.nodes["alice"].controller;
+        let target = &self.movement.room.nodes["device"].controller;
+        let grant = self
+            .movement
+            .room
+            .grant(Approval::PrepareVideo {
+                source: old.connection.clone(),
+                connection: target.connection.clone(),
+                expected: target.revision(),
+                request: request(),
+            })
+            .await;
+        target
+            .prepare_replacement_video(old, &request(), deadline(), cancellation, &grant)
+            .unwrap()
+    }
+
+    fn publish_video(&self, name: &str, sequence: u32) {
+        let port = self.movement.room.nodes[name].adapter.port(Medium::Video);
+        port.try_publish(&frame(&port, sequence)).unwrap();
+        self.movement.room.tick();
+    }
+
+    fn assert_target_quarantined(&self) {
+        let target = &self.movement.room.nodes["device"];
+        assert!(
+            target
+                .controller
+                .direct_subscriptions
+                .saved_selections()
+                .is_empty()
+        );
+        let camera = target.adapter.port(Medium::Video);
+        assert!(
+            camera.try_publish(&frame(&camera, 99)).is_err(),
+            "private preparation opened camera input"
+        );
+        assert!(
+            target.controller.state.lock().unwrap().model.streams()
+                [&desired(Medium::Video).logical_id]
+                .source_muted
+        );
+    }
+}
+
+async fn delivered(output: &mut mpsc::Receiver<QueuedMedia>, timestamp: u32) {
+    outgoing(output)
+        .await
+        .deliver(|frame| async move {
+            assert_eq!(frame.timestamp_rtp, timestamp);
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
