+#[tokio::test]
+async fn replacement_preroll_original_unsubscribe_drains_a_real_inflight_private_write() {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 35);
+    delivered(&mut f.old_output, 35).await;
+    let queued = outgoing(&mut f.target_output).await;
+    let (entered, entered_rx) = tokio::sync::oneshot::channel();
+    let (release, released) = tokio::sync::oneshot::channel();
+    let writing = tokio::spawn(async move {
+        queued
+            .deliver(|_| async move {
+                entered.send(()).unwrap();
+                released.await.unwrap();
+                Ok(())
+            })
+            .await
+    });
+    entered_rx.await.unwrap();
+    let old = f.movement.room.nodes["alice"].controller.clone();
+    let original = old
+        .direct_subscriptions
+        .stamp(
+            &f.movement.room.nodes["bob"].controller,
+            &desired(Medium::Video).logical_id,
+            &desired(Medium::Video).logical_id,
+            Instant::now(),
+        )
+        .unwrap()
+        .delivery_ticket();
+    let unsubscribing = tokio::spawn(async move {
+        old.change_direct_subscriptions(
+            old.revision(),
+            DirectSubscriptionChange::Unsubscribe(vec![desired(Medium::Video).logical_id]),
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+    });
+    // Wait for the original selection's delivery pause, then prove that its
+    // mutation cannot finish while an actual private sink write still owns it.
+    tokio::time::timeout(Duration::from_millis(100), async {
+        while original.is_active() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(
+        !unsubscribing.is_finished(),
+        "unsubscribe published before private write drained"
+    );
+    release.send(()).unwrap();
+    writing.await.unwrap().unwrap();
+    unsubscribing.await.unwrap().unwrap();
+    assert!(!prepared.is_current());
+    f.publish_video("bob", 36);
+    assert!(f.old_output.try_recv().is_err());
+    assert!(f.target_output.try_recv().is_err());
+}
