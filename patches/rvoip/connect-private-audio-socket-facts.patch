+            );
+            value.socket_result(slot, Some(29));
+            value.clock_result(slot, Some(true));
+        }
+        assert!(
+            value
+                .begin(
+                    packet(bytes::Bytes::from_static(&[1]), 9),
+                    "t".into(),
+                    sender,
+                    29
+                )
+                .is_none()
+        );
+        assert_eq!(value.facts.len(), MAX_PACKETS);
+        assert_eq!(value.omitted, 1);
+        assert!(
+            value
+                .begin(
+                    packet(bytes::Bytes::from_static(&[1]), 10),
+                    "foreign-track".into(),
+                    sender,
+                    29
+                )
+                .is_none()
+        );
+        assert!(value.owner_unknown);
+        value.close_observed();
+        assert_eq!(report(&value)["complete"], false);
+        let mut bytes = AudioFacts::enabled(true);
+        for index in 0..700 {
+            let _ = bytes.begin(
+                packet(bytes::Bytes::from(vec![42; 1600]), index),
+                "t".into(),
+                sender,
+                1628,
+            );
+        }
+        assert!(bytes.payload_bytes <= MAX_PAYLOAD_BYTES && bytes.omitted > 0);
+        assert!(bytes.facts.iter().all(|v| v.payload.len() == 1600));
