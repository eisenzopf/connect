+        assert_eq!(ACTIVE.load(Ordering::Acquire), MAX_OWNERS);
+        let omitted = AudioFacts::enabled(true);
+        assert!(omitted.slot.is_none());
+        drop(omitted);
+        assert_eq!(ACTIVE.load(Ordering::Acquire), MAX_OWNERS);
+        drop(owners);
+        assert_eq!(ACTIVE.load(Ordering::Acquire), 0);
+        let mut next = AudioFacts::enabled(true);
+        let slot = next.begin(
+            packet(bytes::Bytes::from_static(&[1]), 1),
+            "t".into(),
+            RTCRtpSenderId::default(),
+            29,
