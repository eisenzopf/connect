+                )
+                .is_none()
+        );
+        assert_eq!(disabled.facts.capacity(), 0);
+        assert_eq!(disabled.attempts, 0);
+        let mut value = AudioFacts::enabled(true);
+        for index in 0..MAX_PACKETS {
+            let slot = value.begin(
+                packet(bytes::Bytes::from_static(&[1]), index as u16),
+                "t".into(),
+                sender,
