+#[cfg(test)]
+mod av_sync_identity_tests {
+    use super::*;
+    #[tokio::test]
+    async fn local_audio_video_sdp_shares_one_private_per_peer_sync_identity() {
+        let config = WebRtcConfig::loopback();
+        let mut identities = std::collections::HashSet::new();
+        for video_first in [false, true] {
+            let peer = RvoipPeerConnection::new(&config, PeerRole::Offerer)
+                .await
+                .unwrap();
+            if video_first {
+                peer.add_local_video_track().await.unwrap();
+            }
+            peer.add_local_audio_track().await.unwrap();
+            peer.add_local_video_track().await.unwrap();
+            let first = sdp_to_string(&peer.pc.create_offer(None).await.unwrap()).unwrap();
+            let second = sdp_to_string(&peer.pc.create_offer(None).await.unwrap()).unwrap();
+            // Close the actual peer before asserting; no UDP owner survives a failure.
+            peer.close().await.unwrap();
+            let cname_set = |sdp: &str| -> std::collections::HashSet<String> {
+                sdp.lines()
+                    .filter(|line| line.starts_with("a=ssrc:"))
+                    .filter_map(|line| {
+                        line.split_once(" cname:")
+                            .map(|(_, cname)| cname.trim().to_owned())
+                    })
+                    .collect()
+            };
+            assert_eq!(
+                first
+                    .lines()
+                    .filter(|line| line.starts_with("m=audio "))
+                    .count(),
+                1
+            );
+            assert_eq!(
+                first
+                    .lines()
+                    .filter(|line| line.starts_with("m=video "))
+                    .count(),
+                1
+            );
+            let names = cname_set(&first);
+            assert_eq!(
+                names.len(),
+                1,
+                "audio and video must identify one synchronization source group"
+            );
+            assert_eq!(
+                names,
+                cname_set(&second),
+                "offer generation must retain the peer identity"
+            );
+            let name = names.into_iter().next().unwrap();
+            assert!(name.starts_with("rvoip-stream-"));
+            assert_eq!(name.len(), "rvoip-stream-".len() + 32);
+            assert!(
+                identities.insert(name),
+                "independent peers must not share a fixed CNAME"
+            );
+            let track_ids: std::collections::HashSet<_> = first
+                .lines()
+                .filter_map(|line| line.strip_prefix("a=msid:"))
+                .filter_map(|line| line.split_whitespace().nth(1))
+                .collect();
+            assert_eq!(
+                track_ids.len(),
+                2,
+                "audio/video track identity remains distinct"
+            );
+        }
+    }
+}
