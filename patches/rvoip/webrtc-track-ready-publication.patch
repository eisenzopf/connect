+//! The actual asynchronous driver must publish a ready track after its callback.
+use super::*;
+use crate::media_stream::track_local::{TrackLocal, static_rtp::TrackLocalStaticRTP};
+use crate::peer_connection::{PeerConnection, PeerConnectionBuilder, PeerConnectionEventHandler};
+use rtc::peer_connection::configuration::media_engine::MediaEngine;
+use rtc::rtp_transceiver::rtp_sender::{
+    RTCRtpCodec, RTCRtpCodecParameters, RTCRtpCodingParameters, RTCRtpEncodingParameters,
+    RtpCodecKind,
+};
+use tokio::sync::{Notify, mpsc};
+use tokio::time::timeout;
+
+struct Handler {
+    gather: mpsc::Sender<()>,
+    opened: Option<mpsc::Sender<(Arc<dyn TrackRemote>, Vec<u32>, Option<RTCRtpCodec>)>>,
+    release: Arc<Notify>,
+}
+#[async_trait::async_trait]
+impl PeerConnectionEventHandler for Handler {
+    async fn on_ice_gathering_state_change(&self, state: RTCIceGatheringState) {
+        if state == RTCIceGatheringState::Complete {
+            let _ = self.gather.try_send(());
+        }
+    }
+    async fn on_track(&self, track: Arc<dyn TrackRemote>) {
+        if let Some(tx) = &self.opened {
+            let ssrcs = track.ssrcs().await;
+            let codec = if let Some(ssrc) = ssrcs.first() {
+                track.codec(*ssrc).await
+            } else {
+                None
+            };
+            tx.send((track, ssrcs, codec)).await.unwrap();
+            // Force the exact publication interval: another task queries receivers
+            // while the application callback is still initializing provenance.
+            self.release.notified().await;
+        }
+    }
+}
+fn media(codec: &RTCRtpCodecParameters, kind: RtpCodecKind) -> MediaEngine {
+    let mut m = MediaEngine::default();
+    m.register_codec(codec.clone(), kind).unwrap();
+    m
+}
+async fn exercise(kind: RtpCodecKind, mime: &str, rate: u32, pt: u8) {
+    let codec = RTCRtpCodecParameters {
+        rtp_codec: RTCRtpCodec {
+            mime_type: mime.into(),
+            clock_rate: rate,
+            ..Default::default()
+        },
+        payload_type: pt,
+    };
+    let (ag, mut agr) = mpsc::channel(1);
+    let (bg, mut bgr) = mpsc::channel(1);
+    let (opened, mut opened_rx) = mpsc::channel(1);
+    let release = Arc::new(Notify::new());
+    let a = PeerConnectionBuilder::new()
+        .with_media_engine(media(&codec, kind))
+        .with_handler(Arc::new(Handler {
+            gather: ag,
+            opened: None,
+            release: release.clone(),
+        }))
+        .with_udp_addrs(vec!["127.0.0.1:0"])
+        .build()
+        .await
+        .unwrap();
+    let b = PeerConnectionBuilder::new()
+        .with_media_engine(media(&codec, kind))
+        .with_handler(Arc::new(Handler {
+            gather: bg,
+            opened: Some(opened),
+            release: release.clone(),
+        }))
+        .with_udp_addrs(vec!["127.0.0.1:0"])
+        .build()
+        .await
+        .unwrap();
+    let ssrc = 12345;
+    let local = Arc::new(TrackLocalStaticRTP::new(MediaStreamTrack::new(
+        "s".into(),
+        "t".into(),
+        "ready".into(),
+        kind,
+        vec![RTCRtpEncodingParameters {
+            rtp_coding_parameters: RTCRtpCodingParameters {
+                ssrc: Some(ssrc),
+                ..Default::default()
+            },
+            codec: codec.rtp_codec.clone(),
+            ..Default::default()
+        }],
+    )));
+    a.add_track(local.clone()).await.unwrap();
+    a.set_local_description(a.create_offer(None).await.unwrap())
+        .await
+        .unwrap();
+    timeout(Duration::from_secs(3), agr.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    b.set_remote_description(a.local_description().await.unwrap())
+        .await
+        .unwrap();
+    b.set_local_description(b.create_answer(None).await.unwrap())
+        .await
+        .unwrap();
+    timeout(Duration::from_secs(3), bgr.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    a.set_remote_description(b.local_description().await.unwrap())
+        .await
+        .unwrap();
+    let writes = tokio::spawn(async move {
+        for sequence in 1..=200 {
+            let packet = rtp::Packet {
+                header: rtp::Header {
+                    version: 2,
+                    ssrc,
+                    sequence_number: sequence,
+                    timestamp: u32::from(sequence) * (rate / 50),
+                    ..Default::default()
+                },
+                payload: bytes::Bytes::from_static(&[0x10, 0, 0, 0, 0]),
+            };
+            let _ = local.write_rtp(packet).await;
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    });
+    let observed = timeout(Duration::from_secs(5), opened_rx.recv()).await;
+    let discoverable_during_callback = timeout(Duration::from_secs(1), b.get_receivers())
+        .await
+        .unwrap()
+        .len();
+    release.notify_one();
+    let after = if let Ok(Some((track, _, _))) = &observed {
+        timeout(Duration::from_secs(2), async {
+            loop {
+                match track.poll().await {
+                    Some(TrackRemoteEvent::OnRtpPacket(packet)) => break Some(packet.header.ssrc),
+                    None | Some(TrackRemoteEvent::OnEnded | TrackRemoteEvent::OnError) => {
+                        break None;
+                    }
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .ok()
+        .flatten()
+    } else {
+        None
+    };
+    writes.abort();
+    let _ = writes.await;
+    timeout(Duration::from_secs(2), a.close())
+        .await
+        .unwrap()
+        .unwrap();
+    timeout(Duration::from_secs(2), b.close())
+        .await
+        .unwrap()
+        .unwrap();
+    let (_, ssrcs, got_codec) = observed.unwrap().unwrap();
+    assert_eq!(
+        (
+            ssrcs,
+            got_codec.map(|c| (c.mime_type, c.clock_rate)),
+            discoverable_during_callback,
+            after
+        ),
+        (vec![ssrc], Some((mime.into(), rate)), 0, Some(ssrc)),
+        "callback metadata and publication ordering must both be ready"
+    );
+}
+#[tokio::test]
+async fn track_ready_audio_callback_precedes_discovery() {
+    exercise(RtpCodecKind::Audio, "audio/PCMU", 8000, 0).await;
+}
+#[tokio::test]
+async fn track_ready_video_callback_precedes_discovery() {
+    exercise(RtpCodecKind::Video, "video/VP8", 90000, 96).await;
+}
