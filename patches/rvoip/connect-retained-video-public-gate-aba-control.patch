+// No original delivery guard exists while this controlled policy callback runs.
+// Poll the SAME real public gate operation to completion without adding a task
+// or waiting while policy/model metadata is owned. Unexpected Pending is a
+// fixture failure; it is never replaced with direct StreamModel mutation.
+fn complete_uncontended_public_gate_for_policy_test(
+    future: impl std::future::Future<Output = ControlResult<()>>,
+) {
+    struct GateWake;
+    impl std::task::Wake for GateWake {
+        fn wake(self: Arc<Self>) {}
+    }
+    let waker = std::task::Waker::from(Arc::new(GateWake));
+    let mut context = std::task::Context::from_waker(&waker);
+    let mut original = Box::pin(future);
+    let completed = std::future::Future::poll(original.as_mut(), &mut context);
+    drop(original);
+    assert!(
+        matches!(completed, std::task::Poll::Ready(Ok(()))),
+        "uncontended original public gate did not complete: {completed:?}"
+    );
+}
