+/// Exact original private structural metadata for a downstream isolated observer.
+/// It retains only the original binding's Weak resources, tickets, cancellation
+/// and fixed deadline, not the preparation object whose Drop closes the route.
+#[cfg(feature = "test-support")]
+pub struct AudioReplacementPreparationObserver {
+    binding: Arc<AudioPrerollBinding>,
+    sources: Vec<MediaSource>,
+}
+#[cfg(feature = "test-support")]
+impl AudioReplacementPreparationObserver {
+    /// Try-only actual state for a downstream isolated media-boundary observer.
+    /// The copied result is diagnostic metadata, never an authorization lease.
+    #[cfg(feature = "test-support")]
+    pub fn observation_for_test(&self) -> ControlResult<Option<AudioReplacementPreparationObservation>> {
+        let Some(target) = self.binding.target.upgrade() else { return Ok(None); };
+        let Some(port) = self.binding.target_port.upgrade() else { return Ok(None); };
+        let Some(gate) = self.binding.target_subscription.gate.upgrade() else { return Ok(None); };
+        // Pin exact already-selected resources BEFORE taking ticket guards;
+        // temporary Weak upgrades inside current_cut cannot become last-owner
+        // destructors while those guards are held.
+        let _source_owners = self.binding.sources.iter().filter_map(|source| source.owner.upgrade()).collect::<Vec<_>>();
+        let _source_ports = self.binding.sources.iter().filter_map(|source| source.port.upgrade()).collect::<Vec<_>>();
+        let originals = self.binding.cut_tickets();
+        let tickets = rvoip_core_traits::peer_switch::PeerRouteGuardSet::try_acquire(&originals)
+            .map_err(|error| match error {
+                rvoip_core_traits::peer_switch::PeerRouteGuardError::MetadataBusy => StreamControlError::MetadataBusy,
+                _ => StreamControlError::NotReady,
+            })?;
+        let state = crate::staged_streams::control_metadata::try_lock(&target.state)?;
+        let programme = crate::staged_streams::control_metadata::try_lock(&gate.state)?;
+        let physical = crate::staged_streams::control_metadata::try_lock(&port.state)?;
+        if matches!(physical.status, PortStatus::Retired | PortStatus::Closed) {
+            return Ok(None);
+        }
+        let logical = &port.binding.negotiated.requested.logical_id;
+        let stream = state.model.streams().get(logical).ok_or(StreamControlError::NotReady)?;
+        let exact = state.active.get(logical).is_some_and(|actual| Arc::ptr_eq(actual, &port));
+        Ok(Some(AudioReplacementPreparationObservation {
+            target_connection: target.connection.clone(),
+            target: port.binding.clone(),
+            native_egress: AdapterMediaPort(port.clone()).native_egress_identity(),
+            private_current: exact && !state.closed && self.binding.current_cut(&tickets),
+            source_muted: stream.source_muted,
+            ordinary_programme_empty: programme.program.selections.is_empty(),
+            sources: self.sources.clone(),
+        }))
+    }
+
+
+}
