+#[cfg(test)]
+mod publication_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    fn guard(started: Arc<AtomicBool>, physical: CancellationToken) -> CredentialPublication {
+        CredentialPublication {
+            started,
+            physical,
+            committed: false,
+        }
+    }
+    #[test]
+    fn credential_publication_cancel_before_media_keeps_prior_physical_peer() {
+        let physical = CancellationToken::new();
+        drop(guard(Arc::new(AtomicBool::new(false)), physical.clone()));
+        assert!(!physical.is_cancelled());
+    }
+    #[test]
+    fn credential_publication_drop_after_possible_media_closes_root_and_children() {
+        let physical = CancellationToken::new();
+        let child = physical.child_token();
+        let started = Arc::new(AtomicBool::new(false));
+        let publication = guard(started.clone(), physical.clone());
+        started.store(true, Ordering::Release);
+        // Original worker result may already be ready when its caller drops.
+        drop(publication);
+        assert!(physical.is_cancelled());
+        assert!(child.is_cancelled());
+    }
+    #[test]
+    fn credential_publication_committed_successor_keeps_physical_peer() {
+        let physical = CancellationToken::new();
+        guard(Arc::new(AtomicBool::new(true)), physical.clone()).committed();
+        assert!(!physical.is_cancelled());
+    }
+}
