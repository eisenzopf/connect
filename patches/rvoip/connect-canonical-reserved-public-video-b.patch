+#[test]
+fn reserved_b_negotiates_exact_mid_codec_direction_without_aliasing_preview() {
+    let offer=sdp(false);let answer=sdp(true);let roles=slots(&offer,false).unwrap();
+    roles.validate_answer(&offer,&answer).unwrap();
+    let a=roles.negotiated(&offer,&answer,VideoRole::Preview).unwrap();
+    let b=roles.negotiated(&offer,&answer,VideoRole::PublicReserved).unwrap();
+    assert_eq!(a.mid.as_deref(),Some("camera"));assert_eq!(b.mid.as_deref(),Some("fresh"));
+    assert_eq!((a.payload_type,a.rtx_payload_type),(120,Some(124)));
+    assert_eq!((b.payload_type,b.rtx_payload_type),(121,Some(125)));
+    assert_eq!(roles.outbound_mid(&offer,&answer,VideoRole::PublicReserved).unwrap(),Some((4,"fresh".into())));
+    for bad in [answer.replace("a=mid:fresh","a=mid:camera"),answer.replace("a=mid:fresh","a=mid:other"),answer.replace("a=sendonly","a=sendrecv"),answer.replace("a=fmtp:125 apt=121","a=fmtp:125 apt=120"),answer.replace("121 VP8/90000","121 VP8/8000"),answer+"m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\n"] {
+        assert!(roles.validate_answer(&offer,&bad).is_err());
+    }
+    assert!(slots(&offer.replace("a=recvonly","a=sendrecv"),false).is_err());
+    assert!(slots(&offer.replace("a=mid:fresh","a=mid:camera"),false).is_err());
+}
