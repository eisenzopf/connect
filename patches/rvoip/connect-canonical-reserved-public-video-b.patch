+// Actual Core queue ownership. No complete canonical-B transport/F assertion.
+#[tokio::test]
+async fn reserved_video_queue_has_no_native_worker_and_original_close_releases_it() {
+    use futures::FutureExt as _;
+    use rvoip_core::peer_admission::PeerAdmissionOwner;
+    use rvoip_core::staged_streams::direct_subscriptions::*;
+    for backend_drop in [false,true] {
+        let f=Fixture::new(Medium::Video).await;
+        let lifetime=CancellationToken::new();
+        let mut accepted=principal("reserved-output");
+        accepted.assurance=IdentityAssurance::Identified {credential_kind:rvoip_core::identity::CredentialKind::Oidc};
+        let owner=PeerAdmissionOwner::new(&accepted,IdentityId::new(),DeviceId::new(),lifetime.child_token(),Default::default()).unwrap();
+        let physical=WebRtcPhysicalBinding::new(&owner.peer(),lifetime.child_token());
+        let peer=match RvoipPeerConnection::new_canonical(&WebRtcConfig::loopback(),PeerRole::Answerer).await {
+            Ok(peer)=>peer,Err(error)=>{let a=f.a.shutdown(deadline()).await;let b=f.b.shutdown(deadline()).await;assert_eq!((a,b),(0,0));panic!("native reservation setup: {error}")}
+        };
+        let owners=Arc::new(DashMap::new());
+        let queue=Arc::new(ReservedVideoOutput {video:Mutex::new(None),stream:f.port.binding().transport_id.clone(),owners:Arc::downgrade(&owners)});
+        let weak=Arc::downgrade(&queue);owners.insert(queue.stream.clone(),queue); // sole strong queue root
+        let (input,_receive)=input_channel(Medium::Video);
+        let io=Arc::new(PortIo {
+            port:f.port.downgrade(),binding:f.port.binding().clone(),physical,
+            health:WorkerHealth::new(lifetime.child_token()),input,input_refused:AtomicU64::new(0),
+            close:OnceLock::new(),reserved_video:Some(weak.clone()),map:Weak::new(),
+        });
+        let work=std::panic::AssertUnwindSafe(async {
+            f.a.change_direct_subscriptions(f.a.revision(),DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&f.b,desired(Medium::Video).logical_id.clone(),desired(Medium::Video).logical_id)]),deadline(),CancellationToken::new(),None).await.unwrap();
+            let mut original=f.b.take_ingress(&desired(Medium::Video).logical_id).unwrap();
+            peer.add_local_video_track().await.unwrap();
+            let track=peer.local_video_track_internal().unwrap();let ssrc=peer.local_video_ssrc().unwrap();
+            let video=CoreVideoEgress::bind(&f.port,track,ssrc,96,peer.sender_clock.clone(),deadline().into_std()).await.unwrap();
+            assert!(f.port.take_egress().is_err());io.reserve_video(video).unwrap();
+            {
+                let setup=io.health.setup.lock().unwrap();
+                assert!(setup.tasks.is_empty());assert!(io.health.activate(&setup).is_err());
+                io.activate_prepared(&setup).unwrap();assert!(setup.tasks.is_empty());
+            }
+            assert!(io.health.confirmed());
+            let packet=f.packet(1,9000);
+            f.opposite_port.try_publish(&MediaFrame {stream_id:f.opposite_port.binding().transport_id.clone(),kind:StreamKind::Video,payload:packet.packet.marshal().unwrap().freeze(),timestamp_rtp:9000,captured_at:Utc::now(),payload_type:Some(96),source_clock:None}).unwrap();
+            original.try_recv().unwrap().try_forward_to(&f.a,&desired(Medium::Video).logical_id).unwrap();
