+            if reserve {
+                server.validate_reserved_video_answer(&offered,&answered).await.unwrap();
+                let (a,assrc)=server.reserved_video_track_for_role(VideoRole::Preview).await.unwrap();
+                let (b,bssrc)=server.reserved_video_track_for_role(VideoRole::PublicReserved).await.unwrap();
+                assert!(Arc::ptr_eq(&a,&original_preview));assert!(!Arc::ptr_eq(&a,&b));assert_ne!(assrc,bssrc);
+                assert_ne!(Some(bssrc),server.local_audio_ssrc());
+                let descriptor=server.reserved_video_descriptor().await.unwrap();
+                assert_eq!(descriptor.logical_stream_id,profile().public_stream_id);
+                assert_eq!(descriptor.primary_ssrc,bssrc);assert_eq!(descriptor.clock_rate_hz,90000);
+                assert_eq!(Some(descriptor.mid.as_str()),server.reserved_video_slots.get().map(|s|s.public_mid.as_str()));
+                let roles=server.reserved_video_slots.get().unwrap();assert_ne!(roles.preview_mid,roles.public_mid);
+                server.prepare_answerer_media_for_offer(&offered).await.unwrap();
+                assert!(Arc::ptr_eq(&b,&server.reserved_video_track_for_role(VideoRole::PublicReserved).await.unwrap().0));
+                // Real sender pointer/MID/coding mismatch cannot silently bind A.
+                let tx=server.reserved_video_track.lock().as_ref().unwrap().transceiver.clone();
+                tx.set_direction(RTCRtpTransceiverDirection::Sendrecv).await.unwrap();
+                assert!(server.reserved_video_track_for_role(VideoRole::PublicReserved).await.is_err());
+                tx.set_direction(RTCRtpTransceiverDirection::Sendonly).await.unwrap();
+                server.validate_reserved_video_answer(&offered,&answered).await.unwrap();
+            } else {
+                assert!(server.reserved_video_track.lock().is_none());assert!(server.reserved_video_slots.get().is_none());
+                assert!(crate::media::core_video_profile::negotiated_profile(&offered,&answered).is_ok());
+            }
+            // Existing camera ingress still reaches the SAME native receiver
+            // while no server B writer exists. Synthetic RTP, not codec quality.
+            let camera_ssrc=client.local_video_ssrc().unwrap();
+            original_camera.write_rtp(crate::media::vp8_rtp_packet_for_ssrc(camera_ssrc,1,9000)).await.unwrap();
+            let remote=server.wait_remote_video_track(Duration::from_secs(2)).await.unwrap();
+            let canonical_input=server.discover_remote_video_track().await.unwrap();
+            assert!(Arc::ptr_eq(&remote,&canonical_input),"canonical camera SourceJob must select exact A, never B dummy receiver");
+            let observed=tokio::time::timeout(Duration::from_secs(2),async {
+                loop { match remote.poll().await {
+                    Some(webrtc::media_stream::track_remote::TrackRemoteEvent::OnRtpPacket(packet,_))=>break packet,
+                    Some(_)=>continue,None=>panic!("original camera receiver ended"),
+                }}
+            }).await.unwrap();
+            assert_eq!((observed.header.ssrc,observed.header.timestamp),(camera_ssrc,9000));
+            assert!(Arc::ptr_eq(&original_camera,&client.local_video_track_internal().unwrap()),"B cannot replace the original camera sender");
+            assert!(Arc::ptr_eq(&original_preview,&server.local_video_track_internal().unwrap()));
+        }).catch_unwind().await;
+        let a=client.close().await;let b=server.close().await;
+        assert!(a.is_ok()&&b.is_ok(),"both actual native owners close before work outcome");
+        if let Err(e)=work { std::panic::resume_unwind(e); }
+    }
+}
