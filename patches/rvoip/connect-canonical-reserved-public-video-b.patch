+//! Setup-only second server video output. No public raw B writer capability.
+use super::*;
+use crate::canonical::reserved_video::{OfferedSlots, ReservedVideoProfile, VideoRole};
+use webrtc::rtp_transceiver::{RtpTransceiver, RTCRtpTransceiverInit};
+
+pub(super) struct ReservedVideoTrack {
+    pub(super) track: Arc<TrackLocalStaticRTP>,
+    pub(super) ssrc: u32,
+    transceiver: Arc<dyn RtpTransceiver>,
+}
+impl RvoipPeerConnection {
+    pub(crate) fn install_reserved_video(&self, profile: ReservedVideoProfile) -> Result<()> {
+        if !self.guarded_video_io || self.role != PeerRole::Answerer || self.local_audio.lock().is_some() || self.local_video.lock().is_some() {
+            return Err(WebRtcError::IncompatibleCapabilities);
+        }
+        self.reserved_video.set(profile).map_err(|_| WebRtcError::IncompatibleCapabilities)
+    }
+    pub(crate) fn reserved_video_profile(&self) -> Option<&ReservedVideoProfile> { self.reserved_video.get() }
+    pub(super) async fn prepare_reserved_video_offer(self: &Arc<Self>, offer: &str) -> Result<()> {
+        let slots = crate::canonical::reserved_video::slots(offer,false).map_err(|_|WebRtcError::IncompatibleCapabilities)?;
+        if let Some(old)=self.reserved_video_slots.get() {
+            if old != &slots { return Err(WebRtcError::IncompatibleCapabilities); }
+        } else {
+            self.reserved_video_slots.set(slots).map_err(|_|WebRtcError::IncompatibleCapabilities)?;
+        }
+        self.add_local_audio_track_with_dtmf(preferred_telephone_event_codec_in_sdp(offer).into_iter().collect()).await?;
+        self.add_local_video_track().await?;
+        if self.reserved_video_track.lock().is_some() { return Ok(()); }
+        let mut occupied=std::collections::BTreeSet::new();
+        for sender in self.pc.get_senders().await {
+            for encoding in sender.track().codings().await {
+                let coding=encoding.rtp_coding_parameters;
+                if let Some(ssrc)=coding.ssrc { occupied.insert(ssrc); }
+                if let Some(rtx)=coding.rtx { occupied.insert(rtx.ssrc); }
+                if let Some(fec)=coding.fec { occupied.insert(fec.ssrc); }
+            }
+        }
+        let mut ssrc=rand::random::<u32>();
+        // At most this finite existing coding census can collide. Zero remains
+        // a legal SSRC. No reuse of another bundled sender/RTX/FEC identity.
+        for _ in 0..=occupied.len() {
+            if !occupied.contains(&ssrc) { break; }
+            ssrc=ssrc.wrapping_add(1);
+        }
+        if occupied.contains(&ssrc) { return Err(WebRtcError::IncompatibleCapabilities); }
+        let track=Arc::new(TrackLocalStaticRTP::new(MediaStreamTrack::new(
+            self.local_stream_id.clone(), format!("rvoip-public-b-{ssrc}"), "rvoip-reserved-public-video".into(), RtpCodecKind::Video,
+            vec![RTCRtpEncodingParameters { rtp_coding_parameters: RTCRtpCodingParameters { ssrc:Some(ssrc), ..Default::default() }, codec:RTCRtpCodec {
+                mime_type:MIME_TYPE_VP8.to_owned(), clock_rate:90000, channels:0, sdp_fmtp_line:String::new(), rtcp_feedback:video_track_rtcp_feedback(),
+            }, ..Default::default() }],
+        )));
+        let transceiver=self.pc.add_transceiver_from_track(track.clone() as Arc<dyn TrackLocal>,Some(RTCRtpTransceiverInit {
+            direction:RTCRtpTransceiverDirection::Sendonly, ..Default::default()
+        })).await?;
+        *self.reserved_video_track.lock()=Some(ReservedVideoTrack { track,ssrc,transceiver });
+        Ok(())
+    }
+    pub(super) async fn validate_reserved_video_answer(&self, offer:&str, answer:&str) -> Result<()> {
+        let slots=self.reserved_video_slots.get().ok_or(WebRtcError::IncompatibleCapabilities)?;
+        slots.validate_answer(offer,answer).map_err(|_|WebRtcError::IncompatibleCapabilities)?;
+        for role in [VideoRole::Preview,VideoRole::PublicReserved] {
+            self.reserved_video_track_for_role(role).await.map_err(|_|WebRtcError::IncompatibleCapabilities)?;
+        }
+        Ok(())
+    }
+    // A is the sole browser publication. Never choose B's dummy receive side
+    // by HashMap order or media kind when a second native video MID exists.
+    pub(super) async fn reserved_camera_track(&self) -> Option<Arc<dyn TrackRemote>> {
+        let slots=self.reserved_video_slots.get()?;
+        let original=self.local_video_track_internal()? as Arc<dyn TrackLocal>;
+        let mut found=None;
+        for tx in self.pc.get_transceivers().await {
+            let Some(sender)=tx.sender().await.ok()? else {continue};
+            if !Arc::ptr_eq(sender.track(),&original) {continue;}
+            if found.is_some() || tx.mid().await.ok()?.as_deref()!=Some(slots.preview_mid.as_str()) || tx.direction().await.ok()?!=RTCRtpTransceiverDirection::Sendrecv {return None;}
+            let receiver=tx.receiver().await.ok()??;
+            let track=receiver.track().clone();
+            if track.kind().await!=RtpCodecKind::Video || track.ssrcs().await.len()!=1 {return None;}
+            found=Some(track);
+        }
+        found
+    }
+    pub(crate) async fn reserved_video_descriptor(&self) -> rvoip_core::staged_streams::ControlResult<crate::canonical::ReservedVideoBinding> {
+        use rvoip_core::staged_streams::StreamControlError as E;
+        if !self.core_transport_current() || !self.signaling_is_stable().await { return Err(E::NotReady); }
+        let profile=self.reserved_video.get().ok_or(E::Unsupported)?;
+        let slots=self.reserved_video_slots.get().ok_or(E::NotReady)?;
+        let local=self.pc.local_description().await.ok_or(E::NotReady)?;
+        let remote=self.pc.remote_description().await.ok_or(E::NotReady)?;
+        if local.sdp_type!=RTCSdpType::Answer || remote.sdp_type!=RTCSdpType::Offer { return Err(E::Unsupported); }
+        slots.validate_answer(&remote.sdp,&local.sdp)?;
+        let mapping=slots.negotiated(&remote.sdp,&local.sdp,VideoRole::PublicReserved)?;
+        let (_,ssrc)=self.reserved_video_track_for_role(VideoRole::PublicReserved).await?;
+        if !self.core_transport_current() || !self.signaling_is_stable().await { return Err(E::NotReady); }
+        Ok(crate::canonical::ReservedVideoBinding { logical_stream_id:profile.public_stream_id.clone(),mid:slots.public_mid.clone(),primary_ssrc:ssrc,payload_type:mapping.payload_type,clock_rate_hz:90000 })
+    }
+    pub(crate) async fn reserved_video_track_for_role(&self, role:VideoRole) -> rvoip_core::staged_streams::ControlResult<(Arc<TrackLocalStaticRTP>,u32)> {
+        use rvoip_core::staged_streams::StreamControlError as E;
+        let slots=self.reserved_video_slots.get().ok_or(E::NotReady)?;
+        let (track,ssrc,expected_tx)= match role {
+            VideoRole::Preview => (self.local_video_track_internal().ok_or(E::NotReady)?,self.local_video_ssrc().ok_or(E::NotReady)?,None),
+            VideoRole::PublicReserved => {
+                let reserved=self.reserved_video_track.lock();
+                let b=reserved.as_ref().ok_or(E::NotReady)?;
+                (b.track.clone(),b.ssrc,Some(b.transceiver.id()))
+            }
+        };
+        let erased=track.clone() as Arc<dyn TrackLocal>;
+        let mut matched=None;
+        for tx in self.pc.get_transceivers().await {
+            let Some(sender)=tx.sender().await.map_err(|_|E::NotReady)? else { continue; };
+            if !Arc::ptr_eq(sender.track(),&erased) { continue; }
+            if matched.is_some() || expected_tx.is_some_and(|id|id!=tx.id()) || tx.mid().await.map_err(|_|E::NotReady)?.as_deref()!=Some(slots.mid(role)) {
+                return Err(E::Unsupported);
+            }
+            let expected=match role { VideoRole::Preview=>RTCRtpTransceiverDirection::Sendrecv,VideoRole::PublicReserved=>RTCRtpTransceiverDirection::Sendonly };
+            if tx.direction().await.map_err(|_|E::NotReady)?!=expected { return Err(E::Unsupported); }
+            let parameters=sender.get_parameters().await.map_err(|_|E::NotReady)?;
+            if parameters.encodings.len()!=1 || parameters.encodings[0].rtp_coding_parameters.ssrc!=Some(ssrc) { return Err(E::Unsupported); }
+            for other in self.pc.get_senders().await {
+                if other.id()==sender.id() { continue; }
+                let parameters=other.get_parameters().await.map_err(|_|E::NotReady)?;
+                if parameters.encodings.iter().any(|e| {
+                    let c=&e.rtp_coding_parameters;
+                    c.ssrc==Some(ssrc) || c.rtx.as_ref().is_some_and(|v|v.ssrc==ssrc) || c.fec.as_ref().is_some_and(|v|v.ssrc==ssrc)
+                }) { return Err(E::Unsupported); }
+            }
+            matched=Some(());
+        }
+        if matched.is_none() { return Err(E::NotReady); }
+        Ok((track,ssrc))
+    }
+}
