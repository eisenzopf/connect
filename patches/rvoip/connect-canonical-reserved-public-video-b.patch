@@ -0,0 +1,122 @@
+//! Explicit initial A/B negotiation, not permission to feed or publish B.
+use rvoip_core::{
+    ids::StreamId,
+    staged_streams::{ControlResult, StreamControlError as E},
+    stream_lifecycle::{DesiredStream, Medium, StreamDirection},
+};
+use rvoip_sip_core::types::sdp::{MediaDescription, ParsedAttribute, SdpSession};
+
+/// Trusted setup intent for audio Both, camera/preview A Both and public B
+/// client-recvonly (Core Send). The Root owns reservation/authentication; this
+/// value names slots and cannot enable a writer, perform a cut or prove ready.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReservedVideoProfile {
+    pub(crate) audio_stream_id: StreamId,
+    pub(crate) preview_stream_id: StreamId,
+    pub(crate) public_stream_id: StreamId,
+}
+/// Negotiated scalar observation only; the original Root must separately bind
+/// Core generations/family, reservation, cut and decoded readiness.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReservedVideoBinding {
+    pub logical_stream_id: StreamId,
+    pub mid: String,
+    pub primary_ssrc: u32,
+    pub payload_type: u8,
+    pub clock_rate_hz: u32,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct OfferedSlots {
+    pub(crate) audio_mid: String,
+    pub(crate) preview_mid: String,
+    pub(crate) public_mid: String,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum VideoRole { Preview, PublicReserved }
+impl ReservedVideoProfile {
+    pub fn new(audio_stream_id: StreamId, preview_stream_id: StreamId, public_stream_id: StreamId) -> ControlResult<Self> {
+        if audio_stream_id == preview_stream_id || audio_stream_id == public_stream_id || preview_stream_id == public_stream_id {
+            return Err(E::Unsupported);
+        }
+        Ok(Self { audio_stream_id, preview_stream_id, public_stream_id })
+    }
+    pub(crate) fn streams(&self) -> [DesiredStream;3] {
+        [DesiredStream{logical_id:self.audio_stream_id.clone(),medium:Medium::Audio,direction:StreamDirection::Both},DesiredStream{logical_id:self.preview_stream_id.clone(),medium:Medium::Video,direction:StreamDirection::Both},DesiredStream{logical_id:self.public_stream_id.clone(),medium:Medium::Video,direction:StreamDirection::Send}]
+    }
+    pub(crate) fn role(&self, stream: &DesiredStream) -> ControlResult<Option<VideoRole>> {
+        match (&stream.logical_id, stream.medium, stream.direction) {
+            (id, Medium::Audio, StreamDirection::Both) if *id == self.audio_stream_id => Ok(None),
+            (id, Medium::Video, StreamDirection::Both) if *id == self.preview_stream_id => Ok(Some(VideoRole::Preview)),
+            (id, Medium::Video, StreamDirection::Send) if *id == self.public_stream_id => Ok(Some(VideoRole::PublicReserved)),
+            _ => Err(E::Unsupported),
+        }
+    }
+    pub(crate) fn validate_ports<'a>(&self, streams: impl IntoIterator<Item=&'a DesiredStream>) -> ControlResult<()> {
+        let mut roles = [false; 3];
+        for stream in streams {
+            let index = match self.role(stream)? { None => 0, Some(VideoRole::Preview) => 1, Some(VideoRole::PublicReserved) => 2 };
+            if std::mem::replace(&mut roles[index], true) { return Err(E::Unsupported); }
+        }
+        if roles != [true; 3] { return Err(E::Unsupported); }
+        Ok(())
+    }
+}
+fn one_mid(media: &MediaDescription) -> ControlResult<String> {
+    let mut mids = media.generic_attributes.iter().filter_map(|a| if let ParsedAttribute::Mid(mid)=a { Some(mid) } else { None });
+    let mid = mids.next().ok_or(E::Unsupported)?;
+    // The existing canonical one-byte MID writer supports at most 16 bytes.
+    if mids.next().is_some() || mid.is_empty() || mid.len()>16 || !mid.bytes().all(|b| b.is_ascii_graphic()) { return Err(E::Unsupported); }
+    Ok(mid.clone())
+}
+fn direction(session: &SdpSession, media: &MediaDescription) -> String {
+    media.direction.as_ref().or(session.direction.as_ref()).map(ToString::to_string).unwrap_or_else(|| "sendrecv".into())
+}
+pub(crate) fn slots(sdp: &str, answer: bool) -> ControlResult<OfferedSlots> {
+    let session: SdpSession = sdp.parse().map_err(|_| E::Unsupported)?;
+    let media = &session.media_descriptions;
+    if media.len()!=3 || media.iter().any(|m|m.port==0) || media[0].media!="audio" || media[1].media!="video" || media[2].media!="video" {
+        return Err(E::Unsupported);
+    }
+    let expected = if answer { ["sendrecv", "sendrecv", "sendonly"] } else { ["sendrecv", "sendrecv", "recvonly"] };
+    for (m, expected) in media.iter().zip(expected) {
+        if direction(&session,m) != expected { return Err(E::Unsupported); }
+    }
+    let out = OfferedSlots { audio_mid: one_mid(&media[0])?, preview_mid: one_mid(&media[1])?, public_mid: one_mid(&media[2])? };
+    if out.audio_mid==out.preview_mid || out.audio_mid==out.public_mid || out.preview_mid==out.public_mid { return Err(E::Unsupported); }
+    Ok(out)
+}
+impl OfferedSlots {
+    pub(crate) fn mid(&self, role: VideoRole) -> &str {
+        match role { VideoRole::Preview => &self.preview_mid, VideoRole::PublicReserved => &self.public_mid }
+    }
+    pub(crate) fn validate_answer(&self, offer: &str, answer: &str) -> ControlResult<()> {
+        if slots(offer,false)? != *self || slots(answer,true)? != *self { return Err(E::Unsupported); }
+        for role in [VideoRole::Preview, VideoRole::PublicReserved] {
+            self.negotiated(offer,answer,role)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn negotiated(&self, offer: &str, answer: &str, role: VideoRole) -> ControlResult<crate::media::core_video_profile::NegotiatedVideo> {
+        crate::media::core_video_profile::negotiated_profile(&project_video(offer,self.mid(role))?, &project_video(answer,self.mid(role))?)
+    }
+    pub(crate) fn outbound_mid(&self, offer: &str, answer: &str, role: VideoRole) -> ControlResult<Option<(u8,String)>> {
+        crate::media::core_video_profile::outbound_mid(&project_video(offer,self.mid(role))?, &project_video(answer,self.mid(role))?, false)
+    }
+}
+/// Projection is only for existing exact codec/extmap validators. Full shape,
+/// original m-section position, direction and all role MIDs are checked first.
+pub(crate) fn project_video(sdp: &str, expected_mid: &str) -> ControlResult<String> {
+    let parsed: SdpSession = sdp.parse().map_err(|_| E::Unsupported)?;
+    let selected: Vec<_> = parsed.media_descriptions.iter().enumerate().filter(|(_,m)|m.media=="video" && one_mid(m).ok().as_deref()==Some(expected_mid)).map(|(i,_)|i).collect();
+    let [selected] = selected.as_slice() else { return Err(E::Unsupported); };
+    let mut index=None;
+    let mut out=String::new();
+    for line in sdp.lines() {
+        if line.starts_with("m=") { index=Some(index.map_or(0,|i|i+1)); }
+        if index.is_none() || index==Some(*selected) { out.push_str(line.trim_end_matches('\r')); out.push_str("\r\n"); }
+    }
+    Ok(out)
+}
