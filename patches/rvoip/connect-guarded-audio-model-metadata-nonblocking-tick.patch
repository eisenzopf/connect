+// Record an ACTUAL guarded third-peer IO callback while State remains held.
+// Decode/assert only after owners have joined, so a negative control cannot
+// strand the source metadata owner through an assertion panic.
+async fn record_healthy_audio(out: &mut mpsc::Receiver<QueuedMedia>) -> (bool, Vec<u8>) {
+    let payload = Arc::new(Mutex::new(Vec::new()));
+    let saved = payload.clone();
+    let delivered = match out.try_recv() {
+        Ok(queued) => queued.deliver(move |frame| {
+            let bytes = frame.payload.to_vec();
+            let saved = saved.clone();
+            async move { *saved.lock().unwrap() = bytes; Ok(()) }
+        }).await.is_ok(),
+        Err(_) => false,
+    };
+    let bytes = payload.lock().unwrap().clone();
+    (delivered, bytes)
+}
+fn assert_healthy_audio(payload: &[u8], expected: i16) {
+    let mut codec = rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+    let samples = codec.decode(payload).unwrap().samples;
+    assert_eq!(samples.len(), 160);
+    assert!((i32::from(samples[80]) - i32::from(expected)).abs() < 350);
+}
