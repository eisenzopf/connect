+#[tokio::test]
+async fn guarded_mixer_actual_model_state_busy_keeps_original_expiry_and_accepts_only_fresh_audio() {
+    for stage in [1, 2] {
+        let (s, full, mut out_a, mut out_c) = model_state_audio_scene(stage).await;
+        let mut owner = ModelStateAudioTick::start(&s);
+        // The SAME existing200ms original age expires; Busy never renews it.
+        tokio::time::sleep(Duration::from_millis(210)).await;
+        let no_idle_grant = s.policy.0.try_write().is_ok();
+        let joined = owner.close();
+        assert!(owner.returned_while_held && joined && no_idle_grant);
+        drop(full);
+        s.mixer.tick();
+        assert!(out_c.try_recv().is_err() && out_a.try_recv().is_err(), "expired original audio escaped");
+        s.publish_at(0, 1000, 160);
+        s.mixer.tick();
+        heard(out_c.try_recv().unwrap(), 1000).await;
+        s.mixer.tick();
+        assert!(out_c.try_recv().is_err(), "fresh recovery repeated");
+    }
+}
