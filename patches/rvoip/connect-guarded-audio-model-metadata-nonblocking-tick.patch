+#[tokio::test]
+async fn guarded_mixer_actual_model_state_busy_preserves_all_original_audio_queues_and_third_peer_io() {
+    for stage in [1, 2] {
+        let (s, full, mut out_a, mut out_c) = model_state_audio_scene(stage).await;
+        let before = s.mixer.audio_queue_state_for_test(&s.controllers[0].connection).unwrap();
+        s.publish_at(1, 1000, 160);
+        let mut owner = ModelStateAudioTick::start(&s);
+        let after = owner.returned_while_held.then(|| s.mixer.audio_queue_state_for_test(&s.controllers[0].connection).unwrap());
+        let healthy = if owner.returned_while_held { record_healthy_audio(&mut out_c).await } else { (false, Vec::new()) };
+        let no_idle_grant = s.policy.0.try_write().is_ok();
+        let joined = owner.close();
+        assert!(owner.inflight_was_free && owner.returned_while_held && joined, "actual State exclusion stalled the mixer");
+        let after = after.unwrap();
+        assert_eq!((after.0, after.1, after.2), (before.0, before.1, before.2));
+        assert!(after.3 >= before.3, "Busy erased original receiver PCM");
+        assert!(healthy.0 && no_idle_grant, "unrelated IO stalled or a permission reader survived");
+        assert_healthy_audio(&healthy.1, 1000);
+        drop(full);
+        s.mixer.tick();
+        heard(out_c.try_recv().expect("same original source PCM lost"), 1800).await;
+        heard(out_a.try_recv().expect("same original receiver quantum lost"), 900).await;
+        heard(out_a.try_recv().expect("next receiver quantum lost"), 1000).await;
+        s.mixer.tick();
+        assert!(out_c.try_recv().is_err() && out_a.try_recv().is_err(), "original audio replayed");
+    }
+}
