+async fn model_state_audio_scene(stage: usize) -> (
+    Scene,
+    Vec<tokio::sync::mpsc::OwnedPermit<QueuedMedia>>,
+    mpsc::Receiver<QueuedMedia>,
+    mpsc::Receiver<QueuedMedia>,
+) {
+    let mode = Arc::new(AtomicUsize::new(0));
+    let saved = mode.clone();
+    let s = Scene::new_inner(
+        &[("a", "alice", audio(), 0), ("b", "bob", audio(), 0), ("c", "carol", audio(), 0)],
+        8000,
+        Some(Box::new(move |inner| Arc::new(BusySource {
+            inner,
+            mode: saved,
+            reads: Arc::new(AtomicUsize::new(0)),
+        }))),
+    ).await;
+    for index in 0..3 { s.bind(index, true).await; }
+    let out_a = s.port(0).take_egress().unwrap();
+    let mut out_c = s.port(2).take_egress().unwrap();
+    let egress = s.port(0).0.egress.clone();
+    let mut full = Vec::new();
+    while let Ok(permit) = egress.clone().try_reserve_owned() { full.push(permit); }
+    s.publish(0, 1800);
+    s.publish(1, 900);
+    mode.store(stage, Ordering::Release);
+    s.mixer.tick();
+    heard(out_c.try_recv().unwrap(), 900).await;
+    // Only seed the pre-existing waiting versus decoded-PCM paths with policy
+    // refusal. The contention being tested below is the real State mutex ONLY.
+    mode.store(0, Ordering::Release);
+    let queues = s.mixer.audio_queue_state_for_test(&s.controllers[0].connection).unwrap();
+    assert_eq!(queues.0, 0);
+    assert_eq!(queues.1, stage == 1);
+    assert_eq!(queues.2, (stage == 2) as usize);
+    assert_eq!(queues.3, 1, "actual unrelated PCM must already await this receiver");
+    (s, full, out_a, out_c)
+}
