+// Hold the ACTUAL controller metadata mutex without its independent inflight
+// permit, exactly as public metadata readers may. Always release and join BOTH
+// original threads before checking the result, including the old blocking
+// counterfactual. The500ms observation bound does not renew any packet deadline.
+struct ModelStateAudioTick {
+    release: Option<std::sync::mpsc::Sender<()>>,
+    holder: Option<std::thread::JoinHandle<()>>,
+    tick: Option<std::thread::JoinHandle<()>>,
+    returned_while_held: bool,
+    inflight_was_free: bool,
+}
+impl ModelStateAudioTick {
+    fn start(s: &Scene) -> Self {
+        let controller = s.controllers[0].clone();
+        let inflight_was_free = controller.inflight.clone().try_acquire_owned().is_ok();
+        let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        let holder = std::thread::spawn(move || {
+            let _state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+            let _ = entered_tx.send(());
+            let _ = release_rx.recv_timeout(Duration::from_secs(3));
+        });
+        let mut owner = Self {
+            release: Some(release_tx),
+            holder: Some(holder),
+            tick: None,
+            returned_while_held: false,
+            inflight_was_free,
+        };
+        if entered_rx.recv_timeout(Duration::from_millis(500)).is_err() {
+            owner.close();
+            panic!("actual source model owner did not enter");
+        }
+        let mixer = s.mixer.clone();
+        let (done_tx, done_rx) = std::sync::mpsc::sync_channel(1);
+        owner.tick = Some(std::thread::spawn(move || {
+            mixer.tick();
+            let _ = done_tx.send(());
+        }));
+        owner.returned_while_held = done_rx.recv_timeout(Duration::from_millis(500)).is_ok();
+        owner
+    }
+    fn close(&mut self) -> bool {
+        if let Some(release) = self.release.take() {
+            let _ = release.send(());
+        }
+        let held = self.holder.take().is_none_or(|owner| owner.join().is_ok());
+        let tick = self.tick.take().is_none_or(|owner| owner.join().is_ok());
+        held && tick
+    }
+}
+impl Drop for ModelStateAudioTick {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
