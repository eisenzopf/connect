+#[tokio::test]
+async fn guarded_audio_tick_adoption_busy_preserves_unclaimed_input_and_recovers_poison() {
+    use crate::staged_streams::audio_consumer::AudioConsumer;
+    use crate::staged_streams::guarded_audio::GuardedAudioMixer;
+    for port_metadata in [false, true] {
+        let s = Scene::new(&[("a", "alice", audio(), 0)], 8000).await;
+        s.publish(0, 1800);
+        let controller = s.controllers[0].clone();
+        let port = s.port(0).0.clone();
+        let consumer = AudioConsumer::optional(Some(desired(Medium::Audio).logical_id), 8000);
+        let mixer = GuardedAudioMixer::new(8000);
+        let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        let held_controller = controller.clone();
+        let held_port = port.clone();
+        let holder = std::thread::spawn(move || {
+            if port_metadata {
+                let _state = held_port.state.lock().unwrap_or_else(|p| p.into_inner());
+                let _ = entered_tx.send(());
+                let _ = release_rx.recv_timeout(Duration::from_secs(3));
+            } else {
+                let _state = held_controller.state.lock().unwrap_or_else(|p| p.into_inner());
+                let _ = entered_tx.send(());
+                let _ = release_rx.recv_timeout(Duration::from_secs(3));
+            }
+        });
+        let entered = entered_rx.recv_timeout(Duration::from_millis(500)).is_ok();
+        let tick_mixer = mixer.clone();
+        let tick_controller = controller.clone();
+        let tick_consumer = consumer.clone();
+        let (done_tx, done_rx) = std::sync::mpsc::sync_channel(1);
+        let tick = std::thread::spawn(move || {
+            let result = tick_mixer.try_prepare_registered(tick_controller, tick_consumer);
+            let _ = done_tx.send(());
+            result
+        });
+        let returned_while_held = done_rx.recv_timeout(Duration::from_millis(500)).is_ok();
+        let unclaimed = returned_while_held.then(|| port.input.lock().unwrap().as_ref().map(|q| q.len()));
+        let _ = release_tx.send(());
+        let holder_joined = holder.join().is_ok();
+        let result = tick.join();
+        assert!(entered && returned_while_held && holder_joined);
+        assert!(matches!(result, Ok(Err(StreamControlError::Backpressure))));
+        assert_eq!(unclaimed, Some(Some(1)), "Busy consumed the original input receiver");
+        // Same old recovery semantics: poisoned metadata is recovered, not
+        // permanently reclassified as Busy or used to fabricate a fresh port.
+        let poison_controller = controller.clone();
+        let poison_port = port.clone();
+        let poisoned = std::thread::spawn(move || {
+            if port_metadata { let _state = poison_port.state.lock().unwrap(); panic!("deliberate original PortState poison"); }
+            else { let _state = poison_controller.state.lock().unwrap(); panic!("deliberate original Controller.State poison"); }
+        }).join().is_err();
+        consumer.activate(true);
+        let member = mixer.try_prepare_registered(controller.clone(), consumer).unwrap();
+        mixer.insert_registered(controller.connection.clone(), member);
+        assert!(poisoned);
+        assert_eq!(mixer.audio_queue_state_for_test(&controller.connection), Some((1, false, 0, 0)));
+    }
+}
