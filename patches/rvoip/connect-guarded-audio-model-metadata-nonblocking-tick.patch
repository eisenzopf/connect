+#[tokio::test]
+async fn guarded_mixer_actual_model_state_busy_rechecks_revocation_without_replaying_original_audio() {
+    for stage in [1, 2] {
+        let (s, full, mut out_a, mut out_c) = model_state_audio_scene(stage).await;
+        let mut owner = ModelStateAudioTick::start(&s);
+        let revoked_without_reader = match s.policy.0.try_write() {
+            Ok(mut policy) => { policy.revoked.insert("alice".into()); true },
+            Err(_) => false,
+        };
+        let joined = owner.close();
+        assert!(owner.returned_while_held && joined && revoked_without_reader);
+        drop(full);
+        s.mixer.tick();
+        assert!(out_c.try_recv().is_err() && out_a.try_recv().is_err(), "revoked original reached IO");
+        s.policy.0.try_write().unwrap().revoked.clear();
+        s.mixer.tick();
+        assert!(out_c.try_recv().is_err() && out_a.try_recv().is_err(), "permission restoration replayed old audio");
+        s.publish_at(0, 1000, 160);
+        s.mixer.tick();
+        heard(out_c.try_recv().unwrap(), 1000).await;
+    }
+}
