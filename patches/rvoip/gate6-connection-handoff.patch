+#[tokio::test]
+async fn handoff_competing_acceptances_commit_one_bridge_and_duplicate_old_plan_has_no_second_effect(
+) {
+    let mut r = Room::new().await;
+    let context = r.handoff_ready().await;
+    r.publish("alice", 800).unwrap();
+    r.tick();
+    let queued = r.nodes.get_mut("consult").unwrap().out.try_recv().unwrap();
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let sending = tokio::spawn({
+        let entered = entered.clone();
+        let release = release.clone();
+        async move {
+            queued
+                .deliver(|_| async move {
+                    entered.notify_one();
+                    release.notified().await;
+                    Ok(())
+                })
+                .await
+        }
+    });
+    entered.notified().await;
+    let plan = r
+        .scene
+        .plan_audio_handoff(
+            context.audience(),
+            r.handoff_request(OldHandoffDisposition::Observer),
+        )
+        .unwrap();
+    let duplicate = plan.clone();
+    let grant = r.grant(Approval::Audience(plan.audience().clone())).await;
+    let work = tokio::spawn({
+        let scene = r.scene.clone();
+        async move {
+            scene
+                .commit_audio_handoff(plan, deadline(), CancellationToken::new(), &grant)
+                .await
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    assert!(!work.is_finished());
+    let mut competing = r.handoff_request(OldHandoffDisposition::Leave);
+    competing.operation_id = "handoff-competing".into();
+    let competing = r
+        .scene
+        .plan_audio_handoff(context.audience(), competing)
+        .unwrap();
+    assert!(r.handoff(competing).await.is_err());
+    assert!(!r.nodes["alice"].controller.shutdown.is_cancelled());
+    release.notify_one();
+    sending.await.unwrap().unwrap();
+    let (outcome, _) = work.await.unwrap().unwrap();
+    let revision = r.scene.audience_revision();
+    assert_eq!(outcome.media.audience_revision, revision);
+    assert!(r.handoff(duplicate).await.is_err());
+    assert_eq!(r.scene.audience_revision(), revision);
+    r.publish("bob", 2400).unwrap();
+    r.tick();
+    r.heard("consult", 2400).await;
+    r.heard("alice", 2400).await;
+    assert!(r.publish("alice", 800).is_err());
+}
