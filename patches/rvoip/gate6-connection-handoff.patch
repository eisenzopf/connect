+        let outgoing = BTreeSet::from([
+            ConnectionId::from_string("alice"),
+            ConnectionId::from_string("alice2"),
+        ]);
+        assert_eq!(
+            handle
+                .outgoing_connections()
+                .cloned()
+                .collect::<BTreeSet<_>>(),
