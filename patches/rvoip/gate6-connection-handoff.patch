+    assert_eq!(
+        handle.finish_local_media_cleanup(deadline()).await,
+        HandoffCleanupOutcome::Unconfirmed
+    );
+    r.publish("bob", 2400).unwrap();
+    r.tick();
+    r.heard("consult", 2400).await;
+    r.silent(&["alice", "public"]);
+    r.publish("consult", 5200).unwrap();
+    r.tick();
+    r.heard("bob", 5200).await;
+    r.silent(&["alice", "public"]);
+    assert_eq!(
+        r.nodes["bob"].controller.active_bindings()[0].transport_id,
+        before.transport_id
+    );
+    r.nodes["alice"]
+        .adapter
+        .uncertain
+        .store(false, Ordering::Release);
+    assert_eq!(
+        handle.finish_local_media_cleanup(deadline()).await,
+        HandoffCleanupOutcome::LocalMediaClosed
+    );
+    assert_eq!(
+        r.nodes["alice"].adapter.outstanding.load(Ordering::Acquire),
+        0
+    );
+    r.publish("bob", 2400).unwrap();
+    r.tick();
+    r.heard("consult", 2400).await;
