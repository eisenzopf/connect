+#[tokio::test]
+async fn handoff_observer_commits_only_new_bridge_and_retains_decoded_authorized_observation() {
+    let mut r = Room::new().await;
+    let context = r.handoff_ready().await;
+    let original = r
+        .nodes
+        .iter()
+        .map(|(id, n)| (id.clone(), n.controller.active_bindings()[0].clone()))
+        .collect::<BTreeMap<_, _>>();
+    r.publish("consult", 5200).unwrap();
+    r.tick();
+    let private_tail = r.nodes.get_mut("alice").unwrap().out.try_recv().unwrap();
+    let plan = r
+        .scene
+        .plan_audio_handoff(
+            context.audience(),
+            r.handoff_request(OldHandoffDisposition::Observer),
+        )
+        .unwrap();
+    let (outcome, handle) = r.handoff(plan).await.unwrap();
+    assert_eq!(outcome.retained, ConnectionId::from_string("bob"));
+    assert_eq!(outcome.admitted, ConnectionId::from_string("consult"));
+    assert_eq!(outcome.observer, Some(ConnectionId::from_string("alice")));
+    assert!(outcome.retiring.is_empty());
+    assert_eq!(outcome.cleanup, HandoffCleanupOutcome::NotRequested);
+    assert!(private_tail
+        .deliver(|_| async { panic!("old private tail crossed handoff") })
+        .await
+        .is_err());
+    assert!(r.publish("alice", 800).is_err());
+    r.publish("bob", 2400).unwrap();
+    r.tick();
+    r.heard("consult", 2400).await;
+    r.heard("alice", 2400).await;
+    r.silent(&["public", "bob"]);
+    r.publish("consult", 5200).unwrap();
+    r.tick();
+    r.heard("bob", 5200).await;
+    r.heard("alice", 5200).await;
+    r.silent(&["public", "consult"]);
+    for (id, before) in original {
+        let now = &r.nodes[&id].controller.active_bindings()[0];
+        assert_eq!(now.transport_id, before.transport_id);
+        assert_eq!(now.stream_local_id, before.stream_local_id);
+        assert_eq!(now.connection_generation, before.connection_generation);
+    }
+    // A simple source unmute cannot turn the committed observer into a speaker.
+    let c = &r.nodes["alice"].controller;
+    c.set_media_gate(
+        c.revision(),
+        &BTreeSet::from([desired(Medium::Audio).logical_id]),
+        StreamGateAction::Unmute,
+        deadline(),
+    )
+    .await
+    .unwrap();
+    assert!(r.publish("alice", 800).is_err());
+    assert!(r
+        .scene
+        .plan_restore_audio_audience(
+            context.audience(),
+            "old-private-restore".into(),
+            r.scene.audience_revision()
+        )
+        .is_err());
+    assert!(r
+        .scene
+        .plan_restore_audio_audience(
+            handle.audience(),
+            "implicit-rollback".into(),
+            r.scene.audience_revision()
+        )
+        .is_err());
+    drop(
+        tokio::time::timeout(Duration::from_secs(1), r.domain.base.0.write())
+            .await
+            .unwrap(),
+    );
