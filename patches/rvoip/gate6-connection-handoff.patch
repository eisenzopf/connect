+#[tokio::test]
+async fn actual_tls_managed_handoff_current_role_denial_and_queued_writer_keep_one_authoritative_commit(
+) {
+    let s = Scene::new_handoff("quic").await;
+    let context = private_context(&s).await;
+    let revision = s.core.orch.participant_revision(&s.core.session).unwrap();
+    let audience = s
+        .core
+        .orch
+        .audio_audience_revision(&s.core.session)
+        .unwrap();
+    let plan = s
+        .core
+        .orch
+        .plan_staged_audio_handoff(
+            &s.core.session,
+            revision,
+            "role-race-correlation".into(),
+            ParticipantRole::Agent,
+            &context,
+            AudioHandoffRequest {
+                operation_id: "native-role-race".into(),
+                expected_revision: audience,
+                old: s.live[0].leg.id.clone(),
+                retained: s.live[1].leg.id.clone(),
+                admitted: s.live[2].leg.id.clone(),
+                old_disposition: OldHandoffDisposition::Observer,
+            },
+        )
+        .unwrap();
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&s.live[0].leg.id)
+        .unwrap()
+        .may_control = false;
+    let invocation = grant(&s, Approval::Handoff(plan.clone())).await;
+    assert!(matches!(
+        s.core
+            .orch
+            .commit_staged_audio_handoff_with_held(
+                &s.core.session,
+                invocation.principal.clone(),
+                plan.clone(),
+                deadline(),
+                CancellationToken::new(),
+                &invocation
+            )
+            .await,
+        Err(ParticipantControlError::Authority)
+    ));
+    drop(invocation);
+    assert_eq!(
+        s.core.orch.participant_revision(&s.core.session).unwrap(),
+        revision
+    );
+    assert_eq!(
+        s.core
+            .orch
+            .audio_audience_revision(&s.core.session)
+            .unwrap(),
+        audience
+    );
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&s.live[0].leg.id)
+        .unwrap()
+        .may_control = true;
+    let invocation = grant(&s, Approval::Handoff(plan.clone())).await;
+    let writer = tokio::spawn({
+        let domain = s.grants.0.clone();
+        let old = s.live[0].leg.id.clone();
+        async move {
+            domain
+                .write()
+                .await
+                .owners
+                .get_mut(&old)
+                .unwrap()
+                .may_control = false;
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    assert!(!writer.is_finished());
+    let (outcome, _) = tokio::time::timeout(
+        Duration::from_secs(1),
+        s.core.orch.commit_staged_audio_handoff_with_held(
+            &s.core.session,
+            invocation.principal.clone(),
+            plan.clone(),
+            deadline(),
+            CancellationToken::new(),
+            &invocation,
+        ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(
+        outcome.media.participant_handoff.as_ref().unwrap().revision,
+        revision + 1
+    );
+    drop(invocation);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    let invocation = grant(&s, Approval::Handoff(plan.clone())).await;
+    assert!(matches!(
+        s.core.orch.replay_staged_audio_handoff(
+            &s.core.session,
+            &invocation.principal,
+            &plan,
+            &invocation
+        ),
+        Err(ParticipantControlError::Authority)
+    ));
+    drop(invocation);
+    assert_eq!(
+        s.core.orch.participant_revision(&s.core.session).unwrap(),
+        revision + 1
+    );
+    s.tone(2, 1).await;
+    s.tone(1, 2).await;
+    s.stop().await;
+}
