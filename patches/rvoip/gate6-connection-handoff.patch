+++ b/crates/uctp/rvoip-uctp/tests/support/canonical_media/guarded_mixer/handoff.rs
@@ -0,0 +1,641 @@
+//! Distinct signed TLS identities through the actual managed Session commit.
+use super::*;
+use rvoip_core::{
+    orchestrator::participant_control::{
+        ControlResult as ParticipantResult, ManagedAudioHandoffPlan, ParticipantControlError,
+        ParticipantHandoffAuthority, ParticipantHandoffControl, ParticipantHandoffLease,
+        ParticipantHandoffScope,
+    },
+    staged_streams::{
+        audience::*, handoff::*, ControlResult as MediaResult, MediaAuthorityLease, MediaControl,
+        MediaControlIntent, MediaPolicy, MediaScope, MediaSource, StreamControlError,
+    },
+};
+use std::any::Any;
+use tokio::sync::OwnedRwLockReadGuard;
+enum Approval {
+    Audience(AudioAudiencePlan),
+    Handoff(ManagedAudioHandoffPlan),
+}
+struct Invocation {
+    domain: Arc<MediaGrants>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    approval: Approval,
+    principal: AuthenticatedPrincipal,
+}
+struct Lease {
+    invocation: Arc<Invocation>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_receive(&self, source: &MediaSource) -> MediaResult<Box<MediaOwner>> {
+        let original = self
+            .invocation
+            .guard
+            .owners
+            .get(&source.connection)
+            .ok_or(StreamControlError::Authority)?;
+        original
+            .connection
+            .require_current(&original.member, &original.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if self.invocation.guard.private
+            || self.invocation.guard.denied.contains(&source.connection)
+            || source.conversation != *original.member.conversation()
+            || source.session != *original.presence.session()
+            || source.participant != *original.member.participant()
+            || source.membership_epoch != original.member.epoch()
+            || source.connection_generation != original.connection.generation()
+            || !original.receive_media.contains(&Medium::Audio)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut target = self.owner.clone();
+        target.may_route_source = true;
+        Ok(Box::new(target))
+    }
+}
+pub(super) struct Media(pub Arc<MediaGrants>);
+impl MediaPolicy for Media {
+    fn current(&self, scope: &MediaScope<'_>) -> MediaResult<Box<dyn MediaAuthorityLease>> {
+        self.0.current(scope)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> MediaResult<MediaControl> {
+        let invocation = held
+            .downcast_ref::<Arc<Invocation>>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.0, &invocation.domain)
+            || invocation.guard.private
+            || invocation.guard.denied.contains(scope.connection)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let approved = match (&invocation.approval, intent) {
+            (Approval::Audience(approved), MediaControlIntent::AudioAudience { plan }) => {
+                approved.same_intent(plan)
+            }
+            (Approval::Handoff(approved), MediaControlIntent::Handoff { plan }) => {
+                approved.media().audience().same_intent(plan)
+            }
+            _ => false,
+        };
+        if !approved {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = invocation
+            .guard
+            .owners
+            .get(scope.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        owner
+            .actor
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        MediaControl::new(
+            Box::new(Lease {
+                invocation: invocation.clone(),
+                owner,
+            }),
+            CancellationToken::new(),
+            deadline(),
+        )
+    }
+}
+pub(super) struct Roles {
+    pub base: Arc<core_fixture::TestPolicy>,
+    pub domain: Arc<MediaGrants>,
+}
+struct RoleLease(Arc<Invocation>);
+impl ParticipantHandoffLease for RoleLease {
+    fn current(
+        &self,
+        scope: &ParticipantHandoffScope<'_>,
+    ) -> ParticipantResult<ParticipantHandoffAuthority> {
+        let Approval::Handoff(plan) = &self.0.approval else {
+            return Err(ParticipantControlError::Authority);
+        };
+        if !plan.same_intent(scope.plan)
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &self.0.principal,
+                scope.principal,
+            )
+            || self.0.guard.private
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let request = plan.media().request();
+        if self.0.guard.denied.contains(&request.old)
+            || self.0.guard.denied.contains(&request.admitted)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let old = self
+            .0
+            .guard
+            .owners
+            .get(&request.old)
+            .ok_or(ParticipantControlError::Authority)?;
+        let new = self
+            .0
+            .guard
+            .owners
+            .get(&request.admitted)
+            .ok_or(ParticipantControlError::Authority)?;
+        if !old.may_control || !new.may_control {
+            return Err(ParticipantControlError::Authority);
+        }
+        old.actor
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| ParticipantControlError::Authority)?;
+        Ok(ParticipantHandoffAuthority {
+            actor: old.actor.clone(),
+            outgoing: old.member.clone(),
+            incoming: new.member.clone(),
+            incoming_may_send_audio: new.receive_media.contains(&Medium::Audio),
+            outgoing_may_receive_audio: old.send_media.contains(&Medium::Audio),
+        })
+    }
+}
+impl ParticipantPolicy for Roles {
+    fn current(
+        &self,
+        scope: &ParticipantScope<'_>,
+    ) -> ParticipantResult<Box<dyn ParticipantAuthorityLease + '_>> {
+        self.base.current(scope)
+    }
+    fn current_handoff_control(
+        &self,
+        scope: &ParticipantHandoffScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ParticipantResult<ParticipantHandoffControl> {
+        let invocation = held
+            .downcast_ref::<Arc<Invocation>>()
+            .ok_or(ParticipantControlError::Authority)?;
+        if !Arc::ptr_eq(&self.domain, &invocation.domain) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let lease = RoleLease(invocation.clone());
+        let _ = lease.current(scope)?;
+        ParticipantHandoffControl::new(Box::new(lease), CancellationToken::new(), deadline())
+    }
+}
+async fn grant(s: &Scene, approval: Approval) -> Arc<Invocation> {
+    Arc::new(Invocation {
+        domain: s.grants.clone(),
+        guard: Arc::new(s.grants.0.clone().read_owned().await),
+        approval,
+        principal: named_actor("alice"),
+    })
+}
+async fn private_context(s: &Scene) -> AudioAudienceHandle {
+    let source = |index: usize| {
+        vec![
+            rvoip_core::staged_streams::audio_subscriptions::AudioSubscription::Connection(
+                s.live[index].leg.id.clone(),
+            ),
+        ]
+    };
+    let plan = s
+        .core
+        .orch
+        .plan_staged_audio_audience(
+            &s.core.session,
