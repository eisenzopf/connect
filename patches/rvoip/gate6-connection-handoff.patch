+                .ok_or(StreamControlError::NotReady)?;
+            let retained = &members
+                .get(&request.retained)
+                .ok_or(StreamControlError::NotReady)?
+                .controller;
+            if old.origin_member.participant() == new.controller.origin_member.participant()
+                || retained.origin_member.participant() == old.origin_member.participant()
+                || retained.origin_member.participant()
+                    == new.controller.origin_member.participant()
+            {
+                return Err(MediaTransitionError::Invalid.into());
+            }
+            if !context.group.contains(old)
+                || !context.group.contains(&new.controller)
+                || context.group.contains(retained)
+            {
+                return Err(StreamControlError::Authority);
+            }
+            let state = new
+                .controller
+                .state
+                .try_lock()
+                .map_err(|_| MediaTransitionError::Conflict)?;
+            let readiness =
+                new.audio_consumer
+                    .duplex_since(&new.controller, context.committed_at, &state)?;
+            let outgoing = members
+                .values()
+                .filter(|m| {
+                    m.controller.origin_member.participant() == old.origin_member.participant()
+                })
