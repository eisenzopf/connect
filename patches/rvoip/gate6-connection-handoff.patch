+            || request.old == request.retained
+            || request.old == request.admitted
+            || request.retained == request.admitted
+            || context.group.origins.len() != 2
+        {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        let (origins, readiness, outgoing) = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+            if !registry
+                .groups
+                .get(&context.group.operation)
+                .is_some_and(|g| Arc::ptr_eq(g, &context.group))
+            {
