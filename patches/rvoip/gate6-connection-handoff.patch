+#[tokio::test]
+async fn handoff_cancelled_or_timed_out_actual_send_drain_preserves_private_bridge_and_retry_intent(
+) {
+    for timeout in [false, true] {
+        let mut r = Room::new().await;
+        let context = r.handoff_ready().await;
+        r.publish("alice", 800).unwrap();
+        r.tick();
+        let queued = r.nodes.get_mut("consult").unwrap().out.try_recv().unwrap();
+        let entered = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        let sending = tokio::spawn({
+            let entered = entered.clone();
+            let release = release.clone();
+            async move {
+                queued
+                    .deliver(|_| async move {
+                        entered.notify_one();
+                        release.notified().await;
+                        Ok(())
+                    })
+                    .await
+            }
+        });
+        entered.notified().await;
+        let plan = r
+            .scene
+            .plan_audio_handoff(
+                context.audience(),
+                r.handoff_request(OldHandoffDisposition::Leave),
+            )
+            .unwrap();
+        let grant = r.grant(Approval::Audience(plan.audience().clone())).await;
+        let revisions = r
+            .nodes
+            .iter()
+            .map(|(id, n)| (id.clone(), n.controller.revision()))
+            .collect::<BTreeMap<_, _>>();
+        let before = r.scene.audience_revision();
+        let cancel = CancellationToken::new();
+        let work = tokio::spawn({
+            let scene = r.scene.clone();
+            let cancel = cancel.clone();
+            async move {
+                scene
+                    .commit_audio_handoff(
+                        plan,
+                        if timeout {
+                            tokio::time::Instant::now() + Duration::from_millis(30)
+                        } else {
+                            deadline()
+                        },
+                        cancel,
+                        &grant,
+                    )
+                    .await
+            }
+        });
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert!(!work.is_finished());
+        if !timeout {
+            cancel.cancel();
+        }
+        let result = work.await.unwrap();
+        if timeout {
+            assert!(matches!(result, Err(StreamControlError::Deadline)));
+        } else {
+            assert!(matches!(result, Err(StreamControlError::Cancelled)));
+        }
+        assert!(!r.nodes["alice"].controller.shutdown.is_cancelled());
+        assert_eq!(r.scene.audience_revision(), before);
+        for (id, rev) in revisions {
+            assert_eq!(
+                r.nodes[&id].controller.revision(),
+                rev,
+                "partial commit for {id}"
+            );
+        }
+        release.notify_one();
+        sending.await.unwrap().unwrap();
+        r.publish("alice", 800).unwrap();
+        r.tick();
+        r.heard("consult", 800).await;
+        r.silent(&["bob", "public"]);
+        let plan = r
+            .scene
+            .plan_audio_handoff(
+                context.audience(),
+                r.handoff_request(OldHandoffDisposition::Leave),
+            )
+            .unwrap();
+        let (outcome, handle) = r.handoff(plan).await.unwrap();
+        assert_eq!(outcome.media.operation_id, "handoff-1");
+        assert_eq!(
+            handle.finish_local_media_cleanup(deadline()).await,
+            HandoffCleanupOutcome::LocalMediaClosed
+        );
+        r.publish("consult", 5200).unwrap();
+        r.tick();
+        r.heard("bob", 5200).await;
+    }
+}
