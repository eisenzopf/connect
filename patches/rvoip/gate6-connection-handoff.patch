+//! Current operator authority and one managed Session/media commit fence.
+use super::*;
+use crate::participant_transitions::{
+    ParticipantHandoffDisposition, ParticipantHandoffMutation, ParticipantHandoffObservation,
+    PreparedParticipantHandoff,
+};
+use crate::staged_streams::{
+    audience::AudioAudiencePlan,
+    handoff::{AudioHandoffPlan, OldHandoffDisposition},
+    StreamControlError,
+};
+#[derive(Clone)]
+pub struct ManagedAudioHandoffPlan {
+    pub(super) media: AudioHandoffPlan,
+    pub(super) expected_revision: u64,
+    pub(super) correlation_id: String,
+    pub(super) incoming_role: ParticipantRole,
+}
+impl ManagedAudioHandoffPlan {
+    pub fn media(&self) -> &AudioHandoffPlan {
+        &self.media
+    }
+    pub fn expected_participant_revision(&self) -> u64 {
+        self.expected_revision
+    }
+    pub fn incoming_role(&self) -> &ParticipantRole {
+        &self.incoming_role
+    }
+    pub fn same_intent(&self, other: &Self) -> bool {
+        self.expected_revision == other.expected_revision
+            && self.correlation_id == other.correlation_id
+            && self.incoming_role == other.incoming_role
+            && self.media.audience().same_intent(other.media.audience())
+    }
+}
+pub struct ParticipantHandoffScope<'a> {
+    pub conversation: &'a ConversationId,
+    pub session: &'a SessionId,
+    pub principal: &'a AuthenticatedPrincipal,
+    pub plan: &'a ManagedAudioHandoffPlan,
+}
+pub struct ParticipantHandoffAuthority {
+    pub actor: Membership,
+    pub outgoing: Membership,
+    pub incoming: Membership,
+    /// Explicit current permission, independently of the requested role label.
+    pub incoming_may_send_audio: bool,
+    pub outgoing_may_receive_audio: bool,
+}
+pub trait ParticipantHandoffLease: Send + Sync {
+    fn current(
+        &self,
+        scope: &ParticipantHandoffScope<'_>,
+    ) -> ControlResult<ParticipantHandoffAuthority>;
+}
+pub struct ParticipantHandoffControl {
+    lease: Box<dyn ParticipantHandoffLease>,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl ParticipantHandoffControl {
+    pub fn new(
+        lease: Box<dyn ParticipantHandoffLease>,
+        cancellation: CancellationToken,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<Self> {
+        let value = Self {
+            lease,
+            cancellation,
+            deadline: deadline.min(tokio::time::Instant::now() + Duration::from_secs(30)),
+        };
+        value.check()?;
+        Ok(value)
+    }
+    fn check(&self) -> ControlResult<()> {
+        if self.cancellation.is_cancelled() {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(ParticipantControlError::Deadline);
+        }
+        Ok(())
+    }
+    pub(super) fn current(
+        &self,
+        scope: &ParticipantHandoffScope<'_>,
+    ) -> ControlResult<ParticipantHandoffAuthority> {
+        self.check()?;
+        let authority = self.lease.current(scope)?;
+        self.check()?;
+        Ok(authority)
+    }
+}
+fn media_error(error: ParticipantControlError) -> StreamControlError {
+    match error {
+        ParticipantControlError::Media(e) => e,
+        ParticipantControlError::Cancelled => StreamControlError::Cancelled,
+        ParticipantControlError::Deadline => StreamControlError::Deadline,
+        ParticipantControlError::Unsupported => StreamControlError::Unsupported,
+        ParticipantControlError::Transition(
+            ParticipantTransitionError::Conflict | ParticipantTransitionError::Capacity,
+        ) => crate::stream_lifecycle::MediaTransitionError::Conflict.into(),
+        _ => StreamControlError::Authority,
+    }
+}
+pub(crate) struct ManagedHandoffContext {
+    pub(super) owner: Arc<Orchestrator>,
+    pub(super) runtime: Arc<ManagedParticipantSession>,
+    pub(super) plan: ManagedAudioHandoffPlan,
+    pub(super) principal: AuthenticatedPrincipal,
+    pub(super) control: ParticipantHandoffControl,
+    pub(super) conversation: Arc<RwLock<Conversation>>,
+    pub(super) session: Arc<RwLock<Session>>,
+    pub(super) lifecycles: Vec<ConnectionLifecycleTicket>,
+}
+impl ManagedHandoffContext {
+    pub(crate) fn deadline(&self) -> tokio::time::Instant {
+        let mut deadline = self.control.deadline;
+        if let Some(expiry) = principal_expiry(&self.principal) {
+            deadline = deadline.min(
+                tokio::time::Instant::now() + (expiry - Utc::now()).to_std().unwrap_or_default(),
+            );
+        }
+        deadline
+    }
+    pub(crate) fn cancellation(&self) -> CancellationToken {
+        self.control.cancellation.clone()
+    }
+    fn authority(
+        &self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<ParticipantHandoffAuthority, StreamControlError> {
+        if !self.plan.media.audience().same_intent(plan) {
+            return Err(StreamControlError::Authority);
+        }
+        let authority = self
+            .control
+            .current(&ParticipantHandoffScope {
+                conversation: &self.runtime.conversation,
+                session: &self.runtime.session,
+                principal: &self.principal,
+                plan: &self.plan,
+            })
+            .map_err(media_error)?;
+        let (old, new) = self.plan.media.participants();
+        if authority.outgoing.participant() != &old
+            || authority.incoming.participant() != &new
+            || authority.actor.conversation() != &self.runtime.conversation
+            || authority.outgoing.conversation() != &self.runtime.conversation
+            || authority.incoming.conversation() != &self.runtime.conversation
+            || !authority.incoming_may_send_audio
+            || (self.plan.media.request().old_disposition == OldHandoffDisposition::Observer
+                && !authority.outgoing_may_receive_audio)
+            || self.plan.incoming_role == ParticipantRole::Observer
+        {
+            return Err(StreamControlError::Authority);
+        }
+        authority
+            .actor
+            .revalidate_principal(&self.principal, Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        Ok(authority)
+    }
+    pub(crate) fn check(
+        &self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<(), StreamControlError> {
+        self.authority(plan).map(|_| ())
+    }
+    pub(crate) fn lock<'a>(
+        &'a self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<ManagedHandoffGuard<'a>, StreamControlError> {
+        // Same lock order as ordinary managed participant publication. No
+        // mutex or live current-authority lookup is held over an IO await.
+        let mixer = self
+            .runtime
+            .mixer
+            .members
+            .try_lock()
+            .map_err(|_| crate::stream_lifecycle::MediaTransitionError::Conflict)?;
+        let state = self.runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+        let registry = self
+            .owner
+            .connection_registry_lock
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let lifecycles = self
+            .owner
+            .lock_connection_lifecycles(&self.lifecycles)
+            .map_err(|e| media_error(e.into()))?;
+        if lifecycles.iter().any(|state| {
+            state
+                .peer_admission
+                .as_ref()
+                .is_some_and(|p| p.peer.is_closed())
+        }) {
+            return Err(StreamControlError::Cancelled);
+        }
+        let conversation = self.conversation.write().unwrap_or_else(|p| p.into_inner());
+        let session = self.session.write().unwrap_or_else(|p| p.into_inner());
+        if state.ended
+            || state.controller.revision() != self.plan.expected_revision
+            || conversation.state != ConversationState::Open
+            || matches!(
+                session.state,
+                SessionState::Ending | SessionState::Ended | SessionState::Failed
+            )
+        {
+            return Err(crate::stream_lifecycle::MediaTransitionError::Conflict.into());
+        }
+        let authority = self.authority(plan)?;
+        let request = self.plan.media.request();
+        let outgoing = state
+            .controller
+            .connections(authority.outgoing.participant())
+            .into_iter()
+            .collect::<std::collections::BTreeSet<_>>();
+        if outgoing != self.plan.media.outgoing_connections() {
+            return Err(crate::stream_lifecycle::MediaTransitionError::Conflict.into());
+        }
+        for id in outgoing
+            .iter()
+            .chain([&request.retained, &request.admitted])
+        {
+            if !self
+                .owner
+                .adapter_for(id)
+                .is_ok_and(|a| a.is_connection_live(id))
+            {
+                return Err(StreamControlError::NotReady);
+            }
+            if !session.connections.contains_key(id)
+                || !state.routes.get(id).is_some_and(|r| {
+                    self.lifecycles.iter().any(|ticket| {
+                        ticket.connection_id == *id
+                            && ticket.generation == r.lifecycle.generation
+                            && Arc::ptr_eq(&ticket.state, &r.lifecycle.state)
+                    })
+                })
+            {
+                return Err(StreamControlError::NotReady);
+            }
+        }
+        let mutation = ParticipantHandoffMutation {
+            operation_id: request.operation_id.clone(),
+            correlation_id: self.plan.correlation_id.clone(),
+            expected_revision: self.plan.expected_revision,
+            outgoing: authority.outgoing.participant().clone(),
+            incoming: authority.incoming.participant().clone(),
+            retained: request.retained.clone(),
+            admitted: request.admitted.clone(),
+            incoming_role: self.plan.incoming_role.clone(),
+            outgoing_disposition: match request.old_disposition {
+                OldHandoffDisposition::Observer => ParticipantHandoffDisposition::Observe,
+                OldHandoffDisposition::Leave => ParticipantHandoffDisposition::Leave,
+            },
+        };
+        let prepared = state
+            .controller
+            .prepare_handoff(
+                &authority.actor,
+                &authority.outgoing,
+                &authority.incoming,
+                mutation,
+            )
+            .map_err(|e| media_error(e.into()))?;
+        Ok(ManagedHandoffGuard {
+            context: self,
+            _mixer: mixer,
+            state,
+            _registry: registry,
+            lifecycles,
+            conversation,
+            session,
+            prepared: Some(prepared),
+        })
+    }
+}
+pub(crate) struct ManagedHandoffGuard<'a> {
+    context: &'a ManagedHandoffContext,
+    _mixer: tokio::sync::MutexGuard<'a, HashMap<ConnectionId, ConferenceMember>>,
+    state: std::sync::MutexGuard<'a, ManagedState>,
+    _registry: std::sync::MutexGuard<'a, ()>,
+    lifecycles: Vec<std::sync::MutexGuard<'a, ConnectionLifecycleState>>,
+    conversation: std::sync::RwLockWriteGuard<'a, Conversation>,
+    session: std::sync::RwLockWriteGuard<'a, Session>,
+    prepared: Option<PreparedParticipantHandoff>,
+}
+impl ManagedHandoffGuard<'_> {
+    pub(crate) fn check(
+        &self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<(), StreamControlError> {
+        self.context.check(plan)
+    }
+    pub(crate) fn commit(&mut self) -> ParticipantHandoffObservation {
+        let observation = self
+            .state
+            .controller
+            .commit_handoff(self.prepared.take().expect("one managed handoff commit"));
+        for id in &observation.retired {
+            self.session.connections.remove(id);
+            self.context.owner.sessions_by_connection.remove(id);
+            self.state.routes.remove(id);
+            let index = self
+                .context
+                .lifecycles
+                .iter()
+                .position(|ticket| ticket.connection_id == *id)
+                .expect("validated outgoing lifecycle");
+            let state = &mut self.lifecycles[index];
+            state.active = false;
+            state.retired = true;
+            if let Some(permit) = &state.peer_admission {
+                permit.retire_delivery();
+            }
+            state.generation = state.generation.saturating_add(1);
+        }
+        if observation.outgoing_role.is_none() {
+            self.session.participants.remove(&observation.outgoing);
+            for pending in self
+                .state
+                .pending
+                .values()
+                .filter(|p| p.participant == observation.outgoing)
+            {
+                pending.cancellation.cancel();
+            }
+        }
+        self.conversation.last_activity_at = Utc::now();
+        let _ = self
+            .context
+            .runtime
+            .events
+            .send(ParticipantRuntimeEvent::HandoffCommitted(
+                observation.clone(),
+            ));
+        observation
+    }
+}
