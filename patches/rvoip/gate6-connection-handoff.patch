+            let mut origins = [old, &new.controller, retained]
+                .into_iter()
+                .map(|c| (c.connection.clone(), AudienceOrigin::new(c)))
+                .collect::<BTreeMap<_, _>>();
+            origins.extend(outgoing.clone());
+            (origins, readiness, outgoing)
+        };
+        let source = |id: ConnectionId| vec![AudioSubscription::Connection(id)];
+        let mut private_connections =
+            BTreeSet::from([request.retained.clone(), request.admitted.clone()]);
+        let old_program = if request.old_disposition == OldHandoffDisposition::Observer {
+            private_connections.extend(outgoing.keys().cloned());
+            vec![
+                AudioSubscription::Connection(request.retained.clone()),
+                AudioSubscription::Connection(request.admitted.clone()),
+            ]
+        } else {
+            vec![]
+        };
+        let mut receivers = BTreeMap::from([
+            (request.retained.clone(), source(request.admitted.clone())),
+            (request.admitted.clone(), source(request.retained.clone())),
+        ]);
+        for id in outgoing.keys() {
+            receivers.insert(id.clone(), old_program.clone());
+        }
+        let mut audience = self.plan_audio_audience_replacing(
+            AudioAudienceRequest {
+                operation_id: request.operation_id.clone(),
+                expected_revision: request.expected_revision,
+                private_connections,
+                receivers,
+                activate_muted: None,
+            },
+            Some(context),
+        )?;
+        for (id, origin) in &origins {
+            if !audience
+                .controllers
+                .get(id)
+                .is_some_and(|c| Weak::ptr_eq(c, &origin.controller))
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+        }
+        audience.handoff = Some(Arc::new(HandoffIntent {
+            request,
+            origins,
+            readiness,
+            outgoing,
+        }));
+        Ok(AudioHandoffPlan { audience })
+    }
+    pub(crate) async fn commit_audio_handoff(
+        &self,
+        plan: AudioHandoffPlan,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<(AudioHandoffOutcome, AudioHandoffHandle)> {
+        self.commit_audio_handoff_managed(plan, deadline, cancel, held, None)
+            .await
+    }
+    pub(crate) async fn commit_audio_handoff_managed(
+        &self,
+        plan: AudioHandoffPlan,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+        managed: Option<crate::orchestrator::participant_control::handoff::ManagedHandoffContext>,
+    ) -> ControlResult<(AudioHandoffOutcome, AudioHandoffHandle)> {
+        let intent = plan
+            .audience
+            .handoff
+            .clone()
+            .ok_or(StreamControlError::Authority)?;
+        let (media, audience) = self
+            .apply_audio_audience_managed(plan.audience, deadline, cancel, held, managed)
+            .await?;
+        let request = &intent.request;
+        let leaving = request.old_disposition == OldHandoffDisposition::Leave;
+        if leaving {
+            for id in intent.outgoing.keys() {
+                self.remove(id);
+            }
+        }
+        Ok((
+            AudioHandoffOutcome {
+                media,
+                retained: request.retained.clone(),
+                admitted: request.admitted.clone(),
+                observer: (!leaving).then(|| request.old.clone()),
+                observer_connections: if leaving {
+                    BTreeSet::new()
+                } else {
+                    intent.outgoing.keys().cloned().collect()
+                },
+                retiring: if leaving {
+                    intent.outgoing.keys().cloned().collect()
+                } else {
+                    BTreeSet::new()
+                },
+                cleanup: if leaving {
+                    HandoffCleanupOutcome::Pending
+                } else {
+                    HandoffCleanupOutcome::NotRequested
+                },
+            },
+            AudioHandoffHandle {
+                audience,
+                old: intent.origins[&request.old].clone(),
+                outgoing: intent.outgoing.clone(),
+                disposition: request.old_disposition,
+            },
+        ))
+    }
+}
