+#[tokio::test]
+async fn actual_tls_managed_handoff_commits_role_and_media_together_with_retained_remote_connection(
+) {
+    for kind in ["quic", "wt"] {
+        for disposition in [
+            OldHandoffDisposition::Observer,
+            OldHandoffDisposition::Leave,
+        ] {
+            let s = Scene::new_handoff(kind).await;
+            let context = private_context(&s).await;
+            let remote = binding(&s.live[1].leg, Medium::Audio);
+            let session = s.core.session.clone();
+            let revision = s.core.orch.participant_revision(&session).unwrap();
+            let plan = s
+                .core
+                .orch
+                .plan_staged_audio_handoff(
+                    &session,
+                    revision,
+                    "native-handoff-correlation".into(),
+                    ParticipantRole::Agent,
+                    &context,
+                    AudioHandoffRequest {
+                        operation_id: "native-managed-handoff".into(),
+                        expected_revision: s.core.orch.audio_audience_revision(&session).unwrap(),
+                        old: s.live[0].leg.id.clone(),
+                        retained: s.live[1].leg.id.clone(),
+                        admitted: s.live[2].leg.id.clone(),
+                        old_disposition: disposition,
+                    },
+                )
+                .unwrap();
+            let replay_plan = plan.clone();
+            let invocation = grant(&s, Approval::Handoff(plan.clone())).await;
+            let (outcome, handle) = s
+                .core
+                .orch
+                .commit_staged_audio_handoff_with_held(
+                    &session,
+                    invocation.principal.clone(),
+                    plan,
+                    deadline(),
+                    CancellationToken::new(),
+                    &invocation,
+                )
+                .await
+                .unwrap();
+            drop(invocation);
+            let logical = outcome
+                .media
+                .participant_handoff
+                .as_ref()
+                .expect("managed logical observation");
+            let replay_grant = grant(&s, Approval::Handoff(replay_plan.clone())).await;
+            let replay = s
+                .core
+                .orch
+                .replay_staged_audio_handoff(
+                    &session,
+                    &replay_grant.principal,
+                    &replay_plan,
+                    &replay_grant,
+                )
+                .unwrap()
+                .unwrap();
+            assert_eq!(&replay, logical);
+            drop(replay_grant);
+            assert_eq!(logical.revision, revision + 1);
+            assert_eq!(logical.retained, s.live[1].leg.id);
+            assert_eq!(logical.admitted, s.live[2].leg.id);
+            assert_eq!(
+                s.core
+                    .orch
+                    .participant_session_role(&session, &core_fixture::participant("alice"))
+                    .unwrap(),
+                if disposition == OldHandoffDisposition::Observer {
+                    Some(ParticipantRole::Observer)
+                } else {
+                    None
+                }
+            );
+            assert_eq!(
+                s.core
+                    .orch
+                    .participant_session_role(&session, &core_fixture::participant("carol"))
+                    .unwrap(),
+                Some(ParticipantRole::Agent)
+            );
+            assert_eq!(
+                s.core.orch.participant_revision(&session).unwrap(),
+                revision + 1
+            );
+            s.tone(2, 1).await;
+            s.tone(1, 2).await;
+            if disposition == OldHandoffDisposition::Observer {
+                s.tone(2, 0).await;
+                s.no_tone(0, 1).await;
+            } else {
+                assert!(outcome.retiring.contains(&s.live[0].leg.id));
+                let _ = handle.finish_local_media_cleanup(deadline()).await;
+            }
+            assert_eq!(
+                binding(&s.live[1].leg, Medium::Audio).transport_id,
+                remote.transport_id
+            );
+            assert_eq!(s.core.session, session);
+            s.stop().await;
+        }
+    }
