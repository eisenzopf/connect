+//! One local role/departure revision paired with an actual media handoff.
+//! The owning coordinator supplies fresh authorized memberships and commits the
+//! opaque candidate only inside the same synchronous graph publication fence.
+use super::*;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ParticipantHandoffDisposition {
+    Observe,
+    Leave,
+}
+#[derive(Clone, PartialEq, Eq)]
+pub struct ParticipantHandoffMutation {
+    pub operation_id: String,
+    pub correlation_id: String,
+    pub expected_revision: u64,
+    pub outgoing: ParticipantId,
+    pub incoming: ParticipantId,
+    pub retained: ConnectionId,
+    pub admitted: ConnectionId,
+    pub incoming_role: ParticipantRole,
+    pub outgoing_disposition: ParticipantHandoffDisposition,
+}
+#[derive(Clone, PartialEq, Eq)]
+pub struct ParticipantHandoffObservation {
+    pub session: SessionId,
+    pub operation_id: String,
+    pub correlation_id: String,
+    pub revision: u64,
+    pub outgoing: ParticipantId,
+    pub outgoing_epoch: u64,
+    pub incoming: ParticipantId,
+    pub incoming_epoch: u64,
+    pub outgoing_role: Option<ParticipantRole>,
+    pub incoming_role: ParticipantRole,
+    pub retained: ConnectionId,
+    pub admitted: ConnectionId,
+    pub retired: Vec<ConnectionId>,
+}
+#[derive(Clone)]
+pub(super) struct HandoffReceipt {
+    actor_identity: IdentityId,
+    actor_participant: ParticipantId,
+    actor_epoch: u64,
+    outgoing_identity: IdentityId,
+    incoming_identity: IdentityId,
+    intent: ParticipantHandoffMutation,
+    observation: ParticipantHandoffObservation,
+}
+pub(crate) struct PreparedParticipantHandoff {
+    expected: u64,
+    next: ParticipantSession,
+    observation: ParticipantHandoffObservation,
+}
+impl ParticipantSession {
+    pub fn replay_handoff(
+        &self,
+        actor: &Membership,
+        outgoing: &Membership,
+        incoming: &Membership,
+        intent: &ParticipantHandoffMutation,
+    ) -> Result<Option<ParticipantHandoffObservation>> {
+        identifier(&intent.operation_id)?;
+        identifier(&intent.correlation_id)?;
+        self.check_member(actor, true)?;
+        // History is metadata: current authorization belongs to the owner.
+        // An authorized status read may name a departed target, but never lend
+        // its receipt to a different identity or membership epoch.
+        self.check_member(outgoing, false)?;
+        self.check_member(incoming, false)?;
+        if outgoing.participant() != &intent.outgoing
+            || incoming.participant() != &intent.incoming
+            || outgoing.participant() == incoming.participant()
+        {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        let key = (actor.participant().clone(), intent.operation_id.clone());
+        if self.receipts.contains_key(&key) {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if let Some(old) = self.handoffs.get(&key) {
+            if old.actor_identity != *actor.identity()
+                || old.actor_participant != *actor.participant()
+                || old.actor_epoch != actor.epoch()
+                || old.outgoing_identity != *outgoing.identity()
+                || old.incoming_identity != *incoming.identity()
+                || old.observation.outgoing_epoch != outgoing.epoch()
+                || old.observation.incoming_epoch != incoming.epoch()
+            {
+                return Err(ParticipantTransitionError::OwnerMismatch);
+            }
+            let mut actual = intent.clone();
+            actual.correlation_id = old.intent.correlation_id.clone();
+            if actual != old.intent {
+                return Err(ParticipantTransitionError::Conflict);
+            }
+            return Ok(Some(old.observation.clone()));
+        }
+        Ok(None)
+    }
+    pub(crate) fn prepare_handoff(
+        &self,
+        actor: &Membership,
+        outgoing: &Membership,
+        incoming: &Membership,
+        intent: ParticipantHandoffMutation,
+    ) -> Result<PreparedParticipantHandoff> {
+        if self
+            .replay_handoff(actor, outgoing, incoming, &intent)?
+            .is_some()
+        {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        self.check_member(outgoing, true)?;
+        self.check_member(incoming, true)?;
+        if self.ended {
+            return Err(ParticipantTransitionError::Ended);
+        }
+        if self.revision != intent.expected_revision || self.revision >= MAX_REVISION {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if self.receipts.len() + self.handoffs.len() >= self.max_operations {
+            return Err(ParticipantTransitionError::Capacity);
+        }
+        if intent.incoming_role == ParticipantRole::Observer {
+            return Err(ParticipantTransitionError::Invalid);
+        }
+        let old = self
+            .participants
+            .get(outgoing.participant())
+            .ok_or(ParticipantTransitionError::Inactive)?;
+        let new = self
+            .participants
+            .get(incoming.participant())
+            .ok_or(ParticipantTransitionError::Inactive)?;
+        self.check_presence(outgoing, old)?;
+        self.check_presence(incoming, new)?;
+        old.appearance.require_current(outgoing)?;
+        new.appearance.require_current(incoming)?;
+        let admitted = new
+            .connections
+            .get(&intent.admitted)
+            .ok_or(ParticipantTransitionError::NotReady)?;
+        admitted.require_current(incoming, &new.appearance)?;
+        if !self.participants.iter().any(|(id, p)| {
+            id != outgoing.participant()
+                && id != incoming.participant()
+                && p.connections.contains_key(&intent.retained)
+        }) {
+            return Err(ParticipantTransitionError::NotReady);
+        }
+        let mut participants = self.participants.clone();
+        let mut appearance = new.appearance.clone();
+        appearance.change_role(
+            incoming,
+            appearance.revision(),
+            intent.incoming_role.clone(),
+        )?;
+        participants
+            .get_mut(incoming.participant())
+            .expect("validated incoming")
+            .appearance = appearance;
+        let (outgoing_role, retired) = match intent.outgoing_disposition {
+            ParticipantHandoffDisposition::Observe => {
+                let mut appearance = old.appearance.clone();
+                appearance.change_role(
+                    outgoing,
+                    appearance.revision(),
+                    ParticipantRole::Observer,
+                )?;
+                participants
+                    .get_mut(outgoing.participant())
+                    .expect("validated outgoing")
+                    .appearance = appearance;
+                (Some(ParticipantRole::Observer), vec![])
+            }
+            ParticipantHandoffDisposition::Leave => {
+                participants.remove(outgoing.participant());
+                (None, old.connections.keys().cloned().collect())
+            }
+        };
+        let observation = ParticipantHandoffObservation {
+            session: self.session.clone(),
+            operation_id: intent.operation_id.clone(),
+            correlation_id: intent.correlation_id.clone(),
+            revision: self.revision + 1,
+            outgoing: intent.outgoing.clone(),
+            outgoing_epoch: outgoing.epoch(),
+            incoming: intent.incoming.clone(),
+            incoming_epoch: incoming.epoch(),
+            outgoing_role,
+            incoming_role: intent.incoming_role.clone(),
+            retained: intent.retained.clone(),
+            admitted: intent.admitted.clone(),
+            retired,
+        };
+        let mut handoffs = self.handoffs.clone();
+        handoffs.insert(
+            (actor.participant().clone(), intent.operation_id.clone()),
+            HandoffReceipt {
+                actor_identity: actor.identity().clone(),
+                actor_participant: actor.participant().clone(),
+                actor_epoch: actor.epoch(),
+                outgoing_identity: outgoing.identity().clone(),
+                incoming_identity: incoming.identity().clone(),
+                intent,
+                observation: observation.clone(),
+            },
+        );
+        Ok(PreparedParticipantHandoff {
+            expected: self.revision,
+            next: ParticipantSession {
+                tenant: self.tenant.clone(),
+                conversation: self.conversation.clone(),
+                session: self.session.clone(),
+                revision: self.revision + 1,
+                ended: false,
+                max_participants: self.max_participants,
+                max_connections: self.max_connections,
+                max_operations: self.max_operations,
+                participants,
+                used_connections: self.used_connections.clone(),
+                receipts: self.receipts.clone(),
+                handoffs,
+            },
+            observation,
+        })
+    }
+    pub(crate) fn commit_handoff(
+        &mut self,
+        prepared: PreparedParticipantHandoff,
+    ) -> ParticipantHandoffObservation {
+        assert_eq!(
+            self.revision, prepared.expected,
+            "handoff owner must hold its original Session commit fence"
+        );
+        assert_eq!(self.session, prepared.next.session);
+        *self = prepared.next;
+        prepared.observation
+    }
+}
