+            .core
+            .orch
+            .plan_staged_audio_handoff(
+                &s.core.session,
+                revision,
+                "cancel-or-end-correlation".into(),
+                ParticipantRole::Agent,
+                &context,
+                AudioHandoffRequest {
+                    operation_id: "native-cancel-or-end".into(),
+                    expected_revision: audience,
+                    old: s.live[0].leg.id.clone(),
+                    retained: s.live[1].leg.id.clone(),
+                    admitted: s.live[2].leg.id.clone(),
+                    old_disposition: OldHandoffDisposition::Leave,
+                },
+            )
+            .unwrap();
+        let cancel = CancellationToken::new();
+        if mode == "cancel" {
+            cancel.cancel();
+        } else {
+            s.live[1].wire.server.shutdown().await.unwrap();
+            core_fixture::until(|| {
+                !s.factory.adapters[&Transport::Quic].is_connection_live(&s.live[1].leg.id)
