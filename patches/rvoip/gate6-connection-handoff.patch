+++ b/crates/foundation/rvoip-core/src/staged_streams/handoff.rs
@@ -0,0 +1,349 @@
+//! Readiness-gated three-leg handoff in the retained managed Session.
+//! Acceptance is the host's fresh authorization of the exact scene-issued plan.
+//! A proposal or a resource-ready port cannot authorize/commit a handoff.
+use super::{
+    audience::*, audio_consumer::AudioDuplexStamp, audio_subscriptions::AudioSubscription,
+    media_scene::GuardedMediaScene, *,
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OldHandoffDisposition {
+    Observer,
+    Leave,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioHandoffRequest {
+    pub operation_id: String,
+    pub expected_revision: u64,
+    pub old: ConnectionId,
+    pub retained: ConnectionId,
+    pub admitted: ConnectionId,
+    pub old_disposition: OldHandoffDisposition,
+}
+#[derive(Clone)]
+pub(super) struct HandoffIntent {
+    pub request: AudioHandoffRequest,
+    origins: BTreeMap<ConnectionId, AudienceOrigin>,
+    pub(super) outgoing: BTreeMap<ConnectionId, AudienceOrigin>,
+    readiness: AudioDuplexStamp,
+}
+impl HandoffIntent {
+    pub(super) fn validate_target(
+        &self,
+        controller: &StreamController,
+        state: &State,
+    ) -> ControlResult<()> {
+        if let Some(origin) = self.origins.get(&controller.connection) {
+            if !origin.matches(controller) {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        if self.request.admitted == controller.connection {
+            self.readiness.current(controller, state)?;
+        }
+        Ok(())
+    }
+}
+#[derive(Clone)]
+pub struct AudioHandoffPlan {
+    audience: AudioAudiencePlan,
+}
+impl AudioHandoffPlan {
+    pub fn audience(&self) -> &AudioAudiencePlan {
+        &self.audience
+    }
+    pub(crate) fn participants(&self) -> (crate::ids::ParticipantId, crate::ids::ParticipantId) {
+        let intent = self.audience.handoff.as_ref().expect("sealed handoff plan");
+        (
+            intent.origins[&intent.request.old]
+                .member
+                .participant()
+                .clone(),
+            intent.origins[&intent.request.admitted]
+                .member
+                .participant()
+                .clone(),
+        )
+    }
+    pub(crate) fn outgoing_connections(&self) -> BTreeSet<ConnectionId> {
+        self.audience
+            .handoff
+            .as_ref()
+            .expect("sealed handoff plan")
+            .outgoing
+            .keys()
+            .cloned()
+            .collect()
+    }
+    pub fn request(&self) -> &AudioHandoffRequest {
+        &self
+            .audience
+            .handoff
+            .as_ref()
+            .expect("sealed handoff plan")
+            .request
+    }
+}
+/// Physical/provider cleanup is a separate post-commit observation. Unknown
+/// cannot turn a known local bridge commit into a successful external rollback.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HandoffCleanupOutcome {
+    NotRequested,
+    Pending,
+    LocalMediaClosed,
+    Unconfirmed,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioHandoffOutcome {
+    pub media: AudioAudienceOutcome,
+    pub retained: ConnectionId,
+    pub admitted: ConnectionId,
+    pub observer: Option<ConnectionId>,
+    pub observer_connections: BTreeSet<ConnectionId>,
+    pub retiring: BTreeSet<ConnectionId>,
+    pub cleanup: HandoffCleanupOutcome,
+}
+/// Committed metadata and the actual old controller pin; no command grant.
+#[derive(Clone)]
+pub struct AudioHandoffHandle {
+    audience: AudioAudienceHandle,
+    old: AudienceOrigin,
+    outgoing: BTreeMap<ConnectionId, AudienceOrigin>,
+    disposition: OldHandoffDisposition,
+}
+impl AudioHandoffHandle {
+    pub fn audience(&self) -> &AudioAudienceHandle {
+        &self.audience
+    }
+    pub fn old_connection(&self) -> &ConnectionId {
+        &self.old.connection
+    }
+    pub fn outgoing_connections(&self) -> impl Iterator<Item = &ConnectionId> {
+        self.outgoing.keys()
+    }
+    pub fn old_disposition(&self) -> OldHandoffDisposition {
+        self.disposition
+    }
+    /// Confirm only owned local media cleanup. Adapter/remote outcomes are
+    /// independent; this method neither closes an active route nor asserts a
+    /// remote participant departure. Retrying this observation keeps the same
+    /// committed bridge and original resource identity.
+    pub async fn finish_local_media_cleanup(
+        &self,
+        deadline: tokio::time::Instant,
+    ) -> HandoffCleanupOutcome {
+        if self.disposition == OldHandoffDisposition::Observer {
+            return HandoffCleanupOutcome::NotRequested;
+        }
+        let mut confirmed = true;
+        for origin in self.outgoing.values() {
+            let Some(controller) = origin.controller.upgrade() else {
+                confirmed = false;
+                continue;
+            };
+            if !origin.matches(&controller) {
+                confirmed = false;
+                continue;
+            }
+            let fenced = {
+                let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+                state.closed && controller.shutdown.is_cancelled()
+            };
+            if !fenced || controller.shutdown(deadline).await != 0 {
+                confirmed = false;
+            }
+        }
+        if confirmed {
+            HandoffCleanupOutcome::LocalMediaClosed
+        } else {
+            HandoffCleanupOutcome::Unconfirmed
+        }
+    }
+}
+impl GuardedMediaScene {
+    /// The incoming leg is already admitted in an isolated two-party audience.
+    /// Both actual audio directions must have flowed in that current context.
+    /// Planning never retires a route and retains no policy reader.
+    pub(crate) fn plan_audio_handoff(
+        &self,
