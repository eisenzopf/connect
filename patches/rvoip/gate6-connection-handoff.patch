+
+fn handoff_room() -> (
+    ParticipantSession,
+    Membership,
+    IdentityBinding,
+    Membership,
+    Membership,
+) {
+    let mut s = session("handoff_session");
+    let (old, binding) = member("tenant_test", "alice");
+    let (new, nb) = member("tenant_test", "bob");
+    let (remote, rb) = member("tenant_test", "remote");
+    let ep = endpoint(&binding, "alice");
+    join(&mut s, &old, &ep, "old_1");
+    join(&mut s, &old, &ep, "old_2");
+    join(&mut s, &new, &endpoint(&nb, "bob"), "new_1");
+    join(&mut s, &remote, &endpoint(&rb, "remote"), "retained");
+    (s, old, binding, new, remote)
+}
+fn handoff_intent(
+    s: &ParticipantSession,
+    old: &Membership,
+    new: &Membership,
+    disposition: ParticipantHandoffDisposition,
+) -> ParticipantHandoffMutation {
+    ParticipantHandoffMutation {
+        operation_id: "handoff_logical".into(),
+        correlation_id: "handoff_correlation".into(),
+        expected_revision: s.revision(),
+        outgoing: old.participant().clone(),
+        incoming: new.participant().clone(),
+        retained: ConnectionId::from_string("retained"),
+        admitted: ConnectionId::from_string("new_1"),
+        incoming_role: ParticipantRole::Supervisor,
+        outgoing_disposition: disposition,
+    }
+}
+#[test]
+fn handoff_model_stages_both_participant_roles_without_publishing_then_commits_one_revision() {
+    let (mut s, old, _, new, _) = handoff_room();
+    let before = s.revision();
+    let intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    let prepared = s.prepare_handoff(&old, &old, &new, intent.clone()).unwrap();
+    assert_eq!(s.revision(), before);
+    assert_eq!(s.role(old.participant()), Some(&ParticipantRole::Agent));
+    assert_eq!(s.role(new.participant()), Some(&ParticipantRole::Agent));
+    drop(prepared);
+    assert_eq!(s.revision(), before);
+    let prepared = s.prepare_handoff(&old, &old, &new, intent.clone()).unwrap();
+    let observation = s.commit_handoff(prepared);
+    assert_eq!(s.revision(), before + 1);
+    assert_eq!(s.role(old.participant()), Some(&ParticipantRole::Observer));
+    assert_eq!(
+        s.role(new.participant()),
+        Some(&ParticipantRole::Supervisor)
+    );
+    assert_eq!(s.connection_count(), 4);
+    assert!(observation.retired.is_empty());
+    assert_eq!(observation.retained, ConnectionId::from_string("retained"));
+    let replay = s
+        .replay_handoff(
+            &old,
+            &old,
+            &new,
+            &ParticipantHandoffMutation {
+                correlation_id: "retry_correlation".into(),
+                ..intent
+            },
+        )
+        .unwrap()
+        .unwrap();
+    assert_eq!(replay, observation);
+    assert_eq!(replay.correlation_id, "handoff_correlation");
+    assert_eq!(s.revision(), before + 1);
+}
+#[test]
+fn handoff_model_leave_retires_all_outgoing_connections_and_preserves_retained_session() {
+    let (mut s, old, _, new, remote) = handoff_room();
+    let intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Leave);
+    let prepared = s.prepare_handoff(&old, &old, &new, intent.clone()).unwrap();
+    let observation = s.commit_handoff(prepared);
+    assert_eq!(
+        observation.retired,
+        vec![
+            ConnectionId::from_string("old_1"),
+            ConnectionId::from_string("old_2")
+        ]
+    );
+    assert_eq!(s.role(old.participant()), None);
+    assert_eq!(s.participant_count(), 2);
+    assert_eq!(s.connection_count(), 2);
+    assert_eq!(
+        s.connections(remote.participant()),
+        vec![ConnectionId::from_string("retained")]
+    );
+    assert_eq!(
+        s.role(new.participant()),
+        Some(&ParticipantRole::Supervisor)
+    );
+    assert_eq!(
+        s.replay_handoff(&old, &old, &new, &intent)
+            .unwrap()
+            .unwrap(),
+        observation
+    );
+}
+#[test]
+fn handoff_model_replays_reject_changed_intent_foreign_actor_and_readmitted_membership_epoch() {
+    let (mut s, mut old, binding, new, _) = handoff_room();
+    let intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    let prepared = s.prepare_handoff(&old, &old, &new, intent.clone()).unwrap();
+    s.commit_handoff(prepared);
+    let mut changed = intent.clone();
+    changed.outgoing_disposition = ParticipantHandoffDisposition::Leave;
+    assert_eq!(
+        s.replay_handoff(&old, &old, &new, &changed),
+        Err(ParticipantTransitionError::Conflict)
+    );
+    changed = intent.clone();
+    changed.expected_revision += 1;
+    assert_eq!(
+        s.replay_handoff(&old, &old, &new, &changed),
+        Err(ParticipantTransitionError::Conflict)
+    );
+    let (foreign, _) = member("tenant_other", "alice");
+    assert_eq!(
+        s.replay_handoff(&foreign, &old, &new, &intent),
+        Err(ParticipantTransitionError::OwnerMismatch)
+    );
+    old.remove(old.revision()).unwrap();
+    old.readmit(&binding, old.revision()).unwrap();
+    assert_eq!(
+        s.replay_handoff(&old, &old, &new, &intent),
+        Err(ParticipantTransitionError::OwnerMismatch)
+    );
+}
+#[test]
+fn handoff_model_missing_candidate_remote_and_cross_family_operation_ids_never_mutate_roles() {
+    let (mut s, old, _, new, _) = handoff_room();
+    let before = s.revision();
+    let mut intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    intent.admitted = ConnectionId::from_string("missing");
+    assert!(matches!(
+        s.prepare_handoff(&old, &old, &new, intent),
+        Err(ParticipantTransitionError::NotReady)
+    ));
+    assert_eq!(s.revision(), before);
+    let mut intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    intent.retained = ConnectionId::from_string("old_1");
+    assert!(matches!(
+        s.prepare_handoff(&old, &old, &new, intent),
+        Err(ParticipantTransitionError::NotReady)
+    ));
+    assert_eq!(s.role(old.participant()), Some(&ParticipantRole::Agent));
+    let intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    let prepared = s.prepare_handoff(&old, &old, &new, intent.clone()).unwrap();
+    s.commit_handoff(prepared);
+    let ordinary = ParticipantMutation {
+        operation_id: intent.operation_id,
+        correlation_id: "other_family".into(),
+        expected_revision: s.revision(),
+        participant: old.participant().clone(),
+        change: ParticipantChange::SetSessionRole {
+            role: ParticipantRole::Agent,
+        },
+    };
+    assert_eq!(
+        s.apply(&old, &old, ordinary, None, None),
+        Err(ParticipantTransitionError::Conflict)
+    );
+}
+
+#[test]
+fn handoff_model_authorized_history_can_name_a_removed_target_but_new_effects_require_active_membership(
+) {
+    let (mut s, old, _, mut new, _) = handoff_room();
+    let intent = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    let prepared = s.prepare_handoff(&old, &old, &new, intent.clone()).unwrap();
+    let observed = s.commit_handoff(prepared);
+    new.remove(new.revision()).unwrap();
+    // This pure metadata read is allowed only after the owner has separately
+    // checked current caller access; it cannot authorize an effect or replay a
+    // later membership epoch.
+    assert_eq!(
+        s.replay_handoff(&old, &old, &new, &intent)
+            .unwrap()
+            .unwrap(),
+        observed
+    );
+    let mut next = handoff_intent(&s, &old, &new, ParticipantHandoffDisposition::Observe);
+    next.operation_id = "new_after_removal".into();
+    assert!(matches!(
+        s.prepare_handoff(&old, &old, &new, next),
+        Err(ParticipantTransitionError::Inactive)
+    ));
+}
