+use crate::staged_streams::handoff::*;
+impl Room {
+    async fn handoff_ready(
+        &mut self,
+    ) -> crate::staged_streams::consultation::PrivateConsultationHandle {
+        self.add("consult", Some("public"), true).await;
+        let handle = self.start_consultation().await;
+        self.publish("alice", 800).unwrap();
+        self.tick();
+        self.heard("consult", 800).await;
+        self.publish("consult", 5200).unwrap();
+        self.tick();
+        self.heard("alice", 5200).await;
+        handle
+    }
+    fn handoff_request(&self, disposition: OldHandoffDisposition) -> AudioHandoffRequest {
+        AudioHandoffRequest {
+            operation_id: "handoff-1".into(),
+            expected_revision: self.scene.audience_revision(),
+            old: ConnectionId::from_string("alice"),
+            retained: ConnectionId::from_string("bob"),
+            admitted: ConnectionId::from_string("consult"),
+            old_disposition: disposition,
+        }
+    }
+    async fn handoff(
+        &self,
+        plan: AudioHandoffPlan,
+    ) -> ControlResult<(AudioHandoffOutcome, AudioHandoffHandle)> {
+        let grant = self
+            .grant(Approval::Audience(plan.audience().clone()))
+            .await;
+        self.scene
+            .commit_audio_handoff(plan, deadline(), CancellationToken::new(), &grant)
+            .await
+    }
