+fn allocation_original() -> AuthorizedEnvelope {
+    let mut a=initial_authorized();
+    let mut original=a.envelope.original().clone();
+    original["payload"]["replacement_preparation"]["profile"]=json!("connect-replacement-preparation-v1");
+    a.envelope=Envelope::from_value(original).unwrap();
+    a
+}
+async fn allocation_with_policy() -> (AuthorizedEnvelope, Arc<OriginalPolicy>, Arc<tokio::sync::RwLock<bool>>, Arc<crate::v2::replay::ReplayFence>) {
+    let mut a=allocation_original();
+    let grants=Arc::new(tokio::sync::RwLock::new(false));
+    let original=AuthorityLease::checking(grants.clone().read_owned().await,a.origin.deadline,||true);
+    a.reply_authority.replace(original.retained());a._lease=original;
+    let policy=Arc::new(OriginalPolicy{expected:a.envelope.original().clone(),grants:grants.clone(),calls:std::sync::atomic::AtomicUsize::new(0),deadline:a.origin.deadline});
+    let(context,replay)=crate::v2::auth_peer::exchange::resource_test_context(policy.clone(),a.principal.clone(),a.origin.lifetime.clone(),a.origin.deadline);
+    replay.consume(a.envelope.id()).unwrap();a.exchange=Some(context);
+    (a,policy,grants,replay)
+}
+#[tokio::test]
+async fn allocation_coordinator_wait_releases_both_guards_and_restores_only_same_fresh_original() {
+    let(a,policy,grants,replay)=allocation_with_policy().await;
+    let original=a.envelope.original().clone();let origin=a.origin.deadline;
+    let(a,until)=a.into_replacement_allocation_wait(Instant::now()+Duration::from_secs(30)).unwrap();
+    assert_eq!(until,origin);assert!(a.authority::<tokio::sync::OwnedRwLockReadGuard<bool>>().is_none());
+    drop(grants.clone().try_write_owned().expect("both original and final-reply guards must be gone during coordinator wait"));
+    assert!(a._lease.authority::<ResourcePreparation>().unwrap().permits(a.envelope()).is_err());
+    assert!(a.reply_authority.for_replies(&[result(&a)]).is_err());
+    let fresh=a.reauthorize_resource_preparation().await.unwrap();
+    let a=a.resume_replacement_allocation(fresh).unwrap();
+    assert_eq!(a.envelope.original(),&original);assert_eq!(a.origin.deadline,origin);
+    assert!(a.authority::<tokio::sync::OwnedRwLockReadGuard<bool>>().is_some());
+    assert_eq!(policy.calls.load(Ordering::Acquire),1);assert_eq!(replay.usage().0,1);
+    let reply=result(&a);assert!(a.reply_authority.for_replies(&[reply.clone()]).is_ok());
+    a.invocation.cancel();assert!(a.reply_authority.for_replies(&[reply.clone()]).is_ok());
+    a.origin.lifetime.cancel();assert_eq!(a.reply_authority.for_replies(&[reply]).unwrap_err(),DispatchError::Authority);
+}
+#[tokio::test]
+async fn allocation_coordinator_wait_recaptures_revocation_without_replaying_or_extending_cutoff() {
+    let(a,policy,grants,replay)=allocation_with_policy().await;
+    let(a,until)=a.into_replacement_allocation_wait(Instant::now()+Duration::from_secs(30)).unwrap();
+    {let mut writer=grants.clone().try_write_owned().expect("no provisional domain aliases while waiting");*writer=true;}
+    assert!(matches!(a.reauthorize_resource_preparation().await,Err(DispatchError::Authority)));
+    assert_eq!(policy.calls.load(Ordering::Acquire),1);assert_eq!(replay.usage().0,1);
+    assert_eq!(a._lease.deadline(),Some(until));
+    assert!(a.reply_authority.for_replies(&[result(&a)]).is_err());
+}
+#[tokio::test]
+async fn allocation_resume_rejects_foreign_fresh_proof_expiry_and_original_cancellation() {
+    let(a,_,_,_)=allocation_with_policy().await;
+    let(a,_)=a.into_replacement_allocation_wait(Instant::now()+Duration::from_secs(30)).unwrap();
+    let(b,_,_,_)=allocation_with_policy().await;
+    let(b,_)=b.into_replacement_allocation_wait(Instant::now()+Duration::from_secs(30)).unwrap();
+    let foreign=b.reauthorize_resource_preparation().await.unwrap();
+    assert!(matches!(a.resume_replacement_allocation(foreign),Err(DispatchError::Authority)));
+    for cancel in [false,true] {
+        let(a,_,_,_)=allocation_with_policy().await;
+        let(mut a,_)=a.into_replacement_allocation_wait(Instant::now()+Duration::from_secs(30)).unwrap();
+        let fresh=a.reauthorize_resource_preparation().await.unwrap();
+        if cancel {a.origin.lifetime.cancel();} else {a._lease.deadline=Some(Instant::now()-Duration::from_millis(1));}
+        assert!(matches!(a.resume_replacement_allocation(fresh),Err(DispatchError::Authority)));
+    }
