 impl AuthorizedEnvelope {
+    /// Consume the unique original replacement-allocation offer before a
+    /// coordinator wait. Drops both original application guards and retains no
+    /// exchange/media permission. Only a fresh admission of this exact signed
+    /// command can restore its application and final-result authority.
+    pub fn into_replacement_allocation_wait(
+        mut self,
+        requested: Instant,
+    ) -> Result<(Self, Instant), DispatchError> {
+        if !self.supports_native_negotiation()
+            || self.envelope.kind() != "connection.offer"
+            || self.envelope.original()["payload"]["replacement_preparation"]["profile"]
+                != "connect-replacement-preparation-v1"
+            || self.envelope.original()["payload"]["replacement_preparation"]["operation_record_id"]
+                .as_str().is_none_or(str::is_empty)
+            || self._lease.authority::<ResourcePreparation>().is_some()
+        {
+            return Err(DispatchError::Authority);
+        }
+        let deadline = self.resource_preparation_cutoff(requested);
+        if deadline <= Instant::now() { return Err(DispatchError::Closed); }
+        let cancellation = self.invocation.child_token();
+        let resource = ResourcePreparation {
+            kind: PreparationKind::ReplacementAllocation,
+            marker: Arc::new(()), original: self.envelope.clone(),
+            participant: String::new(), streams: BTreeSet::new(),
+            cancellation, deadline,
+        };
+        let mut reply = resource.clone();
+        reply.cancellation = self.origin.lifetime.child_token();
+        let reply_current = reply.cancellation.clone();
+        let current = resource.cancellation.clone();
+        self.reply_authority.note_resource_preparation();
+        self.reply_authority.replace(AuthorityLease::checking(reply, deadline,
+            move || !reply_current.is_cancelled()));
+        self._lease = AuthorityLease::checking(resource, deadline,
+            move || !current.is_cancelled());
+        Ok((self, deadline))
+    }
+    /// Resume only the same privately sealed allocation wait. The actual fresh
+    /// policy proof, never the wait marker, authorizes the original effect and
+    /// reply. Neither the command identity nor its original deadline changes.
+    pub fn resume_replacement_allocation(
+        mut self,
+        authority: Arc<ResourceActivationAuthority>,
+    ) -> Result<Self, DispatchError> {
+        let resource = self._lease.authority::<ResourcePreparation>()
+            .ok_or(DispatchError::Authority)?;
+        if resource.kind != PreparationKind::ReplacementAllocation
+            || !self.resource_activation_current(&authority)
+        { return Err(DispatchError::Authority); }
+        let reply_current = authority.clone();
+        self.reply_authority.replace(AuthorityLease {
+            _guard: authority.lease._guard.clone(),
+            validity: Some(Arc::new(move || reply_current.reply_current())),
+            deadline: Some(authority.deadline),
+        });
+        let current = authority.clone();
+        self._lease = AuthorityLease {
+            _guard: authority.lease._guard.clone(),
+            validity: Some(Arc::new(move || current.current())),
+            deadline: Some(authority.deadline),
+        };
+        Ok(self)
+    }
