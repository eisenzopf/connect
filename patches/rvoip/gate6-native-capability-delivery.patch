+//! Scene-issued disclosure metadata. It contains no current domain grant.
+use super::audience::ClosedAudience;
+use super::media_scene::GuardedMediaScene;
+use super::*;
+use std::task::Poll;
+
+#[derive(Clone)]
+struct EndpointStamp {
+    controller: Weak<StreamController>,
+    credential: CredentialSnapshot,
+}
+impl EndpointStamp {
+    fn new(controller: &Arc<StreamController>, credential: &CredentialSnapshot) -> Self {
+        Self {
+            controller: Arc::downgrade(controller),
+            credential: credential.clone(),
+        }
+    }
+    fn matches(&self, current: &CredentialSnapshot) -> bool {
+        current.revision == self.credential.revision
+            && reliable_data::same_credential(&current.principal, &self.credential.principal)
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct SceneCapabilityDisclosure {
+    scene: Weak<GuardedMediaScene>,
+    source: EndpointStamp,
+    // Preserve these actual groups even when a later return removes them.
+    original: Vec<(Arc<ClosedAudience>, bool)>,
+}
+#[derive(Clone)]
+pub(crate) struct SceneCapabilityListener {
+    scene: Weak<GuardedMediaScene>,
+    recipient: EndpointStamp,
+}
+
+impl GuardedMediaScene {
+    /// The caller holds the exact managed runtime/lifecycle source fences.
+    /// Resolve domain policy before this method. `commit` is a synchronous
+    /// leaf and must not enter Core, a controller, policy, or network IO.
+    pub(crate) fn commit_capability_declaration<T>(
+        self: &Arc<Self>,
+        connection: &ConnectionId,
+        controller: &Arc<StreamController>,
+        principal: &AuthenticatedPrincipal,
+        expected: u64,
+        commit: impl FnOnce() -> T,
+    ) -> ControlResult<(T, SceneCapabilityDisclosure)> {
+        let members = self
+            .members
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        let registry = self
+            .audiences
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if !members
+            .get(connection)
+            .is_some_and(|m| Arc::ptr_eq(&m.controller, controller))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        // Pure comparisons against the exact principal checked under the
+        // credential mutex below; no audience callback reenters that mutex.
+        let original = registry
+            .groups
+            .values()
+            .map(|group| {
+                (
+                    group.clone(),
+                    group.contains_principal(controller, principal),
+                )
+            })
+            .collect();
+        controller.commit_capability_declaration(principal, expected, |credential| {
+            let result = commit();
+            (
+                result,
+                SceneCapabilityDisclosure {
+                    scene: Arc::downgrade(self),
+                    source: EndpointStamp::new(controller, credential),
+                    original,
+                },
+            )
+        })
+    }
+
+    pub(crate) fn capability_listener(
+        self: &Arc<Self>,
+        connection: &ConnectionId,
+        controller: &Arc<StreamController>,
+        principal: &AuthenticatedPrincipal,
+    ) -> ControlResult<SceneCapabilityListener> {
+        let members = self
+            .members
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if !members
+            .get(connection)
+            .is_some_and(|m| Arc::ptr_eq(&m.controller, controller))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let state = controller
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        let credential = controller
+            .credential
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if state.closed
+            || controller.shutdown.is_cancelled()
+            || !reliable_data::same_credential(&credential.principal, principal)
+            || StreamController::principal_expiry(principal)
+                .is_some_and(|t| t <= chrono::Utc::now())
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(SceneCapabilityListener {
+            scene: Arc::downgrade(self),
+            recipient: EndpointStamp::new(controller, &credential),
+        })
+    }
+
+    /// Fence one actual bounded IO poll. No guard survives Pending and no
+    /// supplied IO callback may reenter Core, policy, or either controller.
+    /// The caller independently retains fresh source/recipient permission.
+    pub(crate) fn poll_capability_io<T>(
+        self: &Arc<Self>,
+        disclosure: &SceneCapabilityDisclosure,
+        listener: &SceneCapabilityListener,
+        io: impl FnOnce() -> Poll<T>,
+    ) -> ControlResult<Poll<T>> {
+        let own = Arc::downgrade(self);
+        if !Weak::ptr_eq(&disclosure.scene, &own) || !Weak::ptr_eq(&listener.scene, &own) {
+            return Err(StreamControlError::Authority);
+        }
+        let source = disclosure
+            .source
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let target = listener
+            .recipient
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if Arc::ptr_eq(&source, &target) {
+            return Err(StreamControlError::Authority);
+        }
+        let members = self
+            .members
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        let registry = self
+            .audiences
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if !members
+            .get(&source.connection)
+            .is_some_and(|m| Arc::ptr_eq(&m.controller, &source))
+            || !members
+                .get(&target.connection)
+                .is_some_and(|m| Arc::ptr_eq(&m.controller, &target))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let controllers = if source.connection < target.connection {
+            [&source, &target]
+        } else {
+            [&target, &source]
+        };
+        let states = controllers
+            .iter()
+            .map(|c| c.state.try_lock().map_err(|_| StreamControlError::NotReady))
+            .collect::<ControlResult<Vec<_>>>()?;
+        let credentials = controllers
+            .iter()
+            .map(|c| {
+                c.credential
+                    .try_lock()
+                    .map_err(|_| StreamControlError::NotReady)
+            })
+            .collect::<ControlResult<Vec<_>>>()?;
+        let source_index = usize::from(!Arc::ptr_eq(controllers[0], &source));
+        let target_index = 1 - source_index;
+        if controllers
+            .iter()
+            .zip(&states)
+            .zip(&credentials)
+            .any(|((c, state), credential)| {
+                state.closed
+                    || c.shutdown.is_cancelled()
+                    || StreamController::principal_expiry(&credential.principal)
+                        .is_some_and(|t| t <= chrono::Utc::now())
+            })
+            || !disclosure.source.matches(&credentials[source_index])
+            || !listener.recipient.matches(&credentials[target_index])
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let source_principal = &credentials[source_index].principal;
+        let target_principal = &credentials[target_index].principal;
+        if disclosure
+            .original
+            .iter()
+            .any(|(group, inside)| *inside != group.contains_principal(&target, target_principal))
+            || registry.groups.values().any(|group| {
+                group.contains_principal(&source, source_principal)
+                    != group.contains_principal(&target, target_principal)
+            })
+        {
+            return Err(StreamControlError::Authority);
+        }
+        // Holding both registries and exact endpoint credentials serializes
+        // privacy, membership, retirement and rebind with this real IO poll.
+        Ok(io())
+    }
+}
