 #[path = "private_consult/endpoint_preparation.rs"]
 mod endpoint_preparation;
+
+// Controlled engine callbacks only; actual native socket custody is qualified
+// separately through Connect. These real scene handles preserve original groups.
+#[tokio::test]
+async fn capability_disclosure_preserves_original_private_audience_after_return_and_checks_current_scene(
+) {
+    let mut room = Room::new().await;
+    let alice = room.nodes["alice"].controller.clone();
+    let bob = room.nodes["bob"].controller.clone();
+    let public = room.nodes["public"].controller.clone();
+    let principal = alice.credential_snapshot().principal;
+    let bob_listener = room
+        .scene
+        .capability_listener(&bob.connection, &bob, &bob.credential_snapshot().principal)
+        .unwrap();
+    let public_listener = room
+        .scene
+        .capability_listener(
+            &public.connection,
+            &public,
+            &public.credential_snapshot().principal,
+        )
+        .unwrap();
+    let (observed, public_descriptor) = room
+        .scene
+        .commit_capability_declaration(
+            &alice.connection,
+            &alice,
+            &principal,
+            alice.revision(),
+            || "committed",
+        )
+        .unwrap();
+    assert_eq!(observed, "committed");
+    let calls = AtomicUsize::new(0);
+    let effect = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(())
+    };
+    assert!(room
+        .scene
+        .poll_capability_io(&public_descriptor, &bob_listener, &effect)
+        .unwrap()
+        .is_ready());
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    room.add("consult", Some("public"), true).await;
+    let consult = room.nodes["consult"].controller.clone();
+    let consult_listener = room
+        .scene
+        .capability_listener(
+            &consult.connection,
+            &consult,
+            &consult.credential_snapshot().principal,
+        )
+        .unwrap();
+    // Prepared private endpoints are already quarantined from public metadata.
+    assert!(room
+        .scene
+        .poll_capability_io(&public_descriptor, &consult_listener, &effect)
+        .is_err());
+    let (_, handle) = room.apply(room.begin_plan()).await.unwrap();
+    let (_, private_descriptor) = room
+        .scene
+        .commit_capability_declaration(
+            &alice.connection,
+            &alice,
+            &principal,
+            alice.revision(),
+            || (),
+        )
+        .unwrap();
+    assert!(room
+        .scene
+        .poll_capability_io(&private_descriptor, &consult_listener, &effect)
+        .unwrap()
+        .is_ready());
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    assert!(room
+        .scene
+        .poll_capability_io(&private_descriptor, &bob_listener, &effect)
+        .is_err());
+    // Same Participant and credential at another exact Connection are outside.
+    assert!(room
+        .scene
+        .poll_capability_io(&private_descriptor, &public_listener, &effect)
+        .is_err());
+    assert!(room
+        .scene
+        .poll_capability_io(&public_descriptor, &bob_listener, &effect)
+        .is_err());
+    let restore = room
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "capability-return".into(),
+            room.scene.audience_revision(),
+        )
+        .unwrap();
+    room.apply(restore).await.unwrap();
+    // Current main routing is public again. Original private metadata remains
+    // private, even though a check against only the current group would pass.
+    assert!(room
+        .scene
+        .poll_capability_io(&public_descriptor, &bob_listener, &effect)
+        .unwrap()
+        .is_ready());
+    assert!(room
+        .scene
+        .poll_capability_io(&private_descriptor, &bob_listener, &effect)
+        .is_err());
+    assert!(room
+        .scene
+        .poll_capability_io(&private_descriptor, &public_listener, &effect)
+        .is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+    let held = room.scene.audiences.lock().unwrap();
+    assert!(matches!(
+        room.scene
+            .poll_capability_io(&public_descriptor, &bob_listener, &effect),
+        Err(StreamControlError::NotReady)
+    ));
+    drop(held);
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+    alice.retire();
+    assert!(room
+        .scene
+        .poll_capability_io(&public_descriptor, &bob_listener, &effect)
+        .is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+}
