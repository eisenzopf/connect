+//! Exact managed source/listener incarnations, without retained permission.
+use super::*;
+use crate::staged_streams::{
+    capability_disclosure::{SceneCapabilityDisclosure, SceneCapabilityListener},
+    StreamControlError, StreamController,
+};
+use std::task::Poll;
+
+#[derive(Clone)]
+struct LifeStamp {
+    state: Weak<Mutex<ConnectionLifecycleState>>,
+    generation: u64,
+}
+impl LifeStamp {
+    fn new(ticket: &ConnectionLifecycleTicket) -> Self {
+        Self {
+            state: Arc::downgrade(&ticket.state),
+            generation: ticket.generation,
+        }
+    }
+    fn matches(&self, ticket: &ConnectionLifecycleTicket) -> bool {
+        self.generation == ticket.generation
+            && Weak::ptr_eq(&self.state, &Arc::downgrade(&ticket.state))
+    }
+}
+fn live(ticket: &ConnectionLifecycleTicket, state: &ConnectionLifecycleState) -> bool {
+    state.active
+        && !state.retired
+        && state.generation == ticket.generation
+        && state
+            .peer_admission
+            .as_ref()
+            .is_none_or(|permit| !permit.peer.is_closed())
+}
+fn busy() -> ParticipantControlError {
+    StreamControlError::NotReady.into()
+}
+
+/// An actual local declaration's original private audience and source
+/// incarnation. This is metadata, never permission to deliver a descriptor.
+#[derive(Clone)]
+pub struct NativeCapabilityDisclosure {
+    runtime: Weak<ManagedParticipantSession>,
+    session: SessionId,
+    source: ConnectionId,
+    life: LifeStamp,
+    scene: SceneCapabilityDisclosure,
+}
+/// An actual managed recipient incarnation. Native composition must additionally
+/// seal its original physical writer and retain fresh sender/recipient policy.
+#[derive(Clone)]
+pub struct NativeCapabilityListener {
+    runtime: Weak<ManagedParticipantSession>,
+    session: SessionId,
+    recipient: ConnectionId,
+    life: LifeStamp,
+    scene: SceneCapabilityListener,
+}
+impl std::fmt::Debug for NativeCapabilityDisclosure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeCapabilityDisclosure(redacted)")
+    }
+}
+impl std::fmt::Debug for NativeCapabilityListener {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeCapabilityListener(redacted)")
+    }
+}
+
+impl Orchestrator {
+    /// Resolve the managed runtime and actual controller. The host must have
+    /// already retained current named declaration permission. `commit` is a
+    /// synchronous leaf metadata change with no Core/policy reentry or IO.
+    pub fn commit_native_capability_declaration<T>(
+        &self,
+        session: &SessionId,
+        source: &ConnectionId,
+        controller: &Arc<StreamController>,
+        principal: &AuthenticatedPrincipal,
+        expected: u64,
+        commit: impl FnOnce() -> T,
+    ) -> ControlResult<(T, NativeCapabilityDisclosure)> {
+        let runtime = self.participant_runtime(session)?;
+        let state = runtime.state.try_lock().map_err(|_| busy())?;
+        let route = state
+            .routes
+            .get(source)
+            .ok_or(ParticipantControlError::Authority)?;
+        let life = route.lifecycle.state.try_lock().map_err(|_| busy())?;
+        if state.ended || route.lifecycle.connection_id != *source || !live(&route.lifecycle, &life)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let scene = runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let (result, disclosure) =
+            scene.commit_capability_declaration(source, controller, principal, expected, commit)?;
+        Ok((
+            result,
+            NativeCapabilityDisclosure {
+                runtime: Arc::downgrade(&runtime),
+                session: session.clone(),
+                source: source.clone(),
+                life: LifeStamp::new(&route.lifecycle),
+                scene: disclosure,
+            },
+        ))
+    }
+
+    pub fn native_capability_listener(
+        &self,
+        session: &SessionId,
+        recipient: &ConnectionId,
+        controller: &Arc<StreamController>,
+        principal: &AuthenticatedPrincipal,
+    ) -> ControlResult<NativeCapabilityListener> {
+        let runtime = self.participant_runtime(session)?;
+        let state = runtime.state.try_lock().map_err(|_| busy())?;
+        let route = state
+            .routes
+            .get(recipient)
+            .ok_or(ParticipantControlError::Authority)?;
+        let life = route.lifecycle.state.try_lock().map_err(|_| busy())?;
+        if state.ended
+            || route.lifecycle.connection_id != *recipient
+            || !live(&route.lifecycle, &life)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let scene = runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        Ok(NativeCapabilityListener {
+            runtime: Arc::downgrade(&runtime),
+            session: session.clone(),
+            recipient: recipient.clone(),
+            life: LifeStamp::new(&route.lifecycle),
+            scene: scene.capability_listener(recipient, controller, principal)?,
+        })
+    }
+
+    /// Poll actual IO under the original and current private audience, exact
+    /// managed membership, lifecycle, and credential incarnations. This does
+    /// not acquire domain permission. The caller must own fresh current source
+    /// and recipient guards and the exact sealed native physical writer.
+    /// `io` must be bounded and must not reenter Core, policy or a controller.
+    /// No engine guard is retained when this method returns Pending.
+    pub fn poll_native_capability_io<T>(
+        &self,
+        disclosure: &NativeCapabilityDisclosure,
+        listener: &NativeCapabilityListener,
+        io: impl FnOnce() -> Poll<T>,
+    ) -> ControlResult<Poll<T>> {
+        if disclosure.session != listener.session
+            || disclosure.source == listener.recipient
+            || !Weak::ptr_eq(&disclosure.runtime, &listener.runtime)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let runtime = self.participant_runtime(&disclosure.session)?;
+        if !Weak::ptr_eq(&disclosure.runtime, &Arc::downgrade(&runtime)) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let state = runtime.state.try_lock().map_err(|_| busy())?;
+        if state.ended {
+            return Err(ParticipantControlError::Authority);
+        }
+        let source = state
+            .routes
+            .get(&disclosure.source)
+            .ok_or(ParticipantControlError::Authority)?;
+        let target = state
+            .routes
+            .get(&listener.recipient)
+            .ok_or(ParticipantControlError::Authority)?;
+        if !disclosure.life.matches(&source.lifecycle) || !listener.life.matches(&target.lifecycle)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let tickets = if disclosure.source < listener.recipient {
+            [&source.lifecycle, &target.lifecycle]
+        } else {
+            [&target.lifecycle, &source.lifecycle]
+        };
+        let lives = tickets
+            .iter()
+            .map(|ticket| ticket.state.try_lock().map_err(|_| busy()))
+            .collect::<ControlResult<Vec<_>>>()?;
+        if tickets
+            .iter()
+            .zip(&lives)
+            .any(|(ticket, life)| !live(ticket, life))
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let scene = runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        Ok(scene.poll_capability_io(&disclosure.scene, &listener.scene, io)?)
+    }
+}
