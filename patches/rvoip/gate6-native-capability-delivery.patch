+//! A declaration's physical origin is metadata, not its original grant.
+use super::*;
+use crate::staged_media::StagedRtpScope;
+use rvoip_core::{
+    relationships::{EndpointBinding, Membership},
+    staged_streams::StreamController,
+};
+use std::sync::Weak;
+
+pub(in crate::v2) struct CapabilitySourceOrigin {
+    origin: RequestOrigin,
+    route: CancellationToken,
+    controller: Weak<StreamController>,
+    principal: AuthenticatedPrincipal,
+    initial: Weak<dyn std::any::Any + Send + Sync>,
+}
+impl CapabilitySourceOrigin {
+    pub(in crate::v2) fn seal(
+        a: &AuthorizedEnvelope,
+        controller: &Arc<StreamController>,
+        scope: &StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        route: CancellationToken,
+    ) -> Result<Self, DispatchError> {
+        if a.envelope.kind() != "capability.advertise"
+            || !a.supports_native_negotiation()
+            || a.peer.is_none()
+            || !a._lease.current()
+            || a.invocation.is_cancelled()
+            || a.envelope.scope(Scope::Reply).is_some()
+            || a.envelope.scope(Scope::Operation).is_none()
+            || scope.wire_conversation.is_none()
+            || a.envelope.scope(Scope::Conversation) != scope.wire_conversation.as_deref()
+            || a.envelope.scope(Scope::Session) != Some(scope.wire_session.as_str())
+            || a.envelope.scope(Scope::Connection) != Some(scope.wire_connection.as_str())
+            || !controller.is_bound_to(member, endpoint)
+            || !controller.matches_data_credential(&a.principal)
+        {
+            return Err(DispatchError::Authority);
+        }
+        let expiry = crate::v2::auth_peer::effective_expiry(&a.principal)?;
+        let deadline = Instant::now()
+            + expiry
+                .signed_duration_since(chrono::Utc::now())
+                .to_std()
+                .map_err(|_| DispatchError::Closed)?;
+        let value = Self {
+            origin: RequestOrigin {
+                incarnation: a.origin.incarnation,
+                lifetime: a.origin.lifetime.child_token(),
+                deadline,
+            },
+            route,
+            controller: Arc::downgrade(controller),
+            principal: a.principal.clone(),
+            initial: Arc::downgrade(&a._lease._guard),
+        };
+        if !value.current() {
+            return Err(DispatchError::Closed);
+        }
+        Ok(value)
+    }
+    pub(in crate::v2) fn ready(&self) -> bool {
+        self.initial.strong_count() == 0
+    }
+    pub(in crate::v2) fn current(&self) -> bool {
+        !self.origin.lifetime.is_cancelled()
+            && !self.route.is_cancelled()
+            && Instant::now() < self.origin.deadline
+            && self
+                .controller
+                .upgrade()
+                .is_some_and(|c| c.matches_data_credential(&self.principal))
+    }
+    pub(in crate::v2) fn deadline(&self) -> Instant {
+        self.origin.deadline
+    }
+    pub(in crate::v2) fn cancellation(&self) -> CancellationToken {
+        self.origin.lifetime.clone()
+    }
+    pub(in crate::v2) fn route_cancellation(&self) -> CancellationToken {
+        self.route.clone()
+    }
+}
+
+impl HandlerDelivery {
+    pub(in crate::v2) fn capability(
+        listener: Arc<crate::v2::native_capability_delivery::NativeCapabilityRegistration>,
+        frame: Envelope,
+        pending: crate::v2::native_capability_delivery::PendingCapability,
+        deadline: Instant,
+    ) -> Result<Self, DispatchError> {
+        if !listener.current() || !listener.ready() || frame.kind() != "capability.advertise" {
+            return Err(DispatchError::Authority);
+        }
+        Ok(Self {
+            origin: DeliveryOrigin::Capability(listener),
+            frames: Some(HandlerReplies::new(vec![frame])?),
+            authority: None,
+            completion: None,
+            data: None,
+            native: None,
+            capability: Some(pending),
+            deadline,
+        })
+    }
+}
