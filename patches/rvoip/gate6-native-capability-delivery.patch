+//! Original disclosure metadata and the sole native reliable writer.
+//! Nothing queued here holds an old invocation or current policy reader.
+use super::{
+    auth_dispatch::{capabilities::CapabilitySourceOrigin, *},
+    native_lifecycle::NativeLifecycleScope,
+    Envelope, Scope,
+};
+use crate::staged_media::StagedRtpScope;
+use rvoip_core::{
+    orchestrator::participant_control::{
+        NativeCapabilityDisclosure, NativeCapabilityListener, ParticipantControlError,
+    },
+    relationships::{EndpointBinding, Membership},
+    staged_streams::StreamController,
+    Orchestrator,
+};
+use std::{
+    sync::{Arc, Weak},
+    task::Poll,
+    time::Duration,
+};
+use tokio::{sync::oneshot, time::Instant};
+use tokio_util::sync::CancellationToken;
+
+// Erase the orchestrator's internal adapter graph at this metadata boundary.
+// The implementation still upgrades the exact actual Core for each IO poll.
+trait CapabilityEngine: Send + Sync {
+    fn current(&self) -> bool;
+    fn poll(
+        &self,
+        disclosure: &NativeCapabilityDisclosure,
+        listener: &NativeCapabilityListener,
+        io: &mut dyn FnMut() -> Poll<Result<(), DispatchError>>,
+    ) -> Result<Poll<Result<(), DispatchError>>, ParticipantControlError>;
+}
+struct CoreEngine(Weak<Orchestrator>);
+impl CapabilityEngine for CoreEngine {
+    fn current(&self) -> bool {
+        self.0.strong_count() > 0
+    }
+    fn poll(
+        &self,
+        disclosure: &NativeCapabilityDisclosure,
+        listener: &NativeCapabilityListener,
+        io: &mut dyn FnMut() -> Poll<Result<(), DispatchError>>,
+    ) -> Result<Poll<Result<(), DispatchError>>, ParticipantControlError> {
+        let core = self.0.upgrade().ok_or(ParticipantControlError::Cancelled)?;
+        core.poll_native_capability_io(disclosure, listener, io)
+    }
+}
+
+pub struct NativeCapabilityDeclaration {
+    original: Envelope,
+    scope: NativeLifecycleScope,
+    origin: CapabilitySourceOrigin,
+    engine: Arc<dyn CapabilityEngine>,
+    disclosure: NativeCapabilityDisclosure,
+}
+impl std::fmt::Debug for NativeCapabilityDeclaration {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeCapabilityDeclaration(redacted)")
+    }
+}
+impl NativeCapabilityDeclaration {
+    pub(crate) fn new(
+        original: Envelope,
+        scope: NativeLifecycleScope,
+        origin: CapabilitySourceOrigin,
+        core: &Arc<Orchestrator>,
+        disclosure: NativeCapabilityDisclosure,
+    ) -> Self {
+        Self {
+            original,
+            scope,
+            origin,
+            engine: Arc::new(CoreEngine(Arc::downgrade(core))),
+            disclosure,
+        }
+    }
+    pub fn original(&self) -> &Envelope {
+        &self.original
+    }
+    pub fn scope(&self) -> &NativeLifecycleScope {
+        &self.scope
+    }
+    pub fn payload(&self) -> &serde_json::Value {
+        &self.original.original()["payload"]
+    }
+    pub fn current(&self) -> bool {
+        self.origin.current() && self.engine.current()
+    }
+    pub fn ready(&self) -> bool {
+        self.origin.ready()
+    }
+}
+
+pub struct NativeCapabilityRegistration {
+    origin: DataOrigin,
+    scope: NativeLifecycleScope,
+
+    listener: NativeCapabilityListener,
+}
+impl NativeCapabilityRegistration {
+    pub(crate) fn new(
+        a: &AuthorizedEnvelope,
+        controller: &Arc<StreamController>,
+        media: StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        listener: NativeCapabilityListener,
+    ) -> Result<Arc<Self>, DispatchError> {
+        if a.envelope().kind() != "connection.offer" {
+            return Err(DispatchError::Authority);
+        }
+        let origin = DataOrigin::seal(a, controller, media.clone(), member, endpoint)?;
+        Ok(Arc::new(Self {
+            origin,
+            listener,
+            scope: NativeLifecycleScope {
+                principal: a.principal().clone(),
+                media,
+                participant: member.participant().clone(),
+                membership_epoch: member.epoch(),
+                device: endpoint.device().clone(),
+                endpoint: endpoint.endpoint().clone(),
+                identity: member.identity().clone(),
+            },
+        }))
+    }
+    pub fn scope(&self) -> &NativeLifecycleScope {
+        &self.scope
+    }
+    pub fn current(&self) -> bool {
+        self.origin.current()
+    }
+    pub fn ready(&self) -> bool {
+        self.origin.is_ready()
+    }
+    pub fn retire(&self) {
+        self.origin.retire();
+    }
+    pub(in crate::v2) fn incarnation(&self) -> uuid::Uuid {
+        self.origin.incarnation()
+    }
+    pub(in crate::v2) fn cancellation(&self) -> CancellationToken {
+        self.origin.cancellation()
+    }
+    /// The receiver is this sealed physical origin; the wire scope names the
+    /// advertised source. A caller cannot supply replacement envelope bytes.
+    pub fn delivery(
+        self: &Arc<Self>,
+        declaration: Arc<NativeCapabilityDeclaration>,
+        policy: Arc<dyn NativeCapabilityWritePolicy>,
+    ) -> Result<
+        (
+            HandlerDelivery,
+            oneshot::Receiver<Result<(), DispatchError>>,
+        ),
+        DispatchError,
+    > {
+        let source = declaration.scope();
+        let target = self.scope();
+        if !self.current()
+            || !self.ready()
+            || !declaration.current()
+            || !declaration.ready()
+            || source.media.connection == target.media.connection
+            || source.media.session != target.media.session
+            || source.media.wire_conversation != target.media.wire_conversation
+            || source.media.wire_session != target.media.wire_session
+        {
+            return Err(DispatchError::Authority);
+        }
+        let frame = Envelope::from_value(serde_json::json!({
+            "v":2,"type":"capability.advertise","id":format!("capability_{}",uuid::Uuid::new_v4().simple()),
+            "ts":chrono::Utc::now(),"cid":source.media.wire_conversation,"sid":source.media.wire_session,
+            "connid":source.media.wire_connection,"payload":declaration.payload()
+        }))?;
+        let deadline = (Instant::now() + Duration::from_secs(1))
+            .min(self.origin.deadline())
+            .min(declaration.origin.deadline());
+        let (done, result) = oneshot::channel();
+        let pending = PendingCapability {
+            declaration,
+            listener: self.clone(),
+            policy,
+            completion: Some(done),
+        };
+        Ok((
+            HandlerDelivery::capability(self.clone(), frame, pending, deadline)?,
+            result,
+        ))
+    }
+}
+impl Drop for NativeCapabilityRegistration {
+    fn drop(&mut self) {
+        self.origin.retire();
+    }
+}
+
+/// Reacquire exact current sender and recipient permission at actual dequeue.
+/// The returned predicate is passive domain state, with no Core/SQL reentry.
+#[async_trait::async_trait]
+pub trait NativeCapabilityWritePolicy: Send + Sync {
+    async fn acquire(
+        &self,
+        _declaration: &NativeCapabilityDeclaration,
+        _listener: &NativeCapabilityRegistration,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+}
+pub(in crate::v2) struct PendingCapability {
+    declaration: Arc<NativeCapabilityDeclaration>,
+    listener: Arc<NativeCapabilityRegistration>,
+    policy: Arc<dyn NativeCapabilityWritePolicy>,
+    completion: Option<oneshot::Sender<Result<(), DispatchError>>>,
+}
+impl Drop for PendingCapability {
+    fn drop(&mut self) {
+        if let Some(done) = self.completion.take() {
+            let _ = done.send(Err(DispatchError::Closed));
+        }
+    }
+}
+
+struct CapabilityIoCustody<W> {
+    writer: Option<W>,
+    lease: AuthorityLease,
+}
+impl<W> Drop for CapabilityIoCustody<W> {
+    fn drop(&mut self) {
+        drop(self.writer.take());
+    }
+}
+
+pub(in crate::v2) async fn write<
+    W: futures::Sink<bytes::Bytes, Error = DispatchError> + Send + Unpin,
+>(
+    writer: &mut Option<W>,
+    frame: &Envelope,
+    mut pending: PendingCapability,
+    physical: &CancellationToken,
+    authority: Option<&CancellationToken>,
+    stop: &CancellationToken,
+    job_deadline: Instant,
+) -> Result<(), DispatchError> {
+    use futures::{Future, SinkExt};
+    let source = &pending.declaration;
+    let target = &pending.listener;
+    let deadline = job_deadline
+        .min(source.origin.deadline())
+        .min(target.origin.deadline());
+    let ready = || {
+        source.current()
+            && target.current()
+            && !physical.is_cancelled()
+            && !stop.is_cancelled()
+            && !authority.is_some_and(CancellationToken::is_cancelled)
+            && Instant::now() < deadline
+    };
+    let mut touched = false;
+    let result = async {
+        if !ready() || frame.kind()!="capability.advertise"
+            || frame.original()["payload"] != *source.payload()
+            || frame.scope(Scope::Conversation) != source.scope.media.wire_conversation.as_deref()
+            || frame.scope(Scope::Session) != Some(source.scope.media.wire_session.as_str())
+            || frame.scope(Scope::Connection) != Some(source.scope.media.wire_connection.as_str())
+        { return Err(DispatchError::Authority); }
+        let lease = tokio::time::timeout_at(deadline, pending.policy.acquire(source,target))
+            .await.map_err(|_| DispatchError::Closed)??;
+        let bound = deadline.min(lease.deadline().unwrap_or(deadline));
+        if !ready() || !lease.current() { return Err(DispatchError::Authority); }
+        let engine = &source.engine;
+        let bytes = bytes::Bytes::from(serde_json::to_vec(frame).map_err(|_|DispatchError::Unsupported)?);
+        let mut custody = CapabilityIoCustody { writer: None, lease };
+        let source_cancel = source.origin.cancellation(); let route_cancel = source.origin.route_cancellation();
+        let target_cancel = target.cancellation();
+        let result = {
+            let sending = async {
+                custody.writer = Some(writer.take().ok_or(DispatchError::Closed)?);
+                touched = true;
+                custody.writer.as_mut().ok_or(DispatchError::Closed)?.send(bytes).await
+            };
+            tokio::pin!(sending);
+            let mut retry = Box::pin(tokio::time::sleep(Duration::from_millis(5)));
+            let guarded = std::future::poll_fn(|cx| {
+                // Domain/physical checks precede all engine locks. The only
+                // callback under Core fences polls this exact sink future.
+                if !ready() || !custody.lease.current() { return Poll::Ready(Err(DispatchError::Authority)); }
+                match engine.poll(&source.disclosure,&target.listener,&mut || sending.as_mut().poll(cx)) {
+                    Ok(result)=>result,
+                    Err(ParticipantControlError::Media(rvoip_core::staged_streams::StreamControlError::NotReady))=>{
+                        if retry.as_mut().poll(cx).is_ready() {
+                            retry.as_mut().reset(Instant::now()+Duration::from_millis(5));cx.waker().wake_by_ref();
+                        }
+                        Poll::Pending
+                    },
+                    Err(_)=>Poll::Ready(Err(DispatchError::Authority)),
+                }
+            });
+            tokio::select! {biased;
+                _=physical.cancelled()=>Err(DispatchError::Closed),
+                _=stop.cancelled()=>Err(DispatchError::Closed),
+                _=source_cancel.cancelled()=>Err(DispatchError::Closed),
+                _=route_cancel.cancelled()=>Err(DispatchError::Closed),
+                _=target_cancel.cancelled()=>Err(DispatchError::Closed),
+                _=async{match authority{Some(t)=>t.cancelled().await,None=>std::future::pending().await}}=>Err(DispatchError::Authority),
+                _=tokio::time::sleep_until(bound)=>Err(DispatchError::Closed),
+                result=guarded=>result,
+            }
+        };
+        if result.is_ok() { *writer=custody.writer.take(); }
+        // Destroy an unfinished sink before the independently acquired source
+        // and recipient policy readers leave this scope, even on cancellation.
+        if result.is_err() && touched {physical.cancel();}
+        drop(custody);
+        result
+    }.await;
+    if let Some(done) = pending.completion.take() {
+        let _ = done.send(result);
+    }
+    if result.is_err() && touched {
+        physical.cancel();
+        Err(DispatchError::SubmissionUnknown)
+    } else {
+        Ok(())
+    }
+}
