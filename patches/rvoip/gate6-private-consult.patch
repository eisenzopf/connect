+#[tokio::test]
+async fn private_audience_reuses_actual_grant_under_queued_writer_and_future_media_rechecks_policy()
+{
+    let mut r = Room::new().await;
+    r.add("consult", Some("public"), true).await;
+    let plan = r.begin_plan();
+    let grant = r.grant(Approval::Audience(plan.clone())).await;
+    let writer = tokio::spawn({
+        let state = r.domain.base.0.clone();
+        async move {
+            state.write().await.revoked.insert("alice".into());
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    let fresh = r.domain.fresh.load(Ordering::Acquire);
+    let (_, handle) = tokio::time::timeout(
+        Duration::from_secs(1),
+        r.scene
+            .apply_audio_audience(plan, deadline(), CancellationToken::new(), &grant),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(fresh, r.domain.fresh.load(Ordering::Acquire));
+    drop(grant);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(r.publish("alice", 800).is_err());
+    let restore = r
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "denied-restore".into(),
+            r.scene.audience_revision(),
+        )
+        .unwrap();
