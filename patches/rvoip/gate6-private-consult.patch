+//! Closed audio audiences in the retained managed Session.
+//!
+//! Plans and restore handles contain pinned metadata, never a policy lease.
+//! A host must authorize the complete audience operation under its current
+//! domain grant. These local outcomes are not durable operation receipts.
+use super::audio_subscriptions::AudioPlan;
+use super::{audio_subscriptions::*, media_scene::*, *};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioAudienceRequest {
+    pub operation_id: String,
+    pub expected_revision: u64,
+    /// Exact retained Connections in the private conversation. Other devices
+    /// of the same Participant do not inherit this private provider context.
+    pub private_connections: BTreeSet<ConnectionId>,
+    /// Complete replacement programmes, not sequential clear/subscribe calls.
+    pub receivers: BTreeMap<ConnectionId, Vec<AudioSubscription>>,
+    /// An admitted consulting source must start muted. Activation unmutes it
+    /// in the same transaction that installs every receiver's audience fence.
+    pub activate_muted: Option<ConnectionId>,
+}
+impl AudioAudienceRequest {
+    pub(super) fn validate(&self) -> ControlResult<()> {
+        let valid = |s: &str| {
+            !s.is_empty()
+                && s.len() <= 128
+                && s.bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+        };
+        if !valid(&self.operation_id)
+            || self.private_connections.len() < 2
+            || self.private_connections.len() > 16
+            || self.receivers.len() > 32
+            || self.receivers.is_empty()
+            || self
+                .private_connections
+                .iter()
+                .any(|id| !valid(id.as_str()))
+            || self.receivers.keys().any(|id| !valid(id.as_str()))
+            || self
+                .activate_muted
+                .as_ref()
+                .is_some_and(|id| !self.private_connections.contains(id))
+        {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        for sources in self.receivers.values() {
+            if !sources.is_empty() {
+                validate(&AudioSubscriptionChange::Subscribe(sources.clone()))?;
+            }
+        }
+        Ok(())
+    }
+}
+#[derive(Clone)]
+pub(super) struct AudienceOrigin {
+    pub(super) controller: Weak<StreamController>,
+    pub(super) connection: ConnectionId,
+    member: Membership,
+    owner: Arc<AuthenticatedPrincipal>,
+}
+impl AudienceOrigin {
+    pub(super) fn new(controller: &Arc<StreamController>) -> Self {
+        Self {
+            controller: Arc::downgrade(controller),
+            connection: controller.connection.clone(),
+            member: controller.origin_member.clone(),
+            owner: controller.credential_snapshot().principal,
+        }
+    }
+    pub(super) fn matches(&self, controller: &StreamController) -> bool {
+        self.controller
+            .upgrade()
+            .is_some_and(|old| std::ptr::eq(old.as_ref(), controller))
+            && self.member.participant() == controller.origin_member.participant()
+            && self.member.identity() == controller.origin_member.identity()
+            && self.member.epoch() == controller.origin_member.epoch()
+            && self
+                .owner
+                .has_same_owner(&controller.credential_snapshot().principal)
+    }
+}
