+#[tokio::test]
+async fn private_audience_cancel_timeout_and_dropped_drain_preserve_every_original_programme() {
+    for mode in ["cancel", "timeout", "drop"] {
+        let mut r = Room::new().await;
+        r.add("consult", Some("public"), true).await;
+        r.publish("alice", 800).unwrap();
+        r.tick();
+        let queued = r.nodes.get_mut("bob").unwrap().out.try_recv().unwrap();
+        r.heard("public", 800).await;
+        let entered = Arc::new(Notify::new());
+        let release = Arc::new(Notify::new());
+        let sending = tokio::spawn({
+            let entered = entered.clone();
+            let release = release.clone();
+            async move {
+                queued
+                    .deliver(|_| async move {
+                        entered.notify_one();
+                        release.notified().await;
+                        Ok(())
+                    })
+                    .await
+            }
+        });
+        entered.notified().await;
+        let revisions = r
+            .nodes
+            .iter()
+            .map(|(id, n)| (id.clone(), n.controller.revision()))
+            .collect::<BTreeMap<_, _>>();
+        let audience = r.scene.audience_revision();
+        let plan = r.begin_plan();
+        let grant = r.grant(Approval::Audience(plan.clone())).await;
+        let cancel = CancellationToken::new();
+        let work = tokio::spawn({
+            let scene = r.scene.clone();
+            let cancel = cancel.clone();
+            async move {
+                scene
+                    .apply_audio_audience(
+                        plan,
+                        if mode == "timeout" {
+                            tokio::time::Instant::now() + Duration::from_millis(30)
+                        } else {
+                            deadline()
+                        },
+                        cancel,
+                        &grant,
+                    )
+                    .await
+            }
+        });
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert!(
+            !work.is_finished(),
+            "the actual admitted send must fence publication"
+        );
+        if mode == "cancel" {
+            cancel.cancel();
+        }
+        if mode == "drop" {
+            work.abort();
+        }
+        match mode {
+            "drop" => assert!(matches!(work.await, Err(e) if e.is_cancelled())),
+            "cancel" => assert!(matches!(
+                work.await.unwrap(),
+                Err(StreamControlError::Cancelled)
+            )),
+            _ => assert!(matches!(
+                work.await.unwrap(),
+                Err(StreamControlError::Deadline)
+            )),
+        }
+        assert_eq!(audience, r.scene.audience_revision());
+        for (id, revision) in revisions {
+            assert_eq!(
+                revision,
+                r.nodes[&id].controller.revision(),
+                "partial audience at {id}"
+            );
+        }
+        release.notify_one();
+        sending.await.unwrap().unwrap();
+        r.publish("alice", 800).unwrap();
+        r.tick();
+        r.heard("bob", 800).await;
+        r.heard("public", 800).await;
+        r.silent(&["consult"]);
+        assert!(r.publish("consult", 5200).is_err());
+        drop(
+            tokio::time::timeout(Duration::from_secs(1), r.domain.base.0.write())
+                .await
+                .unwrap(),
+        );
+        let (_, handle) = r.apply(r.begin_plan()).await.unwrap();
+        let plan = r
+            .scene
+            .plan_restore_audio_audience(
+                &handle,
+                "retry-restore".into(),
+                r.scene.audience_revision(),
+            )
+            .unwrap();
+        r.apply(plan).await.unwrap();
+    }
+}
