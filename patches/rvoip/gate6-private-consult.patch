+use super::*;
+use crate::staged_streams::{audience::*, audio_subscriptions::*, media_scene::GuardedMediaScene};
+struct Domain {
+    base: Arc<Policy>,
+    fresh: AtomicUsize,
+}
+enum Approval {
+    Prepare {
+        connection: ConnectionId,
+        operation: String,
+        expected: u64,
+    },
+    Audience(AudioAudiencePlan),
+}
+struct Grant {
+    domain: Arc<Domain>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    approval: Approval,
+}
+struct Held {
+    grant: Arc<Grant>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for Held {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_receive(&self, source: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        let old = self
+            .grant
+            .guard
+            .owners
+            .get(source.connection.as_str())
+            .ok_or(StreamControlError::Authority)?;
+        old.connection
+            .require_current(&old.member, &old.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if self.grant.guard.private
+            || self
+                .grant
+                .guard
+                .revoked
+                .contains(&old.actor.identity().to_string())
+            || source.conversation != *old.member.conversation()
+            || source.session != *old.presence.session()
+            || source.participant != *old.member.participant()
+            || source.membership_epoch != old.member.epoch()
+            || source.connection_generation != old.connection.generation()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut owner = self.owner.clone();
+        owner.may_route_source = true;
+        Ok(Box::new(owner))
+    }
+    fn control_participant_receive(
+        &self,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<MediaOwner>> {
+        future_participant_owner(
+            &self.grant.guard,
+            self.owner.connection.connection(),
+            source,
+        )
+        .map(Box::new)
+    }
+}
+impl MediaPolicy for Domain {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.fresh.fetch_add(1, Ordering::AcqRel);
+        self.base.current(scope)
+    }
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.base.current_participant_receive(scope, source)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let grant = held
+            .downcast_ref::<Arc<Grant>>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.base, &grant.domain.base)
+            || grant.guard.private
+            || grant.guard.revoked.contains("alice")
+            || !grant
+                .guard
+                .owners
+                .get("alice")
+                .is_some_and(|owner| owner.may_control)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let valid = match (&grant.approval, intent) {
+            (
+                Approval::Prepare {
+                    connection,
+                    operation,
+                    expected,
+                },
+                MediaControlIntent::PreparePrivateAudio {
+                    operation: actual,
+                    expected: revision,
+                },
+            ) => connection == scope.connection && operation == actual && expected == revision,
+            (Approval::Audience(approved), MediaControlIntent::AudioAudience { plan }) => {
+                approved.same_intent(plan)
+                    && plan
+                        .expected_receiver_revisions()
+                        .contains_key(scope.connection)
+            }
+            _ => false,
+        };
+        if !valid || grant.guard.revoked.contains(&scope.principal.subject) {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = grant
+            .guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        owner
+            .actor
+            .revalidate_principal(scope.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        MediaControl::new(
+            Box::new(Held {
+                grant: grant.clone(),
+                owner,
+            }),
+            CancellationToken::new(),
+            deadline(),
+        )
+    }
+}
+struct Node {
+    controller: Arc<StreamController>,
+    adapter: Arc<Adapter>,
+    out: mpsc::Receiver<QueuedMedia>,
+    sequence: u32,
+}
+struct Room {
+    domain: Arc<Domain>,
+    scene: Arc<GuardedMediaScene>,
+    nodes: BTreeMap<String, Node>,
+}
+impl Room {
+    async fn new() -> Self {
+        let base = Arc::new(Policy(Arc::new(RwLock::new(PolicyState {
+            owners: HashMap::new(),
+            revoked: HashSet::new(),
+            private: false,
+        }))));
+        let domain = Arc::new(Domain {
+            base,
+            fresh: AtomicUsize::new(0),
+        });
+        let scene = GuardedMediaScene::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            domain.clone(),
+            8000,
+        );
+        let mut r = Self {
+            domain,
+            scene,
+            nodes: BTreeMap::new(),
+        };
+        for name in ["alice", "bob", "public", "hold"] {
+            r.add(name, None, false).await;
+        }
+        r.select(
+            "alice",
+            vec![AudioSubscription::Connection(ConnectionId::from_string(
+                "bob",
+            ))],
+        )
+        .await;
+        r.select(
+            "bob",
+            vec![
+                AudioSubscription::Connection(ConnectionId::from_string("alice")),
+                AudioSubscription::Participant(
+                    r.nodes["public"]
+                        .controller
+                        .origin_member
+                        .participant()
+                        .clone(),
+                ),
+            ],
+        )
+        .await;
+        r.select(
+            "public",
+            vec![AudioSubscription::Connection(ConnectionId::from_string(
+                "alice",
+            ))],
+        )
+        .await;
+        r
+    }
+    async fn grant(&self, approval: Approval) -> Arc<Grant> {
+        Arc::new(Grant {
+            domain: self.domain.clone(),
+            guard: Arc::new(self.domain.base.0.clone().read_owned().await),
+            approval,
+        })
+    }
+    async fn add(&mut self, name: &str, alias: Option<&str>, private: bool) {
+        let subject = alias.unwrap_or(name);
+        let mut o = owner(subject);
+        if alias.is_some() {
+            o.connection = ConnectionBinding::prepare(
+                &o.member,
+                &o.presence,
+                &o.endpoint,
+                ConnectionId::from_string(name),
+            )
+            .unwrap();
+            o.connection
+                .observe_ready(&o.member, &o.presence, &o.endpoint, 1)
+                .unwrap();
+            o.connection
+                .activate(&o.member, &o.presence, &o.endpoint)
+                .unwrap();
+        }
+        self.domain
+            .base
+            .0
+            .write()
+            .await
+            .owners
+            .insert(name.into(), o);
+        let adapter = Adapter::new();
+        let c = StreamController::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            ConnectionId::from_string(name),
+            principal(subject),
+            self.domain.clone(),
+            adapter.clone(),
+            Arc::new(StreamHandleAllocator::default()),
+            16,
+        )
+        .unwrap();
+        c.change(
+            0,
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+        let grant = if private {
+            c.set_media_gate(
+                c.revision(),
+                &BTreeSet::from([desired(Medium::Audio).logical_id]),
+                StreamGateAction::Mute,
+                deadline(),
+            )
+            .await
+            .unwrap();
+            Some(
+                self.grant(Approval::Prepare {
+                    connection: c.connection.clone(),
+                    operation: format!("prepare-{name}"),
+                    expected: c.revision(),
+                })
+                .await,
+            )
+        } else {
+            None
+        };
+        let mut member = match &grant {
+            Some(g) => self
+                .scene
+                .prepare_private(c.clone(), &format!("prepare-{name}"), g)
+                .unwrap(),
+            None => self.scene.prepare(c.clone()).unwrap(),
+        };
+        member
+            .quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        assert!(member.ready());
+        self.scene.insert(c.connection.clone(), member, true);
+        drop(grant);
+        let out = adapter.port(Medium::Audio).take_egress().unwrap();
+        self.nodes.insert(
+            name.into(),
+            Node {
+                controller: c,
+                adapter,
+                out,
+                sequence: 0,
+            },
+        );
+    }
+    async fn select(&self, target: &str, sources: Vec<AudioSubscription>) {
+        let c = &self.nodes[target].controller;
+        self.scene
+            .change_subscriptions(
+                &c.connection,
+                c.revision(),
+                AudioSubscriptionChange::Subscribe(sources),
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+            .unwrap();
+    }
+    fn publish(&mut self, name: &str, sample: i16) -> ControlResult<()> {
+        use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+        let n = self.nodes.get_mut(name).unwrap();
+        n.sequence += 1;
+        let p = n.adapter.port(Medium::Audio);
+        let mut f = frame(&p, n.sequence);
+        let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+        f.payload = codec
+            .encode(&AudioFrame {
+                samples: vec![sample; 160],
+                sample_rate: 8000,
+                channels: 1,
+                duration: Duration::from_millis(20),
+                timestamp: n.sequence,
+            })
+            .unwrap()
+            .into();
+        p.try_publish(&f)
+    }
+    fn tick(&self) {
+        self.scene.tick();
+    }
+    async fn heard(&mut self, name: &str, sample: i16) {
+        outgoing(&mut self.nodes.get_mut(name).unwrap().out)
+            .await
+            .deliver(move |f| async move {
+                use rvoip_media_core::codec::factory::CodecFactory;
+                let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+                let a = codec.decode(&f.payload).unwrap();
+                let mean =
+                    a.samples.iter().map(|s| i32::from(*s)).sum::<i32>() / a.samples.len() as i32;
+                assert!(
+                    (mean - i32::from(sample)).abs() < 400,
+                    "speaker expected {sample}, got {mean}"
+                );
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+    fn silent(&mut self, names: &[&str]) {
+        for name in names {
+            assert!(
+                self.nodes.get_mut(*name).unwrap().out.try_recv().is_err(),
+                "unexpected audio at {name}"
+            );
+        }
+    }
+    fn begin_plan(&self) -> AudioAudiencePlan {
+        self.scene
+            .plan_audio_audience(AudioAudienceRequest {
+                operation_id: "consult-1".into(),
+                expected_revision: self.scene.audience_revision(),
+                private_connections: BTreeSet::from([
+                    ConnectionId::from_string("alice"),
+                    ConnectionId::from_string("consult"),
+                ]),
+                receivers: BTreeMap::from([
+                    (
+                        ConnectionId::from_string("alice"),
+                        vec![AudioSubscription::Connection(ConnectionId::from_string(
+                            "consult",
+                        ))],
+                    ),
+                    (
+                        ConnectionId::from_string("consult"),
+                        vec![AudioSubscription::Connection(ConnectionId::from_string(
+                            "alice",
+                        ))],
+                    ),
+                    (
+                        ConnectionId::from_string("bob"),
+                        vec![AudioSubscription::Connection(ConnectionId::from_string(
+                            "hold",
+                        ))],
+                    ),
+                ]),
+                activate_muted: Some(ConnectionId::from_string("consult")),
+            })
+            .unwrap()
+    }
+    async fn apply(
+        &self,
+        plan: AudioAudiencePlan,
+    ) -> ControlResult<(AudioAudienceOutcome, AudioAudienceHandle)> {
+        let grant = self.grant(Approval::Audience(plan.clone())).await;
+        self.scene
+            .apply_audio_audience(plan, deadline(), CancellationToken::new(), &grant)
+            .await
+    }
+}
+#[tokio::test]
