+#[tokio::test]
+async fn private_consultation_timeout_cancel_and_each_hangup_restore_only_surviving_original_paths()
+{
+    use crate::staged_streams::consultation::PrivateConsultationMediaOutcome as O;
+    for (mode, expected) in [
+        ("timeout", O::MediaTimeout),
+        ("cancel", O::Cancelled),
+        ("bob", O::RemoteEnded),
+        ("consult", O::ConsultantEnded),
+        ("alice", O::PrimaryEnded),
+    ] {
+        let mut r = Room::new().await;
+        r.add("consult", Some("public"), true).await;
+        let handle = r.start_consultation().await;
+        // Holding the remote retains its original transport and its independent
+        // public source while the private pair is closed.
+        r.publish("hold", 10400).unwrap();
+        r.tick();
+        r.heard("bob", 10400).await;
+        r.silent(&["alice", "consult", "public"]);
+        let cancel = CancellationToken::new();
+        let scene = r.scene.clone();
+        let wait_handle = handle.clone();
+        let wait_cancel = cancel.clone();
+        let waiting = tokio::spawn(async move {
+            scene
+                .wait_private_consultation_audio(
+                    &wait_handle,
+                    tokio::time::Instant::now() + Duration::from_millis(60),
+                    wait_cancel,
+                )
+                .await
+        });
+        tokio::task::yield_now().await;
+        if mode == "cancel" {
+            cancel.cancel();
+        }
+        if ["bob", "consult", "alice"].contains(&mode) {
+            r.nodes[mode].controller.shutdown.cancel();
+        }
+        assert_eq!(waiting.await.unwrap().unwrap(), expected);
+        if ["bob", "consult", "alice"].contains(&mode) {
+            r.scene.remove(&ConnectionId::from_string(mode));
+        }
+        let restored = r.restore_consultation(&handle).await;
+        assert!(restored.restored);
+        assert_eq!(
+            restored.departed_connections.len(),
+            usize::from(["bob", "consult", "alice"].contains(&mode))
+        );
+        if mode != "alice" {
+            r.publish("alice", 800).unwrap();
+            r.tick();
+            r.heard("public", 800).await;
+            if mode != "bob" {
+                r.heard("bob", 800).await;
+            }
+            r.silent(&["consult"]);
+        }
+        if mode != "alice" && mode != "bob" {
+            r.publish("bob", 2400).unwrap();
+            r.tick();
+            r.heard("alice", 2400).await;
+        }
+        if mode != "consult" {
+            assert!(r.publish("consult", 5200).is_err());
+        }
+        drop(
+            tokio::time::timeout(Duration::from_secs(1), r.domain.base.0.write())
+                .await
+                .unwrap(),
+        );
+    }
+}
