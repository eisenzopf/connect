+        r.apply(restore).await,
+        Err(StreamControlError::Authority)
+    ));
+    r.domain.base.0.write().await.revoked.remove("alice");
+    let restore = r
+        .scene
+        .plan_restore_audio_audience(&handle, "fresh-restore".into(), r.scene.audience_revision())
+        .unwrap();
+    r.apply(restore).await.unwrap();
+    r.publish("alice", 800).unwrap();
