+pub(super) struct PreparedPrivateAudience {
+    pub group: Arc<ClosedAudience>,
+    pub control: MediaControl,
+    state: Arc<Mutex<AudienceState>>,
+    controller: Weak<StreamController>,
+    committed: bool,
+}
+impl PreparedPrivateAudience {
+    pub(super) fn reserve(
+        state: &Arc<Mutex<AudienceState>>,
+        controller: &Arc<StreamController>,
+        operation: &str,
+        control: MediaControl,
+    ) -> ControlResult<Self> {
+        if operation.is_empty()
+            || operation.len() > 128
+            || !operation
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+        {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        let mut registry = state.lock().unwrap_or_else(|p| p.into_inner());
+        if registry.groups.contains_key(operation) || registry.pending.contains_key(operation) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        if registry.groups.len() + registry.pending.len() >= 256
+            || registry.revision >= u64::MAX - 256
+        {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+        registry
+            .pending
+            .insert(operation.into(), Arc::downgrade(controller));
+        Ok(Self {
+            group: Arc::new(ClosedAudience {
+                operation: operation.into(),
+                origins: vec![AudienceOrigin::new(controller)],
+            }),
+            control,
+            state: state.clone(),
+            controller: Arc::downgrade(controller),
+            committed: false,
+        })
+    }
+    pub(super) fn commit(&mut self, state: &mut AudienceState, controller: &Arc<StreamController>) {
+        assert!(state
+            .pending
+            .get(&self.group.operation)
+            .is_some_and(|old| Weak::ptr_eq(old, &self.controller)));
+        assert!(state
+            .groups
+            .insert(self.group.operation.clone(), self.group.clone())
+            .is_none());
+        assert!(state
+            .preparations
+            .insert(controller.connection.clone(), self.group.clone())
+            .is_none());
+        state.pending.remove(&self.group.operation);
+        state.revision += 1;
+        self.committed = true;
+    }
+}
+impl Drop for PreparedPrivateAudience {
+    fn drop(&mut self) {
+        if !self.committed {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state
+                .pending
+                .get(&self.group.operation)
+                .is_some_and(|old| Weak::ptr_eq(old, &self.controller))
+            {
+                state.pending.remove(&self.group.operation);
+            }
+        }
+    }
+}
