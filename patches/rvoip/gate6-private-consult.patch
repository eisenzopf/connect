+impl GuardedMediaScene {
+    pub(crate) fn audience_revision(&self) -> u64 {
+        self.audiences
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .revision
+    }
+    pub(crate) fn plan_audio_audience(
+        &self,
+        request: AudioAudienceRequest,
+    ) -> ControlResult<AudioAudiencePlan> {
+        request.validate()?;
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+        if registry.revision != request.expected_revision
+            || registry.groups.contains_key(&request.operation_id)
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        if registry.groups.len() + registry.pending.len() >= 256 || registry.revision == u64::MAX {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+        if request.receivers.keys().any(|id| !members.contains_key(id)) {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut origins = Vec::new();
+        for id in &request.private_connections {
+            let source = members.get(id).ok_or(StreamControlError::NotReady)?;
+            let state = source
+                .controller
+                .state
+                .try_lock()
+                .map_err(|_| MediaTransitionError::Conflict)?;
+            if source.controller.shutdown.is_cancelled()
+                || source.current_descriptor(&state, true)?.is_none()
+                || source.current_descriptor(&state, false)?.is_none()
+            {
+                return Err(StreamControlError::NotReady);
+            }
+            origins.push(AudienceOrigin::new(&source.controller));
+        }
+        let group = Arc::new(ClosedAudience {
+            operation: request.operation_id.clone(),
+            origins,
+        });
+        let replaced_preparation = match &request.activate_muted {
+            None => None,
+            Some(id) => {
+                let prepared = registry
+                    .preparations
+                    .get(id)
+                    .ok_or(StreamControlError::Authority)?;
+                let source = &members[id].controller;
+                if !prepared.contains(source)
+                    || !registry
+                        .groups
+                        .get(&prepared.operation)
+                        .is_some_and(|old| Arc::ptr_eq(old, prepared))
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                Some(prepared.clone())
+            }
+        };
+        if registry.groups.values().any(|old| {
+            !replaced_preparation
+                .as_ref()
+                .is_some_and(|p| Arc::ptr_eq(p, old))
+                && members
+                    .values()
+                    .any(|m| old.contains(&m.controller) && group.contains(&m.controller))
+        }) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let expected = members
+            .iter()
+            .map(|(id, m)| (id.clone(), m.controller.revision()))
+            .collect();
+        let controllers = members
+            .iter()
+            .map(|(id, m)| (id.clone(), Arc::downgrade(&m.controller)))
+            .collect();
+        Ok(AudioAudiencePlan {
+            scene: self.id,
+            request,
+            group,
+            expected,
+            controllers,
+            restore: None,
+            replaced_preparation,
+        })
+    }
+    pub(crate) fn plan_restore_audio_audience(
+        &self,
+        handle: &AudioAudienceHandle,
+        operation: String,
+        expected_revision: u64,
+    ) -> ControlResult<AudioAudiencePlan> {
+        if handle.scene != self.id
+            || operation.is_empty()
+            || operation.len() > 128
+            || !operation
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+        if registry.revision != expected_revision
+            || !registry
+                .groups
+                .get(&handle.group.operation)
+                .is_some_and(|g| Arc::ptr_eq(g, &handle.group))
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let request = AudioAudienceRequest {
+            operation_id: operation,
+            expected_revision,
+            private_connections: handle
+                .group
+                .origins
+                .iter()
+                .map(|o| o.connection.clone())
+                .collect(),
+            receivers: BTreeMap::new(),
+            activate_muted: None,
+        };
+        let expected = members
+            .iter()
+            .map(|(id, m)| (id.clone(), m.controller.revision()))
+            .collect();
+        let controllers = members
+            .iter()
+            .map(|(id, m)| (id.clone(), Arc::downgrade(&m.controller)))
+            .collect();
+        Ok(AudioAudiencePlan {
+            scene: self.id,
+            request,
+            group: handle.group.clone(),
+            expected,
+            controllers,
+            restore: Some(handle.clone()),
+            replaced_preparation: None,
+        })
+    }
+}
+struct AudienceTarget {
+    controller: Arc<StreamController>,
+    credential: CredentialSnapshot,
+    control: MediaControl,
+    audio: AudioPlan,
+    ports: Vec<(Arc<Port>, PeerRouteTicket, PeerRouteTicket)>,
+    gate: Option<StreamGateAction>,
+}
+fn exact_members(
+    members: &std::collections::HashMap<ConnectionId, SceneMember>,
+    plan: &AudioAudiencePlan,
+) -> bool {
+    members.len() == plan.controllers.len()
+        && members.iter().all(|(id, m)| {
+            plan.controllers
+                .get(id)
+                .is_some_and(|old| Weak::ptr_eq(old, &Arc::downgrade(&m.controller)))
+        })
+}
+fn current(
+    target: &AudienceTarget,
+    deadline: tokio::time::Instant,
+    cancel: &CancellationToken,
+) -> ControlResult<()> {
+    if cancel.is_cancelled() || target.controller.shutdown.is_cancelled() {
+        return Err(StreamControlError::Cancelled);
+    }
+    if tokio::time::Instant::now() >= deadline {
+        return Err(StreamControlError::Deadline);
+    }
+    target.control.valid()?;
+    target
+        .controller
+        .check_credential_snapshot(&target.credential)
+}
+impl GuardedMediaScene {
+    pub(crate) async fn apply_audio_audience(
+        &self,
+        plan: AudioAudiencePlan,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<(AudioAudienceOutcome, AudioAudienceHandle)> {
+        if plan.scene != self.id {
+            return Err(StreamControlError::Authority);
+        }
+        let (controllers, _flights) = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            if !exact_members(&members, &plan) {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            let controllers = members
+                .iter()
+                .map(|(id, m)| (id.clone(), m.controller.clone()))
+                .collect::<BTreeMap<_, _>>();
+            let flights = controllers
+                .values()
+                .map(|c| {
+                    c.inflight
+                        .clone()
+                        .try_acquire_owned()
+                        .map_err(|_| MediaTransitionError::Conflict.into())
+                })
+                .collect::<ControlResult<Vec<_>>>()?;
+            (controllers, flights)
+        };
+        let mut controls = BTreeMap::new();
+        let mut deadline = deadline;
+        for (id, controller) in &controllers {
+            let credential = controller.credential_snapshot();
+            let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+            let control = controller.policy.current_control(
+                &scope,
+                &MediaControlIntent::AudioAudience { plan: &plan },
+                held,
+            )?;
+            deadline = deadline
+                .min(control.deadline)
+                .min(StreamController::command_deadline(
+                    &credential.principal,
+                    deadline,
+                ));
+            controls.insert(id.clone(), (credential, control));
+        }
+        let mut original = BTreeMap::new();
+        let mut receiver_origins = BTreeMap::new();
+        let (targets, next_groups, muted_source) = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+            if !exact_members(&members, &plan)
+                || registry.revision != plan.request.expected_revision
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            let mut groups = registry.groups.clone();
+            let muted_source = if let Some(restore) = &plan.restore {
+                if !groups
+                    .get(&plan.group.operation)
+                    .is_some_and(|g| Arc::ptr_eq(g, &plan.group))
+                {
+                    return Err(MediaTransitionError::Conflict.into());
+                }
+                groups.remove(&plan.group.operation);
+                if let Some(source) = restore
+                    .muted_source
+                    .as_ref()
+                    .filter(|origin| members.values().any(|m| origin.matches(&m.controller)))
+                {
+                    // Keep the old private provider Context isolated after main
+                    // audio resumes, even if external cleanup is uncertain.
+                    groups.insert(
+                        plan.group.operation.clone(),
+                        Arc::new(ClosedAudience {
+                            operation: plan.group.operation.clone(),
+                            origins: vec![source.clone()],
+                        }),
+                    );
+                }
+                original = restore.original.clone();
+                receiver_origins = restore.receivers.clone();
+                restore.muted_source.clone()
+            } else {
+                if let Some(prepared) = &plan.replaced_preparation {
+                    if !groups
+                        .remove(&prepared.operation)
+                        .is_some_and(|g| Arc::ptr_eq(&g, prepared))
+                    {
+                        return Err(MediaTransitionError::Conflict.into());
+                    }
+                }
+                groups.insert(plan.group.operation.clone(), plan.group.clone());
+                for id in plan.request.receivers.keys() {
+                    let target = &members[id];
+                    original.insert(
+                        id.clone(),
+                        target.audio_consumer.subscriptions.saved_program(),
+                    );
+                    receiver_origins.insert(id.clone(), AudienceOrigin::new(&target.controller));
+                }
+                plan.request
+                    .activate_muted
+                    .as_ref()
+                    .map(|id| AudienceOrigin::new(&members[id].controller))
+            };
+            let mut targets = Vec::new();
+            for (id, controller) in &controllers {
+                let member = &members[id];
+                let (credential, control) = controls.remove(id).unwrap();
+                let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+                if state.closed || controller.shutdown.is_cancelled() {
+                    return Err(StreamControlError::Cancelled);
+                }
+                let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+                let owner = control.authority()?;
+                StreamController::check(&scope, &owner)?;
+                state
+                    .model
+                    .check_routing(&owner.current(), plan.expected[id])?;
+                let rules = groups
+                    .values()
+                    .map(|group| AudioAudienceRule {
+                        group: group.clone(),
+                        inside: group.contains(controller),
+                    })
+                    .collect();
+                let saved = plan.restore.as_ref().and_then(|restore| {
+                    restore
+                        .receivers
+                        .get(id)
+                        .filter(|origin| origin.matches(controller))
+                        .and_then(|_| restore.original.get(id))
+                });
+                let replacement = if plan.restore.is_none() {
+                    plan.request.receivers.get(id).map(Vec::as_slice)
+                } else {
+                    None
+                };
+                let audio = AudioPlan::audience(
+                    self,
+                    &members,
+                    member,
+                    &state,
+                    &scope,
+                    &owner,
+                    replacement,
+                    saved,
+                    rules,
+                    &control,
+                )?;
+                let gate = muted_source
+                    .as_ref()
+                    .filter(|source| source.matches(controller))
+                    .map(|_| {
+                        if plan.restore.is_some() {
+                            StreamGateAction::Mute
+                        } else {
+                            StreamGateAction::Unmute
+                        }
+                    });
+                let mut ports = Vec::new();
+                if let Some(action) = gate {
+                    let ids = state
+                        .active
+                        .iter()
+                        .filter(|(_, p)| {
+                            p.binding.negotiated.requested.medium == Medium::Audio
+                                && p.binding.negotiated.requested.direction != StreamDirection::Send
+                        })
+                        .map(|(id, _)| id.clone())
+                        .collect::<BTreeSet<_>>();
+                    if ids.is_empty() {
+                        return Err(StreamControlError::NotReady);
+                    }
+                    if plan.restore.is_none()
+                        && ids.iter().any(|id| !state.model.streams()[id].source_muted)
+                    {
+                        return Err(StreamControlError::Authority);
+                    }
+                    state
+                        .model
+                        .validate_gate(&owner.current(), plan.expected[id], &ids, action)?;
+                    for id in ids {
+                        let port = state.active[&id].clone();
+                        let old = port.ticket();
+                        let next = old.stage().ok_or(MediaTransitionError::Capacity)?;
+                        ports.push((port, old, next));
+                    }
+                }
+                drop(state);
+                targets.push(AudienceTarget {
+                    controller: controller.clone(),
+                    credential,
+                    control,
+                    audio,
+                    ports,
+                    gate,
+                });
+            }
+            (targets, groups, muted_source)
+        };
+        let mut tokens = vec![cancel.clone()];
+        let mut tickets = Vec::new();
+        for target in &targets {
+            current(target, deadline, &cancel)?;
+            tokens.push(target.control.cancellation.clone());
+            tokens.push(target.controller.shutdown.clone());
+            tokens.push(target.audio.cancellation());
+            tickets.extend(target.audio.tickets());
+            tickets.extend(target.ports.iter().map(|(_, old, _)| old.clone()));
+        }
+        let mut drained = Vec::new();
+        for ticket in tickets {
+            drained.push(tokio::select!{biased;
+            _=audio_consumer::any_cancelled(tokens.clone())=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        });
+        }
+        let (outcome, commit, committed_at) = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let mut registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+            if !exact_members(&members, &plan)
+                || registry.revision != plan.request.expected_revision
+                || registry.revision == u64::MAX
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            let mut owners = Vec::new();
+            let mut receive = Vec::new();
+            // Validate one receiver at a time: another receiver is often also
+            // its publisher. Holding all state locks here would reenter them.
+            for target in &targets {
+                current(target, deadline, &cancel)?;
+                let id = &target.controller.connection;
+                let member = &members[id];
+                let state = target
+                    .controller
+                    .state
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner());
+                let scope = target
+                    .controller
+                    .scope(&target.credential.principal, MediaPurpose::Control);
+                let owner = target.control.authority()?;
+                StreamController::check(&scope, &owner)?;
+                state
+                    .model
+                    .check_routing(&owner.current(), plan.expected[id])?;
+                receive.extend(target.audio.validate(
+                    self,
+                    &members,
+                    member,
+                    &state,
+                    &scope,
+                    &owner,
+                    Some(&target.control),
+                    None,
+                )?);
+                owners.push(owner);
+            }
+            let mut states = targets
+                .iter()
+                .map(|t| t.controller.state.lock().unwrap_or_else(|p| p.into_inner()))
+                .collect::<Vec<_>>();
+            let mut models = Vec::new();
+            let mut revisions = BTreeMap::new();
+            for ((target, state), owner) in targets.iter().zip(&states).zip(&owners) {
+                current(target, deadline, &cancel)?;
+                if state.closed {
+                    return Err(StreamControlError::Cancelled);
+                }
+                let id = &target.controller.connection;
+                let mut next = state
+                    .model
+                    .routing_candidate(&owner.current(), plan.expected[id])?;
+                if let Some(action) = target.gate {
+                    let ids = target
+                        .ports
+                        .iter()
+                        .map(|(p, _, _)| p.binding.negotiated.requested.logical_id.clone())
+                        .collect();
+                    next.set_gates(&owner.current(), plan.expected[id], &ids, action)?;
+                } else {
+                    next.commit_routing(
+                        &owner.current(),
+                        plan.expected[id],
+                        target.audio.changed(),
+                    )?;
+                }
+                revisions.insert(id.clone(), next.revision());
+                models.push(next);
+            }
+            let mut commits = targets
+                .iter()
+                .map(|t| t.audio.lock())
+                .collect::<ControlResult<Vec<_>>>()?;
+            for target in &targets {
+                current(target, deadline, &cancel)?;
+            }
+            // No fallible work after the first model or programme is published.
+            for (((target, state), model), commit) in targets
+                .iter()
+                .zip(states.iter_mut())
+                .zip(models)
+                .zip(commits.iter_mut())
+            {
+                state.model = model;
+                for (port, old, next) in &target.ports {
+                    assert!(next.commit_from(old));
+                    *port.ticket.lock().unwrap_or_else(|p| p.into_inner()) = next.clone();
+                }
+                commit.commit(&target.audio);
+            }
+            registry.groups = next_groups;
+            if let Some(id) = &plan.request.activate_muted {
+                registry.preparations.remove(id);
+            }
+            registry.revision += 1;
+            let departed = receiver_origins
+                .iter()
+                .filter(|(_, origin)| !members.values().any(|m| origin.matches(&m.controller)))
+                .map(|(id, _)| id.clone())
+                .collect();
+            let commit = AudioAudienceCommit {
+                targets: targets
+                    .iter()
+                    .zip(&states)
+                    .map(|(target, state)| {
+                        let id = target.controller.connection.clone();
+                        (
+                            id.clone(),
+                            AudienceCommitTarget {
+                                controller: Arc::downgrade(&target.controller),
+                                credential: target.credential.clone(),
+                                previous: plan.expected[&id],
+                                revision: state.model.revision(),
+                                ports: state.active.values().map(Arc::downgrade).collect(),
+                            },
+                        )
+                    })
+                    .collect(),
+            };
+            (
+                AudioAudienceOutcome {
+                    operation_id: plan.request.operation_id.clone(),
+                    audience_revision: registry.revision,
+                    receiver_revisions: revisions,
+                    restored: plan.restore.is_some(),
+                    departed_connections: departed,
+                },
+                commit,
+                Instant::now(),
+            )
+        };
+        drop(drained);
+        self.selection_changed.notify_waiters();
+        let handle = AudioAudienceHandle {
+            scene: self.id,
+            group: plan.group.clone(),
+            original,
+            receivers: receiver_origins,
+            muted_source,
+            committed_at,
+            commit,
+        };
+        Ok((outcome, handle))
+    }
+}
