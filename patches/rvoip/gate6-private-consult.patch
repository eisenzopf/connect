+//! Current host audience grant over real signed-confirmed TLS native routes.
+use super::*;
+use rvoip_core::staged_streams::{audience::*, audio_subscriptions::AudioSubscription};
+struct Invocation {
+    domain: Arc<Grants>,
+    guard: Arc<OwnedRwLockReadGuard<State>>,
+    plan: AudioAudiencePlan,
+}
+struct Held {
+    invocation: Arc<Invocation>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for Held {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_receive(&self, source: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        subscriptions::receive(&self.invocation.guard, self.owner.clone(), source)
+    }
+    fn control_participant_receive(
+        &self,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<MediaOwner>> {
+        future_subscriptions::participant_receive(
+            &self.invocation.guard,
+            self.owner.clone(),
+            source,
+        )
+    }
+}
+pub(super) fn held(
+    domain: &Grants,
+    scope: &MediaScope<'_>,
+    intent: &MediaControlIntent<'_>,
+    held: &(dyn Any + Send + Sync),
+) -> Option<ControlResult<MediaControl>> {
+    let invocation = held.downcast_ref::<Arc<Invocation>>()?;
+    Some((|| {
+        let MediaControlIntent::AudioAudience { plan } = intent else {
+            return Err(StreamControlError::Authority);
+        };
+        if !Arc::ptr_eq(&domain.0, &invocation.domain.0)
+            || invocation.guard.denied
+            || !invocation.plan.same_intent(plan)
+            || !plan
+                .expected_receiver_revisions()
+                .contains_key(scope.connection)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut owner = credential_owner(
+            invocation
+                .guard
+                .owners
+                .get(scope.connection)
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            scope.principal,
+        )?;
+        if let Some(a) = invocation
+            .guard
+            .activations
+            .lock()
+            .unwrap()
+            .get(scope.connection)
+        {
+            owner = a.current(owner)?;
+        }
+        owner
+            .actor
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        if !owner.may_control {
+            return Err(StreamControlError::Authority);
+        }
+        MediaControl::new(
+            Box::new(Held {
+                invocation: invocation.clone(),
+                owner,
+            }),
+            CancellationToken::new(),
+            deadline(),
+        )
+    })())
+}
+#[tokio::test]
+async fn actual_native_closed_audience_commit_preserves_signed_confirmation_and_retained_bindings()
+{
+    for kind in ["quic", "wt"] {
+        let mut s = Scene::new_bootstrap(kind).await;
+        let (answer, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendrecv")).await;
+        s.confirm(&callback).await;
+        s.wait(1).await;
+        let ah = answer.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+            .as_u64()
+            .unwrap() as u16;
+        let mut other = s.second_wire().await;
+        let (answer, callback) =
+            other_prepared(&s, &mut other, lifecycle_offer(&s, 1, 0, "sendrecv")).await;
+        other.send(s.f.sign(s.confirmation(&callback))).await;
+        s.wait(2).await;
+        let bh = answer.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+            .as_u64()
+            .unwrap() as u16;
+        let core = &s.native.core.orch;
+        let sid = &s.native.core.session;
+        let adapter = &s.native.adapters[&s.kind];
+        core_fixture::until(|| core.session(sid).unwrap().read().unwrap().connections.len() == 2)
+            .await;
+        let before = s.controller().active_bindings()[0].clone();
+        let revision = s.controller().revision();
+        let source = |id: ConnectionId| vec![AudioSubscription::Connection(id)];
+        let plan = core
+            .plan_staged_audio_audience(
+                sid,
+                AudioAudienceRequest {
+                    operation_id: "native-closed-audience".into(),
+                    expected_revision: core.audio_audience_revision(sid).unwrap(),
+                    private_connections: BTreeSet::from([s.id.clone(), s.second_id.clone()]),
+                    receivers: BTreeMap::from([
+                        (s.id.clone(), source(s.second_id.clone())),
+                        (s.second_id.clone(), source(s.id.clone())),
+                    ]),
+                    activate_muted: None,
+                },
+            )
+            .unwrap();
+        let invocation = Arc::new(Invocation {
+            domain: s.grants.clone(),
+            guard: Arc::new(s.grants.0.clone().read_owned().await),
+            plan: plan.clone(),
+        });
+        let (_, handle) = core
+            .change_staged_audio_audience_with_held(
+                sid,
+                plan,
+                deadline(),
+                CancellationToken::new(),
+                &invocation,
+            )
+            .await
+            .unwrap();
+        drop(invocation);
+        for id in [&s.id, &s.second_id] {
+            adapter
+                .observe_audio_audience_commit(id, handle.commit())
+                .unwrap();
+            adapter
+                .observe_audio_audience_commit(id, handle.commit())
+                .unwrap();
+        }
+        assert_eq!(s.controller().revision(), revision + 1);
+        assert_eq!(
+            s.controller().active_bindings()[0].stream_local_id,
+            before.stream_local_id
+        );
+        assert_eq!(
+            s.controller().active_bindings()[0].transport_id,
+            before.transport_id
+        );
+        // These two signed endpoints belong to the same Participant. MCU
+        // self-echo remains suppressed; distinct-owner Core tests qualify the
+        // decoded consultation paths. Here the proof is retained confirmation.
+        send(&s.wire, encoded_audio(ah, 0, 1));
+        send(&other, encoded_audio(bh, 0, 2));
+        let plan = core
+            .plan_restore_staged_audio_audience(
+                sid,
+                &handle,
+                "native-restore".into(),
+                core.audio_audience_revision(sid).unwrap(),
+            )
+            .unwrap();
+        let invocation = Arc::new(Invocation {
+            domain: s.grants.clone(),
+            guard: Arc::new(s.grants.0.clone().read_owned().await),
+            plan: plan.clone(),
+        });
+        let (_, restored) = core
+            .change_staged_audio_audience_with_held(
+                sid,
+                plan,
+                deadline(),
+                CancellationToken::new(),
+                &invocation,
+            )
+            .await
+            .unwrap();
+        drop(invocation);
+        assert!(adapter
+            .observe_audio_audience_commit(&s.id, handle.commit())
+            .is_err());
+        for id in [&s.id, &s.second_id] {
+            adapter
+                .observe_audio_audience_commit(id, restored.commit())
+                .unwrap();
+        }
+        s.wire.server.shutdown().await.unwrap();
+        other.server.shutdown().await.unwrap();
+    }
+}
