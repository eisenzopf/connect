+impl Room {
+    fn consultation_plan(&self) -> crate::staged_streams::consultation::PrivateConsultationPlan {
+        use crate::staged_streams::consultation::*;
+        self.scene
+            .plan_private_consultation(PrivateConsultationRequest {
+                operation_id: "private-call".into(),
+                expected_revision: self.scene.audience_revision(),
+                primary: ConnectionId::from_string("alice"),
+                remote: ConnectionId::from_string("bob"),
+                consultant: ConnectionId::from_string("consult"),
+                hold_source: Some(ConnectionId::from_string("hold")),
+            })
+            .unwrap()
+    }
+    async fn start_consultation(
+        &self,
+    ) -> crate::staged_streams::consultation::PrivateConsultationHandle {
+        let plan = self.consultation_plan();
+        let grant = self
+            .grant(Approval::Audience(plan.audience().clone()))
+            .await;
+        self.scene
+            .start_private_consultation(plan, deadline(), CancellationToken::new(), &grant)
+            .await
+            .unwrap()
+            .1
+    }
+    async fn restore_consultation(
+        &self,
+        handle: &crate::staged_streams::consultation::PrivateConsultationHandle,
+    ) -> AudioAudienceOutcome {
+        let plan = self
+            .scene
+            .plan_restore_audio_audience(
+                handle.audience(),
+                "consult-restore".into(),
+                self.scene.audience_revision(),
+            )
+            .unwrap();
+        self.apply(plan).await.unwrap().0
+    }
+}
