@@ -0,0 +1,225 @@
+//! General private consultation lifecycle in one retained managed Session.
+//!
+//! The host creates/adopts a private leg with the existing bounded admission
+//! operation first. Failed leg creation never switches the original bridge.
+//! The engine owns audience isolation, hold, actual audio observation and
+//! restoration. Prompts, provider Context content and business approval belong
+//! to the host. Handles retain metadata, never a live authorization reader.
+use super::{
+    audience::*, audio_subscriptions::AudioSubscription, media_scene::GuardedMediaScene, *,
+};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PrivateConsultationRequest {
+    pub operation_id: String,
+    pub expected_revision: u64,
+    pub primary: ConnectionId,
+    pub remote: ConnectionId,
+    pub consultant: ConnectionId,
+    /// None means silence. Some selects an already admitted, authorized source;
+    /// no prompt or hold-media bytes are interpreted by this engine.
+    pub hold_source: Option<ConnectionId>,
+}
+#[derive(Clone)]
+pub struct PrivateConsultationPlan {
+    audience: AudioAudiencePlan,
+    primary: AudienceOrigin,
+    remote: AudienceOrigin,
+    consultant: AudienceOrigin,
+}
+impl PrivateConsultationPlan {
+    pub fn audience(&self) -> &AudioAudiencePlan {
+        &self.audience
+    }
+}
+#[derive(Clone)]
+pub struct PrivateConsultationHandle {
+    audience: AudioAudienceHandle,
+    primary: AudienceOrigin,
+    remote: AudienceOrigin,
+    consultant: AudienceOrigin,
+}
+impl PrivateConsultationHandle {
+    pub fn audience(&self) -> &AudioAudienceHandle {
+        &self.audience
+    }
+}
+/// Bounded media preparation outcome, not Connection.ready or presence.
+/// A non-audio outcome requires a fresh, authorized restore operation. The
+/// private audience remains closed while restoration is pending or denied.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PrivateConsultationMediaOutcome {
+    DecodedAudioObserved,
+    MediaTimeout,
+    Cancelled,
+    PrimaryEnded,
+    RemoteEnded,
+    ConsultantEnded,
+    AlreadyRestored,
+}
+impl GuardedMediaScene {
+    pub(crate) fn plan_private_consultation(
+        &self,
+        request: PrivateConsultationRequest,
+    ) -> ControlResult<PrivateConsultationPlan> {
+        if request.primary == request.remote
+            || request.primary == request.consultant
+            || request.remote == request.consultant
+            || request.hold_source.as_ref().is_some_and(|id| {
+                id == &request.primary || id == &request.remote || id == &request.consultant
+            })
+        {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        let (primary, remote, consultant) = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let get = |id: &ConnectionId| {
+                members
+                    .get(id)
+                    .map(|m| AudienceOrigin::new(&m.controller))
+                    .ok_or(StreamControlError::NotReady)
+            };
+            (
+                get(&request.primary)?,
+                get(&request.remote)?,
+                get(&request.consultant)?,
+            )
+        };
+        let source = |id: ConnectionId| vec![AudioSubscription::Connection(id)];
+        let audience = self.plan_audio_audience(AudioAudienceRequest {
+            operation_id: request.operation_id,
+            expected_revision: request.expected_revision,
+            private_connections: BTreeSet::from([
+                request.primary.clone(),
+                request.consultant.clone(),
+            ]),
+            receivers: BTreeMap::from([
+                (request.primary, source(request.consultant.clone())),
+                (
+                    request.consultant.clone(),
+                    source(primary.connection.clone()),
+                ),
+                (
+                    request.remote,
+                    request.hold_source.map(source).unwrap_or_default(),
+                ),
+            ]),
+            activate_muted: Some(request.consultant),
+        })?;
+        // The plan pins every admitted controller, including the retained remote.
+        for origin in [&primary, &remote, &consultant] {
+            if !audience
+                .controllers
+                .get(&origin.connection)
+                .is_some_and(|c| Weak::ptr_eq(c, &origin.controller))
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+        }
+        Ok(PrivateConsultationPlan {
+            audience,
+            primary,
+            remote,
+            consultant,
+        })
+    }
+    pub(crate) async fn start_private_consultation(
+        &self,
+        plan: PrivateConsultationPlan,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<(AudioAudienceOutcome, PrivateConsultationHandle)> {
+        let (outcome, audience) = self
+            .apply_audio_audience(plan.audience, deadline, cancel, held)
+            .await?;
+        Ok((
+            outcome,
+            PrivateConsultationHandle {
+                audience,
+                primary: plan.primary,
+                remote: plan.remote,
+                consultant: plan.consultant,
+            },
+        ))
+    }
+    pub(crate) async fn wait_private_consultation_audio(
+        &self,
+        handle: &PrivateConsultationHandle,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<PrivateConsultationMediaOutcome> {
+        use PrivateConsultationMediaOutcome as Outcome;
+        if handle.audience.scene != self.id {
+            return Err(StreamControlError::Authority);
+        }
+        loop {
+            // Register before inspecting state so neither a decoded frame nor a
+            // departure can be lost between inspection and sleeping.
+            let membership = self.selection_changed.notified();
+            tokio::pin!(membership);
+            membership.as_mut().enable();
+            let (consumer, primary_lifetime, remote_lifetime) = {
+                let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+                let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+                if !registry
+                    .groups
+                    .get(&handle.audience.group.operation)
+                    .is_some_and(|g| Arc::ptr_eq(g, &handle.audience.group))
+                {
+                    return Ok(Outcome::AlreadyRestored);
+                }
+                for (origin, ended) in [
+                    (&handle.primary, Outcome::PrimaryEnded),
+                    (&handle.remote, Outcome::RemoteEnded),
+                    (&handle.consultant, Outcome::ConsultantEnded),
+                ] {
+                    if !members.get(&origin.connection).is_some_and(|m| {
+                        origin.matches(&m.controller) && !m.controller.shutdown.is_cancelled()
+                    }) {
+                        return Ok(ended);
+                    }
+                }
+                (
+                    members[&handle.consultant.connection]
+                        .audio_consumer
+                        .clone(),
+                    members[&handle.primary.connection]
+                        .controller
+                        .shutdown
+                        .clone(),
+                    members[&handle.remote.connection]
+                        .controller
+                        .shutdown
+                        .clone(),
+                )
+            };
+            let audio = consumer.decoded_changed.notified();
+            tokio::pin!(audio);
+            audio.as_mut().enable();
+            if cancel.is_cancelled() {
+                return Ok(Outcome::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Ok(Outcome::MediaTimeout);
+            }
+            let controller = handle
+                .consultant
+                .controller
+                .upgrade()
+                .ok_or(StreamControlError::NotReady)?;
+            if consumer.decoded_since(&controller, handle.audience.committed_at) {
+                return Ok(Outcome::DecodedAudioObserved);
+            }
+            tokio::select! { biased;
+                _=cancel.cancelled()=>return Ok(Outcome::Cancelled),
+                _=tokio::time::sleep_until(deadline)=>return Ok(Outcome::MediaTimeout),
+                _=&mut membership=>{},
+                _=&mut audio=>{},
+                _=controller.shutdown.cancelled()=>{},
+                _=primary_lifetime.cancelled()=>{},
+                _=remote_lifetime.cancelled()=>{},
+            }
+        }
+    }
+}
