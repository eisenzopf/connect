+/// Actual scene/controller pins and original programmes. A handle grants no
+/// future restoration authority and never retains the original command reader.
+#[derive(Clone)]
+pub struct AudioAudienceHandle {
+    pub(super) scene: u128,
+    pub(super) group: Arc<ClosedAudience>,
+    pub(super) original: BTreeMap<ConnectionId, SavedAudioProgram>,
+    pub(super) receivers: BTreeMap<ConnectionId, AudienceOrigin>,
+    pub(super) muted_source: Option<AudienceOrigin>,
+    pub(super) committed_at: Instant,
+    commit: AudioAudienceCommit,
+}
+impl AudioAudienceHandle {
+    pub fn commit(&self) -> &AudioAudienceCommit {
+        &self.commit
+    }
+    pub fn operation_id(&self) -> &str {
+        &self.group.operation
+    }
+    pub fn connections(&self) -> BTreeSet<ConnectionId> {
+        self.receivers.keys().cloned().collect()
+    }
+}
+/// Core-issued evidence of a route-only commit. Private fields pin actual
+/// controllers and unchanged ports; public outcome fields are not receipts.
+/// This may carry forward an existing wire confirmation, never create one.
+#[derive(Clone)]
+pub struct AudioAudienceCommit {
+    targets: BTreeMap<ConnectionId, AudienceCommitTarget>,
+}
+#[derive(Clone)]
+struct AudienceCommitTarget {
+    controller: Weak<StreamController>,
+    credential: CredentialSnapshot,
+    previous: u64,
+    revision: u64,
+    ports: Vec<Weak<Port>>,
+}
+impl AudioAudienceCommit {
+    pub fn connections(&self) -> impl Iterator<Item = &ConnectionId> {
+        self.targets.keys()
+    }
+    pub fn revisions_for(&self, controller: &Arc<StreamController>) -> ControlResult<(u64, u64)> {
+        let target = self
+            .targets
+            .get(&controller.connection)
+            .ok_or(StreamControlError::Authority)?;
+        if !Weak::ptr_eq(&target.controller, &Arc::downgrade(controller))
+            || controller.shutdown.is_cancelled()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        controller.check_credential_snapshot(&target.credential)?;
+        let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.closed
+            || state.model.revision() != target.revision
+            || state.active.len() != target.ports.len()
+            || target.ports.iter().any(|p| {
+                !p.upgrade().is_some_and(|p| {
+                    state
+                        .active
+                        .values()
+                        .any(|current| Arc::ptr_eq(current, &p))
+                })
+            })
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        Ok((target.previous, target.revision))
+    }
+}
+#[derive(Clone)]
+pub struct AudioAudiencePlan {
+    pub(super) scene: u128,
+    pub(super) request: AudioAudienceRequest,
+    pub(super) group: Arc<ClosedAudience>,
+    pub(super) expected: BTreeMap<ConnectionId, u64>,
+    pub(super) controllers: BTreeMap<ConnectionId, Weak<StreamController>>,
+    pub(super) restore: Option<AudioAudienceHandle>,
+    pub(super) replaced_preparation: Option<Arc<ClosedAudience>>,
+}
+impl AudioAudiencePlan {
+    /// Exact scene-issued plan identity for a held policy's approval. Matching
+    /// caller-supplied IDs alone is insufficient to approve another scene.
+    pub fn same_intent(&self, other: &Self) -> bool {
+        self.scene == other.scene
+            && self.request == other.request
+            && self.expected == other.expected
+            && Arc::ptr_eq(&self.group, &other.group)
+            && self.controllers.len() == other.controllers.len()
+            && self.controllers.iter().all(|(id, c)| {
+                other
+                    .controllers
+                    .get(id)
+                    .is_some_and(|old| Weak::ptr_eq(c, old))
+            })
+            && self.restore.is_some() == other.restore.is_some()
+            && match (&self.replaced_preparation, &other.replaced_preparation) {
+                (None, None) => true,
+                (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+                _ => false,
+            }
+    }
+    pub fn request(&self) -> &AudioAudienceRequest {
+        &self.request
+    }
+    pub fn expected_receiver_revisions(&self) -> &BTreeMap<ConnectionId, u64> {
+        &self.expected
+    }
+    pub fn is_restore(&self) -> bool {
+        self.restore.is_some()
+    }
+}
+#[derive(Default)]
+pub(super) struct AudienceState {
+    pub revision: u64,
+    pub groups: BTreeMap<String, Arc<ClosedAudience>>,
+    pub preparations: BTreeMap<ConnectionId, Arc<ClosedAudience>>,
+    pub pending: BTreeMap<String, Weak<StreamController>>,
+}
+impl AudienceState {
+    pub(super) fn rules(&self, controller: &StreamController) -> Vec<AudioAudienceRule> {
+        self.groups
+            .values()
+            .map(|group| AudioAudienceRule {
+                group: group.clone(),
+                inside: group.contains(controller),
+            })
+            .collect()
+    }
+}
