+    /// Carry existing signed resource confirmation across an actual Core
+    /// audience commit on this exact installed route. This does not authorize
+    /// an operation or assert Connection readiness or Participant presence.
+    pub fn observe_audio_audience_commit(
+        &self,
+        id: &ConnectionId,
+        commit: &rvoip_core::staged_streams::audience::AudioAudienceCommit,
+    ) -> std::result::Result<(), super::native_negotiation::NativeOfferError> {
+        use super::native_negotiation::NativeOfferError;
+        let route = self.routes.get(id).ok_or(NativeOfferError::NotReady)?;
+        if route.cancel.is_cancelled()
+            || route.physical.context.lifetime.is_cancelled()
+            || route.peer.upgrade().is_none_or(|p| p.is_closed())
+        {
+            return Err(NativeOfferError::NotReady);
+        }
+        let installed = route.installation.lock().unwrap_or_else(|p| p.into_inner());
+        let installed = installed.as_ref().ok_or(NativeOfferError::NotReady)?;
+        let (previous, revision) = commit.revisions_for(&installed.controller)?;
+        let flow = &installed.backend.flow;
+        if flow.confirmed_at(revision) {
+            return Ok(());
+        }
+        if !flow.confirmed_at(previous) {
+            return Err(NativeOfferError::Conflict);
+        }
+        flow.controlled_revision(previous, revision);
+        if !flow.confirmed_at(revision) {
+            return Err(NativeOfferError::Conflict);
+        }
+        Ok(())
     }
