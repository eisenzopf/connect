 use std::{any::Any, sync::Mutex};
 
+struct CatalogReadPause {
+    connection: ConnectionId,
+    armed: AtomicBool,
+    entered: std::sync::mpsc::SyncSender<()>,
+    release: Mutex<std::sync::mpsc::Receiver<()>>,
+}
+impl CatalogReadPause {
+    fn wait(&self, scope: &MediaScope<'_>) -> ControlResult<()> {
+        if scope.connection == &self.connection
+            && matches!(scope.purpose, MediaPurpose::Publish)
+            && self.armed.swap(false, Ordering::AcqRel)
+        {
+            self.entered
+                .send(())
+                .map_err(|_| StreamControlError::Cancelled)?;
+            self.release
+                .lock()
+                .unwrap()
+                .recv_timeout(Duration::from_secs(5))
+                .map_err(|_| StreamControlError::Deadline)?;
+        }
+        Ok(())
+    }
+}
