+//! Explicit optional freeze under the SAME current original read-only FreezeVideo authority.
+//! No replacement publication, B feeding/readiness, fresh nonce or resume API.
+use super::*;
+impl Orchestrator {
+    pub async fn freeze_staged_device_replacement_video_with_held(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,held:&(dyn Any+Send+Sync),
+    )->ControlResult<Arc<crate::staged_streams::old_video_freeze::FrozenOldVideoFrontier>> {
+        let p=&plan.preparation;
+        self.owns_replacement(p)?;p.check()?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let request=scope(p,ReplacementPhase::FreezeVideo,Some(&plan.media));
+        let control=p.runtime.policy.current_replacement_control(&request,held)?;
+        let validate=||->std::result::Result<(),StreamControlError> {
+            self.owns_replacement(p).map_err(handoff::media_error)?;
+            p.check().map_err(handoff::media_error)?;
+            let authority=control.current(&request).map_err(handoff::media_error)?;
+            check_authority(&request,&authority).map_err(handoff::media_error)?;
+            if plan.media.old_may_speak() && !authority.may_send_audio {return Err(StreamControlError::Authority);}
+            Ok(())
+        };
+        validate()?;
+        let realm=p.runtime.frame_realm.as_ref().map(|realm|realm.handle()).and_then(|realm|realm.incarnation())
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let deadline=deadline_for(&p.principal,p.deadline.min(control.deadline));
+        Ok(p.runtime.mixer.staged.as_ref().ok_or(ParticipantControlError::Unsupported)?
+            .freeze_old_video(&plan.media,realm,deadline,p.cancellation.clone(),held,&validate).await?.frontier_metadata())
+    }
+}
