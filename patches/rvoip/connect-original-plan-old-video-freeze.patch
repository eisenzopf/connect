diff --git a/crates/foundation/rvoip-core/src/staged_streams/old_video_freeze.rs b/crates/foundation/rvoip-core/src/staged_streams/old_video_freeze.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/old_video_freeze.rs
@@ -0,0 +1,310 @@
+//! Optional original-plan-owned OLD video EGRESS freeze. No public gate/model
+//! mutation, new authority, target feeding, B readiness or publication occurs.
+//! The only failure cleanup is fail-closed retirement. A future resume API must
+//! FIRST consume real SAME-reservation B discard plus current old authority.
+use super::*;
+use super::physical_video_exposure::{PhysicalVideoExposureSeal,PhysicalVideoExposureSnapshot};
+use rvoip_core_traits::peer_switch::PeerQuiescenceGuard;
+
+/// Opaque SAME-realm conservative potential-exposure ceiling. No public ctor,
+/// Deserialize or Clone. Scalars alone are not a current freeze/IO grant.
+pub struct FrozenOldVideoFrontier {
+    operation:String,source:ConnectionId,target:ConnectionId,realm:u128,ordinal:u64,
+}
+impl FrozenOldVideoFrontier {
+    pub fn operation_id(&self)->&str {&self.operation}
+    pub fn source_connection(&self)->&ConnectionId {&self.source}
+    pub fn target_connection(&self)->&ConnectionId {&self.target}
+    pub fn realm_incarnation(&self)->u128 {self.realm}
+    pub fn ordinal(&self)->u64 {self.ordinal}
+}
+struct FrozenPort {port:Arc<Port>,ticket:PeerRouteTicket,family:u128}
+/// Generic quiesce restores admission when its pending future is dropped. In
+/// THIS strict path retire first, including select/timeout cancellation while
+/// the inner future still owns its not-yet-returned pause guard.
+struct FailClosedQuiescence<F> {
+    ticket:PeerRouteTicket,future:std::pin::Pin<Box<F>>,transferred:bool,
+}
+impl<F:Future<Output=Option<PeerQuiescenceGuard>>> Future for FailClosedQuiescence<F> {
+    type Output=Option<PeerQuiescenceGuard>;
+    fn poll(self:std::pin::Pin<&mut Self>,cx:&mut std::task::Context<'_>)->std::task::Poll<Self::Output> {
+        let this=self.get_mut();
+        match this.future.as_mut().poll(cx) {
+            std::task::Poll::Ready(guard)=>{this.transferred=guard.is_some();std::task::Poll::Ready(guard)}
+            std::task::Poll::Pending=>std::task::Poll::Pending,
+        }
+    }
+}
+impl<F> Drop for FailClosedQuiescence<F> {
+    fn drop(&mut self) {if !self.transferred {self.ticket.retire_if_current();}}
+}
+fn fail_closed_quiescence(ticket:&PeerRouteTicket)->impl Future<Output=Option<PeerQuiescenceGuard>> {
+    let original=ticket.clone();
+    FailClosedQuiescence {ticket:ticket.clone(),future:Box::pin(async move {original.quiesce().await}),transferred:false}
+}
+
+/// Actual nonclone held resources live once in this object, never in a cloned
+/// metadata receipt. Plan clones share only ONE owner/slot.
+struct HeldOldVideo {
+    ports:Vec<FrozenPort>,
+    guards:Vec<PeerQuiescenceGuard>,
+    seal:Option<PhysicalVideoExposureSeal>,
+    _flight:OwnedSemaphorePermit,
+}
+impl Drop for HeldOldVideo {
+    fn drop(&mut self) {
+        // Do NOT let ordinary PeerQuiescenceGuard::Drop resume an uncertain B
+        // handoff. Exact ticket retirement cannot touch a successor generation.
+        for old in &self.ports {old.ticket.retire_if_current();}
+        if let Some(seal)=self.seal.take() {seal.retire();}
+        // guards and original controller flight release only after retirement.
+    }
+}
+pub(crate) struct FrozenOldVideo {
+    intent:Weak<device_replacement::ReplacementIntent>,
+    old:Weak<StreamController>,
+    revision:u64,
+    credential:CredentialSnapshot,
+    deadline:tokio::time::Instant,
+    cancellation:CancellationToken,
+    frontier:Arc<FrozenOldVideoFrontier>,
+    held:Mutex<Option<HeldOldVideo>>,
+}
+impl FrozenOldVideo {
+    /// Historical metadata only. Future B APIs must separately validate this
+    /// same current plan owner and exact target reservation before using it.
+    pub(super) fn frontier(&self)->&FrozenOldVideoFrontier {&self.frontier}
+    pub(crate) fn frontier_metadata(&self)->Arc<FrozenOldVideoFrontier> {self.frontier.clone()}
+    fn current(&self,intent:&device_replacement::ReplacementIntent)->ControlResult<()> {
+        if self.intent.upgrade().is_none_or(|original|!std::ptr::eq(original.as_ref(),intent)) {
+            return Err(StreamControlError::Authority);
+        }
+        if self.cancellation.is_cancelled() {return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=self.deadline {return Err(StreamControlError::Deadline);}
+        let old=self.old.upgrade().ok_or(StreamControlError::Cancelled)?;
+        old.check_credential_snapshot(&self.credential)?;
+        if old.shutdown.is_cancelled() {return Err(StreamControlError::Cancelled);}
+        let held=self.held.lock().map_err(|_|StreamControlError::Authority)?;
+        let held=held.as_ref().ok_or(StreamControlError::Cancelled)?;
+        let seal=held.seal.as_ref().ok_or(StreamControlError::Cancelled)?;
+        if !seal.is_current() || held.ports.iter().any(|p|!p.ticket.is_current()) {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(())
+    }
+    fn validate_old_state(&self,state:&State)->ControlResult<()> {
+        if state.closed || state.model.revision()!=self.revision {return Err(MediaTransitionError::Conflict.into());}
+        let held=self.held.lock().map_err(|_|StreamControlError::Authority)?;
+        let held=held.as_ref().ok_or(StreamControlError::Cancelled)?;
+        let active=visual_sinks(state)?;
+        if active.len()!=held.ports.len() || active.iter().any(|port|!held.ports.iter().any(|p|Arc::ptr_eq(port,&p.port))) {
+            return Err(StreamControlError::Authority);
+        }
+        let seal=held.seal.as_ref().ok_or(StreamControlError::Cancelled)?;
+        for old in &held.ports {
+            validate_port(&old.port,&old.ticket)?;
+            let snapshot=AdapterMediaPort(old.port.clone()).physical_video_exposure_sealed(seal)
+                .ok_or(StreamControlError::Unsupported)?;
+            if !snapshot.coverage_complete || snapshot.physical_family!=old.family ||
+                snapshot.realm_incarnation!=Some(self.frontier.realm) ||
+                snapshot.maximum_potential_ordinal>self.frontier.ordinal ||
+                snapshot.inherited_potential_ordinal>self.frontier.ordinal {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        Ok(())
+    }
+}
+enum FreezeState {Unstarted,Acquiring,Frozen(Arc<FrozenOldVideo>),Terminal}
+pub(super) struct OldVideoFreezeSlot {state:Mutex<FreezeState>}
+impl Default for OldVideoFreezeSlot {fn default()->Self {Self {state:Mutex::new(FreezeState::Unstarted)}}}
+struct FreezeAttempt {slot:Arc<OldVideoFreezeSlot>,published:bool}
+impl Drop for FreezeAttempt {
+    fn drop(&mut self) {
+        if !self.published {
+            *self.slot.state.lock().unwrap_or_else(|p|p.into_inner())=FreezeState::Terminal;
+        }
+    }
+}
+impl OldVideoFreezeSlot {
+    fn begin(self:&Arc<Self>)->ControlResult<FreezeAttempt> {
+        let mut state=self.state.lock().map_err(|_|StreamControlError::Authority)?;
+        if !matches!(*state,FreezeState::Unstarted) {return Err(StreamControlError::NotReady);}
+        *state=FreezeState::Acquiring;
+        Ok(FreezeAttempt {slot:self.clone(),published:false})
+    }
+    fn owner(&self)->Option<Arc<FrozenOldVideo>> {
+        match &*self.state.lock().unwrap_or_else(|p|p.into_inner()) {FreezeState::Frozen(owner)=>Some(owner.clone()),_=>None}
+    }
+    pub(super) fn validate_target(&self,intent:&device_replacement::ReplacementIntent,controller:&StreamController,state:&State)->ControlResult<()> {
+        match &*self.state.lock().map_err(|_|StreamControlError::Authority)? {
+            FreezeState::Unstarted=>Ok(()),
+            FreezeState::Frozen(owner)=>{
+                owner.current(intent)?;
+                if controller.connection==intent.request.source {owner.validate_old_state(state)?;}
+                Ok(())
+            }
+            _=>Err(StreamControlError::NotReady),
+        }
+    }
+    pub(super) fn holds_controller(&self,controller:&Arc<StreamController>)->bool {
+        let Some(owner)=self.owner() else {return false;};
+        if owner.old.upgrade().is_none_or(|old|!Arc::ptr_eq(&old,controller)) {return false;}
+        let Ok(held)=owner.held.lock() else {return false;};
+        held.is_some()
+    }
+    pub(super) fn holds_ticket(&self,ticket:&PeerRouteTicket)->bool {
+        let Some(owner)=self.owner() else {return false;};
+        let Ok(held)=owner.held.lock() else {return false;};
+        held.as_ref().is_some_and(|held|held.ports.iter().any(|old|old.ticket.same_generation(ticket)))
+    }
+    pub(super) fn original_deadline(&self)->Option<tokio::time::Instant> {
+        self.owner().map(|owner|owner.deadline)
+    }
+    pub(super) fn committed(&self) {
+        if let Some(owner)=self.owner() {
+            // Called only AFTER infallible original old model/port retirement.
+            let held=owner.held.lock().unwrap_or_else(|p|p.into_inner()).take();
+            drop(held);
+        }
+    }
+}
+fn visual_sinks(state:&State)->ControlResult<Vec<Arc<Port>>> {
+    let mut ports=Vec::new();
+    for port in state.active.values().filter(|port|port.binding.sink_ready &&
+        matches!(port.binding.negotiated.requested.medium,Medium::Video|Medium::Screen)) {
+        let binding=&port.binding;
+        let logical=state.model.streams().get(&binding.negotiated.requested.logical_id)
+            .ok_or(StreamControlError::Authority)?;
+        if logical.state==LogicalStreamState::Ended || logical.negotiated!=binding.negotiated ||
+            logical.transport_id!=binding.transport_id || logical.stream_local_id!=binding.stream_local_id ||
+            logical.generation!=binding.generation {
+            return Err(StreamControlError::Authority);
+        }
+        ports.push(port.clone());
+    }
+    Ok(ports)
+}
+fn validate_port(port:&Arc<Port>,ticket:&PeerRouteTicket)->ControlResult<()> {
+    let state=port.state.lock().map_err(|_|StreamControlError::Authority)?;
+    if !state.ready || !matches!(state.status,PortStatus::Active|PortStatus::Paused) ||
+        !ticket.is_current() || !port.ticket(TicketSide::Egress).same_generation(ticket) {
+        return Err(StreamControlError::NotReady);
+    }
+    Ok(())
+}
+impl media_scene::GuardedMediaScene {
+    fn validate_freeze_plan(&self,plan:&device_replacement::AudioDeviceReplacementPlan,intent:&device_replacement::ReplacementIntent)->ControlResult<Arc<StreamController>> {
+        let plan=plan.audience();
+        let members=self.members.lock().map_err(|_|StreamControlError::Authority)?;
+        let registry=self.audiences.lock().map_err(|_|StreamControlError::Authority)?;
+        if plan.scene!=self.id || registry.revision!=plan.request.expected_revision ||
+            members.len()!=plan.controllers.len() || !members.iter().all(|(id,member)|plan.controllers.get(id)
+                .is_some_and(|original|Weak::ptr_eq(original,&Arc::downgrade(&member.controller)))) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        for (id,member) in members.iter() {
+            let state=member.controller.state.lock().map_err(|_|StreamControlError::Authority)?;
+            if state.closed || state.model.revision()!=plan.expected[id] {return Err(MediaTransitionError::Conflict.into());}
+            intent.validate_target_without_video_freeze(&member.controller,&state)?;
+        }
+        Ok(members.get(&intent.request.source).ok_or(StreamControlError::NotReady)?.controller.clone())
+    }
+    pub(crate) async fn freeze_old_video(
+        &self,plan:&device_replacement::AudioDeviceReplacementPlan,realm:u128,
+        deadline:tokio::time::Instant,cancel:CancellationToken,held:&(dyn Any+Send+Sync),
+        original_control:&(dyn Fn()->ControlResult<()>+Send+Sync),
+    )->ControlResult<Arc<FrozenOldVideo>> {
+        original_control()?;
+        let intent=plan.audience().replacement.as_ref().ok_or(StreamControlError::Authority)?.clone();
+        if realm==0 || intent.private_consultation_parent().is_some() || !plan.audience().group.origins.is_empty() || intent.video.is_none() {
+            return Err(StreamControlError::Unsupported);
+        }
+        let old=self.validate_freeze_plan(plan,&intent)?;
+        let credential=old.credential_snapshot();
+        let control=old.policy.current_control(&old.scope(&credential.principal,MediaPurpose::Control),
+            &MediaControlIntent::DeviceReplacement {plan:plan.audience()},held)?;
+        let deadline=deadline.min(control.deadline).min(StreamController::command_deadline(&credential.principal,deadline));
+        control.valid()?;
+        // Excludes all ordinary old controller rebind/setup/gate writers while
+        // held. Activation skips only THIS exact plan-owned original flight.
+        let flight=old.inflight.clone().try_acquire_owned().map_err(|_|MediaTransitionError::Conflict)?;
+        let (revision,ports)={
+            let state=old.state.lock().map_err(|_|StreamControlError::Authority)?;
+            let scope=old.scope(&credential.principal,MediaPurpose::Control);
+            let authority=control.authority()?;StreamController::check(&scope,&authority)?;
+            state.model.authorize_binding(&authority.current())?;
+            if !authority.may_control {return Err(StreamControlError::Authority);}
+            let ports=visual_sinks(&state)?;
+            if ports.is_empty() {return Err(StreamControlError::Unsupported);}
+            (state.model.revision(),ports)
+        };
+        let seal=ports[0].video_exposure.get().and_then(|observer|observer.try_seal_coverage())
+            .ok_or(StreamControlError::Unsupported)?;
+        // Known capability failures are effect-free: provisional raw seal and
+        // setup flight drop without ever pausing OLD. Racing unknown metadata
+        // is checked again AFTER drain, where failure must remain fail-closed.
+        let mut checked_ports=Vec::new();
+        for port in ports {
+            let ticket=port.ticket(TicketSide::Egress);validate_port(&port,&ticket)?;
+            let snapshot=AdapterMediaPort(port.clone()).physical_video_exposure_sealed(&seal)
+                .ok_or(StreamControlError::Unsupported)?;
+            if !snapshot.coverage_complete || snapshot.realm_incarnation!=Some(realm) {return Err(StreamControlError::Unsupported);}
+            checked_ports.push(FrozenPort {port,ticket,family:snapshot.physical_family});
+        }
+        original_control()?;control.valid()?;old.check_credential_snapshot(&credential)?;
+        self.validate_freeze_plan(plan,&intent)?;
+        if cancel.is_cancelled() || old.shutdown.is_cancelled() {return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=deadline {return Err(StreamControlError::Deadline);}
+        // Effect-free setup/capability collisions never consume the one-shot
+        // slot. The already-held old flight prevents publication/rebind here.
+        let attempt=intent.video_freeze.begin()?;
+        let mut owned=HeldOldVideo {ports:checked_ports,guards:vec![],seal:Some(seal),_flight:flight};
+        for old_port in &owned.ports {
+            validate_port(&old_port.port,&old_port.ticket)?;
+            owned.guards.push(tokio::select! {biased;
+                _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=control.cancellation.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=old.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),
+                result=tokio::time::timeout_at(deadline,fail_closed_quiescence(&old_port.ticket))=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(StreamControlError::NotReady)?,
+            });
+        }
+        // No model/PortState/Timeline lock or temporary current-authority read
+        // crossed an await. The domain's owned FreezeVideo control MUST retain
+        // only drain-compatible READ custody (Connect's exact scene Reader),
+        // never a Commit Writer. It is not generically policy-lock-free.
+        // Every primary/repair Core guard is now drained on each old sink.
+        original_control()?;control.valid()?;old.check_credential_snapshot(&credential)?;
+        let same=self.validate_freeze_plan(plan,&intent)?;
+        if !Arc::ptr_eq(&same,&old) || cancel.is_cancelled() || tokio::time::Instant::now()>=deadline {
+            return Err(StreamControlError::Cancelled);
+        }
+        let mut maximum=0;
+        for old_port in &mut owned.ports {
+            validate_port(&old_port.port,&old_port.ticket)?;
+            let snapshot:PhysicalVideoExposureSnapshot=AdapterMediaPort(old_port.port.clone())
+                .physical_video_exposure_sealed(owned.seal.as_ref().ok_or(StreamControlError::Authority)?)
+                .ok_or(StreamControlError::Unsupported)?;
+            if !snapshot.coverage_complete || snapshot.realm_incarnation!=Some(realm) {return Err(StreamControlError::Unsupported);}
+            if old_port.family!=snapshot.physical_family {return Err(StreamControlError::Authority);}
