+#[tokio::test]
+async fn original_plan_video_freeze_missing_or_foreign_tracking_or_current_authority_refuses() {
+    for mode in 0..7 {
+        let (realm,exposure,coverage)=namespace();
+        if mode==1 {exposure.mark_untracked();}
+        if mode==2 {assert!(coverage.mark_escaped());}
+        let mut f=Preroll::new_with_physical_exposure(false,(mode!=0).then(||exposure.clone())).await;
+        f.movement.io().await;f.movement.confirm().await;
+        let plan=f.movement.plan_with_video(Some(request())).unwrap();
+        let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+        let old=f.movement.room.nodes["alice"].controller.clone();
+        let result=caught(async {
+            if mode==5 {f.movement.room.domain.deny_replacement.store(true,Ordering::Release);}
+            if mode==6 {
+                old.change_direct_subscriptions(old.revision(),DirectSubscriptionChange::Clear,deadline(),CancellationToken::new(),None).await.unwrap();
+                assert_ne!(old.revision(),plan.audience().expected_receiver_revisions()[&old.connection]);
+            }
+            let check=||if mode==3 {Err(StreamControlError::Authority)} else {Ok(())};
+            let expected=if mode==4 {realm.handle().incarnation().unwrap().wrapping_add(1)} else {realm.handle().incarnation().unwrap()};
+            let frozen=f.movement.room.scene.freeze_old_video(&plan,expected,deadline(),CancellationToken::new(),&grant,&check).await;
+            assert!(frozen.is_err());
+            assert!(!old.shutdown.is_cancelled(),"failure does not claim participant retirement");
+            if matches!(mode,3|5|6) {assert!(f.movement.room.nodes["alice"].adapter.port(Medium::Video).0.ticket(TicketSide::Egress).is_active(),
+                "definite authority refusal before freeze has no IO effect");}
+        }).await;
+        drop(grant);drop(plan);finish(&f).await;
+        if let Err(error)=result {std::panic::resume_unwind(error)}
+    }
