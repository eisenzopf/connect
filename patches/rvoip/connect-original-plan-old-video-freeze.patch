+//! Real engine plan/policy/queued primary+repair guards. The adapter's optional
+//! metadata recorder is modeled explicitly; no native UDP/B grant is claimed.
+use super::*;
+use crate::staged_streams::physical_video_exposure::{PhysicalVideoExposure,PhysicalVideoExposureCoverage};
+use crate::staged_streams::frame_realm::FrameRealmTestOwner;
+use std::future::{Future,poll_fn};
+use std::task::Poll;
+async fn caught<T>(future:impl Future<Output=T>)->Result<T,Box<dyn std::any::Any+Send>> {
+    let mut future=Box::pin(future);
+    poll_fn(|cx|match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||future.as_mut().poll(cx))) {
+        Ok(Poll::Pending)=>Poll::Pending,Ok(Poll::Ready(value))=>Poll::Ready(Ok(value)),Err(error)=>Poll::Ready(Err(error)),
+    }).await
+}
+async fn poll_pending(future:std::pin::Pin<&mut impl Future>){
+    let mut future=future;
+    poll_fn(|cx|{assert!(future.as_mut().poll(cx).is_pending());Poll::Ready(())}).await;
+}
+fn namespace()->(FrameRealmTestOwner,Arc<PhysicalVideoExposure>,Arc<PhysicalVideoExposureCoverage>) {
+    let realm=FrameRealmTestOwner::new(ConversationId::from_string("conversation"),SessionId::from_string("session"));
+    let exposure=Arc::new(PhysicalVideoExposure::default());
+    let coverage=Arc::new(PhysicalVideoExposureCoverage::new(false));
+    exposure.configure_expected_realm(realm.handle().incarnation());exposure.bind_coverage(coverage.clone());
+    (realm,exposure,coverage)
+}
+async fn finish(f:&Preroll) {
+    // Independently attempt EVERY original controller, then all adapter counts.
+    let controllers=f.movement.room.nodes.values().map(|n|n.controller.clone()).collect::<Vec<_>>();
+    let mut joins=Vec::new();
+    for controller in controllers {joins.push(controller.shutdown(deadline()).await);}
+    let counts=f.movement.room.nodes.values().map(|n|n.adapter.outstanding.load(Ordering::Acquire)).collect::<Vec<_>>();
+    assert!(joins.iter().all(|remaining|*remaining==0),"all original engine cleanup joins");
+    assert!(counts.iter().all(|count|*count==0),"all original adapter cleanup counts: {counts:?}");
+}
+#[tokio::test]
+async fn original_plan_video_freeze_drains_actual_primary_and_repair_without_stopping_camera_audio() {
+    let (realm,exposure,coverage)=namespace();
+    let mut f=Preroll::new_with_physical_exposure(false,Some(exposure.clone())).await;
+    f.movement.io().await;f.movement.confirm().await;
+    let plan=f.movement.plan_with_video(Some(request())).unwrap();
+    let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+    let old=f.movement.room.nodes["alice"].controller.clone();
+    let old_port=f.movement.room.nodes["alice"].adapter.port(Medium::Video);
+    let input_ticket=old_port.0.ticket(TicketSide::Ingress);
+    let output_ticket=old_port.0.ticket(TicketSide::Egress);
+    let original_revision=old.revision();
+    let result=caught(async {
+        f.publish_video("bob",40);
+        let first=outgoing(&mut f.old_output).await;
+        let p1=realm.handle().next_point().unwrap();
+        let repair=first.deliver_video_with_repair(|_|async {exposure.record_potential(Some(p1));Ok(())}).await.unwrap();
+        f.publish_video("bob",41);
+        let primary=outgoing(&mut f.old_output).await;
+        let p2=realm.handle().next_point().unwrap();
+        let (primary_release,primary_wait)=tokio::sync::oneshot::channel::<()>();
+        let (repair_release,repair_wait)=tokio::sync::oneshot::channel::<()>();
+        let mut primary=Box::pin(primary.deliver(|_|async {exposure.record_potential(Some(p2));primary_wait.await.unwrap();Ok(())}));
+        let mut repairing=Box::pin(repair.repair(|_,_|async {exposure.record_potential(Some(p1));repair_wait.await.unwrap();Ok(())}));
+        poll_pending(primary.as_mut()).await;poll_pending(repairing.as_mut()).await;
+        let scene=f.movement.room.scene.clone();let check=||Ok(());
+        let mut freezing=Box::pin(scene.freeze_old_video(&plan,realm.handle().incarnation().unwrap(),deadline(),CancellationToken::new(),&grant,&check));
+        poll_pending(freezing.as_mut()).await;
+        assert!(!output_ticket.is_active());assert!(output_ticket.is_current());
+        assert!(input_ticket.is_active());assert_eq!(old.revision(),original_revision);
+        assert!(!coverage.mark_escaped(),"same original raw peer stays sealed while IO drains");
+        primary_release.send(()).unwrap();primary.await.unwrap();
+        poll_pending(freezing.as_mut()).await; // original repair guard still held
+        repair_release.send(()).unwrap();repairing.await.unwrap();
+        let frozen=freezing.await.unwrap();
+        assert_eq!(frozen.frontier().ordinal(),p2.ordinal());
+        assert_eq!(frozen.frontier().realm_incarnation(),p2.incarnation());
+        assert_eq!(frozen.frontier().source_connection(),&old.connection);
+        assert_eq!(frozen.frontier().target_connection(),&f.movement.room.nodes["device"].controller.connection);
+        assert!(!output_ticket.is_active());assert!(input_ticket.is_active());
+        assert_eq!(old.revision(),original_revision);
+        assert!(old.change(old.revision(),&[desired(Medium::Audio),desired(Medium::Video)],&BTreeSet::new(),deadline(),CancellationToken::new()).await.is_err(),
+            "the same held setup flight must exclude a future rebind writer");
+        // Existing media admission is unaffected on microphone/camera INGRESS.
+        f.movement.room.publish("alice",900).unwrap();
+        f.publish_video("alice",42);delivered(&mut f.bob_output,42).await;
+        assert!(input_ticket.is_active());
+        // Flat inherited ceiling is opaque, same realm, no parent owner chain.
+        let inherited=Arc::new(PhysicalVideoExposure::default());
+        inherited.configure_expected_realm(realm.handle().incarnation());inherited.bind_coverage(Arc::new(PhysicalVideoExposureCoverage::new(false)));
+        inherited.inherit_frontier(frozen.frontier());
+        assert_eq!(inherited.observer().snapshot().unwrap().inherited_potential_ordinal,p2.ordinal());
+        let clone=plan.clone();assert!(scene.freeze_old_video(&clone,p2.incarnation(),deadline(),CancellationToken::new(),&grant,&check).await.is_err());
+        frozen.frontier_metadata() // metadata survives cleanup without owning the guard/flight
+    }).await;
+    drop(grant);drop(plan); // drop last same-plan owner before bounded shutdown
+    finish(&f).await;
+    assert!(!output_ticket.is_current(),"unconsumed freeze fails closed, never resumes OLD");
+    assert!(!coverage.mark_escaped());
+    if let Ok(metadata)=&result {assert_eq!(metadata.ordinal(),2);}
+    if let Err(error)=result {std::panic::resume_unwind(error)}
+}
+#[tokio::test]
+async fn original_plan_video_freeze_activation_consumes_same_flight_and_egress_guards_once() {
+    for expired in [false,true] {
+    let (realm,exposure,coverage)=namespace();
+    let mut f=Preroll::new_with_physical_exposure(false,Some(exposure.clone())).await;
+    f.movement.io().await;f.movement.confirm().await;
+    let plan=f.movement.plan_with_video(Some(request())).unwrap();
+    let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+    let result=caught(async {
+        f.publish_video("bob",45);let original=outgoing(&mut f.old_output).await;
+        let point=realm.handle().next_point().unwrap();
+        original.deliver(|_|async {exposure.record_potential(Some(point));Ok(())}).await.unwrap();
+        let check=||Ok(());
+        let original_cutoff=deadline();
+        let frozen=f.movement.room.scene.freeze_old_video(&plan,point.incarnation(),original_cutoff,CancellationToken::new(),&grant,&check).await.unwrap();
+        if expired {
+            tokio::time::sleep_until(original_cutoff).await;
+            let revision=f.movement.room.nodes["device"].controller.revision();
+            let refused=f.movement.commit(plan.clone()).await;
+            assert!(matches!(refused,Err(StreamControlError::Deadline)),"new Commit authority extended original freeze cutoff");
+            assert_eq!(f.movement.room.nodes["device"].controller.revision(),revision);
+            assert!(!f.movement.room.nodes["alice"].controller.shutdown.is_cancelled());
+            assert_eq!(frozen.frontier().ordinal(),point.ordinal());
+            return;
+        }
+        let duplicate=plan.clone();
+        let committed=f.movement.commit(plan.clone()).await.unwrap();
+        assert_eq!(frozen.frontier().ordinal(),point.ordinal());
+        assert!(f.movement.room.nodes["alice"].controller.shutdown.is_cancelled());
+        assert!(f.movement.commit(duplicate).await.is_err(),"same original plan cannot republish");
+        assert_eq!(committed.1.finish_local_media_cleanup(deadline()).await,ReplacementCleanupOutcome::LocalMediaClosed);
+    }).await;
+    drop(grant);drop(plan);finish(&f).await;
+    assert!(!coverage.mark_escaped());
+    if let Err(error)=result {std::panic::resume_unwind(error)}
+}
