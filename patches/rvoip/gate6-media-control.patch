+struct HeldControlContext {
+    domain: Arc<Policy>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    principal: AuthenticatedPrincipal,
+    connection: ConnectionId,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+struct HeldPolicy {
+    base: Arc<Policy>,
+    current_calls: AtomicUsize,
+    held_calls: AtomicUsize,
+}
+struct HeldOwnerLease {
+    owner: MediaOwner,
+    _guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+}
+impl MediaAuthorityLease for HeldOwnerLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+impl MediaPolicy for HeldPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.current_calls.fetch_add(1, Ordering::AcqRel);
+        self.base.current(scope)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        _intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<HeldControlContext>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.base, &held.domain)
+            || held.connection != *scope.connection
+            || !held.principal.has_same_owner(scope.principal)
+            || held.principal.scopes != scope.principal.scopes
+            || held.principal.expires_at != scope.principal.expires_at
+            || held.principal.method != scope.principal.method
+            || held.principal.assurance.kind() != scope.principal.assurance.kind()
+            || held.guard.revoked.contains(&scope.principal.subject)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.held_calls.fetch_add(1, Ordering::AcqRel);
+        let owner = held
+            .guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        MediaControl::new(
+            Box::new(HeldOwnerLease {
+                owner,
+                _guard: held.guard.clone(),
+            }),
+            held.cancellation.clone(),
+            held.deadline,
+        )
+    }
+}
+impl HeldPolicy {
+    fn new(f: &Fixture) -> Arc<Self> {
+        Arc::new(Self {
+            base: f.policy.clone(),
+            current_calls: AtomicUsize::new(0),
+            held_calls: AtomicUsize::new(0),
+        })
+    }
+}
+async fn held_context(
+    f: &Fixture,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+) -> Arc<HeldControlContext> {
+    Arc::new(HeldControlContext {
+        domain: f.policy.clone(),
+        guard: Arc::new(f.policy.0.clone().read_owned().await),
+        principal: f.a.principal.clone(),
+        connection: f.a.connection.clone(),
+        cancellation,
+        deadline,
+    })
+}
+fn held_controller(
+    f: &Fixture,
+    policy: Arc<dyn MediaPolicy>,
+    held: &(dyn Any + Send + Sync),
+) -> ControlResult<Arc<StreamController>> {
+    StreamController::with_held_control(
