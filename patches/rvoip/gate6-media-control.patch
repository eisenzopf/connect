+//! Canonical authenticated invocation -> actual native controller, with a real
+//! held grant guard. Negotiation readiness remains controlled in this scope.
+use super::*;
+use rvoip_uctp::v2::payloads::{ConnectionUpdateAction, Payload};
+use std::{any::Any, sync::Mutex};
+
+struct Invocation {
+    domain: Arc<MediaGrants>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    principal: AuthenticatedPrincipal,
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    cancellation: CancellationToken,
+    deadline: Instant,
+    action: ConnectionUpdateAction,
+    expected: u64,
+}
+struct DerivedLease {
+    owner: MediaOwner,
+    _guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+}
+impl MediaAuthorityLease for DerivedLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+struct HeldWirePolicy {
+    base: Arc<MediaGrants>,
+    fresh: AtomicUsize,
+    held: AtomicUsize,
+}
+impl MediaPolicy for HeldWirePolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.fresh.fetch_add(1, Ordering::AcqRel);
+        self.base.current(scope)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<Invocation>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.base, &held.domain)
+            || held.conversation != *scope.conversation
+            || held.session != *scope.session
+            || held.connection != *scope.connection
+            || !held.principal.has_same_owner(scope.principal)
+            || held.principal.expires_at != scope.principal.expires_at
+            || held.principal.scopes != scope.principal.scopes
+            || held.principal.method != scope.principal.method
+            || held.principal.assurance.kind() != scope.principal.assurance.kind()
+            || held.guard.denied.contains(scope.connection)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let intent_matches = match intent {
+            MediaControlIntent::Initialize => {
+                held.action == ConnectionUpdateAction::CodecRenegotiate
+            }
+            MediaControlIntent::Change {
+                expected,
+                desired,
+                replace,
+            } => {
+                held.action == ConnectionUpdateAction::CodecRenegotiate
+                    && *expected == held.expected
+                    && desired.len() == 1
+                    && desired[0] == super::desired(Medium::Audio)
+                    && replace.is_empty()
+            }
+            MediaControlIntent::Pause {
+                logical,
+                expected,
+                paused,
+            } => {
+                *expected == held.expected
+                    && logical.as_str() == "audio"
+                    && if *paused {
+                        held.action == ConnectionUpdateAction::Hold
+                    } else {
+                        held.action == ConnectionUpdateAction::Resume
+                    }
+            }
+            MediaControlIntent::End { .. } => false,
+        };
+        if !intent_matches {
+            return Err(StreamControlError::Authority);
+        }
+        self.held.fetch_add(1, Ordering::AcqRel);
+        let owner = held
+            .guard
+            .owners
+            .get(scope.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        MediaControl::new(
+            Box::new(DerivedLease {
+                owner,
+                _guard: held.guard.clone(),
+            }),
+            held.cancellation.clone(),
+            held.deadline,
+        )
+    }
+}
+struct Proof {
+    _base: AuthorityLease,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    connection: ConnectionId,
+}
+struct Authority {
+    base: Arc<WirePolicy>,
+    media: Arc<HeldWirePolicy>,
+}
+#[async_trait]
+impl PeerAuthority for Authority {
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let base = self.base.acquire(c, d, i, e).await?;
+        if e.kind() != "connection.update" {
+            return Ok(base);
+        }
+        if e.scope(Scope::Conversation) != Some("conversation")
+            || e.scope(Scope::Session) != Some("session")
+        {
+            return Err(DispatchError::Authority);
+        }
+        let original = base
+            .authority::<WireProof>()
+            .ok_or(DispatchError::Authority)?;
+        let connection = original
+            ._guard
+            .connections
+            .get(e.scope(Scope::Connection).ok_or(DispatchError::Authority)?)
+            .ok_or(DispatchError::Authority)?
+            .clone();
+        let guard = Arc::new(self.media.base.0.clone().read_owned().await);
+        if guard.denied.contains(&connection) {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(Arc::new(Proof {
+            _base: base,
+            guard,
+            connection,
+        })))
+    }
+    async fn refresh(
+        &self,
+        a: &ValidatedBearer,
+        b: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.base.refresh(a, b, d, i, e).await
+    }
+}
+#[derive(Default)]
+struct Record {
+    save: AtomicBool,
+    wrong_intent: AtomicBool,
+    wrong_intent_denied: AtomicBool,
+    saved: Mutex<Option<(Arc<Invocation>, Arc<StreamController>)>>,
+}
+struct ControlFactory {
+    native: Arc<Factory>,
+    media: Arc<HeldWirePolicy>,
+    readiness: Arc<Readiness>,
+    record: Arc<Record>,
+}
+struct ControlHandler {
+    native: NativeHandler,
+    adapter: Arc<CanonicalNativeAdapter>,
+    media: Arc<HeldWirePolicy>,
+    readiness: Arc<Readiness>,
+    record: Arc<Record>,
+}
+impl PhysicalHandlerFactory for ControlFactory {
+    fn handler(
+        &self,
+        context: NativeTransportContext,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        let source = NativePhysicalBinding::new(context);
+        let record = Arc::new(PhysicalRecord::default());
+        self.native.records.lock().unwrap().push(record.clone());
+        Ok(Arc::new(ControlHandler {
+            adapter: self.native.adapters[&source.transport()].clone(),
+            native: NativeHandler {
+                core: self.native.core.clone(),
+                source,
+                record,
+            },
+            media: self.media.clone(),
+            readiness: self.readiness.clone(),
+            record: self.record.clone(),
+        }))
+    }
+}
+#[async_trait]
+impl AuthenticatedHandler for ControlHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        if authorized.envelope().kind() == "connection.offer" {
+            return self.native.handle(authorized).await;
+        }
+        let Payload::ConnectionUpdate(update) = authorized.envelope().payload() else {
+            return Err(DispatchError::Unsupported);
+        };
+        let proof = authorized
+            .authority::<Arc<Proof>>()
+            .ok_or(DispatchError::Authority)?;
+        let invocation = Arc::new(Invocation {
+            domain: self.media.base.clone(),
+            guard: proof.guard.clone(),
+            principal: authorized.principal().clone(),
+            conversation: self.native.core.conversation.clone(),
+            session: self.native.core.session.clone(),
+            connection: proof.connection.clone(),
+            cancellation: authorized.invocation_cancellation(),
+            deadline: deadline(),
+            action: update.action,
+            expected: authorized.envelope().original()["expected_revision"]
+                .as_u64()
+                .ok_or(DispatchError::Authority)?,
+        });
+        let controller = match self.adapter.media_controller(&proof.connection) {
+            Ok(controller) => controller,
+            Err(_) if update.action == ConnectionUpdateAction::CodecRenegotiate => self
+                .adapter
+                .configure_rtp_with_held(
+                    &proof.connection,
+                    authorized.principal().clone(),
+                    self.native.core.conversation.clone(),
+                    StagedRtpScope {
+                        session: self.native.core.session.clone(),
+                        connection: proof.connection.clone(),
+                        owner: authorized.principal().ownership_key(),
+                        wire_conversation: Some("conversation".into()),
+                        wire_session: "session".into(),
+                        wire_connection: authorized
+                            .envelope()
+                            .scope(Scope::Connection)
+                            .unwrap()
+                            .into(),
+                    },
+                    self.media.clone(),
+                    self.readiness.clone(),
+                    16,
+                    invocation.as_ref(),
+                )
+                .map_err(|_| DispatchError::Authority)?,
+            Err(_) => return Err(DispatchError::Authority),
+        };
+        let expected = authorized.envelope().original()["expected_revision"]
+            .as_u64()
+            .ok_or(DispatchError::Authority)?;
+        let result = match update.action {
+            ConnectionUpdateAction::CodecRenegotiate => {
+                controller
+                    .change_with_held(
+                        expected,
+                        &[desired(Medium::Audio)],
+                        &BTreeSet::new(),
+                        deadline(),
+                        CancellationToken::new(),
+                        invocation.clone(),
+                    )
+                    .await
+            }
+            ConnectionUpdateAction::Hold => {
+                controller
+                    .set_paused_with_held(
+                        &StreamId::from_string("audio"),
+                        expected,
+                        true,
+                        deadline(),
+                        invocation.clone(),
+                    )
+                    .await
+            }
+            ConnectionUpdateAction::Resume => {
+                controller
+                    .set_paused_with_held(
+                        &StreamId::from_string("audio"),
+                        expected,
+                        false,
+                        deadline(),
+                        invocation.clone(),
+                    )
+                    .await
+            }
+            _ => return Err(DispatchError::Unsupported),
+        };
+        result.map_err(|_| DispatchError::Authority)?;
+        if self.record.wrong_intent.load(Ordering::Acquire)
+            && update.action == ConnectionUpdateAction::CodecRenegotiate
+        {
+            let before = self.media.held.load(Ordering::Acquire);
+            let rejected = controller
+                .set_paused_with_held(
+                    &StreamId::from_string("audio"),
+                    controller.revision(),
+                    true,
+                    deadline(),
+                    invocation.clone(),
+                )
+                .await
+                .is_err();
+            if !rejected || self.media.held.load(Ordering::Acquire) != before {
+                return Err(DispatchError::Authority);
+            }
+            self.record
+                .wrong_intent_denied
+                .store(true, Ordering::Release);
+        }
+        if self.record.save.load(Ordering::Acquire) {
+            *self.record.saved.lock().unwrap() = Some((invocation, controller.clone()));
+        }
+        let original = authorized.envelope();
+        let mut reply = envelope(
+            "ack",
+            json!({"details":{"media_revision":controller.revision()}}),
+        );
+        for field in ["cid", "sid", "connid", "operation_id"] {
+            reply[field] = original.original()[field].clone();
+        }
+        reply["in_reply_to"] = json!(original.id());
+        Envelope::from_value(reply).map_err(DispatchError::from)
+    }
+}
+struct Harness {
+    f: Fixture,
+    native: Arc<Factory>,
+    media: Arc<HeldWirePolicy>,
+    readiness: Arc<Readiness>,
+    record: Arc<Record>,
+    wire: Wire,
+    id: ConnectionId,
+    kind: Transport,
+}
+impl Harness {
+    async fn new(kind: &str) -> Self {
+        let (mut f, native, base) = wire_setup().await;
+        let media = Arc::new(HeldWirePolicy {
+            base: Arc::new(MediaGrants(Arc::new(RwLock::new(PolicyState {
+                owners: HashMap::new(),
+                denied: BTreeSet::new(),
+                private: false,
+            })))),
+            fresh: AtomicUsize::new(0),
+            held: AtomicUsize::new(0),
+        });
+        Arc::get_mut(&mut f.config).unwrap().authority = Arc::new(Authority {
+            base,
+            media: media.clone(),
+        });
+        let readiness = Readiness::new();
+        let record = Arc::new(Record::default());
+        let profile = CanonicalProfile::new(f.config.clone(), Arc::new(Handler::default()), 8)
+            .unwrap()
+            .with_physical_handlers(Arc::new(ControlFactory {
+                native: native.clone(),
+                media: media.clone(),
+                readiness: readiness.clone(),
+                record: record.clone(),
+            }));
+        let mut wire = wire(kind, profile, "/uctp", Some("https://allowed.example"))
+            .await
+            .unwrap();
+        authenticate_wire(&mut wire, &f).await;
+        wire.send(f.sign(native_offer(0, kind))).await;
+        assert_eq!(wire.read().await.kind(), "ack");
+        let id = native.records.lock().unwrap()[0]
+            .connections
+            .lock()
+            .unwrap()[0]
+            .clone();
+        let transport = if kind == "quic" {
+            Transport::Quic
+        } else {
+            Transport::WebTransport
+        };
+        media
+            .base
+            .0
+            .write()
+            .await
+            .owners
+            .insert(id.clone(), media_owner(&native.core, &id, transport));
+        Self {
+            f,
+            native,
+            media,
+            readiness,
+            record,
+            wire,
+            id,
+            kind: transport,
+        }
+    }
+    fn command(&self, action: &str, revision: u64) -> Value {
+        let mut v = command();
+        v["connid"] = json!("native_0");
+        v["expected_revision"] = json!(revision);
+        v["operation_id"] = json!(format!("media_{}", uuid::Uuid::new_v4().simple()));
+        v["payload"] = json!({"action":action});
+        v
+    }
+    fn adapter(&self) -> &Arc<CanonicalNativeAdapter> {
+        &self.native.adapters[&self.kind]
+    }
+    async fn stop(&self) {
+        self.wire.server.shutdown().await.unwrap();
+        self.native
+            .core
+            .orch
+            .drain_connection_lifecycle_tasks()
+            .await;
+    }
+}
