+impl MediaControl {
+    pub fn new(
+        lease: Box<dyn MediaAuthorityLease>,
+        cancellation: CancellationToken,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<Self> {
+        let value = Self {
+            lease,
+            cancellation,
+            deadline: deadline.min(tokio::time::Instant::now() + Duration::from_secs(30)),
+        };
+        value.authority()?;
+        Ok(value)
+    }
+    fn authority(&self) -> ControlResult<&MediaOwner> {
+        if self.cancellation.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        Ok(self.lease.authority())
+    }
