+#[tokio::test]
+async fn canonical_saved_media_context_cannot_control_after_handler_returns_and_fresh_hold_works() {
+    for kind in ["quic", "wt"] {
+        let mut h = Harness::new(kind).await;
+        h.record.save.store(true, Ordering::Release);
+        h.wire
+            .send(h.f.sign(h.command("codec-renegotiate", 0)))
+            .await;
+        assert_eq!(h.wire.read().await.kind(), "ack");
+        let (saved, controller) = h.record.saved.lock().unwrap().take().unwrap();
+        assert!(saved.cancellation.is_cancelled());
+        let before = controller.stream_open_budget();
+        assert!(controller
+            .change_with_held(
+                controller.revision(),
+                &[desired(Medium::Audio)],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+                saved.clone()
+            )
+            .await
+            .is_err());
+        assert_eq!(controller.stream_open_budget(), before);
+        assert_eq!(controller.revision(), 1);
+        drop(saved);
+        h.record.save.store(false, Ordering::Release);
+        h.wire.send(h.f.sign(h.command("hold", 1))).await;
+        assert_eq!(h.wire.read().await.kind(), "ack");
+        h.wire.send(h.f.sign(h.command("resume", 2))).await;
+        assert_eq!(h.wire.read().await.kind(), "ack");
+        assert_eq!(controller.stream_open_budget(), before);
+        assert_eq!(controller.revision(), 3);
+        assert_eq!(h.media.fresh.load(Ordering::Acquire), 0);
+        let mut input = controller
+            .take_ingress(&StreamId::from_string("audio"))
+            .unwrap();
+        let binding = h.readiness.offers.lock().unwrap()[0].clone();
+        send(&h.wire, audio(binding.stream_local_id, 0));
+        let _ = packet(&mut input).await;
+        assert!(h.media.fresh.load(Ordering::Acquire) > 0);
+        h.stop().await;
+    }
+}
