+impl Destination {
+    fn same_realtime_receiver(&self, other: &Self) -> bool {
+        Weak::ptr_eq(&self.owner, &other.owner)
+            && self.logical == other.logical
+            && match (&self.realtime, &other.realtime) {
+                (Some(left), Some(right)) => {
+                    Weak::ptr_eq(&left.port, &right.port)
+                        && left.ticket.same_generation(&right.ticket)
+                }
+                _ => false,
+            }
+    }
+}
+impl Pending {
+    fn capture(
+        packet: MediaPacket,
+        controllers: &[Arc<StreamController>],
+        source: &Arc<StreamController>,
+        logical: &StreamId,
+    ) -> Self {
+        let remaining = controllers
+            .iter()
+            .flat_map(|target| {
+                target
+                    .direct_subscriptions
+                    .receivers(source, logical, packet.admitted_at)
+                    .into_iter()
+                    .filter_map(|logical| {
+                        let realtime = if packet.frame.kind == StreamKind::Data {
+                            None
+                        } else {
+                            let state = target.state.lock().unwrap_or_else(|p| p.into_inner());
+                            let port = state.active.get(&logical)?;
+                            Some(RealtimeDestination {
+                                port: Arc::downgrade(port),
+                                ticket: port.ticket(),
+                                deadline: tokio::time::Instant::from_std(packet.admitted_at)
+                                    + Duration::from_millis(200),
+                            })
+                        };
+                        Some(Destination {
+                            owner: Arc::downgrade(target),
+                            logical,
+                            realtime,
+                        })
+                    })
+            })
+            .collect();
+        Self { packet, remaining }
+    }
+    fn source_current(&self, controller: &StreamController, consumer: &Arc<SceneConsumer>) -> bool {
+        self.packet
+            .scene
+            .as_ref()
+            .is_some_and(|s| consumer.accepts(s))
+            && self.packet.ticket.is_current()
+            && self
+                .packet
+                .scene
+                .as_ref()
+                .is_none_or(|s| !s.cancel.is_cancelled())
+            && !controller.shutdown.is_cancelled()
+    }
+    fn forward(
+        &mut self,
+        source: &Arc<StreamController>,
+        logical: &StreamId,
+        blocked: &mut Vec<Destination>,
+    ) {
+        let data = self.packet.frame.kind == StreamKind::Data;
+        self.remaining.retain_mut(|destination| {
+            let Some(target) = destination.owner.upgrade() else {
+                return false;
+            };
+            let admitted_to_scene = target
+                .scene_consumer
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .and_then(Weak::upgrade)
+                .is_some_and(|c| {
+                    c.receives_at(self.packet.scene.as_ref(), self.packet.admitted_at)
+                });
+            if !admitted_to_scene
+                || target.shutdown.is_cancelled()
+                || !target.direct_subscriptions.selected_at(
+                    source,
+                    logical,
+                    &destination.logical,
+                    self.packet.admitted_at,
+                )
+            {
+                return false;
+            }
+            if StreamController::principal_expiry(&source.credential_snapshot().principal)
+                .is_some_and(|e| e <= chrono::Utc::now())
+                || StreamController::principal_expiry(&target.credential_snapshot().principal)
+                    .is_some_and(|e| e <= chrono::Utc::now())
+            {
+                return false;
+            }
+            if !data {
+                let Some(original) = destination.realtime.as_ref() else {
+                    return false;
+                };
+                if !original.ticket.is_current()
+                    || tokio::time::Instant::now() >= original.deadline
+                    || self.packet.admitted_at.elapsed() >= Duration::from_millis(200)
+                {
+                    return false;
+                }
+                // FIFO belongs to this exact receiver incarnation. A blocked
+                // candidate never suppresses a different healthy recipient.
+                if blocked
+                    .iter()
+                    .any(|old| old.same_realtime_receiver(destination))
+                {
+                    return true;
+                }
+            }
+            let result = if data {
+                self.packet.try_forward_to(&target, &destination.logical)
+            } else {
+                let Some(original) = destination.realtime.as_mut() else {
+                    return false;
+                };
+                let Some(port) = original.port.upgrade() else {
+                    return false;
+                };
+                self.packet.try_forward_to_pending(
+                    &target,
+                    &destination.logical,
+                    &port,
+                    &original.ticket,
+                    &mut original.deadline,
+                )
+            };
+            match result {
+                Ok(()) | Err(StreamControlError::NotRecipient) => false,
+                Err(StreamControlError::NotReady) if !data => {
+                    let retained = destination.realtime.as_ref().is_some_and(|original| {
+                        original.ticket.is_current()
+                            && tokio::time::Instant::now() < original.deadline
+                            && self.packet.admitted_at.elapsed() < Duration::from_millis(200)
+                    });
+                    if retained {
+                        blocked.push(destination.clone());
+                    }
+                    retained
+                }
+                Err(_) => data,
+            }
+        });
+    }
+}
