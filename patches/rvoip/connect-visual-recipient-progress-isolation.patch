+// Actual scene fanout, with a separately current old recipient and transient
+// candidate reads. These are engine/scheduler controls, not codec qualification.
+struct RecipientPolicy {
+    inner: Arc<Policy>,
+    blocked: Arc<std::sync::atomic::AtomicBool>,
+    source_expiry: Arc<Mutex<Option<chrono::DateTime<chrono::Utc>>>>,
+}
+impl MediaPolicy for RecipientPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if scope.connection.as_str().starts_with("candidate-")
+            && matches!(scope.purpose, MediaPurpose::Receive { .. })
+            && self.blocked.load(Ordering::Acquire)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let lease = self.inner.current(scope)?;
+        if matches!(scope.purpose, MediaPurpose::Publish) {
+            if let Some(until) = *self.source_expiry.lock().unwrap() {
+                return Ok(Box::new(ExpiringLease {
+                    inner: lease,
+                    until,
+                }));
+            }
+        }
+        Ok(lease)
+    }
+}
+struct RecipientScene {
+    f: Fixture,
+    scene: Arc<GuardedMediaScene>,
+    candidates: Vec<(Arc<StreamController>, Arc<Adapter>)>,
+    blocked: Arc<std::sync::atomic::AtomicBool>,
+    source_expiry: Arc<Mutex<Option<chrono::DateTime<chrono::Utc>>>>,
+}
+impl RecipientScene {
+    async fn new(kinds: &[Medium], count: usize) -> Self {
+        assert!((1..=2).contains(&count));
+        let blocked = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let source_expiry = Arc::new(Mutex::new(None));
+        let f = Fixture::with_policy(
+            16,
+            Some(Box::new({
+                let blocked = blocked.clone();
+                let source_expiry = source_expiry.clone();
+                move |inner| {
+                    Arc::new(RecipientPolicy {
+                        inner,
+                        blocked,
+                        source_expiry,
+                    })
+                }
+            })),
+        );
+        f.start_unsubscribed(kinds).await;
+        let mut candidates = Vec::new();
+        for index in 0..count {
+            let name = format!("candidate-{index}");
+            f.policy
+                .0
+                .write()
+                .await
+                .owners
+                .insert(name.clone(), owner(&name));
+            let adapter = Adapter::new();
+            let controller = StreamController::new(
+                ConversationId::from_string("conversation"),
+                SessionId::from_string("session"),
+                ConnectionId::from_string(name.clone()),
+                principal(&name),
+                f.a.policy.clone(),
+                adapter.clone(),
+                f.a.handles.clone(),
+                16,
+            )
+            .unwrap();
+            controller
+                .change(
+                    controller.revision(),
+                    &kinds.iter().map(|k| desired(*k)).collect::<Vec<_>>(),
+                    &BTreeSet::new(),
+                    deadline(),
+                    CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+            candidates.push((controller, adapter));
+        }
+        let scene = GuardedMediaScene::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            f.a.policy.clone(),
+            8000,
+        );
+        for controller in [&f.a, &f.b]
+            .into_iter()
+            .chain(candidates.iter().map(|(c, _)| c))
+        {
+            let mut member = scene.prepare(controller.clone()).unwrap();
+            member
+                .quiesce(deadline(), CancellationToken::new())
+                .await
+                .unwrap();
+            assert!(member.ready());
+            scene.insert(controller.connection.clone(), member, true);
+        }
+        for controller in std::iter::once(&f.b).chain(candidates.iter().map(|(c, _)| c)) {
+            scene
+                .change_direct_subscriptions(
+                    &controller.connection,
+                    controller.revision(),
+                    DirectSubscriptionChange::Subscribe(
+                        kinds
+                            .iter()
+                            .map(|medium| {
+                                DirectSubscription::new(
+                                    &f.a,
+                                    desired(*medium).logical_id.clone(),
+                                    desired(*medium).logical_id,
+                                )
+                            })
+                            .collect(),
+                    ),
+                    deadline(),
+                    CancellationToken::new(),
+                    None,
+                )
+                .await
+                .unwrap();
+        }
+        Self {
+            f,
+            scene,
+            candidates,
+            blocked,
+            source_expiry,
+        }
+    }
+    fn publish(&self, medium: Medium, sequence: u32) {
+        let source = self.f.aa.port(medium);
+        source.try_publish(&frame(&source, sequence)).unwrap();
+    }
+    fn retained(&self) -> (usize, usize, u64, u64) {
+        self.scene
+            .retained_visual_for_test(&self.f.a.connection, &desired(Medium::Video).logical_id)
+    }
+}
+async fn expect_timestamp(output: &mut mpsc::Receiver<QueuedMedia>, expected: u32) {
+    output
+        .try_recv()
+        .expect("actual current recipient output")
+        .deliver(|frame| async move {
+            assert_eq!(frame.timestamp_rtp, expected);
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
+#[tokio::test]
+async fn scene_visual_old_recipient_progresses_before_private_retry_expiry_without_duplicate_or_reordering()
+ {
+    let f = RecipientScene::new(&[Medium::Video], 2).await;
+    let mut old = f.f.ba.port(Medium::Video).take_egress().unwrap();
+    let mut candidates = f
+        .candidates
+        .iter()
+        .map(|(_, a)| a.port(Medium::Video).take_egress().unwrap())
+        .collect::<Vec<_>>();
+    f.blocked.store(true, Ordering::Release);
+    let began = Instant::now();
+    for sequence in 0..3 {
+        f.publish(Medium::Video, sequence);
+        f.scene.tick();
+        expect_timestamp(&mut old, sequence).await;
+        for output in &mut candidates {
+            assert!(output.try_recv().is_err());
+        }
+    }
+    assert!(
+        began.elapsed() < Duration::from_millis(200),
+        "healthy progress waited for private expiry"
+    );
+    assert_eq!(f.retained().0, 3);
+    assert_eq!(f.retained().1, 6);
+    assert!(
+        f.f.policy.0.try_write().is_ok(),
+        "retained work pinned authority"
+    );
+    f.blocked.store(false, Ordering::Release);
+    f.scene.tick();
+    for output in &mut candidates {
+        for sequence in 0..3 {
+            expect_timestamp(output, sequence).await;
+        }
+        assert!(output.try_recv().is_err());
+    }
+    f.scene.tick();
+    assert!(old.try_recv().is_err());
+    assert_eq!(f.retained().0, 0);
+}
+#[tokio::test]
+async fn scene_visual_recipient_isolation_preserves_original_age_and_earliest_authority_expiry() {
+    for expiry_limited in [false, true] {
+        let f = RecipientScene::new(&[Medium::Video], 1).await;
+        let mut old = f.f.ba.port(Medium::Video).take_egress().unwrap();
+        let mut candidate = f.candidates[0].1.port(Medium::Video).take_egress().unwrap();
+        f.publish(Medium::Video, 10);
+        if expiry_limited {
+            *f.source_expiry.lock().unwrap() =
+                Some(chrono::Utc::now() + chrono::Duration::milliseconds(40));
+        }
+        f.blocked.store(true, Ordering::Release);
+        f.scene.tick();
+        expect_timestamp(&mut old, 10).await;
+        *f.source_expiry.lock().unwrap() = None;
+        tokio::time::sleep(Duration::from_millis(if expiry_limited { 60 } else { 210 })).await;
+        f.blocked.store(false, Ordering::Release);
+        f.scene.tick();
+        assert!(
+            candidate.try_recv().is_err(),
+            "old private work renewed its bound"
+        );
+        f.publish(Medium::Video, 20);
+        f.scene.tick();
+        expect_timestamp(&mut old, 20).await;
+        expect_timestamp(&mut candidate, 20).await;
+    }
+}
+#[tokio::test]
+async fn scene_visual_recipient_isolation_refuses_revocation_and_receiver_scene_port_or_selection_epochs()
+ {
+    for changed in 0..5 {
+        let f = RecipientScene::new(&[Medium::Video], 1).await;
+        let controller = &f.candidates[0].0;
+        let adapter = &f.candidates[0].1;
+        let mut old = f.f.ba.port(Medium::Video).take_egress().unwrap();
+        let mut candidate = adapter.port(Medium::Video).take_egress().unwrap();
+        f.blocked.store(true, Ordering::Release);
+        f.publish(Medium::Video, 30);
+        f.scene.tick();
+        expect_timestamp(&mut old, 30).await;
+        f.blocked.store(false, Ordering::Release);
+        match changed {
+            0 => {
+                f.f.policy
+                    .0
+                    .write()
+                    .await
+                    .revoked
+                    .insert(controller.connection.to_string());
+            }
+            1 => {
+                f.scene
+                    .change_direct_subscriptions(
+                        &controller.connection,
+                        controller.revision(),
+                        DirectSubscriptionChange::Clear,
+                        deadline(),
+                        CancellationToken::new(),
+                        None,
+                    )
+                    .await
+                    .unwrap();
+                f.scene
+                    .change_direct_subscriptions(
+                        &controller.connection,
+                        controller.revision(),
+                        DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                            &f.f.a,
+                            desired(Medium::Video).logical_id.clone(),
+                            desired(Medium::Video).logical_id,
+                        )]),
+                        deadline(),
+                        CancellationToken::new(),
+                        None,
+                    )
+                    .await
+                    .unwrap();
+            }
+            2 => {
+                controller
+                    .change(
+                        controller.revision(),
+                        &[desired(Medium::Video)],
+                        &[desired(Medium::Video).logical_id].into_iter().collect(),
+                        deadline(),
+                        CancellationToken::new(),
+                    )
+                    .await
+                    .unwrap();
+            }
+            3 => controller
+                .scene_consumer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .unwrap()
+                .upgrade()
+                .unwrap()
+                .activate(),
+            4 => {
+                f.f.policy.0.write().await.revoked.insert("alice".into());
+            }
+            _ => unreachable!(),
+        }
+        let mut replacement = if changed == 2 {
+            Some(adapter.port(Medium::Video).take_egress().unwrap())
+        } else {
+            None
+        };
+        f.scene.tick();
+        assert!(candidate.try_recv().is_err());
+        if let Some(output) = &mut replacement {
+            assert!(output.try_recv().is_err());
+        }
+        if changed == 4 {
+            let source = f.f.aa.port(Medium::Video);
+            assert!(source.try_publish(&frame(&source, 40)).is_err());
+            continue;
+        }
+        f.publish(Medium::Video, 40);
+        f.scene.tick();
+        expect_timestamp(&mut old, 40).await;
+        if changed != 0 {
+            expect_timestamp(replacement.as_mut().unwrap_or(&mut candidate), 40).await;
+        }
+        assert!(f.f.policy.0.try_write().is_ok());
+    }
+}
+#[tokio::test]
+async fn scene_visual_retained_capacity_is_shared_by_all_recipients_and_evicts_only_remaining_work()
+{
+    let f = RecipientScene::new(&[Medium::Video], 2).await;
+    let mut old = f.f.ba.port(Medium::Video).take_egress().unwrap();
+    let mut candidates = f
+        .candidates
+        .iter()
+        .map(|(_, a)| a.port(Medium::Video).take_egress().unwrap())
+        .collect::<Vec<_>>();
+    f.blocked.store(true, Ordering::Release);
+    for batch in 0..3 {
+        for offset in 0..32 {
+            f.publish(Medium::Video, batch * 32 + offset);
+        }
+        f.scene.tick();
+        for offset in 0..32 {
+            expect_timestamp(&mut old, batch * 32 + offset).await;
+        }
+        let retained = f.retained();
+        assert!(retained.0 <= 64);
+        assert_eq!(retained.1, retained.0 * 2);
+        for output in &mut candidates {
+            assert!(output.try_recv().is_err());
+        }
+    }
+    assert_eq!(f.retained(), (64, 128, 32, 64));
+    f.blocked.store(false, Ordering::Release);
+    f.scene.tick();
+    for output in &mut candidates {
+        for sequence in 32..96 {
+            expect_timestamp(output, sequence).await;
+        }
+        assert!(output.try_recv().is_err());
+    }
+    assert!(
+        old.try_recv().is_err(),
+        "capacity recovery duplicated an old healthy write"
+    );
+    assert_eq!(f.retained().0, 0);
+}
+#[tokio::test]
+async fn scene_recipient_isolation_keeps_reliable_data_ordering_and_independent_visual_progress() {
+    let f = RecipientScene::new(&[Medium::Data, Medium::Video], 1).await;
+    let mut old_data = f.f.ba.port(Medium::Data).take_egress().unwrap();
+    let mut candidate_data = f.candidates[0].1.port(Medium::Data).take_egress().unwrap();
+    let mut old_video = f.f.ba.port(Medium::Video).take_egress().unwrap();
+    f.blocked.store(true, Ordering::Release);
+    for sequence in 0..3 {
+        f.publish(Medium::Data, sequence);
+        f.publish(Medium::Video, 100 + sequence);
+        f.scene.tick();
+        expect_timestamp(&mut old_video, 100 + sequence).await;
+        if sequence == 0 {
+            expect_timestamp(&mut old_data, 0).await;
+        } else {
+            assert!(old_data.try_recv().is_err());
+        }
+        assert!(candidate_data.try_recv().is_err());
+    }
+    f.blocked.store(false, Ordering::Release);
+    f.scene.tick();
+    for sequence in 0..3 {
+        expect_timestamp(&mut candidate_data, sequence).await;
+    }
+    for sequence in 1..3 {
+        expect_timestamp(&mut old_data, sequence).await;
+    }
+    assert!(old_data.try_recv().is_err());
+    assert!(candidate_data.try_recv().is_err());
+}
