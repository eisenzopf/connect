+#[tokio::test]
+async fn scene_visual_full_retained_queue_attempts_originals_before_fresh_ingress_can_evict() {
+    let f = RecipientScene::new(&[Medium::Video], 1).await;
+    let mut old = f.f.ba.port(Medium::Video).take_egress().unwrap();
+    let mut candidate = f.candidates[0].1.port(Medium::Video).take_egress().unwrap();
+    f.blocked.store(true, Ordering::Release);
+    for batch in 0..2 {
+        for offset in 0..32 {
+            f.publish(Medium::Video, batch * 32 + offset);
+        }
+        f.scene.tick();
+        for offset in 0..32 {
+            expect_timestamp(&mut old, batch * 32 + offset).await;
+        }
+    }
+    assert_eq!(f.retained(), (64, 64, 0, 0));
+    assert!(candidate.try_recv().is_err());
+    f.publish(Medium::Video, 64);
+    // The private receiver becomes current before this original normal tick.
+    // New ingress must not evict its older eligible first fragment at capacity.
+    f.blocked.store(false, Ordering::Release);
+    f.scene.tick();
+    for sequence in 0..64 {
+        expect_timestamp(&mut candidate, sequence).await;
+    }
+    expect_timestamp(&mut old, 64).await;
+    assert_eq!(
+        f.retained().2,
+        0,
+        "fresh ingress evicted an eligible original before its attempt"
+    );
+    assert!(old.try_recv().is_err(), "recovery repeated a healthy write");
+}
