+#[test]
+fn persisted_membership_preserves_large_epochs_and_current_activity() {
+    let load = |epoch, revision, active| {
+        Membership::from_current(
+            binding("tenant_one", "id_alice"),
+            ConversationId::from_string("conv_one"),
+            ParticipantId::from_string("part_local"),
+            ParticipantKind::Human,
+            ParticipantRole::Agent,
+            epoch,
+            revision,
+            active,
+        )
+    };
+    let member = load(MAX_REVISION - 1, MAX_REVISION - 1, true).unwrap();
+    assert_eq!(member.epoch(), MAX_REVISION - 1);
+    assert_eq!(member.revision(), MAX_REVISION - 1);
+    member
+        .revalidate_principal(&principal("tenant_one", "id_alice"), now())
+        .unwrap();
+    assert!(member
+        .revalidate_principal(&principal("tenant_one", "id_other"), now())
+        .is_err());
+    let presence = SessionAppearance::admit(&member, SessionId::new(), None).unwrap();
+    assert_eq!(presence.membership_epoch(), MAX_REVISION - 1);
+    let inactive = load(MAX_REVISION - 1, MAX_REVISION, false).unwrap();
+    assert!(!inactive.is_active());
+    assert!(SessionAppearance::admit(&inactive, SessionId::new(), None).is_err());
+    assert!(inactive
+        .revalidate_principal(&principal("tenant_one", "id_alice"), now())
+        .is_err());
+    let mut boundary = load(MAX_REVISION, MAX_REVISION, true).unwrap();
+    assert_eq!(
+        boundary.remove(MAX_REVISION),
+        Err(RelationshipError::Conflict)
+    );
+    assert_eq!(load(1, 0, true).unwrap().revision(), 0);
+    assert_eq!(load(MAX_REVISION, 0, true).unwrap().epoch(), MAX_REVISION);
+    for (epoch, revision) in [
+        (0, 1),
+        (MAX_REVISION + 1, MAX_REVISION + 1),
+        (1, MAX_REVISION + 1),
+    ] {
+        assert!(matches!(
+            load(epoch, revision, true),
+            Err(RelationshipError::InvalidValue)
+        ));
+    }
+}
