+#[test]
+fn restored_readmission_cannot_reuse_prior_presence_or_connection() {
+    let previous = membership("tenant_one", "id_alice", "conv_one");
+    let mut presence = SessionAppearance::admit(&previous, SessionId::new(), None).unwrap();
+    let endpoint = endpoint(&previous.binding, "ep_one");
+    let mut connection =
+        ConnectionBinding::prepare(&previous, &presence, &endpoint, ConnectionId::new()).unwrap();
+    let current = Membership::from_current(
+        binding("tenant_one", "id_alice"),
+        ConversationId::from_string("conv_one"),
+        ParticipantId::from_string("part_local"),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+        2,
+        3,
+        true,
+    )
+    .unwrap();
+    assert_eq!(
+        presence.require_current(&current),
+        Err(RelationshipError::OwnerMismatch)
+    );
+    assert!(presence.leave(&current, 1).is_err());
+    assert!(connection
+        .observe_ready(&current, &presence, &endpoint, 1)
+        .is_err());
+    let fresh = SessionAppearance::admit(&current, SessionId::new(), None).unwrap();
+    assert_eq!(fresh.membership_epoch(), 2);
+}
