+fn error_category(error: DispatchError) -> &'static str {
+    match error {
+        DispatchError::AuthorityUnavailable => "authorization",
+        DispatchError::StorageUnavailable => "storage",
+        DispatchError::Capacity => "capacity",
+        _ => "auth",
+    }
+}
 fn error_reason(error: DispatchError) -> &'static str {
     match error {
+        DispatchError::Authority => "forbidden",
+        DispatchError::AuthorityUnavailable => "authority_unavailable",
+        DispatchError::StorageUnavailable => "storage_unavailable",
+        DispatchError::Capacity => "capacity_exceeded",
         DispatchError::ScopeDenied => "insufficient_scope",
         DispatchError::SubmissionUnknown => "submission_unknown",
         DispatchError::Replay => "replay_detected",
