+#[cfg(test)]
+mod policy_refusal_tests {
+    use super::*;
+    #[test]
+    fn installed_policy_refusals_distinguish_permission_capacity_storage_and_retryable_authority() {
+        for (error, code, category, reason) in [
+            (
+                DispatchError::Authentication,
+                401,
+                "auth",
+                "authentication_failed",
+            ),
+            (DispatchError::Authority, 403, "auth", "forbidden"),
+            (
+                DispatchError::AuthorityUnavailable,
+                503,
+                "authorization",
+                "authority_unavailable",
+            ),
+            (
+                DispatchError::StorageUnavailable,
+                503,
+                "storage",
+                "storage_unavailable",
+            ),
+            (
+                DispatchError::Capacity,
+                429,
+                "capacity",
+                "capacity_exceeded",
+            ),
+        ] {
+            assert_eq!(error_code(error), code);
+            assert_eq!(error_category(error), category);
+            assert_eq!(error_reason(error), reason);
+        }
+    }
+}
