+    f.room.domain.base.0.write().await.private = false;
+    assert_eq!(
+        [
+            old.revision(),
+            new.revision(),
+            bob.revision(),
+            public.revision()
+        ],
+        revisions
+    );
+    assert!(new_port.try_publish(&frame(&new_port, 1)).is_err());
+    // The plan pins old gate facts; a later mute invalidates the whole move.
+    let stale = f.plan_with_video(Some(request())).unwrap();
+    old.set_media_gate(
+        old.revision(),
+        &BTreeSet::from([video_id.clone()]),
+        StreamGateAction::Mute,
+        deadline(),
+    )
+    .await
+    .unwrap();
+    assert!(f.commit(stale).await.is_err());
+    assert_eq!(new.revision(), revisions[1]);
+    old.set_media_gate(
+        old.revision(),
+        &BTreeSet::from([video_id.clone()]),
+        StreamGateAction::Unmute,
+        deadline(),
+    )
+    .await
+    .unwrap();
+    // A real queued old-camera frame must lose its route at the atomic cutover.
+    old_port.try_publish(&frame(&old_port, 20)).unwrap();
+    let queued = receive(&mut old_input).await;
+    queued.try_forward_to(&bob, &video_id).unwrap();
+    let queued_egress = outgoing(&mut bob_output).await;
+    let plan = f.plan_with_video(Some(request())).unwrap();
+    let (_, handle) = f.commit(plan).await.unwrap();
+    assert!(old.shutdown.is_cancelled());
+    assert!(queued.try_forward_to(&bob, &video_id).is_err());
+    assert!(queued_egress
+        .deliver(|_| async {
+            panic!("old route reached sink after cutover");
+        })
+        .await
+        .is_err());
+    assert_eq!(new.revision(), revisions[1] + 1);
+    assert_eq!(bob.revision(), revisions[2] + 1);
+    assert_eq!(public.revision(), revisions[3] + 1);
+    assert_eq!(
+        [bindings(&new), bindings(&bob), bindings(&public)],
+        before_bindings
+    );
+    assert!(
+        incoming_port
+            .try_publish(&frame(&incoming_port, 21))
+            .is_err(),
+        "receiver-only transfer opened another camera"
+    );
+    let data = f.room.nodes["device"].adapter.port(Medium::Data);
+    assert!(data.try_publish(&frame(&data, 21)).is_err());
+    // Both selected directions work without a post-completion subscribe/unmute.
+    new_port.try_publish(&frame(&new_port, 30)).unwrap();
+    let packet = receive(&mut new_input).await;
+    packet.try_forward_to(&bob, &video_id).unwrap();
+    packet.try_forward_to(&public, &video_id).unwrap();
+    for output in [&mut bob_output, &mut public_output] {
+        outgoing(output)
+            .await
+            .deliver(|v| async move {
+                assert_eq!(v.timestamp_rtp, 30);
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+    bob_port.try_publish(&frame(&bob_port, 40)).unwrap();
+    let packet = receive(&mut bob_input).await;
+    packet.try_forward_to(&new, &incoming.logical_id).unwrap();
+    assert!(packet.try_forward_to(&new, &video_id).is_err());
+    outgoing(&mut incoming_output)
+        .await
+        .deliver(|v| async move {
+            assert_eq!(v.timestamp_rtp, 40);
+            Ok(())
+        })
+        .await
+        .unwrap();
+    f.room.publish("device", 5200).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 5200).await;
+    f.room.heard("public", 5200).await;
+    assert_eq!(
+        handle.finish_local_media_cleanup(deadline()).await,
+        ReplacementCleanupOutcome::LocalMediaClosed
+    );
+}
