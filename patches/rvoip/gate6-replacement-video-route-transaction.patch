+use super::*;
+use crate::staged_streams::direct_subscriptions::{DirectSubscription, DirectSubscriptionChange};
+
+fn bindings(
+    controller: &StreamController,
+) -> Vec<(NegotiatedStream, StreamId, u16, u64, u64, bool, bool)> {
+    controller
+        .active_bindings()
+        .into_iter()
+        .map(|b| {
+            (
+                b.negotiated,
+                b.transport_id,
+                b.stream_local_id,
+                b.generation,
+                b.connection_generation,
+                b.source_ready,
+                b.sink_ready,
+            )
+        })
+        .collect()
+}
+
+fn request() -> ReplacementVideoRequest {
+    ReplacementVideoRequest {
+        publications: vec![ReplacementVideoStream {
+            previous: desired(Medium::Video).logical_id,
+            replacement: desired(Medium::Video).logical_id,
+        }],
+        receivers: vec![ReplacementVideoStream {
+            previous: desired(Medium::Video).logical_id,
+            replacement: StreamId::from_string("incoming-video"),
+        }],
+    }
+}
+
+#[tokio::test]
+async fn replacement_video_routes_and_audio_commit_together_with_current_authority_and_stale_packet_fences(
+) {
+    let mut incoming = desired(Medium::Video);
+    incoming.logical_id = StreamId::from_string("incoming-video");
+    let mut f = Move::with_media(
+        false,
+        "alice",
+        false,
+        vec![
+            desired(Medium::Audio),
+            desired(Medium::Video),
+            incoming.clone(),
+            desired(Medium::Data),
+        ],
+    )
+    .await;
+    let video_id = desired(Medium::Video).logical_id;
+    for name in ["alice", "bob", "public"] {
+        let c = &f.room.nodes[name].controller;
+        c.change(
+            c.revision(),
+            &[desired(Medium::Video)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+    }
+    let old = f.room.nodes["alice"].controller.clone();
+    let new = f.room.nodes["device"].controller.clone();
+    let bob = f.room.nodes["bob"].controller.clone();
+    let public = f.room.nodes["public"].controller.clone();
+    for (receiver, publisher) in [(&old, &bob), (&bob, &old), (&public, &old)] {
+        receiver
+            .change_direct_subscriptions(
+                receiver.revision(),
+                DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                    publisher,
+                    video_id.clone(),
+                    video_id.clone(),
+                )]),
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+            .unwrap();
+    }
+    let old_port = f.room.nodes["alice"].adapter.port(Medium::Video);
+    let new_port = f.room.nodes["device"].adapter.port(Medium::Video);
+    let bob_port = f.room.nodes["bob"].adapter.port(Medium::Video);
+    let incoming_port =
+        f.room.nodes["device"].adapter.ports.lock().unwrap()[&incoming.logical_id].clone();
+    let mut old_input = old.take_ingress(&video_id).unwrap();
+    let mut new_input = new.take_ingress(&video_id).unwrap();
+    let mut bob_input = bob.take_ingress(&video_id).unwrap();
+    let mut bob_output = bob_port.take_egress().unwrap();
+    let mut public_output = f.room.nodes["public"]
+        .adapter
+        .port(Medium::Video)
+        .take_egress()
+        .unwrap();
+    let mut incoming_output = incoming_port.take_egress().unwrap();
+    f.io().await;
+    f.confirm().await;
+    let revisions = [
+        old.revision(),
+        new.revision(),
+        bob.revision(),
+        public.revision(),
+    ];
+    let before_bindings = [bindings(&new), bindings(&bob), bindings(&public)];
+    let mut invalid = request();
+    invalid.receivers[0].replacement = desired(Medium::Data).logical_id;
+    assert!(f.plan_with_video(Some(invalid)).is_err());
+    let mut omitted = request();
+    omitted.publications.clear();
+    assert!(f
+        .commit(f.plan_with_video(Some(omitted)).unwrap())
+        .await
+        .is_err());
+    f.room.domain.base.0.write().await.private = true;
+    assert!(f
+        .commit(f.plan_with_video(Some(request())).unwrap())
+        .await
