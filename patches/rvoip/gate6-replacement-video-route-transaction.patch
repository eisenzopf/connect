@@ -0,0 +1,220 @@
+//! Explicit replacement video intent. Snapshots contain no permission lease.
+use super::*;
+use crate::staged_streams::direct_subscriptions::{DirectSubscription, DirectSubscriptionChange};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReplacementVideoStream {
+    pub previous: StreamId,
+    pub replacement: StreamId,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReplacementVideoRequest {
+    /// Old endpoint publications and their exact new negotiated logical IDs.
+    pub publications: Vec<ReplacementVideoStream>,
+    /// Old receiver ports and their exact new negotiated receiver logical IDs.
+    /// This transfers only existing selections, never selects a new publisher.
+    pub receivers: Vec<ReplacementVideoStream>,
+}
+
+pub(crate) struct VideoPlan {
+    old: Weak<StreamController>,
+    new: Weak<StreamController>,
+    old_revision: u64,
+    new_revision: u64,
+    publications: BTreeMap<StreamId, StreamId>,
+    old_video_ids: BTreeSet<StreamId>,
+    incoming: Vec<DirectSubscription>,
+    gates: Vec<(StreamId, LogicalStream)>,
+}
+
+impl VideoPlan {
+    pub(super) fn prepare(
+        old: &Arc<StreamController>,
+        new: &Arc<StreamController>,
+        request: &ReplacementVideoRequest,
+    ) -> ControlResult<Self> {
+        let count = request.publications.len() + request.receivers.len();
+        if count == 0 || count > 32 {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        let mut target_ids = BTreeSet::new();
+        for group in [&request.publications, &request.receivers] {
+            let mut previous = BTreeSet::new();
+            for mapping in group {
+                if mapping.previous.as_str().is_empty()
+                    || mapping.replacement.as_str().is_empty()
+                    || !previous.insert(mapping.previous.clone())
+                    || !target_ids.insert(mapping.replacement.clone())
+                {
+                    return Err(MediaTransitionError::Invalid.into());
+                }
+            }
+        }
+        // Both are try-locks: a caller never waits while owning the other state.
+        let old_state = old
+            .state
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let new_state = new
+            .state
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        if old_state.closed
+            || new_state.closed
+            || old.shutdown.is_cancelled()
+            || new.shutdown.is_cancelled()
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        let previous_routes = old.direct_subscriptions.saved_selections();
+        // Private preparation must not smuggle in an ordinary receive program.
+        if !new.direct_subscriptions.saved_selections().is_empty() {
+            return Err(StreamControlError::Authority);
+        }
+        let mut gates = Vec::new();
+        let mut publications = BTreeMap::new();
+        let mut incoming = Vec::new();
+        for (publish, group) in [(true, &request.publications), (false, &request.receivers)] {
+            for mapping in group {
+                let source = Self::video_stream(&old_state, &mapping.previous)?;
+                let target = Self::video_stream(&new_state, &mapping.replacement)?;
+                let source_direction = source.negotiated.requested.direction;
+                let target_direction = target.negotiated.requested.direction;
+                if if publish {
+                    !source_direction.receives() || !target_direction.receives()
+                } else {
+                    !source_direction.sends() || !target_direction.sends()
+                } {
+                    return Err(StreamControlError::Unsupported);
+                }
+                if target_direction.receives() && !target.source_muted {
+                    return Err(StreamControlError::Authority);
+                }
+                let mut gate = source.clone();
+                if publish {
+                    publications.insert(mapping.previous.clone(), mapping.replacement.clone());
+                } else {
+                    let selected = previous_routes
+                        .iter()
+                        .find(|route| route.receiver == mapping.previous)
+                        .ok_or(StreamControlError::NotReady)?;
+                    let publisher = selected.publisher().ok_or(StreamControlError::NotReady)?;
+                    incoming.push(DirectSubscription::new(
+                        &publisher,
+                        selected.source.logical.clone(),
+                        mapping.replacement.clone(),
+                    ));
+                    // A receiver transfer never opens an extra endpoint input,
+                    // even if the negotiated target happens to be duplex.
+                    gate.source_muted = true;
+                }
+                gates.push((mapping.replacement.clone(), gate));
+            }
+        }
+        Ok(Self {
+            old: Arc::downgrade(old),
+            new: Arc::downgrade(new),
+            old_revision: old_state.model.revision(),
+            new_revision: new_state.model.revision(),
+            publications,
+            incoming,
+            gates,
+            old_video_ids: old_state
+                .model
+                .streams()
+                .iter()
+                .filter(|(_, s)| s.negotiated.requested.medium == Medium::Video)
+                .map(|(id, _)| id.clone())
+                .collect(),
+        })
+    }
+
+    fn video_stream<'a>(state: &'a State, id: &StreamId) -> ControlResult<&'a LogicalStream> {
+        let stream = state
+            .model
+            .streams()
+            .get(id)
+            .filter(|s| {
+                s.state != LogicalStreamState::Ended
+                    && s.negotiated.requested.medium == Medium::Video
+            })
+            .ok_or(StreamControlError::NotReady)?;
+        let port = state.active.get(id).ok_or(StreamControlError::NotReady)?;
+        if port.binding.negotiated != stream.negotiated
+            || port.binding.transport_id != stream.transport_id
+            || port.binding.stream_local_id != stream.stream_local_id
+            || port.binding.generation != stream.generation
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        Ok(stream)
+    }
+
+    pub(crate) fn validate(
+        &self,
+        controller: &StreamController,
+        state: &State,
+    ) -> ControlResult<()> {
+        for (owner, revision) in [
+            (&self.old, self.old_revision),
+            (&self.new, self.new_revision),
+        ] {
+            let owner = owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+            if std::ptr::eq(owner.as_ref(), controller) && state.model.revision() != revision {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn gates(&self) -> &[(StreamId, LogicalStream)] {
+        &self.gates
+    }
+
+    pub(crate) fn direct_change(
+        &self,
+        controller: &Arc<StreamController>,
+    ) -> ControlResult<Option<DirectSubscriptionChange>> {
+        let old = self.old.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let new = self.new.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if Arc::ptr_eq(controller, &old) {
+            return Ok(None); // The old lifetime is retired by the compound commit.
+        }
+        let mut changes = BTreeMap::new();
+        if Arc::ptr_eq(controller, &new) {
+            for route in &self.incoming {
+                changes.insert(route.receiver.clone(), route.clone());
+            }
+        }
+        for route in controller
+            .direct_subscriptions
+            .saved_selections()
+            .into_iter()
+            .chain(changes.values().cloned().collect::<Vec<_>>())
+        {
+            if route
+                .publisher()
+                .is_some_and(|publisher| Arc::ptr_eq(&publisher, &old))
+            {
+                if let Some(logical) = self.publications.get(&route.source.logical) {
+                    changes.insert(
+                        route.receiver.clone(),
+                        DirectSubscription::new(&new, logical.clone(), route.receiver),
+                    );
+                } else if self.old_video_ids.contains(&route.source.logical) {
+                    // Explicit preservation cannot silently leave a selected
+                    // old camera behind on the retiring publisher.
+                    return Err(StreamControlError::Authority);
+                }
+            }
+        }
+        if changes.is_empty() {
+            Ok(None)
+        } else {
+            Ok(Some(DirectSubscriptionChange::Subscribe(
+                changes.into_values().collect(),
+            )))
+        }
+    }
+}
