+//! Observations of actual guarded queues. This owns no permission or media IO.
+use super::*;
+use crate::media_diagnostics::{ForwardStage, MediaDiagnostics, QueueStage};
+
+#[derive(Clone)]
+pub(super) struct PortDiagnostics {
+    collector: Arc<MediaDiagnostics>,
+    input: QueueStage,
+    output: QueueStage,
+}
+impl PortDiagnostics {
+    pub(super) fn forwarded_age(&self, admitted: Instant) {
+        self.collector.forwarded_age(
+            self.output,
+            admitted.elapsed().as_millis().min(i64::MAX as u128) as i64,
+        );
+    }
+    pub(super) fn stale_if_expired(&self, admitted: Instant) {
+        if admitted.elapsed() >= Duration::from_millis(200) {
+            self.collector.stale_discard(self.output);
+        }
+    }
+}
+impl AdapterMediaPort {
+    /// Trusted embedding only: attach one numeric collector to this exact
+    /// actual port. This changes no gate, ticket, deadline or readiness.
+    pub fn configure_queue_diagnostics(
+        &self,
+        collector: Arc<MediaDiagnostics>,
+        input: QueueStage,
+        output: QueueStage,
+    ) -> ControlResult<()> {
+        let expected = match self.0.kind() {
+            StreamKind::Audio => "audio",
+            StreamKind::Video => "video",
+            _ => return Err(StreamControlError::Unsupported),
+        };
+        if input.kind() != expected || output.kind() != expected {
+            return Err(StreamControlError::Unsupported);
+        }
+        let proposed = PortDiagnostics {
+            collector,
+            input,
+            output,
+        };
+        if let Err(proposed) = self.0.diagnostics.set(proposed) {
+            let original = self.0.diagnostics.get().expect("installed diagnostics");
+            if !Arc::ptr_eq(&original.collector, &proposed.collector)
+                || original.input as usize != proposed.input as usize
+                || original.output as usize != proposed.output as usize
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+        }
+        Ok(())
+    }
+    /// Pump-poll occupancy of the same bounded queue used by guarded delivery.
+    pub fn observe_egress_queue(&self) {
+        if let Some(observation) = self.0.diagnostics.get() {
+            observation.collector.observe_queue(
+                observation.output,
+                self.0.egress.max_capacity(),
+                self.0
+                    .egress
+                    .max_capacity()
+                    .saturating_sub(self.0.egress.capacity()),
+            );
+        }
+    }
+}
+impl Port {
+    pub(super) fn enqueue_ingress(
+        &self,
+        packet: MediaPacket,
+    ) -> Result<(), mpsc::error::TrySendError<MediaPacket>> {
+        if let Some(observation) = self.diagnostics.get() {
+            observation.collector.ingress(&packet.frame);
+        }
+        let result = self.ingress.try_send(packet);
+        if let Some(observation) = self.diagnostics.get() {
+            observation.collector.observe_queue(
+                observation.input,
+                self.ingress.max_capacity(),
+                self.ingress
+                    .max_capacity()
+                    .saturating_sub(self.ingress.capacity()),
+            );
+            if matches!(&result, Err(mpsc::error::TrySendError::Full(_))) {
+                observation.collector.enqueue_full(observation.input);
+            }
+        }
+        result
+    }
+    pub(super) fn enqueue_egress(
+        &self,
+        queued: QueuedMedia,
+    ) -> Result<(), mpsc::error::TrySendError<QueuedMedia>> {
+        let handoff = self.diagnostics.get().and_then(|_| {
+            (queued.frame.kind == StreamKind::Video && queued.sources.len() == 1).then(|| {
+                (
+                    queued.frame.clone(),
+                    queued.sources[0].source.binding.transport_id.clone(),
+                )
+            })
+        });
+        let result = self.egress.try_send(queued);
+        if let Some(observation) = self.diagnostics.get() {
+            observation.collector.observe_queue(
+                observation.output,
+                self.egress.max_capacity(),
+                self.egress
+                    .max_capacity()
+                    .saturating_sub(self.egress.capacity()),
+            );
+            if matches!(&result, Err(mpsc::error::TrySendError::Full(_))) {
+                observation.collector.enqueue_full(observation.output);
+            } else if result.is_ok() {
+                if let Some((frame, source)) = handoff {
+                    observation.collector.handoff_from(
+                        ForwardStage::NativeVideoFanout,
+                        &frame,
+                        &source,
+                    );
+                }
+            }
+        }
+        result
+    }
+}
