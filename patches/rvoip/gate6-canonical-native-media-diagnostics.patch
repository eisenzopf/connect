@@ -0,0 +1,130 @@
+//! Actual queue/custody observations; no native transport qualification.
+use super::*;
+use crate::media_diagnostics::{MediaDiagnostics, QueueStage};
+
+fn attach(port: &AdapterMediaPort, collector: Arc<MediaDiagnostics>) {
+    let (input, output, _) = QueueStage::quic(port.0.kind()).unwrap();
+    port.configure_queue_diagnostics(collector, input, output)
+        .unwrap();
+}
+
+#[tokio::test]
+async fn native_video_records_actual_queues_and_original_source_handoff() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let source = f.aa.port(Medium::Video);
+    let target = f.ba.port(Medium::Video);
+    let collector = Arc::new(MediaDiagnostics::default());
+    attach(&source, collector.clone());
+    attach(&target, collector.clone());
+    assert!(collector.snapshot().queues.is_empty());
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Video).logical_id)
+            .unwrap();
+    let mut output = target.take_egress().unwrap();
+    let original = frame(&source, 1);
+    source.try_publish(&original).unwrap();
+    receive(&mut input)
+        .await
+        .forward(&f.b, &desired(Medium::Video).logical_id)
+        .unwrap();
+    target.observe_egress_queue();
+    outgoing(&mut output)
+        .await
+        .deliver(|received| {
+            assert_ne!(received.stream_id, original.stream_id);
+            assert_eq!(received.payload, original.payload);
+            std::future::ready(Ok(()))
+        })
+        .await
+        .unwrap();
+    let observed = collector.snapshot();
+    assert_eq!(observed.queues.len(), 2);
+    assert!(observed
+        .queues
+        .iter()
+        .all(|(_, q)| q.capacity_packets == 64 && q.observations > 0));
+    let (_, output) = observed
+        .queues
+        .iter()
+        .find(|(s, _)| matches!(s, QueueStage::QuicVideoOut))
+        .unwrap();
+    assert!(output
+        .max_forwarded_frame_age_ms
+        .is_some_and(|age| age <= 200));
+    let (_, forwarding) = observed
+        .forwarding
+        .iter()
+        .find(|(s, _)| s.name() == "canonical-native-video-fanout")
+        .unwrap();
+    assert_eq!(forwarding.samples, 1);
+    assert_eq!(forwarding.missing_ingress_observations, 0);
+}
+
+#[tokio::test]
+async fn native_queue_full_expiry_and_policy_refusal_remain_real_failures() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let source = f.aa.port(Medium::Video);
+    let target = f.ba.port(Medium::Video);
+    let collector = Arc::new(MediaDiagnostics::default());
+    attach(&source, collector.clone());
+    attach(&target, collector.clone());
+    let capacity = source.ingress_capacity().0;
+    for sequence in 0..capacity {
+        source
+            .try_publish(&frame(&source, sequence as u32))
+            .unwrap();
+    }
+    assert!(matches!(
+        source.try_publish(&frame(&source, 1000)),
+        Err(StreamControlError::Backpressure)
+    ));
+    let snapshot = collector.snapshot();
+    let (_, input) = snapshot
+        .queues
+        .iter()
+        .find(|(s, _)| matches!(s, QueueStage::QuicVideoIn))
+        .unwrap();
+    assert_eq!(input.sampled_high_water_packets, capacity);
+    assert_eq!(input.enqueue_full_observations, 1);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Video).logical_id)
+            .unwrap();
+    let mut output = target.take_egress().unwrap();
+    receive(&mut input)
+        .await
+        .forward(&f.b, &desired(Medium::Video).logical_id)
+        .unwrap();
+    let queued = outgoing(&mut output).await;
+    tokio::time::sleep(Duration::from_millis(210)).await;
+    assert!(matches!(
+        queued
+            .deliver(|_| async { panic!("expired frame reached IO") })
+            .await,
+        Err(StreamControlError::Deadline)
+    ));
+    let snapshot = collector.snapshot();
+    let (_, output) = snapshot
+        .queues
+        .iter()
+        .find(|(s, _)| matches!(s, QueueStage::QuicVideoOut))
+        .unwrap();
+    assert_eq!(output.stale_forwarding_discards, 1);
+    assert!(output.max_forwarded_frame_age_ms.is_none());
+    f.policy.0.write().await.revoked.insert("alice".into());
+    assert!(matches!(
+        source.try_publish(&frame(&source, 1001)),
+        Err(StreamControlError::Authority)
+    ));
+    assert!(source
+        .configure_queue_diagnostics(
+            Arc::new(MediaDiagnostics::default()),
+            QueueStage::QuicVideoIn,
+            QueueStage::QuicVideoOut
+        )
+        .is_err());
+    assert!(source
+        .configure_queue_diagnostics(collector, QueueStage::QuicAudioIn, QueueStage::QuicAudioOut)
+        .is_err());
+}
