+//! Core-reserved canonical WebRTC resources. Dormant allocation is distinct
+//! from SDP/DTLS, staged media readiness and participant admission.
+use crate::{
+    WebRtcConfig,
+    peer::{PeerRole, RvoipPeerConnection},
+};
+use dashmap::DashMap;
+use futures::{
+    FutureExt,
+    future::{BoxFuture, Shared},
+};
+use rvoip_core::{
+    adapter::*,
+    capability::{CapabilityDescriptor, NegotiatedCodecs},
+    connection::{Connection, ConnectionState, Direction, Transport, TransportHandle},
+    error::{Result, RvoipError},
+    identity::IdentityAssurance,
+    ids::*,
+    message::Message,
+    orchestrator::peer_native::WebRtcConnectionRequest,
+    peer_admission::PeerAdmission,
+    stream::MediaStream,
+};
+use std::sync::{
+    Arc, Mutex, OnceLock, Weak,
+    atomic::{AtomicUsize, Ordering},
+};
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+#[derive(Clone)]
+enum AllocationError {
+    Construction,
+    Worker,
+}
+type Allocation =
+    Shared<BoxFuture<'static, std::result::Result<Arc<RvoipPeerConnection>, AllocationError>>>;
+type Completion = Shared<BoxFuture<'static, std::result::Result<(), String>>>;
+struct Owner {
+    peer: Weak<PeerAdmission>,
+    connection: ConnectionId,
+    cancel: CancellationToken,
+}
+/// Created by the trusted WSS factory before Core reservation. No wire body
+/// can construct the Core request or substitute this original owner/context.
+pub struct WebRtcPhysicalBinding {
+    accepted_peer: Weak<PeerAdmission>,
+    lifetime: CancellationToken,
+    owner: Mutex<Option<Owner>>,
+    allocation: Mutex<Option<Allocation>>,
+    completion: OnceLock<Completion>,
+}
+impl WebRtcPhysicalBinding {
+    pub fn new(peer: &Arc<PeerAdmission>, physical: CancellationToken) -> Arc<Self> {
+        Arc::new(Self {
+            accepted_peer: Arc::downgrade(peer),
+            lifetime: physical.child_token(),
+            owner: Mutex::new(None),
+            allocation: Mutex::new(None),
+            completion: OnceLock::new(),
+        })
+    }
+    fn bind(
+        &self,
+        peer: &Arc<PeerAdmission>,
+        id: &ConnectionId,
+        cancel: CancellationToken,
+    ) -> Result<()> {
+        if self.lifetime.is_cancelled()
+            || peer.is_closed()
+            || !Weak::ptr_eq(&self.accepted_peer, &Arc::downgrade(peer))
+        {
+            return Err(RvoipError::AdmissionRejected("WebRTC physical peer closed"));
+        }
+        let mut owner = self.owner.lock().unwrap_or_else(|p| p.into_inner());
+        if owner.is_some() {
+            return Err(RvoipError::AdmissionRejected(
+                "WebRTC physical binding already reserved",
+            ));
+        }
+        *owner = Some(Owner {
+            peer: Arc::downgrade(peer),
+            connection: id.clone(),
+            cancel,
+        });
+        Ok(())
+    }
+    fn current(&self, peer: &Arc<PeerAdmission>, id: &ConnectionId) -> bool {
+        !self.lifetime.is_cancelled()
+            && !peer.is_closed()
+            && self
+                .owner
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .is_some_and(|o| {
+                    o.connection == *id
+                        && !o.cancel.is_cancelled()
+                        && Weak::ptr_eq(&o.peer, &Arc::downgrade(peer))
+                })
+    }
+    fn owner_current(&self) -> bool {
+        !self.lifetime.is_cancelled()
+            && self
+                .owner
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .is_some_and(|o| {
+                    !o.cancel.is_cancelled() && o.peer.upgrade().is_some_and(|p| !p.is_closed())
+                })
+    }
+    /// Starts at most once, only AFTER the Core callback reserved this context.
+    /// The original spawned allocation lives outside any result observation.
+    pub fn start_peer(&self, config: WebRtcConfig, role: PeerRole) -> Result<()> {
+        let mut slot = self.allocation.lock().unwrap_or_else(|p| p.into_inner());
+        let owner = self.owner.lock().unwrap_or_else(|p| p.into_inner());
+        if self.lifetime.is_cancelled()
+            || owner.as_ref().is_none_or(|o| {
+                o.cancel.is_cancelled() || o.peer.upgrade().is_none_or(|p| p.is_closed())
+            })
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "Core WebRTC reservation required",
+            ));
+        }
+        if slot.is_some() {
+            return Err(RvoipError::InvalidState(
+                "WebRTC allocation already started",
+            ));
+        }
+        let runtime = tokio::runtime::Handle::try_current()
+            .map_err(|_| RvoipError::InvalidState("WebRTC allocation runtime unavailable"))?;
+        let lifetime = self.lifetime.clone();
+        let route_cancel = owner.as_ref().unwrap().cancel.clone();
+        let task = runtime.spawn(async move {
+            let peer = RvoipPeerConnection::new(&config, role)
+                .await
+                .map_err(|_| AllocationError::Construction)?;
+            if lifetime.is_cancelled() || route_cancel.is_cancelled() {
+                peer.close().await.map_err(|_| AllocationError::Worker)?;
+                return Err(AllocationError::Construction);
+            }
+            Ok(peer)
+        });
+        *slot = Some(
+            async move { task.await.unwrap_or(Err(AllocationError::Worker)) }
+                .boxed()
+                .shared(),
+        );
+        Ok(())
+    }
+    pub async fn peer(&self, deadline: tokio::time::Instant) -> Result<Arc<RvoipPeerConnection>> {
+        if !self.owner_current() {
+            return Err(RvoipError::AdmissionRejected(
+                "WebRTC physical peer retired",
+            ));
+        }
+        let original = self
+            .allocation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .clone()
+            .ok_or(RvoipError::InvalidState("WebRTC allocation not started"))?;
+        let result = tokio::time::timeout_at(deadline, original)
+            .await
+            .map_err(|_| RvoipError::InvalidState("WebRTC allocation observation deadline"))?;
+        if !self.owner_current() {
+            return Err(RvoipError::AdmissionRejected(
+                "WebRTC physical peer retired",
+            ));
+        }
+        match result {
+            Ok(p) => Ok(p),
+            Err(AllocationError::Construction) => {
+                Err(RvoipError::InvalidState("WebRTC construction failed"))
+            }
+            Err(AllocationError::Worker) => Err(RvoipError::InvalidState(
+                "WebRTC allocation ownership unconfirmed",
+            )),
+        }
+    }
+    /// Confirm original allocation and actual RTC driver destruction. A dropped
+    /// observer cannot discard either original join or release Core quota.
+    pub async fn shutdown(&self) -> Result<()> {
+        self.lifetime.cancel();
+        let completion = self.completion.get_or_init(|| {
+            let allocation = self
+                .allocation
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .clone();
+            let task = tokio::spawn(async move {
+                if let Some(allocation) = allocation {
+                    match allocation.await {
+                        Ok(peer) => peer.close().await.map_err(|e| e.to_string())?,
+                        // The constructor starts its driver only at its final
+                        // success boundary; a returned construction error owns
+                        // no started peer. A missing task result is unconfirmed.
+                        Err(AllocationError::Construction) => {}
+                        Err(AllocationError::Worker) => {
+                            return Err("WebRTC allocation join unconfirmed".into());
+                        }
+                    }
+                }
+                Ok(())
+            });
+            async move {
+                task.await
+                    .unwrap_or_else(|_| Err("WebRTC close join unconfirmed".into()))
+            }
+            .boxed()
+            .shared()
+        });
+        completion
+            .clone()
+            .await
+            .map_err(|_| RvoipError::InvalidState("WebRTC cleanup unconfirmed"))
+    }
+}
+impl Drop for WebRtcPhysicalBinding {
+    fn drop(&mut self) {
+        self.lifetime.cancel();
+        if self.completion.get().is_some() {
+            return;
+        }
+        if let Some(allocation) = self
+            .allocation
+            .get_mut()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+        {
+            if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+                runtime.spawn(async move {
+                    if let Ok(peer) = allocation.await {
+                        let _ = peer.close().await;
+                    }
+                });
+            }
+        }
+    }
+}
+struct Route {
+    binding: Arc<WebRtcPhysicalBinding>,
+    peer: Weak<PeerAdmission>,
+    cancel: CancellationToken,
+}
+impl Drop for Route {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+    }
+}
+/// Explicit canonical resource adapter. It has no legacy signaling/outbound
+/// fallback and does not advertise staged media until that backend is installed.
+pub struct CanonicalWebRtcAdapter {
+    routes: DashMap<ConnectionId, Arc<Route>>,
+    allocated: AtomicUsize,
+    events: mpsc::Sender<OrchestratorAdapterEvent>,
+    receiver: Mutex<Option<mpsc::Receiver<OrchestratorAdapterEvent>>>,
+    lifecycle: AdapterLifecycleSinkSlot,
+}
+impl CanonicalWebRtcAdapter {
+    pub fn new() -> Arc<Self> {
+        let (tx, rx) = mpsc::channel(64);
+        Arc::new(Self {
+            routes: DashMap::new(),
+            allocated: AtomicUsize::new(0),
+            events: tx,
+            receiver: Mutex::new(Some(rx)),
+            lifecycle: Default::default(),
+        })
+    }
+    pub fn route_count(&self) -> usize {
+        self.routes.len()
+    }
+    pub fn total_allocations(&self) -> usize {
+        self.allocated.load(Ordering::Acquire)
+    }
+}
+#[async_trait::async_trait]
+impl ConnectionAdapter for CanonicalWebRtcAdapter {
+    fn transport(&self) -> Transport {
+        Transport::WebRtc
+    }
+    fn kind(&self) -> AdapterKind {
+        AdapterKind::Substrate
+    }
+    fn lifecycle_capabilities(&self) -> AdapterLifecycleCapabilities {
+        AdapterLifecycleCapabilities {
+            authoritative_liveness: true,
+            terminal_fallback: true,
+            ..Default::default()
+        }
+    }
+    fn install_lifecycle_sink(&self, s: Arc<dyn AdapterLifecycleSink>) -> Result<()> {
+        self.lifecycle
+            .install(s)
+            .map_err(|_| RvoipError::InvalidState("WebRTC lifecycle sink already installed"))
+    }
+    fn supports_peer_webrtc_preparation(&self) -> bool {
+        true
+    }
+    fn prepare_peer_webrtc_connection(
+        &self,
+        request: &WebRtcConnectionRequest,
+    ) -> Result<ConnectionHandle> {
+        if request.frozen_endpoint().transport() != Transport::WebRtc {
+            return Err(RvoipError::AdmissionRejected("WebRTC Endpoint required"));
+        }
+        let binding =
+            request
+                .context::<WebRtcPhysicalBinding>()
+                .ok_or(RvoipError::AdmissionRejected(
+                    "original WebRTC physical context required",
+                ))?;
+        binding.bind(request.peer(), request.connection(), request.cancellation())?;
+        let id = request.connection().clone();
+        let route = Arc::new(Route {
+            binding,
+            peer: Arc::downgrade(request.peer()),
+            cancel: request.cancellation(),
+        });
+        match self.routes.entry(id.clone()) {
+            dashmap::mapref::entry::Entry::Vacant(e) => {
+                e.insert(route);
+            }
+            _ => return Err(RvoipError::InvalidState("WebRTC route ID conflicts")),
+        };
+        self.allocated.fetch_add(1, Ordering::AcqRel);
+        Ok(ConnectionHandle::new(Connection {
+            id,
+            session_id: request.session().clone(),
+            participant_id: request.participant().clone(),
+            transport: Transport::WebRtc,
+            direction: Direction::Inbound,
+            state: ConnectionState::Connecting,
+            capabilities: Default::default(),
+            negotiated_codecs: Default::default(),
+            streams: vec![],
+            messaging_enabled: false,
+            transport_handle: TransportHandle(Arc::new(())),
+            opened_at: chrono::Utc::now(),
+            closed_at: None,
+        }))
+    }
+    fn is_peer_webrtc_preparation_current(
+        &self,
+        id: &ConnectionId,
+        peer: &Arc<PeerAdmission>,
+    ) -> bool {
+        self.routes.get(id).is_some_and(|r| {
+            !r.cancel.is_cancelled()
+                && Weak::ptr_eq(&r.peer, &Arc::downgrade(peer))
+                && r.binding.current(peer, id)
+        })
+    }
+    fn is_connection_live(&self, id: &ConnectionId) -> bool {
+        self.routes.contains_key(id)
+    }
