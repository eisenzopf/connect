+        Err(RvoipError::NotImplemented(
+            "canonical WebRTC staged admission required",
+        ))
+    }
+    async fn reject(&self, id: ConnectionId, _: RejectReason) -> Result<()> {
+        self.end(id, EndReason::Normal).await
+    }
+    async fn end(&self, id: ConnectionId, reason: EndReason) -> Result<()> {
+        let route = self.routes.get(&id).map(|r| r.value().clone());
+        if let Some(route) = route {
+            route.cancel.cancel();
+            route.binding.shutdown().await?;
+            if self
+                .routes
+                .remove_if(&id, |_, r| Arc::ptr_eq(r, &route))
+                .is_some()
+            {
+                self.lifecycle
+                    .queue_or_deliver_orchestrator_terminal(
+                        &self.events,
+                        AdapterEvent::Ended {
+                            connection_id: id,
+                            reason,
+                        },
+                    )
+                    .await;
+            }
+        }
+        Ok(())
+    }
+    async fn hold(&self, _: ConnectionId) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical WebRTC hold"))
+    }
+    async fn resume(&self, _: ConnectionId) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical WebRTC resume"))
+    }
+    async fn transfer(&self, _: ConnectionId, _: TransferTarget) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical WebRTC transfer"))
+    }
+    async fn streams(&self, id: ConnectionId) -> Result<Vec<Arc<dyn MediaStream>>> {
+        if !self.routes.contains_key(&id) {
+            return Err(RvoipError::ConnectionNotFound(id));
+        }
+        Ok(vec![])
+    }
+    async fn send_message(&self, _: ConnectionId, _: Message) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical WebRTC data"))
+    }
+    async fn send_dtmf(&self, _: ConnectionId, _: &str, _: u32) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical WebRTC DTMF"))
+    }
+    async fn renegotiate_media(
+        &self,
+        _: ConnectionId,
+        _: CapabilityDescriptor,
+    ) -> Result<NegotiatedCodecs> {
+        Err(RvoipError::NotImplemented(
+            "canonical WebRTC staged media required",
+        ))
+    }
+    async fn verify_request_signature(
+        &self,
+        _: ConnectionId,
+        _: SignatureHeaders,
+    ) -> Result<IdentityAssurance> {
+        Err(RvoipError::NotImplemented(
+            "canonical signatures require authenticated dispatch",
+        ))
+    }
+    fn subscribe_events(&self) -> mpsc::Receiver<AdapterEvent> {
+        legacy_normalized_event_receiver(self.subscribe_orchestrator_events(), 64)
+    }
+    fn subscribe_orchestrator_events(&self) -> mpsc::Receiver<OrchestratorAdapterEvent> {
+        self.receiver
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .unwrap_or_else(|| {
+                let (_, rx) = mpsc::channel(1);
+                rx
+            })
+    }
+    fn capabilities(&self) -> CapabilityDescriptor {
+        Default::default()
+    }
+}
