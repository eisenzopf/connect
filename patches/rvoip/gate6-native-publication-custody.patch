+    /// Keep the exact signed preparation and Core installed resources stable
+    /// through one synchronous host publication. This supplies no IO permission.
+    pub fn try_publish_installed<R>(
+        &self,
+        generation: u64,
+        publish: impl FnOnce() -> R,
+    ) -> ControlResult<R> {
+        let prepared = self.prepared.try_lock().map_err(|error| match error {
+            std::sync::TryLockError::WouldBlock => StreamControlError::NotReady,
+            std::sync::TryLockError::Poisoned(_) => StreamControlError::Authority,
+        })?;
+        prepared
+            .as_ref()
+            .ok_or(StreamControlError::NotReady)?
+            .try_publish_installed(generation, publish)
