+#[tokio::test]
+async fn installed_publication_orders_retirement_but_never_defers_packet_cancellation() {
+    for mode in [
+        "already-cancelled",
+        "retire-during",
+        "external-during",
+        "rollback",
+    ] {
+        let (_, policy, held, controller, adapter) = setup(true, false).await;
+        controller
+            .change_with_held(
+                0,
+                &[desired(Medium::Audio)],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+                held.clone(),
+            )
+            .await
+            .unwrap();
+        let proof = policy.proof.lock().unwrap().clone().unwrap();
+        let port = adapter.port(Medium::Audio);
+        let called = std::cell::Cell::new(0);
+        // Wrong generation and busy controller metadata never invoke SQL work.
+        assert!(proof.try_publish_installed(3, || called.set(99)).is_err());
+        let busy = controller.state.lock().unwrap();
+        let began = std::time::Instant::now();
+        for _ in 0..16 {
+            assert!(matches!(
+                proof.try_publish_installed(2, || called.set(99)),
+                Err(StreamControlError::NotReady)
+            ));
+        }
+        assert!(began.elapsed() < Duration::from_millis(50));
+        drop(busy);
+        if mode == "already-cancelled" {
+            controller.shutdown.clone().cancel();
+            assert!(matches!(
+                proof.try_publish_installed(2, || called.set(99)),
+                Err(StreamControlError::Cancelled)
+            ));
+            assert_eq!(called.get(), 0);
+        } else {
+            let mut retirement = None;
+            let mut done_retiring = None;
+            let result = proof
+                .try_publish_installed(2, || {
+                    called.set(called.get() + 1);
+                    assert!(controller.state.try_lock().is_err());
+                    if mode == "retire-during" || mode == "rollback" {
+                        let c = controller.clone();
+                        let (sent, done) = std::sync::mpsc::channel();
+                        retirement = Some(std::thread::spawn(move || {
+                            c.retire();
+                            sent.send(()).unwrap();
+                        }));
+                        let until = std::time::Instant::now() + Duration::from_secs(1);
+                        while !controller.shutdown.is_cancelled() {
+                            assert!(std::time::Instant::now() < until);
+                            std::thread::yield_now();
+                        }
+                        assert!(port.ingress_is_closed(), "packet cancellation is immediate");
+                        assert!(
+                            matches!(done.try_recv(), Err(std::sync::mpsc::TryRecvError::Empty)),
+                            "retirement removed resources before publication returned"
+                        );
+                        // Keep the receiver alive until the retirement sender completes.
+                        done_retiring = Some(done);
+                    } else {
+                        // External parent/shared lifetime cancellation does not call
+                        // retire: it must still fence packets during publication.
+                        controller.shutdown.clone().cancel();
+                        assert!(port.ingress_is_closed());
+                    }
+                    if mode == "rollback" {
+                        Err("controlled host commit failure")
+                    } else {
+                        Ok(())
+                    }
+                })
+                .unwrap();
+            assert_eq!(result.is_err(), mode == "rollback");
+            if let Some(done) = done_retiring {
+                done.recv_timeout(Duration::from_secs(1)).unwrap();
+            }
+            if let Some(retirement) = retirement {
+                retirement.join().unwrap();
+            }
+            assert_eq!(called.get(), 1);
+            assert!(proof.try_publish_installed(2, || called.set(99)).is_err());
+        }
+        assert!(port.try_publish(&frame(&port, 160)).is_err());
+        drop(held);
+        assert_eq!(controller.shutdown(deadline()).await, 0);
+    }
+}
