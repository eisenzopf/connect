+    /// Order one synchronous host publication against controller retirement.
+    /// The final cancellation read under the controller state lock is the
+    /// ordering point. Cancellation before it refuses the callback. Cancellation
+    /// afterward still fences packets immediately, but retirement cannot remove
+    /// the installed port metadata until this callback returns. A successful
+    /// host commit can therefore precede subsequent retirement; this is never a
+    /// promise of future connectivity or a media authority lease.
+    ///
+    /// Acquisition is nonblocking. The callback must perform only its already
+    /// prepared local publication: no native IO, await, policy or control call.
+    pub fn try_publish_installed<R>(
+        &self,
+        generation: u64,
+        publish: impl FnOnce() -> R,
+    ) -> ControlResult<R> {
+        let controller = self.controller()?;
+        let state = controller.state.try_lock().map_err(|error| match error {
+            std::sync::TryLockError::WouldBlock => StreamControlError::NotReady,
+            std::sync::TryLockError::Poisoned(_) => StreamControlError::Authority,
+        })?;
+        if state.closed
+            || generation != self.generation
+            || !self.committed.load(Ordering::Acquire)
+            || self.bindings.is_empty()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut ports = Vec::with_capacity(self.bindings.len());
+        for binding in &self.bindings {
+            let port = state
+                .active
+                .values()
+                .find(|port| {
+                    port.binding.transport_id == binding.transport_id
+                        && port.binding.stream_local_id == binding.stream_local_id
+                        && port.binding.generation == binding.generation
+                        && port.binding.connection_generation == generation
+                })
+                .ok_or(StreamControlError::Authority)?;
+            let active = port.state.try_lock().map_err(|error| match error {
+                std::sync::TryLockError::WouldBlock => StreamControlError::NotReady,
+                std::sync::TryLockError::Poisoned(_) => StreamControlError::Authority,
+            })?;
+            if !active.ready || !matches!(active.status, PortStatus::Active | PortStatus::Paused) {
+                return Err(StreamControlError::Authority);
+            }
+            ports.push(active);
+        }
+        // This final read orders publication. Neither token is deferred or
+        // replaced: external lifetime cancellation continues to fence IO now.
+        if controller.shutdown.is_cancelled() || self.cancelled.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let result = publish();
+        drop(ports);
+        drop(state);
+        Ok(result)
     }
