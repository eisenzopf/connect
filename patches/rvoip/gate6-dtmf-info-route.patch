+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn temporary_session_metadata_contention_defers_io_without_retiring_the_live_signal_route() {
+    let r = Rig::new().await;
+    let route = r.route("12", 500, DtmfMethod::Rfc4733);
+    let policy = Policy::new(&r);
+    let sending = tokio::spawn({
+        let core = r.core.clone();
+        let policy = policy.clone();
+        let route = route.clone();
+        async move {
+            core.route_dtmf(
+                &route,
+                policy,
+                CancellationToken::new(),
+                Instant::now() + Duration::from_secs(3),
+            )
+            .await
+        }
+    });
+    r.receive().await;
+    let session = r.core.session(&r.sid).unwrap();
+    let (entered_tx, entered_rx) = tokio::sync::oneshot::channel();
+    let (release_tx, release_rx) = std::sync::mpsc::channel();
+    let writer = std::thread::spawn(move || {
+        let _guard = session.write().unwrap();
+        let _ = entered_tx.send(());
+        let _ = release_rx.recv();
+    });
+    entered_rx.await.unwrap();
+    r.drain().await;
+    // No socket poll may borrow unavailable Session metadata. The source
+    // remains live; bounded contention is not source retirement or a grant.
+    r.no_packet().await;
+    release_tx.send(()).unwrap();
+    writer.join().unwrap();
+    assert_eq!(
+        sending.await.unwrap(),
+        Ok(()),
+        "a temporary metadata writer retired a valid owned signal schedule"
+    );
+    assert!(route.current());
+    assert_eq!(r.raw.calls.load(Ordering::SeqCst), 0);
+}
