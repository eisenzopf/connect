+    /// Explicit bounded application/dtmf-relay profile on the exact admitted
+    /// dialog. RFC6086 INFO-package negotiation is a separate profile. A 2xx
+    /// here is protocol acceptance, never a remote playout measurement.
+    pub(crate) async fn send_dtmf_info_sequence_exact(
+        &self,
+        handle: &SessionRegistryHandle,
+        digits: &str,
+        duration_ms: u32,
+        policy: Arc<dyn rvoip_media_core::dtmf_authority::DtmfInfoWriteAuthority>,
+        requested_deadline: tokio::time::Instant,
+    ) -> std::result::Result<(), rvoip_media_core::dtmf_authority::DtmfWriteError> {
+        use rvoip_media_core::dtmf_authority::*;
+        use rvoip_media_core::relay::controller::dtmf_transmitter::{
+            validate_dtmf_sequence, DEFAULT_DTMF_INTER_DIGIT_MS, MAX_DTMF_SEQUENCE_MS,
+        };
+        validate_dtmf_sequence(digits, duration_ms, DEFAULT_DTMF_INTER_DIGIT_MS)
+            .map_err(|_| DtmfWriteError::Refused)?;
+        if !(100..=5000).contains(&duration_ms) {
+            return Err(DtmfWriteError::Refused);
+        }
+        let deadline = requested_deadline
+            .min(tokio::time::Instant::now() + Duration::from_millis(MAX_DTMF_SEQUENCE_MS));
+        if tokio::time::Instant::now() >= deadline {
+            return Err(DtmfWriteError::DeadlineBeforeWrite);
+        }
+        let dialog = resolve_dialog_for_handle_exact(self.store.as_ref(), handle)
+            .ok_or(DtmfWriteError::NotReady)?;
+        let lane = self
+            .store
+            .state_machine_lane_exact(handle)
+            .ok_or(DtmfWriteError::Refused)?;
+        let store = self.store.clone();
+        let exact = handle.clone();
+        let actual_dialog = dialog.clone();
+        let api = Arc::downgrade(&self.dialog_api);
+        let current: Arc<dyn Fn() -> bool + Send + Sync> = Arc::new(move || {
+            let Ok(snapshot) = store.get_session_snapshot_exact(&exact) else {
+                return false;
+            };
+            snapshot.dialog_established
+                && !snapshot.call_state.is_final()
+                && snapshot.call_state != crate::types::CallState::Terminating
+                && resolve_dialog_for_handle_exact(store.as_ref(), &exact).as_ref()
+                    == Some(&actual_dialog)
+                && api.upgrade().is_some_and(|api| {
+                    api.dialog_manager()
+                        .inner_manager()
+                        .get_dialog(&actual_dialog)
+                        .is_ok_and(|dialog| dialog.state == DialogState::Confirmed)
+                })
+        });
+        if !current() {
+            return Err(DtmfWriteError::NotReady);
+        }
+        let submitted = Arc::new(AtomicBool::new(false));
+        let run = async {
+            for (digit_index, digit) in digits.chars().enumerate() {
+                if !current() {
+                    return Err(DtmfWriteError::Refused);
+                }
+                let (content_type, body) = crate::api::bodies::dtmf_relay(digit, duration_ms);
+                let extra_headers = apply_outbound_extras_policy(
+                    Method::Info,
+                    Vec::new(),
+                    self.outbound_proxy_uri.as_ref(),
+                )
+                .map_err(|_| DtmfWriteError::Refused)?;
+                let error = Arc::new(StdMutex::new(None));
+                let last_write = Arc::new(StdMutex::new(None));
+                struct Write {
+                    policy: Arc<dyn DtmfInfoWriteAuthority>,
+                    current: Arc<dyn Fn() -> bool + Send + Sync>,
+                    lane: Arc<tokio::sync::Mutex<()>>,
+                    store: Arc<SessionStore>,
+                    handle: SessionRegistryHandle,
+                    digits: String,
+                    duration: u32,
+                    index: usize,
+                    body: bytes::Bytes,
+                    error: Arc<StdMutex<Option<DtmfWriteError>>>,
+                    submitted: Arc<AtomicBool>,
+                    last_write: Arc<StdMutex<Option<tokio::time::Instant>>>,
+                    deadline: tokio::time::Instant,
+                }
+                // Synchronous lifecycle custody only spans an actual
+                // bounded IO poll; no non-Send guard survives Pending.
+                struct LifeFence {
+                    store: Arc<SessionStore>,
+                    handle: SessionRegistryHandle,
+                    current: Arc<dyn Fn() -> bool + Send + Sync>,
+                }
+                impl DtmfIoFence for LifeFence {
+                    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+                        let Ok(guard) = self.store.authority().try_operation_exact(
+                            self.handle.key(),
+                            SessionOperationKind::Signaling,
+                        ) else {
+                            return std::task::Poll::Ready(Err(DtmfWriteError::Refused));
+                        };
+                        let result = if guard.ensure_current().is_ok() && (self.current)() {
+                            io()
+                        } else {
+                            std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+                        };
+                        // Releases custody without claiming that an external
+                        // signal was rolled back or mutating session state.
+                        guard.finish_rollback();
+                        result
+                    }
+                }
+                #[async_trait::async_trait]
+                impl rvoip_sip_dialog::transaction::egress::ClientRequestWriteAuthority for Write {
+                    async fn write(
+                        &self,
+                        actual: &rvoip_sip_dialog::transaction::egress::ClientRequestWriteScope<'_>,
+                        io: rvoip_sip_dialog::transaction::egress::ClientRequestWriteFuture<'_>,
+                    ) -> rvoip_sip_transport::Result<rvoip_sip_transport::TransportRoute>
+                    {
+                        let run=async {
+                            // Only the physically verified UDP profile is
+                            // installed here. No MTU/proxy TCP upgrade fallback.
+                            if actual.route.transport_type!=Some(rvoip_sip_transport::transport::TransportType::Udp){return Err(DtmfWriteError::Unsupported);}
+                            if !(self.current)() || !matches!(actual.message,rvoip_sip_core::Message::Request(request) if request.method()==Method::Info && request.body()==self.body.as_ref()) {return Err(DtmfWriteError::Refused);}
+                            let wire=actual.message.to_bytes();let scope=DtmfInfoWriteScope{digits:&self.digits,duration_ms:self.duration,inter_digit_ms:DEFAULT_DTMF_INTER_DIGIT_MS,digit_index:self.index,wire_request:&wire,destination:actual.route.destination};
+                            let write_deadline=self.deadline.min(tokio::time::Instant::now()+DTMF_WRITE_DEADLINE);
+                            let lease=tokio::time::timeout_at(write_deadline,self.policy.acquire_info(&scope)).await.map_err(|_|DtmfWriteError::DeadlineBeforeWrite)??;
+                            let lane=self.lane.clone().try_lock_owned().map_err(|_|DtmfWriteError::NotReady)?;
+                            let current=self.current.clone();
+                            let lease=lease.restrict(lane,move ||current()).with_fence(Arc::new(LifeFence{store:self.store.clone(),handle:self.handle.clone(),current:self.current.clone()}))?;
+                            with_dtmf_write_lease(lease,write_deadline,async {
+                                self.submitted.store(true,Ordering::Release);
+                                let result=io.await;
+                                if result.is_ok(){*self.last_write.lock().unwrap_or_else(|p|p.into_inner())=Some(tokio::time::Instant::now());}
+                                result
+                            }).await
+                        }.await;
+                        run.map_err(|error| {
+                            *self
+                                .error
+                                .lock()
+                                .unwrap_or_else(|poisoned| poisoned.into_inner()) = Some(error);
+                            rvoip_sip_transport::Error::InvalidState(
+                                "authorized INFO write failed".into(),
+                            )
+                        })
+                    }
+                }
+                let authority = Arc::new(Write {
+                    policy: policy.clone(),
+                    current: current.clone(),
+                    lane: lane.clone(),
+                    store: self.store.clone(),
+                    handle: handle.clone(),
+                    digits: digits.to_string(),
+                    duration: duration_ms,
+                    index: digit_index,
+                    body: body.clone(),
+                    error: error.clone(),
+                    submitted: submitted.clone(),
+                    last_write: last_write.clone(),
+                    deadline,
+                });
+                let delivery = self
+                    .dialog_api
+                    .send_info_with_options_authorized(
+                        &dialog,
+                        InfoRequestOptions {
+                            content_type,
+                            body,
+                            extra_headers,
+                        },
+                        authority,
+                        deadline,
+                    )
+                    .await
+                    .map_err(|_| {
+                        error
+                            .lock()
+                            .unwrap_or_else(|p| p.into_inner())
+                            .unwrap_or(DtmfWriteError::OutcomeUnknown)
+                    })?;
+                let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
+                let outcome = delivery
+                    .completion()
+                    .wait_for_outcome(remaining)
+                    .await
+                    .map_err(|_| DtmfWriteError::OutcomeUnknown)?;
+                // Stop any remaining exact transaction effects before another
+                // digit. Final status is factual SIP evidence only.
+                drop(delivery);
+                match outcome {
+                    Some(ClientTransactionOutcome::FinalResponse(response))
+                        if response.status().as_u16() >= 200
+                            && response.status().as_u16() < 300 => {}
+                    Some(ClientTransactionOutcome::FinalResponse(_)) => {
+                        return Err(DtmfWriteError::Refused)
+                    }
+                    _ => {
+                        return Err(error
+                            .lock()
+                            .unwrap_or_else(|p| p.into_inner())
+                            .unwrap_or(DtmfWriteError::OutcomeUnknown))
+                    }
+                }
+                if digit_index + 1 < digits.len() {
+                    // A lost request may first take effect on a retransmit.
+                    // Keep the requested tone/gap after the latest possible
+                    // write, without extending the original parent deadline.
+                    let last = (*last_write.lock().unwrap_or_else(|p| p.into_inner()))
+                        .ok_or(DtmfWriteError::OutcomeUnknown)?;
+                    tokio::time::sleep_until(
+                        (last
+                            + Duration::from_millis(u64::from(
+                                duration_ms + DEFAULT_DTMF_INTER_DIGIT_MS,
+                            )))
+                        .min(deadline),
+                    )
+                    .await;
+                    if tokio::time::Instant::now() >= deadline {
+                        return Err(DtmfWriteError::DeadlineBeforeWrite);
+                    }
+                }
+            }
+            Ok(())
+        };
+        let result = tokio::time::timeout_at(deadline, run)
+            .await
+            .unwrap_or(Err(DtmfWriteError::DeadlineBeforeWrite));
+        if result.is_err() && submitted.load(Ordering::Acquire) {
+            Err(DtmfWriteError::OutcomeUnknown)
+        } else {
+            result
+        }
     }
 
