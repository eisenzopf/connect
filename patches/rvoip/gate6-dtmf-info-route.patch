+//! Real Core source/recipient bindings and two actual local SIP/SDP calls.
+//! Permission is independent of the calls and applies to each INFO write.
+use async_trait::async_trait;
+use bytes::Bytes;
+use rvoip_core::{
+    adapter::{ConnectionAdapter, EndReason, OriginateRequest},
+    capability::CapabilityDescriptor,
+    connection::{Direction, Transport},
+    dtmf::*,
+    ids::{ConnectionId, ParticipantId, SessionId, TenantId},
+    Config as CoreConfig, Orchestrator,
+};
+use rvoip_sip::{
+    api::unified::{Config, UnifiedCoordinator},
+    SipAdapter,
+};
+use rvoip_sip_core::{parser::parse_message, prelude::*};
+use rvoip_sip_dialog::transaction::utils::response_builders::create_response;
+use std::result::Result;
+use std::{
+    net::SocketAddr,
+    str::FromStr,
+    sync::{
+        atomic::{AtomicU16, AtomicUsize, Ordering},
+        Arc, Mutex,
+    },
+    time::Duration,
+};
+use tokio::{
+    net::UdpSocket,
+    sync::{mpsc, RwLock},
+    time::{timeout, Instant},
+};
+use tokio_util::sync::CancellationToken;
+
+struct Observed {
+    bytes: Vec<u8>,
+    request: Request,
+    remote: SocketAddr,
+}
+struct Peer {
+    socket: Arc<UdpSocket>,
+    media: UdpSocket,
+    infos: mpsc::UnboundedReceiver<Observed>,
+    reply: Arc<AtomicU16>,
+    ack: Arc<tokio::sync::Notify>,
+    task: tokio::task::JoinHandle<()>,
+}
+impl Peer {
+    async fn new() -> Self {
+        let socket = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+        let address = socket.local_addr().unwrap();
+        let media = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let media_port = media.local_addr().unwrap().port();
+        let (tx, infos) = mpsc::unbounded_channel();
+        let reply = Arc::new(AtomicU16::new(200));
+        let status = reply.clone();
+        let wire = socket.clone();
+        let ack = Arc::new(tokio::sync::Notify::new());
+        let observed_ack = ack.clone();
+        let task = tokio::spawn(async move {
+            let mut bytes = vec![0; 65536];
+            loop {
+                let (n, remote) = wire.recv_from(&mut bytes).await.unwrap();
+                let request = match parse_message(&bytes[..n]).unwrap() {
+                    Message::Request(request) => request,
+                    _ => continue,
+                };
+                if request.method() == Method::Ack {
+                    observed_ack.notify_one();
+                    continue;
+                }
+                let selected = if request.method() == Method::Info {
+                    status.load(Ordering::Acquire)
+                } else {
+                    200
+                };
+                let mut response = create_response(
+                    &request,
+                    if selected == 401 {
+                        StatusCode::Unauthorized
+                    } else {
+                        StatusCode::Ok
+                    },
+                );
+                if selected == 401 {
+                    response.headers.push(TypedHeader::Other(HeaderName::WwwAuthenticate,rvoip_sip_core::types::header::HeaderValue::Raw(b"Digest realm=\"owned-info-fixture\", nonce=\"fixture-nonce\", algorithm=SHA-256, qop=\"auth\"".to_vec())));
+                }
+                if request.method() == Method::Invite {
+                    if let Some(TypedHeader::To(to)) = response
+                        .headers
+                        .iter_mut()
+                        .find(|h| matches!(h, TypedHeader::To(_)))
+                    {
+                        to.set_tag("info-peer");
+                    }
+                    response.headers.push(TypedHeader::Contact(
+                        Contact::from_str(&format!("<sip:wire-target@{address}>")).unwrap(),
+                    ));
+                    response.headers.push(TypedHeader::ContentType(
+                        rvoip_sip_core::types::ContentType::sdp(),
+                    ));
+                    response.body=Bytes::from(format!("v=0\r\no=info 1 1 IN IP4 127.0.0.1\r\ns=info\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\nm=audio {media_port} RTP/AVP 0 101\r\na=rtpmap:0 PCMU/8000\r\na=rtpmap:101 telephone-event/8000\r\na=fmtp:101 0-15\r\na=sendrecv\r\n"));
+                    response
+                        .headers
+                        .retain(|h| !matches!(h, TypedHeader::ContentLength(_)));
+                    response.headers.push(TypedHeader::ContentLength(
+                        rvoip_sip_core::types::ContentLength::new(response.body.len() as u32),
+                    ));
+                }
+                if request.method() == Method::Info {
+                    tx.send(Observed {
+                        bytes: bytes[..n].to_vec(),
+                        request,
+                        remote,
+                    })
+                    .unwrap();
+                }
+                if selected != 0 {
+                    wire.send_to(&Message::Response(response).to_bytes(), remote)
+                        .await
+                        .unwrap();
+                }
+            }
+        });
+        Self {
+            socket,
+            media,
+            infos,
+            reply,
+            ack,
+            task,
+        }
+    }
+    fn address(&self) -> SocketAddr {
+        self.socket.local_addr().unwrap()
+    }
+    async fn next(&mut self) -> Observed {
+        timeout(Duration::from_secs(2), self.infos.recv())
+            .await
+            .expect("INFO wire deadline")
+            .expect("peer ended")
+    }
+    async fn no_info(&mut self, duration: Duration) {
+        assert!(
+            timeout(duration, self.infos.recv()).await.is_err(),
+            "unexpected INFO effect/retry"
+        );
+    }
+    async fn respond(&self, observed: &Observed) {
+        let response = create_response(&observed.request, StatusCode::Ok);
+        self.socket
+            .send_to(&Message::Response(response).to_bytes(), observed.remote)
+            .await
+            .unwrap();
+    }
+    async fn no_rtp_tone(&self) {
+        let mut bytes = [0; 2048];
+        while let Ok(n) = self.media.try_recv(&mut bytes) {
+            assert!(
+                !(n >= 12 && bytes[1] & 127 == 101),
+                "INFO fell back to raw RFC4733"
+            );
+        }
+    }
+}
+struct Rig {
+    core: Arc<Orchestrator>,
+    adapter: Arc<SipAdapter>,
+    coordinator: Arc<UnifiedCoordinator>,
+    source: ConnectionId,
+    target: ConnectionId,
+    sid: SessionId,
+    source_peer: Peer,
+    target_peer: Peer,
+}
+impl Rig {
+    async fn new() -> Self {
+        let source_peer = Peer::new().await;
+        let target_peer = Peer::new().await;
+        let mut config = Config::local("owned-info-core", 0);
+        config.auth = Some(rvoip_sip::auth::SipClientAuth::digest(
+            "fixture-user",
+            "fixture-password",
+        ));
+        let coordinator = UnifiedCoordinator::new(config).await.unwrap();
+        let adapter = SipAdapter::new(coordinator.clone()).await.unwrap();
+        let core = Orchestrator::new(CoreConfig::default());
+        core.register(adapter.clone()).unwrap();
+        let conversation = core
+            .open_conversation(
+                TenantId::new(),
+                rvoip_core::conversation::ConversationPolicy::default(),
+                Default::default(),
+            )
+            .await
+            .unwrap();
+        let sid = core
+            .start_session(
+                conversation,
+                rvoip_core::session::SessionMedium::Voice,
+                vec![],
+            )
+            .await
+            .unwrap();
+        let mut events = core.subscribe_events();
+        let mut ids = Vec::new();
+        for peer in [&source_peer, &target_peer] {
+            let handle = core
+                .originate_connection(
+                    OriginateRequest::new(
+                        sid.clone(),
+                        ParticipantId::new(),
+                        format!("sip:peer@{}", peer.address()),
+                        Direction::Outbound,
+                        CapabilityDescriptor::default(),
+                    )
+                    .with_transport(Transport::Sip),
+                )
+                .await
+                .unwrap();
+            ids.push(handle.connection.id.clone());
+        }
+        let source = ids.remove(0);
+        let target = ids.remove(0);
+        timeout(Duration::from_secs(5), async {
+            loop {
+                if adapter.is_connection_live(&source)
+                    && adapter.is_connection_live(&target)
+                    && core
+                        .prepare_dtmf_route(
+                            source.clone(),
+                            target.clone(),
+                            DtmfIntent::new(
+                                "original-info-operation".into(),
+                                "5".into(),
+                                160,
+                                DtmfMethod::Info,
+                            )
+                            .unwrap(),
+                        )
+                        .is_ok()
+                {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .expect("actual SIP calls and published Core route");
+        timeout(Duration::from_secs(5), async {
+            let mut connected = std::collections::HashSet::new();
+            while connected.len() < 2 {
+                if let rvoip_core::events::Event::ConnectionConnected { connection_id, .. } =
+                    events.recv().await.unwrap()
+                {
+                    if connection_id == source || connection_id == target {
+                        connected.insert(connection_id);
+                    }
+                }
+            }
+        })
+        .await
+        .expect("both actual SIP final answers reached Core");
+        timeout(Duration::from_secs(2), source_peer.ack.notified())
+            .await
+            .expect("actual source INVITE ACK");
+        timeout(Duration::from_secs(2), target_peer.ack.notified())
+            .await
+            .expect("actual target INVITE ACK");
+        tokio::task::yield_now().await;
+        Self {
+            core,
+            adapter,
+            coordinator,
+            source,
+            target,
+            sid,
+            source_peer,
+            target_peer,
+        }
+    }
+    fn route(&self, digits: &str, duration: u32) -> DtmfRoute {
+        self.core
+            .prepare_dtmf_route(
+                self.source.clone(),
+                self.target.clone(),
+                DtmfIntent::new(
+                    "original-info-operation".into(),
+                    digits.into(),
+                    duration,
+                    DtmfMethod::Info,
+                )
+                .unwrap(),
+            )
+            .unwrap()
+    }
+    fn sending(
+        &self,
+        route: DtmfRoute,
+        policy: Arc<Policy>,
+        cancel: CancellationToken,
+        deadline: Instant,
+    ) -> tokio::task::JoinHandle<Result<(), DtmfWriteError>> {
+        let core = self.core.clone();
+        tokio::spawn(async move { core.route_dtmf(&route, policy, cancel, deadline).await })
+    }
+    async fn stop(self) {
+        for id in [&self.source, &self.target] {
+            let _ = self
+                .core
+                .end_connection(id.clone(), EndReason::Normal)
+                .await;
+        }
+        self.core.drain_connection_lifecycle_tasks().await;
+        self.adapter.drain().await.unwrap();
+        self.coordinator
+            .shutdown_gracefully(Some(Duration::from_secs(1)))
+            .await
+            .unwrap();
+        self.source_peer.task.abort();
+        self.target_peer.task.abort();
+    }
+}
+struct Policy {
+    source: ConnectionId,
+    target: ConnectionId,
+    operation: String,
+    permission: Arc<RwLock<bool>>,
+    calls: AtomicUsize,
+    facts: Mutex<Vec<(usize, Vec<u8>, SocketAddr)>>,
+    io_times: Arc<Mutex<Vec<(usize, Instant)>>>,
+}
+impl Policy {
+    fn new(r: &Rig) -> Arc<Self> {
+        Self::for_operation(r, "original-info-operation")
+    }
+    fn for_operation(r: &Rig, operation: &str) -> Arc<Self> {
+        Arc::new(Self {
+            source: r.source.clone(),
+            target: r.target.clone(),
+            operation: operation.into(),
+            permission: Arc::new(RwLock::new(true)),
+            calls: AtomicUsize::new(0),
+            facts: Mutex::new(Vec::new()),
+            io_times: Arc::new(Mutex::new(Vec::new())),
+        })
+    }
+}
+struct IoTime {
+    digit: usize,
+    times: Arc<Mutex<Vec<(usize, Instant)>>>,
+}
+impl DtmfIoFence for IoTime {
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        let result = io();
+        if matches!(result, std::task::Poll::Ready(Ok(()))) {
+            self.times
+                .lock()
+                .unwrap()
+                .push((self.digit, Instant::now()));
+        }
+        result
+    }
+}
+#[async_trait]
+impl DtmfRoutePolicy for Policy {
+    async fn acquire(
+        &self,
+        _route: &DtmfRouteScope<'_>,
+        _packet: &DtmfWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        panic!("INFO borrowed RTP permission")
+    }
+    async fn acquire_info(
+        &self,
+        route: &DtmfRouteScope<'_>,
+        info: &DtmfInfoWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        assert_eq!(route.source.connection(), &self.source);
+        assert_eq!(route.recipient.connection(), &self.target);
+        assert_eq!(route.source.transport(), Transport::Sip);
+        assert_eq!(route.recipient.transport(), Transport::Sip);
+        assert_eq!(route.source.conversation(), route.recipient.conversation());
+        assert_eq!(route.source.tenant(), route.recipient.tenant());
+        assert_eq!(route.intent.operation_id(), self.operation);
+        assert_eq!(route.intent.method(), DtmfMethod::Info);
+        assert_eq!(info.digits, route.intent.digits());
+        assert_eq!(info.duration_ms, route.intent.duration_ms());
+        assert_eq!(info.inter_digit_ms, 70);
+        let request = match parse_message(info.wire_request).unwrap() {
+            Message::Request(request) => request,
+            _ => panic!("actual INFO request"),
+        };
+        assert_eq!(request.method(), Method::Info);
+        assert_eq!(
+            request.body(),
+            format!(
+                "Signal={}\r\nDuration={}\r\n",
+                info.digits.as_bytes()[info.digit_index] as char,
+                info.duration_ms
+            )
+            .as_bytes()
+        );
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        let guard = self.permission.clone().read_owned().await;
+        if !*guard {
+            return Err(DtmfWriteError::Refused);
+        }
+        self.facts.lock().unwrap().push((
+            info.digit_index,
+            info.wire_request.to_vec(),
+            info.destination,
+        ));
+        DtmfWriteLease::new(guard, Instant::now() + Duration::from_millis(200), || true).with_fence(
+            Arc::new(IoTime {
+                digit: info.digit_index,
+                times: self.io_times.clone(),
+            }),
+        )
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_core_info_routes_exact_source_recipient_original_operation_and_body() {
+    let mut r = Rig::new().await;
+    let p = Policy::new(&r);
+    let route = r.route("5#", 160);
+    let mut send = r.sending(
+        route,
+        p.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(3),
+    );
+    let first = tokio::select! {biased; first=r.target_peer.next()=>first, result=&mut send=>panic!("route ended before first INFO: {result:?}")};
+    assert_eq!(
+        first.request.uri.to_string(),
+        format!("sip:wire-target@{}", r.target_peer.address()),
+        "INFO must use the actual dialog Contact while To retains the remote identity"
+    );
+    assert_eq!(
+        first.request.to().unwrap().address().uri.to_string(),
+        format!("sip:peer@{}", r.target_peer.address())
+    );
+    let second = tokio::select! {biased; second=r.target_peer.next()=>second, result=&mut send=>panic!("route ended before second INFO: {result:?}")};
+    assert_eq!(send.await.unwrap(), Ok(()));
+    assert_ne!(
+        first.request.cseq().unwrap().seq,
+        second.request.cseq().unwrap().seq
+    );
+    assert_eq!(first.request.call_id(), second.request.call_id());
+    assert_eq!(first.request.body(), b"Signal=5\r\nDuration=160\r\n");
+    assert_eq!(second.request.body(), b"Signal=#\r\nDuration=160\r\n");
+    let facts = p.facts.lock().unwrap().clone();
+    assert_eq!(
+        facts,
+        vec![
+            (0, first.bytes, r.target_peer.address()),
+            (1, second.bytes, r.target_peer.address())
+        ]
+    );
+    assert_eq!(p.calls.load(Ordering::Acquire), 2);
+    r.source_peer.no_info(Duration::from_millis(60)).await;
+    r.target_peer.no_rtp_tone().await;
+    r.stop().await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_refuses_independent_permission_and_invalid_whole_intent_without_raw_fallback()
+{
+    let mut r = Rig::new().await;
+    let p = Policy::new(&r);
+    *p.permission.write().await = false;
+    assert_eq!(
+        r.core
+            .route_dtmf(
+                &r.route("56", 160),
+                p.clone(),
+                CancellationToken::new(),
+                Instant::now() + Duration::from_secs(2)
+            )
+            .await,
+        Err(DtmfWriteError::Refused)
+    );
+    for (digits, duration) in [("5X", 160), ("5", 99), ("5", 5001)] {
+        assert!(DtmfIntent::new(
+            "original-info-operation".into(),
+            digits.into(),
+            duration,
+            DtmfMethod::Info
+        )
+        .is_err());
+    }
+    assert_eq!(
+        ConnectionAdapter::send_dtmf_info_authorized(
+            r.adapter.as_ref(),
+            ConnectionId::new(),
+            "5",
+            160,
+            Arc::new(DenyInfo),
+            Instant::now() + Duration::from_secs(1)
+        )
+        .await,
+        Err(DtmfWriteError::Refused)
+    );
+    r.target_peer.no_info(Duration::from_millis(120)).await;
+    assert_eq!(p.calls.load(Ordering::Acquire), 1);
+    r.target_peer.no_rtp_tone().await;
+    r.stop().await;
+}
+struct DenyInfo;
+#[async_trait]
+impl DtmfInfoWriteAuthority for DenyInfo {}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_transport_retry_reacquires_permission_and_preserves_exact_transaction() {
+    let mut r = Rig::new().await;
+    r.target_peer.reply.store(0, Ordering::Release);
+    let p = Policy::new(&r);
+    let send = r.sending(
+        r.route("5", 160),
+        p.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(3),
+    );
+    let first = r.target_peer.next().await;
+    let writer = timeout(Duration::from_millis(100), p.permission.write())
+        .await
+        .expect("idle transaction retained host reader");
+    drop(writer);
+    let second = r.target_peer.next().await;
+    assert_eq!(first.bytes, second.bytes);
+    r.target_peer.respond(&second).await;
+    assert_eq!(send.await.unwrap(), Ok(()));
+    assert_eq!(p.calls.load(Ordering::Acquire), 2);
+    r.stop().await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_revocation_between_timer_e_writes_stops_retransmission() {
+    let mut r = Rig::new().await;
+    r.target_peer.reply.store(0, Ordering::Release);
+    let p = Policy::new(&r);
+    let send = r.sending(
+        r.route("56", 160),
+        p.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(3),
+    );
+    r.target_peer.next().await;
+    *timeout(Duration::from_millis(100), p.permission.write())
+        .await
+        .expect("idle transaction retained reader") = false;
+    assert_eq!(
+        timeout(Duration::from_secs(2), send)
+            .await
+            .unwrap()
+            .unwrap(),
+        Err(DtmfWriteError::OutcomeUnknown)
+    );
+    r.target_peer.no_info(Duration::from_millis(150)).await;
+    assert_eq!(p.calls.load(Ordering::Acquire), 2);
+    r.stop().await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_revocation_between_digits_stops_suffix_under_original_operation() {
+    let mut r = Rig::new().await;
+    let p = Policy::new(&r);
+    let send = r.sending(
+        r.route("56", 300),
