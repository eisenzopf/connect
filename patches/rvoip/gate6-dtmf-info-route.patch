+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_drop_cancel_deadline_and_source_retirement_stop_pending_transaction() {
+    for mode in ["drop", "cancel", "deadline", "retire"] {
+        let mut r = Rig::new().await;
+        r.target_peer.reply.store(0, Ordering::Release);
+        let p = Policy::new(&r);
+        let token = CancellationToken::new();
+        let route = r.route("56", 160);
+        let deadline = Instant::now()
+            + if mode == "deadline" {
+                Duration::from_millis(160)
+            } else {
+                Duration::from_secs(3)
+            };
+        let send = r.sending(route.clone(), p.clone(), token.clone(), deadline);
+        r.target_peer.next().await;
+        assert_eq!(
+            r.core
+                .route_dtmf(
+                    &route,
+                    p.clone(),
+                    CancellationToken::new(),
+                    Instant::now() + Duration::from_secs(1)
+                )
+                .await,
+            Err(DtmfWriteError::NotReady)
+        );
+        match mode {
+            "drop" => {
+                send.abort();
+                assert!(send.await.unwrap_err().is_cancelled());
+            }
+            "cancel" => {
+                token.cancel();
+                assert_eq!(send.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown));
+            }
+            "deadline" => assert_eq!(send.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown)),
+            "retire" => {
+                r.core
+                    .end_connection(r.source.clone(), EndReason::Normal)
+                    .await
+                    .unwrap();
+                assert_eq!(send.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown));
+                assert_eq!(
+                    r.core.session(&r.sid).unwrap().read().unwrap().state,
+                    rvoip_core::session::SessionState::Active
+                );
+            }
+            _ => unreachable!(),
+        }
+        let writer = p
+            .permission
+            .try_write()
+            .expect("ended transaction retained host permission");
+        drop(writer);
+        r.target_peer.no_info(Duration::from_millis(750)).await;
+        assert_eq!(p.calls.load(Ordering::Acquire), 1);
+        r.target_peer.no_rtp_tone().await;
+        r.stop().await;
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_401_stops_sequence_and_never_replays_a_challenged_effect() {
+    let mut r = Rig::new().await;
+    r.target_peer.reply.store(401, Ordering::Release);
+    let p = Policy::new(&r);
+    let send = r.sending(
+        r.route("56", 160),
+        p.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(3),
+    );
+    r.target_peer.next().await;
+    assert_eq!(send.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown));
+    r.target_peer.no_info(Duration::from_millis(750)).await;
+    assert_eq!(p.calls.load(Ordering::Acquire), 1);
+    let sessions = r.coordinator.list_sessions().await;
+    let target = sessions
+        .iter()
+        .find(|s| s.to.contains(&r.target_peer.address().to_string()))
+        .expect("actual challenged target session");
+    assert_eq!(
+        target.state,
+        rvoip_sip::types::CallState::Active,
+        "unowned INFO challenge mutated the session authentication state"
+    );
+    r.target_peer.reply.store(200, Ordering::Release);
+    let fresh = r
+        .core
+        .prepare_dtmf_route(
+            r.source.clone(),
+            r.target.clone(),
+            DtmfIntent::new(
+                "fresh-info-operation".into(),
+                "9".into(),
+                160,
+                DtmfMethod::Info,
+            )
+            .unwrap(),
+        )
+        .unwrap();
+    let fresh_policy = Policy::for_operation(&r, "fresh-info-operation");
+    let sending = r.sending(
+        fresh,
+        fresh_policy.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(2),
+    );
+    let info = r.target_peer.next().await;
+    assert_eq!(info.request.body(), b"Signal=9\r\nDuration=160\r\n");
+    assert_eq!(sending.await.unwrap(), Ok(()));
+    assert_eq!(fresh_policy.calls.load(Ordering::Acquire), 1);
+    r.stop().await;
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_retransmission_preserves_quiet_time_before_the_next_digit() {
+    let mut r = Rig::new().await;
+    r.target_peer.reply.store(0, Ordering::Release);
+    let policy = Policy::new(&r);
+    let sending = r.sending(
+        r.route("56", 160),
+        policy.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(3),
+    );
+    let original = r.target_peer.next().await;
+    let retry = r.target_peer.next().await;
+    assert_eq!(original.bytes, retry.bytes);
+    r.target_peer.respond(&retry).await;
+    // If the original datagram was lost, the peer can first act on this
+    // retransmission. A delayed response cannot collapse the requested tone
+    // duration and gap before the next digit. No remote playout is inferred.
+    r.target_peer.no_info(Duration::from_millis(100)).await;
+    let second = r.target_peer.next().await;
+    assert_eq!(second.request.body(), b"Signal=6\r\nDuration=160\r\n");
+    r.target_peer.respond(&second).await;
+    assert_eq!(sending.await.unwrap(), Ok(()));
+    assert_eq!(policy.calls.load(Ordering::Acquire), 3);
+    let indices: Vec<_> = policy.facts.lock().unwrap().iter().map(|f| f.0).collect();
+    assert_eq!(indices, vec![0, 0, 1]);
+    let times = policy.io_times.lock().unwrap().clone();
+    assert_eq!(
+        times.iter().map(|entry| entry.0).collect::<Vec<_>>(),
+        vec![0, 0, 1]
+    );
+    let interval = times[2].1.duration_since(times[1].1);
+    assert!(interval>=Duration::from_millis(228),"local successful UDP submissions collapsed160ms tone +70ms gap (2ms clock tolerance): {interval:?}");
+    r.stop().await;
+}
