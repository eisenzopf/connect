@@ -0,0 +1,512 @@
+//! Fenced, process-local participant transitions for a single live Session.
+//!
+//! The owner serializes access and supplies CURRENT authoritative Membership
+//! and EndpointBinding values after checking caller permission. Roles never
+//! grant authority here. These values do not perform adapter I/O, persist an
+//! operation, or replace Connect's journal. Commit the returned route changes
+//! through the owning media coordinator before publishing public observations.
+
+use crate::ids::{ConnectionId, ConversationId, IdentityId, ParticipantId, SessionId, TenantId};
+use crate::participant::ParticipantRole;
+use crate::relationships::{
+    ConnectionBinding, EndpointBinding, Membership, RelationshipError, SessionAppearance,
+};
+use std::collections::{BTreeMap, HashMap, HashSet};
+
+const MAX_REVISION: u64 = 9_007_199_254_740_991;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum ParticipantTransitionError {
+    #[error("invalid participant transition")]
+    Invalid,
+    #[error("participant transition conflicts with current state")]
+    Conflict,
+    #[error("participant transition requires current membership")]
+    Inactive,
+    #[error("participant transition crosses an ownership boundary")]
+    OwnerMismatch,
+    #[error("participant connection is not ready")]
+    NotReady,
+    #[error("participant transition capacity exhausted")]
+    Capacity,
+    #[error("session has ended")]
+    Ended,
+}
+
+impl From<RelationshipError> for ParticipantTransitionError {
+    fn from(value: RelationshipError) -> Self {
+        match value {
+            RelationshipError::InvalidValue => Self::Invalid,
+            RelationshipError::Conflict => Self::Conflict,
+            RelationshipError::Inactive => Self::Inactive,
+            RelationshipError::OwnerMismatch => Self::OwnerMismatch,
+            RelationshipError::NotReady => Self::NotReady,
+        }
+    }
+}
+
+type Result<T> = std::result::Result<T, ParticipantTransitionError>;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DepartureCause {
+    Left,
+    Removed,
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub enum ParticipantChange {
+    Admit {
+        connection: ConnectionId,
+        role_override: Option<ParticipantRole>,
+    },
+    Depart {
+        cause: DepartureCause,
+    },
+    SetSessionRole {
+        role: ParticipantRole,
+    },
+}
+
+/// Session/tenant are supplied by this controller, actor by current authority.
+/// Correlation is observation metadata; changing it on a retry does not change
+/// business intent or rewrite the original observation.
+#[derive(Clone)]
+pub struct ParticipantMutation {
+    pub operation_id: String,
+    pub correlation_id: String,
+    pub expected_revision: u64,
+    pub participant: ParticipantId,
+    pub change: ParticipantChange,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ParticipantObservationKind {
+    Joined,
+    ConnectionAdded,
+    Left,
+    Removed,
+    RoleChanged,
+}
+
+/// A committed local topology observation, not a provider/media completion.
+#[derive(Clone, PartialEq, Eq)]
+pub struct ParticipantObservation {
+    pub session: SessionId,
+    pub participant: ParticipantId,
+    pub membership_epoch: u64,
+    pub revision: u64,
+    pub operation_id: String,
+    pub correlation_id: String,
+    pub kind: ParticipantObservationKind,
+    pub role: ParticipantRole,
+    pub admitted: Vec<ConnectionId>,
+    pub retired: Vec<ConnectionId>,
+}
+
+#[derive(Clone)]
+struct Presence {
+    appearance: SessionAppearance,
+    identity: IdentityId,
+    connections: BTreeMap<ConnectionId, ConnectionBinding>,
+}
+
+#[derive(Clone)]
+struct Receipt {
+    actor_identity: IdentityId,
+    actor_participant: ParticipantId,
+    actor_epoch: u64,
+    target_identity: IdentityId,
+    intent: ParticipantMutation,
+    observation: ParticipantObservation,
+}
+
+/// A negotiation ticket is bound to the Session revision, target membership
+/// revision/epoch, role and exact connection generation. A failed commit never
+/// retires an already admitted connection.
+pub struct PreparedParticipantAdmission {
+    revision: u64,
+    membership_revision: u64,
+    appearance: SessionAppearance,
+    connection: ConnectionBinding,
+}
+
+impl PreparedParticipantAdmission {
+    pub fn generation(&self) -> u64 {
+        self.connection.generation()
+    }
+
+    /// Trusted media adapter calls this only after negotiated ingress/egress
+    /// and configured endpoint confirmation. Signaling acceptance is not proof.
+    pub fn observe_ready(
+        &mut self,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        generation: u64,
+    ) -> Result<()> {
+        self.connection
+            .observe_ready(member, &self.appearance, endpoint, generation)?;
+        Ok(())
+    }
+}
+
+/// Pure engine state. Keep this within the same serialized/transactional owner
+/// as its authoritative Session. Bounds retain operation and connection ID
+/// tombstones; exhausting them refuses NEW work rather than evicting retry
+/// protection. End this controller and its owning Session together.
+pub struct ParticipantSession {
+    tenant: TenantId,
+    conversation: ConversationId,
+    session: SessionId,
+    revision: u64,
+    ended: bool,
+    max_participants: usize,
+    max_connections: usize,
+    max_operations: usize,
+    participants: BTreeMap<ParticipantId, Presence>,
+    used_connections: HashSet<ConnectionId>,
+    receipts: HashMap<(ParticipantId, String), Receipt>,
+}
+
+fn identifier(value: &str) -> Result<()> {
+    if value.is_empty()
+        || value.len() > 128
+        || !value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+    {
+        return Err(ParticipantTransitionError::Invalid);
+    }
+    Ok(())
+}
+
+impl ParticipantSession {
+    pub fn new(
+        tenant: TenantId,
+        conversation: ConversationId,
+        session: SessionId,
+        max_participants: usize,
+        max_connections: usize,
+        max_operations: usize,
+    ) -> Result<Self> {
+        identifier(tenant.as_str())?;
+        identifier(conversation.as_str())?;
+        identifier(session.as_str())?;
+        if max_participants == 0 || max_connections == 0 || max_operations == 0 {
+            return Err(ParticipantTransitionError::Invalid);
+        }
+        Ok(Self {
+            tenant,
+            conversation,
+            session,
+            revision: 1,
+            ended: false,
+            max_participants,
+            max_connections,
+            max_operations,
+            participants: BTreeMap::new(),
+            used_connections: HashSet::new(),
+            receipts: HashMap::new(),
+        })
+    }
+
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn participant_count(&self) -> usize {
+        self.participants.len()
+    }
+    pub fn connection_count(&self) -> usize {
+        self.participants
+            .values()
+            .map(|p| p.connections.len())
+            .sum()
+    }
+    pub fn role(&self, participant: &ParticipantId) -> Option<&ParticipantRole> {
+        self.participants
+            .get(participant)
+            .map(|p| p.appearance.role())
+    }
+    pub fn connections(&self, participant: &ParticipantId) -> Vec<ConnectionId> {
+        self.participants
+            .get(participant)
+            .map(|p| p.connections.keys().cloned().collect())
+            .unwrap_or_default()
+    }
+
+    fn check_member(&self, member: &Membership, active: bool) -> Result<()> {
+        if member.tenant() != &self.tenant || member.conversation() != &self.conversation {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        if active && !member.is_active() {
+            return Err(ParticipantTransitionError::Inactive);
+        }
+        Ok(())
+    }
+
+    fn check_presence(&self, member: &Membership, presence: &Presence) -> Result<()> {
+        if presence.identity != *member.identity()
+            || presence.appearance.membership_epoch() != member.epoch()
+        {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        Ok(())
+    }
+
+    pub fn prepare_admission(
+        &self,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        connection: ConnectionId,
+        role_override: Option<ParticipantRole>,
+    ) -> Result<PreparedParticipantAdmission> {
+        self.check_member(member, true)?;
+        if self.ended {
+            return Err(ParticipantTransitionError::Ended);
+        }
+        self.check_admission_capacity(member.participant(), &connection)?;
+        let appearance = match self.participants.get(member.participant()) {
+            Some(presence) => {
+                presence.appearance.require_current(member)?;
+                if role_override
+                    .as_ref()
+                    .is_some_and(|r| r != presence.appearance.role())
+                {
+                    return Err(ParticipantTransitionError::Conflict);
+                }
+                presence.appearance.clone()
+            }
+            None => SessionAppearance::admit(member, self.session.clone(), role_override)?,
+        };
+        let binding = ConnectionBinding::prepare(member, &appearance, endpoint, connection)?;
+        Ok(PreparedParticipantAdmission {
+            revision: self.revision,
+            membership_revision: member.revision(),
+            appearance,
+            connection: binding,
+        })
+    }
+
+    fn check_admission_capacity(
+        &self,
+        participant: &ParticipantId,
+        connection: &ConnectionId,
+    ) -> Result<()> {
+        if self.used_connections.contains(connection) {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if (!self.participants.contains_key(participant)
+            && self.participants.len() >= self.max_participants)
+            || self.connection_count() >= self.max_connections
+            || self.used_connections.len() >= self.max_operations
+        {
+            return Err(ParticipantTransitionError::Capacity);
+        }
+        Ok(())
+    }
+
+    /// Invoke after current application authorization, under the owning
+    /// Session's mutation lock/transaction. Replays recheck current actor and
+    /// target membership before returning a retained receipt.
+    pub fn apply(
+        &mut self,
+        actor: &Membership,
+        target: &Membership,
+        mutation: ParticipantMutation,
+        admission: Option<PreparedParticipantAdmission>,
+        endpoint: Option<&EndpointBinding>,
+    ) -> Result<ParticipantObservation> {
+        identifier(&mutation.operation_id)?;
+        identifier(&mutation.correlation_id)?;
+        self.check_member(actor, true)?;
+        let removed = matches!(
+            mutation.change,
+            ParticipantChange::Depart {
+                cause: DepartureCause::Removed
+            }
+        );
+        self.check_member(target, !removed)?;
+        if target.participant() != &mutation.participant {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        let key = (actor.participant().clone(), mutation.operation_id.clone());
+        if let Some(receipt) = self.receipts.get(&key) {
+            if receipt.actor_identity != *actor.identity()
+                || receipt.actor_epoch != actor.epoch()
+                || receipt.actor_participant != *actor.participant()
+                || receipt.target_identity != *target.identity()
+                || receipt.observation.membership_epoch != target.epoch()
+            {
+                return Err(ParticipantTransitionError::OwnerMismatch);
+            }
+            if receipt.intent.expected_revision != mutation.expected_revision
+                || receipt.intent.participant != mutation.participant
+                || receipt.intent.change != mutation.change
+            {
+                return Err(ParticipantTransitionError::Conflict);
+            }
+            return Ok(receipt.observation.clone());
+        }
+        if self.ended {
+            return Err(ParticipantTransitionError::Ended);
+        }
+        if self.revision != mutation.expected_revision || self.revision >= MAX_REVISION {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if self.receipts.len() >= self.max_operations {
+            return Err(ParticipantTransitionError::Capacity);
+        }
+        let revision = self.revision + 1;
+        let (kind, role, admitted, retired) = match &mutation.change {
+            ParticipantChange::Admit {
+                connection,
+                role_override,
+            } => {
+                self.check_admission_capacity(target.participant(), connection)?;
+                let mut ready = admission.ok_or(ParticipantTransitionError::NotReady)?;
+                let endpoint = endpoint.ok_or(ParticipantTransitionError::NotReady)?;
+                if ready.revision != self.revision
+                    || ready.membership_revision != target.revision()
+                    || ready.appearance.session() != &self.session
+                    || ready.connection.connection() != connection
+                {
+                    return Err(ParticipantTransitionError::Conflict);
+                }
+                ready.appearance.require_current(target)?;
+                let expected_role = role_override.as_ref().unwrap_or_else(|| {
+                    self.role(target.participant())
+                        .unwrap_or_else(|| target.default_role())
+                });
+                if ready.appearance.role() != expected_role {
+                    return Err(ParticipantTransitionError::Conflict);
+                }
+                // Rechecks the CURRENT endpoint, not the preparation snapshot.
+                ready
+                    .connection
+                    .activate(target, &ready.appearance, endpoint)?;
+                let role = ready.appearance.role().clone();
+                let joining = !self.participants.contains_key(target.participant());
+                let presence = self
+                    .participants
+                    .entry(target.participant().clone())
+                    .or_insert_with(|| Presence {
+                        appearance: ready.appearance,
+                        identity: target.identity().clone(),
+                        connections: BTreeMap::new(),
+                    });
+                presence
+                    .connections
+                    .insert(connection.clone(), ready.connection);
+                self.used_connections.insert(connection.clone());
+                (
+                    if joining {
+                        ParticipantObservationKind::Joined
+                    } else {
+                        ParticipantObservationKind::ConnectionAdded
+                    },
+                    role,
+                    vec![connection.clone()],
+                    vec![],
+                )
+            }
+            ParticipantChange::Depart { cause } => {
+                let presence = self
+                    .participants
+                    .get(target.participant())
+                    .ok_or(ParticipantTransitionError::Inactive)?;
+                self.check_presence(target, presence)?;
+                let role = presence.appearance.role().clone();
+                let retired = presence.connections.keys().cloned().collect();
+                self.participants.remove(target.participant());
+                (
+                    if *cause == DepartureCause::Left {
+                        ParticipantObservationKind::Left
+                    } else {
+                        ParticipantObservationKind::Removed
+                    },
+                    role,
+                    vec![],
+                    retired,
+                )
+            }
+            ParticipantChange::SetSessionRole { role } => {
+                let presence = self
+                    .participants
+                    .get(target.participant())
+                    .ok_or(ParticipantTransitionError::Inactive)?;
+                let mut appearance = presence.appearance.clone();
+                appearance.change_role(target, appearance.revision(), role.clone())?;
+                self.participants
+                    .get_mut(target.participant())
+                    .expect("checked presence")
+                    .appearance = appearance;
+                (
+                    ParticipantObservationKind::RoleChanged,
+                    role.clone(),
+                    vec![],
+                    vec![],
+                )
+            }
+        };
+        self.revision = revision;
+        let observation = ParticipantObservation {
+            session: self.session.clone(),
+            participant: target.participant().clone(),
+            membership_epoch: target.epoch(),
+            revision,
+            operation_id: mutation.operation_id.clone(),
+            correlation_id: mutation.correlation_id.clone(),
+            kind,
+            role,
+            admitted,
+            retired,
+        };
+        self.receipts.insert(
+            key,
+            Receipt {
+                actor_identity: actor.identity().clone(),
+                actor_participant: actor.participant().clone(),
+                actor_epoch: actor.epoch(),
+                target_identity: target.identity().clone(),
+                intent: mutation,
+                observation: observation.clone(),
+            },
+        );
+        Ok(observation)
+    }
+
+    /// Explicit end fences all negotiation tickets and returns only this
+    /// Session's admitted route IDs. It never changes Conversation membership.
+    pub fn end(&mut self, expected_revision: u64) -> Result<Vec<ConnectionId>> {
+        if self.revision != expected_revision || self.revision >= MAX_REVISION {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if self.ended {
+            return Ok(vec![]);
+        }
+        let routes = self
+            .participants
+            .values()
+            .flat_map(|p| p.connections.keys().cloned())
+            .collect();
+        self.participants.clear();
+        self.revision += 1;
+        self.ended = true;
+        Ok(routes)
+    }
+}
+
+macro_rules! redacted_debug {
+    ($($name:ty),*) => { $(impl std::fmt::Debug for $name {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str(concat!(stringify!($name), "(redacted)")) }
+    })* };
+}
+redacted_debug!(
+    ParticipantSession,
+    PreparedParticipantAdmission,
+    ParticipantChange,
+    ParticipantMutation,
+    ParticipantObservation
+);
+
+#[cfg(test)]
+mod tests;
