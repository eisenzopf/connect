+#[test]
+fn competing_changes_with_same_revision_have_exactly_one_winner() {
+    let mut s = session("sess_test");
+    let (m, b) = member("tenant_test", "alice");
+    let ep = endpoint(&b, "alice");
+    join(&mut s, &m, &ep, "conn_alice");
+    let commands = [
+        mutation(
+            &s,
+            &m,
+            "role_a",
+            ParticipantChange::SetSessionRole {
+                role: ParticipantRole::Observer,
+            },
+        ),
+        mutation(
+            &s,
+            &m,
+            "role_b",
+            ParticipantChange::SetSessionRole {
+                role: ParticipantRole::Supervisor,
+            },
+        ),
+    ];
+    let state = Arc::new(Mutex::new(s));
+    let barrier = Arc::new(Barrier::new(3));
+    let threads: Vec<_> = commands
+        .into_iter()
+        .map(|command| {
+            let state = state.clone();
+            let barrier = barrier.clone();
+            let m = m.clone();
+            std::thread::spawn(move || {
+                barrier.wait();
+                state.lock().unwrap().apply(&m, &m, command, None, None)
+            })
+        })
+        .collect();
+    barrier.wait();
+    let results: Vec<_> = threads.into_iter().map(|t| t.join().unwrap()).collect();
+    assert_eq!(results.iter().filter(|r| r.is_ok()).count(), 1);
+    assert_eq!(
+        results
+            .iter()
+            .filter(|r| matches!(r, Err(ParticipantTransitionError::Conflict)))
+            .count(),
+        1
+    );
+    assert_eq!(state.lock().unwrap().revision(), 3);
+}
