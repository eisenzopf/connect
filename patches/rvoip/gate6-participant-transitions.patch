+use super::*;
+use crate::{
+    connection::Transport,
+    identity::{AuthenticatedPrincipal, AuthenticationMethod, IdentityAssurance},
+    ids::{DeviceId, EndpointId},
+    participant::ParticipantKind,
+    relationships::IdentityBinding,
+};
+use chrono::Utc;
+use std::sync::{Arc, Barrier, Mutex};
+
+fn member(tenant: &str, name: &str) -> (Membership, IdentityBinding) {
+    let principal = AuthenticatedPrincipal {
+        subject: name.into(),
+        tenant: Some(tenant.into()),
+        scopes: vec![],
+        issuer: None,
+        expires_at: None,
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Anonymous,
+    };
+    let binding = IdentityBinding::from_authenticated(
+        &principal,
+        IdentityId::from_string(format!("id_{name}")),
+        Utc::now(),
+    )
+    .unwrap();
+    let membership = Membership::admit(
+        binding.clone(),
+        ConversationId::from_string("conv_test"),
+        ParticipantId::from_string(format!("part_{name}")),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+    )
+    .unwrap();
+    (membership, binding)
+}
+fn endpoint(binding: &IdentityBinding, name: &str) -> EndpointBinding {
+    let mut ep = EndpointBinding::provision(
+        binding.clone(),
+        EndpointId::from_string(format!("ep_{name}")),
+        DeviceId::from_string(format!("dev_{name}")),
+        Transport::WebRtc,
+        "private:canary-address".into(),
+    )
+    .unwrap();
+    ep.verify(binding, "proof_test".into(), Utc::now()).unwrap();
+    ep
+}
+fn session(name: &str) -> ParticipantSession {
+    ParticipantSession::new(
+        TenantId::from_string("tenant_test"),
+        ConversationId::from_string("conv_test"),
+        SessionId::from_string(name),
+        4,
+        6,
+        64,
+    )
+    .unwrap()
+}
+fn mutation(
+    s: &ParticipantSession,
+    member: &Membership,
+    op: &str,
+    change: ParticipantChange,
+) -> ParticipantMutation {
+    ParticipantMutation {
+        operation_id: op.into(),
+        correlation_id: format!("corr_{op}"),
+        expected_revision: s.revision(),
+        participant: member.participant().clone(),
+        change,
+    }
+}
+fn prepare(
+    s: &ParticipantSession,
+    member: &Membership,
+    ep: &EndpointBinding,
+    conn: &str,
+) -> PreparedParticipantAdmission {
+    let mut ticket = s
+        .prepare_admission(member, ep, ConnectionId::from_string(conn), None)
+        .unwrap();
+    ticket
+        .observe_ready(member, ep, ticket.generation())
+        .unwrap();
+    ticket
+}
+fn join(
+    s: &mut ParticipantSession,
+    member: &Membership,
+    ep: &EndpointBinding,
+    conn: &str,
+) -> ParticipantObservation {
+    let ticket = prepare(s, member, ep, conn);
+    let intent = mutation(
+        s,
+        member,
+        &format!("join_{conn}"),
+        ParticipantChange::Admit {
+            connection: ConnectionId::from_string(conn),
+            role_override: None,
+        },
+    );
+    s.apply(member, member, intent, Some(ticket), Some(ep))
+        .unwrap()
+}
+
+#[test]
+fn four_participants_six_connections_departure_retires_only_target_routes() {
+    let mut s = session("sess_test");
+    let mut members = vec![];
+    for name in ["alice", "bob", "carol", "dave"] {
+        let (m, b) = member("tenant_test", name);
+        let ep = endpoint(&b, name);
+        let result = join(&mut s, &m, &ep, &format!("conn_{name}"));
+        assert_eq!(result.kind, ParticipantObservationKind::Joined);
+        members.push((m, ep));
+    }
+    for (index, (m, ep)) in members.iter().take(2).enumerate() {
+        assert_eq!(
+            join(&mut s, m, ep, &format!("conn_extra_{index}")).kind,
+            ParticipantObservationKind::ConnectionAdded
+        );
+    }
+    assert_eq!((s.participant_count(), s.connection_count()), (4, 6));
+    let (alice, _) = &members[0];
+    let intent = mutation(
+        &s,
+        alice,
+        "leave_alice",
+        ParticipantChange::Depart {
+            cause: DepartureCause::Left,
+        },
+    );
+    let result = s.apply(alice, alice, intent, None, None).unwrap();
