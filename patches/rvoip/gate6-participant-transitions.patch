+#[tokio::test]
+async fn leave_one_session_preserves_other_presence_and_replay_has_no_event() {
+    let orch = Orchestrator::new(Config::default());
+    let cid = orch
+        .open_conversation(
+            TenantId::new(),
+            ConversationPolicy::default(),
+            HashMap::new(),
+        )
+        .await
+        .unwrap();
+    let first = orch
+        .start_session(cid.clone(), SessionMedium::Voice, vec![])
+        .await
+        .unwrap();
+    let other = orch
+        .start_session(cid.clone(), SessionMedium::Voice, vec![])
+        .await
+        .unwrap();
+    let participant = ParticipantId::new();
+    for sid in [&first, &other] {
+        orch.join_session(
+            sid.clone(),
+            participant.clone(),
+            ParticipantKind::Human,
+            ParticipantRole::Agent,
+        )
+        .await
+        .unwrap();
+    }
+    let mut events = orch.subscribe_events();
+    orch.leave_session(first.clone(), participant.clone())
+        .await
+        .unwrap();
+    assert!(
+        matches!(next_event(&mut events).await, Event::ParticipantLeft { session_id, .. } if session_id == first)
+    );
+    orch.leave_session(first.clone(), participant.clone())
+        .await
+        .unwrap();
+    assert!(matches!(
+        events.try_recv(),
+        Err(tokio::sync::broadcast::error::TryRecvError::Empty)
+    ));
+    assert!(!orch
+        .session(&first)
+        .unwrap()
+        .read()
+        .unwrap()
+        .participants
+        .contains(&participant));
+    let other = orch.session(&other).unwrap();
+    let other = other.read().unwrap();
+    assert!(other.participants.contains(&participant));
+    assert_eq!(other.state, SessionState::Active);
+    let conversation = orch.conversation(&cid).unwrap();
+    let conversation = conversation.read().unwrap();
+    let member = conversation
+        .participants
+        .iter()
+        .find(|p| p.id == participant)
+        .unwrap();
+    assert!(member.left_at.is_none());
+    assert_eq!(member.role, ParticipantRole::Agent);
+}
