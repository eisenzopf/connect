+struct RecordingStore {
+    unavailable: AtomicBool,
+    inner: InMemorySignatureReplayStore,
+    accepted: AtomicUsize,
+}
+#[async_trait]
+impl SignatureReplayStore for RecordingStore {
+    async fn consume(
+        &self,
+        c: &SignatureVerificationContext,
+        id: &str,
+        expiry: chrono::DateTime<Utc>,
+        now: chrono::DateTime<Utc>,
+    ) -> Result<(), ReplayConsumeError> {
+        if self.unavailable.load(Ordering::SeqCst) {
+            return Err(ReplayConsumeError::Unavailable);
+        }
+        let result = self.inner.consume(c, id, expiry, now).await;
+        if result.is_ok() {
+            self.accepted.fetch_add(1, Ordering::SeqCst);
+        }
+        result
+    }
+}
