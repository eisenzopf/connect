+/// Minimal correlation only: deferred failures retain no credentials, body or
+/// arbitrary signed extensions. Exactly one slot exists per physical peer.
+pub(super) struct FailureRecord {
+    original: Value,
+    response: Value,
+    execution_started: bool,
+}
+struct FailureGuard {
+    record: Option<FailureRecord>,
+    slot: Arc<parking_lot::Mutex<Option<FailureRecord>>>,
+    lifetime: CancellationToken,
+    execution_started: bool,
+}
+impl FailureGuard {
+    fn new(
+        original: &Envelope,
+        response: &Envelope,
+        slot: Arc<parking_lot::Mutex<Option<FailureRecord>>>,
+        lifetime: CancellationToken,
+    ) -> Self {
+        Self {
+            record: Some(FailureRecord {
+                original: correlation(original),
+                response: correlation(response),
+                execution_started: false,
+            }),
+            slot,
+            lifetime,
+            execution_started: false,
+        }
+    }
+}
+impl Drop for FailureGuard {
+    fn drop(&mut self) {
+        let Some(mut record) = self.record.take() else {
+            return;
+        };
+        if self.lifetime.is_cancelled() {
+            return;
+        }
+        record.execution_started = self.execution_started;
+        let mut slot = self.slot.lock();
+        if slot.is_some() {
+            self.lifetime.cancel();
+            return;
+        }
+        *slot = Some(record);
+    }
+}
+fn correlation(envelope: &Envelope) -> Value {
+    let mut value = json!({"in_reply_to":envelope.id()});
+    for name in ["cid", "sid", "connid", "operation_id"] {
+        if let Some(item) = envelope.original().get(name) {
+            value[name] = item.clone();
+        }
+    }
+    value
+}
+impl CanonicalPeer {
+    /// Drive after an error or cancellation when using `handle` directly. `run`
+    /// drains this bounded slot automatically before accepting another frame.
+    /// A validation failure is definitive; interruption after execution starts
+    /// is explicitly unknown and must be reconciled under the logical ID.
+    pub fn drain_step_up_failures(&self) -> Result<Option<PeerOutput>, DispatchError> {
+        let Some(record) = self.step_up_failure.lock().take() else {
+            return Ok(None);
+        };
+        if self.lifetime.is_cancelled() || self.effective_deadline() <= Instant::now() {
+            return Ok(None);
+        }
+        let (code, reason) = if record.execution_started {
+            (409, "operation_interrupted")
+        } else {
+            (403, "assurance_not_established")
+        };
+        let mut original = json!({"v":2,"type":"error","id":fresh_id(),"ts":chrono::Utc::now(),"payload":{"code":code,"category":"auth","reason":reason}});
+        if record.execution_started {
+            original["payload"]["details"] = json!({"outcome":"unknown"});
+        }
+        let mut response = json!({"v":2,"type":"error","id":fresh_id(),"ts":chrono::Utc::now(),"payload":{"code":if record.execution_started {408}else{401},"category":"auth","reason":if record.execution_started {"step_up_interrupted"}else{"step_up_failed"}}});
+        original
+            .as_object_mut()
+            .expect("object")
+            .extend(record.original.as_object().expect("correlation").clone());
+        response
+            .as_object_mut()
+            .expect("object")
+            .extend(record.response.as_object().expect("correlation").clone());
+        Ok(Some(output(
+            vec![self.signed(original)?, self.signed(response)?],
+            None,
+        )))
+    }
+}
