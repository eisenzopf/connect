+struct UncertainHandler {
+    entered: Notify,
+    release: Notify,
+    effects: AtomicUsize,
+}
+#[async_trait]
+impl AuthenticatedHandler for UncertainHandler {
+    async fn handle(&self, _: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        self.effects.fetch_add(1, Ordering::SeqCst);
+        self.entered.notify_one();
+        self.release.notified().await;
+        Envelope::from_value(envelope("ack", json!({}))).map_err(DispatchError::from)
+    }
+}
