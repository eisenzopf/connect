+        .send(Bytes::from(f.sign(request.clone())))
+        .await
+        .unwrap();
+    let challenge = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    let bad = proof(&challenge, "private-secret");
+    writer.send(Bytes::from(f.sign(bad.clone()))).await.unwrap();
+    for (id, code, reason) in [
+        (request["id"].clone(), 403, "assurance_not_established"),
