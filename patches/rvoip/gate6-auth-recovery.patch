@@ -0,0 +1,40 @@
+use super::{auth_dispatch::DispatchError, Identifier};
+use parking_lot::Mutex;
+use std::collections::HashSet;
+
+/// Defense independent of timestamp freshness and external replay-store TTL.
+/// One fence belongs to one physical peer, across refresh and step-up. Signed
+/// IDs remain consumed until that peer is retired. No age/LRU eviction exists.
+pub(super) struct ReplayFence {
+    capacity: usize,
+    ids: Mutex<HashSet<String>>,
+}
+impl ReplayFence {
+    pub(super) const DEFAULT_CAPACITY: usize = 4096;
+    pub(super) fn new(capacity: usize) -> Result<Self, DispatchError> {
+        if capacity == 0 || capacity > Self::DEFAULT_CAPACITY {
+            return Err(DispatchError::Capacity);
+        }
+        Ok(Self {
+            capacity,
+            ids: Mutex::new(HashSet::new()),
+        })
+    }
+    /// Call only after actual signature/freshness verification. The mutex makes
+    /// duplicate lookup and insertion one operation, including under contention.
+    pub(super) fn consume(&self, id: &str) -> Result<(), DispatchError> {
+        Identifier::try_from(id.to_owned())?;
+        let mut ids = self.ids.lock();
+        if ids.contains(id) {
+            return Err(DispatchError::Replay);
+        }
+        if ids.len() >= self.capacity {
+            return Err(DispatchError::ReplayCapacity);
+        }
+        ids.insert(id.to_owned());
+        Ok(())
+    }
+    pub(super) fn usage(&self) -> (usize, usize) {
+        (self.ids.lock().len(), self.capacity)
+    }
+}
