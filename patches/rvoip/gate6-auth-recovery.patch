+        CanonicalPeer::with_replay_capacity(f.config.clone(), CancellationToken::new(), 3).unwrap();
+    f.authenticate(&mut peer, "old").await;
+    let h = AnyHandler::default();
+    let first = command();
+    peer.handle(&f.sign(first.clone()), &h, deadline())
+        .await
+        .unwrap();
+    assert_eq!(
+        peer.handle(&serde_json::to_vec(&command()).unwrap(), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::SignatureRequired
+    );
+    let mut tampered: Value = serde_json::from_slice(&f.sign(command())).unwrap();
+    tampered["tampered"] = json!(true);
+    assert_eq!(
+        peer.handle(&serde_json::to_vec(&tampered).unwrap(), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::Signature
+    );
+    assert_eq!(peer.replay_usage(), (2, 3));
+    peer.handle(&f.sign(command()), &h, deadline())
+        .await
+        .unwrap();
+    assert_eq!(
+        peer.handle(&f.sign(command()), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::ReplayCapacity
+    );
+    assert_eq!(peer.replay_usage(), (3, 3));
+    assert_eq!(h.calls.load(Ordering::SeqCst), 2);
+    f.clock.advance(301);
+    assert_eq!(
+        peer.handle(&f.sign(first), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::Replay
+    );
+    assert_eq!(peer.replay_usage(), (3, 3));
