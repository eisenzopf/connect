+#[tokio::test]
+async fn fresh_signature_after_external_replay_ttl_cannot_reuse_id_in_same_peer() {
+    let f = Fixture::new();
+    f.policy.require_stepup.store(false, Ordering::SeqCst);
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let h = AnyHandler::default();
+    let request = command();
+    assert!(peer
+        .handle(&f.sign(request.clone()), &h, deadline())
+        .await
+        .is_ok());
+    assert_eq!(peer.replay_usage(), (2, 4096));
+    assert_eq!(f.store.accepted.load(Ordering::SeqCst), 2);
+    f.clock.advance(301);
+    assert_eq!(
+        peer.handle(&f.sign(request.clone()), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::Replay
+    );
+    assert_eq!(
+        f.store.accepted.load(Ordering::SeqCst),
+        3,
+        "actual external replay entry expired and cryptographic verification passed"
+    );
+    assert_eq!(h.calls.load(Ordering::SeqCst), 1);
+    assert_eq!(peer.replay_usage(), (2, 4096));
+    let mut fresh = request;
+    fresh["id"] = json!("fresh-operation-attempt");
+    assert!(peer.handle(&f.sign(fresh), &h, deadline()).await.is_ok());
+    assert_eq!(h.calls.load(Ordering::SeqCst), 2);
+    assert_eq!(h.effects.lock().unwrap().len(), 1);
+}
