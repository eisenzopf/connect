+#[tokio::test]
+async fn actual_tls_quic_signature_problems_are_distinct_safe_and_signed_logout_closes_peer() {
+    let f = Fixture::new();
+    let (_server, _client, host, remote) = quic_pair().await;
+    let _host_lifetime = host.clone();
+    let peer = f.peer();
+    let lifetime = peer.cancellation();
+    let server = tokio::spawn(async move {
+        let (tx, rx) = host.accept_bi().await.unwrap();
+        peer.run(rx, tx, &AnyHandler::default()).await
+    });
+    let (tx, rx) = remote.open_bi().await.unwrap();
+    let mut writer = FramedWrite::new(tx, rvoip_uctp::substrate::length_prefixed_codec());
+    let mut reader = FramedRead::new(rx, rvoip_uctp::substrate::length_prefixed_codec());
+    writer
+        .send(Bytes::from(serde_json::to_vec(&hello()).unwrap()))
+        .await
+        .unwrap();
+    let challenge = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    let unsigned = response(&challenge, "private-never-echo");
+    let mut stale = response(&challenge, "old");
+    stale["ts"] = json!(f.clock.now() - chrono::Duration::seconds(301));
+    let stale = serde_json::to_vec(&f.client.sign(&stale).unwrap()).unwrap();
+    let mut unknown: Value = serde_json::from_slice(&f.sign(response(&challenge, "old"))).unwrap();
+    unknown["signature"]["keyid"] = json!("private-missing-key");
+    let mut invalid: Value = serde_json::from_slice(&f.sign(response(&challenge, "old"))).unwrap();
+    invalid["signature"]["sig"] = json!("AAAA");
+    let wires = [
+        serde_json::to_vec(&unsigned).unwrap(),
+        stale,
+        serde_json::to_vec(&unknown).unwrap(),
+        serde_json::to_vec(&invalid).unwrap(),
+    ];
+    let mut generic = Vec::new();
+    for (wire, reason) in wires.into_iter().zip([
+        "signature_required",
+        "stale_timestamp",
+        "invalid_signature",
+        "invalid_signature",
+    ]) {
+        let request: Value = serde_json::from_slice(&wire).unwrap();
+        writer.send(Bytes::from(wire)).await.unwrap();
+        let problem = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+        assert_eq!(problem.original()["payload"]["code"], 401);
+        assert_eq!(problem.original()["payload"]["reason"], reason);
+        assert_eq!(problem.scope(Scope::Reply), request["id"].as_str());
+        let text = serde_json::to_string(&problem).unwrap();
+        assert!(!text.contains("private-never-echo") && !text.contains("private-missing-key"));
+        f.verify_server(&problem).await;
+        if reason == "invalid_signature" {
+            generic.push(problem.original()["payload"].clone());
+        }
+    }
+    assert_eq!(generic[0], generic[1]);
+    writer
+        .send(Bytes::from(f.sign(response(&challenge, "old"))))
+        .await
+        .unwrap();
+    assert_eq!(
+        Envelope::parse(&reader.next().await.unwrap().unwrap())
+            .unwrap()
+            .kind(),
+        "auth.session"
+    );
+    f.store.unavailable.store(true, Ordering::SeqCst);
+    writer.send(Bytes::from(f.sign(command()))).await.unwrap();
+    let unavailable = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    assert_eq!(unavailable.original()["payload"]["code"], 503);
+    assert_eq!(
+        unavailable.original()["payload"]["reason"],
+        "replay_protection_unavailable"
+    );
+    f.verify_server(&unavailable).await;
+    f.store.unavailable.store(false, Ordering::SeqCst);
+    let bye = envelope("auth.bye", json!({"reason":"user-logout"}));
+    writer.send(Bytes::from(f.sign(bye.clone()))).await.unwrap();
+    let ack = Envelope::parse(
+        &tokio::time::timeout(Duration::from_secs(3), reader.next())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(ack.kind(), "ack");
+    assert_eq!(ack.scope(Scope::Reply), bye["id"].as_str());
+    assert!(tokio::time::timeout(Duration::from_secs(3), server)
+        .await
+        .unwrap()
+        .unwrap()
+        .is_ok());
+    assert!(lifetime.is_cancelled());
+}
