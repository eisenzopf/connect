+#[cfg(test)]
+mod fixed_public_video_schema_tests {
+    use super::matches_schema;
+    use serde_json::json;
+
+    #[test]
+    fn contains_counts_exact_original_roles_without_requiring_array_order() {
+        let schema = json!({"contains":{"type":"object","required":["kind","direction"],
+            "properties":{"kind":{"const":"video"},"direction":{"const":"recvonly"}}},
+            "minContains":1,"maxContains":1});
+        let audio = json!({"kind":"audio","direction":"sendrecv"});
+        let camera = json!({"kind":"video","direction":"sendrecv"});
+        let public = json!({"kind":"video","direction":"recvonly"});
+        assert!(matches_schema(&schema, &json!([audio, camera, public])));
+        assert!(matches_schema(&schema, &json!([public, camera, audio])));
+        assert!(!matches_schema(&schema, &json!([audio, camera])));
+        assert!(!matches_schema(&schema, &json!([public, public])));
+        assert!(!matches_schema(&schema, &json!([])));
+        let default_minimum = json!({"contains":{"const":"public"}});
+        assert!(!matches_schema(&default_minimum, &json!([])));
+        assert!(matches_schema(&default_minimum, &json!(["public"])));
+        let none = json!({"contains":{"const":"public"},"minContains":0,"maxContains":0});
+        assert!(matches_schema(&none, &json!(["camera"])));
+        assert!(!matches_schema(&none, &json!(["public"])));
+    }
+
+    #[test]
+    fn printable_ascii_mid_is_not_a_sip_uri_and_refuses_whitespace_controls_and_unicode() {
+        let schema = json!({"type":"string","pattern":"^[!-~]+$"});
+        for value in ["0", "B!~", "audio-2"] {
+            assert!(matches_schema(&schema, &json!(value)), "{value:?}");
+        }
+        for value in ["", " ", "mid space", "tab\t", "line\n", "\u{7f}", "é"] {
+            assert!(!matches_schema(&schema, &json!(value)), "{value:?}");
+        }
+    }
