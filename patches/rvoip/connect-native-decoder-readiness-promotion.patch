+#[tokio::test]
+async fn replacement_preroll_public_promotion_preserves_decoder_identity_but_retires_private_feedback(
+) {
+    let mut f = Preroll::new().await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 70);
+    delivered(&mut f.old_output, 70).await;
+    let private = feedback_delivery(&mut f.target_output, 70).await;
+    private
+        .dispatch(private.epoch(), 41, |_, _| Ok(()))
+        .unwrap();
+    let plan = f.movement.plan_with_video(Some(request())).unwrap();
+    let (_, handle) = f.movement.commit(plan).await.unwrap();
+    assert!(!private.is_current());
+    assert!(private
+        .dispatch(private.epoch(), 42, |_, _| panic!(
+            "private feedback crossed promotion"
+        ))
+        .is_err());
+    prepared.close();
+    assert!(
+        f.target_output.try_recv().is_err(),
+        "promotion replayed a private queued payload"
+    );
+    f.publish_video("bob", 71);
+    let public = feedback_delivery(&mut f.target_output, 71).await;
+    assert_eq!(
+        public.epoch(),
+        private.epoch(),
+        "same original physical decoder was reset at public promotion"
+    );
+    assert!(public
+        .dispatch(public.epoch(), 41, |_, _| panic!(
+            "old feedback sequence was accepted"
+        ))
+        .is_err());
+    tokio::time::sleep(Duration::from_millis(110)).await;
+    public.dispatch(public.epoch(), 42, |_, _| Ok(())).unwrap();
+    f.movement
+        .room
+        .domain
+        .base
+        .0
+        .write()
+        .await
+        .revoked
+        .insert("bob".into());
+    assert!(public
+        .dispatch(public.epoch(), 43, |_, _| panic!(
+            "historical decoder identity bypassed current source revocation"
+        ))
+        .is_err());
+    assert_eq!(
+        handle.finish_local_media_cleanup(deadline()).await,
+        ReplacementCleanupOutcome::LocalMediaClosed
+    );
+}
