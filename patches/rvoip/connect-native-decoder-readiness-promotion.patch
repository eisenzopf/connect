+#[tokio::test]
+async fn replacement_preroll_public_identity_does_not_survive_source_or_target_port_generation_change(
+) {
+    for name in ["bob", "device"] {
+        let mut f = Preroll::new().await;
+        let prepared = f.prepare(CancellationToken::new()).await;
+        f.publish_video("bob", 90);
+        delivered(&mut f.old_output, 90).await;
+        let private = feedback_delivery(&mut f.target_output, 90).await;
+        let plan = f.movement.plan_with_video(Some(request())).unwrap();
+        let (_, handle) = f.movement.commit(plan).await.unwrap();
+        prepared.close();
+        f.publish_video("bob", 91);
+        let public = feedback_delivery(&mut f.target_output, 91).await;
+        assert_eq!(public.epoch(), private.epoch());
+        let controller = f.movement.room.nodes[name].controller.clone();
+        let logical = if name == "bob" {
+            desired(Medium::Video).logical_id
+        } else {
+            request().receivers[0].replacement.clone()
+        };
+        let before = controller
+            .active_bindings()
+            .into_iter()
+            .find(|b| b.negotiated.requested.logical_id == logical)
+            .unwrap();
+        let desired = controller
+            .active_bindings()
+            .into_iter()
+            .map(|b| b.negotiated.requested)
+            .collect::<Vec<_>>();
+        controller
+            .change(
+                controller.revision(),
+                &desired,
+                &BTreeSet::from([logical.clone()]),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        let after = controller
+            .active_bindings()
+            .into_iter()
+            .find(|b| b.negotiated.requested.logical_id == logical)
+            .unwrap();
+        assert_ne!(before.transport_id, after.transport_id);
+        assert!(after.generation > before.generation);
+        if name == "device" {
+            f.target_output = f.movement.room.nodes[name].adapter.ports.lock().unwrap()[&logical]
+                .take_egress()
+                .unwrap();
+        }
+        f.publish_video("bob", 92);
+        let changed = feedback_delivery(&mut f.target_output, 92).await;
+        assert_ne!(
+            changed.epoch(),
+            public.epoch(),
+            "{name} replacement inherited old decoder identity"
+        );
+        assert!(!public.is_current());
+        assert_eq!(
+            handle.finish_local_media_cleanup(deadline()).await,
+            ReplacementCleanupOutcome::LocalMediaClosed
+        );
+    }
+}
