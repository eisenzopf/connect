+    /// Only DirectCommit may call this for its validated original private route
+    /// and identical selected source. Unavailable metadata conservatively gets a
+    /// fresh identity; it never blocks the atomic routing fence or borrows IO.
+    pub(super) fn promoted(&self) -> Self {
+        let continuation = self.current.try_lock().ok().and_then(|slot| {
+            let epoch = slot.as_ref()?;
+            let rate = epoch.rate.try_lock().ok()?.clone();
+            Some(DecoderContinuation {
+                id: epoch.id,
+                source: epoch.scope.source.clone(),
+                target: epoch.scope.target.clone(),
+                descriptor: epoch.source.clone(),
+                rate,
+            })
+        });
+        Self {
+            current: Mutex::new(None),
+            continuation,
+        }
+    }
