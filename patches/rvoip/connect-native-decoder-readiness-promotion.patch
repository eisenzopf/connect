+//! Host-issued metadata for one original native replacement negotiation.
+//! This is a challenge, never a media grant or a decoder observation. It cannot
+//! be copied from arbitrary client extensions or attached to an update/replay.
+use super::*;
+#[derive(Clone)]
+pub struct ReplacementReadinessChallenge {
+    record: Identifier,
+    nonce: Identifier,
+    source_generation: u64,
+    target_generation: u64,
+}
+impl ReplacementReadinessChallenge {
+    pub fn new(
+        operation_record_id: String,
+        nonce: String,
+        source_generation: u64,
+        target_generation: u64,
+    ) -> Result<Self, NativeOfferError> {
+        if source_generation == 0
+            || source_generation.checked_add(1) != Some(target_generation)
+            || target_generation > super::super::MAX_SAFE_REVISION
+        {
+            return Err(NativeOfferError::Invalid);
+        }
+        Ok(Self {
+            record: operation_record_id
+                .try_into()
+                .map_err(|_| NativeOfferError::Invalid)?,
+            nonce: nonce.try_into().map_err(|_| NativeOfferError::Invalid)?,
+            source_generation,
+            target_generation,
+        })
+    }
+    pub(super) fn validate_start(
+        &self,
+        envelope: &Envelope,
+        expected: u64,
+        plan: &NativeOfferPlan,
+    ) -> Result<(), NativeOfferError> {
+        let marker = &envelope.original()["payload"]["replacement_preparation"];
+        if envelope.kind() != "connection.offer"
+            || expected != 0
+            || marker.as_object().map(|m| m.len()) != Some(2)
+            || marker["profile"] != "connect-replacement-media-v1"
+            || marker["operation_record_id"].as_str() != Some(self.record.as_str())
+            || plan
+                .selected()
+                .iter()
+                .filter(|s| {
+                    s.requested.medium == Medium::Audio
+                        && s.requested.direction == StreamDirection::Both
+                })
+                .count()
+                != 1
+        {
+            return Err(NativeOfferError::Scope);
+        }
+        Ok(())
+    }
+    pub(super) fn marker(&self, bindings: &[ReadyMediaBinding]) -> Result<Value, NativeOfferError> {
+        if bindings.is_empty()
+            || bindings
+                .iter()
+                .any(|b| b.connection_generation != self.target_generation)
+        {
+            return Err(NativeOfferError::Confirmation);
+        }
+        Ok(
+            json!({"profile":"connect-replacement-media-v1","operation_record_id":self.record.as_str(),"readiness":{
+                "nonce":self.nonce.as_str(),"source_generation":self.source_generation,"target_generation":self.target_generation,"stream_revision":2
+            }}),
+        )
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn replacement_challenge_requires_exact_bounded_consecutive_generations_and_identifiers() {
+        assert!(ReplacementReadinessChallenge::new("record".into(), "nonce".into(), 1, 2).is_ok());
+        for (a, b) in [
+            (0, 1),
+            (1, 1),
+            (1, 3),
+            (u64::MAX, u64::MAX),
+            (
+                super::super::super::MAX_SAFE_REVISION,
+                super::super::super::MAX_SAFE_REVISION + 1,
+            ),
+        ] {
+            assert!(
+                ReplacementReadinessChallenge::new("record".into(), "nonce".into(), a, b).is_err()
+            );
+        }
+        assert!(
+            ReplacementReadinessChallenge::new("../record".into(), "nonce".into(), 1, 2).is_err()
+        );
+        assert!(ReplacementReadinessChallenge::new("record".into(), "".into(), 1, 2).is_err());
+    }
+    #[test]
+    fn replacement_challenge_without_actual_prepared_binding_never_emits_a_marker() {
+        let challenge =
+            ReplacementReadinessChallenge::new("record".into(), "nonce".into(), 1, 2).unwrap();
+        assert!(matches!(
+            challenge.marker(&[]),
+            Err(NativeOfferError::Confirmation)
+        ));
+    }
+}
