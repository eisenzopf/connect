+// Decoder identity and replay/cooldown cursor only. This owns no Epoch, route,
+// media frame, current ticket, reader, port or controller. Admission is rebuilt
+// at the first actual public delivery under its new real current guards.
+#[derive(Clone)]
+struct DecoderContinuation {
+    id: u128,
+    source: Weak<Port>,
+    target: Weak<Port>,
+    descriptor: MediaSource,
+    rate: Rate,
+}
+impl DecoderContinuation {
+    fn matches(&self, scope: &Scope, source: &MediaSource) -> bool {
+        Weak::ptr_eq(&self.source, &scope.source)
+            && Weak::ptr_eq(&self.target, &scope.target)
+            && self.source.upgrade().is_some()
+            && self.target.upgrade().is_some()
+            && self.descriptor.conversation == source.conversation
+            && self.descriptor.session == source.session
+            && self.descriptor.connection == source.connection
+            && self.descriptor.participant == source.participant
+            && self.descriptor.membership_epoch == source.membership_epoch
+            && self.descriptor.connection_generation == source.connection_generation
+            && self.descriptor.logical_id == source.logical_id
+            && self.descriptor.transport_id == source.transport_id
+            && self.descriptor.stream_generation == source.stream_generation
+    }
+}
