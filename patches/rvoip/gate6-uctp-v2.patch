+//! UCTP envelope 2, including the negotiated `connect/2` application profile.
+//!
+//! Decoding is bounded, rejects ambiguous JSON and validates before producing
+//! typed payloads. [`Envelope::original`] retains optional extensions for
+//! signature verification; [`Envelope::execution_value`] removes ignored
+//! fields before business-intent processing. Authentication and authorization
+//! remain the responsibility of the application service, never JSON metadata.
+
+pub mod payloads;
+mod validation;
+
+use chrono::{DateTime, Utc};
+pub use payloads::{OperationState, Payload, REGISTRY};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::fmt;
+
+pub const ENVELOPE_VERSION: u8 = 2;
+pub const RAW_QUIC_ALPN: &[u8] = b"uctp/2";
+pub const APPLICATION_PROFILE: &str = "connect/2";
+pub const DATAGRAM_VERSION: u8 = 1;
+pub const RTP_DATAGRAM_PROFILE: &str = "rtp-datagram/1";
+pub const MAX_ENVELOPE_BYTES: usize = 1_048_576;
+pub const MAX_SAFE_REVISION: u64 = 9_007_199_254_740_991;
+
+/// A bounded opaque identifier; construction and deserialization are checked.
+#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(try_from = "String", into = "String")]
+pub struct Identifier(String);
+
+impl Identifier {
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+impl TryFrom<String> for Identifier {
+    type Error = WireError;
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        if value.is_empty()
+            || value.len() > 128
+            || !value
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+        {
+            return Err(WireError::InvalidIdentifier);
+        }
+        Ok(Self(value))
+    }
+}
+
+impl From<Identifier> for String {
+    fn from(value: Identifier) -> Self {
+        value.0
+    }
+}
+
+impl fmt::Debug for Identifier {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Identifier(redacted)")
+    }
+}
+
+/// Stable error categories contain no attacker-selected values or private data.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, thiserror::Error)]
+pub enum WireError {
+    #[error("envelope exceeds the reliable message limit")]
+    TooLarge,
+    #[error("invalid or ambiguous JSON encoding")]
+    InvalidJson,
+    #[error("unsupported envelope version")]
+    UnsupportedVersion,
+    #[error("unsupported message type")]
+    UnsupportedType,
+    #[error("invalid identifier")]
+    InvalidIdentifier,
+    #[error("required routing or correlation field is missing")]
+    MissingScope,
+    #[error("payload does not satisfy the negotiated contract")]
+    InvalidPayload,
+    #[error("no supported application profile was offered")]
+    UnsupportedProfile,
+    #[error("operation transition requires authoritative evidence")]
+    InvalidTransition,
+}
+
+impl WireError {
+    /// Stable, bounded wire failure with no payload or credential echo.
+    pub fn problem(self) -> payloads::Error {
+        let (code, category, reason) = match self {
+            Self::TooLarge => (413, "validation", "envelope_too_large"),
+            Self::InvalidJson => (400, "validation", "invalid_json"),
+            Self::UnsupportedVersion => (426, "unsupported", "unsupported_version"),
+            Self::UnsupportedType => (501, "unsupported", "unsupported_type"),
+            Self::InvalidIdentifier => (400, "validation", "invalid_identifier"),
+            Self::MissingScope => (400, "validation", "missing_scope"),
+            Self::InvalidPayload => (400, "validation", "invalid_payload"),
+            Self::UnsupportedProfile => (426, "unsupported", "unsupported_profile"),
+            Self::InvalidTransition => (409, "conflict", "invalid_transition"),
+        };
+        payloads::Error {
+            code,
+            category: category.into(),
+            reason: reason.into(),
+            details: None,
+        }
+    }
+}
+
+/// A validated immutable envelope. Debug output intentionally omits content.
+#[derive(Clone)]
+pub struct Envelope {
+    original: Value,
+    payload: Payload,
+}
+
+impl Serialize for Envelope {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.original.serialize(serializer)
+    }
+}
+
+impl fmt::Debug for Envelope {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Envelope")
+            .field("type", &self.kind())
+            .field("version", &ENVELOPE_VERSION)
+            .finish_non_exhaustive()
+    }
+}
+
+impl Envelope {
+    pub fn parse(bytes: &[u8]) -> Result<Self, WireError> {
+        if bytes.len() > MAX_ENVELOPE_BYTES {
+            return Err(WireError::TooLarge);
+        }
+        let original = validation::unique_json(bytes)?;
+        Self::validate(original)
+    }
+
+    /// Locally constructed values pass through the same contract checks.
+    pub fn from_value(value: Value) -> Result<Self, WireError> {
+        let bytes = serde_json::to_vec(&value).map_err(|_| WireError::InvalidJson)?;
+        Self::parse(&bytes)
+    }
+
+    fn validate(original: Value) -> Result<Self, WireError> {
+        if original.get("v").and_then(Value::as_u64) != Some(2) {
+            return Err(WireError::UnsupportedVersion);
+        }
+        let kind = original
+            .get("type")
+            .and_then(Value::as_str)
+            .ok_or(WireError::UnsupportedType)?;
+        let (_, operation, revision) = REGISTRY
+            .iter()
+            .find(|(name, _, _)| *name == kind)
+            .ok_or(WireError::UnsupportedType)?;
+        for field in ["id", "cid", "sid", "connid", "in_reply_to", "operation_id"] {
+            if let Some(value) = original.get(field) {
+                Identifier::try_from(
+                    value
+                        .as_str()
+                        .ok_or(WireError::InvalidIdentifier)?
+                        .to_owned(),
+                )?;
+            }
+        }
+        if (*operation && original.get("operation_id").is_none())
+            || (*revision && original.get("expected_revision").is_none())
+        {
+            return Err(WireError::MissingScope);
+        }
+        validation::validate_envelope(&original)?;
+        let payload: Payload =
+            serde_json::from_value(original.clone()).map_err(|_| WireError::InvalidPayload)?;
+        Ok(Self { original, payload })
+    }
+
+    pub fn kind(&self) -> &'static str {
+        self.payload.kind()
+    }
+    pub fn payload(&self) -> &Payload {
+        &self.payload
+    }
+    pub fn original(&self) -> &Value {
+        &self.original
+    }
+    pub fn id(&self) -> &str {
+        self.original["id"].as_str().expect("validated ID")
+    }
+    pub fn timestamp(&self) -> DateTime<Utc> {
+        DateTime::parse_from_rfc3339(self.original["ts"].as_str().expect("validated timestamp"))
+            .expect("validated timestamp")
+            .with_timezone(&Utc)
+    }
+    pub fn scope(&self, field: Scope) -> Option<&str> {
+        self.original.get(field.name()).and_then(Value::as_str)
+    }
+    pub fn expected_revision(&self) -> Option<u64> {
+        self.original
+            .get("expected_revision")
+            .and_then(Value::as_u64)
+    }
+
+    /// Use for signature verification before normalization. Includes unknown
+    /// optional fields and excludes only the signature member itself.
+    pub fn signature_input(&self) -> Value {
+        let mut value = self.original.clone();
+        value
+            .as_object_mut()
+            .expect("validated object")
+            .remove("signature");
+        value
+    }
+
+    /// Known execution fields only. Not an authorization decision or a digest:
+    /// the service must add authenticated scope and apply its JCS intent policy.
+    pub fn execution_value(&self) -> Value {
+        let mut value = serde_json::to_value(&self.payload).expect("serializable checked payload");
+        // Typed decoding removes unknown fields, including nested ones. A few
+        // contract-defined opaque objects intentionally remain application data.
+        for field in ["cid", "sid", "connid", "operation_id", "expected_revision"] {
+            if let Some(item) = self.original.get(field) {
+                value[field] = item.clone();
+            }
+        }
+        value
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+pub enum Scope {
+    Conversation,
+    Session,
+    Connection,
+    Reply,
+    Operation,
+}
+impl Scope {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Conversation => "cid",
+            Self::Session => "sid",
+            Self::Connection => "connid",
+            Self::Reply => "in_reply_to",
+            Self::Operation => "operation_id",
+        }
+    }
+}
+
+/// Selection must be retained in the authenticated peer binding. A payload
+/// cannot change it by advertising an unsolicited session profile later.
+pub fn select_application_profile(hello: &payloads::AuthHello) -> Result<&'static str, WireError> {
+    if hello
+        .application_profiles
+        .iter()
+        .any(|profile| profile == APPLICATION_PROFILE)
+    {
+        Ok(APPLICATION_PROFILE)
+    } else {
+        Err(WireError::UnsupportedProfile)
+    }
+}
+
+impl OperationState {
+    pub fn is_terminal(self) -> bool {
+        matches!(self, Self::Completed | Self::Cancelled | Self::Failed)
+    }
+
+    /// Pure transition guard. Evidence is supplied only by an authorized
+    /// service after persisting its attribution, never directly from a client.
+    pub fn transition(self, next: Self, evidence: TransitionEvidence) -> Result<Self, WireError> {
+        use OperationState::*;
+        if self == next {
+            return Ok(next);
+        }
+        let allowed = match self {
+            Accepted => matches!(next, Preparing | Cancelled | Failed | Interrupted),
+            Preparing => matches!(
+                next,
+                Ready | Committing | Cancelled | Failed | Interrupted | Unknown
+            ),
+            Ready => matches!(next, Committing | Cancelled | Failed | Interrupted),
+            Committing => matches!(next, Completed | Failed | Interrupted | Unknown),
+            Interrupted => match next {
+                Preparing => evidence == TransitionEvidence::SafeRedispatch,
+                Completed | Cancelled | Failed => evidence == TransitionEvidence::Reconciled,
+                Unknown => true,
+                _ => false,
+            },
+            Unknown => {
+                matches!(next, Completed | Cancelled | Failed)
+                    && evidence == TransitionEvidence::Reconciled
+            }
+            Completed | Cancelled | Failed => false,
+        };
+        if allowed {
+            Ok(next)
+        } else {
+            Err(WireError::InvalidTransition)
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TransitionEvidence {
+    Ordinary,
+    SafeRedispatch,
+    Reconciled,
+}
+
+#[cfg(test)]
+mod tests;
