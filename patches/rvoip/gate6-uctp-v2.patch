--- /dev/null
+++ b/crates/uctp/rvoip-uctp/src/v2/validation.rs
@@ -0,0 +1,249 @@
+//! The fixed published schema's validation vocabulary. This is deliberately
+//! private: callers cannot supply schemas or resolve remote references.
+use super::WireError;
+use base64::Engine;
+use serde::de::{self, Deserialize, Deserializer, MapAccess, SeqAccess, Visitor};
+use serde_json::{Map, Number, Value};
+use std::{fmt, sync::LazyLock};
+
+static SCHEMA: LazyLock<Value> = LazyLock::new(|| {
+    serde_json::from_str(include_str!("envelope.schema.json")).expect("compiled schema")
+});
+
+pub(super) fn validate_envelope(value: &Value) -> Result<(), WireError> {
+    if !matches_schema(&SCHEMA, value) {
+        return Err(WireError::InvalidPayload);
+    }
+    if value["type"] == "message.send" {
+        let payload = &value["payload"];
+        let body = payload["body"].as_str().ok_or(WireError::InvalidPayload)?;
+        let size = if payload["body_encoding"] == "base64" {
+            base64::engine::general_purpose::STANDARD
+                .decode(body)
+                .map_err(|_| WireError::InvalidPayload)?
+                .len()
+        } else {
+            body.len()
+        };
+        if size > 65_536 {
+            return Err(WireError::InvalidPayload);
+        }
+    }
+    Ok(())
+}
+
+fn matches_schema(schema: &Value, value: &Value) -> bool {
+    if let Some(reference) = schema.get("$ref").and_then(Value::as_str) {
+        let name = reference
+            .strip_prefix("#/$defs/")
+            .expect("local fixed reference");
+        return matches_schema(&SCHEMA["$defs"][name], value);
+    }
+    if schema
+        .get("const")
+        .is_some_and(|expected| expected != value)
+    {
+        return false;
+    }
+    if let Some(choices) = schema.get("enum").and_then(Value::as_array) {
+        if !choices.contains(value) {
+            return false;
+        }
+    }
+    if let Some(clauses) = schema.get("allOf").and_then(Value::as_array) {
+        if !clauses.iter().all(|clause| matches_schema(clause, value)) {
+            return false;
+        }
+    }
+    if let Some(clauses) = schema.get("anyOf").and_then(Value::as_array) {
+        if !clauses.iter().any(|clause| matches_schema(clause, value)) {
+            return false;
+        }
+    }
+    if let Some(clauses) = schema.get("oneOf").and_then(Value::as_array) {
+        if clauses
+            .iter()
+            .filter(|clause| matches_schema(clause, value))
+            .count()
+            != 1
+        {
+            return false;
+        }
+    }
+    if schema
+        .get("not")
+        .is_some_and(|clause| matches_schema(clause, value))
+    {
+        return false;
+    }
+    if let Some(condition) = schema.get("if") {
+        let branch = if matches_schema(condition, value) {
+            "then"
+        } else {
+            "else"
+        };
+        if schema
+            .get(branch)
+            .is_some_and(|clause| !matches_schema(clause, value))
+        {
+            return false;
+        }
+    }
+    if let Some(kind) = schema.get("type").and_then(Value::as_str) {
+        let valid = match kind {
+            "object" => value.is_object(),
+            "array" => value.is_array(),
+            "string" => value.is_string(),
+            "integer" => value.as_u64().is_some(),
+            "number" => value.is_number(),
+            "boolean" => value.is_boolean(),
+            "null" => value.is_null(),
+            _ => unreachable!("unsupported fixed schema type"),
+        };
+        if !valid {
+            return false;
+        }
+    }
+    if let Some(object) = value.as_object() {
+        if let Some(required) = schema.get("required").and_then(Value::as_array) {
+            if required
+                .iter()
+                .any(|name| !object.contains_key(name.as_str().expect("schema key")))
+            {
+                return false;
+            }
+        }
+        if let Some(properties) = schema.get("properties").and_then(Value::as_object) {
+            for (key, child) in properties {
+                if object
+                    .get(key)
+                    .is_some_and(|item| !matches_schema(child, item))
+                {
+                    return false;
+                }
+            }
+        }
+    }
+    if let Some(items) = value.as_array() {
+        if below(schema, "minItems", items.len() as u64)
+            || above(schema, "maxItems", items.len() as u64)
+        {
+            return false;
+        }
+        if schema.get("uniqueItems") == Some(&Value::Bool(true)) {
+            for (index, item) in items.iter().enumerate() {
+                if items[..index].contains(item) {
+                    return false;
+                }
+            }
+        }
+        if schema
+            .get("items")
+            .is_some_and(|child| !items.iter().all(|item| matches_schema(child, item)))
+        {
+            return false;
+        }
+    }
+    if let Some(text) = value.as_str() {
+        let length = text.chars().count() as u64;
+        if below(schema, "minLength", length) || above(schema, "maxLength", length) {
+            return false;
+        }
+        if let Some(pattern) = schema.get("pattern").and_then(Value::as_str) {
+            assert_eq!(pattern, "^[A-Za-z0-9._~-]+$");
+            if super::Identifier::try_from(text.to_owned()).is_err() {
+                return false;
+            }
+        }
+        if schema.get("format").and_then(Value::as_str) == Some("date-time")
+            && chrono::DateTime::parse_from_rfc3339(text).is_err()
+        {
+            return false;
+        }
+    }
+    if let Some(number) = value.as_u64() {
+        if below(schema, "minimum", number) || above(schema, "maximum", number) {
+            return false;
+        }
+    }
+    true
+}
+
+fn below(schema: &Value, bound: &str, value: u64) -> bool {
+    schema
+        .get(bound)
+        .and_then(Value::as_u64)
+        .is_some_and(|minimum| value < minimum)
+}
+fn above(schema: &Value, bound: &str, value: u64) -> bool {
+    schema
+        .get(bound)
+        .and_then(Value::as_u64)
+        .is_some_and(|maximum| value > maximum)
+}
+
+/// Serde's ordinary Value decoder keeps the last duplicate member. Reject
+/// duplicates recursively instead, before signatures or authority are parsed.
+struct Unique(Value);
+impl<'de> Deserialize<'de> for Unique {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct UniqueVisitor;
+        impl<'de> Visitor<'de> for UniqueVisitor {
+            type Value = Unique;
+            fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+                f.write_str("unambiguous JSON")
+            }
+            fn visit_bool<E: de::Error>(self, value: bool) -> Result<Unique, E> {
+                Ok(Unique(value.into()))
+            }
+            fn visit_i64<E: de::Error>(self, value: i64) -> Result<Unique, E> {
+                Ok(Unique(value.into()))
+            }
+            fn visit_u64<E: de::Error>(self, value: u64) -> Result<Unique, E> {
+                Ok(Unique(value.into()))
+            }
+            fn visit_f64<E: de::Error>(self, value: f64) -> Result<Unique, E> {
+                Number::from_f64(value)
+                    .map(|v| Unique(Value::Number(v)))
+                    .ok_or_else(|| E::custom("nonfinite JSON number"))
+            }
+            fn visit_str<E: de::Error>(self, value: &str) -> Result<Unique, E> {
+                Ok(Unique(value.into()))
+            }
+            fn visit_string<E: de::Error>(self, value: String) -> Result<Unique, E> {
+                Ok(Unique(value.into()))
+            }
+            fn visit_unit<E: de::Error>(self) -> Result<Unique, E> {
+                Ok(Unique(Value::Null))
+            }
+            fn visit_none<E: de::Error>(self) -> Result<Unique, E> {
+                Ok(Unique(Value::Null))
+            }
+            fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<Unique, A::Error> {
+                let mut items = Vec::new();
+                while let Some(Unique(item)) = seq.next_element()? {
+                    items.push(item);
+                }
+                Ok(Unique(Value::Array(items)))
+            }
+            fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Unique, A::Error> {
+                let mut fields = Map::new();
+                while let Some(key) = map.next_key::<String>()? {
+                    if fields.contains_key(&key) {
+                        return Err(de::Error::custom("duplicate JSON member"));
+                    }
+                    let Unique(value) = map.next_value()?;
+                    fields.insert(key, value);
+                }
+                Ok(Unique(Value::Object(fields)))
+            }
+        }
+        deserializer.deserialize_any(UniqueVisitor)
+    }
+}
+
+pub(super) fn unique_json(bytes: &[u8]) -> Result<Value, WireError> {
+    serde_json::from_slice::<Unique>(bytes)
+        .map(|value| value.0)
+        .map_err(|_| WireError::InvalidJson)
+}
