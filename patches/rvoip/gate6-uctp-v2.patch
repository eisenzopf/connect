@@ -0,0 +1,246 @@
+use super::*;
+use serde_json::json;
+
+fn sample(kind: &str) -> Value {
+    let vectors: Value = serde_json::from_str(include_str!("golden-vectors.json")).unwrap();
+    vectors["vectors"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|v| v["valid"] == true && v["envelope"]["type"] == kind)
+        .unwrap()["envelope"]
+        .clone()
+}
+
+#[test]
+fn frozen_golden_vectors_decode_and_roundtrip_every_type() {
+    let vectors: Value = serde_json::from_str(include_str!("golden-vectors.json")).unwrap();
+    let mut covered = std::collections::BTreeSet::new();
+    for vector in vectors["vectors"].as_array().unwrap() {
+        let result = Envelope::parse(&serde_json::to_vec(&vector["envelope"]).unwrap());
+        assert_eq!(
+            result.is_ok(),
+            vector["valid"].as_bool().unwrap(),
+            "{}: {:?}",
+            vector["id"],
+            result.as_ref().err()
+        );
+        if let Ok(envelope) = result {
+            assert_eq!(envelope.original(), &vector["envelope"]);
+            let wire = serde_json::to_vec(envelope.original()).unwrap();
+            assert_eq!(Envelope::parse(&wire).unwrap().kind(), envelope.kind());
+            covered.insert(envelope.kind());
+        }
+    }
+    assert_eq!(covered, REGISTRY.iter().map(|(name, _, _)| *name).collect());
+}
+
+#[test]
+fn rejects_duplicate_members_at_all_depths_and_trailing_documents() {
+    for bytes in [
+        br#"{"v":2,"v":1}"#.as_slice(),
+        br#"{"v":2,"payload":{"kind":"role-change","kind":"participant-leave"}}"#,
+        br#"{"v":2,"payload":[{"x":1,"x":2}]}"#,
+        br#"{"v":2} {}"#,
+        br#"{"v":2,"payload":{"x":1e999}}"#,
+    ] {
+        assert_eq!(Envelope::parse(bytes).unwrap_err(), WireError::InvalidJson);
+    }
+    assert_eq!(
+        Envelope::parse(&[0xff]).unwrap_err(),
+        WireError::InvalidJson
+    );
+}
+
+#[test]
+fn rejects_oversize_before_decoding() {
+    assert_eq!(
+        Envelope::parse(&vec![b' '; MAX_ENVELOPE_BYTES + 1]).unwrap_err(),
+        WireError::TooLarge
+    );
+}
+
+#[test]
+fn validates_ids_safe_revisions_scope_and_time() {
+    for value in ["", "bad/id", "bad id", "\u{e9}", &"a".repeat(129)] {
+        let mut wire = sample("session.handoff");
+        wire["id"] = value.into();
+        assert_eq!(
+            Envelope::from_value(wire).unwrap_err(),
+            WireError::InvalidIdentifier
+        );
+    }
+    for value in [
+        json!(-1),
+        json!(MAX_SAFE_REVISION + 1),
+        json!(1.5),
+        json!("1"),
+    ] {
+        let mut wire = sample("session.handoff");
+        wire["expected_revision"] = value;
+        assert!(Envelope::from_value(wire).is_err());
+    }
+    for field in ["cid", "sid", "connid"] {
+        let mut wire = sample("connection.replace");
+        wire.as_object_mut().unwrap().remove(field);
+        assert!(Envelope::from_value(wire).is_err());
+    }
+    let mut wire = sample("conversation.get");
+    wire["ts"] = "tomorrow".into();
+    assert!(Envelope::from_value(wire).is_err());
+    let id: Identifier = serde_json::from_str("\"env_019abc~.z-1\"").unwrap();
+    assert_eq!(id.as_str(), "env_019abc~.z-1");
+}
+
+#[test]
+fn ignores_extensions_for_execution_but_retains_them_for_signatures() {
+    let mut wire = sample("session.handoff");
+    wire["new_extension"] = json!({"secret":"top-secret"});
+    wire["payload"]["grant"] = json!({"admin":true});
+    wire["payload"]["actor"] = "spoofed-actor".into();
+    let envelope = Envelope::from_value(wire.clone()).unwrap();
+    assert_eq!(envelope.signature_input(), wire);
+    let execution = envelope.execution_value();
+    assert!(execution.get("new_extension").is_none());
+    assert!(execution["payload"].get("grant").is_none());
+    assert!(execution["payload"].get("actor").is_none());
+    assert!(!format!("{envelope:?} {:?}", envelope.payload()).contains("top-secret"));
+}
+
+#[test]
+fn validates_typed_transitions_and_retained_connection_relationships() {
+    let mut wire = sample("session.update");
+    wire["payload"] =
+        json!({"kind":"role-change","details":{"participant_id":"p_one","role":"lead"}});
+    let envelope = Envelope::from_value(wire.clone()).unwrap();
+    assert!(matches!(
+        envelope.payload(),
+        Payload::SessionUpdate(payloads::SessionUpdate::RoleChange { .. })
+    ));
+    wire["payload"]["details"]
+        .as_object_mut()
+        .unwrap()
+        .remove("role");
+    assert!(Envelope::from_value(wire).is_err());
+    let mut wire = sample("session.handoff");
+    wire["payload"]
+        .as_object_mut()
+        .unwrap()
+        .remove("expected_conversation_revision");
+    assert!(Envelope::from_value(wire.clone()).is_err());
+    wire["payload"]["role_scope"] = "session".into();
+    assert!(Envelope::from_value(wire).is_ok());
+    let mut wire = sample("connection.replace");
+    wire["payload"]["candidate_connid"] = "candidate".into();
+    assert!(Envelope::from_value(wire).is_err());
+    let mut wire = sample("session.consult");
+    wire["payload"]["private_participants"] = json!(["p_one", "p_one"]);
+    assert!(Envelope::from_value(wire).is_err());
+}
+
+#[test]
+fn message_body_limit_counts_decoded_bytes_not_unicode_characters() {
+    use base64::Engine;
+    let mut wire = sample("message.send");
+    wire["payload"]["body_encoding"] = "utf8".into();
+    wire["payload"]["body"] = "é".repeat(32_768).into();
+    assert!(Envelope::from_value(wire.clone()).is_ok());
+    wire["payload"]["body"] = "é".repeat(32_769).into();
+    assert!(Envelope::from_value(wire.clone()).is_err());
+    wire["payload"]["body_encoding"] = "base64".into();
+    wire["payload"]["body"] = base64::engine::general_purpose::STANDARD
+        .encode(vec![1u8; 65_536])
+        .into();
+    assert!(Envelope::from_value(wire.clone()).is_ok());
+    wire["payload"]["body"] = base64::engine::general_purpose::STANDARD
+        .encode(vec![1u8; 65_537])
+        .into();
+    assert!(Envelope::from_value(wire.clone()).is_err());
+    wire["payload"]["body"] = "%%%".into();
+    assert!(Envelope::from_value(wire).is_err());
+}
+
+#[test]
+fn negotiation_selects_only_an_offered_supported_profile() {
+    let envelope = Envelope::from_value(sample("auth.hello")).unwrap();
+    let Payload::AuthHello(mut hello) = envelope.payload().clone() else {
+        panic!()
+    };
+    hello.application_profiles = vec!["other/7".into()];
+    assert_eq!(
+        select_application_profile(&hello),
+        Err(WireError::UnsupportedProfile)
+    );
+    hello.application_profiles.push(APPLICATION_PROFILE.into());
+    assert_eq!(select_application_profile(&hello), Ok(APPLICATION_PROFILE));
+    let mut wire = sample("auth.session");
+    wire["payload"]["application_profile"] = "other/7".into();
+    assert!(Envelope::from_value(wire).is_err());
+}
+
+#[test]
+fn uncertain_operations_cannot_complete_cancel_or_retry_without_evidence() {
+    use OperationState::*;
+    use TransitionEvidence::*;
+    assert_eq!(
+        Committing.transition(Cancelled, Ordinary),
+        Err(WireError::InvalidTransition)
+    );
+    assert_eq!(
+        Unknown.transition(Completed, Ordinary),
+        Err(WireError::InvalidTransition)
+    );
+    assert_eq!(
+        Unknown.transition(Preparing, SafeRedispatch),
+        Err(WireError::InvalidTransition)
+    );
+    assert_eq!(Unknown.transition(Completed, Reconciled), Ok(Completed));
+    assert_eq!(
+        Interrupted.transition(Preparing, Ordinary),
+        Err(WireError::InvalidTransition)
+    );
+    assert_eq!(
+        Interrupted.transition(Preparing, SafeRedispatch),
+        Ok(Preparing)
+    );
+    for state in [Completed, Cancelled, Failed] {
+        assert!(state.is_terminal());
+        assert_eq!(
+            state.transition(Preparing, Reconciled),
+            Err(WireError::InvalidTransition)
+        );
+        assert_eq!(state.transition(state, Ordinary), Ok(state));
+    }
+    let mut wire = sample("operation.updated");
+    wire["payload"]["state"] = "unknown".into();
+    wire["payload"]["result"] = json!({"completed":true});
+    assert!(Envelope::from_value(wire).is_err());
+}
+
+#[test]
+fn transport_and_logical_operation_ids_have_distinct_lifetimes() {
+    let first = sample("session.handoff");
+    let mut second = first.clone();
+    second["id"] = "env_fresh_reconnect".into();
+    second["ts"] = "2026-10-15T12:00:01Z".into();
+    let a = Envelope::from_value(first).unwrap();
+    let b = Envelope::from_value(second).unwrap();
+    assert_ne!(a.id(), b.id());
+    assert_eq!(a.scope(Scope::Operation), b.scope(Scope::Operation));
+    assert_eq!(a.execution_value(), b.execution_value());
+}
+
+#[test]
+fn nested_identifiers_and_bounded_typed_errors() {
+    let mut wire = sample("message.send");
+    wire["payload"]["to"] = json!(["not/an/id"]);
+    assert!(Envelope::from_value(wire).is_err());
+    let mut wire = sample("conversation.participant.add");
+    wire["payload"]["identity_id"] = "bad identity".into();
+    assert!(Envelope::from_value(wire).is_err());
+    let problem = WireError::InvalidTransition.problem();
+    assert_eq!(problem.code, 409);
+    assert_eq!(problem.category, "conflict");
+    assert_eq!(problem.reason, "invalid_transition");
+    assert!(problem.details.is_none());
+}
