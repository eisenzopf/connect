+//! Acquire only mixer metadata before the one compound replacement publication.
+use crate::staged_streams::{ControlResult, StreamControlError};
+use std::future::{poll_fn, Future};
+use std::task::Poll;
+use tokio::sync::{Mutex, MutexGuard};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+pub(super) async fn acquire<'a, T: Send>(
+    mixer: &'a Mutex<T>,
+    deadline: Instant,
+    tokens: &[CancellationToken],
+) -> ControlResult<MutexGuard<'a, T>> {
+    if tokens.is_empty() {
+        return Err(StreamControlError::Authority);
+    }
+    let mut waiting = tokens
+        .iter()
+        .map(|t| Box::pin(t.cancelled()))
+        .collect::<Vec<_>>();
+    let cancelled = poll_fn(move |context| {
+        for token in &mut waiting {
+            if token.as_mut().poll(context).is_ready() {
+                return Poll::Ready(());
+            }
+        }
+        Poll::Pending
+    });
+    let guard = tokio::select! {
+        biased;
+        _ = cancelled => return Err(StreamControlError::Cancelled),
+        _ = tokio::time::sleep_until(deadline) => return Err(StreamControlError::Deadline),
+        guard = mixer.lock() => guard,
+    };
+    if tokens.iter().any(CancellationToken::is_cancelled) {
+        return Err(StreamControlError::Cancelled);
+    }
+    if Instant::now() >= deadline {
+        return Err(StreamControlError::Deadline);
+    }
+    Ok(guard)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+    use std::time::Duration;
+
+    #[tokio::test]
+    async fn busy_mixer_waits_for_original_owner_and_returns_one_guard() {
+        let mixer = Arc::new(Mutex::new(0u64));
+        let held = mixer.lock().await;
+        let queued = mixer.clone();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let worker = tokio::spawn(async move {
+            started.send(()).unwrap();
+            let mut guard = acquire(
+                &queued,
+                Instant::now() + Duration::from_secs(1),
+                &[CancellationToken::new()],
+            )
+            .await
+            .unwrap();
+            *guard += 1;
+        });
+        ready.await.unwrap();
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert!(!worker.is_finished());
+        assert_eq!(*held, 0);
+        drop(held);
+        worker.await.unwrap();
+        assert_eq!(*mixer.lock().await, 1);
+    }
+
+    #[tokio::test]
+    async fn busy_mixer_keeps_original_cutoff_without_publication() {
+        let mixer = Mutex::new(0u64);
+        let held = mixer.lock().await;
+        let result = acquire(
+            &mixer,
+            Instant::now() + Duration::from_millis(20),
+            &[CancellationToken::new()],
+        )
+        .await;
+        assert!(matches!(result, Err(StreamControlError::Deadline)));
+        assert_eq!(*held, 0);
+    }
+
+    #[tokio::test]
+    async fn secondary_cancellation_stops_original_wait() {
+        let mixer = Arc::new(Mutex::new(0u64));
+        let held = mixer.lock().await;
+        let queued = mixer.clone();
+        let stop = CancellationToken::new();
+        let cancelled = stop.clone();
+        let (started, ready) = tokio::sync::oneshot::channel();
+        let worker = tokio::spawn(async move {
+            started.send(()).unwrap();
+            let result = acquire(
+                &queued,
+                Instant::now() + Duration::from_secs(1),
+                &[CancellationToken::new(), cancelled],
+            )
+            .await;
+            assert!(matches!(result, Err(StreamControlError::Cancelled)));
+        });
+        ready.await.unwrap();
+        stop.cancel();
+        worker.await.unwrap();
+        assert_eq!(*held, 0);
+    }
+
+    #[tokio::test]
+    async fn ready_mixer_cannot_bypass_expiry_or_cancellation() {
+        let mixer = Mutex::new(0u64);
+        assert!(matches!(
+            acquire(&mixer, Instant::now(), &[CancellationToken::new()]).await,
+            Err(StreamControlError::Deadline)
+        ));
+        let cancelled = CancellationToken::new();
+        cancelled.cancel();
+        assert!(matches!(
+            acquire(
+                &mixer,
+                Instant::now() + Duration::from_secs(1),
+                &[cancelled]
+            )
+            .await,
+            Err(StreamControlError::Cancelled)
+        ));
+        assert!(matches!(
+            acquire(&mixer, Instant::now() + Duration::from_secs(1), &[]).await,
+            Err(StreamControlError::Authority)
+        ));
+        assert_eq!(*mixer.lock().await, 0);
+    }
+}
