+        let departed=s.f.b.clone();
+        let audio=departed.audio_consumer.lock().unwrap().as_ref().unwrap().upgrade().unwrap().stamp();
+        let(held,consumer)=hold_retirement(&departed);
+        let scene=s.scene.clone();let id=departed.connection.clone();
+        let(worker,done)=control_thread(move||async move {if clear {scene.clear();}else {scene.remove(&id);}Ok::<_,StreamControlError>(())});
+        let bound=Instant::now()+Duration::from_secs(1);
+        while !(consumer.cancel.is_cancelled()&&audio.cancellation.is_cancelled())&&Instant::now()<bound {std::thread::yield_now();}
+        let cancelled=consumer.cancel.is_cancelled()&&audio.cancellation.is_cancelled();
+        let pending=done.try_recv().is_err();
+        let free_members=s.scene.members.try_lock().is_ok();let free_audiences=s.scene.audiences.try_lock().is_ok();let free_selection=s.scene.selections.try_lock().is_ok();
