+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn terminal_clear_drains_captured_orphan_bookkeeping_and_refuses_later_same_key_arcs() {
+    let s=Scene::new(&[Medium::Audio,Medium::Video]).await;
+    let id=ConnectionId::from_string("orphan-not-admitted");
+    s.f.policy.0.write().await.owners.insert(id.as_str().into(),owner(id.as_str()));
+    let orphan=StreamController::new(s.f.a.conversation.clone(),s.f.a.session.clone(),id.clone(),principal(id.as_str()),s.f.a.policy.clone(),Adapter::new(),s.f.a.handles.clone(),16).unwrap();
+    assert!(!s.scene.members.lock().unwrap().contains_key(&id));
+    let preparation=later_preparation(&orphan);let selection=Arc::new(crate::staged_streams::selection_intent::SelectionProgram::default());
+    s.scene.audiences.lock().unwrap().preparations.insert(id.clone(),preparation.clone());
+    s.scene.selections.lock().unwrap().insert(id.clone(),selection.clone());
+    let exact=terminal_set(&s);let bookkeeping=s.scene.try_capture_clear_bookkeeping().unwrap();
+    let successor_selection=Arc::new(crate::staged_streams::selection_intent::SelectionProgram::default());
+    s.scene.selections.lock().unwrap().insert(id.clone(),successor_selection.clone());
+    let changed_selection=s.scene.try_clear_members(&exact,&bookkeeping);
+    let kept_successor_selection=s.scene.selections.lock().unwrap().get(&id).is_some_and(|value|Arc::ptr_eq(value,&successor_selection));
+    let kept_original_preparation=s.scene.audiences.lock().unwrap().preparations.get(&id).is_some_and(|value|Arc::ptr_eq(value,&preparation));
+    s.scene.selections.lock().unwrap().insert(id.clone(),selection.clone());
+    let successor_preparation=later_preparation(&orphan);
+    s.scene.audiences.lock().unwrap().preparations.insert(id.clone(),successor_preparation.clone());
+    let changed_preparation=s.scene.try_clear_members(&exact,&bookkeeping);
+    let kept_successor_preparation=s.scene.audiences.lock().unwrap().preparations.get(&id).is_some_and(|value|Arc::ptr_eq(value,&successor_preparation));
+    let still_members=s.scene.members.lock().unwrap().len();
+    let consumer=s.f.b.scene_consumer.lock().unwrap().as_ref().unwrap().upgrade().unwrap();let audio=s.f.b.audio_consumer.lock().unwrap().as_ref().unwrap().upgrade().unwrap().stamp();
+    let no_cancel=!consumer.cancel.is_cancelled()&&!audio.cancellation.is_cancelled();
+    s.scene.audiences.lock().unwrap().preparations.insert(id.clone(),preparation);
+    for original in &exact {original.begin_retirement();}
+    let drained=s.scene.try_clear_members(&exact,&bookkeeping);
+    let empty=s.scene.members.lock().unwrap().is_empty()&&s.scene.selections.lock().unwrap().is_empty()&&s.scene.audiences.lock().unwrap().preparations.is_empty();
+    let repeated=s.scene.try_clear_members(&exact,&bookkeeping);
+    let remaining=cleanup(&[s.f.a.clone(),s.f.b.clone(),orphan]).await;
+    assert!(matches!(changed_selection,Err(StreamControlError::Authority))&&kept_successor_selection&&kept_original_preparation);
+    assert!(matches!(changed_preparation,Err(StreamControlError::Authority))&&kept_successor_preparation&&still_members==2&&no_cancel);
+    assert!(drained.is_ok()&&empty&&repeated.is_ok(),"terminal success must drain exact captured orphan keys too");
+    assert!(remaining.iter().all(|count|*count==0));
