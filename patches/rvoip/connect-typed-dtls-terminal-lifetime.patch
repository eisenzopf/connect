+            match RvoipPeerConnection::new(&config, role).await {
+                Ok(peer) => owners.push(peer),
+                Err(error) => {
+                    for peer in &owners {
+                        let _ = peer.close().await;
+                    }
+                    panic!("original peer setup: {error}");
+                }
+            }
+        }
+        let observed: Result<(bool, bool, bool)> = async {
+            for i in [0, 2] {
+                owners[i].add_local_audio_track().await?;
+                let offer = owners[i].create_offer_and_gather().await?;
+                let answer = owners[i + 1].accept_offer_and_gather(&offer).await?;
+                owners[i].set_remote_answer(&answer).await?;
+                tokio::try_join!(
+                    owners[i].wait_connected(Duration::from_secs(3)),
+                    owners[i + 1].wait_connected(Duration::from_secs(3))
