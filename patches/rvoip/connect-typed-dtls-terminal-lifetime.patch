+//! Real SDP/ICE/DTLS handshake and original encrypted terminal packets.
+//! No test writes a peer failed flag or invents encrypted payload bytes.
+use super::*;
+use crate::peer_connection::RTCPeerConnectionBuilder;
+use crate::peer_connection::configuration::setting_engine::SettingEngine;
+use crate::peer_connection::transport::dtls::state::RTCDtlsTransportState;
+use crate::peer_connection::transport::{
+    CandidateConfig, CandidateHostConfig, RTCDtlsRole, RTCIceCandidate, RTCIceCandidateInit,
+};
+use ::interceptor::Packet;
+use sansio::Protocol;
+use shared::{TransportContext, TransportProtocol};
+use std::net::SocketAddr;
+
+struct Pair {
+    a: RTCPeerConnection,
+    b: RTCPeerConnection,
+    addresses: [SocketAddr; 2],
+    original_stun: bytes::BytesMut,
+}
+fn peer(address: SocketAddr, role: RTCDtlsRole) -> RTCPeerConnection {
+    let mut settings = SettingEngine::default();
+    settings.set_answering_dtls_role(role).unwrap();
+    let mut peer = RTCPeerConnectionBuilder::new()
+        .with_setting_engine(settings)
+        .build()
+        .unwrap();
+    let candidate = CandidateHostConfig {
+        base_config: CandidateConfig {
+            network: "udp".into(),
+            address: address.ip().to_string(),
+            port: address.port(),
+            component: 1,
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+    .new_candidate_host()
+    .unwrap();
+    peer.add_local_candidate(RTCIceCandidate::from(&candidate).to_json().unwrap())
+        .unwrap();
+    peer
+}
+fn incoming(
+    peer: &mut RTCPeerConnection,
+    local: SocketAddr,
+    remote: SocketAddr,
+    message: bytes::BytesMut,
+) {
+    peer.handle_read(TaggedBytesMut {
+        now: Instant::now(),
+        transport: TransportContext {
+            local_addr: local,
+            peer_addr: remote,
+            ecn: None,
+            transport_protocol: TransportProtocol::UDP,
+        },
+        message,
+    })
+    .unwrap();
+}
+fn pump(
+    source: &mut RTCPeerConnection,
+    target: &mut RTCPeerConnection,
+    local: SocketAddr,
+    remote: SocketAddr,
+) -> Option<bytes::BytesMut> {
+    let mut original_stun = None;
+    let mut packets = 0;
+    while let Some(write) = source.poll_write() {
+        packets += 1;
+        assert!(packets <= 512, "original handshake packet bound");
+        if write.message.first().is_some_and(|byte| *byte <= 3) && original_stun.is_none() {
+            original_stun = Some(write.message.clone());
+        }
+        incoming(target, local, remote, write.message);
+    }
+    original_stun
+}
+fn drain_events(peer: &mut RTCPeerConnection) -> Vec<RTCPeerConnectionState> {
+    let mut states = Vec::new();
+    while let Some(event) = peer.poll_event() {
+        if let RTCPeerConnectionEvent::OnConnectionStateChangeEvent(state) = event {
+            states.push(state);
+        }
+    }
+    states
+}
+impl Pair {
+    fn handshake(base_port: u16) -> Self {
+        let addresses = [
+            SocketAddr::from(([127, 0, 0, 1], base_port)),
+            SocketAddr::from(([127, 0, 0, 1], base_port + 1)),
+        ];
+        let mut a = peer(addresses[0], RTCDtlsRole::Server);
+        let mut b = peer(addresses[1], RTCDtlsRole::Client);
+        a.create_data_channel("original-terminal-fixture", None)
+            .unwrap();
+        let offer = a.create_offer(None).unwrap();
+        a.set_local_description(offer.clone()).unwrap();
+        b.set_remote_description(offer).unwrap();
+        let answer = b.create_answer(None).unwrap();
+        b.set_local_description(answer.clone()).unwrap();
+        a.set_remote_description(answer).unwrap();
+        for (owner, remote) in [(&mut a, addresses[1]), (&mut b, addresses[0])] {
+            owner
+                .add_remote_candidate(RTCIceCandidateInit {
+                    candidate: format!(
+                        "candidate:1 1 udp 2130706431 {} {} typ host",
+                        remote.ip(),
+                        remote.port()
+                    ),
+                    ..Default::default()
+                })
+                .unwrap();
+        }
+        let cutoff = Instant::now() + Duration::from_secs(3);
+        let mut original_stun = None;
+        loop {
+            assert!(
+                Instant::now() < cutoff,
+                "original local SDP/ICE/DTLS handshake cutoff"
+            );
+            let now = Instant::now();
+            a.handle_timeout(now).unwrap();
+            b.handle_timeout(now).unwrap();
+            let a_stun = pump(&mut a, &mut b, addresses[1], addresses[0]);
+            let b_stun = pump(&mut b, &mut a, addresses[0], addresses[1]);
+            if original_stun.is_none() {
+                original_stun = b_stun.or(a_stun);
+            }
+            drain_events(&mut a);
+            drain_events(&mut b);
+            if a.peer_connection_state == RTCPeerConnectionState::Connected
+                && b.peer_connection_state == RTCPeerConnectionState::Connected
+            {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        assert_eq!(a.dtls_transport().state, RTCDtlsTransportState::Connected);
+        assert_eq!(b.dtls_transport().state, RTCDtlsTransportState::Connected);
+        Self {
+            a,
+            b,
+            addresses,
+            original_stun: original_stun.expect("original ICE binding datagram"),
+        }
+    }
+    fn encrypted_close_notify(&mut self) -> Vec<bytes::BytesMut> {
+        let endpoint = self.a.dtls_transport_mut().dtls_endpoint.as_mut().unwrap();
+        // Existing original endpoint API emits real protected DTLS records.
+        // RTCDtlsTransport::stop currently omits this call; that separate local
+        // close behavior is intentionally not changed by this candidate.
+        endpoint.close().unwrap();
+        let mut packets = Vec::new();
+        while let Some(transmit) = endpoint.poll_transmit() {
+            assert_eq!(transmit.message[0], 21, "DTLS alert content type");
+            assert!(
+                u16::from_be_bytes([transmit.message[3], transmit.message[4]]) > 0,
+                "encrypted established epoch"
+            );
+            packets.push(transmit.message);
+        }
+        assert!(!packets.is_empty() && packets.len() <= 4);
+        packets
+    }
+}
+impl Drop for Pair {
+    fn drop(&mut self) {
+        let _ = self.a.close();
+        let _ = self.b.close();
+    }
+}
+#[test]
+fn encrypted_close_notify_after_real_handshake_ends_only_the_original_rtc_transport() {
+    let mut original = Pair::handshake(19000);
+    let mut unrelated = Pair::handshake(19100);
+    use shared::marshal::Marshal;
+    let original_rtp = |sequence_number| rtp::Packet {
+        header: rtp::Header {
+            version: 2,
+            payload_type: 111,
+            sequence_number,
+            timestamp: u32::from(sequence_number) * 960,
+            ssrc: 0x10203040,
+            ..Default::default()
+        },
+        payload: bytes::Bytes::from_static(&[0xf8, 0xff, 0xfe]),
+    };
+    let secure = original
+        .a
+        .pipeline_context
+        .srtp_handler_context
+        .local_srtp_context
+        .as_mut()
+        .unwrap();
+    let preceding = secure
+        .encrypt_rtp(&original_rtp(701).marshal().unwrap())
+        .unwrap();
+    // This original, authenticated, previously unseen packet is held in flight
+    // until after CloseNotify. It is neither re-encrypted nor replayed.
+    let post_close = secure
+        .encrypt_rtp(&original_rtp(702).marshal().unwrap())
+        .unwrap();
+    {
+        let mut receiver = original.b.get_srtp_handler();
+        receiver
+            .handle_read(TaggedRTCMessageInternal {
+                now: Instant::now(),
+                transport: TransportContext::default(),
+                message: RTCMessageInternal::Rtp(RTPMessage::Raw(preceding)),
+            })
+            .unwrap();
+        assert!(matches!(receiver.poll_read().map(|message|message.message),
+            Some(RTCMessageInternal::Rtp(RTPMessage::Packet(Packet::Rtp(packet)))) if packet.header.sequence_number == 701));
+    }
+    // Queue genuine already-encrypted outbound media before the terminal read.
+    // A final queue guard must suppress it even though encryption already ran.
+    let queued_rtp = original
+        .b
+        .pipeline_context
+        .srtp_handler_context
+        .local_srtp_context
+        .as_mut()
+        .unwrap()
+        .encrypt_rtp(&original_rtp(703).marshal().unwrap())
+        .unwrap();
+    let queued_rtcp = original
+        .b
+        .pipeline_context
+        .srtp_handler_context
+        .local_srtp_context
+        .as_mut()
+        .unwrap()
+        .encrypt_rtcp(
+            &rtcp::packet::marshal(&[Box::new(rtcp::sender_report::SenderReport {
+                ssrc: 0x10203040,
+                ..Default::default()
+            })])
+            .unwrap(),
+        )
+        .unwrap();
+    let endpoint = original
+        .b
+        .dtls_transport_mut()
+        .dtls_endpoint
+        .as_mut()
+        .unwrap();
+    let remote = *endpoint.get_connections_keys().next().unwrap();
+    endpoint
+        .write(remote, b"original pending application data")
+        .unwrap();
+    let mut queued_dtls = Vec::new();
+    while let Some(transmit) = endpoint.poll_transmit() {
+        assert_eq!(
+            transmit.message[0], 23,
+            "original encrypted application record"
+        );
+        queued_dtls.push(transmit.message);
+    }
+    assert!(!queued_dtls.is_empty());
+    let original_stun = original.original_stun.clone();
+    let packets = original.encrypted_close_notify();
+    // A coalesced datagram must preserve the actual alert byte-for-byte while
+    // removing every original encrypted application record beside it.
+    let mut coalesced = packets[0].clone();
+    for application in &queued_dtls {
+        coalesced.extend_from_slice(application);
+    }
+    let expected_alert = packets[0].clone();
+    for message in [
+        queued_rtp,
+        queued_rtcp,
+        queued_dtls.remove(0),
+        coalesced,
+        original_stun.clone(),
+    ] {
+        original
+            .b
+            .pipeline_context
+            .write_outs
+            .push_back(TaggedBytesMut {
+                now: Instant::now(),
+                transport: TransportContext::default(),
+                message,
+            });
+    }
+    for packet in &packets {
+        // Different secure transport cannot authenticate the original alert.
+        incoming(
+            &mut unrelated.b,
+            unrelated.addresses[1],
+            unrelated.addresses[0],
+            packet.clone(),
+        );
+        incoming(
+            &mut original.b,
+            original.addresses[1],
+            original.addresses[0],
+            packet.clone(),
+        );
+    }
+    assert_eq!(
+        original.b.dtls_transport().state,
+        RTCDtlsTransportState::Failed
+    );
+    assert_eq!(
+        original.b.pipeline_context.stats.transport.dtls_state,
+        RTCDtlsTransportState::Failed
+    );
+    assert!(
+        original
+            .b
+            .pipeline_context
+            .srtp_handler_context
+            .local_srtp_context
+            .is_none()
+    );
+    assert!(
+        original
+            .b
+            .pipeline_context
+            .srtp_handler_context
+            .remote_srtp_context
+            .is_none()
+    );
+    incoming(
+        &mut original.b,
+        original.addresses[1],
+        original.addresses[0],
+        post_close.clone(),
+    );
+    assert!(
+        original.b.poll_read().is_none(),
+        "post-terminal original ciphertext reached application media"
+    );
+    {
+        let mut receiver = original.b.get_srtp_handler();
+        assert!(
+            receiver
+                .handle_read(TaggedRTCMessageInternal {
+                    now: Instant::now(),
+                    transport: TransportContext::default(),
+                    message: RTCMessageInternal::Rtp(RTPMessage::Raw(post_close)),
+                })
+                .is_err(),
+            "terminal secure context authenticated previously unseen RTP"
+        );
+        assert!(receiver.poll_read().is_none());
+    }
+    let mut outbound = Vec::new();
+    while let Some(write) = original.b.poll_write() {
+        assert!(outbound.len() < 512, "original bounded outbound queue");
+        assert!(
+            !demuxer::match_srtp(&write.message),
+            "queued secure RTP emitted after terminal"
+        );
+        if demuxer::match_dtls(&write.message) {
+            use ::dtls::content::ContentType;
+            use ::dtls::record_layer::record_layer_header::RecordLayerHeader;
+            let mut records = write.message.as_ref();
+            while !records.is_empty() {
+                let header = RecordLayerHeader::unmarshal(&mut records).unwrap();
+                assert_ne!(
+                    header.content_type,
+                    ContentType::ApplicationData,
+                    "queued DTLS application record emitted after terminal"
+                );
+                // unmarshal consumed exactly the original header.
+                let content_len = usize::from(header.content_len);
+                assert!(content_len <= records.len());
+                records = &records[content_len..];
+            }
+        }
+        outbound.push(write.message);
+    }
+    assert!(
+        outbound.contains(&original_stun),
+        "original STUN datagram was discarded"
+    );
+    assert!(
+        outbound.contains(&expected_alert),
+        "coalesced alert bytes were changed/discarded"
+    );
+    let first = drain_events(&mut original.b);
+    assert_eq!(
+        first
+            .iter()
+            .filter(|&&state| state == RTCPeerConnectionState::Failed)
+            .count(),
+        1
+    );
+    for packet in packets {
+        incoming(
+            &mut original.b,
+            original.addresses[1],
+            original.addresses[0],
+            packet,
+        );
+    }
+    assert!(
+        !drain_events(&mut original.b).contains(&RTCPeerConnectionState::Failed),
+        "same terminal alert emitted twice"
+    );
+    assert_eq!(
+        unrelated.b.dtls_transport().state,
+        RTCDtlsTransportState::Connected
+    );
+    assert_eq!(
+        unrelated.b.peer_connection_state,
+        RTCPeerConnectionState::Connected
+    );
+    assert!(!drain_events(&mut unrelated.b).contains(&RTCPeerConnectionState::Failed));
+    let unrelated_media = unrelated
+        .a
+        .pipeline_context
+        .srtp_handler_context
+        .local_srtp_context
+        .as_mut()
+        .unwrap()
+        .encrypt_rtp(&original_rtp(704).marshal().unwrap())
+        .unwrap();
+    let mut healthy = unrelated.b.get_srtp_handler();
+    healthy
+        .handle_read(TaggedRTCMessageInternal {
+            now: Instant::now(),
+            transport: TransportContext::default(),
+            message: RTCMessageInternal::Rtp(RTPMessage::Raw(unrelated_media)),
+        })
+        .unwrap();
+    assert!(matches!(healthy.poll_read().map(|message|message.message),
+        Some(RTCMessageInternal::Rtp(RTPMessage::Packet(Packet::Rtp(packet)))) if packet.header.sequence_number == 704));
+}
+#[test]
+fn typed_fatal_or_close_is_terminal_but_other_read_errors_and_handlers_are_not() {
+    assert!(known_terminal_dtls_read(
+        "DtlsHandler",
+        &Error::ErrAlertFatalOrClose
+    ));
+    assert!(!known_terminal_dtls_read(
+        "SrtpHandler",
+        &Error::ErrAlertFatalOrClose
+    ));
+    for error in [
+        Error::ErrTimeout,
+        Error::ErrDtlsTransportNotStarted,
+        Error::ErrBufferClosed,
+    ] {
+        assert!(!known_terminal_dtls_read("DtlsHandler", &error));
+    }
+}
+#[test]
+fn malformed_dtls_record_preserves_a_real_healthy_transport() {
+    let mut original = Pair::handshake(19200);
+    incoming(
+        &mut original.b,
+        original.addresses[1],
+        original.addresses[0],
+        bytes::BytesMut::from(&[22, 254, 253, 0][..]),
+    );
+    assert_eq!(
+        original.b.dtls_transport().state,
+        RTCDtlsTransportState::Connected
+    );
+    assert_eq!(
+        original.b.peer_connection_state,
+        RTCPeerConnectionState::Connected
+    );
+    assert!(!drain_events(&mut original.b).contains(&RTCPeerConnectionState::Failed));
