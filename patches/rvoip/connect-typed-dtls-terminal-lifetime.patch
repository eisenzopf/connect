+// Only the DTLS parser can report this merged, known-terminal alert. Other
+// protocol/transport read errors keep their existing nonterminal behavior.
+fn known_terminal_dtls_read(handler: &str, error: &Error) -> bool {
+    handler == "DtlsHandler" && matches!(error, Error::ErrAlertFatalOrClose)
+}
+
+// This queue belongs to one RTC peer/secure transport. Preserve unrelated
+// protocols and each control record's original bytes, including when DTLS
+// records are coalesced. Unknown/malformed suffixes retain their prior behavior.
+fn terminal_write(message: bytes::BytesMut) -> Option<bytes::BytesMut> {
+    use ::dtls::content::ContentType;
+    use ::dtls::record_layer::record_layer_header::{RECORD_LAYER_HEADER_SIZE, RecordLayerHeader};
+    if demuxer::match_srtp(&message) {
+        return None;
+    }
+    if !demuxer::match_dtls(&message) {
+        return Some(message);
+    }
+    let mut control = bytes::BytesMut::new();
+    let mut remaining = message.as_ref();
+    while !remaining.is_empty() {
+        let mut reader = remaining;
+        let Ok(header) = RecordLayerHeader::unmarshal(&mut reader) else {
+            control.extend_from_slice(remaining);
+            break;
+        };
+        let record_len = RECORD_LAYER_HEADER_SIZE + usize::from(header.content_len);
+        if record_len > remaining.len() {
+            control.extend_from_slice(remaining);
+            break;
+        }
+        if header.content_type != ContentType::ApplicationData {
+            control.extend_from_slice(&remaining[..record_len]);
+        }
+        remaining = &remaining[record_len..];
+    }
+    (!control.is_empty()).then_some(control)
+}
