+//! Actual warm setup/F, original source+target State exclusions and real
+//! policy lease Drop. The adapter callback is modeled, not native readiness.
+use super::*;
+use std::sync::mpsc;
+
+enum HoldCommand {Acquire,Release}
+struct StateHold {command:mpsc::Sender<HoldCommand>,entered:Option<mpsc::Receiver<()>>,thread:Option<std::thread::JoinHandle<()>>}
+impl StateHold {
+    fn new(controller:Arc<StreamController>)->Self {
+        let(command,receive)=mpsc::channel();let(sent,entered)=mpsc::sync_channel(1);
+        let thread=std::thread::spawn(move||{
+            if !matches!(receive.recv(),Ok(HoldCommand::Acquire)) {return;}
+            let held=controller.state.lock().unwrap();let _=sent.send(());let _=receive.recv();drop(held);
+        });
+        Self {command,entered:Some(entered),thread:Some(thread)}
+    }
+    fn callback(&mut self)->Box<dyn FnOnce()+Send> {
+        let command=self.command.clone();let entered=self.entered.take().unwrap();
+        Box::new(move||{command.send(HoldCommand::Acquire).unwrap();entered.recv_timeout(Duration::from_secs(1)).expect("actual State owner entered");})
+    }
+    fn acquire(&mut self) {(self.callback())();}
+    fn release(&mut self) {let _=self.command.send(HoldCommand::Release);if let Some(thread)=self.thread.take(){thread.join().unwrap();}}
+}
+impl Drop for StateHold {fn drop(&mut self){self.release();}}
+fn retry<'a>(value:ControlResult<PublicVideoWarmInvocation<'a>>)->PublicVideoWarmRetry<'a> {
+    match value.unwrap() {PublicVideoWarmInvocation::DefinitelyUnstarted(retry)=>retry,PublicVideoWarmInvocation::Complete=>panic!("actual metadata hold must precede callback entry")}
+}
+async fn invoke(owner:&PublicVideoWarmPreparation,hint:bool)->ControlResult<PublicVideoWarmInvocation<'_>> {
+    if hint {owner.request_initial_picture().await}else{owner.start().await}
+}
+fn calls(room:&ManagedRoom,source:&ConnectionId,target:&ConnectionId,hint:bool)->usize {
+    if hint {room.nodes[source].backend.initial_picture_calls.load(Ordering::Acquire)}else{room.nodes[target].backend.public_warm_starts.load(Ordering::Acquire)}
+}
