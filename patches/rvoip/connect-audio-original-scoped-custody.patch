+#[tokio::test]
+async fn original_audio_private_audience_cannot_adopt_prechange_input_from_either_capture_path() {
+    for busy in [false,true] {
+        let mut fixture=OriginalVisual::new(Medium::Video,true,busy).await;
+        let mut owned=Box::pin(async {
+            fixture.room.add("consult",None,true).await;
+            let plan=fixture.room.begin_plan();let grant=fixture.room.grant(Approval::Audience(plan.clone())).await;
+            let cutoff=tokio::time::Instant::from_std(fixture.received+Duration::from_millis(200));
+            fixture.room.scene.apply_audio_audience(plan,cutoff,CancellationToken::new(),&grant).await.unwrap();drop(grant);
+            assert!(fixture.received.elapsed()<Duration::from_millis(200));
+            let result=fixture.original.try_publish_clocked(|_|None);
+            assert!(matches!(&result,Err(StreamControlError::NotReady|StreamControlError::Model(MediaTransitionError::Conflict))),"pre-audience original adopted new scope: busy={busy} {result:?}");
+            assert_eq!(fixture.port.ingress_capacity().0,fixture.port.ingress_capacity().1);
+            // New current microphone data may reach ONLY the actual private
+            // receiver. It cannot substitute for rejection of the old original.
+            fixture.room.publish("alice",1800).unwrap();fixture.room.tick();fixture.room.heard("consult",1800).await;fixture.room.silent(&["bob"]);
+            assert!(matches!(fixture.original.try_publish_clocked(|_|None),Err(StreamControlError::Cancelled)));
+        });
+        let result=std::future::poll_fn(|cx|match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||std::future::Future::poll(owned.as_mut(),cx))) {
+            Ok(std::task::Poll::Pending)=>std::task::Poll::Pending,
+            Ok(std::task::Poll::Ready(value))=>std::task::Poll::Ready(Ok(value)),
+            Err(error)=>std::task::Poll::Ready(Err(error)),
+        }).await;drop(owned);
+        let mut cleanup=Vec::new();for node in fixture.room.nodes.values() {cleanup.push(node.controller.shutdown(deadline()).await);}
+        assert!(cleanup.into_iter().all(|remaining|remaining==0));assert!(fixture.room.nodes.values().all(|node|node.adapter.outstanding.load(Ordering::Acquire)==0));
+        if let Err(error)=result {std::panic::resume_unwind(error)}
+    }
