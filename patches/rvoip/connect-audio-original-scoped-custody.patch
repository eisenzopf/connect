+#[tokio::test]
+async fn original_audio_programme_clear_before_publication_fences_both_capture_paths() {
+    for busy in [false,true] {
+        let mut fixture=OriginalVisual::new(Medium::Video,true,busy).await;
+        // Work borrows the actual room; cleanup is explicit below after drop.
+        let mut owned=Box::pin(async {
+            let revision=fixture.source.revision();let cutoff=tokio::time::Instant::from_std(fixture.received+Duration::from_millis(200));
+            fixture.room.scene.change_subscriptions(&fixture.source.connection,revision,AudioSubscriptionChange::Clear,cutoff,CancellationToken::new(),None).await.unwrap();
+            assert!(fixture.source.revision()>revision);assert!(fixture.received.elapsed()<Duration::from_millis(200));
+            let before=fixture.room.domain.fresh.load(Ordering::Acquire);
+            let result=fixture.original.try_publish_clocked(|_|None);
+            assert!(matches!(&result,Err(StreamControlError::Model(MediaTransitionError::Conflict))),"same original captured a newer audio programme: busy={busy} {result:?}");
+            assert_eq!(fixture.room.domain.fresh.load(Ordering::Acquire),before,"invalid original scope borrowed a new current grant");
+            assert_eq!(fixture.port.ingress_capacity().0,fixture.port.ingress_capacity().1);assert!(fixture.room.nodes.get_mut("bob").unwrap().out.try_recv().is_err());
+            fixture.room.publish("alice",1800).unwrap();fixture.room.tick();fixture.room.heard("bob",1800).await;
+            assert!(matches!(fixture.original.try_publish_clocked(|_|None),Err(StreamControlError::Cancelled)));
+        });
+        let result=std::future::poll_fn(|cx|match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||std::future::Future::poll(owned.as_mut(),cx))) {
+            Ok(std::task::Poll::Pending)=>std::task::Poll::Pending,
+            Ok(std::task::Poll::Ready(value))=>std::task::Poll::Ready(Ok(value)),
+            Err(error)=>std::task::Poll::Ready(Err(error)),
+        }).await;drop(owned);
+        let mut cleanup=Vec::new();for node in fixture.room.nodes.values() {cleanup.push(node.controller.shutdown(deadline()).await);}
+        assert!(cleanup.into_iter().all(|remaining|remaining==0));assert!(fixture.room.nodes.values().all(|node|node.adapter.outstanding.load(Ordering::Acquire)==0));
+        if let Err(error)=result {std::panic::resume_unwind(error)}
