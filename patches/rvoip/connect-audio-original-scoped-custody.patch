+/// Actual current-policy model turn, not a pre-call revision mismatch. Refuse
+/// this callback without IO, then reauthorize only the SAME original input.
+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn original_audio_video_policy_race_retries_same_scoped_input_without_old_grant() {
+    for busy in [false,true] {
+        let mut fixture=OriginalVisual::new(Medium::Video,true,busy).await;
+        let source=fixture.source.clone();let runtime=tokio::runtime::Handle::current();let cutoff=tokio::time::Instant::from_std(fixture.received+Duration::from_millis(200));
+        let callback:OriginalVisualPolicyAction=Box::new(move|lease| {
+            drop(source.state.try_lock().expect("audio policy callback held model State"));
+            let control=std::thread::spawn(move||runtime.block_on(async move {
+                let ids=[desired(Medium::Video).logical_id].into_iter().collect();let revision=source.revision();
+                source.set_media_gate(revision,&ids,StreamGateAction::Hold {direction:StreamDirection::Receive},cutoff).await?;
+                Ok::<(),StreamControlError>(())
+            })).join().expect("original video-only control worker panicked");
+            control?;Ok(lease)
+        });
+        let action=ActionOwner(fixture.room.domain.clone());
+        assert!(fixture.room.domain.original_visual_policy_action.lock().unwrap().replace(callback).is_none());
+        let mut owned_work=Box::pin(async {
+            let first=fixture.original.try_publish_clocked(|_|None);fixture.assert_refused_without_readers();
+            assert!(matches!(&first,Err(StreamControlError::MetadataBusy)),"unchanged audio model turn must be retryable without IO: {first:?}");
+            assert!(fixture.received.elapsed()<Duration::from_millis(200));
+            let before=fixture.room.domain.fresh.load(Ordering::Acquire);
+            fixture.original.try_publish_clocked(|_|None).unwrap();
+            assert!(fixture.room.domain.fresh.load(Ordering::Acquire)>before,"same original retry reused old policy grant");
+            fixture.room.tick();fixture.room.heard("bob",1800).await;
+            assert!(matches!(fixture.original.try_publish_clocked(|_|None),Err(StreamControlError::Cancelled)));
+            assert!(fixture.room.nodes.get_mut("bob").unwrap().out.try_recv().is_err(),"same original duplicated actual audio output");
+        });
+        let work=std::future::poll_fn(|cx|match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||std::future::Future::poll(owned_work.as_mut(),cx))) {
+            Ok(std::task::Poll::Pending)=>std::task::Poll::Pending,
+            Ok(std::task::Poll::Ready(value))=>std::task::Poll::Ready(Ok(value)),
+            Err(error)=>std::task::Poll::Ready(Err(error)),
+        }).await;
+        drop(owned_work);
+        drop(action); // Break callback/domain/owner custody before all cleanup.
+        let mut cleanup=Vec::new();for node in fixture.room.nodes.values() {cleanup.push(node.controller.shutdown(deadline()).await);}
+        assert!(cleanup.into_iter().all(|remaining|remaining==0));assert!(fixture.room.nodes.values().all(|node|node.adapter.outstanding.load(Ordering::Acquire)==0));
+        if let Err(error)=work {std::panic::resume_unwind(error)}
+    }
+}
