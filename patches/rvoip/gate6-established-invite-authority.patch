 use std::sync::Arc;
 use std::time::{Duration, Instant};
 use tracing::{debug, error, info, warn};
+
+// Bind this transaction's immutable request to the actual confirmed dialog.
+// A non-2xx ACK completes that admitted transaction without authorizing another
+// INVITE; the host still evaluates every INVITE/retransmission independently.
+struct DialogInviteWritePolicy {
+    authority: Arc<dyn crate::transaction::egress::ClientRequestWriteAuthority>,
+    call_id: String,
+    local_tag: Option<String>,
+    remote_tag: Option<String>,
+}
+#[async_trait::async_trait]
+impl crate::transaction::egress::ClientRequestWriteAuthority for DialogInviteWritePolicy {
+    async fn write(
+        &self,
+        scope: &crate::transaction::egress::ClientRequestWriteScope<'_>,
+        io: crate::transaction::egress::ClientRequestWriteFuture<'_>,
+    ) -> rvoip_sip_transport::Result<rvoip_sip_transport::TransportRoute> {
+        let rvoip_sip_core::Message::Request(request) = scope.message else {
+            return Err(rvoip_sip_transport::Error::InvalidState(
+                "dialog INVITE write refused".into(),
+            ));
+        };
+        if self.local_tag.is_none()
+            || self.remote_tag.is_none()
+            || request.call_id().map(|id| id.value()).as_deref() != Some(self.call_id.as_str())
+            || request.from().and_then(|from| from.tag()) != self.local_tag.as_deref()
+            || request.to().and_then(|to| to.tag()) != self.remote_tag.as_deref()
+        {
+            return Err(rvoip_sip_transport::Error::InvalidState(
+                "dialog INVITE identity refused".into(),
+            ));
+        }
+        match request.method() {
+            Method::Invite => self.authority.write(scope, io).await,
+            Method::Ack => io.await,
+            _ => Err(rvoip_sip_transport::Error::InvalidState(
+                "dialog INVITE method refused".into(),
+            )),
+        }
+    }
+}
 
