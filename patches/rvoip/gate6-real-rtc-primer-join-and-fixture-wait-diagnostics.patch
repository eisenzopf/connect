+// Preserve the original predicate/deadline. Only a false original poll gets
+// an extra sequential diagnostic sample; it is not an atomic permission proof.
+async fn diagnosed_until(
+    s: &Scene, c: &Browser, mode: &str, stage: &str, mut predicate: impl FnMut() -> bool,
+) {
+    trace_stage(mode, stage);
+    let mut last = None;
+    let result = std::panic::AssertUnwindSafe(core_fixture::until(|| {
+        let ready = predicate();
+        if !ready {
+            last = Some((s.core.orch.participant_capacity(&s.core.session),
+                c.adapter.is_connection_live(&c.id()),
+                c.owner.as_ref().map(|owner| owner.peer().snapshot().connections),
+                s.live[0].peer.snapshot().connections));
+        }
+        ready
+    })).catch_unwind().await;
+    if let Err(error) = result {
+        eprintln!("RTC fixture failure mode={mode} stage={stage} last_capacity_adapter_live_rtc_peer_connections_old_native_peer_connections={last:?}");
+        std::panic::resume_unwind(error);
+    }
+}
+
+async fn diagnosed_scene_stop(s: &Scene, c: &Browser, peer: Option<&Arc<PeerAdmission>>, mode: &str) {
+    trace_stage(mode, "original-old-scene-stop");
+    let result = std::panic::AssertUnwindSafe(s.stop()).catch_unwind().await;
+    if let Err(error) = result {
+        eprintln!("RTC fixture failure mode={mode} stage=old-scene-stop at_failure_capacity={:?} adapter_live={:?} rtc_peer_connections={:?} old_native_peer_connections={:?}",
+            s.core.orch.participant_capacity(&s.core.session),
+            c.pending.as_ref().map(|pending| c.adapter.is_connection_live(&pending.intent().replacement)),
+            peer.map(|peer| peer.snapshot().connections),
+            s.live.iter().map(|live| live.peer.snapshot().connections).collect::<Vec<_>>());
+        std::panic::resume_unwind(error);
+    }
+}
