+            if mode == 3 { &wrong } else { document },
+            &key,
+            jsonwebtoken::Algorithm::RS256,
+            CertificateReference::X5u("https://certificate.invalid/fixture-key".into()),
+        )
+        .unwrap();
+        if mode == 2 {
+            let mut sig = signed.signatures[0].signature.clone().into_bytes();
+            sig[0] = if sig[0] == b'A' { b'B' } else { b'A' };
+            signed.signatures[0].signature = String::from_utf8(sig).unwrap();
+        }
+        Ok(Some(rvoip_core::records::RecordSignature {
+            document: signed,
+            trusted_key: TrustedKey::new(
+                trusted,
+                if mode == 4 {
+                    jsonwebtoken::Algorithm::RS512
+                } else {
+                    jsonwebtoken::Algorithm::RS256
+                },
+            ),
+            signer: "fixture-record-key".into(),
+        }))
+    }
+    fn current(&self, r: &RecordViewRequest) -> RecordViewResult<BTreeSet<String>> {
+        if r != &self.request
+            || r.scope() != &self.held.scope
+            || r.viewer() != &self.held.viewer
+            || !self.held.original.current()
+        {
+            return Err(RecordViewError::Authority);
+        }
+        Ok((*self.held.sources).clone())
+    }
+}
+fn source_lease(
+    r: &RecordViewRequest,
+    a: &AuthorityLease,
+) -> Result<Box<dyn RecordViewLease>, DispatchError> {
+    let held = a
+        .authority::<Arc<Inner>>()
+        .ok_or(DispatchError::Authority)?;
+    if r.scope() != &held.scope || r.viewer() != &held.viewer {
+        return Err(DispatchError::Authority);
+    }
+    Ok(Box::new(Sources {
+        request: r.clone(),
+        held: held.clone(),
+    }))
+}
+struct FetchPolicy {
+    base: Arc<Policy>,
+    backend: Arc<Backend>,
+    viewer: ParticipantId,
+    sources: Arc<RwLock<BTreeSet<String>>>,
+    references: Option<Arc<RecordReferenceRegistry>>,
+    inline_limit: usize,
+    signing: std::sync::atomic::AtomicU8,
+}
+impl FetchPolicy {
+    async fn current(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let original = self.base.guard(c, d, i, e).await?;
+        let sources = Arc::new(self.sources.clone().read_owned().await);
+        let inner = Arc::new(Inner {
+            signing: self.signing.load(Ordering::SeqCst),
+            original,
+            scope: scope(),
+            viewer: self.viewer.clone(),
+            sources,
+        });
+        let check = inner.clone();
+        Ok(AuthorityLease::checking(
+            inner,
+            Instant::now() + Duration::from_secs(10),
+            move || check.original.current(),
+        ))
+    }
+}
+#[async_trait]
+impl PeerAuthority for FetchPolicy {
+    fn authority_lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        a: &AuthorityLease,
+    ) -> Result<AuthorityLifetime, DispatchError> {
+        self.base.authority_lifetime(c, d, i, a)
+    }
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if e.kind() != "recording.vcon-fetch" {
+            return self.base.acquire(c, d, i, e).await;
+        }
+        let a = self.current(c, d, i, e).await?;
+        authorize_record_fetch(
+            e,
+            &c.principal,
+            scope(),
+            self.viewer.clone(),
+            a,
+            self.backend.as_ref(),
+            source_lease,
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(10),
+            self.references.clone(),
+            self.inline_limit,
+        )
+        .await
+    }
+    async fn refresh(
+        &self,
+        o: &ValidatedBearer,
+        n: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.base.refresh(o, n, d, i, e).await
+    }
+}
+struct Counted {
+    returned: Notify,
+}
+#[async_trait]
+impl AuthenticatedHandler for Counted {
+    async fn handle(&self, a: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let result = RecordFetchHandler.handle(a).await;
+        self.returned.notify_one();
+        result
+    }
+}
+async fn setup(
+    inline: usize,
+    ttl: Duration,
+) -> (Fixture, Arc<FetchPolicy>, VconHandle, uuid::Uuid) {
+    let mut f = Fixture::new();
+    let viewer = ParticipantId::new();
+    let record = record(&viewer, &ParticipantId::new());
+    let uuid = record.uuid();
+    let allowed = record
+        .manifest()
+        .sources()
+        .iter()
+        .map(|s| s.id().to_owned())
+        .collect();
+    let backend = Arc::new(Backend {
+        inner: MemoryVconStore::new(),
+        fail: AtomicBool::new(false),
+    });
+    let handle = backend.put(&scope(), record).await.unwrap();
+    let references = Arc::new(
+        RecordReferenceRegistry::new("https://records.invalid/vcon".into(), 8, ttl).unwrap(),
+    );
+    let p = Arc::new(FetchPolicy {
+        base: f.policy.clone(),
+        backend,
+        viewer,
+        sources: Arc::new(RwLock::new(allowed)),
+        references: Some(references),
+        inline_limit: inline,
+        signing: std::sync::atomic::AtomicU8::new(0),
+    });
+    f.config = Arc::new(PeerConfig {
+        methods: f.config.methods.clone(),
+        verifier: f.config.verifier.clone(),
+        signer: f.config.signer.clone(),
+        authority: p.clone(),
+        pending_capacity: 2,
+    });
+    (f, p, handle, uuid)
+}
+fn fetch(uuid: uuid::Uuid) -> Value {
+    let mut r = envelope("recording.vcon-fetch", json!({"uuid":uuid}));
+    r["cid"] = json!("conversation");
+    r["sid"] = json!("session");
+    r
+}
+async fn fresh(f: &Fixture, p: &FetchPolicy, r: &Envelope) -> AuthorityLease {
+    let c = f.validator.validate_credential("old").await.unwrap();
