+#[derive(Clone, Eq, PartialEq, Serialize)]
+pub struct RecordManifest {
+    version: u32,
+    policy: String,
+    sources: Vec<RecordSource>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ManifestWire {
+    version: u32,
+    policy: String,
+    sources: Vec<RecordSource>,
+}
+struct Limit(usize);
+impl io::Write for Limit {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0 = self
+            .0
+            .checked_sub(bytes.len())
+            .ok_or_else(|| io::Error::other("record metadata too large"))?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+impl RecordManifest {
+    pub fn new(policy: String, mut sources: Vec<RecordSource>) -> Result<Self> {
+        if !id(&policy) || sources.is_empty() || sources.len() > MAX_RECORD_SOURCES {
+            return Err(invalid());
+        }
+        for source in &mut sources {
+            source.normalize()?;
+        }
+        sources.sort_by_key(|s| s.target);
+        let mut ids = BTreeSet::new();
+        let mut targets = BTreeSet::new();
+        for source in &sources {
+            if !ids.insert(source.id.clone()) || !targets.insert(source.target) {
+                return Err(invalid());
+            }
+        }
+        if !targets.contains(&RecordTarget::Document)
+            || sources
+                .iter()
+                .any(|s| s.references.iter().any(|r| !ids.contains(r)))
+        {
+            return Err(invalid());
+        }
+        let value = Self {
+            version: 2,
+            policy,
+            sources,
+        };
+        serde_json::to_writer(Limit(MAX_RECORD_MANIFEST_BYTES), &value).map_err(|_| invalid())?;
+        Ok(value)
+    }
+    pub fn decode(bytes: &[u8]) -> Result<Self> {
+        if bytes.len() > MAX_RECORD_MANIFEST_BYTES {
+            return Err(invalid());
+        }
+        let wire: ManifestWire = serde_json::from_slice(bytes).map_err(|_| invalid())?;
+        if wire.version != 2 {
+            return Err(invalid());
+        }
+        Self::new(wire.policy, wire.sources)
+    }
+    pub fn encode(&self) -> Result<Vec<u8>> {
+        serde_json::to_vec(self).map_err(|_| invalid())
+    }
+    pub fn sources(&self) -> &[RecordSource] {
+        &self.sources
+    }
+    pub fn policy(&self) -> &str {
+        &self.policy
+    }
+    /// No producer attribution or historical audience is invented. Raw builder
+    /// data remains private until an explicit capture source rule is supplied.
+    pub fn unattributed(body: &[u8]) -> Result<Self> {
+        let (_, targets) = inspect(body)?;
+        let sources = targets
+            .into_iter()
+            .enumerate()
+            .map(|(index, target)| {
+                RecordSource::new(
+                    format!("unattributed.{index}"),
+                    1,
+                    target,
+                    RecordCategory::Metadata,
+                    RecordAudience::Participants(vec![]),
+                    "unattributed".into(),
+                    RecordRetention::UntilDeleted,
+                    RecordRetention::UntilDeleted,
+                )
+            })
+            .collect();
+        Self::new("unattributed".into(), sources)
+    }
+    fn validate_body(&self, body: &[u8]) -> Result<Uuid> {
+        let (uuid, targets) = inspect(body)?;
+        if targets
+            != self
+                .sources
+                .iter()
+                .map(|s| s.target)
+                .collect::<BTreeSet<_>>()
+        {
+            return Err(invalid());
+        }
+        Ok(uuid)
+    }
+}
+impl fmt::Debug for RecordManifest {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("RecordManifest")
+            .field("source_count", &self.sources.len())
+            .finish_non_exhaustive()
+    }
+}
+fn inspect(body: &[u8]) -> Result<(Uuid, BTreeSet<RecordTarget>)> {
+    if body.len() > MAX_RECORD_BYTES {
+        return Err(invalid());
+    }
+    let value: serde_json::Value = serde_json::from_slice(body).map_err(|_| invalid())?;
+    let uuid = value
+        .get("uuid")
+        .and_then(|v| v.as_str())
+        .and_then(|s| Uuid::parse_str(s).ok())
+        .filter(|v| !v.is_nil())
+        .ok_or_else(invalid)?;
+    #[cfg(feature = "vcon")]
+    {
+        let vcon: rvoip_vcon::Vcon =
+            serde_json::from_value(value.clone()).map_err(|_| invalid())?;
+        vcon.validate().map_err(|_| invalid())?;
+    }
+    let mut targets = BTreeSet::from([RecordTarget::Document]);
+    let arrays: [(&str, fn(u32) -> RecordTarget); 4] = [
+        ("parties", RecordTarget::Party),
+        ("dialog", RecordTarget::Dialog),
+        ("analysis", RecordTarget::Analysis),
+        ("attachments", RecordTarget::Attachment),
+    ];
+    for (name, kind) in arrays {
+        if let Some(items) = value.get(name) {
+            let items = items.as_array().ok_or_else(invalid)?;
+            if items.len() > MAX_RECORD_SOURCES {
+                return Err(invalid());
+            }
+            for index in 0..items.len() {
+                targets.insert(kind(index as u32));
+            }
+        }
+    }
+    if targets.len() > MAX_RECORD_SOURCES {
+        return Err(invalid());
+    }
+    Ok((uuid, targets))
+}
+/// Immutable canonical body and its complete source index. Construction checks
+/// every item has exactly one rule; neither data nor its digest grants access.
+#[derive(Clone)]
+pub struct VconRecord {
