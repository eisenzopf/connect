+    manifest: RecordManifest,
+    uuid: Uuid,
+}
+impl VconRecord {
+    pub fn new(body: Bytes, manifest: RecordManifest) -> Result<Self> {
+        let uuid = manifest.validate_body(&body)?;
+        #[cfg(feature = "vcon")]
