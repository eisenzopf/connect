+#[tokio::test]
+async fn cancelled_redaction_writer_releases_intent_and_real_delivery_fences_lost_response_recovery(
+) {
+    use super::redaction::*;
+    use std::{future::Future, task::Poll};
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let (record, _, _, _) = fixture();
+    let store = MemoryVconStore::new();
+    let owner = scope();
+    let id = record
+        .manifest()
+        .sources()
+        .iter()
+        .find(|s| s.target() == RecordTarget::Analysis(0))
+        .unwrap()
+        .id()
+        .to_owned();
+    let handle = store.put(&owner, record.clone()).await.unwrap();
+    let intent = VconRedaction::new(
+        "uncertain-redaction".into(),
+        handle.clone(),
+        vec![SourceRedaction {
+            source_id: id,
+            mode: SourceRedactionMode::Content,
+        }],
+    )
+    .unwrap();
+    let read = store.get(&owner, &handle).await.unwrap().unwrap();
+    let original = read.body().clone();
+    let (mut sink, mut peer) = tokio::io::duplex(8);
+    let delivery = tokio::spawn(async move {
+        sink.write_all(read.body()).await.unwrap();
+        drop(read);
+    });
+    let mut pending = Box::pin(store.redact(&owner, &intent));
+    std::future::poll_fn(|cx| match pending.as_mut().poll(cx) {
+        Poll::Pending => Poll::Ready(()),
+        Poll::Ready(_) => panic!("write crossed a held delivery"),
+    })
+    .await;
+    drop(pending);
+    assert!(store.get(&owner, &handle).await.unwrap().is_some());
+    let (committed, seen) = tokio::sync::oneshot::channel();
+    let worker = tokio::spawn({
+        let store = store.clone();
+        let owner = owner.clone();
+        let intent = intent.clone();
+        async move {
+            let fact = store.redact(&owner, &intent).await.unwrap().unwrap();
+            committed.send(fact).unwrap();
+            std::future::pending::<()>().await;
+        }
+    });
+    tokio::task::yield_now().await;
+    let unrelated = store.put(&scope(), fixture().0).await.unwrap();
+    assert_ne!(unrelated.url, handle.url);
+    assert!(!worker.is_finished());
+    let mut received = vec![];
+    peer.read_to_end(&mut received).await.unwrap();
+    assert_eq!(received, original);
+    delivery.await.unwrap();
+    let fact = seen.await.unwrap();
+    worker.abort();
+    assert!(worker.await.unwrap_err().is_cancelled());
+    let replay = store.redact(&owner, &intent).await.unwrap().unwrap();
+    assert_eq!(replay.at(), fact.at());
+    assert_eq!(replay.result().manifest_hash, fact.result().manifest_hash);
+    assert!(store.get(&owner, &handle).await.is_err());
+    assert!(store.get(&owner, replay.result()).await.unwrap().is_some());
+}
