+impl RecordSource {
+    pub fn new(
+        id: String,
+        revision: u64,
+        target: RecordTarget,
+        category: RecordCategory,
+        audience: RecordAudience,
+        policy: String,
+        metadata_retention: RecordRetention,
+        content_retention: RecordRetention,
+    ) -> Self {
+        Self {
+            id,
+            revision,
+            target,
+            category,
+            state: RecordSourceState::Available,
+            audience,
+            policy,
+            metadata_retention,
+            content_retention,
+            references: vec![],
+            provenance: RecordProvenance::default(),
+        }
+    }
+    pub fn with_references(mut self, references: Vec<String>) -> Self {
+        self.references = references;
+        self
+    }
+    pub fn with_provenance(mut self, provenance: RecordProvenance) -> Self {
+        self.provenance = provenance;
+        self
+    }
+    pub fn id(&self) -> &str {
+        &self.id
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn target(&self) -> RecordTarget {
+        self.target
+    }
+    pub fn category(&self) -> RecordCategory {
+        self.category
+    }
+    pub fn policy(&self) -> &str {
+        &self.policy
+    }
+    pub fn references(&self) -> &[String] {
+        &self.references
+    }
+    pub fn provenance(&self) -> &RecordProvenance {
+        &self.provenance
+    }
+    pub fn metadata_retention(&self) -> RecordRetention {
+        self.metadata_retention
+    }
+    pub fn content_retention(&self) -> RecordRetention {
+        self.content_retention
+    }
+    pub fn state(&self) -> RecordSourceState {
+        self.state
+    }
+    pub fn admits(&self, participant: &ParticipantId) -> bool {
+        if self.state == RecordSourceState::MetadataUnavailable {
+            return false;
+        }
+        match &self.audience {
+            RecordAudience::Participants(ids) => ids.contains(participant),
+            RecordAudience::Policy => true,
+        }
+    }
+    fn normalize(&mut self) -> Result<()> {
+        if !id(&self.id)
+            || !id(&self.policy)
+            || self.revision == 0
+            || self.revision > crate::store::vcon_store::MAX_VCON_REVISION
+            || self.references.len() > 64
+            || self.references.iter().any(|r| !id(r))
+        {
+            return Err(invalid());
+        }
+        self.references.sort();
+        if self.references.windows(2).any(|pair| pair[0] == pair[1]) {
+            return Err(invalid());
+        }
+        if let RecordAudience::Participants(ids) = &mut self.audience {
+            if ids.len() > 256 || ids.iter().any(|p| !id(p.as_str())) {
+                return Err(invalid());
+            }
+            ids.sort();
+            if ids.windows(2).any(|pair| pair[0] == pair[1]) {
+                return Err(invalid());
+            }
+        }
+        let p = &self.provenance;
+        if p.producing_participant
+            .as_ref()
+            .is_some_and(|p| !id(p.as_str()))
+            || p.connection.as_ref().is_some_and(|v| !id(v))
+            || p.correlation.as_ref().is_some_and(|v| !id(v))
+            || p.connection_generation
+                .is_some_and(|v| v == 0 || v > crate::store::vcon_store::MAX_VCON_REVISION)
+            || p.local_sequence
+                .is_some_and(|v| v == 0 || v > crate::store::vcon_store::MAX_VCON_REVISION)
+            || match (p.missing_first, p.missing_last, p.local_sequence) {
+                (None, None, _) => false,
+                (Some(first), Some(last), Some(seq)) => first == 0 || first > last || last >= seq,
+                _ => true,
+            }
+            || p.provider_role
+                .as_deref()
+                .is_some_and(|v| !matches!(v, "user" | "assistant" | "system" | "other"))
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
