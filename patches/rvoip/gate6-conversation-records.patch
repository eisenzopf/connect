+    #[test]
+    fn bounded_capture_reports_omissions_and_never_widens_frozen_audience() {
+        use crate::{
+            connection::Direction,
+            ids::{ConversationId, MessageId, SessionId},
+            message::{ContentType, MessageOrigin},
+            session::{Session, SessionMedium, SessionState},
+        };
+        let sender = ParticipantId::new();
+        let recipient = ParticipantId::new();
+        let outsider = ParticipantId::new();
+        let conversation = ConversationId::new();
+        let buffer = RecordCaptureBuffer::default();
+        let mut message = Message {
+            id: MessageId::new(),
+            conversation_id: conversation.clone(),
+            origin: MessageOrigin::System,
+            from_participant: sender.clone(),
+            to: MessageRecipients::Participants(vec![recipient.clone()]),
+            direction: Direction::Outbound,
+            content_type: ContentType::Text,
+            body: Bytes::from_static(b"bounded private message"),
+            attachments: vec![],
+            in_reply_to: None,
+            timestamp: Utc::now(),
+        };
+        for _ in 0..=MAX_CAPTURE_ITEMS {
+            message.id = MessageId::new();
+            buffer.message(
+                &message,
+                RecordCaptureDecision {
+                    policy: "bounded-capture".into(),
+                    audience: vec![recipient.clone(), outsider.clone()],
+                    metadata_retention: RecordRetention::UntilDeleted,
+                    content_retention: RecordRetention::UntilDeleted,
+                },
+            );
+        }
+        let now = Utc::now();
+        let session = Session {
+            id: SessionId::new(),
+            conversation_id: conversation,
+            state: SessionState::Ended,
+            medium: SessionMedium::TextChat,
+            participants: Default::default(),
+            connections: Default::default(),
+            negotiated_capabilities: Default::default(),
+            started_at: now,
+            ended_at: Some(now),
+            end_reason: Some(crate::adapter::EndReason::Normal),
+        };
+        let builder = crate::vcon::DefaultVconBuilder::new();
+        use crate::vcon::VconBuilderHandle;
+        let record = buffer
+            .finish(
+                &builder.snapshot(),
+                &session,
+                &VconScope::new(
+                    crate::ids::TenantId::new(),
+                    session.conversation_id.clone(),
+                    session.id.clone(),
+                ),
+                &MetadataOnlyRecordCapture,
+            )
+            .unwrap();
+        let doc: rvoip_vcon::Vcon = serde_json::from_slice(record.body()).unwrap();
+        doc.validate().unwrap();
+        assert_eq!(doc.analysis.len(), MAX_CAPTURE_ITEMS + 1);
+        let outcome = doc.analysis.last().unwrap().body.as_ref().unwrap();
+        assert_eq!(outcome["capture_omissions"], 1);
+        assert_eq!(outcome["capture_complete"], false);
+        assert_eq!(outcome["recorded_audio"], false);
+        let sources = record
+            .manifest()
+            .sources()
+            .iter()
+            .filter(|source| source.id().starts_with("message."))
+            .collect::<Vec<_>>();
+        assert_eq!(sources.len(), MAX_CAPTURE_ITEMS);
+        assert!(sources
+            .iter()
+            .all(|source| source.admits(&recipient) && !source.admits(&outsider)));
+        assert!(
+            buffer
+                .finish(
+                    &builder.snapshot(),
+                    &session,
+                    &VconScope::new(
+                        crate::ids::TenantId::new(),
+                        session.conversation_id.clone(),
+                        session.id.clone()
+                    ),
+                    &MetadataOnlyRecordCapture
+                )
+                .is_err(),
+            "no second freeze"
+        );
+    }
+}
