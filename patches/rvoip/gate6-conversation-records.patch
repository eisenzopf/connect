@@ -0,0 +1,52 @@
+//! Factual local connection lineage; metadata is not a provider receipt.
+use super::*;
+use crate::{connection::Transport, ids::ConnectionId};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum RecordConnectionPhase {
+    AdapterConnected,
+    AdapterEnded,
+    AdapterFailed,
+    LocallyAdmitted,
+    LocallyRetired,
+}
+/// Constructed only at actual Core observations/commits. No route, address,
+/// provider failure text or claimed remote delivery is captured.
+#[derive(Clone)]
+pub struct RecordConnectionFact {
+    pub(crate) participant: ParticipantId,
+    pub(crate) connection: ConnectionId,
+    pub(crate) generation: u64,
+    pub(crate) transport: Transport,
+    pub(crate) phase: RecordConnectionPhase,
+    pub(crate) correlation: Option<String>,
+    pub(crate) at: DateTime<Utc>,
+}
+impl RecordConnectionFact {
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn connection(&self) -> &ConnectionId {
+        &self.connection
+    }
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+    pub fn transport(&self) -> Transport {
+        self.transport
+    }
+    pub fn phase(&self) -> RecordConnectionPhase {
+        self.phase
+    }
+    pub fn at(&self) -> DateTime<Utc> {
+        self.at
+    }
+}
+impl fmt::Debug for RecordConnectionFact {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("RecordConnectionFact")
+            .field("phase", &self.phase)
+            .finish_non_exhaustive()
+    }
+}
diff --git a/crates/foundation/rvoip-core/src/records/projection.rs b/crates/foundation/rvoip-core/src/records/projection.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/records/projection.rs
@@ -0,0 +1,674 @@
+//! Current policy and source visibility projection over a retained stored read.
+use super::*;
+use crate::{
+    ids::ParticipantId,
+    store::{VconRead, VconScope},
+};
+use serde_json::{json, Value};
+use std::{collections::VecDeque, time::Duration};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, thiserror::Error)]
+pub enum RecordViewError {
+    #[error("record view authority denied")]
+    Authority,
+    #[error("record view unavailable")]
+    Unavailable,
+    #[error("record view expired")]
+    Expired,
+    #[error("record view cancelled")]
+    Cancelled,
+    #[error("invalid or oversized record view")]
+    Invalid,
+    #[error("record extension unavailable")]
+    Unsupported,
+    #[error("record signature invalid or unavailable")]
+    Integrity,
+}
+pub type RecordViewResult<T> = std::result::Result<T, RecordViewError>;
+#[derive(Clone, Eq, PartialEq)]
+pub struct RecordViewRequest {
+    scope: VconScope,
+    viewer: ParticipantId,
+    uuid: Uuid,
+    revision: u64,
+    body_hash: String,
+    manifest_hash: String,
+    correlation: String,
+}
+impl RecordViewRequest {
+    pub fn new(
+        scope: VconScope,
+        viewer: ParticipantId,
+        uuid: Uuid,
+        revision: u64,
+        body_hash: String,
+        manifest_hash: String,
+        correlation: String,
+    ) -> RecordViewResult<Self> {
+        if body_hash.is_empty()
+            || body_hash.len() > 512
+            || manifest_hash.is_empty()
+            || manifest_hash.len() > 512
+            || !id(viewer.as_str())
+            || !id(&correlation)
+            || uuid.is_nil()
+            || revision == 0
+            || revision > crate::store::vcon_store::MAX_VCON_REVISION
+        {
+            return Err(RecordViewError::Invalid);
+        }
+        Ok(Self {
+            scope,
+            viewer,
+            uuid,
+            revision,
+            body_hash,
+            manifest_hash,
+            correlation,
+        })
+    }
+    pub fn scope(&self) -> &VconScope {
+        &self.scope
+    }
+    pub fn viewer(&self) -> &ParticipantId {
+        &self.viewer
+    }
+    pub fn uuid(&self) -> Uuid {
+        self.uuid
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn correlation(&self) -> &str {
+        &self.correlation
+    }
+    pub fn body_hash(&self) -> &str {
+        &self.body_hash
+    }
+    pub fn manifest_hash(&self) -> &str {
+        &self.manifest_hash
+    }
+}
+impl fmt::Debug for RecordViewRequest {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("RecordViewRequest([redacted])")
+    }
+}
+/// Explicit signing output plus an independently selected trusted key. Core
+/// verifies every signature and exact projected payload before releasing bytes.
+/// Certificate-discovery metadata is never a trust anchor.
+pub struct RecordSignature {
+    pub document: rvoip_vcon::SignedVcon,
+    pub trusted_key: rvoip_vcon::TrustedKey,
+    pub signer: String,
+}
+/// The installed trusted policy must retain current credential/resource/source
+/// authority until drop and derive facts under that same guard. Never reacquire
+/// an authority reader while its writer is queued or return a stale snapshot.
+pub trait RecordViewLease: Send + Sync {
+    /// None selects unsigned delivery. A configured signing failure must return
+    /// an error, never silently downgrade. Use deterministic signing to preserve
+    /// the exact view digest across conditional/referenced retrieval.
+    fn sign_projection(
+        &self,
+        _request: &RecordViewRequest,
+        _document: &rvoip_vcon::Vcon,
+    ) -> RecordViewResult<Option<RecordSignature>> {
+        Ok(None)
+    }
+    fn current(&self, request: &RecordViewRequest) -> RecordViewResult<BTreeSet<String>>;
+    /// Return only a currently authorized endpoint that checks authority again
+    /// on retrieval. A secret URL alone must not grant media access.
+    fn media_reference(
+        &self,
+        _request: &RecordViewRequest,
+        _source: &RecordSource,
+        _url: &str,
+        _hashes: &Value,
+    ) -> RecordViewResult<Option<AuthorizedRecordUrl>> {
+        Ok(None)
+    }
+}
+pub struct AuthorizedRecordUrl {
+    url: String,
+    expires_at: DateTime<Utc>,
+}
+impl AuthorizedRecordUrl {
+    pub fn new(url: String, expires_at: DateTime<Utc>) -> RecordViewResult<Self> {
+        let now = Utc::now();
+        if !url.starts_with("https://")
+            || url.len() > 2048
+            || url.chars().any(|c| c.is_control() || c.is_whitespace())
+            || expires_at <= now
+            || expires_at > now + chrono::Duration::minutes(5)
+        {
+            return Err(RecordViewError::Invalid);
+        }
+        Ok(Self { url, expires_at })
+    }
+}
+/// One exact invocation; no Clone and no authority held while awaiting hints.
+pub struct RecordViewControl {
+    request: RecordViewRequest,
+    lease: Box<dyn RecordViewLease>,
+    cancellation: CancellationToken,
+    deadline: Instant,
+}
+impl RecordViewControl {
+    pub fn new(
+        request: RecordViewRequest,
+        lease: Box<dyn RecordViewLease>,
+        cancellation: CancellationToken,
+        deadline: Instant,
+    ) -> RecordViewResult<Self> {
+        let value = Self {
+            request,
+            lease,
+            cancellation,
+            deadline: deadline.min(Instant::now() + Duration::from_secs(30)),
+        };
+        value.current()?;
+        Ok(value)
+    }
+    fn current(&self) -> RecordViewResult<BTreeSet<String>> {
+        if self.cancellation.is_cancelled() {
+            return Err(RecordViewError::Cancelled);
+        }
+        if Instant::now() >= self.deadline {
+            return Err(RecordViewError::Expired);
+        }
+        let sources = self.lease.current(&self.request)?;
+        if sources.len() > MAX_RECORD_SOURCES || sources.iter().any(|s| !id(s)) {
+            return Err(RecordViewError::Authority);
+        }
+        if self.cancellation.is_cancelled() {
+            return Err(RecordViewError::Cancelled);
+        }
+        if Instant::now() >= self.deadline {
+            return Err(RecordViewError::Expired);
+        }
+        Ok(sources)
+    }
+}
+impl fmt::Debug for RecordViewControl {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("RecordViewControl([redacted])")
+    }
+}
+
+/// Owns both storage custody and current policy protection. Retain this value
+/// through actual transmission; its data/digest is not a grant for later replay.
+pub struct RecordProjection {
+    read: VconRead,
+    control: RecordViewControl,
+    body: Bytes,
+    hash: String,
+    sources: Vec<(RecordSource, bool)>,
+    url_expiries: Vec<DateTime<Utc>>,
+    signed_by: Vec<String>,
+}
+pub struct RecordView<'a> {
+    pub signed_by: &'a [String],
+    pub body: &'a Bytes,
+    pub content_hash: &'a str,
+    pub uuid: Uuid,
+    pub revision: u64,
+}
+impl RecordProjection {
+    pub fn prepare(read: VconRead, control: RecordViewControl) -> RecordViewResult<Self> {
+        let request = &control.request;
+        if read.scope() != request.scope()
+            || read.record().uuid() != request.uuid()
+            || read.handle().revision != request.revision()
+            || read.handle().content_hash != request.body_hash
+            || read.handle().manifest_hash != request.manifest_hash
+        {
+            return Err(RecordViewError::Authority);
+        }
+        let allowed = control.current()?;
+        let vcon: rvoip_vcon::Vcon =
+            serde_json::from_slice(read.body()).map_err(|_| RecordViewError::Invalid)?;
+        vcon.validate_with_supported_extensions(std::iter::empty::<&str>())
+            .map_err(|_| RecordViewError::Unsupported)?;
+        let raw: Value =
+            serde_json::from_slice(read.body()).map_err(|_| RecordViewError::Invalid)?;
+        let rules = read.record().manifest().sources();
+        let now = Utc::now();
+        let positions: BTreeMap<_, _> = rules
+            .iter()
+            .enumerate()
+            .map(|(i, s)| (s.target(), i))
+            .collect();
+        let ids: BTreeMap<_, _> = rules.iter().enumerate().map(|(i, s)| (s.id(), i)).collect();
+        let mut keep: Vec<bool> = rules
+            .iter()
+            .map(|s| {
+                allowed.contains(s.id())
+                    && s.admits(request.viewer())
+                    && s.metadata_retention().permits(now)
+            })
+            .collect();
+        let mut content: Vec<bool> = rules
+            .iter()
+            .map(|s| {
+                s.state() == RecordSourceState::Available && s.content_retention().permits(now)
+            })
+            .collect();
+        let mut references: BTreeMap<usize, AuthorizedRecordUrl> = BTreeMap::new();
+        let mut causes: BTreeMap<usize, &str> = BTreeMap::new();
+        for (i, source) in rules.iter().enumerate() {
+            if !keep[i] {
+                continue;
+            }
+            if !content[i] {
+                causes.insert(i, "retention");
+                continue;
+            }
+            let item = match source.target() {
+                RecordTarget::Dialog(n) => &raw["dialog"][n as usize],
+                RecordTarget::Analysis(n) => &raw["analysis"][n as usize],
+                RecordTarget::Attachment(n) => &raw["attachments"][n as usize],
+                _ => &Value::Null,
+            };
+            if let Some(url) = item.get("url").and_then(Value::as_str) {
+                match control.lease.media_reference(
+                    request,
+                    source,
+                    url,
+                    item.get("content_hash").unwrap_or(&Value::Null),
+                )? {
+                    Some(reference) => {
+                        references.insert(i, reference);
+                    }
+                    None => {
+                        content[i] = false;
+                        causes.insert(i, "media-reference-unavailable");
+                    }
+                }
+            }
+        }
+        let mut reverse = vec![vec![]; rules.len()];
+        let mut edges = 0;
+        for (i, source) in rules.iter().enumerate() {
+            let mut dependencies = Vec::new();
+            for reference in source.references() {
+                dependencies.push(
+                    *ids.get(reference.as_str())
+                        .ok_or(RecordViewError::Invalid)?,
+                );
+            }
+            for target in dependencies_for(source.target(), &raw)? {
+                dependencies.push(*positions.get(&target).ok_or(RecordViewError::Invalid)?);
+            }
+            dependencies.sort_unstable();
+            dependencies.dedup();
+            edges += dependencies.len();
+            if edges > MAX_RECORD_SOURCES * 64 {
+                return Err(RecordViewError::Invalid);
+            }
+            for dependency in dependencies {
+                reverse[dependency].push(i);
+            }
+            if let RecordTarget::Dialog(index) = source.target() {
+                let dialog = &raw["dialog"][index as usize];
+                if dialog["type"] == "recording-set" {
+                    for child in numbers(&dialog["recordings"])? {
+                        if !content[*positions
+                            .get(&RecordTarget::Dialog(child))
+                            .ok_or(RecordViewError::Invalid)?]
+                        {
+                            keep[i] = false;
+                        }
+                    }
+                }
+                if dialog["type"] == "transfer" {
+                    for child in numbers(&dialog["original"])? {
+                        if !content[*positions
+                            .get(&RecordTarget::Dialog(child))
+                            .ok_or(RecordViewError::Invalid)?]
+                        {
+                            keep[i] = false;
+                        }
+                    }
+                }
+            }
+        }
+        let mut queue: VecDeque<_> = keep
+            .iter()
+            .enumerate()
+            .filter_map(|(i, k)| (!k).then_some(i))
+            .collect();
+        while let Some(hidden) = queue.pop_front() {
+            for &dependent in &reverse[hidden] {
+                if keep[dependent] {
+                    keep[dependent] = false;
+                    queue.push_back(dependent);
+                }
+            }
+        }
+        if !keep[*positions
+            .get(&RecordTarget::Document)
+            .ok_or(RecordViewError::Invalid)?]
+        {
+            return Err(RecordViewError::Authority);
+        }
+        let mut party_map = BTreeMap::new();
+        let mut dialog_map = BTreeMap::new();
+        let mut attachment_map = BTreeMap::new();
+        for (name, kind, map) in [
+            (
+                "parties",
+                RecordTarget::Party as fn(u32) -> RecordTarget,
+                &mut party_map,
+            ),
+            ("dialog", RecordTarget::Dialog, &mut dialog_map),
+            ("attachments", RecordTarget::Attachment, &mut attachment_map),
+        ] {
+            if let Some(items) = raw.get(name).and_then(Value::as_array) {
+                for i in 0..items.len() {
+                    if keep[positions[&kind(i as u32)]] {
+                        map.insert(i as u32, map.len() as u32);
+                    }
+                }
+            }
+        }
+        let mut output = json!({"uuid":raw["uuid"],"created_at":raw["created_at"]});
+        if let Some(version) = raw.get("vcon") {
+            output["vcon"] = version.clone();
+        }
+        // Schema declarations are metadata; retained child extension fields
+        // still require them even when the document's own content is removed.
+        if let Some(extensions) = raw.get("extensions") {
+            output["extensions"] = extensions.clone();
+        }
+        let doc_position = positions[&RecordTarget::Document];
+        if content[doc_position] {
+            for field in ["subject", "updated_at"] {
+                if let Some(value) = raw.get(field) {
+                    output[field] = value.clone();
+                }
+            }
+        }
+        let mut expiries = vec![];
+        let mut unavailable = vec![];
+        for (name, kind) in [
+            ("parties", RecordTarget::Party as fn(u32) -> RecordTarget),
+            ("dialog", RecordTarget::Dialog),
+            ("analysis", RecordTarget::Analysis),
+            ("attachments", RecordTarget::Attachment),
+        ] {
+            let mut items = vec![];
+            if let Some(original) = raw.get(name).and_then(Value::as_array) {
+                for (index, item) in original.iter().enumerate() {
+                    let rule_index = positions[&kind(index as u32)];
+                    if !keep[rule_index] {
+                        continue;
+                    }
+                    let source = &rules[rule_index];
+                    let mut value = item.clone();
+                    rewrite(
+                        kind(index as u32),
+                        &mut value,
+                        &party_map,
+                        &dialog_map,
+                        &attachment_map,
+                    )?;
+                    if let Some(reference) = references.remove(&rule_index) {
+                        expiries.push(reference.expires_at);
+                        value["url"] = Value::String(reference.url);
+                    }
+                    if let Some(cause) = causes.get(&rule_index).copied() {
+                        unavailable.push(json!({"source":source.id(),"reason":cause}));
+                        make_unavailable(kind(index as u32), &mut value, cause);
+                    }
+                    items.push(value);
+                }
+            }
+            if !items.is_empty() {
+                output[name] = Value::Array(items);
+            }
+        }
+        // If expired media became incomplete, no surviving recording-set or
+        // transfer may retain a reference that falsely calls it a recording.
+        let refs:Vec<_>=rules.iter().enumerate().filter(|(i,_)|keep[*i]).map(|(i,s)| {
+            let mut provenance=s.provenance().clone();
+            let producer_visible=provenance.producing_participant.as_ref().is_some_and(|pid|raw.get("parties").and_then(Value::as_array).is_some_and(|parties|parties.iter().enumerate().any(|(index,party)|party.get("uuid").and_then(Value::as_str)==Some(pid.as_str()) && party_map.contains_key(&(index as u32)))));
+            if !producer_visible {provenance.producing_participant=None;provenance.connection=None;provenance.connection_generation=None;provenance.correlation=None;}
+            json!({"source_id":s.id(),"source_revision":s.revision(),"category":s.category(),"provenance":provenance,"content_available":content[i]})
+        }).collect();
+        let annotation = json!({"type":"connect.record-projection","vendor":"rvoip","mediatype":"application/json","encoding":"json",
+            "body":{"record_revision":request.revision(),"correlation_id":request.correlation(),"capture_complete":false,"omissions":keep.iter().any(|k|!*k),"sources":refs,"unavailable":unavailable}});
+        output
+            .as_object_mut()
+            .ok_or(RecordViewError::Invalid)?
+            .entry("analysis")
+            .or_insert_with(|| json!([]))
+            .as_array_mut()
+            .ok_or(RecordViewError::Invalid)?
+            .push(annotation);
+        let projected: rvoip_vcon::Vcon =
+            serde_json::from_value(output).map_err(|_| RecordViewError::Invalid)?;
+        projected.validate().map_err(|_| RecordViewError::Invalid)?;
+        let unsigned = serde_json::to_vec(&projected).map_err(|_| RecordViewError::Invalid)?;
+        let (body, signed_by) = match control.lease.sign_projection(request, &projected)? {
+            None => (Bytes::from(unsigned), vec![]),
+            Some(signature) => {
+                if !id(&signature.signer)
+                    || signature.document.payload != rvoip_vcon::encode_base64url(&unsigned)
+                    || !signature.document.extra.is_empty()
+                {
+                    return Err(RecordViewError::Integrity);
+                }
+                let verified = rvoip_vcon::verify_jws(
+                    &signature.document,
+                    &signature.trusted_key.key,
+                    signature.trusted_key.algorithm,
+                )
+                .map_err(|_| RecordViewError::Integrity)?;
+                if serde_json::to_vec(&verified).map_err(|_| RecordViewError::Integrity)?
+                    != unsigned
+                {
+                    return Err(RecordViewError::Integrity);
+                }
+                (
+                    Bytes::from(
+                        serde_json::to_vec(&signature.document)
+                            .map_err(|_| RecordViewError::Integrity)?,
+                    ),
+                    vec![signature.signer],
+                )
+            }
+        };
+        if body.len() > MAX_RECORD_BYTES {
+            return Err(RecordViewError::Invalid);
+        }
+        let hash = crate::store::vcon_store::stored_content_hash(&body);
+        let sources = rules
+            .iter()
+            .enumerate()
+            .filter_map(|(i, s)| keep[i].then_some((s.clone(), content[i])))
+            .collect();
+        let value = Self {
+            read,
+            control,
+            body,
+            hash,
+            sources,
+            url_expiries: expiries,
+            signed_by,
+        };
+        value.view()?;
+        Ok(value)
+    }
+    pub fn view(&self) -> RecordViewResult<RecordView<'_>> {
+        let allowed = self.control.current()?;
+        let now = Utc::now();
+        if self.sources.iter().any(|(s, was_content)| {
+            !allowed.contains(s.id())
+                || !s.admits(self.control.request.viewer())
+                || !s.metadata_retention().permits(now)
+                || (*was_content
+                    && (s.state() != RecordSourceState::Available
+                        || !s.content_retention().permits(now)))
+        }) {
+            return Err(RecordViewError::Authority);
+        }
+        if self.url_expiries.iter().any(|expiry| now >= *expiry) {
+            return Err(RecordViewError::Expired);
+        }
+        Ok(RecordView {
+            signed_by: &self.signed_by,
+            body: &self.body,
+            content_hash: &self.hash,
+            uuid: self.read.record().uuid(),
+            revision: self.read.handle().revision,
+        })
+    }
+}
+impl fmt::Debug for RecordProjection {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("RecordProjection")
+            .field("body_bytes", &self.body.len())
+            .field("source_count", &self.sources.len())
+            .finish_non_exhaustive()
+    }
+}
+pub(super) fn numbers(value: &Value) -> RecordViewResult<Vec<u32>> {
+    let mut result = vec![];
+    let mut pending = vec![value];
+    while let Some(value) = pending.pop() {
+        match value {
+            Value::Null => {}
+            Value::Number(n) => result.push(
+                u32::try_from(n.as_u64().ok_or(RecordViewError::Invalid)?)
+                    .map_err(|_| RecordViewError::Invalid)?,
+            ),
+            Value::Array(values) => pending.extend(values),
+            _ => return Err(RecordViewError::Invalid),
+        }
+    }
+    Ok(result)
+}
+pub(super) fn dependencies_for(
+    target: RecordTarget,
+    raw: &Value,
+) -> RecordViewResult<Vec<RecordTarget>> {
+    let mut result = vec![];
+    let mut add = |value: &Value, kind: fn(u32) -> RecordTarget| -> RecordViewResult<()> {
+        for index in numbers(value)? {
+            result.push(kind(index));
+        }
+        Ok(())
+    };
+    match target {
+        RecordTarget::Dialog(index) => {
+            let d = &raw["dialog"][index as usize];
+            for key in [
+                "parties",
+                "originator",
+                "transferee",
+                "transferor",
+                "transfer_target",
+            ] {
+                add(&d[key], RecordTarget::Party)?;
+            }
+            if let Some(history) = d.get("party_history").and_then(Value::as_array) {
+                for event in history {
+                    add(&event["party"], RecordTarget::Party)?;
+                }
+            }
+            for key in ["recordings", "original", "consultation", "target_dialog"] {
+                add(&d[key], RecordTarget::Dialog)?;
+            }
+        }
+        RecordTarget::Analysis(index) => {
+            let a = &raw["analysis"][index as usize];
+            add(&a["dialog"], RecordTarget::Dialog)?;
+            add(&a["attachment"], RecordTarget::Attachment)?;
+        }
+        RecordTarget::Attachment(index) => {
+            let a = &raw["attachments"][index as usize];
+            add(&a["party"], RecordTarget::Party)?;
+            add(&a["dialog"], RecordTarget::Dialog)?;
+        }
+        _ => {}
+    }
+    Ok(result)
+}
+fn remap(value: &mut Value, map: &BTreeMap<u32, u32>) -> RecordViewResult<()> {
+    match value {
+        Value::Null => Ok(()),
+        Value::Number(n) => {
+            let old = u32::try_from(n.as_u64().ok_or(RecordViewError::Invalid)?)
+                .map_err(|_| RecordViewError::Invalid)?;
+            *value = json!(map.get(&old).ok_or(RecordViewError::Invalid)?);
+            Ok(())
+        }
+        Value::Array(items) => {
+            for item in items {
+                remap(item, map)?;
+            }
+            Ok(())
+        }
+        _ => Err(RecordViewError::Invalid),
+    }
+}
+fn rewrite(
+    target: RecordTarget,
+    value: &mut Value,
+    parties: &BTreeMap<u32, u32>,
+    dialogs: &BTreeMap<u32, u32>,
+    attachments: &BTreeMap<u32, u32>,
+) -> RecordViewResult<()> {
+    match target {
+        RecordTarget::Dialog(_) => {
+            for key in [
+                "parties",
+                "originator",
+                "transferee",
+                "transferor",
+                "transfer_target",
+            ] {
+                if let Some(v) = value.get_mut(key) {
+                    remap(v, parties)?;
+                }
+            }
+            if let Some(events) = value.get_mut("party_history").and_then(Value::as_array_mut) {
+                for event in events {
+                    remap(&mut event["party"], parties)?;
+                }
+            }
+            for key in ["recordings", "original", "consultation", "target_dialog"] {
+                if let Some(v) = value.get_mut(key) {
+                    remap(v, dialogs)?;
+                }
+            }
+            if let Some(old) = value.get("recording_set").and_then(Value::as_u64) {
+                if let Some(new) = dialogs.get(&(old as u32)) {
+                    value["recording_set"] = json!(new);
+                } else {
+                    value.as_object_mut().unwrap().remove("recording_set");
+                }
+            }
+        }
+        RecordTarget::Analysis(_) => {
+            if let Some(v) = value.get_mut("dialog") {
+                remap(v, dialogs)?;
+            }
+            if let Some(v) = value.get_mut("attachment") {
+                remap(v, attachments)?;
+            }
+        }
+        RecordTarget::Attachment(_) => {
+            remap(&mut value["party"], parties)?;
+            remap(&mut value["dialog"], dialogs)?;
+        }
+        _ => {}
+    }
+    Ok(())
+}
+fn make_unavailable(target: RecordTarget, value: &mut Value, cause: &str) {
+    super::redaction::unavailable_content(target, value, cause);
+}
