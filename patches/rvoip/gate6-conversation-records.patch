+            body,
+            manifest,
+            uuid,
+        })
+    }
+    pub fn unattributed(body: Bytes) -> Result<Self> {
+        let manifest = RecordManifest::unattributed(&body)?;
+        Self::new(body, manifest)
+    }
+    pub fn body(&self) -> &Bytes {
+        &self.body
+    }
+    pub fn manifest(&self) -> &RecordManifest {
+        &self.manifest
+    }
+    pub fn uuid(&self) -> Uuid {
+        self.uuid
+    }
+    pub fn manifest_hash(&self) -> Result<String> {
+        Ok(crate::store::vcon_store::stored_content_hash(
+            self.manifest.encode()?,
+        ))
+    }
+}
