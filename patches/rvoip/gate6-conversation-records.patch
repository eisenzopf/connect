+pub const MAX_VCON_REVISION: u64 = 9_007_199_254_740_991;
+
+/// A backend-owned read/delivery reservation, not audience authority. Retain it
+/// alongside the current audience grant until the actual response settles.
+/// It is intentionally not Clone: cloning body bytes cannot carry this lease.
+pub struct VconRead {
+    scope: VconScope,
+    handle: VconHandle,
+    record: VconRecord,
+    _guard: Box<dyn Any + Send + Sync>,
+}
+impl VconRead {
+    /// Trusted backend composition. `guard` must prevent mutation/deletion of
+    /// this exact scope/location/revision until drop, including another process
+    /// when the backend is shared. A stale boolean is not such a reservation.
+    pub fn protected(
+        scope: VconScope,
+        handle: VconHandle,
+        record: VconRecord,
+        guard: impl Any + Send + Sync,
+    ) -> Result<Self> {
+        if handle.url.is_empty()
+            || handle.url.len() > 2048
+            || handle.url.chars().any(char::is_control)
+            || handle.revision == 0
+            || handle.revision > MAX_VCON_REVISION
+            || stored_content_hash(record.body()) != handle.content_hash
+            || record.manifest_hash()? != handle.manifest_hash
+        {
+            return Err(RvoipError::InvalidState("vCon handle integrity mismatch"));
+        }
+        Ok(Self {
+            scope,
+            handle,
+            record,
+            _guard: Box::new(guard),
+        })
+    }
+    pub fn scope(&self) -> &VconScope {
+        &self.scope
+    }
+    pub fn handle(&self) -> &VconHandle {
+        &self.handle
+    }
+    pub fn body(&self) -> &Bytes {
+        self.record.body()
+    }
+    pub fn record(&self) -> &VconRecord {
+        &self.record
+    }
+}
+impl fmt::Debug for VconRead {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VconRead")
+            .field("revision", &self.handle.revision)
+            .field("body_bytes", &self.record.body().len())
+            .finish_non_exhaustive()
+    }
+}
