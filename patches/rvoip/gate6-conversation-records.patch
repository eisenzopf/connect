+        assert!(store.lookup(&scope(), &locator).await.unwrap().is_none());
+    }
+    assert!(store
+        .lookup(
+            &owner,
+            &VconLocator::new(Some(uuid8()), Some(handle.url.clone())).unwrap()
+        )
+        .await
+        .unwrap()
+        .is_none());
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let locator = VconLocator::new(
+        None,
+        Some(format!(
+            "http://{}/must-never-be-fetched",
+            listener.local_addr().unwrap()
+        )),
+    )
+    .unwrap();
+    assert!(store.lookup(&owner, &locator).await.unwrap().is_none());
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), listener.accept())
+            .await
+            .is_err()
+    );
+    assert!(VconLocator::new(None, None).is_err());
+    assert!(VconLocator::new(Some(Uuid::nil()), None).is_err());
+    let read = store
+        .lookup(&owner, &VconLocator::new(Some(uuid), None).unwrap())
+        .await
+        .unwrap()
+        .unwrap();
+    let intent =
+        crate::store::VconDeletion::new("delete-looked-up".into(), handle.clone()).unwrap();
+    let task = tokio::spawn({
+        let store = store.clone();
+        let owner = owner.clone();
+        async move { store.delete(&owner, &intent).await.unwrap() }
+    });
+    tokio::task::yield_now().await;
+    assert!(!task.is_finished());
+    drop(read);
+    assert!(task.await.unwrap().is_some());
+    assert!(store
+        .lookup(&owner, &VconLocator::new(Some(uuid), None).unwrap())
+        .await
+        .unwrap()
+        .is_none());
+}
