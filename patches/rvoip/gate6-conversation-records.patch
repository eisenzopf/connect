+//! Exact original local redaction intent and canonical transformation. These
+//! values are not current authority, a host operation ledger or provider erasure.
+use super::*;
+use crate::store::{VconDeletion, VconHandle};
+use serde_json::{json, Value};
+
+#[derive(Clone, Copy, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum SourceRedactionMode {
+    Content,
+    Metadata,
+}
+#[derive(Clone, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SourceRedaction {
+    pub source_id: String,
+    pub mode: SourceRedactionMode,
+}
+impl fmt::Debug for SourceRedaction {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SourceRedaction([redacted])")
+    }
+}
+#[derive(Clone)]
+pub struct VconRedaction {
+    operation_id: String,
+    expected: VconHandle,
+    sources: Vec<SourceRedaction>,
+    fingerprint: String,
+}
+impl VconRedaction {
+    pub fn new(
+        operation_id: String,
+        expected: VconHandle,
+        mut sources: Vec<SourceRedaction>,
+    ) -> Result<Self> {
+        // Both local mutations share the same bounded original-operation and
+        // expected-handle shape; constructing this value performs no deletion.
+        VconDeletion::new(operation_id.clone(), expected.clone())?;
+        if sources.is_empty()
+            || sources.len() > MAX_RECORD_SOURCES
+            || sources.iter().any(|s| !id(&s.source_id))
+        {
+            return Err(invalid());
+        }
+        sources.sort_by(|a, b| a.source_id.cmp(&b.source_id));
+        if sources.windows(2).any(|s| s[0].source_id == s[1].source_id) {
+            return Err(invalid());
+        }
+        let binding = serde_json::to_vec(&(
+            "record-redaction-v1",
+            &expected.url,
+            &expected.content_hash,
+            &expected.manifest_hash,
+            expected.revision,
+            &sources,
+        ))
+        .map_err(|_| invalid())?;
+        let fingerprint = crate::store::vcon_store::stored_content_hash(binding);
+        Ok(Self {
+            operation_id,
+            expected,
+            sources,
+            fingerprint,
+        })
+    }
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+    pub fn expected(&self) -> &VconHandle {
+        &self.expected
+    }
+    pub fn sources(&self) -> &[SourceRedaction] {
+        &self.sources
+    }
+    pub fn fingerprint(&self) -> &str {
+        &self.fingerprint
+    }
+}
+impl fmt::Debug for VconRedaction {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VconRedaction")
+            .field("source_count", &self.sources.len())
+            .finish_non_exhaustive()
+    }
+}
+#[derive(Clone)]
+pub struct VconRedactionFact {
+    operation_id: String,
+    fingerprint: String,
+    result: VconHandle,
+    at: DateTime<Utc>,
+}
+impl VconRedactionFact {
+    /// Trusted backend reconstruction after exact owner/original-intent checks.
+    /// The result is a historical local fact, not an assurance it remains live.
+    pub fn recorded(
+        operation_id: String,
+        fingerprint: String,
+        result: VconHandle,
+        at: DateTime<Utc>,
+    ) -> Result<Self> {
+        if !id(&operation_id)
+            || fingerprint.is_empty()
+            || fingerprint.len() > 512
+            || result.revision < 2
+            || result.revision > crate::store::vcon_store::MAX_VCON_REVISION
+            || result.url.is_empty()
+            || result.url.len() > 2048
+            || result.url.chars().any(char::is_control)
+            || result.content_hash.is_empty()
+            || result.content_hash.len() > 512
+            || result.manifest_hash.is_empty()
+            || result.manifest_hash.len() > 512
+        {
+            return Err(invalid());
+        }
+        Ok(Self {
+            operation_id,
+            fingerprint,
+            result,
+            at,
+        })
+    }
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+    pub fn fingerprint(&self) -> &str {
+        &self.fingerprint
+    }
+    pub fn result(&self) -> &VconHandle {
+        &self.result
+    }
+    pub fn at(&self) -> DateTime<Utc> {
+        self.at
+    }
+    pub fn matches(&self, intent: &VconRedaction) -> bool {
+        self.operation_id == intent.operation_id && self.fingerprint == intent.fingerprint
+    }
+}
+impl fmt::Debug for VconRedactionFact {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("VconRedactionFact")
+            .field("revision", &self.result.revision)
+            .finish_non_exhaustive()
+    }
+}
+
+/// Conservative canonical metadata. Unrecognized flattened extension fields
+/// cannot become a second content channel after content expiry/redaction.
+#[cfg(feature = "vcon")]
+pub(super) fn unavailable_content(target: RecordTarget, value: &mut Value, cause: &str) {
+    let keep: &[&str] = match target {
+        RecordTarget::Document => &[
+            "uuid",
+            "created_at",
+            "vcon",
+            "parties",
+            "dialog",
+            "analysis",
+            "attachments",
+            "extensions",
+        ],
+        RecordTarget::Party(_) => &["uuid"],
+        RecordTarget::Dialog(_) => &["type", "start", "duration", "parties", "originator"],
+        RecordTarget::Analysis(_) => &["type", "vendor", "dialog", "attachment"],
+        RecordTarget::Attachment(_) => &["start", "party", "dialog"],
+    };
+    if let Some(object) = value.as_object_mut() {
+        object.retain(|key, _| keep.contains(&key.as_str()));
+    }
+    match target {
+        RecordTarget::Dialog(_) => {
+            value["type"] = json!("incomplete");
+            value["disposition"] = json!("failed");
+        }
+        RecordTarget::Analysis(_) | RecordTarget::Attachment(_) => {
+            value["body"] = json!({"unavailable":cause});
+            value["encoding"] = json!("json");
+            value["mediatype"] = json!("application/json");
+        }
+        _ => {}
+    }
+}
+
+/// Trusted persistence primitive. Invoke only while owning the exact current
+/// record write reservation and after checking expected revision/body/manifest.
+/// The caller must independently retain current mutation authority on replay.
+#[cfg(feature = "vcon")]
+pub fn apply_redaction(record: &VconRecord, intent: &VconRedaction) -> Result<VconRecord> {
+    use super::projection::{dependencies_for, numbers};
+    use std::collections::VecDeque;
+    let canonical: rvoip_vcon::Vcon =
+        serde_json::from_slice(record.body()).map_err(|_| invalid())?;
+    canonical
+        .validate_with_supported_extensions(std::iter::empty::<&str>())
+        .map_err(|_| invalid())?;
+    let raw: Value = serde_json::from_slice(record.body()).map_err(|_| invalid())?;
+    let mut output = raw.clone();
+    let mut rules = record.manifest().sources().to_vec();
+    let positions: BTreeMap<_, _> = rules
+        .iter()
+        .enumerate()
+        .map(|(i, s)| (s.target(), i))
+        .collect();
+    let ids: BTreeMap<_, _> = rules
+        .iter()
+        .enumerate()
+        .map(|(i, s)| (s.id().to_owned(), i))
+        .collect();
+    let mut modes = vec![None; rules.len()];
+    for source in intent.sources() {
+        let position = *ids.get(&source.source_id).ok_or_else(invalid)?;
+        if rules[position].target() == RecordTarget::Document
+            && source.mode == SourceRedactionMode::Metadata
+        {
+            return Err(invalid());
+        }
+        modes[position] = Some(source.mode);
+    }
+    let mut reverse = vec![vec![]; rules.len()];
+    let mut edges = 0;
+    for (i, source) in rules.iter().enumerate() {
+        let mut deps = source
+            .references()
+            .iter()
+            .map(|r| ids.get(r).copied().ok_or_else(invalid))
+            .collect::<Result<Vec<_>>>()?;
+        for target in dependencies_for(source.target(), &raw).map_err(|_| invalid())? {
+            deps.push(*positions.get(&target).ok_or_else(invalid)?);
+        }
+        deps.sort_unstable();
+        deps.dedup();
+        edges += deps.len();
+        if edges > MAX_RECORD_SOURCES * 64 {
+            return Err(invalid());
+        }
+        for dependency in deps {
+            reverse[dependency].push(i);
+        }
+        if let RecordTarget::Dialog(index) = source.target() {
+            if raw["dialog"][index as usize]["type"] == "recording-set"
+                && numbers(&raw["dialog"][index as usize]["recordings"])
+                    .map_err(|_| invalid())?
+                    .iter()
+                    .any(|child| {
+                        positions
+                            .get(&RecordTarget::Dialog(*child))
+                            .is_some_and(|child| modes[*child].is_some())
+                    })
+            {
+                modes[i] = Some(SourceRedactionMode::Metadata);
+            }
+        }
+    }
+    let mut queue: VecDeque<_> = modes
+        .iter()
+        .enumerate()
+        .filter_map(|(i, mode)| (*mode == Some(SourceRedactionMode::Metadata)).then_some(i))
+        .collect();
+    while let Some(removed) = queue.pop_front() {
+        for &dependent in &reverse[removed] {
+            if modes[dependent] != Some(SourceRedactionMode::Metadata) {
+                if rules[dependent].target() == RecordTarget::Document {
+                    return Err(invalid());
+                }
+                modes[dependent] = Some(SourceRedactionMode::Metadata);
+                queue.push_back(dependent);
+            }
+        }
+    }
+    let now = Utc::now();
+    let start = raw["created_at"].clone();
+    for (index, source) in rules.iter().enumerate() {
+        let Some(mode) = modes[index] else { continue };
+        let target = source.target();
+        let value = match target {
+            RecordTarget::Document => &mut output,
+            RecordTarget::Party(i) => &mut output["parties"][i as usize],
+            RecordTarget::Dialog(i) => &mut output["dialog"][i as usize],
+            RecordTarget::Analysis(i) => &mut output["analysis"][i as usize],
+            RecordTarget::Attachment(i) => &mut output["attachments"][i as usize],
+        };
+        match mode {
+            SourceRedactionMode::Content => unavailable_content(target, value, "redacted"),
+            SourceRedactionMode::Metadata => {
+                *value = match target {
+                    RecordTarget::Party(_) => json!({}),
+                    RecordTarget::Dialog(_) => {
+                        json!({"type":"incomplete","start":start,"disposition":"failed"})
+                    }
+                    RecordTarget::Analysis(_) => {
+                        json!({"type":"unavailable","vendor":"rvoip","body":{"unavailable":"metadata-redacted"},"encoding":"json","mediatype":"application/json"})
+                    }
+                    RecordTarget::Attachment(_) => {
+                        json!({"start":start,"party":value["party"],"dialog":value["dialog"],"body":{"unavailable":"metadata-redacted"},"encoding":"json","mediatype":"application/json"})
+                    }
+                    RecordTarget::Document => return Err(invalid()),
+                };
+            }
+        }
+    }
+    let mut extra_changed = BTreeSet::new();
+    // A redacted recording-set cannot remain the parent of live recordings.
+    if let Some(dialogs) = output.get_mut("dialog").and_then(Value::as_array_mut) {
+        for (index, dialog) in dialogs.iter_mut().enumerate() {
+            let parent = dialog
+                .get("recording_set")
+                .and_then(Value::as_u64)
+                .and_then(|p| u32::try_from(p).ok());
+            if parent.is_some_and(|p| {
+                positions
+                    .get(&RecordTarget::Dialog(p))
+                    .is_some_and(|p| modes[*p].is_some())
+            }) {
+                dialog
+                    .as_object_mut()
+                    .ok_or_else(invalid)?
+                    .remove("recording_set");
+                let position = *positions
+                    .get(&RecordTarget::Dialog(index as u32))
+                    .ok_or_else(invalid)?;
+                extra_changed.insert(position);
+            }
+        }
+    }
+    let removed_participants: BTreeSet<_> = rules
+        .iter()
+        .enumerate()
+        .filter_map(|(i, s)| {
+            if modes[i] != Some(SourceRedactionMode::Metadata) {
+                return None;
+            }
+            if let RecordTarget::Party(p) = s.target() {
+                raw["parties"][p as usize]["uuid"]
+                    .as_str()
+                    .map(str::to_owned)
+            } else {
+                None
+            }
+        })
+        .collect();
+    for (index, source) in rules.iter_mut().enumerate() {
+        if source
+            .provenance
+            .producing_participant
+            .as_ref()
+            .is_some_and(|p| removed_participants.contains(p.as_str()))
+        {
+            source.provenance.producing_participant = None;
+            source.provenance.connection = None;
+            source.provenance.connection_generation = None;
+            source.provenance.correlation = None;
+            extra_changed.insert(index);
+        }
+        if modes[index].is_some() || extra_changed.contains(&index) {
+            source.revision = source.revision.checked_add(1).ok_or_else(invalid)?;
+        }
+
+        if let Some(mode) = modes[index] {
+            source.state = RecordSourceState::ContentUnavailable;
+            source.content_retention = RecordRetention::Until(now);
+            source.provenance.completeness = Some(RecordCompleteness::Unavailable);
+            source.provenance.capture_complete = false;
+            if mode == SourceRedactionMode::Metadata {
+                source.state = RecordSourceState::MetadataUnavailable;
+                source.audience = RecordAudience::Participants(vec![]);
+                source.policy = "redacted".into();
+                source.references.clear();
+                source.metadata_retention = RecordRetention::Until(now);
+                source.provenance = RecordProvenance {
+                    completeness: Some(RecordCompleteness::Unavailable),
+                    ..Default::default()
+                };
+            }
+        }
+    }
+    VconRecord::new(
+        Bytes::from(serde_json::to_vec(&output).map_err(|_| invalid())?),
+        RecordManifest::new(record.manifest().policy().into(), rules)?,
+    )
