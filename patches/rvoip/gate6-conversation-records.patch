new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/records/capture.rs
@@ -0,0 +1,676 @@
+//! Explicit installation capture policy. Capture selection is not a read grant.
+use super::*;
+use crate::{
+    agent::{AgentObservationContent, AttributedAgentObservation},
+    message::{Message, MessageRecipients},
+    store::VconScope,
+};
+use std::sync::Mutex;
+
+pub const MAX_CAPTURE_ITEMS: usize = 256;
+pub const MAX_CAPTURE_BYTES: usize = 1024 * 1024;
+
+#[derive(Clone)]
+pub struct RecordCaptureDecision {
+    pub policy: String,
+    pub audience: Vec<ParticipantId>,
+    pub metadata_retention: RecordRetention,
+    pub content_retention: RecordRetention,
+}
+impl fmt::Debug for RecordCaptureDecision {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("RecordCaptureDecision")
+            .field("audience_count", &self.audience.len())
+            .finish_non_exhaustive()
+    }
+}
+/// Trusted, synchronous, nonblocking installation selection. Default content
+/// capture is disabled. Selecting content for storage never authorizes a read.
+/// The engine also intersects messages with their actual frozen audience;
+/// transcript roles do not establish a human audience or speaker identity.
+pub trait RecordCapturePolicy: Send + Sync {
+    /// Named installation policy and independent retention classes. These are
+    /// persisted as data and remain subject to current read authorization.
+    fn name(&self) -> &str {
+        "metadata-only"
+    }
+    fn retention(&self, _scope: &VconScope, _category: RecordCategory) -> RecordRetention {
+        RecordRetention::UntilDeleted
+    }
+    fn message(&self, _scope: &VconScope, _message: &Message) -> Option<RecordCaptureDecision> {
+        None
+    }
+    /// Baseline local lineage is metadata. Default selection requires current
+    /// installation policy; Session membership does not select its audience.
+    fn connection_audience(
+        &self,
+        _scope: &VconScope,
+        _fact: &RecordConnectionFact,
+    ) -> RecordAudience {
+        RecordAudience::Policy
+    }
+    /// Provider identifiers have their own explicit capture decision. They are
+    /// reported references, never independently verified provider receipts.
+    fn agent_provider_references(
+        &self,
+        _scope: &VconScope,
+        _observation: &AttributedAgentObservation,
+    ) -> Option<RecordCaptureDecision> {
+        None
+    }
+    /// Explicit source selection for the trusted builder's canonical snapshot.
+    /// Do not derive historical audience from current Session membership. The
+    /// decision is frozen with this source and still requires current read policy.
+    fn canonical_source(
+        &self,
+        _scope: &VconScope,
+        _document: &rvoip_vcon::Vcon,
+        _source: &RecordSource,
+    ) -> Option<RecordCaptureDecision> {
+        None
+    }
+    fn agent_observation(
+        &self,
+        _scope: &VconScope,
+        _observation: &AttributedAgentObservation,
+    ) -> Option<RecordCaptureDecision> {
+        None
+    }
+}
+#[derive(Default)]
+pub struct MetadataOnlyRecordCapture;
+impl RecordCapturePolicy for MetadataOnlyRecordCapture {}
+
+struct Item {
+    source: RecordSource,
+    body: serde_json::Value,
+}
+#[derive(Default)]
+struct State {
+    items: BTreeMap<String, Item>,
+    bytes: usize,
+    dropped: u64,
+    frozen: bool,
+}
+#[derive(Default)]
+pub(crate) struct RecordCaptureBuffer {
+    state: Mutex<State>,
+}
+impl RecordCaptureBuffer {
+    fn add(&self, mut source: RecordSource, body: serde_json::Value) {
+        let mut state = self.state.lock().expect("record capture lock poisoned");
+        if state.frozen {
+            return;
+        }
+        let size = serde_json::to_vec(&body)
+            .map(|bytes| bytes.len())
+            .unwrap_or(MAX_CAPTURE_BYTES + 1)
+            .saturating_add(
+                serde_json::to_vec(&source)
+                    .map(|bytes| bytes.len())
+                    .unwrap_or(MAX_CAPTURE_BYTES + 1),
+            );
+        if source.normalize().is_err() {
+            state.dropped = state.dropped.saturating_add(1);
+            return;
+        }
+        if let Some(original) = state.items.get(source.id()) {
+            if original.body != body || original.source != source {
+                state.dropped = state.dropped.saturating_add(1);
+            }
+            return;
+        }
+        if state.items.len() >= MAX_CAPTURE_ITEMS
+            || size > MAX_CAPTURE_BYTES.saturating_sub(state.bytes)
+        {
+            state.dropped = state.dropped.saturating_add(1);
+            return;
+        }
+        state.bytes += size;
+        state
+            .items
+            .insert(source.id().into(), Item { source, body });
+    }
+    fn source(
+        id: String,
+        category: RecordCategory,
+        mut decision: RecordCaptureDecision,
+    ) -> RecordSource {
+        decision.audience.sort_by(|a, b| a.as_str().cmp(b.as_str()));
+        decision.audience.dedup();
+        RecordSource::new(
+            id,
+            1,
+            RecordTarget::Document,
+            category,
+            RecordAudience::Participants(decision.audience),
+            decision.policy,
+            decision.metadata_retention,
+            decision.content_retention,
+        )
+    }
+    pub(crate) fn message(&self, message: &Message, mut decision: RecordCaptureDecision) {
+        let MessageRecipients::Participants(recipients) = &message.to else {
+            return;
+        };
+        decision
+            .audience
+            .retain(|p| p == &message.from_participant || recipients.contains(p));
+        if decision.audience.is_empty() {
+            return;
+        }
+        let source = Self::source(
+            format!("message.{}", message.id),
+            RecordCategory::Metadata,
+            decision,
+        )
+        .with_provenance(RecordProvenance {
+            producing_participant: Some(message.from_participant.clone()),
+            correlation: Some(message.id.to_string()),
+            completeness: Some(RecordCompleteness::Final),
+            capture_complete: false,
+            ..Default::default()
+        });
+        // Do not retain attachment/provider URLs under a message-content policy.
+        // Their absence is explicit; separate capture/retention is required.
+        let body = serde_json::json!({"kind":"message","timestamp":message.timestamp,"content_type":message.content_type,
+            "body_base64url":rvoip_vcon::encode_base64url(&message.body),"attachment_count":message.attachments.len(),
+            "attachments":"not-captured","reply":"not-projected"});
+        self.add(source, body);
+    }
+    pub(crate) fn agent(
+        &self,
+        observation: &AttributedAgentObservation,
+        decision: RecordCaptureDecision,
+    ) {
+        if decision.audience.is_empty() {
+            return;
+        }
+        let item = observation.observation();
+        let (role, completeness) = match item.content() {
+            AgentObservationContent::Transcript {
+                speaker_role,
+                completeness,
+                ..
+            }
+            | AgentObservationContent::Speech {
+                speaker_role,
+                completeness,
+                ..
+            } => (*speaker_role, Some((*completeness).into())),
+            AgentObservationContent::Action { completeness, .. } => {
+                (None, Some((*completeness).into()))
+            }
+            AgentObservationContent::Unavailable { .. } => {
+                (None, Some(RecordCompleteness::Unavailable))
+            }
+            _ => (None, None),
+        };
+        let role = role
+            .and_then(|role| serde_json::to_value(role).ok())
+            .and_then(|role| role.as_str().map(str::to_owned));
+        let gap = item.missing_before();
+        let source = Self::source(
+            format!(
+                "agent.{}.{}.{}",
+                observation.connection_id(),
+                observation.connection_generation(),
+                item.local_sequence()
+            ),
+            if matches!(item.content(), AgentObservationContent::Transcript { .. }) {
+                RecordCategory::Transcript
+            } else {
+                RecordCategory::Metadata
+            },
+            decision,
+        )
+        .with_provenance(RecordProvenance {
+            producing_participant: Some(observation.participant_id().clone()),
+            connection: Some(observation.connection_id().to_string()),
+            connection_generation: Some(observation.connection_generation()),
+            correlation: None,
+            provider_role: role,
+            completeness,
+            capture_complete: false,
+            local_sequence: Some(item.local_sequence()),
+            missing_first: gap.map(|gap| gap.first_sequence),
+            missing_last: gap.map(|gap| gap.last_sequence),
+        });
+        // Provider session/event references have independent capture/retention;
+        // this stores only selected content and bounded factual provenance.
+        self.add(source,serde_json::json!({"kind":"agent-observation","observed_at":item.observed_at(),"content":item.content(),"provider_references":"not-captured"}));
+    }
+    pub(crate) fn connection(
+        &self,
+        scope: &VconScope,
+        fact: &RecordConnectionFact,
+        policy: &dyn RecordCapturePolicy,
+    ) {
+        use sha2::{Digest, Sha256};
+        // Stable opaque source IDs do not reveal a hidden connection in an
+        // otherwise permitted metadata annotation.
+        let key = format!("{}:{}:{:?}", fact.connection, fact.generation, fact.phase);
+        let hash = Sha256::digest(key.as_bytes());
+        let source_id = format!(
+            "connection.{}",
+            hash.iter().map(|b| format!("{b:02x}")).collect::<String>()
+        );
+        let source = RecordSource::new(
+            source_id,
+            1,
+            RecordTarget::Document,
+            RecordCategory::Metadata,
+            policy.connection_audience(scope, fact),
+            policy.name().into(),
+            policy.retention(scope, RecordCategory::Metadata),
+            policy.retention(scope, RecordCategory::Metadata),
+        )
+        .with_provenance(RecordProvenance {
+            producing_participant: Some(fact.participant.clone()),
+            connection: Some(fact.connection.to_string()),
+            connection_generation: Some(fact.generation),
+            correlation: fact.correlation.clone(),
+            capture_complete: false,
+            ..Default::default()
+        });
+        self.add(source, serde_json::json!({"kind":"connection-lineage", "phase":fact.phase, "transport":fact.transport, "observed_at":fact.at,
+            "remote_delivery":"not-established"}));
+    }
+    pub(crate) fn agent_provider(
+        &self,
+        observation: &AttributedAgentObservation,
+        decision: RecordCaptureDecision,
+    ) {
+        let item = observation.observation();
+        if decision.audience.is_empty()
+            || (item.provider_session_id().is_none() && item.provider_event_id().is_none())
+        {
+            return;
+        }
+        let source = Self::source(
+            format!(
+                "provider.{}.{}.{}",
+                observation.connection_id(),
+                observation.connection_generation(),
+                item.local_sequence()
+            ),
+            RecordCategory::ProviderReference,
+            decision,
+        )
+        .with_provenance(RecordProvenance {
+            producing_participant: Some(observation.participant_id().clone()),
+            connection: Some(observation.connection_id().to_string()),
+            connection_generation: Some(observation.connection_generation()),
+            local_sequence: Some(item.local_sequence()),
+            capture_complete: false,
+            ..Default::default()
+        });
+        self.add(source, serde_json::json!({"kind":"provider-reference", "observed_at":item.observed_at(),
+            "provider_session_id":item.provider_session_id(), "provider_event_id":item.provider_event_id(),
+            "verification":"provider-reported", "remote_deletion":"not-attempted"}));
+    }
+    #[cfg(feature = "vcon")]
+    pub(crate) fn finish(
+        &self,
+        snapshot: &crate::vcon::VconSnapshot,
+        session: &crate::session::Session,
+        scope: &VconScope,
+        policy: &dyn RecordCapturePolicy,
+    ) -> Result<VconRecord> {
+        let mut state = self.state.lock().expect("record capture lock poisoned");
+        if state.frozen {
+            return Err(invalid());
+        }
+        state.frozen = true;
+        let (mut document, raw_available) = match rvoip_vcon::Vcon::try_from(snapshot) {
+            Ok(document) => (document, true),
+            Err(_) => (
+                rvoip_vcon::Vcon {
+                    vcon: Some("0.4.0".into()),
+                    uuid: snapshot.uuid,
+                    created_at: snapshot.created_at,
+                    ..Default::default()
+                },
+                false,
+            ),
+        };
+        document.validate().map_err(|_| invalid())?;
+        let raw = Bytes::from(serde_json::to_vec(&document).map_err(|_| invalid())?);
+        let mut sources = RecordManifest::unattributed(&raw)?.sources;
+        let document_source = sources
+            .iter_mut()
+            .find(|source| source.target == RecordTarget::Document)
+            .ok_or_else(invalid)?;
+        document_source.id = "session.document".into();
+        document_source.audience = RecordAudience::Policy;
+        document_source.policy = policy.name().into();
+        for source in &mut sources {
+            source.category = match source.target {
+                RecordTarget::Dialog(index) => {
+                    let dialog = &document.dialog[index as usize];
+                    if dialog.url.is_some() {
+                        RecordCategory::ProviderReference
+                    } else if dialog.kind == rvoip_vcon::DialogKind::Recording {
+                        RecordCategory::RecordedMedia
+                    } else if dialog.kind == rvoip_vcon::DialogKind::Text {
+                        RecordCategory::Transcript
+                    } else {
+                        RecordCategory::Metadata
+                    }
+                }
+                RecordTarget::Analysis(index)
+                    if document.analysis[index as usize].kind == "transcript" =>
+                {
+                    RecordCategory::Transcript
+                }
+                RecordTarget::Analysis(index)
+                    if document.analysis[index as usize].url.is_some() =>
+                {
+                    RecordCategory::ProviderReference
+                }
+                RecordTarget::Attachment(index)
+                    if document.attachments[index as usize].url.is_some() =>
+                {
+                    RecordCategory::ProviderReference
+                }
+                _ => RecordCategory::Metadata,
+            };
+            source.metadata_retention = policy.retention(scope, RecordCategory::Metadata);
+            source.content_retention = policy.retention(scope, source.category);
+            if source.target != RecordTarget::Document {
+                if let Some(decision) = policy.canonical_source(scope, &document, source) {
+                    source.audience = RecordAudience::Participants(decision.audience);
+                    source.policy = decision.policy;
+                    source.metadata_retention = decision.metadata_retention;
+                    source.content_retention = decision.content_retention;
+                }
+            }
+        }
+        let reason = match session.end_reason.as_ref() {
+            Some(crate::adapter::EndReason::Normal) => "normal",
+            Some(crate::adapter::EndReason::Cancelled) => "cancelled",
+            Some(crate::adapter::EndReason::Failed { .. }) => "failed",
+            Some(crate::adapter::EndReason::Timeout) => "timeout",
+            Some(crate::adapter::EndReason::BridgeTorn) => "bridge-torn",
+            None => "unknown",
+        };
+        let outcome = serde_json::json!({"kind":"session-outcome","state":"ended","medium":session.medium,"started_at":session.started_at,"ended_at":session.ended_at,"reason":reason,
+            "capture_complete":false,"raw_capture":if raw_available {"validated"} else {"invalid-unavailable"},"capture_omissions":state.dropped,
+            "recorded_audio":document.dialog.iter().any(|dialog|dialog.kind==rvoip_vcon::DialogKind::Recording && dialog.mediatype.as_deref().is_some_and(|kind|kind.starts_with("audio/")) && dialog.body.is_some())});
+        let mut items = std::mem::take(&mut state.items)
+            .into_values()
+            .collect::<Vec<_>>();
+        state.bytes = 0;
+        items.push(Item {
+            source: RecordSource::new(
+                "session.outcome".into(),
+                1,
+                RecordTarget::Document,
+                RecordCategory::Metadata,
+                RecordAudience::Policy,
+                policy.name().into(),
+                policy.retention(scope, RecordCategory::Metadata),
+                policy.retention(scope, RecordCategory::Metadata),
+            ),
+            body: outcome,
+        });
+        for mut item in items {
+            let index = u32::try_from(document.analysis.len()).map_err(|_| invalid())?;
+            item.source.target = RecordTarget::Analysis(index);
+            document.analysis.push(rvoip_vcon::Analysis {
+                kind: item
+                    .body
+                    .get("kind")
+                    .and_then(|kind| kind.as_str())
+                    .unwrap_or("captured-event")
+                    .into(),
+                vendor: "rvoip".into(),
+                mediatype: Some("application/json".into()),
+                body: Some(item.body),
+                encoding: Some(rvoip_vcon::ContentEncoding::Json),
+                ..Default::default()
+            });
+            sources.push(item.source);
+        }
+        document.validate().map_err(|_| invalid())?;
+        VconRecord::new(
+            Bytes::from(serde_json::to_vec(&document).map_err(|_| invalid())?),
+            RecordManifest::new("explicit-session-capture".into(), sources)?,
+        )
+    }
+}
