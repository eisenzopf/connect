+/// Immutable original local mutation intent. This is correlation data, not
+/// permission: callers must enforce current authority again on every replay.
+#[derive(Clone)]
+pub struct VconDeletion {
+    operation_id: String,
+    expected: VconHandle,
+}
+impl VconDeletion {
+    pub fn new(operation_id: String, expected: VconHandle) -> Result<Self> {
+        if operation_id.is_empty()
+            || operation_id.len() > 128
+            || !operation_id
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"._~-".contains(&c))
+            || expected.revision == 0
+            || expected.revision >= MAX_VCON_REVISION
+            || expected.url.is_empty()
+            || expected.url.len() > 2048
+            || expected.url.chars().any(char::is_control)
+            || expected.content_hash.is_empty()
+            || expected.content_hash.len() > 512
+            || expected.manifest_hash.is_empty()
+            || expected.manifest_hash.len() > 512
+        {
+            return Err(RvoipError::InvalidState("invalid vCon deletion intent"));
+        }
+        Ok(Self {
+            operation_id,
+            expected,
+        })
+    }
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+    pub fn expected(&self) -> &VconHandle {
+        &self.expected
+    }
+}
