+
+/// Frozen selection under a protected current record read. Drop that backend
+/// read before awaiting its writer, retaining current mutation authority. The
+/// host persists/replays this exact intent; it must not select again on retry.
+pub enum RecordRetentionAction {
+    Redact(VconRedaction),
+    Delete(VconDeletion),
+}
+pub fn retention_action(
+    record: &VconRecord,
+    operation_id: String,
+    expected: VconHandle,
+    cutoff: DateTime<Utc>,
+) -> Result<Option<RecordRetentionAction>> {
+    if crate::store::vcon_store::stored_content_hash(record.body()) != expected.content_hash
+        || record.manifest_hash()? != expected.manifest_hash
+    {
+        return Err(invalid());
+    }
+    let mut sources = vec![];
+    for source in record.manifest().sources() {
+        if source.state() == RecordSourceState::MetadataUnavailable {
+            continue;
+        }
+        let mode = if !source.metadata_retention().permits(cutoff) {
+            SourceRedactionMode::Metadata
+        } else if source.state() == RecordSourceState::Available
+            && !source.content_retention().permits(cutoff)
+        {
+            SourceRedactionMode::Content
+        } else {
+            continue;
+        };
+        if source.target() == RecordTarget::Document && mode == SourceRedactionMode::Metadata {
+            return Ok(Some(RecordRetentionAction::Delete(VconDeletion::new(
+                operation_id,
+                expected,
+            )?)));
+        }
+        sources.push(SourceRedaction {
+            source_id: source.id().into(),
+            mode,
+        });
+    }
+    if sources.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(RecordRetentionAction::Redact(VconRedaction::new(
+        operation_id,
+        expected,
+        sources,
+    )?)))
+}
+
+#[cfg(feature = "vcon")]
+pub(super) fn validate_source_states(body: &[u8], manifest: &RecordManifest) -> Result<()> {
+    let raw: Value = serde_json::from_slice(body).map_err(|_| invalid())?;
+    for source in manifest.sources() {
+        if source.state() == RecordSourceState::Available {
+            continue;
+        }
+        let value = match source.target() {
+            RecordTarget::Document => &raw,
+            RecordTarget::Party(i) => &raw["parties"][i as usize],
+            RecordTarget::Dialog(i) => &raw["dialog"][i as usize],
+            RecordTarget::Analysis(i) => &raw["analysis"][i as usize],
+            RecordTarget::Attachment(i) => &raw["attachments"][i as usize],
+        };
+        let mut expected = value.clone();
+        unavailable_content(
+            source.target(),
+            &mut expected,
+            if source.state() == RecordSourceState::MetadataUnavailable {
+                "metadata-redacted"
+            } else {
+                "redacted"
+            },
+        );
+        if source.state() == RecordSourceState::MetadataUnavailable {
+            let expected_provenance = RecordProvenance {
+                completeness: Some(RecordCompleteness::Unavailable),
+                ..Default::default()
+            };
+            if source.target() == RecordTarget::Document
+                || source.provenance() != &expected_provenance
+                || !matches!(&source.audience,RecordAudience::Participants(ids) if ids.is_empty())
+                || source.policy() != "redacted"
+                || !source.references().is_empty()
+            {
+                return Err(invalid());
+            }
+            match source.target() {
+                RecordTarget::Party(_) => expected = json!({}),
+                RecordTarget::Dialog(_) => {
+                    expected = json!({"type":"incomplete","start":raw["created_at"],"disposition":"failed"})
+                }
+                RecordTarget::Analysis(_) => {
+                    expected = json!({"type":"unavailable","vendor":"rvoip","body":{"unavailable":"metadata-redacted"},"encoding":"json","mediatype":"application/json"})
+                }
+                RecordTarget::Attachment(_) => {
+                    expected = json!({"start":raw["created_at"],"party":value["party"],"dialog":value["dialog"],"body":{"unavailable":"metadata-redacted"},"encoding":"json","mediatype":"application/json"})
+                }
+                RecordTarget::Document => return Err(invalid()),
+            }
+        }
+        if value != &expected {
+            return Err(invalid());
+        }
+    }
+    Ok(())
+}
