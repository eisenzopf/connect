+    let public = read
+        .record()
+        .manifest()
+        .sources()
+        .iter()
+        .find(|s| s.target() == RecordTarget::Dialog(1))
+        .unwrap();
+    assert_eq!(public.revision(), 1);
+    let source = public.id().to_owned();
+    drop(read);
+    let next = VconRedaction::new(
+        "redact-public-content".into(),
+        fact.result().clone(),
+        vec![SourceRedaction {
+            source_id: source,
+            mode: SourceRedactionMode::Content,
+        }],
+    )
+    .unwrap();
+    let second = store.redact(&owner, &next).await.unwrap().unwrap();
+    assert_eq!(second.result().revision, 3);
+    let changed = VconRedaction::new(
+        intent.operation_id().into(),
+        handle.clone(),
+        vec![SourceRedaction {
+            source_id: selected,
+            mode: SourceRedactionMode::Content,
+        }],
+    )
+    .unwrap();
+    assert!(store.redact(&owner, &changed).await.is_err());
+    assert!(
+        store
+            .delete(
+                &owner,
+                &crate::store::VconDeletion::new(
+                    intent.operation_id().into(),
+                    second.result().clone()
+                )
+                .unwrap()
+            )
+            .await
+            .is_err(),
+        "operation identity cannot change action kind"
+    );
+    store
+        .delete(
+            &owner,
+            &crate::store::VconDeletion::new(
+                "delete-after-redaction".into(),
+                second.result().clone(),
+            )
+            .unwrap(),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+    let replay = store.redact(&owner, &intent).await.unwrap().unwrap();
+    assert_eq!(replay.at(), fact.at());
+    assert_eq!(replay.result().content_hash, fact.result().content_hash);
+    assert_eq!(replay.result().revision, 2);
+    assert!(store.put(&owner, record).await.is_err());
+    assert!(!format!("{intent:?} {fact:?}").contains("redact-private-metadata"));
+}
