+    drop(read);
+    struct Lease {
+        request: RecordViewRequest,
+        sources: std::collections::BTreeSet<String>,
+        _guard: tokio::sync::OwnedRwLockReadGuard<()>,
+    }
+    impl RecordViewLease for Lease {
+        fn current(
+            &self,
+            request: &RecordViewRequest,
+        ) -> RecordViewResult<std::collections::BTreeSet<String>> {
