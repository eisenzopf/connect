+struct PolicyState {
+    request: RecordViewRequest,
+    allowed: BTreeSet<String>,
+}
+struct HeldPolicy {
+    guard: tokio::sync::OwnedRwLockReadGuard<PolicyState>,
+}
+impl RecordViewLease for HeldPolicy {
+    fn current(&self, request: &RecordViewRequest) -> RecordViewResult<BTreeSet<String>> {
+        if request != &self.guard.request {
+            return Err(RecordViewError::Authority);
+        }
+        Ok(self.guard.allowed.clone())
+    }
+}
+async fn control(
+    record: &VconRecord,
+    scope: VconScope,
+    viewer: ParticipantId,
+) -> (
+    RecordViewControl,
+    Arc<RwLock<PolicyState>>,
+    CancellationToken,
+) {
+    let request = RecordViewRequest::new(
+        scope,
+        viewer,
+        record.uuid(),
+        1,
+        crate::store::vcon_store::stored_content_hash(record.body()),
+        record.manifest_hash().unwrap(),
+        "view-correlation".into(),
+    )
+    .unwrap();
+    let state = Arc::new(RwLock::new(PolicyState {
+        request: request.clone(),
+        allowed: record
+            .manifest()
+            .sources()
+            .iter()
+            .map(|s| s.id().into())
+            .collect(),
+    }));
+    let held = HeldPolicy {
+        guard: Arc::clone(&state).read_owned().await,
+    };
+    let cancel = CancellationToken::new();
+    (
+        RecordViewControl::new(
+            request,
+            Box::new(held),
+            cancel.clone(),
+            Instant::now() + Duration::from_secs(10),
+        )
+        .unwrap(),
+        state,
+        cancel,
+    )
+}
