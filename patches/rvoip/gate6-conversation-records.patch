+    };
+    use tokio::sync::Notify;
+
+    struct InterruptedStore {
+        inner: MemoryVconStore,
+        mode: AtomicU8,
+        committed: Notify,
+    }
+    impl InterruptedStore {
+        fn new(mode: u8) -> Self {
+            Self {
+                inner: MemoryVconStore::new(),
+                mode: AtomicU8::new(mode),
+                committed: Notify::new(),
+            }
+        }
+    }
+    #[async_trait::async_trait]
+    impl VconStore for InterruptedStore {
+        async fn put(&self, scope: &VconScope, record: VconRecord) -> Result<VconHandle> {
+            match self.mode.load(Ordering::Acquire) {
+                1 => Err(RvoipError::InvalidState("private-backend-error-canary")),
+                2 => {
+                    let _handle = self.inner.put(scope, record).await?;
+                    self.committed.notify_one();
+                    pending().await
                 }
+                3 => {
+                    self.committed.notify_one();
+                    pending().await
+                }
+                4 => {
+                    let mut handle = self.inner.put(scope, record).await?;
+                    handle.manifest_hash = "forged".into();
+                    Ok(handle)
+                }
+                _ => self.inner.put(scope, record).await,
             }
+        }
+        async fn lookup(
+            &self,
+            s: &VconScope,
+            l: &rvoip_core::store::VconLocator,
+        ) -> Result<Option<VconRead>> {
+            self.inner.lookup(s, l).await
+        }
+        async fn get(&self, s: &VconScope, h: &VconHandle) -> Result<Option<VconRead>> {
+            self.inner.get(s, h).await
+        }
+        async fn delete(&self, s: &VconScope, i: &VconDeletion) -> Result<Option<VconTombstone>> {
+            self.inner.delete(s, i).await
+        }
+        async fn redact(
+            &self,
+            s: &VconScope,
+            i: &rvoip_core::records::redaction::VconRedaction,
+        ) -> Result<Option<rvoip_core::records::redaction::VconRedactionFact>> {
+            self.inner.redact(s, i).await
+        }
+        async fn tombstone(&self, s: &VconScope, u: &str) -> Result<Option<VconTombstone>> {
+            self.inner.tombstone(s, u).await
+        }
+        async fn list_for_session(&self, s: &VconScope) -> Result<Vec<VconHandle>> {
+            self.inner.list_for_session(s).await
+        }
+        async fn list_for_conversation(
+            &self,
+            t: &TenantId,
+            c: &rvoip_core::ids::ConversationId,
+        ) -> Result<Vec<VconHandle>> {
+            self.inner.list_for_conversation(t, c).await
+        }
+    }
+    async fn setup(mode: u8) -> (Arc<Orchestrator>, Arc<InterruptedStore>, VconScope) {
+        let store = Arc::new(InterruptedStore::new(mode));
+        let mut config = Config::default();
+        config.vcon_store = store.clone();
+        let orch = Orchestrator::new(config);
+        let tenant = TenantId::new();
+        let cid = orch
+            .open_conversation(
+                tenant.clone(),
+                ConversationPolicy::default(),
+                HashMap::new(),
+            )
+            .await
+            .unwrap();
+        let sid = orch
+            .start_session(cid.clone(), SessionMedium::Voice, vec![])
+            .await
+            .unwrap();
+        (orch, store, VconScope::new(tenant, cid, sid))
+    }
+    fn ready(status: Option<Status>) -> VconHandle {
+        match status {
+            Some(Status::Ready(handle)) => handle,
+            other => panic!("expected Ready: {other:?}"),
+        }
+    }
+    #[tokio::test]
+    async fn failed_store_is_explicit_and_same_session_retry_recovers_one_metadata_only_record() {
+        let (orch, store, scope) = setup(1).await;
+        assert!(matches!(
+            orch.session_record_status(&scope),
+            Some(Status::Capturing)
+        ));
+        assert!(orch.retry_session_record(&scope).await.is_err());
+        let mut events = orch.subscribe_events();
+        orch.end_session(scope.session_id().clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        assert!(matches!(
+            orch.session_record_status(&scope),
+            Some(Status::StoreOutcomeUnknown)
+        ));
+        assert!(store.list_for_session(&scope).await.unwrap().is_empty());
+        assert!(!format!("{:?}", orch.session_record_status(&scope))
+            .contains("private-backend-error-canary"));
+        next_matching(&mut events, |event| {
+            matches!(event, Event::SessionEnded { .. })
         })
-        .await
-        .is_err(),
-        "VconReady was unexpectedly emitted"
-    );
+        .await;
+        assert!(events.try_recv().is_err());
+        store.mode.store(0, Ordering::Release);
+        let handle = ready(orch.retry_session_record(&scope).await.unwrap());
+        let read = store.get(&scope, &handle).await.unwrap().unwrap();
+        let doc: rvoip_vcon::Vcon = serde_json::from_slice(read.body()).unwrap();
+        doc.validate().unwrap();
+        assert!(doc.dialog.is_empty());
+        assert_eq!(doc.analysis.len(), 1);
+        assert_eq!(doc.analysis[0].kind, "session-outcome");
+        assert_eq!(
+            doc.analysis[0].body.as_ref().unwrap()["recorded_audio"],
+            false
+        );
+        assert!(doc.attachments.is_empty());
+        assert!(read
+            .record()
+            .manifest()
+            .sources()
+            .iter()
+            .all(|source| !source.provenance().capture_complete));
+        drop(read);
+        next_matching(&mut events, |event| {
+            matches!(event, Event::VconReady { .. })
+        })
+        .await;
+        for _ in 0..3 {
+            orch.end_session(scope.session_id().clone(), EndReason::Normal)
+                .await
+                .unwrap();
+        }
+        assert_eq!(store.list_for_session(&scope).await.unwrap().len(), 1);
+        assert_eq!(ready(orch.session_record_status(&scope)).url, handle.url);
+        assert!(
+            events.try_recv().is_err(),
+            "duplicate readiness or SessionEnded"
+        );
+        let foreign = VconScope::new(
+            TenantId::new(),
+            scope.conversation_id().clone(),
+            scope.session_id().clone(),
+        );
+        assert!(orch.session_record_status(&foreign).is_none());
+        assert!(orch.retry_session_record(&foreign).await.unwrap().is_none());
+    }
+    #[tokio::test]
+    async fn cancelled_after_real_store_commit_retries_original_document_without_duplicate_or_detached_work(
+    ) {
+        let (orch, store, scope) = setup(2).await;
+        let builder = orch.session_vcon_handle(scope.session_id()).unwrap();
+        let original = builder.snapshot().uuid;
+        let mut events = orch.subscribe_events();
+        let owner = orch.clone();
+        let sid = scope.session_id().clone();
+        let task = tokio::spawn(async move { owner.end_session(sid, EndReason::Normal).await });
+        store.committed.notified().await;
+        let handles = store.list_for_session(&scope).await.unwrap();
+        assert_eq!(handles.len(), 1);
+        assert!(matches!(
+            orch.session_record_status(&scope),
+            Some(Status::StoreOutcomeUnknown)
+        ));
+        next_matching(&mut events, |event| {
+            matches!(event, Event::SessionEnded { .. })
+        })
+        .await;
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        // Mutating a retained old builder cannot change the frozen retry intent.
+        builder.add_party(VconParty {
+            participant_id: ParticipantId::new(),
+            display_name: Some("late-private-canary".into()),
+            did: None,
+            stir: None,
+            validation: IdentityAssurance::Anonymous,
+        });
+        store.mode.store(0, Ordering::Release);
+        let mut attempts = tokio::task::JoinSet::new();
+        for _ in 0..8 {
+            let owner = orch.clone();
+            let scope = scope.clone();
+            attempts.spawn(async move { owner.retry_session_record(&scope).await.unwrap() });
+        }
+        while let Some(result) = attempts.join_next().await {
+            assert_eq!(ready(result.unwrap()).url, handles[0].url);
+        }
+        assert_eq!(store.list_for_session(&scope).await.unwrap().len(), 1);
+        let read = store.get(&scope, &handles[0]).await.unwrap().unwrap();
+        assert_eq!(read.record().uuid(), original);
+        assert!(!String::from_utf8_lossy(read.body()).contains("late-private-canary"));
+        drop(read);
+        next_matching(&mut events, |event| {
+            matches!(event, Event::VconReady { .. })
+        })
+        .await;
+        assert!(events.try_recv().is_err(), "one readiness fact only");
+    }
+    #[tokio::test]
+    async fn bounded_store_timeout_preserves_unknown_and_other_session_can_finalize() {
+        let (orch, store, scope) = setup(3).await;
+        let mut events = orch.subscribe_events();
+        let owner = orch.clone();
+        let sid = scope.session_id().clone();
+        let task = tokio::spawn(async move { owner.end_session(sid, EndReason::Normal).await });
+        store.committed.notified().await;
+        next_matching(&mut events, |event| {
+            matches!(event, Event::SessionEnded { .. })
+        })
+        .await;
+        store.mode.store(0, Ordering::Release);
+        let sid = orch
+            .start_session(
+                scope.conversation_id().clone(),
+                SessionMedium::Voice,
+                vec![],
+            )
+            .await
+            .unwrap();
+        orch.end_session(sid.clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        let other = VconScope::new(
+            scope.tenant_id().clone(),
+            scope.conversation_id().clone(),
+            sid,
+        );
+        ready(orch.session_record_status(&other));
+        tokio::time::timeout(Duration::from_secs(4), task)
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            orch.session_record_status(&scope),
+            Some(Status::StoreOutcomeUnknown)
+        ));
+        assert!(store.list_for_session(&scope).await.unwrap().is_empty());
+        ready(orch.retry_session_record(&scope).await.unwrap());
+    }
+    #[tokio::test]
+    async fn invalid_capture_and_fabricated_store_handle_never_announce_readiness() {
+        let (orch, store, scope) = setup(4).await;
+        let mut events = orch.subscribe_events();
+        orch.end_session(scope.session_id().clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        assert!(matches!(
+            orch.session_record_status(&scope),
+            Some(Status::StoreOutcomeUnknown)
+        ));
+        next_matching(&mut events, |event| {
+            matches!(event, Event::SessionEnded { .. })
+        })
+        .await;
+        assert!(events.try_recv().is_err());
+        store.mode.store(0, Ordering::Release);
+        ready(orch.retry_session_record(&scope).await.unwrap());
+        let sid = orch
+            .start_session(
+                scope.conversation_id().clone(),
+                SessionMedium::Voice,
+                vec![],
+            )
+            .await
+            .unwrap();
+        let invalid = VconScope::new(
+            scope.tenant_id().clone(),
+            scope.conversation_id().clone(),
+            sid.clone(),
+        );
+        orch.session_vcon_handle(&sid)
+            .unwrap()
+            .add_dialog(VconDialog {
+                kind: VconDialogKind::Text,
+                stream_id: None,
+                started: Utc::now(),
+                ended: None,
+                parties: vec![ParticipantId::new()],
+                mediatype: Some("text/plain".into()),
+                body: Some(Bytes::from_static(b"invalid private source")),
+                url: None,
+                content_hash: None,
+            });
+        orch.end_session(sid, EndReason::Normal).await.unwrap();
+        assert!(matches!(
+            orch.session_record_status(&invalid),
+            Some(Status::Ready(_))
+        ));
+        assert!(matches!(
+            orch.retry_session_record(&invalid).await.unwrap(),
+            Some(Status::Ready(_))
+        ));
+        let handles = store.list_for_session(&invalid).await.unwrap();
+        assert_eq!(handles.len(), 1);
+        let read = store.get(&invalid, &handles[0]).await.unwrap().unwrap();
+        assert!(!String::from_utf8_lossy(read.body()).contains("invalid private source"));
+    }
 }
