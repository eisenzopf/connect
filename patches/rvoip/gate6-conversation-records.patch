+#[tokio::test]
+async fn retention_selection_physically_clears_only_expired_content_then_deletes_expired_document()
+{
+    use super::redaction::*;
+    let (record, _, _, _) = fixture();
+    let mut sources = record.manifest().sources().to_vec();
+    let now = Utc::now();
+    for source in &mut sources {
+        if source.target() == RecordTarget::Analysis(0) {
+            source.content_retention = RecordRetention::Until(now - chrono::Duration::seconds(1));
+        }
+    }
+    let record = VconRecord::new(
+        record.body().clone(),
+        RecordManifest::new("retention-cas".into(), sources).unwrap(),
+    )
+    .unwrap();
+    let store = MemoryVconStore::new();
+    let owner = scope();
+    let handle = store.put(&owner, record).await.unwrap();
+    let read = store.get(&owner, &handle).await.unwrap().unwrap();
+    let action = retention_action(
+        read.record(),
+        "expire-transcript".into(),
+        handle.clone(),
+        now,
+    )
+    .unwrap()
+    .unwrap();
+    drop(read);
+    let RecordRetentionAction::Redact(intent) = action else {
+        panic!("content-only retention")
+    };
+    let fact = store.redact(&owner, &intent).await.unwrap().unwrap();
+    let read = store.get(&owner, fact.result()).await.unwrap().unwrap();
+    export_redacted_record("retention-redacted.json", read.body());
+    let text = String::from_utf8_lossy(read.body());
+    assert!(!text.contains("private-transcript-canary"));
+    assert!(text.contains("public-summary"));
+    assert!(retention_action(
+        read.record(),
+        "no-repeated-expiry".into(),
+        fact.result().clone(),
+        now
+    )
+    .unwrap()
+    .is_none());
+    let mut forged = serde_json::to_value(read.record().manifest()).unwrap();
+    let index = read
+        .record()
+        .manifest()
+        .sources()
+        .iter()
+        .position(|s| s.target() == RecordTarget::Analysis(1))
+        .unwrap();
+    forged["sources"][index]["state"] = json!("content-unavailable");
+    let forged = RecordManifest::decode(&serde_json::to_vec(&forged).unwrap()).unwrap();
+    assert!(
+        VconRecord::new(read.body().clone(), forged).is_err(),
+        "unavailable state cannot conceal retained bytes"
+    );
+    let mut sources = read.record().manifest().sources().to_vec();
+    sources
+        .iter_mut()
+        .find(|s| s.target() == RecordTarget::Document)
+        .unwrap()
+        .metadata_retention = RecordRetention::Until(now - chrono::Duration::seconds(1));
+    let expired = VconRecord::new(
+        read.body().clone(),
+        RecordManifest::new("expired-document".into(), sources).unwrap(),
+    )
+    .unwrap();
+    drop(read);
+    let other = scope();
+    let fresh = MemoryVconStore::new();
+    let handle = fresh.put(&other, expired).await.unwrap();
+    let read = fresh.get(&other, &handle).await.unwrap().unwrap();
+    let action = retention_action(read.record(), "expire-document".into(), handle.clone(), now)
+        .unwrap()
+        .unwrap();
+    drop(read);
+    let RecordRetentionAction::Delete(intent) = action else {
+        panic!("metadata retention deletes full record")
+    };
+    fresh.delete(&other, &intent).await.unwrap().unwrap();
+    assert!(fresh.get(&other, &handle).await.unwrap().is_none());
+}
