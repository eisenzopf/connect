+    let handle = store.put(&owner, record).await.unwrap();
+    for locator in [
+        VconLocator::new(Some(uuid), None).unwrap(),
+        VconLocator::new(None, Some(handle.url.clone())).unwrap(),
+        VconLocator::new(Some(uuid), Some(handle.url.clone())).unwrap(),
+    ] {
+        let read = store.lookup(&owner, &locator).await.unwrap().unwrap();
+        assert_eq!(read.record().uuid(), uuid);
