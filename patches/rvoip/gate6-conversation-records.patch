+        let doc: rvoip_vcon::Vcon = serde_json::from_slice(first.body()).unwrap();
+        assert_eq!(
+            doc.analysis.last().unwrap().body.as_ref().unwrap()["recorded_audio"],
+            false
+        );
+        let reference = first
+            .manifest()
+            .sources()
+            .iter()
+            .find(|s| s.category() == RecordCategory::ProviderReference)
+            .unwrap();
+        assert_eq!(
+            reference.content_retention(),
+            NamedLimits.retention(&scope, RecordCategory::ProviderReference)
+        );
+        assert_eq!(
+            reference.metadata_retention(),
+            NamedLimits.retention(&scope, RecordCategory::Metadata)
+        );
+        assert!(
+            !reference.admits(&ParticipantId::new()),
+            "raw builder grants nobody"
+        );
+        builder.add_dialog(VconDialog {
+            kind: VconDialogKind::Audio,
+            stream_id: None,
+            started: now,
+            ended: Some(now),
+            parties: vec![],
+            mediatype: Some("audio/opus".into()),
+            body: Some(Bytes::from_static(b"actual inline recording bytes")),
+            url: None,
+            content_hash: None,
+        });
+        builder.add_analysis(VconAnalysis {
+            kind: VconAnalysisKind::Transcript,
+            vendor: "test".into(),
+            product: None,
+            body: Bytes::from_static(b"actual transcript"),
+            mediatype: "text/plain".into(),
+        });
+        let second = RecordCaptureBuffer::default()
+            .finish(&builder.snapshot(), &session, &scope, &NamedLimits)
+            .unwrap();
+        let doc: rvoip_vcon::Vcon = serde_json::from_slice(second.body()).unwrap();
+        doc.validate().unwrap();
+        assert_eq!(
+            doc.analysis.last().unwrap().body.as_ref().unwrap()["recorded_audio"],
+            true
+        );
+        for category in [
+            RecordCategory::Transcript,
+            RecordCategory::RecordedMedia,
+            RecordCategory::ProviderReference,
+        ] {
+            let source = second
+                .manifest()
+                .sources()
+                .iter()
+                .find(|s| s.category() == category)
+                .unwrap();
+            assert_eq!(
+                source.content_retention(),
+                NamedLimits.retention(&scope, category)
+            );
+            assert_eq!(
+                source.metadata_retention(),
+                NamedLimits.retention(&scope, RecordCategory::Metadata)
+            );
+        }
+    }
+}
diff --git a/crates/foundation/rvoip-core/src/records/finalization.rs b/crates/foundation/rvoip-core/src/records/finalization.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/records/finalization.rs
@@ -0,0 +1,137 @@
+//! Owned Session record creation. Status is a local storage fact, never an
+//! audience grant, captured-audio claim, delivery receipt or remote outcome.
+use super::VconRecord;
+use crate::store::{VconHandle, VconScope, VconStore};
+use std::{
+    fmt,
+    sync::{Mutex, OnceLock},
+    time::Duration,
+};
+use tokio::sync::Mutex as AsyncMutex;
+
+/// One attempt is bounded; failed/uncertain writes retain the original document
+/// for explicit retry. No background task or automatic retry is detached.
+pub const RECORD_FINALIZATION_TIMEOUT: Duration = Duration::from_secs(2);
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum RecordUnavailableReason {
+    InvalidRecord,
+    MissingSource,
+}
+
+#[derive(Clone)]
+pub enum RecordFinalizationStatus {
+    Capturing,
+    Pending,
+    /// A write may have committed. Retry only the same original document;
+    /// neither a timeout, cancellation nor a backend error proves no effect.
+    StoreOutcomeUnknown,
+    Ready(VconHandle),
+    Unavailable(RecordUnavailableReason),
+}
+impl fmt::Debug for RecordFinalizationStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Capturing => f.write_str("Capturing"),
+            Self::Pending => f.write_str("Pending"),
+            Self::StoreOutcomeUnknown => f.write_str("StoreOutcomeUnknown"),
+            Self::Ready(handle) => f.debug_tuple("Ready").field(handle).finish(),
+            Self::Unavailable(reason) => f.debug_tuple("Unavailable").field(reason).finish(),
+        }
+    }
+}
+
+pub(crate) struct SessionRecordFinalization {
+    scope: VconScope,
+    #[cfg(feature = "vcon")]
+    pub(crate) capture: super::capture::RecordCaptureBuffer,
+    intent: OnceLock<Mutex<Option<VconRecord>>>,
+    status: Mutex<RecordFinalizationStatus>,
+    attempt: AsyncMutex<()>,
+}
+impl SessionRecordFinalization {
+    pub(crate) fn new(scope: VconScope) -> Self {
+        Self {
+            scope,
+            #[cfg(feature = "vcon")]
+            capture: super::capture::RecordCaptureBuffer::default(),
+            intent: OnceLock::new(),
+            status: Mutex::new(RecordFinalizationStatus::Capturing),
+            attempt: AsyncMutex::new(()),
+        }
+    }
+    pub(crate) fn scope(&self) -> &VconScope {
+        &self.scope
+    }
+    pub(crate) fn status(&self) -> RecordFinalizationStatus {
+        self.status
+            .lock()
+            .expect("record status lock poisoned")
+            .clone()
+    }
+    pub(crate) fn freeze(&self, record: std::result::Result<VconRecord, RecordUnavailableReason>) {
+        let mut status = self.status.lock().expect("record status lock poisoned");
+        if self.intent.get().is_some() {
+            return;
+        }
+        let (intent, next) = match record {
+            Ok(record) => (Some(record), RecordFinalizationStatus::Pending),
+            Err(reason) => (None, RecordFinalizationStatus::Unavailable(reason)),
+        };
+        self.intent
+            .set(Mutex::new(intent))
+            .unwrap_or_else(|_| unreachable!("freeze serialized"));
+        *status = next;
+    }
+    /// Caller owns this future. Cancellation leaves an explicit unknown status
+    /// and the immutable original intent, releasing the attempt lock for retry.
+    /// There is no suspension between recording Ready and returning its first
+    /// notification decision to the Orchestrator.
+    pub(crate) async fn persist(&self, store: &dyn VconStore) -> (RecordFinalizationStatus, bool) {
+        let _attempt = self.attempt.lock().await;
+        if let status @ RecordFinalizationStatus::Ready(_) = self.status() {
+            return (status, false);
+        }
+        let record = self
+            .intent
+            .get()
+            .and_then(|intent| intent.lock().expect("record intent lock poisoned").clone());
+        let Some(record) = record else {
+            return (self.status(), false);
+        };
+        *self.status.lock().expect("record status lock poisoned") =
+            RecordFinalizationStatus::StoreOutcomeUnknown;
+        let result = tokio::time::timeout(
+            RECORD_FINALIZATION_TIMEOUT,
+            store.put(&self.scope, record.clone()),
+        )
+        .await;
+        // Defensive verification of a backend's returned binding. A fabricated
+        // handle must never be announced as the stored original record.
+        let handle = match result {
+            Ok(Ok(handle))
+                if handle.revision == 1
+                    && handle.content_hash
+                        == crate::store::vcon_store::stored_content_hash(record.body())
+                    && record.manifest_hash().ok().as_ref() == Some(&handle.manifest_hash)
+                    && !handle.url.is_empty()
+                    && handle.url.len() <= 2048
+                    && !handle.url.chars().any(char::is_control) =>
+            {
+                handle
+            }
+            _ => return (self.status(), false),
+        };
+        // Release the retry copy once the backend confirms the exact binding.
+        // Subsequent retention/deletion must not leave a second owned body here.
+        self.intent
+            .get()
+            .expect("frozen intent")
+            .lock()
+            .expect("record intent lock poisoned")
+            .take();
+        let status = RecordFinalizationStatus::Ready(handle);
+        *self.status.lock().expect("record status lock poisoned") = status.clone();
+        (status, true)
+    }
+}
diff --git a/crates/foundation/rvoip-core/src/records/lineage.rs b/crates/foundation/rvoip-core/src/records/lineage.rs
