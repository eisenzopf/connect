+/// Local index selection, never permission or a URL to retrieve over network.
+/// When both identifiers are present they must identify the same stored record.
+#[derive(Clone)]
+pub struct VconLocator {
+    uuid: Option<uuid::Uuid>,
+    url: Option<String>,
+}
+impl VconLocator {
+    pub fn new(uuid: Option<uuid::Uuid>, url: Option<String>) -> Result<Self> {
+        if (uuid.is_none() && url.is_none())
+            || uuid.is_some_and(|id| id.is_nil())
+            || url.as_ref().is_some_and(|url| {
+                url.is_empty()
+                    || url.len() > 2048
+                    || url.chars().any(|c| c.is_control() || c.is_whitespace())
+            })
+        {
+            return Err(RvoipError::InvalidState("invalid local record selector"));
+        }
+        Ok(Self { uuid, url })
+    }
+    pub fn uuid(&self) -> Option<uuid::Uuid> {
+        self.uuid
+    }
+    pub fn url(&self) -> Option<&str> {
+        self.url.as_deref()
+    }
+    fn matches(&self, id: uuid::Uuid, url: &str) -> bool {
+        self.uuid.is_none_or(|expected| expected == id)
+            && self.url.as_deref().is_none_or(|expected| expected == url)
+    }
+}
