+async fn autoend_record_fixture(fail_store: bool) {
+    use rvoip_core::{
+        events::Event, records::finalization::RecordFinalizationStatus, store::VconScope,
+    };
+    let store = Arc::new(AutoendStore {
+        inner: rvoip_core::store::MemoryVconStore::new(),
+        fail: std::sync::atomic::AtomicBool::new(fail_store),
+    });
+    let core = Orchestrator::new(CoreConfig {
+        vcon_store: store.clone(),
+        ..CoreConfig::default()
+    });
+    let (adapter, events) = CallerAdapter::new();
+    core.register(adapter).unwrap();
+    let caller = admit_caller_on(&core, &events).await;
+    assert!(
+        core.operational_event_stream_health()
+            == rvoip_core::operational_events::OperationalEventStreamHealth::NotInstalled
+    );
+    let sid = core.session_of(&caller).unwrap();
+    let cid = core
+        .session(&sid)
+        .unwrap()
+        .read()
+        .unwrap()
+        .conversation_id
+        .clone();
+    let tenant = core
+        .conversation(&cid)
+        .unwrap()
+        .read()
+        .unwrap()
+        .tenant_id
+        .clone();
+    let scope = VconScope::new(tenant, cid, sid.clone());
+    let original_builder = core.session_vcon_handle(&sid).unwrap();
+    let mut notifications = core.subscribe_events();
+    events
+        .send(AdapterEvent::Connected {
+            connection_id: caller.clone(),
+        })
+        .await
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            if matches!(
+                notifications.recv().await.unwrap(),
+                Event::ConnectionConnected { .. }
+            ) {
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+    events
+        .send(if fail_store {
+            AdapterEvent::Failed {
+                connection_id: caller.clone(),
+                detail: "private-terminal-error-canary".into(),
+            }
+        } else {
+            AdapterEvent::Ended {
+                connection_id: caller.clone(),
+                reason: rvoip_core::adapter::EndReason::Normal,
+            }
+        })
+        .await
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            if matches!(
+                notifications.recv().await.unwrap(),
+                Event::ConnectionEnded { .. } | Event::ConnectionFailed { .. }
+            ) {
+                break;
+            }
+        }
+    })
+    .await
+    .unwrap();
+    assert!(core.session_of(&caller).is_none());
+    assert!(core.session_vcon_handle(&sid).is_none());
+    if fail_store {
+        assert!(matches!(
+            core.session_record_status(&scope),
+            Some(RecordFinalizationStatus::StoreOutcomeUnknown)
+        ));
+        assert!(core
+            .config
+            .vcon_store
+            .list_for_session(&scope)
+            .await
+            .unwrap()
+            .is_empty());
+        original_builder.add_analysis(rvoip_core::VconAnalysis {
+            kind: rvoip_core::VconAnalysisKind::Summary,
+            vendor: "fixture".into(),
+            product: None,
+            body: Bytes::from_static(b"changed-after-autoend-canary"),
+            mediatype: "text/plain".into(),
+        });
+        store.fail.store(false, Ordering::SeqCst);
+        core.end_session(sid.clone(), rvoip_core::adapter::EndReason::Cancelled)
+            .await
+            .unwrap();
+    }
+    let Some(RecordFinalizationStatus::Ready(handle)) = core.session_record_status(&scope) else {
+        panic!("automatic outcome was not persisted")
+    };
+    let read = core
+        .config
+        .vcon_store
+        .get(&scope, &handle)
+        .await
+        .unwrap()
+        .unwrap();
+    let body: serde_json::Value = serde_json::from_slice(read.body()).unwrap();
+    assert!(!String::from_utf8_lossy(read.body()).contains("private-terminal-error-canary"));
+    assert!(!String::from_utf8_lossy(read.body()).contains("changed-after-autoend-canary"));
+    let outcomes = body["analysis"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|a| a["type"] == "session-outcome")
+        .collect::<Vec<_>>();
+    assert_eq!(outcomes.len(), 1);
+    assert_eq!(
+        outcomes[0]["body"]["reason"],
+        if fail_store { "failed" } else { "normal" }
+    );
+    let facts = body["analysis"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|a| a["type"] == "connection-lineage")
+        .collect::<Vec<_>>();
+    assert_eq!(body["parties"].as_array().unwrap().len(), 1);
+    for phase in [
+        "locally-admitted",
+        "adapter-connected",
+        if fail_store {
+            "adapter-failed"
+        } else {
+            "adapter-ended"
+        },
+        "locally-retired",
+    ] {
+        assert!(
+            facts.iter().any(|a| a["body"]["phase"] == phase),
+            "missing {phase}"
+        );
+    }
+    assert!(body["analysis"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .any(|a| a["type"] == "session-outcome" && a["body"]["recorded_audio"] == false));
+    for source in read
+        .record()
+        .manifest()
+        .sources()
+        .iter()
+        .filter(|s| s.id().starts_with("connection."))
+    {
+        assert_eq!(
+            source.provenance().connection.as_deref(),
+            Some(caller.as_str())
+        );
+        assert!(source.provenance().connection_generation.unwrap() > 0);
+        assert!(!source.id().contains(caller.as_str()));
+        assert_eq!(
+            serde_json::to_value(source).unwrap()["audience"]["kind"],
+            "policy"
+        );
+    }
+    let original = read.body().clone();
+    drop(read);
+    core.end_session(sid, rvoip_core::adapter::EndReason::Normal)
+        .await
+        .unwrap();
+    assert_eq!(
+        core.config
+            .vcon_store
+            .list_for_session(&scope)
+            .await
+            .unwrap()
+            .len(),
+        1
+    );
+    assert_eq!(
+        core.config
+            .vcon_store
+            .get(&scope, &handle)
+            .await
+            .unwrap()
+            .unwrap()
+            .body(),
+        &original
+    );
+    if let Some(dir) = std::env::var_os("CONNECT_G6_RECORD_VIEW_EXPORT_DIR") {
+        let dir = std::path::PathBuf::from(dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(
+            dir.join(if fail_store {
+                "actual-autoend-recovery.json"
+            } else {
+                "actual-autoend-lineage.json"
+            }),
+            original,
+        )
+        .unwrap();
+    }
+}
