+//! Persisted source/audience data for records. These values are not authority.
+use crate::{
+    agent::ObservationCompleteness,
+    error::{Result, RvoipError},
+    ids::ParticipantId,
+};
+use bytes::Bytes;
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fmt, io,
+};
+use uuid::Uuid;
+
+pub const MAX_RECORD_BYTES: usize = 16 * 1024 * 1024;
+pub const MAX_RECORD_MANIFEST_BYTES: usize = 1024 * 1024;
+pub const MAX_RECORD_SOURCES: usize = 4096;
+fn invalid() -> RvoipError {
+    RvoipError::InvalidState("invalid or oversized record source manifest")
+}
+fn id(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || b"._~-".contains(&c))
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "index", rename_all = "kebab-case")]
+pub enum RecordTarget {
+    Document,
+    Party(u32),
+    Dialog(u32),
+    Analysis(u32),
+    Attachment(u32),
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum RecordCategory {
+    Metadata,
+    Transcript,
+    RecordedMedia,
+    ProviderReference,
+}
+#[derive(Clone, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "participants", rename_all = "kebab-case")]
+pub enum RecordAudience {
+    Participants(Vec<ParticipantId>),
+    Policy,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "until", rename_all = "kebab-case")]
+pub enum RecordRetention {
+    UntilDeleted,
+    Until(DateTime<Utc>),
+}
+impl RecordRetention {
+    pub fn permits(&self, now: DateTime<Utc>) -> bool {
+        match self {
+            Self::UntilDeleted => true,
+            Self::Until(until) => now < *until,
+        }
+    }
+}
