+    forged["sources"][tombstone]["audience"] = json!({"kind":"policy"});
+    let forged = RecordManifest::decode(&serde_json::to_vec(&forged).unwrap()).unwrap();
+    assert!(
+        VconRecord::new(read.body().clone(), forged).is_err(),
+        "metadata tombstone must clear its stored audience too"
+    );
+    let doc: rvoip_vcon::Vcon = serde_json::from_slice(read.body()).unwrap();
+    doc.validate().unwrap();
+    let text = String::from_utf8_lossy(read.body());
+    for canary in [
+        "private-consultant-canary",
+        "private-dialog-canary",
+        "private-transcript-canary",
+        "private-attachment-canary",
+        "derived-private-canary",
+        ai.as_str(),
+    ] {
+        assert!(
+            !text.contains(canary),
+            "removed source metadata/content must be absent"
+        );
+    }
+    assert!(text.contains("public-dialog") && text.contains("public-summary"));
+    assert_eq!(
+        read.record()
+            .manifest()
+            .sources()
+            .iter()
+            .map(|s| s.id().to_owned())
+            .collect::<BTreeSet<_>>(),
