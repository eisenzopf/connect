+//! Canonical record fetch and bounded authorized retrieval. The application
+//! supplies current credential/resource/source authority; URLs grant nothing.
+use super::{
+    auth_dispatch::{AuthenticatedHandler, AuthorityLease, AuthorizedEnvelope, DispatchError},
+    Envelope, Payload, Scope,
+};
+use async_trait::async_trait;
+use bytes::Bytes;
+use chrono::{DateTime, Utc};
+use rvoip_auth_core::bearer::AuthenticatedPrincipal;
+use rvoip_core::{
+    ids::ParticipantId,
+    records::{
+        RecordProjection, RecordView, RecordViewControl, RecordViewError, RecordViewLease,
+        RecordViewRequest,
+    },
+    store::{VconLocator, VconScope, VconStore},
+};
+use serde_json::json;
+use std::{
+    collections::HashMap,
+    fmt,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use tokio::{
+    io::{AsyncWrite, AsyncWriteExt},
+    time::Instant,
+};
+use tokio_util::sync::CancellationToken;
+
+const MAX_INLINE: usize = 128 * 1024;
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum RecordFetchError {
+    #[error("record unavailable")]
+    Missing,
+    #[error("record storage unavailable")]
+    Storage,
+    #[error("record view changed or expired")]
+    Changed,
+    #[error("record delivery unavailable")]
+    Delivery,
+    #[error("record authority denied or expired")]
+    Authority,
+}
+impl RecordFetchError {
+    fn problem(self) -> (u16, &'static str) {
+        match self {
+            Self::Missing => (404, "record_not_found"),
+            Self::Storage => (503, "record_store_unavailable"),
+            Self::Changed => (409, "record_view_changed"),
+            Self::Delivery => (503, "record_delivery_unavailable"),
+            Self::Authority => (403, "record_authority_denied"),
+        }
+    }
+}
+struct Ready {
+    projection: RecordProjection,
+    request: RecordViewRequest,
+}
+enum Outcome {
+    Ready(Ready),
+    Problem(RecordFetchError),
+}
+/// Owned by the invocation's AuthorityLease and hence the actual peer writer.
+/// No detached task, blanket Session audience or future authorization is stored.
+pub struct RecordFetchCustody {
+    invocation: serde_json::Value,
+    principal: AuthenticatedPrincipal,
+    authority: AuthorityLease,
+    outcome: Outcome,
+    references: Option<Arc<RecordReferenceRegistry>>,
+    inline_limit: usize,
+    cancel: CancellationToken,
+}
+impl RecordFetchCustody {
+    fn current(&self) -> bool {
+        !self.cancel.is_cancelled()
+            && self.authority.current()
+            && match &self.outcome {
+                Outcome::Ready(ready) => ready.projection.view().is_ok(),
+                _ => true,
+            }
+    }
+    pub fn original_authority(&self) -> &AuthorityLease {
+        &self.authority
+    }
+    /// Data for a currently authorized readiness hint. No storage URI or full
+    /// canonical/manifest digest is exposed; readiness is never audio capture.
+    pub fn ready_payload(&self) -> Result<serde_json::Value, RecordFetchError> {
+        if !self.current() {
+            return Err(RecordFetchError::Authority);
+        }
+        let Outcome::Ready(ready) = &self.outcome else {
+            return Err(RecordFetchError::Missing);
+        };
+        let view = ready
+            .projection
+            .view()
+            .map_err(|_| RecordFetchError::Authority)?;
+        Ok(
+            json!({"vcon_handle":{"uuid":view.uuid,"revision":view.revision,"content_hash":view.content_hash},"encrypted":false,"signed_by":view.signed_by}),
+        )
+    }
+}
+impl fmt::Debug for RecordFetchCustody {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("RecordFetchCustody([redacted])")
+    }
+}
+/// Trusted backend composition during current authority acquisition. `scope`
+/// and `viewer` come from the verified principal's actual resource binding.
+/// `sources` must derive under that SAME held current authority, with no reader
+/// reacquisition behind a queued writer. The returned lease retains everything
+/// through physical response IO. Its data is not authority for a later request.
+#[allow(clippy::too_many_arguments)]
+pub async fn authorize_record_fetch<F>(
+    envelope: &Envelope,
+    principal: &AuthenticatedPrincipal,
+    scope: VconScope,
+    viewer: ParticipantId,
+    authority: AuthorityLease,
+    store: &dyn VconStore,
+    sources: F,
+    cancel: CancellationToken,
+    deadline: Instant,
+    references: Option<Arc<RecordReferenceRegistry>>,
+    inline_limit: usize,
+) -> Result<AuthorityLease, DispatchError>
+where
+    F: FnOnce(
+            &RecordViewRequest,
+            &AuthorityLease,
+        ) -> Result<Box<dyn RecordViewLease>, DispatchError>
+        + Send,
+{
+    if !authority.current() || cancel.is_cancelled() || Instant::now() >= deadline {
+        return Err(DispatchError::Authority);
+    }
+    let Payload::RecordingVconFetch(query) = envelope.payload() else {
+        return Err(DispatchError::Unsupported);
+    };
+    if envelope.scope(Scope::Conversation) != Some(scope.conversation_id().as_str())
+        || envelope.scope(Scope::Session) != Some(scope.session_id().as_str())
+    {
+        return Err(DispatchError::Authority);
+    }
+    let uuid = query
+        .uuid
+        .as_ref()
+        .map(|id| uuid::Uuid::parse_str(id))
+        .transpose()
+        .map_err(|_| DispatchError::Wire(super::WireError::InvalidPayload))?;
+    let locator = VconLocator::new(uuid, query.url.clone())
+        .map_err(|_| DispatchError::Wire(super::WireError::InvalidPayload))?;
+    let deadline = deadline
+        .min(authority.deadline().unwrap_or(deadline))
+        .min(Instant::now() + super::auth_dispatch::MAX_DISPATCH_WAIT);
+    let read = tokio::select! {biased;_=cancel.cancelled()=>return Err(DispatchError::Closed),_=tokio::time::sleep_until(deadline)=>return Err(DispatchError::Closed),read=store.lookup(&scope,&locator)=>read};
+    let outcome = match read {
+        Err(_) => Outcome::Problem(RecordFetchError::Storage),
+        Ok(None) => Outcome::Problem(RecordFetchError::Missing),
+        Ok(Some(read)) => {
+            let handle = read.handle();
+            let request = RecordViewRequest::new(
+                scope,
+                viewer,
+                read.record().uuid(),
+                handle.revision,
+                handle.content_hash.clone(),
+                handle.manifest_hash.clone(),
+                format!(
+                    "record-view-{}-{}",
+                    read.record().uuid().simple(),
+                    handle.revision
+                ),
+            )
+            .map_err(|_| DispatchError::Authority)?;
+            let lease = sources(&request, &authority)?;
+            let control = RecordViewControl::new(request.clone(), lease, cancel.clone(), deadline)
+                .map_err(|_| DispatchError::Authority)?;
+            match RecordProjection::prepare(read, control) {
+                Ok(projection) => {
+                    if query.content_hash.as_ref().is_some_and(|expected| {
+                        projection
+                            .view()
+                            .map_or(true, |view| view.content_hash != expected)
+                    }) {
+                        Outcome::Problem(RecordFetchError::Changed)
+                    } else {
+                        Outcome::Ready(Ready {
+                            projection,
+                            request,
+                        })
+                    }
+                }
+                Err(RecordViewError::Integrity) => Outcome::Problem(RecordFetchError::Delivery),
+                Err(_) => Outcome::Problem(RecordFetchError::Missing),
+            }
+        }
+    };
+    if !authority.current() {
+        return Err(DispatchError::Authority);
+    }
+    let custody = Arc::new(RecordFetchCustody {
+        invocation: envelope.original().clone(),
+        principal: principal.clone(),
+        authority,
+        outcome,
+        references,
+        inline_limit: inline_limit.clamp(1, MAX_INLINE),
+        cancel,
+    });
+    let check = custody.clone();
+    Ok(AuthorityLease::checking(custody, deadline, move || {
+        check.current()
+    }))
+}
+
+/// Fetch-only canonical handler. Compose with the application's other request
+/// families. Missing/failed stores produce correlated explicit factual errors.
+#[derive(Default)]
+pub struct RecordFetchHandler;
+#[async_trait]
+impl AuthenticatedHandler for RecordFetchHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let custody = authorized
+            .authority::<Arc<RecordFetchCustody>>()
+            .ok_or(DispatchError::Authority)?;
+        if !custody.current()
+            || !custody.principal.has_same_owner(authorized.principal())
+            || custody.invocation != *authorized.envelope().original()
+        {
+            return Err(DispatchError::Authority);
+        }
+        let request = authorized.envelope();
+        let result = (|| -> Result<serde_json::Value, RecordFetchError> {
+            let Outcome::Ready(ready) = &custody.outcome else {
+                if let Outcome::Problem(error) = custody.outcome {
+                    return Err(error);
+                }
+                unreachable!()
+            };
+            let view = ready
+                .projection
+                .view()
+                .map_err(|_| RecordFetchError::Authority)?;
+            if view.body.len() <= custody.inline_limit {
+                Ok(
+                    json!({"delivery":"inline","vcon":std::str::from_utf8(view.body).map_err(|_|RecordFetchError::Storage)?,"content_hash":view.content_hash}),
+                )
+            } else {
+                let registry = custody
+                    .references
+                    .as_ref()
+                    .ok_or(RecordFetchError::Delivery)?;
+                let reference = registry.issue(&ready.request, &view)?;
+                Ok(
+                    json!({"delivery":"url","url":reference.url,"expires_at":reference.expires_at,"content_hash":view.content_hash}),
+                )
+            }
+        })();
+        let (kind, payload) = match result {
+            Ok(payload) => ("recording.vcon-fetched", payload),
+            Err(error) => {
+                let (code, reason) = error.problem();
+                (
+                    "error",
+                    json!({"category":"recording","code":code,"reason":reason}),
+                )
+            }
+        };
+        let mut reply = json!({"v":2,"type":kind,"id":format!("record-reply-{}",uuid::Uuid::new_v4().simple()),"ts":Utc::now(),"in_reply_to":request.id(),"payload":payload});
+        for key in ["cid", "sid", "connid"] {
+            if let Some(value) = request.original().get(key) {
+                reply[key] = value.clone();
+            }
+        }
+        Envelope::from_value(reply).map_err(DispatchError::from)
+    }
+}
+struct Reference {
+    url: String,
+    expires_at: DateTime<Utc>,
+}
+#[derive(Clone)]
+struct Entry {
+    request: RecordViewRequest,
+    hash: String,
+    expires_at: DateTime<Utc>,
+    end: Instant,
+}
+/// Bounded ephemeral DATA references, without record bytes or authority guards.
+/// The HTTP/native adapter MUST authenticate each retrieval again; URL secrecy
+/// alone never grants content. Restart loses references rather than authority.
+pub struct RecordReferenceRegistry {
+    base: String,
+    capacity: usize,
+    ttl: Duration,
+    entries: Mutex<HashMap<String, Entry>>,
+}
+impl RecordReferenceRegistry {
+    pub fn new(base: String, capacity: usize, ttl: Duration) -> Result<Self, RecordFetchError> {
+        let authority = base
+            .strip_prefix("https://")
+            .and_then(|rest| rest.split('/').next())
+            .unwrap_or("");
+        if authority.is_empty()
+            || base.len() > 1900
+            || base
+                .chars()
+                .any(|c| c.is_control() || c.is_whitespace() || matches!(c, '?' | '#' | '@'))
+            || !(1..=4096).contains(&capacity)
+            || ttl.is_zero()
+            || ttl > Duration::from_secs(300)
+        {
+            return Err(RecordFetchError::Delivery);
+        }
+        Ok(Self {
+            base: base.trim_end_matches('/').into(),
+            capacity,
+            ttl,
+            entries: Mutex::new(HashMap::new()),
+        })
+    }
+    fn issue(
+        &self,
+        request: &RecordViewRequest,
+        view: &RecordView<'_>,
+    ) -> Result<Reference, RecordFetchError> {
+        if request.uuid() != view.uuid || request.revision() != view.revision {
+            return Err(RecordFetchError::Changed);
+        }
+        let now = Utc::now();
+        let instant = Instant::now();
+        let mut entries = self
+            .entries
+            .lock()
+            .map_err(|_| RecordFetchError::Delivery)?;
+        entries.retain(|_, entry| entry.end > instant && entry.expires_at > now);
+        if entries.len() >= self.capacity {
+            return Err(RecordFetchError::Delivery);
+        }
+        let url = format!("{}/{}", self.base, uuid::Uuid::new_v4().simple());
+        let expires_at =
+            now + chrono::Duration::from_std(self.ttl).map_err(|_| RecordFetchError::Delivery)?;
+        entries.insert(
+            url.clone(),
+            Entry {
+                request: request.clone(),
+                hash: view.content_hash.into(),
+                expires_at,
+                end: instant + self.ttl,
+            },
+        );
+        Ok(Reference { url, expires_at })
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub async fn retrieve<F>(
+        &self,
+        url: &str,
+        scope: &VconScope,
+        viewer: &ParticipantId,
+        authority: AuthorityLease,
+        store: &dyn VconStore,
+        sources: F,
+        cancel: CancellationToken,
+        deadline: Instant,
+    ) -> Result<GuardedRecordBody, RecordFetchError>
+    where
+        F: FnOnce(
+                &RecordViewRequest,
+                &AuthorityLease,
+            ) -> Result<Box<dyn RecordViewLease>, DispatchError>
+            + Send,
+    {
+        if !authority.current() {
+            return Err(RecordFetchError::Authority);
+        }
+        let entry = self
+            .entries
+            .lock()
+            .map_err(|_| RecordFetchError::Delivery)?
+            .get(url)
+            .cloned()
+            .ok_or(RecordFetchError::Missing)?;
+        if entry.request.scope() != scope || entry.request.viewer() != viewer {
+            return Err(RecordFetchError::Authority);
+        }
+        if entry.end <= Instant::now() || entry.expires_at <= Utc::now() {
+            return Err(RecordFetchError::Changed);
+        }
+        let deadline = deadline
+            .min(authority.deadline().unwrap_or(deadline))
+            .min(entry.end)
+            .min(Instant::now() + Duration::from_secs(30));
+        let locator = VconLocator::new(Some(entry.request.uuid()), None)
+            .map_err(|_| RecordFetchError::Missing)?;
+        let read = tokio::select! {biased;_=cancel.cancelled()=>return Err(RecordFetchError::Authority),_=tokio::time::sleep_until(deadline)=>return Err(RecordFetchError::Changed),read=store.lookup(scope,&locator)=>read.map_err(|_|RecordFetchError::Storage)?.ok_or(RecordFetchError::Missing)?};
+        if read.handle().revision != entry.request.revision()
+            || read.handle().content_hash != entry.request.body_hash()
+            || read.handle().manifest_hash != entry.request.manifest_hash()
+        {
+            return Err(RecordFetchError::Changed);
+        }
+        let request = RecordViewRequest::new(
+            scope.clone(),
+            viewer.clone(),
+            read.record().uuid(),
+            read.handle().revision,
+            read.handle().content_hash.clone(),
+            read.handle().manifest_hash.clone(),
+            entry.request.correlation().into(),
+        )
+        .map_err(|_| RecordFetchError::Changed)?;
+        let lease = sources(&request, &authority).map_err(|_| RecordFetchError::Authority)?;
+        let control = RecordViewControl::new(request, lease, cancel.clone(), deadline)
+            .map_err(|_| RecordFetchError::Authority)?;
+        let projection =
+            RecordProjection::prepare(read, control).map_err(|_| RecordFetchError::Authority)?;
+        if projection
+            .view()
+            .map_err(|_| RecordFetchError::Authority)?
+            .content_hash
+            != entry.hash
+        {
+            return Err(RecordFetchError::Changed);
+        }
+        Ok(GuardedRecordBody {
+            projection,
+            authority,
+            cancel,
+            deadline,
+        })
+    }
+}
+/// Own this through actual response IO; copying its bytes cannot copy custody.
+pub struct GuardedRecordBody {
+    projection: RecordProjection,
+    authority: AuthorityLease,
+    cancel: CancellationToken,
+    deadline: Instant,
+}
+impl GuardedRecordBody {
+    pub fn view(&self) -> Result<RecordView<'_>, RecordFetchError> {
+        if !self.authority.current()
+            || self.cancel.is_cancelled()
+            || Instant::now() >= self.deadline
+        {
+            return Err(RecordFetchError::Authority);
+        }
+        self.projection
+            .view()
+            .map_err(|_| RecordFetchError::Authority)
+    }
+    /// Bounded raw-body submission to an adapter-owned writer. Success records
+    /// only local IO completion; it is never a remote receipt or durable cursor.
+    pub async fn write_to<W: AsyncWrite + Unpin>(
+        self,
+        writer: &mut W,
+    ) -> Result<(), RecordFetchError> {
+        let bytes: Bytes = self.view()?.body.clone();
+        for chunk in bytes.chunks(16 * 1024) {
+            self.view()?;
+            tokio::select! {biased;_=self.cancel.cancelled()=>return Err(RecordFetchError::Authority),_=tokio::time::sleep_until(self.deadline)=>return Err(RecordFetchError::Changed),result=writer.write_all(chunk)=>{result.map_err(|_|RecordFetchError::Delivery)?;}}
+        }
+        self.view()?;
+        Ok(())
+    }
+}
