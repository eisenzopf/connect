+/// Local deletion fact. It neither grants access nor claims provider deletion.
+#[derive(Clone, Eq, PartialEq)]
+pub struct VconTombstone {
+    scope: VconScope,
+    url: String,
+    operation_id: String,
+    revision: u64,
+    deleted_at: DateTime<Utc>,
+}
+impl VconTombstone {
+    /// Trusted persistence reconstruction after exact owner/operation checks.
+    pub fn recorded(
+        scope: VconScope,
+        url: String,
+        operation_id: String,
+        revision: u64,
+        deleted_at: DateTime<Utc>,
+    ) -> Result<Self> {
+        if url.is_empty()
+            || url.len() > 2048
+            || url.chars().any(char::is_control)
+            || revision < 2
+            || revision > MAX_VCON_REVISION
+            || operation_id.is_empty()
+            || operation_id.len() > 128
+            || !operation_id
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"._~-".contains(&c))
+        {
+            return Err(RvoipError::InvalidState("invalid vCon tombstone"));
+        }
+        Ok(Self {
+            scope,
+            url,
+            operation_id,
+            revision,
+            deleted_at,
+        })
+    }
+    pub fn scope(&self) -> &VconScope {
+        &self.scope
+    }
+    pub fn url(&self) -> &str {
+        &self.url
+    }
+    pub fn operation_id(&self) -> &str {
