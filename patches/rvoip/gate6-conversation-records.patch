+struct AutoendStore {
+    inner: rvoip_core::store::MemoryVconStore,
+    fail: std::sync::atomic::AtomicBool,
+}
+#[async_trait::async_trait]
+impl rvoip_core::store::VconStore for AutoendStore {
+    async fn put(
+        &self,
+        s: &rvoip_core::store::VconScope,
+        r: rvoip_core::records::VconRecord,
+    ) -> rvoip_core::Result<rvoip_core::store::VconHandle> {
+        if self.fail.load(Ordering::SeqCst) {
+            return Err(rvoip_core::RvoipError::InvalidState(
+                "synthetic store failure",
+            ));
+        }
+        self.inner.put(s, r).await
+    }
+    async fn get(
+        &self,
+        s: &rvoip_core::store::VconScope,
+        h: &rvoip_core::store::VconHandle,
+    ) -> rvoip_core::Result<Option<rvoip_core::store::VconRead>> {
+        self.inner.get(s, h).await
+    }
+    async fn lookup(
+        &self,
+        s: &rvoip_core::store::VconScope,
+        l: &rvoip_core::store::VconLocator,
+    ) -> rvoip_core::Result<Option<rvoip_core::store::VconRead>> {
+        self.inner.lookup(s, l).await
+    }
+    async fn delete(
+        &self,
+        s: &rvoip_core::store::VconScope,
+        i: &rvoip_core::store::VconDeletion,
+    ) -> rvoip_core::Result<Option<rvoip_core::store::VconTombstone>> {
+        self.inner.delete(s, i).await
+    }
+    async fn redact(
+        &self,
+        s: &rvoip_core::store::VconScope,
+        i: &rvoip_core::records::redaction::VconRedaction,
+    ) -> rvoip_core::Result<Option<rvoip_core::records::redaction::VconRedactionFact>> {
+        self.inner.redact(s, i).await
+    }
+    async fn tombstone(
+        &self,
+        s: &rvoip_core::store::VconScope,
+        u: &str,
+    ) -> rvoip_core::Result<Option<rvoip_core::store::VconTombstone>> {
+        self.inner.tombstone(s, u).await
+    }
+    async fn list_for_session(
+        &self,
+        s: &rvoip_core::store::VconScope,
+    ) -> rvoip_core::Result<Vec<rvoip_core::store::VconHandle>> {
+        self.inner.list_for_session(s).await
+    }
+    async fn list_for_conversation(
+        &self,
+        t: &TenantId,
+        c: &rvoip_core::ids::ConversationId,
+    ) -> rvoip_core::Result<Vec<rvoip_core::store::VconHandle>> {
+        self.inner.list_for_conversation(t, c).await
+    }
+}
