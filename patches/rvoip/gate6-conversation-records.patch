+async fn guarded_inline_fixture(signing: bool) {
+    let (f, p, h, id) = setup(128 * 1024, Duration::from_secs(5)).await;
+    if signing {
+        p.signing.store(1, Ordering::SeqCst);
+    }
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let handler = Arc::new(Counted {
+        returned: Notify::new(),
+    });
+    let notify = handler.clone();
+    let (a, b) = tokio::io::duplex(64);
+    let (rd, wr) = tokio::io::split(a);
+    let (cr, cw) = tokio::io::split(b);
+    let server = tokio::spawn(async move { peer.run(rd, wr, handler.as_ref()).await });
+    let mut writer = FramedWrite::new(cw, rvoip_uctp::substrate::length_prefixed_codec());
+    let mut reader = FramedRead::new(cr, rvoip_uctp::substrate::length_prefixed_codec());
+    let request = fetch(id);
+    writer
+        .send(Bytes::from(f.sign(request.clone())))
+        .await
+        .unwrap();
+    notify.returned.notified().await;
+    let revoke = tokio::spawn({
+        let sources = p.sources.clone();
+        async move {
+            sources.write().await.clear();
+        }
+    });
+    let intent = VconDeletion::new("delete-after-fetch".into(), h.clone()).unwrap();
+    let deletion = tokio::spawn({
+        let b = p.backend.clone();
+        async move { b.delete(&scope(), &intent).await.unwrap() }
+    });
+    tokio::task::yield_now().await;
+    assert!(!revoke.is_finished() && !deletion.is_finished());
+    let reply = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    assert_eq!(reply.kind(), "recording.vcon-fetched");
+    f.verify_server(&reply).await;
+    assert_eq!(reply.scope(Scope::Reply), request["id"].as_str());
+    let payload = &reply.original()["payload"];
+    let body = payload["vcon"].as_str().unwrap();
+    assert_eq!(payload["content_hash"], hash(body.as_bytes()));
+    assert_ne!(payload["content_hash"], h.content_hash);
+    let decoded;
+    let projected = if signing {
+        use rvoip_core::signed_vcon::*;
+        let signed: SignedVcon = serde_json::from_str(body).unwrap();
+        let key = jsonwebtoken::DecodingKey::from_rsa_pem(include_bytes!(
+            "../../../../extensions/rvoip-vcon/tests/fixtures/jws-rs256-public-key.txt"
+        ))
+        .unwrap();
+        let verified = verify_jws(&signed, &key, jsonwebtoken::Algorithm::RS256).unwrap();
+        decoded = serde_json::to_string(&verified).unwrap();
+        assert_ne!(hash(decoded.as_bytes()), payload["content_hash"]);
+        decoded.as_str()
+    } else {
+        body
+    };
+    assert!(
+        projected.contains("public-record-body")
+            && !projected.contains("private-record-body-canary")
+            && !projected.contains("private-record-party-canary")
+    );
+    tokio::time::timeout(Duration::from_secs(2), revoke)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(deletion.await.unwrap().is_some());
+    writer.close().await.unwrap();
+    tokio::time::timeout(Duration::from_secs(2), server)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    if let Some(dir) = std::env::var_os("CONNECT_G6_RECORD_VIEW_EXPORT_DIR") {
+        let dir = std::path::PathBuf::from(dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(
+            dir.join(if signing {
+                "canonical-signed-payload.json"
+            } else {
+                "canonical-fetch-view.json"
+            }),
+            projected,
+        )
+        .unwrap();
+        if signing {
+            std::fs::write(dir.join("canonical-signed-fetch.jws"), body).unwrap();
+        }
+    }
+}
+#[tokio::test]
+async fn canonical_fetch_missing_store_failed_and_wrong_projected_digest_are_explicit_and_correlated(
+) {
+    let (f, p, _, id) = setup(128 * 1024, Duration::from_secs(5)).await;
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    for (request, expected) in [(fetch(uuid::Uuid::new_v4()), 404), (fetch(id), 503)] {
+        p.backend.fail.store(expected == 503, Ordering::SeqCst);
+        let out = peer
+            .handle(&f.sign(request.clone()), &RecordFetchHandler, deadline())
+            .await
+            .unwrap();
+        let reply = &out.envelopes()[0];
+        assert_eq!(reply.kind(), "error");
+        assert_eq!(reply.original()["payload"]["code"], expected);
+        assert_eq!(reply.scope(Scope::Reply), request["id"].as_str());
+        assert!(!serde_json::to_string(reply)
+            .unwrap()
+            .contains("private-database-error-canary"));
+        f.verify_server(reply).await;
+    }
+    p.backend.fail.store(false, Ordering::SeqCst);
+    let first = peer
+        .handle(&f.sign(fetch(id)), &RecordFetchHandler, deadline())
+        .await
+        .unwrap();
+    let current_hash = first.envelopes()[0].original()["payload"]["content_hash"].clone();
+    drop(first);
+    let mut same = fetch(id);
+    same["payload"]["content_hash"] = current_hash.clone();
+    let same = peer
+        .handle(&f.sign(same), &RecordFetchHandler, deadline())
+        .await
+        .unwrap();
+    assert_eq!(same.envelopes()[0].kind(), "recording.vcon-fetched");
+    assert_eq!(
+        same.envelopes()[0].original()["payload"]["content_hash"],
+        current_hash
+    );
+    drop(same);
+    let mut r = fetch(id);
+    r["payload"]["content_hash"] = json!("wrong-projected-digest");
+    let out = peer
+        .handle(&f.sign(r), &RecordFetchHandler, deadline())
+        .await
+        .unwrap();
+    assert_eq!(out.envelopes()[0].original()["payload"]["code"], 409);
+    drop(out);
+    let mut r = fetch(id);
+    r["cid"] = json!("foreign-conversation");
+    assert_eq!(
+        peer.handle(&f.sign(r), &RecordFetchHandler, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::Authority
+    );
+}
