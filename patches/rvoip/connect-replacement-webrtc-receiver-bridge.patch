+        assert_eq!(scope.original_intent(),ready.root.intent());assert!(ready.private.is_current());
+        let target=ready.grant.intent.replacement.clone();let port=room.nodes[&target].backend.ports.lock().unwrap()[&b_id()].clone();
+        assert!(scope.target_port().unwrap().same_original(&port));
+        let mut output=port.take_egress().unwrap();let exposure=room.nodes[&target].video_exposures[&b_id()].clone();
+        let(packet,point)=video_packet(&room.nodes[&source],27000,None);let point=point.unwrap();publish_packet(&room.nodes[&source],packet,Some(point.clone())).await;
+        let writes=AtomicUsize::new(0);let queued=outgoing(&mut output).await;
+        assert!(Arc::ptr_eq(queued.original_video_frame().unwrap(),&point));
+        let repair=queued.deliver_video_with_repair(|_,_|async {exposure.record_potential(point.frame_realm());writes.fetch_add(1,Ordering::AcqRel);Ok(())}).await.unwrap();
+        assert_eq!(writes.load(Ordering::Acquire),1);assert!(scope.is_current(),"tracked candidate IO does not reapply zero-feed reservation predicate");
+        repair.repair(|_,_|async {writes.fetch_add(1,Ordering::AcqRel);Ok(())}).await.unwrap();assert_eq!(writes.load(Ordering::Acquire),2);
+        let(packet,next_point)=video_packet(&room.nodes[&source],30000,None);let next_point=next_point.unwrap();
