+//! Resource-only ownership transition. No public candidate source grant,
+//! media route, native start, F, OLD pause or replacement publication.
+use super::*;
+impl Orchestrator {
+    pub fn prepare_staged_public_video_bridge_ownership_with_held(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,held:&(dyn Any+Send+Sync),
+    )->ControlResult<crate::staged_streams::public_video_reservation::PreCutPublicVideoBridgeOwnership> {
+        let p=&plan.preparation;
+        self.owns_replacement(p)?;p.check()?;
+        let _flight = p.flight.clone().try_acquire_owned().map_err(|error| match error {
+            tokio::sync::TryAcquireError::NoPermits => StreamControlError::MetadataBusy,
+            tokio::sync::TryAcquireError::Closed => StreamControlError::Cancelled,
+        })?;
+        plan.media.require_legacy_video_effects()?;
+        let request=scope(p,ReplacementPhase::ReserveVideo,None);
+        let control=p.runtime.policy.current_replacement_control(&request,held)?;
+        let validate=||->std::result::Result<(),StreamControlError> {
+            self.owns_replacement(p).map_err(handoff::media_error)?;
+            p.check().map_err(handoff::media_error)?;
+            check_authority(&request,&control.current(&request).map_err(handoff::media_error)?)
+                .map_err(handoff::media_error)
+        };
+        validate()?;
+        let scene=p.runtime.mixer.staged.as_ref().ok_or(ParticipantControlError::Unsupported)?;
+        if !scene.old_video_freeze_unstarted(&plan.media) {return Err(ParticipantControlError::Media(StreamControlError::NotReady));}
+        let reservation=p.public_video_reservation.current(p)?;
+        Ok(reservation.claim_pre_cut_bridge_ownership(&plan.media,&p.preparation_identity(),
+            p.public_video_reservation.bridge_guard(),deadline_for(&p.principal,p.deadline.min(control.deadline)),&validate)?)
+    }
+}
