+// Preserve the SAME strong resource allocation while keeping the typed
+// preparation/runtime graph out of packet Scope auto-trait obligations.
+// Sole private implementation; no new allocation or public authority factory.
+trait BridgeResource:Send+Sync {
+    fn is_current(&self)->bool;
+    fn close(&self);
+    fn into_ownership(self:Arc<Self>)->Arc<PreCutPublicVideoBridgeOwnership>;
+}
+impl BridgeResource for PreCutPublicVideoBridgeOwnership {
+    fn is_current(&self)->bool {PreCutPublicVideoBridgeOwnership::is_current(self)}
+    fn close(&self) {PreCutPublicVideoBridgeOwnership::close(self)}
+    fn into_ownership(self:Arc<Self>)->Arc<PreCutPublicVideoBridgeOwnership> {self}
+}
+/// Opaque exact original candidate source and receiving resource. Root must
+/// retain this Arc before any native egress start. Routes keep Weak only.
+/// This context grants neither IO nor readiness; every original attempt uses
+/// the separate current_pre_cut_public_video_bridge policy hook below.
+pub struct PreCutPublicVideoBridgeScope {
+    resource:Arc<dyn BridgeResource>,
+    original:ParticipantReplacementMutation,conversation:ConversationId,session:SessionId,
+    source:MediaSource,target:PublicVideoWarmTarget,realm:u128,
+    original_selection:DirectStamp,source_port:Weak<Port>,source_ticket:PeerRouteTicket,
+    target_port:Weak<Port>,target_ticket:PeerRouteTicket,
+    old_scene:Option<scene_consumer::SceneStamp>,source_scene:Option<scene_consumer::SceneStamp>,target_scene:Option<scene_consumer::SceneStamp>,
+    gate:Weak<DirectGate>,deadline:tokio::time::Instant,cancel:CancellationToken,
+    withdrawal:std::sync::atomic::AtomicU8,original_plan:Weak<dyn Any+Send+Sync>,
+    closed:AtomicBool,installed:AtomicBool,installed_ticket:std::sync::OnceLock<PeerRouteTicket>,
+}
+impl PreCutPublicVideoBridgeScope {
+    pub(in crate::staged_streams) fn matches_original_plan_intent(&self,intent:&Arc<device_replacement::ReplacementIntent>)->bool {
+        std::ptr::eq(self.original_plan.as_ptr() as *const (),Arc::as_ptr(intent) as *const ())
+    }
+    pub fn matches_original_plan(&self,plan:&device_replacement::AudioDeviceReplacementPlan)->bool {
+        plan.audience().replacement.as_ref().is_some_and(|intent|
+            std::ptr::eq(self.original_plan.as_ptr() as *const (),Arc::as_ptr(intent) as *const ()))
+    }
+    pub(crate) fn ownership_for_withdrawal(&self,plan:&device_replacement::AudioDeviceReplacementPlan,identity:&ReplacementPreparationIdentity)->ControlResult<Arc<PreCutPublicVideoBridgeOwnership>> {
+        if !self.matches_original_plan(plan)||!self.is_current() {return Err(StreamControlError::Authority);}
+        let ownership=self.resource.clone().into_ownership();ownership.require_plan(plan,identity)?;Ok(ownership)
+    }
+    /// Only an actual original freeze pin with ALL original controller flights
+    /// may use this after OLD EGRESS becomes paused. The original selection
+    /// was current at pin capture and no structural writer can change it.
+    pub(crate) fn withdrawal_metadata_current(&self)->bool {
+        !self.closed.load(Ordering::Acquire)&&!self.cancel.is_cancelled()
+            &&tokio::time::Instant::now()<self.deadline&&self.resource.is_current()
+            &&self.source_ticket.is_active()&&self.target_ticket.is_active()
+            &&self.installed.load(Ordering::Acquire)&&self.installed_ticket.get().is_some_and(PeerRouteTicket::is_active)
+            &&self.source_port.upgrade().is_some_and(|port|!port.terminal_requested())
+            &&self.target_port.upgrade().is_some_and(|port|!port.terminal_requested())
+            &&[&self.old_scene,&self.source_scene,&self.target_scene].into_iter().flatten().all(|scene|!scene.cancel.is_cancelled())
+            &&self.withdrawal.load(Ordering::Acquire)<3
+    }
+    pub(crate) fn withdrawal_started(&self)->bool {self.withdrawal.load(Ordering::Acquire)!=0}
+    pub(crate) fn begin_withdrawal(&self)->ControlResult<()> {
+        if !self.is_current() {return Err(StreamControlError::NotReady);}
+        self.withdrawal.compare_exchange(0,1,Ordering::AcqRel,Ordering::Acquire).map_err(|_|StreamControlError::NotReady)?;Ok(())
+    }
+    pub(in crate::staged_streams) fn finish_withdrawal(self:&Arc<Self>,plan:&device_replacement::AudioDeviceReplacementPlan,
+        frozen:crate::staged_streams::old_video_freeze::FrozenVideoWarmWitness)->ControlResult<PreCutPublicVideoBridgeWithdrawal> {
+        if !self.matches_original_plan(plan)||!self.withdrawal_metadata_current()||!frozen.is_current()
+            ||self.withdrawal.load(Ordering::Acquire)!=1||frozen.frontier.realm_incarnation()!=self.realm
+            ||frozen.frontier.operation_id()!=self.original.operation_id
+            ||frozen.frontier.source_connection()!=&self.original.source
+            ||frozen.frontier.target_connection()!=&self.original.replacement {return Err(StreamControlError::Authority);}
+        self.withdrawal.store(2,Ordering::Release);
+        Ok(PreCutPublicVideoBridgeWithdrawal {scope:self.clone(),frozen,transferred:AtomicBool::new(false)})
+    }
+    pub fn matches_ownership(&self,ownership:&Arc<PreCutPublicVideoBridgeOwnership>)->bool {
+        std::ptr::eq(Arc::as_ptr(&self.resource) as *const (),Arc::as_ptr(ownership) as *const ())
+    }
+    pub fn original_intent(&self)->&ParticipantReplacementMutation {&self.original}
+    pub fn conversation(&self)->&ConversationId {&self.conversation}
+    pub fn session(&self)->&SessionId {&self.session}
+    pub fn source(&self)->&MediaSource {&self.source}
+    pub fn target(&self)->&PublicVideoWarmTarget {&self.target}
+    pub fn realm_incarnation(&self)->u128 {self.realm}
+    pub fn deadline(&self)->tokio::time::Instant {self.deadline}
+    pub fn cancellation(&self)->CancellationToken {self.cancel.clone()}
+    /// Checked original resource metadata for controlled native setup only.
+    /// This returns no raw peer/track and grants no packet delivery permission;
+    /// Scope/Port/root/current policy MUST be rechecked after every native await.
+    pub fn target_port(&self)->ControlResult<AdapterMediaPort> {
+        if !self.installed.load(Ordering::Acquire)||!self.is_current() {return Err(StreamControlError::NotReady);}
+        let port=self.target_port.upgrade().ok_or(StreamControlError::Cancelled)?;
+        port.require_ticket(TicketSide::Egress,&self.target_ticket)?;
+        let binding=&port.binding;
+        if binding.negotiated.requested.logical_id!=self.target.logical_id||binding.transport_id!=self.target.transport_id
+            ||binding.generation!=self.target.stream_generation||binding.connection_generation!=self.target.connection_generation {
+            return Err(StreamControlError::Authority);
+        }
+        let port=AdapterMediaPort(port);
+        let physical=port.physical_video_exposure().ok_or(StreamControlError::Unsupported)?;
+        if !physical.coverage_complete||physical.realm_incarnation!=Some(self.realm)
+            ||physical.physical_family!=self.target.physical_writer_incarnation {return Err(StreamControlError::Authority);}
+        Ok(port)
+    }
+    /// Nonblocking exact lifetime metadata, safe inside held policy callbacks.
+    /// This deliberately has NO F and cannot stand in for a current grant.
+    pub fn is_current(&self)->bool {
+        !self.closed.load(Ordering::Acquire)&&!self.cancel.is_cancelled()
+            &&self.withdrawal.load(Ordering::Acquire)==0
+            &&tokio::time::Instant::now()<self.deadline&&self.resource.is_current()
+            &&self.original_selection.is_current()&&self.source_ticket.is_active()&&self.target_ticket.is_active()
+            &&(!self.installed.load(Ordering::Acquire)||self.installed_ticket.get().is_some_and(PeerRouteTicket::is_active))
+            &&self.source_port.upgrade().is_some_and(|port|!port.terminal_requested())
+            &&self.target_port.upgrade().is_some_and(|port|!port.terminal_requested())
+            &&[&self.old_scene,&self.source_scene,&self.target_scene].into_iter().flatten().all(|scene|!scene.cancel.is_cancelled())
+    }
+    pub(crate) fn require_original_frame(&self,original:Option<&Arc<OriginalVideoFrame>>)->ControlResult<()> {
+        if !self.installed.load(Ordering::Acquire)||!self.is_current() {return Err(StreamControlError::NotReady);}
+        // A later bridge may originate from an already published B. Preserve
+        // that receiver's prior permanent floor; pre-F here means only that no
+        // NEW cut has been taken, never that an inherited cut disappears.
+        if let Some(prior)=self.original_selection.post_cut.as_ref() {prior.require_original_frame(original)?;}
+        let point=original.and_then(|frame|frame.frame_realm()).ok_or(StreamControlError::Unsupported)?;
+        if point.incarnation()!=self.realm {return Err(StreamControlError::Authority);}
+        // Pre-F candidate context deliberately has no ordinal floor. Existing
+        // post-F checks are unchanged and are NEVER replaced by this branch.
+        Ok(())
+    }
+    /// Idempotent route cancellation, not a native join/no-write receipt.
+    /// Readers/roles must be released before physical whole-candidate cleanup.
+    pub fn close(&self) {
+        if self.closed.swap(true,Ordering::AcqRel) {return;}
+        self.withdrawal.store(3,Ordering::Release);
+        self.cancel.cancel();
+        if let Some(gate)=self.gate.upgrade() {
+            if let Ok(mut routing)=gate.routing.try_lock() {
+                let same=routing.preparation.get(&self.target.logical_id)
+                    .and_then(|route|route.bridge.as_ref()).is_some_and(|scope|std::ptr::eq(scope.as_ptr(),self));
