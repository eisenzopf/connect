+//! One exact whole-frame observation on the retained WebRTC writer.
+use super::{public_warm::valid_keyframe_header, Mapping, Source};
+use arc_swap::ArcSwapOption;
+use rtc::rtp;
+use rvoip_core::{
+    ids::StreamId,
+    participant_transitions::ParticipantReplacementMutation,
+    staged_streams::{
+        direct_subscriptions::PublicVideoWarmTarget, old_video_freeze::FrozenOldVideoFrontier,
+        ControlResult, OriginalVideoFrame, SourceFrameRealmPoint, StreamControlError,
+    },
+};
+use std::sync::{Arc, OnceLock, Weak};
+use tokio_util::sync::CancellationToken;
+
+pub struct ReceiverReleaseFrame {
+    point: SourceFrameRealmPoint,
+    timestamp: u32,
+}
+impl ReceiverReleaseFrame {
+    pub fn original_point(&self) -> SourceFrameRealmPoint {
+        self.point
+    }
+    pub fn rtp_timestamp(&self) -> u32 {
+        self.timestamp
+    }
+}
+
+/// Historical observation only. The caller still holds the exact current
+/// handoff, writer and signed authorization at the public release boundary.
+pub struct ReceiverReleaseObservation {
+    original: ParticipantReplacementMutation,
+    target: PublicVideoWarmTarget,
+    realm: u128,
+    ssrc: u32,
+    cancel: CancellationToken,
+    cut: OnceLock<Arc<FrozenOldVideoFrontier>>,
+    first: OnceLock<ReceiverReleaseFrame>,
+    first_pre_cut_keyframe: OnceLock<Arc<ReceiverReleaseFrame>>,
+    pre_cut_keyframe: ArcSwapOption<ReceiverReleaseFrame>,
+}
+impl ReceiverReleaseObservation {
+    pub(super) fn new(
+        original: ParticipantReplacementMutation,
+        target: PublicVideoWarmTarget,
+        realm: u128,
+        ssrc: u32,
+        cancel: CancellationToken,
+    ) -> Self {
+        Self {
+            original,
+            target,
+            realm,
+            ssrc,
+            cancel,
+            cut: OnceLock::new(),
+            first: OnceLock::new(),
+            first_pre_cut_keyframe: OnceLock::new(),
+            pre_cut_keyframe: ArcSwapOption::empty(),
+        }
+    }
+
+    pub fn bind_cut(&self, frontier: &Arc<FrozenOldVideoFrontier>) -> ControlResult<()> {
+        if self.cancel.is_cancelled()
+            || self.original.operation_id != frontier.operation_id()
+            || &self.original.source != frontier.source_connection()
+            || &self.original.replacement != frontier.target_connection()
+            || self.realm != frontier.realm_incarnation()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        match self.cut.set(frontier.clone()) {
+            Ok(()) => Ok(()),
+            Err(same)
+                if self
+                    .cut
+                    .get()
+                    .is_some_and(|value| Arc::ptr_eq(value, &same)) =>
+            {
+                Ok(())
+            }
+            Err(_) => Err(StreamControlError::Authority),
+        }
+    }
+
+    /// Match an initial or recent complete, successfully submitted VP8 keyframe while
+    /// the bridge's candidate decoder was private. The signed browser
+    /// observation must separately establish decoding on this original writer.
+    pub fn pre_cut_keyframe(&self, rtp_timestamp: u32) -> Option<Arc<ReceiverReleaseFrame>> {
+        if self.cancel.is_cancelled() || self.cut.get().is_some() {
+            return None;
+        }
+        self.first_pre_cut_keyframe.get().filter(|frame| frame.rtp_timestamp() == rtp_timestamp).cloned().or_else(|| {
+            self.pre_cut_keyframe.load_full().filter(|frame| frame.rtp_timestamp() == rtp_timestamp)
+        })
+    }
+
+    pub fn first_complete(&self) -> Option<&ReceiverReleaseFrame> {
+        if self.cancel.is_cancelled() {
+            return None;
+        }
+        self.first.get()
+    }
+
+    pub fn stream(&self) -> &StreamId {
+        &self.target.logical_id
+    }
+
+    pub fn primary_ssrc(&self) -> u32 {
+        self.ssrc
+    }
+
+    pub fn target(&self) -> &PublicVideoWarmTarget {
+        &self.target
+    }
+}
+
+struct Partial {
+    original: Arc<OriginalVideoFrame>,
+    source: Source,
+    output_timestamp: u32,
+    before_cut: bool,
+    next_input_sequence: u16,
+    next_output_sequence: u16,
+}
+
+/// This cursor is exclusively serialized by the existing writer Timeline.
+/// It retains only one bounded fragment cursor and no packet payloads.
+pub(super) struct ReleaseProgress {
+    observer: Weak<ReceiverReleaseObservation>,
+    partial: Option<Partial>,
+}
+impl ReleaseProgress {
+    pub(super) fn new(observer: &Arc<ReceiverReleaseObservation>) -> Self {
+        Self {
+            observer: Arc::downgrade(observer),
+            partial: None,
+        }
+    }
+
+    pub(super) fn successful_packet(
+        &mut self,
+        original: Option<&Arc<OriginalVideoFrame>>,
+        source: &Source,
+        input: &rtp::Packet,
+        output: Mapping,
+    ) {
+        let Some(observer) = self.observer.upgrade() else {
+            self.partial = None;
+            return;
+        };
+        let cut = observer.cut.get();
+        let before_cut = cut.is_none();
+        if observer.first.get().is_some() || observer.cancel.is_cancelled() {
+            self.partial = None;
+            return;
+        }
+        let Some((original, point)) = original
