+            source:self.scope.source_port.clone(),source_ticket:self.scope.source_ticket.clone(),target:self.scope.target_port.clone(),target_ticket:self.scope.target_ticket.clone(),
+            source_scene:self.scope.source_scene.clone(),target_scene:self.scope.target_scene.clone()})
+    }
+    pub(super) fn transferred(&self) {self.transferred.store(true,Ordering::Release);}
+    pub fn frontier(&self)->&crate::staged_streams::old_video_freeze::FrozenOldVideoFrontier {&self.frozen.frontier}
+    pub fn frontier_owner(&self)->&Arc<crate::staged_streams::old_video_freeze::FrozenOldVideoFrontier> {&self.frozen.frontier}
+    pub fn bridge(&self)->&Arc<PreCutPublicVideoBridgeScope> {&self.scope}
+    pub fn is_current(&self)->bool {!self.transferred.load(Ordering::Acquire)&&self.scope.withdrawal.load(Ordering::Acquire)==2&&self.scope.withdrawal_metadata_current()&&self.frozen.is_current()}
