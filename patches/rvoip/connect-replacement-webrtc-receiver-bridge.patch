+//! Actual original public candidate route, current policy and Core queue IO.
+//! Cold physical families and final native callbacks are fixture metadata;
+//! no actual transport/decoder overlap, signed phase or public release claim.
+use super::*;
+use crate::staged_streams::direct_subscriptions::PreCutPublicVideoBridgeScope;
+use crate::staged_streams::public_video_reservation::PreCutPublicVideoBridgeOwnership;
+
+pub(in super::super) fn current(world:&Arc<World>,scope:&MediaScope<'_>,bridge:&PreCutPublicVideoBridgeScope,held:Option<&(dyn Any+Send+Sync)>)->ControlResult<Box<dyn MediaAuthorityLease>> {
+    if !world.warm_allowed.load(Ordering::Acquire) {return Err(StreamControlError::Unsupported);}
+    let MediaPurpose::Receive {source}=scope.purpose else {return Err(StreamControlError::Authority);};
+    let resource=world.raw(scope.connection)?;let pending=resource.pending.as_ref().ok_or(StreamControlError::Authority)?;
+    if !bridge.is_current()||bridge.original_intent()!=pending.intent()||scope.connection!=&bridge.original_intent().replacement
+        ||scope.conversation!=bridge.conversation()||scope.session!=bridge.session()
+        ||!same_source(source,bridge.source())||bridge.target().logical_id!=b_id() {return Err(StreamControlError::Authority);}
+    if let Some(held)=held {
+        let root=replacement_grant(held).ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&root.world,world)||&root.intent!=bridge.original_intent() {return Err(StreamControlError::Authority);}
+    }
+    world.lease(scope)
+}
+fn ownership(room:&ManagedRoom,ready:&Ready)->Arc<PreCutPublicVideoBridgeOwnership> {
+    Arc::new(room.orch.prepare_staged_public_video_bridge_ownership_with_held(&ready.plan,&ready.grant).unwrap())
+}
+fn route(room:&ManagedRoom,ready:&Ready,owner:&Arc<PreCutPublicVideoBridgeOwnership>)->std::result::Result<Arc<PreCutPublicVideoBridgeScope>,ParticipantControlError> {
+    room.orch.prepare_staged_pre_cut_public_video_bridge_with_held(&ready.plan,owner,
+        &Command::Audience {root:ready.grant.clone(),plan:ready.plan.media().audience().clone()})
+}
+async fn old_progress(room:&mut ManagedRoom,old:&ConnectionId,source:&ConnectionId) {
+    let port=room.nodes[old].backend.port(Medium::Video);assert!(port.0.ticket(TicketSide::Egress).is_active());
+    let mut output=port.take_egress().unwrap();while output.try_recv().is_ok(){}
+    let(packet,point)=video_packet(&room.nodes[source],39000,None);let point=point.unwrap();
+    publish_packet(&room.nodes[source],packet,Some(point.clone())).await;
+    let exposure=room.nodes[old].video_exposures[&desired(Medium::Video).logical_id].clone();
+    let queued=outgoing(&mut output).await;assert!(Arc::ptr_eq(queued.original_video_frame().unwrap(),&point));
+    queued.deliver(|_|async {exposure.record_potential(point.frame_realm());Ok(())}).await.unwrap();
+    for node in room.nodes.values_mut(){node.drain();}
+    room.nodes.get_mut(old).unwrap().publish(800).unwrap();room.nodes.get_mut(source).unwrap().hear(800).await;
+}
