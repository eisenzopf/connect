+        if self.transferred.load(Ordering::Acquire)||!self.is_current()||!self.scope.matches_original_plan(plan) {return Err(StreamControlError::Authority);}
+        let ownership=self.scope.resource.clone().into_ownership();ownership.require_plan(plan,identity)?;
