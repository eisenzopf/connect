+//! Retain the exact original reserved writer through the bridge cut.
+use super::{public_warm::WarmVideo, CoreVideoEgress, ReceiverReleaseObservation};
+use rvoip_core::staged_streams::{
+    direct_subscriptions::{PreCutPublicVideoBridgeScope, PublicVideoWarmStart},
+    physical_video_exposure::PhysicalVideoExposure,
+    ControlResult, StreamControlError,
+};
+use std::sync::{Arc, Weak};
+use tokio::sync::oneshot;
+
+pub(crate) struct BridgeWarmAdoption {
+    original: Weak<PreCutPublicVideoBridgeScope>,
+    release: Weak<ReceiverReleaseObservation>,
+    exposure: Arc<PhysicalVideoExposure>,
+    ssrc: u32,
+    payload_type: u8,
+    sender: oneshot::Sender<WarmVideo>,
+}
+
+pub(super) struct PendingBridgeAdoption {
+    pub(super) original: Weak<PreCutPublicVideoBridgeScope>,
+    pub(super) receiver: oneshot::Receiver<WarmVideo>,
+}
+
+impl CoreVideoEgress {
+    pub(crate) fn prepare_bridge_warm_adoption(
+        &mut self,
+        original: &Arc<PreCutPublicVideoBridgeScope>,
+        release: &Arc<ReceiverReleaseObservation>,
+    ) -> ControlResult<BridgeWarmAdoption> {
+        if !original.is_current()
+            || self.bridge_adoption.is_some()
+            || release.target() != original.target()
+            || release.primary_ssrc() != self.ssrc
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let (sender, receiver) = oneshot::channel();
+        self.bridge_adoption = Some(PendingBridgeAdoption {
+            original: Arc::downgrade(original),
+            receiver,
+        });
+        Ok(BridgeWarmAdoption {
+            original: Arc::downgrade(original),
+            release: Arc::downgrade(release),
+            exposure: self.exposure.clone(),
+            ssrc: self.ssrc,
+            payload_type: self.payload_type,
+            sender,
+        })
+    }
+}
+
+impl BridgeWarmAdoption {
+    pub(crate) fn matches(&self, original: &PreCutPublicVideoBridgeScope) -> bool {
+        std::ptr::eq(self.original.as_ptr(), original)
+    }
+
+    pub(crate) fn adopt(self, request: &PublicVideoWarmStart<'_>) -> ControlResult<()> {
+        let original = request
+            .pre_cut_bridge()
+            .ok_or(StreamControlError::Authority)?;
+        let scope = request.scope();
+        let frontier = scope.frontier_owner();
+        let observed = self
+            .exposure
+            .observer()
+            .snapshot()
+            .ok_or(StreamControlError::NotReady)?;
+        let release = self
+            .release
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if !request.is_current()
+            || !self.matches(original)
+            || self.sender.is_closed()
+            || !observed.coverage_complete
+            || observed.physical_family != scope.target().physical_writer_incarnation
+            || observed.realm_incarnation != Some(frontier.realm_incarnation())
+            || release.target() != scope.target()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let recorder = request.keyframe_submission_recorder(self.ssrc, self.payload_type)?;
+        if !recorder.matches_writer(
+            scope.as_ref(),
+            observed.physical_family,
+            self.ssrc,
+            self.payload_type,
+        ) {
+            return Err(StreamControlError::Authority);
+        }
+        release.bind_cut(frontier)?;
+        // Future retirements must include this original OLD frontier even if
+        // the adopted worker fails before seeing the first post-cut frame.
+        self.exposure.inherit_frontier(frontier);
+        self.sender
+            .send(WarmVideo::new(scope.clone(), recorder))
+            .map_err(|_| StreamControlError::Cancelled)
+    }
+}
