+            }
+        }
+        // A busy metadata map may retain a dead/cancelled Weak route until
+        // original target cleanup. It can never fall back to ordinary Receive.
+        if self.installed.load(Ordering::Acquire) {self.resource.close();}
+    }
+}
+impl Drop for PreCutPublicVideoBridgeScope {fn drop(&mut self){self.close();}}
