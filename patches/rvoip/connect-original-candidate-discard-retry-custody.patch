+//! Actual cold bind + native driver close after the last admission Arc is gone.
+//! This intentionally does NOT forge Core cancellation or a terminal receipt.
+use super::*;
+use rvoip_core::identity::{AuthenticatedPrincipal,AuthenticationMethod,IdentityAssurance,CredentialKind};
+use rvoip_core::peer_admission::PeerAdmissionOwner;
+use futures::FutureExt as _;
+#[tokio::test]
+async fn original_native_cleanup_preserves_bound_origin_after_last_admission_strong() {
+    let principal=AuthenticatedPrincipal {subject:"historical-origin".into(),tenant:Some("tenant".into()),scopes:vec![],issuer:Some("fixture".into()),expires_at:Some(chrono::Utc::now()+chrono::Duration::minutes(5)),method:AuthenticationMethod::Bearer,assurance:IdentityAssurance::Identified {credential_kind:CredentialKind::Oidc}};
+    let life=CancellationToken::new();
+    let mut owner=Some(PeerAdmissionOwner::new(&principal,IdentityId::from_string("same-identity"),DeviceId::from_string("same-device"),life.child_token(),Default::default()).unwrap());
+    let mut accepted=Some(owner.as_ref().unwrap().peer());
+    let weak=Arc::downgrade(accepted.as_ref().unwrap());let origin=accepted.as_ref().unwrap().original_origin();
+    let foreign=PeerAdmissionOwner::new(&principal,IdentityId::from_string("same-identity"),DeviceId::from_string("same-device"),CancellationToken::new(),Default::default()).unwrap();
+    let foreign_origin=foreign.peer().original_origin();
+    let adapter=Arc::new(());let id=ConnectionId::from_string("original-native-cleanup");
+    let physical=WebRtcPhysicalBinding::new(accepted.as_ref().unwrap(),life.child_token());
+    physical.bind(accepted.as_ref().unwrap(),&id,life.child_token(),&adapter).unwrap();
+    let mut native=None;
+    let result=std::panic::AssertUnwindSafe(async {
+        physical.start_peer(WebRtcConfig::loopback(),PeerRole::Offerer).unwrap();
+        native=Some(physical.peer_internal(tokio::time::Instant::now()+std::time::Duration::from_secs(5)).await.unwrap());
+        drop(owner.take());drop(accepted.take());
+        assert!(weak.upgrade().is_none());
+        let bound=physical.owner.get().unwrap();
+        assert!(bound.peer.upgrade().is_none(),"historical match must not require renewed peer liveness");
+        assert!(bound.peer_origin==origin);assert!(bound.peer_origin!=foreign_origin);
+        assert!(!physical.owner_current());
+    }).catch_unwind().await;
+    // SAME original native shared completion joins even with no admission Arc.
+    let closed=physical.shutdown().await;
+    let native_closed=match native {Some(native)=>native.close().await.is_ok(),None=>true};
+    drop(owner);drop(accepted);drop(foreign);
+    assert!(closed.is_ok()&&native_closed);assert!(physical.actual_close_confirmed());
+    assert!(physical.terminal.lock().unwrap().is_none(),"native close alone must not pretend a Core terminal join/token");
+    if let Err(error)=result {std::panic::resume_unwind(error)}
+}
