+use super::*;
+#[test]
+fn original_peer_origin_survives_last_strong_without_becoming_current_admission() {
+    let principal=AuthenticatedPrincipal {subject:"original-origin".into(),tenant:Some("tenant".into()),scopes:vec![],issuer:Some("fixture".into()),expires_at:Some(chrono::Utc::now()+chrono::Duration::minutes(5)),method:AuthenticationMethod::Bearer,assurance:IdentityAssurance::Identified {credential_kind:crate::identity::CredentialKind::Oidc}};
+    let identity=IdentityId::from_string("original-identity");let device=DeviceId::from_string("original-device");
+    let owner=PeerAdmissionOwner::new(&principal,identity.clone(),device.clone(),CancellationToken::new(),Default::default()).unwrap();
+    let other=PeerAdmissionOwner::new(&principal,identity,device,CancellationToken::new(),Default::default()).unwrap();
+    let original=owner.peer();let weak=Arc::downgrade(&original);
+    let origin=original.original_origin();let from_lifecycle=PeerAdmissionOrigin::from_lifecycle(original.incarnation());
+    let other_origin=other.peer().original_origin();
+    drop(owner);
+    let denied=original.validate_principal(&principal).is_err();
+    drop(original);drop(other);
+    // All actual resource owners are retired before the behavior oracles.
+    assert!(weak.upgrade().is_none());assert!(denied);
+    assert!(origin==from_lifecycle);assert!(origin!=other_origin);
+}
