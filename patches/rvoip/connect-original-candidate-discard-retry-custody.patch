+//! Actual whole original candidate close, not cancellation/absence-as-proof.
+use super::*;
+use rvoip_core::orchestrator::participant_control::{DeviceReplacementPreparation,UnpublishedCandidateDiscardContext};
+
+/// Historical nonclone join attestation. No public constructor, wire conversion,
+/// media permission or OLD restoration method. The original Root must separately
+/// obtain fresh OLD-source authorization under a future restoration contract.
+pub struct ClosedOriginalCandidate {
+    context: UnpublishedCandidateDiscardContext,
+    physical: Weak<WebRtcPhysicalBinding>,
+    adapter: Weak<()>,
+}
+impl ClosedOriginalCandidate {
+    pub fn intent(&self) -> &rvoip_core::participant_transitions::ParticipantReplacementMutation {self.context.intent()}
+    pub fn session(&self) -> &SessionId {self.context.session()}
+    pub fn conversation(&self) -> &ConversationId {self.context.conversation()}
+    pub fn matches_preparation(&self, original:&Arc<DeviceReplacementPreparation>) -> bool {self.context.matches_preparation(original)}
+    /// Only historical same-owner identity. This does not reauthorize old work.
+    pub fn matches_original_binding(&self, adapter:&CanonicalWebRtcAdapter, original:&Arc<WebRtcPhysicalBinding>) -> bool {
+        Weak::ptr_eq(&self.adapter,&Arc::downgrade(&adapter.identity))
+            && Weak::ptr_eq(&self.physical,&Arc::downgrade(original))
+            && original.actual_close_confirmed()
+            && self.context.cancelled_original()
+    }
+}
+/// Constructor refusal preserves the SAME nonclone Core context. A trusted
+/// caller may correct its original binding lookup without minting new custody.
+pub struct OriginalCandidateDiscardRefusal {context:UnpublishedCandidateDiscardContext,error:RvoipError}
+impl std::fmt::Debug for OriginalCandidateDiscardRefusal {
+    fn fmt(&self,f:&mut std::fmt::Formatter<'_>)->std::fmt::Result {f.write_str("OriginalCandidateDiscardRefusal(original context retained)")}
+}
+impl OriginalCandidateDiscardRefusal {
+    pub fn error(&self)->&RvoipError {&self.error}
+    pub fn into_parts(self)->(UnpublishedCandidateDiscardContext,RvoipError) {(self.context,self.error)}
+}
+/// Root must own this object BEFORE awaiting cleanup. Cancelling one observer
+/// or a refused join leaves exact original custody here. There is no Clone,
+/// concurrent join, new admission, new reason, or replacement physical lookup.
+pub struct OriginalCandidateDiscard {
+    context:Option<UnpublishedCandidateDiscardContext>,physical:Arc<WebRtcPhysicalBinding>,
+    adapter:Weak<()>,reason:EndReason,
+}
+impl OriginalCandidateDiscard {
+    /// Rejoins existing original completions only. Error/observer cancellation
+    /// retains context; only fully successful joins move it into the attestation.
+    pub async fn join(&mut self,adapter:&CanonicalWebRtcAdapter)->Result<ClosedOriginalCandidate> {
+        if !Weak::ptr_eq(&self.adapter,&Arc::downgrade(&adapter.identity)) {
+            return Err(RvoipError::AdmissionRejected("Original discard adapter differs"));
+        }
+        let context=self.context.as_ref().ok_or(RvoipError::InvalidState("Original discard already joined"))?;
+        if !context.cancelled_original() {return Err(RvoipError::AdmissionRejected("Original cancellation differs"));}
+        let id=context.intent().replacement.clone();
+        // Route absence is not proof. This API retains/rejoins the actual
+        // original native, Backend/controller and Core terminal owners.
+        adapter.end_original_binding(id,&self.physical,self.reason.clone()).await?;
+        self.physical.shutdown().await?;
+        if !self.physical.actual_close_confirmed() || !context.cancelled_original() {
+            return Err(RvoipError::InvalidState("Original candidate join unconfirmed"));
+        }
+        let terminal=self.physical.terminal.lock().unwrap_or_else(|v|v.into_inner()).clone()
+            .ok_or(RvoipError::InvalidState("Original candidate Core terminal unavailable"))?;
+        terminal.wait().await.map_err(|error|terminal_error(&context.intent().replacement,error))?;
+        // No await/failure follows consumption. Cancelled/failed observations
+        // above cannot destroy the sole context or falsely mint a closed token.
+        let context=self.context.take().expect("same exclusive original join");
+        Ok(ClosedOriginalCandidate {context,physical:Arc::downgrade(&self.physical),adapter:self.adapter.clone()})
+    }
+}
+impl CanonicalWebRtcAdapter {
+    /// Synchronous validation returns the actual owned join handle before any
+    /// await. A refused binding lookup returns SAME context in owned error.
+    pub fn prepare_original_candidate_discard(
+        &self,context:UnpublishedCandidateDiscardContext,original:&Arc<WebRtcPhysicalBinding>,reason:EndReason,
+    )->std::result::Result<OriginalCandidateDiscard,OriginalCandidateDiscardRefusal> {
+        let id=&context.intent().replacement;
+        let matches=context.cancelled_original() && original.reserved_video.is_some()
+            && original.owner.get().is_some_and(|owner|&owner.connection==id
+                && Weak::ptr_eq(&owner.adapter,&Arc::downgrade(&self.identity))
+                && context.matches_original_origin(&owner.peer_origin));
+        if !matches {return Err(OriginalCandidateDiscardRefusal {context,error:RvoipError::AdmissionRejected("Original unpublished candidate differs")});}
+        Ok(OriginalCandidateDiscard {context:Some(context),physical:original.clone(),adapter:Arc::downgrade(&self.identity),reason})
+    }
+}
