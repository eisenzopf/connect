+//! Real Core preparations, controlled Host cleanup lease. No native close token
+//! is fabricated: this managed SIP fixture only exercises cancellation custody.
+use super::*;
+#[derive(Clone,Copy)]
+enum HostCommit { KnownPrecommit, Started, Unknown, Confirmed }
+#[derive(Clone)]
+pub(super) struct CleanupGrant { original:ReplacementGrant,until:tokio::time::Instant,commit:HostCommit }
+impl CleanupGrant {
+    pub(super) fn known(original:&ReplacementGrant)->Self {Self {original:original.clone(),until:deadline(),commit:HostCommit::KnownPrecommit}}
+    pub(super) fn control(&self,world:&World,scope:&ParticipantReplacementScope<'_>)->std::result::Result<ParticipantReplacementControl,ParticipantControlError> {
+        if !std::ptr::eq(world,self.original.world.as_ref()) {return Err(ParticipantControlError::Authority);}
+        self.current(scope)?;
+        ParticipantReplacementControl::new(Box::new(self.clone()),CancellationToken::new(),self.until)
+    }
+}
+impl ParticipantReplacementLease for CleanupGrant {
+    fn current(&self,scope:&ParticipantReplacementScope<'_>)->std::result::Result<ParticipantReplacementAuthority,ParticipantControlError> {
+        let g=&self.original;
+        if scope.phase!=ReplacementPhase::Discard || !matches!(self.commit,HostCommit::KnownPrecommit)
+            || scope.intent!=&g.intent || scope.session!=&g.domain.session
+            || scope.conversation!=g.domain.member.conversation()
+            || scope.principal.ownership_key()!=g.domain.principal.ownership_key()
+            || tokio::time::Instant::now()>=self.until
+        {return Err(ParticipantControlError::Authority);}
+        // Historical exact custody: target expired/revoked admission is NOT
+        // renewed. Actual Store Reader/known-precommit integration is Host work.
+        Ok(ParticipantReplacementAuthority {actor:g.domain.member.clone(),target:g.domain.member.clone(),endpoint:g.domain.endpoint.clone(),may_send_audio:false,may_receive_audio:false})
+    }
+}
+async fn original_pair(room:&mut ManagedRoom)->(Arc<Domain>,ConnectionId,ConnectionId) {
+    let alice=domain(&room.conversation,&room.session,"discard-alice","alice");
+    let bob=domain(&room.conversation,&room.session,"discard-bob","bob");
+    let source=room.initial(alice.clone()).await;
+    let retained=room.initial(bob).await;
+    room.select(&retained,vec![AudioSubscription::Connection(source.clone())]).await;
+    (alice,source,retained)
+}
+fn replacement_domain(room:&ManagedRoom,alice:&Arc<Domain>)->Arc<Domain> {
+    let mut next=domain(&room.conversation,&room.session,"discard-next","alice");
+    let value=Arc::get_mut(&mut next).unwrap();value.principal=alice.principal.clone();value.member=alice.member.clone();next
+}
+#[tokio::test]
+async fn original_candidate_discard_is_once_and_old_public_audio_continues() {
+    let mut room=ManagedRoom::new().await;
+    let result=catch_original(async {
+        let(alice,source,retained)=original_pair(&mut room).await;
+        let next=replacement_domain(&room,&alice);
+        let(root,grant,_,_,_)=room.prepare_move(&source,&retained,next).await;
+        let cleanup=CleanupGrant::known(&grant);
+        let context=room.orch.discard_staged_device_replacement_with_held(&root,&cleanup).unwrap();
+        assert!(context.matches_preparation(&root)&&context.cancelled_original());
+        assert!(context.intent()==&grant.intent);
+        assert_eq!(context.session(),&room.session);
+        assert!(room.orch.discard_staged_device_replacement_with_held(&root,&cleanup).is_err());
+        assert!(room.orch.plan_staged_device_replacement_activation(&root).is_err());
+        room.nodes.get_mut(&source).unwrap().publish(800).unwrap();
+        room.nodes.get_mut(&retained).unwrap().hear(800).await;
+        assert_eq!(room.orch.session_of(&source),Some(room.session.clone()));
+        assert!(!room.nodes[&source].controller.shutdown.is_cancelled());
+    }).await;
+    let cleanup=room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done|done));
+    if let Err(error)=result {resume_unwind(error)}
+}
+#[tokio::test]
+async fn original_candidate_expired_cancelled_cleanup_does_not_renew_target_admission() {
+    let mut room=ManagedRoom::new().await;
+    let result=catch_original(async {
+        let(alice,source,retained)=original_pair(&mut room).await;
+        let next=replacement_domain(&room,&alice);
+        let(root,grant,_,_,_)=room.prepare_move(&source,&retained,next).await;
+        tokio::time::sleep_until(grant.until).await;
+        // Actual original expiry/cancel, not changed clock fields or reset age.
+        assert!(root.cancel());
+        let cleanup=CleanupGrant::known(&grant);
+        let context=room.orch.discard_staged_device_replacement_with_held(&root,&cleanup).unwrap();
+        assert!(context.matches_preparation(&root));
+        assert!(room.orch.activate_staged_device_replacement_with_held(&root,&grant).await.is_err());
+        assert!(room.orch.plan_staged_device_replacement_activation(&root).is_err());
+        room.nodes.get_mut(&source).unwrap().publish(800).unwrap();
+        room.nodes.get_mut(&retained).unwrap().hear(800).await;
+        assert!(!room.nodes[&source].controller.shutdown.is_cancelled());
+    }).await;
+    let cleanup=room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done|done));
+    if let Err(error)=result {resume_unwind(error)}
+}
+#[tokio::test]
+async fn original_candidate_discard_foreign_started_unknown_and_expired_cleanup_refuse_without_cancel() {
+    let mut room=ManagedRoom::new().await;
+    let result=catch_original(async {
+        let(alice,source,retained)=original_pair(&mut room).await;
+        let next=replacement_domain(&room,&alice);
+        let(root,grant,_,_,_)=room.prepare_move(&source,&retained,next).await;
+        for state in [HostCommit::Started,HostCommit::Unknown,HostCommit::Confirmed] {
+            let mut cleanup=CleanupGrant::known(&grant);cleanup.commit=state;
+            assert!(room.orch.discard_staged_device_replacement_with_held(&root,&cleanup).is_err());
+            assert!(!root.cancellation().is_cancelled());
+        }
+        let mut foreign=CleanupGrant::known(&grant);foreign.original.intent.operation_id.push_str("-foreign");
+        assert!(room.orch.discard_staged_device_replacement_with_held(&root,&foreign).is_err());
+        let mut expired=CleanupGrant::known(&grant);expired.until=tokio::time::Instant::now();
+        assert!(room.orch.discard_staged_device_replacement_with_held(&root,&expired).is_err());
+        assert!(!root.cancellation().is_cancelled());
+        let context=room.orch.discard_staged_device_replacement_with_held(&root,&CleanupGrant::known(&grant)).unwrap();
+        assert!(context.cancelled_original());
+    }).await;
+    let cleanup=room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done|done));
+    if let Err(error)=result {resume_unwind(error)}
+}
