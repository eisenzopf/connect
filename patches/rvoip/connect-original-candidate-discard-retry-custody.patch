+//! Known-precommit cancellation custody, NOT native close or OLD restoration proof.
+//! The Host Discard policy must own a compatible Store Reader over the original
+//! preparing operation/reservation and reject ANY Commit-start/unknown/public state.
+use super::*;
+
+/// Nonclone original cancellation context. Only the actual Core cancellation
+/// transition can create it. An adapter must still join its original physical
+/// owner and Core terminal cleanup before issuing any close attestation.
+pub struct UnpublishedCandidateDiscardContext {
+    preparation: Arc<DeviceReplacementPreparation>,
+    peer_origin: Option<crate::peer_admission::PeerAdmissionOrigin>,
+}
+impl UnpublishedCandidateDiscardContext {
+    pub fn intent(&self) -> &ParticipantReplacementMutation { &self.preparation.intent }
+    pub fn session(&self) -> &SessionId { &self.preparation.runtime.session }
+    pub fn conversation(&self) -> &ConversationId { &self.preparation.runtime.conversation }
+    pub fn matches_preparation(&self, original: &Arc<DeviceReplacementPreparation>) -> bool {
+        Arc::ptr_eq(&self.preparation, original) && self.cancelled_original()
+    }
+    /// Historical native incarnation, not current permission/liveness.
+    pub fn matches_original_peer(&self, original: &Arc<PeerAdmission>) -> bool {
+        self.matches_original_origin(&original.original_origin())
+    }
+    /// Historical equality remains usable after the original last strong peer
+    /// and route permit are released. It is not current admission.
+    pub fn matches_original_origin(&self,original:&crate::peer_admission::PeerAdmissionOrigin)->bool {
+        self.peer_origin.as_ref()==Some(original) && self.cancelled_original()
+    }
+    pub fn cancelled_original(&self) -> bool {
+        self.preparation.phase.load(Ordering::Acquire)==CANCELLED
+            && self.preparation.cancellation.is_cancelled()
+            && self.preparation.resource_lifetime.is_cancelled()
+    }
+}
+impl Orchestrator {
+    /// Capture SAME unpublished preparation under distinct Host Discard authority,
+    /// including after target expiry/cancel, then permanently cancel it BEFORE releasing the original publication locks.
+    /// This provides no native-close, OLD-resume, media grant or fresh operation.
+    pub fn discard_staged_device_replacement_with_held(
+        self: &Arc<Self>, p: &Arc<DeviceReplacementPreparation>, held: &(dyn Any+Send+Sync),
+    ) -> ControlResult<UnpublishedCandidateDiscardContext> {
+        self.owns_replacement(p)?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let request=scope(p,ReplacementPhase::Discard,None);
+        let control=p.runtime.policy.current_replacement_control(&request,held)?;
+        check_discard_scope(&request,&control.current(&request)?)?;
+        let peer={
+            // SAME ordering as actual attach/final managed publication. No await,
+            // physical join or adapter callback occurs under these locks.
+            let state=p.runtime.state.lock().unwrap_or_else(|v|v.into_inner());
+            let _registry=self.connection_registry_lock.lock().unwrap_or_else(|v|v.into_inner());
+            let life=p.candidate.state.lock().unwrap_or_else(|v|v.into_inner());
+            let mut pending=p.state.lock().unwrap_or_else(|v|v.into_inner());
+            self.owns_replacement(p)?;
+            check_discard_scope(&request,&control.current(&request)?)?;
+            let phase=p.phase.load(Ordering::Acquire);
+            if phase==COMMITTED || !matches!(phase,PREPARING|ATTACHED|CANCELLED)
+                || self.sessions_by_connection.contains_key(&p.intent.replacement)
+                || self.connection_lifecycles.get(&p.intent.replacement).is_some_and(|actual|!Arc::ptr_eq(actual.value(),&p.candidate.state))
+                || (phase!=CANCELLED && (life.retired || life.replacement_reservation!=Some(p.nonce)
+                    || !state.pending.get(&p.intent.replacement).is_some_and(|entry|entry.replacement_nonce==Some(p.nonce))))
+                || (phase==CANCELLED && !life.retired)
+            { return Err(ParticipantTransitionError::Conflict.into()); }
+            // A fresh cleanup lease is NOT target admission. Expired/revoked
+            // target state can be closed, including after original cancellation.
+            // No later failure occurs after claiming this one original context.
+            p.discard_context_issued.set(()).map_err(|_|ParticipantTransitionError::Conflict)?;
+            let peer=life.peer_origin.map(crate::peer_admission::PeerAdmissionOrigin::from_lifecycle);
+            // Final Commit also holds pending state through its publication.
+            // Never release that fence and then call a later best-effort cancel.
+            p.phase.store(CANCELLED,Ordering::Release);
+            p.cancellation.cancel();
+            p.resource_lifetime.cancel();
+            pending.slot.take();
+            pending.cleanup_started=true;
+            peer
+        };
+        // Actual exact lifecycle tombstone/scene removal after publication locks
+        // are dropped. Existing cleanup is idempotent; original joins stay owned.
+        p.abort_candidate();
+        Ok(UnpublishedCandidateDiscardContext {preparation:p.clone(),peer_origin:peer})
+    }
+}
+
+// Cleanup deliberately does not require a currently usable target endpoint,
+// target media permissions or the original expired principal. Exact historical
+// custody and fresh Host known-precommit Reader are required instead.
+fn check_discard_scope(scope:&ParticipantReplacementScope<'_>,authority:&ParticipantReplacementAuthority)->ControlResult<()> {
+    if scope.phase!=ReplacementPhase::Discard
+        || authority.actor.conversation()!=scope.conversation
+        || authority.target.conversation()!=scope.conversation
+        || authority.target.participant()!=&scope.intent.participant
+        || authority.endpoint.endpoint()!=&scope.intent.endpoint
+        || authority.endpoint.device()!=&scope.intent.device
+    {return Err(ParticipantControlError::Authority);}
+    Ok(())
+}
