+#[tokio::test]
+async fn retrying_video_metadata_cannot_restore_revoked_audience_generation_or_expired_original() {
+    for action in [
+        "source",
+        "target",
+        "audience",
+        "source-gate",
+        "target-gate",
+        "cancel",
+        "age",
+    ] {
+        let (f, armed, busy) = fixture(Medium::Video).await;
+        let packet = queued(&f, Medium::Video).await;
+        let original_until = packet.admitted_at + Duration::from_millis(200);
+        let entered = Arc::new(AtomicUsize::new(0));
+        let calls = entered.clone();
+        armed.store(true, Ordering::Release);
+        let mut attempt = Box::pin(packet.deliver_video_with_repair(move |_, _| async move {
+            calls.fetch_add(1, Ordering::AcqRel);
+            Ok(())
+        }));
+        let first = std::future::poll_fn(|cx| Poll::Ready(attempt.as_mut().poll(cx))).await;
+        let pending = first.is_pending();
+        let released = f.policy.0.try_write().is_ok();
+        match action {
+            "source" | "target" => {
+                f.policy
+                    .0
+                    .try_write()
+                    .unwrap()
+                    .revoked
+                    .insert(if action == "source" { "alice" } else { "bob" }.into());
+            }
+            "audience" => f.policy.0.try_write().unwrap().private = true,
+            "source-gate" | "target-gate" => {
+                let c = if action == "source-gate" { &f.a } else { &f.b };
+                let ids = [desired(Medium::Video).logical_id].into_iter().collect();
+                for change in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                    c.set_media_gate(c.revision(), &ids, change, deadline())
+                        .await
+                        .unwrap();
+                }
+            }
+            "cancel" => f.b.shutdown.cancel(),
+            _ => {
+                tokio::time::sleep_until(tokio::time::Instant::from_std(
+                    original_until + Duration::from_millis(1),
+                ))
+                .await
+            }
+        }
+        let result = match first {
+            Poll::Ready(result) => {
+                drop(attempt);
+                result
+            }
+            Poll::Pending => attempt.await,
+        };
+        let refused = result.is_err();
+        let expired = matches!(&result, Err(StreamControlError::Deadline));
+        drop(result);
+        let joined = close(&f).await;
+        assert!(joined, "original Core owners not joined for {action}");
+        assert!(
+            pending && released && busy.load(Ordering::Acquire) == 1,
+            "negative did not enter the original metadata defer: {action}"
+        );
+        assert!(
+            refused && entered.load(Ordering::Acquire) == 0,
+            "withdrawn {action} reached callback"
+        );
+        if action == "age" {
+            assert!(expired, "original 200ms bound was renewed");
+        }
+    }
+}
+
+#[tokio::test]
+async fn metadata_retry_never_repeats_an_entered_video_callback_or_issues_repair_after_refusal() {
+    for metadata in [true, false] {
+        let (f, armed, busy) = fixture(Medium::Video).await;
+        let packet = queued(&f, Medium::Video).await;
+        let entered = Arc::new(AtomicUsize::new(0));
+        let calls = entered.clone();
+        armed.store(true, Ordering::Release);
+        let result = packet
+            .deliver_video_with_repair(move |_, _| async move {
+                calls.fetch_add(1, Ordering::AcqRel);
+                Err(if metadata {
+                    StreamControlError::MetadataBusy
+                } else {
+                    StreamControlError::NotReady
+                })
+            })
+            .await;
+        let original_error = if metadata {
+            matches!(&result, Err(StreamControlError::MetadataBusy))
+        } else {
+            matches!(&result, Err(StreamControlError::NotReady))
+        };
+        drop(result);
+        let released = f.policy.0.try_write().is_ok();
+        let joined = close(&f).await;
+        assert!(joined && released);
+        assert_eq!(busy.load(Ordering::Acquire), 1);
+        assert!(
+            original_error && entered.load(Ordering::Acquire) == 1,
+            "entered IO was replayed or repair authority issued"
+        );
+    }
+}
