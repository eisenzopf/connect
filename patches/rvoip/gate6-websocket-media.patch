diff --git a/crates/uctp/rvoip-websocket/tests/media_bridge_loopback.rs b/crates/uctp/rvoip-websocket/tests/media_bridge_loopback.rs
--- a/crates/uctp/rvoip-websocket/tests/media_bridge_loopback.rs
+++ b/crates/uctp/rvoip-websocket/tests/media_bridge_loopback.rs
@@ -64,3 +64,155 @@
