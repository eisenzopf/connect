+
+/// Media must start through the public stream after signaling is ready; no
+/// test-owned on_track polling, track priming or manual attach is permitted.
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn delayed_bidirectional_opus_is_automatically_attached_and_decodes_after_connection_wait() {
+    use rvoip_core::stream::{MediaFrame, MediaStream, StreamKind};
+    use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+    use std::sync::Arc;
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let a = WebRtcMediaBridge::new_offerer().await.unwrap();
+    let b = WebRtcMediaBridge::new_answerer().await.unwrap();
+    b.set_remote_substrate_setup(a.local_substrate_setup().await.unwrap())
+        .await
+        .unwrap();
+    a.set_remote_substrate_setup(b.local_substrate_setup().await.unwrap())
+        .await
+        .unwrap();
+    let (ar, br) = tokio::join!(
+        a.wait_connected(Duration::from_secs(10)),
+        b.wait_connected(Duration::from_secs(10))
+    );
+    ar.unwrap();
+    br.unwrap();
+    // No media has flowed during the initial bounded track wait. This is
+    // deliberately after wait_connected returns, as a real idle caller does.
+    tokio::time::sleep(Duration::from_millis(150)).await;
+    let sa = a.media_stream().unwrap();
+    let sb = b.media_stream().unwrap();
+    let mut ia = sa.try_frames_in().unwrap();
+    let mut ib = sb.try_frames_in().unwrap();
+    assert_eq!(sa.frames_out().max_capacity(), 10);
+    assert_eq!(sb.frames_out().max_capacity(), 10);
+    assert_eq!(ia.max_capacity(), 10);
+    assert_eq!(ib.max_capacity(), 10);
+    assert!(tokio::time::timeout(Duration::from_millis(30), ia.recv())
+        .await
+        .is_err());
+    assert!(tokio::time::timeout(Duration::from_millis(30), ib.recv())
+        .await
+        .is_err());
+    for (source, destination) in [(&sa, &mut ib), (&sb, &mut ia)] {
+        let mut encoder = CodecFactory::create_codec(111, Some(48_000), Some(1)).unwrap();
+        let mut decoder = CodecFactory::create_codec(111, Some(48_000), Some(1)).unwrap();
+        let mut decoded = Vec::new();
+        for n in 0..5usize {
+            let samples = (0..960)
+                .map(|i| {
+                    let sample = ((std::f64::consts::TAU * 440.0 * (n * 960 + i) as f64 / 48_000.0)
+                        .sin()
+                        * 7000.0) as i16;
+                    sample
+                })
+                .collect();
+            let body = encoder
+                .encode(&AudioFrame {
+                    samples,
+                    sample_rate: 48_000,
+                    channels: 1,
+                    duration: Duration::from_millis(20),
+                    timestamp: (n * 960) as u32,
+                })
+                .unwrap();
+            source
+                .frames_out()
+                .send(MediaFrame {
+                    source_clock: None,
+                    stream_id: source.id(),
+                    kind: StreamKind::Audio,
+                    payload: body.clone().into(),
+                    timestamp_rtp: (n * 960) as u32,
+                    captured_at: chrono::Utc::now(),
+                    payload_type: None,
+                })
+                .await
+                .unwrap();
+            let frame = tokio::time::timeout(Duration::from_secs(2), destination.recv())
+                .await
+                .expect("late track was not automatically attached")
+                .expect("receiver closed");
+            assert_eq!(frame.payload.as_ref(), body.as_slice());
+            assert_eq!(frame.timestamp_rtp, (n * 960) as u32);
+            assert_eq!(frame.kind, StreamKind::Audio);
+            let pcm = decoder.decode(&frame.payload).unwrap();
+            assert_eq!(
+                (pcm.sample_rate, pcm.channels, pcm.samples.len()),
+                (48_000, 1, 960)
+            );
+            if n > 0 {
+                decoded.extend(pcm.samples);
+            }
+        }
+        let mean = decoded.iter().map(|s| f64::from(*s).abs()).sum::<f64>() / decoded.len() as f64;
+        let crossings = decoded.windows(2).filter(|v| v[0] < 0 && v[1] >= 0).count();
+        let hz = crossings as f64 * 48_000.0 / decoded.len() as f64;
+        assert!(mean > 500.0, "silent audio");
+        assert!(
+            (380.0..500.0).contains(&hz),
+            "wrong decoded frequency: {hz}"
+        );
+    }
+    // Repeated setup cannot create another pump or change the receiver owner.
+    a.wait_connected(Duration::from_secs(2)).await.unwrap();
+    b.wait_connected(Duration::from_secs(2)).await.unwrap();
+    assert!(Arc::ptr_eq(&sa, &a.media_stream().unwrap()));
+    assert!(sa.try_frames_in().is_err());
+    a.close().await.unwrap();
+    b.close().await.unwrap();
+    assert!(a.media_stream().is_none() && b.media_stream().is_none());
+    assert!(sa.frames_out().is_closed() && sb.frames_out().is_closed());
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn closing_idle_bridge_joins_track_attacher_and_cannot_recreate_media() {
+    use std::sync::Arc;
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let a = WebRtcMediaBridge::new_offerer().await.unwrap();
+    let b = WebRtcMediaBridge::new_answerer().await.unwrap();
+    b.set_remote_substrate_setup(a.local_substrate_setup().await.unwrap())
+        .await
+        .unwrap();
+    a.set_remote_substrate_setup(b.local_substrate_setup().await.unwrap())
+        .await
+        .unwrap();
+    let (ar, br) = tokio::join!(
+        a.wait_connected(Duration::from_secs(10)),
+        b.wait_connected(Duration::from_secs(10))
+    );
+    ar.unwrap();
+    br.unwrap();
+    let weak_peer = Arc::downgrade(a.peer());
+    tokio::time::timeout(Duration::from_secs(2), a.close())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(a.media_stream().is_none());
+    assert!(tokio::time::timeout(
+        Duration::from_millis(100),
+        a.wait_connected(Duration::from_secs(2))
+    )
+    .await
+    .unwrap()
+    .is_err());
+    assert!(a.local_substrate_setup().await.is_err());
+    assert!(a.media_stream().is_none());
+    a.close().await.unwrap();
+    b.close().await.unwrap();
+    drop(a);
+    assert!(
+        weak_peer.upgrade().is_none(),
+        "owned attacher retained closed peer"
+    );
+}
