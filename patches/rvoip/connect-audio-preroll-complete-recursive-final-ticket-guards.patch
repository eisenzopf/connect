+/// Actual receiver-only preroll must retain every original guarded fence.
+/// This observes the SAME stamp minted by real mixer delivery in model_ready.
+fn assert_actual_preroll_ticket_closure(
+    room: &ManagedRoom,
+    ready: &ModelReady,
+) -> crate::staged_streams::audio_subscriptions::SubscriptionStamp {
+    use rvoip_core_traits::peer_switch::{PeerRouteGuardError, PeerRouteGuardSet, PeerRouteTicket};
+    let consumer = room.nodes[&ready.grant.intent.replacement]
+        .controller.audio_consumer.lock().unwrap().as_ref()
+        .and_then(std::sync::Weak::upgrade).expect("actual candidate audio consumer");
+    let stamp = consumer.subscriptions.mix_stamp();
+    assert!(stamp.is_current(), "actual delivered preroll must already be current");
+    let old_root_only = [stamp.cut_ticket()];
+    {
+        let guards = PeerRouteGuardSet::try_acquire(&old_root_only).unwrap();
+        assert!(!stamp.current_cut(&guards), "the old root-only set must refuse subordinate fences");
+    }
+    let mut complete = Vec::<PeerRouteTicket>::new();
+    for ticket in stamp.cut_tickets() {
+        if !complete.iter().any(|old| old.same_generation(&ticket)) {
+            complete.push(ticket);
+        }
+    }
+    assert!(complete.len() > old_root_only.len());
+    {
+        let guards = PeerRouteGuardSet::try_acquire(&complete).unwrap();
+        assert!(stamp.current_cut(&guards), "complete actual recursive ticket closure");
+    }
+    for missing in 0..complete.len() {
+        let partial = complete.iter().enumerate().filter(|(index, _)| *index != missing)
+            .map(|(_, ticket)| ticket.clone()).collect::<Vec<_>>();
+        let guards = PeerRouteGuardSet::try_acquire(&partial).unwrap();
+        assert!(!stamp.current_cut(&guards), "missing actual subordinate ticket must fail closed");
+    }
+    for ticket in &complete {
+        let held = [ticket.clone()];
+        let _original = PeerRouteGuardSet::try_acquire(&held).unwrap();
+        assert!(matches!(PeerRouteGuardSet::try_acquire(&complete), Err(PeerRouteGuardError::MetadataBusy)),
+            "actual subordinate lock must be try-only Busy");
+    }
+    eprintln!("AUDIO_PREROLL_GUARD_CLOSURE actual_tickets={} old_root_only_refused=true complete_current=true each_missing_refused=true each_actual_lock_busy=true", complete.len());
+    stamp
+}
