+// Only schema-valid request bytes for the control/guard fixture. The frozen
+// metadata/counters do not grant domain readiness or any media permission.
+fn public_ready_value(a: &AuthorizedEnvelope) -> serde_json::Value {
+    let vectors: serde_json::Value =
+        serde_json::from_str(include_str!("../../golden-vectors.json")).unwrap();
+    let payload = vectors["vectors"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|v| v["id"] == "public-video-ready-original-three-roles-null-native-keycounter")
+        .unwrap()["envelope"]["payload"]
+        .clone();
+    // Keep the SAME originally authorized request ID, routing scopes and cutoff.
+    let mut value = a.envelope.original().clone();
+    value["payload"] = payload;
+    value["payload"]["by_participant"] = a.envelope.original()["payload"]["by_participant"].clone();
+    value["payload"]["substrate_setup"] = json!({"kind":"websocket+webrtc"});
+    value["payload"]["replacement_preparation"]["operation_record_id"] = json!("original-record");
+    value["payload"]["replacement_preparation"]["public_video_readiness"]["nonce"] =
+        json!("original-public-nonce");
+    value
+}
