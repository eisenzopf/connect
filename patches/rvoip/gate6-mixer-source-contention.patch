+//! A busy fresh source read does not discard an already accepted original frame.
+use super::*;
+struct BusySource {
+    inner: Arc<Policy>,
+    mode: Arc<AtomicUsize>,
+    reads: Arc<AtomicUsize>,
+}
+impl MediaPolicy for BusySource {
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current_participant_receive(scope, source)
+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let mode = self.mode.load(Ordering::Acquire);
+        if mode != 0
+            && scope.connection.as_str() == "a"
+            && matches!(scope.purpose, MediaPurpose::Publish)
+        {
+            let count = self.reads.fetch_add(1, Ordering::AcqRel);
+            if mode == 1 || count > 0 {
+                return Err(StreamControlError::NotReady);
+            }
+        }
+        self.inner.current(scope)
+    }
+}
+async fn scene() -> (Scene, Arc<AtomicUsize>) {
+    let mode = Arc::new(AtomicUsize::new(0));
+    let saved = mode.clone();
+    let s = Scene::new_inner(
+        &[("a", "alice", audio(), 0), ("b", "bob", audio(), 0)],
+        8000,
+        Some(Box::new(move |inner| {
+            Arc::new(BusySource {
+                inner,
+                mode: saved,
+                reads: Arc::new(AtomicUsize::new(0)),
+            })
+        })),
+    )
+    .await;
+    s.bind(0, true).await;
+    s.bind(1, true).await;
+    (s, mode)
+}
+#[tokio::test]
+async fn guarded_mixer_busy_collect_and_take_keep_original_frame_without_idle_grants() {
+    for stage in [1, 2] {
+        let (s, mode) = scene().await;
+        let mut output = s.port(1).take_egress().unwrap();
+        s.publish(0, 1800);
+        mode.store(stage, Ordering::Release);
+        s.mixer.tick();
+        assert!(output.try_recv().is_err());
+        drop(
+            s.policy
+                .0
+                .try_write()
+                .expect("busy mixer retained authority"),
+        );
+        mode.store(0, Ordering::Release);
+        s.mixer.tick();
+        heard(
+            output
+                .try_recv()
+                .expect("original frame lost while source was busy"),
+            1800,
+        )
+        .await;
+        s.mixer.tick();
+        assert!(output.try_recv().is_err(), "original frame repeated");
+    }
+}
+#[tokio::test]
+async fn guarded_mixer_busy_collect_and_take_recheck_revocation_and_never_replay() {
+    for stage in [1, 2] {
+        let (s, mode) = scene().await;
+        let mut output = s.port(1).take_egress().unwrap();
+        s.publish(0, 1800);
+        mode.store(stage, Ordering::Release);
+        s.mixer.tick();
+        s.policy
+            .0
+            .try_write()
+            .unwrap()
+            .revoked
+            .insert("alice".into());
+        mode.store(0, Ordering::Release);
+        s.mixer.tick();
+        assert!(output.try_recv().is_err());
+        s.policy.0.try_write().unwrap().revoked.clear();
+        s.mixer.tick();
+        assert!(output.try_recv().is_err(), "refused original replayed");
+        s.publish(0, 1800);
+        s.mixer.tick();
+        heard(output.try_recv().unwrap(), 1800).await;
+    }
+}
+#[tokio::test]
+async fn guarded_mixer_busy_collect_and_take_expire_original_then_accept_fresh_input() {
+    for stage in [1, 2] {
+        let (s, mode) = scene().await;
+        let mut output = s.port(1).take_egress().unwrap();
+        s.publish(0, 1800);
+        mode.store(stage, Ordering::Release);
+        s.mixer.tick();
+        drop(s.policy.0.try_write().unwrap());
+        tokio::time::sleep(Duration::from_millis(210)).await;
+        mode.store(0, Ordering::Release);
+        s.mixer.tick();
+        assert!(output.try_recv().is_err(), "expired original escaped");
+        s.publish(0, 1800);
+        s.mixer.tick();
+        heard(output.try_recv().unwrap(), 1800).await;
+    }
+}
+#[tokio::test]
+async fn guarded_mixer_busy_original_does_not_cross_pause_resume_epoch() {
+    for stage in [1, 2] {
+        let (s, mode) = scene().await;
+        let mut output = s.port(1).take_egress().unwrap();
+        s.publish(0, 1800);
+        mode.store(stage, Ordering::Release);
+        s.mixer.tick();
+        assert!(output.try_recv().is_err());
+        let c = &s.controllers[0];
+        let logical = desired(Medium::Audio).logical_id;
+        c.set_paused(&logical, c.revision(), true, deadline())
+            .await
+            .unwrap();
+        mode.store(0, Ordering::Release);
+        s.mixer.tick();
+        assert!(output.try_recv().is_err());
+        c.set_paused(&logical, c.revision(), false, deadline())
+            .await
+            .unwrap();
+        s.mixer.tick();
+        assert!(
+            output.try_recv().is_err(),
+            "pre-pause frame replayed after resume"
+        );
+        s.publish(0, 1000);
+        s.mixer.tick();
+        heard(output.try_recv().unwrap(), 1000).await;
+    }
+}
