+async fn resource_subscription_metadata_case(mode: &str) {
+    let (s, policy) = held_scene(&[Medium::Audio]).await;
+    let before = s.f.b.revision();
+    let budget = s.f.b.stream_open_budget();
+    let old = s.f.b.active_bindings()[0].clone();
+    let held = held_resources(&s, receiver_plan(&s)).await;
+    policy.collision.remaining.store(
+        if mode == "recover" { 1 } else { usize::MAX },
+        Ordering::Release,
+    );
+    let cancel = CancellationToken::new();
+    let until = if mode == "deadline" {
+        tokio::time::Instant::now() + Duration::from_millis(40)
+    } else {
+        deadline()
+    };
+    let update = tokio::spawn({
+        let controller = s.f.b.clone();
+        let scene = s.scene.clone();
+        let held = held.clone();
+        let cancel = cancel.clone();
+        async move {
+            controller
+                .change_selected_and_subscriptions(
+                    held.expected,
+                    held.selected.as_ref().unwrap(),
+                    &BTreeSet::new(),
+                    scene,
+                    &held.change,
+                    until,
+                    cancel,
+                    Arc::new(held.clone()),
+                )
+                .await
+        }
+    });
+    tokio::time::timeout(Duration::from_secs(1), policy.collision.seen.notified())
+        .await
+        .expect("controlled source metadata collision must be reached");
+    if mode == "cancel" {
+        cancel.cancel();
+    }
+    if mode == "revoke" {
+        policy.collision.denied.store(true, Ordering::Release);
+    }
+    let outcome = tokio::time::timeout(Duration::from_secs(3), update)
+        .await
+        .unwrap()
+        .unwrap();
+    eprintln!("resource-subscription-metadata mode={mode} outcome={outcome:?} revision={} opens={} adapter_ports={} source_checks={}", s.f.b.revision(), s.f.b.stream_open_budget().0, s.f.ba.outstanding.load(Ordering::Acquire), policy.collision.checks.load(Ordering::Acquire));
+    if mode == "recover" {
+        assert!(
+            outcome.is_ok(),
+            "one pre-IO metadata collision must recover under the original invocation: {outcome:?}"
+        );
+        assert_eq!(s.f.b.revision(), before + 1);
+        assert_eq!(s.f.b.stream_open_budget(), (budget.0 + 3, budget.1));
+        assert_eq!(s.f.ba.outstanding.load(Ordering::Acquire), 4);
+        assert!(policy.collision.checks.load(Ordering::Acquire) >= 2);
+    } else {
+        assert!(match mode {
+            "cancel" => matches!(outcome, Err(StreamControlError::Cancelled)),
+            "deadline" => matches!(outcome, Err(StreamControlError::Deadline)),
+            "revoke" => matches!(outcome, Err(StreamControlError::Authority)),
+            _ => false,
+        }, "original cancellation, cutoff and current source authorization must remain decisive: {outcome:?}");
+        assert_eq!(s.f.b.revision(), before);
+        assert_eq!(s.f.b.stream_open_budget(), budget);
+        assert_eq!(
+            s.f.ba.outstanding.load(Ordering::Acquire),
+            1,
+            "no adapter IO may precede successful source metadata preparation"
+        );
+        assert_eq!(s.f.b.active_bindings().len(), 1);
+    }
+    assert!(s
+        .f
+        .b
+        .active_bindings()
+        .iter()
+        .any(|binding| binding.transport_id == old.transport_id
+            && binding.stream_local_id == old.stream_local_id));
+}
+#[tokio::test]
+async fn resource_subscription_metadata_collision_recovers_before_single_adapter_prepare() {
+    resource_subscription_metadata_case("recover").await;
+}
+#[tokio::test]
+async fn resource_subscription_metadata_collision_preserves_original_cancellation() {
+    resource_subscription_metadata_case("cancel").await;
+}
+#[tokio::test]
+async fn resource_subscription_metadata_collision_preserves_original_deadline() {
+    resource_subscription_metadata_case("deadline").await;
+}
+#[tokio::test]
+async fn resource_subscription_metadata_collision_rechecks_current_source_authorization() {
+    resource_subscription_metadata_case("revoke").await;
+}
