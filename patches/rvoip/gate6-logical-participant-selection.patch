+
+#[tokio::test]
+async fn retained_media_participant_reconciles_after_distinct_route_replacement_without_lending_old_principal(
+) {
+    use crate::staged_streams::selection_intent::SelectionMutation;
+    let mut f = Move::with_route_actor_and_selection(false, "sip-account", true).await;
+    f.io().await;
+    f.confirm().await;
+    let plan = f.plan().unwrap();
+    f.commit(plan).await.unwrap();
+    // The host publishes the current physical owner derived from the actual
+    // committed resource proof, rather than keeping a provisional fixture row.
+    let current = {
+        let guard = f.room.domain.base.0.read().await;
+        f.room
+            .domain
+            .resource_owner(&guard, guard.owners["device"].clone())
+            .unwrap()
+    };
+    f.room
+        .domain
+        .base
+        .0
+        .write()
+        .await
+        .owners
+        .insert("device".into(), current);
+    let bob = &f.room.nodes["bob"].controller;
+    let previous = f
+        .room
+        .scene
+        .selections
+        .lock()
+        .unwrap()
+        .get(&bob.connection)
+        .unwrap()
+        .clone();
+    let request = previous.participants.values().next().unwrap().clone();
+    assert!(request.matches(&f.room.nodes["device"].controller));
+    let intent = SelectionMutation::new(
+        &f.room.scene,
+        bob,
+        bob.revision(),
+        Some(previous.clone()),
+        (*previous).clone(),
+        vec![request],
+    )
+    .unwrap();
+    f.room
+        .scene
+        .change_media_subscriptions(
+            &bob.connection,
+            bob.revision(),
+            MediaSubscriptionChange {
+                selection: Some(intent),
+                audio: None,
+                direct: None,
+            },
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+        .unwrap();
+    f.room.publish("device", 5200).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 5200).await;
+    f.room.domain.base.0.write().await.owners.remove("device");
+    assert!(f.room.publish("device", 5200).is_err());
+    f.room.publish("other", 1800).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 1800).await;
+}
