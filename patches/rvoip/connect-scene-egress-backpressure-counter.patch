+#[tokio::test]
+async fn scene_video_egress_full_retry_keeps_age_earliest_expiry_revocation_and_receiver_epochs() {
+    for mode in ["age", "expiry", "revocation", "subscription", "port"] {
+        let f = RecipientScene::new(&[Medium::Video], 1).await;
+        let mut healthy = f.f.ba.port(Medium::Video).take_egress().unwrap();
+        let mut blocked = f.candidates[0].1.port(Medium::Video).take_egress().unwrap();
+        let healthy_seen = Arc::new(Mutex::new(Vec::new()));
+        let blocked_seen = Arc::new(Mutex::new(Vec::new()));
+        let mut failures = Vec::new();
+        for n in 0..blocked.max_capacity() {
+            f.publish(Medium::Video, n as u32);
+            f.scene.tick();
+            failures.extend(record_backpressure_output(&mut healthy, &healthy_seen).await);
+        }
+        if mode == "expiry" {
+            *f.source_expiry.lock().unwrap() =
+                Some(chrono::Utc::now() + chrono::Duration::milliseconds(50));
+        }
+        let original = publish_backpressure_fragment(&f, 500, 90000, true, true);
+        f.scene.tick();
+        failures.extend(record_backpressure_output(&mut healthy, &healthy_seen).await);
+        *f.source_expiry.lock().unwrap() = None;
+        let retained_before = f.retained();
+        // Drop the older queued fixture packets without invoking stale IO.
+        while blocked.try_recv().is_ok() {}
+        match mode {
+            "age" => tokio::time::sleep(Duration::from_millis(215)).await,
+            "expiry" => tokio::time::sleep(Duration::from_millis(80)).await,
+            "revocation" => {
+                f.f.policy
+                    .0
+                    .write()
+                    .await
+                    .revoked
+                    .insert("candidate-0".into());
+            }
+            "subscription" => {
+                f.scene
+                    .change_direct_subscriptions(
+                        &f.candidates[0].0.connection,
+                        f.candidates[0].0.revision(),
+                        DirectSubscriptionChange::Clear,
+                        deadline(),
+                        CancellationToken::new(),
+                        None,
+                    )
+                    .await
+                    .unwrap();
+            }
+            "port" => {
+                let controller = &f.candidates[0].0;
+                controller
+                    .change(
+                        controller.revision(),
+                        &[desired(Medium::Video)],
+                        &[desired(Medium::Video).logical_id].into_iter().collect(),
+                        deadline(),
+                        CancellationToken::new(),
+                    )
+                    .await
+                    .unwrap();
+            }
+            _ => unreachable!(),
+        }
+        f.scene.tick();
+        let no_old_output = blocked.try_recv().is_err();
+        if mode == "revocation" {
+            f.f.policy.0.write().await.revoked.remove("candidate-0");
+        }
+        if mode == "subscription" {
+            let c = &f.candidates[0].0;
+            f.scene
+                .change_direct_subscriptions(
+                    &c.connection,
+                    c.revision(),
+                    DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                        &f.f.a,
+                        desired(Medium::Video).logical_id.clone(),
+                        desired(Medium::Video).logical_id,
+                    )]),
+                    deadline(),
+                    CancellationToken::new(),
+                    None,
+                )
+                .await
+                .unwrap();
+        }
+        if mode == "port" {
+            blocked = f.candidates[0].1.port(Medium::Video).take_egress().unwrap();
+        }
+        f.scene.tick();
+        let no_revival = blocked.try_recv().is_err();
+        let fresh = publish_backpressure_fragment(&f, 501, 93000, true, true);
+        f.scene.tick();
+        failures.extend(record_backpressure_output(&mut healthy, &healthy_seen).await);
+        failures.extend(record_backpressure_output(&mut blocked, &blocked_seen).await);
+        let recovered = blocked_seen.lock().unwrap().clone();
+        let after = f.retained();
+        drop(healthy);
+        drop(blocked);
+        failures.extend(close_backpressure_scene(&f).await);
+        assert!(failures.is_empty(), "{mode}:{failures:?}");
+        assert_eq!(
+            retained_before,
+            (1, 1, 0, 0),
+            "{mode}: initial backpressure was not retained"
+        );
+        assert!(
+            no_old_output && no_revival,
+            "{mode}: original crossed expiry/current receiver fence"
+        );
+        assert_eq!(
+            recovered,
+            vec![fresh],
+            "{mode}: only new original should recover"
+        );
+        assert!(!recovered.contains(&original));
+        assert_eq!(after, (0, 0, 0, 0));
+    }
+}
