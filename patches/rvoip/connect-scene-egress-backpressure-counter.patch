+#[tokio::test]
+async fn scene_video_egress_full_retains_original_fragment_and_fifo_while_healthy_recipient_progresses()
+ {
+    let f = RecipientScene::new(&[Medium::Video], 1).await;
+    let mut healthy = f.f.ba.port(Medium::Video).take_egress().unwrap();
+    let mut blocked = f.candidates[0].1.port(Medium::Video).take_egress().unwrap();
+    let capacity = blocked.max_capacity();
+    let healthy_seen = Arc::new(Mutex::new(Vec::new()));
+    let blocked_seen = Arc::new(Mutex::new(Vec::new()));
+    let mut expected = Vec::new();
+    let mut failures = Vec::new();
+    for n in 0..capacity - 1 {
+        expected.push(publish_backpressure_fragment(
+            &f,
+            n as u16,
+            90000 + n as u32 * 3000,
+            true,
+            true,
+        ));
+        f.scene.tick();
+        failures.extend(record_backpressure_output(&mut healthy, &healthy_seen).await);
+    }
+    let timestamp = 90000 + (capacity - 1) as u32 * 3000;
+    expected.push(publish_backpressure_fragment(
+        &f,
+        (capacity - 1) as u16,
+        timestamp,
+        false,
+        true,
+    ));
+    f.scene.tick();
+    failures.extend(record_backpressure_output(&mut healthy, &healthy_seen).await);
+    // These are NEW original inputs, not retries/republication of the first
+    // fragment. The second fragment alone encounters the actual full queue.
+    expected.push(publish_backpressure_fragment(
+        &f,
+        capacity as u16,
+        timestamp,
+        true,
+        false,
+    ));
+    expected.push(publish_backpressure_fragment(
+        &f,
+        (capacity + 1) as u16,
+        timestamp + 3000,
+        true,
+        true,
+    ));
+    f.scene.tick();
+    failures.extend(record_backpressure_output(&mut healthy, &healthy_seen).await);
+    let retained_before = f.retained();
+    let healthy_before_release = healthy_seen.lock().unwrap().clone();
+    let no_authority_retained = f.f.policy.0.try_write().is_ok();
+    failures.extend(record_backpressure_output(&mut blocked, &blocked_seen).await);
+    f.scene.tick();
+    failures.extend(record_backpressure_output(&mut blocked, &blocked_seen).await);
+    let after = f.retained();
+    let healthy_after = healthy_seen.lock().unwrap().clone();
+    let blocked_after = blocked_seen.lock().unwrap().clone();
+    drop(healthy);
+    drop(blocked);
+    failures.extend(close_backpressure_scene(&f).await);
+    eprintln!(
+        "G6_SCENE_EGRESS_FULL original_inputs={} target_capacity={} healthy_before_release={} blocked_after_release={} retained_before={:?} retained_after={:?} no_authority_retained={} all_original_cleanup={} failures={:?}",
+        expected.len(),
+        capacity,
+        healthy_before_release.len(),
+        blocked_after.len(),
+        retained_before,
+        after,
+        no_authority_retained,
+        failures.is_empty(),
+        failures
+    );
+    // The old source naturally reaches this unique post-cleanup loss oracle:
+    // full-target fragment and later frame were discarded, healthy stayed live.
+    assert!(failures.is_empty(), "{failures:?}");
+    assert!(no_authority_retained);
+    assert_eq!(
+        healthy_before_release, expected,
+        "healthy recipient waited for another recipient's capacity"
+    );
+    assert_eq!(healthy_after, expected, "retry duplicated healthy output");
+    assert_eq!(
+        retained_before,
+        (2, 2, 0, 0),
+        "known pre-enqueue backpressure dropped original work"
+    );
+    assert_eq!(
+        blocked_after, expected,
+        "full-target original fragment/FIFO bytes lost or repeated"
+    );
+    assert_eq!(after, (0, 0, 0, 0));
+}
