+// Real scene/Port egress queue controls, not decoded codec or network proof.
+// One fragment fills the last target slot; its companion and a later frame
+// must retain exact original FIFO work without blocking a healthy recipient.
+fn publish_backpressure_fragment(
+    f: &RecipientScene,
+    sequence: u16,
+    timestamp: u32,
+    marker: bool,
+    first: bool,
+) -> (u32, Vec<u8>) {
+    let port = f.f.aa.port(Medium::Video);
+    let mut original = frame(&port, timestamp);
+    let mut payload = vec![0x80, 96 | if marker { 0x80 } else { 0 }];
+    payload.extend_from_slice(&sequence.to_be_bytes());
+    payload.extend_from_slice(&timestamp.to_be_bytes());
+    payload.extend_from_slice(&7u32.to_be_bytes());
+    payload.extend_from_slice(&[if first { 0x10 } else { 0 }, 0x31, 0x42, sequence as u8]);
+    original.payload = Bytes::from(payload.clone());
+    port.try_publish(&original).unwrap();
+    (timestamp, payload)
+}
+async fn record_backpressure_output(
+    output: &mut mpsc::Receiver<QueuedMedia>,
+    observed: &Arc<Mutex<Vec<(u32, Vec<u8>)>>>,
+) -> Vec<String> {
+    let mut failures = Vec::new();
+    while let Ok(packet) = output.try_recv() {
+        let observed = observed.clone();
+        if let Err(error) = packet
+            .deliver(move |frame| async move {
+                observed
+                    .lock()
+                    .unwrap()
+                    .push((frame.timestamp_rtp, frame.payload.to_vec()));
+                Ok(())
+            })
+            .await
+        {
+            failures.push(format!("{error:?}"));
+        }
+    }
+    failures
+}
+async fn close_backpressure_scene(f: &RecipientScene) -> Vec<String> {
+    // The fixture manually ticks the original scene; it starts no scheduler.
+    // Remove its original members, then await every actual controller cleanup.
+    for controller in [&f.f.a, &f.f.b]
+        .into_iter()
+        .chain(f.candidates.iter().map(|(c, _)| c))
+    {
+        f.scene.remove(&controller.connection);
+    }
+    let mut failures = Vec::new();
+    for controller in [&f.f.a, &f.f.b]
+        .into_iter()
+        .chain(f.candidates.iter().map(|(c, _)| c))
+    {
+        let remaining = controller.shutdown(deadline()).await;
+        if remaining != 0 {
+            failures.push(format!("{}:{remaining}", controller.connection.as_str()));
+        }
+    }
+    for adapter in [&f.f.aa, &f.f.ba]
+        .into_iter()
+        .chain(f.candidates.iter().map(|(_, a)| a))
+    {
+        if adapter.outstanding.load(Ordering::Acquire) != 0 {
+            failures.push("original adapter cleanup outstanding".into());
+        }
+    }
+    failures
+}
