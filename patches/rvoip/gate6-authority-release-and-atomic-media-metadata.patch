@@ -0,0 +1,69 @@
+//! Exact credential metadata publication. Packet readers retain one immutable
+//! principal/revision pair; existing control writers retain the same mutex and
+//! publish before releasing it. This metadata is never an authority lease.
+use super::CredentialSnapshot;
+use arc_swap::ArcSwap;
+use std::{
+    ops::{Deref, DerefMut},
+    sync::{Arc, LockResult, Mutex, MutexGuard, PoisonError, TryLockError, TryLockResult},
+};
+
+pub(super) struct CredentialPublication {
+    published: ArcSwap<CredentialSnapshot>,
+    writer: Mutex<CredentialSnapshot>,
+}
+impl CredentialPublication {
+    pub(super) fn new(value: CredentialSnapshot) -> Self {
+        Self {
+            published: ArcSwap::from_pointee(value.clone()),
+            writer: Mutex::new(value),
+        }
+    }
+    pub(super) fn snapshot(&self) -> CredentialSnapshot {
+        self.published.load_full().as_ref().clone()
+    }
+    fn guard<'a>(&'a self, value: MutexGuard<'a, CredentialSnapshot>) -> CredentialWrite<'a> {
+        CredentialWrite { owner: self, value }
+    }
+    pub(super) fn lock(&self) -> LockResult<CredentialWrite<'_>> {
+        self.writer
+            .lock()
+            .map(|value| self.guard(value))
+            .map_err(|error| PoisonError::new(self.guard(error.into_inner())))
+    }
+    pub(super) fn try_lock(&self) -> TryLockResult<CredentialWrite<'_>> {
+        self.writer
+            .try_lock()
+            .map(|value| self.guard(value))
+            .map_err(|error| match error {
+                TryLockError::WouldBlock => TryLockError::WouldBlock,
+                TryLockError::Poisoned(error) => {
+                    TryLockError::Poisoned(PoisonError::new(self.guard(error.into_inner())))
+                }
+            })
+    }
+}
+pub(super) struct CredentialWrite<'a> {
+    owner: &'a CredentialPublication,
+    value: MutexGuard<'a, CredentialSnapshot>,
+}
+impl Deref for CredentialWrite<'_> {
+    type Target = CredentialSnapshot;
+    fn deref(&self) -> &CredentialSnapshot {
+        &self.value
+    }
+}
+impl DerefMut for CredentialWrite<'_> {
+    fn deref_mut(&mut self) -> &mut CredentialSnapshot {
+        &mut self.value
+    }
+}
+impl Drop for CredentialWrite<'_> {
+    fn drop(&mut self) {
+        // Preserve the original Mutex recovery behavior: the complete retained
+        // principal/revision value becomes visible even when a caller unwinds.
+        // No permission is minted here; every actual use retains its original
+        // policy/currentness, expiry and delivery-ticket checks.
+        self.owner.published.store(Arc::new(self.value.clone()));
+    }
+}
