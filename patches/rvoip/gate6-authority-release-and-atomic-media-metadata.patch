+#[test]
+fn actual_rtc_current_does_not_wait_for_preparation_publication_and_poison_refuses() {
+    use rvoip_core::peer_admission::PeerAdmissionOwner;
+    let physical_lifetime = CancellationToken::new();
+    let mut accepted = principal("publication");
+    accepted.assurance = IdentityAssurance::Identified {
+        credential_kind: rvoip_core::identity::CredentialKind::Oidc,
+    };
+    let peer_owner = PeerAdmissionOwner::new(
+        &accepted,
+        IdentityId::new(),
+        DeviceId::new(),
+        physical_lifetime.child_token(),
+        Default::default(),
+    )
+    .unwrap();
+    let physical = WebRtcPhysicalBinding::new(&peer_owner.peer(), physical_lifetime.child_token());
+    let backend = Backend::new(
+        ConnectionId::new(),
+        physical,
+        physical_lifetime.child_token(),
+        Weak::new(),
+    );
+    let activation = Arc::new(RtcMediaActivation {
+        controller: Weak::new(),
+        backend: Arc::downgrade(&backend),
+        prepared: arc_swap::ArcSwapOption::empty(),
+        publication: Mutex::new(()),
+    });
+    let publication = activation.publication.lock().unwrap();
+    let (tx, rx) = std::sync::mpsc::channel();
+    let original = activation.clone();
+    let worker = std::thread::spawn(move || {
+        tx.send(original.current(owner("publication")).map(|_| ()))
+            .unwrap();
+    });
+    let before_release = rx.recv_timeout(Duration::from_secs(1));
+    let invoked = AtomicBool::new(false);
+    let publication_result = activation.try_publish_installed(1, || {
+        invoked.store(true, std::sync::atomic::Ordering::Release);
+    });
+    // Always release/join before asserting; no detached fixture owner remains.
+    drop(publication);
+    worker.join().unwrap();
+    assert!(matches!(before_release, Ok(Err(StreamControlError::NotReady))), "actual RTC current must refuse missing preparation while control publication is still held");
+    assert!(matches!(
+        publication_result,
+        Err(StreamControlError::NotReady)
+    ));
+    assert!(!invoked.load(std::sync::atomic::Ordering::Acquire));
+    let original = activation.clone();
+    assert!(std::thread::spawn(move || {
+        let _publication = original.publication.lock().unwrap();
+        panic!("controlled RTC publication poison");
+    })
+    .join()
+    .is_err());
+    assert!(matches!(
+        activation.current(owner("publication")),
+        Err(StreamControlError::Authority)
+    ));
+    drop(activation);
+    drop(backend);
+    drop(peer_owner);
+    physical_lifetime.cancel();
