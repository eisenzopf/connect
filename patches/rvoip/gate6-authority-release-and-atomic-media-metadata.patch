+    pub(in crate::v2) fn for_replies(
+        &self,
+        replies: &[Envelope],
+    ) -> Result<AuthorityLease, DispatchError> {
+        let lease = self.0.lock();
+        if !lease.current() {
+            return Err(DispatchError::Authority);
+        }
+        if let Some(resource) = lease.authority::<ResourcePreparation>() {
+            for reply in replies {
+                if reply.kind() == "connection.answer" {
+                    resource.permits(reply)?;
+                } else if reply.kind() == "error"
+                    && reply.scope(Scope::Reply) == Some(resource.original.id())
+                    && [
+                        Scope::Conversation,
+                        Scope::Session,
+                        Scope::Connection,
+                        Scope::Operation,
+                    ]
+                    .iter()
+                    .all(|scope| {
+                        resource.original.scope(*scope).is_some()
+                            && resource.original.scope(*scope) == reply.scope(*scope)
+                    })
+                {
+                    // Only a scoped refusal, never another application result.
+                } else {
+                    return Err(DispatchError::ReplyMismatch);
+                }
+            }
+        }
+        Ok(lease.retained())
+    }
+}
