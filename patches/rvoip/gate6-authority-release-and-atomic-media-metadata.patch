+#[test]
+fn original_credential_snapshot_and_binding_read_do_not_wait_for_control_publication() {
+    let (f, _) = setup(principal("alice"));
+    let old = f.a.credential_snapshot();
+    let owner = f.policy.0.try_read().unwrap().owners["alice"].clone();
+    let mut writer = f.a.credential.lock().unwrap();
+    let mut next = old.principal.as_ref().clone();
+    next.scopes.push("fresh-credential-metadata".into());
+    *writer = CredentialSnapshot {
+        principal: Arc::new(next),
+        revision: old.revision + 1,
+    };
+    let original = f.a.clone();
+    let (tx, rx) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        let captured = original.credential_snapshot();
+        let bound = original.is_bound_to(&owner.member, &owner.endpoint);
+        tx.send((captured, bound)).unwrap();
+    });
+    let before_release = rx.recv_timeout(std::time::Duration::from_secs(1));
+    // Always release and join the actual owner before evaluating the witness.
+    drop(writer);
+    worker.join().unwrap();
+    let (captured, bound) = before_release
+        .expect("ordinary credential/binding read must finish while control publication is held");
+    assert!(bound);
+    assert_eq!(captured.revision, old.revision);
+    assert!(Arc::ptr_eq(&captured.principal, &old.principal));
+    let current = f.a.credential_snapshot();
+    assert_eq!(current.revision, old.revision + 1);
+    assert!(!Arc::ptr_eq(&current.principal, &old.principal));
+    assert!(
+        f.a.check_credential_snapshot(&old).is_err(),
+        "old queued credential metadata must not borrow the new publication"
+    );
+    assert!(f.a.check_credential_snapshot(&current).is_ok());
+}
