@@ -0,0 +1,68 @@
+//! One original allocation future. Construction/cleanup keep the same owner
+//! mutex; ordinary readiness only peeks a published handle to that exact future.
+use super::Allocation;
+use arc_swap::ArcSwapOption;
+use std::{
+    ops::{Deref, DerefMut},
+    sync::{Arc, LockResult, Mutex, MutexGuard, PoisonError},
+};
+pub(super) struct AllocationPublication {
+    published: ArcSwapOption<Allocation>,
+    original: Mutex<Option<Allocation>>,
+}
+impl AllocationPublication {
+    pub(super) fn new() -> Self {
+        Self {
+            published: ArcSwapOption::empty(),
+            original: Mutex::new(None),
+        }
+    }
+    pub(super) fn snapshot(&self) -> Option<Arc<Allocation>> {
+        self.published.load_full()
+    }
+    pub(super) fn lock(&self) -> LockResult<AllocationWrite<'_>> {
+        self.original
+            .lock()
+            .map(|value| AllocationWrite { owner: self, value })
+            .map_err(|error| {
+                PoisonError::new(AllocationWrite {
+                    owner: self,
+                    value: error.into_inner(),
+                })
+            })
+    }
+    /// Only the physical binding's final Drop can move its original future.
+    /// Cancellation has already happened; the actual cleanup task owns this
+    /// same future afterward, never a new allocation or inferred receipt.
+    pub(super) fn take_mut(&mut self) -> Option<Allocation> {
+        self.published.store(None);
+        self.original
+            .get_mut()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+    }
+}
+pub(super) struct AllocationWrite<'a> {
+    owner: &'a AllocationPublication,
+    value: MutexGuard<'a, Option<Allocation>>,
+}
+impl Deref for AllocationWrite<'_> {
+    type Target = Option<Allocation>;
+    fn deref(&self) -> &Self::Target {
+        &self.value
+    }
+}
+impl DerefMut for AllocationWrite<'_> {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.value
+    }
+}
+impl Drop for AllocationWrite<'_> {
+    fn drop(&mut self) {
+        // Publish while still holding the original start/cleanup mutex. Shared
+        // clones retain the same spawned task/result; none restarts or polls IO.
+        self.owner
+            .published
+            .store(self.value.as_ref().map(|value| Arc::new(value.clone())));
+    }
+}
