+// Exercise the actual decoder-only Probe, not an authority or readiness flag.
+fn observe_preparation(target: &Target, sequence: u32) -> ControlResult<()> {
+    let node = &target.room.nodes["fresh"];
+    let port = node.adapter.port(Medium::Audio);
+    target
+        .preparation
+        .probe
+        .observe(&node.controller, &port.0, &frame(&port, sequence))
+        .expect("original preparation remains selected")
+}
+#[tokio::test]
+async fn endpoint_probe_policy_refuses_model_aba_credential_original_port_and_shutdown_changes() {
+    for changed in 0..5 {
+        let target = Target::new(true).await;
+        let controller = target.room.nodes["fresh"].controller.clone();
+        let owner = target.room.domain.base.0.read().await.owners["fresh"].clone();
+        let since = Instant::now();
+        *target.room.domain.preparation_action.lock().unwrap() = Some(Box::new({
+            let controller = controller.clone();
+            move || {
+                assert!(
+                    controller.state.try_lock().is_ok(),
+                    "policy retained model State"
+                );
+                match changed {
+                    0 => {
+                        let mut state = controller.state.lock().unwrap();
+                        for paused in [true, false] {
+                            let expected = state.model.revision();
+                            state
+                                .model
+                                .set_paused(
+                                    &owner.current(),
+                                    expected,
+                                    &desired(Medium::Audio).logical_id,
+                                    paused,
+                                )
+                                .unwrap();
+                        }
+                    }
+                    1 => controller.credential.lock().unwrap().revision += 1,
+                    2 => controller.state.lock().unwrap().active
+                        [&desired(Medium::Audio).logical_id]
+                        .retire(),
+                    3 => controller.state.lock().unwrap().closed = true,
+                    4 => controller.shutdown.cancel(),
+                    _ => unreachable!(),
+                }
+            }
+        }));
+        assert!(
+            observe_preparation(&target, 801).is_err(),
+            "changed={changed}"
+        );
+        assert!(target
+            .room
+            .domain
+            .preparation_action
+            .lock()
+            .unwrap()
+            .is_none());
+        assert!(!target
+            .preparation
+            .probe
+            .consumer
+            .decoded_since(&controller, since));
+        assert!(controller.state.try_lock().is_ok());
+        assert!(target.preparation.probe.registry.try_lock().is_ok());
+    }
+}
+#[tokio::test]
+async fn endpoint_probe_policy_refuses_consumed_registry_and_replaced_probe_owners() {
+    for changed in 0..4 {
+        let target = Target::new(true).await;
+        let probe = target.preparation.probe.clone();
+        let controller = target.room.nodes["fresh"].controller.clone();
+        let since = Instant::now();
+        *target.room.domain.preparation_action.lock().unwrap() = Some(Box::new({
+            let probe = probe.clone();
+            let controller = controller.clone();
+            move || {
+                assert!(
+                    probe.registry.try_lock().is_ok(),
+                    "policy retained preparation registry"
+                );
+                match changed {
+                    0 => probe.cancel.cancel(),
+                    1 => {
+                        probe
+                            .registry
+                            .lock()
+                            .unwrap()
+                            .groups
+                            .remove(&probe.group.operation);
+                    }
+                    2 => *controller.audio_preparation.lock().unwrap() = None,
+                    3 => {
+                        let replacement = Arc::new((*probe.group).clone());
+                        probe
+                            .registry
+                            .lock()
+                            .unwrap()
+                            .groups
+                            .insert(probe.group.operation.clone(), replacement);
+                    }
+                    _ => unreachable!(),
+                }
+            }
+        }));
+        assert!(
+            observe_preparation(&target, 802).is_err(),
+            "changed={changed}"
+        );
+        assert!(target
+            .room
+            .domain
+            .preparation_action
+            .lock()
+            .unwrap()
+            .is_none());
+        assert!(!probe.consumer.decoded_since(&controller, since));
+    }
+    let mut room = Room::new().await;
+    room.add_owned_with_media(
+        "fresh",
+        "fresh",
+        owner("fresh"),
+        true,
+        None,
+        vec![desired(Medium::Audio), desired(Medium::Video)],
+    )
+    .await;
+    let id = ConnectionId::from_string("fresh");
+    room.domain
+        .local_preparations
+        .lock()
+        .unwrap()
+        .insert(id.clone(), "prepare-fresh".into());
+    let preparation = room
+        .scene
+        .prepare_audio_endpoint(&id, "prepare-fresh")
+        .unwrap();
+    let target = Target {
+        room,
+        preparation,
+        operation: "prepare-fresh".into(),
+    };
+    let controller = target.room.nodes["fresh"].controller.clone();
+    let since = Instant::now();
+    *target.room.domain.preparation_action.lock().unwrap() = Some(Box::new({
+        let controller = controller.clone();
+        move || controller.state.lock().unwrap().active[&desired(Medium::Video).logical_id].retire()
+    }));
+    assert!(observe_preparation(&target, 809).is_err());
+    assert!(target
+        .room
+        .domain
+        .preparation_action
+        .lock()
+        .unwrap()
+        .is_none());
+    assert!(!target
+        .preparation
+        .probe
+        .consumer
+        .decoded_since(&controller, since));
+}
+#[tokio::test]
+async fn endpoint_probe_policy_freezes_original_consumer_and_scene_activation() {
+    for changed in 0..5 {
+        let target = Target::new(true).await;
+        let probe = target.preparation.probe.clone();
+        let controller = target.room.nodes["fresh"].controller.clone();
+        let since = Instant::now();
+        let replacement =
+            audio_consumer::AudioConsumer::optional(Some(desired(Medium::Audio).logical_id), 8000);
+        replacement.activate(false);
+        *target.room.domain.preparation_action.lock().unwrap() = Some(Box::new({
+            let probe = probe.clone();
+            let controller = controller.clone();
+            let replacement = replacement.clone();
+            move || match changed {
+                0 => probe.consumer.activate(false),
+                1 => *controller.audio_consumer.lock().unwrap() = None,
+                2 => controller
+                    .scene_consumer
+                    .lock()
+                    .unwrap()
+                    .as_ref()
+                    .unwrap()
+                    .upgrade()
+                    .unwrap()
+                    .activate(),
+                3 => *controller.scene_consumer.lock().unwrap() = None,
+                4 => {
+                    *controller.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&replacement))
+                }
+                _ => unreachable!(),
+            }
+        }));
+        assert!(
+            observe_preparation(&target, 803).is_err(),
+            "changed={changed}"
+        );
+        assert!(target
+            .room
+            .domain
+            .preparation_action
+            .lock()
+            .unwrap()
+            .is_none());
+        assert!(!probe.consumer.decoded_since(&controller, since));
+        // A new packet may use a genuinely current activation; the old one may not.
+        if changed == 0 || changed == 2 {
+            observe_preparation(&target, 804).unwrap();
+            assert!(probe.consumer.decoded_since(&controller, since));
+        }
+    }
+}
+#[tokio::test]
+async fn endpoint_probe_codec_collision_records_nothing_and_releases_original_guards() {
+    let target = Target::new(true).await;
+    let probe = target.preparation.probe.clone();
+    let controller = target.room.nodes["fresh"].controller.clone();
+    let since = Instant::now();
+    let decoder = probe.decoder.lock().unwrap();
+    assert!(observe_preparation(&target, 805).is_err());
+    assert!(!probe.consumer.decoded_since(&controller, since));
+    assert!(controller.state.try_lock().is_ok());
+    assert!(probe.registry.try_lock().is_ok());
+    drop(decoder);
+    observe_preparation(&target, 806).unwrap();
+    assert!(probe.consumer.decoded_since(&controller, since));
+}
