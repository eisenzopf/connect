+#[tokio::test]
+async fn endpoint_probe_blocked_policy_keeps_original_private_video_writer_and_registry_available()
+{
+    let mut f = Preroll::new_with_endpoint_preparation(true).await;
+    let prepared = f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob", 807);
+    let queued = outgoing(&mut f.target_output).await;
+    let controller = f.movement.room.nodes["device"].controller.clone();
+    let probe = controller
+        .audio_preparation
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .upgrade()
+        .unwrap();
+    let port = f.movement.room.nodes["device"].adapter.port(Medium::Audio);
+    let frame = frame(&port, 808);
+    let (entered, waiting) = std::sync::mpsc::sync_channel(1);
+    let (release, released) = std::sync::mpsc::sync_channel(1);
+    *f.movement.room.domain.preparation_action.lock().unwrap() = Some(Box::new(move || {
+        let _ = entered.send(());
+        released
+            .recv_timeout(Duration::from_secs(2))
+            .expect("original callback release");
+    }));
+    let (done, result) = std::sync::mpsc::sync_channel(1);
+    let original = {
+        let probe = probe.clone();
+        let controller = controller.clone();
+        std::thread::spawn(move || {
+            let value = probe.observe(&controller, &port.0, &frame);
+            let _ = done.send(value);
+        })
+    };
+    let mut workers = AudioGateWorkers::new(release, original);
+    let started = waiting.recv_timeout(Duration::from_secs(1));
+    let model_free = controller.state.try_lock().is_ok();
+    let registry_free = probe.registry.try_lock().is_ok();
+    let output_scope = probe.output_scope(
+        &crate::staged_streams::local_audio::LocalAudioPurpose::EndpointPreparation {
+            operation_id: probe.group.operation.clone(),
+        },
+    );
+    let writes = Arc::new(AtomicUsize::new(0));
+    let observed = writes.clone();
+    let delivered = tokio::time::timeout(
+        Duration::from_secs(1),
+        queued.deliver_video_with_feedback(move |_, _, _| {
+            observed.fetch_add(1, Ordering::AcqRel);
+            std::future::ready(Ok(()))
+        }),
+    )
+    .await;
+    workers.finish();
+    assert!(started.is_ok(), "original preparation callback not reached");
+    assert!(
+        model_free && registry_free,
+        "Probe retained coarse metadata across policy"
+    );
+    assert!(output_scope.is_ok(), "same preparation output was excluded");
+    assert!(
+        delivered.is_ok_and(|value| value.is_ok()),
+        "original queued private video could not complete"
+    );
+    assert_eq!(writes.load(Ordering::Acquire), 1);
+    assert!(matches!(result.try_recv(), Ok(Some(Ok(())))));
+    assert!(f
+        .movement
+        .room
+        .domain
+        .preparation_action
+        .lock()
+        .unwrap()
+        .is_none());
+    assert!(prepared.is_current());
+}
