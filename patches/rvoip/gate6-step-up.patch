+use super::*;
+
+/// A policy-owned requirement with explicit delegation provenance. Assurance
+/// labels alone are not a total ordering of authority over tasks and users.
+#[derive(Clone, PartialEq, Eq)]
+pub enum AssuranceRequirement {
+    Identified,
+    TaskScoped {
+        task_id: String,
+        scopes: Vec<String>,
+    },
+    UserAuthorized {
+        user_id: rvoip_core::IdentityId,
+        scopes: Vec<String>,
+    },
+}
+impl fmt::Debug for AssuranceRequirement {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("AssuranceRequirement")
+            .field(&self.label())
+            .finish()
+    }
+}
+impl AssuranceRequirement {
+    pub fn label(&self) -> &'static str {
+        match self {
+            Self::Identified => "identified",
+            Self::TaskScoped { .. } => "task-scoped",
+            Self::UserAuthorized { .. } => "user-authorized",
+        }
+    }
+    fn validate(&self) -> Result<(), DispatchError> {
+        let scopes = match self {
+            Self::Identified => return Ok(()),
+            Self::TaskScoped { task_id, scopes } => {
+                Identifier::try_from(task_id.clone())?;
+                scopes
+            }
+            Self::UserAuthorized { user_id, scopes } => {
+                Identifier::try_from(user_id.as_str().to_owned())?;
+                scopes
+            }
+        };
+        if scopes.is_empty()
+            || scopes.len() > 64
+            || scopes
+                .iter()
+                .any(|s| s.is_empty() || s.len() > 256 || s.chars().any(char::is_control))
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(())
+    }
+    fn meets(&self, principal: &AuthenticatedPrincipal, identity: &Identifier) -> bool {
+        if effective_expiry(principal).is_err() {
+            return false;
+        }
+        let includes = |required: &[String], actual: &[String]| {
+            required.iter().all(|scope| {
+                principal.has_scope(scope) && actual.iter().any(|item| item == scope || item == "*")
+            })
+        };
+        match (self, &principal.assurance) {
+            (Self::Identified, IdentityAssurance::Identified { .. }) => true,
+            (
+                Self::Identified,
+                IdentityAssurance::TaskScoped { identity: id, .. }
+                | IdentityAssurance::UserAuthorized { identity: id, .. },
+            ) => id.as_str() == identity.as_str(),
+            (
+                Self::TaskScoped { task_id, scopes },
+                IdentityAssurance::TaskScoped {
+                    identity: id,
+                    task_id: actual,
+                    scopes: granted,
+                    ..
+                },
+            ) => id.as_str() == identity.as_str() && task_id == actual && includes(scopes, granted),
+            (
+                Self::UserAuthorized { user_id, scopes },
+                IdentityAssurance::UserAuthorized {
+                    identity: id,
+                    user_id: actual,
+                    scopes: granted,
+                },
+            ) => id.as_str() == identity.as_str() && user_id == actual && includes(scopes, granted),
+            _ => false,
+        }
+    }
+}
+
+pub(super) struct PendingStepUp {
+    pub(super) held: HeldRequest,
+    challenge: Envelope,
+    requirement: AssuranceRequirement,
+    generation: u64,
+    methods: Vec<String>,
+}
+
+impl CanonicalPeer {
+    pub(super) async fn control(
+        &mut self,
+        bytes: &[u8],
+        envelope: &Envelope,
+        handler: &dyn AuthenticatedHandler,
+        deadline: Instant,
+    ) -> Result<PeerOutput, DispatchError> {
+        let State::Authenticated(binding) = &self.state else {
+            return Err(DispatchError::Authentication);
+        };
+        let authorized = binding.dispatch.preflight(bytes, deadline).await?;
+        let requirement = if envelope.scope(Scope::Reply).is_none() {
+            self.config.authority.assurance_requirement(
+                &binding.credential,
+                &binding.device,
+                &binding.identity,
+                envelope,
+            )?
+        } else {
+            None
+        };
+        if let Some(requirement) = requirement {
+            requirement.validate()?;
+            if !requirement.meets(&binding.credential.principal, &binding.identity) {
+                if binding.step_up.is_some() {
+                    return Err(DispatchError::Capacity);
+                }
+                let methods: Vec<String> = self
+                    .config
+                    .methods
+                    .advertised()
+                    .into_iter()
+                    .map(str::to_owned)
+                    .collect();
+                if methods.is_empty() {
+                    return Err(DispatchError::UnsupportedMethod);
+                }
+                let challenge = self.reply("identity.step-up-request",json!({"required":requirement.label(),"allowed_methods":methods,"reason":"resource_assurance_required"}),Some(envelope))?;
