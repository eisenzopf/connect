+    let hh = h.clone();
+    let server = tokio::spawn(async move {
+        let (tx, rx) = host.accept_bi().await.unwrap();
+        peer.run(rx, tx, hh.as_ref()).await
+    });
+    let (tx, rx) = remote.open_bi().await.unwrap();
+    let mut writer = FramedWrite::new(tx, rvoip_uctp::substrate::length_prefixed_codec());
+    let mut reader = FramedRead::new(rx, rvoip_uctp::substrate::length_prefixed_codec());
+    writer
+        .send(Bytes::from(serde_json::to_vec(&hello()).unwrap()))
+        .await
+        .unwrap();
+    let challenge = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    writer
+        .send(Bytes::from(f.sign(response(&challenge, "old"))))
+        .await
+        .unwrap();
+    assert_eq!(
+        Envelope::parse(&reader.next().await.unwrap().unwrap())
+            .unwrap()
+            .kind(),
+        "auth.session"
+    );
+    let request = command();
+    let wire = f.sign(request.clone());
+    writer.send(Bytes::from(wire.clone())).await.unwrap();
+    let challenge = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    assert_eq!(challenge.kind(), "identity.step-up-request");
+    assert_eq!(challenge.scope(Scope::Reply), request["id"].as_str());
+    assert_eq!(h.calls.load(Ordering::SeqCst), 0);
+    writer
+        .send(Bytes::from(f.sign(proof(&challenge, "user"))))
+        .await
+        .unwrap();
+    for kind in ["auth.session", "identity.assurance-changed", "ack"] {
+        let envelope = Envelope::parse(
+            &tokio::time::timeout(Duration::from_secs(3), reader.next())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap(),
+        )
+        .unwrap();
+        assert_eq!(envelope.kind(), kind);
+        assert_eq!(envelope.scope(Scope::Operation), Some("logical-op"));
+        f.verify_server(&envelope).await;
+        if kind == "ack" {
+            assert_eq!(envelope.scope(Scope::Reply), request["id"].as_str());
+        }
+    }
+    writer.send(Bytes::from(wire)).await.unwrap();
+    let problem = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    assert_eq!(problem.original()["payload"]["reason"], "envelope_replay");
+    assert_eq!(h.calls.load(Ordering::SeqCst), 1);
+    writer.close().await.unwrap();
+    assert!(tokio::time::timeout(Duration::from_secs(3), server)
+        .await
+        .unwrap()
+        .unwrap()
+        .is_ok());
+    assert!(lifetime.is_cancelled());
+}
