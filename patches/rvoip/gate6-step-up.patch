+struct RevisionHandler {
+    revision: AtomicUsize,
+    effects: AtomicUsize,
+}
+#[async_trait]
+impl AuthenticatedHandler for RevisionHandler {
+    async fn handle(&self, env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        assert_eq!(env.envelope().expected_revision(), Some(1));
+        if env.envelope().expected_revision() != Some(self.revision.load(Ordering::SeqCst) as u64) {
+            return Envelope::from_value(envelope(
+                "error",
+                json!({"code":409,"category":"conflict","reason":"revision_changed"}),
+            ))
+            .map_err(DispatchError::from);
+        }
+        self.effects.fetch_add(1, Ordering::SeqCst);
+        Envelope::from_value(envelope("ack", json!({}))).map_err(DispatchError::from)
+    }
+}
