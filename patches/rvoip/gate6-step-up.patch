+                let lease = authorized.retain_authority();
+                let held = HeldRequest::seal(authorized)?;
+                let pending = PendingStepUp {
+                    held,
+                    challenge: challenge.clone(),
+                    requirement,
+                    generation: binding.generation,
+                    methods,
+                };
+                let State::Authenticated(binding) = &mut self.state else {
+                    return Err(DispatchError::Closed);
+                };
+                binding.step_up = Some(pending);
+                return Ok(output(vec![challenge], Some(lease)));
+            }
+        }
+        match binding
+            .dispatch
+            .dispatch_authorized(authorized, handler, deadline)
+            .await?
+        {
+            DispatchOutcome::ReplyDelivered => Ok(output(Vec::new(), None)),
+            DispatchOutcome::Handled(reply) => {
+                let lease = self
+                    .config
+                    .authority
+                    .acquire(
+                        &binding.credential,
+                        &binding.device,
+                        &binding.identity,
+                        envelope,
+                    )
+                    .await?;
+                let reply = self.handler_reply(reply, envelope)?;
+                Ok(output(vec![reply], Some(lease)))
+            }
+        }
+    }
