+        }
+        // Unauthenticated/wrong-scope traffic cannot consume the pending proof.
+        drop(
+            self.config
+                .authority
+                .acquire(
+                    &binding.credential,
+                    &binding.device,
+                    &binding.identity,
+                    &response,
+                )
+                .await?,
+        );
+        self.verify(&binding.credential.principal, &response)
+            .await?;
+        let State::Authenticated(binding) = &mut self.state else {
+            return Err(DispatchError::Closed);
+        };
+        // Matching authenticated completion gets one validation attempt. Any
+        // failure or cancellation below discards the hold without executing it.
+        let pending = binding.step_up.take().ok_or(DispatchError::ReplyMismatch)?;
+        if !pending.methods.contains(&payload.method) {
+            return Err(DispatchError::UnsupportedMethod);
+        }
+        let State::Authenticated(binding) = &self.state else {
+            return Err(DispatchError::Closed);
+        };
+        let deadline = deadline.min(pending.held.deadline());
+        let credential = Arc::new(
+            self.config
+                .methods
+                .authenticate_credential(&payload.method, &payload.credential, None, deadline)
+                .await?,
+        );
+        if !binding
+            .credential
+            .principal
+            .has_same_owner(&credential.principal)
+            || !pending
+                .requirement
+                .meets(&credential.principal, &binding.identity)
+        {
+            return Err(DispatchError::Authentication);
+        }
+        let identity = self
+            .config
+            .authority
+            .identity(&credential, &binding.device)
+            .await?;
+        if identity != binding.identity {
+            return Err(DispatchError::Authentication);
+        }
+        let blocked = pending.held.envelope().clone();
+        let lease = self
+            .config
+            .authority
+            .step_up(
+                &binding.credential,
+                &credential,
+                &binding.device,
+                &identity,
+                &pending.requirement,
+                &blocked,
+                &response,
+            )
+            .await?;
+        // Check the current requirement under the transition guard, after all
+        // async validation. A stale policy plan cannot authorize the hold.
+        if self
+            .config
+            .authority
+            .assurance_requirement(&credential, &binding.device, &identity, &blocked)?
+            .as_ref()
+            != Some(&pending.requirement)
+        {
+            return Err(DispatchError::Authority);
+        }
+        let next = self.binding(
+            credential,
+            binding.device.clone(),
+            identity,
+            binding
+                .generation
+                .checked_add(1)
+                .ok_or(DispatchError::Capacity)?,
+        )?;
+        let reply = next
+            .dispatch
+            .execute_held(
+                pending.held,
+                &binding.dispatch,
+                lease.retained(),
+                handler,
+                deadline,
+            )
+            .await?;
+        let session = self.session(&next, &response)?;
+        let changed = self.reply("identity.assurance-changed",json!({"previous":binding.credential.principal.assurance.kind(),"current":next.credential.principal.assurance.kind(),"reason":"verified-step-up"}),Some(&response))?;
+        let reply = self.handler_reply(reply, &blocked)?;
+        self.state = State::Authenticated(next);
+        Ok(output(vec![session, changed, reply], Some(lease)))
+    }
+
+    pub(super) fn pending_step_up_deadline(&self) -> Option<Instant> {
+        match &self.state {
+            State::Authenticated(binding) => binding
+                .step_up
+                .as_ref()
+                .map(|pending| pending.held.deadline()),
+            _ => None,
+        }
+    }
+    pub(super) fn discard_expired_step_up(&mut self) {
+        if let State::Authenticated(binding) = &mut self.state {
+            if binding
+                .step_up
+                .as_ref()
+                .is_some_and(|pending| !pending.held.live())
+            {
+                binding.step_up = None;
+            }
+        }
+    }
+    pub(super) fn expire_step_up(&mut self) -> Result<Option<PeerOutput>, DispatchError> {
+        let pending = match &mut self.state {
+            State::Authenticated(binding)
+                if binding
+                    .step_up
+                    .as_ref()
+                    .is_some_and(|pending| !pending.held.live()) =>
+            {
+                binding.step_up.take()
+            }
+            _ => None,
+        };
+        pending
+            .map(|pending| {
+                self.reply(
+                    "error",
+                    json!({"code":403,"category":"auth","reason":"step_up_expired"}),
+                    Some(pending.held.envelope()),
+                )
+                .map(|reply| output(vec![reply], None))
+            })
+            .transpose()
+    }
+}
