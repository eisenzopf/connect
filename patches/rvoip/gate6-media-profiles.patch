+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_signed_reliable_text_json_and_binary_profiles_validate_decode_and_recover_on_all_native_wires(
+) {
+    for kind in ["quic", "wt", "ws"] {
+        for protocol in [DataProtocol::Text, DataProtocol::Json, DataProtocol::Binary] {
+            let mut scene = DataScene::with_protocol(kind, false, None, protocol.clone()).await;
+            scene.select(0, 1).await;
+            assert_eq!(
+                scene.live[0].controller.active_bindings()[0]
+                    .negotiated
+                    .format,
+                MediaFormat::ReliableOrdered(protocol.clone())
+            );
+            let (body, encoding) = match protocol {
+                DataProtocol::Text => ("text ☃ \u{1f642}".to_string(), "utf8"),
+                DataProtocol::Json => (
+                    serde_json::to_string(&json!({"text":"snow ☃","items":[1,true,null]})).unwrap(),
+                    "utf8",
+                ),
+                DataProtocol::Binary => (
+                    base64::Engine::encode(
+                        &base64::engine::general_purpose::STANDARD,
+                        [0, 255, 128, 17],
+                    ),
+                    "base64",
+                ),
+            };
+            let request = scene.request(0, 0, body.clone(), encoding);
+            assert_eq!(scene.publish(0, request).await.kind(), "ack");
+            scene.receive(1, 0, 0, &body, encoding).await;
+            if protocol != DataProtocol::Binary {
+                let (bad, encoding) = if protocol == DataProtocol::Json {
+                    ("{broken".to_string(), "utf8")
+                } else {
+                    (
+                        base64::Engine::encode(
+                            &base64::engine::general_purpose::STANDARD,
+                            [255, 254],
+                        ),
+                        "base64",
+                    )
+                };
+                let request = scene.request(0, 1, bad, encoding);
+                assert_eq!(scene.publish(0, request).await.kind(), "error");
+                assert!(
+                    tokio::time::timeout(
+                        Duration::from_millis(70),
+                        scene.live[1].wire.reader.next()
+                    )
+                    .await
+                    .is_err(),
+                    "invalid codec data escaped to the recipient"
+                );
+                let request = scene.request(0, 2, body.clone(), "utf8");
+                assert_eq!(scene.publish(0, request).await.kind(), "ack");
+                scene.receive(1, 0, 2, &body, "utf8").await;
+            }
+            assert!(
+                scene.policy.0.try_write().is_ok(),
+                "no idle data permission reader"
+            );
+            scene.stop().await;
+        }
+    }
+}
