+#[tokio::test]
+async fn original_private_video_binding_outlives_capture_but_not_its_original_lifetime() {
+    let mut f = Preroll::new().await;
+    let old = f.movement.room.nodes["alice"].controller.clone();
+    let target = f.movement.room.nodes["device"].controller.clone();
+    let began = tokio::time::Instant::now();
+    let capture_deadline = began + Duration::from_millis(100);
+    let original_deadline = began + Duration::from_millis(500);
+    let cancellation = CancellationToken::new();
+    let lifetime =
+        PrivateVideoBindingLifetime::for_test(&target, original_deadline, cancellation.clone());
+    let grant = captured_video_control(&f, capture_deadline).await;
+    let prepared = match target
+        .prepare_replacement_video(&old, &request(), &lifetime, original_deadline, &grant)
+        .unwrap()
+    {
+        VideoReplacementPreparationAttempt::Prepared(value) => value,
+        _ => panic!("uncontended original metadata"),
+    };
+    tokio::time::sleep_until(capture_deadline + Duration::from_millis(20)).await;
+    assert!(tokio::time::Instant::now() < original_deadline);
+    assert!(
+        matches!(
+            target.prepare_replacement_video(
+                &old,
+                &request(),
+                &lifetime,
+                original_deadline,
+                &grant
+            ),
+            Err(StreamControlError::Deadline)
+        ),
+        "an expired synchronous capture must not authorize a new installation"
+    );
+    drop(grant); // No original authorization guard survives into later packets.
+    assert!(
+        prepared.is_current(),
+        "structural intent incorrectly retained the expired capture deadline"
+    );
+    f.publish_video("bob", 240);
+    delivered(&mut f.old_output, 240).await;
+    delivered(&mut f.target_output, 240).await;
+    f.assert_target_quarantined();
+    tokio::time::sleep_until(original_deadline + Duration::from_millis(10)).await;
+    assert!(!prepared.is_current());
+    f.publish_video("bob", 241);
+    delivered(&mut f.old_output, 241).await;
+    assert!(
+        f.target_output.try_recv().is_err(),
+        "original route lifetime was renewed by fresh packet authority"
+    );
+    prepared.close();
+    assert!(!cancellation.is_cancelled());
+}
