+#[tokio::test]
+async fn original_private_video_binding_requires_fresh_source_authority_and_original_cancellation()
+{
+    for boundary in ["source-revoked", "root-cancelled"] {
+        let mut f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let capture_deadline = tokio::time::Instant::now() + Duration::from_millis(100);
+        let original_deadline = capture_deadline + Duration::from_millis(600);
+        let cancellation = CancellationToken::new();
+        let lifetime =
+            PrivateVideoBindingLifetime::for_test(&target, original_deadline, cancellation.clone());
+        let grant = captured_video_control(&f, capture_deadline).await;
+        let prepared = match target
+            .prepare_replacement_video(&old, &request(), &lifetime, original_deadline, &grant)
+            .unwrap()
+        {
+            VideoReplacementPreparationAttempt::Prepared(value) => value,
+            _ => panic!("uncontended original metadata"),
+        };
+        drop(grant);
+        tokio::time::sleep_until(capture_deadline + Duration::from_millis(20)).await;
+        assert!(prepared.is_current());
+        f.publish_video("bob", 242);
+        delivered(&mut f.old_output, 242).await;
+        delivered(&mut f.target_output, 242).await;
+        if boundary == "source-revoked" {
+            f.movement
+                .room
+                .domain
+                .base
+                .0
+                .write()
+                .await
+                .revoked
+                .insert("bob".into());
+        } else {
+            cancellation.cancel();
+            assert!(!prepared.is_current());
+        }
+        f.publish_video("bob", 243);
+        if boundary == "root-cancelled" {
+            delivered(&mut f.old_output, 243).await;
+        }
+        assert!(
+            f.target_output.try_recv().is_err(),
+            "private route cached expired or revoked packet authority"
+        );
+        f.assert_target_quarantined();
+        prepared.close();
+    }
+}
