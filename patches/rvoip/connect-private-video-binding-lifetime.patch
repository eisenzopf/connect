+async fn captured_video_control(f: &Preroll, capture_deadline: tokio::time::Instant) -> Arc<Grant> {
+    let old = &f.movement.room.nodes["alice"].controller;
+    let target = &f.movement.room.nodes["device"].controller;
+    Arc::new(Grant {
+        domain: f.movement.room.domain.clone(),
+        guard: Arc::new(f.movement.room.domain.base.0.clone().read_owned().await),
+        approval: Approval::PrepareVideo {
+            source: old.connection.clone(),
+            connection: target.connection.clone(),
+            expected: target.revision(),
+            request: request(),
+        },
+        control_deadline: Some(capture_deadline),
+        control_owner_delay: None,
+    })
+}
