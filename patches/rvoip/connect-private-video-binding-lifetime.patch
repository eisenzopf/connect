+/// Lifetime of structural private route intent, minted only from the exact
+/// owned Core preparation. It contains no MediaControl or authorization read.
+/// Every queued packet still requires its own current policy admission.
+pub(crate) struct PrivateVideoBindingLifetime {
+    target: Weak<crate::staged_streams::StreamController>,
+    deadline: tokio::time::Instant,
+    cancellation: CancellationToken,
+}
+impl PrivateVideoBindingLifetime {
+    fn from_preparation(
+        prepared: &DeviceReplacementPreparation,
+        target: &Arc<crate::staged_streams::StreamController>,
+    ) -> Self {
+        Self {
+            target: Arc::downgrade(target),
+            deadline: prepared.deadline,
+            cancellation: prepared.cancellation.clone(),
+        }
+    }
+    pub(crate) fn metadata_for(
+        &self,
+        target: &Arc<crate::staged_streams::StreamController>,
+    ) -> std::result::Result<(tokio::time::Instant, CancellationToken), StreamControlError> {
+        if self
+            .target
+            .upgrade()
+            .is_none_or(|original| !Arc::ptr_eq(&original, target))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok((self.deadline, self.cancellation.child_token()))
+    }
+    // Trusted Core unit fixture only; no production caller can supply a new
+    // arbitrary lifetime instead of its original owned preparation.
+    #[cfg(test)]
+    pub(crate) fn for_test(
+        target: &Arc<crate::staged_streams::StreamController>,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> Self {
+        Self {
+            target: Arc::downgrade(target),
+            deadline,
+            cancellation,
+        }
+    }
 }
