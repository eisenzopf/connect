+#[tokio::test]
+async fn original_private_video_lifetime_never_extends_busy_retry_or_expired_capture_authority() {
+    let f = Preroll::new().await;
+    let old = f.movement.room.nodes["alice"].controller.clone();
+    let target = f.movement.room.nodes["device"].controller.clone();
+    let capture_deadline = tokio::time::Instant::now() + Duration::from_millis(100);
+    let original_deadline = capture_deadline + Duration::from_millis(400);
+    let cancellation = CancellationToken::new();
+    let lifetime =
+        PrivateVideoBindingLifetime::for_test(&target, original_deadline, cancellation.clone());
+    let grant = captured_video_control(&f, capture_deadline).await;
+    let foreign =
+        PrivateVideoBindingLifetime::for_test(&old, original_deadline, cancellation.clone());
+    assert!(
+        matches!(
+            target.prepare_replacement_video(&old, &request(), &foreign, original_deadline, &grant),
+            Err(StreamControlError::Authority)
+        ),
+        "another physical controller cannot lend its structural lifetime"
+    );
+    let outer_deadline = capture_deadline - Duration::from_millis(50);
+    let held = old.state.lock().unwrap();
+    match target
+        .prepare_replacement_video(&old, &request(), &lifetime, outer_deadline, &grant)
+        .unwrap()
+    {
+        VideoReplacementPreparationAttempt::MetadataBusy { deadline } => {
+            assert!(deadline <= outer_deadline && deadline < capture_deadline)
+        }
+        _ => panic!("busy pre-effect metadata was not classified"),
+    }
+    assert_eq!(
+        target.direct_subscriptions.private_route_count_for_test(),
+        0
+    );
+    drop(held);
+    tokio::time::sleep_until(outer_deadline + Duration::from_millis(5)).await;
+    assert!(
+        tokio::time::Instant::now() < capture_deadline,
+        "test must isolate the earlier outer capture"
+    );
+    assert!(
+        matches!(
+            target.prepare_replacement_video(&old, &request(), &lifetime, outer_deadline, &grant),
+            Err(StreamControlError::Cancelled)
+        ),
+        "a still-current inner media control cannot extend the original outer installation deadline"
+    );
+    assert_eq!(
+        target.direct_subscriptions.private_route_count_for_test(),
+        0
+    );
+    // Even an otherwise later outer bound cannot revive the expired original
+    // inner capture below. Neither boundary changes the structural lifetime.
+    tokio::time::sleep_until(capture_deadline + Duration::from_millis(20)).await;
+    assert!(tokio::time::Instant::now() < original_deadline);
+    assert!(matches!(
+        target.prepare_replacement_video(&old, &request(), &lifetime, original_deadline, &grant),
+        Err(StreamControlError::Deadline)
+    ));
+    assert_eq!(
+        target.direct_subscriptions.private_route_count_for_test(),
+        0
+    );
+    assert!(!cancellation.is_cancelled());
+    drop(grant);
+
+    // The outer capture is current at entry but expires while the original
+    // policy performs its real second owner read. Inner control and root remain
+    // current, so only the final installation cutoff prevents publication.
+    let began = tokio::time::Instant::now();
+    let outer_deadline = began + Duration::from_millis(50);
+    let inner_deadline = began + Duration::from_millis(500);
+    let original_deadline = began + Duration::from_secs(1);
+    let calls = Arc::new(AtomicUsize::new(0));
+    let delayed_grant = Arc::new(Grant {
+        domain: f.movement.room.domain.clone(),
+        guard: Arc::new(f.movement.room.domain.base.0.clone().read_owned().await),
+        approval: Approval::PrepareVideo {
+            source: old.connection.clone(),
+            connection: target.connection.clone(),
+            expected: target.revision(),
+            request: request(),
+        },
+        control_deadline: Some(inner_deadline),
+        control_owner_delay: Some((calls.clone(), outer_deadline + Duration::from_millis(5))),
+    });
+    let lifetime =
+        PrivateVideoBindingLifetime::for_test(&target, original_deadline, cancellation.clone());
+    assert!(
+        matches!(
+            target.prepare_replacement_video(
+                &old,
+                &request(),
+                &lifetime,
+                outer_deadline,
+                &delayed_grant
+            ),
+            Err(StreamControlError::NotReady)
+        ),
+        "an expired outer capture must not publish routes after the original owner read"
+    );
+    assert!(
+        calls.load(Ordering::SeqCst) >= 2,
+        "the original policy must reach its preparation owner read"
+    );
+    assert!(
+        tokio::time::Instant::now() < inner_deadline,
+        "the synthetic inner capture must remain current"
+    );
+    assert_eq!(
+        target.direct_subscriptions.private_route_count_for_test(),
+        0
+    );
+    assert!(!cancellation.is_cancelled());
+}
