+#[tokio::test]
+async fn private_video_poisoned_metadata_and_invalid_mapping_are_terminal_before_routes() {
+    for refusal in ["poisoned", "invalid-mapping", "expired"] {
+        let f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let mut mapping = request();
+        if refusal == "invalid-mapping" {
+            mapping.receivers.push(mapping.receivers[0].clone());
+        }
+        let grant = f
+            .movement
+            .room
+            .grant(Approval::PrepareVideo {
+                source: old.connection.clone(),
+                connection: target.connection.clone(),
+                expected: target.revision(),
+                request: mapping.clone(),
+            })
+            .await;
+        if refusal == "poisoned" {
+            let original = old.clone();
+            assert!(
+                std::thread::spawn(move || {
+                    let _held = original.state.lock().unwrap();
+                    panic!("controlled metadata poison");
+                })
+                .join()
+                .is_err()
+            );
+        }
+        let cutoff = if refusal == "expired" {
+            tokio::time::Instant::now()
+        } else {
+            deadline()
+        };
+        let result = target.prepare_replacement_video(
+            &old,
+            &mapping,
+            cutoff,
+            CancellationToken::new(),
+            &grant,
+        );
+        assert!(result.is_err(), "semantic failure became a retry outcome");
+        assert!(
+            target
+                .direct_subscriptions
+                .routing
+                .lock()
+                .unwrap()
+                .preparation
+                .is_empty()
+        );
+        assert!(!target.shutdown.is_cancelled());
+    }
