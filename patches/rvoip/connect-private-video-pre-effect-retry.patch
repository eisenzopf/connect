+                    .write()
+                    .await
+                    .revoked
+                    .insert("alice".into());
+            }
+            "revision" => {
+                let media = target
+                    .active_bindings()
+                    .into_iter()
+                    .map(|binding| binding.negotiated.requested)
+                    .collect::<Vec<_>>();
+                target
+                    .change(
+                        revision,
+                        &media,
+                        &BTreeSet::from([request().receivers[0].replacement.clone()]),
+                        cutoff,
+                        CancellationToken::new(),
+                    )
+                    .await
+                    .unwrap();
+            }
+            _ => unreachable!(),
+        }
+        let grant = f.movement.room.grant(approval()).await;
+        let result = target.prepare_replacement_video(
+            &old,
+            &request(),
+            cutoff,
+            cancellation.clone(),
+            &grant,
+        );
+        assert!(matches!(
+            result,
+            Err(StreamControlError::Cancelled | StreamControlError::Authority)
+        ));
+        assert!(
+            target
+                .direct_subscriptions
+                .routing
+                .lock()
+                .unwrap()
+                .preparation
+                .is_empty()
+        );
+        assert!(f.target_output.try_recv().is_err());
+        assert!(!old.shutdown.is_cancelled());
+    }
+}
