+#[test]
+fn tenant_role_viewer_keeps_private_source_policy_and_tenant_scope_explicit() {
+    let (record, _, _, _) = fixture();
+    let scope = scope();
+    let viewer = RecordViewer::TenantRole {
+        identity: crate::ids::IdentityId::from_string("identity_auditor"),
+        tenant: scope.tenant_id().clone(),
+        role: "auditor".into(),
+        revision: 1,
+        private_sources: false,
+    };
+    let private = record
+        .manifest()
+        .sources()
+        .iter()
+        .find(|s| matches!(&s.audience, RecordAudience::Participants(_)))
+        .unwrap();
+    assert!(!private.admits(&viewer));
+    let RecordViewer::TenantRole {
+        identity,
+        tenant,
+        role,
+        revision,
+        ..
+    } = viewer.clone()
+    else {
+        unreachable!()
+    };
+    let full = RecordViewer::TenantRole {
+        identity,
+        tenant,
+        role,
+        revision,
+        private_sources: true,
+    };
+    assert!(private.admits(&full));
+    let request = |viewer| {
+        RecordViewRequest::new(
+            scope.clone(),
+            viewer,
+            record.uuid(),
+            1,
+            crate::store::vcon_store::stored_content_hash(record.body()),
+            record.manifest_hash().unwrap(),
+            "role-view".into(),
+        )
+    };
+    assert!(request(viewer).is_ok());
+    let RecordViewer::TenantRole {
+        identity,
+        role,
+        revision,
+        private_sources,
+        ..
+    } = full
+    else {
+        unreachable!()
+    };
+    assert!(request(RecordViewer::TenantRole {
+        identity,
+        tenant: crate::ids::TenantId::from_string("other_tenant"),
+        role,
+        revision,
+        private_sources
+    })
+    .is_err());
+}
