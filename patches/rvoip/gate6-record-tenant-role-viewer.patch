+/// The current host-authorized reader. A tenant role is never a Participant
+/// appearance, and this value alone grants no source access: the current lease
+/// must independently select every permitted source.
+#[derive(Clone, Eq, PartialEq)]
+pub enum RecordViewer {
+    Participant {
+        participant: ParticipantId,
+        membership_epoch: u64,
+    },
+    TenantRole {
+        identity: IdentityId,
+        tenant: TenantId,
+        role: String,
+        revision: u64,
+        private_sources: bool,
+    },
+}
+impl RecordViewer {
+    fn valid_for(&self, scope: &crate::store::VconScope) -> bool {
+        match self {
+            Self::Participant {
+                participant,
+                membership_epoch,
+            } => {
+                id(participant.as_str())
+                    && *membership_epoch > 0
+                    && *membership_epoch <= crate::store::vcon_store::MAX_VCON_REVISION
+            }
+            Self::TenantRole {
+                identity,
+                tenant,
+                role,
+                revision,
+                ..
+            } => {
+                id(identity.as_str())
+                    && id(tenant.as_str())
+                    && tenant == scope.tenant_id()
+                    && id(role)
+                    && role.len() <= 64
+                    && *revision > 0
+                    && *revision <= crate::store::vcon_store::MAX_VCON_REVISION
+            }
+        }
+    }
+}
+impl fmt::Debug for RecordViewer {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("RecordViewer([redacted])")
+    }
+}
 
