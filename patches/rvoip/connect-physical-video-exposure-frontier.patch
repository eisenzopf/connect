+//! Real original Core enqueue/current admission -> actual Producer callback.
+//! Fake borrowed IO observes pre-IO metadata; no UDP/delivery claim.
+use super::*;
+use rvoip_core::staged_streams::{
+    frame_realm::FrameRealmTestOwner,
+    physical_video_exposure::{PhysicalVideoExposure, PhysicalVideoExposureCoverage},
+};
+use rtc::media_stream::{MediaStreamId,MediaStreamTrack};
+use rtc::rtp_transceiver::rtp_sender::{RTCRtpCodec,RTCRtpCodingParameters,RTCRtpEncodingParameters,RtpCodecKind};
+
+fn track(ssrc:u32) -> Arc<TrackLocalStaticRTP> {
+    Arc::new(TrackLocalStaticRTP::new(MediaStreamTrack::new(
+        MediaStreamId::from("exposure-stream"), "exposure-track".into(), "video".into(),
+        RtpCodecKind::Video,
+        vec![RTCRtpEncodingParameters {
+            rtp_coding_parameters: RTCRtpCodingParameters {ssrc:Some(ssrc),..Default::default()},
+            codec:RTCRtpCodec {mime_type:"video/VP8".into(),clock_rate:90000,channels:0,..Default::default()},
+            ..Default::default()
+        }],
+    )))
+}
+#[tokio::test]
+async fn physical_video_family_survives_actual_track_clone_and_rejects_wrong_ssrc() {
+    let track=track(77);
+    let first=track.owned_rtp_timeline::<PhysicalVideoFamily>(77).await.unwrap();
+    let clone=track.as_ref().clone();
+    let rebound=clone.owned_rtp_timeline::<PhysicalVideoFamily>(77).await.unwrap();
+    assert!(Arc::ptr_eq(&first,&rebound));
+    assert!(Arc::ptr_eq(&first.timeline,&rebound.timeline));
+    assert!(Arc::ptr_eq(&first.exposure,&rebound.exposure));
+    assert!(clone.owned_rtp_timeline::<PhysicalVideoFamily>(78).await.is_err());
+    assert!(clone.owned_rtp_timeline::<AsyncMutex<Timeline>>(77).await.is_err());
+    // A weak Port observer alone does not root family, track or sequence state.
+    let observer=first.exposure.observer();
+    drop(first);drop(rebound);drop(clone);drop(track);
+    assert!(observer.snapshot().is_none());
+}
+struct ObserveIo {
+    family:Arc<PhysicalVideoExposure>,
+    ordinal:u64,
+    complete:bool,
+    mode:u8,
+    attempted:bool,
+    written:bool,
+    calls:usize,
+    control:OwnedRtpControl,
+}
+#[async_trait::async_trait]
+impl OwnedRtpIo for ObserveIo {
+    async fn write(&mut self,_:rtp::Packet)->rtc::shared::error::Result<()> { panic!("clocked original operation required") }
+    fn written(&self)->bool {self.written}
+    fn attempted(&self)->bool {self.attempted}
+    fn submission_control(&self)->OwnedRtpControl {self.control.clone()}
+    async fn write_with_clock(&mut self,_:rtp::Packet,_:SenderClockHandle,_:Option<SenderClockUpdate>)->rtc::shared::error::Result<()> {
+        let snapshot=self.family.observer().snapshot().unwrap();
+        assert_eq!(snapshot.coverage_complete,self.complete);
+        assert_eq!(snapshot.maximum_potential_ordinal,self.ordinal,"potential maximum must precede actual IO callback entry");
+        self.calls+=1;self.attempted=true;
+        match self.mode {
+            0=>{self.written=true;Ok(())},
+            1=>Err(rtc::shared::error::Error::ErrRTPTransceiverCodecUnsupported),
+            _=>std::future::pending().await,
+        }
+    }
+}
+#[tokio::test]
+async fn physical_video_actual_primary_and_repair_track_before_success_error_or_cancelled_io() {
+    use futures::FutureExt as _;
+    for mode in 0..5u8 {
+        let mut f=Fixture::new(Medium::Video).await;
+        let work=std::panic::AssertUnwindSafe(async {
+            let realm=FrameRealmTestOwner::new(ConversationId::from_string("conversation"),SessionId::from_string("session"));
+            let handle=realm.handle();
+            let source_ssrc=77;let sequence=100u16;let timestamp=300000;
+            let other=FrameRealmTestOwner::new(ConversationId::from_string("conversation"),SessionId::from_string("session"));
+            let other_handle=other.handle();
+            let point=OriginalVideoFrame::observed_in_realm(19,source_ssrc,timestamp,timestamp as u64,if mode==3 {None} else if mode==4 {Some(&other_handle)} else {Some(&handle)});
+            let ordinal=if mode>=3 {0} else {point.frame_realm().unwrap().ordinal()};
+            let track=track(88);
+            let mut output=CoreVideoEgress::bind(&f.target,track,88,96,SenderClockHandle::default(),deadline().into_std()).await.unwrap();
+            // Isolated trusted setup stands in for canonical peer creation,
+            // not a forged public capability or a shipping ownership claim.
+            output.exposure.bind_coverage(Arc::new(PhysicalVideoExposureCoverage::new(false)));
+            output.exposure.configure_expected_realm(handle.incarnation());
+            let packet=rtp::Packet {header:rtp::Header {version:2,ssrc:source_ssrc,sequence_number:sequence,timestamp,marker:true,payload_type:96,..Default::default()},payload:vec![0x10,0,1,2].into()};
+            let frame=MediaFrame {stream_id:f.source.binding().transport_id.clone(),kind:StreamKind::Video,payload:packet.marshal().unwrap().freeze(),timestamp_rtp:timestamp,captured_at:Utc::now(),payload_type:Some(96),source_clock:None};
+            let mut original=f.source.retain_original_video_ingress(frame,Instant::now(),Some(point)).unwrap().unwrap();
+            original.try_publish_clocked(|_|None).unwrap();
+            tokio::time::timeout_at(deadline(),f.input.recv()).await.unwrap().unwrap().try_forward_to(&f.b,&desired(Medium::Video).logical_id).unwrap();
+            let queued=output.output.recv().await.unwrap();
+            let producer=Producer {
+                original:Mutex::new(Some((queued,output.timeline.clone().lock_owned().await))),
+                exposure:output.exposure.clone(),retained:Mutex::new(None),
+                ssrc:output.ssrc,payload_type:output.payload_type,clock:output.clock.clone(),
+                mid:None,pictures:output.pictures.clone(),mapping_target:None,
+            };
+            let mut io=ObserveIo {family:output.exposure.clone(),ordinal,complete:mode<3,mode:if mode>=3 {0} else {mode},attempted:false,written:false,calls:0,control:OwnedRtpControl::new(deadline().into_std())};
+            if mode==2 {
+                assert!(tokio::time::timeout(Duration::from_millis(5),producer.write(&mut io)).await.is_err());
+                assert!(io.attempted&&!io.written);
+            } else {
+                let actual=producer.write(&mut io).await;
+                assert_eq!(actual,OwnedRtpAttempt::Complete(if mode==0 || mode>=3 {Ok(())} else {Err(OwnedRtpError::Refused)}));
+                if mode==0 || mode>=3 {
+                    assert!(producer.repair(&mut io).await.is_ok());
+                    assert_eq!(io.calls,2,"same original successful repair executes once");
+                } else {assert_eq!(io.calls,1);}
+            }
+            let snapshot=f.target.physical_video_exposure().unwrap();
+            assert_eq!(snapshot.coverage_complete,mode<3);
+            assert_eq!(snapshot.maximum_potential_ordinal,ordinal);
+            drop(producer);drop(output);
+            io.calls
+        }).catch_unwind().await;
+        let clean=f.close().await;
+        assert!(clean,"both original Core controllers/adapter cleanup must complete");
+        if let Err(error)=work {std::panic::resume_unwind(error)}
+    }
+}
