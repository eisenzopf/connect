+//! Optional historical potential-IO metadata. Not a gate, readiness result,
+//! source-exclusion certificate or future no-escape capability.
+use super::SourceFrameRealmPoint;
+use std::sync::{Arc, OnceLock, Weak, atomic::{AtomicBool, AtomicU64, Ordering}};
+
+/// One peer-wide sticky coverage root, installed at original canonical creation.
+/// A public escaping capability marks this BEFORE returning the original handle.
+/// No method here denies, delays or changes ordinary IO.
+pub struct PhysicalVideoExposureCoverage { escaped: AtomicBool }
+impl PhysicalVideoExposureCoverage {
+    pub fn new(already_exposed: bool) -> Self { Self { escaped: AtomicBool::new(already_exposed) } }
+    pub fn mark_escaped(&self) { self.escaped.store(true, Ordering::Release); }
+    pub fn escaped(&self) -> bool { self.escaped.load(Ordering::Acquire) }
+}
+
+/// Strong lifetime belongs to SAME actual physical Track+SSRC family, not Port.
+/// It owns no policy, runtime, peer, track, timeline, or parent history.
+pub struct PhysicalVideoExposure {
+    identity: u128,
+    expected: OnceLock<u128>,
+    coverage: OnceLock<Arc<PhysicalVideoExposureCoverage>>,
+    attempted: AtomicBool,
+    untracked: AtomicBool,
+    maximum: AtomicU64,
+}
+impl Default for PhysicalVideoExposure {
+    fn default() -> Self {
+        Self { identity: uuid::Uuid::new_v4().as_u128(), expected: OnceLock::new(),
+            coverage: OnceLock::new(), attempted: AtomicBool::new(false),
+            untracked: AtomicBool::new(false), maximum: AtomicU64::new(0) }
+    }
+}
+impl PhysicalVideoExposure {
+    pub fn observer(self: &Arc<Self>) -> PhysicalVideoExposureObserver {
+        PhysicalVideoExposureObserver(Arc::downgrade(self))
+    }
+    pub fn mark_untracked(&self) {
+        if !self.untracked.load(Ordering::Relaxed) { self.untracked.store(true, Ordering::Release); }
+    }
+    /// Freeze TARGET's original setup realm, never first-source adoption.
+    /// Equal existing setup is allowed on the same family after Port rebind.
+    pub fn configure_expected_realm(&self, incarnation: Option<u128>) {
+        let Some(value) = incarnation.filter(|n| *n != 0) else { self.mark_untracked(); return; };
+        if let Some(old) = self.expected.get() {
+            if *old != value { self.mark_untracked(); }
+            return;
+        }
+        if self.attempted.load(Ordering::Acquire) { self.mark_untracked(); }
+        if let Err(value) = self.expected.set(value) {
+            if self.expected.get() != Some(&value) { self.mark_untracked(); }
+        }
+    }
+    /// Coverage root is shared even with future track families/cloned handles.
+    pub fn bind_coverage(&self, coverage: Arc<PhysicalVideoExposureCoverage>) {
+        if let Some(old) = self.coverage.get() {
+            if !Arc::ptr_eq(old, &coverage) { self.mark_untracked(); }
+            return;
+        }
+        if self.attempted.load(Ordering::Acquire) { self.mark_untracked(); }
+        if let Err(other) = self.coverage.set(coverage) {
+            if self.coverage.get().is_none_or(|old| !Arc::ptr_eq(old, &other)) { self.mark_untracked(); }
+        }
+    }
+    /// Called only after original current guards/mapping, BEFORE possible IO.
+    /// Unknown/failed/partial IO conservatively remains in the potential maximum.
+    /// No result, grant, retry, lock, SQL, timestamp pacing, or source-count quota.
+    pub fn record_potential(&self, point: Option<SourceFrameRealmPoint>) {
+        if !self.attempted.load(Ordering::Relaxed) { self.attempted.store(true, Ordering::Release); }
+        let Some(point) = point else { self.mark_untracked(); return; };
+        if self.expected.get() != Some(&point.incarnation()) || point.ordinal() == 0
+            || self.coverage.get().is_none() {
+            self.mark_untracked(); return;
+        }
+        // Repeated fragments/repairs are already covered. A concurrent higher
+        // writer only makes this inequality more conservative; never lower max.
+        if point.ordinal() > self.maximum.load(Ordering::Relaxed) {
+            self.maximum.fetch_max(point.ordinal(), Ordering::AcqRel);
+        }
+    }
+    fn snapshot(&self) -> PhysicalVideoExposureSnapshot {
+        let expected = self.expected.get().copied();
+        let coverage = self.coverage.get();
+        PhysicalVideoExposureSnapshot {
+            physical_family: self.identity,
+            realm_incarnation: expected,
+            maximum_potential_ordinal: self.maximum.load(Ordering::Acquire),
+            coverage_complete: expected.is_some() && coverage.is_some_and(|c| !c.escaped())
+                && !self.untracked.load(Ordering::Acquire),
+        }
+    }
+}
+/// Weak opaque observer. Copying a Port's observer cannot retain its writer.
+#[derive(Clone)]
+pub struct PhysicalVideoExposureObserver(Weak<PhysicalVideoExposure>);
+impl PhysicalVideoExposureObserver {
+    pub fn same_family(&self, other: &Self) -> bool { Weak::ptr_eq(&self.0, &other.0) }
+    pub fn mark_untracked(&self) { if let Some(family)=self.0.upgrade() { family.mark_untracked(); } }
+    pub fn snapshot(&self) -> Option<PhysicalVideoExposureSnapshot> { Some(self.0.upgrade()?.snapshot()) }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct PhysicalVideoExposureSnapshot {
+    pub physical_family: u128,
+    pub realm_incarnation: Option<u128>,
+    pub maximum_potential_ordinal: u64,
+    /// Past tracking coverage only. A caller must separately quiesce/drain the
+    /// exact writer family; this is NOT future exclusion or a no-escape seal.
+    pub coverage_complete: bool,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ids::{ConversationId, SessionId};
+    use crate::staged_streams::frame_realm::SessionFrameRealm;
+    fn setup() -> (Arc<SessionFrameRealm>, Arc<PhysicalVideoExposure>, Arc<PhysicalVideoExposureCoverage>) {
+        let realm = SessionFrameRealm::new(ConversationId::new(), SessionId::new());
+        let family = Arc::new(PhysicalVideoExposure::default());
+        let coverage = Arc::new(PhysicalVideoExposureCoverage::new(false));
+        family.configure_expected_realm(realm.handle().incarnation());
+        family.bind_coverage(coverage.clone());
+        (realm, family, coverage)
+    }
+    #[test]
+    fn physical_exposure_tracks_potential_max_without_source_quota_or_repair_remint() {
+        let (realm, family, _) = setup();
+        let mut points=Vec::new();
+        for _ in 0..320 { points.push(realm.handle().next_point().unwrap()); }
+        family.record_potential(Some(points[319]));
+        family.record_potential(Some(points[0])); // older queued/repair SAME point
+        let before=family.observer().snapshot().unwrap();
+        assert_eq!(before.maximum_potential_ordinal,320);
+        family.record_potential(Some(points[319])); // repeated repair, not allocation
+        assert_eq!(family.observer().snapshot().unwrap(),before);
+        assert!(before.coverage_complete);
+        // Historical scalar identity survives runtime retirement, no grant.
+        drop(realm);
+        family.record_potential(Some(points[318]));
+        assert_eq!(family.observer().snapshot().unwrap(),before);
+    }
+    #[test]
+    fn physical_exposure_unknown_mixed_late_setup_and_escape_are_sticky_only_metadata() {
+        let (realm, family, coverage) = setup();
+        family.record_potential(Some(realm.handle().next_point().unwrap()));
+        coverage.mark_escaped();
+        assert!(!family.observer().snapshot().unwrap().coverage_complete);
+        let (_, mixed, _) = setup();
+        mixed.record_potential(Some(realm.handle().next_point().unwrap()));
+        assert!(!mixed.observer().snapshot().unwrap().coverage_complete);
+        let (_, missing, _) = setup();
+        missing.record_potential(None);
+        missing.record_potential(Some(realm.handle().next_point().unwrap()));
+        assert!(!missing.observer().snapshot().unwrap().coverage_complete);
+        let late=Arc::new(PhysicalVideoExposure::default());
+        late.record_potential(None);
+        late.configure_expected_realm(realm.handle().incarnation());
+        late.bind_coverage(Arc::new(PhysicalVideoExposureCoverage::new(false)));
+        assert!(!late.observer().snapshot().unwrap().coverage_complete);
+        let fresh=Arc::new(PhysicalVideoExposure::default());
+        fresh.bind_coverage(coverage); // escaped BEFORE this family was born
+        fresh.configure_expected_realm(realm.handle().incarnation());
+        assert!(!fresh.observer().snapshot().unwrap().coverage_complete);
+    }
+    #[test]
+    fn physical_exposure_observer_is_weak_and_equal_rebind_keeps_original_family() {
+        let (realm,family,coverage)=setup();
+        let observer=family.observer();
+        let original=observer.snapshot().unwrap().physical_family;
+        family.record_potential(Some(realm.handle().next_point().unwrap()));
+        family.configure_expected_realm(realm.handle().incarnation());
+        family.bind_coverage(coverage);
+        assert_eq!(observer.snapshot().unwrap().physical_family,original);
+        assert!(observer.snapshot().unwrap().coverage_complete);
+        drop(family);
+        assert!(observer.snapshot().is_none());
+    }
+}
