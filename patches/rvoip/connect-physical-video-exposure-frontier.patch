+//! Actual canonical constructor, scalar ICE facade and raw getter coverage.
+//! Metadata only; no offer, frame, B, cut or admission authority is claimed.
+use super::*;
+use rvoip_core::staged_streams::physical_video_exposure::PhysicalVideoExposure;
+#[tokio::test]
+async fn canonical_scalar_ice_control_keeps_coverage_until_original_raw_getter_escape() {
+    for kind in 0..4 {
+        let peer=RvoipPeerConnection::new_canonical(&WebRtcConfig::loopback(),PeerRole::Offerer).await.unwrap();
+        let work=std::panic::AssertUnwindSafe(async {
+            let original=OriginalWebRtcIceControl {peer:peer.clone()};
+            let same=original.clone();
+            let exposure=Arc::new(PhysicalVideoExposure::default());
+            exposure.configure_expected_realm(Some(17)); // isolated metadata namespace only
+            exposure.bind_coverage(peer.video_exposure_coverage());
+            let observer=exposure.observer();
+            assert!(original.same_physical(&same));
+            assert_eq!(original.descriptions().await,(None,None));
+            assert!(!original.ice_descriptions_ready("","").await);
+            assert!(observer.snapshot().unwrap().coverage_complete);
+            match kind {
+                0=>{let _original=peer.peer_connection();},
+                1=>{let _original=peer.local_video_track();},
+                2=>{let _original=peer.local_audio_track();},
+                _=>{let _original=peer.local_dtmf_track();},
+            }
+            assert!(!observer.snapshot().unwrap().coverage_complete);
+            let later=Arc::new(PhysicalVideoExposure::default());
+            later.configure_expected_realm(Some(17));
+            later.bind_coverage(peer.video_exposure_coverage());
+            assert!(!later.observer().snapshot().unwrap().coverage_complete);
+            // Same owned control/peer remains usable; escape never changes IO
+            // results, closes, permission or the original returned capability.
+            assert!(same.same_physical(&original));
+            assert_eq!(original.descriptions().await,(None,None));
+        }).catch_unwind().await;
+        let closed=peer.close().await;
+        assert!(closed.is_ok(),"original peer driver must join before outcome");
+        if let Err(error)=work {std::panic::resume_unwind(error)}
+    }
+}
