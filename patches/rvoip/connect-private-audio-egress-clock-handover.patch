+//! Original receiver-port producer coordinates, serialized by the actual writer.
+//! Numeric history only: no frame, current authorization or physical owner.
+use super::{ControlResult, StreamControlError};
+use std::sync::atomic::{AtomicU64, Ordering};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct BindingIdentity {
+    family: u128,
+    ordinal: u64,
+}
+/// One metadata family for an actual physical track/SSRC writer. Reserving a
+/// prepared binding never changes which binding has actually emitted media.
+pub struct AudioEgressBindings {
+    family: u128,
+    next: AtomicU64,
+}
+impl Default for AudioEgressBindings {
+    fn default() -> Self {
+        Self {
+            family: uuid::Uuid::new_v4().as_u128(),
+            next: AtomicU64::new(1),
+        }
+    }
+}
+impl AudioEgressBindings {
+    pub fn reserve(&self) -> ControlResult<AudioEgressBinding> {
+        let ordinal = self
+            .next
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |old| {
+                old.checked_add(1)
+            })
+            .map_err(|_| StreamControlError::Authority)?;
+        Ok(AudioEgressBinding {
+            identity: BindingIdentity {
+                family: self.family,
+                ordinal,
+            },
+        })
+    }
+    pub fn owns(&self, stamp: &AudioEgressStamp) -> bool {
+        stamp.identity.family == self.family
+            && stamp.identity.ordinal > 0
+            && stamp.identity.ordinal < self.next.load(Ordering::Acquire)
+    }
+}
+/// Move-only adapter metadata installed before the original Port reader is
+/// taken. No deserialization or permission; every write still needs fresh Core.
+pub struct AudioEgressBinding {
+    identity: BindingIdentity,
+}
+impl AudioEgressBinding {
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn silence_for_test(&self, samples: u32, enabled: bool) -> AudioEgressStamp {
+        AudioEgressStamp::new(
+            self.identity,
+            enabled,
+            AudioProducerTiming::silence(samples),
+        )
+    }
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn mixed_for_test(
+        &self,
+        mixer: u128,
+        capture: Option<(u128, u64, u32)>,
+        samples: u32,
+        enabled: bool,
+    ) -> AudioEgressStamp {
+        AudioEgressStamp::new(
+            self.identity,
+            enabled,
+            AudioProducerTiming::mixed(mixer, capture, samples),
+        )
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Producer {
+    Silence,
+    Mixed {
+        mixer: u128,
+        capture: Option<(u128, u64, u32)>,
+    },
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct AudioProducerTiming {
+    producer: Producer,
+    samples: u32,
+}
+impl AudioProducerTiming {
+    pub(super) fn silence(samples: u32) -> Self {
+        Self {
+            producer: Producer::Silence,
+            samples,
+        }
+    }
+    pub(super) fn mixed(mixer: u128, capture: Option<(u128, u64, u32)>, samples: u32) -> Self {
+        Self {
+            producer: Producer::Mixed { mixer, capture },
+            samples,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AudioEgressStamp {
+    identity: BindingIdentity,
+    timing: AudioProducerTiming,
+    enabled: bool,
+}
+impl AudioEgressStamp {
+    fn new(identity: BindingIdentity, enabled: bool, timing: AudioProducerTiming) -> Self {
+        Self {
+            identity,
+            enabled,
+            timing,
+        }
+    }
+    pub fn samples(&self) -> u32 {
+        self.timing.samples
+    }
+    pub fn enabled(&self) -> bool {
+        self.enabled
+    }
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn silence_for_test(owner: u128, samples: u32) -> Self {
+        Self::new(
+            BindingIdentity {
+                family: owner,
+                ordinal: 1,
+            },
+            true,
+            AudioProducerTiming::silence(samples),
+        )
+    }
+    #[cfg(any(test, feature = "test-support"))]
+    pub fn mixed_for_test(
+        owner: u128,
+        mixer: u128,
+        capture: Option<(u128, u64, u32)>,
+        samples: u32,
+    ) -> Self {
+        Self::new(
+            BindingIdentity {
+                family: owner,
+                ordinal: 1,
+            },
+            true,
+            AudioProducerTiming::mixed(mixer, capture, samples),
+        )
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Position {
+    stamp: AudioEgressStamp,
+    source: u32,
+    wire: u32,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub struct AudioEgressClock {
+    last: Option<Position>,
+    resume: bool,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AudioEgressReservation {
+    next: Position,
+    mapping_changed: bool,
+}
+impl AudioEgressReservation {
+    pub fn timestamp(&self) -> u32 {
+        self.next.wire
+    }
+    pub fn mapping_changed(&self) -> bool {
+        self.mapping_changed
+    }
+}
+impl AudioEgressClock {
+    pub fn active(&self) -> bool {
+        self.last.is_some()
+    }
+    pub fn prepare(
+        &self,
+        stamp: AudioEgressStamp,
+        source: u32,
+        last_wire: Option<u32>,
+    ) -> ControlResult<AudioEgressReservation> {
+        if stamp.timing.samples == 0 {
+            return Err(StreamControlError::NotReady);
+        }
+        let wire = match self.last {
+            None => last_wire.map_or(source, |last| last.wrapping_add(stamp.timing.samples)),
+            Some(old) => {
+                if old.stamp.identity.family != stamp.identity.family {
+                    return Err(StreamControlError::Authority);
+                }
+                if stamp.identity.ordinal < old.stamp.identity.ordinal {
+                    return Err(StreamControlError::NotReady);
+                }
+                if stamp.identity.ordinal > old.stamp.identity.ordinal {
+                    // Only an actual fresh-admitted mixed write can adopt a new ordinary
+                    // Port. Preparing its metadata does not silence the original binding.
+                    if !matches!(stamp.timing.producer, Producer::Mixed { .. }) {
+                        return Err(StreamControlError::NotReady);
+                    }
+                    last_wire
+                        .unwrap_or(old.wire)
+                        .wrapping_add(stamp.timing.samples)
+                } else {
+                    if old.stamp.timing.samples != stamp.timing.samples {
+                        return Err(StreamControlError::Unsupported);
+                    }
+                    match (old.stamp.timing.producer, stamp.timing.producer) {
+                        (Producer::Mixed { .. }, Producer::Silence) => {
+                            return Err(StreamControlError::NotReady);
+                        }
+                        (before, after) if before != after || self.resume => last_wire
+                            .unwrap_or(old.wire)
+                            .wrapping_add(stamp.timing.samples),
+                        _ => {
+                            let delta = source.wrapping_sub(old.source);
+                            if delta == 0 || delta >= (1u32 << 31) {
+                                return Err(StreamControlError::NotReady);
+                            }
+                            old.wire.wrapping_add(delta)
+                        }
+                    }
+                }
+            }
+        };
+        let mapping_changed = self.last.is_none_or(|old| {
+            old.stamp.identity != stamp.identity
+                || old.stamp.timing.producer != stamp.timing.producer
+        }) || self.resume;
+        Ok(AudioEgressReservation {
+            next: Position {
+                stamp,
+                source,
+                wire,
+            },
+            mapping_changed,
+        })
+    }
+    /// Actual successful primary IO. This is not remote decoded readiness.
+    pub fn commit(&mut self, reservation: AudioEgressReservation) {
+        self.last = Some(reservation.next);
+        self.resume = false;
+    }
+    /// The exact original IO may have happened. Consume its source/wire coordinate
+    /// without delivery/readiness credit; a distinct fresh packet can continue.
+    pub fn burn(&mut self, reservation: AudioEgressReservation) {
+        self.commit(reservation);
+    }
+    pub fn telephone_event(&mut self) {
+        self.resume = true;
+    }
+}
+impl super::AdapterMediaPort {
+    /// Attach actual physical-writer metadata to this exact prepared audio Port.
+    /// Consumes its one-use token; no active clock transition occurs here.
+    pub fn install_audio_egress_binding(&self, binding: AudioEgressBinding) -> ControlResult<()> {
+        let output = self
+            .0
+            .output
+            .lock()
+            .map_err(|_| StreamControlError::Authority)?;
+        let state = self
+            .0
+            .state
+            .lock()
+            .map_err(|_| StreamControlError::Authority)?;
+        if !matches!(
+            state.status,
+            super::PortStatus::Prepared | super::PortStatus::Active | super::PortStatus::Paused
+        ) || output.is_none()
+            || self.0.binding.negotiated.requested.medium != super::Medium::Audio
+            || !self.0.binding.sink_ready
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.0
+            .audio_egress_binding
+            .set(binding)
+            .map_err(|_| StreamControlError::Authority)
+    }
+}
+impl super::QueuedMedia {
+    /// Exact immutable Core binding/producer coordinates, not authorization.
+    pub fn audio_egress_stamp(&self) -> ControlResult<Option<AudioEgressStamp>> {
+        if self.frame.kind != super::StreamKind::Audio {
+            return Ok(None);
+        }
+        let enabled = self.target.audio_egress_owner.get().is_some();
+        let identity = match self.target.audio_egress_binding.get() {
+            Some(binding) => binding.identity,
+            None => match self.target.audio_egress_owner.get().copied() {
+                Some(family) => BindingIdentity { family, ordinal: 1 },
+                None => return Ok(None),
+            },
+        };
+        let Some(timing) = self.audio_timing else {
+            return if enabled {
+                Err(StreamControlError::Unsupported)
+            } else {
+                Ok(None)
+            };
+        };
+        Ok(Some(AudioEgressStamp::new(identity, enabled, timing)))
+    }
+}
