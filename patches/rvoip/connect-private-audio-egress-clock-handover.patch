+#[test]
+fn explicit_actual_capture_epoch_remap_publishes_matching_report_without_waiting_for_old_throttle()
+{
+    let (b, mut p, wire) = fixture();
+    let neutral = AudioEgressStamp::silence_for_test(1, 160);
+    let remote = AudioEgressStamp::mixed_for_test(1, 2, None, 160);
+    p.send(frame(&b, 160), None, Some(neutral), &b, 0, &wire, |_| {})
+        .unwrap();
+    let anchor = rvoip_core::stream::MediaClockAnchor {
+        ntp_time: rtcp::now_ntp(),
+        rtp_time: 160,
+        clock_rate: 8000,
+    };
+    let make = |timestamp, anchor| {
+        let mut f = frame(&b, timestamp);
+        f.source_clock = Some(rvoip_core::stream::MediaSourceClock {
+            source_id: 2,
+            generation: 1,
+            anchor: Some(anchor),
+            supported: true,
+            rtp_offset: 0,
+            is_current: Arc::new(|| true),
+        });
+        f
+    };
+    p.send(make(160, anchor), None, Some(remote), &b, 0, &wire, |_| {})
+        .unwrap();
+    let first_ssrc = p.ssrc;
+    let next_anchor = rvoip_core::stream::MediaClockAnchor {
+        ntp_time: anchor.ntp_time.wrapping_add(1u64 << 24),
+        rtp_time: 0,
+        clock_rate: 8000,
+    };
+    let epoch = AudioEgressStamp::mixed_for_test(1, 2, Some((7, 3, 8000)), 160);
+    p.send(
+        make(0, next_anchor),
+        None,
+        Some(epoch),
+        &b,
+        0,
+        &wire,
+        |_| {},
+    )
+    .unwrap();
+    assert_eq!(
+        p.ssrc, first_ssrc,
+        "explicit translation does not invent a new public source identity"
+    );
+    let rows = wire.packets.lock().unwrap();
+    let reports = rows
+        .iter()
+        .filter_map(|b| rtcp::parse(b))
+        .map(|(_, r)| r)
+        .collect::<Vec<_>>();
+    assert_eq!(
+        reports.len(),
+        2,
+        "a matching explicit epoch report must not wait for old one-second throttle"
+    );
+    assert_eq!(
+        reports[1].rtp,
+        rtcp::rtp_at(reports[1].ntp, next_anchor, 480).unwrap()
+    );
+    assert_eq!(
+        rows.iter()
+            .filter_map(|b| crate::substrate::unpack_rtp_datagram(b).ok())
+            .map(|d| d.rtp.timestamp)
+            .collect::<Vec<_>>(),
+        vec![160, 320, 480]
+    );
+}
