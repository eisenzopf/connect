+#[tokio::test]
+async fn actual_private_codec_queue_seals_only_known_silence_and_original_mixer_epoch_without_renewing_frame_age()
+ {
+    use crate::staged_streams::audio_egress_clock::AudioEgressClock;
+    let mut f = Move::for_audio_preroll().await;
+    let prepared = prepare(&f, deadline(), CancellationToken::new()).await;
+    let target = f.room.nodes["device"].controller.clone();
+    // A public arbitrary encoded prompt has no fabricated packet duration.
+    f.queue_prompt(4000).unwrap();
+    let arbitrary = f
+        .room
+        .nodes
+        .get_mut("device")
+        .unwrap()
+        .out
+        .try_recv()
+        .unwrap();
+    assert!(matches!(
+        arbitrary.audio_egress_stamp(),
+        Err(StreamControlError::Unsupported)
+    ));
+    let purpose = LocalAudioPurpose::EndpointPreparation {
+        operation_id: f.pending.intent().operation_id.clone(),
+    };
+    target
+        .try_queue_local_silence(&desired(Medium::Audio).logical_id, purpose, 160)
+        .unwrap();
+    let neutral = f
+        .room
+        .nodes
+        .get_mut("device")
+        .unwrap()
+        .out
+        .try_recv()
+        .unwrap();
+    let original_age = neutral.admitted_at;
+    let neutral_stamp = neutral.audio_egress_stamp().unwrap().unwrap();
+    assert_eq!(neutral_stamp.samples(), 160);
+    let mut clock = AudioEgressClock::default();
+    neutral
+        .deliver(|frame| {
+            assert!(original_age.elapsed() < Duration::from_millis(200));
+            let pending = clock
+                .prepare(neutral_stamp, frame.timestamp_rtp, None)
+                .unwrap();
+            assert_eq!(pending.timestamp(), 160);
+            clock.commit(pending);
+            std::future::ready(Ok(()))
+        })
+        .await
+        .unwrap();
+    assert!(
+        !prepared.has_delivered_remote_audio(),
+        "actual neutral output cannot count as remote media"
+    );
+    f.room.publish("bob", 6000).unwrap();
+    f.room.tick();
+    let real = f
+        .room
+        .nodes
+        .get_mut("device")
+        .unwrap()
+        .out
+        .try_recv()
+        .unwrap();
+    let original_frame_age = real.admitted_at;
+    let stamp = real.audio_egress_stamp().unwrap().unwrap();
+    real.deliver(|frame| {
+        assert!(original_frame_age.elapsed() < Duration::from_millis(200));
+        use rvoip_media_core::codec::factory::CodecFactory;
+        let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+        let decoded = codec.decode(&frame.payload).unwrap();
+        let mean = decoded.samples.iter().map(|s| i32::from(*s)).sum::<i32>()
+            / decoded.samples.len() as i32;
+        assert!((mean - 6000).abs() < 400);
+        let pending = clock.prepare(stamp, frame.timestamp_rtp, None).unwrap();
+        assert_eq!(pending.timestamp(), 320);
+        clock.commit(pending);
+        std::future::ready(Ok(()))
+    })
+    .await
+    .unwrap();
+
+    assert!(prepared.has_delivered_remote_audio());
+    assert!(!target.shutdown.is_cancelled());
+    assert!(!f.room.nodes["alice"].controller.shutdown.is_cancelled());
+}
