+                .state
+                .accepted_core_timestamp(frame.timestamp_rtp, timestamp);
+        }
+        state.accepted = true;
+    }
+    if result.is_ok() && !io.written() {
+        return Err(StreamControlError::NotReady);
+    }
+    result.map_err(|_| StreamControlError::NotReady)
+}
