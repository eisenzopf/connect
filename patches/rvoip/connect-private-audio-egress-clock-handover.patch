+#[cfg(test)]
+mod producer_freeze_tests {
+    use super::*;
+    struct Io {
+        control: OwnedRtpControl,
+    }
+    #[async_trait::async_trait]
+    impl OwnedRtpIo for Io {
+        async fn write(&mut self, _: rtp::Packet) -> Result<()> {
+            panic!("definitive refusal performed IO")
+        }
+        fn written(&self) -> bool {
+            false
+        }
+        fn submission_control(&self) -> OwnedRtpControl {
+            self.control.clone()
+        }
+    }
+    struct Refused;
+    #[async_trait::async_trait]
+    impl OwnedRtpProducer for Refused {
+        async fn write(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+            assert!(!io.submission_control().freeze_producer());
+            Err(OwnedRtpError::Refused)
+        }
+    }
+    #[tokio::test]
+    async fn exact_finished_no_write_preserves_completed_refusal_and_clones_cannot_claim_or_begin()
+    {
+        let control = OwnedRtpControl::new(Instant::now() + std::time::Duration::from_millis(200));
+        let mut io = Io {
+            control: control.clone(),
+        };
+        assert_eq!(
+            complete(&Refused, &mut io, &control).await,
+            Err(OwnedRtpError::Refused)
+        );
+        assert!(!control.clone().claim());
+        assert!(!control.clone().begin());
+        assert!(!control.cancel());
+    }
+    #[tokio::test]
+    async fn completed_freeze_does_not_override_actual_deadline_or_caller_cancellation_result() {
+        for cancelled in [false, true] {
+            let control = OwnedRtpControl::new(if cancelled {
+                Instant::now() + std::time::Duration::from_millis(200)
+            } else {
+                Instant::now()
+            });
+            if cancelled {
+                assert!(!control.cancel());
+            }
+            let mut io = Io {
+                control: control.clone(),
+            };
+            assert_eq!(
+                complete(&Refused, &mut io, &control).await,
+                Err(OwnedRtpError::DeadlineBeforeWrite)
+            );
+        }
+    }
+    #[test]
+    fn current_deadline_and_caller_cancellation_still_refuse_finished_ticket_and_started_is_uncertain()
+     {
+        let cancelled =
+            OwnedRtpControl::new(Instant::now() + std::time::Duration::from_millis(200));
+        assert!(!cancelled.cancel());
+        assert!(!cancelled.freeze_producer());
+        assert!(!cancelled.current());
+        assert!(!cancelled.begin());
+        let expired = OwnedRtpControl::new(Instant::now());
+        assert!(!expired.freeze_producer());
+        assert!(!expired.current());
+        assert!(!expired.begin());
+        let started = OwnedRtpControl::new(Instant::now() + std::time::Duration::from_millis(200));
+        assert!(started.claim());
+        assert!(started.begin());
+        assert!(started.freeze_producer());
+        assert_eq!(stopped(&started), OwnedRtpError::OutcomeUnknown);
+    }
+}
