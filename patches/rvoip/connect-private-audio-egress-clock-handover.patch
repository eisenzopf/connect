+struct TestPacket {
+    state: OwnedMutexGuard<OutboundAudioRtpState>,
+    frame: MediaFrame,
+    stamp: AudioEgressStamp,
+}
+struct Producer {
+    packet: Mutex<Option<TestPacket>>,
+    writer: Arc<OutboundAudioRtpWriter>,
+    after_write_error: bool,
+}
+struct FailAfterWrite<'a>(&'a mut dyn OwnedRtpIo);
+#[async_trait::async_trait]
+impl OwnedRtpIo for FailAfterWrite<'_> {
+    async fn write(&mut self, packet: rtc::rtp::Packet) -> rtc::shared::error::Result<()> {
+        self.0.write(packet).await?;
+        Err(rtc::shared::error::Error::ErrConnectionClosed)
+    }
+    async fn write_with_clock(
+        &mut self,
+        packet: rtc::rtp::Packet,
+        clock: rtc::interceptor::SenderClockHandle,
+        update: Option<rtc::interceptor::SenderClockUpdate>,
+    ) -> rtc::shared::error::Result<()> {
+        self.0.write_with_clock(packet, clock, update).await?;
+        Err(rtc::shared::error::Error::ErrConnectionClosed)
+    }
+    fn written(&self) -> bool {
+        self.0.written()
+    }
+    fn submission_control(&self) -> OwnedRtpControl {
+        self.0.submission_control()
+    }
+}
+#[async_trait::async_trait]
+impl OwnedRtpProducer for Producer {
+    async fn write(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+        let TestPacket {
+            state,
+            frame,
+            stamp,
+        } = self
+            .packet
+            .lock()
+            .unwrap()
+            .take()
+            .ok_or(OwnedRtpError::Refused)?;
+        let mut state = CoreAudioState::new(state, io.submission_control());
+        let result = if self.after_write_error {
+            write_frame(
+                &mut state,
+                &self.writer,
+                111,
+                Some(stamp),
+                frame,
+                &mut FailAfterWrite(io),
+            )
+            .await
+        } else {
+            write_frame(&mut state, &self.writer, 111, Some(stamp), frame, io).await
+        };
+        result.map_err(|_| OwnedRtpError::Refused)
+    }
+}
+fn frame(timestamp: u32) -> MediaFrame {
+    MediaFrame {
+        stream_id: StreamId::new(),
+        kind: StreamKind::Audio,
+        payload: bytes::Bytes::from_static(&[0xf8, 0xff, 0xfe]),
+        timestamp_rtp: timestamp,
+        captured_at: chrono::Utc::now(),
+        payload_type: Some(111),
+        source_clock: None,
+    }
+}
+async fn submit(
+    writer: &Arc<OutboundAudioRtpWriter>,
+    frame: MediaFrame,
+    stamp: AudioEgressStamp,
+    after_write_error: bool,
+) -> OwnedRtpResult {
+    let state = writer.state_for_test().lock_owned().await;
+    let producer = Producer {
+        packet: Mutex::new(Some(TestPacket {
+            state,
+            frame,
+            stamp,
+        })),
+        writer: writer.clone(),
+        after_write_error,
+    };
+    let write = writer.track_for_test().owned_rtp(
+        Arc::new(producer),
+        Instant::now() + Duration::from_millis(200),
+    );
+    let result = write.result().await;
+    let joined = write.cancel_and_drain().await;
+    joined?;
+    result
+}
+async fn receive(
+    receiver: &Arc<crate::peer::RvoipPeerConnection>,
+    count: usize,
+) -> Result<Vec<rtc::rtp::Packet>, String> {
+    let track = receiver
+        .wait_remote_track_kind(
+            rtc::rtp_transceiver::rtp_sender::RtpCodecKind::Audio,
+            Duration::from_secs(2),
+        )
+        .await
+        .ok_or("no actual received track")?;
+    tokio::time::timeout(Duration::from_secs(2), async {
+        let mut output = Vec::new();
+        while output.len() < count {
+            match track.poll().await {
+                Some(TrackRemoteEvent::OnRtpPacket(packet, _)) => output.push(packet),
+                Some(TrackRemoteEvent::OnEnded | TrackRemoteEvent::OnError) | None => {
+                    return Err("actual track stopped".into());
+                }
+                _ => {}
+            }
+        }
+        Ok(output)
+    })
+    .await
+    .map_err(|_| "actual received RTP timeout".to_owned())?
+}
