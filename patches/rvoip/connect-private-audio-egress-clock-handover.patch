+        );
+    }
+    #[test]
+    fn definitive_refusal_preserves_neutral_but_possible_original_packet_consumes_coordinates_not_future_media()
+     {
+        let mut clock = AudioEgressClock::default();
+        let p = clock.prepare(silence(), 960, None).unwrap();
+        clock.commit(p);
+        let _refused = clock.prepare(mixed(10, None), 960, None).unwrap();
+        let p = clock.prepare(silence(), 1920, None).unwrap();
+        clock.commit(p);
+        let uncertain = clock.prepare(mixed(10, None), 960, None).unwrap();
+        assert_eq!(uncertain.timestamp(), 2880);
+        clock.burn(uncertain);
+        assert!(clock.prepare(silence(), 2880, None).is_err());
+        assert!(clock.prepare(mixed(10, None), 960, None).is_err());
+        let fresh = clock.prepare(mixed(10, None), 1920, None).unwrap();
+        assert_eq!(fresh.timestamp(), 3840);
+        clock.commit(fresh);
+    }
+    #[test]
+    fn actual_prepared_binding_reservation_does_not_replace_old_owner_but_first_admitted_higher_binding_fences_old()
+     {
+        let bindings = AudioEgressBindings::default();
+        let original = bindings.reserve().unwrap();
+        let a = original.mixed_for_test(10, None, 960, true);
+        let mut clock = AudioEgressClock::default();
+        clock.commit(clock.prepare(a, 960, None).unwrap());
+        let next = bindings.reserve().unwrap();
+        let b = next.mixed_for_test(11, None, 960, false);
+        assert!(bindings.owns(&a) && bindings.owns(&b));
+        clock.commit(clock.prepare(a, 1920, None).unwrap());
+        let moved = clock.prepare(b, 0, None).unwrap();
+        assert_eq!(moved.timestamp(), 2880);
+        clock.commit(moved);
+        assert!(clock.prepare(a, 2880, None).is_err());
+        assert!(
+            clock
+                .prepare(next.silence_for_test(960, false), 960, None)
+                .is_err()
+        );
+        assert_eq!(clock.prepare(b, 960, None).unwrap().timestamp(), 3840);
+    }
+}
