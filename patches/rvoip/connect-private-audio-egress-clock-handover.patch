+            let decoded = codec.decode(&frame.payload).unwrap();
+            let mean = decoded.samples.iter().map(|s| i32::from(*s)).sum::<i32>()
+                / decoded.samples.len() as i32;
+            assert!((mean - 7000).abs() < 400);
+            let reserved = clock.prepare(stamp, frame.timestamp_rtp, None).unwrap();
+            assert_eq!(reserved.timestamp(), 480);
+            clock.commit(reserved);
+            std::future::ready(Ok(()))
+        })
+        .await
+        .unwrap();
+    assert!(f.room.publish("alice", 9000).is_err());
+}
