+    state: &mut CoreAudioState,
+    writer: &OutboundAudioRtpWriter,
+    payload_type: u8,
+    audio_stamp: Option<rvoip_core::staged_streams::audio_egress_clock::AudioEgressStamp>,
+    frame: rvoip_core::stream::MediaFrame,
+    io: &mut dyn OwnedRtpIo,
