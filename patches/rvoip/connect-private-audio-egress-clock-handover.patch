+     {
+        let mut clock = AudioEgressClock::default();
+        let p = clock.prepare(silence(), u32::MAX - 479, None).unwrap();
+        clock.commit(p);
+        let first = clock.prepare(mixed(10, None), 0, None).unwrap();
+        assert_eq!(first.timestamp(), 480);
+        clock.commit(first);
+        assert!(clock.prepare(silence(), 480, None).is_err());
+        let next = clock.prepare(mixed(10, None), 2880, None).unwrap();
+        assert_eq!(next.timestamp(), 3360);
+        clock.commit(next);
+        assert!(clock.prepare(mixed(10, None), 2880, None).is_err());
+        let actual_epoch = clock
+            .prepare(mixed(10, Some((20, 2, 48000))), 0, None)
