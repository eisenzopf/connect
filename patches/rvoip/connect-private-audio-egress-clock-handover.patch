+#[test]
+fn same_native_writer_maps_retained_first_remote_and_fences_queued_neutral_without_erasing_real_gaps()
+ {
+    let (b, mut p, wire) = fixture();
+    let neutral = AudioEgressStamp::silence_for_test(1, 160);
+    let remote = AudioEgressStamp::mixed_for_test(1, 2, None, 160);
+    p.send(frame(&b, 160), None, Some(neutral), &b, 0, &wire, |_| {})
+        .unwrap();
+    p.send(frame(&b, 160), None, Some(remote), &b, 0, &wire, |_| {})
+        .unwrap();
+    let cursor = p.outer;
+    assert!(
+        p.send(frame(&b, 320), None, Some(neutral), &b, 0, &wire, |_| {})
+            .is_err()
+    );
+    assert_eq!(
+        p.outer, cursor,
+        "queued neutral must refuse before reserving physical RTP"
+    );
+    p.send(frame(&b, 480), None, Some(remote), &b, 0, &wire, |_| {})
+        .unwrap();
+    let epoch = AudioEgressStamp::mixed_for_test(1, 2, Some((7, 3, 8000)), 160);
+    p.send(frame(&b, 0), None, Some(epoch), &b, 0, &wire, |_| {})
+        .unwrap();
+    assert_eq!(timestamps(&wire), vec![160, 320, 640, 800]);
+    assert!(
+        p.send(frame(&b, 960), None, None, &b, 0, &wire, |_| {})
+            .is_err(),
+        "arbitrary public local audio has no invented20ms stamp"
+    );
+}
+#[test]
+fn native_definitive_transport_refusal_leaves_neutral_clock_and_actual_primary_effect_commits_before_rtcp_failure()
+ {
+    let (b, mut p, wire) = fixture();
+    let neutral = AudioEgressStamp::silence_for_test(1, 160);
+    let remote = AudioEgressStamp::mixed_for_test(1, 2, None, 160);
+    p.send(frame(&b, 160), None, Some(neutral), &b, 0, &wire, |_| {})
+        .unwrap();
+    let before = p.audio_clock;
+    wire.refuse.store(true, Ordering::Release);
+    assert!(
+        p.send(frame(&b, 160), None, Some(remote), &b, 0, &wire, |_| {})
+            .is_err()
+    );
+    assert_eq!(p.audio_clock, before);
+    assert_eq!(timestamps(&wire), vec![160]);
+    p.send(frame(&b, 320), None, Some(neutral), &b, 0, &wire, |_| {})
+        .unwrap();
+    let mut real = frame(&b, 160);
+    let anchor = rvoip_core::stream::MediaClockAnchor {
+        ntp_time: rtcp::now_ntp(),
+        rtp_time: 160,
+        clock_rate: 8000,
+    };
+    real.source_clock = Some(rvoip_core::stream::MediaSourceClock {
+        source_id: 2,
+        generation: 3,
+        anchor: Some(anchor),
+        supported: true,
+        rtp_offset: 0,
+        is_current: Arc::new(|| true),
+    });
+    let ntp = real.source_clock.as_ref().unwrap().anchor.unwrap().ntp_time;
+    // The same actual callback accepts RTP; it then makes only the later RTCP
+    // transport admission fail. Primary success cannot be undone by metadata.
+    p.send(real, None, Some(remote), &b, 0, &wire, |_| {
+        wire.refuse.store(true, Ordering::Release)
+    })
+    .unwrap();
+    assert_eq!(timestamps(&wire), vec![160, 320, 480]);
+    assert!(
+        p.send(frame(&b, 480), None, Some(neutral), &b, 0, &wire, |_| {})
+            .is_err()
+    );
+    assert_eq!(
+        anchor.ntp_time, ntp,
+        "original capture anchor is never rewritten"
+    );
+    assert!(
+        wire.packets
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|p| !rtcp::is_rtcp(p))
+    );
+}
