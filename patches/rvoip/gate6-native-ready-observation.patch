+/// Engine-minted historical readiness. No deserialization or public constructor;
+/// cloning preserves facts, and supplies no current media or delivery authority.
+#[derive(Clone)]
+pub struct NativeConnectionReadyObservation {
+    pub(crate) connection: ConnectionId,
+    pub(crate) principal: AuthenticatedPrincipal,
+    pub(crate) revision: u64,
+    pub(crate) credential_revision: u64,
+    pub(crate) observed_at: chrono::DateTime<chrono::Utc>,
+    pub(crate) streams: Vec<ReadyMediaBinding>,
+}
+impl NativeConnectionReadyObservation {
+    pub fn connection(&self) -> &ConnectionId {
+        &self.connection
+    }
+    pub fn principal(&self) -> &AuthenticatedPrincipal {
+        &self.principal
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn credential_revision(&self) -> u64 {
+        self.credential_revision
+    }
+    pub fn observed_at(&self) -> chrono::DateTime<chrono::Utc> {
+        self.observed_at
+    }
+    pub fn streams(&self) -> &[ReadyMediaBinding] {
+        &self.streams
+    }
+}
