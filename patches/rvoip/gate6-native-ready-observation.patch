+//! Capture historical metadata under actual controller/credential/port custody.
+use super::*;
+impl StreamController {
+    /// `capture` may inspect independent metadata but must not reenter Core or
+    /// retain an IO grant. Its epoch must cover every captured fact. Flow locks
+    /// leave the callback before port locks are acquired (flow -> port order).
+    /// The returned value proves a past observation, never permission for IO.
+    pub fn capture_ready_metadata<T>(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        connection: &ConnectionId,
+        revision: u64,
+        capture: impl FnOnce(u64, &[ReadyMediaBinding]) -> ControlResult<(T, CancellationToken)>,
+    ) -> ControlResult<T> {
+        let state = self
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        let credential = self
+            .credential
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if self.shutdown.is_cancelled()
+            || &self.connection != connection
+            || state.closed
+            || state.model.revision() != revision
+            || !reliable_data::same_credential(&credential.principal, principal)
+            || state.active.is_empty()
+            || state.active.len() > 64
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let bindings = state
+            .active
+            .values()
+            .map(|p| p.binding.clone())
+            .collect::<Vec<_>>();
+        let (value, epoch) = capture(credential.revision, &bindings)?;
+        let mut guards = Vec::with_capacity(state.active.len());
+        for port in state.active.values() {
+            let guard = port
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::NotReady)?;
+            if guard.status != PortStatus::Active {
+                return Err(StreamControlError::Authority);
+            }
+            guards.push(guard);
+        }
+        if self.shutdown.is_cancelled() || epoch.is_cancelled() {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(value)
+    }
+}
