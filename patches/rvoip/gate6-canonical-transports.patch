+//! Canonical connect/2 text frames over TLS WebSocket, without a v1 coordinator.
+use bytes::Bytes;
+use futures::{SinkExt, StreamExt};
+use rvoip_uctp::v2::{
+    auth_dispatch::DispatchError,
+    auth_peer::AUTHENTICATION_TIMEOUT,
+    reachability::PeerTransport,
+    server::{origin_allowed, CanonicalProfile, ProfileServer},
+    MAX_ENVELOPE_BYTES,
+};
+use std::{collections::HashSet, sync::Arc};
+use tokio::{net::TcpStream, sync::mpsc};
+use tokio_tungstenite::{
+    accept_hdr_async_with_config,
+    tungstenite::{
+        handshake::server::{ErrorResponse, Request, Response},
+        protocol::{Message, WebSocketConfig},
+    },
+};
+
+/// Feed raw accepted TCP streams; this driver owns TLS, HTTP upgrade, canonical
+/// authentication and physical retirement. The listener stays caller-owned.
+pub fn start(
+    incoming: mpsc::Receiver<TcpStream>,
+    tls: Arc<rustls::ServerConfig>,
+    profile: CanonicalProfile,
+    contact: String,
+    mount: String,
+    origins: Option<HashSet<String>>,
+) -> Result<ProfileServer, DispatchError> {
+    if !mount.starts_with('/') || mount.contains(['?', '#']) {
+        return Err(DispatchError::Unsupported);
+    }
+    let origins = Arc::new(origins);
+    ProfileServer::spawn(
+        incoming,
+        profile.max_connections(),
+        move |socket, cancel| {
+            let tls = tls.clone();
+            let profile = profile.clone();
+            let contact = contact.clone();
+            let mount = mount.clone();
+            let origins = origins.clone();
+            async move {
+                let deadline = tokio::time::Instant::now() + AUTHENTICATION_TIMEOUT;
+                let peer = profile.peer(PeerTransport::WebSocket, &contact, cancel.clone())?;
+                let upgrade = async move {
+                    let socket = tokio_rustls::TlsAcceptor::from(tls)
+                        .accept(socket)
+                        .await
+                        .map_err(|_| DispatchError::Closed)?;
+                    let callback = move |request: &Request,
+                                         response: Response|
+                          -> Result<Response, ErrorResponse> {
+                        let valid_origin = origin_allowed(
+                            request
+                                .headers()
+                                .get_all("origin")
+                                .iter()
+                                .map(|value| value.to_str().unwrap_or("")),
+                            origins.as_ref().as_ref(),
+                        );
+                        if request.uri().path() != mount || !valid_origin {
+                            let status = if !valid_origin { 403 } else { 404 };
+                            return Err(Response::builder()
+                                .status(status)
+                                .body(Some("upgrade denied".into()))
+                                .expect("static HTTP response"));
+                        }
+                        Ok(response)
+                    };
+                    accept_hdr_async_with_config(
+                        socket,
+                        callback,
+                        Some(
+                            WebSocketConfig::default()
+                                .max_message_size(Some(MAX_ENVELOPE_BYTES))
+                                .max_frame_size(Some(MAX_ENVELOPE_BYTES)),
+                        ),
+                    )
+                    .await
+                    .map_err(|_| DispatchError::Closed)
+                };
+                let websocket = tokio::select! {
+                    biased;
+                    _=cancel.cancelled()=>return Err(DispatchError::Closed),
+                    result=tokio::time::timeout_at(deadline,upgrade)=>result.map_err(|_|DispatchError::Closed)??,
+                };
+                let (writer, reader) = websocket.split();
+                let reader = futures::stream::unfold(reader, |mut reader| async move {
+                    loop {
+                        match reader.next().await {
+                            Some(Ok(Message::Text(text))) => {
+                                return Some((Ok(Bytes::copy_from_slice(text.as_bytes())), reader))
+                            }
+                            Some(Ok(Message::Ping(_) | Message::Pong(_))) => continue,
+                            Some(Ok(Message::Close(_))) | None => return None,
+                            _ => return Some((Err(DispatchError::Closed), reader)),
+                        }
+                    }
+                });
+                let writer = writer
+                    .with(|bytes: Bytes| async move {
+                        String::from_utf8(bytes.to_vec())
+                            .map(|text| Message::Text(text.into()))
+                            .map_err(|_| tokio_tungstenite::tungstenite::Error::ConnectionClosed)
+                    })
+                    .sink_map_err(|_| DispatchError::Closed);
+                peer.run_frames(Box::pin(reader), Box::pin(writer), profile.handler.as_ref())
+                    .await
+            }
+        },
+        drop,
+    )
+}
