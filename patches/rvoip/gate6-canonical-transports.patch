+    struct NotifyDrop(Arc<Notify>);
+    impl Drop for NotifyDrop {
+        fn drop(&mut self) {
+            self.0.notify_one();
+        }
+    }
+    let entered = Arc::new(Notify::new());
+    let entry = entered.clone();
+    let retired = Arc::new(Notify::new());
+    let retirement = retired.clone();
+    let (send, receive) = mpsc::channel(1);
+    let server = ProfileServer::spawn(
+        receive,
+        1,
+        move |_: (), _| {
+            let entry = entry.clone();
+            let retirement = retirement.clone();
+            async move {
+                let _guard = NotifyDrop(retirement);
+                entry.notify_one();
+                std::future::pending::<()>().await;
+                Ok(())
