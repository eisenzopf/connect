@@ -0,0 +1,64 @@
+//! Canonical connect/2 signaling on an already TLS-negotiated QUIC connection.
+use rvoip_uctp::v2::{
+    auth_dispatch::DispatchError,
+    auth_peer::AUTHENTICATION_TIMEOUT,
+    reachability::PeerTransport,
+    server::{CanonicalProfile, ProfileServer},
+    RAW_QUIC_ALPN,
+};
+use tokio::sync::mpsc;
+
+struct Close(quinn::Connection);
+impl Drop for Close {
+    fn drop(&mut self) {
+        self.0.close(0u32.into(), b"canonical-peer-retired");
+    }
+}
+
+/// The endpoint owner feeds accepted connections here and retains endpoint
+/// ownership. This server owns and closes each admitted physical connection.
+pub fn start(
+    incoming: mpsc::Receiver<quinn::Connection>,
+    profile: CanonicalProfile,
+    contact: String,
+) -> Result<ProfileServer, DispatchError> {
+    ProfileServer::spawn(
+        incoming,
+        profile.max_connections(),
+        move |connection, cancel| {
+            let profile = profile.clone();
+            let contact = contact.clone();
+            async move {
+                let _close = Close(connection.clone());
+                let alpn = connection
+                    .handshake_data()
+                    .and_then(|data| data.downcast::<quinn::crypto::rustls::HandshakeData>().ok())
+                    .and_then(|data| data.protocol.clone());
+                if alpn.as_deref() != Some(RAW_QUIC_ALPN) {
+                    return Err(DispatchError::Unsupported);
+                }
+                let deadline = tokio::time::Instant::now() + AUTHENTICATION_TIMEOUT;
+                let peer = profile.peer(PeerTransport::Quic, &contact, cancel.clone())?;
+                let (mut writer, reader) = tokio::select! {
+                    biased;
+                    _=cancel.cancelled()=>return Err(DispatchError::Closed),
+                    result=tokio::time::timeout_at(deadline,connection.accept_bi())=>result.map_err(|_|DispatchError::Closed)?.map_err(|_|DispatchError::Closed)?,
+                };
+                let result = peer
+                    .run(reader, &mut writer, profile.handler.as_ref())
+                    .await;
+                // FIN and bounded acknowledgement precede CONNECTION_CLOSE;
+                // closing immediately can discard the final signed auth.bye.
+                if writer.finish().is_ok() {
+                    tokio::select! {
+                        biased;
+                        _=cancel.cancelled()=>{},
+                        _=tokio::time::timeout(std::time::Duration::from_secs(1),writer.stopped())=>{},
+                    }
+                }
+                result
+            }
+        },
+        |connection| connection.close(0u32.into(), b"canonical-admission-closed"),
+    )
+}
