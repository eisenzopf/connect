+async fn supervisor_bounds_admission_and_retains_shutdown_after_cancelled_wait() {
+    let (send, receive) = mpsc::channel(4);
+    let entered = Arc::new(Notify::new());
+    let entry = entered.clone();
+    let stopping = Arc::new(Notify::new());
+    let stopped = stopping.clone();
+    let release = Arc::new(Notify::new());
+    let released = release.clone();
+    let server = ProfileServer::spawn(
+        receive,
+        1,
+        move |_: (), cancel| {
+            let entry = entry.clone();
+            let stopped = stopped.clone();
+            let released = released.clone();
+            async move {
+                entry.notify_one();
+                cancel.cancelled().await;
+                stopped.notify_one();
+                released.notified().await;
+                Ok(())
+            }
+        },
+        |_| {},
+    )
+    .unwrap();
+    send.send(()).await.unwrap();
+    entered.notified().await;
+    send.send(()).await.unwrap();
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while server.stats().rejected_physical != 1 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    let control = server.clone();
+    let waiter = tokio::spawn(async move { control.shutdown().await });
+    stopping.notified().await;
+    waiter.abort();
+    let _ = waiter.await;
+    assert_eq!(server.stats().active_physical, 1);
+    release.notify_one();
+    server.shutdown().await.unwrap();
+    assert_eq!(server.stats().active_physical, 0);
+    assert_eq!(server.stats().accepted_physical, 1);
+    assert_eq!(server.stats().rejected_physical, 1);
