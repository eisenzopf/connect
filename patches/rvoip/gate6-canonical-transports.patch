--- /dev/null
+++ b/crates/uctp/rvoip-webtransport/src/canonical.rs
@@ -0,0 +1,133 @@
+//! Canonical connect/2 over one bidirectional WebTransport signaling stream.
+use bytes::Bytes;
+use rvoip_uctp::v2::{
+    auth_dispatch::DispatchError,
+    auth_peer::AUTHENTICATION_TIMEOUT,
+    reachability::PeerTransport,
+    server::{origin_allowed, CanonicalProfile, ProfileServer},
+    MAX_ENVELOPE_BYTES,
+};
+use std::{collections::HashSet, sync::Arc};
+use tokio::sync::mpsc;
+
+struct Close(quinn::Connection);
+impl Drop for Close {
+    fn drop(&mut self) {
+        self.0.close(0u32.into(), b"canonical-peer-retired");
+    }
+}
+
+/// A configured allowlist requires exactly one matching Origin. None explicitly
+/// enables a native deployment without browser Origin enforcement.
+pub fn start(
+    incoming: mpsc::Receiver<quinn::Connection>,
+    profile: CanonicalProfile,
+    contact: String,
+    mount: String,
+    origins: Option<HashSet<String>>,
+) -> Result<ProfileServer, DispatchError> {
+    if !mount.starts_with('/') || mount.contains(['?', '#']) {
+        return Err(DispatchError::Unsupported);
+    }
+    let origins = Arc::new(origins);
+    ProfileServer::spawn(
+        incoming,
+        profile.max_connections(),
+        move |connection, cancel| {
+            let profile = profile.clone();
+            let contact = contact.clone();
+            let mount = mount.clone();
+            let origins = origins.clone();
+            async move {
+                let _close = Close(connection.clone());
+                let alpn = connection
+                    .handshake_data()
+                    .and_then(|data| data.downcast::<quinn::crypto::rustls::HandshakeData>().ok())
+                    .and_then(|data| data.protocol.clone());
+                if alpn.as_deref() != Some(b"h3".as_slice()) {
+                    return Err(DispatchError::Unsupported);
+                }
+                let deadline = tokio::time::Instant::now() + AUTHENTICATION_TIMEOUT;
+                let peer = profile.peer(PeerTransport::WebTransport, &contact, cancel.clone())?;
+                let upgrade = async {
+                    let request = web_transport_quinn::Request::accept(connection)
+                        .await
+                        .map_err(|_| DispatchError::Closed)?;
+                    let valid_origin = origin_allowed(
+                        request
+                            .headers
+                            .get_all(http::header::ORIGIN)
+                            .iter()
+                            .map(|value| value.to_str().unwrap_or("")),
+                        origins.as_ref().as_ref(),
+                    );
+                    if request.url.path() != mount || !valid_origin {
+                        let status = if !valid_origin {
+                            http::StatusCode::FORBIDDEN
+                        } else {
+                            http::StatusCode::NOT_FOUND
+                        };
+                        let _ = request.reject(status).await;
+                        return Err(DispatchError::Authority);
+                    }
+                    let session = request.ok().await.map_err(|_| DispatchError::Closed)?;
+                    let (writer, reader) = session
+                        .accept_bi()
+                        .await
+                        .map_err(|_| DispatchError::Closed)?;
+                    Ok((session, writer, reader))
+                };
+                let (_session, mut transport_writer, reader) = tokio::select! {
+                    biased;
+                    _=cancel.cancelled()=>return Err(DispatchError::Closed),
+                    result=tokio::time::timeout_at(deadline,upgrade)=>result.map_err(|_|DispatchError::Closed)??,
+                };
+                // Retain the native read API: the Tokio adapter can lose the wake
+                // after consuming a coalesced WebTransport stream header.
+                let reader = futures::stream::unfold(
+                    crate::framing::EnvelopeReader::new(reader),
+                    |mut reader| async move {
+                        match reader.next_bytes().await {
+                            Ok(Some(bytes)) => Some((Ok(bytes), reader)),
+                            Ok(None) => None,
+                            Err(_) => Some((Err(DispatchError::Closed), reader)),
+                        }
+                    },
+                );
+                let writer = futures::sink::unfold(
+                    &mut transport_writer,
+                    |writer, bytes: Bytes| async move {
+                        if bytes.len() > MAX_ENVELOPE_BYTES {
+                            return Err(DispatchError::Closed);
+                        }
+                        let mut frame = Vec::with_capacity(4 + bytes.len());
+                        frame.extend_from_slice(&(bytes.len() as u32).to_be_bytes());
+                        frame.extend_from_slice(&bytes);
+                        writer
+                            .write_all(&frame)
+                            .await
+                            .map_err(|_| DispatchError::Closed)?;
+                        tokio::io::AsyncWriteExt::flush(writer)
+                            .await
+                            .map_err(|_| DispatchError::Closed)?;
+                        Ok(writer)
+                    },
+                );
+                let result = peer
+                    .run_frames(Box::pin(reader), Box::pin(writer), profile.handler.as_ref())
+                    .await;
+                // Keep the CONNECT session and physical connection until the
+                // signaling FIN is acknowledged, bounded by shutdown/one second.
+                if transport_writer.finish().is_ok() {
+                    tokio::select! {
+                        biased;
+                        _=cancel.cancelled()=>{},
+                        _=tokio::time::timeout(std::time::Duration::from_secs(1),transport_writer.stopped())=>{},
+                    }
+                }
+                result
+            }
+        },
+        |connection| connection.close(0u32.into(), b"canonical-admission-closed"),
+    )
+}
