+use futures::{Sink, Stream};
+use rvoip_uctp::v2::server::{CanonicalProfile, ProfileServer};
+use tokio::sync::mpsc;
+type Reader = std::pin::Pin<Box<dyn Stream<Item = Result<Bytes, DispatchError>> + Send>>;
+type Writer = std::pin::Pin<Box<dyn Sink<Bytes, Error = DispatchError> + Send>>;
+struct Wire {
+    reader: Reader,
+    writer: Writer,
+    server: ProfileServer,
+    quic: Option<(quinn::Endpoint, quinn::Endpoint, quinn::Connection)>,
+    wt: Option<web_transport_quinn::Session>,
+}
+impl Wire {
+    async fn send(&mut self, value: Vec<u8>) {
+        self.writer.send(Bytes::from(value)).await.unwrap();
+    }
+    async fn read(&mut self) -> Envelope {
+        let bytes = tokio::time::timeout(Duration::from_secs(3), self.reader.next())
+            .await
+            .expect("driver read deadline")
+            .expect("driver EOF")
+            .unwrap();
+        Envelope::parse(&bytes).unwrap()
+    }
+    async fn retired(&self) {
+        tokio::time::timeout(Duration::from_secs(3), async {
+            while self.server.stats().active_physical != 0 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+    }
+}
+async fn pair(
+    alpn: &[u8],
+) -> (
+    quinn::Endpoint,
+    quinn::Endpoint,
+    quinn::Connection,
+    quinn::Connection,
+) {
+    use rvoip_uctp::substrate::{
+        dev_client_config_trusting, make_server_endpoint, self_signed_for_dev,
+    };
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let (cert, key) = self_signed_for_dev(&["localhost".into()]).unwrap();
+    let mut tls = rustls::ServerConfig::builder()
+        .with_no_client_auth()
+        .with_single_cert(vec![cert.clone()], key)
+        .unwrap();
+    tls.alpn_protocols = vec![alpn.to_vec()];
+    let server = make_server_endpoint(
+        "127.0.0.1:0".parse().unwrap(),
+        Arc::new(tls),
+        quinn::TransportConfig::default(),
+    )
+    .unwrap();
+    let mut tls = dev_client_config_trusting(&cert).unwrap();
+    tls.alpn_protocols = vec![alpn.to_vec()];
+    let mut client = quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+    client.set_default_client_config(quinn::ClientConfig::new(Arc::new(
+        quinn::crypto::rustls::QuicClientConfig::try_from(tls).unwrap(),
+    )));
+    let connect = client
+        .connect(server.local_addr().unwrap(), "localhost")
+        .unwrap();
+    let accept = async { server.accept().await.unwrap().await.unwrap() };
+    let (remote, host) = tokio::join!(connect, accept);
+    (server, client, host, remote.unwrap())
+}
+async fn wire(
+    kind: &str,
+    profile: CanonicalProfile,
+    path: &str,
+    origin: Option<&str>,
+) -> Result<Wire, DispatchError> {
+    if kind == "quic" || kind == "wt" {
+        let (send, receive) = mpsc::channel(4);
+        let (host_ep, remote_ep, host, remote) =
+            pair(if kind == "quic" { RAW_QUIC_ALPN } else { b"h3" }).await;
+        let server = if kind == "quic" {
+            rvoip_quic::canonical::start(receive, profile, "quic://localhost:443".into())?
+        } else {
+            rvoip_webtransport::canonical::start(
+                receive,
+                profile,
+                "https://localhost/uctp".into(),
+                "/uctp".into(),
+                Some(HashSet::from(["https://allowed.example".into()])),
+            )?
+        };
+        send.send(host).await.unwrap();
+        let wt = if kind == "wt" {
+            let mut request = web_transport_quinn::proto::ConnectRequest::from(
+                url::Url::parse(&format!("https://localhost{path}")).unwrap(),
+            );
+            if let Some(origin) = origin {
+                request.headers.insert("origin", origin.parse().unwrap());
+            }
+            match tokio::time::timeout(
+                Duration::from_secs(3),
+                web_transport_quinn::Session::connect(remote.clone(), request),
+            )
+            .await
+            .unwrap()
+            {
+                Ok(session) => Some(session),
+                Err(_) => {
+                    server.shutdown().await?;
+                    return Err(DispatchError::Authority);
+                }
+            }
+        } else {
+            None
+        };
+        if let Some(session) = wt {
+            let (writer, reader) = session.open_bi().await.unwrap();
+            // Client fixture also uses the native read API and explicit bounds.
+            let reader = futures::stream::unfold(
+                (reader, Vec::<u8>::new()),
+                |(mut reader, mut buffered)| async move {
+                    loop {
+                        if buffered.len() >= 4 {
+                            let length =
+                                u32::from_be_bytes(buffered[..4].try_into().unwrap()) as usize;
+                            if length > 1024 * 1024 {
+                                return Some((Err(DispatchError::Closed), (reader, buffered)));
+                            }
+                            if buffered.len() >= length + 4 {
+                                let bytes = Bytes::copy_from_slice(&buffered[4..4 + length]);
+                                buffered.drain(..4 + length);
+                                return Some((Ok(bytes), (reader, buffered)));
+                            }
+                        }
+                        let mut chunk = [0u8; 65536];
+                        match reader.read(&mut chunk).await {
+                            Ok(Some(n)) => buffered.extend_from_slice(&chunk[..n]),
+                            _ => return None,
+                        }
+                    }
+                },
+            );
+            let writer = futures::sink::unfold(writer, |mut writer, bytes: Bytes| async move {
+                let mut frame = Vec::new();
+                frame.extend_from_slice(&(bytes.len() as u32).to_be_bytes());
+                frame.extend_from_slice(&bytes);
+                writer
+                    .write_all(&frame)
+                    .await
+                    .map_err(|_| DispatchError::Closed)?;
+                tokio::io::AsyncWriteExt::flush(&mut writer)
+                    .await
+                    .map_err(|_| DispatchError::Closed)?;
+                Ok(writer)
+            });
+            Ok(Wire {
+                reader: Box::pin(reader),
+                writer: Box::pin(writer),
+                server,
+                quic: Some((host_ep, remote_ep, remote)),
+                wt: Some(session),
+            })
+        } else {
+            let (writer, reader) = remote.open_bi().await.unwrap();
+            let reader = FramedRead::new(reader, rvoip_uctp::substrate::length_prefixed_codec())
+                .map(|frame| {
+                    frame
+                        .map(|bytes| bytes.freeze())
+                        .map_err(|_| DispatchError::Closed)
+                });
+            let writer = FramedWrite::new(writer, rvoip_uctp::substrate::length_prefixed_codec())
+                .sink_map_err(|_| DispatchError::Closed);
+            Ok(Wire {
+                reader: Box::pin(reader),
+                writer: Box::pin(writer),
+                server,
+                quic: Some((host_ep, remote_ep, remote)),
+                wt: None,
+            })
+        }
+    } else {
+        let (send, receive) = mpsc::channel(4);
+        use rvoip_uctp::substrate::{dev_client_config_trusting, self_signed_for_dev};
+        use tokio_tungstenite::{
+            tungstenite::{client::IntoClientRequest, Message},
+            Connector,
+        };
+        let _ = rustls::crypto::ring::default_provider().install_default();
+        let (cert, key) = self_signed_for_dev(&["localhost".into()]).unwrap();
+        let tls = rustls::ServerConfig::builder()
+            .with_no_client_auth()
+            .with_single_cert(vec![cert.clone()], key)
+            .unwrap();
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let server = rvoip_websocket::canonical::start(
+            receive,
+            Arc::new(tls),
+            profile,
+            "wss://localhost/uctp".into(),
+            "/uctp".into(),
+            Some(HashSet::from(["https://allowed.example".into()])),
+        )?;
+        let mut request = format!("wss://localhost:{}{path}", addr.port())
+            .into_client_request()
+            .unwrap();
+        if let Some(origin) = origin {
+            request
+                .headers_mut()
+                .insert("origin", origin.parse().unwrap());
+        }
+        let connect = tokio_tungstenite::connect_async_tls_with_config(
+            request,
+            None,
+            false,
+            Some(Connector::Rustls(Arc::new(
+                dev_client_config_trusting(&cert).unwrap(),
+            ))),
+        );
+        let accept = async {
+            let (socket, _) = listener.accept().await.unwrap();
+            send.send(socket).await.unwrap();
+        };
+        let (connected, _) = tokio::join!(connect, accept);
+        let (ws, _) = match connected {
+            Ok(pair) => pair,
+            Err(_) => {
+                server.shutdown().await?;
+                return Err(DispatchError::Authority);
+            }
+        };
+        let (writer, reader) = ws.split();
+        let reader = reader.map(|message| match message {
+            Ok(Message::Text(text)) => Ok(Bytes::copy_from_slice(text.as_bytes())),
+            _ => Err(DispatchError::Closed),
+        });
+        let writer = writer
+            .with(|bytes: Bytes| async move {
+                Ok::<_, tokio_tungstenite::tungstenite::Error>(Message::Text(
+                    String::from_utf8(bytes.to_vec()).unwrap().into(),
+                ))
+            })
+            .sink_map_err(|_| DispatchError::Closed);
+        Ok(Wire {
+            reader: Box::pin(reader),
+            writer: Box::pin(writer),
+            server,
+            quic: None,
+            wt: None,
+        })
+    }
+}
+async fn authenticate_wire(wire: &mut Wire, f: &Fixture) -> Envelope {
+    wire.send(serde_json::to_vec(&hello()).unwrap()).await;
+    let challenge = wire.read().await;
+    assert_eq!(challenge.kind(), "auth.challenge");
+    f.verify_server(&challenge).await;
+    wire.send(f.sign(response(&challenge, "old"))).await;
+    let session = wire.read().await;
+    assert_eq!(session.kind(), "auth.session");
+    f.verify_server(&session).await;
+    session
+}
+async fn lifecycle(kind: &str) {
+    let f = Fixture::new();
+    let handler = Arc::new(Handler::default());
+    let profile = CanonicalProfile::new(f.config.clone(), handler.clone(), 8).unwrap();
+    let mut wire = wire(kind, profile, "/uctp", Some("https://allowed.example"))
+        .await
+        .unwrap();
+    let session = authenticate_wire(&mut wire, &f).await;
+    wire.send(f.sign(command())).await;
+    let reply = wire.read().await;
+    f.verify_server(&reply).await;
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 1);
+    wire.send(f.sign(envelope(
+        "auth.refresh",
+        json!({"method":"bearer","credential":"new"}),
+    )))
+    .await;
+    let next = wire.read().await;
+    assert_eq!(next.kind(), "auth.session");
+    f.verify_server(&next).await;
+    assert_ne!(
+        session.original()["payload"]["session_token"],
+        next.original()["payload"]["session_token"]
+    );
+    wire.server.begin_drain();
+    assert!(wire.server.is_draining());
+    wire.send(f.sign(command())).await;
+    let _ = wire.read().await;
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 2);
+    wire.server.shutdown().await.unwrap();
+    wire.retired().await;
+    assert_eq!(wire.server.stats().accepted_physical, 1);
+}
