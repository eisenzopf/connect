+use rvoip_uctp::v2::reachability::{ReachabilityRegistry, RouteAuthority, RouteHandle};
+struct RoutePolicy {
+    policy: Arc<Policy>,
+    tokens: std::sync::Mutex<std::collections::HashMap<(String, String), CancellationToken>>,
+    deny: AtomicBool,
+    deny_lifetime: AtomicBool,
+    hold: AtomicBool,
+    entered: Notify,
+    release: Notify,
+    deliveries: AtomicUsize,
+}
+impl RoutePolicy {
+    fn new(policy: Arc<Policy>) -> Arc<Self> {
+        Arc::new(Self {
+            policy,
+            tokens: std::sync::Mutex::new(std::collections::HashMap::new()),
+            deny: AtomicBool::new(false),
+            deny_lifetime: AtomicBool::new(false),
+            hold: AtomicBool::new(false),
+            entered: Notify::new(),
+            release: Notify::new(),
+            deliveries: AtomicUsize::new(0),
+        })
+    }
+    fn revoke(&self, token: &str, device: &str) {
+        if let Some(token) = self
+            .tokens
+            .lock()
+            .unwrap()
+            .get(&(token.into(), device.into()))
+        {
+            token.cancel();
+        }
+    }
+}
+#[async_trait]
+impl RouteAuthority for RoutePolicy {
+    fn lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        _: &Identifier,
+    ) -> Result<CancellationToken, DispatchError> {
+        if self.deny_lifetime.load(Ordering::SeqCst) {
+            return Err(DispatchError::Authority);
+        }
+        let key = (
+            c.token_id.clone().ok_or(DispatchError::Authority)?,
+            d.id.as_str().to_owned(),
+        );
+        Ok(self.tokens.lock().unwrap().entry(key).or_default().clone())
+    }
+    async fn delivery(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.deliveries.fetch_add(1, Ordering::SeqCst);
+        self.entered.notify_one();
+        if self.hold.load(Ordering::SeqCst) {
+            self.release.notified().await;
+        }
+        if self.deny.load(Ordering::SeqCst)
+            || !c.principal.has_scope("control")
+            || e.scope(Scope::Conversation) != Some("conversation")
+        {
+            return Err(DispatchError::Authority);
+        }
+        self.policy.guard(c, d, i, e).await
+    }
+}
+fn owner() -> rvoip_auth_core::PrincipalOwnershipKey {
+    principal("old").ownership_key()
+}
+fn identity() -> Identifier {
+    Identifier::try_from("identity-alice".to_owned()).unwrap()
+}
+fn event() -> Envelope {
+    let mut value = envelope(
+        "conversation.event",
+        json!({"event_id":"event-fixture","cursor":"cursor-fixture","kind":"fixture","revision":1,"data":{"text":"guarded-route-payload"}}),
+    );
+    value["cid"] = json!("conversation");
+    value["operation_id"] = json!("logical-route-operation");
+    Envelope::from_value(value).unwrap()
+}
+fn routes(registry: &ReachabilityRegistry) -> Vec<RouteHandle> {
+    registry.routes_for(&owner(), &identity()).unwrap()
+}
+async fn routed_lifecycle(kind: &str) {
+    let f = Fixture::new();
+    let handler = Arc::new(Handler::default());
+    let registry = ReachabilityRegistry::new(8).unwrap();
+    let policy = RoutePolicy::new(f.policy.clone());
+    let profile = CanonicalProfile::new(f.config.clone(), handler, 8)
+        .unwrap()
+        .with_reachability(
+            registry.clone(),
+            policy.clone(),
+            Duration::from_secs(30),
+            10,
+        )
+        .unwrap();
+    let mut wire = wire(kind, profile, "/uctp", Some("https://allowed.example"))
+        .await
+        .unwrap();
+    assert!(routes(&registry).is_empty());
+    let session = authenticate_wire(&mut wire, &f).await;
+    assert_eq!(
+        session.original()["payload"]["reachability"][0]["transport"],
+        match kind {
+            "quic" => "quic",
+            "wt" => "webtransport",
+            _ => "websocket",
+        }
+    );
+    let old = routes(&registry).pop().unwrap();
+    let sent = old.submit(event(), deadline()).await.unwrap();
+    let observed = wire.read().await;
+    assert_eq!(observed.id(), sent.envelope_id().as_str());
+    assert_eq!(observed.kind(), "conversation.event");
+    f.verify_server(&observed).await;
+    policy.deny.store(true, Ordering::SeqCst);
+    assert!(matches!(
+        old.submit(event(), deadline()).await,
+        Err(DispatchError::Authority)
+    ));
+    policy.deny.store(false, Ordering::SeqCst);
+    wire.send(f.sign(envelope(
+        "auth.refresh",
+        json!({"method":"bearer","credential":"new"}),
+    )))
+    .await;
+    assert_eq!(wire.read().await.kind(), "auth.session");
+    assert!(old.submit(event(), deadline()).await.is_err());
+    assert_eq!(routes(&registry).len(), 1);
+    let current = routes(&registry).pop().unwrap();
+    current.submit(event(), deadline()).await.unwrap();
+    let observed = wire.read().await;
+    f.verify_server(&observed).await;
+    policy.revoke("new", "device-alice");
+    let bye = wire.read().await;
+    assert_eq!(bye.kind(), "auth.bye");
+    f.verify_server(&bye).await;
+    wire.retired().await;
+    assert!(routes(&registry).is_empty());
+    assert!(current.submit(event(), deadline()).await.is_err());
+    wire.server.shutdown().await.unwrap();
+}
