diff --git a/crates/uctp/rvoip-uctp/src/v2/server.rs b/crates/uctp/rvoip-uctp/src/v2/server.rs
new file mode 100644
index 0000000..4e7dfff
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/src/v2/server.rs
@@ -0,0 +1,235 @@
+//! Shared canonical profile construction and retained transport task supervision.
+use super::{
+    auth_dispatch::{AuthenticatedHandler, DispatchError},
+    auth_peer::{CanonicalPeer, PeerConfig},
+    reachability::{PeerTransport, ReachabilityRegistry, RouteAuthority, TrustedPeerRoute},
+};
+use futures::{
+    future::{BoxFuture, Shared},
+    FutureExt,
+};
+use std::{
+    future::Future,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+use tokio::{
+    sync::{mpsc, Semaphore},
+    task::JoinSet,
+};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+pub struct CanonicalProfile {
+    peer: Arc<PeerConfig>,
+    pub handler: Arc<dyn AuthenticatedHandler>,
+    max_connections: usize,
+    routes: Option<(
+        Arc<ReachabilityRegistry>,
+        Arc<dyn RouteAuthority>,
+        Duration,
+        u16,
+    )>,
+}
+impl CanonicalProfile {
+    pub fn new(
+        peer: Arc<PeerConfig>,
+        handler: Arc<dyn AuthenticatedHandler>,
+        max_connections: usize,
+    ) -> Result<Self, DispatchError> {
+        if max_connections == 0 || max_connections > 4096 {
+            return Err(DispatchError::Capacity);
+        }
+        Ok(Self {
+            peer,
+            handler,
+            max_connections,
+            routes: None,
+        })
+    }
+    pub fn with_reachability(
+        mut self,
+        registry: Arc<ReachabilityRegistry>,
+        authority: Arc<dyn RouteAuthority>,
+        lease: Duration,
+        priority: u16,
+    ) -> Result<Self, DispatchError> {
+        TrustedPeerRoute::new(PeerTransport::Quic, "configured-contact", priority, lease)?;
+        self.routes = Some((registry, authority, lease, priority));
+        Ok(self)
+    }
+    pub fn peer(
+        &self,
+        transport: PeerTransport,
+        contact: &str,
+        parent: CancellationToken,
+    ) -> Result<CanonicalPeer, DispatchError> {
+        match &self.routes {
+            Some((registry, authority, lease, priority)) => CanonicalPeer::with_reachability(
+                self.peer.clone(),
+                parent,
+                registry.clone(),
+                TrustedPeerRoute::new(transport, contact, *priority, *lease)?,
+                authority.clone(),
+            ),
+            None => CanonicalPeer::new(self.peer.clone(), parent),
+        }
+    }
+    pub fn max_connections(&self) -> usize {
+        self.max_connections
+    }
+}
+
+#[derive(Default)]
+struct Counters {
+    accepted: AtomicUsize,
+    rejected: AtomicUsize,
+    active: AtomicUsize,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ServerStats {
+    pub accepted_physical: usize,
+    pub rejected_physical: usize,
+    pub active_physical: usize,
+}
+struct Active(Arc<Counters>);
+impl Drop for Active {
+    fn drop(&mut self) {
+        self.0.active.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+struct Inner {
+    drain: CancellationToken,
+    shutdown: CancellationToken,
+    join: Shared<BoxFuture<'static, Result<(), DispatchError>>>,
+    counters: Arc<Counters>,
+}
+impl Drop for Inner {
+    fn drop(&mut self) {
+        self.drain.cancel();
+        self.shutdown.cancel();
+    }
+}
+
+/// Clones share one owner. Dropping the last control cancels the supervisor;
+/// explicit shutdown retains/awaits its task even if a previous wait is dropped.
+#[derive(Clone)]
+pub struct ProfileServer {
+    inner: Arc<Inner>,
+}
+impl ProfileServer {
+    pub fn spawn<A, F, Fut, G>(
+        mut incoming: mpsc::Receiver<A>,
+        max: usize,
+        serve: F,
+        reject: G,
+    ) -> Result<Self, DispatchError>
+    where
+        A: Send + 'static,
+        F: Fn(A, CancellationToken) -> Fut + Send + Sync + 'static,
+        Fut: Future<Output = Result<(), DispatchError>> + Send + 'static,
+        G: Fn(A) + Send + 'static,
+    {
+        if max == 0 || max > 4096 || incoming.max_capacity() > 4096 {
+            return Err(DispatchError::Capacity);
+        }
+        let drain = CancellationToken::new();
+        let shutdown = CancellationToken::new();
+        let d = drain.clone();
+        let s = shutdown.clone();
+        let counters = Arc::new(Counters::default());
+        let counts = counters.clone();
+        let serve = Arc::new(serve);
+        let task = tokio::spawn(async move {
+            let slots = Arc::new(Semaphore::new(max));
+            let mut peers = JoinSet::new();
+            let mut admitting = true;
+            let mut failed = false;
+            loop {
+                tokio::select! {
+                    biased;
+                    _=s.cancelled()=>break,
+                    _=d.cancelled(),if admitting=>{admitting=false;incoming.close();while let Ok(peer)=incoming.try_recv(){counts.rejected.fetch_add(1,Ordering::AcqRel);reject(peer);}},
+                    completed=peers.join_next(),if !peers.is_empty()=>{if completed.is_some_and(|result|result.is_err()){failed=true;s.cancel();}},
+                    peer=incoming.recv(),if admitting=>match peer {
+                        Some(peer)=>{
+                            let permit=match slots.clone().try_acquire_owned(){Ok(permit)=>permit,Err(_)=>{counts.rejected.fetch_add(1,Ordering::AcqRel);reject(peer);continue;}};
+                            counts.accepted.fetch_add(1,Ordering::AcqRel);counts.active.fetch_add(1,Ordering::AcqRel);let active=Active(counts.clone());let serve=serve.clone();let cancel=s.child_token();
+                            peers.spawn(async move{let _permit=permit;let _active=active;serve(peer,cancel).await});
+                        }
+                        None=>{admitting=false;},
+                    },
+                    else=>break,
+                }
+                if !admitting && peers.is_empty() {
+                    break;
+                }
+            }
+            incoming.close();
+            while let Ok(peer) = incoming.try_recv() {
+                counts.rejected.fetch_add(1, Ordering::AcqRel);
+                reject(peer);
+            }
+            s.cancel();
+            let drained = tokio::time::timeout(Duration::from_secs(2), async {
+                while peers.join_next().await.is_some() {}
+            })
+            .await;
+            if drained.is_err() {
+                peers.abort_all();
+                while peers.join_next().await.is_some() {}
+            }
+            if failed {
+                Err(DispatchError::Closed)
+            } else {
+                Ok(())
+            }
+        });
+        let join = async move { task.await.map_err(|_| DispatchError::Closed)? }
+            .boxed()
+            .shared();
+        Ok(Self {
+            inner: Arc::new(Inner {
+                drain,
+                shutdown,
+                join,
+                counters,
+            }),
+        })
+    }
+    /// Stop admission while active peers retain their own normal lifetime.
+    pub fn begin_drain(&self) {
+        self.inner.drain.cancel();
+    }
+    pub fn is_draining(&self) -> bool {
+        self.inner.drain.is_cancelled()
+    }
+    pub async fn shutdown(&self) -> Result<(), DispatchError> {
+        self.inner.drain.cancel();
+        self.inner.shutdown.cancel();
+        self.inner.join.clone().await
+    }
+    pub fn stats(&self) -> ServerStats {
+        ServerStats {
+            accepted_physical: self.inner.counters.accepted.load(Ordering::Acquire),
+            rejected_physical: self.inner.counters.rejected.load(Ordering::Acquire),
+            active_physical: self.inner.counters.active.load(Ordering::Acquire),
+        }
+    }
+}
+
+/// Exact origin checking shared by HTTP upgrade drivers. A native deployment
+/// may explicitly use None; configured browser origins require one exact value.
+pub fn origin_allowed<'a>(
+    origins: impl IntoIterator<Item = &'a str>,
+    allowed: Option<&std::collections::HashSet<String>>,
+) -> bool {
+    let Some(allowed) = allowed else {
+        return true;
+    };
+    let mut origins = origins.into_iter();
+    matches!(origins.next(),Some(origin) if allowed.contains(origin)) && origins.next().is_none()
+}
