+
+#[tokio::test]
+async fn actual_native_source_contention_preserves_not_ready_and_never_revives_retirement() {
+    for kind in ["quic", "wt"] {
+        let mut r = RouteRig::new(kind).await;
+        let observed = r.observation("8", 100, "info").await;
+        let controller = r.scene.controller();
+        let held_controller = controller.clone();
+        let principal = observed.principal().clone();
+        let revision = observed.stream_revision();
+        let credential = observed.credential_revision();
+        let audio = observed.audio_bindings().to_vec();
+        let (entered, ready) = std::sync::mpsc::channel();
+        let (release, wait) = std::sync::mpsc::channel();
+        let holding = std::thread::spawn(move || {
+            held_controller.poll_dtmf_source_io(
+                &principal,
+                revision,
+                credential,
+                &audio,
+                &mut || {
+                    entered.send(()).unwrap();
+                    wait.recv_timeout(Duration::from_secs(2)).unwrap();
+                    std::task::Poll::Ready(Ok(()))
+                },
+            )
+        });
+        ready.recv_timeout(Duration::from_secs(2)).unwrap();
+        let result = observed.prepare_core_route(&r.scene.native.core.orch, r.target.clone());
+        release.send(()).unwrap();
+        assert_eq!(holding.join().unwrap(), std::task::Poll::Ready(Ok(())));
+        assert!(
+            matches!(result, Err(DtmfWriteError::NotReady)),
+            "busy actual source was classified as retired: {result:?}"
+        );
+        r.peer.no_info(Duration::from_millis(30)).await;
+        let policy = SignalPolicy::new(&r, &observed);
+        let sending = r.start(&observed, policy);
+        r.peer.next().await;
+        assert_eq!(sending.await.unwrap(), Ok(()));
+        r.peer.no_info(Duration::from_millis(30)).await;
+        controller.retire();
+        assert!(matches!(
+            observed.prepare_core_route(&r.scene.native.core.orch, r.target.clone()),
+            Err(DtmfWriteError::Refused)
+        ));
+        r.stop().await;
+    }
+}
