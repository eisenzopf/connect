+
+#[tokio::test]
+async fn public_video_reservation_keeps_its_original_lifetime_after_installation_control_expires() {
+    let mut room = ManagedRoom::with_video(true).await;
+    let result = catch_original(async {
+        let (alice, old, source) = actors(&mut room).await;
+        let mut next = domain(&room.conversation, &room.session, "reserve-lifetime-next", "alice");
+        let value = Arc::get_mut(&mut next).unwrap();
+        value.principal = alice.principal.clone();
+        value.member = alice.member.clone();
+        let (root, grant, _signal, _context, _probe) =
+            room.prepare_move(&old, &source, next).await;
+
+        let mut capture = grant.clone();
+        capture.until = tokio::time::Instant::now();
+        assert!(room.orch.prepare_staged_public_video_reservation_with_held(
+            &root, &b_id(), &capture,
+        ).is_err());
+
+        capture.until += Duration::from_millis(100);
+        let reservation = room.orch.prepare_staged_public_video_reservation_with_held(
+            &root, &b_id(), &capture,
+        ).unwrap();
+        tokio::time::sleep_until(capture.until).await;
+        assert!(tokio::time::Instant::now() < grant.until);
+        assert!(reservation.is_current() && reservation.matches_original_preparation(&root));
+        assert!(room.nodes[&old].backend.port(Medium::Video).0.ticket(TicketSide::Egress).is_active());
+
+        root.cancellation().cancel();
+        assert!(reservation.is_current(), "a consumer's child token cannot cancel the original");
+        assert!(root.cancel());
+        assert!(!reservation.is_current());
+    }).await;
+    let cleanup = room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done| done));
+    if let Err(error) = result {
+        resume_unwind(error);
+    }
 }
 
