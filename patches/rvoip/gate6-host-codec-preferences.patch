+    /// Host policy orders only formats also offered by the peer and supported
+    /// by the current profile. It never changes capabilities or grants IO.
+    pub fn with_codec_preferences(
+        mut self,
+        preferences: &[String],
+    ) -> Result<Self, NativeOfferError> {
+        if preferences.len() > 32 {
+            return Err(NativeOfferError::Capacity);
+        }
+        let mut seen = BTreeSet::new();
+        let mut names = Vec::new();
+        for preference in preferences {
+            if preference.is_empty()
+                || preference.len() > 64
+                || !preference
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"-._/".contains(&b))
+            {
+                return Err(NativeOfferError::Invalid);
+            }
+            let name = normalize(preference).to_owned();
+            if !seen.insert(name.clone()) {
+                return Err(NativeOfferError::Invalid);
+            }
+            names.push(name);
+        }
+        self.codec_preferences = names;
+        Ok(self)
+    }
