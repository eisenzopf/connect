+#[test]
+fn host_codec_preferences_order_only_current_compatible_peer_offers_without_mutating_capabilities()
+{
+    let original = offer();
+    let wire = serde_json::to_value(&original).unwrap();
+    let base = profile();
+    let capabilities = base.capabilities().clone();
+    let preferred = base
+        .clone()
+        .with_codec_preferences(&["g.711-mu".into()])
+        .unwrap();
+    let selected = NativeOfferPlan::parse(&original, &preferred, &actor()).unwrap();
+    assert!(selected
+        .selected()
+        .iter()
+        .all(|s| s.format == audio("pcmu")));
+    assert_eq!(preferred.capabilities(), &capabilities);
+    assert_eq!(serde_json::to_value(&original).unwrap(), wire);
+    let unsupported = base
+        .clone()
+        .with_codec_preferences(&["unoffered".into()])
+        .unwrap();
+    let fallback = NativeOfferPlan::parse(&original, &unsupported, &actor()).unwrap();
+    assert_eq!(fallback.selected()[0].format, audio("pcma"));
+    assert_eq!(fallback.selected()[1].format, audio("pcmu"));
+    let mut only_pcma = original.clone();
+    for stream in &mut only_pcma.streams_offered {
+        stream.codec_preferences = vec!["pcma".into()];
+    }
+    let absent = NativeOfferPlan::parse(&only_pcma, &preferred, &actor()).unwrap();
+    assert!(absent.selected().iter().all(|s| s.format == audio("pcma")));
+}
+#[test]
+fn host_codec_preferences_are_bounded_and_reject_alias_duplicates() {
+    assert!(profile()
+        .with_codec_preferences(&vec!["pcmu".into(); 33])
+        .is_err());
+    for names in [
+        vec!["pcmu", "g.711-mu"],
+        vec!["bad name"],
+        vec![""],
+        vec!["pcma", "PCMA"],
+    ] {
+        assert!(profile()
+            .with_codec_preferences(&names.into_iter().map(str::to_owned).collect::<Vec<_>>())
+            .is_err());
+    }
+}
