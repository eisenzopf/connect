+
+/// Prospective phase3 causal control, not a production change: a video sink-only
+/// freeze must not discard an already-owned camera input while current camera
+/// authority remains allowed. OLD is expected to fail the final camera oracle;
+/// setup, sink refusal, fresh camera/audio and all cleanup must qualify first.
+#[tokio::test]
+async fn directional_video_sink_hold_preserves_original_camera_ingress_after_cleanup() {
+    use crate::staged_streams::direct_subscriptions::{
+        DirectSubscription, DirectSubscriptionChange,
+    };
+    let f = Fixture::new(8);
+    let video_id = desired(Medium::Video).logical_id;
+    let audio_id = desired(Medium::Audio).logical_id;
+    let sink_io = Arc::new(AtomicUsize::new(0));
+    let audio_io = Arc::new(AtomicUsize::new(0));
+    let work = async {
+        f.start(&[Medium::Audio, Medium::Video]).await;
+        // f.start installs A camera -> B sink. Add the actual reverse video
+        // selection so OLD A has a real queued sink packet before its hold.
+        f.a.change_direct_subscriptions(
+            f.a.revision(),
+            DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                &f.b,
+                video_id.clone(),
+                video_id.clone(),
+            )]),
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+        .unwrap();
+        let a_video = f.aa.port(Medium::Video);
+        let b_video = f.ba.port(Medium::Video);
+        let a_audio = f.aa.port(Medium::Audio);
+        let b_audio = f.ba.port(Medium::Audio);
+        let mut camera_input = f.a.take_ingress(&video_id).unwrap();
+        let mut remote_video = f.b.take_ingress(&video_id).unwrap();
+        let mut remote_audio = f.b.take_ingress(&audio_id).unwrap();
+        let mut old_sink = a_video.take_egress().unwrap();
+        let mut audio_sink = a_audio.take_egress().unwrap();
+        let original_frame = frame(&a_video, 18000);
+        let original_at = Instant::now();
+        let mut original_camera = a_video
+            .retain_original_ingress(original_frame.clone(), original_at)
+            .unwrap()
+            .unwrap();
+        b_video.try_publish(&frame(&b_video, 9000)).unwrap();
+        receive(&mut remote_video)
+            .await
+            .try_forward_to(&f.a, &video_id)
+            .unwrap();
+        let old_sink_packet = outgoing(&mut old_sink).await;
+        b_audio.try_publish(&frame(&b_audio, 160)).unwrap();
+        receive(&mut remote_audio)
+            .await
+            .try_forward_to(&f.a, &audio_id)
+            .unwrap();
+        let old_audio_packet = outgoing(&mut audio_sink).await;
+        let ids = [video_id.clone()].into_iter().collect();
+        let before = f.a.revision();
+        let (after, changed) =
+            f.a.set_media_gate(
+                before,
+                &ids,
+                StreamGateAction::Hold {
+                    direction: StreamDirection::Receive,
+                },
+                deadline(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(after, before + 1);
+        assert_eq!(changed.len(), 1);
+        assert!(
+            changed[0].permits(false),
+            "CoreReceive keeps client camera publication allowed"
+        );
+        assert!(
+            !changed[0].permits(true),
+            "CoreSend OLD receive sink must be frozen"
+        );
+        let old_sink_result = old_sink_packet
+            .deliver_with_origin(|_, _| async {
+                sink_io.fetch_add(1, Ordering::SeqCst);
+                Ok(())
+            })
+            .await;
+        let audio_result = old_audio_packet
+            .deliver_with_origin(|_, _| async {
+                audio_io.fetch_add(1, Ordering::SeqCst);
+                Ok(())
+            })
+            .await;
+        // Observe SAME original capture outcome; never recreate it, swap its
+        // receive time or call a fresh-frame API as a substitute.
+        let camera_age = original_at.elapsed();
+        assert!(
+            camera_age < Duration::from_millis(200),
+            "Original camera age expired before causal check: {camera_age:?}"
+        );
+        let camera_result = original_camera.try_publish_clocked(|_| None);
+        if camera_result.is_ok() {
+            let packet = receive(&mut camera_input).await;
+            assert_eq!(packet.frame.timestamp_rtp, original_frame.timestamp_rtp);
+            assert_eq!(packet.frame.payload, original_frame.payload);
+            assert_eq!(packet.admitted_at, original_at);
+        } else {
+            assert!(camera_input.try_recv().is_err());
+        }
+        // Real current admission remains independently positive after the hold.
+        let fresh = frame(&a_video, 27000);
+        a_video.try_publish(&fresh).unwrap();
+        let fresh_packet = receive(&mut camera_input).await;
+        assert_eq!(fresh_packet.frame.payload, fresh.payload);
+        assert_eq!(fresh_packet.frame.timestamp_rtp, fresh.timestamp_rtp);
+        assert!(old_sink.try_recv().is_err());
+        assert!(audio_sink.try_recv().is_err());
+        drop(original_camera);
+        (camera_result, old_sink_result, audio_result)
+    };
+    // Join every original controller even if a setup/control assertion panics.
+    // The expected OLD leaf is asserted only AFTER original cleanup markers.
+    let mut work = Box::pin(work);
+    let outcome = std::future::poll_fn(|cx| {
+        match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            std::future::Future::poll(work.as_mut(), cx)
+        })) {
+            Ok(std::task::Poll::Ready(value)) => std::task::Poll::Ready(Ok(value)),
+            Ok(std::task::Poll::Pending) => std::task::Poll::Pending,
+            Err(error) => std::task::Poll::Ready(Err(error)),
+        }
+    })
+    .await;
+    drop(work);
+    let a_remaining = f.a.shutdown(deadline()).await;
+    let b_remaining = f.b.shutdown(deadline()).await;
+    assert_eq!(a_remaining, 0, "original A controller cleanup");
+    assert_eq!(b_remaining, 0, "original B controller cleanup");
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(f.ba.outstanding.load(Ordering::Acquire), 0);
+    eprintln!("DIRECTIONAL_HOLD_COUNTER original_controllers_closed=true adapters_outstanding=0");
+    let (camera_result, sink_result, audio_result) = match outcome {
+        Ok(value) => value,
+        Err(error) => std::panic::resume_unwind(error),
+    };
+    assert!(
+        sink_result.is_err(),
+        "OLD sink unexpectedly admitted after hold"
+    );
+    assert_eq!(
+        sink_io.load(Ordering::Acquire),
+        0,
+        "OLD sink callback entered"
+    );
+    assert!(
+        audio_result.is_ok(),
+        "Unrelated original audio refused: {audio_result:?}"
+    );
+    assert_eq!(audio_io.load(Ordering::Acquire), 1);
+    eprintln!("DIRECTIONAL_HOLD_COUNTER sink_refused=true sink_io=0 original_audio_io=1 fresh_camera_passed=true original_camera={camera_result:?}");
+    assert!(camera_result.is_ok(),"directional sink-only hold discarded SAME original camera ingress while current camera authority remains allowed: {camera_result:?}");
+}
