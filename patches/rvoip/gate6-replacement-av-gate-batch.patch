+#[test]
+fn replacement_audio_video_gates_commit_once_and_refuse_whole_invalid_batches() {
+    let f = Fixture::new();
+    let mut state = StreamLifecycle::new(&f.authority()).unwrap();
+    let now = Instant::now();
+    let p = profile();
+    let prepared = state
+        .prepare(
+            &f.authority(),
+            0,
+            &p,
+            &p,
+            &[
+                desired("audio", Medium::Audio),
+                desired("camera", Medium::Video),
+                desired("data", Medium::Data),
+                desired("screen", Medium::Screen),
+            ],
+            now,
+            now + Duration::from_secs(10),
+        )
+        .unwrap();
+    state
+        .commit(&f.authority(), &prepared, &bindings(&prepared), now)
+        .unwrap();
+    let audio_id = StreamId::from_string("audio");
+    let video_id = StreamId::from_string("camera");
+    let before = state.streams().clone();
+    let mut old_audio = before[&audio_id].clone();
+    old_audio.state = LogicalStreamState::Paused;
+    old_audio.source_muted = true;
+    old_audio.hold_direction = Some(StreamDirection::Receive);
+    old_audio.transport_id = StreamId::from_string("old-device-audio");
+    old_audio.stream_local_id = 99;
+    old_audio.generation = 77;
+    old_audio.negotiated.requested.logical_id = StreamId::from_string("old-logical-audio");
+    old_audio.negotiated.format = audio();
+    let mut old_video = before[&video_id].clone();
+    old_video.source_muted = true; // Deliberately muted camera must stay muted.
+    old_video.transport_id = StreamId::from_string("old-device-camera");
+    let intended = vec![
+        (audio_id.clone(), old_audio.clone()),
+        (video_id.clone(), old_video.clone()),
+    ];
+    let mut ended_video = old_video.clone();
+    ended_video.state = LogicalStreamState::Ended;
+    let mut wrong_medium = old_video.clone();
+    wrong_medium.negotiated.requested.medium = Medium::Data;
+    let invalid = vec![
+        vec![],
+        vec![
+            (audio_id.clone(), old_audio.clone()),
+            (audio_id.clone(), old_audio.clone()),
+        ],
+        vec![
+            (audio_id.clone(), old_audio.clone()),
+            (StreamId::from_string("absent"), old_video.clone()),
+        ],
+        vec![
+            (audio_id.clone(), old_audio.clone()),
+            (video_id.clone(), ended_video),
+        ],
+        vec![
+            (audio_id.clone(), old_audio.clone()),
+            (video_id.clone(), wrong_medium),
+        ],
+        vec![(audio_id.clone(), old_video.clone())],
+        vec![(
+            StreamId::from_string("data"),
+            before[&StreamId::from_string("data")].clone(),
+        )],
+        vec![(
+            StreamId::from_string("screen"),
+            before[&StreamId::from_string("screen")].clone(),
+        )],
+    ];
+    for batch in invalid {
+        assert!(
+            state
+                .inherit_replacement_gates(&f.authority(), 1, &batch, true)
+                .is_err()
+        );
+        assert_eq!(state.revision(), 1);
+        assert_eq!(
+            state.streams(),
+            &before,
+            "invalid later member must not partially transfer audio"
+        );
+    }
+    let mut denied = f.authority();
+    denied.receive_media.remove(&Medium::Video);
+    assert_eq!(
+        state.inherit_replacement_gates(&denied, 1, &intended, true),
+        Err(MediaTransitionError::Authority)
+    );
+    assert_eq!(
+        state.inherit_replacement_gates(&f.authority(), 0, &intended, true),
+        Err(MediaTransitionError::Conflict)
+    );
+    assert_eq!(state.streams(), &before);
+    assert_eq!(state.revision(), 1);
+    state
+        .inherit_replacement_gates(&f.authority(), 1, &intended, true)
+        .unwrap();
+    assert_eq!(state.revision(), 2, "audio and video share one revision");
+    let mut expected = before.clone();
+    for (id, source) in &intended {
+        let target = expected.get_mut(id).unwrap();
+        target.state = source.state;
+        target.source_muted = source.source_muted;
+        target.hold_direction = source.hold_direction;
+    }
+    assert_eq!(
+        state.streams(),
+        &expected,
+        "only gates transfer; physical resources and Data stay unchanged"
+    );
+    state
+        .inherit_replacement_gates(&f.authority(), 2, &intended, false)
+        .unwrap();
+    assert_eq!(
+        state.revision(),
+        2,
+        "unchanged gates do not invent another revision"
+    );
+    state
+        .inherit_replacement_gates(&f.authority(), 2, &intended, true)
+        .unwrap();
+    assert_eq!(
+        state.revision(),
+        3,
+        "route change still advances exactly once"
+    );
+    state.revision = u64::MAX;
+    assert_eq!(
+        state.inherit_replacement_gates(&f.authority(), u64::MAX, &intended, true),
+        Err(MediaTransitionError::Capacity)
+    );
+    assert_eq!(state.streams(), &expected);
+}
