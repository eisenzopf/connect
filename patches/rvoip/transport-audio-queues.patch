+    #[tokio::test]
+    async fn audio_channels_honor_the_selected_budget() {
+        let capacity = std::num::NonZeroUsize::MIN.saturating_add(9);
+        use rtc::rtp_transceiver::rtp_sender::{
+            RTCRtpCodec, RTCRtpEncodingParameters, RtpCodecKind,
+        };
+        use webrtc::media_stream::MediaStreamTrack;
+        let track = Arc::new(TrackLocalStaticRTP::new(MediaStreamTrack::new(
+            "queue-audio".into(),
+            "queue-test".into(),
+            "queue-test".into(),
+            RtpCodecKind::Audio,
+            vec![RTCRtpEncodingParameters {
+                codec: RTCRtpCodec {
+                    mime_type: "audio/opus".into(),
+                    clock_rate: 48_000,
+                    channels: 1,
+                    ..Default::default()
+                },
+                ..Default::default()
+            }],
+        )));
+        let stream = from_tracks_with_dtmf_events_and_task_counter(
+            StreamId::new(),
+            CodecInfo {
+                name: "opus".into(),
+                clock_rate_hz: 48_000,
+                channels: 1,
+                fmtp: None,
+                payload_type: Some(111),
+            },
+            track,
+            1,
+            111,
+            None,
+            None,
+            Vec::new(),
+            None,
+            None,
+            Some(capacity),
