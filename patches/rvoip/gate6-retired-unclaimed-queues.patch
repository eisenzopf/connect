+use super::*;
+
+async fn shutdown_both(f: &Fixture) {
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+    assert_eq!(f.b.shutdown(deadline()).await, 0);
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(f.ba.outstanding.load(Ordering::Acquire), 0);
+}
+
+#[tokio::test]
+async fn shutdown_releases_admitted_ingress_when_receiver_was_never_claimed() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let weak = source.downgrade();
+    let controller = Arc::downgrade(&f.a);
+    // Use normal admission and an actual encoded frame. There is intentionally
+    // no scene/adapter consumer yet; successful publication owns the packet.
+    source.try_publish(&frame(&source, 160)).unwrap();
+    shutdown_both(&f).await;
+    assert!(source.try_publish(&frame(&source, 320)).is_err());
+    drop(source);
+    drop(f);
+    assert!(controller.upgrade().is_none());
+    assert!(
+        weak.upgrade().is_none(),
+        "confirmed shutdown retained the unclaimed ingress queue's media port"
+    );
+}
+
+#[tokio::test]
+async fn shutdown_releases_forwarded_egress_when_receiver_was_never_claimed() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let target = f.ba.port(Medium::Audio);
+    let source_weak = source.downgrade();
+    let target_weak = target.downgrade();
+    let source_controller = Arc::downgrade(&f.a);
+    let target_controller = Arc::downgrade(&f.b);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    // Forwarding used current source and recipient authority. The recipient
+    // has not claimed its egress receiver, so the queued copy is still owned
+    // internally rather than by an adapter worker we could join here.
+    shutdown_both(&f).await;
+    drop(input);
+    drop((source, target));
+    drop(f);
+    assert!(source_controller.upgrade().is_none());
+    assert!(target_controller.upgrade().is_none());
+    assert!(
+        target_weak.upgrade().is_none(),
+        "confirmed shutdown retained the unclaimed egress queue's media port"
+    );
+    assert!(source_weak.upgrade().is_none());
+}
+
+#[tokio::test]
+async fn claimed_ingress_and_dequeued_packet_keep_their_actual_owner_until_drop() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let weak = source.downgrade();
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    shutdown_both(&f).await;
+    drop(source);
+    drop(f);
+    assert!(
+        weak.upgrade().is_some(),
+        "the claimed queue still owns its packet"
+    );
+    let packet = receive(&mut input).await;
+    drop(input);
+    assert!(
+        weak.upgrade().is_some(),
+        "the dequeued packet still owns its port"
+    );
+    drop(packet);
+    assert!(weak.upgrade().is_none());
+}
