+#[tokio::test]
+async fn claimed_egress_decodes_before_retirement_and_remains_fenced_afterward() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let target = f.ba.port(Medium::Audio);
+    let weak = target.downgrade();
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut output = target.take_egress().unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    assert_audio(outgoing(&mut output).await).await;
+    for timestamp in [320, 480] {
+        source.try_publish(&frame(&source, timestamp)).unwrap();
+        receive(&mut input)
+            .await
+            .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+            .unwrap();
+    }
+    shutdown_both(&f).await;
+    let sent = Arc::new(AtomicBool::new(false));
+    let observed = sent.clone();
+    assert!(outgoing(&mut output)
+        .await
+        .deliver(|_| async move {
+            observed.store(true, Ordering::Release);
+            Ok(())
+        })
+        .await
+        .is_err());
+    // The controllers and ports still exist here: retirement itself must
+    // prevent this callback, independently of later Weak-owner failure.
+    assert!(!sent.load(Ordering::Acquire));
+    drop(input);
+    drop((source, target));
+    drop(f);
+    assert!(
+        weak.upgrade().is_some(),
+        "the claimed queue still owns its copy"
+    );
+    let queued = outgoing(&mut output).await;
+    drop(output);
+    assert!(
+        weak.upgrade().is_some(),
+        "the dequeued copy still owns its target"
+    );
+    let observed = sent.clone();
+    assert!(queued
+        .deliver(|_| async move {
+            observed.store(true, Ordering::Release);
+            Ok(())
+        })
+        .await
+        .is_err());
+    assert!(!sent.load(Ordering::Acquire));
+    assert!(weak.upgrade().is_none());
+}
