+struct ReentrantContext {
+    controller: Weak<StreamController>,
+    observed: Arc<AtomicUsize>,
+    held: Arc<AtomicUsize>,
+}
+impl Drop for ReentrantContext {
+    fn drop(&mut self) {
+        let Some(controller) = self.controller.upgrade() else {
+            self.observed.store(2, Ordering::Release);
+            return;
+        };
+        // Detect a held lock without making a failing regression hang. When
+        // none is held, perform the actual public metadata read from Drop.
+        let mut held = 0;
+        if controller.state.try_lock().is_err() {
+            held |= 1;
+        }
+        if controller.cleanup_lock.try_lock().is_err() {
+            held |= 2;
+        }
+        if controller.inflight.available_permits() != 1 {
+            held |= 4;
+        }
+        self.held.store(held, Ordering::Release);
+        if held == 0 {
+            let _ = controller.revision();
+            self.observed.store(1, Ordering::Release);
+        } else {
+            self.observed.store(3, Ordering::Release);
+        }
+    }
+}
+struct ReentrantDataPolicy(Arc<Policy>);
+impl MediaPolicy for ReentrantDataPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.0.current(scope)
+    }
+    fn current_data(
+        &self,
+        scope: &MediaScope<'_>,
+        data: &crate::staged_streams::reliable_data::StagedData,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if held.is_some() || data.context::<ReentrantContext>().is_none() {
+            return Err(StreamControlError::Authority);
+        }
+        self.0.current(scope)
+    }
+}
+
+#[tokio::test]
+async fn queued_data_context_drop_can_reenter_after_all_cleanup_guards_are_gone() {
+    let f = Fixture::with_policy(
+        8,
+        Some(Box::new(|base| Arc::new(ReentrantDataPolicy(base)))),
+    );
+    f.start(&[Medium::Data]).await;
+    let source = f.aa.port(Medium::Data);
+    let target = f.ba.port(Medium::Data);
+    let mut input = f.a.take_ingress(&desired(Medium::Data).logical_id).unwrap();
+    let observed = Arc::new(AtomicUsize::new(0));
+    let held = Arc::new(AtomicUsize::new(0));
+    let data = crate::staged_streams::reliable_data::StagedData::new(
+        crate::DataMessage::reliable("data", "application/json", Bytes::from_static(b"{}")),
+        ReentrantContext {
+            controller: Arc::downgrade(&f.b),
+            observed: observed.clone(),
+            held: held.clone(),
+        },
+    )
+    .unwrap();
+    source.try_publish_data(&data, None).unwrap();
+    drop(data);
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Data).logical_id)
+        .unwrap();
+    assert_eq!(observed.load(Ordering::Acquire), 0);
+    assert!(target.report_terminal().unwrap());
+    assert_eq!(f.b.shutdown(deadline()).await, 0);
+    // On the original implementation this public late claim/drop releases
+    // the otherwise retained packet; it makes this a passing before-control.
+    // The fixed cleanup already released its unclaimed receiver and refuses
+    // the claim. Neither path permits data delivery after retirement.
+    if let Ok(output) = target.take_egress() {
+        drop(output);
+    }
+    assert_eq!(held.load(Ordering::Acquire), 0);
+    assert_eq!(observed.load(Ordering::Acquire), 1);
+    shutdown_both(&f).await;
+}
