+async fn refused_upgrade_preserves_old_queue(cancelled: bool) {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let target = f.ba.port(Medium::Audio);
+    let source_weak = source.downgrade();
+    let target_weak = target.downgrade();
+    // Queue before starting the failed/cancelled upgrade, and only claim the
+    // old receiver afterward. Candidate retirement must not drain this port.
+    source.try_publish(&frame(&source, 160)).unwrap();
+    f.aa.mode
+        .store(if cancelled { 1 } else { 2 }, Ordering::Release);
+    let token = CancellationToken::new();
+    let candidate;
+    if cancelled {
+        let a = f.a.clone();
+        let cancellation = token.clone();
+        let task = tokio::spawn(async move {
+            a.change(
+                1,
+                &[desired(Medium::Audio), desired(Medium::Video)],
+                &BTreeSet::new(),
+                deadline(),
+                cancellation,
+            )
+            .await
+        });
+        tokio::time::timeout(Duration::from_secs(1), f.aa.entered.notified())
+            .await
+            .unwrap();
+        candidate = f.aa.port(Medium::Video);
+        assert!(candidate.try_publish(&frame(&candidate, 1)).is_err());
+        token.cancel();
+        assert!(matches!(
+            task.await.unwrap(),
+            Err(StreamControlError::Cancelled)
+        ));
+    } else {
+        assert!(matches!(
+            f.a.change(
+                1,
+                &[desired(Medium::Audio), desired(Medium::Video)],
+                &BTreeSet::new(),
+                deadline(),
+                token,
+            )
+            .await,
+            Err(StreamControlError::NotReady)
+        ));
+        candidate = f.aa.port(Medium::Video);
+    }
+    let candidate_weak = candidate.downgrade();
+    assert_eq!(f.a.revision(), 1);
+    assert_eq!(f.a.reconcile_cleanup(deadline()).await, 0);
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 1);
+    assert!(candidate.try_publish(&frame(&candidate, 2)).is_err());
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut output = target.take_egress().unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    assert_audio(outgoing(&mut output).await).await;
+    shutdown_both(&f).await;
+    drop((input, output));
+    drop((source, target, candidate));
+    drop(f);
+    assert!(candidate_weak.upgrade().is_none());
+    assert!(source_weak.upgrade().is_none());
+    assert!(target_weak.upgrade().is_none());
+}
+
+#[tokio::test]
+async fn cancelled_open_releases_candidate_without_draining_existing_audio() {
+    refused_upgrade_preserves_old_queue(true).await;
+}
+
+#[tokio::test]
+async fn failed_open_releases_candidate_without_draining_existing_audio() {
+    refused_upgrade_preserves_old_queue(false).await;
+}
