+//! Native-only control-plane lease composition. RTC's exclusive seal API stays
+//! unchanged. There is still ONE CAS/raw fence per accepted physical peer.
+//! No registry/lock/refcount operation here runs on a packet writer path.
+use super::*;
+use std::collections::BTreeMap;
+#[derive(Default)]
+pub(super) struct NativeSessionSeals {
+    peer:Weak<SharedPeerFence>,
+    last_token:Option<u64>,
+    // A retired strict scope must never reopen raw handles to that history.
+    // Keep one flattened peer fence, not a chain/list of previous owners.
+    pinned:Option<Arc<SharedPeerFence>>,
+    scopes:BTreeMap<u128,Weak<ScopeSeal>>,
+}
+struct SharedPeerFence {coverage:Weak<PhysicalVideoExposureCoverage>,token:u64}
+impl SharedPeerFence {
+    fn is_current(&self)->bool {self.coverage.upgrade().is_some_and(|root|root.state.load(Ordering::Acquire)==self.token)}
+}
+impl Drop for SharedPeerFence {
+    fn drop(&mut self) {if let Some(root)=self.coverage.upgrade(){let _=root.state.compare_exchange(self.token,0,Ordering::AcqRel,Ordering::Acquire);}}
+}
+pub(super) struct ScopeSeal {realm:u128,peer:Arc<SharedPeerFence>,live:AtomicBool}
+impl ScopeSeal {
+    pub(super) fn realm(&self)->u128 {self.realm}
+    pub(super) fn is_current(&self)->bool {self.live.load(Ordering::Acquire)&&self.peer.is_current()}
+    pub(super) fn abort(&self) {self.live.store(false,Ordering::Release);}
+    pub(super) fn retire(&self,root:&Arc<PhysicalVideoExposureCoverage>) {
+        self.live.store(false,Ordering::Release);
+        let Some(state)=root.native_sessions.get() else {root.retire();return;};
+        match state.lock() {
+            Ok(mut state)=>if self.peer.is_current(){state.pinned=Some(self.peer.clone());},
+            Err(_)=>root.retire(),
+        }
+    }
+}
+impl PhysicalVideoExposureCoverage {
+    pub(in crate::staged_streams) fn enable_native_session_seals(&self) {let _=self.native_sessions.get_or_init(||std::sync::Mutex::new(NativeSessionSeals::default()));}
+    pub(super) fn try_seal_family(self:&Arc<Self>,realm:Option<u128>)->Result<PhysicalVideoExposureSeal,PhysicalVideoSealUnavailable> {
+        let Some(state)=self.native_sessions.get() else {return self.try_seal();};
+        let Some(realm)=realm.filter(|value|*value!=0) else {return Err(PhysicalVideoSealUnavailable::Retired);};
+        let mut state=state.lock().map_err(|_|{self.retire();PhysicalVideoSealUnavailable::Retired})?;
+        state.scopes.retain(|_,scope|scope.upgrade().is_some_and(|scope|scope.is_current()));
+        if state.scopes.contains_key(&realm) {return Err(PhysicalVideoSealUnavailable::AlreadySealed);}
+        let peer=if let Some(peer)=state.peer.upgrade() {
+            if !peer.is_current(){return Err(PhysicalVideoSealUnavailable::Retired);}
+            peer
+        } else {
+            let token=self.next_token.fetch_update(Ordering::Relaxed,Ordering::Relaxed,|next|next.checked_add(1)).map_err(|_|PhysicalVideoSealUnavailable::Exhausted)?;
+            // If the last abort is concurrently dropping its peer Arc, replace
