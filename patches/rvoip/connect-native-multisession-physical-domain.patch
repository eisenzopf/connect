+    async fn refresh(&self,o:&ValidatedBearer,n:&ValidatedBearer,d:&Device,i:&Identifier,e:&Envelope)->Result<AuthorityLease,DispatchError>{self.proof(self.base.refresh(o,n,d,i,e).await?,e)}
