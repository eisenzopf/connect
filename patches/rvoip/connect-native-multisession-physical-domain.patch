+    fn proof(&self,base:AuthorityLease,e:&Envelope)->Result<AuthorityLease,DispatchError> {
+        let (session,connection)=if e.kind()=="connection.offer" {
+            if e.scope(Scope::Conversation)!=Some("conversation"){return Err(DispatchError::Authority);}
+            (Some(self.sessions.get(e.scope(Scope::Session).ok_or(DispatchError::Authority)?).ok_or(DispatchError::Authority)?.clone()),Some(self.connections.get(e.scope(Scope::Connection).ok_or(DispatchError::Authority)?).ok_or(DispatchError::Authority)?.clone()))
