+        .unwrap();
+    outgoing(&mut ports.output).await
+}
+#[tokio::test]
+async fn owned_source_and_recipient_expiry_bound_pending_io_before_longer_credentials_and_packet_age(
+) {
+    for connection in ["alice", "bob"] {
+        let (f, expiry) = fixture();
+        f.start(&[Medium::Audio]).await;
+        let mut ports = ports(&f);
+        let packet = queued(&f, &mut ports, 160).await;
+        *expiry.lock().unwrap() = Some((
+            connection.into(),
+            chrono::Utc::now() + chrono::Duration::milliseconds(80),
+        ));
+        let polled = AtomicBool::new(false);
+        let result = tokio::time::timeout(
+            Duration::from_millis(150),
+            packet.deliver(|_| async {
+                polled.store(true, Ordering::Release);
+                std::future::pending::<ControlResult<()>>().await
+            }),
+        )
+        .await;
+        assert!(
+            matches!(result, Ok(Err(StreamControlError::Deadline))),
+            "{connection} grant did not bound IO: {result:?}"
+        );
+        assert!(polled.load(Ordering::Acquire));
+        assert!(
+            f.policy.0.try_write().is_ok(),
+            "expired IO kept a policy reader"
+        );
+    }
+}
+#[tokio::test]
+async fn expired_owned_packet_interval_never_polls_io_and_releases_all_source_and_target_readers() {
+    for connection in ["alice", "bob"] {
+        let (f, expiry) = fixture();
+        f.start(&[Medium::Audio]).await;
+        let mut ports = ports(&f);
+        let packet = queued(&f, &mut ports, 160).await;
+        *expiry.lock().unwrap() = Some((
+            connection.into(),
+            chrono::Utc::now() - chrono::Duration::seconds(1),
+        ));
+        let polled = AtomicBool::new(false);
+        assert!(matches!(
+            packet
+                .deliver(|_| async {
+                    polled.store(true, Ordering::Release);
+                    Ok(())
+                })
+                .await,
+            Err(StreamControlError::Deadline)
+        ));
+        assert!(!polled.load(Ordering::Acquire));
+        assert!(
+            f.policy.0.try_write().is_ok(),
+            "refusal kept a policy reader"
+        );
+        *expiry.lock().unwrap() = None;
+        assert_audio(queued(&f, &mut ports, 161).await).await;
+        assert!(f.policy.0.try_write().is_ok());
+    }
+}
