+//! Current credentials cannot extend the shorter owned packet interval.
+use super::*;
+type Expiry = Arc<Mutex<Option<(String, chrono::DateTime<chrono::Utc>)>>>;
+struct TimedPolicy {
+    inner: Arc<Policy>,
+    expiry: Expiry,
+}
+struct TimedLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    expiry: Option<chrono::DateTime<chrono::Utc>>,
+}
+impl MediaAuthorityLease for TimedLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        self.expiry
+    }
+}
+impl MediaPolicy for TimedPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let expiry = self
+            .expiry
+            .lock()
+            .unwrap()
+            .as_ref()
+            .filter(|(connection, _)| connection == scope.connection.as_str())
+            .map(|(_, until)| *until);
+        Ok(Box::new(TimedLease {
+            inner: self.inner.current(scope)?,
+            expiry,
+        }))
+    }
+}
