+
+#[tokio::test]
+async fn endpoint_preparation_allows_quarantined_video_without_granting_public_media() {
+    let mut room = Room::new().await;
+    room.add_owned_with_media(
+        "fresh", "fresh", owner("fresh"), true, None,
+        vec![desired(Medium::Audio), desired(Medium::Video)],
+    ).await;
+    let id = ConnectionId::from_string("fresh");
+    room.domain.local_preparations.lock().unwrap().insert(id.clone(), "prepare-fresh".into());
+    let video = room.nodes["fresh"].adapter.port(Medium::Video);
+    assert!(video.try_publish(&frame(&video, 1)).is_err(), "muted preparation published video");
+    let preparation = room.scene.prepare_audio_endpoint(&id, "prepare-fresh")
+        .expect("one duplex audio port plus separately muted video must permit decoder-only readiness");
+    assert!(!preparation.has_duplex_io());
+    room.publish("fresh", 12000).unwrap();
+    room.tick();
+    room.silent(&["alice", "bob", "public", "hold", "fresh"]);
+    assert!(video.try_publish(&frame(&video, 2)).is_err(), "audio proof opened a video route");
+    drop(preparation);
+    assert!(video.try_publish(&frame(&video, 3)).is_err(), "dropping preparation opened video");
+}
