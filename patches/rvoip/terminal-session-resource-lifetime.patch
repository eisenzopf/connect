+/// Opt-in resource supervision with exact Session retirement. Current peer
+/// authority is rechecked even when no Session remains. Any unsupported,
+/// revoked, unknown or unavailable authorization still ends the whole peer.
+/// An authorized durable end retires only its own coordinator resources and
+/// adapter workers, preserving control signaling and other live Sessions.
+pub fn spawn_resource_authorization_guard_with_session_retirement(
+    bindings: Arc<PeerResourceBindings>,
+    coordinator: Arc<UctpCoordinator>,
+    validation_interval: Duration,
+) -> JoinHandle<()> {
+    tokio::spawn(async move {
+        if !bindings.supports_terminal_session_retirement() {
+            return;
+        }
+        let mut interval = tokio::time::interval(validation_interval);
+        loop {
+            interval.tick().await;
+            let Ok(terminal) = bindings.authorized_terminal_sessions() else {
+                return;
+            };
+            for session in terminal {
+                if coordinator
+                    .retire_authorized_terminal_session(&session)
+                    .await
+                    .is_err()
+                {
+                    return;
+                }
+            }
+        }
+    })
+}
