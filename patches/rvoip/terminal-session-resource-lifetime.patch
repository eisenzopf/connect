+#[tokio::test]
+async fn current_authority_loss_wins_before_or_after_terminal_state_without_terminal_shortcut() {
+    for end_first in [false, true] {
+        let current = Arc::new(AtomicBool::new(true));
+        let ended = Arc::new(AtomicBool::new(false));
+        let bindings = PeerResourceBindings::new(Arc::new(TerminalResolver {
+            current: current.clone(),
+            ended: ended.clone(),
+        }));
+        bindings
+            .authenticate(AuthenticatedPrincipal::anonymous())
+            .unwrap();
+        bindings
+            .bind_session(&SessionId::from_string("terminal"))
+            .unwrap();
+        if end_first {
+            ended.store(true, Ordering::Release);
+        }
+        current.store(false, Ordering::Release);
+        if !end_first {
+            ended.store(true, Ordering::Release);
+        }
+        assert!(bindings.authorized_terminal_sessions().is_err());
+        assert!(bindings
+            .core_session(&SessionId::from_string("terminal"))
+            .is_some());
+    }
+}
