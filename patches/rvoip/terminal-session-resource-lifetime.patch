+//! Exact Session cleanup and fail-closed current peer lifetime fixtures.
+use super::{spawn_resource_authorization_guard_with_session_retirement, UctpCoordinator};
+use crate::state::{
+    PeerResourceBindings, ResourceBindingError, SessionBindingResolver, UctpSessionEvent,
+    ENVELOPE_CHANNEL_CAP,
+};
+use rvoip_core::identity::AuthenticatedPrincipal;
+use rvoip_core::ids::SessionId;
+use std::{
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+use tokio::sync::mpsc;
+
+struct TerminalResolver {
+    current: Arc<AtomicBool>,
+    ended: Arc<AtomicBool>,
+}
+impl SessionBindingResolver for TerminalResolver {
+    fn resolve_session(
+        &self,
+        _: &AuthenticatedPrincipal,
+        wire: &SessionId,
+    ) -> Result<SessionId, ResourceBindingError> {
+        Ok(wire.clone())
+    }
+    fn supports_terminal_session_retirement(&self) -> bool {
+        true
+    }
+    fn reauthorize_peer(&self, _: &AuthenticatedPrincipal) -> Result<(), ResourceBindingError> {
+        if self.current.load(Ordering::Acquire) {
+            Ok(())
+        } else {
+            Err(ResourceBindingError::forbidden("current-authority-lost"))
+        }
+    }
+    fn session_is_terminal(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        wire: &SessionId,
+        _: &SessionId,
+    ) -> Result<bool, ResourceBindingError> {
+        self.reauthorize_peer(principal)?;
+        Ok(wire.as_str() == "terminal" && self.ended.load(Ordering::Acquire))
+    }
+}
+
+#[tokio::test]
+async fn authorized_terminal_session_retires_exact_resources_keeps_control_and_current_peer_guard()
+{
+    let current = Arc::new(AtomicBool::new(true));
+    let ended = Arc::new(AtomicBool::new(false));
+    let bindings = PeerResourceBindings::new(Arc::new(TerminalResolver {
+        current: current.clone(),
+        ended: ended.clone(),
+    }));
+    bindings
+        .authenticate(AuthenticatedPrincipal::anonymous())
+        .unwrap();
+    let terminal = SessionId::from_string("terminal");
+    let other = SessionId::from_string("other");
+    bindings.bind_session(&terminal).unwrap();
+    bindings.bind_session(&other).unwrap();
+    let (_in_tx, in_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let (out_tx, mut out_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let (events_tx, mut events_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let coordinator = UctpCoordinator::start(
+        "test",
+        in_rx,
+        out_tx,
+        events_tx,
+        rvoip_auth_core::bearer_stub(),
+    );
+    coordinator.set_resource_bindings(bindings.clone()).unwrap();
+    let pending = coordinator.pending();
+    let waiting = pending.clone();
+    let control = tokio::spawn(async move {
+        waiting
+            .wait_for(
+                crate::ids::EnvelopeId::from_string("control"),
+                Duration::from_secs(1),
+            )
+            .await
+    });
+    tokio::task::yield_now().await;
+    let guard = spawn_resource_authorization_guard_with_session_retirement(
+        bindings.clone(),
+        coordinator.clone(),
+        Duration::from_millis(5),
+    );
+    ended.store(true, Ordering::Release);
+    let event = tokio::time::timeout(Duration::from_secs(1), events_rx.recv())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(matches!(event, UctpSessionEvent::SessionEnded { sid, .. } if sid == terminal));
+    let envelope = out_rx.recv().await.unwrap();
+    assert_eq!(envelope.msg_type, crate::types::MessageType::SessionEnd);
+    assert_eq!(envelope.sid.as_deref(), Some("terminal"));
+    assert!(bindings.core_session(&terminal).is_none());
+    assert_eq!(bindings.core_session(&other), Some(other.clone()));
+    assert!(!guard.is_finished());
+    assert!(pending.has_waiter("control"));
+    pending
+        .deliver(
+            crate::envelope::UctpEnvelope::new(
+                crate::types::MessageType::Ack,
+                serde_json::json!({}),
+            )
+            .with_in_reply_to("control"),
+        )
+        .unwrap();
+    assert!(control.await.unwrap().is_ok());
+    bindings.remove_session(&other);
+    current.store(false, Ordering::Release);
+    tokio::time::timeout(Duration::from_secs(1), guard)
+        .await
+        .unwrap()
+        .unwrap();
+    coordinator.abort().await;
+}
