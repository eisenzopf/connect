+#[tokio::test]
+async fn adapter_retirement_before_guard_tick_preserves_control_and_sibling_session() {
+    let current = Arc::new(AtomicBool::new(true));
+    let ended = Arc::new(AtomicBool::new(true));
+    let bindings = PeerResourceBindings::new(Arc::new(TerminalResolver { current, ended }));
+    bindings
+        .authenticate(AuthenticatedPrincipal::anonymous())
+        .unwrap();
+    let terminal = SessionId::from_string("terminal");
+    let other = SessionId::from_string("other");
+    bindings.bind_session(&terminal).unwrap();
+    bindings.bind_session(&other).unwrap();
+    let (_in_tx, in_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let (out_tx, _out_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let (events_tx, _events_rx) = mpsc::channel(ENVELOPE_CHANNEL_CAP);
+    let coordinator = UctpCoordinator::start(
+        "test",
+        in_rx,
+        out_tx,
+        events_tx,
+        rvoip_auth_core::bearer_stub(),
+    );
+    coordinator.set_resource_bindings(bindings.clone()).unwrap();
+    // The ordinary adapter path can win the same durable-end race. The next
+    // guard pass must not interpret already-removed bindings as revoked peer
+    // authority or touch a sibling Session.
+    coordinator.retire_local_session(&terminal);
+    let guard = spawn_resource_authorization_guard_with_session_retirement(
+        bindings.clone(),
+        coordinator.clone(),
+        Duration::from_millis(5),
+    );
+    tokio::time::sleep(Duration::from_millis(15)).await;
+    assert!(!guard.is_finished());
+    assert!(bindings.core_session(&terminal).is_none());
+    assert_eq!(bindings.core_session(&other), Some(other));
+    coordinator.retire_local_session(&terminal);
+    assert!(bindings.authorized_terminal_sessions().unwrap().is_empty());
+    guard.abort();
+    let _ = guard.await;
+    coordinator.abort().await;
+}
