+/// A directional receiver may advertise more capacity than our fixed encoder
+/// needs. Unknown VP8 parameters are ignored per RFC7741; known limits and all
+/// syntax/duplicate declarations must remain unambiguous and meet the program.
+fn receiver_limits(media: &MediaDescription, pt: u8) -> ControlResult<()> {
+    let mut entries = media.fmtps().filter(|p| p.format.parse::<u8>() == Ok(pt));
+    let parameters = entries.next();
+    if entries.next().is_some() {
+        return Err(E::Unsupported);
+    }
+    let mut names = std::collections::BTreeSet::new();
+    for field in parameters
+        .map(|p| p.parameters.as_str())
+        .unwrap_or("")
+        .split(';')
+        .filter(|p| !p.trim().is_empty())
+    {
+        let (name, value) = field.trim().split_once('=').unwrap_or((field.trim(), ""));
+        let name = name.trim().to_ascii_lowercase();
+        if name == "max-fr" || name == "max-fs" {
+            if !names.insert(name.clone()) {
+                return Err(E::Unsupported);
+            }
+            let value = value.trim();
+            if value.is_empty() || !value.bytes().all(|b| b.is_ascii_digit()) {
+                return Err(E::Unsupported);
+            }
+            let value = value.parse::<u32>().map_err(|_| E::Unsupported)?;
+            let required = if name == "max-fr" {
+                MAX_FRAME_RATE
+            } else {
+                MAX_FRAME_MACROBLOCKS
+            };
+            if value < required {
+                return Err(E::Unsupported);
+            }
+        }
+    }
+    Ok(())
+}
