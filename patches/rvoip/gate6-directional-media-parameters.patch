+use super::*;
+use crate::peer_connection::sdp::session_description::RTCSessionDescription;
+fn codec(mime: &str, rate: u32, channels: u16, pt: u8, parameters: &str) -> RTCRtpCodecParameters {
+    RTCRtpCodecParameters {
+        rtp_codec: RTCRtpCodec {
+            mime_type: mime.into(),
+            clock_rate: rate,
+            channels,
+            sdp_fmtp_line: parameters.into(),
+            ..Default::default()
+        },
+        payload_type: pt,
+        ..Default::default()
+    }
+}
+fn engine() -> MediaEngine {
+    let mut engine = MediaEngine::default();
+    for (kind, codec) in [
+        (
+            RtpCodecKind::Audio,
+            codec(
+                MIME_TYPE_OPUS,
+                48000,
+                2,
+                111,
+                "stereo=0;maxaveragebitrate=32000;useinbandfec=1",
+            ),
+        ),
+        (
+            RtpCodecKind::Audio,
+            codec(MIME_TYPE_TELEPHONE_EVENT, 8000, 1, 101, "0-15"),
+        ),
+        (
+            RtpCodecKind::Video,
+            codec(MIME_TYPE_VP8, 90000, 0, 96, "max-fs=920;max-fr=30"),
+        ),
+        (
+            RtpCodecKind::Video,
+            codec("video/rtx", 90000, 0, 97, "apt=96"),
+        ),
+    ] {
+        engine.register_codec(codec, kind).unwrap();
+    }
+    engine
+}
+fn remote() -> SessionDescription {
+    RTCSessionDescription::offer("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 109 101\r\na=rtpmap:109 opus/48000/2\r\na=fmtp:109 maxplaybackrate=48000;stereo=1;useinbandfec=1\r\na=rtpmap:101 telephone-event/8000\r\na=fmtp:101 0-15\r\nm=video 9 UDP/TLS/RTP/SAVPF 120 124\r\na=rtpmap:120 VP8/90000\r\na=fmtp:120 max-fs=12288;max-fr=60\r\na=rtpmap:124 rtx/90000\r\na=fmtp:124 apt=120\r\n".into()).unwrap().unmarshal().unwrap()
+}
+#[test]
+fn wire_identity_keeps_opus_when_supplemental_audio_is_an_exact_match() {
+    let mut engine = engine();
+    engine.update_from_remote_description(&remote()).unwrap();
+    let audio = engine.get_codecs_by_kind(RtpCodecKind::Audio);
+    assert!(audio.iter().any(|c| c.payload_type == 101));
+    let opus = audio.iter().find(|c| c.payload_type == 109).unwrap();
+    assert!(
+        opus.rtp_codec.sdp_fmtp_line.contains("stereo=1"),
+        "sender retains remote receiver preference"
+    );
+    assert!(
+        engine
+            .local_receive_fmtp(opus, RtpCodecKind::Audio)
+            .contains("stereo=0")
+    );
+    assert!(
+        engine
+            .local_receive_fmtp(opus, RtpCodecKind::Audio)
+            .contains("maxaveragebitrate=32000")
+    );
+}
+#[test]
+fn local_video_limits_preserve_dynamic_payload_and_remote_rtx_association() {
+    let mut engine = engine();
+    engine.update_from_remote_description(&remote()).unwrap();
+    let video = engine.get_codecs_by_kind(RtpCodecKind::Video);
+    let primary = video.iter().find(|c| c.payload_type == 120).unwrap();
+    assert_eq!(primary.rtp_codec.sdp_fmtp_line, "max-fs=12288;max-fr=60");
+    assert_eq!(
+        engine.local_receive_fmtp(primary, RtpCodecKind::Video),
+        "max-fs=920;max-fr=30"
+    );
+    let repair = video.iter().find(|c| c.payload_type == 124).unwrap();
+    assert_eq!(repair.rtp_codec.sdp_fmtp_line, "apt=120");
+    assert_eq!(
+        engine.local_receive_fmtp(repair, RtpCodecKind::Video),
+        "apt=120"
+    );
+}
+#[test]
+fn receive_preferences_do_not_relax_clock_channel_or_format_identity() {
+    let engine = engine();
+    for mut remote in [
+        codec(MIME_TYPE_OPUS, 8000, 2, 109, "stereo=1"),
+        codec(MIME_TYPE_OPUS, 48000, 1, 109, "stereo=1"),
+        codec("audio/other", 48000, 2, 109, ""),
+    ] {
+        assert_eq!(
+            codec_parameters_fuzzy_search(&remote.rtp_codec, &engine.audio_codecs).1,
+            CodecMatch::None
+        );
+        remote.rtp_codec.sdp_fmtp_line.clear();
+        assert_eq!(
+            codec_parameters_fuzzy_search(&remote.rtp_codec, &engine.audio_codecs).1,
+            CodecMatch::None
+        );
+    }
+    let h264 = codec("video/H264", 90000, 0, 102, "profile-level-id=42e01f");
+    let different = codec("video/H264", 90000, 0, 103, "profile-level-id=640032");
+    assert_ne!(
+        codec_parameters_fuzzy_search(&different.rtp_codec, &[h264]).1,
+        CodecMatch::Exact
+    );
+}
