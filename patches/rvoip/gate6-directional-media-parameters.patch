+    /// Local SDP carries this endpoint's receive preferences. Negotiated RTP
+    /// parameters remain the remote receiver's constraints for actual senders.
+    /// Payload identity, RTX apt and format-defining codec parameters are kept.
+    pub(crate) fn local_receive_fmtp(
+        &self,
+        codec: &RTCRtpCodecParameters,
+        kind: RtpCodecKind,
+    ) -> String {
+        if !codec
+            .rtp_codec
+            .mime_type
+            .eq_ignore_ascii_case(MIME_TYPE_OPUS)
+            && !codec
+                .rtp_codec
+                .mime_type
+                .eq_ignore_ascii_case(MIME_TYPE_VP8)
+        {
+            return codec.rtp_codec.sdp_fmtp_line.clone();
+        }
+        let registered = if kind == RtpCodecKind::Audio {
+            &self.audio_codecs
+        } else {
+            &self.video_codecs
+        };
+        let (local, matched) = codec_parameters_fuzzy_search(&codec.rtp_codec, registered);
+        if matched == CodecMatch::None {
+            return codec.rtp_codec.sdp_fmtp_line.clone();
+        }
+        local.rtp_codec.sdp_fmtp_line
+    }
