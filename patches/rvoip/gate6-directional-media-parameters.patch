+#[cfg(test)]
+mod receive_limit_tests {
+    use super::*;
+    fn sdp(parameters: &str) -> String {
+        format!(
+            "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\nm=video 9 UDP/TLS/RTP/SAVPF 120 124\r\na=mid:camera\r\na=rtpmap:120 VP8/90000\r\na=rtpmap:124 rtx/90000\r\na=fmtp:124 apt=120\r\n{parameters}"
+        )
+    }
+    #[test]
+    fn asymmetric_receiver_capacity_keeps_original_video_and_repair_identity() {
+        let offer = sdp("a=fmtp:120 max-fs=12288;max-fr=60\r\n");
+        let answer = sdp("a=fmtp:120 max-fs=920;max-fr=30\r\n");
+        for (a, b) in [(&offer, &answer), (&answer, &offer)] {
+            let selected = negotiated_profile(a, b).unwrap();
+            assert_eq!(selected.payload_type, 120);
+            assert_eq!(selected.rtx_payload_type, Some(124));
+            assert_eq!(selected.mid.as_deref(), Some("camera"));
+        }
+        assert!(negotiated_profile(&sdp(""), &answer).is_ok());
+    }
+    #[test]
+    fn unmet_or_ambiguous_limits_refuse_in_either_direction() {
+        let answer = sdp("a=fmtp:120 max-fr=30;max-fs=920\r\n");
+        for tail in [
+            "max-fr=29",
+            "max-fs=919",
+            "max-fr=0",
+            "max-fs=0",
+            "max-fr=+30",
+            "max-fr=30.0",
+            "max-fr=4294967296",
+            "max-fr",
+            "max-fr=30;MAX-FR=60",
+            "max-fs=920;max-fs=12288",
+        ] {
+            let bad = sdp(&format!("a=fmtp:120 {tail}\r\n"));
+            assert!(negotiated_profile(&bad, &answer).is_err(), "{tail}");
+            assert!(negotiated_profile(&answer, &bad).is_err(), "{tail}");
+        }
+        let duplicate = sdp("a=fmtp:120 max-fr=30\r\na=fmtp:0120 max-fr=60\r\n");
+        assert!(negotiated_profile(&duplicate, &answer).is_err());
+    }
+    #[test]
+    fn unknown_vp8_extensions_do_not_change_receive_limits() {
+        let offer = sdp("a=fmtp:120 max-fr=60;max-fs=12288;x-extension=opaque;future-flag\r\n");
+        assert!(negotiated_profile(&offer, &sdp("a=fmtp:120 max-fs=920;max-fr=30\r\n")).is_ok());
+        assert!(
+            negotiated_profile(&offer, &sdp("a=fmtp:120 max-fr=29;x-extension=opaque\r\n"))
+                .is_err()
+        );
+    }
+}
