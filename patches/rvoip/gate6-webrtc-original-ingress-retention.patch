+#[tokio::test]
+async fn rtc_original_ingress_input_bound_and_original_stop_join_are_preserved() {
+    let mut f = Fixture::new(Medium::Audio).await;
+    f.policy.mode.store(1, Ordering::SeqCst);
+    let (send, stop, task) = f.start();
+    send.send(f.packet(9, 160)).await.unwrap();
+    f.wait_attempt(0).await;
+    // One original is in-flight. The unchanged ten-slot ordered adapter queue
+    // must refuse the eleventh pending original without making a new owner.
+    for sequence in 20..30 {
+        send.try_send(f.packet(sequence, sequence as u32 * 160))
+            .unwrap();
+    }
+    assert!(matches!(
+        send.try_send(f.packet(30, 4800)),
+        Err(mpsc::error::TrySendError::Full(_))
+    ));
+    stop.cancel();
+    tokio::time::timeout(Duration::from_millis(250), task)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert!(send.is_closed());
+    assert!(f.input.try_recv().is_err());
+    f.policy.mode.store(0, Ordering::SeqCst);
+    f.publish_fresh(40, 6400);
+    assert_eq!(timestamps(&f.delivered(1).await), [6400]);
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+    assert_eq!(f.b.shutdown(deadline()).await, 0);
+    drop(
+        f.policy
+            .guard
+            .clone()
+            .try_write_owned()
+            .expect("original stop retained authority"),
+    );
