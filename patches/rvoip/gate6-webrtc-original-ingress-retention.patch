+        ));
+        (send, stop, task)
+    }
+    async fn wait_attempt(&self, previous: usize) {
+        tokio::time::timeout(Duration::from_millis(100), async {
+            while self.policy.attempts.load(Ordering::SeqCst) <= previous {
+                tokio::time::sleep(Duration::from_millis(1)).await;
+            }
+        })
+        .await
+        .expect("original policy boundary was not reached");
+    }
+    async fn delivered(&mut self, limit: usize) -> Vec<MediaFrame> {
+        let mut frames = Vec::new();
+        let until = tokio::time::Instant::now() + Duration::from_millis(85);
+        while frames.len() < limit {
+            let Ok(Some(packet)) = tokio::time::timeout_at(until, self.input.recv()).await else {
+                break;
+            };
+            packet
+                .try_forward_to(&self.b, &desired(self.medium).logical_id)
+                .unwrap();
+            let queued = self.output.try_recv().unwrap();
+            let result = Arc::new(Mutex::new(None));
+            let out = result.clone();
+            queued
+                .deliver(move |frame| async move {
+                    *out.lock().unwrap() = Some(frame);
+                    Ok(())
+                })
+                .await
+                .unwrap();
+            frames.push(result.lock().unwrap().take().unwrap());
+        }
+        frames
+    }
+    fn fill_core_input(&self) -> usize {
+        let count = self.port.ingress_capacity().0;
+        for sequence in 0..count {
+            self.publish_fresh(sequence as u16 + 100, sequence as u32 * 160);
+        }
+        assert_eq!(self.port.ingress_capacity().1, 0);
+        count
+    }
+    fn publish_fresh(&self, sequence: u16, timestamp: u32) {
+        let packet = self.packet(sequence, timestamp);
+        self.port
+            .try_publish(&MediaFrame {
+                stream_id: self.port.binding().transport_id.clone(),
+                kind: if self.medium == Medium::Audio {
+                    StreamKind::Audio
+                } else {
+                    StreamKind::Video
+                },
+                payload: if self.medium == Medium::Audio {
+                    packet.packet.payload.clone()
+                } else {
+                    packet.packet.marshal().unwrap().freeze()
+                },
+                timestamp_rtp: timestamp,
+                captured_at: Utc::now(),
+                payload_type: Some(self.source.payload_type),
+                source_clock: None,
+            })
+            .unwrap();
+    }
+    async fn finish(
+        self,
+        stop: CancellationToken,
+        task: tokio::task::JoinHandle<ControlResult<()>>,
+    ) {
+        stop.cancel();
+        tokio::time::timeout(Duration::from_millis(250), task)
+            .await
+            .expect("original RTC ingress did not join")
+            .unwrap()
+            .unwrap();
+        assert_eq!(self.a.shutdown(deadline()).await, 0);
+        assert_eq!(self.b.shutdown(deadline()).await, 0);
+        drop(
+            self.policy
+                .guard
+                .clone()
+                .try_write_owned()
+                .expect("retirement retained authority"),
+        );
+    }
+}
+fn timestamps(frames: &[MediaFrame]) -> Vec<u32> {
+    frames.iter().map(|frame| frame.timestamp_rtp).collect()
+}
