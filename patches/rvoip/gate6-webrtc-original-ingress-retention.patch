+#[tokio::test]
+async fn rtc_original_ingress_keeps_original_age_and_earlier_grant_cutoffs() {
+    for short_grant in [false, true] {
+        let mut f = Fixture::new(Medium::Audio).await;
+        let count = if short_grant { f.fill_core_input() } else { 0 };
+        if short_grant {
+            *f.policy.grant_until.lock().unwrap() =
+                Some(Utc::now() + chrono::Duration::milliseconds(60));
+        } else {
+            f.policy.mode.store(1, Ordering::SeqCst);
+        }
+        let attempts = f.policy.attempts.load(Ordering::SeqCst);
+        let (send, stop, task) = f.start();
+        let original = f.packet(9, 16000);
+        let at = original.at;
+        send.send(original).await.unwrap();
+        f.wait_attempt(attempts).await;
+        // A longer later grant must not renew the already observed deadline.
+        *f.policy.grant_until.lock().unwrap() = None;
+        tokio::time::sleep(Duration::from_millis(if short_grant { 80 } else { 215 })).await;
+        if short_grant {
+            assert!(at.elapsed() < Duration::from_millis(180));
+        }
+        for _ in 0..count {
+            drop(f.input.try_recv().unwrap());
+        }
+        f.policy.mode.store(0, Ordering::SeqCst);
+        send.send(f.packet(10, 16160)).await.unwrap();
+        let times = timestamps(&f.delivered(2).await);
+        f.finish(stop, task).await;
+        assert_eq!(
+            times,
+            [16160],
+            "old original escaped cutoff short_grant={short_grant}"
+        );
+    }
+}
