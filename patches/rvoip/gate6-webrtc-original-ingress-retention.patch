+#[tokio::test]
+async fn rtc_original_ingress_refuses_semantic_readiness_revocation_and_generation_changes() {
+    for medium in [Medium::Audio, Medium::Video] {
+        for action in 0..4 {
+            let mut f = Fixture::new(medium).await;
+            f.policy.mode.store(1, Ordering::SeqCst);
+            let (send, stop, task) = f.start();
+            send.send(f.packet(9, 160)).await.unwrap();
+            f.wait_attempt(0).await;
+            match action {
+                0 | 1 => {
+                    let attempts = f.policy.attempts.load(Ordering::SeqCst);
+                    f.policy
+                        .mode
+                        .store(if action == 0 { 2 } else { 3 }, Ordering::SeqCst);
+                    f.wait_attempt(attempts).await;
+                }
+                2 => {
+                    let ids = [desired(medium).logical_id].into_iter().collect();
+                    for gate in [StreamGateAction::Mute, StreamGateAction::Unmute] {
+                        f.a.set_media_gate(f.a.revision(), &ids, gate, deadline())
+                            .await
+                            .unwrap();
+                    }
+                }
+                3 => {
+                    f.clock.cname(77, b"new-generation");
+                    assert!(f.clock.sender_report(77, 12 << 32, 0, 3, 102 << 32));
+                }
+                _ => unreachable!(),
+            }
+            f.policy.mode.store(0, Ordering::SeqCst);
+            send.send(f.packet(10, 320)).await.unwrap();
+            let frames = f.delivered(2).await;
+            let times = timestamps(&frames);
+            f.finish(stop, task).await;
+            assert_eq!(
+                times,
+                [320],
+                "retained old RTC original adopted change {action} for {medium:?}"
+            );
+        }
+    }
+}
