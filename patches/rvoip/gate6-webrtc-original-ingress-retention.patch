+#[tokio::test]
+async fn original_ingress_queue_full_keeps_same_frame_and_fresh_current_authority() {
+    for medium in [Medium::Audio, Medium::Video] {
+        let (f, mode) = fixture().await;
+        mode.store(0, Ordering::SeqCst);
+        let port = f.aa.port(medium);
+        let mut input = f.a.take_ingress(&desired(medium).logical_id).unwrap();
+        let capacity = port.ingress_capacity().0;
+        for sequence in 0..capacity {
+            port.try_publish(&frame(&port, sequence as u32 * 160))
+                .unwrap();
+        }
+        let at = Instant::now();
+        let mut original = port
+            .retain_original_ingress(frame(&port, 16000), at)
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::Backpressure)
+        ));
+        drop(
+            f.policy
+                .0
+                .try_write()
+                .expect("full ingress retained authority"),
+        );
+        for _ in 0..capacity {
+            drop(input.try_recv().unwrap());
+        }
+        mode.store(1, Ordering::SeqCst);
+        assert!(
+            matches!(
+                original.try_publish_clocked(|_| None),
+                Err(StreamControlError::MetadataBusy)
+            ),
+            "retry did not obtain fresh authority"
+        );
+        mode.store(0, Ordering::SeqCst);
+        original.try_publish_clocked(|_| None).unwrap();
+        let packet = input.try_recv().unwrap();
+        assert_eq!(packet.frame.timestamp_rtp, 16000);
+        assert_eq!(packet.admitted_at, at);
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::Cancelled)
+        ));
+        assert!(input.try_recv().is_err());
+    }
+}
