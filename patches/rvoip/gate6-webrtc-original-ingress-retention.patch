+#[tokio::test]
+async fn original_ingress_queue_full_cannot_refresh_credentials_gates_or_age() {
+    for action in 0..5 {
+        let (f, mode) = fixture().await;
+        mode.store(0, Ordering::SeqCst);
+        let port = f.aa.port(Medium::Audio);
+        let id = desired(Medium::Audio).logical_id;
+        let mut input = f.a.take_ingress(&id).unwrap();
+        let capacity = port.ingress_capacity().0;
+        for sequence in 0..capacity {
+            port.try_publish(&frame(&port, sequence as u32 * 160))
+                .unwrap();
+        }
+        let mut original = port
+            .retain_original_ingress(frame(&port, 16000), Instant::now())
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::Backpressure)
+        ));
+        for _ in 0..capacity {
+            drop(input.try_recv().unwrap());
+        }
+        match action {
+            0 => {
+                f.policy
+                    .0
+                    .try_write()
+                    .unwrap()
+                    .revoked
+                    .insert("alice".into());
+            }
+            1 => f.a.credential.lock().unwrap().revision += 1,
+            2 => {
+                let ids = [id].into_iter().collect();
+                for gate in [StreamGateAction::Mute, StreamGateAction::Unmute] {
+                    f.a.set_media_gate(f.a.revision(), &ids, gate, deadline())
+                        .await
+                        .unwrap();
+                }
+            }
+            3 => f.a.shutdown.cancel(),
+            4 => tokio::time::sleep(Duration::from_millis(205)).await,
+            _ => unreachable!(),
+        }
+        assert!(
+            original.try_publish_clocked(|_| None).is_err(),
+            "queue full refreshed original action {action}"
+        );
+        assert!(input.try_recv().is_err());
+        drop(f.policy.0.try_write().unwrap());
+    }
+}
