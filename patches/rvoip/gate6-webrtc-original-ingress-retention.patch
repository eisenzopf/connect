+#[tokio::test]
+async fn rtc_original_ingress_recovers_exact_once_and_fresh_control() {
+    let mut observations = Vec::new();
+    for medium in [Medium::Audio, Medium::Video] {
+        let mut f = Fixture::new(medium).await;
+        f.policy.mode.store(1, Ordering::SeqCst);
+        let (send, stop, task) = f.start();
+        let original = f.packet(9, 160);
+        let original_at = original.at;
+        let original_payload = if medium == Medium::Audio {
+            original.packet.payload.clone()
+        } else {
+            original.packet.marshal().unwrap().freeze()
+        };
+        send.send(original).await.unwrap();
+        f.wait_attempt(0).await;
+        assert!(f.input.try_recv().is_err());
+        drop(
+            f.policy
+                .guard
+                .clone()
+                .try_write_owned()
+                .expect("refused receive held authority"),
+        );
+        // The same clock generation has a later SR. The pending frame must keep
+        // its original anchor; a distinct later packet may use the new anchor.
+        assert!(f.clock.sender_report(77, 11 << 32, 8000, 2, 101 << 32));
+        f.policy.mode.store(0, Ordering::SeqCst);
+        send.send(f.packet(10, 320)).await.unwrap();
+        let frames = f.delivered(2).await;
+        let times = timestamps(&frames);
+        let exact = frames.first().is_some_and(|frame| {
+            frame.timestamp_rtp == 160
+                && frame.payload == original_payload
+                && frame.source_clock.as_ref().is_some_and(|clock| {
+                    clock.anchor.unwrap().ntp_time == 100 << 32 && (clock.is_current)()
+                })
+        });
+        let fresh = frames.iter().any(|frame| frame.timestamp_rtp == 320);
+        let no_duplicates = f.input.try_recv().is_err();
+        println!(
+            "rtc_original_recovery medium={medium:?} original={exact} fresh={fresh} times={times:?} original_age_ms={}",
+            original_at.elapsed().as_millis()
+        );
+        let original_attempts = f.policy.original_attempts.load(Ordering::SeqCst);
+        println!("rtc_original_policy medium={medium:?} attempts={original_attempts}");
+        observations
+            .push(exact && fresh && times == [160, 320] && no_duplicates && original_attempts >= 3);
+        f.finish(stop, task).await;
+    }
+    assert!(
+        observations.into_iter().all(|value| value),
+        "RTC metadata refusal discarded or replaced the original frame"
+    );
+}
