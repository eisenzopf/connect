+//! Actual RTC ingress worker and Core queues. Synthetic policy exclusion is
+//! mapped exactly as Connect does: legacy NotReady, original MetadataBusy.
+use super::*;
+use crate::peer::source_clock::{ClockTrack, SourceClock};
+use bytes::Bytes;
+use rvoip_core::{
+    capability::DataProtocol,
+    identity::AuthenticationMethod,
+    participant::{ParticipantKind, ParticipantRole},
+    relationships::{ConnectionBinding, IdentityBinding, SessionAppearance},
+};
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+use tokio::sync::{OwnedRwLockReadGuard, RwLock};
+
+fn principal(name: &str) -> AuthenticatedPrincipal {
+    AuthenticatedPrincipal {
+        subject: name.into(),
+        tenant: Some("tenant".into()),
+        scopes: vec![],
+        issuer: Some("fixture".into()),
+        expires_at: Some(chrono::Utc::now() + chrono::Duration::hours(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Anonymous,
+    }
+}
+fn audio() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "pcmu".into(),
+        clock_rate_hz: 8000,
+        channels: 1,
+        fmtp: None,
+    }
+}
+fn video() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "vp8".into(),
+        clock_rate_hz: 90000,
+        channels: 0,
+        fmtp: None,
+    }
+}
+fn profile() -> EndpointMediaCapabilities {
+    let capabilities = vec![
+        MediaCapability {
+            medium: Medium::Audio,
+            formats: vec![audio()],
+        },
+        MediaCapability {
+            medium: Medium::Video,
+            formats: vec![video()],
+        },
+        MediaCapability {
+            medium: Medium::Screen,
+            formats: vec![video()],
+        },
+        MediaCapability {
+            medium: Medium::Data,
+            formats: vec![MediaFormat::ReliableOrdered(DataProtocol::Json)],
+        },
+    ];
+    EndpointMediaCapabilities {
+        send: capabilities.clone(),
+        receive: capabilities,
+        max_streams: 8,
+        renegotiation: true,
+    }
+}
+fn desired(kind: Medium) -> DesiredStream {
+    DesiredStream {
+        logical_id: StreamId::from_string(match kind {
+            Medium::Audio => "audio",
+            Medium::Video => "video",
+            Medium::Screen => "screen",
+            Medium::Data => "data",
+        }),
+        medium: kind,
+        direction: StreamDirection::Both,
+    }
+}
+fn owner(name: &str) -> MediaOwner {
+    let principal = principal(name);
+    let identity = IdentityBinding::from_authenticated(
+        &principal,
+        IdentityId::from_string(name),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let member = Membership::admit(
+        identity.clone(),
+        ConversationId::from_string("conversation"),
+        ParticipantId::from_string(format!("participant-{name}")),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+    )
+    .unwrap();
+    let presence =
+        SessionAppearance::admit(&member, SessionId::from_string("session"), None).unwrap();
+    let mut endpoint = EndpointBinding::provision(
+        identity.clone(),
+        EndpointId::from_string(format!("endpoint-{name}")),
+        DeviceId::from_string(format!("device-{name}")),
+        Transport::WebRtc,
+        "fixture-address".into(),
+    )
+    .unwrap();
+    endpoint
+        .verify(&identity, "fixture-evidence".into(), chrono::Utc::now())
+        .unwrap();
+    let mut connection = ConnectionBinding::prepare(
+        &member,
+        &presence,
+        &endpoint,
+        ConnectionId::from_string(name),
+    )
+    .unwrap();
+    connection
+        .observe_ready(&member, &presence, &endpoint, 1)
+        .unwrap();
+    connection.activate(&member, &presence, &endpoint).unwrap();
+    MediaOwner {
+        actor: member.clone(),
+        member,
+        presence,
+        endpoint,
+        connection,
+        may_control: true,
+        send_media: [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+            .into_iter()
+            .collect(),
+        receive_media: [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+            .into_iter()
+            .collect(),
+        local: profile(),
+        remote: profile(),
+        may_route_source: true,
+    }
+}
+struct Policy {
+    owners: HashMap<String, MediaOwner>,
+    guard: Arc<RwLock<()>>,
+    mode: AtomicUsize,
+    attempts: AtomicUsize,
+    original_attempts: AtomicUsize,
+    grant_until: Mutex<Option<chrono::DateTime<Utc>>>,
+}
+struct Lease {
+    owner: MediaOwner,
+    _guard: OwnedRwLockReadGuard<()>,
+    until: Option<chrono::DateTime<Utc>>,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<Utc>> {
+        self.until
+    }
+}
+impl Policy {
+    fn read(
+        &self,
+        scope: &MediaScope<'_>,
+        original: bool,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if scope.connection.as_str() == "alice" && matches!(scope.purpose, MediaPurpose::Publish) {
+            self.attempts.fetch_add(1, Ordering::SeqCst);
+            if original {
+                self.original_attempts.fetch_add(1, Ordering::SeqCst);
+            }
+            match self.mode.load(Ordering::SeqCst) {
+                1 => {
+                    return Err(if original {
+                        StreamControlError::MetadataBusy
+                    } else {
+                        StreamControlError::NotReady
+                    });
+                }
+                2 => return Err(StreamControlError::NotReady),
+                3 => return Err(StreamControlError::Authority),
+                _ => {}
+            }
+        }
+        let guard = self
+            .guard
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        Ok(Box::new(Lease {
+            owner: self.owners.get(scope.connection.as_str()).unwrap().clone(),
+            _guard: guard,
+            until: if scope.connection.as_str() == "alice"
+                && matches!(scope.purpose, MediaPurpose::Publish)
+            {
+                *self.grant_until.lock().unwrap()
+            } else {
+                None
+            },
+        }))
+    }
+}
+impl MediaPolicy for Policy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.read(scope, false)
+    }
+    fn current_original_ingress(
+        &self,
+        scope: &MediaScope<'_>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.read(scope, true)
+    }
+}
+struct Cleanup;
+#[async_trait::async_trait]
+impl MediaPortCleanup for Cleanup {
+    async fn close(&self) -> ControlResult<()> {
+        Ok(())
+    }
+}
+#[derive(Default)]
+struct Adapter(Mutex<BTreeMap<StreamId, AdapterMediaPort>>);
+impl Adapter {
+    fn port(&self, medium: Medium) -> AdapterMediaPort {
+        self.0.lock().unwrap()[&desired(medium).logical_id].clone()
+    }
+}
+#[async_trait::async_trait]
+impl StagedMediaAdapter for Adapter {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<()> {
+        for preparation in ports {
+            let port = preparation.port;
+            if preparation.is_new {
+                port.install_cleanup(Arc::new(Cleanup))?;
+                let pt = if port.binding().negotiated.requested.medium == Medium::Audio {
+                    0
+                } else {
+                    96
+                };
+                port.observe_ready(&port.binding().negotiated.format, true, true, Some(pt))?;
+            }
+            self.0
+                .lock()
+                .unwrap()
+                .insert(port.binding().negotiated.requested.logical_id.clone(), port);
+        }
+        Ok(())
+    }
+}
+struct Fixture {
