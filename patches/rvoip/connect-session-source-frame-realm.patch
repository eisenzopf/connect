+#[cfg(test)]
+mod source_realm_tests {
+    use super::*;
+    use rvoip_core::{ids::{ConversationId,SessionId},staged_streams::frame_realm::FrameRealmTestOwner};
+    fn owner()->FrameRealmTestOwner {FrameRealmTestOwner::new(ConversationId::from_string("conversation"),SessionId::from_string("session"))}
+    fn packet(seq:u16,ts:u32,marker:bool)->rtp::Packet {
+        rtp::Packet {header:rtp::Header {version:2,ssrc:77,payload_type:96,sequence_number:seq,timestamp:ts,marker,..Default::default()},payload:vec![0x10;1400].into()}
+    }
+    fn mapper(realm:Option<SourceFrameRealm>,incarnation:u128)->SequenceMapper {
+        let mut mapper=SequenceMapper::default();mapper.observe_original_source(Some(incarnation),77);mapper.observe_frame_realm(realm);mapper
+    }
+    #[test]
+    fn source_realm_group_allocates_once_before_fragments_duplicates_and_source_changes() {
+        let realm=owner();let mut a=mapper(Some(realm.handle()),1);
+        let original=packet(10,u32::MAX-2999,false);
+        assert_eq!(normalize(original.clone(),&mut a).unwrap().len(),2);
+        let first=a.original_frame().unwrap().clone();assert_eq!(first.frame_realm().unwrap().ordinal(),1);
+        normalize(packet(11,u32::MAX-2999,true),&mut a).unwrap();assert!(Arc::ptr_eq(a.original_frame().unwrap(),&first));
+        normalize(packet(12,0,true),&mut a).unwrap();let second=a.original_frame().unwrap().clone();assert_eq!(second.frame_realm().unwrap().ordinal(),2);
+        normalize(original,&mut a).unwrap();assert!(Arc::ptr_eq(a.original_frame().unwrap(),&first));
+        let mut b=mapper(Some(realm.handle()),2);normalize(packet(1,90000,true),&mut b).unwrap();
+        assert_eq!(b.original_frame().unwrap().frame_realm().unwrap().ordinal(),3);
+        assert_ne!(b.original_frame().unwrap().source_incarnation(),first.source_incarnation());
+        assert_eq!(b.original_frame().unwrap().frame_realm().unwrap().incarnation(),first.frame_realm().unwrap().incarnation());
+    }
+    #[test]
+    fn source_realm_missing_dead_late_or_exhausted_keeps_group_and_ordinary_packets() {
+        let realm=owner();let mut missing=mapper(None,1);
+        let original=packet(10,90000,true);let expected=normalize(original.clone(),&mut missing).unwrap();
+        let first=missing.original_frame().unwrap().clone();assert!(first.frame_realm().is_none());
+        missing.observe_frame_realm(Some(realm.handle()));
+        let repeated=normalize(original,&mut missing).unwrap();assert_eq!(repeated[0].payload,expected[0].payload);assert!(Arc::ptr_eq(missing.original_frame().unwrap(),&first));
+        normalize(packet(11,93000,true),&mut missing).unwrap();assert!(missing.original_frame().unwrap().frame_realm().is_none());
+        let dead=owner();let mut gone=mapper(Some(dead.handle()),1);drop(dead);
+        assert_eq!(normalize(packet(10,90000,true),&mut gone).unwrap().len(),2);assert!(gone.original_frame().unwrap().frame_realm().is_none());
+        let full=FrameRealmTestOwner::with_last_for_test(ConversationId::new(),SessionId::new(),u64::MAX);
+        let mut exhausted=mapper(Some(full.handle()),1);
+        assert_eq!(normalize(packet(10,90000,true),&mut exhausted).unwrap().len(),2);assert!(exhausted.original_frame().unwrap().frame_realm().is_none());
+        // Same public namespace in another runtime cannot compare by ordinal.
+        let another=owner();let mut other=mapper(Some(another.handle()),1);normalize(packet(10,90000,true),&mut other).unwrap();
+        let mut known=mapper(Some(realm.handle()),1);normalize(packet(10,90000,true),&mut known).unwrap();
+        assert_ne!(known.original_frame().unwrap().frame_realm().unwrap().incarnation(),other.original_frame().unwrap().frame_realm().unwrap().incarnation());
+    }
