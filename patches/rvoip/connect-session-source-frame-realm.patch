+//! Optional original-frame provenance for ONE retained local managed runtime.
+//! No IO permission, delivery/readiness certificate or cross-runtime transfer.
+use crate::ids::{ConversationId,SessionId};
+use std::sync::{Arc,Weak,atomic::{AtomicU64,Ordering}};
+
+pub(crate) struct SessionFrameRealm {
+    incarnation:u128,
+    conversation:ConversationId,
+    session:SessionId,
+    last:AtomicU64,
+}
+impl SessionFrameRealm {
+    pub(crate) fn new(conversation:ConversationId,session:SessionId) -> Arc<Self> {
+        Arc::new(Self {incarnation:uuid::Uuid::new_v4().as_u128(),conversation,session,last:AtomicU64::new(0)})
+    }
+    pub(crate) fn handle(self:&Arc<Self>) -> SourceFrameRealm {SourceFrameRealm(Arc::downgrade(self))}
+}
+/// Opaque setup-only weak metadata handle. Only Core creates production realms;
+/// cloning one neither retains its runtime nor grants current source authority.
+#[derive(Clone)]
+pub struct SourceFrameRealm(Weak<SessionFrameRealm>);
+impl SourceFrameRealm {
+    /// Setup identity only; a live weak owner is NOT current IO authority.
+    pub fn incarnation(&self)->Option<u128> {self.0.upgrade().map(|realm|realm.incarnation)}
+    /// Frozen namespace comparison only, never an authorization/liveness grant.
+    pub fn for_scope(&self,conversation:&ConversationId,session:&SessionId) -> Option<Self> {
+        let realm=self.0.upgrade()?;
+        (&realm.conversation==conversation && &realm.session==session).then(||self.clone())
+    }
+    pub(super) fn next_point(&self) -> Option<SourceFrameRealmPoint> {
+        let realm=self.0.upgrade()?;
+        let last=realm.last.fetch_update(Ordering::Relaxed,Ordering::Relaxed,|last|last.checked_add(1)).ok()?;
+        Some(SourceFrameRealmPoint {incarnation:realm.incarnation,ordinal:last+1})
+    }
+}
+/// Scalar original accepted source-group ordering, NOT capture/content/IO proof.
+/// Only points with the SAME actual runtime incarnation may be compared.
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub struct SourceFrameRealmPoint {incarnation:u128,ordinal:u64}
+impl SourceFrameRealmPoint {
+    pub fn incarnation(&self)->u128 {self.incarnation}
+    pub fn ordinal(&self)->u64 {self.ordinal}
+}
+
+/// Isolated metadata-only owner for existing explicit test-support composition.
+/// No controller, scene, policy, adapter or media permission is created.
+#[cfg(feature="test-support")]
+pub struct FrameRealmTestOwner(Arc<SessionFrameRealm>);
+#[cfg(feature="test-support")]
+impl FrameRealmTestOwner {
+    pub fn new(conversation:ConversationId,session:SessionId)->Self {Self(SessionFrameRealm::new(conversation,session))}
+    pub fn handle(&self)->SourceFrameRealm {self.0.handle()}
+    pub fn with_last_for_test(conversation:ConversationId,session:SessionId,last:u64)->Self {
+        let owner=Self::new(conversation,session);owner.0.last.store(last,Ordering::Relaxed);owner
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn frame_realm_scope_runtime_identity_and_weak_retirement_are_distinct() {
+        let conversation=ConversationId::from_string("conversation");let session=SessionId::from_string("session");
+        let a=SessionFrameRealm::new(conversation.clone(),session.clone());let b=SessionFrameRealm::new(conversation.clone(),session.clone());
+        let handle=a.handle();assert!(handle.for_scope(&conversation,&session).is_some());
+        assert!(handle.for_scope(&ConversationId::from_string("foreign"),&session).is_none());
+        assert!(handle.for_scope(&conversation,&SessionId::from_string("foreign")).is_none());
+        let first=handle.next_point().unwrap();let other=b.handle().next_point().unwrap();
+        assert_eq!(first.ordinal(),1);assert_eq!(other.ordinal(),1);assert_ne!(first.incarnation(),other.incarnation());
+        drop(a);assert!(handle.incarnation().is_none());assert!(handle.next_point().is_none());
+        assert_eq!(first.ordinal(),1); // historical scalar, not a live grant
+        assert!(b.handle().next_point().is_some());
+    }
+    #[test]
+    fn frame_realm_concurrent_sources_share_checked_nonwrapping_order_without_quota() {
+        let realm=SessionFrameRealm::new(ConversationId::new(),SessionId::new());let handle=realm.handle();
+        let jobs:Vec<_>=(0..4).map(|_|{let handle=handle.clone();std::thread::spawn(move||(0..80).map(|_|handle.next_point().unwrap()).collect::<Vec<_>>())}).collect();
+        let points:Vec<_>=jobs.into_iter().flat_map(|job|job.join().unwrap()).collect();
+        let ordinals:std::collections::BTreeSet<_>=points.iter().map(|point|point.ordinal()).collect();
+        assert_eq!(ordinals,(1..=320).collect());assert!(points.iter().all(|point|point.incarnation()==realm.incarnation));
+        // Checked numerical exhaustion is unavailable metadata, not wrap/reuse.
+        realm.last.store(u64::MAX-1,Ordering::Relaxed);
+        assert_eq!(handle.next_point().unwrap().ordinal(),u64::MAX);
+        assert!(handle.next_point().is_none());assert_eq!(realm.last.load(Ordering::Relaxed),u64::MAX);
+    }
+}
