+//! Actual retained managed runtime -> original Core adapter preparation hook.
+//! Dormant error-only adapters allocate no transport/codec/media resources.
+use super::*;
+use chrono::Utc;
+use crate::{adapter::*,capability::{CapabilityDescriptor,NegotiatedCodecs},identity::{CredentialKind,IdentityAssurance},ids::{DeviceId,EndpointId},message::Message,peer_admission::PeerAdmissionOwner,relationships::IdentityBinding,staged_streams::{MediaPolicy,MediaScope,MediaAuthorityLease,OriginalVideoFrame,SourceFrameRealm},orchestrator::participant_control::ParticipantLimits,stream::MediaStream};
+#[allow(dead_code)]
+#[path="../../../tests/support/participant_control_fixture.rs"]
+mod fixture;
+use fixture::{Fixture,participant,principal};
+struct NoMedia;
+impl MediaPolicy for NoMedia {
+    fn current(&self,_:&MediaScope<'_>)->crate::staged_streams::ControlResult<Box<dyn MediaAuthorityLease>> {Err(crate::staged_streams::StreamControlError::Authority)}
+}
+struct Authority(PeerNativeAuthority);
+impl PeerNativeAuthorityLease for Authority {fn authority(&self)->&PeerNativeAuthority {&self.0}}
+struct HookAdapter {
+    transport:Transport,
+    observed:Mutex<Vec<Option<SourceFrameRealm>>>,
+    _events:tokio::sync::mpsc::Sender<AdapterEvent>,
+    receiver:Mutex<Option<tokio::sync::mpsc::Receiver<AdapterEvent>>>,
+}
+impl HookAdapter {
+    fn new(transport:Transport)->Arc<Self> {let(events,receiver)=tokio::sync::mpsc::channel(2);Arc::new(Self {transport,observed:Mutex::new(Vec::new()),_events:events,receiver:Mutex::new(Some(receiver))})}
+    fn record(&self,realm:Option<SourceFrameRealm>)->crate::Result<ConnectionHandle> {self.observed.lock().unwrap().push(realm);Err(RvoipError::NotImplemented("dormant hook observed; no physical allocation"))}
+}
+#[async_trait::async_trait]
+impl ConnectionAdapter for HookAdapter {
+    fn transport(&self)->Transport {self.transport}
+    fn kind(&self)->AdapterKind {AdapterKind::Interop}
+    fn lifecycle_capabilities(&self)->AdapterLifecycleCapabilities {AdapterLifecycleCapabilities {authoritative_liveness:true,..Default::default()}}
+    fn is_connection_live(&self,_:&ConnectionId)->bool {false}
+    fn supports_peer_native_preparation(&self)->bool {true}
+    fn supports_peer_webrtc_preparation(&self)->bool {true}
+    fn prepare_peer_native_connection(&self,request:&NativeConnectionRequest)->crate::Result<ConnectionHandle> {self.record(request.source_frame_realm())}
+    fn prepare_peer_webrtc_connection(&self,request:&WebRtcConnectionRequest)->crate::Result<ConnectionHandle> {self.record(request.source_frame_realm())}
+    async fn originate(&self,_:OriginateRequest)->crate::Result<ConnectionHandle> {Err(RvoipError::NotImplemented("fixture"))}
+    async fn accept(&self,_:ConnectionId)->crate::Result<()> {Ok(())}
+    async fn reject(&self,_:ConnectionId,_:RejectReason)->crate::Result<()> {Ok(())}
+    async fn end(&self,_:ConnectionId,_:EndReason)->crate::Result<()> {Ok(())}
+    async fn hold(&self,_:ConnectionId)->crate::Result<()> {Ok(())}
+    async fn resume(&self,_:ConnectionId)->crate::Result<()> {Ok(())}
+    async fn transfer(&self,_:ConnectionId,_:TransferTarget)->crate::Result<()> {Ok(())}
+    async fn streams(&self,_:ConnectionId)->crate::Result<Vec<Arc<dyn MediaStream>>> {Ok(vec![])}
+    async fn send_message(&self,_:ConnectionId,_:Message)->crate::Result<()> {Ok(())}
+    async fn send_dtmf(&self,_:ConnectionId,_:&str,_:u32)->crate::Result<()> {Ok(())}
+    async fn renegotiate_media(&self,_:ConnectionId,_:CapabilityDescriptor)->crate::Result<NegotiatedCodecs> {Ok(NegotiatedCodecs::default())}
+    fn subscribe_events(&self)->tokio::sync::mpsc::Receiver<AdapterEvent> {self.receiver.lock().unwrap().take().unwrap()}
+    fn capabilities(&self)->CapabilityDescriptor {CapabilityDescriptor::default()}
+    async fn verify_request_signature(&self,_:ConnectionId,_:SignatureHeaders)->crate::Result<IdentityAssurance> {Ok(IdentityAssurance::Anonymous)}
+}
+#[tokio::test]
+async fn retained_runtime_realm_is_frozen_in_core_native_and_webrtc_request_before_hook() {
+    let f=Fixture::new().await;
+    let sid=f.orch.start_session(f.conversation.clone(),SessionMedium::Voice,vec![]).await.unwrap();
+    assert!(f.orch.source_frame_realm_for_preparation(&sid,&f.conversation).is_none());
+    f.orch.enable_staged_participant_control(&sid,f.policy.clone(),Arc::new(NoMedia),ParticipantLimits::default()).unwrap();
+    let retained=f.orch.source_frame_realm_for_preparation(&sid,&f.conversation).unwrap();
+    let native=HookAdapter::new(Transport::Quic);let rtc=HookAdapter::new(Transport::WebRtc);
+    f.orch.register(native.clone()).unwrap();f.orch.register(rtc.clone()).unwrap();
+    let mut actor=principal("alice");actor.expires_at=Some(Utc::now()+chrono::Duration::minutes(5));actor.assurance=IdentityAssurance::Identified {credential_kind:CredentialKind::Oidc};
+    let member=f.policy.0.read().unwrap().members[&participant("alice")].clone();
+    let identity=IdentityBinding::from_authenticated(&actor,member.identity().clone(),Utc::now()).unwrap();
+    let device=DeviceId::new();
+    let owner=PeerAdmissionOwner::new(&actor,member.identity().clone(),device.clone(),CancellationToken::new(),Default::default()).unwrap();
+    let mut owned_work=Box::pin(async {
+        assert!(f.orch.source_frame_realm_for_preparation(&sid,&ConversationId::new()).is_none());
+        for transport in [Transport::Quic,Transport::WebRtc] {
+            let mut endpoint=EndpointBinding::provision(identity.clone(),EndpointId::new(),device.clone(),transport,"fixture".into()).unwrap();
+            endpoint.verify(&identity,"fixture-proof".into(),Utc::now()).unwrap();
+            let authority=Authority(PeerNativeAuthority {actor:member.clone(),endpoint,may_prepare:true});
+            let connection=ConnectionId::new();
+            // Actual Core public entrypoint reserves ownership and constructs
+            // the original request before invoking our dormant adapter hook.
+            let refused=if transport==Transport::WebRtc {
+                matches!(f.orch.prepare_peer_webrtc_connection(owner.peer(),&actor,PeerWebRtcIntent {session:sid.clone(),connection},&authority,Arc::new(())),Err(PeerNativeError::Adapter))
+            } else {
+                matches!(f.orch.prepare_peer_native_connection(owner.peer(),&actor,PeerNativeIntent {session:sid.clone(),connection,transport},&authority,Arc::new(())),Err(PeerNativeError::Adapter))
+            };
+            assert!(refused,"actual hook must run and deliberately return its no-allocation error");
+        }
+        // Original Core retirement tasks, not a fresh route or manual permit
+        // replacement, release the exact failed preparations before oracles.
+        tokio::time::timeout(std::time::Duration::from_secs(2),async {while owner.peer().snapshot().connections!=0 {tokio::task::yield_now().await}}).await.unwrap();
+        let n=native.observed.lock().unwrap();let w=rtc.observed.lock().unwrap();
+        assert_eq!(n.len(),1);assert_eq!(w.len(),1);
+        let a=n[0].as_ref().unwrap();let b=w[0].as_ref().unwrap();
+        assert_eq!(a.incarnation(),retained.incarnation());assert_eq!(b.incarnation(),retained.incarnation());
+        let first=OriginalVideoFrame::observed_in_realm(17,77,90000,90000,Some(a));
+        let second=OriginalVideoFrame::observed_in_realm(18,88,90000,90000,Some(b));
+        assert_eq!(first.frame_realm().unwrap().incarnation(),second.frame_realm().unwrap().incarnation());
+        assert_eq!(second.frame_realm().unwrap().ordinal(),first.frame_realm().unwrap().ordinal()+1);
+    });
+    let work=std::future::poll_fn(|cx|match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||std::future::Future::poll(owned_work.as_mut(),cx))) {
+        Ok(std::task::Poll::Pending)=>std::task::Poll::Pending,
+        Ok(std::task::Poll::Ready(value))=>std::task::Poll::Ready(Ok(value)),
+        Err(error)=>std::task::Poll::Ready(Err(error)),
+    }).await;
+    drop(owned_work);
+    // Join BOTH original managed runtimes even if a behavior oracle failed.
+    let ended=f.orch.end_session(sid.clone(),EndReason::Normal).await;
+    let base_ended=f.orch.end_session(f.session.clone(),EndReason::Normal).await;
+    let clean_connections=owner.peer().snapshot().connections;
+    drop(owner);
+    assert!(ended.is_ok()&&base_ended.is_ok());assert_eq!(clean_connections,0);
+    if let Err(error)=work {std::panic::resume_unwind(error)}
+    // Stored request handles are weak: retaining diagnostics cannot retain the
+    // runtime, while already-born scalar points remain historical provenance.
+    assert!(retained.incarnation().is_none());
+    assert!(native.observed.lock().unwrap()[0].as_ref().unwrap().incarnation().is_none());
+    assert!(rtc.observed.lock().unwrap()[0].as_ref().unwrap().incarnation().is_none());
+    assert!(OriginalVideoFrame::observed_in_realm(17,77,93000,93000,Some(&retained)).frame_realm().is_none());
+    assert!(f.orch.enable_staged_participant_control(&sid,f.policy.clone(),Arc::new(NoMedia),ParticipantLimits::default()).is_err());
+}
