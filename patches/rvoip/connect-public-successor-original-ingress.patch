+++ b/crates/foundation/rvoip-core/src/staged_streams/successor_ingress.rs
@@ -0,0 +1,515 @@
+//! One bounded, never-private-consumed original across an actual public cut.
+//! This owns provenance only. Publication still obtains a fresh packet-purpose
+//! lease and a real queued epoch after the final Writer has ended.
+use super::*;
+use audio_consumer::{ConsumerCutGuards, ConsumerStamp};
+use audio_subscriptions::{AudioCommit, AudioPlan, SubscriptionStamp};
+use std::sync::atomic::AtomicU8;
+
+const ARMED: u8 = 0;
+const HELD: u8 = 1;
+const RELEASED: u8 = 2;
+const QUEUED: u8 = 3;
+const CLOSED: u8 = 4;
+
+pub(super) struct Registration(Weak<Slot>);
+pub(super) struct Owner(Arc<Slot>);
+pub(super) struct Claim(Arc<Slot>);
+struct Slot {
+    controller: Weak<StreamController>,
+    port: Weak<Port>,
+    credential: CredentialSnapshot,
+    scene: Option<scene_consumer::SceneStamp>,
+    armed_at: Instant,
+    deadline: tokio::time::Instant,
+    cancellation: CancellationToken,
+    phase: AtomicU8,
+    released: std::sync::OnceLock<Arc<Provenance>>,
+    #[cfg(feature="test-support")]
+    observation: Arc<SuccessorObservation>,
+}
+
+// Only the actual successful managed cut constructs/releases this metadata.
+// No Reader/lease, PCM, controller or mutable permission is retained here.
+pub(super) struct Provenance {
+    controller: Weak<StreamController>,
+    port: Weak<Port>,
+    pub(super) credential: CredentialSnapshot,
+    pub(super) scene: Option<scene_consumer::SceneStamp>,
+    pub(super) consumer: ConsumerStamp,
+    pub(super) programme: SubscriptionStamp,
+    pub(super) ticket: PeerRouteTicket,
+    targets: Vec<Target>,
+    #[cfg(feature="test-support")]
+    observation: Arc<SuccessorObservation>,
+    committed_at: Instant,
+    armed_at: Instant,
+    deadline: tokio::time::Instant,
+    cancellation: CancellationToken,
+}
+struct Target {
+    controller: Weak<StreamController>,
+    port: Weak<Port>,
+    consumer: ConsumerStamp,
+    programme: SubscriptionStamp,
+    ticket: PeerRouteTicket,
+}
+
+impl Owner {
+    pub(super) fn arm(
+        plan: &audience::AudioAudiencePlan,
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        credential: &CredentialSnapshot,
+        scene: Option<scene_consumer::SceneStamp>,
+        deadline: tokio::time::Instant,
+        cancellation: &CancellationToken,
+    ) -> ControlResult<Self> {
+        let replacement = plan
+            .replacement
+            .as_ref()
+            .ok_or(StreamControlError::Authority)?;
+        if plan.handoff.is_some()
+            || plan.restore.is_some()
+            || !plan.group.origins.is_empty()
+            || replacement.restoration.is_some()
+            || !replacement.old_speaks
+            || replacement.request.admitted != controller.connection
+            || replacement.new_logical != port.binding.negotiated.requested.logical_id
+            || !plan
+                .controllers
+                .get(&controller.connection)
+                .is_some_and(|expected| Weak::ptr_eq(expected, &Arc::downgrade(controller)))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Self::arm_exact(controller, port, credential, scene, deadline, cancellation)
+    }
+    fn arm_exact(
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        credential: &CredentialSnapshot,
+        scene: Option<scene_consumer::SceneStamp>,
+        deadline: tokio::time::Instant,
+        cancellation: &CancellationToken,
+    ) -> ControlResult<Self> {
+        if !matches!(
+            controller.origin_endpoint.transport(),
+            crate::connection::Transport::Quic
+                | crate::connection::Transport::WebTransport
+                | crate::connection::Transport::WebRtc
+        ) || port.kind() != StreamKind::Audio
+            || controller.shutdown.is_cancelled()
+            || cancellation.is_cancelled()
+            || tokio::time::Instant::now() >= deadline
+        {
+            return Err(StreamControlError::Authority);
+        }
+        controller.check_credential_snapshot(credential)?;
+        let previous = controller.successor_ingress.load_full();
+        if previous
+            .as_ref()
+            .and_then(|r| r.0.upgrade())
+            .is_some_and(|slot| slot.phase.load(Ordering::Acquire) < QUEUED)
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let slot = Arc::new(Slot {
+            controller: Arc::downgrade(controller),
+            port: Arc::downgrade(port),
+            credential: credential.clone(),
+            scene,
+            armed_at: Instant::now(),
+            deadline,
+            cancellation: cancellation.clone(),
+            phase: AtomicU8::new(ARMED),
+            released: std::sync::OnceLock::new(),
+            #[cfg(feature="test-support")]
+            observation: Arc::new(SuccessorObservation::default()),
+        });
+        let next = Arc::new(Registration(Arc::downgrade(&slot)));
+        let saved = controller
+            .successor_ingress
+            .compare_and_swap(&previous, Some(next));
+        let same = match ((&*saved).as_ref(), previous.as_ref()) {
+            (None, None) => true,
+            (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+            _ => false,
+        };
+        if !same {
+            return Err(StreamControlError::MetadataBusy);
+        }
+        Ok(Self(slot))
+    }
+
+    #[cfg(test)]
+    pub(super) fn arm_for_test(
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        deadline: tokio::time::Instant,
+        cancellation: &CancellationToken,
+    ) -> ControlResult<Self> {
+        Self::arm_exact(
+            controller,
+            port,
+            &controller.credential_snapshot(),
+            controller.current_scene_stamp()?,
+            deadline,
+            cancellation,
+        )
+    }
+    #[cfg(test)]
+    pub(super) fn release_for_test(
+        &self,
+        consumer: &Arc<audio_consumer::AudioConsumer>,
+        targets: &[(
+            &Arc<StreamController>,
+            &Arc<Port>,
+            &Arc<audio_consumer::AudioConsumer>,
+        )],
+    ) {
+        let port = self.0.port.upgrade().expect("actual fixture source port");
+        let proof = Arc::new(Provenance {
+            controller: self.0.controller.clone(),
+            port: self.0.port.clone(),
+            credential: self.0.credential.clone(),
+            scene: self.0.scene.clone(),
+            #[cfg(feature="test-support")]
+            observation: self.0.observation.clone(),
+            consumer: consumer.stamp(),
+            programme: consumer.subscriptions.stamp(),
+            ticket: port.ticket(TicketSide::Ingress),
+            targets: targets
+                .iter()
+                .map(|(controller, port, consumer)| Target {
+                    controller: Arc::downgrade(controller),
+                    port: Arc::downgrade(port),
+                    consumer: consumer.stamp(),
+                    programme: consumer.subscriptions.stamp(),
+                    ticket: port.ticket(TicketSide::Egress),
+                })
+                .collect(),
+            committed_at: Instant::now(),
+            armed_at: self.0.armed_at,
+            deadline: self.0.deadline,
+            cancellation: self.0.cancellation.clone(),
+        });
+        self.release(proof);
+    }
+
+    // All allocations and metadata extraction precede the first effect. The
+    // held-state snapshots below do not re-enter ordinary consumer/gate locks.
+    pub(super) fn prepare_release(
+        &self,
+        source_consumer: &Arc<audio_consumer::AudioConsumer>,
+        source_programme: &AudioPlan,
+        source_commit: &AudioCommit<'_>,
+        consumers: &ConsumerCutGuards<'_>,
+        targets: Vec<(
+            Arc<StreamController>,
+            Arc<Port>,
+            ConsumerStamp,
+            SubscriptionStamp,
+        )>,
+    ) -> ControlResult<Arc<Provenance>> {
+        let port = self.0.port.upgrade().ok_or(StreamControlError::NotReady)?;
+        Ok(Arc::new(Provenance {
+            controller: self.0.controller.clone(),
+            port: self.0.port.clone(),
+            credential: self.0.credential.clone(),
+            scene: self.0.scene.clone(),
+            #[cfg(feature="test-support")]
+            observation: self.0.observation.clone(),
+            consumer: consumers.snapshot(source_consumer)?,
+            programme: source_commit.snapshot(source_programme),
+            ticket: port.ticket(TicketSide::Ingress),
+            targets: targets
+                .into_iter()
+                .map(|(controller, port, consumer, programme)| Target {
+                    controller: Arc::downgrade(&controller),
+                    port: Arc::downgrade(&port),
+                    consumer,
+                    programme,
+                    ticket: port.ticket(TicketSide::Egress),
+                })
+                .collect(),
+            committed_at: Instant::now(),
+            armed_at: self.0.armed_at,
+            deadline: self.0.deadline,
+            cancellation: self.0.cancellation.clone(),
+        }))
+    }
+
+    pub(super) fn release(&self, proof: Arc<Provenance>) {
+        // A cut with no reserved producer adds no exceptional input later.
+        // Once released, the producer must earn ordinary current Publish/epoch.
+        if self.0.phase.load(Ordering::Acquire) == ARMED {
+            let _ =
+                self.0
+                    .phase
+                    .compare_exchange(ARMED, CLOSED, Ordering::AcqRel, Ordering::Acquire);
+        }
+        if self.0.phase.load(Ordering::Acquire) == HELD {
+            assert!(
+                self.0.released.set(proof).is_ok(),
+                "one original successor release"
+            );
+            #[cfg(feature="test-support")]
+            self.0.observation.releases.fetch_add(1, Ordering::AcqRel);
+            let _ =
+                self.0
+                    .phase
+                    .compare_exchange(HELD, RELEASED, Ordering::AcqRel, Ordering::Acquire);
+        }
+    }
+}
+impl Drop for Owner {
+    fn drop(&mut self) {
+        // Refusal/abandonment/panic before a genuine complete release cannot
+        // keep a producer waiting or lend stamps from partial publication.
+        let _ = self
+            .0
+            .phase
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |phase| {
+                (phase < RELEASED).then_some(CLOSED)
+            });
+    }
+}
+impl Claim {
+    pub(super) fn capture(
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        received_at: Instant,
+    ) -> ControlResult<Option<Self>> {
+        let Some(slot) = controller
+            .successor_ingress
+            .load_full()
+            .and_then(|r| r.0.upgrade())
+        else {
+            return Ok(None);
+        };
+        let phase = slot.phase.load(Ordering::Acquire);
+        if phase >= QUEUED {
+            return Ok(None);
+        }
+        if !Weak::ptr_eq(&slot.controller, &Arc::downgrade(controller))
+            || !Weak::ptr_eq(&slot.port, &Arc::downgrade(port))
+        {
+            return Ok(None);
+        }
+        if phase != ARMED {
+            return Err(StreamControlError::MetadataBusy);
+        }
+        if received_at < slot.armed_at
+            || slot.cancellation.is_cancelled()
+            || controller.shutdown.is_cancelled()
+            || tokio::time::Instant::now() >= slot.deadline
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        controller.check_credential_snapshot(&slot.credential)?;
+        slot.phase
+            .compare_exchange(ARMED, HELD, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| StreamControlError::MetadataBusy)?;
+        Ok(Some(Self(slot)))
+    }
+    pub(super) fn ready(&self, received_at: Instant) -> ControlResult<Arc<Provenance>> {
+        if self.0.cancellation.is_cancelled() || tokio::time::Instant::now() >= self.0.deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        match self.0.phase.load(Ordering::Acquire) {
+            HELD => return Err(StreamControlError::MetadataBusy),
+            RELEASED => {}
+            _ => return Err(StreamControlError::Cancelled),
+        }
+        let proof = self.0.released.get().ok_or(StreamControlError::Authority)?;
+        if received_at < proof.armed_at || received_at > proof.committed_at || !proof.current() {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(proof.clone())
+    }
+    pub(super) fn queued(&self) {
+        let _ =
+            self.0
+                .phase
+                .compare_exchange(RELEASED, QUEUED, Ordering::AcqRel, Ordering::Acquire);
+    }
+}
+impl Drop for Claim {
+    fn drop(&mut self) {
+        let _ = self
+            .0
+            .phase
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |phase| {
+                (phase == HELD || phase == RELEASED).then_some(CLOSED)
+            });
+    }
+}
+impl Provenance {
+    pub(super) fn update_source(
+        &mut self,
+        consumer: ConsumerStamp,
+        programme: SubscriptionStamp,
+        ticket: PeerRouteTicket,
+    ) {
+        self.consumer = consumer;
+        self.programme = programme;
+        self.ticket = ticket;
+        self.committed_at = Instant::now();
+    }
+    pub(super) fn update_target(
+        &mut self,
+        index: usize,
+        consumer: ConsumerStamp,
+        programme: SubscriptionStamp,
+        ticket: PeerRouteTicket,
+    ) {
+        self.targets[index].consumer = consumer;
+        self.targets[index].programme = programme;
+        self.targets[index].ticket = ticket;
+    }
+    pub(super) fn deadline(&self) -> tokio::time::Instant {
+        self.deadline
+    }
+    pub(super) fn current(&self) -> bool {
+        !self.cancellation.is_cancelled() && tokio::time::Instant::now() < self.deadline
+    }
+    pub(super) fn source_matches(&self, controller: &StreamController, port: &Arc<Port>) -> bool {
+        self.current()
+            && self.controller.as_ptr() == controller as *const StreamController
+            && Weak::ptr_eq(&self.port, &Arc::downgrade(port))
+    }
+    pub(super) fn source_consumer_matches(
+        &self,
+        port: &Arc<Port>,
+        consumer: &ConsumerStamp,
+    ) -> bool {
+        self.current()
+            && Weak::ptr_eq(&self.port, &Arc::downgrade(port))
+            && self.consumer.same_generation(consumer)
+            && consumer.is_current()
+    }
+    pub(super) fn target_matches(
+        &self,
+        controller: &Arc<StreamController>,
+        port: &Arc<Port>,
+        consumer: &ConsumerStamp,
+        programme: &SubscriptionStamp,
+        ticket: &PeerRouteTicket,
+        source: &Arc<Port>,
+    ) -> bool {
+        self.current()
+            && Weak::ptr_eq(&self.port, &Arc::downgrade(source))
+            && self.targets.iter().any(|target| {
+                Weak::ptr_eq(&target.controller, &Arc::downgrade(controller))
+                    && Weak::ptr_eq(&target.port, &Arc::downgrade(port))
+                    && target.consumer.same_generation(consumer)
+                    && target.programme.same_generation(programme)
+                    && target.ticket.same_generation(ticket)
+            })
+    }
+}
+impl StreamController {
+    pub(super) fn successor_original_pending(&self, port: &Arc<Port>) -> bool {
+        self.successor_ingress
+            .load_full()
+            .and_then(|r| r.0.upgrade())
+            .is_some_and(|slot| {
+                Weak::ptr_eq(&slot.port, &Arc::downgrade(port))
+                    && matches!(slot.phase.load(Ordering::Acquire), HELD | RELEASED)
+            })
+    }
+}
+
+// Closed metadata-only observation of an actual production reservation. No
+// test arm/release API, payload, strong Controller/Port or authority is exposed.
+#[cfg(feature="test-support")]
+#[derive(Clone,Debug)]
+pub struct SuccessorNativeCaptureForTest {
+    pub connection:String, pub stream_local_id:u16,
+    pub connection_generation:u64, pub stream_generation:u64,
+    pub sequence:u32, pub ssrc:u32, pub timestamp:u32,
+    pub payload_len:usize, pub payload_fingerprint:u64, pub original_owner_exact:bool,
+}
+#[cfg(feature="test-support")]
+#[derive(Clone,Debug)]
+pub struct SuccessorNativeOutputForTest {
+    pub target:String, pub stream_local_id:u16, pub timestamp:u32,
+    pub payload_len:usize, pub payload_fingerprint:u64, pub contribution_count:usize, pub selected_exact_target:bool,
+}
+#[cfg(feature="test-support")]
+#[derive(Default)]
+struct SuccessorObservationData {
+    captures:u64, wire:Option<SuccessorNativeCaptureForTest>,
+    outputs:Vec<SuccessorNativeOutputForTest>,
+}
+#[cfg(feature="test-support")]
+#[derive(Default)]
+struct SuccessorObservation {
+    data:Mutex<SuccessorObservationData>, missed:std::sync::atomic::AtomicU64,
+    releases:std::sync::atomic::AtomicU64, queued:std::sync::atomic::AtomicU64,
+    epoch_current:std::sync::atomic::AtomicBool, admitted_age_us:std::sync::atomic::AtomicU64,
+}
+#[cfg(feature="test-support")]
+pub struct SuccessorIngressObserverForTest {slot:Weak<Slot>,observation:Arc<SuccessorObservation>}
+#[cfg(feature="test-support")]
+#[derive(Clone,Debug)]
+pub struct SuccessorIngressSnapshotForTest {
+    pub phase:Option<&'static str>, pub captures:u64,
+    pub wire:Option<SuccessorNativeCaptureForTest>, pub releases:u64, pub queued:u64,
+    pub packet_epoch_current_at_admission:bool, pub original_admitted_age_us:u64,
+    pub outputs:Vec<SuccessorNativeOutputForTest>, pub missed:u64,
+}
+#[cfg(feature="test-support")]
+fn diagnostic_fingerprint(bytes:&[u8])->u64 {
+    bytes.iter().fold(0xcbf29ce484222325u64,|h,b|(h^u64::from(*b)).wrapping_mul(0x100000001b3))
+}
+#[cfg(feature="test-support")]
+impl SuccessorIngressObserverForTest {
