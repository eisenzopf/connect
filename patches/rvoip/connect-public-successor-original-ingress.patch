+            releases:self.observation.releases.load(Ordering::Acquire),queued:self.observation.queued.load(Ordering::Acquire),
+            packet_epoch_current_at_admission:self.observation.epoch_current.load(Ordering::Acquire),
+            original_admitted_age_us:self.observation.admitted_age_us.load(Ordering::Acquire),
