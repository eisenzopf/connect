+//! Primitive original/epoch boundary controls. These do not replace actual
+//! ManagedCut/Store/Service or strict Firefox continuity qualification.
+use super::*;
+use crate::staged_streams::{audio_consumer::AudioConsumer, successor_ingress::Owner};
+
+struct Epoch(AtomicBool);
+impl PacketEpoch for Epoch {
+    fn current(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}
+struct Lease {
+    inner: Box<dyn MediaAuthorityLease>,
+    epoch: Option<Arc<Epoch>>,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        self.inner.expires_at()
+    }
+    fn packet_epoch(&self) -> Option<Arc<dyn PacketEpoch>> {
+        self.epoch.clone().map(|e| e as Arc<dyn PacketEpoch>)
+    }
+}
+struct Admission {
+    inner: Arc<Policy>,
+    epoch: Arc<Epoch>,
+    busy: Arc<AtomicBool>,
+    no_epoch: Arc<AtomicBool>,
+    calls: Arc<AtomicUsize>,
+}
+impl MediaPolicy for Admission {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        Ok(Box::new(Lease {
+            inner: self.inner.current(scope)?,
+            epoch: (!self.no_epoch.load(Ordering::Acquire)).then(|| self.epoch.clone()),
+        }))
+    }
+    fn current_original_ingress(
+        &self,
+        scope: &MediaScope<'_>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        if self.busy.load(Ordering::Acquire) {
+            return Err(StreamControlError::MetadataBusy);
+        }
+        self.current(scope)
+    }
+}
+struct Ready {
+    f: Fixture,
+    source: Arc<AudioConsumer>,
+    target: Arc<AudioConsumer>,
+    epoch: Arc<Epoch>,
+    busy: Arc<AtomicBool>,
+    no_epoch: Arc<AtomicBool>,
+    calls: Arc<AtomicUsize>,
+}
+async fn ready() -> Ready {
+    let epoch = Arc::new(Epoch(AtomicBool::new(true)));
+    let busy = Arc::new(AtomicBool::new(false));
+    let no_epoch = Arc::new(AtomicBool::new(false));
+    let calls = Arc::new(AtomicUsize::new(0));
+    let capture = (epoch.clone(), busy.clone(), no_epoch.clone(), calls.clone());
+    let f = Fixture::with_policy(
+        8,
+        Some(Box::new(move |inner| {
+            Arc::new(Admission {
+                inner,
+                epoch: capture.0,
+                busy: capture.1,
+                no_epoch: capture.2,
+                calls: capture.3,
+            })
+        })),
+    );
+    f.start(&[Medium::Audio]).await;
+    let source = AudioConsumer::optional(Some(desired(Medium::Audio).logical_id), 8000);
+    let target = AudioConsumer::optional(Some(desired(Medium::Audio).logical_id), 8000);
+    source.activate(true);
+    target.activate(true);
+    *f.a.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&source));
+    *f.b.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&target));
+    Ready {
+        f,
+        source,
+        target,
+        epoch,
+        busy,
+        no_epoch,
+        calls,
+    }
+}
+
+#[tokio::test]
+async fn public_successor_original_waits_without_grant_then_queues_exact_age_once() {
+    let r = ready().await;
+    let port = r.f.aa.port(Medium::Audio);
+    let target_port = r.f.ba.port(Medium::Audio);
+    let cancel = CancellationToken::new();
+    let owner = Owner::arm_for_test(&r.f.a, &port.0, deadline(), &cancel).unwrap();
+    let at = Instant::now();
+    let frame = frame(&port, 160);
+    let mut input =
+        r.f.a
+            .take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut original = port
+        .retain_original_ingress(frame.clone(), at)
+        .unwrap()
+        .unwrap();
+    assert!(matches!(
+        original.try_publish_clocked(|_| panic!("clock before fresh admission")),
+        Err(StreamControlError::MetadataBusy)
+    ));
+    assert_eq!(r.calls.load(Ordering::Acquire), 0);
+    assert!(input.try_recv().is_err());
+    assert!(
+        matches!(
+            port.try_publish(&frame),
+            Err(StreamControlError::MetadataBusy)
+        ),
+        "later direct input cannot overtake"
+    );
+    assert!(matches!(
+        port.retain_original_ingress(frame.clone(), Instant::now()),
+        Err(StreamControlError::MetadataBusy)
+    ));
+    drop(
+        r.f.policy
+            .0
+            .try_write()
+            .expect("no positive authority across wait"),
+    );
+    // Real role-generation transitions reproduce the start-after-arrival seam.
+    r.source
+        .prepare_role(deadline(), cancel.clone())
+        .await
+        .unwrap()
+        .commit(true);
+    r.target
+        .prepare_role(deadline(), cancel.clone())
+        .await
+        .unwrap()
+        .commit(true);
+    owner.release_for_test(&r.source, &[(&r.f.b, &target_port.0, &r.target)]);
+    r.busy.store(true, Ordering::Release);
+    assert!(matches!(
+        original.try_publish_clocked(|_| panic!("clock on policy Busy")),
+        Err(StreamControlError::MetadataBusy)
+    ));
+    drop(
+        r.f.policy
+            .0
+            .try_write()
+            .expect("fresh refused turn released policy"),
+    );
+    r.busy.store(false, Ordering::Release);
+    let clocks = std::cell::Cell::new(0);
+    original
+        .try_publish_clocked(|current| {
+            assert!(current());
+            clocks.set(clocks.get() + 1);
+            None
+        })
+        .unwrap();
+    assert_eq!(clocks.get(), 1);
+    assert_eq!(r.calls.load(Ordering::Acquire), 2);
+    let packet = receive(&mut input).await;
+    assert_eq!(packet.admitted_at, at);
+    assert_eq!(packet.frame.timestamp_rtp, frame.timestamp_rtp);
+    assert_eq!(packet.frame.captured_at, frame.captured_at);
+    assert_eq!(packet.frame.payload, frame.payload);
+    let proof = packet
+        .custody
+        .0
+        .successor
+        .get()
+        .expect("exact one original handover provenance");
+    assert!(proof.target_matches(
+        &r.f.b,
+        &target_port.0,
+        &r.target.stamp(),
+        &r.target.subscriptions.stamp(),
+        &target_port.0.ticket(TicketSide::Egress),
+        &port.0
+    ));
+    assert!(!proof.target_matches(
+        &r.f.a,
+        &port.0,
+        &r.source.stamp(),
+        &r.source.subscriptions.stamp(),
+        &port.0.ticket(TicketSide::Egress),
+        &port.0
+    ));
+    // Provenance is not selection permission, even for its exact target.
+    assert!(
+        r.target
+            .subscriptions
+            .stamp()
+            .begin(&r.f.a, &desired(Medium::Audio).logical_id)
+            .is_err()
+    );
+    assert!(matches!(
+        original.try_publish_clocked(|_| None),
+        Err(StreamControlError::Cancelled)
+    ));
+    assert!(
+        input.try_recv().is_err(),
+        "one reserved original, no replay"
+    );
+    drop(
+        r.f.policy
+            .0
+            .try_write()
+            .expect("queue holds epoch metadata, not policy reader"),
+    );
+    r.epoch.0.store(false, Ordering::Release);
+    assert!(
+        !packet.custody.current(),
+        "actual queued epoch revocation remains terminal"
+    );
+}
+
+#[tokio::test]
+async fn public_successor_original_refuses_cancel_expiry_rebind_and_missing_epoch() {
+    for action in 0..7 {
+        let r = ready().await;
+        let port = r.f.aa.port(Medium::Audio);
+        let cancel = CancellationToken::new();
+        let owner = Owner::arm_for_test(&r.f.a, &port.0, deadline(), &cancel).unwrap();
+        let mut input =
+            r.f.a
+                .take_ingress(&desired(Medium::Audio).logical_id)
+                .unwrap();
+        let mut original = port
+            .retain_original_ingress(frame(&port, 160), Instant::now())
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::MetadataBusy)
+        ));
+        owner.release_for_test(&r.source, &[]);
+        match action {
+            0 => cancel.cancel(),
+            1 => {
+                r.f.policy
+                    .0
+                    .try_write()
+                    .unwrap()
+                    .revoked
+                    .insert("alice".into());
+            }
+            2 => r.f.a.credential.lock().unwrap().revision += 1,
+            3 => r.epoch.0.store(false, Ordering::Release),
+            4 => r.no_epoch.store(true, Ordering::Release),
+            5 => r
+                .source
+                .prepare_role(deadline(), cancel.clone())
+                .await
+                .unwrap()
+                .commit(true),
+            _ => tokio::time::sleep(Duration::from_millis(205)).await,
+        }
+        assert!(
+            original
+                .try_publish_clocked(|_| panic!("terminal input reached clock/queue"))
+                .is_err(),
+            "action={action}"
+        );
+        assert!(input.try_recv().is_err(), "action={action}");
+        drop(
+            r.f.policy
+                .0
+                .try_write()
+                .expect("refusal retained authority"),
+        );
+    }
+}
+
+#[tokio::test]
+async fn public_successor_reservation_cannot_relabel_ordinary_or_survive_abandonment() {
+    let r = ready().await;
+    let port = r.f.aa.port(Medium::Audio);
+    let mut input =
+        r.f.a
+            .take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut ordinary = port
+        .retain_original_ingress(frame(&port, 160), Instant::now())
+        .unwrap()
+        .unwrap();
+    let cancel = CancellationToken::new();
+    let owner = Owner::arm_for_test(&r.f.a, &port.0, deadline(), &cancel).unwrap();
+    let mut reserved = port
+        .retain_original_ingress(frame(&port, 320), Instant::now())
+        .unwrap()
+        .unwrap();
+    drop(owner);
+    assert!(matches!(
+        reserved.try_publish_clocked(|_| None),
+        Err(StreamControlError::Cancelled)
+    ));
+    r.source
+        .prepare_role(deadline(), cancel)
+        .await
+        .unwrap()
+        .commit(true);
+    assert!(
+        ordinary.try_publish_clocked(|_| None).is_err(),
+        "normal original age/generation rule stays strict"
+    );
+    assert!(input.try_recv().is_err());
+}
