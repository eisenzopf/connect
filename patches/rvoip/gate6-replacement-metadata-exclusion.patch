+use super::*;
+use crate::orchestrator::participant_control::{
+    DeviceReplacementEndpointEvent, ParticipantControlError,
+    replacement::metadata_test_support::ObservationState,
+};
+use crate::participant_transitions::EndpointConfirmationObservation;
+fn request(f: &Move) -> AudioDeviceReplacementRequest {
+    AudioDeviceReplacementRequest {
+        operation_id: f.pending.intent().operation_id.clone(),
+        expected_revision: f.room.scene.audience_revision(),
+        source: f.pending.intent().source.clone(),
+        admitted: f.pending.intent().replacement.clone(),
+        retained: f.pending.intent().retained.clone(),
+        video: None,
+    }
+}
+async fn ready() -> Move {
+    let mut f = Move::new(false).await;
+    f.io().await;
+    f.confirm().await;
+    f
+}
+async fn partial_ready() -> Move {
+    let mut f = Move::with_media_and_confirmation(
+        false,
+        "alice",
+        false,
+        vec![desired(Medium::Audio)],
+        EndpointConfirmationPolicy::AnsweredDtmf {
+            digits: "77".into(),
+        },
+    )
+    .await;
+    f.io().await;
+    let owner = f.room.domain.base.0.read().await.owners["device"].clone();
+    let generation = f.pending.generation();
+    f.pending
+        .observe_media_ready(&owner.member, &owner.endpoint, generation)
+        .unwrap();
+    f.pending
+        .observe_answer(owner.connection.connection(), generation)
+        .unwrap();
+    assert!(!f.pending.confirmation_ready());
+    f
+}
+fn busy<T>(result: ControlResult<T>) {
+    assert!(
+        matches!(result, Err(StreamControlError::MetadataBusy)),
+        "actual held metadata must be the distinct temporary result"
+    );
+}
+fn event_busy<T>(result: Result<T, ParticipantControlError>) {
+    assert!(
+        matches!(
+            result,
+            Err(ParticipantControlError::Media(
+                StreamControlError::MetadataBusy
+            ))
+        ),
+        "metadata deferral must reach the event caller without consuming the event"
+    );
+}
+#[tokio::test]
+async fn replacement_metadata_audio_old_and_new_lock_collisions_preserve_plan_and_old_pcm() {
+    let mut f = ready().await;
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let revision = f.room.scene.audience_revision();
+    let before = f.pending.binding().clone();
+    for who in ["alice", "device"] {
+        let c = f.room.nodes[who].controller.clone();
+        let held = c.state.lock().unwrap();
+        busy(f.room.scene.plan_audio_device_replacement(
+            &f.context,
+            &f.pending,
+            Some(stamp.clone()),
+            request(&f),
+        ));
+        drop(held);
+        assert!(
+            f.room
+                .scene
+                .plan_audio_device_replacement(
+                    &f.context,
+                    &f.pending,
+                    Some(stamp.clone()),
+                    request(&f)
+                )
+                .is_ok()
+        );
+        assert_eq!(f.room.scene.audience_revision(), revision);
+        assert!(f.pending.binding().same_incarnation(&before));
+        assert!(!f.room.nodes["alice"].controller.shutdown.is_cancelled());
+        f.room.publish("alice", 800).unwrap();
+        f.room.tick();
+        f.room.heard("bob", 800).await;
+        f.room.heard("public", 800).await;
+        f.room.silent(&["device"]);
+    }
+}
+#[tokio::test]
+async fn replacement_metadata_video_old_and_new_lock_collisions_preserve_intent() {
+    let mut f = Move::with_media(
+        false,
+        "alice",
+        false,
+        vec![desired(Medium::Audio), desired(Medium::Video)],
+    )
+    .await;
+    let old = f.room.nodes["alice"].controller.clone();
+    old.change(
+        old.revision(),
+        &[desired(Medium::Audio), desired(Medium::Video)],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+    )
+    .await
+    .unwrap();
+    f.io().await;
+    f.confirm().await;
+    let new = f.room.nodes["device"].controller.clone();
+    let video = ReplacementVideoRequest {
+        publications: vec![ReplacementVideoStream {
+            previous: desired(Medium::Video).logical_id,
+            replacement: desired(Medium::Video).logical_id,
+        }],
+        receivers: vec![],
+    };
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let revision = f.room.scene.audience_revision();
+    for c in [&old, &new] {
+        let held = c.state.lock().unwrap();
+        let mut intent = request(&f);
+        intent.video = Some(video.clone());
+        busy(f.room.scene.plan_audio_device_replacement(
+            &f.context,
+            &f.pending,
+            Some(stamp.clone()),
+            intent,
+        ));
+        drop(held);
+        assert!(f.plan_with_video(Some(video.clone())).is_ok());
+        assert_eq!(f.room.scene.audience_revision(), revision);
+        assert!(!old.shutdown.is_cancelled());
+        assert!(
+            new.state.lock().unwrap().model.streams()[&desired(Medium::Video).logical_id]
+                .source_muted
+        );
+    }
+}
+#[tokio::test]
+async fn replacement_metadata_capture_preserves_original_sequence_on_each_scene_lock() {
+    let f = ready().await;
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let mut state = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+    let before = state.snapshot();
+    let controller = f.room.nodes["device"].controller.clone();
+    let held = controller.state.lock().unwrap();
+    event_busy(state.capture(&f.room.scene));
+    assert_eq!(state.snapshot(), before);
+    drop(held);
+    let held = f.room.scene.members.lock().unwrap();
+    event_busy(state.capture(&f.room.scene));
+    assert_eq!(state.snapshot(), before);
+    drop(held);
+    let held = f.room.scene.audiences.lock().unwrap();
+    event_busy(state.capture(&f.room.scene));
+    assert_eq!(state.snapshot(), before);
+    drop(held);
+    let (stamp, answered, sequence) = state.capture(&f.room.scene).unwrap();
+    assert!(stamp.is_some() && answered);
+    assert_eq!(sequence, before.3 + 1);
+}
+#[tokio::test]
+async fn replacement_metadata_readiness_deferral_preserves_full_and_partial_confirmation() {
+    let f = ready().await;
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let mut full = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+    let before = full.snapshot();
+    assert!(before.0 && before.1 && before.2.is_none());
+    let controller = f.room.nodes["device"].controller.clone();
+    let held = controller.state.lock().unwrap();
+    busy(stamp.check());
+    event_busy(full.refresh());
+    assert_eq!(full.snapshot(), before);
+    drop(held);
+    full.refresh().unwrap();
+    assert_eq!(full.snapshot(), before);
+
+    let f = partial_ready().await;
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let mut partial = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+    partial.partial(stamp.clone());
+    let (_, _, sequence) = partial.capture(&f.room.scene).unwrap();
+    let before = partial.snapshot();
+    assert!(!before.0 && !before.1 && before.2.as_deref() == Some("7"));
+    let controller = f.room.nodes["device"].controller.clone();
+    let held = controller.state.lock().unwrap();
+    // Answer capture is already complete: only the actual stored prefix's
+    // readiness check is blocked here, not the media-at-capture predicate.
+    event_busy(partial.observe(
+        &f.room.scene,
+        &DeviceReplacementEndpointEvent::Answered,
+        None,
+        sequence,
+    ));
+    assert_eq!(partial.snapshot(), before);
+    drop(held);
+    assert!(
+        partial
+            .observe(
+                &f.room.scene,
+                &DeviceReplacementEndpointEvent::Answered,
+                None,
+                sequence
+            )
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(partial.snapshot().2.as_deref(), Some("7"));
+    assert_eq!(partial.snapshot().4, sequence);
+    assert_eq!(
+        partial
+            .observe(
+                &f.room.scene,
+                &DeviceReplacementEndpointEvent::Answered,
+                None,
+                sequence
+            )
+            .unwrap(),
+        Some(EndpointConfirmationObservation::AlreadyObserved)
+    );
+}
+#[tokio::test]
+async fn replacement_metadata_observation_does_not_consume_event_at_capture_or_final_scene_check() {
+    for which in ["capture", "members", "audiences"] {
+        let f = partial_ready().await;
+        let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+        let mut state = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+        state.partial(stamp.clone());
+        let (captured, _, sequence) = state.capture(&f.room.scene).unwrap();
+        let captured = captured.unwrap();
+        let before = state.snapshot();
+        let event = DeviceReplacementEndpointEvent::Dtmf { digits: "7".into() };
+        let c = f.room.nodes["device"].controller.clone();
+        if which == "capture" {
+            let held = c.state.lock().unwrap();
+            event_busy(state.observe(&f.room.scene, &event, Some(&captured), sequence));
+            drop(held);
+        } else if which == "members" {
+            let held = f.room.scene.members.lock().unwrap();
+            event_busy(state.observe(&f.room.scene, &event, Some(&captured), sequence));
+            drop(held);
+        } else {
+            let held = f.room.scene.audiences.lock().unwrap();
+            event_busy(state.observe(&f.room.scene, &event, Some(&captured), sequence));
+            drop(held);
+        }
+        assert_eq!(
+            state.snapshot(),
+            before,
+            "{which}: original event state changed while busy"
+        );
+        assert!(
+            state
+                .observe(&f.room.scene, &event, Some(&captured), sequence)
+                .unwrap()
+                .is_none()
+        );
+        assert_eq!(state.snapshot().2.as_deref(), Some("7"));
+        assert_eq!(state.snapshot().4, sequence);
+        assert_eq!(
+            state
+                .observe(&f.room.scene, &event, Some(&captured), sequence)
+                .unwrap(),
+            Some(EndpointConfirmationObservation::AlreadyObserved)
+        );
+    }
+}
