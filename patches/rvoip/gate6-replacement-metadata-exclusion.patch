+#[tokio::test]
+async fn replacement_metadata_original_pre_media_and_sequence_gap_refusals_remain() {
+    let f = partial_ready().await;
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let mut state = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+    state.partial(stamp.clone());
+    let dtmf = DeviceReplacementEndpointEvent::Dtmf { digits: "7".into() };
+    let (_, _, sequence) = state.capture(&f.room.scene).unwrap();
+    // An original event carrying no captured media cannot acquire readiness
+    // retroactively merely because the current fixture now has actual IO.
+    assert_eq!(
+        state.observe(&f.room.scene, &dtmf, None, sequence).unwrap(),
+        Some(EndpointConfirmationObservation::BeforeAnswerOrMedia)
+    );
+    assert_eq!(state.snapshot().4, 2);
+    assert!(state.snapshot().2.is_none());
+
+    let mut state = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+    state.partial(stamp.clone());
+    let (_, _, lost) = state.capture(&f.room.scene).unwrap();
+    let (_, _, later) = state.capture(&f.room.scene).unwrap();
+    assert_eq!(later, lost + 1);
+    assert!(
+        state
+            .observe(
+                &f.room.scene,
+                &DeviceReplacementEndpointEvent::Answered,
+                None,
+                later
+            )
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(state.snapshot().4, later);
+    assert!(
+        state.snapshot().2.is_none(),
+        "a lost original event must break the digit prefix"
+    );
+    assert_eq!(
+        state
+            .observe(&f.room.scene, &dtmf, Some(&stamp), lost)
+            .unwrap(),
+        Some(EndpointConfirmationObservation::AlreadyObserved)
+    );
+}
