+impl PendingReplacementState {
+    /// Metadata reads precede consuming the immutable event sequence. A busy
+    /// scene can be retried with the same event without losing a digit or
+    /// invalidating an otherwise current confirmation.
+    fn capture_observation(
+        &mut self,
+        has_controller: bool,
+        scene: Option<&crate::staged_streams::media_scene::GuardedMediaScene>,
+    ) -> ControlResult<(Option<ReplacementReadinessStamp>, bool, u64)> {
+        let media = match (has_controller, scene, self.context.as_ref()) {
+            (true, Some(scene), Some(context)) => {
+                match scene.replacement_endpoint_stamp(context) {
+                    Ok(stamp) => Some(stamp),
+                    Err(error @ StreamControlError::MetadataBusy) => return Err(error.into()),
+                    // Actual absent duplex media keeps its pre-media outcome.
+                    // A changed scene, poisoned lock or failed authority is a
+                    // refusal, never an invitation to recapture indefinitely.
+                    Err(StreamControlError::NotReady) => None,
+                    Err(error) => return Err(error.into()),
+                }
+            }
+            _ => None,
+        };
+        let sequence = self
+            .captured_signal
+            .checked_add(1)
+            .ok_or(ParticipantControlError::Authority)?;
+        self.captured_signal = sequence;
+        Ok((media, self.ticket.has_answered(), sequence))
+    }
+
+    fn prepare_observation(
+        &mut self,
+        event: &DeviceReplacementEndpointEvent,
+        has_controller: bool,
+        media_at_capture: Option<&ReplacementReadinessStamp>,
+        answered_at_capture: bool,
+        sequence: u64,
+        scene: &crate::staged_streams::media_scene::GuardedMediaScene,
+    ) -> ControlResult<Option<EndpointConfirmationObservation>> {
+        let needs_media = matches!(
+            event,
+            DeviceReplacementEndpointEvent::MediaObserved
+                | DeviceReplacementEndpointEvent::Dtmf { .. }
+        );
+        if needs_media {
+            let captured_current = match media_at_capture.map(ReplacementReadinessStamp::check) {
+                Some(Ok(())) => true,
+                Some(Err(error @ StreamControlError::MetadataBusy)) => return Err(error.into()),
+                _ => false,
+            };
+            if !has_controller
+                || !captured_current
+                || matches!(event, DeviceReplacementEndpointEvent::Dtmf { .. })
+                    && !answered_at_capture
+            {
+                self.confirmation = None;
+                return Ok(Some(EndpointConfirmationObservation::BeforeAnswerOrMedia));
+            }
+        }
+        if sequence <= self.observed_signal {
+            return Ok(Some(EndpointConfirmationObservation::AlreadyObserved));
+        }
+        let contiguous = self.observed_signal.checked_add(1) == Some(sequence);
+        let partial_current = if contiguous {
+            match self
+                .confirmation
+                .as_ref()
+                .map(|partial| partial.readiness.check())
+            {
+                Some(Ok(())) | None => true,
+                Some(Err(error @ StreamControlError::MetadataBusy)) => return Err(error.into()),
+                Some(Err(_)) => false,
+            }
+        } else {
+            false
+        };
+        let media_ready = if needs_media {
+            match self.context.as_ref() {
+                Some(context) => match scene.replacement_endpoint_ready(context) {
+                    Ok(()) => true,
+                    Err(StreamControlError::NotReady) => false,
+                    Err(error) => return Err(error.into()),
+                },
+                None => false,
+            }
+        } else {
+            true
+        };
+        // No further retryable metadata read follows this point. In particular
+        // final scene-read contention cannot consume the original sequence or
+        // erase a consecutive partial confirmation.
+        if !contiguous || !partial_current {
+            self.confirmation = None;
+        }
+        self.observed_signal = sequence;
+        if !media_ready {
+            self.confirmation = None;
+            return Ok(Some(EndpointConfirmationObservation::BeforeAnswerOrMedia));
+        }
+        Ok(None)
     }
