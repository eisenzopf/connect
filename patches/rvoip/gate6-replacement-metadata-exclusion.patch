+//! Test access to the actual production event state machine. The fixture supplies
+//! real scene/controller/PCM readiness; this bridge supplies no authority or IO.
+use super::*;
+use crate::staged_streams::media_scene::GuardedMediaScene;
+pub(crate) struct ObservationState(PendingReplacementState);
+impl ObservationState {
+    pub(crate) fn new(
+        ticket: PreparedParticipantReplacement,
+        context: AudioAudienceHandle,
+        readiness: ReplacementReadinessStamp,
+    ) -> Self {
+        // A complete "7" confirmation has an answer and one digit. An actual
+        // "77" partial fixture supplies an answered, ready, unconfirmed ticket.
+        let complete = ticket.confirmation_ready();
+        assert!(ticket.has_answered());
+        Self(PendingReplacementState {
+            ticket,
+            context: Some(context),
+            slot: None,
+            cleanup_started: false,
+            captured_signal: if complete { 2 } else { 1 },
+            observed_signal: if complete { 2 } else { 1 },
+            confirmation: None,
+            confirmed_at: complete.then_some(readiness),
+        })
+    }
+    pub(crate) fn partial(&mut self, stamp: ReplacementReadinessStamp) {
+        assert!(!self.0.ticket.confirmation_ready());
+        assert!(self.0.confirmed_at.is_none());
+        let crate::participant_transitions::EndpointConfirmationPolicy::AnsweredDtmf { digits } =
+            &self.0.ticket.intent().confirmation
+        else {
+            panic!("DTMF fixture required")
+        };
+        assert_eq!(digits, "77");
+        // Snapshot after one attributed '7', a proper prefix of the actual
+        // configured '77'. This state is mutually exclusive with completion.
+        self.0.captured_signal = 2;
+        self.0.observed_signal = 2;
+        self.0.confirmation = Some(PartialConfirmation {
+            digits: "7".into(),
+            readiness: stamp,
+        });
+    }
+    pub(crate) fn refresh(&mut self) -> ControlResult<()> {
+        self.0.refresh_confirmation()
+    }
+    pub(crate) fn capture(
+        &mut self,
+        scene: &GuardedMediaScene,
+    ) -> ControlResult<(Option<ReplacementReadinessStamp>, bool, u64)> {
+        self.0.capture_observation(true, Some(scene))
+    }
+    pub(crate) fn observe(
+        &mut self,
+        scene: &GuardedMediaScene,
+        event: &DeviceReplacementEndpointEvent,
+        stamp: Option<&ReplacementReadinessStamp>,
+        sequence: u64,
+    ) -> ControlResult<Option<EndpointConfirmationObservation>> {
+        self.0
+            .prepare_observation(event, true, stamp, true, sequence, scene)
+    }
+    pub(crate) fn snapshot(&self) -> (bool, bool, Option<String>, u64, u64) {
+        (
+            self.0.ticket.confirmation_ready(),
+            self.0.confirmed_at.is_some(),
+            self.0.confirmation.as_ref().map(|p| p.digits.clone()),
+            self.0.captured_signal,
+            self.0.observed_signal,
+        )
+    }
+}
