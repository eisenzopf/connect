+#[tokio::test]
+async fn replacement_metadata_poisoned_state_is_refused_without_retry_or_old_retirement() {
+    let f = ready().await;
+    let stamp = f.room.scene.replacement_endpoint_stamp(&f.context).unwrap();
+    let controller = f.room.nodes["device"].controller.clone();
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let _held = controller.state.lock().unwrap();
+        panic!("intentional fixture metadata owner panic");
+    }));
+    assert!(result.is_err() && controller.state.is_poisoned());
+    assert!(matches!(
+        stamp.check(),
+        Err(StreamControlError::Model(MediaTransitionError::Conflict))
+    ));
+    assert!(matches!(
+        f.room.scene.plan_audio_device_replacement(
+            &f.context,
+            &f.pending,
+            Some(stamp.clone()),
+            request(&f)
+        ),
+        Err(StreamControlError::Model(MediaTransitionError::Conflict))
+    ));
+    let mut state = ObservationState::new(f.pending.clone(), f.context.clone(), stamp.clone());
+    let before = state.snapshot();
+    assert!(matches!(
+        state.capture(&f.room.scene),
+        Err(ParticipantControlError::Media(StreamControlError::Model(
+            MediaTransitionError::Conflict
+        )))
+    ));
+    assert_eq!(state.snapshot(), before);
+    assert!(!f.room.nodes["alice"].controller.shutdown.is_cancelled());
+}
