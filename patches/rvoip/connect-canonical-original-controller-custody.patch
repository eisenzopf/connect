+++ b/crates/foundation/rvoip-core/src/staged_streams/adapter_owner.rs
@@ -0,0 +1,20 @@
+//! Cold adapter identity only, never a permission, generation or IO grant.
+//! Reuses the SAME existing once-per-controller subscription identity root.
+use super::*;
+#[derive(Clone)]
+pub struct AdapterMediaOwner(Weak<()>);
+impl AdapterMediaOwner {
+    pub fn same_original(&self,other:&Self)->bool {
+        self.0.strong_count()!=0 && other.0.strong_count()!=0 && Weak::ptr_eq(&self.0,&other.0)
+    }
+}
+impl StreamController {
+    pub fn adapter_media_owner(&self)->AdapterMediaOwner {
+        AdapterMediaOwner(Arc::downgrade(&self.subscription_commit_identity))
+    }
+}
+impl AdapterMediaPort {
+    pub fn matches_adapter_media_owner(&self,original:&AdapterMediaOwner)->bool {
+        self.0.owner.upgrade().is_some_and(|owner|owner.adapter_media_owner().same_original(original))
+    }
+}
