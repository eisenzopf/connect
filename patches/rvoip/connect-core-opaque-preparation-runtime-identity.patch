+//! Actual retained runtime identity, no fabricated identity/nonce/realm.
+use super::*;
+
+#[tokio::test]
+async fn opaque_preparation_identity_preserves_actual_runtime_scope_cancel_and_weak_retirement() {
+    let mut room=ManagedRoom::with_video(true).await;
+    let mut foreign=ManagedRoom::with_video(true).await;
+    let result=catch_original(async {
+        let(alice,old,source)=actors(&mut room).await;
+        let ready=prepared(&mut room,&alice,&old,&source).await;
+        let(other_alice,other_old,other_source)=actors(&mut foreign).await;
+        let other=prepared(&mut foreign,&other_alice,&other_old,&other_source).await;
+        let identity=ready.root.preparation_identity();let cloned=identity.clone();
+        let repeated=ready.root.preparation_identity();let different=other.root.preparation_identity();
+        let realm=room.nodes[&old].video_realm.as_ref().and_then(SourceFrameRealm::incarnation).unwrap();
+        assert!(identity.same(&cloned)&&identity.same(&repeated));
+        assert!(!identity.same(&different));
+        assert!(identity.matches_scope(&room.conversation,&room.session,realm));
+        assert!(!identity.matches_scope(&foreign.conversation,&room.session,realm));
+        assert!(!identity.matches_scope(&room.conversation,&foreign.session,realm));
+        assert!(!identity.matches_scope(&room.conversation,&room.session,realm^1));
+        assert!(ready.reservation.is_current());
+        assert!(ready.root.cancel());
+        assert!(!ready.reservation.is_current(),"metadata identity cannot renew cancelled admission");
+        assert!(identity.same(&cloned)&&identity.matches_scope(&room.conversation,&room.session,realm),
+            "structural runtime identity is deliberately separate from current preparation authority");
+        let root=Arc::downgrade(&ready.root);
+        // No actual preparation or runtime is returned from this scope.
+        (identity,cloned,root,room.conversation.clone(),room.session.clone(),realm)
+    }).await;
+    let clean=room.close_originals().await.into_iter().all(|done|done);
+    let other_clean=foreign.close_originals().await.into_iter().all(|done|done);
+    drop(room);drop(foreign);
+    assert!(clean&&other_clean,"both original managed owners joined before final weak-lifetime oracle");
+    let(identity,cloned,root,conversation,session,realm)=match result {Ok(value)=>value,Err(error)=>resume_unwind(error)};
+    assert!(root.upgrade().is_none(),"identity cannot keep actual original preparation alive");
+    assert!(!identity.same(&cloned),"last retained runtime cannot be revived by erased Weak clones");
+    assert!(!identity.matches_scope(&conversation,&session,realm));
+}
