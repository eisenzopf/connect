+//! Cold original-plan metadata, never permission, Warm, IO or a new deadline.
+use super::*;
+struct MemberPin {
+    controller:Arc<StreamController>,state:State,credential:CredentialSnapshot,
+    scene_cancel:CancellationToken,audio_cancel:CancellationToken,
+    ports:Vec<(Arc<Port>,Arc<directional_ticket::PortTickets>)>,
+}
+pub(crate) struct FreezeStructuralPin<'a> {
+    scene:&'a media_scene::GuardedMediaScene,epoch:u64,
+    intent:Arc<device_replacement::ReplacementIntent>,members:Vec<MemberPin>,old:usize,
+    // Strong original controller Arcs accompany these exact owned permits.
+    // No map/model/Port/role guard or authority lease crosses the drain await.
+    _other_flights:Vec<OwnedSemaphorePermit>,
+}
+impl FreezeStructuralPin<'_> {
+    pub(crate) fn validate(&self)->ControlResult<()> {
+        if !self.scene.structural_epoch.unchanged(self.epoch) {return Err(MediaTransitionError::Conflict.into());}
+        for member in &self.members {
+            if member.controller.shutdown.is_cancelled() || member.scene_cancel.is_cancelled() || member.audio_cancel.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            member.controller.check_credential_snapshot(&member.credential)?;
+            for (port,tickets) in &member.ports {
+                if port.terminal_requested() || !Arc::ptr_eq(tickets,&port.ticket_snapshot()) || !tickets.is_current() {
+                    return Err(StreamControlError::NotReady);
+                }
+            }
+        }
+        let target=self.members.iter().find(|member|member.controller.connection==self.intent.request.admitted).ok_or(StreamControlError::Authority)?;
+        self.intent.freeze_pin_current(&target.controller,&target.state)?;
+        if !self.scene.structural_epoch.unchanged(self.epoch) {return Err(MediaTransitionError::Conflict.into());}
+        Ok(())
+    }
+    pub(crate) fn old(&self)->&Arc<StreamController> {&self.members[self.old].controller}
+    pub(crate) fn old_state(&self)->&State {&self.members[self.old].state}
+    pub(crate) fn state_for(&self,controller:&Arc<StreamController>)->ControlResult<&State> {
+        self.members.iter().find(|member|Arc::ptr_eq(&member.controller,controller)).map(|member|&member.state).ok_or(StreamControlError::Authority)
+    }
+    pub(crate) fn same_plan(&self,plan:&device_replacement::AudioDeviceReplacementPlan)->bool {
+        plan.audience().scene==self.scene.id && plan.audience().replacement.as_ref().is_some_and(|intent|Arc::ptr_eq(intent,&self.intent))
+    }
+    pub(crate) fn validate_old_port(&self,port:&Arc<Port>,ticket:&PeerRouteTicket)->ControlResult<()> {
+        // validate_port checked ready/status before the attempt. Structural
+        // writers are excluded; terminal reports invalidate before waiting.
+        if !self.members[self.old].state.active.values().any(|original|Arc::ptr_eq(original,port))
+            || port.terminal_requested() || !ticket.is_current()
+            || !port.ticket(TicketSide::Egress).same_generation(ticket) {return Err(StreamControlError::NotReady);}
+        self.validate()
+    }
+    pub(crate) fn validate_frozen(&self,owner:&Arc<FrozenOldVideo>)->ControlResult<()> {
+        // Only this actual pinned scene call constructs/publishes this owner.
+        // A prior Frozen cannot coexist with capture's SAME OLD permit; p.flight
+        // excludes restore/another freeze, and other permits exclude audience
+        // mark_committed. No tuple-only lookup or new slot-lock refusal here.
+        self.validate()?;
+        if owner.intent.upgrade().is_none_or(|intent|!Arc::ptr_eq(&intent,&self.intent))
+            || owner.old.upgrade().is_none_or(|old|!Arc::ptr_eq(&old,self.old()))
+            || owner.frontier.operation_id()!=self.intent.request.operation_id
+            || owner.frontier.source_connection()!=&self.intent.request.source
+            || owner.frontier.target_connection()!=&self.intent.request.admitted {return Err(StreamControlError::Authority);}
+        Ok(())
+    }
+}
+impl media_scene::GuardedMediaScene {
+    pub(crate) fn capture_freeze_structure(&self,plan:&device_replacement::AudioDeviceReplacementPlan)
+        ->ControlResult<(FreezeStructuralPin<'_>,OwnedSemaphorePermit)> {
+        let plan=plan.audience();
+        let intent=plan.replacement.as_ref().ok_or(StreamControlError::Authority)?.clone();
+        if intent.private_consultation_parent().is_some() || !plan.group.origins.is_empty() || intent.video.is_none() {
+            return Err(StreamControlError::Unsupported);
+        }
+        let members=super::super::control_metadata::try_lock(&self.members)?;
+        let registry=super::super::control_metadata::try_lock(&self.audiences)?;
+        let epoch=self.structural_epoch.capture()?;
+        if plan.scene!=self.id || registry.revision!=plan.request.expected_revision
+            || members.len()!=plan.controllers.len() || !members.iter().all(|(id,member)|id==&member.controller.connection && plan.controllers.get(id)
+                .is_some_and(|original|Weak::ptr_eq(original,&Arc::downgrade(&member.controller)))) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let mut controllers=members.values().map(|member|member.controller.clone()).collect::<Vec<_>>();
+        controllers.sort_by_key(|controller|Arc::as_ptr(controller) as usize);
+        controllers.dedup_by(|a,b|Arc::ptr_eq(a,b));
+        // Each exact allocation is acquired once before any OLD pause/effect.
+        let mut flights=controllers.iter().map(|controller|controller.inflight.clone().try_acquire_owned()
+            .map(Some).map_err(|_|StreamControlError::MetadataBusy)).collect::<ControlResult<Vec<_>>>()?;
+        let states=controllers.iter().map(|controller|super::super::control_metadata::try_lock(&controller.state)).collect::<ControlResult<Vec<_>>>()?;
+        let mut captured=Vec::with_capacity(controllers.len());
+        for (controller,state) in controllers.iter().zip(&states) {
+            let member=members.get(&controller.connection).ok_or(StreamControlError::Authority)?;
+            if !Arc::ptr_eq(&member.controller,controller) || state.closed || state.model.revision()!=plan.expected[&controller.connection] {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            // Full original predicates under actual guards. Later validation
+            // uses exclusion plus early invalidation, never notification hints.
+            intent.validate_target_without_video_freeze(controller,state)?;
+            captured.push(MemberPin {controller:controller.clone(),state:state.control_metadata_snapshot(),
+                credential:controller.credential_snapshot(),scene_cancel:member.consumer.cancel.clone(),
+                audio_cancel:member.audio_consumer.stamp().cancellation,
+                ports:state.active.values().map(|port|(port.clone(),port.ticket_snapshot())).collect()});
+        }
+        let old=controllers.iter().position(|controller|controller.connection==intent.request.source).ok_or(StreamControlError::NotReady)?;
+        if !self.structural_epoch.unchanged(epoch) {return Err(MediaTransitionError::Conflict.into());}
+        // Every snapshot is coherent before releasing any original guard.
+        drop(states);drop(registry);drop(members);
+        let old_flight=flights[old].take().ok_or(StreamControlError::Authority)?;
+        let pin=FreezeStructuralPin {scene:self,epoch,intent,members:captured,old,
+            _other_flights:flights.into_iter().flatten().collect()};
+        pin.validate()?;
+        Ok((pin,old_flight))
+    }
+}
