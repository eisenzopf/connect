+//! Actual scene insertion and terminal callback owners. No native close,
+//! Host signed phase, decoded browser AV or readiness qualification is modeled.
+use super::*;
+use std::sync::mpsc;
+
+struct StateOwner {
+    release: Option<mpsc::SyncSender<()>>,
+    join: Option<std::thread::JoinHandle<()>>,
+}
+impl StateOwner {
+    fn hold(controller: Arc<StreamController>) -> Self {
+        let (release, wait) = mpsc::sync_channel(1);
+        let (ready, entered) = mpsc::sync_channel(1);
+        let join = std::thread::spawn(move || {
+            let state = controller.state.lock().unwrap();
+            let _ = ready.send(());
+            let _ = wait.recv();
+            drop(state);
+        });
+        let mut owner = Self { release: Some(release), join: Some(join) };
+        if entered.recv_timeout(Duration::from_secs(1)).is_err() {
+            owner.release();
+            panic!("actual original State owner did not enter");
+        }
+        owner
+    }
+    fn release(&mut self) {
+        if let Some(release) = self.release.take() { let _ = release.send(()); }
+        if let Some(join) = self.join.take() { join.join().unwrap(); }
+    }
+}
+impl Drop for StateOwner { fn drop(&mut self) { self.release(); } }
+struct TerminalOwner {
+    state: StateOwner,
+    report: Option<std::thread::JoinHandle<ControlResult<bool>>>,
+}
+impl TerminalOwner {
+    fn start(controller: Arc<StreamController>, port: AdapterMediaPort) -> Self {
+        let state = StateOwner::hold(controller);
+        let report = Some(std::thread::spawn(move || port.report_terminal()));
+        Self { state, report }
+    }
+    fn finish(&mut self) -> ControlResult<bool> {
+        self.state.release();
+        self.report.take().unwrap().join().unwrap()
+    }
+}
+impl Drop for TerminalOwner {
+    fn drop(&mut self) {
+        self.state.release();
+        if let Some(report) = self.report.take() { let _ = report.join(); }
+    }
+}
+
+#[tokio::test]
+async fn actual_new_scene_insertion_invalidates_original_epoch_despite_all_original_flights() {
+    let mut room = ManagedRoom::with_video(true).await;
+    let result = catch_original(async {
+        let (alice, old, source) = actors(&mut room).await;
+        let ready = prepared(&mut room, &alice, &old, &source).await;
+        let scene = crate::orchestrator::participant_control::replacement::metadata_test_support::replacement_scene_for_test(&ready.root).unwrap();
+        let original = scene.structural_epoch.capture().unwrap();
+        let controllers = room.nodes.values().map(|node| node.controller.clone()).collect::<Vec<_>>();
+        let flights = controllers.iter().map(|controller| controller.inflight.clone().try_acquire_owned().unwrap()).collect::<Vec<_>>();
+        // This is genuine public fixture admission of a NEW controller. Its
+        // own flight does not overlap any retained original controller flight.
+        let next = domain(&room.conversation, &room.session, "structural-insert", "inserted");
+        let inserted = room.initial(next).await;
+        assert!(scene.members.lock().unwrap().contains_key(&inserted));
+        assert!(!scene.structural_epoch.unchanged(original));
+        assert!(controllers.iter().all(|controller| controller.inflight.available_permits() == 0));
+        let after_insert = scene.structural_epoch.capture().unwrap();
+        drop(flights);
+        // An empty exact cleanup is genuinely effect-free and must not make
+        // the unchanged original scene look structurally different.
+        scene.try_remove_committed_members(&[]).unwrap();
+        assert!(scene.structural_epoch.unchanged(after_insert));
+        let expected = {
+            let members = scene.members.lock().unwrap();
+            crate::staged_streams::media_scene::TerminalMemberRetirement::capture(members[&inserted].control_view())
+        };
+        scene.try_remove_committed_members(std::slice::from_ref(&expected)).unwrap();
+        assert!(!scene.structural_epoch.unchanged(after_insert));
+        let removed = scene.structural_epoch.capture().unwrap();
+        scene.try_remove_committed_members(std::slice::from_ref(&expected)).unwrap();
+        assert!(scene.structural_epoch.unchanged(removed), "already-removed original is a no-op");
+    }).await;
+    let cleanup = room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done| done));
+    if let Err(error) = result { resume_unwind(error); }
+}
