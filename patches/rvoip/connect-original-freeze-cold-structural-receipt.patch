+//! Cold-control structural invalidation. This is authoritative only when
+//! captured under the same original structural guards as the protected facts.
+//! Writers invalidate beneath their existing guards before the first effect.
+use super::{ControlResult, MediaTransitionError};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub(super) struct StructuralEpoch(AtomicU64);
+impl Default for StructuralEpoch {
+    fn default() -> Self { Self(AtomicU64::new(1)) }
+}
+impl StructuralEpoch {
+    pub(super) fn capture(&self) -> ControlResult<u64> {
+        let value = self.0.load(Ordering::Acquire);
+        if value == u64::MAX { return Err(MediaTransitionError::Conflict.into()); }
+        Ok(value)
+    }
+    pub(super) fn unchanged(&self, expected: u64) -> bool {
+        expected != u64::MAX && self.0.load(Ordering::Acquire) == expected
+    }
+    pub(super) fn invalidate_before_effect(&self) {
+        // Never wrap or make an exhausted incarnation usable again.
+        let _ = self.0.fetch_update(Ordering::AcqRel, Ordering::Acquire,
+            |value| Some(value.saturating_add(1)));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn original_structural_epoch_never_recovers_after_invalidation_or_exhaustion() {
+        let epoch = StructuralEpoch::default();
+        let original = epoch.capture().unwrap();
+        assert!(epoch.unchanged(original));
+        epoch.invalidate_before_effect();
+        assert!(!epoch.unchanged(original));
+        let next = epoch.capture().unwrap();
+        assert!(next > original && epoch.unchanged(next));
+        let exhausted = StructuralEpoch(AtomicU64::new(u64::MAX - 1));
+        let last = exhausted.capture().unwrap();
+        exhausted.invalidate_before_effect();
+        assert!(!exhausted.unchanged(last) && exhausted.capture().is_err());
+        exhausted.invalidate_before_effect();
+        assert!(!exhausted.unchanged(last) && !exhausted.unchanged(u64::MAX)
+            && exhausted.capture().is_err());
+    }
+}
