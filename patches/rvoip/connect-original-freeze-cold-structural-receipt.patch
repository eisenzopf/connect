+#[tokio::test]
+async fn terminal_request_precedes_blocked_model_cleanup_without_racing_directional_publication() {
+    let mut room = ManagedRoom::with_video(true).await;
+    let result = catch_original(async {
+        let (_, old, _) = actors(&mut room).await;
+        let controller = room.nodes[&old].controller.clone();
+        let port = room.nodes[&old].backend.port(Medium::Video);
+        assert!(!port.0.terminal_requested());
+        let original_ingress = port.0.ticket(TicketSide::Ingress);
+        let original_egress = port.0.ticket(TicketSide::Egress);
+        let change = crate::staged_streams::directional_ticket::PortTicketChange::stage(port.0.clone(), [true, false]).unwrap();
+        let mut owner = TerminalOwner::start(controller, port.clone());
+        let until = deadline();
+        while !port.0.terminal_requested() && tokio::time::Instant::now() < until {
+            tokio::task::yield_now().await;
+        }
+        let requested = port.0.terminal_requested();
+        let blocked = !owner.report.as_ref().unwrap().is_finished();
+        let old_tickets_not_retired = original_ingress.is_current() && original_egress.is_current();
+        // The exact original State owner blocks report_terminal. Its early
+        // request MUST NOT retire tickets between real preflight and commit.
+        let published = {
+            let mut state = port.0.state.lock().unwrap();
+            change.validate(&state).unwrap();
+            change.commit(&mut state);
+            port.0.ticket(TicketSide::Ingress).is_current()
+                && !original_ingress.is_current() && original_egress.is_current()
+        };
+        let actual = owner.finish().unwrap();
+        assert!(requested && blocked && old_tickets_not_retired && published && actual);
+        assert!(port.0.terminal_requested());
+        assert!(!port.0.ticket(TicketSide::Ingress).is_current()
+            && !port.0.ticket(TicketSide::Egress).is_current());
+        assert!(!port.report_terminal().unwrap(), "same original terminal report is idempotent");
+    }).await;
+    let cleanup = room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done| done));
+    if let Err(error) = result { resume_unwind(error); }
+}
