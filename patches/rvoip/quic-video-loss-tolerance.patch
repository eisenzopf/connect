+    /// Observe cumulative Quinn path counters without summing the same
+    /// connection repeatedly or inventing aggregate loss across physical peers.
+    pub fn quic_congestion(&self, rtt: Duration, cwnd: u64, lost: u64, events: u64, sent: u64) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let value = &mut state.quic;
+        let rtt = rtt.as_micros().min(u64::MAX as u128) as u64;
+        value.congestion_samples = value.congestion_samples.saturating_add(1);
+        value.minimum_sampled_rtt_us = Some(value.minimum_sampled_rtt_us.unwrap_or(rtt).min(rtt));
+        value.maximum_sampled_rtt_us = Some(value.maximum_sampled_rtt_us.unwrap_or(rtt).max(rtt));
