+/// Actual encrypted UDP reordering and loss, independent of codec assembly.
+/// These fixture thresholds establish transport behavior only, not the media
+/// qualification profile. The proxy preserves the configured 100ms delay bound.
+#[tokio::test]
+async fn encoded_video_transport_reorders_and_still_detects_real_loss() {
+    for drop_every in [0_u64, 33] {
+        let _ = rustls::crypto::ring::default_provider().install_default();
+        let (cert, key) =
+            rvoip_uctp::substrate::self_signed_for_dev(&["localhost".into()]).unwrap();
+        let mut tls = rustls::ServerConfig::builder()
+            .with_no_client_auth()
+            .with_single_cert(vec![cert.clone()], key)
+            .unwrap();
+        tls.alpn_protocols = vec![rvoip_uctp::UCTP_RAW_QUIC_ALPN_BYTES.to_vec()];
+        let mut transport = quinn::TransportConfig::default();
+        apply_encoded_video_transport_budget(&mut transport);
+        let server = rvoip_uctp::substrate::make_server_endpoint(
+            "127.0.0.1:0".parse().unwrap(),
+            Arc::new(tls),
+            transport,
+        )
+        .unwrap();
+        let front = Arc::new(tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap());
+        let back = Arc::new(tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap());
+        let proxy_address = front.local_addr().unwrap();
+        let target = server.local_addr().unwrap();
+        let cancel = tokio_util::sync::CancellationToken::new();
+        let proxy_cancel = cancel.clone();
+        let proxy = tokio::spawn(async move {
+            let mut client_address = None;
+            let mut a = [0u8; 65536];
+            let mut b = [0u8; 65536];
+            let mut pending: tokio::task::JoinSet<std::io::Result<(usize, usize)>> =
+                tokio::task::JoinSet::new();
+            let mut counts = [0u64; 2];
+            let mut drops = [0u64; 2];
+            let mut forwarded = [0u64; 2];
+            let mut peak = 0;
+            let mut random = 511_u64;
+            loop {
+                let (data, socket, destination, direction) = tokio::select! {
+                    _ = proxy_cancel.cancelled() => break,
+                    Some(result) = pending.join_next(), if !pending.is_empty() => {
+                        let (direction, _) = result.unwrap().unwrap();
+                        forwarded[direction] += 1; continue;
+                    },
+                    incoming = front.recv_from(&mut a) => {
+                        let (length, address) = incoming.unwrap();
+                        client_address = Some(address);
+                        (a[..length].to_vec(), back.clone(), target, 0)
+                    },
+                    incoming = back.recv_from(&mut b) => {
+                        let (length, address) = incoming.unwrap();
+                        assert_eq!(address, target);
+                        (b[..length].to_vec(), front.clone(), client_address.unwrap(), 1)
+                    }
+                };
+                counts[direction] += 1;
+                if drop_every > 0 && counts[direction] % drop_every == 0 {
+                    drops[direction] += 1;
+                    continue;
+                }
+                random = random.wrapping_mul(6364136223846793005).wrapping_add(1);
+                let delay = Duration::from_micros((random >> 32) % 100_001);
+                assert!(pending.len() < 512, "proxy queue must remain bounded");
+                pending.spawn(async move {
+                    tokio::time::sleep(delay).await;
+                    socket
+                        .send_to(&data, destination)
+                        .await
+                        .map(|bytes| (direction, bytes))
+                });
+                peak = peak.max(pending.len());
+            }
+            // Stop admitting new UDP input, then dispatch every already-owned
+            // packet before evaluating realized loss. Shutdown drops are zero.
+            while let Some(result) = pending.join_next().await {
+                let (direction, _) = result.unwrap().unwrap();
+                forwarded[direction] += 1;
+            }
+            (counts, drops, forwarded, peak)
+        });
+        let mut tls = rvoip_uctp::substrate::dev_client_config_trusting(&cert).unwrap();
+        tls.alpn_protocols = vec![rvoip_uctp::UCTP_RAW_QUIC_ALPN_BYTES.to_vec()];
+        let mut config = quinn::ClientConfig::new(Arc::new(
+            quinn::crypto::rustls::QuicClientConfig::try_from(tls).unwrap(),
+        ));
+        let mut transport = quinn::TransportConfig::default();
+        apply_encoded_video_transport_budget(&mut transport);
+        config.transport_config(Arc::new(transport));
+        let client = quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+        let connecting = client
+            .connect_with(config, proxy_address, "localhost")
+            .unwrap();
+        let (sender, receiver) = tokio::time::timeout(Duration::from_secs(10), async {
+            tokio::join!(connecting, async { server.accept().await.unwrap().await })
+        })
+        .await
+        .unwrap();
+        let sender = sender.unwrap();
+        let receiver = receiver.unwrap();
+        let reader_stop = tokio_util::sync::CancellationToken::new();
+        let reader_cancel = reader_stop.clone();
+        let reader = tokio::spawn(async move {
+            let mut seen = std::collections::HashSet::new();
+            loop {
+                let wire = tokio::select! {
+                    _ = reader_cancel.cancelled() => break,
+                    wire = receiver.read_datagram() => match wire {Ok(wire) => wire, Err(_) => break},
+                };
+                assert_eq!(wire.len(), 900);
+                let id = u32::from_be_bytes(wire[..4].try_into().unwrap());
+                assert!(id < 480);
+                assert!(wire[4..].iter().all(|byte| *byte == (id % 251) as u8));
+                assert!(seen.insert(id), "duplicate application datagram");
+            }
+            seen.len()
+        });
+        let mut cadence = tokio::time::interval(Duration::from_nanos(1_000_000_000 / 30));
+        cadence.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        let mut over_space = 0;
+        for frame in 0..120 {
+            cadence.tick().await;
+            for fragment in 0..4 {
+                let id = frame * 4 + fragment;
+                let mut wire = vec![(id % 251) as u8; 900];
+                wire[..4].copy_from_slice(&(id as u32).to_be_bytes());
+                if sender.datagram_send_buffer_space() < wire.len() {
+                    over_space += 1;
+                }
+                sender.send_datagram(wire.into()).unwrap();
+            }
+        }
+        tokio::time::sleep(Duration::from_millis(400)).await;
+        // Loss/congestion counters are sampled before any shutdown, after a
+        // drain four times longer than the maximum proxy delay.
+        let stats = sender.stats();
+        reader_stop.cancel();
+        sender.close(0u32.into(), b"fixture complete");
+        let received = tokio::time::timeout(Duration::from_secs(5), reader)
+            .await
+            .unwrap()
+            .unwrap();
+        cancel.cancel();
+        let (counts, drops, forwarded, peak) = proxy.await.unwrap();
+        for direction in 0..2 {
+            assert_eq!(counts[direction], drops[direction] + forwarded[direction]);
+        }
+        eprintln!("QUIC reorder fixture drop_every={drop_every} sent=480 received={received} over_space={over_space} udp={counts:?} dropped={drops:?} forwarded={forwarded:?} peak={peak} path={:?}", stats.path);
+        // Deep reordering must not collapse useful delivery. The actual-loss
+        // case must remain observably lossy and congestion-controlled.
+        assert!(
+            received >= 360,
+            "at least75% exact datagrams must survive the bounded profile"
+        );
+        if drop_every == 0 {
+            assert_eq!(drops, [0, 0]);
+        } else {
+            assert!(drops.iter().sum::<u64>() > 0);
+            assert!(stats.path.lost_packets > 0);
+            assert!(stats.path.congestion_events > 0);
+            assert!(received < 480);
+        }
+    }
+}
