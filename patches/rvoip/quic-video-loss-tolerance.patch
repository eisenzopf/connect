 pub fn apply_encoded_video_transport_budget(transport: &mut quinn::TransportConfig) -> usize {
     let capacity = 64 * (rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES + 8);
     transport.datagram_send_buffer_size(capacity);
+    // Encoded frames arrive in bounded bursts. A 100ms reorder window can put
+    // more than the default three packets ahead of an intact earlier fragment.
+    // Retain Cubic and real loss detection, but avoid interpreting every such
+    // burst as congestion. Time-based loss and PTO still bound missing packets;
+    // this does not enlarge any media queue or the 200ms local frame deadline.
+    transport.packet_threshold(64).time_threshold(4.0);
     capacity
 }
