+#[test]
+fn encoded_video_loss_tolerance_is_explicit_and_preserves_other_transport_settings() {
+    let baseline = quinn::TransportConfig::default();
+    let baseline_debug = format!("{baseline:?}");
+    assert!(baseline_debug.contains("packet_threshold: 3,"));
+    assert!(baseline_debug.contains("time_threshold: 1.125,"));
+    let mut selected = quinn::TransportConfig::default();
+    let capacity = apply_encoded_video_transport_budget(&mut selected);
+    assert_eq!(capacity, 64 * 1188);
+    let mut expected = baseline;
+    expected
+        .datagram_send_buffer_size(capacity)
+        .packet_threshold(64)
+        .time_threshold(4.0);
+    assert_eq!(format!("{selected:?}"), format!("{expected:?}"));
+    // Default upstream endpoints remain unchanged; no alternate controller is
+    // installed by the opt-in helper. Cubic's loss response is exercised by the
+    // separately selected actual loss/reorder transport fixture.
+    assert_eq!(
+        format!("{:?}", quinn::TransportConfig::default()),
+        baseline_debug
