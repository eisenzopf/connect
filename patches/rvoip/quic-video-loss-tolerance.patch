+#[test]
+fn congestion_samples_preserve_extrema_without_summing_connection_counters() {
+    let collector = MediaDiagnostics::default();
+    collector.quic_path(Some(1186), 1200, 1188);
+    collector.quic_congestion(Duration::from_millis(80), 12000, 8, 3, 40);
+    collector.quic_congestion(Duration::from_millis(100), 6000, 8, 3, 40);
+    collector.quic_congestion(Duration::from_millis(20), 24000, 2, 1, 10);
+    let value = collector.snapshot().quic.unwrap();
+    assert_eq!(value.congestion_samples, 3);
+    assert_eq!(value.minimum_sampled_rtt_us, Some(20000));
+    assert_eq!(value.maximum_sampled_rtt_us, Some(100000));
+    assert_eq!(value.minimum_sampled_cwnd_bytes, Some(6000));
+    assert_eq!(value.maximum_sampled_cwnd_bytes, Some(24000));
+    assert_eq!(value.maximum_sampled_connection_lost_packets, 8);
+    assert_eq!(value.maximum_sampled_connection_congestion_events, 3);
+    assert_eq!(value.maximum_sampled_connection_sent_packets, 40);
+}
