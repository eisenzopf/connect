--- /dev/null
+++ b/crates/uctp/rvoip-uctp/src/v2/native_journal_delivery.rs
@@ -0,0 +1,97 @@
+//! Metadata-only journal hints acquire current domain readers at actual IO.
+use super::{
+    auth_dispatch::{AuthorityLease, DispatchError},
+    native_requests::NativeRequestOrigin,
+    Envelope, Scope,
+};
+use std::sync::Arc;
+use tokio::{sync::oneshot, time::Instant};
+use tokio_util::sync::CancellationToken;
+#[async_trait::async_trait]
+pub trait NativeJournalWritePolicy: Send + Sync {
+    async fn acquire(
+        &self,
+        origin: &NativeRequestOrigin,
+        payload: &serde_json::Value,
+    ) -> Result<AuthorityLease, DispatchError>;
+}
+pub(in crate::v2) struct PendingJournal {
+    pub origin: Arc<NativeRequestOrigin>,
+    pub payload: serde_json::Value,
+    pub frame: Envelope,
+    pub policy: Arc<dyn NativeJournalWritePolicy>,
+    pub completion: Option<oneshot::Sender<Result<(), DispatchError>>>,
+    pub cancel: CancellationToken,
+}
+impl Drop for PendingJournal {
+    fn drop(&mut self) {
+        if let Some(done) = self.completion.take() {
+            let _ = done.send(Err(DispatchError::Closed));
+        }
+    }
+}
+struct Custody<W> {
+    writer: Option<W>,
+    lease: AuthorityLease,
+}
+impl<W> Drop for Custody<W> {
+    fn drop(&mut self) {
+        drop(self.writer.take());
+    }
+}
+pub(in crate::v2) async fn write<
+    W: futures::Sink<bytes::Bytes, Error = DispatchError> + Send + Unpin,
+>(
+    writer: &mut Option<W>,
+    frame: &Envelope,
+    mut pending: PendingJournal,
+    physical: &CancellationToken,
+    authority: Option<&CancellationToken>,
+    stop: &CancellationToken,
+    deadline: Instant,
+) -> Result<(), DispatchError> {
+    use futures::{Future, SinkExt};
+    let ready = || {
+        pending.origin.current()
+            && pending.origin.ready()
+            && !pending.cancel.is_cancelled()
+            && !physical.is_cancelled()
+            && !stop.is_cancelled()
+            && !authority.is_some_and(CancellationToken::is_cancelled)
+            && Instant::now() < deadline
+    };
+    let mut touched = false;
+    let result=async {
+        if !ready() || frame.kind()!="operation.updated" || frame.id()!=pending.frame.id() || frame.original()["payload"]!=pending.payload
+            || [Scope::Conversation,Scope::Session,Scope::Connection,Scope::Operation,Scope::Reply].into_iter().any(|s|frame.scope(s)!=pending.frame.scope(s)) {return Err(DispatchError::Authority);}
+        let lease=tokio::time::timeout_at(deadline,pending.policy.acquire(&pending.origin,&pending.payload)).await.map_err(|_|DispatchError::Closed)??;
+        let bound=deadline.min(lease.deadline().unwrap_or(deadline));
+        if !ready() || !lease.current() {return Err(DispatchError::Authority);}
+        let bytes=bytes::Bytes::from(serde_json::to_vec(frame).map_err(|_|DispatchError::Unsupported)?);
+        let mut custody=Custody{writer:None,lease};
+        let result={
+            let sending=async {
+                custody.writer=Some(writer.take().ok_or(DispatchError::Closed)?);touched=true;
+                custody.writer.as_mut().ok_or(DispatchError::Closed)?.send(bytes).await
+            };tokio::pin!(sending);
+            let guarded=std::future::poll_fn(|cx| {if !ready() || !custody.lease.current(){return std::task::Poll::Ready(Err(DispatchError::Authority));}sending.as_mut().poll(cx)});
+            tokio::select!{biased;
+                _=physical.cancelled()=>Err(DispatchError::Closed),_=stop.cancelled()=>Err(DispatchError::Closed),_=pending.cancel.cancelled()=>Err(DispatchError::Closed),
+                _=async{match authority{Some(token)=>token.cancelled().await,None=>std::future::pending().await}}=>Err(DispatchError::Authority),
+                _=tokio::time::sleep_until(bound)=>Err(DispatchError::Closed),result=guarded=>result,
+            }
+        };
+        if result.is_ok(){*writer=custody.writer.take();}else if touched{physical.cancel();}
+        // An unfinished sink dies before the independently acquired read does.
+        drop(custody);result
+    }.await;
+    if let Some(done) = pending.completion.take() {
+        let _ = done.send(result);
+    }
+    if result.is_err() && touched {
+        physical.cancel();
+        Err(DispatchError::SubmissionUnknown)
+    } else {
+        Ok(())
+    }
+}
