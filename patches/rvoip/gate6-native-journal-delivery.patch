 impl NativeRequestOrigin {
+    /// Submit a metadata hint on this exact already-confirmed physical writer.
+    /// The caller supplies fresh current domain authority, never an idle grant.
+    /// This cannot carry bindings, complete an operation, or authorize media.
+    pub fn journal_delivery(
+        self: &Arc<Self>,
+        payload: serde_json::Value,
+        policy: Arc<dyn super::native_journal_delivery::NativeJournalWritePolicy>,
+    ) -> Result<
+        (
+            HandlerDelivery,
+            tokio::sync::oneshot::Receiver<Result<(), DispatchError>>,
+        ),
+        DispatchError,
+    > {
+        let object = payload.as_object().ok_or(DispatchError::ReplyMismatch)?;
+        let fields = [
+            "operation_id",
+            "record_id",
+            "command_type",
+            "expected_revision",
+            "state",
+            "revision",
+            "subscription_record_id",
+            "stream_revision",
+            "journal_hint",
+            "resources_changed",
+        ];
+        if object.len() != fields.len()
+            || fields.iter().any(|f| !object.contains_key(*f))
+            || payload["command_type"] != "stream.reconcile"
+            || payload["state"] != "completed"
+            || payload["journal_hint"] != true
+            || payload["resources_changed"] != false
+            || payload["revision"]
+                .as_u64()
+                .is_none_or(|n| n > 9_007_199_254_740_991)
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        for field in ["operation_id", "record_id", "subscription_record_id"] {
+            super::Identifier::try_from(
+                payload[field]
+                    .as_str()
+                    .ok_or(DispatchError::ReplyMismatch)?
+                    .to_owned(),
+            )?;
+        }
+        let expected = payload["expected_revision"]
+            .as_u64()
+            .filter(|n| *n > 0 && *n < 9_007_199_254_740_991)
+            .ok_or(DispatchError::ReplyMismatch)?;
+        let resulting = payload["stream_revision"]
+            .as_u64()
+            .ok_or(DispatchError::ReplyMismatch)?;
+        if !(expected..=expected + 1).contains(&resulting) || !self.current() || !self.ready() {
+            return Err(DispatchError::Authority);
+        }
+        let frame = Envelope::from_value(serde_json::json!({
+            "v":2,"type":"operation.updated","id":format!("journal_{}",uuid::Uuid::new_v4().simple()),"ts":chrono::Utc::now(),
+            "cid":self.scope.media.wire_conversation,"sid":self.scope.media.wire_session,"connid":self.scope.media.wire_connection,
+            "operation_id":payload["operation_id"],"payload":payload,
+        }))?;
+        let (done, receipt) = tokio::sync::oneshot::channel();
+        let pending = super::native_journal_delivery::PendingJournal {
+            origin: self.clone(),
+            payload,
+            frame: frame.clone(),
+            policy,
+            completion: Some(done),
+            cancel: self.origin.cancellation(),
+        };
+        let delivery = HandlerDelivery::native_journal(
+            &self.origin,
+            frame,
+            pending,
+            (Instant::now() + Duration::from_secs(1)).min(self.origin.deadline()),
+        )?;
+        Ok((delivery, receipt))
+    }
     pub(crate) fn new(
         a: &AuthorizedEnvelope,
         controller: &Arc<StreamController>,
