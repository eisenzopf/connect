+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc, Mutex,
+    },
+    time::Duration,
+};
+use tokio::{
+    net::UdpSocket,
+    sync::RwLock,
+    time::{timeout, Instant},
+};
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+struct Policy {
+    permission: Arc<RwLock<bool>>,
+    acquisitions: AtomicUsize,
+    wire: Mutex<Vec<Vec<u8>>>,
+}
+impl Policy {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            permission: Arc::new(RwLock::new(true)),
+            acquisitions: AtomicUsize::new(0),
+            wire: Mutex::new(Vec::new()),
+        })
+    }
+}
+#[async_trait]
+impl ClientRequestWriteAuthority for Policy {
+    async fn write(
+        &self,
+        scope: &ClientRequestWriteScope<'_>,
+        io: ClientRequestWriteFuture<'_>,
+    ) -> rvoip_sip_transport::Result<TransportRoute> {
+        self.acquisitions.fetch_add(1, Ordering::AcqRel);
+        let guard = self.permission.clone().read_owned().await;
+        if !*guard {
+            return Err(rvoip_sip_transport::Error::InvalidState(
+                "fixture refusal".into(),
+            ));
+        }
+        assert!(
+            matches!(scope.message,Message::Request(request) if request.method()==Method::Info)
+        );
+        self.wire
+            .lock()
+            .unwrap()
+            .push(scope.message.to_bytes().to_vec());
+        let result = io.await;
+        drop(guard);
+        result
+    }
+}
+struct Fixture {
+    api: UnifiedDialogApi,
+    transactions: Arc<TransactionManager>,
+    peer: UdpSocket,
+    dialog: rvoip_sip_dialog::DialogId,
+}
+impl Fixture {
+    async fn new() -> Result<Self, Box<dyn std::error::Error>> {
+        let peer = UdpSocket::bind("127.0.0.1:0").await?;
+        let address = peer.local_addr()?;
+        let config = TransportManagerConfig {
+            enable_udp: true,
+            enable_tcp: false,
+            enable_ws: false,
+            enable_tls: false,
+            bind_addresses: vec!["127.0.0.1:0".parse()?],
+            ..Default::default()
+        };
+        let (mut transport, rx) = TransportManager::new(config).await?;
+        transport.initialize().await?;
+        let local = transport
+            .default_transport()
+            .await
+            .ok_or("no transport")?
+            .local_addr()?;
+        let (transactions, _) =
+            TransactionManager::with_transport_manager(transport, rx, Some(32)).await?;
+        let transactions = Arc::new(transactions);
+        let api = UnifiedDialogApi::new(
+            transactions.clone(),
+            DialogManagerConfig::client(local)
+                .with_from_uri("sip:fixture@127.0.0.1")
+                .build(),
+        )
+        .await?;
+        api.start().await?;
+        let mut dialog = Dialog::new(
+            "owned-info-fixture".into(),
+            format!("sip:fixture@{local}").parse()?,
+            format!("sip:peer@{address}").parse()?,
+            Some("fixture-local".into()),
+            Some("fixture-peer".into()),
+            true,
+        );
+        dialog.state = DialogState::Confirmed;
+        let id = dialog.id.clone();
+        api.dialog_manager()
+            .inner_manager()
+            .store_dialog(dialog)
+            .await?;
+        Ok(Self {
+            api,
+            transactions,
+            peer,
+            dialog: id,
+        })
+    }
+    async fn receive(&self) -> (Vec<u8>, std::net::SocketAddr) {
+        let mut buffer = vec![0; 65536];
+        let (n, peer) = timeout(Duration::from_secs(2), self.peer.recv_from(&mut buffer))
+            .await
+            .expect("INFO UDP deadline")
+            .unwrap();
+        buffer.truncate(n);
+        (buffer, peer)
+    }
+    async fn stop(self) {
+        self.api.stop().await.unwrap();
+        self.transactions.shutdown().await;
+    }
+}
+fn options() -> InfoRequestOptions {
+    InfoRequestOptions {
+        content_type: "application/dtmf-relay".into(),
+        body: Bytes::from_static(b"Signal=5\r\nDuration=160\r\n"),
+        extra_headers: Vec::new(),
+    }
+}
+#[tokio::test]
+async fn owned_info_public_udp_retransmits_exact_request_under_fresh_permission() -> TestResult {
+    let fixture = Fixture::new().await?;
+    let policy = Policy::new();
+    let delivery = fixture
+        .api
+        .send_info_with_options_authorized(
+            &fixture.dialog,
+            options(),
+            policy.clone(),
+            Instant::now() + Duration::from_secs(4),
+        )
+        .await?;
+    let (first, peer) = fixture.receive().await;
+    let (second, retry_peer) = fixture.receive().await;
+    assert_eq!(peer, retry_peer);
+    assert_eq!(first, second);
+    let request = match parse_message(&first)? {
+        Message::Request(request) => request,
+        _ => panic!("request"),
+    };
+    assert_eq!(request.method(), Method::Info);
+    assert_eq!(request.body(), b"Signal=5\r\nDuration=160\r\n");
+    assert!(
+        matches!(request.header(&HeaderName::ContentType),Some(TypedHeader::ContentType(value)) if value.to_string()=="application/dtmf-relay")
+    );
+    assert_eq!(policy.acquisitions.load(Ordering::Acquire), 2);
+    assert_eq!(
+        policy.wire.lock().unwrap().as_slice(),
+        &[first.clone(), second]
+    );
+    let writer = timeout(Duration::from_millis(100), policy.permission.write())
+        .await
+        .expect("idle grant retained");
+    drop(writer);
+    let response = create_response(&request, StatusCode::Ok);
+    fixture
+        .peer
+        .send_to(&Message::Response(response).to_bytes(), peer)
+        .await?;
+    assert!(
+        matches!(delivery.completion().wait_for_outcome(Duration::from_secs(1)).await?,Some(ClientTransactionOutcome::FinalResponse(response)) if response.status()==StatusCode::Ok)
+    );
+    drop(delivery);
+    fixture.stop().await;
+    Ok(())
+}
+#[tokio::test]
+async fn owned_info_public_drop_stops_udp_retry_after_first_effect() -> TestResult {
+    let fixture = Fixture::new().await?;
+    let policy = Policy::new();
+    let delivery = fixture
+        .api
+        .send_info_with_options_authorized(
+            &fixture.dialog,
+            options(),
+            policy.clone(),
+            Instant::now() + Duration::from_secs(3),
+        )
+        .await?;
+    fixture.receive().await;
+    drop(delivery);
+    let mut buffer = [0; 2048];
+    assert!(timeout(
+        Duration::from_millis(750),
+        fixture.peer.recv_from(&mut buffer)
+    )
+    .await
+    .is_err());
+    assert_eq!(policy.acquisitions.load(Ordering::Acquire), 1);
+    fixture.stop().await;
+    Ok(())
+}
+#[tokio::test]
+async fn owned_info_public_refusal_and_expiry_produce_no_datagram() -> TestResult {
+    for expired in [false, true] {
+        let fixture = Fixture::new().await?;
+        let policy = Policy::new();
+        *policy.permission.write().await = false;
+        let deadline = if expired {
+            Instant::now() - Duration::from_millis(1)
+        } else {
+            Instant::now() + Duration::from_secs(1)
+        };
+        assert!(fixture
+            .api
+            .send_info_with_options_authorized(&fixture.dialog, options(), policy.clone(), deadline)
+            .await
+            .is_err());
+        let mut buffer = [0; 2048];
+        assert!(timeout(
+            Duration::from_millis(100),
+            fixture.peer.recv_from(&mut buffer)
+        )
+        .await
+        .is_err());
+        assert_eq!(
+            policy.acquisitions.load(Ordering::Acquire),
+            usize::from(!expired)
+        );
+        fixture.stop().await;
+    }
+    Ok(())
+}
+#[tokio::test]
+async fn owned_info_public_401_is_exact_final_response_without_automatic_effect_retry() -> TestResult
+{
+    let fixture = Fixture::new().await?;
