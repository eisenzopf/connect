+//! Real isolated UDP through the public canonical INFO API and real Timer E.
+use async_trait::async_trait;
+use bytes::Bytes;
+use rvoip_sip_core::{parse_message, HeaderName, Message, Method, StatusCode, TypedHeader};
+use rvoip_sip_dialog::transaction::{
+    egress::{ClientRequestWriteAuthority, ClientRequestWriteFuture, ClientRequestWriteScope},
+    transport::{TransportManager, TransportManagerConfig},
+    utils::response_builders::create_response,
+    ClientTransactionOutcome, TransactionManager,
+};
