@@ -0,0 +1,296 @@
+//! Per-write authorization at the exact client request transport boundary.
+//! The policy is installed before transaction publication. Its retained object
+//! carries no idle grant; every first send and retransmission calls it anew.
+use super::TransactionKey;
+use async_trait::async_trait;
+use rvoip_sip_core::Message;
+use rvoip_sip_transport::{Result, TransportRoute};
+use std::{future::Future, pin::Pin};
+pub type ClientRequestWriteFuture<'a> =
+    Pin<Box<dyn Future<Output = Result<TransportRoute>> + Send + 'a>>;
+/// Actual immutable transaction/message and prepared route. Message content or
+/// a matching branch is never authority. The IO future owns the exact send;
+/// a policy cannot substitute another message or destination through this seam.
+pub struct ClientRequestWriteScope<'a> {
+    pub transaction: &'a TransactionKey,
+    pub message: &'a Message,
+    pub route: &'a TransportRoute,
+}
+impl std::fmt::Debug for ClientRequestWriteScope<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("ClientRequestWriteScope(redacted)")
+    }
+}
+/// Acquire current permission and retain its owned guard through this actual
+/// IO, including abortion. Do not detach the supplied future, hold a reader
+/// between retries, or treat a prior success as a grant for another write.
+#[async_trait]
+pub trait ClientRequestWriteAuthority: Send + Sync {
+    async fn write(
+        &self,
+        _scope: &ClientRequestWriteScope<'_>,
+        _io: ClientRequestWriteFuture<'_>,
+    ) -> Result<TransportRoute> {
+        Err(rvoip_sip_transport::Error::InvalidState(
+            "client request write authority denied".into(),
+        ))
+    }
+}
+
+/// Custody of all writes of one client operation. Drop aborts any pending
+/// owned IO and prohibits every later retransmission, without retaining a
+/// permission guard during timers or response waits.
+#[must_use = "dropping the owner cancels current and later request writes"]
+pub struct ClientRequestWriteOwner {
+    stop: tokio::sync::watch::Sender<bool>,
+    poll_fence: std::sync::Arc<std::sync::Mutex<bool>>,
+}
+impl ClientRequestWriteOwner {
+    pub fn new(
+        authority: std::sync::Arc<dyn ClientRequestWriteAuthority>,
+        deadline: tokio::time::Instant,
+    ) -> (Self, std::sync::Arc<dyn ClientRequestWriteAuthority>) {
+        let (stop, cancelled) = tokio::sync::watch::channel(false);
+        let poll_fence = std::sync::Arc::new(std::sync::Mutex::new(false));
+        (
+            Self {
+                stop,
+                poll_fence: poll_fence.clone(),
+            },
+            std::sync::Arc::new(OwnedRequestWriteAuthority {
+                authority,
+                poll_fence,
+                cancelled,
+                deadline,
+            }),
+        )
+    }
+    pub fn cancel(&self) {
+        // Linearize cancellation with actual bounded transport polls. No
+        // guard survives Pending, and no policy callback runs under this lock.
+        *self
+            .poll_fence
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner()) = true;
+        self.stop.send_replace(true);
+    }
+}
+impl Drop for ClientRequestWriteOwner {
+    fn drop(&mut self) {
+        self.cancel();
+    }
+}
+impl std::fmt::Debug for ClientRequestWriteOwner {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("ClientRequestWriteOwner(redacted)")
+    }
+}
+struct OwnedRequestWriteAuthority {
+    poll_fence: std::sync::Arc<std::sync::Mutex<bool>>,
+    authority: std::sync::Arc<dyn ClientRequestWriteAuthority>,
+    cancelled: tokio::sync::watch::Receiver<bool>,
+    deadline: tokio::time::Instant,
+}
+#[async_trait]
+impl ClientRequestWriteAuthority for OwnedRequestWriteAuthority {
+    async fn write(
+        &self,
+        scope: &ClientRequestWriteScope<'_>,
+        io: ClientRequestWriteFuture<'_>,
+    ) -> Result<TransportRoute> {
+        let mut cancelled = self.cancelled.clone();
+        if *cancelled.borrow_and_update() || tokio::time::Instant::now() >= self.deadline {
+            return Err(rvoip_sip_transport::Error::InvalidState(
+                "request write owner ended".into(),
+            ));
+        }
+        let mut io = io;
+        let io = Box::pin(std::future::poll_fn(|cx| {
+            let Ok(ended) = self.poll_fence.try_lock() else {
+                return std::task::Poll::Ready(Err(rvoip_sip_transport::Error::InvalidState(
+                    "request write custody busy".into(),
+                )));
+            };
+            if *ended || tokio::time::Instant::now() >= self.deadline {
+                return std::task::Poll::Ready(Err(rvoip_sip_transport::Error::InvalidState(
+                    "request write owner ended".into(),
+                )));
+            }
+            io.as_mut().poll(cx)
+        }));
+        tokio::select! {biased;
+            _=cancelled.changed()=>Err(rvoip_sip_transport::Error::InvalidState("request write owner ended".into())),
+            _=tokio::time::sleep_until(self.deadline)=>Err(rvoip_sip_transport::Error::InvalidState("request write owner deadline".into())),
+            result=self.authority.write(scope,io)=>result,
+        }
+    }
+}
+/// Exact INFO transaction and write custody returned together. The completion
+/// is factual SIP transaction evidence, never proof that a peer played a tone.
+#[must_use = "keep this delivery alive while awaiting its exact completion"]
+#[derive(Debug)]
+pub struct OwnedInfoDelivery {
+    transaction: TransactionKey,
+    completion: super::ClientTransactionCompletionHandle,
+    _owner: ClientRequestWriteOwner,
+}
+impl OwnedInfoDelivery {
+    pub(crate) fn new(
+        transaction: TransactionKey,
+        completion: super::ClientTransactionCompletionHandle,
+        owner: ClientRequestWriteOwner,
+    ) -> Self {
+        Self {
+            transaction,
+            completion,
+            _owner: owner,
+        }
+    }
+    pub fn transaction(&self) -> &TransactionKey {
+        &self.transaction
+    }
+    pub fn completion(&self) -> &super::ClientTransactionCompletionHandle {
+        &self.completion
+    }
+    pub fn cancel(&self) {
+        self._owner.cancel();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        sync::{
+            atomic::{AtomicBool, Ordering},
+            Arc,
+        },
+        task::Poll,
+        time::Duration,
+    };
+    struct Allow;
+    #[async_trait]
+    impl ClientRequestWriteAuthority for Allow {
+        async fn write(
+            &self,
+            _scope: &ClientRequestWriteScope<'_>,
+            io: ClientRequestWriteFuture<'_>,
+        ) -> Result<TransportRoute> {
+            io.await
+        }
+    }
+    struct DropProbe(Arc<AtomicBool>);
+    impl Drop for DropProbe {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::Release);
+        }
+    }
+    #[tokio::test(start_paused = true)]
+    async fn owner_drop_or_deadline_discards_pending_actual_io_before_a_ready_poll() {
+        for expired in [false, true] {
+            let request = Message::Request(rvoip_sip_core::Request::new(
+                rvoip_sip_core::Method::Info,
+                "sip:fixture@127.0.0.1".parse().unwrap(),
+            ));
+            let transaction = TransactionKey::new(
+                "z9hG4bK.owned-info-poll".into(),
+                rvoip_sip_core::Method::Info,
+                false,
+            );
+            let route = TransportRoute::new("127.0.0.1:5060".parse().unwrap());
+            let scope = ClientRequestWriteScope {
+                transaction: &transaction,
+                message: &request,
+                route: &route,
+            };
+            let (owner, authority) = ClientRequestWriteOwner::new(
+                Arc::new(Allow),
+                tokio::time::Instant::now() + Duration::from_millis(50),
+            );
+            let dropped = Arc::new(AtomicBool::new(false));
+            let ready = Arc::new(AtomicBool::new(false));
+            let wrote = Arc::new(AtomicBool::new(false));
+            let probe = DropProbe(dropped.clone());
+            let ready_io = ready.clone();
+            let wrote_io = wrote.clone();
+            let actual_route = route.clone();
+            let io = Box::pin(async move {
+                let _probe = probe;
+                std::future::poll_fn(move |_| {
+                    if ready_io.load(Ordering::Acquire) {
+                        wrote_io.store(true, Ordering::Release);
+                        Poll::Ready(Ok(actual_route.clone()))
+                    } else {
+                        Poll::Pending
+                    }
+                })
+                .await
+            });
+            let mut writing = Box::pin(authority.write(&scope, io));
+            assert!(futures::poll!(&mut writing).is_pending());
+            assert!(!dropped.load(Ordering::Acquire));
+            if expired {
+                tokio::time::advance(Duration::from_millis(51)).await;
+            } else {
+                owner.cancel();
+            }
+            ready.store(true, Ordering::Release);
+            assert!(writing.await.is_err());
+            assert!(dropped.load(Ordering::Acquire));
+            assert!(!wrote.load(Ordering::Acquire));
+            drop(owner);
+        }
+    }
+    #[tokio::test]
+    async fn cancellation_stops_delayed_policy_even_if_it_catches_up_after_owner_ends() {
+        struct Delayed {
+            ready: tokio::sync::Notify,
+        }
+        #[async_trait]
+        impl ClientRequestWriteAuthority for Delayed {
+            async fn write(
+                &self,
+                _scope: &ClientRequestWriteScope<'_>,
+                io: ClientRequestWriteFuture<'_>,
+            ) -> Result<TransportRoute> {
+                self.ready.notified().await;
+                io.await
+            }
+        }
+        let request = Message::Request(rvoip_sip_core::Request::new(
+            rvoip_sip_core::Method::Info,
+            "sip:fixture@127.0.0.1".parse().unwrap(),
+        ));
+        let transaction = TransactionKey::new(
+            "z9hG4bK.owned-info-policy".into(),
+            rvoip_sip_core::Method::Info,
+            false,
+        );
+        let route = TransportRoute::new("127.0.0.1:5060".parse().unwrap());
+        let scope = ClientRequestWriteScope {
+            transaction: &transaction,
+            message: &request,
+            route: &route,
+        };
+        let policy = Arc::new(Delayed {
+            ready: tokio::sync::Notify::new(),
+        });
+        let (owner, authority) = ClientRequestWriteOwner::new(
+            policy.clone(),
+            tokio::time::Instant::now() + Duration::from_secs(1),
+        );
+        let wrote = Arc::new(AtomicBool::new(false));
+        let actual_wrote = wrote.clone();
+        let actual_route = route.clone();
+        let io = Box::pin(async move {
+            actual_wrote.store(true, Ordering::Release);
+            Ok(actual_route)
+        });
+        let mut writing = Box::pin(authority.write(&scope, io));
+        assert!(futures::poll!(&mut writing).is_pending());
+        owner.cancel();
+        policy.ready.notify_one();
+        assert!(writing.await.is_err());
+        assert!(!wrote.load(Ordering::Acquire));
+    }
+}
