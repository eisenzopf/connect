+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_failed_routing_replays_the_exact_error_with_metadata_only_custody() {
+    for kind in ["quic", "wt"] {
+        let (s, mut other, policy) = setup(kind).await;
+        let receiver = s.native.adapters[&s.kind]
+            .media_controller(&s.second_id)
+            .unwrap();
+        other.send(s.f.sign(select(receiver.revision()))).await;
+        assert_eq!(other.read().await.kind(), "ack");
+        tokio::time::sleep(Duration::from_millis(650)).await;
+        let revision = receiver.revision();
+        let budget = receiver.stream_open_budget();
+        let completed_before = policy.operations.lock().unwrap().len();
+        policy.capture_error.store(true, Ordering::Release);
+        policy.fail_routing.store(true, Ordering::Release);
+        policy.changed.notify_waiters();
+        core_fixture::until(|| policy.error_replays.load(Ordering::Acquire) > 0).await;
+        let changed = policy.changed_errors.load(Ordering::Acquire);
+        if changed == 0 {
+            // The historical token owns no policy reader or new media grant.
+            drop(
+                tokio::time::timeout(Duration::from_secs(1), s.grants.0.write())
+                    .await
+                    .unwrap(),
+            );
+            core_fixture::until(|| {
+                policy.operations.lock().unwrap()[completed_before..]
+                    .iter()
+                    .any(|(_, result)| result.is_ok())
+            })
+            .await;
+            let operations = policy.operations.lock().unwrap();
+            let results = &operations[completed_before..];
+            let failed = results
+                .iter()
+                .filter(|(_, result)| matches!(result, Err(NativeOfferError::Conflict)))
+                .collect::<Vec<_>>();
+            assert_eq!(
+                failed.len(),
+                1,
+                "original failed outcome must be recorded once"
+            );
+            assert!(
+                results
+                    .iter()
+                    .any(|(operation, result)| result.is_ok() && operation != &failed[0].0),
+                "a definite failed attempt closes before fresh authorized reconciliation"
+            );
+        }
+        assert_eq!(
+            receiver.revision(),
+            revision,
+            "failed routing changed the graph revision"
+        );
+        assert_eq!(
+            receiver.stream_open_budget(),
+            budget,
+            "routing-only failure allocated resources"
+        );
+        s.wire.server.shutdown().await.unwrap();
+        other.server.shutdown().await.unwrap();
+        assert_eq!(
+            changed, 0,
+            "metadata-only retry replaced the original Conflict outcome with another engine result"
+        );
+    }
+}
