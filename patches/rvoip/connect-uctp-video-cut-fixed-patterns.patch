     #[test]
+    fn actual_receiver_cut_and_release_schemas_accept_only_the_declared_coordinates() {
+        use super::SCHEMA;
+
+        let mut value = json!({
+            "operation_record_id": "record",
+            "operation_id": "move",
+            "reservation_id": "reservation",
+            "source_connection_id": "old",
+            "target_connection_id": "candidate",
+            "stream_id": "receiver-b",
+            "source_cut_id": "cut",
+            "stream_generation": 1,
+            "connection_generation": 2,
+            "target_generation": 2,
+            "original_frame": {
+                "realm": "0000000000000000000000000000000a",
+                "last_old_ordinal": "0",
+                "ordinal": "18446744073709551615",
+            },
+            "floor": {
+                "carrier": "webrtc-rtp",
+                "physical_writer_incarnation": "0123456789abcdef0123456789abcdef",
+                "primary_ssrc": 7,
+                "first_public_rtp_timestamp": 4294967295_u32,
+            },
+        });
+        for (definition, profile) in [
+            (
+                "WebRtcReceiverVideoPostCut",
+                "connect-receiver-video-post-cut-v1",
+            ),
+            (
+                "WebRtcReceiverVideoRelease",
+                "connect-receiver-video-release-v1",
+            ),
+        ] {
+            let schema = &SCHEMA["$defs"][definition];
+            value["profile"] = json!(profile);
+            assert!(matches_schema(schema, &value));
+            for malformed in ["", "01", "-1", "1\n", "1٢", "184467440737095516150"] {
+                let mut refused = value.clone();
+                refused["original_frame"]["ordinal"] = json!(malformed);
+                assert!(!matches_schema(schema, &refused), "{malformed:?}");
+            }
+            for malformed in [
+                "0123456789ABCDEF0123456789abcdef",
+                "0123456789abcdef0123456789abcde",
+                "0123456789abcdef0123456789abcdef0",
+            ] {
+                let mut refused = value.clone();
+                refused["floor"]["physical_writer_incarnation"] = json!(malformed);
+                assert!(!matches_schema(schema, &refused), "{malformed:?}");
+            }
+        }
+    }
+
