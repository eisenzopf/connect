+/// One exact logical index transition. Repeated keys describe a sequential
+/// transition (including remove+insert of the SAME key), not a second guard.
+#[derive(Clone)]
+pub(in crate::orchestrator) struct BindingChange {
+    pub(in crate::orchestrator) connection: ConnectionId,
+    pub(in crate::orchestrator) before: Option<SessionId>,
+    pub(in crate::orchestrator) after: Option<SessionId>,
+}
+/// Owns the exact epoch and unique shard guards acquired before publication.
+/// The erased closure keeps their concrete hashbrown types private without
+/// introducing a dependency version or changing any ordinary index lookup.
+pub(in crate::orchestrator) struct BindingCommit<'a> {
+    apply: Option<Box<dyn FnOnce() + 'a>>,
+}
+impl BindingCommit<'_> {
+    pub(in crate::orchestrator) fn commit(mut self) {
+        if let Some(apply)=self.apply.take() {apply();}
+    }
+}
+impl DtmfBindingIndex {
+    pub(in crate::orchestrator) fn try_compound_change<'a>(
+        &'a self,
+        changes: &[BindingChange],
+    ) -> std::result::Result<BindingCommit<'a>, crate::staged_streams::StreamControlError> {
+        use crate::staged_streams::StreamControlError;
+        use std::collections::{BTreeMap, BTreeSet};
+        use std::hash::BuildHasher;
+        if changes.is_empty() { return Ok(BindingCommit { apply: None }); }
+        let mut combined = BTreeMap::<ConnectionId, (Option<SessionId>, Option<SessionId>, usize)>::new();
+        for change in changes {
+            if let Some((_, last, invalidations)) = combined.get_mut(&change.connection) {
+                if *last != change.before { return Err(StreamControlError::Authority); }
+                *last = change.after.clone();
+                *invalidations += 1;
+            } else {
+                combined.insert(change.connection.clone(), (change.before.clone(), change.after.clone(), 1));
+            }
+        }
+        let mut epochs = match self.epochs.try_lock() {
+            Ok(value) => value,
+            Err(std::sync::TryLockError::Poisoned(error)) => error.into_inner(),
+            Err(std::sync::TryLockError::WouldBlock) => return Err(StreamControlError::MetadataBusy),
+        };
+        // Deduplicate BEFORE acquisition: two keys can share a shard, and one
+        // replacement can be represented by two operations on the same key.
+        let indices = combined.keys().map(|id| self.map.determine_map(id)).collect::<BTreeSet<_>>();
+        let mut guards = Vec::with_capacity(indices.len());
+        for index in indices {
+            let guard = self.map.shards()[index].try_write().ok_or(StreamControlError::MetadataBusy)?;
+            guards.push((index, guard));
+        }
+        let hasher = self.map.hasher().clone();
+        let mut prepared = Vec::with_capacity(combined.len());
+        let mut reserve = vec![0usize; guards.len()];
+        for (id, (before, after, invalidations)) in combined {
+            let hash = hasher.hash_one(&id);
+            let shard = self.map.determine_map(&id);
+            let position = guards.binary_search_by_key(&shard, |(index, _)| *index).expect("exact deduplicated shard");
+            let actual = guards[position].1.get(hash, |(key, _)| key == &id).map(|(_, value)| value.get().clone());
+            if actual != before { return Err(StreamControlError::Authority); }
+            if after.is_some() && actual.is_none() { reserve[position] += 1; }
+            prepared.push((id, after, invalidations, hash, position));
+        }
+        // Any allocation is before the first model/index/route publication.
+        // The already-held mutation closure below performs no lock acquisition.
+        for ((_, shard), additional) in guards.iter_mut().zip(reserve) {
+            shard.try_reserve(additional, |(key, _)| hasher.hash_one(key))
+                .map_err(|_| StreamControlError::Model(crate::stream_lifecycle::MediaTransitionError::Capacity))?;
+        }
+        Ok(BindingCommit { apply: Some(Box::new(move || {
+            for (id, after, invalidations, hash, position) in prepared {
+                if let Some(token) = epochs.get(&id).and_then(Weak::upgrade) {
+                    // Preserve the number of original per-operation epoch
+                    // invalidations even when one physical shard/key is held.
+                    for _ in 0..invalidations {
+                        let _ = token.fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| value.checked_add(1));
+                    }
+                } else { epochs.remove(&id); }
+                let shard = &mut guards[position].1;
+                match after {
+                    Some(value) => match shard.get_mut(hash, |(key, _)| key == &id) {
+                        Some((_, original)) => *original = dashmap::SharedValue::new(value),
+                        None => { shard.insert(hash, (id, dashmap::SharedValue::new(value)), |(key, _)| hasher.hash_one(key)); }
+                    },
+                    None => { shard.remove_entry(hash, |(key, _)| key == &id); }
+                }
+            }
+        })) })
+    }
+}
