+#[cfg(test)]
+mod managed_binding_commit_tests {
+    use super::*;
+    use crate::staged_streams::StreamControlError;
+    fn id(value:usize)->ConnectionId {ConnectionId::from_string(format!("compound-index-{value}"))}
+    fn pair(index:&DtmfBindingIndex,same:bool)->(ConnectionId,ConnectionId) {
+        let first=id(0);let shard=index.map.determine_map(&first);
+        let second=(1..4096).map(id).find(|candidate|(index.map.determine_map(candidate)==shard)==same).expect("bounded actual same/cross-shard keys");
+        (first,second)
+    }
+    fn changes(old:&ConnectionId,new:&ConnectionId,sid:&SessionId)->Vec<BindingChange> {
+        vec![BindingChange {connection:old.clone(),before:Some(sid.clone()),after:None},BindingChange {connection:new.clone(),before:None,after:Some(sid.clone())}]
+    }
+    #[test]
+    fn managed_binding_commit_deduplicates_actual_same_cross_shards_and_same_key() {
+        for case in ["same-shard","cross-shard","same-key"] {
+            let index=DtmfBindingIndex::default();let(old,mut new)=pair(&index,case!="cross-shard");if case=="same-key" {new=old.clone();}
+            let sid=SessionId::from_string("compound-session");index.insert(old.clone(),sid.clone());
+            let old_epoch=index.token(&old).unwrap();let new_epoch=index.token(&new).unwrap();let before=old_epoch.load(Ordering::Acquire);
+            assert_eq!(index.get(&old).map(|value|value.clone()),Some(sid.clone()));
+            let prepared=index.try_compound_change(&changes(&old,&new,&sid)).expect("deduplicated guard set must not self-Busy");
+            assert!(matches!(index.map.try_get(&old),dashmap::try_result::TryResult::Locked));
+            prepared.commit();
+            assert_eq!(index.get(&new).map(|value|value.clone()),Some(sid));
+            if old!=new {assert!(!index.contains_key(&old));assert_eq!(old_epoch.load(Ordering::Acquire),before+1);assert_eq!(new_epoch.load(Ordering::Acquire),2);}
+            else {assert_eq!(old_epoch.load(Ordering::Acquire),before+2);}
+        }
+    }
+    #[test]
+    fn managed_binding_commit_real_epoch_and_shard_exclusion_refuse_before_any_effect() {
+        let index=DtmfBindingIndex::default();let(old,new)=pair(&index,true);let sid=SessionId::from_string("busy-session");index.insert(old.clone(),sid.clone());let epoch=index.token(&old).unwrap();let before=epoch.load(Ordering::Acquire);let change=changes(&old,&new,&sid);
+        let held=index.epochs.lock().unwrap();index.try_compound_change(&[]).expect("no index effect must not acquire epochs").commit();assert!(matches!(index.try_compound_change(&change),Err(StreamControlError::MetadataBusy)));drop(held);
+        let held=index.map.shards()[index.map.determine_map(&old)].write();assert!(matches!(index.try_compound_change(&change),Err(StreamControlError::MetadataBusy)));drop(held);
+        assert_eq!(index.get(&old).map(|value|value.clone()),Some(sid));assert!(!index.contains_key(&new));assert_eq!(epoch.load(Ordering::Acquire),before);
+        index.try_compound_change(&change).unwrap().commit();assert!(!index.contains_key(&old));assert!(index.contains_key(&new));assert_eq!(epoch.load(Ordering::Acquire),before+1);
+    }
+    #[test]
+    fn managed_binding_commit_abandoned_before_effect_and_wrong_original_leave_index_and_epoch_current() {
+        let index=DtmfBindingIndex::default();let(old,new)=pair(&index,false);let sid=SessionId::from_string("cancel-session");index.insert(old.clone(),sid.clone());let epoch=index.token(&old).unwrap();let before=epoch.load(Ordering::Acquire);let change=changes(&old,&new,&sid);
+        let prepared=index.try_compound_change(&change).unwrap();drop(prepared);
+        assert_eq!(index.get(&old).map(|value|value.clone()),Some(sid.clone()));assert!(!index.contains_key(&new));assert_eq!(epoch.load(Ordering::Acquire),before);
+        let wrong=vec![BindingChange {connection:old.clone(),before:Some(SessionId::from_string("foreign-session")),after:None}];assert!(matches!(index.try_compound_change(&wrong),Err(StreamControlError::Authority)));
+        assert_eq!(index.get(&old).map(|value|value.clone()),Some(sid));assert!(!index.contains_key(&new));assert_eq!(epoch.load(Ordering::Acquire),before);
+    }
+}
