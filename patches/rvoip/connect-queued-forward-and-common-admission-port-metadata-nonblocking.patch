+                assert!(output.try_recv().is_err());
+                drop(f.policy.0.try_write().expect("metadata refusal retained a source/recipient permission"));
+                assert!(fence.clone().try_write_owned().is_err(), "test's real original fence reader died before paired retry");
+                match outcome {
+                    "source-denied" => { f.policy.0.write().await.revoked.insert("alice".into()); }
