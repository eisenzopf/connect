+    assert_eq!(admission.data().message(), expected.message());
+    assert_eq!(admission.data().operation_id(), expected.operation_id());
+    assert_eq!(admission.data().context::<Context>().unwrap().operation, "stable-operation");
+    let write = admission.begin_write().unwrap();
+    assert_eq!(write.frame().payload, expected.message().bytes);
+    drop(write);
+    assert!(admission.begin_write().is_err(), "writer used twice");
