+struct OriginalPortMetadataPolicy {
+    inner: Arc<Policy>,
+    rendezvous: Arc<Mutex<Option<(std::sync::mpsc::SyncSender<()>, std::sync::mpsc::Receiver<()>)>>>,
+    first_expiry: Arc<Mutex<Option<chrono::DateTime<chrono::Utc>>>>,
+}
+struct OriginalPortExpiringLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    until: chrono::DateTime<chrono::Utc>,
+}
+impl MediaAuthorityLease for OriginalPortExpiringLease {
+    fn authority(&self) -> &MediaOwner { self.inner.authority() }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> { Some(self.until) }
+}
+impl MediaPolicy for OriginalPortMetadataPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current(scope)
+    }
+    fn current_original_ingress(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let rendezvous = self.rendezvous.lock().unwrap().take();
+        if let Some((request, acquired)) = rendezvous {
+            request.send(()).map_err(|_| StreamControlError::MetadataBusy)?;
+            acquired.recv_timeout(Duration::from_millis(500)).map_err(|_| StreamControlError::MetadataBusy)?;
+        }
+        let lease = self.inner.current(scope)?;
+        let expiry = self.first_expiry.lock().unwrap().take();
+        match expiry {
+            Some(until) => Ok(Box::new(OriginalPortExpiringLease { inner: lease, until })),
+            None => Ok(lease),
+        }
+    }
+}
