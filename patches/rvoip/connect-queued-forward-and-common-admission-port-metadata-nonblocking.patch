+        let mut video = third.port(Medium::Video).take_egress().unwrap();
+        let messages = [message(101).with_operation_id("first-original").unwrap(),
+            message(102).with_operation_id("second-original").unwrap()];
+        for original in &messages { source.try_publish_data(original, None).unwrap(); }
+        let independent = f.ba.port(Medium::Video);
+        independent.try_publish(&frame(&independent, 19000)).unwrap();
+        let before = [calls[0].load(Ordering::Acquire), calls[1].load(Ordering::Acquire)];
+        let held = source_state.then(|| f.a.state.lock().unwrap());
+        let port_held = (!source_state).then(|| source.0.state.lock().unwrap());
+        assert!(f.a.inflight.available_permits() > 0, "public reader owns no control permit");
+        let (worker, done) = metadata_tick_worker(s.clone());
+        let completed = done.recv_timeout(Duration::from_millis(500));
+        // Release on both old-blocking and new-refused outcomes, then join the
+        // SAME original worker before inspecting or failing this control.
+        let healthy = video.try_recv();
+        drop((held, port_held));
+        worker.join().unwrap();
+        assert!(completed.is_ok(), "adopted Data source metadata blocked scene tick source_state={source_state}");
+        healthy.expect("independent video queued before exclusion released").deliver(|frame| async move {
+            assert_eq!(rvoip_rtp_core::RtpPacket::parse(&frame.payload).unwrap().header.timestamp, 19000);
+            Ok(())
+        }).await.unwrap();
+        assert!(output.try_recv().is_err());
+        assert_eq!(source.ingress_capacity().1, source.ingress_capacity().0 - 1, "second message dequeued before original retired");
+        assert_eq!(s.retained_visual_for_test(&f.a.connection, &desired(Medium::Data).logical_id), (1, 1, 0, 0));
+        assert_eq!(calls[1].load(Ordering::Acquire), before[1], "busy source gained target authorization");
+        drop(f.policy.0.try_write().expect("refusal retained message authority"));
+        // A current denial cannot gain IO or advance the original FIFO. The
+        // original reliable messages may recover only after current authority.
+        f.policy.0.write().await.revoked.insert("alice".into());
+        s.tick();
+        assert!(output.try_recv().is_err());
+        assert_eq!(source.ingress_capacity().1, source.ingress_capacity().0 - 1);
+        f.policy.0.write().await.revoked.remove("alice");
+        s.tick();
+        for original in &messages { metadata_deliver_original(&mut output, original).await; }
+        assert!(output.try_recv().is_err());
+        assert_eq!(source.ingress_capacity().1, source.ingress_capacity().0);
+        s.tick();
+        assert!(output.try_recv().is_err(), "recovery duplicated original messages");
+    }
+}
+
+struct MetadataDataPolicy {
+    inner: DataPolicy,
+    rendezvous: Arc<Mutex<Option<(std::sync::mpsc::SyncSender<()>, std::sync::mpsc::Receiver<()>)>>>,
+    source: Arc<Mutex<Weak<StreamController>>>,
+    state_was_held: Arc<AtomicUsize>,
+}
+impl MediaPolicy for MetadataDataPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current(scope)
+    }
+    fn current_data(&self, scope: &MediaScope<'_>, data: &StagedData,
+        held: Option<&(dyn Any + Send + Sync)>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if matches!(scope.purpose, MediaPurpose::Publish) {
+            let rendezvous = self.rendezvous.lock().unwrap().take();
+            if let Some((request, acquired)) = rendezvous {
+                let source = self.source.lock().unwrap().upgrade().unwrap();
+                self.state_was_held.store(usize::from(matches!(source.state.try_lock(),
+                    Err(std::sync::TryLockError::WouldBlock))), Ordering::Release);
+                request.send(()).map_err(|_| StreamControlError::Backpressure)?;
+                acquired.recv_timeout(Duration::from_millis(500)).map_err(|_| StreamControlError::Backpressure)?;
+            }
+        }
+        self.inner.current_data(scope, data, held)
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn scene_typed_data_post_lookup_metadata_races_refuse_without_detaching_current_policy_guard() {
+    // Target State after early lookup; source/target PortState after the early
+    // messages_only probe. Each lock is actually acquired by a separate owner
+    // during the SAME source policy call, never a synthetic policy-Busy error.
+    for kind in ["target-state", "source-port", "target-port"] {
+        let rendezvous = Arc::new(Mutex::new(None));
+        let source_owner = Arc::new(Mutex::new(Weak::new()));
+        let state_was_held = Arc::new(AtomicUsize::new(0));
+        let calls = Arc::new([AtomicUsize::new(0), AtomicUsize::new(0)]);
+        let f = Fixture::with_policy(8, Some(Box::new({
+            let rendezvous = rendezvous.clone(); let source = source_owner.clone();
+            let state_was_held = state_was_held.clone(); let calls = calls.clone();
+            move |base| Arc::new(MetadataDataPolicy { inner: DataPolicy(base, calls),
+                rendezvous, source, state_was_held })
+        })));
+        *source_owner.lock().unwrap() = Arc::downgrade(&f.a);
+        {
+            let mut state = f.policy.0.write().await;
+            for owner in state.owners.values_mut() {
+                for caps in [&mut owner.local, &mut owner.remote] {
+                    for direction in [&mut caps.send, &mut caps.receive] {
+                        direction.iter_mut().find(|cap| cap.medium == Medium::Data).unwrap().formats =
+                            vec![MediaFormat::ReliableOrdered(DataProtocol::Json)];
+                    }
+                }
+            }
+        }
+        f.aa.mode.store(5, Ordering::Release); f.ba.mode.store(5, Ordering::Release);
+        f.start(&[Medium::Data]).await;
+        let (s, third) = metadata_scene_with_independent_video(&f, true).await;
+        let source = f.aa.port(Medium::Data); let target = f.ba.port(Medium::Data);
+        let mut output = target.take_egress().unwrap();
+        let mut video = third.port(Medium::Video).take_egress().unwrap();
+        let original = message(201).with_operation_id("raced-original").unwrap();
+        source.try_publish_data(&original, None).unwrap();
+        let independent = f.aa.port(Medium::Video);
+        independent.try_publish(&frame(&independent, 29000)).unwrap();
+        let (request, requested) = std::sync::mpsc::sync_channel(1);
+        let (acquired, acquisition) = std::sync::mpsc::sync_channel(1);
+        let (release, released) = std::sync::mpsc::sync_channel(1);
+        *rendezvous.lock().unwrap() = Some((request, acquisition));
+        let controller = f.b.clone(); let source_port = source.0.clone(); let target_port = target.0.clone();
+        let holder = std::thread::spawn(move || {
+            if requested.recv_timeout(Duration::from_secs(2)).is_err() { return false; }
+            let state = (kind == "target-state").then(|| controller.state.lock().unwrap());
+            let source = (kind == "source-port").then(|| source_port.state.lock().unwrap());
+            let target = (kind == "target-port").then(|| target_port.state.lock().unwrap());
+            let _ = acquired.send(());
+            let released = released.recv_timeout(Duration::from_secs(2)).is_ok();
+            drop((state, source, target));
+            released
+        });
+        let (worker, done) = metadata_tick_worker(s.clone());
+        let completed = done.recv_timeout(Duration::from_millis(500));
+        let healthy = video.try_recv();
+        let _ = release.send(());
+        let holder_released = holder.join().unwrap();
+        worker.join().unwrap();
+        assert!(holder_released, "actual metadata holder was not naturally released {kind}");
+        assert!(completed.is_ok(), "post-lookup Data metadata race blocked shared tick {kind}");
+        assert_eq!(state_was_held.load(Ordering::Acquire), 1, "Data State guard detached across current_data");
+        healthy.expect("independent video progressed while actual metadata held").deliver(|frame| async move {
+            assert_eq!(rvoip_rtp_core::RtpPacket::parse(&frame.payload).unwrap().header.timestamp, 29000);
+            Ok(())
+        }).await.unwrap();
+        assert!(output.try_recv().is_err());
+        assert_eq!(s.retained_visual_for_test(&f.a.connection, &desired(Medium::Data).logical_id), (1, 1, 0, 0));
+        drop(f.policy.0.try_write().expect("post-lookup refusal retained a current policy reader"));
+        s.tick();
+        metadata_deliver_original(&mut output, &original).await;
+        s.tick(); assert!(output.try_recv().is_err(), "raced original delivered twice");
+    }
+}
