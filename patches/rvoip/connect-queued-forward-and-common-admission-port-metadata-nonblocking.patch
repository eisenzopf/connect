+// Opt-in packet-context policy: the weak context identifies one actual live
+// fence reader, never permissions. Every source/recipient still derives its
+// own current grant; the queue itself retains only the existing weak metadata.
+struct QueuedForwardRead {
+    domain: Arc<()>,
+    source: ConnectionId,
+    current: AtomicBool,
+    until: Option<chrono::DateTime<chrono::Utc>>,
+    _fence: tokio::sync::OwnedRwLockReadGuard<()>,
+}
+struct QueuedForwardLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    read: Arc<QueuedForwardRead>,
+    weak: Weak<dyn Any + Send + Sync>,
+}
+impl MediaAuthorityLease for QueuedForwardLease {
+    fn authority(&self) -> &MediaOwner { self.inner.authority() }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        match (self.read.until, self.inner.expires_at()) {
+            (Some(a), Some(b)) => Some(a.min(b)),
+            (a, b) => a.or(b),
+        }
+    }
+    fn packet_context(&self) -> Option<&(dyn Any + Send + Sync)> { Some(&self.weak) }
+}
+struct QueuedForwardPolicy {
+    inner: Arc<Policy>,
+    domain: Arc<()>,
+    active: Arc<Mutex<Weak<QueuedForwardRead>>>,
+    hook: Arc<Mutex<Option<(std::sync::mpsc::SyncSender<()>, std::sync::mpsc::Receiver<()>)>>>,
+    packet_calls: Arc<AtomicUsize>,
+}
+impl QueuedForwardPolicy {
+    fn lease(&self, scope: &MediaScope<'_>, read: Arc<QueuedForwardRead>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let erased: Arc<dyn Any + Send + Sync> = read.clone();
+        Ok(Box::new(QueuedForwardLease { inner: self.inner.current(scope)?, read,
+            weak: Arc::downgrade(&erased) }))
+    }
+}
+impl MediaPolicy for QueuedForwardPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let active = self.active.lock().unwrap().upgrade();
+        if matches!(scope.purpose, MediaPurpose::Publish) {
+            if let Some(read) = active { return self.lease(scope, read); }
+        }
+        self.inner.current(scope)
+    }
+    fn current_packet(&self, scope: &MediaScope<'_>, context: &(dyn Any + Send + Sync)) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.packet_calls.fetch_add(1, Ordering::AcqRel);
+        let read = context.downcast_ref::<Weak<dyn Any + Send + Sync>>()
+            .and_then(Weak::upgrade).and_then(|read| read.downcast::<QueuedForwardRead>().ok())
+            .ok_or(StreamControlError::Authority)?;
+        let source = match scope.purpose {
+            MediaPurpose::Publish => scope.connection,
+            MediaPurpose::Receive { source } => &source.connection,
+            _ => return Err(StreamControlError::Authority),
+        };
+        if !Arc::ptr_eq(&read.domain, &self.domain) || &read.source != source
+            || !read.current.load(Ordering::Acquire)
+        { return Err(StreamControlError::Authority); }
+        if matches!(scope.purpose, MediaPurpose::Publish) {
+            if let Some((request, acquired)) = self.hook.lock().unwrap().take() {
+                request.send(()).map_err(|_| StreamControlError::NotReady)?;
+                acquired.recv_timeout(Duration::from_millis(500)).map_err(|_| StreamControlError::NotReady)?;
+            }
+        }
+        self.lease(scope, read)
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
