+                let fence = Arc::new(RwLock::new(()));
+                let read = Arc::new(QueuedForwardRead {
+                    domain: domain.clone(), source: f.a.connection.clone(), current: AtomicBool::new(true),
+                    until: (outcome == "expired").then(|| chrono::Utc::now() + chrono::Duration::milliseconds(80)),
+                    _fence: fence.clone().try_read_owned().unwrap(),
+                });
+                *active.lock().unwrap() = Arc::downgrade(&read);
+                let original = frame(&source, 640);
+                source.try_publish(&original).unwrap();
+                let packet = receive(&mut input).await;
+                let actual = packet.custody.active().unwrap().downcast::<QueuedForwardRead>().ok().unwrap();
+                assert!(Arc::ptr_eq(&actual, &read), "source queue changed original live context identity");
+                drop(actual);
+                let before_calls = packet_calls.load(Ordering::Acquire);
+                let (request, requested) = std::sync::mpsc::sync_channel(1);
+                let (acquired, acquisition) = std::sync::mpsc::sync_channel(1);
+                let (release, released) = std::sync::mpsc::sync_channel(1);
+                let holder = if held_source {
+                    None
+                } else {
+                    // Source policy runs after early target lookup. Audio's
+                    // OrdinaryForward target is intentionally non-detached;
+                    // its later acquisition must refuse instead of waiting.
+                    *hook.lock().unwrap() = Some((request, acquisition));
+                    let target = f.b.clone();
+                    Some(std::thread::spawn(move || {
+                        if requested.recv_timeout(Duration::from_secs(2)).is_err() { return false; }
+                        let held = target.state.lock().unwrap();
+                        let _ = acquired.send(());
+                        let released = released.recv_timeout(Duration::from_secs(2)).is_ok();
+                        drop(held);
