+                let target = f.b.clone(); let target_logical = logical.clone();
+                let (returned, observed) = std::sync::mpsc::sync_channel(1);
+                let runtime = tokio::runtime::Handle::current();
+                let worker = std::thread::spawn(move || {
+                    let _entered = runtime.enter();
+                    let result = packet.try_forward_to(&target, &target_logical);
+                    let _ = returned.send(());
+                    (packet, result)
+                });
+                let completed = observed.recv_timeout(Duration::from_millis(500));
+                drop(held);
+                let _ = release.send(());
+                let holder_released = holder.map_or(true, |owner| owner.join().unwrap());
+                let (packet, refused) = worker.join().unwrap();
+                assert!(completed.is_ok() && holder_released, "actual queued forward waited on metadata {medium:?} held_source={held_source}");
+                assert!(matches!(refused, Err(StreamControlError::NotReady)), "{refused:?}");
+                assert_eq!(packet_calls.load(Ordering::Acquire) - before_calls, if held_source { 0 } else { 1 });
