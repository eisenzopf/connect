+// Actual metadata exclusion controls; these keep the ordinary strict typed
+// message policy, original operation/context, one-use writer, and Data FIFO.
+async fn metadata_scene_with_independent_video(
+    f: &Fixture, independent_from_alice: bool,
+) -> (Arc<GuardedMediaScene>, Arc<Adapter>) {
+    for controller in [&f.a, &f.b] {
+        controller.change(controller.revision(), &[desired(Medium::Data), desired(Medium::Video)],
+            &BTreeSet::new(), deadline(), CancellationToken::new()).await.unwrap();
+    }
+    let s = scene(f).await;
+    s.change_direct_subscriptions(&f.b.connection, f.b.revision(),
+        DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&f.a,
+            desired(Medium::Data).logical_id.clone(), desired(Medium::Data).logical_id)]),
+        deadline(), CancellationToken::new(), None).await.unwrap();
+    f.policy.0.write().await.owners.insert("charlie".into(), owner("charlie"));
+    let adapter = Adapter::new();
+    let third = StreamController::new(f.a.conversation.clone(), f.a.session.clone(),
+        ConnectionId::from_string("charlie"), principal("charlie"), f.a.policy.clone(),
+        adapter.clone(), f.a.handles.clone(), 8).unwrap();
+    third.change(0, &[desired(Medium::Video)], &BTreeSet::new(), deadline(), CancellationToken::new()).await.unwrap();
+    let mut member = s.prepare(third.clone()).unwrap();
+    member.quiesce(deadline(), CancellationToken::new()).await.unwrap();
+    assert!(member.ready());
+    s.insert(third.connection.clone(), member, true);
+    s.change_direct_subscriptions(&third.connection, third.revision(),
+        DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+            if independent_from_alice { &f.a } else { &f.b },
+            desired(Medium::Video).logical_id.clone(), desired(Medium::Video).logical_id)]),
+        deadline(), CancellationToken::new(), None).await.unwrap();
+    // Adopt the Data receiver BEFORE exclusion: a skipped adoption read must
+    // not hide the later forwarding of an already-owned original input.
+    s.tick();
+    (s, adapter)
+}
+fn metadata_tick_worker(s: Arc<GuardedMediaScene>) -> (
+    std::thread::JoinHandle<()>, std::sync::mpsc::Receiver<()>,
+) {
+    let runtime = tokio::runtime::Handle::current();
+    let (sent, done) = std::sync::mpsc::sync_channel(1);
+    let worker = std::thread::spawn(move || {
+        let _entered = runtime.enter();
+        s.tick();
+        let _ = sent.send(());
+    });
+    (worker, done)
+}
+async fn metadata_deliver_original(output: &mut mpsc::Receiver<QueuedMedia>, expected: &StagedData) {
+    let packet = output.try_recv().expect("same original Data packet");
