+fn context_request(
+    record: &VconRecord,
+    viewer: ParticipantId,
+    owner: VconScope,
+) -> RecordViewRequest {
+    RecordViewRequest::new(
+        owner,
+        RecordViewer::Participant {
+            participant: viewer,
+            membership_epoch: 1,
+        },
+        record.uuid(),
+        1,
+        crate::store::vcon_store::stored_content_hash(record.body()),
+        record.manifest_hash().unwrap(),
+        "view-correlation".into(),
+    )
+    .unwrap()
+}
+#[tokio::test]
+async fn context_snapshot_matches_guarded_fetch_and_never_forwards_private_or_media_urls() {
+    let (record, _, viewer, _) = fixture();
+    let owner = scope();
+    let request = context_request(&record, viewer.clone(), owner.clone());
+    let allowed = record
+        .manifest()
+        .sources()
+        .iter()
+        .map(|s| s.id().to_owned())
+        .collect();
+    let snapshot = project_context_snapshot(&record, &request, &allowed).unwrap();
+    let (current, _, _) = control(&record, owner.clone(), viewer).await;
+    let store = MemoryVconStore::new();
+    let handle = store.put(&owner, record).await.unwrap();
+    let projected =
+        RecordProjection::prepare(store.get(&owner, &handle).await.unwrap().unwrap(), current)
+            .unwrap();
+    let view = projected.view().unwrap();
+    assert_eq!(snapshot.body(), view.body);
+    assert_eq!(snapshot.content_hash(), view.content_hash);
+    assert_eq!(snapshot.valid_until(), None);
+    let text = String::from_utf8(snapshot.body().to_vec()).unwrap();
+    for secret in [
+        "private-dialog-canary",
+        "private-transcript-canary",
+        "derived-private-canary",
+        "private-attachment-canary",
+        "private-consultant-canary",
+        "https://provider.invalid/private-original-media",
+    ] {
+        assert!(!text.contains(secret), "{secret}");
+    }
+    assert!(text.contains("public-dialog"));
+    assert!(text.contains("media-reference-unavailable"));
+    assert!(!format!("{snapshot:?}").contains("public-dialog"));
+}
+#[test]
+fn context_snapshot_requires_exact_record_and_manifest_and_source_ceiling() {
+    let (record, _, viewer, _) = fixture();
+    let (other, _, _, _) = fixture();
+    let allowed = record
+        .manifest()
+        .sources()
+        .iter()
+        .map(|s| s.id().to_owned())
+        .collect();
+    let owner = scope();
+    for (body_hash, manifest_hash) in [
+        (
+            crate::store::vcon_store::stored_content_hash(other.body()),
+            record.manifest_hash().unwrap(),
+        ),
+        (
+            crate::store::vcon_store::stored_content_hash(record.body()),
+            other.manifest_hash().unwrap(),
+        ),
+    ] {
+        let request = RecordViewRequest::new(
+            owner.clone(),
+            RecordViewer::Participant {
+                participant: viewer.clone(),
+                membership_epoch: 1,
+            },
+            record.uuid(),
+            1,
+            body_hash,
+            manifest_hash,
+            "view-correlation".into(),
+        )
+        .unwrap();
+        assert!(matches!(
+            project_context_snapshot(&record, &request, &allowed),
+            Err(RecordViewError::Integrity)
+        ));
+    }
+    let request = context_request(&record, viewer, owner);
+    assert!(matches!(
+        project_context_snapshot(&record, &request, &BTreeSet::new()),
+        Err(RecordViewError::Authority)
+    ));
+    let document = record
+        .manifest()
+        .sources()
+        .iter()
+        .find(|s| s.target() == RecordTarget::Document)
+        .unwrap()
+        .id()
+        .to_owned();
+    let minimal = project_context_snapshot(&record, &request, &BTreeSet::from([document])).unwrap();
+    assert!(!String::from_utf8(minimal.body().to_vec())
+        .unwrap()
+        .contains("public-dialog"));
+    assert_ne!(
+        minimal.content_hash(),
+        project_context_snapshot(&record, &request, &allowed)
+            .unwrap()
+            .content_hash()
+    );
+}
+#[test]
+fn context_snapshot_exposes_exact_future_retention_cutoff_and_rebuilds_expired_content() {
+    let (record, _, viewer, _) = fixture();
+    let cutoff = Utc::now() + chrono::Duration::seconds(30);
+    let metadata = cutoff + chrono::Duration::seconds(30);
+    let sources = record
+        .manifest()
+        .sources()
+        .iter()
+        .cloned()
+        .map(|mut s| {
+            s.content_retention = RecordRetention::Until(cutoff);
+            s.metadata_retention = RecordRetention::Until(metadata);
+            s
+        })
+        .collect();
+    let manifest = RecordManifest::new("explicit-fixture-capture".into(), sources).unwrap();
+    let record = VconRecord::new(record.body().clone(), manifest).unwrap();
+    let request = context_request(&record, viewer.clone(), scope());
+    let allowed = record
+        .manifest()
+        .sources()
+        .iter()
+        .map(|s| s.id().to_owned())
+        .collect();
+    let snapshot = project_context_snapshot(&record, &request, &allowed).unwrap();
+    assert_eq!(snapshot.valid_until(), Some(cutoff));
+    let sources = record
+        .manifest()
+        .sources()
+        .iter()
+        .cloned()
+        .map(|mut s| {
+            s.content_retention = RecordRetention::Until(Utc::now() - chrono::Duration::seconds(1));
+            s
+        })
+        .collect();
+    let expired = VconRecord::new(
+        record.body().clone(),
+        RecordManifest::new("explicit-fixture-capture".into(), sources).unwrap(),
+    )
+    .unwrap();
+    let request = context_request(&expired, viewer, scope());
+    let next = project_context_snapshot(&expired, &request, &allowed).unwrap();
+    assert_eq!(next.valid_until(), Some(metadata));
+    assert_ne!(snapshot.content_hash(), next.content_hash());
+    assert!(!String::from_utf8(next.body().to_vec())
+        .unwrap()
+        .contains("public-dialog"));
+}
