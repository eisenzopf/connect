+// Actual source PCM is captured normally while only the original target's
+// bounded output is full. The encoder probe below consumes that exact quantum,
+// not a constructed frame or a new admission interval.
+async fn encoder_metadata_scene(pt: u8) -> (
+    Scene,
+    Vec<mpsc::OwnedPermit<QueuedMedia>>,
+    mpsc::Receiver<QueuedMedia>,
+    mpsc::Receiver<QueuedMedia>,
+) {
+    let s = Scene::new(
+        &[("a", "alice", audio(), pt), ("b", "bob", audio(), pt), ("c", "carol", audio(), pt)],
+        8000,
+    ).await;
+    for index in 0..3 { s.bind(index, true).await; }
+    let out_a = s.port(0).take_egress().unwrap();
+    let out_c = s.port(2).take_egress().unwrap();
+    let mut full = Vec::new();
+    let egress = s.port(0).0.egress.clone();
+    while let Ok(permit) = egress.clone().try_reserve_owned() { full.push(permit); }
+    s.publish(1, 900);
+    s.mixer.tick();
+    assert_eq!(s.mixer.audio_queue_state_for_test(&s.controllers[0].connection).unwrap().3, 1);
+    (s, full, out_a, out_c)
+}
