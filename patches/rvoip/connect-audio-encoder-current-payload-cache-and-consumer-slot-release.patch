+// Isolate the actual final-encoder boundary with ONE already captured target
+// quantum. The test supplies no PCM, descriptor, ticket, grant or deadline;
+// normal current admission still precedes the rendezvous, and returned output
+// must pass ordinary QueuedMedia delivery. No callback exists in shipping.
+#[cfg(test)]
+impl GuardedAudioMixer {
+    pub(in crate::staged_streams) fn encode_retained_audio_for_test(
+        &self,
+        connection: &ConnectionId,
+        before_encode: impl FnOnce(),
+    ) -> ControlResult<Option<QueuedMedia>> {
+        let mut members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let member = members.get_mut(connection).ok_or(StreamControlError::NotReady)?;
+        let Some(mut quantum) = member.target_pending.pop_front() else {
+            return Ok(None);
+        };
+        let mut phase = AudioStage::TargetPendingSourceDeferred;
+        let current = match quantum.admit(&member.controller, &mut phase) {
+            Ok(current) => current,
+            Err(problem) => {
+                if matches!(&problem, StreamControlError::NotReady | StreamControlError::MetadataBusy)
+                    && tokio::time::Instant::now() < quantum.deadline
+                    && quantum.current(&member.controller, &member.port)
+                {
+                    member.target_pending.push_front(quantum);
+                } else {
+                    // Match ordinary target output: a permanent refusal ends
+                    // the programme, never a later permission-based replay.
+                    member.target_pending.clear();
+                }
+                return Err(problem);
+            }
+        };
+        before_encode();
+        let queued = member.encode_pending(quantum, self.rate);
+        drop(current);
+        Ok(queued)
+    }
+}
