+#[tokio::test]
+async fn guarded_audio_encoder_current_payload_cache_avoids_port_wait_and_preserves_original_delivery_fences() {
+    // Exercise both the fixed PCMU payload and a negotiated dynamic PCMU PT.
+    // Every case resets the encoder on its first original contributor set.
+    for pt in [0, 96] {
+        for outcome in [0, 1, 2] {
+            let (s, full, mut out_a, mut out_c) = encoder_metadata_scene(pt).await;
+            let began = Instant::now();
+            let mixer = s.mixer.clone();
+            let connection = s.controllers[0].connection.clone();
+            let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+            let (encode_tx, encode_rx) = std::sync::mpsc::channel();
+            let (done_tx, done_rx) = std::sync::mpsc::sync_channel(1);
+            let runtime = tokio::runtime::Handle::current();
+            let worker = std::thread::spawn(move || {
+                let _runtime = runtime.enter();
+                let queued = mixer.encode_retained_audio_for_test(&connection, || {
+                    let _ = entered_tx.send(());
+                    let _ = encode_rx.recv_timeout(Duration::from_secs(3));
+                });
+                let _ = done_tx.send(());
+                queued
+            });
+            // The exact original quantum has completed ordinary source/target
+            // admission BEFORE this thread takes the real encoder PortState.
+            let entered = entered_rx.recv_timeout(Duration::from_millis(500)).is_ok();
+            let port = s.port(0).0.clone();
+            let held = entered.then(|| port.state.lock().unwrap_or_else(|p| p.into_inner()));
+            let _ = encode_tx.send(());
+            let returned_while_held = done_rx.recv_timeout(Duration::from_millis(500)).is_ok();
+            let after = returned_while_held.then(|| s.mixer.audio_queue_state_for_test(&s.controllers[0].connection).unwrap());
+            let healthy = if returned_while_held { record_healthy_audio(&mut out_c).await } else { (false, Vec::new()) };
+            let no_idle_reader = s.policy.0.try_write().is_ok();
+            let revoked = if outcome == 1 && returned_while_held {
+                match s.policy.0.try_write() {
+                    Ok(mut policy) => { policy.revoked.insert("bob".into()); true },
+                    Err(_) => false,
+                }
+            } else { outcome != 1 };
+            if outcome == 2 && returned_while_held {
+                tokio::time::sleep(Duration::from_millis(210)).await;
+            }
+            // Always release and join the SAME original worker before asserting,
+            // including the old blocking PortState encoder counterfactual.
+            drop(held);
+            let joined = worker.join();
+            assert!(entered && returned_while_held && joined.is_ok(), "final encoder waited on actual PortState");
+            let queued = joined.unwrap().unwrap().expect("original retained PCM disappeared");
+            assert!(healthy.0 && no_idle_reader && revoked);
+            assert_healthy_audio(&healthy.1, 900);
+            assert_eq!(after.unwrap().3, 0, "same quantum was not consumed exactly once");
+            assert_eq!(queued.frame.payload_type, Some(pt), "cached negotiated PT changed");
+            assert!(queued.admitted_at <= began, "encoder invented a new original admission");
+            assert!(queued.original_realtime_deadline().unwrap() <= queued.admitted_at + Duration::from_millis(200));
+            drop(full);
+            if outcome == 0 {
+                heard(queued, 900).await;
+            } else {
+                let submitted = Arc::new(AtomicBool::new(false));
+                let observed = submitted.clone();
+                let result = queued.deliver(move |_| {
+                    observed.store(true, Ordering::Release);
+                    async { Ok(()) }
+                }).await;
+                if outcome == 1 { assert!(matches!(result, Err(StreamControlError::Authority))); }
+                else { assert!(matches!(result, Err(StreamControlError::Deadline))); }
+                assert!(!submitted.load(Ordering::Acquire), "revoked/expired original reached IO");
+            }
+            s.policy.0.try_write().unwrap().revoked.clear();
+            s.mixer.tick();
+            assert!(out_a.try_recv().is_err() && out_c.try_recv().is_err(), "original PCM replayed");
+            s.publish_at(1, 1000, 160);
+            s.mixer.tick();
+            heard(out_a.try_recv().expect("fresh target audio did not recover"), 1000).await;
+            heard(out_c.try_recv().expect("healthy peer did not recover"), 1000).await;
+            s.mixer.tick();
+            assert!(out_a.try_recv().is_err() && out_c.try_recv().is_err());
+        }
+    }
+}
