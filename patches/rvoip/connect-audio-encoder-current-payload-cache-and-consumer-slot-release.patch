+#[tokio::test]
+async fn guarded_audio_port_validation_releases_consumer_slot_before_real_port_wait_with_original_flight() {
+    let (s, full, mut out_a, mut out_c) = encoder_metadata_scene(96).await;
+    let controller = s.controllers[0].clone();
+    let consumer = controller.audio_consumer.lock().unwrap().as_ref().unwrap().upgrade().unwrap();
+    let original_count = Arc::strong_count(&consumer);
+    let revision = controller.revision();
+    let port = s.port(0).clone();
+    let held = port.0.state.lock().unwrap_or_else(|p| p.into_inner());
+    let validator = controller.clone();
+    let selected = vec![PortPreparation { port: port.clone(), is_new: false }];
+    let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+    let worker = std::thread::spawn(move || {
+        let flight = validator.inflight.clone().try_acquire_owned();
+        let acquired = flight.is_ok();
+        let _ = entered_tx.send(acquired);
+        let result = validator.validate_audio_consumer_ports(&selected);
+        drop(flight);
+        result
+    });
+    let entered = entered_rx.recv_timeout(Duration::from_millis(500)).ok() == Some(true);
+    // The only additional strong owner here is the actual validator upgrade.
+    // Seeing it proves entry beyond the slot lookup and into real PortState
+    // exclusion, without sleeping or supplying a synthetic callback result.
+    let until = Instant::now() + Duration::from_millis(500);
+    while entered && Arc::strong_count(&consumer) == original_count && Instant::now() < until {
+        std::thread::yield_now();
+    }
+    let actual_validator_owner = Arc::strong_count(&consumer) == original_count + 1;
+    let same_consumer = controller.audio_consumer.try_lock().ok().is_some_and(|slot| {
+        slot.as_ref().and_then(Weak::upgrade).is_some_and(|current| Arc::ptr_eq(&current, &consumer))
+    });
+    let same_stamp = if same_consumer {
+        controller.current_consumer_stamp(&port.0).ok().flatten().is_some_and(|stamp| stamp.is_current())
+    } else { false };
+    let original_flight_held = controller.inflight.clone().try_acquire_owned().is_err();
+    let healthy = record_healthy_audio(&mut out_c).await;
+    let no_idle_reader = s.policy.0.try_write().is_ok();
+    drop(held);
+    let joined = worker.join();
+    assert!(entered && actual_validator_owner && same_consumer && same_stamp && original_flight_held, "PortState validator retained the consumer slot or changed original ownership");
+    assert!(joined.is_ok() && joined.unwrap().is_ok());
+    assert!(healthy.0 && no_idle_reader);
+    assert_healthy_audio(&healthy.1, 900);
+    assert_eq!(controller.revision(), revision, "metadata validation changed the model");
+    assert!(controller.inflight.clone().try_acquire_owned().is_ok());
+    assert_eq!(Arc::strong_count(&consumer), original_count);
+    drop(full);
+    s.mixer.tick();
+    heard(out_a.try_recv().expect("same original receiver PCM lost during validation"), 900).await;
+    s.mixer.tick();
+    assert!(out_a.try_recv().is_err() && out_c.try_recv().is_err());
+}
