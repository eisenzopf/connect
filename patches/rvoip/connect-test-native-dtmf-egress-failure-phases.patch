+/// Owned scalar observations of this original source's metadata-only polls.
+/// No snapshot is an IO grant or a coherent ordering across concurrent callers.
+#[cfg(feature = "test-support")]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeDtmfSourceStateDiagnosticsForTest {
+    /// Actual source_state results that were Ok.
+    pub ok: u64,
+    /// Actual source_state results that were NotReady.
+    pub not_ready: u64,
+    /// Actual source_state results that were Refused.
+    pub refused: u64,
+    /// Actual source_state results containing another error.
+    pub other: u64,
+    /// Last recorded tag:0=unobserved,1=Ok,2=NotReady,3=Refused,4=other.
+    pub last_tag: u8,
+}
+#[cfg(feature = "test-support")]
+#[derive(Default)]
+struct SourceStateDiagnostics {
+    ok: std::sync::atomic::AtomicU64,
+    not_ready: std::sync::atomic::AtomicU64,
+    refused: std::sync::atomic::AtomicU64,
+    other: std::sync::atomic::AtomicU64,
+    last_tag: std::sync::atomic::AtomicU8,
+}
+#[cfg(feature = "test-support")]
+impl SourceStateDiagnostics {
+    fn record(&self, result: &Result<(), rvoip_core::dtmf::DtmfWriteError>) {
+        use rvoip_core::dtmf::DtmfWriteError;
+        use std::sync::atomic::Ordering;
+        let (counter, tag) = match result {
+            Ok(()) => (&self.ok, 1),
+            Err(DtmfWriteError::NotReady) => (&self.not_ready, 2),
+            Err(DtmfWriteError::Refused) => (&self.refused, 3),
+            Err(_) => (&self.other, 4),
+        };
+        counter.fetch_add(1, Ordering::Relaxed);
+        self.last_tag.store(tag, Ordering::Release);
+    }
+    fn snapshot(&self) -> NativeDtmfSourceStateDiagnosticsForTest {
+        use std::sync::atomic::Ordering;
+        let last_tag = self.last_tag.load(Ordering::Acquire);
+        NativeDtmfSourceStateDiagnosticsForTest {
+            ok: self.ok.load(Ordering::Relaxed),
+            not_ready: self.not_ready.load(Ordering::Relaxed),
+            refused: self.refused.load(Ordering::Relaxed),
+            other: self.other.load(Ordering::Relaxed),
+            last_tag,
+        }
+    }
 }
