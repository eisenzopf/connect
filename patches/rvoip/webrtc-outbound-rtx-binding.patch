+use super::*;
+use crate::rtp_transceiver::rtp_sender::RTCRtpCodec;
+use crate::rtp_transceiver::rtp_sender::{RTCRtpCodingParameters, RTCRtpRtxParameters};
+use interceptor::{Interceptor, NoopInterceptor, StreamInfo, TaggedPacket, interceptor};
+use std::result::Result;
+use std::sync::{Arc, Mutex};
+
+#[derive(Interceptor)]
+struct Bindings<P: Interceptor> {
+    #[next]
+    inner: P,
+    records: Arc<Mutex<Vec<(bool, StreamInfo)>>>,
+}
+#[interceptor]
+impl<P: Interceptor> Bindings<P> {
+    #[overrides]
+    fn bind_local_stream(&mut self, info: &StreamInfo) {
+        self.records.lock().unwrap().push((true, info.clone()));
+        self.inner.bind_local_stream(info);
+    }
+    #[overrides]
+    fn unbind_local_stream(&mut self, info: &StreamInfo) {
+        self.records.lock().unwrap().push((false, info.clone()));
+        self.inner.unbind_local_stream(info);
+    }
+}
+fn sender<P: Interceptor>() -> RTCRtpSenderInternal<P> {
+    let primary = RTCRtpCodec {
+        mime_type: "video/VP8".into(),
+        clock_rate: 90000,
+        rtcp_feedback: vec![crate::rtp_transceiver::rtp_sender::RTCPFeedback {
+            typ: "nack".into(),
+            parameter: String::new(),
+        }],
+        ..Default::default()
+    };
+    let encoding = RTCRtpEncodingParameters {
+        rtp_coding_parameters: RTCRtpCodingParameters {
+            ssrc: Some(1001),
+            ..Default::default()
+        },
+        codec: primary.clone(),
+        ..Default::default()
+    };
+    let track = MediaStreamTrack::new(
+        "s".into(),
+        "t".into(),
+        "video".into(),
+        RtpCodecKind::Video,
+        vec![encoding.clone()],
+    );
+    let mut negotiated = encoding;
+    negotiated.rtp_coding_parameters.rtx = Some(RTCRtpRtxParameters { ssrc: 2002 });
+    let mut sender =
+        RTCRtpSenderInternal::new(RtpCodecKind::Video, track, vec![], vec![negotiated]);
+    sender.set_codec_preferences(vec![
+        RTCRtpCodecParameters {
+            payload_type: 96,
+            rtp_codec: primary,
+        },
+        RTCRtpCodecParameters {
+            payload_type: 97,
+            rtp_codec: RTCRtpCodec {
+                mime_type: "video/rtx".into(),
+                clock_rate: 90000,
+                sdp_fmtp_line: "apt=96".into(),
+                ..Default::default()
+            },
+        },
+    ]);
+    sender
+}
+fn fixture() -> (
+    RTCRtpSenderInternal<Bindings<NoopInterceptor>>,
+    Bindings<NoopInterceptor>,
+) {
+    (
+        sender(),
+        Bindings {
+            inner: NoopInterceptor::new(),
+            records: Arc::default(),
+        },
+    )
+}
+
+#[test]
+fn outbound_rtx_binding_uses_negotiated_identity_and_symmetric_stop() {
+    let (mut sender, mut chain) = fixture();
+    let media = MediaEngine::default();
+    assert!(
+        sender.track().codings()[0]
+            .rtp_coding_parameters
+            .rtx
+            .is_none()
+    );
+    sender.interceptor_local_streams_op(&media, &mut chain, true);
+    sender.set_sent();
+    sender.stop(&media, &mut chain).unwrap();
+    let records = chain.records.lock().unwrap();
+    assert_eq!(records.len(), 2);
+    assert!(records[0].0);
+    assert!(!records[1].0);
+    assert_eq!(records[0].1, records[1].1);
+    assert_eq!(
+        (
+            records[0].1.ssrc,
+            records[0].1.ssrc_rtx,
+            records[0].1.payload_type_rtx
+        ),
+        (1001, Some(2002), Some(97))
+    );
+}
+#[test]
+fn outbound_rtx_cached_offer_cannot_restore_disabled_negotiated_encoding() {
+    let (mut sender, mut chain) = fixture();
+    let media = MediaEngine::default();
+    assert_eq!(
+        sender.get_parameters(&media).encodings[0]
+            .rtp_coding_parameters
+            .rtx
+            .as_ref()
+            .unwrap()
+            .ssrc,
+        2002
+    );
+    sender.configure_rtx_and_fec(false, false);
+    assert!(
+        sender.get_parameters(&media).encodings[0]
+            .rtp_coding_parameters
+            .rtx
+            .is_none(),
+        "a cached offer must not advertise disabled RTX"
+    );
+    sender.interceptor_local_streams_op(&media, &mut chain, true);
+    sender.set_sent();
+    sender.stop(&media, &mut chain).unwrap();
+    let records = chain.records.lock().unwrap();
+    assert_eq!(records[0].1.ssrc_rtx, None);
+    assert_eq!(records[0].1, records[1].1);
+}
+
+#[test]
+fn outbound_rtx_stop_discards_cached_repairs_before_new_encoding_binds() {
+    use interceptor::{NackResponderBuilder, Packet, Registry};
+    use rtcp::transport_feedbacks::transport_layer_nack::{NackPair, TransportLayerNack};
+    use sansio::Protocol;
+    use std::time::Instant;
+    let mut chain = Registry::new()
+        .with(NackResponderBuilder::new().build())
+        .build();
+    let mut sender = sender();
+    let media = MediaEngine::default();
+    sender.interceptor_local_streams_op(&media, &mut chain, true);
+    let packet = |seq| TaggedPacket {
+        now: Instant::now(),
+        transport: Default::default(),
+        message: Packet::Rtp(rtp::Packet {
+            header: rtp::Header {
+                version: 2,
+                ssrc: 1001,
+                payload_type: 96,
+                sequence_number: seq,
+                ..Default::default()
+            },
+            payload: bytes::Bytes::from_static(&[0x10, 7]),
+        }),
+    };
+    let nack = |seq| TaggedPacket {
+        now: Instant::now(),
+        transport: Default::default(),
+        message: Packet::Rtcp(vec![Box::new(TransportLayerNack {
+            sender_ssrc: 999,
+            media_ssrc: 1001,
+            nacks: vec![NackPair {
+                packet_id: seq,
+                lost_packets: 0,
+            }],
+        })]),
+    };
+    chain.handle_write(packet(11)).unwrap();
+    chain.poll_write().unwrap();
+    chain.handle_read(nack(11)).unwrap();
+    let old = chain.poll_write().unwrap();
+    assert!(matches!(old.message, Packet::Rtp(ref p) if p.header.ssrc == 2002));
+    sender.set_sent();
+    sender.stop(&media, &mut chain).unwrap();
+    chain.handle_read(nack(11)).unwrap();
+    assert!(chain.poll_write().is_none());
+    // A replacement negotiated encoding uses its own repair identity; old history
+    // must not survive the stop/rebind boundary on the same primary SSRC.
+    sender.send_encodings[0].rtp_coding_parameters.rtx = Some(RTCRtpRtxParameters { ssrc: 3003 });
+    sender.last_returned_parameters = None;
+    sender.interceptor_local_streams_op(&media, &mut chain, true);
+    chain.handle_read(nack(11)).unwrap();
+    assert!(chain.poll_write().is_none());
+    chain.handle_write(packet(12)).unwrap();
+    chain.poll_write().unwrap();
+    chain.handle_read(nack(12)).unwrap();
+    assert!(
+        matches!(chain.poll_write().unwrap().message, Packet::Rtp(ref p) if p.header.ssrc == 3003 && p.header.payload_type == 97)
+    );
+}
