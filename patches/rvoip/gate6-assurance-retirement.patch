+#[path = "support/retirement_policy.rs"]
+mod retirement_policy;
+
+fn with_retirement_policy(f: &mut Fixture) -> Arc<retirement_policy::LifetimePolicy> {
+    let policy = retirement_policy::LifetimePolicy::new(f.policy.clone());
+    f.config = Arc::new(PeerConfig {
+        methods: f.config.methods.clone(),
+        verifier: f.config.verifier.clone(),
+        signer: f.config.signer.clone(),
+        authority: policy.clone(),
+        pending_capacity: 2,
+    });
+    policy
+}
+
+#[tokio::test]
+async fn stepup_installs_new_lifetime_without_old_credential_retiring_its_successor() {
+    let mut f = Fixture::new();
+    let policy = with_retirement_policy(&mut f);
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let h = Tracking::default();
+    let (_, challenge) = blocked(&f, &mut peer, &h).await;
+    drop(
+        peer.handle(&f.sign(proof(&challenge, "user")), &h, deadline())
+            .await
+            .unwrap(),
+    );
+    assert_eq!(peer.generation(), Some(2));
+    policy.signal("old").cancel();
+    assert!(peer.authenticated_identity().is_some());
+    assert!(peer.take_retirement_output().unwrap().is_none());
+    policy.signal("user").cancel();
+    let output = peer.take_retirement_output().unwrap().unwrap();
+    assert_eq!(
+        output.envelopes()[0].original()["payload"],
+        json!({"previous":"user-authorized","current":"anonymous","reason":"key-revoked"})
+    );
+    for e in output.envelopes() {
+        f.verify_server(e).await;
+    }
+    assert!(f.policy.revoked.try_write().is_ok());
+}
+
+#[tokio::test]
+async fn candidate_key_retirement_interrupts_held_stepup_execution_without_retiring_valid_old_binding(
+) {
+    struct Block(Arc<Notify>);
+    #[async_trait]
+    impl AuthenticatedHandler for Block {
+        async fn handle(&self, _env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+            self.0.notify_one();
+            std::future::pending().await
+        }
+    }
+    let mut f = Fixture::new();
+    let policy = with_retirement_policy(&mut f);
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let (_, challenge) = blocked(&f, &mut peer, &Tracking::default()).await;
+    let wire = f.sign(proof(&challenge, "user"));
+    let entered = Arc::new(Notify::new());
+    let h = Block(entered.clone());
+    {
+        let work = peer.handle(&wire, &h, deadline());
+        tokio::pin!(work);
+        tokio::select! {result=&mut work=>panic!("early {result:?}"),_=entered.notified()=>{}}
+        policy.signal("user").cancel();
+        assert_eq!(work.await.unwrap_err(), DispatchError::Authority);
+    }
+    assert_eq!(peer.generation(), Some(1));
+    assert!(peer.authenticated_identity().is_some());
+    assert!(!peer.has_pending_step_up());
+    assert!(peer.take_retirement_output().unwrap().is_none());
+    let failures = peer.drain_step_up_failures().unwrap().unwrap();
+    assert_eq!(
+        failures.envelopes()[0].original()["payload"]["reason"],
+        "operation_interrupted"
+    );
+    assert_eq!(
+        failures.envelopes()[0].original()["payload"]["details"]["outcome"],
+        "unknown"
+    );
+    drop(failures);
+    assert!(f.policy.revoked.try_write().is_ok());
+}
