+#[tokio::test]
+async fn revocation_interrupts_owned_handler_releases_guard_and_preserves_unrelated_peer() {
+    struct Block {
+        entered: Arc<Notify>,
+        dropped: Arc<AtomicBool>,
+    }
+    struct OnDrop(Arc<AtomicBool>);
+    impl Drop for OnDrop {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::SeqCst);
+        }
+    }
+    #[async_trait]
+    impl AuthenticatedHandler for Block {
+        async fn handle(&self, _env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+            let _drop = OnDrop(self.dropped.clone());
+            self.entered.notify_one();
+            std::future::pending().await
+        }
+    }
+    let mut f = Fixture::new();
+    let policy = install(&mut f);
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let mut other = f.peer();
+    f.authenticate(&mut other, "other").await;
+    let token = peer.cancellation();
+    let entered = Arc::new(Notify::new());
+    let dropped = Arc::new(AtomicBool::new(false));
+    let h = Block {
+        entered: entered.clone(),
+        dropped: dropped.clone(),
+    };
+    let wire = f.sign(command());
+    let work = async { peer.handle(&wire, &h, deadline()).await };
+    tokio::pin!(work);
+    tokio::select! {result=&mut work=>panic!("early {result:?}"),_=entered.notified()=>{}}
+    policy.signal("old").cancel();
+    assert_eq!(work.await.unwrap_err(), DispatchError::Authority);
+    assert!(dropped.load(Ordering::SeqCst));
+    assert!(token.is_cancelled());
+    assert!(!other.cancellation().is_cancelled());
+    assert!(f.policy.revoked.try_write().is_ok());
+    drop(
+        other
+            .handle(&f.sign(command()), &Handler::default(), deadline())
+            .await
+            .unwrap(),
+    );
+}
