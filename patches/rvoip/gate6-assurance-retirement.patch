+    let mut lifetime = AuthorityLifetime::new(root.clone(), RetirementReason::IdentityRevoked)
+        .with_signal(key.clone(), RetirementReason::SigningKeyRevoked)
+        .unwrap();
+    for _ in 2..8 {
+        lifetime = lifetime
+            .with_signal(
+                CancellationToken::new(),
+                RetirementReason::CredentialRevoked,
+            )
+            .unwrap();
+    }
+    assert!(matches!(
+        lifetime
+            .clone()
+            .with_signal(CancellationToken::new(), RetirementReason::DeviceRevoked),
+        Err(DispatchError::Capacity)
+    ));
+    key.cancel();
+    assert_eq!(
+        lifetime.retired().await,
+        RetirementReason::SigningKeyRevoked
+    );
+    assert_eq!(lifetime.reason(), Some(RetirementReason::SigningKeyRevoked));
+    drop(lifetime);
+    assert!(!root.is_cancelled());
+}
