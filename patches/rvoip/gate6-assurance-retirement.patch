@@ -0,0 +1,190 @@
+//! Current credential-incarnation retirement. These policy signals carry no
+//! resource grants and cannot establish a replacement or lower assurance.
+use super::*;
+use futures::{stream::FuturesUnordered, FutureExt};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RetirementReason {
+    CredentialExpired,
+    DelegationExpired,
+    SigningKeyRevoked,
+    CredentialRevoked,
+    DelegationRevoked,
+    DeviceRevoked,
+    IdentityRevoked,
+    AuthorityRetired,
+}
+impl RetirementReason {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::CredentialExpired => "credential-expired",
+            Self::DelegationExpired => "delegation-expired",
+            Self::SigningKeyRevoked => "key-revoked",
+            Self::CredentialRevoked => "credential-revoked",
+            Self::DelegationRevoked => "delegation-revoked",
+            Self::DeviceRevoked => "device-revoked",
+            Self::IdentityRevoked => "identity-revoked",
+            Self::AuthorityRetired => "authority-retired",
+        }
+    }
+    fn expired(self) -> bool {
+        matches!(self, Self::CredentialExpired | Self::DelegationExpired)
+    }
+    pub(super) fn error(self) -> DispatchError {
+        if self.expired() {
+            DispatchError::Closed
+        } else {
+            DispatchError::Authority
+        }
+    }
+}
+
+/// Required installed-policy lifetime for one validated credential, Identity
+/// and Device incarnation. The policy registers these signals synchronously
+/// under the supplied current lease, without reacquiring its authority lock.
+/// Owners must cancel them when the named fact is invalidated. They must not
+/// reuse a successor's credential signal for old work or cancel a shared parent
+/// endpoint. The peer observes cancellation; it never cancels policy signals.
+#[derive(Clone)]
+pub struct AuthorityLifetime {
+    signals: Vec<(CancellationToken, RetirementReason)>,
+}
+impl AuthorityLifetime {
+    pub fn new(signal: CancellationToken, reason: RetirementReason) -> Self {
+        Self {
+            signals: vec![(signal, reason)],
+        }
+    }
+    /// At most eight independently owned facts. If several are already retired,
+    /// installation order selects one true cause; no untrusted reason is echoed.
+    pub fn with_signal(
+        mut self,
+        signal: CancellationToken,
+        reason: RetirementReason,
+    ) -> Result<Self, DispatchError> {
+        if self.signals.len() >= 8 {
+            return Err(DispatchError::Capacity);
+        }
+        self.signals.push((signal, reason));
+        Ok(self)
+    }
+    pub fn reason(&self) -> Option<RetirementReason> {
+        self.signals
+            .iter()
+            .find_map(|(signal, reason)| signal.is_cancelled().then_some(*reason))
+    }
+    pub async fn retired(&self) -> RetirementReason {
+        if let Some(reason) = self.reason() {
+            return reason;
+        }
+        let mut waits = self
+            .signals
+            .iter()
+            .map(|(signal, reason)| {
+                let signal = signal.clone();
+                let reason = *reason;
+                async move {
+                    signal.cancelled().await;
+                    reason
+                }
+                .boxed()
+            })
+            .collect::<FuturesUnordered<_>>();
+        // Construction always installs at least one signal.
+        let reason = waits.next().await.expect("nonempty authority lifetime");
+        self.reason().unwrap_or(reason)
+    }
+}
+impl fmt::Debug for AuthorityLifetime {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AuthorityLifetime")
+            .field("signals", &self.signals.len())
+            .finish_non_exhaustive()
+    }
+}
+
+#[derive(Clone)]
+pub(super) struct RetirementRecord {
+    pub previous: String,
+    pub reason: RetirementReason,
+}
+pub(super) fn effective_expiry_for_snapshot(
+    principal: &AuthenticatedPrincipal,
+) -> Option<chrono::DateTime<chrono::Utc>> {
+    effective_expiry(principal).ok()
+}
+pub(super) fn expiry_reason(principal: &AuthenticatedPrincipal) -> RetirementReason {
+    match &principal.assurance {
+        IdentityAssurance::TaskScoped { expires_at, .. }
+            if principal
+                .expires_at
+                .is_none_or(|credential| *expires_at <= credential) =>
+        {
+            RetirementReason::DelegationExpired
+        }
+        _ => RetirementReason::CredentialExpired,
+    }
+}
+pub(super) fn terminal_output(
+    config: &PeerConfig,
+    record: RetirementRecord,
+) -> Result<PeerOutput, DispatchError> {
+    // The entire authenticated physical binding is retired. Anonymous denotes
+    // absence of an authenticated binding, never permission to keep executing.
+    // No Conversation/Session/Connection is invented from untrusted input.
+    let changed = exchange::signed(
+        config,
+        json!({"v":2,"type":"identity.assurance-changed","id":fresh_id(),"ts":chrono::Utc::now(),"payload":{"previous":record.previous,"current":"anonymous","reason":record.reason.as_str()}}),
+    )?;
+    let bye = exchange::signed(
+        config,
+        json!({"v":2,"type":"auth.bye","id":fresh_id(),"ts":chrono::Utc::now(),"payload":{"reason":if record.reason.expired(){"session-expired"}else{"authority-retired"}}}),
+    )?;
+    Ok(output(vec![changed, bye], None))
+}
+
+impl CanonicalPeer {
+    pub(super) fn current_retirement(&self) -> Option<RetirementRecord> {
+        let State::Authenticated(binding) = &self.state else {
+            return None;
+        };
+        let reason = binding
+            .authority_lifetime
+            .reason()
+            .or_else(|| {
+                binding
+                    .route
+                    .as_ref()
+                    .filter(|route| route.authority().is_cancelled())
+                    .map(|_| RetirementReason::AuthorityRetired)
+            })
+            .or_else(|| {
+                (binding.expires <= Instant::now()
+                    || effective_expiry(&binding.credential.principal)
+                        .is_ok_and(|expiry| expiry <= chrono::Utc::now()))
+                .then(|| expiry_reason(&binding.credential.principal))
+            })?;
+        Some(RetirementRecord {
+            previous: binding.credential.principal.assurance.kind().into(),
+            reason,
+        })
+    }
+    pub(super) fn poll_retirement(&mut self) -> Option<DispatchError> {
+        let record = self.current_retirement()?;
+        let error = record.reason.error();
+        self.retirement = Some(record);
+        self.close();
+        Some(error)
+    }
+    /// Direct `handle` integrations must drive their policy/expiry lifecycle and
+    /// retain this one-use, signed terminal output through bounded writer
+    /// admission. `run`/`run_frames` do that automatically. This returns an
+    /// observation, not a result for any interrupted business operation.
+    pub fn take_retirement_output(&mut self) -> Result<Option<PeerOutput>, DispatchError> {
+        self.poll_retirement();
+        self.retirement
+            .take()
+            .map(|record| terminal_output(&self.config, record))
+            .transpose()
+    }
+}
