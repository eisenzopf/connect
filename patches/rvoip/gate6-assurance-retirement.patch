@@ -0,0 +1,124 @@
+//! Controlled current policy with exact credential-incarnation signals.
+use super::*;
+use std::{collections::HashMap, sync::Mutex};
+struct Proof {
+    _base: AuthorityLease,
+    domain: Arc<()>,
+    token: Option<String>,
+    device: Identifier,
+    identity: Identifier,
+    lifetime: AuthorityLifetime,
+}
+pub(super) struct LifetimePolicy {
+    base: Arc<dyn PeerAuthority>,
+    domain: Arc<()>,
+    signals: Mutex<HashMap<String, CancellationToken>>,
+}
+impl LifetimePolicy {
+    pub(super) fn new(base: Arc<dyn PeerAuthority>) -> Arc<Self> {
+        Arc::new(Self {
+            base,
+            domain: Arc::new(()),
+            signals: Mutex::new(HashMap::new()),
+        })
+    }
+    pub(super) fn signal(&self, token: &str) -> CancellationToken {
+        self.signals
+            .lock()
+            .unwrap()
+            .entry(token.into())
+            .or_default()
+            .clone()
+    }
+    fn wrap(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        base: AuthorityLease,
+    ) -> AuthorityLease {
+        let token = c.token_id.as_deref().unwrap();
+        AuthorityLease::holding(Proof {
+            _base: base,
+            domain: self.domain.clone(),
+            token: c.token_id.clone(),
+            device: d.id.clone(),
+            identity: i.clone(),
+            lifetime: AuthorityLifetime::new(
+                self.signal(token),
+                RetirementReason::SigningKeyRevoked,
+            ),
+        })
+    }
+}
+#[async_trait]
+impl PeerAuthority for LifetimePolicy {
+    fn assurance_requirement(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<Option<AssuranceRequirement>, DispatchError> {
+        self.base.assurance_requirement(c, d, i, e)
+    }
+    async fn step_up(
+        &self,
+        old: &ValidatedBearer,
+        next: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        r: &AssuranceRequirement,
+        blocked: &Envelope,
+        response: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Ok(self.wrap(
+            next,
+            d,
+            i,
+            self.base
+                .step_up(old, next, d, i, r, blocked, response)
+                .await?,
+        ))
+    }
+
+    fn authority_lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        held: &AuthorityLease,
+    ) -> Result<AuthorityLifetime, DispatchError> {
+        let proof = held.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if !Arc::ptr_eq(&proof.domain, &self.domain)
+            || proof.token != c.token_id
+            || proof.device != d.id
+            || &proof.identity != i
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(proof.lifetime.clone())
+    }
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Ok(self.wrap(c, d, i, self.base.acquire(c, d, i, e).await?))
+    }
+    async fn refresh(
+        &self,
+        old: &ValidatedBearer,
+        next: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Ok(self.wrap(next, d, i, self.base.refresh(old, next, d, i, e).await?))
+    }
+}
