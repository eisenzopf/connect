@@ -0,0 +1,329 @@
+//! Exact credential lifecycle signals under the real current grant guard.
+use super::*;
+
+#[path = "retirement_policy.rs"]
+mod policy;
+use policy::LifetimePolicy;
+fn install(f: &mut Fixture) -> Arc<LifetimePolicy> {
+    let policy = LifetimePolicy::new(f.policy.clone());
+    f.config = Arc::new(PeerConfig {
+        methods: f.config.methods.clone(),
+        verifier: f.config.verifier.clone(),
+        signer: f.config.signer.clone(),
+        authority: policy.clone(),
+        pending_capacity: 2,
+    });
+    policy
+}
+fn check_terminal(output: &PeerOutput, previous: &str, reason: &str) {
+    assert_eq!(output.envelopes().len(), 2);
+    let changed = &output.envelopes()[0];
+    assert_eq!(changed.kind(), "identity.assurance-changed");
+    assert_eq!(
+        changed.original()["payload"],
+        json!({"previous":previous,"current":"anonymous","reason":reason})
+    );
+    assert_eq!(output.envelopes()[1].kind(), "auth.bye");
+    for envelope in output.envelopes() {
+        for scope in [
+            Scope::Conversation,
+            Scope::Session,
+            Scope::Connection,
+            Scope::Operation,
+            Scope::Reply,
+        ] {
+            assert!(envelope.scope(scope).is_none());
+        }
+    }
+}
+
+#[tokio::test]
+async fn retired_current_key_denies_direct_control_and_emits_one_signed_terminal_transition() {
+    let mut f = Fixture::new();
+    let policy = install(&mut f);
+    let parent = CancellationToken::new();
+    let mut peer = CanonicalPeer::new(f.config.clone(), parent.clone()).unwrap();
+    f.authenticate(&mut peer, "old").await;
+    let h = Handler::default();
+    policy.signal("old").cancel();
+    assert!(peer.authenticated_identity().is_none());
+    assert!(peer
+        .register_reply(&Envelope::from_value(command()).unwrap(), deadline())
+        .is_err());
+    assert_eq!(
+        peer.handle(&f.sign(command()), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::Authority
+    );
+    assert_eq!(h.calls.load(Ordering::SeqCst), 0);
+    let output = peer.take_retirement_output().unwrap().unwrap();
+    check_terminal(&output, "identified", "key-revoked");
+    for e in output.envelopes() {
+        f.verify_server(e).await;
+    }
+    assert!(peer.take_retirement_output().unwrap().is_none());
+    assert!(peer.cancellation().is_cancelled());
+    assert!(!parent.is_cancelled());
+    assert!(f.policy.revoked.try_write().is_ok());
+}
+
+#[tokio::test]
+async fn old_credential_signal_cannot_retire_refreshed_binding_and_failed_candidate_keeps_old_live()
+{
+    let mut f = Fixture::new();
+    let policy = install(&mut f);
