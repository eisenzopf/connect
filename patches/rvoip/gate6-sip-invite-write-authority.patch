diff --git a/crates/sip/sip-dialog/src/manager/transaction_integration.rs b/crates/sip/sip-dialog/src/manager/transaction_integration.rs
--- a/crates/sip/sip-dialog/src/manager/transaction_integration.rs
+++ b/crates/sip/sip-dialog/src/manager/transaction_integration.rs
@@ -33,6 +33,50 @@
 use std::sync::Arc;
 use std::time::{Duration, Instant};
 use tracing::{debug, error, info, warn};
+
+// The application policy owns INVITE submission permission. Generated non-2xx
+// ACKs complete the already admitted transaction and do not originate a call.
+// The monotonic bit records polling the exact transport future, not queue entry.
+struct InitialInviteWritePolicy {
+    authority: Arc<dyn crate::transaction::egress::ClientRequestWriteAuthority>,
+    attempted: Arc<std::sync::atomic::AtomicBool>,
+    refused: Arc<std::sync::atomic::AtomicBool>,
+}
+#[async_trait::async_trait]
+impl crate::transaction::egress::ClientRequestWriteAuthority for InitialInviteWritePolicy {
+    async fn write(
+        &self,
+        scope: &crate::transaction::egress::ClientRequestWriteScope<'_>,
+        io: crate::transaction::egress::ClientRequestWriteFuture<'_>,
+    ) -> rvoip_sip_transport::Result<rvoip_sip_transport::TransportRoute> {
+        match scope.message {
+            rvoip_sip_core::Message::Request(request) if request.method() == Method::Invite => {
+                let result = self
+                    .authority
+                    .write(
+                        scope,
+                        Box::pin(async {
+                            self.attempted.store(true, Ordering::Release);
+                            io.await
+                        }),
+                    )
+                    .await;
