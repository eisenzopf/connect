diff --git a/crates/sip/rvoip-sip/tests/guarded_invite_submission.rs b/crates/sip/rvoip-sip/tests/guarded_invite_submission.rs
new file mode 100644
--- /dev/null
+++ b/crates/sip/rvoip-sip/tests/guarded_invite_submission.rs
@@ -0,0 +1,356 @@
+//! Actual UDP INVITE writes through the shared current-authority transaction seam.
+use async_trait::async_trait;
+use rvoip_sip::{types::Credentials, Config, SipClientAuth, UnifiedCoordinator};
+use rvoip_sip_core::{
+    parser::parse_message,
+    prelude::{HeaderName, Message, Method, StatusCode, TypedHeader},
+    types::header::HeaderValue,
+};
+use rvoip_sip_dialog::transaction::{egress::*, utils::response_builders::create_response};
+use std::{
+    net::SocketAddr,
+    sync::{
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        Arc, Mutex,
+    },
+    time::Duration,
+};
+use tokio::{net::UdpSocket, sync::Notify};
+
+struct Policy {
+    target: SocketAddr,
+    allowed: Arc<AtomicBool>,
+    calls: AtomicUsize,
+    readers: Arc<AtomicUsize>,
+    authenticated: AtomicUsize,
+    lose_receipt: bool,
+    entered: Notify,
+    release: Option<Arc<Notify>>,
+}
+struct Reader(Arc<AtomicUsize>);
+impl Drop for Reader {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+#[async_trait]
+impl ClientRequestWriteAuthority for Policy {
+    async fn write(
+        &self,
+        scope: &ClientRequestWriteScope<'_>,
+        io: ClientRequestWriteFuture<'_>,
+    ) -> rvoip_sip_transport::Result<rvoip_sip_transport::TransportRoute> {
+        assert!(matches!(scope.message, Message::Request(r) if r.method() == Method::Invite));
+        if let Message::Request(request) = scope.message {
+            if request
+                .headers
+                .iter()
+                .any(|h| h.name() == HeaderName::Authorization)
+            {
+                self.authenticated.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let ordinal = self.calls.fetch_add(1, Ordering::SeqCst);
+        self.entered.notify_one();
+        if ordinal == 0 {
+            if let Some(release) = &self.release {
+                release.notified().await;
+            }
+        }
+        if !self.allowed.load(Ordering::SeqCst)
+            || scope.route.destination != self.target
+            || !matches!(scope.message, Message::Request(r) if r.method()==Method::Invite)
+        {
+            return Err(rvoip_sip_transport::Error::InvalidState(
+                "fixture INVITE authority refused".into(),
+            ));
+        }
+        self.readers.fetch_add(1, Ordering::SeqCst);
+        let _reader = Reader(self.readers.clone());
+        let route = io.await?;
+        if self.lose_receipt {
+            Err(rvoip_sip_transport::Error::InvalidState(
+                "fixture lost write receipt after IO".into(),
+            ))
+        } else {
+            Ok(route)
+        }
+    }
+}
+struct Peer {
+    address: SocketAddr,
+    invites: Arc<AtomicUsize>,
+    acknowledged: Arc<AtomicUsize>,
+    methods: Arc<Mutex<Vec<Method>>>,
+    task: tokio::task::JoinHandle<()>,
+}
+impl Peer {
+    async fn new(challenge: bool, allowed: Arc<AtomicBool>) -> Self {
+        let socket = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let address = socket.local_addr().unwrap();
+        let invites = Arc::new(AtomicUsize::new(0));
+        let methods = Arc::new(Mutex::new(Vec::new()));
+        let acknowledged = Arc::new(AtomicUsize::new(0));
+        let seen_acks = acknowledged.clone();
+        let seen = invites.clone();
+        let seen_methods = methods.clone();
+        let task = tokio::spawn(async move {
+            let mut bytes = vec![0u8; 16384];
+            let mut original = None;
+            loop {
+                let Ok((n, from)) = socket.recv_from(&mut bytes).await else {
+                    break;
+                };
+                let Ok(Message::Request(request)) = parse_message(&bytes[..n]) else {
+                    continue;
+                };
+                seen_methods.lock().unwrap().push(request.method());
+                match request.method() {
+                    Method::Invite => {
+                        let first = seen.fetch_add(1, Ordering::SeqCst) == 0;
+                        if first {
+                            original = Some(request.clone());
+                            if challenge {
+                                // Revoke before the 401 can trigger its automatic retry.
+                                allowed.store(false, Ordering::SeqCst);
+                                let mut response =
+                                    create_response(&request, StatusCode::Unauthorized);
+                                if let Some(TypedHeader::To(to)) = response
+                                    .headers
+                                    .iter_mut()
+                                    .find(|h| matches!(h, TypedHeader::To(_)))
+                                {
+                                    to.set_tag("invite-auth-fixture");
+                                }
+                                response.headers.push(TypedHeader::Other(HeaderName::WwwAuthenticate,HeaderValue::Raw(
+                                    br#"Digest realm="fixture", nonce="invite-test", algorithm=MD5, qop="auth""#.to_vec())));
+                                socket
+                                    .send_to(&Message::Response(response).to_bytes(), from)
+                                    .await
+                                    .unwrap();
+                            }
+                        }
+                    }
+                    Method::Ack => {
+                        let original = original
+                            .as_ref()
+                            .expect("ACK must follow this peer's INVITE");
+                        assert_eq!(
+                            request.call_id().unwrap().value(),
+                            original.call_id().unwrap().value()
+                        );
+                        assert_eq!(request.cseq().unwrap().seq, original.cseq().unwrap().seq);
+                        seen_acks.fetch_add(1, Ordering::SeqCst);
+                    }
+                    Method::Cancel => {
+                        socket
+                            .send_to(
+                                &Message::Response(create_response(&request, StatusCode::Ok))
+                                    .to_bytes(),
+                                from,
+                            )
+                            .await
+                            .unwrap();
+                        if let Some(invite) = &original {
+                            socket
+                                .send_to(
+                                    &Message::Response(create_response(
+                                        invite,
+                                        StatusCode::RequestTerminated,
+                                    ))
+                                    .to_bytes(),
+                                    from,
+                                )
+                                .await
+                                .unwrap();
+                        }
+                    }
+                    Method::Bye => {
+                        socket
+                            .send_to(
+                                &Message::Response(create_response(&request, StatusCode::Ok))
+                                    .to_bytes(),
+                                from,
+                            )
+                            .await
+                            .unwrap();
+                    }
+                    _ => {}
+                }
+            }
+        });
+        Self {
+            address,
+            invites,
+            acknowledged,
+            methods,
+            task,
+        }
+    }
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+async fn until(predicate: impl Fn() -> bool) {
+    tokio::time::timeout(Duration::from_secs(4), async {
+        while !predicate() {
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .unwrap();
+}
+fn policy(peer: &Peer, allowed: Arc<AtomicBool>, release: Option<Arc<Notify>>) -> Arc<Policy> {
+    Arc::new(Policy {
+        target: peer.address,
+        allowed,
+        calls: AtomicUsize::new(0),
+        authenticated: AtomicUsize::new(0),
+        lose_receipt: false,
+        readers: Arc::new(AtomicUsize::new(0)),
+        entered: Notify::new(),
+        release,
+    })
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn queued_invite_rechecks_before_physical_io_and_holds_no_idle_reader() {
+    let allowed = Arc::new(AtomicBool::new(true));
+    let peer = Peer::new(false, allowed.clone()).await;
+    let release = Arc::new(Notify::new());
+    let policy = policy(&peer, allowed.clone(), Some(release.clone()));
+    let coordinator = UnifiedCoordinator::new(Config::local("queued-invite", 0))
+        .await
+        .unwrap();
+    let send = tokio::spawn({
+        let c = coordinator.clone();
+        let p = policy.clone();
+        let address = peer.address;
+        async move {
+            c.invite(None, format!("sip:target@{address}"))
+                .with_request_write_authority(p)
+                .send()
+                .await
+        }
+    });
+    policy.entered.notified().await;
+    assert_eq!(policy.readers.load(Ordering::SeqCst), 0);
+    assert!(peer.methods.lock().unwrap().is_empty());
+    allowed.store(false, Ordering::SeqCst);
+    release.notify_one();
+    assert!(tokio::time::timeout(Duration::from_secs(5), send)
+        .await
+        .unwrap()
+        .unwrap()
+        .is_err());
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert!(
+        peer.methods.lock().unwrap().is_empty(),
+        "refused initial request caused wire traffic"
+    );
+    assert_eq!(policy.readers.load(Ordering::SeqCst), 0);
+    coordinator
+        .shutdown_gracefully(Some(Duration::from_secs(3)))
+        .await
+        .unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn invite_retransmission_reacquires_permission_without_a_reader_during_ringing() {
+    let allowed = Arc::new(AtomicBool::new(true));
+    let peer = Peer::new(false, allowed.clone()).await;
+    let policy = policy(&peer, allowed.clone(), None);
+    let coordinator = UnifiedCoordinator::new(Config::local("invite-retry", 0))
+        .await
+        .unwrap();
+    coordinator
+        .invite(None, format!("sip:target@{}", peer.address))
+        .with_request_write_authority(policy.clone())
+        .send()
+        .await
+        .unwrap();
+    until(|| peer.invites.load(Ordering::SeqCst) == 1).await;
+    until(|| policy.readers.load(Ordering::SeqCst) == 0).await;
+    allowed.store(false, Ordering::SeqCst);
+    until(|| policy.calls.load(Ordering::SeqCst) >= 2).await;
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert_eq!(peer.invites.load(Ordering::SeqCst), 1);
+    assert_eq!(policy.readers.load(Ordering::SeqCst), 0);
+    coordinator
+        .shutdown_gracefully(Some(Duration::from_secs(3)))
+        .await
+        .unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn authenticated_initial_invite_retry_retains_the_same_current_write_policy() {
+    let _ = tracing_subscriber::fmt()
+        .with_env_filter("rvoip_sip=trace,rvoip_sip_dialog=trace")
+        .with_test_writer()
+        .try_init();
+    let allowed = Arc::new(AtomicBool::new(true));
+    let peer = Peer::new(true, allowed.clone()).await;
+    let policy = policy(&peer, allowed, None);
+    let coordinator = UnifiedCoordinator::new(Config::local("invite-auth", 0))
+        .await
+        .unwrap();
+    coordinator
+        .invite(None, format!("sip:target@{}", peer.address))
+        .with_auth(SipClientAuth::Digest(Credentials {
+            username: "fixture".into(),
+            password: "fixture-only".into(),
+            realm: Some("fixture".into()),
+        }))
+        .with_request_write_authority(policy.clone())
+        .send()
+        .await
+        .unwrap();
+    until(|| policy.authenticated.load(Ordering::SeqCst) >= 1).await;
+    assert!(policy.calls.load(Ordering::SeqCst) >= 2);
+    assert_eq!(
+        peer.invites.load(Ordering::SeqCst),
+        1,
+        "auth retry bypassed the installed policy"
+    );
+    assert_eq!(policy.readers.load(Ordering::SeqCst), 0);
+    coordinator
+        .shutdown_gracefully(Some(Duration::from_secs(3)))
+        .await
+        .unwrap();
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn invite_lost_write_receipt_retains_uncertainty_and_cancels_the_actual_call() {
+    let _ = tracing_subscriber::fmt()
+        .with_env_filter("rvoip_sip=trace,rvoip_sip_dialog=trace")
+        .with_test_writer()
+        .try_init();
+    let allowed = Arc::new(AtomicBool::new(true));
+    let peer = Peer::new(false, allowed.clone()).await;
+    let mut policy = policy(&peer, allowed, None);
+    Arc::get_mut(&mut policy).unwrap().lose_receipt = true;
+    let coordinator = UnifiedCoordinator::new(Config::local("invite-unknown", 0))
+        .await
+        .unwrap();
+    assert!(tokio::time::timeout(
+        Duration::from_secs(5),
+        coordinator
+            .invite(None, format!("sip:target@{}", peer.address))
+            .with_request_write_authority(policy.clone())
+            .send()
+    )
+    .await
+    .unwrap()
+    .is_err());
+    until(|| peer.invites.load(Ordering::SeqCst) == 1).await;
+    until(|| peer.methods.lock().unwrap().contains(&Method::Cancel)).await;
+    until(|| peer.acknowledged.load(Ordering::SeqCst) >= 1).await;
+    assert_eq!(peer.invites.load(Ordering::SeqCst), 1);
+    assert_eq!(policy.readers.load(Ordering::SeqCst), 0);
+    coordinator
+        .shutdown_gracefully(Some(Duration::from_secs(3)))
+        .await
+        .unwrap();
+}
