+
+// Exercise the public SIP originate context through Core's real dormant route.
+struct RefuseInvite;
+#[async_trait::async_trait]
+impl rvoip_sip_dialog::transaction::egress::ClientRequestWriteAuthority for RefuseInvite {}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_sip_replacement_refused_invite_authority_keeps_original_audio_and_zero_wire() {
+    let s = Scene::new_replacement("quic").await;
+    let peer = Peer::new(true).await;
+    let policy = Arc::new(RefuseInvite);
+    let c = Candidate::new_with_options(
+        &s,
+        &peer,
+        None,
+        "5",
+        SipOriginateContext::default().with_request_write_authority(policy.clone()),
+    )
+    .await;
+    let g = grant(&s, c.pending.intent(), &c.principal, Approval::Start).await;
+    assert!(tokio::time::timeout(
+        Duration::from_secs(5),
+        s.core
+            .orch
+            .start_adapter_device_replacement_with_held(&c.pending, &g)
+    )
+    .await
+    .unwrap()
+    .is_err());
+    drop(g);
+    assert!(peer.methods.lock().unwrap().is_empty());
+    assert_eq!(peer.calls(), 0);
+    c.stop(&peer, None).await;
+    assert_eq!(c.coordinator.allocated_media_port_count().await, 0);
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    s.stop().await;
+}
