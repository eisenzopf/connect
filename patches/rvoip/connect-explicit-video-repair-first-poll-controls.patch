+#[tokio::test]
+async fn explicit_repair_later_request_cannot_restore_revoked_or_expired_original() {
+    use futures::FutureExt as _;
+    for action in ["source", "target", "audience", "source-gate", "target-gate", "cancel", "age"] {
+        let (f, armed, busy) = fixture(Medium::Video).await;
+        let work = std::panic::AssertUnwindSafe(async {
+            let repair = retained(&f).await;
+            armed.store(true, Ordering::Release);
+            let mut pending = Box::pin(repair.repair(|_, _| async { panic!("busy repair entered IO") }));
+            let first = std::future::poll_fn(|cx| Poll::Ready(pending.as_mut().poll(cx))).await;
+            let immediate_busy = matches!(&first, Poll::Ready(Err(StreamControlError::MetadataBusy)));
+            drop(pending);
+            match action {
+                "source" | "target" => { f.policy.0.try_write().unwrap().revoked.insert(if action == "source" { "alice" } else { "bob" }.into()); }
+                "audience" => f.policy.0.try_write().unwrap().private = true,
+                "source-gate" | "target-gate" => {
+                    let c = if action == "source-gate" { &f.a } else { &f.b };
+                    let ids = [desired(Medium::Video).logical_id].into_iter().collect();
+                    for change in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                        c.set_media_gate(c.revision(), &ids, change, deadline()).await.unwrap();
+                    }
+                }
+                "cancel" => f.b.shutdown.cancel(),
+                _ => tokio::time::sleep_until(tokio::time::Instant::from_std(repair.expires_at() + Duration::from_millis(1))).await,
+            }
+            let denied = repair.repair(|_, _| async { panic!("withdrawn repair entered IO") }).await;
+            let expired = matches!(&denied, Err(StreamControlError::Deadline));
+            (immediate_busy, denied.is_err(), action != "age" || expired, f.policy.0.try_write().is_ok())
+        }).catch_unwind().await;
+        let joined = close(&f).await;
+        assert!(joined, "original Core controllers not closed for {action}");
+        let facts = match work { Ok(value) => value, Err(error) => std::panic::resume_unwind(error) };
+        assert_eq!(busy.load(Ordering::Acquire), 1);
+        assert!(facts.0 && facts.1 && facts.2 && facts.3, "repair denial/cutoff changed for {action}");
+    }
+}
