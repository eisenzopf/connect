+struct Domain {
+    principal: AuthenticatedPrincipal,
+    session: SessionId,
+    member: Membership,
+    endpoint: EndpointBinding,
+    alternate_endpoint: EndpointBinding,
+    owner: Mutex<Option<MediaOwner>>,
+    proof: Mutex<Option<Arc<PreparedMediaObservation>>>,
+    allowed: AtomicBool,
+    private_allowed: AtomicBool,
+    changed_epoch: AtomicBool,
+    changed_endpoint: AtomicBool,
+    private_checks: AtomicUsize,
+    preparations: AtomicUsize,
+}
+#[derive(Clone)]
+struct Grant {
+    domain: Arc<Domain>,
+    mutation: ParticipantMutation,
+    private_revision: Option<u64>,
+    private_audio: bool,
+}
+struct ParticipantLease(Grant);
+impl ParticipantControlLease for ParticipantLease {
+    fn current(
+        &self,
+        s: &ParticipantScope<'_>,
+    ) -> std::result::Result<ParticipantAuthority, ParticipantControlError> {
+        let g = &self.0;
+        let d = &g.domain;
+        if !d.allowed.load(Ordering::SeqCst)
+            || s.session != &d.session
+            || s.conversation != d.member.conversation()
+            || s.principal.ownership_key() != d.principal.ownership_key()
+            || s.principal.expires_at != d.principal.expires_at
+            || (s.mutation.operation_id != g.mutation.operation_id
+                || s.mutation.correlation_id != g.mutation.correlation_id
+                || s.mutation.expected_revision != g.mutation.expected_revision
+                || s.mutation.participant != g.mutation.participant
+                || s.mutation.change != g.mutation.change)
+            || s.connection_generation.is_some_and(|g| g != 1)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let identity = IdentityBinding::from_authenticated(
+            &d.principal,
+            d.member.identity().clone(),
+            chrono::Utc::now(),
+        )
+        .unwrap();
+        let member = if d.changed_epoch.load(Ordering::SeqCst) {
+            Membership::from_current(
+                identity.clone(),
+                d.member.conversation().clone(),
+                d.member.participant().clone(),
+                d.member.kind().clone(),
+                d.member.default_role().clone(),
+                2,
+                1,
+                true,
+            )
+            .unwrap()
+        } else {
+            d.member.clone()
+        };
+        let endpoint = if d.changed_endpoint.load(Ordering::SeqCst) {
+            d.alternate_endpoint.clone()
+        } else {
+            d.endpoint.clone()
+        };
+        Ok(ParticipantAuthority {
+            actor: member.clone(),
+            target: member,
+            endpoint: Some(endpoint),
+            may_send_audio: true,
+            may_receive_audio: true,
+            confirmation_required: false,
+            confirmed_generation: None,
+        })
+    }
+}
+impl ParticipantPolicy for Domain {
+    fn current(
+        &self,
+        _: &ParticipantScope<'_>,
+    ) -> std::result::Result<Box<dyn ParticipantAuthorityLease + '_>, ParticipantControlError> {
+        Err(ParticipantControlError::Unsupported)
+    }
+    fn current_control(
+        &self,
+        s: &ParticipantScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> std::result::Result<ParticipantControl, ParticipantControlError> {
+        let grant = held
+            .downcast_ref::<Grant>()
+            .ok_or(ParticipantControlError::Authority)?;
+        if !std::ptr::eq(self, grant.domain.as_ref()) {
+            return Err(ParticipantControlError::Authority);
+        }
+        ParticipantLease(grant.clone()).current(s)?;
+        ParticipantControl::new(
+            Box::new(ParticipantLease(grant.clone())),
+            CancellationToken::new(),
+            deadline(),
+        )
+    }
+}
+struct MediaLease {
+    domain: Arc<Domain>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for MediaLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_prepared(
+        &self,
+        proof: &Arc<PreparedMediaObservation>,
+    ) -> ControlResult<Box<MediaOwner>> {
+        let owner = proof.activate_for_commit(self.owner.clone())?;
+        *self.domain.proof.lock().unwrap() = Some(proof.clone());
+        Ok(Box::new(owner))
+    }
+}
+impl Domain {
+    fn current_owner(&self) -> ControlResult<MediaOwner> {
+        if !self.allowed.load(Ordering::SeqCst) {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = self
+            .owner
+            .lock()
+            .unwrap()
+            .clone()
+            .ok_or(StreamControlError::NotReady)?;
+        if let Some(p) = self
+            .proof
+            .lock()
+            .unwrap()
+            .as_ref()
+            .filter(|p| p.is_committed())
+        {
+            p.current(owner)
+        } else {
+            Ok(owner)
+        }
+    }
+    fn media(&self, s: &MediaScope<'_>) -> ControlResult<MediaOwner> {
+        let owner = self.current_owner()?;
+        if s.connection != owner.connection.connection()
+            || s.session != owner.presence.session()
+            || s.conversation != owner.member.conversation()
+            || s.principal.ownership_key() != self.principal.ownership_key()
+            || s.principal.expires_at != self.principal.expires_at
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(owner)
+    }
+}
+struct OrdinaryMediaLease(MediaOwner);
+impl MediaAuthorityLease for OrdinaryMediaLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.0
+    }
+}
+impl MediaPolicy for Domain {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if !matches!(scope.purpose, MediaPurpose::Control) {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(Box::new(OrdinaryMediaLease(self.media(scope)?)))
+    }
+    fn current_control(
+        &self,
+        s: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let grant = held
+            .downcast_ref::<Grant>()
+            .ok_or(StreamControlError::Authority)?;
+        if !std::ptr::eq(self, grant.domain.as_ref()) {
+            return Err(StreamControlError::Authority);
+        }
+        if let MediaControlIntent::PreparePrivateAudio {
+            operation,
+            expected,
+        } = intent
+        {
+            self.private_checks.fetch_add(1, Ordering::SeqCst);
+            if !self.private_allowed.load(Ordering::SeqCst)
+                || *operation != grant.mutation.operation_id
+                || Some(*expected) != grant.private_revision
+            {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        MediaControl::new(
+            Box::new(MediaLease {
+                domain: grant.domain.clone(),
+                owner: self.media(s)?,
+            }),
+            CancellationToken::new(),
+            deadline(),
+        )
+    }
+}
