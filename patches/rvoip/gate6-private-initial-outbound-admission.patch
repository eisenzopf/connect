+            DeviceId::new(),
+            Transport::Sip,
+            "sip:private@fixture.invalid".into(),
+        )
+        .unwrap();
+        endpoint
+            .verify(
+                &identity,
+                "controlled-outbound-fixture".into(),
+                chrono::Utc::now(),
+            )
+            .unwrap();
+        let mut alternate_endpoint = EndpointBinding::provision(
+            identity.clone(),
+            EndpointId::new(),
+            DeviceId::new(),
+            Transport::Sip,
+            endpoint.address().into(),
+        )
+        .unwrap();
+        alternate_endpoint
+            .verify(
+                &identity,
+                "alternate-current-endpoint".into(),
+                chrono::Utc::now(),
+            )
+            .unwrap();
+        let domain = Arc::new(Domain {
+            principal,
+            session: session.clone(),
+            member,
+            endpoint,
+            alternate_endpoint,
+            owner: Mutex::new(None),
+            proof: Mutex::new(None),
+            allowed: AtomicBool::new(true),
+            private_allowed: AtomicBool::new(true),
+            changed_epoch: AtomicBool::new(false),
+            changed_endpoint: AtomicBool::new(false),
+            private_checks: AtomicUsize::new(0),
+            preparations: AtomicUsize::new(0),
+        });
+        orch.enable_staged_participant_control(
+            &session,
+            domain.clone(),
+            domain.clone(),
+            ParticipantLimits::default(),
+        )
+        .unwrap();
+        Self {
+            orch,
+            route,
+            domain,
+            session,
+        }
+    }
+    async fn activated(
+        &self,
+        private_audio: bool,
+    ) -> (
+        crate::orchestrator::participant_control::ActivatedInitialParticipant,
+        Grant,
+    ) {
+        let p = self
+            .orch
+            .prepare_outbound_connection(OriginateRequest {
+                session_id: self.session.clone(),
+                participant_id: self.domain.member.participant().clone(),
+                target: self.domain.endpoint.address().into(),
+                direction: Direction::Outbound,
+                capabilities: CapabilityDescriptor::default(),
+                transport: Some(Transport::Sip),
+                context: Default::default(),
+            })
+            .await
+            .unwrap();
+        let grant = Grant {
+            domain: self.domain.clone(),
+            private_revision: None,
+            private_audio,
+            mutation: ParticipantMutation {
+                operation_id: "private-initial".into(),
+                correlation_id: "private-initial".into(),
+                expected_revision: self.orch.participant_revision(&self.session).unwrap(),
+                participant: self.domain.member.participant().clone(),
+                change: ParticipantChange::Admit {
+                    connection: p.connection_id().clone(),
+                    role_override: None,
+                },
+            },
+        };
+        let active = if private_audio {
+            p.activate_private_initial_participant_with_held(
+                self.domain.principal.clone(),
+                grant.mutation.clone(),
+                deadline(),
+                CancellationToken::new(),
+                Box::new(grant.clone()),
+            )
+            .await
+        } else {
+            p.activate_initial_participant_with_held(
+                self.domain.principal.clone(),
+                grant.mutation.clone(),
+                deadline(),
+                CancellationToken::new(),
+                Box::new(grant.clone()),
+            )
+            .await
+        }
+        .unwrap();
+        assert!(self.orch.session_of(active.connection_id()).is_none());
+        assert_eq!(self.route.allocations.load(Ordering::SeqCst), 1);
+        assert_eq!(self.route.signals.load(Ordering::SeqCst), 1);
+        (active, grant)
+    }
+    async fn commit(
+        &self,
+        active: crate::orchestrator::participant_control::ActivatedInitialParticipant,
+        grant: Grant,
+        muted: bool,
+    ) -> std::result::Result<(ConnectionHandle, ParticipantObservation), ParticipantControlError>
+    {
+        let domain = self.domain.clone();
+        let route = self.route.clone();
+        let held = grant.clone();
+        active
+            .commit_staged_participant_with_held(
+                grant.mutation.clone(),
+                deadline(),
+                CancellationToken::new(),
+                Box::new(grant),
+                move |p| async move {
+                    assert_eq!(p.is_private_audio(), held.private_audio);
+                    domain.preparations.fetch_add(1, Ordering::SeqCst);
+                    let mut caps = profile();
+                    caps.send.retain(|c| c.medium == Medium::Audio);
+                    caps.receive.retain(|c| c.medium == Medium::Audio);
+                    caps.max_streams = 1;
+                    *domain.owner.lock().unwrap() = Some(MediaOwner {
+                        actor: p.member().clone(),
+                        member: p.member().clone(),
+                        presence: p.appearance().clone(),
+                        endpoint: p.endpoint().clone(),
+                        connection: p.binding().clone(),
+                        may_control: true,
+                        may_route_source: false,
+                        send_media: BTreeSet::from([Medium::Audio]),
+                        receive_media: BTreeSet::from([Medium::Audio]),
+                        local: caps.clone(),
+                        remote: caps,
+                    });
+                    let backend = Adapter::new();
+                    let controller = StreamController::with_held_control(
+                        p.member().conversation().clone(),
+                        p.appearance().session().clone(),
+                        p.binding().connection().clone(),
+                        p.principal().clone(),
+                        domain.clone(),
+                        backend,
+                        Arc::new(StreamHandleAllocator::default()),
+                        4,
+                        8,
+                        p.cancellation(),
+                        &held,
+                    )?;
+                    controller
+                        .change_with_held(
+                            0,
+                            &[desired(Medium::Audio)],
+                            &BTreeSet::new(),
+                            deadline(),
+                            CancellationToken::new(),
+                            Arc::new(held.clone()),
+                        )
+                        .await?;
+                    if muted {
+                        controller
+                            .set_media_gate_with_held(
+                                1,
+                                &BTreeSet::from([desired(Medium::Audio).logical_id]),
+                                StreamGateAction::Mute,
+                                deadline(),
+                                Arc::new(held.clone()),
+                            )
+                            .await?;
+                    }
+                    let mut held = held;
+                    held.private_revision = Some(controller.revision());
+                    route
+                        .controllers
+                        .lock()
+                        .unwrap()
+                        .insert(p.binding().connection().clone(), controller);
+                    Ok(Arc::new(held) as Arc<dyn Any + Send + Sync>)
+                },
+            )
+            .await
+    }
+}
+#[tokio::test]
+async fn private_outbound_admission_keeps_original_ticket_and_requires_muted_owned_ports() {
+    let f = Setup::new().await;
+    let (active, grant) = f.activated(true).await;
+    let id = active.connection_id().clone();
+    let (_handle, observed) = f.commit(active, grant, true).await.unwrap();
+    assert!(observed.admitted.contains(&id));
+    assert_eq!(f.orch.session_of(&id), Some(f.session.clone()));
+    assert!(f.domain.private_checks.load(Ordering::SeqCst) > 0);
+    assert_eq!(f.route.allocations.load(Ordering::SeqCst), 1);
+    assert_eq!(f.route.signals.load(Ordering::SeqCst), 1);
+    f.orch.end_connection(id, EndReason::Normal).await.unwrap();
+    assert_eq!(f.route.ends.load(Ordering::SeqCst), 1);
+}
