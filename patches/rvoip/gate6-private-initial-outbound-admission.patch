+fn same_initial_member(a: &Membership, b: &Membership) -> bool {
+    a.identity() == b.identity()
+        && a.tenant() == b.tenant()
+        && a.conversation() == b.conversation()
+        && a.participant() == b.participant()
+        && a.epoch() == b.epoch()
+        && a.kind() == b.kind()
+        && a.default_role() == b.default_role()
+}
+fn same_initial_endpoint(a: &EndpointBinding, b: &EndpointBinding) -> bool {
+    a.endpoint() == b.endpoint()
+        && a.device() == b.device()
+        && a.identity() == b.identity()
+        && a.address() == b.address()
+        && a.state() == b.state()
+        && a.transport() == b.transport()
