+    fn capture(authority: &ParticipantAuthority) -> ControlResult<Self> {
+        Ok(Self {
+            actor: authority.actor.clone(),
+            target: authority.target.clone(),
+            endpoint: authority
+                .endpoint
+                .clone()
+                .ok_or(ParticipantControlError::Authority)?,
+        })
+    }
+    fn require(&self, authority: &ParticipantAuthority) -> ControlResult<()> {
+        if !same_initial_member(&self.actor, &authority.actor)
+            || !same_initial_member(&self.target, &authority.target)
+            || !authority
+                .endpoint
+                .as_ref()
+                .is_some_and(|e| same_initial_endpoint(&self.endpoint, e))
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        Ok(())
+    }
+}
 
