+// Shared only among copies/contributions of one original input packet. A dead
+// weak reference cannot reacquire custody, and a different input gets a new slot.
+#[derive(Clone, Default)]
+struct PacketCustody(Arc<Mutex<Option<Weak<dyn Any + Send + Sync>>>>);
+impl PacketCustody {
+    fn from_lease(lease: &dyn MediaAuthorityLease) -> Self {
+        let custody = Self::default();
+        custody.observe(lease);
+        custody
+    }
+    fn observe(&self, lease: &dyn MediaAuthorityLease) {
+        let weak = lease
+            .packet_context()
+            .and_then(|context| context.downcast_ref::<Weak<dyn Any + Send + Sync>>());
+        if let (Some(weak), Ok(mut slot)) = (weak, self.0.try_lock()) {
+            *slot = Some(weak.clone());
+        }
+    }
+    fn active(&self) -> Option<Arc<dyn Any + Send + Sync>> {
+        self.0.try_lock().ok()?.as_ref()?.upgrade()
+    }
+}
