+
+// A separate fair lock models file custody, independently of mutable policy.
+struct WeakPacketRead {
+    domain: Arc<()>,
+    source: ConnectionId,
+    _guard: OwnedRwLockReadGuard<()>,
+}
+struct WeakPacketLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    _read: Arc<WeakPacketRead>,
+    weak: Weak<dyn Any + Send + Sync>,
+}
+impl MediaAuthorityLease for WeakPacketLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn packet_context(&self) -> Option<&(dyn Any + Send + Sync)> {
+        Some(&self.weak)
+    }
+}
+struct WeakPacketPolicy {
+    inner: Arc<Policy>,
+    domain: Arc<()>,
+    fence: Arc<RwLock<()>>,
+    revoked: Arc<AtomicBool>,
+}
+impl WeakPacketPolicy {
+    fn lease(
+        &self,
+        scope: &MediaScope<'_>,
+        read: Arc<WeakPacketRead>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if scope.connection.as_str() == "c" && self.revoked.load(Ordering::Acquire) {
+            return Err(StreamControlError::Authority);
+        }
+        let erased: Arc<dyn Any + Send + Sync> = read.clone();
+        Ok(Box::new(WeakPacketLease {
+            inner: self.inner.current(scope)?,
+            _read: read,
+            weak: Arc::downgrade(&erased),
+        }))
+    }
+}
+impl MediaPolicy for WeakPacketPolicy {
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current_participant_receive(scope, source)
+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .fence
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::NotReady)?;
+        self.lease(
+            scope,
+            Arc::new(WeakPacketRead {
+                domain: self.domain.clone(),
+                source: scope.connection.clone(),
+                _guard: guard,
+            }),
+        )
+    }
+    fn current_packet(
+        &self,
+        scope: &MediaScope<'_>,
+        context: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let read = context
+            .downcast_ref::<Weak<dyn Any + Send + Sync>>()
+            .and_then(Weak::upgrade)
+            .and_then(|read| read.downcast::<WeakPacketRead>().ok())
+            .ok_or(StreamControlError::Authority)?;
+        let source = match scope.purpose {
+            MediaPurpose::Publish => scope.connection,
+            MediaPurpose::Receive { source } => &source.connection,
+            _ => return Err(StreamControlError::Authority),
+        };
+        if !Arc::ptr_eq(&read.domain, &self.domain) || &read.source != source {
+            return Err(StreamControlError::Authority);
+        }
+        self.lease(scope, read)
+    }
+}
+async fn weak_scene() -> (Scene, Arc<RwLock<()>>, Arc<AtomicBool>) {
+    let fence = Arc::new(RwLock::new(()));
+    let revoked = Arc::new(AtomicBool::new(false));
+    let s = Scene::new_inner(
+        &[
+            ("a", "alice", audio(), 0),
+            ("b", "bob", audio(), 0),
+            ("c", "carol", audio(), 0),
+            ("d", "dave", audio(), 0),
+        ],
+        8000,
+        Some(Box::new({
+            let fence = fence.clone();
+            let revoked = revoked.clone();
+            move |inner| {
+                Arc::new(WeakPacketPolicy {
+                    inner,
+                    domain: Arc::new(()),
+                    fence,
+                    revoked,
+                })
+            }
+        })),
+    )
+    .await;
+    for i in 0..4 {
+        s.bind(i, true).await;
+    }
+    (s, fence, revoked)
+}
+#[tokio::test]
+async fn same_original_packet_shares_only_active_custody_and_never_a_different_packet() {
+    let (s, fence, _) = weak_scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    let mut dave = s.port(3).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    s.publish(0, 2300);
+    s.mixer.tick();
+    assert!(
+        fence.clone().try_write_owned().is_ok(),
+        "queued metadata retained a reader"
+    );
+    let first = bob.try_recv().unwrap();
+    let same = carol.try_recv().unwrap();
+    let remaining = dave.try_recv().unwrap();
+    let different = carol.try_recv().unwrap();
+    assert!(Arc::ptr_eq(
+        &same.sources[0].custody.0,
+        &remaining.sources[0].custody.0
+    ));
+    assert!(!Arc::ptr_eq(
+        &same.sources[0].custody.0,
+        &different.sources[0].custody.0
+    ));
+    let mut sending = Box::pin(first.deliver(|_| std::future::pending::<ControlResult<()>>()));
+    assert!(sending
+        .as_mut()
+        .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+        .is_pending());
+    let mut writer = Box::pin(fence.clone().write_owned());
+    assert!(writer
+        .as_mut()
+        .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+        .is_pending());
+    assert!(matches!(
+        different.admit_queued_media(),
+        Err(StreamControlError::NotReady)
+    ));
+    heard(same, 1800).await;
+    assert!(remaining.sources[0].custody.active().is_some());
+    drop(sending);
+    assert!(
+        remaining.sources[0].custody.active().is_none(),
+        "queued copies resurrected custody"
+    );
+    let guard = writer.await;
+    assert!(matches!(
+        remaining.admit_queued_media(),
+        Err(StreamControlError::NotReady)
+    ));
+    drop(guard);
+    heard(remaining, 1800).await;
+    heard(different, 2300).await;
+    assert!(fence.clone().try_write_owned().is_ok());
+}
+#[tokio::test]
+async fn same_packet_live_custody_preserves_current_recipient_and_original_age() {
+    let (s, fence, revoked) = weak_scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    let mut dave = s.port(3).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let mut sending = Box::pin(
+        bob.try_recv()
+            .unwrap()
+            .deliver(|_| std::future::pending::<ControlResult<()>>()),
+    );
+    assert!(sending
+        .as_mut()
+        .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+        .is_pending());
+    let mut writer = Box::pin(fence.clone().write_owned());
+    assert!(writer
+        .as_mut()
+        .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+        .is_pending());
+    revoked.store(true, Ordering::Release);
+    let same = carol.try_recv().unwrap();
+    assert!(matches!(
+        same.admit_queued_media(),
+        Err(StreamControlError::Authority)
+    ));
+    revoked.store(false, Ordering::Release);
+    heard(same, 1800).await;
+    let mut expired = dave.try_recv().unwrap();
+    expired.admitted_at = Instant::now() - Duration::from_millis(201);
+    assert!(matches!(
+        expired.admit_queued_media(),
+        Err(StreamControlError::Deadline)
+    ));
+    drop(sending);
+    drop(writer.await);
+    assert!(fence.clone().try_write_owned().is_ok());
+}
