+fn observe_pending(
+    packet: &MediaPacket,
+    events: &std::sync::atomic::AtomicU8,
+    stage: &'static str,
+    target: Option<&StreamController>,
+    deadline: Option<tokio::time::Instant>,
+    error: Option<&StreamControlError>,
+    remaining: Option<usize>,
+) {
+    if packet.frame.kind != StreamKind::Video
+        || !tracing::enabled!(target: "rvoip_core::video_pending", tracing::Level::DEBUG)
+    {
+        return;
+    }
+    let Ok(event) = events.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+        (n < 32).then_some(n + 1)
+    }) else {
+        return;
+    };
+    tracing::debug!(target: "rvoip_core::video_pending", stage, event=event+1,
+        source=packet.source.owner.upgrade().as_ref().map(|o|o.connection.as_str()),
+        target=target.map(|o|o.connection.as_str()),
+        stream=%packet.frame.stream_id, timestamp_rtp=packet.frame.timestamp_rtp,
+        age_us=packet.admitted_at.elapsed().as_micros() as u64,
+        remaining_us=deadline.map(|d|d.saturating_duration_since(tokio::time::Instant::now()).as_micros() as u64),
+        original_epoch_current=packet.custody.current(), original_ticket_current=packet.ticket.is_current(),
+        original_scene_cancelled=packet.scene.as_ref().map(|s|s.cancel.is_cancelled()),
+        ?error, remaining,
+        "Original video pending decision (at most32 events per packet)");
+}
