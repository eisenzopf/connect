+//! Actual scene retention: distinguish a plain target miss from an invalidated
+//! original packet epoch without renewing permission or changing packet age.
+use super::*;
+use std::sync::atomic::AtomicBool;
+use tracing_subscriber::{layer::Context, prelude::*, Layer};
+
+struct Epoch(AtomicBool);
+impl PacketEpoch for Epoch {
+    fn current(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}
+struct EpochLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    epoch: Arc<Epoch>,
+}
+impl MediaAuthorityLease for EpochLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        self.inner.expires_at()
+    }
+    fn packet_epoch(&self) -> Option<Arc<dyn PacketEpoch>> {
+        Some(self.epoch.clone())
+    }
+}
+struct EpochPolicy {
+    inner: TransientPolicy,
+    epoch: Arc<Epoch>,
+}
+impl MediaPolicy for EpochPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let lease = self.inner.current(scope)?;
+        if matches!(scope.purpose, MediaPurpose::Publish) {
+            Ok(Box::new(EpochLease {
+                inner: lease,
+                epoch: self.epoch.clone(),
+            }))
+        } else {
+            Ok(lease)
+        }
+    }
+}
+#[derive(Clone, Default, Debug)]
+struct Observed {
+    stage: String,
+    epoch: Option<bool>,
+    error: String,
+}
+impl tracing::field::Visit for Observed {
+    fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
+        if field.name() == "stage" {
+            self.stage = value.into();
+        }
+    }
+    fn record_bool(&mut self, field: &tracing::field::Field, value: bool) {
+        if field.name() == "original_epoch_current" {
+            self.epoch = Some(value);
+        }
+    }
+    fn record_debug(&mut self, field: &tracing::field::Field, value: &dyn std::fmt::Debug) {
+        if field.name() == "error" {
+            self.error = format!("{value:?}");
+        }
+    }
+}
+struct Capture(Arc<Mutex<Vec<Observed>>>);
+impl<S: tracing::Subscriber> Layer<S> for Capture {
+    fn on_event(&self, event: &tracing::Event<'_>, _: Context<'_, S>) {
+        if event.metadata().target() != "rvoip_core::video_pending" {
+            return;
+        }
+        let mut observed = Observed::default();
+        event.record(&mut observed);
+        self.0.lock().unwrap().push(observed);
+    }
+}
+fn tick(scene: &GuardedMediaScene, events: &Arc<Mutex<Vec<Observed>>>) {
+    tracing::subscriber::with_default(
+        tracing_subscriber::registry()
+            .with(tracing_subscriber::EnvFilter::new(
+                "off,rvoip_core::video_pending=debug",
+            ))
+            .with(Capture(events.clone())),
+        || scene.tick(),
+    );
+}
+
+#[tokio::test]
+async fn original_video_not_ready_and_revoked_epoch_have_distinct_pending_decisions() {
+    for revoked in [false, true] {
+        let blocked = Arc::new(AtomicU8::new(0));
+        let epoch = Arc::new(Epoch(AtomicBool::new(true)));
+        let f = Fixture::with_policy(
+            16,
+            Some(Box::new({
+                let blocked = blocked.clone();
+                let epoch = epoch.clone();
+                move |inner| {
+                    Arc::new(EpochPolicy {
+                        inner: TransientPolicy {
+                            inner,
+                            blocked,
+                            source_expiry: Arc::new(Mutex::new(None)),
+                        },
+                        epoch,
+                    })
+                }
+            })),
+        );
+        f.start_unsubscribed(&[Medium::Video]).await;
+        let scene = GuardedMediaScene::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            f.a.policy.clone(),
+            8000,
+        );
+        for controller in [&f.a, &f.b] {
+            let mut member = scene.prepare(controller.clone()).unwrap();
+            member
+                .quiesce(deadline(), CancellationToken::new())
+                .await
+                .unwrap();
+            assert!(member.ready());
+            scene.insert(controller.connection.clone(), member, true);
+        }
+        let s = Scene { f, scene };
+        s.subscribe(Medium::Video).await;
+        let mut output = s.f.ba.port(Medium::Video).take_egress().unwrap();
+        let events = Arc::new(Mutex::new(Vec::new()));
+        s.publish(Medium::Video, 3000);
+        blocked.store(2, Ordering::Release);
+        tick(&s.scene, &events);
+        assert!(output.try_recv().is_err());
+        assert_eq!(
+            s.scene
+                .retained_visual_for_test(&s.f.a.connection, &desired(Medium::Video).logical_id),
+            (1, 1, 0, 0)
+        );
+        s.f.policy
+            .0
+            .try_write()
+            .expect("pending packet retained real policy reader");
+        blocked.store(0, Ordering::Release);
+        if revoked {
+            epoch.0.store(false, Ordering::Release);
+        }
+        tick(&s.scene, &events);
+        let records = events.lock().unwrap().clone();
+        assert!(records
+            .iter()
+            .any(|e| e.stage == "retain-not-ready" && e.epoch == Some(true)));
+        if revoked {
+            assert!(
+                output.try_recv().is_err(),
+                "old packet borrowed a new current epoch"
+            );
+            assert!(
+                records.iter().any(|e| e.stage == "forward-result"
+                    && e.epoch == Some(false)
+                    && e.error == "Some(Authority)"),
+                "{records:?}"
+            );
+        } else {
+            let packet = output
+                .try_recv()
+                .expect("plain target miss lost original packet");
+            packet
+                .deliver(|frame| async move {
+                    assert_eq!(frame.timestamp_rtp, 3000);
+                    Ok(())
+                })
+                .await
+                .unwrap();
+            assert!(
+                records.iter().any(|e| e.stage == "forward-result"
+                    && e.epoch == Some(true)
+                    && e.error == "None"),
+                "{records:?}"
+            );
+        }
+        assert!(records.len() <= 32);
+        drop(records);
+        assert_eq!(
+            s.scene
+                .retained_visual_for_test(&s.f.a.connection, &desired(Medium::Video).logical_id),
+            (0, 0, 0, 0)
+        );
+        tick(&s.scene, &events);
+        assert!(output.try_recv().is_err(), "duplicate original frame");
+    }
+}
