+        Instant::now() - Duration::from_millis(1),
+    );
+    assert!(!a.resource_activation_current(&expired));
+    let fresh = a.reauthorize_resource_preparation().await.unwrap();
+    assert!(a.resource_activation_current(&fresh));
+    let mut old_cap = a._lease.authority::<ResourcePreparation>().unwrap().clone();
+    old_cap.deadline = Instant::now() - Duration::from_millis(1);
+    a._lease = AuthorityLease::checking(old_cap.clone(), old_cap.deadline, || true);
+    assert!(matches!(
+        a.reauthorize_resource_preparation().await,
+        Err(DispatchError::Authority)
+    ));
+    assert_eq!(
+        policy.calls.load(Ordering::Acquire),
+        1,
+        "expired original cannot call policy to renew lifetime"
+    );
+    assert!(!a.resource_activation_current(&fresh));
+    a.origin.lifetime.cancel();
+    assert!(!fresh.current());
+    assert_eq!(replay.usage().0, 1);
