+//! Live selected-media resource ownership on the existing real adapter fixture.
+use super::*;
+struct ExactPolicy {
+    base: Arc<HeldPolicy>,
+    desired: Vec<DesiredStream>,
+    replace: BTreeSet<StreamId>,
+    checked: AtomicUsize,
+}
+impl MediaPolicy for ExactPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.base.current(scope)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        if let MediaControlIntent::Change {
+            expected,
+            desired,
+            replace,
+        } = intent
+        {
+            if *expected != 1 || *desired != self.desired.as_slice() || *replace != &self.replace {
+                return Err(StreamControlError::Authority);
+            }
+            self.checked.fetch_add(1, Ordering::AcqRel);
+        }
+        self.base.current_control(scope, intent, held)
+    }
+}
+async fn audio(
+    f: &Fixture,
+    source: &AdapterMediaPort,
+    input: &mut mpsc::Receiver<MediaPacket>,
+    output: &mut mpsc::Receiver<QueuedMedia>,
+    sequence: u32,
+) {
+    source.try_publish(&frame(source, sequence)).unwrap();
+    receive(input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    assert_audio(outgoing(output).await).await;
+}
+async fn exercise(mode: &str) {
+    let mut f = Fixture::new(8);
+    let replace = BTreeSet::from([desired(Medium::Video).logical_id]);
+    let policy = Arc::new(ExactPolicy {
+        base: HeldPolicy::new(&f),
+        desired: vec![desired(Medium::Audio), desired(Medium::Video)],
+        replace: replace.clone(),
+        checked: AtomicUsize::new(0),
+    });
+    let initial = held_context(&f, CancellationToken::new(), deadline()).await;
+    f.a = held_controller(&f, policy.clone(), initial.as_ref()).unwrap();
+    drop(initial);
+    f.start(&[Medium::Audio, Medium::Video]).await;
+    let expected = f.a.revision();
+    assert_eq!(expected, 1);
+    let old_audio = f.aa.port(Medium::Audio);
+    let old_video = f.aa.port(Medium::Video);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut output = f.ba.port(Medium::Audio).take_egress().unwrap();
+    audio(&f, &old_audio, &mut input, &mut output, 160).await;
+    let selected =
+        f.a.active_bindings()
+            .into_iter()
+            .map(|b| b.negotiated)
+            .collect::<Vec<_>>();
+    assert_eq!(
+        selected
+            .iter()
+            .map(|s| s.requested.clone())
+            .collect::<Vec<_>>(),
+        policy.desired
+    );
+    let resource_cancel = CancellationToken::new();
+    let held = held_context(&f, CancellationToken::new(), deadline()).await;
+    let calls = f.aa.prepare_calls.load(Ordering::Acquire);
+    let candidate =
+        f.a.stage_selected_with_held(
+            expected,
+            &selected,
+            &replace,
+            deadline(),
+            resource_cancel.clone(),
+            held,
+        )
+        .await
+        .unwrap();
+    f.aa.mode.store(1, Ordering::Release);
+    let task = tokio::spawn(candidate.prepare());
+    tokio::time::timeout(Duration::from_secs(1), f.aa.entered.notified())
+        .await
+        .unwrap();
+    let provisional = f.aa.port(Medium::Video);
+    let writer = f.policy.0.clone().try_write_owned();
+    let writer_progressed = writer.is_ok();
+    if let Ok(mut writer) = writer {
+        if mode == "withdraw-format" {
+            let owner = writer.owners.get_mut("alice").unwrap();
+            let alternative = MediaFormat::Encoded {
+                name: "h264".into(),
+                clock_rate_hz: 90000,
+                channels: 0,
+                fmtp: None,
+            };
+            // Video remains allowed and H264 still negotiable. Only the exact
+            // already-prepared VP8 is withdrawn; Audio is unchanged.
+            assert!(owner.send_media.contains(&Medium::Video));
+            assert!(owner.receive_media.contains(&Medium::Video));
+            for set in [&mut owner.local.send, &mut owner.local.receive] {
+                set.iter_mut()
+                    .find(|cap| cap.medium == Medium::Video)
+                    .unwrap()
+                    .formats
+                    .push(alternative.clone());
+            }
+            for set in [&mut owner.remote.send, &mut owner.remote.receive] {
+                set.iter_mut()
+                    .find(|cap| cap.medium == Medium::Video)
+                    .unwrap()
+                    .formats = vec![alternative.clone()];
+            }
+        }
+    }
+    assert_eq!(f.a.revision(), expected);
+    assert_eq!(old_video.status(), PortStatus::Active);
+    assert_eq!(provisional.status(), PortStatus::Prepared);
+    assert_ne!(
+        old_video.binding().transport_id,
+        provisional.binding().transport_id
+    );
+    assert!(provisional.try_publish(&frame(&provisional, 3000)).is_err());
+    audio(&f, &old_audio, &mut input, &mut output, 320).await;
+    let result = if mode == "cancel" {
+        resource_cancel.cancel();
+        match task.await.unwrap() {
+            Err(error) => Err(error),
+            Ok(_) => panic!("cancelled adapter wait unexpectedly completed"),
+        }
+    } else {
+        f.aa.release.notify_one();
+        let mut prepared = task.await.unwrap().unwrap();
+        if mode == "expired" {
+            prepared.staged.deadline = tokio::time::Instant::now();
+        }
+        let fresh: Arc<dyn Any + Send + Sync> = if mode == "foreign" {
+            Arc::new(())
+        } else {
+            held_context(&f, CancellationToken::new(), deadline()).await
+        };
+        prepared.activate_with_held(fresh).await
+    };
+    let revision = f.a.revision();
+    let status = provisional.status();
+    let old_status = old_video.status();
+    let prepares = f.aa.prepare_calls.load(Ordering::Acquire);
+    audio(&f, &old_audio, &mut input, &mut output, 480).await;
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+    assert_eq!(f.b.shutdown(deadline()).await, 0);
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(f.ba.outstanding.load(Ordering::Acquire), 0);
+    assert!(
+        writer_progressed,
+        "live resource preparation retained the original domain reader"
+    );
+    assert_eq!(prepares, calls + 1, "adapter.prepare repeated");
+    if mode == "current" {
+        result.unwrap();
+        assert_eq!(revision, expected + 1);
+        assert_eq!(status, PortStatus::Active);
+        assert_eq!(old_status, PortStatus::Retired);
+        assert_eq!(policy.checked.load(Ordering::Acquire), 2);
+    } else {
+        match mode {
+            "foreign" => assert!(matches!(result, Err(StreamControlError::Authority))),
+            "cancel" => assert!(matches!(result, Err(StreamControlError::Cancelled))),
+            "expired" => assert!(matches!(result, Err(StreamControlError::Deadline))),
+            "withdraw-format" => assert!(matches!(
+                result,
+                Err(StreamControlError::Model(MediaTransitionError::Unsupported))
+            )),
+            _ => unreachable!(),
+        }
+        assert_eq!(revision, expected);
+        assert_eq!(status, PortStatus::Retired);
+        assert_eq!(old_status, PortStatus::Active);
+    }
+}
