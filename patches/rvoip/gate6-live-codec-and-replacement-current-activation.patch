+#[tokio::test]
+async fn actual_session_codec_resource_wait_releases_control_and_fresh_withdrawal_keeps_old_audio_once(
+) {
+    let (mut s, origin, policy) = setup("quic").await;
+    let controller = s.controller();
+    let first = StreamId::from_string("first");
+    let old = controller.active_bindings()[0].clone();
+    let mut input = controller.take_ingress(&first).unwrap();
+    let selected = plan(&s, &origin, "pcma");
+    let connection = selected.scope().origin.media.connection.clone();
+    let task = execute(&s, selected, "withdraw_after_codec_prepare", policy.clone());
+    let callback = s.wire.read().await;
+    s.f.verify_server(&callback).await;
+    // Withdraw only control, not old send/receive Audio. This is a real writer
+    // while the original signed answer is withheld; no copied grant can survive.
+    let mut writer = tokio::time::timeout(Duration::from_secs(1), s.grants.0.clone().write_owned())
+        .await
+        .expect("codec resource preparation retained old domain authority");
+    writer.owners.get_mut(&connection).unwrap().may_control = false;
+    drop(writer);
+    s.confirm(&callback).await;
+    let failure = task.await.unwrap().unwrap_err();
+    assert!(failure.effect_possible);
+    assert_eq!(controller.revision(), 1);
+    assert_eq!(
+        controller.active_bindings()[0].transport_id,
+        old.transport_id
+    );
+    send(&s.wire, encoded_audio(old.stream_local_id, 0, 71));
+    packet(&mut input)
+        .await
+        .try_forward_to(&controller, &first)
+        .unwrap();
+    decoded_codec(&received(&s.wire).await, 0);
+    assert_eq!(policy.operations.lock().unwrap().len(), 1);
+    assert_eq!(
+        policy.reads.load(Ordering::Acquire),
+        1,
+        "withdrawn current control must refuse before publishing a fresh grant"
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_millis(50), s.wire.reader.next())
+            .await
+            .is_err()
+    );
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&connection)
+        .unwrap()
+        .may_control = true;
+    let repeated = execute(
+        &s,
+        plan(&s, &origin, "pcma"),
+        "withdraw_after_codec_prepare",
+        policy.clone(),
+    )
+    .await
+    .unwrap()
+    .unwrap_err();
+    assert!(!repeated.effect_possible);
+    assert_eq!(policy.operations.lock().unwrap().len(), 1);
+    assert_eq!(controller.revision(), 1);
+    s.wire.server.shutdown().await.unwrap();
+}
