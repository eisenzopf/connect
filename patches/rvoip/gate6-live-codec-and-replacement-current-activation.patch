+    async fn authorize_codec_activation(
+        &self,
+        original: &NativeSessionCodecActivation,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if !original.current()
+            || !self
+                .operations
+                .lock()
+                .unwrap()
+                .contains(original.operation())
+        {
+            return Err(DispatchError::Authority);
+        }
+        let wire = self.wire.grants.clone().read_owned().await;
+        let guard = self.domain.0.clone().read_owned().await;
+        let proof = FreshProof {
+            domain: self.domain.clone(),
+            wire_domain: self.wire.clone(),
+            guard,
+            wire,
+            principal: original.scope().origin.principal.clone(),
+            plan: original.plan().media().clone(),
+            expected: original.plan().expected_revision(),
+            operation: original.operation().into(),
+            proposal: Mutex::new(None),
+        };
+        validate(&proof, original.scope())?;
+        self.reads.fetch_add(1, Ordering::AcqRel);
+        Ok(AuthorityLease::holding(proof))
+    }
 }
