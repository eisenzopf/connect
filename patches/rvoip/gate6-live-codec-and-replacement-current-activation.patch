+        a.origin.lifetime.clone(),
+        a.origin.deadline,
+    );
+    replay.consume(a.envelope().id()).unwrap();
+    a.exchange = Some(context);
+    let mut a = a
+        .into_resource_preparation(
+            "part_alice".into(),
+            ["audio".into()].into_iter().collect(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .unwrap();
+    let other = initial_authorized();
+    let other_resource = other._lease.authority::<ResourcePreparation>().unwrap();
+    let foreign = Arc::new(ResourceActivationAuthority {
+        marker: other_resource.marker.clone(),
+        lease: AuthorityLease::holding(17u64),
+        invocation: a.invocation.child_token(),
+        physical: a.origin.lifetime.child_token(),
+        deadline: Instant::now() + Duration::from_secs(1),
