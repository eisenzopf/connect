+/// The exact original adapter batch completed once; this owns its rollback path.
+pub struct PreparedSelectedMedia {
+    staged: StagedChange,
+    replace: BTreeSet<StreamId>,
+}
+impl QuarantinedSelectedMedia {
+    pub async fn prepare(mut self) -> ControlResult<PreparedSelectedMedia> {
+        let s = &mut self.staged;
+        let owner = s.candidate.owner.clone();
+        debug_assert!(s.control.is_none());
+        tokio::select! { biased;
+            _ = s.cancellation.cancelled() => return Err(StreamControlError::Cancelled),
+            _ = owner.shutdown.cancelled() => return Err(StreamControlError::Cancelled),
+            result = tokio::time::timeout_at(s.deadline,
+                owner.adapter.prepare(s.selected.clone(), s.deadline, s.candidate.cancellation.clone())) => {
+                result.map_err(|_| StreamControlError::Deadline)??;
+            }
+        }
+        s.adapter_prepared = true;
+        Ok(PreparedSelectedMedia {
+            staged: self.staged,
+            replace: self.replace,
+        })
+    }
+}
+impl PreparedSelectedMedia {
+    pub async fn activate_with_held(
+        mut self,
+        held: Arc<dyn Any + Send + Sync>,
+    ) -> ControlResult<()> {
+        let owner = self.staged.candidate.owner.clone();
+        let desired = self
+            .staged
+            .selected
+            .iter()
+            .map(|p| p.port.0.binding.negotiated.requested.clone())
+            .collect::<Vec<_>>();
+        owner.check_credential_snapshot(&self.staged.credential)?;
+        self.staged.control = Some(owner.policy.current_control(
+            &owner.scope(&self.staged.credential.principal, MediaPurpose::Control),
+            &MediaControlIntent::Change {
+                expected: self.staged.expected,
+                desired: &desired,
+                replace: &self.replace,
+            },
+            held.as_ref(),
+        )?);
+        // DesiredStream carries the medium/direction, not the chosen codec.
+        // Revalidate the unchanged negotiated formats under this fresh held
+        // control before activation; never renegotiate or repeat adapter IO.
+        let current = self
+            .staged
+            .control
+            .as_ref()
+            .expect("fresh selected control")
+            .authority()?;
+        let selected = self
+            .staged
+            .selected
+            .iter()
+            .map(|p| p.port.0.binding.negotiated.clone())
+            .collect::<Vec<_>>();
+        validate_selected_streams(&current.local, &current.remote, &selected)?;
+        drop(current);
+        self.staged.control_cancel = self
+            .staged
+            .control
+            .as_ref()
+            .expect("fresh selected control")
+            .cancellation
+            .clone();
+        owner.finish_change(self.staged).await
+    }
+}
