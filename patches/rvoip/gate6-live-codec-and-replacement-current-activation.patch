+//! Sealed server-generated codec parameter rights; never media/application authority.
+use super::*;
+use crate::v2::{
+    auth_dispatch::lifecycle::NativeLifecycleFence,
+    auth_dispatch::{AuthorityLease, DispatchError},
+    native_negotiation::{
+        catalog::{codec_wire, direction, kind, payload_type},
+        ServerInvocation,
+    },
+    native_requests::{NativeRequestPolicy, NativeRequestReply},
+    Envelope, Scope,
+};
+use serde_json::json;
+use std::{collections::BTreeSet, sync::OnceLock};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+
+struct OfferBinding {
+    id: String,
+    substrate: String,
+}
+
+pub(in crate::v2) struct CodecResourcePreparation {
+    pub(super) plan: Arc<NativeSessionCodecPlan>,
+    operation: String,
+    marker: Arc<()>,
+    offer: OnceLock<OfferBinding>,
+    confirmation: OnceLock<Arc<dyn NativeLifecycleFence>>,
+    pub(super) cancel: CancellationToken,
+    deadline: Instant,
+}
+impl CodecResourcePreparation {
+    pub(in crate::v2) fn new(original: &Arc<NativeSessionCodecInvocation>) -> Arc<Self> {
+        Arc::new(Self {
+            plan: original.plan.clone(),
+            operation: original.operation().into(),
+            marker: Arc::new(()),
+            offer: OnceLock::new(),
+            confirmation: OnceLock::new(),
+            cancel: original.cancellation(),
+            deadline: original.deadline(),
+        })
+    }
+    pub(in crate::v2) fn bind_offer(
+        &self,
+        offer: &str,
+        substrate: &str,
+    ) -> Result<(), DispatchError> {
+        if offer.is_empty() || offer.len() > 128 || substrate.is_empty() || substrate.len() > 32 {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        self.offer
+            .set(OfferBinding {
+                id: offer.into(),
+                substrate: substrate.into(),
+            })
+            .map_err(|_| DispatchError::ReplyMismatch)
+    }
+    fn base_current(&self) -> bool {
+        !self.cancel.is_cancelled() && Instant::now() < self.deadline && self.plan.origin.current()
+    }
+    fn current(&self) -> bool {
+        self.base_current() && self.confirmation.get().is_none_or(|fence| fence.current())
+    }
+    fn proposal(&self, proposal: &Envelope) -> Result<(), DispatchError> {
+        let scope = self.plan.scope();
+        let origin = &scope.origin;
+        let p = &proposal.original()["payload"];
+        let setup = &p["substrate_setup"];
+        let bound = self.offer.get().ok_or(DispatchError::Authority)?;
+        if !self.current()
+            || proposal.kind() != "connection.offer"
+            || proposal.scope(Scope::Reply).is_some()
+            || proposal.scope(Scope::Operation) != Some(self.operation.as_str())
+            || proposal.scope(Scope::Conversation) != origin.media.wire_conversation.as_deref()
+            || proposal.scope(Scope::Session) != Some(origin.media.wire_session.as_str())
+            || proposal.scope(Scope::Connection) != Some(origin.media.wire_connection.as_str())
+            || proposal.expected_revision() != Some(scope.stream_revision)
+            || p["by_participant"] != origin.participant.as_str()
+            || setup["kind"] != "native-prepared/1"
+            || setup["revision"].as_u64() != scope.stream_revision.checked_add(1)
+            || setup["offer_id"].as_str() != Some(bound.id.as_str())
+            || p["substrate"].as_str() != Some(bound.substrate.as_str())
+        {
+            return Err(DispatchError::Authority);
+        }
+        let streams = setup["streams"]
+            .as_array()
+            .ok_or(DispatchError::ReplyMismatch)?;
+        if streams.is_empty()
+            || streams.len() > 32
+            || streams.len() != self.plan.media().selected().len()
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        let mut ids = BTreeSet::new();
+        let mut handles = BTreeSet::new();
+        for stream in streams {
+            let id = stream["strm_id"]
+                .as_str()
+                .ok_or(DispatchError::ReplyMismatch)?;
+            let selected = self
+                .plan
+                .media()
+                .selected()
+                .iter()
+                .find(|s| s.requested.logical_id.as_str() == id)
+                .ok_or(DispatchError::Authority)?;
+            let handle = stream["stream_local_id"]
+                .as_u64()
+                .ok_or(DispatchError::ReplyMismatch)?;
+            if !ids.insert(id)
+                || !handles.insert(handle)
+                || !(1..=65535).contains(&handle)
+                || stream["kind"] != kind(selected.requested.medium)
+                || stream["direction"] != direction(selected.requested.direction)
+                || stream["codec"] != codec_wire(&selected.format, payload_type(&selected.format))
+            {
+                return Err(DispatchError::Authority);
+            }
+        }
+        let offered=streams.iter().map(|s|json!({"id":s["strm_id"],"kind":s["kind"],"direction":s["direction"],"codec_preferences":[s["codec"]["name"]]})).collect::<Vec<_>>();
+        if p["streams_offered"] != json!(offered) {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        Ok(())
+    }
+    pub(in crate::v2) fn reply(
+        &self,
+        request: &Envelope,
+        reply: &Envelope,
+    ) -> Result<(), DispatchError> {
+        self.proposal(request)?;
+        if reply.kind() != "connection.answer"
+            || reply.scope(Scope::Reply) != Some(request.id())
+            || [
+                Scope::Conversation,
+                Scope::Session,
+                Scope::Connection,
+                Scope::Operation,
+            ]
+            .into_iter()
+            .any(|scope| reply.scope(scope) != request.scope(scope))
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        let p = &reply.original()["payload"];
+        if p["substrate"] != request.original()["payload"]["substrate"]
+            || p["by_participant"] != self.plan.scope().origin.participant.as_str()
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        // This is authenticated input for the original negotiation only, not
+        // current/application authority. The broker owns full setup/codec
+        // confirmation validation before confirmed() or fresh activation. A
+        // malformed original answer must reach its definitive Confirmation
+        // failure rather than silently keeping the original waiter open.
+        Ok(())
+    }
+    pub(super) fn confirmed_fence(&self) -> Result<Arc<dyn NativeLifecycleFence>, DispatchError> {
+        self.confirmation
+            .get()
+            .cloned()
+            .ok_or(DispatchError::Authority)
+    }
+}
+#[async_trait::async_trait]
+impl NativeRequestPolicy for CodecResourcePreparation {
+    async fn authorize(
+        &self,
+        scope: &NativeRequestScope,
+        proposal: &Envelope,
+        held: Option<&AuthorityLease>,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let held = held.ok_or(DispatchError::Authority)?;
+        let actual = held
+            .authority::<CodecParameterReply>()
+            .and_then(|proof| proof.resource.upgrade())
+            .ok_or(DispatchError::Authority)?;
+        if !std::ptr::eq(self, Arc::as_ptr(&actual))
+            || !Arc::ptr_eq(&self.marker, &actual.marker)
+            || !Arc::ptr_eq(&scope.origin, &self.plan.scope().origin)
+            || scope.stream_revision != self.plan.expected_revision()
+            || scope.connection_generation != self.plan.scope().connection_generation
+            || scope.credential_revision != self.plan.scope().credential_revision
+            || scope.conversation != self.plan.scope().conversation
+        {
+            return Err(DispatchError::Authority);
+        }
+        self.proposal(proposal)?;
+        Ok(held.retained())
+    }
+}
+impl ServerInvocation for Arc<CodecResourcePreparation> {
+    fn scope(&self) -> &NativeRequestScope {
+        self.plan.scope()
+    }
+    fn media(&self) -> &NativeOfferPlan {
+        self.plan.media()
+    }
+    fn operation(&self) -> &str {
+        &self.operation
+    }
+    fn current(&self) -> bool {
+        CodecResourcePreparation::current(self)
+    }
+    fn origin(&self) -> &Arc<NativeRequestOrigin> {
+        &self.plan.origin
+    }
+    fn lease(&self) -> AuthorityLease {
+        // A confirmed reply fence retains this authority. Its backedge must be
+        // Weak and base-only: cap -> fence -> cap would leak and recurse current.
+        let resource = Arc::downgrade(self);
+        let current = resource.clone();
+        AuthorityLease::checking(CodecParameterReply { resource }, self.deadline, move || {
+            current.upgrade().is_some_and(|cap| cap.base_current())
+        })
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.cancel.child_token()
+    }
+    fn confirmed(&self, reply: &NativeRequestReply) -> Result<(), NativeOfferError> {
+        if !reply.current() || reply.scope().stream_revision != self.plan.expected_revision() {
+            return Err(NativeOfferError::Cancelled);
+        }
+        self.confirmation
+            .set(reply.commit_fence())
+            .map_err(|_| NativeOfferError::Conflict)
+    }
+}
+pub(in crate::v2) struct CodecParameterReply {
+    resource: std::sync::Weak<CodecResourcePreparation>,
+}
+impl CodecParameterReply {
+    pub(in crate::v2) fn reply(
+        &self,
+        request: &Envelope,
+        reply: &Envelope,
+    ) -> Result<(), DispatchError> {
+        self.resource
+            .upgrade()
+            .ok_or(DispatchError::Closed)?
+            .reply(request, reply)
+    }
+}
+
+/// Exact original prepared codec attempt. Construction is private to the
+/// executor after one authenticated parameter answer; it is not a current grant.
+pub struct NativeSessionCodecActivation {
+    pub(super) resource: Arc<CodecResourcePreparation>,
+}
+impl NativeSessionCodecActivation {
+    pub(in crate::v2) fn new(
+        resource: Arc<CodecResourcePreparation>,
+    ) -> Result<Self, DispatchError> {
+        if !resource.current() || resource.confirmation.get().is_none() {
+            return Err(DispatchError::Authority);
+        }
+        Ok(Self { resource })
+    }
+    pub fn current(&self) -> bool {
+        self.resource.current()
+    }
+    pub fn plan(&self) -> &NativeSessionCodecPlan {
+        &self.resource.plan
+    }
+    pub fn scope(&self) -> &NativeRequestScope {
+        self.resource.plan.scope()
+    }
+    pub fn operation(&self) -> &str {
+        &self.resource.operation
+    }
+    pub fn deadline(&self) -> Instant {
+        self.resource.deadline
+    }
+}
