+#[tokio::test]
+async fn initial_offer_reauthorization_releases_original_guards_and_retains_exact_original_cap() {
+    let mut a = initial_authorized();
+    let grants = Arc::new(tokio::sync::RwLock::new(false));
+    let until = Instant::now() + Duration::from_secs(2);
+    let original = AuthorityLease::checking(grants.clone().read_owned().await, until, || true);
+    a.reply_authority.replace(original.retained());
+    a.reply_authority.1.store(false, Ordering::Release);
+    a._lease = original;
+    let policy = Arc::new(OriginalPolicy {
+        expected: a.envelope().original().clone(),
+        grants: grants.clone(),
+        calls: std::sync::atomic::AtomicUsize::new(0),
+        deadline: Instant::now() + Duration::from_secs(30),
+    });
+    let (context, replay) = crate::v2::auth_peer::exchange::resource_test_context(
+        policy.clone(),
+        a.principal().clone(),
+        a.origin.lifetime.clone(),
+        a.origin.deadline,
+    );
+    replay.consume(a.envelope().id()).unwrap();
+    a.exchange = Some(context);
+    assert!(grants.clone().try_write_owned().is_err());
+    let a = a
+        .into_resource_preparation(
+            "part_alice".into(),
+            ["audio".into()].into_iter().collect(),
+            Instant::now() + Duration::from_secs(30),
+        )
+        .unwrap();
+    let writer = grants
+        .clone()
+        .try_write_owned()
+        .expect("initial invocation AND final reply domain guards released");
+    drop(writer);
+    let fresh = a.reauthorize_resource_preparation().await.unwrap();
+    assert!(a.resource_activation_current(&fresh));
+    assert!(fresh.deadline <= until && fresh.deadline <= a.origin.deadline);
+    assert!(fresh
+        .authority::<tokio::sync::OwnedRwLockReadGuard<bool>>()
+        .is_some());
+    assert!(
+        grants.clone().try_write_owned().is_err(),
+        "same fresh guard retained through local reservation"
+    );
+    assert_eq!(policy.calls.load(Ordering::Acquire), 1);
+    assert_eq!(
+        replay.usage().0,
+        1,
+        "no signature consumption or physical command replay"
+    );
+    assert_eq!(
+        a.install_resource_reply_authority(&fresh),
+        Err(DispatchError::Authority),
+        "initial resource cannot install application result rights"
+    );
+    assert_eq!(
+        a.reply_authority.for_replies(&[result(&a)]).unwrap_err(),
+        DispatchError::ReplyMismatch
+    );
+    drop(fresh);
+    let mut writer = grants
+        .clone()
+        .try_write_owned()
+        .expect("fresh guard released before retry pause");
+    *writer = true;
+    drop(writer);
+    assert!(matches!(
+        a.reauthorize_resource_preparation().await,
+        Err(DispatchError::Authority)
+    ));
+    assert_eq!(policy.calls.load(Ordering::Acquire), 2);
+    assert_eq!(replay.usage().0, 1);
+}
