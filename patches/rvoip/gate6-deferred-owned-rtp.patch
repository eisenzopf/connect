+//! Deferred, driver-owned primary RTP writes. Queues contain no permission lease.
+use super::owned_dtmf::OwnedDtmfControl;
+use futures::{
+    FutureExt,
+    future::{BoxFuture, Shared},
+};
+use rtc::{rtp, shared::error::Result};
+use std::{sync::Arc, time::Instant};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OwnedRtpError {
+    Unsupported,
+    NotReady,
+    Refused,
+    DeadlineBeforeWrite,
+    OutcomeUnknown,
+}
+pub type OwnedRtpResult = std::result::Result<(), OwnedRtpError>;
+
+/// A borrowed actual driver sink. It accepts at most one negotiated G.711 RTP
+/// packet. It cannot be retained by the producer or detached from its guard.
+#[async_trait::async_trait]
+pub trait OwnedRtpIo: Send {
+    async fn write(&mut self, packet: rtp::Packet) -> Result<()>;
+    fn written(&self) -> bool;
+}
+/// Runs in the driver immediately before wire IO, not while enqueuing a job.
+/// A Core producer calls QueuedMedia::deliver here, supplying its packet only
+/// under fresh source/target permission. That future owns its guard and IO;
+/// destruction must drop IO before releasing authorization.
+#[async_trait::async_trait]
+pub trait OwnedRtpProducer: Send + Sync {
+    async fn write(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult;
+}
+/// The qualified one-use delivery state is shared with the existing owned DTMF
+/// path. This separate type prevents exchanging tickets between those jobs.
+#[derive(Clone)]
+pub struct OwnedRtpControl {
+    inner: OwnedDtmfControl,
+    deadline: Instant,
+}
+impl OwnedRtpControl {
+    pub fn new(deadline: Instant) -> Self {
+        let inner = OwnedDtmfControl::new();
+        Self {
+            deadline: deadline.min(inner.deadline()),
+            inner,
+        }
+    }
+    pub fn deadline(&self) -> Instant {
+        self.deadline
+    }
+    /// True means actual submission may have started; never retry that packet.
+    pub fn cancel(&self) -> bool {
+        self.inner.cancel()
+    }
+    pub(crate) fn claim(&self) -> bool {
+        self.current() && self.inner.claim()
+    }
+    pub(crate) fn begin(&self) -> bool {
+        self.current() && self.inner.begin()
+    }
+    pub(crate) fn current(&self) -> bool {
+        self.inner.current(self.deadline)
+    }
+    async fn cancelled(&self) {
+        self.inner.cancelled().await;
+    }
+}
+pub(crate) fn stopped(control: &OwnedRtpControl) -> OwnedRtpError {
+    if control.cancel() {
+        OwnedRtpError::OutcomeUnknown
+    } else {
+        OwnedRtpError::DeadlineBeforeWrite
+    }
+}
+#[derive(Clone)]
+pub(crate) struct Receipt {
+    pub delivery: OwnedRtpResult,
+    pub drained: bool,
+}
+impl Receipt {
+    pub(crate) fn not_submitted(error: OwnedRtpError) -> Self {
+        Self {
+            delivery: Err(error),
+            drained: true,
+        }
+    }
+}
+type Completion = Shared<BoxFuture<'static, Receipt>>;
+/// Owns the original submission/receipt worker outside any observation future.
+/// Cancelling a result wait does not consume its join or confirm cleanup.
+pub struct OwnedRtpWrite {
+    control: OwnedRtpControl,
+    completion: Completion,
+}
+impl OwnedRtpWrite {
+    pub(crate) fn new(control: OwnedRtpControl, task: tokio::task::JoinHandle<Receipt>) -> Self {
+        let completion = async move {
+            task.await.unwrap_or(Receipt {
+                delivery: Err(OwnedRtpError::OutcomeUnknown),
+                drained: false,
+            })
+        }
+        .boxed()
+        .shared();
+        Self {
+            control,
+            completion,
+        }
+    }
+    pub fn cancel(&self) -> bool {
+        self.control.cancel()
+    }
+    pub async fn result(&self) -> OwnedRtpResult {
+        self.completion.clone().await.delivery
+    }
+    /// Requires the exact driver's acknowledgement after callback destruction.
+    /// A missing receipt is unconfirmed cleanup, even if its task disappeared.
+    pub async fn cancel_and_drain(&self) -> OwnedRtpResult {
+        self.control.cancel();
+        if self.completion.clone().await.drained {
+            Ok(())
+        } else {
+            Err(OwnedRtpError::OutcomeUnknown)
+        }
+    }
+}
+impl Drop for OwnedRtpWrite {
+    fn drop(&mut self) {
+        self.control.cancel();
+    }
+}
+pub(crate) struct OwnedRtpRequest {
+    pub producer: Arc<dyn OwnedRtpProducer>,
+    pub control: OwnedRtpControl,
+    pub completion: tokio::sync::oneshot::Sender<OwnedRtpResult>,
+}
+impl std::fmt::Debug for OwnedRtpRequest {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("OwnedRtpRequest(redacted)")
+    }
+}
+/// Shared custody seam for actual driver IO and forced-pending-IO tests.
+pub(crate) async fn complete(
+    producer: &dyn OwnedRtpProducer,
+    io: &mut dyn OwnedRtpIo,
+    control: &OwnedRtpControl,
+) -> OwnedRtpResult {
+    let mut flight = Box::pin(producer.write(io));
+    let result = tokio::select! {biased;
+        _=tokio::time::sleep_until(tokio::time::Instant::from_std(control.deadline()))=>Err(stopped(control)),
+        _=control.cancelled()=>Err(stopped(control)),
+        result=&mut flight=>result,
+    };
+    // No receipt can release caller custody until the IO/authorization future
+    // has actually been destroyed, including cancellation and deadline races.
+    drop(flight);
+    if !control.current() {
+        return Err(stopped(control));
+    }
+    match result {
+        Ok(()) if io.written() => Ok(()),
+        Ok(()) => Err(OwnedRtpError::Refused),
+        Err(_) if control.inner.started() => Err(OwnedRtpError::OutcomeUnknown),
+        result => result,
+    }
+}
