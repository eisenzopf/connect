+    /// A reviewed immediate primary-audio write, validated without enqueueing.
+    /// NACK/repair/paced media is not admitted by this first owned RTP profile.
+    pub fn prepare_owned_rtp(&mut self, mut packet: rtp::Packet) -> Result<(rtp::Packet, u32)> {
+        use crate::rtp_transceiver::RTCRtpTransceiverDirection::{Sendonly, Sendrecv};
+        let transceiver = &self.peer_connection.rtp_transceivers[self.id.0];
+        if !matches!(transceiver.direction(), Sendonly | Sendrecv)
+            || !matches!(transceiver.current_direction(), Sendonly | Sendrecv)
+        {
+            return Err(Error::ErrRTPTransceiverCodecUnsupported);
+        }
+        if packet.payload.is_empty() || packet.payload.len() > 1600 || packet.header.version != 2 {
+            return Err(Error::ErrRTPTransceiverCodecUnsupported);
+        }
+        let sender = self.peer_connection.rtp_transceivers[self.id.0]
+            .sender_mut()
+            .as_mut()
+            .ok_or(Error::ErrSenderWithNoSSRCs)?;
+        if !sender
+            .track()
+            .ssrcs()
+            .any(|ssrc| ssrc == packet.header.ssrc)
+        {
+            return Err(Error::ErrSenderWithNoSSRCs);
+        }
+        let parameters = sender.get_parameters(&mut self.peer_connection.media_engine);
+        let codec = parameters
+            .rtp_parameters
+            .codecs
+            .iter()
+            .find(|c| c.payload_type == packet.header.payload_type)
+            .ok_or(Error::ErrRTPTransceiverCodecUnsupported)?;
+        let mime = &codec.rtp_codec.mime_type;
+        if !(mime.eq_ignore_ascii_case("audio/PCMU") || mime.eq_ignore_ascii_case("audio/PCMA"))
+            || codec.rtp_codec.clock_rate != 8000
+            || codec.rtp_codec.channels != 1
+            || codec
+                .rtp_codec
+                .rtcp_feedback
+                .iter()
+                .any(|f| f.typ != "transport-cc" || !f.parameter.is_empty())
+        {
+            return Err(Error::ErrRTPTransceiverCodecUnsupported);
+        }
+        let clock = codec.rtp_codec.clock_rate;
+        bind_outbound_packet_to_encoding(
+            &mut packet,
+            &parameters.rtp_parameters.codecs,
+            &parameters.encodings,
+        )?;
+        Ok((packet, clock))
+    }
