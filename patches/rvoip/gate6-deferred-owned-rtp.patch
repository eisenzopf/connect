+    /// Own a deferred primary RTP job before asynchronous track/queue admission.
+    /// The producer runs only in the driver and must supply one authorized packet.
+    pub fn owned_rtp(
+        &self,
+        producer: std::sync::Arc<dyn super::owned_rtp::OwnedRtpProducer>,
+        deadline: std::time::Instant,
+    ) -> super::owned_rtp::OwnedRtpWrite {
+        use super::owned_rtp::*;
+        let control = OwnedRtpControl::new(deadline);
+        let lifetime = control.clone();
+        let track = self.clone();
+        let task = tokio::spawn(async move {
+            if !lifetime.claim() {
+                return Receipt::not_submitted(OwnedRtpError::Refused);
+            }
+            let deadline = tokio::time::Instant::from_std(lifetime.deadline());
+            let context = match tokio::time::timeout_at(deadline, track.ctx.lock()).await {
+                Ok(context) => context.clone(),
+                Err(_) => return Receipt::not_submitted(stopped(&lifetime)),
+            };
+            let Some(context) = context else {
+                return Receipt::not_submitted(OwnedRtpError::NotReady);
+            };
+            if !lifetime.current() {
+                return Receipt::not_submitted(stopped(&lifetime));
+            }
+            let (completion, receipt) = tokio::sync::oneshot::channel();
+            let request = OwnedRtpRequest {
+                producer,
+                control: lifetime.clone(),
+                completion,
+            };
+            let queued = tokio::time::timeout_at(
+                deadline,
+                context
+                    .driver_event_tx
+                    .send(PeerConnectionDriverEvent::OwnedRtp(
+                        context.rtp_sender_id,
+                        request,
+                    )),
+            )
+            .await;
+            match queued {
+                Ok(Ok(())) => {}
+                _ => return Receipt::not_submitted(stopped(&lifetime)),
+            }
+            // Once queued, retain the ORIGINAL driver receipt even after the
+            // frame deadline/caller cancellation. Only the driver can confirm
+            // that its callback and actual IO future have both been destroyed.
+            match receipt.await {
+                Ok(result) => Receipt {
+                    delivery: result,
+                    drained: true,
+                },
+                Err(_) => Receipt {
+                    delivery: Err(OwnedRtpError::OutcomeUnknown),
+                    drained: false,
+                },
+            }
+        });
+        OwnedRtpWrite::new(control, task)
+    }
