+    async fn handle_owned_rtp(
+        &mut self,
+        sender: RTCRtpSenderId,
+        request: crate::media_stream::track_local::owned_rtp::OwnedRtpRequest,
+    ) {
+        use crate::media_stream::track_local::owned_rtp::*;
+        let OwnedRtpRequest {
+            producer,
+            control,
+            completion,
+        } = request;
+        let inner = self.inner.clone();
+        let ready =
+            tokio::time::timeout_at(tokio::time::Instant::from_std(control.deadline()), async {
+                let mut core = inner.core.lock().await;
+                if !control.current() {
+                    return Err(stopped(&control));
+                }
+                if !core.supports_owned_dtmf_io() {
+                    return Err(OwnedRtpError::Unsupported);
+                }
+                if !core.owned_dtmf_io_ready() {
+                    return Err(OwnedRtpError::NotReady);
+                }
+                if let Some(prior) = core.poll_write() {
+                    self.deferred_transmits.push_back(prior);
+                    return Err(OwnedRtpError::NotReady);
+                }
+                Ok(())
+            })
+            .await
+            .unwrap_or_else(|_| Err(stopped(&control)));
+        let result = match ready {
+            Err(error) => Err(error),
+            Ok(()) => {
+                let mut io = RtpIo {
+                    driver: self,
+                    sender,
+                    control: &control,
+                    attempted: false,
+                    written: false,
+                };
+                complete(producer.as_ref(), &mut io, &control).await
+            }
+        };
+        // `complete` destroys the producer's future (and hence Core guards)
+        // before this exact original receipt is acknowledged.
+        let _ = completion.send(result);
+    }
