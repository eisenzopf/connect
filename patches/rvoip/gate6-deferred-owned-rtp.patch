+struct RtpIo<'a, I: Interceptor + 'static> {
+    driver: &'a mut PeerConnectionDriver<I>,
+    sender: RTCRtpSenderId,
+    control: &'a crate::media_stream::track_local::owned_rtp::OwnedRtpControl,
+    attempted: bool,
+    written: bool,
+}
+#[async_trait::async_trait]
+impl<I: Interceptor + 'static> crate::media_stream::track_local::owned_rtp::OwnedRtpIo
+    for RtpIo<'_, I>
+{
+    fn written(&self) -> bool {
+        self.written
+    }
+    async fn write(&mut self, packet: rtp::Packet) -> Result<()> {
+        if self.attempted {
+            return Err(Error::ErrConnectionClosed);
+        }
+        self.attempted = true;
+        let inner = self.driver.inner.clone();
+        let (fact, output) = {
+            let mut core = inner.core.lock().await;
+            if !self.control.current() || !core.owned_dtmf_io_ready() {
+                return Err(Error::ErrConnectionClosed);
+            }
+            if let Some(prior) = core.poll_write() {
+                self.driver.deferred_transmits.push_back(prior);
+                return Err(Error::ErrConnectionClosed);
+            }
+            let mut sender = core
+                .rtp_sender(self.sender)
+                .ok_or(Error::ErrConnectionClosed)?;
+            let (packet, _) = sender.prepare_owned_rtp(packet)?;
+            let fact = packet.clone();
+            if !self.control.begin() {
+                return Err(Error::ErrConnectionClosed);
+            }
+            sender.write_rtp(packet)?;
+            let mut output = Vec::new();
+            while let Some(message) = core.poll_write() {
+                output.push(message);
+            }
+            (fact, output)
+        };
+        if output.len() != 1 {
+            return Err(Error::ErrConnectionClosed);
+        }
+        let message = output
+            .into_iter()
+            .next()
+            .ok_or(Error::ErrConnectionClosed)?;
+        let bytes = &message.message;
+        if bytes.len() < 12
+            || bytes[0] >> 6 != 2
+            || bytes[1] & 127 != fact.header.payload_type
+            || (bytes[1] & 128 != 0) != fact.header.marker
+            || u16::from_be_bytes([bytes[2], bytes[3]]) != fact.header.sequence_number
+            || u32::from_be_bytes(bytes[4..8].try_into().unwrap()) != fact.header.timestamp
+            || u32::from_be_bytes(bytes[8..12].try_into().unwrap()) != fact.header.ssrc
+            || !self.control.current()
+        {
+            return Err(Error::ErrConnectionClosed);
+        }
+        let address = self
+            .driver
+            .advertised_to_socket
+            .get(&message.transport.local_addr)
+            .copied()
+            .unwrap_or(message.transport.local_addr);
+        let socket = self
+            .driver
+            .sockets
+            .get(&address)
+            .ok_or(Error::ErrConnectionClosed)?;
+        let written = socket
+            .send_to(bytes, message.transport.peer_addr)
+            .await
+            .map_err(|_| Error::ErrConnectionClosed)?;
+        if written != bytes.len() {
+            return Err(Error::ErrConnectionClosed);
+        }
+        self.written = true;
+        Ok(())
+    }
+}
