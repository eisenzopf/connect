+async fn gate_reply(s: &mut Scene, request: Value, kind: &str) -> Envelope {
+    let original = request.clone();
+    let id = request["id"].clone();
+    s.wire.send(s.f.sign(request)).await;
+    let reply = s.wire.read().await;
+    assert_eq!(reply.kind(), kind, "{reply:?}");
+    s.f.verify_server(&reply).await;
+    // Early authority refusal need not correlate an unaccepted invocation.
+    if kind == "ack" || reply.scope(Scope::Reply).is_some() {
+        assert_eq!(reply.original()["in_reply_to"], id);
+    }
+    if kind == "ack" {
+        for field in ["cid", "sid", "connid", "operation_id"] {
+            assert_eq!(reply.original()[field], original[field]);
+        }
+    }
+    reply
+}
+struct GatePair {
+    s: Scene,
+    other: Wire,
+    ah: u16,
+    bh: u16,
+    ai: mpsc::Receiver<MediaPacket>,
+    bi: mpsc::Receiver<MediaPacket>,
+}
+impl GatePair {
+    async fn new(kind: &str) -> Self {
+        let mut s = Scene::new(kind, false).await;
+        let mut other = s.second_wire().await;
+        let (a, ca) = s.prepared(lifecycle_offer(&s, 0, 0, "sendrecv")).await;
+        s.confirm(&ca).await;
+        s.wait(1).await;
+        let (b, cb) = other_prepared(&s, &mut other, lifecycle_offer(&s, 1, 0, "sendrecv")).await;
+        other.send(s.f.sign(s.confirmation(&cb))).await;
+        s.wait(2).await;
+        let ah = a.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+            .as_u64()
+            .unwrap() as u16;
+        let bh = b.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+            .as_u64()
+            .unwrap() as u16;
+        let ai = s
+            .controller()
+            .take_ingress(&StreamId::from_string("first"))
+            .unwrap();
+        let bi = s.native.adapters[&s.kind]
+            .media_controller(&s.second_id)
+            .unwrap()
+            .take_ingress(&StreamId::from_string("first"))
+            .unwrap();
+        Self {
+            s,
+            other,
+            ah,
+            bh,
+            ai,
+            bi,
+        }
+    }
+    fn bc(&self) -> Arc<StreamController> {
+        self.s.native.adapters[&self.s.kind]
+            .media_controller(&self.s.second_id)
+            .unwrap()
+    }
+    async fn playback(&mut self, n: u16) {
+        send(&self.other, audio_sequence(self.bh, n));
+        packet(&mut self.bi)
+            .await
+            .try_forward_to(&self.s.controller(), &StreamId::from_string("first"))
+            .unwrap();
+        let output = received(&self.s.wire).await;
+        assert_eq!(output.stream_local_id, self.ah);
+        decoded(&output);
+    }
+}
