+fn gate_command(
+    action: &str,
+    revision: u64,
+    streams: Option<&[&str]>,
+    details: Option<Value>,
+) -> Value {
+    let mut payload = json!({"action":action});
+    if let Some(ids) = streams {
+        payload["streams"] = json!(ids);
+    }
+    if let Some(details) = details {
+        payload["details"] = details;
+    }
+    let mut request = envelope("connection.update", payload);
+    request["cid"] = json!("conversation");
+    request["sid"] = json!("session");
+    request["connid"] = json!("native_0");
+    request["operation_id"] = json!(format!("gate_{}", uuid::Uuid::new_v4().simple()));
+    request["expected_revision"] = json!(revision);
+    request
