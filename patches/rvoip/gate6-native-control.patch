+//! Native runtime gates applied to one authenticated Connection update.
+//! A result is a historical local graph commit, not a durable operation receipt.
+use super::{
+    auth_dispatch::AuthorizedEnvelope, native_negotiation::NativeOfferError, payloads::*, Envelope,
+    Scope,
+};
+use rvoip_core::{ids::StreamId, stream_lifecycle::*};
+use std::collections::BTreeSet;
+#[derive(Clone)]
+pub struct NativeControlPlan {
+    expected: u64,
+    streams: BTreeSet<StreamId>,
+    action: StreamGateAction,
+}
+impl NativeControlPlan {
+    pub fn expected_revision(&self) -> u64 {
+        self.expected
+    }
+    pub fn streams(&self) -> &BTreeSet<StreamId> {
+        &self.streams
+    }
+    pub fn action(&self) -> StreamGateAction {
+        self.action
+    }
+    pub(crate) fn parse(
+        e: &Envelope,
+        bindings: &[ReadyMediaBinding],
+    ) -> Result<Self, NativeOfferError> {
+        let Payload::ConnectionUpdate(update) = e.payload() else {
+            return Err(NativeOfferError::Unsupported);
+        };
+        let expected = e.expected_revision().ok_or(NativeOfferError::Invalid)?;
+        if update.action == ConnectionUpdateAction::CodecRenegotiate {
+            return Err(NativeOfferError::Unsupported);
+        }
+        if e.scope(Scope::Operation).is_none()
+            || e.scope(Scope::Reply).is_some()
+            || update.codec_preferences.is_some()
+        {
+            return Err(NativeOfferError::Invalid);
+        }
+        let action = match update.action {
+            ConnectionUpdateAction::Hold => {
+                // Directions describe the requesting endpoint, as in offers.
+                let direction = match update.details.as_ref() {
+                    None => StreamDirection::Send,
+                    Some(v) if v.as_object().is_some_and(|v| v.len() == 1) => {
+                        match v.get("direction").and_then(serde_json::Value::as_str) {
+                            Some("sendonly") => StreamDirection::Receive,
+                            Some("recvonly") => StreamDirection::Send,
+                            _ => return Err(NativeOfferError::Invalid),
+                        }
+                    }
+                    _ => return Err(NativeOfferError::Invalid),
+                };
+                StreamGateAction::Hold { direction }
+            }
+            ConnectionUpdateAction::Resume if update.details.is_none() => StreamGateAction::Resume,
+            ConnectionUpdateAction::Mute if update.details.is_none() => StreamGateAction::Mute,
+            ConnectionUpdateAction::Unmute if update.details.is_none() => StreamGateAction::Unmute,
+            ConnectionUpdateAction::CodecRenegotiate => return Err(NativeOfferError::Unsupported),
+            _ => return Err(NativeOfferError::Invalid),
+        };
+        let mut streams = BTreeSet::new();
+        match &update.streams {
+            Some(ids) if !ids.is_empty() && ids.len() <= 32 => {
+                for id in ids {
+                    if id.is_empty() || id.len() > 128 || !streams.insert(StreamId::from_string(id))
+                    {
+                        return Err(NativeOfferError::Invalid);
+                    }
+                }
+            }
+            None if matches!(
+                action,
+                StreamGateAction::Hold { .. } | StreamGateAction::Resume
+            ) =>
+            {
+                streams.extend(
+                    bindings
+                        .iter()
+                        .map(|b| b.negotiated.requested.logical_id.clone()),
+                )
+            }
+            _ => return Err(NativeOfferError::Invalid),
+        }
+        if streams.is_empty() {
+            return Err(NativeOfferError::NotReady);
+        }
+        if streams.iter().any(|id| {
+            !bindings
+                .iter()
+                .any(|b| &b.negotiated.requested.logical_id == id)
+        }) {
+            return Err(NativeOfferError::NotReady);
+        }
+        Ok(Self {
+            expected,
+            streams,
+            action,
+        })
+    }
+}
+pub struct NativeControlOutcome {
+    pub revision: u64,
+    pub streams: Vec<LogicalStream>,
+}
+impl std::fmt::Debug for NativeControlOutcome {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeControlOutcome")
+            .field("revision", &self.revision)
+            .field("streams", &self.streams.len())
+            .finish()
+    }
+}
+pub(crate) fn scope_matches(
+    a: &AuthorizedEnvelope,
+    scope: &crate::staged_media::StagedRtpScope,
+) -> bool {
+    a.supports_native_negotiation()
+        && a.envelope().kind() == "connection.update"
+        && scope.wire_conversation.is_some()
+        && a.envelope().scope(Scope::Conversation) == scope.wire_conversation.as_deref()
+        && a.envelope().scope(Scope::Session) == Some(scope.wire_session.as_str())
+        && a.envelope().scope(Scope::Connection) == Some(scope.wire_connection.as_str())
+}
