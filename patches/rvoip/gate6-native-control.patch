+    pub async fn set_media_gate_with_held(
+        &self,
+        expected: u64,
+        ids: &BTreeSet<StreamId>,
+        action: StreamGateAction,
+        deadline: tokio::time::Instant,
+        held: Arc<dyn Any + Send + Sync>,
+    ) -> ControlResult<(u64, Vec<LogicalStream>)> {
+        let credential = self.credential_snapshot();
+        let control = self.policy.current_control(
+            &self.scope(&credential.principal, MediaPurpose::Control),
+            &MediaControlIntent::Gate {
+                expected,
+                streams: ids,
+                action,
+            },
+            held.as_ref(),
+        )?;
+        self.set_media_gate_inner(expected, ids, action, deadline, credential, Some(control))
+            .await
+    }
+    async fn set_media_gate_inner(
+        &self,
+        expected: u64,
+        ids: &BTreeSet<StreamId>,
+        action: StreamGateAction,
+        deadline: tokio::time::Instant,
+        credential: CredentialSnapshot,
+        control: Option<MediaControl>,
+    ) -> ControlResult<(u64, Vec<LogicalStream>)> {
+        let deadline = Self::command_deadline(&credential.principal, deadline)
+            .min(control.as_ref().map_or(deadline, |c| c.deadline));
+        let cancelled = control
+            .as_ref()
+            .map(|c| c.cancellation.clone())
+            .unwrap_or_default();
+        if deadline <= tokio::time::Instant::now() {
+            return Err(StreamControlError::Deadline);
+        }
+        let _flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        self.check_credential_snapshot(&credential)?;
+        let ports = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(&credential.principal, MediaPurpose::Control);
+            let lease = control_read(self.policy.as_ref(), &scope, control.as_ref())?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            if state.closed || self.shutdown.is_cancelled() || !auth.may_control {
+                return Err(StreamControlError::Authority);
+            }
+            state
+                .model
+                .validate_gate(&auth.current(), expected, ids, action)?;
+            ids.iter()
+                .map(|id| {
+                    state
+                        .active
+                        .get(id)
+                        .cloned()
+                        .ok_or(StreamControlError::NotReady)
+                })
+                .collect::<ControlResult<Vec<_>>>()?
+        };
+        let mut quiesced = Vec::with_capacity(ports.len());
+        for port in &ports {
+            let old = port.ticket();
+            let next = old.stage().ok_or(MediaTransitionError::Capacity)?;
+            let drained = tokio::select! {biased;_=cancelled.cancelled()=>return Err(StreamControlError::Cancelled),_=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),r=tokio::time::timeout_at(deadline,old.quiesce())=>r.map_err(|_|StreamControlError::Deadline)?.ok_or(StreamControlError::NotReady)?};
+            quiesced.push((old, next, drained));
+        }
+        let outcome = {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = self.scope(&credential.principal, MediaPurpose::Control);
+            let lease = control_read(self.policy.as_ref(), &scope, control.as_ref())?;
+            let auth = lease.authority();
+            Self::check(&scope, auth)?;
+            if state.closed || self.shutdown.is_cancelled() || cancelled.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(StreamControlError::Deadline);
+            }
+            let changed = state
+                .model
+                .set_gates(&auth.current(), expected, ids, action)?;
+            for (port, (old, next, _)) in ports.iter().zip(&quiesced) {
+                assert!(
+                    next.commit_from(old),
+                    "private gate generation changed outside controller"
+                );
+                *port.ticket.lock().unwrap_or_else(|p| p.into_inner()) = next.clone();
+                let logical = state
+                    .model
+                    .streams()
+                    .get(&port.binding.negotiated.requested.logical_id)
+                    .expect("active gated stream");
+                port.state.lock().unwrap_or_else(|p| p.into_inner()).status =
+                    if logical.state == LogicalStreamState::Paused {
+                        PortStatus::Paused
+                    } else {
+                        PortStatus::Active
+                    };
+            }
+            (state.model.revision(), changed)
+        };
+        drop(quiesced);
+        Ok(outcome)
     }
