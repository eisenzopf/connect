+    let mut s = Scene::new("quic", false).await;
+    let (_, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendrecv")).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let original = s.controller().active_bindings();
+    let mut requests = vec![
+        gate_command("mute", 0, Some(&["first"]), None),
+        gate_command("mute", 1, Some(&["first", "missing"]), None),
+        gate_command("mute", 1, Some(&["first", "first"]), None),
+        gate_command("hold", 1, None, Some(json!({"direction":"sendrecv"}))),
+    ];
+    let mut wrong = gate_command("mute", 1, Some(&["first"]), None);
+    wrong["sid"] = json!("foreign");
+    requests.push(wrong);
+    let mut wrong = gate_command("mute", 1, Some(&["first"]), None);
+    wrong["payload"]["codec_preferences"] = json!(["pcmu"]);
+    requests.push(wrong);
+    let mut codec = gate_command("codec-renegotiate", 1, Some(&["first"]), None);
+    codec["payload"]["codec_preferences"] = json!(["pcma"]);
