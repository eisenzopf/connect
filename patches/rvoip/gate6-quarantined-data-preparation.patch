+#[tokio::test]
+async fn endpoint_preparation_allows_quarantined_data_with_video_and_preserves_its_gate() {
+    let mut room = Room::new().await;
+    room.add_owned_with_media(
+        "fresh",
+        "fresh",
+        owner("fresh"),
+        true,
+        None,
+        vec![
+            desired(Medium::Audio),
+            desired(Medium::Video),
+            desired(Medium::Data),
+        ],
+    )
+    .await;
+    let id = ConnectionId::from_string("fresh");
+    room.domain
+        .local_preparations
+        .lock()
+        .unwrap()
+        .insert(id.clone(), "prepare-fresh".into());
+    let video = room.nodes["fresh"].adapter.port(Medium::Video);
+    assert!(
+        video.try_publish(&frame(&video, 1)).is_err(),
+        "muted preparation published video"
+    );
+    let preparation = room
+        .scene
+        .prepare_audio_endpoint(&id, "prepare-fresh")
+        .expect(
+            "one duplex audio port plus separately muted video must permit decoder-only readiness",
+        );
+    assert!(!preparation.has_duplex_io());
+    {
+        let controller = &room.nodes["fresh"].controller;
+        let state = controller.state.lock().unwrap();
+        assert_eq!(state.active.len(), 3);
+        let data = &state.model.streams()[&desired(Medium::Data).logical_id];
+        assert!(data.source_muted);
+        assert_eq!(data.state, LogicalStreamState::Active);
+        assert!(data.hold_direction.is_none());
+    }
+    room.publish("fresh", 12000).unwrap();
+    room.tick();
+    room.silent(&["alice", "bob", "public", "hold", "fresh"]);
+    assert!(
+        video.try_publish(&frame(&video, 2)).is_err(),
+        "audio proof opened a video route"
+    );
+    drop(preparation);
+    assert!(
+        video.try_publish(&frame(&video, 3)).is_err(),
+        "dropping preparation opened video"
+    );
+    {
+        let state = room.nodes["fresh"].controller.state.lock().unwrap();
+        assert!(state.model.streams()[&desired(Medium::Data).logical_id].source_muted);
+    }
+}
