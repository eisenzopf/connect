+#[tokio::test]
+async fn endpoint_preparation_data_unmute_hold_retire_or_removed_port_invalidates_audio_readiness()
+{
+    for change in ["unmute", "hold", "retire", "remove"] {
+        let mut room = Room::new().await;
+        room.add_owned_with_media(
+            "fresh",
+            "fresh",
+            owner("fresh"),
+            true,
+            None,
+            vec![
+                desired(Medium::Audio),
+                desired(Medium::Video),
+                desired(Medium::Data),
+            ],
+        )
+        .await;
+        let id = ConnectionId::from_string("fresh");
+        room.domain
+            .local_preparations
+            .lock()
+            .unwrap()
+            .insert(id.clone(), "prepare-fresh".into());
+        let preparation = room
+            .scene
+            .prepare_audio_endpoint(&id, "prepare-fresh")
+            .unwrap();
+        let mut target = Target {
+            room,
+            preparation,
+            operation: "prepare-fresh".into(),
+        };
+        target.room.publish("fresh", 12000).unwrap();
+        target.queue();
+        target.room.heard("fresh", 0).await;
+        assert!(target.preparation.has_duplex_io());
+        let controller = &target.room.nodes["fresh"].controller;
+        let before = target
+            .room
+            .scene
+            .replacement_endpoint_stamp(target.preparation.audience())
+            .unwrap();
+        let removed = if change == "remove" {
+            Some(
+                controller
+                    .state
+                    .lock()
+                    .unwrap()
+                    .active
+                    .remove(&desired(Medium::Data).logical_id)
+                    .unwrap(),
+            )
+        } else {
+            None
+        };
+        if change == "remove" {
+            assert!(removed.is_some());
+        } else if change == "retire" {
+            target.room.nodes["fresh"]
+                .adapter
+                .port(Medium::Data)
+                .report_terminal()
+                .unwrap();
+        } else {
+            controller
+                .set_media_gate(
+                    controller.revision(),
+                    &BTreeSet::from([desired(Medium::Data).logical_id]),
+                    if change == "hold" {
+                        StreamGateAction::Hold {
+                            direction: StreamDirection::Receive,
+                        }
+                    } else {
+                        StreamGateAction::Unmute
+                    },
+                    deadline(),
+                )
+                .await
+                .unwrap();
+        }
+        assert!(!target.preparation.has_duplex_io());
+        assert!(target
+            .room
+            .scene
+            .replacement_endpoint_stamp(target.preparation.audience())
+            .is_err());
+        assert!(
+            before.check().is_err(),
+            "stale Data resource permitted a replacement readiness stamp"
+        );
+        assert!(
+            target.room.publish("fresh", 12000).is_err(),
+            "invalid Data quarantine accepted fresh preparation audio"
+        );
+    }
+}
