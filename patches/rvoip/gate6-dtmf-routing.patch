+//! Caller-owned signal routing. Engine ownership and bridge metadata are data;
+//! the host supplies independent current source/recipient permission per write.
+use super::*;
+use crate::dtmf::{
+    validate_dtmf_sequence, DtmfIoFence, DtmfIoPoll, DtmfWriteAuthority, DtmfWriteError,
+    DtmfWriteLease, DtmfWriteScope, DEFAULT_DTMF_INTER_DIGIT_MS, MAX_DTMF_SEQUENCE_MS,
+};
+use std::task::Poll;
+use tokio::time::Instant;
+pub const MAX_ACTIVE_DTMF_SEQUENCES: usize = 64;
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DtmfMethod {
+    Rfc4733,
+    Info,
+}
+#[derive(Clone, Eq, PartialEq)]
+pub struct DtmfIntent {
+    operation_id: String,
+    digits: String,
+    duration_ms: u32,
+    method: DtmfMethod,
+}
+impl DtmfIntent {
+    pub fn new(
+        operation_id: String,
+        digits: String,
+        duration_ms: u32,
+        method: DtmfMethod,
+    ) -> std::result::Result<Self, DtmfWriteError> {
+        if operation_id.is_empty()
+            || operation_id.len() > 128
+            || !operation_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        validate_dtmf_sequence(&digits, duration_ms, DEFAULT_DTMF_INTER_DIGIT_MS)
+            .map_err(|_| DtmfWriteError::Refused)?;
+        Ok(Self {
+            operation_id,
+            digits,
+            duration_ms,
+            method,
+        })
+    }
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+    pub fn digits(&self) -> &str {
+        &self.digits
+    }
+    pub fn duration_ms(&self) -> u32 {
+        self.duration_ms
+    }
+    pub fn method(&self) -> DtmfMethod {
+        self.method
+    }
+}
+impl std::fmt::Debug for DtmfIntent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfIntent(redacted)")
+    }
+}
+#[derive(Clone, Eq, PartialEq)]
+pub struct DtmfEndpoint {
+    tenant: TenantId,
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    participant: ParticipantId,
+    transport: Transport,
+    generation: u64,
+}
+impl DtmfEndpoint {
+    pub fn tenant(&self) -> &TenantId {
+        &self.tenant
+    }
+    pub fn conversation(&self) -> &ConversationId {
+        &self.conversation
+    }
+    pub fn session(&self) -> &SessionId {
+        &self.session
+    }
+    pub fn connection(&self) -> &ConnectionId {
+        &self.connection
+    }
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn transport(&self) -> Transport {
+        self.transport
+    }
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+}
+impl std::fmt::Debug for DtmfEndpoint {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfEndpoint(redacted)")
+    }
+}
+pub struct DtmfRouteScope<'a> {
+    pub source: &'a DtmfEndpoint,
+    pub recipient: &'a DtmfEndpoint,
+    pub intent: &'a DtmfIntent,
+}
+/// A physical source fence, never independent permission. Native composition
+/// retains its actual sealed origin here, without retaining an idle grant.
+/// Implementations must be bounded and must not reenter Core.
+pub trait DtmfSourceFence: Send + Sync {
+    fn current(&self) -> bool;
+}
+/// Must bind the authenticated actor, original operation/intent, both current
+/// relationship epochs and this exact packet. Reuse any actual held domain;
+/// never reacquire a reader behind its queued writer or cache idle permission.
+#[async_trait::async_trait]
+pub trait DtmfRoutePolicy: Send + Sync {
+    async fn acquire(
+        &self,
+        _route: &DtmfRouteScope<'_>,
+        _packet: &DtmfWriteScope<'_>,
+    ) -> std::result::Result<DtmfWriteLease, DtmfWriteError> {
+        Err(DtmfWriteError::Refused)
+    }
+}
+pub struct DenyDtmfRoutePolicy;
+#[async_trait::async_trait]
+impl DtmfRoutePolicy for DenyDtmfRoutePolicy {}
+#[derive(Clone)]
+pub struct DtmfRoute {
+    owner: Weak<Orchestrator>,
+    endpoints: [DtmfEndpoint; 2],
+    tickets: Vec<ConnectionLifecycleTicket>,
+    intent: DtmfIntent,
+    source_fences: Vec<Arc<dyn DtmfSourceFence>>,
+    slot: Arc<Semaphore>,
+}
+impl std::fmt::Debug for DtmfRoute {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfRoute(redacted)")
+    }
+}
+impl DtmfRoute {
+    pub fn source(&self) -> &DtmfEndpoint {
+        &self.endpoints[0]
+    }
+    pub fn recipient(&self) -> &DtmfEndpoint {
+        &self.endpoints[1]
+    }
+    pub fn intent(&self) -> &DtmfIntent {
+        &self.intent
+    }
+    pub fn with_source_fence(
+        mut self,
+        fence: Arc<dyn DtmfSourceFence>,
+    ) -> std::result::Result<Self, DtmfWriteError> {
+        if self.source_fences.len() >= 8 || !fence.current() || !self.current() {
+            return Err(DtmfWriteError::Refused);
+        }
+        self.source_fences.push(fence);
+        Ok(self)
+    }
+    pub fn current(&self) -> bool {
+        self.check_current().is_ok()
+    }
+    fn check_current(&self) -> std::result::Result<(), DtmfWriteError> {
+        match self.poll_bound(&mut || Poll::Ready(Ok(()))) {
+            Poll::Ready(result) => result,
+            Poll::Pending => Err(DtmfWriteError::NotReady),
+        }
+    }
+    fn poll_bound(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        let result = (|| -> std::result::Result<DtmfIoPoll, DtmfWriteError> {
+            if self.source_fences.iter().any(|f| !f.current()) {
+                return Err(DtmfWriteError::Refused);
+            }
+            let core = self.owner.upgrade().ok_or(DtmfWriteError::Refused)?;
+            if core
+                .connection_lifecycle_tasks
+                .draining
+                .load(Ordering::Acquire)
+            {
+                return Err(DtmfWriteError::Refused);
+            }
+            // No blocking acquisition or guard survives a Pending poll. The
+            // registry, exact incarnations and Session/Conversation readers
+            // serialize the actual IO poll with local ownership mutations.
+            let _registry = core
+                .connection_registry_lock
+                .try_lock()
+                .map_err(|_| DtmfWriteError::NotReady)?;
+            let mut lives = Vec::with_capacity(2);
+            for ticket in &self.tickets {
+                let current = core
+                    .connection_lifecycles
+                    .get(&ticket.connection_id)
+                    .ok_or(DtmfWriteError::Refused)?;
+                if !Arc::ptr_eq(current.value(), &ticket.state) {
+                    return Err(DtmfWriteError::Refused);
+                }
+                let life = ticket
+                    .state
+                    .try_lock()
+                    .map_err(|_| DtmfWriteError::NotReady)?;
+                if !life.active || life.retired || life.generation != ticket.generation {
+                    return Err(DtmfWriteError::Refused);
+                }
+                lives.push(life);
+            }
+            let sessions = self
+                .endpoints
+                .iter()
+                .map(|e| core.session(&e.session).ok_or(DtmfWriteError::Refused))
+                .collect::<std::result::Result<Vec<_>, _>>()?;
+            let conversations = self
+                .endpoints
+                .iter()
+                .map(|e| {
+                    core.conversation(&e.conversation)
+                        .ok_or(DtmfWriteError::Refused)
+                })
+                .collect::<std::result::Result<Vec<_>, _>>()?;
+            let mut session_guards = Vec::with_capacity(2);
+            let mut conversation_guards = Vec::with_capacity(2);
+            for ((endpoint, session), conversation) in
+                self.endpoints.iter().zip(&sessions).zip(&conversations)
+            {
+                let s = session.try_read().map_err(|_| DtmfWriteError::NotReady)?;
+                let c = conversation
+                    .try_read()
+                    .map_err(|_| DtmfWriteError::NotReady)?;
+                let entry = core
+                    .connections
+                    .get(&endpoint.connection)
+                    .ok_or(DtmfWriteError::Refused)?;
+                if s.state != SessionState::Active
+                    || s.conversation_id != endpoint.conversation
+                    || c.state != ConversationState::Open
+                    || c.tenant_id != endpoint.tenant
+                    || s.connections
+                        .get(&endpoint.connection)
+                        .is_none_or(|v| v.participant_id != endpoint.participant)
+                    || core.session_of(&endpoint.connection).as_ref() != Some(&endpoint.session)
+                    || entry.transport != endpoint.transport
+                    || entry.inbound_publication != InboundPublicationState::Published
+                    || !core
+                        .adapter(endpoint.transport)
+                        .map_err(|_| DtmfWriteError::NotReady)?
+                        .is_connection_live(&endpoint.connection)
+                {
+                    return Err(DtmfWriteError::Refused);
+                }
+                session_guards.push(s);
+                conversation_guards.push(c);
+            }
+            Ok(io())
+        })();
+        result.unwrap_or_else(|e| Poll::Ready(Err(e)))
+    }
+}
+struct IoFence {
+    route: DtmfRoute,
+    submitted: Arc<AtomicBool>,
+    deadline: Instant,
+    cancel: CancellationToken,
+}
+impl DtmfIoFence for IoFence {
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        if self.cancel.is_cancelled() || Instant::now() >= self.deadline {
+            return Poll::Ready(Err(DtmfWriteError::DeadlineBeforeWrite));
+        }
+        self.route.poll_bound(&mut || {
+            self.submitted.store(true, Ordering::Release);
+            io()
+        })
+    }
+}
+struct WritePolicy {
+    route: DtmfRoute,
+    host: Arc<dyn DtmfRoutePolicy>,
+    submitted: Arc<AtomicBool>,
+    deadline: Instant,
+    cancel: CancellationToken,
+}
+#[async_trait::async_trait]
+impl DtmfWriteAuthority for WritePolicy {
+    async fn acquire(
+        &self,
+        packet: &DtmfWriteScope<'_>,
+    ) -> std::result::Result<DtmfWriteLease, DtmfWriteError> {
+        if self.cancel.is_cancelled()
+            || Instant::now() >= self.deadline
+            || !self.route.current()
+            || packet.digits != self.route.intent.digits
+            || packet.duration_ms != self.route.intent.duration_ms
+            || packet.inter_digit_ms != DEFAULT_DTMF_INTER_DIGIT_MS
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        let scope = DtmfRouteScope {
+            source: self.route.source(),
+            recipient: self.route.recipient(),
+            intent: self.route.intent(),
+        };
+        let lease = self.host.acquire(&scope, packet).await?;
+        let route = self.route.clone();
+        let token = self.cancel.clone();
+        let deadline = self.deadline;
+        lease
+            .restrict((), move || {
+                !token.is_cancelled() && Instant::now() < deadline && route.current()
+            })
+            .with_fence(Arc::new(IoFence {
+                route: self.route.clone(),
+                submitted: self.submitted.clone(),
+                deadline: self.deadline,
+                cancel: self.cancel.clone(),
+            }))
+    }
+}
+impl Orchestrator {
+    /// Capture exact current local endpoints and immutable intent. These facts
+    /// grant nothing. The caller supplies current independent policy per write.
+    pub fn prepare_dtmf_route(
+        self: &Arc<Self>,
+        source: ConnectionId,
+        recipient: ConnectionId,
+        intent: DtmfIntent,
+    ) -> std::result::Result<DtmfRoute, DtmfWriteError> {
+        if source == recipient {
+            return Err(DtmfWriteError::Refused);
+        }
+        let _registry = self
+            .connection_registry_lock
+            .try_lock()
+            .map_err(|_| DtmfWriteError::NotReady)?;
+        let capture = |connection: ConnectionId| -> std::result::Result<
+            (DtmfEndpoint, ConnectionLifecycleTicket, Arc<Semaphore>),
+            DtmfWriteError,
+        > {
+            let entry = self
+                .connections
+                .get(&connection)
+                .ok_or(DtmfWriteError::NotReady)?;
+            if entry.inbound_publication != InboundPublicationState::Published {
+                return Err(DtmfWriteError::NotReady);
+            }
+            let state = self
+                .connection_lifecycles
+                .get(&connection)
+                .map(|v| v.value().clone())
+                .ok_or(DtmfWriteError::NotReady)?;
+            let live = state.try_lock().map_err(|_| DtmfWriteError::NotReady)?;
+            if !live.active || live.retired {
+                return Err(DtmfWriteError::Refused);
+            }
+            let sid = self
+                .session_of(&connection)
+                .ok_or(DtmfWriteError::NotReady)?;
+            let session = self.session(&sid).ok_or(DtmfWriteError::NotReady)?;
+            let session = session.try_read().map_err(|_| DtmfWriteError::NotReady)?;
+            if session.state != SessionState::Active {
+                return Err(DtmfWriteError::NotReady);
+            }
+            let binding = session
+                .connections
+                .get(&connection)
+                .ok_or(DtmfWriteError::NotReady)?;
+            let conversation = self
+                .conversation(&session.conversation_id)
+                .ok_or(DtmfWriteError::Refused)?;
+            let conversation = conversation
+                .try_read()
+                .map_err(|_| DtmfWriteError::NotReady)?;
+            if conversation.state != ConversationState::Open {
+                return Err(DtmfWriteError::Refused);
+            }
+            let endpoint = DtmfEndpoint {
+                tenant: conversation.tenant_id.clone(),
+                conversation: session.conversation_id.clone(),
+                session: sid,
+                connection: connection.clone(),
+                participant: binding.participant_id.clone(),
+                transport: entry.transport,
+                generation: live.generation,
+            };
+            let ticket = ConnectionLifecycleTicket {
+                connection_id: connection,
+                generation: live.generation,
+                state: state.clone(),
+            };
+            let slot = live
+                .dtmf_sequence
+                .get_or_init(|| Arc::new(Semaphore::new(1)))
+                .clone();
+            Ok((endpoint, ticket, slot))
+        };
+        let (source, a, _) = capture(source)?;
+        let (recipient, b, slot) = capture(recipient)?;
+        if source.tenant != recipient.tenant || source.conversation != recipient.conversation {
+            return Err(DtmfWriteError::Refused);
+        }
+        let mut tickets = vec![a, b];
+        tickets.sort_by(|a, b| a.connection_id.cmp(&b.connection_id));
+        Ok(DtmfRoute {
+            owner: Arc::downgrade(self),
+            endpoints: [source, recipient],
+            tickets,
+            intent,
+            source_fences: vec![],
+            slot,
+        })
+    }
+    /// One bounded, caller-owned schedule. No automatic retry or detached
+    /// forwarding. Success is local submission, not a remote tone receipt.
+    pub async fn route_dtmf(
+        self: &Arc<Self>,
+        route: &DtmfRoute,
+        host: Arc<dyn DtmfRoutePolicy>,
+        cancel: CancellationToken,
+        requested_deadline: Instant,
+    ) -> std::result::Result<(), DtmfWriteError> {
+        if route.owner.upgrade().is_none_or(|c| !Arc::ptr_eq(&c, self)) || cancel.is_cancelled() {
+            return Err(DtmfWriteError::Refused);
+        }
+        route.check_current()?;
+        if route.intent.method != DtmfMethod::Rfc4733 {
+            return Err(DtmfWriteError::Unsupported);
+        }
+        let deadline =
+            requested_deadline.min(Instant::now() + Duration::from_millis(MAX_DTMF_SEQUENCE_MS));
+        if Instant::now() >= deadline {
+            return Err(DtmfWriteError::DeadlineBeforeWrite);
+        }
+        let _capacity = self
+            .dtmf_slots
+            .try_acquire()
+            .map_err(|_| DtmfWriteError::NotReady)?;
+        let _target = route
+            .slot
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| DtmfWriteError::NotReady)?;
+        let submitted = Arc::new(AtomicBool::new(false));
+        let policy = Arc::new(WritePolicy {
+            route: route.clone(),
+            host,
+            submitted: submitted.clone(),
+            deadline,
+            cancel: cancel.clone(),
+        });
+        let adapter = self
+            .adapter(route.recipient().transport)
+            .map_err(|_| DtmfWriteError::Unsupported)?;
+        let mut send = Box::pin(adapter.send_dtmf_authorized(
+            route.recipient().connection.clone(),
+            &route.intent.digits,
+            route.intent.duration_ms,
+            policy,
+        ));
+        let mut probe = tokio::time::interval(Duration::from_millis(5));
+        probe.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        let result = loop {
+            tokio::select! {biased;
+                _=cancel.cancelled()=>break Err(DtmfWriteError::Refused),
+                _=tokio::time::sleep_until(deadline)=>break Err(DtmfWriteError::DeadlineBeforeWrite),
+                _=probe.tick()=>if !route.current(){break Err(DtmfWriteError::Refused)},
+                r=&mut send=>break r,
+            }
+        };
+        drop(send);
+        if result.is_err() && submitted.load(Ordering::Acquire) {
+            Err(DtmfWriteError::OutcomeUnknown)
+        } else {
+            result
+        }
+    }
+}
