+#[cfg(test)]
+mod poll_fence_tests {
+    use super::*;
+    use std::{
+        sync::{
+            atomic::{AtomicBool, AtomicUsize, Ordering},
+            Arc,
+        },
+        task::Poll,
+    };
+    struct Fence {
+        inside: Arc<AtomicBool>,
+        active: Arc<AtomicBool>,
+    }
+    impl DtmfIoFence for Fence {
+        fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+            if !self.active.load(Ordering::Acquire) {
+                return Poll::Ready(Err(DtmfWriteError::Refused));
+            }
+            assert!(!self.inside.swap(true, Ordering::AcqRel));
+            let result = io();
+            self.inside.store(false, Ordering::Release);
+            result
+        }
+    }
+    struct Policy {
+        fence: Arc<Fence>,
+        held: Arc<AtomicBool>,
+    }
+    struct Grant(Arc<AtomicBool>);
+    impl Drop for Grant {
+        fn drop(&mut self) {
+            self.0.store(false, Ordering::Release);
+        }
+    }
+    #[async_trait]
+    impl DtmfWriteAuthority for Policy {
+        async fn acquire(&self, _: &DtmfWriteScope<'_>) -> Result<DtmfWriteLease, DtmfWriteError> {
+            self.held.store(true, Ordering::Release);
+            DtmfWriteLease::new(
+                Grant(self.held.clone()),
+                Instant::now() + Duration::from_secs(1),
+                || true,
+            )
+            .restrict((), || true)
+            .with_fence(self.fence.clone())
+        }
+    }
+    #[tokio::test]
+    async fn synchronous_io_poll_fence_releases_on_pending_and_prevents_ready_io_after_retirement()
+    {
+        let inside = Arc::new(AtomicBool::new(false));
+        let active = Arc::new(AtomicBool::new(true));
+        let held = Arc::new(AtomicBool::new(false));
+        let polls = Arc::new(AtomicUsize::new(0));
+        let policy = Policy {
+            fence: Arc::new(Fence {
+                inside: inside.clone(),
+                active: active.clone(),
+            }),
+            held: held.clone(),
+        };
+        let scope = DtmfWriteScope {
+            digits: "1",
+            duration_ms: 40,
+            inter_digit_ms: 70,
+            digit_index: 0,
+            event: 1,
+            end_of_event: false,
+            duration_samples: 160,
+            timestamp: 1,
+            ssrc: 7,
+            payload_type: 110,
+            clock_rate_hz: 8000,
+            marker: true,
+        };
+        let count = polls.clone();
+        let inside_io = inside.clone();
+        let held_io = held.clone();
+        let io = std::future::poll_fn(move |cx| {
+            assert!(inside_io.load(Ordering::Acquire) && held_io.load(Ordering::Acquire));
+            let n = count.fetch_add(1, Ordering::AcqRel);
+            if n == 0 {
+                cx.waker().wake_by_ref();
+                Poll::Pending
+            } else {
+                Poll::Ready(Ok::<(), ()>(()))
+            }
+        });
+        let mut request = Box::pin(with_dtmf_write_authority(&policy, &scope, io));
+        // One manual poll reaches Pending actual IO under the synchronous fence.
+        std::future::poll_fn(|cx| {
+            assert!(request.as_mut().poll(cx).is_pending());
+            Poll::Ready(())
+        })
+        .await;
+        assert!(!inside.load(Ordering::Acquire));
+        assert!(held.load(Ordering::Acquire));
+        assert_eq!(polls.load(Ordering::Acquire), 1);
+        active.store(false, Ordering::Release);
+        assert_eq!(request.await, Err(DtmfWriteError::OutcomeUnknown));
+        assert_eq!(polls.load(Ordering::Acquire), 1);
+        assert!(!held.load(Ordering::Acquire));
+    }
