+/// A bounded synchronous fence around each actual IO future poll. It must
+/// invoke `io` at most once and must not retain it or reenter its owner. This
+/// lets a Core owner serialize a socket poll with synchronous retirement,
+/// without holding a non-Send mutex guard across suspension.
+pub type DtmfIoPoll = std::task::Poll<Result<(), DtmfWriteError>>;
+pub trait DtmfIoFence: Send + Sync {
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll;
+}
+fn poll_fences(
+    fences: &[std::sync::Arc<dyn DtmfIoFence>],
+    io: &mut dyn FnMut() -> DtmfIoPoll,
+) -> DtmfIoPoll {
+    match fences.split_first() {
+        Some((first, rest)) => first.poll(&mut || poll_fences(rest, io)),
+        None => io(),
+    }
+}
