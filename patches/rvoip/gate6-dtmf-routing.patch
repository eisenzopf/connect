+        packet: &DtmfWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        assert_eq!(route.source.connection(), &self.expected_source);
+        assert_eq!(route.recipient.connection(), &self.expected_target);
+        assert_eq!(route.intent.operation_id(), "stable-logical-operation");
+        assert_eq!(route.intent.method(), DtmfMethod::Rfc4733);
+        assert_eq!(packet.digits, route.intent.digits());
+        assert_eq!(packet.duration_ms, route.intent.duration_ms());
+        assert_eq!(packet.payload_type, 110);
+        assert_eq!(packet.ssrc, 0xcafebabe);
+        assert_eq!(packet.clock_rate_hz, 8000);
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        let guard = self.domain.clone().read_owned().await;
+        if !*guard {
+            return Err(DtmfWriteError::Refused);
