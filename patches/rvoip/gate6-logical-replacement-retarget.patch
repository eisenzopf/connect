+
+#[tokio::test]
+async fn replacement_distinct_route_account_follows_sealed_binding_and_logical_participant_intent_with_current_io(
+) {
+    let mut f = Move::with_route_actor(false, "sip-account").await;
+    assert!(!f.room.nodes["alice"]
+        .controller
+        .credential_snapshot()
+        .principal
+        .has_same_owner(
+            &f.room.nodes["device"]
+                .controller
+                .credential_snapshot()
+                .principal
+        ));
+    f.io().await;
+    f.confirm().await;
+    let plan = f.plan().unwrap();
+    let stale = f.plan().unwrap();
+    f.commit(plan).await.unwrap();
+    assert!(f.commit(stale).await.is_err());
+    assert!(f.room.publish("alice", 800).is_err());
+    f.room.publish("device", 5200).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 5200).await;
+    f.room.heard("public", 5200).await;
+    f.room.publish("other", 1800).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 1800).await;
+    f.room.heard("public", 1800).await;
+    f.room.publish("bob", 2400).unwrap();
+    f.room.tick();
+    f.room.heard("device", 2400).await;
+    f.room.heard("other", 2400).await;
+    // A retained Participant selector is not a cached physical grant.
+    f.room.domain.base.0.write().await.owners.remove("device");
+    assert!(f.room.publish("device", 5200).is_err());
+    f.room.publish("other", 1800).unwrap();
+    f.room.tick();
+    f.room.heard("public", 1800).await;
+}
