new file mode 100644
--- /dev/null
+++ b/crates/sip/rvoip-sip/src/adapter/initial_participant.rs
@@ -0,0 +1,224 @@
+//! Initial SIP media retains its actual outbound ticket's checked identity.
+use super::*;
+use rvoip_core::orchestrator::participant_control::OutboundParticipantPreparation;
+use rvoip_core::relationships::EndpointState;
+use rvoip_core::staged_streams::{
+    ControlResult, MediaPolicy, StagedMediaAdapter, StreamControlError, StreamController,
+    StreamHandleAllocator,
+};
+
+/// Constructed by the installed adapter from a live Core-owned initial ticket.
+/// No replacement/source/retained connection is invented for an initial call.
+pub struct SipInitialParticipantContext {
+    inner: Arc<Context>,
+}
+pub(super) struct Context {
+    adapter: Weak<SipAdapter>,
+    route: Weak<SipOutboundRoute>,
+    prepared: Arc<OutboundParticipantPreparation>,
+    media_started: AtomicBool,
+    media: OnceLock<ManagedMedia>,
+}
+struct ManagedMedia {
+    bridge: Arc<crate::media_stream::guarded::SipGuardedMedia>,
+    controller: Arc<StreamController>,
+}
+impl fmt::Debug for SipInitialParticipantContext {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SipInitialParticipantContext(redacted)")
+    }
+}
+impl Context {
+    fn route_current(&self) -> bool {
+        if !self.prepared.is_current() {
+            return false;
+        }
+        let Some(adapter) = self.adapter.upgrade() else {
+            return false;
+        };
+        let Some(route) = self.route.upgrade() else {
+            return false;
+        };
+        let Some(handle) = route.lifecycle_handle() else {
+            return false;
+        };
+        let epoch = SipRouteEpoch {
+            session_id: route.session_id.clone(),
+            connection_id: route.connection_id.clone(),
+            owner: SipRouteEpochOwner::Admitted(handle),
+        };
+        let _mapping = adapter
+            .mapping_lock
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        route.is_publicly_live()
+            && adapter.epoch_is_current_locked(&epoch)
+            && adapter
+                .outbound_routes
+                .get(&route.connection_id)
+                .is_some_and(|r| Arc::ptr_eq(r.value(), &route))
+            && route
+                .initial_participant
+                .get()
+                .is_some_and(|c| std::ptr::eq(self, c.as_ref()))
+    }
+}
+impl SipAdapter {
+    /// Install initial guarded media only after this actual ticket's signaling
+    /// activation. Exact target, owner and lifecycle remain independently checked
+    /// by Core and by the host's current media policy. Installation is once-only.
+    pub fn initial_participant_context(
+        self: &Arc<Self>,
+        prepared: Arc<OutboundParticipantPreparation>,
+    ) -> CoreResult<Arc<SipInitialParticipantContext>> {
+        let endpoint = prepared.endpoint();
+        validate_sip_principal_at(prepared.principal(), Utc::now())
+            .map_err(|_| RvoipError::AdmissionRejected("initial SIP principal refused"))?;
+        if !prepared.is_current()
+            || !prepared.belongs_to_adapter(self.as_ref())
+            || endpoint.transport() != Transport::Sip
+            || endpoint.state() != EndpointState::Verified
+            || prepared.principal().method == rvoip_core::identity::AuthenticationMethod::Anonymous
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "initial SIP preparation refused",
+            ));
+        }
+        let route = self
+            .outbound_routes
+            .get(prepared.binding().connection())
+            .map(|r| r.value().clone())
+            .ok_or(RvoipError::InvalidState("initial SIP route unavailable"))?;
+        if route.target != endpoint.address()
+            || route.replacement.get().is_some()
+            || route.lifecycle_handle().is_none()
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "initial SIP route does not match prepared endpoint",
+            ));
+        }
+        let context = Arc::new(Context {
+            adapter: Arc::downgrade(self),
+            route: Arc::downgrade(&route),
+            prepared,
+            media_started: AtomicBool::new(false),
+            media: OnceLock::new(),
+        });
+        route
+            .initial_participant
+            .set(context.clone())
+            .map_err(|_| RvoipError::InvalidState("initial SIP context already installed"))?;
+        if !context.route_current() {
+            return Err(RvoipError::InvalidState("initial SIP route retired"));
+        }
+        Ok(Arc::new(SipInitialParticipantContext { inner: context }))
+    }
+    pub(super) fn initial_participant_controller(
+        &self,
+        id: &ConnectionId,
+    ) -> Option<Arc<StreamController>> {
+        self.outbound_routes
+            .get(id)?
+            .initial_participant
+            .get()?
+            .media
+            .get()
+            .map(|m| m.controller.clone())
+    }
+    pub(super) fn initial_participant_media(
+        &self,
+        id: &ConnectionId,
+    ) -> Option<Arc<dyn StagedMediaAdapter>> {
+        self.outbound_routes
+            .get(id)?
+            .initial_participant
+            .get()?
+            .media
+            .get()
+            .map(|m| m.bridge.clone() as Arc<dyn StagedMediaAdapter>)
+    }
+}
+impl SipInitialParticipantContext {
+    /// Actual negotiated route metadata only; it grants no media publication.
+    pub fn negotiated_audio_codec(&self) -> CoreResult<rvoip_core::capability::CodecInfo> {
+        if !self.inner.route_current() {
+            return Err(RvoipError::InvalidState("initial SIP route retired"));
+        }
+        let route = self
+            .inner
+            .route
+            .upgrade()
+            .ok_or(RvoipError::InvalidState("initial SIP route retired"))?;
+        if !route.stream.source_ready() {
+            return Err(RvoipError::InvalidState("initial SIP media unavailable"));
+        }
+        Ok(route.stream.codec())
+    }
+    /// The supplied policy must derive this exact original binding and current
+    /// endpoint/media authority from the actual held host invocation. This does
+    /// not create streams or assert readiness; their negotiation remains explicit.
+    pub fn prepare_media_controller(
+        &self,
+        policy: Arc<dyn MediaPolicy>,
+        opened_limit: usize,
+        held: &(dyn std::any::Any + Send + Sync),
+    ) -> ControlResult<Arc<StreamController>> {
+        if !self.inner.route_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        if self.inner.media_started.swap(true, Ordering::AcqRel) {
+            return Err(StreamControlError::NotReady);
+        }
+        let adapter = self
+            .inner
+            .adapter
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let route = self
+            .inner
+            .route
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let prepared = &self.inner.prepared;
+        let weak = Arc::downgrade(&self.inner);
+        let current = Arc::new(move || weak.upgrade().is_some_and(|c| c.route_current()));
+        let bridge = crate::media_stream::guarded::SipGuardedMedia::new(
+            route.stream.clone(),
+            (
+                prepared.member().conversation().clone(),
+                prepared.appearance().session().clone(),
+                prepared.binding().connection().clone(),
+            ),
+            prepared.binding().generation(),
+            current,
+            prepared.cancellation(),
+            adapter.retained_tasks.clone(),
+        );
+        let controller = StreamController::with_held_control(
+            prepared.member().conversation().clone(),
+            prepared.appearance().session().clone(),
+            prepared.binding().connection().clone(),
+            prepared.principal().clone(),
+            policy,
+            bridge.clone(),
+            Arc::new(StreamHandleAllocator::default()),
+            1,
+            opened_limit,
+            prepared.cancellation(),
+            held,
+        )?;
+        if !controller.is_bound_to_outbound(prepared) {
+            controller.retire();
+            return Err(StreamControlError::Authority);
+        }
+        bridge.bind_controller(&controller)?;
+        self.inner
+            .media
+            .set(ManagedMedia {
+                bridge,
+                controller: controller.clone(),
+            })
+            .map_err(|_| StreamControlError::NotReady)?;
+        Ok(controller)
+    }
+}
