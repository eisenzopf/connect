+++ b/crates/foundation/rvoip-core/src/orchestrator/participant_control/outbound.rs
@@ -0,0 +1,381 @@
+//! Owned initial SIP activation and checked admission. No native/replacement proof.
+use super::*;
+use crate::relationships::{ConnectionBinding, SessionAppearance};
+
+/// Created only from an actual Core-owned provisional outbound ticket and its
+/// installed participant policy. Adapters may retain its resource identity; it
+/// is not a current authorization grant or a readiness observation.
+pub struct OutboundParticipantPreparation {
+    owner: Weak<Orchestrator>,
+    adapter: Weak<dyn ConnectionAdapter>,
+    pub(super) shared: Arc<PreparedOutboundShared>,
+    lifecycle: ConnectionLifecycleTicket,
+    principal: AuthenticatedPrincipal,
+    mutation: ParticipantMutation,
+    member: Membership,
+    endpoint: EndpointBinding,
+    appearance: SessionAppearance,
+    binding: ConnectionBinding,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl OutboundParticipantPreparation {
+    /// Exact adapter owner; this never conveys current write authority.
+    pub fn belongs_to_adapter(&self, adapter: &dyn ConnectionAdapter) -> bool {
+        self.adapter
+            .upgrade()
+            .is_some_and(|owned| std::ptr::addr_eq(owned.as_ref(), adapter))
+    }
+    pub fn binding(&self) -> &ConnectionBinding {
+        &self.binding
+    }
+    pub fn appearance(&self) -> &SessionAppearance {
+        &self.appearance
+    }
+    pub fn endpoint(&self) -> &EndpointBinding {
+        &self.endpoint
+    }
+    pub fn member(&self) -> &Membership {
+        &self.member
+    }
+    pub fn principal(&self) -> &AuthenticatedPrincipal {
+        &self.principal
+    }
+    pub fn cancellation(&self) -> CancellationToken {
+        self.cancellation.clone()
+    }
+
+    /// Resource liveness only. Every signaling/media write still needs a fresh
+    /// host policy read. After admission the preparation deadline no longer
+    /// governs an established route's separately authorized lifetime.
+    pub fn is_current(&self) -> bool {
+        let decision = self.shared.decision.load(Ordering::Acquire);
+        matches!(
+            decision,
+            PREPARED_OUTBOUND_COMMITTING | PREPARED_OUTBOUND_COMMITTED
+        ) && (decision == PREPARED_OUTBOUND_COMMITTED
+            || tokio::time::Instant::now() < self.deadline)
+            && !self.cancellation.is_cancelled()
+            && !self.principal.is_expired()
+            && self.owner.strong_count() != 0
+            && self
+                .adapter
+                .upgrade()
+                .is_some_and(|adapter| adapter.is_connection_live(&self.lifecycle.connection_id))
+    }
+    // A provisional route is deliberately unavailable through Core's ordinary
+    // operational lookup. Only this exact live owned ticket can access it.
+    pub(super) fn adapter_for(
+        &self,
+        connection: &ConnectionId,
+    ) -> ControlResult<Arc<dyn ConnectionAdapter>> {
+        if connection != &self.lifecycle.connection_id || !self.is_current() {
+            return Err(ParticipantControlError::Authority);
+        }
+        self.adapter
+            .upgrade()
+            .ok_or(ParticipantControlError::Cancelled)
+    }
+    pub(super) fn require_invocation(
+        &self,
+        owner: &Arc<Orchestrator>,
+        session: &SessionId,
+        principal: &AuthenticatedPrincipal,
+        mutation: &ParticipantMutation,
+    ) -> ControlResult<()> {
+        if !self.is_current()
+            || !Weak::ptr_eq(&self.owner, &Arc::downgrade(owner))
+            || session != self.appearance.session()
+            || principal.ownership_key() != self.principal.ownership_key()
+            || principal.expires_at != self.principal.expires_at
+            || principal.scopes != self.principal.scopes
+            || principal.method != self.principal.method
+            || principal.assurance.kind() != self.principal.assurance.kind()
+            || mutation.operation_id != self.mutation.operation_id
+            || mutation.correlation_id != self.mutation.correlation_id
+            || mutation.expected_revision != self.mutation.expected_revision
+            || mutation.participant != self.mutation.participant
+            || mutation.change != self.mutation.change
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        owner.validate_connection_lifecycles(std::slice::from_ref(&self.lifecycle))?;
+        Ok(())
+    }
+    pub(super) fn require_authority(
+        &self,
+        scope: &ParticipantScope<'_>,
+        authority: &ParticipantAuthority,
+    ) -> ControlResult<()> {
+        let endpoint = authority
+            .endpoint
+            .as_ref()
+            .ok_or(ParticipantControlError::Authority)?;
+        if !self.is_current()
+            || scope.session != self.appearance.session()
+            || scope.conversation != self.member.conversation()
+            || scope
+                .connection_generation
+                .is_some_and(|v| v != self.lifecycle.generation)
+            || endpoint.endpoint() != self.endpoint.endpoint()
+            || endpoint.device() != self.endpoint.device()
+            || endpoint.identity() != self.endpoint.identity()
+            || endpoint.address() != self.endpoint.address()
+            || endpoint.state() != self.endpoint.state()
+            || endpoint.transport() != Transport::Sip
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        self.appearance
+            .require_current(&authority.target)
+            .map_err(ParticipantTransitionError::from)?;
+        self.binding
+            .require_current(&authority.target, &self.appearance)
+            .map_err(ParticipantTransitionError::from)?;
+        Ok(())
+    }
+}
+impl PreparedOutboundConnection {
+    /// Activate this one initial SIP route and transfer it into the installed
+    /// staged participant coordinator. The callback installs actual guarded
+    /// adapter media after signaling activation. It cannot replace the ticket,
+    /// actor, endpoint or mutation. Failure/cancellation/drop keep supervisor
+    /// cleanup ownership; no generic Session binding or native peer is minted.
+    /// The owned initial invocation and its control lease are dropped after
+    /// activation, before the callback. The host can record a captured remote
+    /// answer without retaining its transport read, then return a fresh owned
+    /// media/admission invocation. The two phases never borrow each other's grant.
+    pub async fn commit_staged_participant_with_held<F, Fut>(
+        mut self,
+        principal: AuthenticatedPrincipal,
+        mutation: ParticipantMutation,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+        held: Box<dyn Any + Send + Sync>,
+        prepare_media: F,
+    ) -> ControlResult<(ConnectionHandle, ParticipantObservation)>
+    where
+        F: FnOnce(Arc<OutboundParticipantPreparation>) -> Fut,
+        Fut: std::future::Future<Output = ControlResult<Arc<dyn Any + Send + Sync>>>,
+    {
+        self.cleanup
+            .shared
+            .decision
+            .compare_exchange(
+                PREPARED_OUTBOUND_PENDING,
+                PREPARED_OUTBOUND_COMMITTING,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .map_err(|_| ParticipantControlError::Cancelled)?;
+        let result = self
+            .commit_staged_inner(
+                principal,
+                mutation,
+                deadline,
+                cancellation,
+                held,
+                prepare_media,
+            )
+            .await;
+        if result.is_err() {
+            self.claim_committing_abort("checked outbound admission failed");
+            self.abort_committed_work().await;
+        }
+        result
+    }
+    async fn commit_staged_inner<F, Fut>(
+        &mut self,
+        principal: AuthenticatedPrincipal,
+        mutation: ParticipantMutation,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+        held: Box<dyn Any + Send + Sync>,
+        prepare_media: F,
+    ) -> ControlResult<(ConnectionHandle, ParticipantObservation)>
+    where
+        F: FnOnce(Arc<OutboundParticipantPreparation>) -> Fut,
+        Fut: std::future::Future<Output = ControlResult<Arc<dyn Any + Send + Sync>>>,
+    {
+        let owner = self
+            .orchestrator
+            .upgrade()
+            .ok_or(ParticipantControlError::Cancelled)?;
+        owner.ensure_operational_event_stream_healthy()?;
+        let ParticipantChange::Admit {
+            connection,
+            role_override,
+        } = &mutation.change
+        else {
+            return Err(ParticipantControlError::Authority);
+        };
+        if connection != self.connection_id()
+            || mutation.participant != self.participant_id
+            || self.transport() != Transport::Sip
+            || !self
+                .cleanup
+                .adapter
+                .lifecycle_capabilities()
+                .authoritative_liveness
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let runtime = owner.participant_runtime(&self.session_id)?;
+        if runtime.mixer.staged.is_none() {
+            return Err(ParticipantControlError::Unsupported);
+        }
+        let scope = ParticipantScope {
+            session: &self.session_id,
+            conversation: &runtime.conversation,
+            principal: &principal,
+            mutation: &mutation,
+            connection_generation: None,
+        };
+        let control = runtime.policy.current_control(&scope, held.as_ref())?;
+        let control_cancel = control.cancellation.clone();
+        let authority = control.current(&scope)?;
+        Orchestrator::check_participant_authority(&scope, &authority, false)?;
+        authority
+            .target
+            .revalidate_principal(&principal, Utc::now())
+            .map_err(|_| ParticipantControlError::Authority)?;
+        let endpoint = authority
+            .endpoint
+            .as_ref()
+            .ok_or(ParticipantControlError::Authority)?;
+        if endpoint.transport() != Transport::Sip || endpoint.address() != self.target {
+            return Err(ParticipantControlError::Authority);
+        }
+        let mut deadline = deadline.min(control.deadline);
+        if let Some(expiry) = principal_expiry(&principal) {
+            let remaining = expiry - Utc::now();
+            if remaining <= chrono::Duration::zero() {
+                return Err(ParticipantControlError::Authority);
+            }
+            deadline =
+                deadline.min(tokio::time::Instant::now() + remaining.to_std().unwrap_or_default());
+        }
+        invocation_current(&cancellation, Some(&control), None, deadline)?;
+        let pending = {
+            let state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state.ended || state.controller.revision() != mutation.expected_revision {
+                return Err(ParticipantTransitionError::Conflict.into());
+            }
+            if state
+                .controller
+                .replay(&authority.actor, &authority.target, &mutation)?
+                .is_some()
+            {
+                return Err(ParticipantTransitionError::Conflict.into());
+            }
+            state.controller.prepare_admission(
+                &authority.target,
+                endpoint,
+                connection.clone(),
+                role_override.clone(),
+            )?
+        };
+        // Reserve this Session's physical route quota before signaling IO. The
+        // admission candidate consumes the same slot instead of reserving twice.
+        let slot = runtime
+            .slots
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| ParticipantTransitionError::Capacity)?;
+        *self
+            .cleanup
+            .shared
+            .participant_permit
+            .lock()
+            .unwrap_or_else(|p| p.into_inner()) = Some(slot);
+        let prepared = Arc::new(OutboundParticipantPreparation {
+            owner: Arc::downgrade(&owner),
+            adapter: Arc::downgrade(&self.cleanup.adapter),
+            shared: self.cleanup.shared.clone(),
+            lifecycle: self.cleanup.lifecycle.clone(),
+            principal: principal.clone(),
+            mutation: mutation.clone(),
+            member: authority.target.clone(),
+            endpoint: endpoint.clone(),
+            appearance: pending.appearance().clone(),
+            binding: pending.binding().clone(),
+            cancellation: cancellation.clone(),
+            deadline,
+        });
+        prepared.require_invocation(&owner, &self.session_id, &principal, &mutation)?;
+        let activation = tokio::select! { biased;
+            _=cancellation.cancelled()=>return Err(ParticipantControlError::Cancelled),
+            _=control_cancel.cancelled()=>return Err(ParticipantControlError::Cancelled),
+            _=self.wait_for_abort()=>return Err(ParticipantControlError::Cancelled),
+            value=tokio::time::timeout_at(deadline, self.cleanup.adapter.activate_outbound_with_receipt(connection.clone()))=>value.map_err(|_|ParticipantControlError::Deadline)??,
+        };
+        invocation_current(&cancellation, Some(&control), None, deadline)?;
+        prepared.require_invocation(&owner, &self.session_id, &principal, &mutation)?;
+        drop(control);
+        drop(held);
+        let admission = tokio::select! { biased;
+            _=cancellation.cancelled()=>return Err(ParticipantControlError::Cancelled),
+            _=control_cancel.cancelled()=>return Err(ParticipantControlError::Cancelled),
+            _=self.wait_for_abort()=>return Err(ParticipantControlError::Cancelled),
+            value=tokio::time::timeout_at(deadline, prepare_media(prepared.clone()))=>value.map_err(|_|ParticipantControlError::Deadline)??,
+        };
+        prepared.require_invocation(&owner, &self.session_id, &principal, &mutation)?;
+        let observation = owner
+            .change_participant_internal(
+                &self.session_id,
+                principal,
+                mutation,
+                deadline,
+                cancellation,
+                None,
+                Some(admission.as_ref()),
+                false,
+                Some(&prepared),
+            )
+            .await?;
+        // From here the managed coordinator owns its actual slot and binding.
+        // Keep provisional supervisor ownership until its completion handshake.
+        self.cleanup.shared.published.store(true, Ordering::Release);
+        *self
+            .cleanup
+            .shared
+            .binding
+            .lock()
+            .unwrap_or_else(|p| p.into_inner()) = Some(ConnectionSessionBinding {
+            connection_id: self.connection_id().clone(),
+            session_id: self.session_id.clone(),
+            participant_id: self.participant_id.clone(),
+            lifecycle: self.cleanup.lifecycle.clone(),
+            inserted: true,
+            activated_session: false,
+        });
+        if owner.session_of(self.connection_id()).as_ref() != Some(&self.session_id) {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        owner.validate_connection_lifecycles(std::slice::from_ref(&self.cleanup.lifecycle))?;
+        owner.ensure_operational_event_stream_healthy()?;
+        let (completed, completion) = oneshot::channel();
+        self.supervisor
+            .send(PreparedOutboundSupervisorCommand::Complete {
+                key: self.cleanup.key.clone(),
+                completion: completed,
+            })
+            .await
+            .map_err(|_| ParticipantControlError::Cancelled)?;
+        if !completion.await.unwrap_or(false) {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        self.cleanup
+            .shared
+            .binding
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take();
+        let mut handle = self
+            .handle
+            .take()
+            .ok_or(ParticipantControlError::Cancelled)?;
+        handle.attach_outbound_activation(activation);
+        Ok((handle, observation))
+    }
+}
