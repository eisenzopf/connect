+    /// Close only the captured original allocation, even after its authority
+    /// or signaling lifetime expires. A replacement at the same ID cannot be
+    /// selected by this historical cleanup capability.
+    pub async fn end_original(
+        &self,
+        id: ConnectionId,
+        peer: &Arc<PeerAdmission>,
+        original: &Arc<RvoipPeerConnection>,
+        reason: EndReason,
+    ) -> Result<()> {
+        let Some(route) = self.routes.get(&id).map(|r| r.value().clone()) else {
+            return Ok(());
+        };
+        let same = Weak::ptr_eq(&route.peer, &Arc::downgrade(peer))
+            && route
+                .binding
+                .allocation
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .and_then(|f| f.peek())
+                .is_some_and(|r| r.as_ref().is_ok_and(|p| Arc::ptr_eq(p, original)));
+        if !same {
+            return Err(RvoipError::AdmissionRejected(
+                "Original WebRTC cleanup allocation differs",
+            ));
+        }
+        self.end_route(id, route, reason).await
+    }
+    async fn end_route(
+        &self,
+        id: ConnectionId,
+        route: Arc<Route>,
+        reason: EndReason,
+    ) -> Result<()> {
+        route.cancel.cancel();
+        let installation = route
+            .installation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .map(|i| (i.controller.clone(), i.backend.clone()));
+        // Parent transport destruction also resolves port IO whose original
+        // driver receipt was lost; outcome uncertainty remains historical.
+        route.binding.shutdown().await?;
+        if let Some((controller, backend)) = installation {
+            backend
+                .close()
+                .await
+                .map_err(|_| RvoipError::InvalidState("RTC port cleanup unconfirmed"))?;
+            if controller
+                .shutdown(tokio::time::Instant::now() + std::time::Duration::from_secs(1))
+                .await
+                != 0
+            {
+                return Err(RvoipError::InvalidState("RTC Core cleanup unconfirmed"));
+            }
+        }
+        self.capacity_release(&route.binding);
+        if self
+            .routes
+            .remove_if(&id, |_, r| Arc::ptr_eq(r, &route))
+            .is_some()
+        {
+            self.lifecycle
+                .queue_or_deliver_orchestrator_terminal(
+                    &self.events,
+                    AdapterEvent::Ended {
+                        connection_id: id,
+                        reason,
+                    },
+                )
+                .await;
+        }
+        Ok(())
+    }
