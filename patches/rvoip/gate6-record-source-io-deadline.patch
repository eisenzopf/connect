+#[tokio::test]
+async fn projection_io_deadline_uses_visible_live_content_and_the_original_control_bound() {
+    for exported_content in [true, false] {
+        let (record, _, participant, _) = fixture();
+        let now = Utc::now();
+        let mut sources = record.manifest().sources().to_vec();
+        for source in &mut sources {
+            if source.target() == RecordTarget::Dialog(0) {
+                // This private source is hidden from this actual viewer.
+                source.metadata_retention =
+                    RecordRetention::Until(now + chrono::Duration::seconds(1));
+                source.content_retention = source.metadata_retention;
+            }
+            if source.target() == RecordTarget::Dialog(1) {
+                source.metadata_retention =
+                    RecordRetention::Until(now + chrono::Duration::seconds(20));
+                source.content_retention = RecordRetention::Until(
+                    now + chrono::Duration::seconds(if exported_content { 4 } else { -1 }),
+                );
+            }
+        }
+        let record = VconRecord::new(
+            record.body().clone(),
+            RecordManifest::new("io-deadline-fixture".into(), sources).unwrap(),
+        )
+        .unwrap();
+        let scope = scope();
+        let store = MemoryVconStore::new();
+        let handle = store.put(&scope, record.clone()).await.unwrap();
+        let (control, _, _) = control(&record, scope.clone(), participant).await;
+        let projection =
+            RecordProjection::prepare(store.get(&scope, &handle).await.unwrap().unwrap(), control)
+                .unwrap();
+        let remaining = projection
+            .deadline()
+            .unwrap()
+            .saturating_duration_since(Instant::now());
+        if exported_content {
+            assert!(
+                remaining > Duration::from_secs(3) && remaining <= Duration::from_secs(4),
+                "visible content must clip IO before the ten-second control bound: {remaining:?}"
+            );
+        } else {
+            assert!(remaining > Duration::from_secs(9) && remaining <= Duration::from_secs(10), "expired unexported content and hidden sources cannot invalidate retained metadata: {remaining:?}");
+        }
+        assert!(projection.view().is_ok());
+    }
+}
