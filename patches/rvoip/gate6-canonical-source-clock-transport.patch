+//! Bounded clock-only RFC3550 compounds on the canonical RTP datagram profile.
+use bytes::{BufMut, Bytes, BytesMut};
+use rvoip_rtp_core::packet::rtcp::{RtcpCompoundMember, RtcpPacket, RtcpTolerantCompoundPacket};
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Report {
+    pub ssrc: u32,
+    pub ntp: u64,
+    pub rtp: u32,
+    pub packets: u32,
+    pub octets: u32,
+    pub cname: String,
+}
+fn valid_name(s: &str) -> bool {
+    !s.is_empty() && s.len() <= 255 && !s.chars().any(|c| c.is_ascii_control())
+}
+pub(crate) fn is_rtcp(bytes: &[u8]) -> bool {
+    bytes.len() >= 12
+        && bytes.len() <= 1188
+        && bytes[0] == 1
+        && bytes[2..4] != [0, 0]
+        && bytes[8] >> 6 == 2
+        && (192..=223).contains(&bytes[9])
+}
+pub(crate) fn parse(bytes: &[u8]) -> Option<(u16, Report)> {
+    if !is_rtcp(bytes) || bytes.len() < 48 || bytes[1] != 0 {
+        return None;
+    }
+    let data = &bytes[8..];
+    let mut offset = 0;
+    let mut count = 0;
+    while offset < data.len() {
+        if offset + 4 > data.len() || !(192..=223).contains(&data[offset + 1]) {
+            return None;
+        }
+        let len = (usize::from(u16::from_be_bytes([data[offset + 2], data[offset + 3]])) + 1) * 4;
+        offset = offset.checked_add(len)?;
+        count += 1;
+        if offset > data.len() || count > 16 {
+            return None;
+        }
+    }
+    let compound = RtcpTolerantCompoundPacket::parse(data).ok()?;
+    let RtcpCompoundMember::Known(RtcpPacket::SenderReport(sr)) = compound.packets.first()? else {
+        return None;
+    };
+    let mut cname = None;
+    let mut names = std::collections::BTreeSet::new();
+    for (index, member) in compound.packets.iter().enumerate() {
+        match member {
+            RtcpCompoundMember::Known(RtcpPacket::SenderReport(_)) if index != 0 => return None,
+            RtcpCompoundMember::Known(RtcpPacket::Goodbye(_)) => return None,
+            RtcpCompoundMember::Known(RtcpPacket::SourceDescription(sdes)) => {
+                for chunk in &sdes.chunks {
+                    for item in &chunk.items {
+                        if item.item_type == rvoip_rtp_core::packet::rtcp::RtcpSdesItemType::CName {
+                            if !valid_name(&item.value) || !names.insert(chunk.ssrc) {
+                                return None;
+                            }
+                            if chunk.ssrc == sr.ssrc {
+                                cname = Some(item.value.clone());
+                            }
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    Some((
+        u16::from_be_bytes([bytes[2], bytes[3]]),
+        Report {
+            ssrc: sr.ssrc,
+            ntp: sr.ntp_timestamp.to_u64(),
+            rtp: sr.rtp_timestamp,
+            packets: sr.sender_packet_count,
+            octets: sr.sender_octet_count,
+            cname: cname?,
+        },
+    ))
+}
+pub(crate) fn encode(handle: u16, seq: u32, report: &Report) -> Option<Bytes> {
+    if handle == 0 || !valid_name(&report.cname) {
+        return None;
+    }
+    let name = report.cname.as_bytes();
+    let sdes = (11 + name.len()).div_ceil(4) * 4;
+    let mut b = BytesMut::with_capacity(8 + 28 + sdes);
+    b.put_u8(1);
+    b.put_u8(0);
+    b.put_u16(handle);
+    b.put_u32(seq);
+    b.extend_from_slice(&[0x80, 200, 0, 6]);
+    b.put_u32(report.ssrc);
+    b.put_u64(report.ntp);
+    b.put_u32(report.rtp);
+    b.put_u32(report.packets);
+    b.put_u32(report.octets);
+    b.put_u8(0x81);
+    b.put_u8(202);
+    b.put_u16((sdes / 4 - 1) as u16);
+    b.put_u32(report.ssrc);
+    b.put_u8(1);
+    b.put_u8(name.len() as u8);
+    b.extend_from_slice(name);
+    b.resize(8 + 28 + sdes, 0);
+    Some(b.freeze())
+}
+pub(crate) fn now_ntp() -> u64 {
+    rvoip_rtp_core::packet::rtcp::NtpTimestamp::now().to_u64()
+}
+pub(crate) fn rtp_at(
+    ntp: u64,
+    anchor: rvoip_core::stream::MediaClockAnchor,
+    offset: u32,
+) -> Option<u32> {
+    if anchor.clock_rate == 0 {
+        return None;
+    }
+    let delta = ntp.wrapping_sub(anchor.ntp_time) as i64;
+    // Metadata outside a media lifetime is not a usable sampling clock.
+    if delta.unsigned_abs() > (10u64 << 32) {
+        return None;
+    }
+    let ticks = (i128::from(delta) * i128::from(anchor.clock_rate)).div_euclid(1i128 << 32);
+    Some(
+        anchor
+            .rtp_time
+            .wrapping_add(offset)
+            .wrapping_add(ticks as u32),
+    )
+}
+pub(crate) fn payload_octets(packet: &[u8]) -> Option<u32> {
+    if packet.len() < 20 {
+        return None;
+    }
+    let mut start = 20 + usize::from(packet[8] & 15) * 4;
+    if packet[8] & 16 != 0 {
+        let n = packet.get(start + 2..start + 4)?;
+        start += 4 + usize::from(u16::from_be_bytes([n[0], n[1]])) * 4;
+    }
+    let end = packet.len().checked_sub(if packet[8] & 32 != 0 {
+        usize::from(*packet.last()?)
+    } else {
+        0
+    })?;
+    u32::try_from(end.checked_sub(start)?).ok()
+}
