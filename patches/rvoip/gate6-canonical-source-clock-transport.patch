+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    fn yes() -> Current {
+        Arc::new(|| true)
+    }
+    fn report(ssrc: u32, ntp: u64, rtp: u32) -> Report {
+        Report {
+            ssrc,
+            ntp,
+            rtp,
+            packets: 1,
+            octets: 160,
+            cname: "same".into(),
+        }
+    }
+    #[test]
+    fn canonical_clock_binds_ssrc_and_one_common_offset_across_rates() {
+        let g = Group::new();
+        let a = g.track(1, 48000, yes()).unwrap();
+        let v = g.track(2, 90000, yes()).unwrap();
+        assert!(a.snapshot(10, yes()).unwrap().anchor.is_none());
+        assert!(a.report(report(10, 100u64 << 32, 48000), yes(), 200u64 << 32));
+        assert!(v.report(report(20, 101u64 << 32, 180000), yes(), 205u64 << 32));
+        let a = a.snapshot(10, yes()).unwrap();
+        let v = v.snapshot(20, yes()).unwrap();
+        assert_ne!(a.source_id, v.source_id);
+        assert_eq!(a.generation, v.generation);
+        assert_eq!(a.anchor.unwrap().ntp_time, 200u64 << 32);
+        assert_eq!(v.anchor.unwrap().ntp_time, 201u64 << 32);
+        assert!((a.is_current)());
+        assert!((v.is_current)());
+    }
+    #[test]
+    fn canonical_clock_never_revives_report_after_pause_or_old_ssrc() {
+        let g = Group::new();
+        let a = g.track(1, 8000, yes()).unwrap();
+        let live = Arc::new(AtomicBool::new(true));
+        let p: Current = {
+            let l = live.clone();
+            Arc::new(move || l.load(Ordering::Acquire))
+        };
+        a.snapshot(10, yes());
+        a.report(report(10, 100u64 << 32, 0), p, 200u64 << 32);
+        let held = a.snapshot(10, yes()).unwrap();
+        assert!((held.is_current)());
+        live.store(false, Ordering::Release);
+        assert!(!(held.is_current)());
+        assert!(a.snapshot(10, yes()).unwrap().anchor.is_none());
+        a.report(report(10, 101u64 << 32, 8000), yes(), 201u64 << 32);
+        let current = a.snapshot(10, yes()).unwrap();
+        assert!(current.anchor.is_some());
+        assert!(!(held.is_current)());
+        let changed = a.snapshot(11, yes()).unwrap();
+        assert!(changed.anchor.is_none());
+        assert_ne!(
+            changed.source_id, current.source_id,
+            "SSRC restart reused source incarnation"
+        );
+        assert!(!(current.is_current)());
+        drop(a);
+        assert!(!(changed.is_current)());
+    }
+    #[test]
+    fn canonical_clock_conflicting_identity_is_explicit_and_fences_all_tracks() {
+        let g = Group::new();
+        let a = g.track(1, 8000, yes()).unwrap();
+        let v = g.track(2, 90000, yes()).unwrap();
+        a.snapshot(10, yes());
+        v.snapshot(20, yes());
+        a.report(report(10, 100u64 << 32, 0), yes(), 200u64 << 32);
+        let old = a.snapshot(10, yes()).unwrap();
+        let mut conflict = report(20, 100u64 << 32, 0);
+        conflict.cname = "other".into();
+        assert!(!v.report(conflict, yes(), 200u64 << 32));
+        assert!(!(old.is_current)());
+        assert!(!a.snapshot(10, yes()).unwrap().supported);
+        assert!(v.snapshot(20, yes()).unwrap().anchor.is_none());
+    }
+    #[test]
+    fn canonical_clock_does_not_accept_duplicate_old_or_missing_reports_as_new_anchor() {
+        let g = Group::new();
+        let a = g.track(1, 8000, yes()).unwrap();
+        a.snapshot(10, yes());
+        assert!(a.report(report(10, 100u64 << 32, 0), yes(), 200u64 << 32));
+        assert!(!a.report(report(10, 100u64 << 32, 999), yes(), 201u64 << 32));
+        assert!(!a.report(report(10, 99u64 << 32, 999), yes(), 201u64 << 32));
+        assert_eq!(a.snapshot(10, yes()).unwrap().anchor.unwrap().rtp_time, 0);
+        assert!(a.report(report(10, 0, 0), yes(), 201u64 << 32));
+        assert!(a.snapshot(10, yes()).unwrap().anchor.is_none());
+    }
+}
