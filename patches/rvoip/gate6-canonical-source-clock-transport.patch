+    #[test]
+    fn clock_compound_requires_one_matching_identity_and_no_bye() {
+        let b = encode(7, 9, &report()).unwrap();
+        let mut foreign = b.to_vec();
+        foreign[40..44].copy_from_slice(&1u32.to_be_bytes());
+        assert!(parse(&foreign).is_none());
+        let mut duplicate = b.to_vec();
+        duplicate.extend_from_slice(&b[8..36]);
+        assert!(parse(&duplicate).is_none());
+        let mut bye = b.to_vec();
+        bye.extend_from_slice(&[0x81, 203, 0, 1, 0, 0, 0, 1]);
+        assert!(parse(&bye).is_none());
+        assert!(encode(0, 0, &report()).is_none());
+    }
+    #[test]
+    fn outgoing_sample_clock_preserves_wrap_and_refuses_distant_time() {
+        let a = rvoip_core::stream::MediaClockAnchor {
+            ntp_time: 100u64 << 32,
+            rtp_time: u32::MAX - 479,
+            clock_rate: 48000,
+        };
+        assert_eq!(rtp_at((100u64 << 32) + (1u64 << 32) / 50, a, 0), Some(479));
+        assert!(rtp_at(120u64 << 32, a, 0).is_none());
+    }
+}
