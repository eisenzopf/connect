+//! One canonical Connection's bounded sender clock. No queued grants or IO.
+use super::rtcp::Report;
+use rvoip_core::stream::{MediaClockAnchor, MediaSourceClock};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex},
+};
+type Current = Arc<dyn Fn() -> bool + Send + Sync>;
+struct Entry {
+    id: u128,
+    rate: u32,
+    ssrc: Option<u32>,
+    revision: u64,
+    alive: Current,
+    anchor: Option<MediaClockAnchor>,
+    report_current: Option<Current>,
+    last_ntp: Option<u64>,
+    pending: Option<(Report, Current, u64)>,
+}
+struct State {
+    entries: BTreeMap<u16, Entry>,
+    cname: Option<String>,
+    offset: Option<u64>,
+    generation: u64,
+    unsupported: bool,
+}
+pub(crate) struct Group {
+    state: Mutex<State>,
+    pub cname: String,
+}
+pub(crate) struct Track {
+    group: Arc<Group>,
+    handle: u16,
+}
+impl Group {
+    pub fn new() -> Arc<Self> {
+        let id = uuid::Uuid::new_v4();
+        Arc::new(Self {
+            cname: format!("connect-{id}"),
+            state: Mutex::new(State {
+                entries: BTreeMap::new(),
+                cname: None,
+                offset: None,
+                generation: 1,
+                unsupported: false,
+            }),
+        })
+    }
+    pub fn track(self: &Arc<Self>, handle: u16, rate: u32, alive: Current) -> Option<Track> {
+        let mut s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        s.entries.retain(|_, e| (e.alive)());
+        if handle == 0 || rate == 0 || s.entries.len() >= 256 || s.entries.contains_key(&handle) {
+            return None;
+        }
+        if s.entries.is_empty() {
+            s.generation = s.generation.checked_add(1)?;
+            s.cname = None;
+            s.offset = None;
+            s.unsupported = false;
+        }
+        s.entries.insert(
+            handle,
+            Entry {
+                id: uuid::Uuid::new_v4().as_u128(),
+                rate,
+                ssrc: None,
+                revision: 1,
+                alive,
+                anchor: None,
+                report_current: None,
+                last_ntp: None,
+                pending: None,
+            },
+        );
+        Some(Track {
+            group: self.clone(),
+            handle,
+        })
+    }
+}
+fn apply(s: &mut State, e: &mut Entry, r: Report, current: Current, receipt: u64) -> bool {
+    if !(current)() || !(e.alive)() {
+        return false;
+    }
+    if e.ssrc != Some(r.ssrc) {
+        e.pending = Some((r, current, receipt));
+        return true;
+    }
+    if r.ntp == 0 {
+        e.revision = e.revision.saturating_add(1);
+        e.anchor = None;
+        e.last_ntp = None;
+        e.report_current = Some(current);
+        return true;
+    }
+    if r.packets == 0
+        || e.last_ntp
+            .is_some_and(|old| (r.ntp.wrapping_sub(old) as i64) <= 0)
+    {
+        return false;
+    }
+    if s.cname.as_ref().is_some_and(|c| c != &r.cname) {
+        s.unsupported = true;
+        s.generation = s.generation.saturating_add(1);
+        for t in s.entries.values_mut() {
+            t.anchor = None;
+            t.pending = None;
+        }
+        e.anchor = None;
+        e.pending = None;
+        return false;
+    }
+    if s.unsupported {
+        return false;
+    }
+    s.cname.get_or_insert(r.cname);
+    let offset = *s.offset.get_or_insert_with(|| receipt.wrapping_sub(r.ntp));
+    e.anchor = Some(MediaClockAnchor {
+        ntp_time: r.ntp.wrapping_add(offset),
+        rtp_time: r.rtp,
+        clock_rate: e.rate,
+    });
+    e.last_ntp = Some(r.ntp);
+    e.report_current = Some(current);
+    true
+}
+impl Track {
+    pub fn report(&self, r: Report, current: Current, receipt: u64) -> bool {
+        let mut s = self.group.state.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(mut e) = s.entries.remove(&self.handle) else {
+            return false;
+        };
+        let result = apply(&mut s, &mut e, r, current, receipt);
+        s.entries.insert(self.handle, e);
+        result
+    }
+    pub fn snapshot(&self, ssrc: u32, current: Current) -> Option<MediaSourceClock> {
+        if !(current)() {
+            return None;
+        }
+        let mut s = self.group.state.lock().unwrap_or_else(|p| p.into_inner());
+        let mut e = s.entries.remove(&self.handle)?;
+        if !(e.alive)() {
+            s.entries.insert(self.handle, e);
+            return None;
+        }
+        if e.ssrc != Some(ssrc) {
+            if e.ssrc.is_some() {
+                e.id = uuid::Uuid::new_v4().as_u128();
+            }
+            e.ssrc = Some(ssrc);
+            e.revision = e.revision.checked_add(1)?;
+            e.anchor = None;
+            e.report_current = None;
+            e.last_ntp = None;
+            if let Some((report, report_current, receipt)) = e.pending.take() {
+                if report.ssrc == ssrc {
+                    apply(&mut s, &mut e, report, report_current, receipt);
+                }
+            }
+        }
+        let source_id = e.id;
+        let revision = e.revision;
+        let generation = s.generation;
+        let supported = !s.unsupported;
+        let anchor = e
+            .anchor
+            .filter(|_| e.report_current.as_ref().is_some_and(|c| c()));
+        let report_current = if anchor.is_some() {
+            e.report_current.clone()
+        } else {
+            None
+        };
+        s.entries.insert(self.handle, e);
+        let weak = Arc::downgrade(&self.group);
+        let handle = self.handle;
+        Some(MediaSourceClock {
+            source_id,
+            generation,
+            anchor,
+            supported,
+            rtp_offset: 0,
+            is_current: Arc::new(move || {
+                current()
+                    && report_current.as_ref().is_none_or(|c| c())
