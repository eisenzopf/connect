+fn source_clock_wire(handle: u16, ntp: u64, rtp: u32) -> Bytes {
+    use bytes::BufMut;
+    use rvoip_rtp_core::packet::rtcp::*;
+    let mut sr = RtcpSenderReport::new(17);
+    sr.ntp_timestamp = NtpTimestamp::from_u64(ntp);
+    sr.rtp_timestamp = rtp;
+    sr.sender_packet_count = 1;
+    sr.sender_octet_count = 160;
+    let mut c = RtcpCompoundPacket::new_with_sr(sr);
+    let mut chunk = RtcpSdesChunk::new(17);
+    chunk.add_item(RtcpSdesItem::cname("source-capture-clock".into()));
+    let mut sdes = RtcpSourceDescription::new();
+    sdes.add_chunk(chunk);
+    c.add_sdes(sdes);
+    let mut b = bytes::BytesMut::new();
+    b.put_u8(1);
+    b.put_u8(0);
+    b.put_u16(handle);
+    b.put_u32(7);
+    b.extend_from_slice(&c.serialize().unwrap());
+    b.freeze()
+}
+async fn raw_clock_output(w: &Wire) -> Bytes {
+    tokio::time::timeout(Duration::from_secs(2), async {
+        if let Some(wt) = &w.wt {
+            wt.read_datagram().await.unwrap()
+        } else {
+            w.quic.as_ref().unwrap().2.read_datagram().await.unwrap()
+        }
+    })
+    .await
+    .unwrap()
+}
+#[tokio::test]
+async fn actual_signed_native_clock_reports_cross_current_ingress_and_egress_without_readiness_or_idle_grants(
+) {
+    use rvoip_rtp_core::packet::rtcp::{
+        NtpTimestamp, RtcpCompoundMember, RtcpPacket, RtcpTolerantCompoundPacket,
+    };
+    for kind in ["quic", "wt"] {
+        let p=Pair::new(kind,json!([{"id":"sound","kind":"audio","direction":"sendrecv","codec_preferences":["pcmu"]}])).await;
+        let (ah, ap) = p.binding(true, "sound");
+        let (bh, _) = p.binding(false, "sound");
+        let logical = StreamId::from_string("sound");
+        let mut input = p.scene.controller().take_ingress(&logical).unwrap();
+        let before = p.source_peer.snapshot();
+        let ntp = NtpTimestamp::now().to_u64();
+        send(&p.scene.wire, source_clock_wire(ah, ntp, 800));
+        tokio::time::timeout(Duration::from_secs(2), async {
+            while p.source_peer.snapshot().clock_accepted == before.clock_accepted {
+                tokio::time::sleep(Duration::from_millis(1)).await;
+            }
+        })
+        .await
+        .unwrap();
+        let admitted_before = NtpTimestamp::now().to_u64();
+        assert_eq!(
+            p.source_peer.snapshot().ingress_accepted,
+            before.ingress_accepted,
+            "report counted as RTP"
+        );
+        assert!(
+            input.try_recv().is_err(),
+            "clock report enqueued media or fabricated readiness"
+        );
+        assert!(
+            p.scene.grants.0.try_write().is_ok(),
+            "clock metadata retained idle authority"
+        );
+        let body = Bytes::from(vec![0xff; 160]);
+        send(&p.scene.wire, audio_wire(ah, ap, 1, 0, body.clone()));
+        packet(&mut input)
+            .await
+            .try_forward_to(&p.target, &logical)
+            .unwrap();
+        let mut media = None;
+        let mut report = None;
+        for _ in 0..2 {
+            let b = raw_clock_output(&p.other).await;
+            assert_eq!(u16::from_be_bytes([b[2], b[3]]), bh);
+            if (192..=223).contains(&b[9]) {
+                let compound = RtcpTolerantCompoundPacket::parse(&b[8..]).unwrap();
+                let RtcpCompoundMember::Known(RtcpPacket::SenderReport(sr)) = &compound.packets[0]
+                else {
+                    panic!("missing SR");
+                };
+                assert_eq!((sr.sender_packet_count, sr.sender_octet_count), (1, 160));
+                assert_ne!(sr.ntp_timestamp.to_u64(), 0);
+                report = Some(sr.clone());
+            } else {
+                media = Some(observe_rtp_datagram(&b).unwrap());
+            }
+        }
+        let media = media.unwrap();
+        let report = report.unwrap();
+        assert_eq!(media.rtp.packet().payload, body);
+        assert_eq!(report.ssrc, media.rtp.packet().header.ssrc);
+        let capture = report.ntp_timestamp.to_u64().wrapping_sub(
+            ((u64::from(
+                report
+                    .rtp_timestamp
+                    .wrapping_sub(media.rtp.packet().header.timestamp),
+            )) << 32)
+                / 8000,
+        );
+        // The source SR samples RTP800 while this actual payload is RTP0.
+        // Preserve that100ms capture phase, independent of IO/admission age.
+        // The normalized report-time mapping must lie inside the observed
+        // before-send/after-admission interval, within one8kHz sample.
+        let report_time = capture.wrapping_add((800u64 << 32) / 8000);
+        let tolerance = ((1u64 << 32) / 8000 + 1) as i64;
+        assert!(
+            (report_time.wrapping_sub(ntp) as i64) >= -tolerance,
+            "capture phase precedes the actual report send interval"
+        );
+        assert!(
+            (admitted_before.wrapping_sub(report_time) as i64) >= -tolerance,
+            "capture phase was replaced by RTP delivery time"
+        );
+        assert!(p.scene.grants.0.try_write().is_ok());
+        let rejected = p.source_peer.snapshot().clock_rejected;
+        p.scene.grants.0.write().await.denied = true;
+        send(
+            &p.scene.wire,
+            source_clock_wire(ah, NtpTimestamp::now().to_u64(), 160),
+        );
+        tokio::time::timeout(Duration::from_secs(2), async {
+            while p.source_peer.snapshot().clock_rejected == rejected {
+                tokio::time::sleep(Duration::from_millis(1)).await;
+            }
+        })
+        .await
+        .unwrap();
+        assert!(input.try_recv().is_err());
+        p.no_output().await;
+        p.scene.grants.0.write().await.denied = false;
+        assert!(p.scene.grants.0.try_write().is_ok());
+        p.stop().await;
+    }
+}
