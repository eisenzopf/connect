+#[cfg(test)]
+mod retirement_tests {
+    use super::*;
+    #[tokio::test]
+    async fn beginning_shutdown_cancels_active_peer_lifetime_before_awaiting_join() {
+        let (sender, receiver) = tokio::sync::mpsc::channel::<()>(1);
+        let (observed, received) = tokio::sync::oneshot::channel();
+        let observed = Arc::new(std::sync::Mutex::new(Some(observed)));
+        let profile = ProfileServer::spawn(
+            receiver,
+            1,
+            move |_, lifetime| {
+                let observed = observed.clone();
+                async move {
+                    observed
+                        .lock()
+                        .unwrap()
+                        .take()
+                        .unwrap()
+                        .send(lifetime.clone())
+                        .unwrap();
+                    lifetime.cancelled().await;
+                    Ok(())
+                }
+            },
+            drop,
+        )
+        .unwrap();
+        sender.send(()).await.unwrap();
+        let lifetime = received.await.unwrap();
+        assert!(!lifetime.is_cancelled());
+        profile.begin_shutdown();
+        assert!(profile.is_draining());
+        assert!(
+            lifetime.is_cancelled(),
+            "retirement waited for an async shutdown poll"
+        );
+        tokio::time::timeout(std::time::Duration::from_secs(1), profile.shutdown())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(profile.stats().active_physical, 0);
+    }
+    #[tokio::test]
+    async fn admission_drain_retains_active_peer_until_explicit_retirement() {
+        let (sender, receiver) = tokio::sync::mpsc::channel::<()>(1);
+        let (observed, received) = tokio::sync::oneshot::channel();
+        let observed = Arc::new(std::sync::Mutex::new(Some(observed)));
+        let profile = ProfileServer::spawn(
+            receiver,
+            1,
+            move |_, lifetime| {
+                let observed = observed.clone();
+                async move {
+                    observed
+                        .lock()
+                        .unwrap()
+                        .take()
+                        .unwrap()
+                        .send(lifetime.clone())
+                        .unwrap();
+                    lifetime.cancelled().await;
+                    Ok(())
+                }
+            },
+            drop,
+        )
+        .unwrap();
+        sender.send(()).await.unwrap();
+        let lifetime = received.await.unwrap();
+        profile.begin_drain();
+        assert!(profile.is_draining());
+        assert!(
+            !lifetime.is_cancelled(),
+            "drain unexpectedly retired the existing peer"
+        );
+        profile.begin_shutdown();
+        assert!(lifetime.is_cancelled());
+        tokio::time::timeout(std::time::Duration::from_secs(1), profile.shutdown())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(profile.stats().active_physical, 0);
+    }
+}
