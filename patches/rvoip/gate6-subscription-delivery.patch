+//! Owned physical-incarnation subscription delivery; an origin is not authority.
+use super::*;
+
+#[derive(Clone)]
+pub struct SubscriptionOrigin {
+    origin: RequestOrigin,
+    conversation: String,
+    request: String,
+    end: Instant,
+    initial: std::sync::Weak<dyn std::any::Any + Send + Sync>,
+}
+impl SubscriptionOrigin {
+    /// The initial command guard has left the reliable writer. This weak fact
+    /// retains no old grant and cannot be upgraded by application callers.
+    pub fn is_ready(&self) -> bool {
+        self.initial.strong_count() == 0
+    }
+    pub fn deadline(&self) -> Instant {
+        self.end
+    }
+    pub fn terminal_deadline(&self) -> Instant {
+        self.origin.deadline
+    }
+    pub fn current(&self) -> bool {
+        !self.origin.lifetime.is_cancelled() && Instant::now() < self.origin.deadline
+    }
+    /// Retire only this registration, never its authenticated peer or successor.
+    pub fn retire(&self) {
+        self.origin.lifetime.cancel();
+    }
+    pub async fn retired(&self) {
+        self.origin.lifetime.cancelled().await;
+    }
+    pub(in crate::v2) fn incarnation(&self) -> uuid::Uuid {
+        self.origin.incarnation
+    }
+    pub(in crate::v2) fn cancellation(&self) -> CancellationToken {
+        self.origin.lifetime.clone()
+    }
+}
+impl fmt::Debug for SubscriptionOrigin {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SubscriptionOrigin(redacted)")
+    }
+}
+impl AuthorizedEnvelope {
+    /// Seal an explicitly installed live Conversation subscription on this
+    /// physical credential incarnation. This stores no invocation grant. Each
+    /// delivery must supply a new owned current-authority lease independently.
+    pub fn subscription_origin(
+        &self,
+        lease: Duration,
+    ) -> Result<SubscriptionOrigin, DispatchError> {
+        let super::super::Payload::ConversationSubscribe(input) = self.envelope.payload() else {
+            return Err(DispatchError::Unsupported);
+        };
+        if self.peer.is_none()
+            || input.live == Some(false)
+            || lease.is_zero()
+            || lease > Duration::from_secs(30)
+            || lease > Duration::from_secs(input.lease_seconds.unwrap_or(30))
+            || [
+                Scope::Session,
+                Scope::Connection,
+                Scope::Operation,
+                Scope::Reply,
+            ]
+            .iter()
+            .any(|scope| self.envelope.scope(*scope).is_some())
+        {
+            return Err(DispatchError::Unsupported);
+        }
+        let conversation = self
+            .envelope
+            .scope(Scope::Conversation)
+            .ok_or(DispatchError::ScopeDenied)?
+            .to_owned();
+        let expiry = super::super::auth_peer::effective_expiry(&self.principal)?;
+        let credential = Instant::now()
+            + expiry
+                .signed_duration_since(chrono::Utc::now())
+                .to_std()
+                .map_err(|_| DispatchError::Closed)?;
+        let end = (Instant::now() + lease)
+            .min(self.origin.deadline)
+            .min(credential);
+        let deadline = (end + Duration::from_secs(1)).min(credential);
+        if Instant::now() >= end || self.origin.lifetime.is_cancelled() {
+            return Err(DispatchError::Closed);
+        }
+        Ok(SubscriptionOrigin {
+            origin: RequestOrigin {
+                incarnation: self.origin.incarnation,
+                lifetime: self.origin.lifetime.child_token(),
+                deadline,
+            },
+            initial: Arc::downgrade(&self._lease._guard),
+            conversation,
+            request: self.envelope.id().into(),
+            end,
+        })
+    }
+}
+/// One bounded page and its new real delivery guard. The writer reports only
+/// local submission; the receiver's persisted cursor remains authoritative.
+pub struct HandlerDelivery {
+    origin: SubscriptionOrigin,
+    frames: Option<HandlerReplies>,
+    authority: Option<AuthorityLease>,
+    completion: Option<oneshot::Sender<Result<(), DispatchError>>>,
+}
+impl HandlerDelivery {
+    pub fn new(
+        origin: &SubscriptionOrigin,
+        frames: HandlerReplies,
+        authority: AuthorityLease,
+    ) -> Result<(Self, oneshot::Receiver<Result<(), DispatchError>>), DispatchError> {
+        if !origin.current() || !origin.is_ready() || !authority.current() {
+            return Err(DispatchError::Closed);
+        }
+        for envelope in frames.envelopes() {
+            if envelope.scope(Scope::Conversation) != Some(origin.conversation.as_str())
+                || envelope.scope(Scope::Reply) != Some(origin.request.as_str())
+                || !matches!(
+                    envelope.kind(),
+                    "conversation.event" | "conversation.snapshot" | "ack" | "error"
+                )
+                || (envelope.kind() == "conversation.event" && Instant::now() >= origin.end)
+            {
+                return Err(DispatchError::ReplyMismatch);
+            }
+        }
+        let (sender, receiver) = oneshot::channel();
+        Ok((
+            Self {
+                origin: origin.clone(),
+                frames: Some(frames),
+                authority: Some(authority),
+                completion: Some(sender),
+            },
+            receiver,
+        ))
+    }
+    pub(in crate::v2) fn into_parts(
+        mut self,
+    ) -> (
+        SubscriptionOrigin,
+        HandlerReplies,
+        AuthorityLease,
+        oneshot::Sender<Result<(), DispatchError>>,
+        Instant,
+    ) {
+        let deadline = if self
+            .frames
+            .as_ref()
+            .expect("one delivery")
+            .envelopes()
+            .iter()
+            .any(|frame| frame.kind() == "conversation.event")
+        {
+            self.origin.end
+        } else {
+            self.origin.terminal_deadline()
+        };
+        (
+            self.origin.clone(),
+            self.frames.take().expect("one delivery"),
+            self.authority.take().expect("owned authority"),
+            self.completion.take().expect("one completion"),
+            deadline,
+        )
+    }
+}
+impl Drop for HandlerDelivery {
+    fn drop(&mut self) {
+        if let Some(sender) = self.completion.take() {
+            let _ = sender.send(Err(DispatchError::Closed));
+        }
+    }
+}
+impl fmt::Debug for HandlerDelivery {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("HandlerDelivery(redacted)")
+    }
+}
