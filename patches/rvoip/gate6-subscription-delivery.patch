+#[derive(Default)]
+struct CaptureSubscription(parking_lot::Mutex<Option<SubscriptionOrigin>>);
+#[async_trait]
+impl AuthenticatedHandler for CaptureSubscription {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let origin = authorized.subscription_origin(Duration::from_secs(1))?;
+        *self.0.lock() = Some(origin);
+        let mut reply = envelope("ack", json!({}));
+        reply["cid"] = json!("conversation");
+        reply["in_reply_to"] = json!(authorized.envelope().id());
+        Envelope::from_value(reply).map_err(DispatchError::from)
+    }
+}
+fn subscription_request() -> Value {
+    let mut value = envelope(
+        "conversation.subscribe",
+        json!({"live":true,"lease_seconds":1}),
+    );
+    value["cid"] = json!("conversation");
+    value
+}
+fn subscription_fact(request: &Value) -> Envelope {
+    let mut value = envelope(
+        "conversation.event",
+        json!({"event_id":"retained-event","cursor":"opaque-cursor","kind":"changed","revision":1,"data":{}}),
+    );
+    value["cid"] = json!("conversation");
+    value["in_reply_to"] = request["id"].clone();
+    Envelope::from_value(value).unwrap()
+}
+struct DeliverOnce(parking_lot::Mutex<Option<HandlerDelivery>>);
+#[async_trait]
+impl AuthenticatedHandler for DeliverOnce {
+    async fn handle(&self, _: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+    async fn next_delivery(&self) -> Result<HandlerDelivery, DispatchError> {
+        let delivery = self.0.lock().take();
+        if let Some(delivery) = delivery {
+            Ok(delivery)
+        } else {
+            std::future::pending().await
+        }
+    }
+}
+struct BlockSubscriptionSink {
+    entered: Arc<Notify>,
+    writes: Arc<AtomicUsize>,
+}
+impl futures::Sink<Bytes> for BlockSubscriptionSink {
+    type Error = DispatchError;
+    fn poll_ready(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), DispatchError>> {
+        self.entered.notify_one();
+        std::task::Poll::Pending
+    }
+    fn start_send(self: std::pin::Pin<&mut Self>, _: Bytes) -> Result<(), DispatchError> {
+        self.writes.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }
+    fn poll_flush(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), DispatchError>> {
+        std::task::Poll::Pending
+    }
+    fn poll_close(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), DispatchError>> {
+        std::task::Poll::Ready(Ok(()))
+    }
+}
+#[tokio::test]
+async fn subscription_origin_outlives_only_its_handler_and_refuses_changed_scope_and_refresh_reuse()
+{
+    let f = Fixture::new();
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let capture = CaptureSubscription::default();
+    let request = subscription_request();
+    let initial = peer
+        .handle(&f.sign(request.clone()), &capture, deadline())
+        .await
+        .unwrap();
+    let old = capture.0.lock().take().unwrap();
+    assert!(old.current());
+    assert!(!old.is_ready());
+    let guard = f.policy.revoked.clone().read_owned().await;
+    assert!(matches!(
+        HandlerDelivery::new(
+            &old,
+            HandlerReplies::new(vec![subscription_fact(&request)]).unwrap(),
+            AuthorityLease::holding(guard)
+        ),
+        Err(DispatchError::Closed)
+    ));
+    drop(initial);
+    assert!(old.is_ready());
+    for field in ["cid", "in_reply_to"] {
+        let mut changed = subscription_fact(&request).original().clone();
+        changed[field] = json!("other");
+        let guard = f.policy.revoked.clone().read_owned().await;
+        assert!(matches!(
+            HandlerDelivery::new(
+                &old,
+                HandlerReplies::new(vec![Envelope::from_value(changed).unwrap()]).unwrap(),
+                AuthorityLease::holding(guard)
+            ),
+            Err(DispatchError::ReplyMismatch)
+        ));
+    }
+    f.policy.deny_refresh.store(true, Ordering::SeqCst);
+    assert!(peer
+        .handle(
+            &f.sign(envelope(
+                "auth.refresh",
+                json!({"method":"bearer","credential":"new"})
+            )),
+            &Handler::default(),
+            deadline()
+        )
+        .await
+        .is_err());
+    assert!(old.current());
+    f.policy.deny_refresh.store(false, Ordering::SeqCst);
+    drop(
+        peer.handle(
+            &f.sign(envelope(
+                "auth.refresh",
+                json!({"method":"bearer","credential":"new"}),
+            )),
+            &Handler::default(),
+            deadline(),
+        )
+        .await
+        .unwrap(),
+    );
+    assert!(!old.current());
+    let next = subscription_request();
+    drop(
+        peer.handle(&f.sign(next), &capture, deadline())
+            .await
+            .unwrap(),
+    );
+    let successor = capture.0.lock().take().unwrap();
+    old.retire();
+    assert!(successor.current());
+    assert!(!peer.cancellation().is_cancelled());
+}
+#[tokio::test]
+async fn subscription_foreign_physical_origin_is_never_submitted_and_completion_releases_real_guard(
+) {
+    let f = Fixture::new();
+    let mut first = f.peer();
+    let mut second = f.peer();
+    f.authenticate(&mut first, "old").await;
+    f.authenticate(&mut second, "old").await;
+    let capture = CaptureSubscription::default();
+    let request = subscription_request();
+    drop(
+        first
+            .handle(&f.sign(request.clone()), &capture, deadline())
+            .await
+            .unwrap(),
+    );
+    let origin = capture.0.lock().take().unwrap();
+    let guard = f.policy.revoked.clone().read_owned().await;
+    let (delivery, done) = HandlerDelivery::new(
+        &origin,
+        HandlerReplies::new(vec![subscription_fact(&request)]).unwrap(),
+        AuthorityLease::holding(guard),
+    )
+    .unwrap();
+    let handler = Arc::new(DeliverOnce(parking_lot::Mutex::new(Some(delivery))));
+    let stop = second.cancellation();
+    let writes = Arc::new(AtomicUsize::new(0));
+    let sink = BlockSubscriptionSink {
+        entered: Arc::new(Notify::new()),
+        writes: writes.clone(),
+    };
+    let job = tokio::spawn(async move {
+        second
+            .run_frames(
+                futures::stream::pending::<Result<Bytes, DispatchError>>(),
+                sink,
+                handler.as_ref(),
+            )
+            .await
+    });
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(1), done)
+            .await
+            .unwrap()
+            .unwrap(),
+        Err(DispatchError::Closed)
+    );
+    assert_eq!(writes.load(Ordering::SeqCst), 0);
+    let writer = tokio::time::timeout(Duration::from_secs(1), f.policy.revoked.write())
+        .await
+        .unwrap();
+    drop(writer);
+    stop.cancel();
+    let _ = job.await.unwrap();
+    assert!(origin.current());
+    assert!(!first.cancellation().is_cancelled());
+}
