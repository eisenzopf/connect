+    /// Bind declared wire/repair metadata once, without resetting report state
+    /// when the first media packet later opens the track.
+    pub(crate) fn bind_remote_codec(
+        &mut self,
+        interceptor: &mut I,
+        ssrc: SSRC,
+        codec: &RTCRtpCodecParameters,
+        parameters: &RTCRtpReceiveParameters,
+    ) {
+        // Bind the negotiated codec, including media-engine feedback. Codec
+        // preferences used by first-packet routing omit that merged metadata.
+        let codec = parameters
+            .rtp_parameters
+            .codecs
+            .iter()
+            .find(|candidate| {
+                candidate.payload_type == codec.payload_type
+                    && candidate
+                        .rtp_codec
+                        .mime_type
+                        .eq_ignore_ascii_case(&codec.rtp_codec.mime_type)
+            })
+            .unwrap_or(codec);
+        let coding = self
+            .track()
+            .codings()
+            .iter()
+            .find(|coding| coding.rtp_coding_parameters.ssrc == Some(ssrc));
+        let repair = coding
+            .and_then(|coding| coding.rtp_coding_parameters.rtx.as_ref())
+            .map(|rtx| rtx.ssrc);
+        let repair_pt =
+            find_rtx_payload_type(codec.payload_type, &parameters.rtp_parameters.codecs);
+        let info = create_stream_info(
+            ssrc,
+            repair.filter(|_| repair_pt.is_some()),
+            None,
+            codec.payload_type,
+            repair_pt.filter(|_| repair.is_some()),
+            None,
+            &codec.rtp_codec,
+            &parameters.rtp_parameters.header_extensions,
+        );
+        if self.bound_remote_streams.get(&ssrc) == Some(&info) {
+            return;
+        }
+        if let Some(previous) = self.bound_remote_streams.remove(&ssrc) {
+            interceptor.unbind_remote_stream(&previous);
+        }
+        interceptor.bind_remote_stream(&info);
+        self.bound_remote_streams.insert(ssrc, info);
+    }
