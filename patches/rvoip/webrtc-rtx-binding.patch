+#[test]
+fn declared_rtx_first_packet_reaches_primary_track_without_feedback_reset() {
+    let primary = RTCRtpCodecParameters {
+        rtp_codec: RTCRtpCodec {
+            mime_type: "video/VP8".into(),
+            clock_rate: 90000,
+            ..Default::default()
+        },
+        payload_type: 96,
+    };
+    let repair = RTCRtpCodecParameters {
+        rtp_codec: RTCRtpCodec {
+            mime_type: "video/rtx".into(),
+            clock_rate: 90000,
+            sdp_fmtp_line: "apt=96".into(),
+            ..Default::default()
+        },
+        payload_type: 97,
+    };
+    let mut media = MediaEngine::default();
+    media
+        .register_codec(primary.clone(), RtpCodecKind::Video)
+        .unwrap();
+    media
+        .register_codec(repair.clone(), RtpCodecKind::Video)
+        .unwrap();
+    let mut chain = register_default_interceptors(Registry::new(), &mut media)
+        .unwrap()
+        .build();
+    let mut transceiver = RTCRtpTransceiverInternal::new(
+        RtpCodecKind::Video,
+        None,
+        RTCRtpTransceiverInit {
+            direction: RTCRtpTransceiverDirection::Recvonly,
+            ..Default::default()
+        },
+    );
+    transceiver.set_mid("video-0".into()).unwrap();
+    let receiver = transceiver.receiver_mut().as_mut().unwrap();
+    receiver.set_codec_preferences(vec![primary, repair]);
+    let coding = RTCRtpCodingParameters {
+        ssrc: Some(1001),
+        rtx: Some(RTCRtpRtxParameters { ssrc: 2002 }),
+        ..Default::default()
+    };
+    receiver.set_coding_parameters(vec![coding.clone()]);
+    receiver.set_track(MediaStreamTrack::new(
+        "source".into(),
+        "video".into(),
+        "declared video".into(),
+        RtpCodecKind::Video,
+        vec![RTCRtpEncodingParameters {
+            rtp_coding_parameters: coding,
+            ..Default::default()
+        }],
+    ));
+    receiver.interceptor_remote_streams_op(&media, &mut chain, true);
+    let ext = receiver
+        .get_parameters(&media)
+        .rtp_parameters
+        .header_extensions
+        .iter()
+        .find(|e| e.uri.contains("transport-wide-cc"))
+        .unwrap()
+        .id as u8;
+    let mut transceivers = vec![transceiver];
+    let mut context = EndpointHandlerContext::default();
+    let mut stats = RTCStatsAccumulator::new();
+    let now = Instant::now();
+    let mut output = Vec::new();
+    let mut losses = Vec::new();
+    let mut twcc_receipts = 0;
+    for (index, (ssrc, pt, seq, payload)) in [
+        (2002, 97, 400, vec![0, 10, 0x10, 7]),
+        (1001, 96, 12, vec![0x10, 8]),
+        (2002, 97, 401, vec![0, 11, 0x10, 9]),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut packet = rtp::Packet::default();
+        packet.header.ssrc = ssrc;
+        packet.header.payload_type = pt;
+        packet.header.sequence_number = seq;
+        packet.header.timestamp = 90000;
+        packet
+            .header
+            .set_extension(ext, ((index + 1) as u16).to_be_bytes().to_vec().into())
+            .unwrap();
+        packet.payload = payload.into();
+        let at = now + Duration::from_millis(index as u64 * 1100);
+        chain
+            .handle_read(TaggedPacket {
+                now: at,
+                transport: TransportContext::default(),
+                message: Packet::Rtp(packet),
+            })
+            .unwrap();
+        let mut decoded = Vec::new();
+        while let Some(p) = chain.poll_read() {
+            decoded.push(p);
+        }
+        for p in decoded {
+            let mut endpoint = EndpointHandler::new(
+                &mut context,
+                &mut transceivers,
+                &media,
+                &mut chain,
+                &mut stats,
+            );
+            endpoint
+                .handle_read(TaggedRTCMessageInternal {
+                    now: p.now,
+                    transport: p.transport,
+                    message: RTCMessageInternal::Rtp(RTPMessage::Packet(p.message)),
+                })
+                .unwrap();
+        }
+        while let Some(p) = context.read_outs.pop_front() {
+            if let RTCMessageInternal::Rtp(RTPMessage::TrackPacket(p)) = p.message {
+                assert_eq!(p.track_id, "video");
+                let Packet::Rtp(p) = p.packet else { panic!() };
+                assert_eq!(p.header.ssrc, 1001);
+                assert_eq!(p.header.payload_type, 96);
+                assert_eq!(p.payload[0], 0x10);
+                output.push(p.header.sequence_number);
+            }
+        }
+        chain
+            .handle_timeout(at + Duration::from_millis(1001))
+            .unwrap();
+        while let Some(p) = chain.poll_write() {
+            if let Packet::Rtcp(ps) = p.message {
+                for p in ps {
+                    if let Some(rr) = p
+                        .as_any()
+                        .downcast_ref::<rtcp::receiver_report::ReceiverReport>()
+                    {
+                        for r in &rr.reports {
+                            assert_eq!(r.ssrc, 1001);
+                            losses.push(r.total_lost);
+                        }
+                    }
+                    if let Some(t)=p.as_any().downcast_ref::<rtcp::transport_feedbacks::transport_layer_cc::TransportLayerCc>() {twcc_receipts+=t.recv_deltas.len();}
+                }
+            }
+        }
+    }
+    assert_eq!(
+        output,
+        [10, 12, 11],
+        "RTX must restore OSN and primary ownership before public media"
+    );
+    assert_eq!(
+        losses,
+        [0, 1, 0],
+        "first-track transition must not reset prebound RR history"
+    );
+    assert_eq!(
+        twcc_receipts, 3,
+        "both wire SSRCs must contribute actual transport receipts"
+    );
+    assert_eq!(
+        context.event_outs.len(),
+        1,
+        "RTX-first opens the primary track only once"
+    );
+}
