+#[tokio::test]
+async fn scene_pending_visual_committed_receiver_before_first_adoption_flows_during_control() {
+    let f = RecipientScene::new(&[Medium::Audio, Medium::Video], 1).await;
+    let (target, adapter) = &f.candidates[0];
+    target.change(target.revision(), &[desired(Medium::Audio)], &BTreeSet::new(), deadline(), CancellationToken::new()).await.unwrap();
+    f.scene.tick();
+    let logical = desired(Medium::Video).logical_id;
+    assert!(!f.scene.members.lock().unwrap()[&target.connection].egress.contains_key(&logical));
+    target.change(target.revision(), &[desired(Medium::Audio), desired(Medium::Video)], &BTreeSet::new(), deadline(), CancellationToken::new()).await.unwrap();
+    f.scene.change_direct_subscriptions(
+        &target.connection, target.revision(),
+        DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&f.f.a, logical.clone(), logical.clone())]),
+        deadline(), CancellationToken::new(), None,
+    ).await.unwrap();
+    let port = adapter.port(Medium::Video);
+    let ticket = port.0.ticket(TicketSide::Egress);
+    let mut output = port.take_egress().unwrap();
+    let mut healthy = f.f.ba.port(Medium::Video).take_egress().unwrap();
+    assert!(ticket.is_current() && ticket.committed_at().is_some());
+    assert!(!f.scene.members.lock().unwrap()[&target.connection].egress.contains_key(&logical));
+    let flight = target.inflight.clone().try_acquire_owned().unwrap();
+    f.publish(Medium::Video, 9000);
+    f.scene.tick();
+    expect_timestamp(&mut output, 9000).await;
+    expect_timestamp(&mut healthy, 9000).await;
+    assert!(ticket.is_current());
+    assert_eq!(f.retained(), (0, 0, 0, 0));
+    assert!(output.try_recv().is_err() && healthy.try_recv().is_err());
+    drop(flight);
+}
