+            )
+            .unwrap();
+        let mut ready = bindings(&prepared);
+        ready[0].transport_id = StreamId::from_string(format!("replacement-{index}"));
+        ready[0].stream_local_id = index as u16;
+        ready[0].generation = index;
+        state
+            .commit(&f.authority(), &prepared, &ready, now)
+            .unwrap();
+    }
+    let prepared = state
+        .prepare(
+            &f.authority(),
+            MAX_BINDINGS as u64,
+            &p,
+            &p,
+            &request,
+            now,
+            now + Duration::from_secs(10),
+        )
+        .unwrap();
+    let mut ready = bindings(&prepared);
+    ready[0].generation = MAX_BINDINGS as u64 + 1;
+    assert_eq!(
+        state.commit(&f.authority(), &prepared, &ready, now),
+        Err(MediaTransitionError::Conflict)
+    );
+    ready[0].transport_id = StreamId::from_string("overflow");
+    ready[0].stream_local_id = MAX_BINDINGS as u16 + 1;
+    assert_eq!(
+        state.commit(&f.authority(), &prepared, &ready, now),
+        Err(MediaTransitionError::Capacity)
+    );
+    assert_eq!(state.revision(), MAX_BINDINGS as u64);
+    assert_eq!(state.streams().len(), 1);
+}
