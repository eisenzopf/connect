+#[test]
+fn screen_permission_revoked_during_preparation_preserves_authorized_audio() {
+    let f = Fixture::new();
+    let mut state = initial(&f);
+    let before = state.streams().clone();
+    let now = Instant::now();
+    let p = profile();
+    let request = [
+        desired("audio", Medium::Audio),
+        desired("screen", Medium::Screen),
+    ];
+    let prepared = state
+        .prepare(
+            &f.authority(),
+            1,
+            &p,
+            &p,
+            &request,
+            now,
+            now + Duration::from_secs(1),
+        )
+        .unwrap();
+    let mut current = f.authority();
+    current.send_media.remove(&Medium::Screen);
+    assert!(current.send_media.contains(&Medium::Audio));
+    assert_eq!(
+        state.commit(&current, &prepared, &bindings(&prepared), now),
+        Err(MediaTransitionError::Authority)
+    );
+    assert_eq!(state.streams(), &before);
+    assert_eq!(state.revision(), 1);
+}
