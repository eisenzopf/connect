+    fn new() -> Self {
+        Self::in_conversation("conversation")
+    }
+    fn in_conversation(conversation: &str) -> Self {
+        let now = DateTime::parse_from_rfc3339("2026-10-16T12:00:00Z")
+            .unwrap()
+            .with_timezone(&Utc);
+        let principal = AuthenticatedPrincipal {
+            subject: "alice".into(),
+            tenant: Some("tenant".into()),
+            scopes: vec![],
+            issuer: Some("fixture".into()),
+            expires_at: Some(now + chrono::Duration::hours(1)),
+            method: AuthenticationMethod::Bearer,
+            assurance: IdentityAssurance::Anonymous,
+        };
+        let owner =
+            IdentityBinding::from_authenticated(&principal, IdentityId::from_string("alice"), now)
+                .unwrap();
+        let member = Membership::admit(
+            owner.clone(),
+            ConversationId::from_string(conversation),
+            ParticipantId::from_string("participant"),
+            ParticipantKind::Human,
+            ParticipantRole::Agent,
+        )
+        .unwrap();
+        let presence =
+            SessionAppearance::admit(&member, SessionId::from_string("session"), None).unwrap();
+        let mut endpoint = EndpointBinding::provision(
+            owner,
+            EndpointId::from_string("endpoint"),
+            DeviceId::from_string("device"),
+            Transport::WebRtc,
+            "fixture-address".into(),
+        )
+        .unwrap();
+        let owner =
+            IdentityBinding::from_authenticated(&principal, IdentityId::from_string("alice"), now)
+                .unwrap();
+        endpoint
+            .verify(&owner, "fixture-evidence".into(), now)
+            .unwrap();
+        let mut connection = ConnectionBinding::prepare(
+            &member,
+            &presence,
+            &endpoint,
+            ConnectionId::from_string("connection"),
+        )
+        .unwrap();
+        connection
+            .observe_ready(&member, &presence, &endpoint, 1)
+            .unwrap();
+        connection.activate(&member, &presence, &endpoint).unwrap();
+        Self {
+            member,
+            presence,
+            endpoint,
+            connection,
+        }
+    }
+    fn authority(&self) -> CurrentMediaAuthority<'_> {
+        CurrentMediaAuthority {
+            member: &self.member,
+            presence: &self.presence,
+            endpoint: &self.endpoint,
+            connection: &self.connection,
+            may_negotiate: true,
+            send_media: [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+                .into_iter()
+                .collect(),
+            receive_media: [Medium::Audio, Medium::Video, Medium::Screen, Medium::Data]
+                .into_iter()
+                .collect(),
+        }
+    }
+}
+fn audio() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "pcmu".into(),
+        clock_rate_hz: 8000,
+        channels: 1,
+        fmtp: None,
+    }
+}
+fn opus() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "opus".into(),
+        clock_rate_hz: 48000,
+        channels: 1,
+        fmtp: None,
+    }
+}
+fn video() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "vp8".into(),
+        clock_rate_hz: 90000,
+        channels: 0,
+        fmtp: None,
+    }
+}
+fn capability(medium: Medium, formats: Vec<MediaFormat>) -> MediaCapability {
+    MediaCapability { medium, formats }
+}
+fn profile() -> EndpointMediaCapabilities {
+    let caps = vec![
+        capability(Medium::Audio, vec![opus(), audio()]),
+        capability(Medium::Video, vec![video()]),
+        capability(Medium::Screen, vec![video()]),
+        capability(
+            Medium::Data,
+            vec![MediaFormat::ReliableOrdered(DataProtocol::Json)],
+        ),
+    ];
+    EndpointMediaCapabilities {
+        send: caps.clone(),
+        receive: caps,
+        max_streams: 8,
+        renegotiation: true,
+    }
+}
+fn desired(id: &str, medium: Medium) -> DesiredStream {
+    DesiredStream {
+        logical_id: StreamId::from_string(id),
+        medium,
+        direction: StreamDirection::Both,
+    }
+}
+fn bindings(prepared: &PreparedMediaChange) -> Vec<ReadyMediaBinding> {
+    prepared
+        .streams()
+        .iter()
+        .enumerate()
+        .map(|(index, plan)| ReadyMediaBinding {
+            negotiated: plan.clone(),
+            transport_id: StreamId::from_string(format!("transport-{index}")),
+            stream_local_id: index as u16 + 1,
+            generation: 1,
+            connection_generation: 1,
+            source_ready: true,
+            sink_ready: true,
+        })
+        .collect()
+}
+fn initial(f: &Fixture) -> StreamLifecycle {
+    let mut state = StreamLifecycle::new(&f.authority()).unwrap();
+    let now = Instant::now();
+    let p = profile();
+    let candidate = state
+        .prepare(
+            &f.authority(),
+            0,
+            &p,
+            &p,
+            &[desired("audio", Medium::Audio)],
+            now,
+            now + Duration::from_secs(10),
+        )
+        .unwrap();
+    state
+        .commit(&f.authority(), &candidate, &bindings(&candidate), now)
+        .unwrap();
+    state
+}
