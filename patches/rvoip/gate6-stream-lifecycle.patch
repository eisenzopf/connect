+#[test]
+fn matching_ids_in_another_conversation_and_retired_connections_do_not_borrow_authority() {
+    let mut f = Fixture::new();
+    let other = Fixture::in_conversation("another-conversation");
+    let mut state = initial(&f);
+    let now = Instant::now();
+    let p = profile();
+    let request = [desired("audio", Medium::Audio)];
+    assert_eq!(
+        state
+            .prepare(
+                &other.authority(),
+                1,
+                &p,
+                &p,
+                &request,
+                now,
+                now + Duration::from_secs(1)
+            )
+            .err(),
+        Some(MediaTransitionError::Authority)
+    );
+    let prepared = state
+        .prepare(
+            &f.authority(),
+            1,
+            &p,
+            &p,
+            &request,
+            now,
+            now + Duration::from_secs(1),
+        )
+        .unwrap();
+    f.connection.retire();
+    assert_eq!(
+        state.commit(&f.authority(), &prepared, &bindings(&prepared), now),
+        Err(MediaTransitionError::Authority)
+    );
+    assert_eq!(state.revision(), 1);
+}
