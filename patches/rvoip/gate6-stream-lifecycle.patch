+#[test]
+fn explicit_stream_end_is_terminal_and_preserves_other_streams_and_controllers() {
+    let f = Fixture::new();
+    let other = initial(&f);
+    let mut state = StreamLifecycle::new(&f.authority()).unwrap();
+    let now = Instant::now();
+    let p = profile();
+    let request = [
+        desired("audio", Medium::Audio),
+        desired("video", Medium::Video),
+    ];
+    let prepared = state
+        .prepare(
+            &f.authority(),
+            0,
+            &p,
+            &p,
+            &request,
+            now,
+            now + Duration::from_secs(1),
+        )
+        .unwrap();
+    state
+        .commit(&f.authority(), &prepared, &bindings(&prepared), now)
+        .unwrap();
+    state
+        .end_stream(&f.authority(), 1, &request[1].logical_id)
+        .unwrap();
+    assert_eq!(
+        state.streams()[&request[1].logical_id].state,
+        LogicalStreamState::Ended
+    );
+    assert_eq!(
+        state.streams()[&request[0].logical_id].state,
+        LogicalStreamState::Active
+    );
+    assert_eq!(other.revision(), 1);
+    assert_eq!(
+        other.streams()[&request[0].logical_id].state,
+        LogicalStreamState::Active
+    );
+    assert_eq!(
+        state.end_stream(&f.authority(), 2, &request[1].logical_id),
+        Err(MediaTransitionError::Conflict)
+    );
+}
