+//! Process-local negotiated stream model. The media coordinator must prepare
+//! actual routes without disturbing the old graph, acquire current policy,
+//! then commit graph changes with this model. This module neither authenticates
+//! a caller nor performs adapter I/O. A successful model commit is not physical
+//! media evidence or a durable operation receipt.
+
+use crate::capability::{CodecInfo, DataProtocol};
+use crate::ids::StreamId;
+use crate::relationships::{
+    BindingState, ConnectionBinding, EndpointBinding, Membership, SessionAppearance,
+};
+use std::collections::{BTreeMap, BTreeSet};
+use std::time::{Duration, Instant};
+
+const MAX_REVISION: u64 = 9_007_199_254_740_991;
+const MAX_STREAMS: usize = 32;
+const MAX_BINDINGS: usize = 4096;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Medium {
+    Audio,
+    Video,
+    Screen,
+    Data,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StreamDirection {
+    Send,
+    Receive,
+    Both,
+}
+impl StreamDirection {
+    fn sends(self) -> bool {
+        self != Self::Receive
+    }
+    fn receives(self) -> bool {
+        self != Self::Send
+    }
+}
+
+/// RTP payload type and datagram handle are hop-local bindings, not codec
+/// compatibility. Parameters must agree exactly; no implicit transcoder or
+/// codec-name default is inferred here.
+#[derive(Clone, PartialEq, Eq)]
+pub enum MediaFormat {
+    Encoded {
+        name: String,
+        clock_rate_hz: u32,
+        channels: u8,
+        fmtp: Option<String>,
+    },
+    /// The approved data profile is reliable and ordered.
+    ReliableOrdered(DataProtocol),
+}
+impl std::fmt::Debug for MediaFormat {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("MediaFormat(redacted)")
+    }
+}
+impl MediaFormat {
+    pub fn encoded(codec: &CodecInfo) -> Self {
+        Self::Encoded {
+            name: codec.name.to_ascii_lowercase(),
+            clock_rate_hz: codec.clock_rate_hz,
+            channels: codec.channels,
+            fmtp: codec.fmtp.clone(),
+        }
+    }
+    fn validate(&self, medium: Medium) -> Result<()> {
+        match self {
+            Self::ReliableOrdered(_) if medium == Medium::Data => Ok(()),
+            Self::Encoded {
+                name,
+                clock_rate_hz,
+                channels,
+                fmtp,
+            } if medium != Medium::Data => {
+                if name.is_empty()
+                    || name.len() > 64
+                    || !name
+                        .bytes()
+                        .all(|b| b.is_ascii_alphanumeric() || b"-._/".contains(&b))
+                    || *clock_rate_hz == 0
+                    || *clock_rate_hz > 192_000
+                    || fmtp
+                        .as_ref()
+                        .is_some_and(|p| p.len() > 1024 || p.chars().any(char::is_control))
+                    || (medium == Medium::Audio && !(1..=8).contains(channels))
+                    || (medium != Medium::Audio && (*channels != 0 || *clock_rate_hz != 90_000))
+                {
+                    return Err(MediaTransitionError::Invalid);
+                }
+                Ok(())
+            }
+            _ => Err(MediaTransitionError::Invalid),
+        }
+    }
+    fn matches(&self, other: &Self) -> bool {
+        match (self, other) {
+            (
+                Self::Encoded {
+                    name: a,
+                    clock_rate_hz: ar,
+                    channels: ac,
+                    fmtp: af,
+                },
+                Self::Encoded {
+                    name: b,
+                    clock_rate_hz: br,
+                    channels: bc,
+                    fmtp: bf,
+                },
+            ) => a.eq_ignore_ascii_case(b) && ar == br && ac == bc && af == bf,
+            _ => self == other,
+        }
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct MediaCapability {
+    pub medium: Medium,
+    pub formats: Vec<MediaFormat>,
+}
+#[derive(Clone, Debug)]
+pub struct EndpointMediaCapabilities {
+    pub send: Vec<MediaCapability>,
+    pub receive: Vec<MediaCapability>,
+    pub max_streams: usize,
+    pub renegotiation: bool,
+}
+impl EndpointMediaCapabilities {
+    fn validate(&self) -> Result<()> {
+        if self.max_streams == 0 || self.max_streams > MAX_STREAMS {
+            return Err(MediaTransitionError::Invalid);
+        }
+        for capabilities in [&self.send, &self.receive] {
+            if capabilities.len() > 4 {
+                return Err(MediaTransitionError::Invalid);
+            }
+            let mut kinds = BTreeSet::new();
+            for capability in capabilities {
+                if !kinds.insert(capability.medium)
+                    || capability.formats.is_empty()
+                    || capability.formats.len() > 32
+                {
+                    return Err(MediaTransitionError::Invalid);
+                }
+                for (index, format) in capability.formats.iter().enumerate() {
+                    format.validate(capability.medium)?;
+                    if capability.formats[..index]
+                        .iter()
+                        .any(|previous| previous.matches(format))
+                    {
+                        return Err(MediaTransitionError::Invalid);
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DesiredStream {
+    pub logical_id: StreamId,
+    pub medium: Medium,
+    pub direction: StreamDirection,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NegotiatedStream {
+    pub requested: DesiredStream,
+    pub format: MediaFormat,
+}
+
+/// All requested streams are required. A caller chooses an explicit smaller
+/// request for an audio-only peer; video refusal never mutates active audio.
+/// Screen support is declared independently of video support.
+pub fn negotiate_streams(
+    local: &EndpointMediaCapabilities,
+    remote: &EndpointMediaCapabilities,
+    requested: &[DesiredStream],
+) -> Result<Vec<NegotiatedStream>> {
+    local.validate()?;
+    remote.validate()?;
+    if requested.is_empty() || requested.len() > local.max_streams.min(remote.max_streams) {
+        return Err(MediaTransitionError::Capacity);
+    }
+    let mut ids = BTreeSet::new();
+    let mut result = Vec::new();
+    for request in requested {
+        identifier(request.logical_id.as_str())?;
+        if !ids.insert(&request.logical_id) {
+            return Err(MediaTransitionError::Invalid);
+        }
+        let mut sets = Vec::new();
+        if request.direction.sends() {
+            sets.push(&local.send);
+            sets.push(&remote.receive);
+        }
+        if request.direction.receives() {
+            sets.push(&local.receive);
+            sets.push(&remote.send);
+        }
+        let formats = sets
+            .iter()
+            .map(|set| {
+                set.iter()
+                    .find(|cap| cap.medium == request.medium)
+                    .map(|cap| &cap.formats)
+                    .ok_or(MediaTransitionError::Unsupported)
+            })
+            .collect::<Result<Vec<_>>>()?;
+        let selected = formats[0]
+            .iter()
+            .find(|format| {
+                formats[1..]
+                    .iter()
+                    .all(|set| set.iter().any(|candidate| format.matches(candidate)))
+            })
+            .ok_or(MediaTransitionError::Unsupported)?;
+        result.push(NegotiatedStream {
+            requested: request.clone(),
+            format: selected.clone(),
+        });
+    }
+    Ok(result)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum MediaTransitionError {
+    #[error("invalid media transition")]
+    Invalid,
+    #[error("media transition conflicts with current state")]
+    Conflict,
+    #[error("requested media is unsupported")]
+    Unsupported,
+    #[error("media capacity exhausted")]
+    Capacity,
+    #[error("media transition requires current authority")]
+    Authority,
+    #[error("media route is not ready")]
+    NotReady,
+    #[error("media preparation expired")]
+    Expired,
+}
+type Result<T> = std::result::Result<T, MediaTransitionError>;
+fn identifier(value: &str) -> Result<()> {
+    if value.is_empty()
+        || value.len() > 128
+        || !value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-._:".contains(&b))
+    {
+        return Err(MediaTransitionError::Invalid);
+    }
+    Ok(())
+}
+
+/// Supplied by current trusted policy while its authority lease is held.
+/// Grants are explicit per medium; roles and capabilities grant nothing.
+pub struct CurrentMediaAuthority<'a> {
+    pub member: &'a Membership,
+    pub presence: &'a SessionAppearance,
+    pub endpoint: &'a EndpointBinding,
+    pub connection: &'a ConnectionBinding,
+    pub may_negotiate: bool,
+    pub send_media: BTreeSet<Medium>,
+    pub receive_media: BTreeSet<Medium>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LogicalStreamState {
+    Active,
+    Paused,
+    Ended,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LogicalStream {
+    pub negotiated: NegotiatedStream,
+    pub transport_id: StreamId,
+    pub stream_local_id: u16,
+    pub generation: u64,
+    pub state: LogicalStreamState,
+}
+/// Exact, protected adapter observation. The coordinator must additionally
+/// prove endpoint confirmation, route ownership and current policy before use.
+#[derive(Clone, Debug)]
+pub struct ReadyMediaBinding {
+    pub negotiated: NegotiatedStream,
+    pub transport_id: StreamId,
+    pub stream_local_id: u16,
+    pub generation: u64,
+    pub connection_generation: u64,
+    pub source_ready: bool,
+    pub sink_ready: bool,
+}
+pub struct PreparedMediaChange {
+    controller: uuid::Uuid,
+    nonce: uuid::Uuid,
+    revision: u64,
+    expires: Instant,
+    streams: Vec<NegotiatedStream>,
+}
+impl PreparedMediaChange {
+    pub fn streams(&self) -> &[NegotiatedStream] {
+        &self.streams
+    }
+}
+
+/// Bounded model for one exact Connection generation. It owns no sockets,
+/// receivers or media pumps. Stream IDs/handles retired here cannot be reused.
+pub struct StreamLifecycle {
+    controller: uuid::Uuid,
+    owner: Membership,
+    binding: ConnectionBinding,
+    revision: u64,
+    streams: BTreeMap<StreamId, LogicalStream>,
+    used_transport_ids: BTreeSet<StreamId>,
+    used_handles: BTreeSet<u16>,
+    pending: Option<(uuid::Uuid, Instant)>,
+}
+impl StreamLifecycle {
+    pub fn new(authority: &CurrentMediaAuthority<'_>) -> Result<Self> {
+        let value = Self {
+            controller: uuid::Uuid::new_v4(),
+            owner: authority.member.clone(),
+            binding: authority.connection.clone(),
+            revision: 0,
+            streams: BTreeMap::new(),
+            used_transport_ids: BTreeSet::new(),
+            used_handles: BTreeSet::new(),
+            pending: None,
+        };
+        value.authorize(authority)?;
+        Ok(value)
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn streams(&self) -> &BTreeMap<StreamId, LogicalStream> {
+        &self.streams
+    }
+    fn authorize(&self, authority: &CurrentMediaAuthority<'_>) -> Result<()> {
+        authority
+            .connection
+            .require_current(authority.member, authority.presence)
+            .map_err(|_| MediaTransitionError::Authority)?;
+        authority
+            .endpoint
+            .usable_by(authority.member)
+            .map_err(|_| MediaTransitionError::Authority)?;
+        if authority.member.identity() != self.owner.identity()
+            || authority.member.tenant() != self.owner.tenant()
+            || authority.member.conversation() != self.owner.conversation()
+            || authority.member.participant() != self.owner.participant()
+            || authority.member.epoch() != self.owner.epoch()
+            || authority.connection.connection() != self.binding.connection()
+            || authority.connection.generation() != self.binding.generation()
+            || authority.connection.session() != self.binding.session()
+            || authority.connection.endpoint() != self.binding.endpoint()
+            || authority.connection.device() != self.binding.device()
+            || authority.endpoint.endpoint() != self.binding.endpoint()
+            || authority.endpoint.device() != self.binding.device()
+            || authority.connection.state() != BindingState::Active
+            || !authority.may_negotiate
+        {
+            return Err(MediaTransitionError::Authority);
+        }
+        Ok(())
+    }
+    fn expected(&self, revision: u64) -> Result<()> {
+        if self.revision != revision {
+            return Err(MediaTransitionError::Conflict);
+        }
+        if self.revision >= MAX_REVISION {
+            return Err(MediaTransitionError::Capacity);
+        }
+        Ok(())
+    }
+    pub fn prepare(
+        &mut self,
+        authority: &CurrentMediaAuthority<'_>,
+        expected: u64,
+        local: &EndpointMediaCapabilities,
+        remote: &EndpointMediaCapabilities,
+        requested: &[DesiredStream],
+        now: Instant,
+        deadline: Instant,
+    ) -> Result<PreparedMediaChange> {
+        self.authorize(authority)?;
+        self.expected(expected)?;
+        if deadline <= now || deadline.duration_since(now) > Duration::from_secs(30) {
+            return Err(MediaTransitionError::Expired);
+        }
+        if self
+            .pending
+            .as_ref()
+            .is_some_and(|(_, expires)| *expires > now)
+        {
+            return Err(MediaTransitionError::Conflict);
+        }
+        let streams = negotiate_streams(local, remote, requested)?;
+        if !self.streams.is_empty() && (!local.renegotiation || !remote.renegotiation) {
+            return Err(MediaTransitionError::Unsupported);
+        }
+        for stream in &streams {
+            if (stream.requested.direction.sends()
+                && !authority.send_media.contains(&stream.requested.medium))
+                || (stream.requested.direction.receives()
+                    && !authority.receive_media.contains(&stream.requested.medium))
+            {
+                return Err(MediaTransitionError::Authority);
+            }
+            if let Some(old) = self.streams.get(&stream.requested.logical_id) {
+                if old.state == LogicalStreamState::Ended
+                    || old.negotiated.requested.medium != stream.requested.medium
+                {
+                    return Err(MediaTransitionError::Conflict);
+                }
+            }
+        }
+        let new_ids = streams
+            .iter()
+            .filter(|s| !self.streams.contains_key(&s.requested.logical_id))
+            .count();
+        if self.streams.len() + new_ids > MAX_BINDINGS {
+            return Err(MediaTransitionError::Capacity);
+        }
+        let nonce = uuid::Uuid::new_v4();
+        self.pending = Some((nonce, deadline));
+        Ok(PreparedMediaChange {
+            controller: self.controller,
+            nonce,
+            revision: self.revision,
+            expires: deadline,
+            streams,
+        })
+    }
+    pub fn abort(&mut self, prepared: PreparedMediaChange) -> Result<()> {
+        if prepared.controller != self.controller
+            || self.pending.as_ref().map(|p| p.0) != Some(prepared.nonce)
+        {
+            return Err(MediaTransitionError::Conflict);
+        }
+        self.pending = None;
+        Ok(())
+    }
+    pub fn commit(
+        &mut self,
+        authority: &CurrentMediaAuthority<'_>,
+        prepared: &PreparedMediaChange,
+        bindings: &[ReadyMediaBinding],
+        now: Instant,
+    ) -> Result<()> {
+        self.authorize(authority)?;
+        self.expected(prepared.revision)?;
+        if prepared.controller != self.controller
+            || self.pending.as_ref().map(|p| p.0) != Some(prepared.nonce)
+        {
+            return Err(MediaTransitionError::Conflict);
+        }
+        if now >= prepared.expires {
+            return Err(MediaTransitionError::Expired);
+        }
+        if bindings.len() != prepared.streams.len() {
+            return Err(MediaTransitionError::NotReady);
+        }
+        let mut next = BTreeMap::new();
+        let mut handles = BTreeSet::new();
+        let mut ids = BTreeSet::new();
+        let mut new_handles = 0;
+        for plan in &prepared.streams {
+            if (plan.requested.direction.sends()
+                && !authority.send_media.contains(&plan.requested.medium))
+                || (plan.requested.direction.receives()
+                    && !authority.receive_media.contains(&plan.requested.medium))
+            {
+                return Err(MediaTransitionError::Authority);
+            }
+            let binding = bindings
+                .iter()
+                .find(|b| b.negotiated.requested.logical_id == plan.requested.logical_id)
+                .ok_or(MediaTransitionError::NotReady)?;
+            identifier(binding.transport_id.as_str())?;
+            if binding.negotiated != *plan
+                || binding.connection_generation != self.binding.generation()
+                || binding.stream_local_id == 0
+                || !handles.insert(binding.stream_local_id)
+                || !ids.insert(binding.transport_id.clone())
+                || (plan.requested.direction.sends() && !binding.sink_ready)
+                || (plan.requested.direction.receives() && !binding.source_ready)
+            {
+                return Err(MediaTransitionError::NotReady);
+            }
+            let old = self.streams.get(&plan.requested.logical_id);
+            let unchanged = old.is_some_and(|old| {
+                old.transport_id == binding.transport_id
+                    && old.stream_local_id == binding.stream_local_id
+                    && old.negotiated == *plan
+            });
+            let generation = if unchanged {
+                old.unwrap().generation
+            } else {
+                old.map_or(1, |old| old.generation + 1)
+            };
+            if binding.generation != generation
+                || generation > MAX_REVISION
+                || (!unchanged
+                    && (self.used_transport_ids.contains(&binding.transport_id)
+                        || self.used_handles.contains(&binding.stream_local_id)))
+            {
+                return Err(MediaTransitionError::Conflict);
+            }
+            if !unchanged {
+                new_handles += 1;
+            }
+            next.insert(
+                plan.requested.logical_id.clone(),
+                LogicalStream {
+                    negotiated: plan.clone(),
+                    transport_id: binding.transport_id.clone(),
+                    stream_local_id: binding.stream_local_id,
+                    generation,
+                    state: old.map_or(LogicalStreamState::Active, |old| old.state),
+                },
+            );
+        }
+        if self.used_handles.len() + new_handles > MAX_BINDINGS {
+            return Err(MediaTransitionError::Capacity);
+        }
+        // Nothing above mutates the committed snapshot. The owner commits the
+        // matching real graph under its current-authority lease at this point.
+        for (id, stream) in self.streams.iter_mut() {
+            if !next.contains_key(id) {
+                stream.state = LogicalStreamState::Ended;
+            }
+        }
+        for (id, stream) in next {
+            self.used_handles.insert(stream.stream_local_id);
+            self.used_transport_ids.insert(stream.transport_id.clone());
+            self.streams.insert(id, stream);
+        }
+        self.pending = None;
+        self.revision += 1;
+        Ok(())
+    }
+    pub fn set_paused(
+        &mut self,
+        authority: &CurrentMediaAuthority<'_>,
+        expected: u64,
+        id: &StreamId,
+        paused: bool,
+    ) -> Result<()> {
+        self.authorize(authority)?;
+        self.expected(expected)?;
+        let stream = self
+            .streams
+            .get_mut(id)
+            .ok_or(MediaTransitionError::Conflict)?;
+        if stream.state == LogicalStreamState::Ended {
+            return Err(MediaTransitionError::Conflict);
+        }
+        if (stream.negotiated.requested.direction.sends()
+            && !authority
+                .send_media
+                .contains(&stream.negotiated.requested.medium))
+            || (stream.negotiated.requested.direction.receives()
+                && !authority
+                    .receive_media
+                    .contains(&stream.negotiated.requested.medium))
+        {
+            return Err(MediaTransitionError::Authority);
+        }
+        stream.state = if paused {
+            LogicalStreamState::Paused
+        } else {
+            LogicalStreamState::Active
+        };
+        self.revision += 1;
+        Ok(())
+    }
+    /// Logical end only. The owner must retire the matching actual route under
+    /// the same policy lease before publishing an authoritative public event.
+    pub fn end_stream(
+        &mut self,
+        authority: &CurrentMediaAuthority<'_>,
+        expected: u64,
+        id: &StreamId,
+    ) -> Result<()> {
+        self.authorize(authority)?;
+        self.expected(expected)?;
+        let stream = self
+            .streams
+            .get_mut(id)
+            .ok_or(MediaTransitionError::Conflict)?;
+        if stream.state == LogicalStreamState::Ended {
+            return Err(MediaTransitionError::Conflict);
+        }
+        stream.state = LogicalStreamState::Ended;
+        self.revision += 1;
+        Ok(())
+    }
+    /// Protected terminal callback. An old physical stream's end cannot close
+    /// a replacement that retained the same logical ID.
+    pub fn observe_ended(
+        &mut self,
+        id: &StreamId,
+        transport: &StreamId,
+        local_id: u16,
+        generation: u64,
+        connection_generation: u64,
+    ) -> Result<bool> {
+        let Some(stream) = self.streams.get_mut(id) else {
+            return Ok(false);
+        };
+        if stream.state == LogicalStreamState::Ended
+            || stream.transport_id != *transport
+            || stream.stream_local_id != local_id
+            || stream.generation != generation
+            || self.binding.generation() != connection_generation
+        {
+            return Ok(false);
+        }
+        if self.revision >= MAX_REVISION {
+            return Err(MediaTransitionError::Capacity);
+        }
+        stream.state = LogicalStreamState::Ended;
+        self.revision += 1;
+        Ok(true)
+    }
+}
