+struct Fixture {
+    policy: Arc<Policy>,
+    a: Arc<StreamController>,
+    b: Arc<StreamController>,
+    source: AdapterMediaPort,
+    target: AdapterMediaPort,
+    input: mpsc::Receiver<MediaPacket>,
+    medium: Medium,
+}
+fn deadline() -> tokio::time::Instant {
+    tokio::time::Instant::now() + Duration::from_secs(2)
+}
+impl Fixture {
+    async fn new(medium: Medium) -> Self {
+        let policy = Arc::new(Policy {
+            owners: [("alice".into(), owner("alice")), ("bob".into(), owner("bob"))].into(),
+            guard: Arc::new(RwLock::new(())),
+            mode: AtomicUsize::new(0),
+            attempts: AtomicUsize::new(0),
+            original_attempts: AtomicUsize::new(0),
+            grant_until: Mutex::new(None),
+        });
+        let aa = Arc::new(Adapter::default());
+        let ba = Arc::new(Adapter::default());
+        let handles = Arc::new(StreamHandleAllocator::default());
+        let controller = |name: &str, adapter: Arc<Adapter>| {
+            StreamController::new(
+                ConversationId::from_string("conversation"), SessionId::from_string("session"),
+                ConnectionId::from_string(name), principal(name), policy.clone(), adapter,
+                handles.clone(), 8,
+            ).unwrap()
+        };
+        let a = controller("alice", aa.clone());
+        let b = controller("bob", ba.clone());
+        for controller in [&a, &b] {
+            controller.change(controller.revision(), &[desired(medium)], &BTreeSet::new(),
+                deadline(), CancellationToken::new()).await.unwrap();
+        }
+        b.change_direct_subscriptions(b.revision(),
+            DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                &a, desired(medium).logical_id.clone(), desired(medium).logical_id,
+            )]), deadline(), CancellationToken::new(), None).await.unwrap();
+        let input = a.take_ingress(&desired(medium).logical_id).unwrap();
+        Self { policy, a, b, source: aa.port(medium), target: ba.port(medium), input, medium }
+    }
+    async fn enqueue(&mut self, ssrc: u32, sequence: u16) {
+        let packet = rtp::Packet {
+            header: rtp::Header { version: 2, payload_type: 96, ssrc,
+                sequence_number: sequence, timestamp: sequence as u32 * 3000,
+                marker: true, ..Default::default() },
+            payload: vec![0x10, 0, 1, 2].into(),
+        };
+        self.source.try_publish(&MediaFrame {
+            stream_id: self.source.binding().transport_id.clone(), kind: StreamKind::Video,
+            payload: packet.marshal().unwrap().freeze(), timestamp_rtp: packet.header.timestamp,
+            captured_at: Utc::now(), payload_type: Some(96), source_clock: None,
+        }).unwrap();
+        tokio::time::timeout_at(deadline(), self.input.recv()).await.unwrap().unwrap()
+            .try_forward_to(&self.b, &desired(self.medium).logical_id).unwrap();
+    }
+    async fn close(self) -> bool {
+        let a = self.a.shutdown(deadline()).await;
+        let b = self.b.shutdown(deadline()).await;
+        a == 0 && b == 0 && self.policy.guard.clone().try_write_owned().is_ok()
+    }
+}
+struct Peers {
+    publisher: Arc<RvoipPeerConnection>,
+    receiver: Arc<RvoipPeerConnection>,
+}
+impl Peers {
+    async fn new() -> Self {
+        let mut config = WebRtcConfig::loopback();
+        config.require_vp8_audio_video_profile = true;
+        let publisher = RvoipPeerConnection::new_canonical(&config, PeerRole::Offerer).await.unwrap();
+        let receiver = RvoipPeerConnection::new(&config, PeerRole::Answerer).await.unwrap();
+        publisher.add_local_audio_track().await.unwrap();
+        publisher.add_local_video_track().await.unwrap();
+        let offer = publisher.create_offer_and_gather().await.unwrap();
+        let answer = receiver.accept_offer_and_gather(&offer).await.unwrap();
+        publisher.set_remote_answer(&answer).await.unwrap();
+        tokio::try_join!(publisher.wait_connected(Duration::from_secs(3)),
+            receiver.wait_connected(Duration::from_secs(3))).unwrap();
+        let (audio, video) = RvoipPeerConnection::prime_remote_media(
+            &publisher, &receiver, true, Duration::from_secs(3),
+        ).await;
+        assert!(audio.is_some() && video.is_some(), "actual RTP establishes the feedback source SSRC");
+        Self { publisher, receiver }
+    }
+    async fn primary(&self, f: &mut Fixture, sequence: u16) -> (CoreVideoEgress, bool) {
+        let ssrc = self.publisher.local_video_ssrc().unwrap();
+        let mut output = self.publisher.core_video_egress(
+            &f.target, deadline().into_std(),
+        ).await.unwrap();
+        f.enqueue(ssrc, sequence).await;
+        let write = output.submit_next(deadline().into_std()).await.unwrap().unwrap();
+        let result = write.result().await;
+        let joined = write.cancel_and_drain().await;
+        // Consume any negotiation/initial-source request before observing this
+        // test's fresh hint. No notification is counted as new media credit.
+        let requests = self.publisher.video_keyframe_requests();
+        for _ in 0..8 {
+            if tokio::time::timeout(Duration::from_millis(1), requests.notified()).await.is_err() {
+                break;
+            }
+        }
+        (output, result.is_ok() && joined.is_ok())
+    }
+    async fn hint(&self, pictures: &PictureRequests) -> (bool, bool) {
+        let requests = self.publisher.video_keyframe_requests();
+        let notice = requests.notified();
+        tokio::pin!(notice);
+        notice.as_mut().enable();
+        let peer = self.receiver.clone();
+        let attempt = pictures.forward(tokio::time::Instant::now() + Duration::from_millis(100),
+            move |_, ssrc| async move {
+                peer.request_picture_for_source(ssrc).await.map_err(|_| StreamControlError::NotReady)
+            }).await;
+        let observed = tokio::time::timeout(Duration::from_millis(100), notice).await.is_ok();
+        (matches!(attempt, PictureAttempt::Invoked), observed)
+    }
+    async fn close(self) -> bool {
+        let (a, b) = tokio::join!(self.publisher.close(), self.receiver.close());
+        a.is_ok() && b.is_ok()
+    }
+}
