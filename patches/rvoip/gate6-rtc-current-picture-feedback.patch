+impl QueuedMedia {
+    /// Submit one original VP8 packet with independent metadata for fresh RTC
+    /// control hints. The repair handle retains its original bytes, 200ms age
+    /// and four-attempt budget. Feedback never retains those bytes or readers.
+    pub async fn deliver_video_with_repair_and_feedback<F, Fut>(
+        self,
+        send: F,
+    ) -> ControlResult<(VideoRepair, Option<VideoFeedbackRoute>)>
+    where
+        F: FnOnce(MediaFrame, Option<MediaDeliveryOrigin>) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        let medium = self.target.binding.negotiated.requested.medium;
+        if self.frame.kind != StreamKind::Video
+            || self.data.is_some()
+            || self.local.is_some()
+            || self.sources.len() != 1
+            || self.target_consumer.is_some()
+            || !matches!(medium, Medium::Video | Medium::Screen)
+            || self.sources[0].source.binding.negotiated.requested.medium != medium
+            || self.sources[0].consumer.is_some()
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let source = &self.sources[0];
+        let scope = Scope {
+            source: Arc::downgrade(&source.source),
+            target: Arc::downgrade(&self.target),
+            source_ticket: source.ticket.clone(),
+            target_ticket: self.target_ticket.clone(),
+            source_scene: source.scene.clone(),
+            target_scene: self.target_scene.clone(),
+        };
+        let descriptor = source.descriptor.clone();
+        let direct = self.direct.clone().ok_or(StreamControlError::Authority)?;
+        let mut installed = None;
+        let output = &mut installed;
+        let repair = self
+            .deliver_video_with_repair(move |frame, origin| async move {
+                // Auxiliary metadata contention cannot turn an otherwise valid
+                // primary RTP write into a failure. A previous hint still needs
+                // current exact route admission; no old authority is reused.
+                let route = match VideoFeedbackRoute::issued(scope, descriptor, direct) {
+                    Ok(route) => Some(route),
+                    Err(StreamControlError::Backpressure) => None,
+                    Err(problem) => return Err(problem),
+                };
+                send(frame, origin).await?;
+                *output = route;
+                Ok(())
+            })
+            .await?;
+        Ok((repair, installed))
+    }
+}
