+#[tokio::test]
+async fn rtc_feedback_metadata_exclusion_does_not_discard_valid_primary_video() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let mut input = f.a.take_ingress(&desired(Medium::Video).logical_id).unwrap();
+    let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+    publish(&f, Medium::Video, &mut input, 700).await
+        .try_forward_to(&f.b, &desired(Medium::Video).logical_id).unwrap();
+    let queued = outgoing(&mut output).await;
+    let direct = queued.direct.clone().unwrap();
+    let excluded = direct.feedback.hold_metadata_for_test();
+    let submitted = Arc::new(AtomicUsize::new(0));
+    let count = submitted.clone();
+    let (repair, feedback) = queued.deliver_video_with_repair_and_feedback(move |_, _| async move {
+        count.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }).await.unwrap();
+    drop(excluded);
+    assert_eq!(submitted.load(Ordering::SeqCst), 1);
+    assert!(feedback.is_none());
+    repair.repair(|_, _| async { Ok(()) }).await.unwrap();
+}
