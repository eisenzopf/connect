+#[tokio::test]
+async fn fresh_rtc_feedback_destroys_pending_io_before_current_guards_on_cutoff_or_cancel() {
+    struct PendingIo {
+        policy: Arc<Policy>,
+        dropped_under_readers: Arc<AtomicBool>,
+    }
+    impl Drop for PendingIo {
+        fn drop(&mut self) {
+            self.dropped_under_readers.store(self.policy.0.try_write().is_err(), Ordering::SeqCst);
+        }
+    }
+    for cancel in [false, true] {
+        let f = Fixture::new(8);
+        f.start(&[Medium::Video]).await;
+        let mut input = f.a.take_ingress(&desired(Medium::Video).logical_id).unwrap();
+        let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+        let feedback = feedback_record(&f, &mut input, &mut output, 600).await;
+        let callback_entered = AtomicBool::new(false);
+        let expired = feedback.dispatch_current(
+            tokio::time::Instant::now() - Duration::from_millis(1),
+            |_, _| {
+                callback_entered.store(true, Ordering::SeqCst);
+                async { Ok(()) }
+            },
+        ).await;
+        assert!(matches!(expired, Err(StreamControlError::Deadline)));
+        assert!(!callback_entered.load(Ordering::SeqCst));
+        let entered = Arc::new(Notify::new());
+        let dropped = Arc::new(AtomicBool::new(false));
+        let pending = PendingIo { policy: f.policy.clone(), dropped_under_readers: dropped.clone() };
+        let seen = entered.clone();
+        let until = tokio::time::Instant::now() + Duration::from_millis(20);
+        let sending = feedback.dispatch_current(until, move |_, _| async move {
+            let _pending = pending;
+            seen.notify_one();
+            std::future::pending::<ControlResult<()>>().await
+        });
+        let (result, entered) = tokio::join!(sending, async {
+            let entered = tokio::time::timeout(
+                Duration::from_millis(100), entered.notified(),
+            ).await.is_ok();
+            if cancel && entered { f.a.retire(); }
+            entered
+        });
+        assert!(entered, "fresh feedback did not enter its actual IO future");
+        assert!(if cancel { matches!(result, Err(StreamControlError::Cancelled)) }
+            else { matches!(result, Err(StreamControlError::Deadline)) });
+        assert!(dropped.load(Ordering::SeqCst), "IO dropped after current readers");
+        assert!(f.policy.0.try_write().is_ok(), "feedback retained authority after completion");
+        f.a.retire();
+        let callback_entered = AtomicBool::new(false);
+        let cancelled = feedback.dispatch_current(deadline(), |_, _| {
+            callback_entered.store(true, Ordering::SeqCst);
+            async { Ok(()) }
+        }).await;
+        assert!(cancelled.is_err());
+        assert!(!callback_entered.load(Ordering::SeqCst));
+    }
+}
