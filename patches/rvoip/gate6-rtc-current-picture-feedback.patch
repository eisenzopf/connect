+#[tokio::test]
+async fn fresh_rtc_feedback_keeps_current_authority_selection_and_physical_generation() {
+    for action in 0..6 {
+        let f = Fixture::new(8);
+        f.start(&[Medium::Video, Medium::Screen]).await;
+        let mut input = f.a.take_ingress(&desired(Medium::Video).logical_id).unwrap();
+        let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+        publish(&f, Medium::Video, &mut input, 500).await
+            .try_forward_to(&f.b, &desired(Medium::Video).logical_id).unwrap();
+        let (_, feedback) = outgoing(&mut output).await
+            .deliver_video_with_repair_and_feedback(|_, _| async { Ok(()) }).await.unwrap();
+        let feedback = feedback.unwrap();
+        match action {
+            0 | 1 => {
+                f.policy.0.write().await.revoked.insert(if action == 0 { "alice" } else { "bob" }.into());
+            },
+            2 => { f.policy.0.write().await.private = true; },
+            3 => {
+                route(&f, DirectSubscriptionChange::Unsubscribe(vec![desired(Medium::Video).logical_id]))
+                    .await.unwrap();
+            },
+            4 => {
+                let logical = desired(Medium::Video).logical_id;
+                f.a.set_paused(&logical, f.a.revision(), true, deadline()).await.unwrap();
+                f.a.set_paused(&logical, f.a.revision(), false, deadline()).await.unwrap();
+            },
+            5 => {
+                let logical = desired(Medium::Video).logical_id;
+                f.b.set_paused(&logical, f.b.revision(), true, deadline()).await.unwrap();
+                f.b.set_paused(&logical, f.b.revision(), false, deadline()).await.unwrap();
+            },
+            _ => unreachable!(),
+        }
+        assert!(feedback.dispatch_current(deadline(), |_, _| async {
+            panic!("stale or forbidden RTC feedback entered IO")
+        }).await.is_err(), "current refusal lane {action}");
+    }
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video, Medium::Screen]).await;
+    let mut input = f.a.take_ingress(&desired(Medium::Video).logical_id).unwrap();
+    let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+    publish(&f, Medium::Video, &mut input, 501).await
+        .try_forward_to(&f.b, &desired(Medium::Video).logical_id).unwrap();
+    let mut wrong = outgoing(&mut output).await;
+    wrong.target = f.ba.port(Medium::Screen).0;
+    assert!(matches!(wrong.deliver_video_with_repair_and_feedback(|_, _| async {
+        panic!("camera-to-screen route entered IO")
+    }).await, Err(StreamControlError::Unsupported)));
+}
