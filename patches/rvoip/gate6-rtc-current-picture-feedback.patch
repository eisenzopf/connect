+#[tokio::test]
+async fn rtc_picture_hint_earlier_grant_expiry_drops_pending_io_without_reentry() {
+    struct PendingIo {
+        policy: Arc<Policy>,
+        dropped_under_readers: Arc<AtomicBool>,
+    }
+    impl Drop for PendingIo {
+        fn drop(&mut self) {
+            self.dropped_under_readers.store(
+                self.policy.guard.clone().try_write_owned().is_err(), Ordering::SeqCst,
+            );
+        }
+    }
+    let peers = Peers::new().await;
+    let mut f = Fixture::new(Medium::Video).await;
+    let (output, primary) = peers.primary(&mut f, 1300).await;
+    let route = output.picture_requests().latest.lock().unwrap().as_ref().unwrap().0.clone();
+    *f.policy.grant_until.lock().unwrap() = Some(Utc::now() + chrono::Duration::milliseconds(10));
+    let completed = Arc::new(AtomicBool::new(false));
+    let done = completed.clone();
+    let dropped = Arc::new(AtomicBool::new(false));
+    let pending = PendingIo { policy: f.policy.clone(), dropped_under_readers: dropped.clone() };
+    let result = route.dispatch_current(
+        tokio::time::Instant::now() + Duration::from_millis(100),
+        move |_, _| async move {
+            let _pending = pending;
+            tokio::time::sleep(Duration::from_millis(50)).await;
+            done.store(true, Ordering::SeqCst);
+            Ok(())
+        },
+    ).await;
+    let no_reader = f.policy.guard.clone().try_write_owned().is_ok();
+    *f.policy.grant_until.lock().unwrap() = None;
+    drop(output);
+    let core_joined = f.close().await;
+    let peers_joined = peers.close().await;
+    assert!(core_joined && peers_joined);
+    assert!(primary && matches!(result, Err(StreamControlError::Deadline)));
+    assert!(dropped.load(Ordering::SeqCst) && no_reader);
+    assert!(!completed.load(Ordering::SeqCst), "original shorter grant did not bound actual IO");
+}
