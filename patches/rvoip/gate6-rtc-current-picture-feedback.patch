+#[tokio::test]
+async fn fresh_rtc_feedback_does_not_spend_or_renew_original_video_repairs() {
+    for medium in [Medium::Video, Medium::Screen] {
+        let f = Fixture::new(8);
+        f.start(&[medium]).await;
+        let mut input = f.a.take_ingress(&desired(medium).logical_id).unwrap();
+        let mut output = f.ba.port(medium).take_egress().unwrap();
+        publish(&f, medium, &mut input, 400).await
+            .try_forward_to(&f.b, &desired(medium).logical_id).unwrap();
+        let (repair, feedback) = outgoing(&mut output).await
+            .deliver_video_with_repair_and_feedback(|_, _| async { Ok(()) }).await.unwrap();
+        let feedback = feedback.unwrap();
+        let expiry = repair.expires_at();
+        let excluded = f.policy.0.write().await;
+        for _ in 0..4 {
+            assert!(feedback.dispatch_current(deadline(), |_, _| async {
+                panic!("excluded feedback entered IO")
+            }).await.is_err());
+        }
+        drop(excluded);
+        let sends = Arc::new(AtomicUsize::new(0));
+        for _ in 0..super::super::video_repair::MAX_VIDEO_REPAIRS {
+            let sends = sends.clone();
+            repair.repair(move |frame, _| async move {
+                assert_eq!(frame.timestamp_rtp, 400);
+                sends.fetch_add(1, Ordering::SeqCst);
+                Ok(())
+            }).await.unwrap();
+        }
+        assert_eq!(sends.load(Ordering::SeqCst), 4);
+        assert!(matches!(repair.repair(|_, _| async {
+            panic!("fifth actual repair bypassed original budget")
+        }).await, Err(StreamControlError::Backpressure)));
+        assert_eq!(repair.expires_at(), expiry);
+        tokio::time::sleep_until(expiry.into()).await;
+        assert!(matches!(repair.repair(|_, _| async {
+            panic!("expired repair replayed original bytes")
+        }).await, Err(StreamControlError::Deadline)));
+        feedback.dispatch_current(deadline(), |_, _| async { Ok(()) }).await.unwrap();
+        assert_eq!(repair.expires_at(), expiry);
+    }
+}
