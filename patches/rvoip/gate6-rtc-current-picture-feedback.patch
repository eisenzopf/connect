+#[tokio::test]
+async fn rtc_picture_hint_after_last_media_expiry_does_not_replay_the_old_packet() {
+    let peers = Peers::new().await;
+    let mut observations = Vec::new();
+    for (index, medium) in [Medium::Video, Medium::Screen].into_iter().enumerate() {
+        let mut f = Fixture::new(medium).await;
+        let (output, primary) = peers.primary(&mut f, 1100 + index as u16).await;
+        let pictures = output.picture_requests();
+        tokio::time::sleep(Duration::from_millis(210)).await;
+        let (invoked, pli) = peers.hint(&pictures).await;
+        let no_new_input = f.input.try_recv().is_err();
+        drop(output);
+        let joined = f.close().await;
+        observations.push((medium, primary, invoked, pli, no_new_input, joined));
+    }
+    let peers_joined = peers.close().await;
+    println!("rtc_picture_expired observations={observations:?} peers_joined={peers_joined}");
+    assert!(peers_joined && observations.iter().all(|(_, _, _, _, _, joined)| *joined));
+    assert!(observations.iter().all(|(_, primary, invoked, pli, no_input, _)|
+        *primary && *invoked && *pli && *no_input), "expired media prevented fresh authorized PLI");
+}
