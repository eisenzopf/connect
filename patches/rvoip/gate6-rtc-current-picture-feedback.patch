+#[tokio::test]
+async fn rtc_picture_hint_after_four_busy_admissions_uses_fresh_current_authority() {
+    let peers = Peers::new().await;
+    let mut f = Fixture::new(Medium::Video).await;
+    let (output, primary) = peers.primary(&mut f, 1000).await;
+    let pictures = output.picture_requests();
+    let before = f.policy.attempts.load(Ordering::SeqCst);
+    f.policy.mode.store(1, Ordering::SeqCst); // exact pre-callback Backpressure
+    let mut refused = 0;
+    let entered = AtomicUsize::new(0);
+    for _ in 0..4 {
+        let attempt = pictures.forward(tokio::time::Instant::now() + Duration::from_millis(100),
+            |_, _| async { entered.fetch_add(1, Ordering::SeqCst); Ok(()) }).await;
+        if matches!(attempt, PictureAttempt::MetadataRefused) {
+            refused += 1;
+        }
+    }
+    let attempts = f.policy.attempts.load(Ordering::SeqCst) - before;
+    f.policy.mode.store(0, Ordering::SeqCst);
+    let (invoked, pli) = peers.hint(&pictures).await;
+    drop(output);
+    let core_joined = f.close().await;
+    let peers_joined = peers.close().await;
+    println!("rtc_picture_busy primary={primary} refused={refused} policy_attempts={attempts} invoked={invoked} source_srtcp_pli={pli} core_joined={core_joined} peers_joined={peers_joined}");
+    assert!(core_joined && peers_joined);
+    assert!(primary && refused == 4 && attempts == 4 && entered.load(Ordering::SeqCst) == 0);
+    assert!(invoked && pli, "four refused metadata polls exhausted fresh PLI through packet repair");
+}
