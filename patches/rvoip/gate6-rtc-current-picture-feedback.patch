+#[tokio::test]
+async fn rtc_picture_hint_refuses_revoked_wrong_route_and_current_generation_changes() {
+    let peers = Peers::new().await;
+    let mut observations = Vec::new();
+    for action in 0..4 {
+        let mut f = Fixture::new(Medium::Video).await;
+        let (output, primary) = peers.primary(&mut f, 1200 + action).await;
+        let pictures = output.picture_requests();
+        match action {
+            0 => f.policy.mode.store(3, Ordering::SeqCst),
+            1 => {
+                pictures.latest.lock().unwrap().as_mut().unwrap().1.origin.generation += 1;
+            },
+            2 => {
+                f.a.set_paused(&desired(Medium::Video).logical_id, f.a.revision(), true,
+                    deadline()).await.unwrap();
+            },
+            3 => {
+                f.b.change_direct_subscriptions(f.b.revision(), DirectSubscriptionChange::Clear,
+                    deadline(), CancellationToken::new(), None).await.unwrap();
+            },
+            _ => unreachable!(),
+        }
+        let (invoked, pli) = peers.hint(&pictures).await;
+        f.policy.mode.store(0, Ordering::SeqCst);
+        drop(output);
+        let joined = f.close().await;
+        observations.push((action, primary, invoked, pli, joined));
+    }
+    let peers_joined = peers.close().await;
+    println!("rtc_picture_negative observations={observations:?} peers_joined={peers_joined}");
+    assert!(peers_joined && observations.iter().all(|(_, _, _, _, joined)| *joined));
+    assert!(observations.iter().all(|(_, primary, invoked, pli, _)| *primary && !*invoked && !*pli));
+}
