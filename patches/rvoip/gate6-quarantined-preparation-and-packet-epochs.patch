+impl AuthorityLease {
+    pub(in crate::v2) fn resource_preparation_reply(
+        &self,
+        request: &Envelope,
+        reply: &Envelope,
+    ) -> Option<Result<(), DispatchError>> {
+        self.authority::<ResourcePreparation>().map(|resource| {
+            resource.permits(request)?;
+            if request.kind() != "connection.offer" || reply.kind() != "connection.answer" ||
+                reply.scope(Scope::Reply) != Some(request.id()) {
+                return Err(DispatchError::ReplyMismatch);
+            }
+            for scope in [Scope::Conversation, Scope::Session, Scope::Connection, Scope::Operation] {
+                if reply.scope(scope) != request.scope(scope) { return Err(DispatchError::ReplyMismatch); }
+            }
+            let p = &reply.original()["payload"];
+            let setup = &request.original()["payload"]["substrate_setup"];
+            if p["substrate_setup"] != *setup || p["substrate"] != request.original()["payload"]["substrate"] ||
+                p["by_participant"].as_str() != Some(resource.participant.as_str()) ||
+                setup["offer_id"] != resource.original.id() ||
+                reply.original()["signature"]["keyid"] != resource.original.original()["signature"]["keyid"] ||
+                reply.original()["signature"]["alg"] != resource.original.original()["signature"]["alg"] {
+                return Err(DispatchError::Authority);
+            }
+            let expected = setup["streams"].as_array().ok_or(DispatchError::ReplyMismatch)?.iter()
+                .map(|s| serde_json::json!({"id":s["strm_id"],"kind":s["kind"],
+                    "direction":match s["direction"].as_str(){Some("sendonly")=>"recvonly",Some("recvonly")=>"sendonly",Some("sendrecv")=>"sendrecv",_=>"inactive"},"codec":s["codec"]}))
+                .collect::<Vec<_>>();
+            if p["streams_answered"] != serde_json::json!(expected) { return Err(DispatchError::ReplyMismatch); }
+            Ok(())
+        })
+    }
+}
