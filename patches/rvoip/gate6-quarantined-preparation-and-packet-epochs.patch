+/// Owns the one original prepared adapter batch through fresh authorization.
+/// Dropping this aborts dormant Core ports and releases the negotiation slot.
+pub struct PreparedNativeOffer {
+    route: Arc<Route>,
+    controller: Arc<rvoip_core::staged_streams::StreamController>,
+    guard: super::native_negotiation::NegotiationGuard,
+    prepared: rvoip_core::staged_streams::PreparedInitialMedia,
+    source: String,
+}
+impl PreparedNativeOffer {
+    pub async fn activate_muted(
+        self,
+        held: Arc<dyn std::any::Any + Send + Sync>,
+    ) -> std::result::Result<
+        super::native_negotiation::NativeOfferOutcome,
+        super::native_negotiation::NativeOfferError,
+    > {
+        self.activate_with_initial_gate(held, true).await
+    }
+    pub async fn activate(
+        self,
+        held: Arc<dyn std::any::Any + Send + Sync>,
+    ) -> std::result::Result<
+        super::native_negotiation::NativeOfferOutcome,
+        super::native_negotiation::NativeOfferError,
+    > {
+        self.activate_with_initial_gate(held, false).await
+    }
+    async fn activate_with_initial_gate(
+        self,
+        held: Arc<dyn std::any::Any + Send + Sync>,
+        muted: bool,
+    ) -> std::result::Result<
+        super::native_negotiation::NativeOfferOutcome,
+        super::native_negotiation::NativeOfferError,
+    > {
+        use super::native_negotiation::NativeOfferError;
+        if self.route.cancel.is_cancelled() || self.route.physical.context.lifetime.is_cancelled() {
+            return Err(NativeOfferError::Cancelled);
+        }
+        let revision = if muted { 2 } else { 1 };
+        let activation = if muted {
+            self.prepared.activate_muted_with_held(held).await
+        } else {
+            self.prepared.activate_with_held(held).await
+        };
+        activation.map_err(|error| self.guard.error(error))?;
+        self.guard.committed();
+        if let Some(installed) = self
+            .route
+            .installation
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+        {
+            installed.backend.flow.confirmed(revision, &self.source);
+        }
+        let mut outcome = self.guard.result(&self.controller)?;
+        outcome.revision = revision;
+        Ok(outcome)
+    }
+}
