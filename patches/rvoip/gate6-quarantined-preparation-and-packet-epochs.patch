+//! Original-request-only transport negotiation, without a domain authority lease.
+use super::*;
+use std::collections::BTreeSet;
+
+// Not exported or constructible by a peer. This allows only parameter exchange
+// for the exact initially authorized offer, never conversation payload delivery.
+struct ResourcePreparation {
+    original: Envelope,
+    participant: String,
+    streams: BTreeSet<String>,
+    cancellation: CancellationToken,
+    deadline: Instant,
+}
+impl ResourcePreparation {
+    fn permits(&self, outgoing: &Envelope) -> Result<(), DispatchError> {
+        if self.cancellation.is_cancelled() || Instant::now() >= self.deadline {
+            return Err(DispatchError::Closed);
+        }
+        for scope in [
+            Scope::Conversation,
+            Scope::Session,
+            Scope::Connection,
+            Scope::Operation,
+        ] {
+            if self.original.scope(scope).is_none()
+                || self.original.scope(scope) != outgoing.scope(scope)
+            {
+                return Err(DispatchError::ReplyMismatch);
+            }
+        }
+        if !matches!(outgoing.kind(), "connection.offer" | "connection.answer") {
+            return Err(DispatchError::Unsupported);
+        }
+        let payload = &outgoing.original()["payload"];
+        if payload["by_participant"].as_str() != Some(self.participant.as_str()) {
+            return Err(DispatchError::Authority);
+        }
+        let field = if outgoing.kind() == "connection.offer" {
+            "streams_offered"
+        } else {
+            "streams_answered"
+        };
+        let streams = payload[field]
+            .as_array()
+            .ok_or(DispatchError::ReplyMismatch)?;
+        let ids = streams
+            .iter()
+            .map(|stream| stream["id"].as_str().ok_or(DispatchError::ReplyMismatch))
+            .collect::<Result<BTreeSet<_>, _>>()?;
+        if ids.len() != streams.len()
+            || ids.len() != self.streams.len()
+            || ids.iter().any(|id| !self.streams.contains(*id))
+        {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        if outgoing.kind() == "connection.answer" {
+            validate_offer_answer(&self.original, outgoing)?;
+        } else if outgoing.scope(Scope::Reply).is_some() {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        Ok(())
+    }
+}
+impl AuthorizedEnvelope {
+    /// Consume the unique original invocation after dormant resource planning.
+    /// Only its resource bounds, physical cancellation, answer identity and
+    /// signed exchange remain. Typed application authority becomes unavailable.
+    /// Final activation must separately reacquire current domain authorization.
+    pub fn into_resource_preparation(
+        mut self,
+        participant: String,
+        streams: BTreeSet<String>,
+        deadline: Instant,
+    ) -> Result<Self, DispatchError> {
+        if !self.supports_native_negotiation()
+            || self.envelope.kind() != "connection.offer"
+            || self.envelope.original()["payload"]
+                .get("replacement_preparation")
+                .is_some_and(|p| p["profile"] != "connect-replacement-media-v1")
+            || participant.is_empty()
+            || streams.is_empty()
+        {
+            return Err(DispatchError::Authority);
+        }
+        let payload = &self.envelope.original()["payload"];
+        let offered = payload["streams_offered"]
+            .as_array()
+            .ok_or(DispatchError::Unsupported)?;
+        if streams.len() > offered.len()
