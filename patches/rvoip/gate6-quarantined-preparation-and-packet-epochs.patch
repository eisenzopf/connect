+#[tokio::test]
+async fn quarantined_signed_exchange_releases_real_domain_reader_and_retains_exact_original_answer()
+{
+    let (f, policy, handler) = setup(Mode::Resource);
+    handler.hold.store(true, Ordering::Release);
+    let mut wire = open("quic", &f, handler.clone(), None).await;
+    let original = quarantined_offer();
+    wire.send(f.sign(original.clone())).await;
+    handler.entered.notified().await;
+    // Real command guard is gone while its resource exchange is still alive.
+    let mut writer = policy
+        .grants
+        .clone()
+        .try_write_owned()
+        .expect("resource preparation pinned original domain read");
+    writer.deny = true;
+    drop(writer);
+    handler.hold.store(false, Ordering::Release);
+    handler.release.notify_one();
+    let answer = wire.read().await;
+    f.verify_server(&answer).await;
+    assert_eq!(answer.kind(), "connection.answer");
+    assert_eq!(answer.scope(Scope::Reply), original["id"].as_str());
+    progress(|| handler.written.load(Ordering::Acquire) == 1).await;
+    assert_eq!(
+        policy.approvals.load(Ordering::Acquire),
+        0,
+        "quarantine is not a domain grant"
+    );
+    wire.server.shutdown().await.unwrap();
+}
