+//! Original queued media cannot borrow authorization restored in a later epoch.
+use super::*;
+struct Epoch(AtomicBool);
+impl PacketEpoch for Epoch {
+    fn current(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}
+struct EpochLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    epoch: Arc<Epoch>,
+}
+impl MediaAuthorityLease for EpochLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        self.inner.expires_at()
+    }
+    fn packet_epoch(&self) -> Option<Arc<dyn PacketEpoch>> {
+        Some(self.epoch.clone())
+    }
+}
+struct EpochPolicy {
+    inner: Arc<Policy>,
+    source: Arc<arc_swap::ArcSwap<Epoch>>,
+    target: Arc<arc_swap::ArcSwap<Epoch>>,
+}
+impl MediaPolicy for EpochPolicy {
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current_participant_receive(scope, source)
+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if matches!(scope.purpose, MediaPurpose::Control) {
+            return self.inner.current(scope);
+        }
+        let epoch = if scope.connection.as_str() == "alice" {
+            &self.source
+        } else {
+            &self.target
+        };
+        Ok(Box::new(EpochLease {
+            inner: self.inner.current(scope)?,
+            epoch: epoch.load_full(),
+        }))
+    }
+}
+fn setup() -> (
+    Fixture,
+    Arc<arc_swap::ArcSwap<Epoch>>,
+    Arc<arc_swap::ArcSwap<Epoch>>,
+) {
+    let source = Arc::new(arc_swap::ArcSwap::from_pointee(Epoch(AtomicBool::new(
+        true,
+    ))));
+    let target = Arc::new(arc_swap::ArcSwap::from_pointee(Epoch(AtomicBool::new(
+        true,
+    ))));
+    let f = Fixture::with_policy(
+        8,
+        Some(Box::new({
+            let source = source.clone();
+            let target = target.clone();
+            move |inner| {
+                Arc::new(EpochPolicy {
+                    inner,
+                    source,
+                    target,
+                })
+            }
+        })),
+    );
+    (f, source, target)
+}
+fn revoke_and_restore(slot: &arc_swap::ArcSwap<Epoch>) {
+    slot.load().0.store(false, Ordering::Release);
+    slot.store(Arc::new(Epoch(AtomicBool::new(true))));
+}
+async fn source_epoch_case(medium: Medium) {
+    let (f, source_epoch, _) = setup();
+    f.start(&[medium]).await;
+    let source = f.aa.port(medium);
+    let mut input = f.a.take_ingress(&desired(medium).logical_id).unwrap();
+    let mut output = f.ba.port(medium).take_egress().unwrap();
+    source.try_publish(&frame(&source, 1)).unwrap();
+    let original = receive(&mut input).await;
+    assert!(
+        f.policy.0.try_write().is_ok(),
+        "queued epoch must retain no policy guard"
+    );
+    revoke_and_restore(&source_epoch);
+    assert!(matches!(
+        original.try_forward_to(&f.b, &desired(medium).logical_id),
+        Err(StreamControlError::Authority)
+    ));
+    assert!(output.try_recv().is_err());
+    source.try_publish(&frame(&source, 2)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(medium).logical_id)
+        .unwrap();
+    outgoing(&mut output)
+        .await
+        .deliver(|_| async { Ok(()) })
+        .await
+        .unwrap();
+    tokio::join!(f.a.shutdown(deadline()), f.b.shutdown(deadline()));
+}
+async fn target_epoch_case(medium: Medium) {
+    let (f, _, target_epoch) = setup();
+    f.start(&[medium]).await;
+    let source = f.aa.port(medium);
+    let mut input = f.a.take_ingress(&desired(medium).logical_id).unwrap();
+    let mut output = f.ba.port(medium).take_egress().unwrap();
+    source.try_publish(&frame(&source, 1)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(medium).logical_id)
+        .unwrap();
+    let original = outgoing(&mut output).await;
+    assert!(
+        f.policy.0.try_write().is_ok(),
+        "recipient queue must retain no policy guard"
+    );
+    revoke_and_restore(&target_epoch);
+    let entered = Arc::new(AtomicBool::new(false));
+    let observed = entered.clone();
+    let result = original
+        .deliver(move |_| async move {
+            observed.store(true, Ordering::Release);
+            Ok(())
+        })
+        .await;
+    assert!(matches!(result, Err(StreamControlError::Authority)));
+    assert!(!entered.load(Ordering::Acquire));
+    source.try_publish(&frame(&source, 2)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(medium).logical_id)
+        .unwrap();
+    outgoing(&mut output)
+        .await
+        .deliver(|_| async { Ok(()) })
+        .await
+        .unwrap();
+    tokio::join!(f.a.shutdown(deadline()), f.b.shutdown(deadline()));
+}
+#[tokio::test]
+async fn queued_audio_source_epoch_is_not_renewed_after_revocation_and_restoration() {
+    source_epoch_case(Medium::Audio).await;
+}
+#[tokio::test]
+async fn queued_video_source_epoch_is_not_renewed_after_revocation_and_restoration() {
+    source_epoch_case(Medium::Video).await;
+}
+#[tokio::test]
+async fn queued_audio_recipient_epoch_is_not_renewed_after_revocation_and_restoration() {
+    target_epoch_case(Medium::Audio).await;
+}
+#[tokio::test]
+async fn queued_video_recipient_epoch_is_not_renewed_after_revocation_and_restoration() {
+    target_epoch_case(Medium::Video).await;
+}
