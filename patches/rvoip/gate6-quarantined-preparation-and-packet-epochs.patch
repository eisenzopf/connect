+            return Err(DispatchError::Closed);
+        }
+        let cancellation = self.invocation.child_token();
+        let current = cancellation.clone();
+        let resource = ResourcePreparation {
+            original: self.envelope.clone(),
+            participant,
+            streams,
+            cancellation,
+            deadline,
+        };
+        self._lease = AuthorityLease::checking(resource, deadline, move || !current.is_cancelled());
+        Ok(self)
+    }
+    pub(in crate::v2) fn resource_preparation_lease(
+        &self,
+        outgoing: &Envelope,
+    ) -> Option<Result<AuthorityLease, DispatchError>> {
+        self._lease
+            .authority::<ResourcePreparation>()
+            .map(|resource| {
+                resource.permits(outgoing)?;
+                Ok(self._lease.retained())
+            })
+    }
+}
