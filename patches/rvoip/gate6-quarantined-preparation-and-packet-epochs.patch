+    pub fn belongs_to(&self, controller: &Arc<StreamController>) -> bool {
+        Arc::ptr_eq(&self.staged.candidate.owner, controller)
+    }
+    pub async fn prepare(mut self) -> ControlResult<PreparedInitialMedia> {
+        let s = &mut self.staged;
+        let owner = s.candidate.owner.clone();
+        debug_assert!(s.control.is_none());
+        tokio::select! { biased;
+            _ = s.cancellation.cancelled() => return Err(StreamControlError::Cancelled),
+            _ = s.control_cancel.cancelled() => return Err(StreamControlError::Cancelled),
+            _ = owner.shutdown.cancelled() => return Err(StreamControlError::Cancelled),
+            result = tokio::time::timeout_at(s.deadline,
+                owner.adapter.prepare(s.selected.clone(), s.deadline, s.candidate.cancellation.clone())) => {
+                result.map_err(|_| StreamControlError::Deadline)??;
+            }
+        }
+        s.adapter_prepared = true;
+        Ok(PreparedInitialMedia {
+            staged: self.staged,
+        })
+    }
