+    /// Observe the live ICE agent for these exact negotiated credentials.
+    /// Accumulated statistics and prior connection callbacks are not proof of
+    /// this generation. This read grants no owner, media or application authority.
+    pub fn ice_generation_ready(
+        &self,
+        local: &RTCIceParameters,
+        remote: &RTCIceParameters,
+    ) -> bool {
+        use crate::peer_connection::transport::{RTCDtlsTransportState, RTCIceTransportState};
+        let ice = self.ice_transport();
+        let (local_ufrag, local_pwd) = ice.get_local_user_credentials();
+        let (remote_ufrag, remote_pwd) = ice.get_remote_user_credentials();
+        self.signaling_state == RTCSignalingState::Stable
+            && self.pending_local_description.is_none()
+            && self.pending_remote_description.is_none()
+            && self.peer_connection_state == RTCPeerConnectionState::Connected
+            && self.dtls_transport().state == RTCDtlsTransportState::Connected
+            && matches!(
+                ice.state(),
+                RTCIceTransportState::Connected | RTCIceTransportState::Completed
+            )
+            && ice.agent.get_selected_candidate_pair().is_some()
+            && !local_ufrag.is_empty()
+            && !local_pwd.is_empty()
+            && !remote_ufrag.is_empty()
+            && !remote_pwd.is_empty()
+            && local_ufrag == local.username_fragment
+            && local_pwd == local.password
+            && remote_ufrag == remote.username_fragment
+            && remote_pwd == remote.password
+    }
