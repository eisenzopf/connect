+#[tokio::test]
+async fn explicit_end_retries_only_retired_quarantine_and_keeps_operational_access_closed() {
+    use rvoip_core::{adapter::ConnectionAdapter, RvoipError};
+    for already_physically_absent in [false, true] {
+        let f = Fixture::new().await;
+        let (connection, _) = f.connection("alice", true).await;
+        f.join(&f.session, "alice", &connection).await;
+        f.adapter.fail_end.store(true, Ordering::Release);
+        f.orch
+            .end_session(f.session.clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        assert_eq!(
+            f.orch.session(&f.session).unwrap().read().unwrap().state,
+            SessionState::Ended
+        );
+        until(|| f.adapter.ended.load(Ordering::Acquire) == 1).await;
+        assert_eq!(f.orch.adapter_cleanup_quarantine_count(), 1);
+        assert!(f.adapter.is_connection_live(&connection));
+        let still_failing = f
+            .orch
+            .end_connection(connection.clone(), EndReason::Normal)
+            .await;
+        let after_failed = f.orch.adapter_cleanup_quarantine_count();
+        let still_live = f.adapter.is_connection_live(&connection);
+        f.adapter.fail_end.store(false, Ordering::Release);
+        if already_physically_absent {
+            // The original adapter has closed without a terminal hint. Its exact
+            // quarantine is still required; no new route or ID is substituted.
+            f.adapter
+                .end(connection.clone(), EndReason::Normal)
+                .await
+                .unwrap();
+        }
+        f.adapter.refuse_absent_end.store(true, Ordering::Release);
+        let before_retry_calls = f.adapter.ended.load(Ordering::Acquire);
+        let retried = f
+            .orch
+            .end_connection(connection.clone(), EndReason::Normal)
+            .await;
+        let after_retry_calls = f.adapter.ended.load(Ordering::Acquire);
+        let after_retry = f.orch.adapter_cleanup_quarantine_count();
+        let actually_absent = !f.adapter.is_connection_live(&connection);
+        let hold = f.orch.hold(connection.clone()).await;
+        let resume = f.orch.resume(connection.clone()).await;
+        let principal = f.orch.connection_principal(&connection);
+        // Even the old body must retire the exact test route and join its owners
+        // before the causal success assertion can fail.
+        f.adapter.refuse_absent_end.store(false, Ordering::Release);
+        f.adapter
+            .end(connection.clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        f.orch
+            .drain_connection_lifecycle_tasks_until(
+                tokio::time::Instant::now() + Duration::from_secs(2),
+            )
+            .await
+            .unwrap();
+        assert!(still_failing.is_err());
+        assert_eq!(after_failed, 1);
+        assert!(still_live);
+        assert!(
+            retried.is_ok(),
+            "explicit end must reach original quarantine: {retried:?}"
+        );
+        assert_eq!(
+            after_retry_calls - before_retry_calls,
+            usize::from(!already_physically_absent)
+        );
+        assert!(actually_absent);
+        assert_eq!(after_retry, 0);
+        assert!(matches!(hold, Err(RvoipError::ConnectionNotFound(_))));
+        assert!(matches!(resume, Err(RvoipError::ConnectionNotFound(_))));
+        assert!(matches!(principal, Err(RvoipError::ConnectionNotFound(_))));
+    }
+}
