+#[tokio::test]
+async fn quarantined_end_without_authoritative_absence_keeps_cleanup_unconfirmed() {
+    use rvoip_core::adapter::ConnectionAdapter;
+    let f = Fixture::new().await;
+    let (connection, _) = f.connection("alice", true).await;
+    f.join(&f.session, "alice", &connection).await;
+    f.adapter.fail_end.store(true, Ordering::Release);
+    f.orch
+        .end_session(f.session.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    until(|| f.adapter.ended.load(Ordering::Acquire) == 1).await;
+    f.adapter.fail_end.store(false, Ordering::Release);
+    f.adapter
+        .authoritative_liveness
+        .store(false, Ordering::Release);
+    let result = f
+        .orch
+        .end_connection(connection.clone(), EndReason::Normal)
+        .await;
+    let quarantine = f.orch.adapter_cleanup_quarantine_count();
+    f.adapter.end(connection, EndReason::Normal).await.unwrap();
+    f.orch
+        .drain_connection_lifecycle_tasks_until(
+            tokio::time::Instant::now() + Duration::from_secs(2),
+        )
+        .await
+        .unwrap();
+    assert!(result.is_err());
+    assert_eq!(
+        quarantine, 1,
+        "an adapter acknowledgement is not an absence proof"
+    );
+}
