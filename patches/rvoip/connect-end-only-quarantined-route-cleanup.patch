+#[tokio::test]
+async fn quarantined_end_refuses_missing_active_and_stale_lifecycles() {
+    let core = Orchestrator::new(Config::default());
+    let connection = ConnectionId::new();
+    assert!(core.ensure_connection_lifecycle(&connection));
+    let lifecycle = core.connection_lifecycles.get(&connection).unwrap().clone();
+    let generation = lifecycle.lock().unwrap().generation;
+    // There is deliberately no adapter. A failed ownership check must return
+    // ConnectionNotFound before it can resolve or invoke any transport.
+    for (quarantine, active, retired, current_generation) in [
+        (None, false, true, generation),
+        (Some(generation), true, false, generation),
+        (Some(generation), false, false, generation),
+        (Some(generation), false, true, generation + 1),
+    ] {
+        core.adapter_cleanup_quarantines.remove(&connection);
+        if let Some(lifecycle_generation) = quarantine {
+            core.adapter_cleanup_quarantines.insert(
+                connection.clone(),
+                AdapterCleanupQuarantine {
+                    transport: Transport::Sip,
+                    lifecycle_generation,
+                },
+            );
+        }
+        {
+            let mut state = lifecycle.lock().unwrap();
+            state.active = active;
+            state.retired = retired;
+            state.generation = current_generation;
+        }
+        assert!(matches!(
+            core.end_connection(connection.clone(), EndReason::Normal).await,
+            Err(RvoipError::ConnectionNotFound(id)) if id == connection
+        ));
+        assert_eq!(
+            core.adapter_cleanup_quarantine_count(),
+            usize::from(quarantine.is_some())
+        );
+    }
+}
