+use super::*;
+#[allow(dead_code)]
+#[path = "../../../tests/support/participant_control_fixture.rs"]
+mod fixture;
+use fixture::{participant, Fixture};
+struct RefuseMedia;
+impl crate::staged_streams::MediaPolicy for RefuseMedia {
+    fn current(
+        &self,
+        _: &crate::staged_streams::MediaScope<'_>,
+    ) -> crate::staged_streams::ControlResult<Box<dyn crate::staged_streams::MediaAuthorityLease>>
+    {
+        Err(crate::staged_streams::StreamControlError::Authority)
+    }
+}
+async fn staged(f: &Fixture) -> SessionId {
+    let sid = f
+        .orch
+        .start_session(f.conversation.clone(), SessionMedium::Voice, vec![])
+        .await
+        .unwrap();
+    f.orch
+        .enable_staged_participant_control(
+            &sid,
+            f.policy.clone(),
+            Arc::new(RefuseMedia),
+            ParticipantLimits::default(),
+        )
+        .unwrap();
+    sid
+}
+fn terminal_events(events: &mut broadcast::Receiver<Event>, sid: &SessionId) -> usize {
+    let mut count = 0;
+    while let Ok(event) = events.try_recv() {
+        if matches!(event,Event::SessionEnded{session_id,..} if &session_id==sid) {
+            count += 1;
+        }
+    }
+    count
+}
+#[tokio::test]
+async fn successful_end_releases_exact_runtime_mixer_and_staged_scene_before_orchestrator_shutdown()
+{
+    let f = Fixture::new().await;
+    let sid = staged(&f).await;
+    let (runtime, mixer, scene) = {
+        let r = f.orch.participant_runtime(&sid).unwrap();
+        (
+            Arc::downgrade(&r),
+            Arc::downgrade(&r.mixer),
+            Arc::downgrade(r.mixer.staged.as_ref().unwrap()),
+        )
+    };
+    assert!(scene.upgrade().is_some());
+    f.orch
+        .end_session(sid.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    assert!(!f.orch.participant_sessions.contains_key(&sid));
+    assert!(runtime.upgrade().is_none());
+    assert!(mixer.upgrade().is_none());
+    assert!(scene.upgrade().is_none());
+    assert!(
+        f.orch.session(&sid).is_some(),
+        "logical history remains without its media owner"
+    );
+}
+#[tokio::test]
+async fn repeated_terminal_sessions_keep_live_registry_constant_and_only_scalar_revision_in_history(
+) {
+    let f = Fixture::new().await;
+    let live = f.orch.participant_sessions.len();
+    let history = f.orch.sessions.len();
+    for index in 0..8 {
+        let sid = staged(&f).await;
+        let before = f.orch.participant_revision(&sid).unwrap();
+        let weak = {
+            let r = f.orch.participant_runtime(&sid).unwrap();
+            Arc::downgrade(&r)
+        };
+        let mut events = f.orch.subscribe_events();
+        f.orch
+            .end_session(sid.clone(), EndReason::Cancelled)
+            .await
+            .unwrap();
+        assert_eq!(terminal_events(&mut events, &sid), 1);
+        f.orch
+            .end_session(sid.clone(), EndReason::Timeout)
+            .await
+            .unwrap();
+        assert_eq!(terminal_events(&mut events, &sid), 0);
+        assert!(weak.upgrade().is_none());
+        assert_eq!(f.orch.participant_sessions.len(), live);
+        assert_eq!(f.orch.participant_revision(&sid).unwrap(), before + 1);
+        assert_eq!(f.orch.participant_capacity(&sid).unwrap(), (0, 0));
+        assert_eq!(
+            f.orch
+                .participant_session_role(&sid, &participant("alice"))
+                .unwrap(),
+            None
+        );
+        let record = f.orch.session(&sid).unwrap();
+        let record = record.read().unwrap();
+        assert_eq!(record.participant_terminal_revision, Some(before + 1));
+        assert_eq!(record.state, SessionState::Ended);
+        assert!(matches!(record.end_reason, Some(EndReason::Cancelled)));
+        assert_eq!(f.orch.sessions.len(), history + index + 1);
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn cancelled_original_join_keeps_same_runtime_until_successful_retry_releases_it() {
+    let f = Fixture::new().await;
+    let sid = staged(&f).await;
+    let (weak, mut finalizer) = {
+        let r = f.orch.participant_runtime(&sid).unwrap();
+        tokio::time::timeout(Duration::from_secs(2), r.mixer.started_for_test.notified())
+            .await
+            .unwrap();
+        (
+            Arc::downgrade(&r),
+            r.mixer.hold_original_finalizer_for_test(),
+        )
+    };
+    let owner = f.orch.clone();
+    let id = sid.clone();
+    let end = tokio::spawn(async move { owner.end_session(id, EndReason::Cancelled).await });
+    tokio::time::timeout(Duration::from_secs(2), finalizer.entered())
+        .await
+        .unwrap();
+    end.abort();
+    assert!(end.await.unwrap_err().is_cancelled());
+    assert!(weak.upgrade().is_some());
+    assert!(Arc::ptr_eq(
+        &weak.upgrade().unwrap(),
+        f.orch.participant_sessions.get(&sid).unwrap().value()
+    ));
+    assert_eq!(
+        f.orch
+            .session(&sid)
+            .unwrap()
+            .read()
+            .unwrap()
+            .participant_terminal_revision,
+        None
+    );
+    finalizer.release();
+    f.orch
+        .end_session(sid.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    assert!(weak.upgrade().is_none());
+    assert!(!f.orch.participant_sessions.contains_key(&sid));
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn failed_original_finalizer_never_publishes_terminal_metadata_or_removes_join_custody() {
+    let f = Fixture::new().await;
+    let sid = staged(&f).await;
+    let weak = {
+        let r = f.orch.participant_runtime(&sid).unwrap();
+        tokio::time::timeout(Duration::from_secs(2), r.mixer.started_for_test.notified())
+            .await
+            .unwrap();
+        r.mixer.panic_original_finalizer_for_test();
+        Arc::downgrade(&r)
+    };
+    let mut events = f.orch.subscribe_events();
+    for _ in 0..2 {
+        assert!(f
+            .orch
+            .end_session(sid.clone(), EndReason::Normal)
+            .await
+            .is_err());
+    }
+    assert!(weak.upgrade().is_some());
+    assert!(f.orch.participant_sessions.contains_key(&sid));
+    assert_eq!(
+        f.orch
+            .session(&sid)
+            .unwrap()
+            .read()
+            .unwrap()
+            .participant_terminal_revision,
+        None
+    );
+    assert_eq!(
+        f.orch.session(&sid).unwrap().read().unwrap().state,
+        SessionState::Ending
+    );
+    assert_eq!(terminal_events(&mut events, &sid), 0);
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn concurrent_end_releases_one_original_runtime_after_join_and_keeps_stable_terminal_queries()
+{
+    let f = Fixture::new().await;
+    let sid = staged(&f).await;
+    let before = f.orch.participant_revision(&sid).unwrap();
+    let (weak, mut finalizer) = {
+        let r = f.orch.participant_runtime(&sid).unwrap();
+        tokio::time::timeout(Duration::from_secs(2), r.mixer.started_for_test.notified())
+            .await
+            .unwrap();
+        (
+            Arc::downgrade(&r),
+            r.mixer.hold_original_finalizer_for_test(),
+        )
+    };
+    let mut events = f.orch.subscribe_events();
+    let mut ends = Vec::new();
+    for _ in 0..4 {
+        let owner = f.orch.clone();
+        let id = sid.clone();
+        ends.push(tokio::spawn(async move {
+            owner.end_session(id, EndReason::Normal).await
+        }));
+    }
+    tokio::time::timeout(Duration::from_secs(2), finalizer.entered())
+        .await
+        .unwrap();
+    assert!(ends.iter().all(|e| !e.is_finished()));
+    assert!(weak.upgrade().is_some());
+    finalizer.release();
+    for end in ends {
+        end.await.unwrap().unwrap();
+    }
+    assert!(weak.upgrade().is_none());
+    assert_eq!(terminal_events(&mut events, &sid), 1);
+    assert_eq!(f.orch.participant_revision(&sid).unwrap(), before + 1);
+    assert_eq!(f.orch.participant_capacity(&sid).unwrap(), (0, 0));
+}
+#[tokio::test]
+async fn terminal_scene_release_keeps_unrelated_live_runtime_and_original_mixer_owned() {
+    let f = Fixture::new().await;
+    let (connection, _) = f.connection("alice", true).await;
+    f.join(&f.session, "alice", &connection).await;
+    let live = f.orch.participant_runtime(&f.session).unwrap();
