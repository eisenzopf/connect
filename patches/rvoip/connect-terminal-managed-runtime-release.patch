+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn terminal_revision_publication_precedes_excluded_same_runtime_removal_without_query_gap() {
+    let f = Fixture::new().await;
+    let sid = staged(&f).await;
+    let revision = f.orch.participant_revision(&sid).unwrap();
+    // An original read guard deterministically excludes map removal, while
+    // permitting the real original join and terminal scalar publication.
+    let held = f.orch.participant_sessions.get(&sid).unwrap();
+    let weak = Arc::downgrade(held.value());
+    let owner = f.orch.clone();
+    let id = sid.clone();
+    let end = tokio::spawn(async move { owner.end_session(id, EndReason::Normal).await });
+    let observed = tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            if f.orch
+                .session(&sid)
+                .unwrap()
+                .read()
+                .unwrap()
+                .participant_terminal_revision
+                .is_some()
+            {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await;
+    assert!(observed.is_ok());
+    assert!(!end.is_finished());
+    assert_eq!(
+        held.value().state.lock().unwrap().controller.revision(),
+        revision + 1
+    );
+    drop(held);
+    end.await.unwrap().unwrap();
+    assert!(weak.upgrade().is_none());
+    // The missing-live-owner branch observes the already-published scalar.
+    assert_eq!(f.orch.participant_revision(&sid).unwrap(), revision + 1);
+    assert_eq!(f.orch.participant_capacity(&sid).unwrap(), (0, 0));
+    assert_eq!(
+        f.orch
+            .participant_session_role(&sid, &participant("alice"))
+            .unwrap(),
+        None
+    );
+}
