+    assert!(!live.state.lock().unwrap().ended);
+    assert!(!live.mixer.task.joined_and_released_for_test().await);
+    assert_eq!(f.orch.participant_revision(&f.session).unwrap(), revision);
+    assert_eq!(f.orch.participant_capacity(&f.session).unwrap(), (1, 0));
+}
+#[tokio::test]
