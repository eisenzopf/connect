+//! Explicitly negotiated receiver-video history on the native packet boundary.
+//! A tag identifies history; only the signed selection/notice and current route
+//! authorize its use. It never grants media or feedback permission.
+use super::{observe_rtp, observe_rtp_datagram, ObservedRtpPayload};
+use crate::errors::SubstrateError;
+use bytes::{BufMut, Bytes, BytesMut};
+
+pub const VIDEO_EPOCH_FLAG: u8 = 1;
+const MAXIMUM: usize = 16 * 1024 + 36;
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VideoEpochDatagram {
+    pub stream_local_id: u16,
+    pub seq: u32,
+    pub epoch: u128,
+    pub rtp: ObservedRtpPayload,
+}
+fn invalid() -> SubstrateError {
+    SubstrateError::InvalidDatagram("invalid native video epoch packet")
+}
+/// Preserve the original RTP body byte for byte, including its original clock.
+/// Call only within current delivery guards for a selected feedback profile.
+pub fn tag_video_epoch_datagram(input: &[u8], epoch: u128) -> Result<Bytes, SubstrateError> {
+    if epoch == 0
+        || input.len() > MAXIMUM - 16
+        || input.get(1) != Some(&0)
+        || input.get(9).is_some_and(|kind| (192..=223).contains(kind))
+    {
+        return Err(invalid());
+    }
+    let parsed = observe_rtp_datagram(input)?;
+    if parsed.rtp.packet().header.ssrc == 0 {
+        return Err(invalid());
+    }
+    let mut output = BytesMut::with_capacity(input.len() + 16);
+    output.extend_from_slice(&input[..8]);
+    output[1] = VIDEO_EPOCH_FLAG;
+    output.put_u128(epoch);
+    output.extend_from_slice(&input[8..]);
+    Ok(output.freeze())
+}
+/// This separate parser must never be a fallback for ordinary unnegotiated RTP.
+pub fn observe_video_epoch_datagram(input: &[u8]) -> Result<VideoEpochDatagram, SubstrateError> {
+    if input.len() < 36
+        || input.len() > MAXIMUM
+        || input[..2] != [1, VIDEO_EPOCH_FLAG]
+        || (192..=223).contains(&input[25])
+    {
+        return Err(invalid());
+    }
+    let stream_local_id = u16::from_be_bytes(input[2..4].try_into().expect("bounded header"));
+    let seq = u32::from_be_bytes(input[4..8].try_into().expect("bounded header"));
+    let epoch = u128::from_be_bytes(input[8..24].try_into().expect("bounded epoch"));
+    if stream_local_id == 0 || epoch == 0 {
+        return Err(invalid());
+    }
+    let rtp = observe_rtp(Bytes::copy_from_slice(&input[24..]))?;
+    if rtp.packet().header.ssrc == 0 {
+        return Err(invalid());
+    }
+    Ok(VideoEpochDatagram {
+        stream_local_id,
+        seq,
+        epoch,
+        rtp,
+    })
+}
