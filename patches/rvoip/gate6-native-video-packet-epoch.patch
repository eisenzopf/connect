+use rvoip_uctp::substrate::{
+    observe_native_media_datagram, observe_video_epoch_datagram, tag_video_epoch_datagram,
+};
+#[test]
+fn epoch_video_envelope_preserves_original_rtp_and_requires_explicit_parser() {
+    let mut ordinary = vec![1, 0, 0, 42, 255, 255, 255, 255];
+    ordinary.extend_from_slice(&[
+        0xb1, 0xe0, 255, 254, 255, 255, 255, 0, 1, 2, 3, 4, 5, 6, 7, 8, 0xbe, 0xde, 0, 1, 0x10,
+        0x33, 0, 0, 0x10, 1, 2, 3, 0, 0, 0, 4,
+    ]);
+    let epoch = 0x0102030405060708090a0b0c0d0e0f10_u128;
+    let tagged = tag_video_epoch_datagram(&ordinary, epoch).unwrap();
+    assert_eq!(&tagged[..8], &[1, 1, 0, 42, 255, 255, 255, 255]);
+    assert_eq!(&tagged[8..24], &epoch.to_be_bytes());
+    assert_eq!(&tagged[24..], &ordinary[8..]);
+    let parsed = observe_video_epoch_datagram(&tagged).unwrap();
+    assert_eq!(parsed.epoch, epoch);
+    assert_eq!(parsed.stream_local_id, 42);
+    assert_eq!(parsed.seq, u32::MAX);
+    assert_eq!(parsed.rtp.packet().header.timestamp, 0xffffff00);
+    assert_eq!(parsed.rtp.packet().header.sequence_number, 65534);
+    assert!(parsed.rtp.packet().header.marker);
+    assert!(observe_native_media_datagram(&tagged).is_err());
+    assert!(observe_video_epoch_datagram(&ordinary).is_err());
+    assert!(tag_video_epoch_datagram(&ordinary, 0).is_err());
+    assert!(tag_video_epoch_datagram(&tagged, epoch).is_err());
+    for length in 0..36 {
+        assert!(observe_video_epoch_datagram(&tagged[..length]).is_err());
+    }
+    for range in [2..4, 8..24, 32..36] {
+        let mut bad = tagged.to_vec();
+        bad[range].fill(0);
+        assert!(observe_video_epoch_datagram(&bad).is_err());
+    }
+    for flags in [0, 2, 255] {
+        let mut bad = tagged.to_vec();
+        bad[1] = flags;
+        assert!(observe_video_epoch_datagram(&bad).is_err());
+    }
+    assert!(observe_video_epoch_datagram(&vec![0; 16 * 1024 + 37]).is_err());
+    // Same physical handle, SSRC, timestamp and sequence are insufficient to
+    // cross a selection boundary. The in-band epoch stays independently visible.
+    let next = tag_video_epoch_datagram(&ordinary, epoch + 1).unwrap();
+    let next = observe_video_epoch_datagram(&next).unwrap();
+    assert_eq!(next.seq, parsed.seq);
+    assert_eq!(next.rtp, parsed.rtp);
+    assert_ne!(next.epoch, parsed.epoch);
+}
