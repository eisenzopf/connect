+#[tokio::test]
+async fn native_video_packets_identify_reselection_before_reading_the_signed_notice() {
+    let profile = Arc::new((*profile(false)).clone().with_video_feedback());
+    let mut s = Scene::new_profiled("quic", false, true, true, profile, None).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    let mut offer = lifecycle_offer(&s, 0, 0, "sendonly");
+    offer["payload"]["streams_offered"].as_array_mut().unwrap().push(json!({"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}));
+    let (_, cb) = s.prepared(offer).await;
+    let source_handle = subscriptions::stream_handle(&cb, "camera");
+    s.confirm(&cb).await;
+    s.wait(1).await;
+    let mut other = s.second_wire().await;
+    let (_, cb) = other_prepared(&s, &mut other, lifecycle_offer(&s, 1, 0, "recvonly")).await;
+    other.send(s.f.sign(s.confirmation(&cb))).await;
+    s.wait(2).await;
+    let receiver = s.native.adapters[&s.kind]
+        .media_controller(&s.second_id)
+        .unwrap();
+    let subscribe = || {
+        subscriptions::command(
+            "stream.subscribe",
+            receiver.revision(),
+            json!({"subscriptions":[{"strm_id":"camera"}]}),
+        )
+    };
+    other.send(s.f.sign(subscribe())).await;
+    let cb = other.read().await;
+    assert_eq!(cb.kind(), "connection.offer");
+    s.f.verify_server(&cb).await;
+    let target_handle = subscriptions::stream_handle(&cb, "camera");
+    other.send(s.f.sign(s.confirmation(&cb))).await;
+    assert_eq!(other.read().await.kind(), "ack");
+    send(
+        &s.wire,
+        subscriptions::video_sequence(source_handle, 1, 6000),
+    );
+    // The packet is consumed before the reliable notice; it still identifies
+    // which history must be authenticated before any decoder can see its RTP.
+    let first = tagged_video(&other).await;
+    let _source = epoch(&s.f, &mut s.wire).await;
+    let notice = epoch(&s.f, &mut other).await;
+    assert_eq!(first.stream_local_id, target_handle);
+    assert_eq!(
+        format!("{:032x}", first.epoch),
+        notice["payload"]["epoch"].as_str().unwrap()
+    );
+    assert_eq!(
+        first.seq,
+        notice["payload"]["first_sequence"].as_u64().unwrap() as u32
+    );
+    assert_eq!(first.rtp.packet().header.timestamp, 6000);
+    other
+        .send(s.f.sign(subscriptions::command(
+            "stream.unsubscribe",
+            receiver.revision(),
+            json!({"strm_ids":["camera"]}),
+        )))
+        .await;
+    assert_eq!(other.read().await.kind(), "ack");
+    other.send(s.f.sign(subscribe())).await;
+    assert_eq!(other.read().await.kind(), "ack");
+    send(
+        &s.wire,
+        subscriptions::video_sequence(source_handle, 2, 9000),
+    );
+    let next = tagged_video(&other).await;
+    assert_eq!(next.stream_local_id, first.stream_local_id);
+    assert_eq!(
+        next.rtp.packet().header.ssrc,
+        first.rtp.packet().header.ssrc
+    );
+    assert_eq!(next.rtp.packet().header.timestamp, 9000);
+    assert_ne!(
+        next.epoch, first.epoch,
+        "SSRC/handle reuse must not silently inherit the previous decoder history"
+    );
+    let next_notice = epoch(&s.f, &mut other).await;
+    assert_eq!(
+        format!("{:032x}", next.epoch),
+        next_notice["payload"]["epoch"].as_str().unwrap()
+    );
+    assert_eq!(
+        next.seq,
+        next_notice["payload"]["first_sequence"].as_u64().unwrap() as u32
+    );
+    assert!(next_notice["payload"]["revision"].as_u64() > notice["payload"]["revision"].as_u64());
+    send(&other, feedback_request(target_handle, &next_notice, 1));
+    assert_eq!(source_feedback(&s).await.stream_local_id, source_handle);
+    s.wire.server.shutdown().await.unwrap();
+    other.server.shutdown().await.unwrap();
+}
