+#[tokio::test]
+async fn original_ingress_initial_exclusion_refuses_pre_ready_and_post_receipt_activation() {
+    for action in 0..7 {
+        let (f, mode) = fixture().await;
+        mode.store(0, Ordering::SeqCst);
+        let port = f.aa.port(Medium::Audio);
+        let id = desired(Medium::Audio).logical_id;
+        let mut input = f.a.take_ingress(&id).unwrap();
+        let at = Instant::now();
+        let mut consumer = None;
+        let mut scene = None;
+        match action {
+            0 => port.0.state.lock().unwrap().status = PortStatus::Prepared,
+            1 => port.0.state.lock().unwrap().ready = false,
+            2 | 3 => {
+                let c = AudioConsumer::optional(Some(id.clone()), 8000);
+                if action == 3 {
+                    c.activate(true);
+                }
+                *f.a.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&c));
+                consumer = Some(c);
+            }
+            4 | 5 => {
+                let c = SceneConsumer::new(13);
+                if action == 5 {
+                    c.activate();
+                }
+                *f.a.scene_consumer.lock().unwrap() = Some(Arc::downgrade(&c));
+                scene = Some(c);
+            }
+            6 => {
+                let ids = [id.clone()].into_iter().collect();
+                f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Mute, deadline())
+                    .await
+                    .unwrap();
+                f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Unmute, deadline())
+                    .await
+                    .unwrap();
+            }
+            _ => unreachable!(),
+        }
+        let held = f.a.state.lock().unwrap();
+        assert!(
+            port.retain_original_ingress(frame(&port, 160), at).is_err(),
+            "pre-ready or later activation {action} captured"
+        );
+        drop(held);
+        assert!(input.try_recv().is_err());
+        drop((consumer, scene));
+    }
+    // A packet received while already muted cannot be rescued by a later
+    // unmute, even when initial model exclusion prevented reading that mute.
+    let (f, mode) = fixture().await;
+    mode.store(0, Ordering::SeqCst);
+    let port = f.aa.port(Medium::Audio);
+    let id = desired(Medium::Audio).logical_id;
+    let mut input = f.a.take_ingress(&id).unwrap();
+    let ids = [id].into_iter().collect();
+    f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Mute, deadline())
+        .await
+        .unwrap();
+    let held = f.a.state.lock().unwrap();
+    let mut original = port
+        .retain_original_ingress(frame(&port, 160), Instant::now())
+        .unwrap()
+        .unwrap();
+    drop(held);
+    f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Unmute, deadline())
+        .await
+        .unwrap();
+    assert!(original.try_publish_clocked(|_| None).is_err());
+    assert!(input.try_recv().is_err());
+}
