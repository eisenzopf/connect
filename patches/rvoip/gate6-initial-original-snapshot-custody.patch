+#[tokio::test]
+async fn original_ingress_initial_exclusion_keeps_exact_activation_instant() {
+    for audio in [true, false] {
+        let (f, mode) = fixture().await;
+        mode.store(0, Ordering::SeqCst);
+        let port = f.aa.port(Medium::Audio);
+        let mut input =
+            f.a.take_ingress(&desired(Medium::Audio).logical_id)
+                .unwrap();
+        let consumer = AudioConsumer::optional(Some(desired(Medium::Audio).logical_id), 8000);
+        let scene = SceneConsumer::new(14);
+        if audio {
+            consumer.activate(true);
+            *f.a.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&consumer));
+        } else {
+            scene.activate();
+            *f.a.scene_consumer.lock().unwrap() = Some(Arc::downgrade(&scene));
+        }
+        let held = f.a.state.lock().unwrap();
+        let mut original = port
+            .retain_original_ingress(frame(&port, 160), Instant::now())
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::MetadataBusy)
+        ));
+        drop(held);
+        // Same object/ticket, later readiness observation: original activation
+        // metadata must not be silently refreshed by a retry.
+        if audio {
+            consumer.activate(true);
+        } else {
+            scene.activate();
+        }
+        assert!(original.try_publish_clocked(|_| None).is_err());
+        assert!(input.try_recv().is_err());
+    }
