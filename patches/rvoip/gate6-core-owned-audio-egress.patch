@@ -0,0 +1,166 @@
+//! Exact Core-port egress through the actual RTC driver's guarded socket call.
+//!
+//! This component does not report readiness or own peer/port shutdown. The staged
+//! adapter must register cleanup before binding, retain each returned original
+//! write owner, and call cancel_and_drain before acknowledging port cleanup.
+use super::outbound::{OutboundAudioRtpState, OutboundAudioRtpWriter};
+use rvoip_core::{
+    staged_streams::{AdapterMediaPort, ControlResult, QueuedMedia, StreamControlError},
+    stream::StreamKind,
+    stream_lifecycle::{MediaFormat, Medium},
+};
+use std::{
+    sync::{Arc, Mutex},
+    time::Instant,
+};
+use tokio::sync::{OwnedMutexGuard, mpsc};
+use webrtc::media_stream::{
+    Track,
+    track_local::{owned_rtp::*, static_rtp::TrackLocalStaticRTP},
+};
+
+/// Consumes only the receiver belonging to one exact Core port. Callers cannot
+/// substitute a queued frame, frame bytes, stream ID or source authorization.
+pub struct CoreAudioEgress {
+    output: mpsc::Receiver<QueuedMedia>,
+    writer: Arc<OutboundAudioRtpWriter>,
+    payload_type: u8,
+}
+impl CoreAudioEgress {
+    /// Validate static format/track identity before taking the exact port queue.
+    /// The driver independently checks the current negotiated sender/PT/direction
+    /// for every packet. This metadata observation grants no media permission.
+    pub async fn bind(
+        port: &AdapterMediaPort,
+        track: Arc<TrackLocalStaticRTP>,
+        ssrc: u32,
+        payload_type: u8,
+        deadline: Instant,
+    ) -> ControlResult<Self> {
+        let binding = port.binding();
+        let MediaFormat::Encoded {
+            name,
+            clock_rate_hz,
+            channels,
+            fmtp,
+        } = &binding.negotiated.format
+        else {
+            return Err(StreamControlError::Unsupported);
+        };
+        let mime = match name.to_ascii_lowercase().as_str() {
+            "pcmu" | "g.711-mu" => "audio/PCMU",
+            "pcma" | "g.711-a" => "audio/PCMA",
+            _ => return Err(StreamControlError::Unsupported),
+        };
+        if binding.negotiated.requested.medium != Medium::Audio
+            || !binding.sink_ready
+            || *clock_rate_hz != 8000
+            || *channels != 1
+            || fmtp.as_ref().is_some_and(|f| !f.is_empty())
+            || payload_type >= 128
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let codec =
+            tokio::time::timeout_at(tokio::time::Instant::from_std(deadline), track.codec(ssrc))
+                .await
+                .map_err(|_| StreamControlError::Deadline)?
+                .ok_or(StreamControlError::NotReady)?;
+        if !codec.mime_type.eq_ignore_ascii_case(mime)
+            || codec.clock_rate != *clock_rate_hz
+            || codec.channels != u16::from(*channels)
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let writer = OutboundAudioRtpWriter::new(track, ssrc, *clock_rate_hz);
+        if writer.clock_rate_hz() != *clock_rate_hz {
+            return Err(StreamControlError::Unsupported);
+        }
+        let output = port.take_egress()?;
+        Ok(Self {
+            output,
+            writer,
+            payload_type,
+        })
+    }
+    /// Acquire no permission while waiting for a frame or shared audio/DTMF
+    /// sequence ownership. Once returned, retain this exact write until drained.
+    /// Dropping this wait before submission produces no IO. No write is retried.
+    pub async fn submit_next(&mut self, deadline: Instant) -> ControlResult<Option<OwnedRtpWrite>> {
+        let queued =
+            tokio::time::timeout_at(tokio::time::Instant::from_std(deadline), self.output.recv())
+                .await
+                .map_err(|_| StreamControlError::Deadline)?;
+        let Some(queued) = queued else {
+            return Ok(None);
+        };
+        self.writer
+            .queue_core_audio(queued, self.payload_type, deadline)
+            .await
+            .map(Some)
+    }
+}
+struct Packet {
+    queued: QueuedMedia,
+    state: OwnedMutexGuard<OutboundAudioRtpState>,
+}
+pub(crate) struct CoreProducer {
+    packet: Mutex<Option<Packet>>,
+    writer: Arc<OutboundAudioRtpWriter>,
+    payload_type: u8,
+}
+impl CoreProducer {
+    pub(crate) fn new(
+        queued: QueuedMedia,
+        state: OwnedMutexGuard<OutboundAudioRtpState>,
+        writer: Arc<OutboundAudioRtpWriter>,
+        payload_type: u8,
+    ) -> Self {
+        Self {
+            packet: Mutex::new(Some(Packet { queued, state })),
+            writer,
+            payload_type,
+        }
+    }
+}
+#[async_trait::async_trait]
+impl OwnedRtpProducer for CoreProducer {
+    async fn write(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+        let Packet { queued, mut state } = self
+            .packet
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(OwnedRtpError::Refused)?;
+        // Only Core can disclose the frame. Its fresh source/target authority,
+        // route generation, cancellation and original age cover this IO future.
+        queued
+            .deliver(|frame| async move {
+                if frame.kind != StreamKind::Audio
+                    || frame.payload_type != Some(self.payload_type)
+                    || frame.payload.is_empty()
+                    || frame.payload.len() > 1600
+                {
+                    return Err(StreamControlError::NotReady);
+                }
+                let samples = frame.payload.len() as u32; // G.711 mono: one sample/byte.
+                let timestamp = state.allocate_audio_timestamp(frame.timestamp_rtp, samples);
+                let packet = rtc::rtp::Packet {
+                    header: rtc::rtp::Header {
+                        version: 2,
+                        payload_type: self.payload_type,
+                        ssrc: self.writer.ssrc(),
+                        sequence_number: state.next_sequence_number(),
+                        timestamp,
+                        ..Default::default()
+                    },
+                    payload: frame.payload.to_vec().into(),
+                };
+                io.write(packet)
+                    .await
+                    .map_err(|_| StreamControlError::NotReady)
+            })
+            .await
+            .map_err(|_| OwnedRtpError::Refused)
+    }
+}
