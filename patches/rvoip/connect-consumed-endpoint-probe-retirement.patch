+#[cfg(test)]
+mod consumed_probe_metadata_tests {
+    use super::*;
+    #[test]
+    fn endpoint_probe_retirement_is_exact_object_and_never_reactivates_a_consumed_clone() {
+        let old = Arc::new(ClosedAudience {
+            operation: "same-operation".into(),
+            origins: Vec::new(),
+            routing_identity: None,
+            endpoint_probe_retired: std::sync::atomic::AtomicBool::new(false),
+        });
+        let replacement = Arc::new((*old).clone());
+        let unchanged = Arc::new(ClosedAudience {
+            operation: "unchanged-operation".into(),
+            origins: Vec::new(),
+            routing_identity: None,
+            endpoint_probe_retired: std::sync::atomic::AtomicBool::new(false),
+        });
+        let previous = BTreeMap::from([
+            (old.operation.clone(), old.clone()),
+            (unchanged.operation.clone(), unchanged.clone()),
+        ]);
+        let next = BTreeMap::from([
+            (replacement.operation.clone(), replacement.clone()),
+            (unchanged.operation.clone(), unchanged.clone()),
+        ]);
+        retire_consumed_endpoint_probes(&previous, &next);
+        assert!(old.endpoint_probe_retired.load(Ordering::Acquire));
+        assert!(!replacement.endpoint_probe_retired.load(Ordering::Acquire));
+        assert!(!unchanged.endpoint_probe_retired.load(Ordering::Acquire));
+        assert!((*old)
+            .clone()
+            .endpoint_probe_retired
+            .load(Ordering::Acquire));
+    }
+}
