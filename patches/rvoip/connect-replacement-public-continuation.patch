+    /// Current model ownership only. A captured replacement receipt or matching
+    /// public identifier cannot substitute for this live admitted incarnation.
+    pub(crate) fn require_live_binding(
+        &self,
+        member: &Membership,
+        binding: &ConnectionBinding,
+    ) -> Result<()> {
+        self.check_member(member, true)?;
+        let presence = self
+            .participants
+            .get(member.participant())
+            .ok_or(ParticipantTransitionError::Inactive)?;
+        self.check_presence(member, presence)?;
+        presence.appearance.require_current(member)?;
+        let actual = presence
+            .connections
+            .get(binding.connection())
+            .ok_or(ParticipantTransitionError::Inactive)?;
+        actual.require_current(member, &presence.appearance)?;
+        if actual.state() != crate::relationships::BindingState::Active
+            || binding.state() != crate::relationships::BindingState::Active
+            || !actual.same_incarnation(binding)
+            || actual.generation() != binding.generation()
+            || actual.endpoint() != binding.endpoint()
+            || actual.device() != binding.device()
+        {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        Ok(())
     }
 
