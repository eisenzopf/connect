+//! A current managed-route fence for the short post-commit journal interval.
+//! This grants no Store permission and retains no Orchestrator/session owner.
+use super::*;
+use crate::staged_streams::{ControlResult as MediaResult, MediaOwner};
+use rvoip_core_traits::peer_switch::{PeerDeliveryGuard, PeerRouteTicket};
+
+/// Owned by precisely one live managed route. Removal, replacement or session
+/// destruction invalidates every future continuation admission.
+pub(crate) struct ManagedRoutePublication(PeerRouteTicket);
+impl ManagedRoutePublication {
+    pub(crate) fn new() -> Self {
+        Self(PeerRouteTicket::initial())
+    }
+}
+impl Drop for ManagedRoutePublication {
+    fn drop(&mut self) {
+        self.0.retire_if_current();
+    }
+}
+
+/// A non-forgeable observation of this actual live binding and delivery ticket.
+/// The ordinary packet gate still validates port/model/scene/subscription stamps
+/// after policy admission. No mutex or current-domain reader is retained here.
+#[must_use]
+pub struct CurrentReplacementPublication {
+    _delivery: PeerDeliveryGuard,
+}
+fn metadata<T>(error: std::sync::TryLockError<T>) -> StreamControlError {
+    match error {
+        std::sync::TryLockError::WouldBlock => StreamControlError::MetadataBusy,
+        std::sync::TryLockError::Poisoned(_) => StreamControlError::Authority,
+    }
+}
+impl DeviceReplacementPreparation {
+    /// Call after fresh domain admission, never before an awaited Store read.
+    /// An inactive or historical preparation is insufficient: the exact live
+    /// model binding, original lifecycle and current delivery ticket must agree.
+    pub fn current_publication(
+        &self,
+        current: &MediaOwner,
+    ) -> MediaResult<CurrentReplacementPublication> {
+        if self.owner.upgrade().is_none()
+            || self.cancellation.is_cancelled()
+            || tokio::time::Instant::now() >= self.deadline
+            || current.connection.connection() != &self.intent.replacement
+            || current.connection.participant() != &self.intent.participant
+            || current.connection.endpoint() != &self.intent.endpoint
+            || current.connection.device() != &self.intent.device
+            || current.presence.session() != &self.runtime.session
+            || current.member.conversation() != &self.runtime.conversation
+        {
+            return Err(StreamControlError::Authority);
+        }
+        // Store -> managed state -> lifecycle is the existing commit order.
+        // Both locks are immediate and are dropped before the policy returns.
+        let state = self.runtime.state.try_lock().map_err(metadata)?;
+        if state.ended || state.pending.contains_key(&self.intent.replacement) {
+            return Err(StreamControlError::NotReady);
+        }
+        let route = state
+            .routes
+            .get(&self.intent.replacement)
+            .ok_or(StreamControlError::NotReady)?;
+        if route.lifecycle.connection_id != self.candidate.connection_id
+            || route.lifecycle.generation != self.candidate.generation
+            || !Arc::ptr_eq(&route.lifecycle.state, &self.candidate.state)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        state
+            .controller
+            .require_live_binding(&current.member, &current.connection)
+            .map_err(|_| StreamControlError::Authority)?;
+        let lifecycle = route.lifecycle.state.try_lock().map_err(metadata)?;
+        if !lifecycle.active
+            || lifecycle.retired
+            || lifecycle.generation != self.candidate.generation
+            || lifecycle.replacement_reservation.is_some()
+            || lifecycle.peer_admission.as_ref().is_none_or(|permit| {
+                permit.peer.is_closed() || permit.cancellation().is_cancelled()
+            })
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let delivery = route
+            .publication
+            .0
+            .try_begin_delivery()
+            .ok_or(StreamControlError::Authority)?;
+        Ok(CurrentReplacementPublication {
+            _delivery: delivery,
+        })
+    }
+}
