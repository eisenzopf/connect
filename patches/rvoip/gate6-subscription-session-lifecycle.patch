 #[path = "support/record_fetch.rs"]
 mod record_fetch;
+
+fn subscription_session_hint(kind: &str, request: &Value) -> Envelope {
+    let payload = match kind {
+        "session.started" => {
+            json!({"started_at":Utc::now(),"participants_present":["recipient"],"active_connections":[],"negotiated_capabilities":{}})
+        }
+        "session.participant.joined" => {
+            json!({"participant":{"participant_id":"recipient","identity_id":"identity","kind":"human","role":"member","display_name":"Recipient","joined_at":Utc::now()},"via_connection":"connection"})
+        }
+        "session.participant.left" => {
+            json!({"participant_id":"recipient","left_at":Utc::now(),"reason":"left"})
+        }
+        _ => unreachable!(),
+    };
+    let mut value = envelope(kind, payload);
+    value["cid"] = json!("conversation");
+    value["sid"] = json!("session");
+    value["in_reply_to"] = request["id"].clone();
+    Envelope::from_value(value).unwrap()
+}
+#[tokio::test]
+async fn subscription_session_lifecycle_requires_original_scope_and_live_deadline() {
+    let f = Fixture::new();
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let capture = CaptureSubscription::default();
+    let request = subscription_request();
+    drop(
+        peer.handle(&f.sign(request.clone()), &capture, deadline())
+            .await
+            .unwrap(),
+    );
+    let origin = capture.0.lock().take().unwrap();
+    for kind in [
+        "session.started",
+        "session.participant.joined",
+        "session.participant.left",
+    ] {
+        let fact = subscription_session_hint(kind, &request);
+        let (delivery, _) = HandlerDelivery::new(
+            &origin,
+            HandlerReplies::new(vec![fact.clone()]).unwrap(),
+            AuthorityLease::holding(()),
+        )
+        .unwrap();
+        drop(delivery);
+        for field in ["cid", "in_reply_to"] {
+            let mut changed = fact.original().clone();
+            changed[field] = json!("foreign");
+            assert!(matches!(
+                HandlerDelivery::new(
+                    &origin,
+                    HandlerReplies::new(vec![Envelope::from_value(changed).unwrap()]).unwrap(),
+                    AuthorityLease::holding(())
+                ),
+                Err(DispatchError::ReplyMismatch)
+            ));
+        }
+    }
+    tokio::time::sleep_until(origin.deadline()).await;
+    assert!(
+        origin.current(),
+        "terminal grace cannot grant a late lifecycle hint"
+    );
+    for kind in [
+        "session.started",
+        "session.participant.joined",
+        "session.participant.left",
+    ] {
+        assert!(matches!(
+            HandlerDelivery::new(
+                &origin,
+                HandlerReplies::new(vec![subscription_session_hint(kind, &request)]).unwrap(),
+                AuthorityLease::holding(())
+            ),
+            Err(DispatchError::ReplyMismatch)
+        ));
+    }
+    assert!(!peer.cancellation().is_cancelled());
+}
+#[tokio::test]
+async fn subscription_session_lifecycle_blocked_writer_uses_live_deadline_and_releases_actual_guard(
+) {
+    for kind in [
+        "session.started",
+        "session.participant.joined",
+        "session.participant.left",
+    ] {
+        let f = Fixture::new();
+        let mut peer = f.peer();
+        f.authenticate(&mut peer, "old").await;
+        let capture = CaptureSubscription::default();
+        let request = subscription_request();
+        drop(
+            peer.handle(&f.sign(request.clone()), &capture, deadline())
+                .await
+                .unwrap(),
+        );
+        let origin = capture.0.lock().take().unwrap();
+        let value = subscription_session_hint(kind, &request);
+        let guard = f.policy.revoked.clone().read_owned().await;
+        let (delivery, done) = HandlerDelivery::new(
+            &origin,
+            HandlerReplies::new(vec![value]).unwrap(),
+            AuthorityLease::checking(guard, Instant::now() + Duration::from_secs(30), || true),
+        )
+        .unwrap();
+        let handler = Arc::new(DeliverOnce(parking_lot::Mutex::new(Some(delivery))));
+        let entered = Arc::new(Notify::new());
+        let writes = Arc::new(AtomicUsize::new(0));
+        let sink = BlockSubscriptionSink {
+            entered: entered.clone(),
+            writes: writes.clone(),
+        };
+        let job = tokio::spawn(async move {
+            peer.run_frames(
+                futures::stream::pending::<Result<Bytes, DispatchError>>(),
+                sink,
+                handler.as_ref(),
+            )
+            .await
+        });
+        tokio::time::timeout(Duration::from_secs(1), entered.notified())
+            .await
+            .unwrap();
+        let gate = f.policy.revoked.clone();
+        let retiring = tokio::spawn(async move { gate.write_owned().await });
+        tokio::task::yield_now().await;
+        assert!(!retiring.is_finished());
+        assert_eq!(
+            tokio::time::timeout_at(origin.deadline() + Duration::from_millis(500), job)
+                .await
+                .unwrap()
+                .unwrap(),
+            Err(DispatchError::Closed)
+        );
+        assert!(done.await.unwrap().is_err());
+        drop(retiring.await.unwrap());
+        assert_eq!(writes.load(Ordering::SeqCst), 0);
+    }
+}
