+            let origin = super::auth_dispatch::DataOrigin::from_refresh(
+                &refresh,
+                &i.controller,
+                revision,
+                i.scope.clone(),
+                &route.member,
+                &route.endpoint,
+                lease,
+            )
+            .map_err(|_| RvoipError::AdmissionRejected("native refresh metadata denied"))?;
+            (origin, revision)
