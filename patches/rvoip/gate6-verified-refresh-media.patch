+    /// Seal only from the adapter's captured actual credential rebind result.
+    pub(in crate::v2) fn from_refresh(
+        refresh: &VerifiedCredentialRefresh,
+        controller: &Arc<StreamController>,
+        revision: u64,
+        scope: StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        held: &AuthorityLease,
+    ) -> Result<Self, DispatchError> {
+        if !refresh.current()
+            || !held.current()
+            || revision != controller.credential_revision()
+            || !controller.matches_data_credential(&refresh.next.principal)
+            || !controller.is_bound_to(member, endpoint)
+        {
+            return Err(DispatchError::Authority);
+        }
+        refresh
+            .peer
+            .validate_binding(
+                &refresh.next.principal,
+                member.identity(),
+                endpoint.device(),
+            )
+            .map_err(|_| DispatchError::Authority)?;
+        let result = Self {
+            origin: RequestOrigin {
+                incarnation: refresh.next_origin.incarnation,
+                lifetime: refresh.next_origin.lifetime.child_token(),
+                deadline: refresh.next_origin.deadline,
+            },
+            controller: Arc::downgrade(controller),
+            principal: Arc::new(refresh.next.principal.clone()),
+            revision,
+            scope,
+            conversation: member.conversation().clone(),
+            participant: member.participant().clone(),
+            identity: member.identity().clone(),
+            device: endpoint.device().clone(),
+            epoch: member.epoch(),
+            initial: Arc::downgrade(&held._guard),
+        };
+        if !result.current() {
+            return Err(DispatchError::Closed);
+        }
+        Ok(result)
+    }
+    pub(in crate::v2) fn registration_copy(&self) -> Self {
+        let mut result = self.clone();
+        result.origin.lifetime = self.origin.lifetime.child_token();
+        result
+    }
