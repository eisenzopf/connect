+    /// An unchanged credential still creates a new authenticated dispatcher.
+    /// Observe this exact retained controller without changing credential epoch.
+    pub fn refresh_unchanged_credential(
+        &self,
+        id: &ConnectionId,
+        refresh: Arc<super::auth_dispatch::VerifiedCredentialRefresh>,
+        lease: &super::auth_dispatch::AuthorityLease,
+    ) -> Result<RefreshedNativeMedia> {
+        if refresh.previous().token_id != refresh.next().token_id
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &refresh.previous().principal,
+                &refresh.next().principal,
+            )
+            || !refresh.current()
+            || !lease.current()
+        {
+            return Err(RvoipError::AdmissionRejected("credential refresh differs"));
+        }
+        let route = self
+            .routes
+            .get(id)
+            .map(|r| r.value().clone())
+            .ok_or_else(|| RvoipError::ConnectionNotFound(id.clone()))?;
+        if !route
+            .peer
+            .upgrade()
+            .is_some_and(|p| Arc::ptr_eq(&p, refresh.peer()))
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "credential physical peer differs",
+            ));
+        }
+        self.physical_source(id)?;
+        let (origin, revision) = {
+            let installed = route.installation.lock().unwrap_or_else(|p| p.into_inner());
+            let i = installed.as_ref().ok_or(RvoipError::NotImplemented(
+                "native staged media not configured",
+            ))?;
+            if !i.backend.flow.confirmed_at(i.controller.revision()) {
+                return Err(RvoipError::AdmissionRejected("native flow not confirmed"));
