+//! Metadata sealed only after authenticated refresh, before any media effect.
+use super::*;
+use rvoip_auth_core::bearer::ValidatedBearer;
+/// The exact verified refresh and successor dispatch on one physical peer.
+/// It is neither a command envelope nor a reusable authority grant.
+pub struct VerifiedCredentialRefresh {
+    pub(in crate::v2) previous: Arc<ValidatedBearer>,
+    pub(in crate::v2) next: Arc<ValidatedBearer>,
+    pub(in crate::v2) peer: Arc<rvoip_core::peer_admission::PeerAdmission>,
+    pub(super) next_origin: RequestOrigin,
+    pub(in crate::v2) exchange: Option<super::super::auth_peer::exchange::ExchangeContext>,
+    physical: CancellationToken,
+    refresh_id: String,
+    key_id: String,
+    algorithm: String,
+    deadline: Instant,
+}
+impl std::fmt::Debug for VerifiedCredentialRefresh {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("VerifiedCredentialRefresh(redacted)")
+    }
+}
+impl VerifiedCredentialRefresh {
+    pub fn previous(&self) -> &ValidatedBearer {
+        &self.previous
+    }
+    pub fn next(&self) -> &ValidatedBearer {
+        &self.next
+    }
+    pub fn peer(&self) -> &Arc<rvoip_core::peer_admission::PeerAdmission> {
+        &self.peer
+    }
+    pub fn refresh_id(&self) -> &str {
+        &self.refresh_id
+    }
+    pub fn key_id(&self) -> &str {
+        &self.key_id
+    }
+    pub fn algorithm(&self) -> &str {
+        &self.algorithm
+    }
+    pub fn deadline(&self) -> Instant {
+        self.deadline
+    }
+    pub fn cancellation(&self) -> CancellationToken {
+        self.next_origin.lifetime.clone()
+    }
+    pub fn retire_physical(&self) {
+        self.physical.cancel();
+    }
+    pub fn current(&self) -> bool {
+        Instant::now() < self.deadline
+            && !self.physical.is_cancelled()
+            && !self.next_origin.lifetime.is_cancelled()
+            && !self.peer.is_closed()
+    }
+}
+impl AuthenticatedDispatch {
+    /// Called only by the authenticated peer after old-key verification and
+    /// successor credential/assurance/owner admission. No raw bearer is copied
+    /// into an envelope or retained by media registrations.
+    pub(in crate::v2) fn verified_credential_refresh(
+        &self,
+        previous: Arc<ValidatedBearer>,
+        next: Arc<ValidatedBearer>,
+        request: &Envelope,
+        physical: CancellationToken,
+        deadline: Instant,
+    ) -> Result<Arc<VerifiedCredentialRefresh>, DispatchError> {
+        if request.kind() != "auth.refresh"
+            || !previous.principal.has_same_owner(&next.principal)
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &self.principal,
+                &next.principal,
+            )
+            || self.lifetime.is_cancelled()
+            || Instant::now() >= deadline
+        {
+            return Err(DispatchError::Authority);
+        }
+        let peer = self.peer.clone().ok_or(DispatchError::Authority)?;
+        let expiry = super::super::auth_peer::effective_expiry(&next.principal)?;
+        let media_deadline = Instant::now()
+            + (expiry - chrono::Utc::now())
+                .to_std()
+                .map_err(|_| DispatchError::Closed)?;
+        let exchange = self.exchanges.as_ref().map(|sender| {
+            super::super::auth_peer::exchange::ExchangeContext::new(
+                sender.clone(),
+                self.authority.clone(),
+                self.verifier.clone(),
+                self.replay.clone(),
+                self.principal.clone(),
+                self.lifetime.clone(),
+                media_deadline,
+            )
+        });
+        Ok(Arc::new(VerifiedCredentialRefresh {
+            previous,
+            next,
+            peer,
+            exchange,
+            next_origin: RequestOrigin {
+                incarnation: self.incarnation,
+                lifetime: self.lifetime.clone(),
+                deadline: media_deadline,
+            },
+            physical,
+            refresh_id: request.id().into(),
+            key_id: request.original()["signature"]["keyid"]
+                .as_str()
+                .ok_or(DispatchError::Signature)?
+                .into(),
+            algorithm: request.original()["signature"]["alg"]
+                .as_str()
+                .ok_or(DispatchError::Signature)?
+                .into(),
+            deadline,
+        }))
+    }
+}
