+// Only a Core refusal returns an unsubmitted original. An IO callback result
+// always takes the separate Submitted arm, even if it reports these errors.
+fn retryable_refusal(problem: &StreamControlError) -> bool {
+    matches!(problem, StreamControlError::NotReady | StreamControlError::MetadataBusy)
+}
+#[cfg(test)]
+mod retry_tests {
+    use super::*;
+    #[test]
+    fn only_definite_ready_audio_absence_or_metadata_exclusion_is_retryable() {
+        assert!(retryable_refusal(&StreamControlError::NotReady));
+        assert!(retryable_refusal(&StreamControlError::MetadataBusy));
+        for permanent in [StreamControlError::Authority, StreamControlError::Cancelled,
+            StreamControlError::Deadline, StreamControlError::Backpressure,
+            StreamControlError::Unsupported, StreamControlError::NotRecipient,
+            StreamControlError::CleanupUnconfirmed] {
+            assert!(!retryable_refusal(&permanent));
+        }
+    }
+}
