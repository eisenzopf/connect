+#[tokio::test]
+async fn original_audio_subscription_metadata_wait_obeys_original_deadline_and_cancellation() {
+    for cancelled in [false, true] {
+        let s = Scene::new(&[Medium::Audio]).await;
+        let revision = s.f.b.revision();
+        let mut output = s.f.ba.port(Medium::Audio).take_egress().unwrap();
+        let cancel = CancellationToken::new();
+        let source = s.f.a.state.lock().unwrap();
+        let mut original = Box::pin(s.scene.change_media_subscriptions(
+            &s.f.b.connection,
+            revision,
+            audio_only(&s),
+            tokio::time::Instant::now() + Duration::from_millis(30),
+            cancel.clone(),
+            None,
+        ));
+        assert!(
+            std::future::poll_fn(|cx| std::task::Poll::Ready(original.as_mut().poll(cx)))
+                .await
+                .is_pending()
+        );
+        if cancelled {
+            cancel.cancel();
+        }
+        let result = original.await;
+        assert!(
+            if cancelled {
+                matches!(result, Err(StreamControlError::Cancelled))
+            } else {
+                matches!(result, Err(StreamControlError::Deadline))
+            },
+            "{result:?}"
+        );
+        drop(source);
+        assert_eq!(s.f.b.revision(), revision);
+        s.publish(Medium::Audio, 160);
+        s.scene.tick();
+        assert!(
+            output.try_recv().is_err(),
+            "uncommitted subscription reached IO"
+        );
+    }
+}
