+fn audio_only(s: &Scene) -> MediaSubscriptionChange {
+    MediaSubscriptionChange {
+        selection: None,
+        audio: Some(AudioSubscriptionChange::Subscribe(vec![
+            AudioSubscription::Stream(MediaStreamRef {
+                connection: s.f.a.connection.clone(),
+                logical: desired(Medium::Audio).logical_id,
+            }),
+        ])),
+        direct: None,
+    }
+}
