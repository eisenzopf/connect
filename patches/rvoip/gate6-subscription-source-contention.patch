+#[tokio::test]
+async fn original_audio_subscription_waits_for_source_metadata_then_commits_once() {
+    let s = Scene::new(&[Medium::Audio]).await;
+    let mut output = s.f.ba.port(Medium::Audio).take_egress().unwrap();
+    let revision = s.f.b.revision();
+    let budget = s.f.b.stream_open_budget();
+    let source = s.f.a.state.lock().unwrap();
+    let mut original = Box::pin(s.scene.change_media_subscriptions(
+        &s.f.b.connection,
+        revision,
+        audio_only(&s),
+        deadline(),
+        CancellationToken::new(),
+        None,
+    ));
+    let first = std::future::poll_fn(|cx| std::task::Poll::Ready(original.as_mut().poll(cx))).await;
+    assert!(
+        first.is_pending(),
+        "source metadata collision must yield within the same command: {first:?}"
+    );
+    assert_eq!(s.f.b.revision(), revision);
+    assert!(output.try_recv().is_err());
+    drop(source);
+    assert_eq!(original.await.unwrap(), revision + 1);
+    assert_eq!(s.f.b.revision(), revision + 1);
+    assert_eq!(s.f.b.stream_open_budget(), budget);
+    s.publish(Medium::Audio, 160);
+    s.scene.tick();
+    outgoing(&mut output)
+        .await
+        .deliver(|frame| async move {
+            use rvoip_media_core::codec::factory::CodecFactory;
+            let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+            assert!(
+                codec
+                    .decode(&frame.payload)
+                    .unwrap()
+                    .samples
+                    .iter()
+                    .any(|sample| *sample > 1000)
+            );
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
