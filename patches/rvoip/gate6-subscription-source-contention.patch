+// Wait only after a definite precommit metadata collision. Callers have
+// released scene/state/policy guards and still own the original inflight slot,
+// plan, credentials and cutoff. No authority lease is shared across the wait.
+async fn metadata_wait(
+    shutdown: CancellationToken,
+    cancel: CancellationToken,
+    control_cancel: CancellationToken,
+    deadline: tokio::time::Instant,
+) -> ControlResult<()> {
+    tokio::select! { biased;
+        _=cancel.cancelled()=>Err(StreamControlError::Cancelled),
+        _=shutdown.cancelled()=>Err(StreamControlError::Cancelled),
+        _=control_cancel.cancelled()=>Err(StreamControlError::Cancelled),
+        _=tokio::time::sleep_until(deadline)=>Err(StreamControlError::Deadline),
+        _=tokio::time::sleep(Duration::from_millis(2))=>Ok(())
+    }
+}
