+#[tokio::test]
+async fn original_audio_subscription_slot_wait_keeps_real_revision_conflicts() {
+    let s = Scene::new(&[Medium::Audio]).await;
+    let revision = s.f.b.revision();
+    let tick = s.f.b.inflight.clone().try_acquire_owned().unwrap();
+    // Queue the competing command first: Tokio reserves the released permit
+    // for its first waiter even before that future is polled again.
+    let mut concurrent = Box::pin(apply(&s, audio_only(&s)));
+    assert!(
+        std::future::poll_fn(|cx| std::task::Poll::Ready(concurrent.as_mut().poll(cx)))
+            .await
+            .is_pending()
+    );
+    let mut original = Box::pin(s.scene.change_media_subscriptions(
+        &s.f.b.connection,
+        revision,
+        audio_only(&s),
+        deadline(),
+        CancellationToken::new(),
+        None,
+    ));
+    assert!(
+        std::future::poll_fn(|cx| std::task::Poll::Ready(original.as_mut().poll(cx)))
+            .await
+            .is_pending()
+    );
+    drop(tick);
+    assert_eq!(concurrent.await.unwrap(), revision + 1);
+    assert!(matches!(
+        original.await,
+        Err(StreamControlError::Model(MediaTransitionError::Conflict))
+    ));
+    assert_eq!(s.f.b.revision(), revision + 1);
+}
