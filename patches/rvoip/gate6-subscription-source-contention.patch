+#[tokio::test]
+async fn original_audio_subscription_metadata_wait_rechecks_authority_before_commit() {
+    let s = Scene::new(&[Medium::Audio]).await;
+    let revision = s.f.b.revision();
+    let source = s.f.a.state.lock().unwrap();
+    let mut original = Box::pin(s.scene.change_media_subscriptions(
+        &s.f.b.connection,
+        revision,
+        audio_only(&s),
+        deadline(),
+        CancellationToken::new(),
+        None,
+    ));
+    assert!(
+        std::future::poll_fn(|cx| std::task::Poll::Ready(original.as_mut().poll(cx)))
+            .await
+            .is_pending()
+    );
+    // No policy reader survives the metadata backoff, so this writer enters.
+    s.f.policy.0.write().await.revoked.insert("bob".into());
+    drop(source);
+    assert!(matches!(original.await, Err(StreamControlError::Authority)));
+    assert_eq!(s.f.b.revision(), revision);
+}
