+    pub(super) fn reserved_video_port_binding(&self, native:&ReservedVideoBinding, peer:&Arc<RvoipPeerConnection>) -> ControlResult<super::ReservedVideoPortBinding> {
+        if !self.current() {return Err(StreamControlError::NotReady);}
