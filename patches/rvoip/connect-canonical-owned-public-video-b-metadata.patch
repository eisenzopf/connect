+            let io=entry.value();
+            if io.binding.negotiated.requested.logical_id!=profile.public_stream_id {continue;}
+            let Some(port)=io.port.upgrade() else {continue;};
+            if !matches!(port.status(),PortStatus::Active|PortStatus::Paused) {continue;}
+            if found.is_some() || profile.role(&io.binding.negotiated.requested)?!=Some(super::reserved_video::VideoRole::PublicReserved) {return Err(StreamControlError::Authority);}
+            let setup=io.health.setup.try_lock().map_err(|_|StreamControlError::MetadataBusy)?;
+            if setup.closing || !setup.tasks.is_empty() || !io.health.confirmed() {return Err(StreamControlError::NotReady);}
+            let owner=io.reserved_video.as_ref().and_then(Weak::upgrade).ok_or(StreamControlError::NotReady)?;
+            let queue=owner.video.try_lock().map_err(|_|StreamControlError::MetadataBusy)?;
