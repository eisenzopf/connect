+//! Original Route/Backend/Port-owned negotiation metadata; never a grant/F.
+use super::*;
+use rvoip_core::staged_streams::{AdapterMediaPort,ControlResult,PortStatus,StreamControlError as E};
+use rvoip_core::staged_streams::physical_video_exposure::PhysicalVideoExposureSnapshot;
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub struct ReservedVideoPortBinding {
+    pub native: ReservedVideoBinding,
+    pub conversation_id: ConversationId,
+    pub session_id: SessionId,
+    pub connection_id: ConnectionId,
+    pub transport_stream_id: StreamId,
+    pub stream_generation: u64,
+    pub connection_generation: u64,
+    pub physical_writer_incarnation: u128,
+    pub realm_incarnation: u128,
+}
+// Inputs only come from the original held queue and exact Core Port. No
+// wire-to-operation path exists; returned scalars themselves are not proof.
+pub(super) fn from_owned_binding(port:&AdapterMediaPort,native:&ReservedVideoBinding,owned:(u32,u8,PhysicalVideoExposureSnapshot),expected:u128)->ControlResult<ReservedVideoPortBinding> {
+    let (ssrc,pt,queue)=owned;
+    let binding=port.binding();
+    if !matches!(port.status(),PortStatus::Active|PortStatus::Paused) || !binding.sink_ready || binding.generation==0 || binding.connection_generation==0 {return Err(E::NotReady);}
+    if native.logical_stream_id!=binding.negotiated.requested.logical_id || native.primary_ssrc!=ssrc || native.payload_type!=pt || native.clock_rate_hz!=90000 || pt>=128 {return Err(E::Authority);}
+    let observed=port.physical_video_exposure().ok_or(E::Unsupported)?;
+    if observed.physical_family!=queue.physical_family {return Err(E::Authority);}
+    if expected==0 || !observed.coverage_complete || !queue.coverage_complete || observed.realm_incarnation!=Some(expected) || queue.realm_incarnation!=Some(expected) || observed.maximum_potential_ordinal!=0 || queue.maximum_potential_ordinal!=0 {return Err(E::Unsupported);}
+    let (conversation_id,session_id,connection_id)=port.context_ids()?;
+    Ok(ReservedVideoPortBinding {native:native.clone(),conversation_id,session_id,connection_id,transport_stream_id:binding.transport_id.clone(),stream_generation:binding.generation,connection_generation:binding.connection_generation,physical_writer_incarnation:observed.physical_family,realm_incarnation:expected})
+}
+impl CanonicalWebRtcAdapter {
+    /// Read the same original unstarted B queue's actual Core generations and
+    /// physical family. No SDP-generated writer UUID, authority, F or future
+    /// no-escape guarantee. Root must retain its original owned control/seal.
+    pub async fn reserved_video_port_binding(&self,id:&ConnectionId,peer:&Arc<PeerAdmission>,deadline:tokio::time::Instant)->ControlResult<ReservedVideoPortBinding> {
+        let route=self.routes.get(id).map(|r|r.value().clone()).ok_or(E::NotReady)?;
+        let current=|| !route.cancel.is_cancelled() && Weak::ptr_eq(&route.peer,&Arc::downgrade(peer)) && route.binding.current(peer,id) && self.routes.get(id).is_some_and(|r|Arc::ptr_eq(r.value(),&route));
+        if !current() {return Err(E::Cancelled);}
+        let (controller,backend)=route.installation.lock().map_err(|_|E::Authority)?.as_ref().map(|i|(i.controller.clone(),i.backend.clone())).ok_or(E::NotReady)?;
+        let original=route.binding.peer_internal(deadline).await.map_err(|_|E::NotReady)?;
+        if !current() {return Err(E::Cancelled);}
+        let native=tokio::time::timeout_at(deadline,original.reserved_video_descriptor()).await.map_err(|_|E::Deadline)??;
+        let binding=backend.reserved_video_port_binding(&native,&original)?;
+        if !current() || route.session!=binding.session_id || !controller.active_bindings().iter().any(|b|b.transport_id==binding.transport_stream_id && b.generation==binding.stream_generation && b.connection_generation==binding.connection_generation && b.negotiated.requested.logical_id==native.logical_stream_id) {return Err(E::NotReady);}
+        Ok(binding)
+    }
+}
