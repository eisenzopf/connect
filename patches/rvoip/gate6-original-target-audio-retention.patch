+use super::*;
+use crate::staged_streams::audio_subscriptions::{AudioSubscription, AudioSubscriptionChange};
+
+const ANCHOR: u64 = 100u64 << 32;
+
+fn value(index: usize) -> i16 {
+    1200 + (index as i16) * 100
+}
+fn publish(s: &Scene, index: usize) {
+    s.publish_clocked_ms(
+        0,
+        value(index),
+        8000 + index as u32 * 160,
+        20,
+        Some(source_clock(
+            700,
+            8000,
+            8000,
+            ANCHOR,
+            Arc::new(AtomicBool::new(true)),
+        )),
+    );
+}
+async fn original(queued: QueuedMedia, index: usize) -> u32 {
+    decoded(
+        queued,
+        &expected_pcm(value(index)),
+        ntp_ms(ANCHOR, index as u64 * 20),
+    )
+    .await
+}
+fn assert_no_reader(s: &Scene) {
+    drop(
+        s.policy
+            .0
+            .try_write()
+            .expect("pending receiver retained a policy reader"),
+    );
+}
