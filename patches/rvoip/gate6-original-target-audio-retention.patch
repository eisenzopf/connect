+#[tokio::test]
+async fn repeated_target_contention_catches_up_continuous_original_audio_without_drift() {
+    let (s, target, probe) = scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    let mut blocked = None;
+    let mut received = 0;
+    let mut previous = None;
+    for index in 0..36 {
+        if index % 9 == 0 {
+            blocked = Some(target.clone().write_owned().await);
+        }
+        if index % 9 == 2 {
+            drop(blocked.take());
+        }
+        publish(&s, index);
+        s.mixer.tick();
+        original(
+            carol.try_recv().expect("unblocked recipient stalled"),
+            index,
+        )
+        .await;
+        while let Ok(queued) = bob.try_recv() {
+            let stamp = original(queued, received).await;
+            if let Some(old) = previous {
+                assert_eq!(stamp.wrapping_sub(old), 160);
+            }
+            previous = Some(stamp);
+            received += 1;
+        }
+        if index % 9 >= 3 {
+            assert_eq!(
+                received,
+                index + 1,
+                "one-per-tick recovery left a permanent backlog"
+            );
+        }
+        assert_no_reader(&s);
+        assert!(carol.try_recv().is_err());
+    }
+    assert_eq!(received, 36);
+    assert!(probe.target_refused.load(Ordering::Acquire) >= 8);
+    s.mixer.tick();
+    assert!(bob.try_recv().is_err() && carol.try_recv().is_err());
+}
