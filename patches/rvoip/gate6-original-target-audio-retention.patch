+        Ok(Box::new(ExpiringLease { inner, expiry }))
+    }
+    fn receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source_context: bool,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
