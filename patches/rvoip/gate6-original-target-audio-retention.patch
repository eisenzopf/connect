+//! Original target PCM survives temporary admission contention, never authority.
+use super::super::audio_subscriptions::SubscriptionStamp;
+use super::*;
+use rvoip_core_traits::peer_switch::PeerDeliveryGuard;
+
+const MAX_PENDING_QUANTA: usize = 10;
+const MAX_RECOVERY_ATTEMPTS: usize = 2;
+
+struct PendingSource {
+    origin: Contribution,
+    admitted_at: Instant,
+}
+
+pub(super) struct PendingAudioQuantum {
+    samples: Vec<i16>,
+    clocks: Vec<ClockPoint>,
+    sources: Vec<PendingSource>,
+    target: Arc<Port>,
+    target_ticket: PeerRouteTicket,
+    target_consumer: Option<ConsumerStamp>,
+    target_scene: Option<scene_consumer::SceneStamp>,
+    subscription: SubscriptionStamp,
+    admitted_at: Instant,
+    deadline: tokio::time::Instant,
+    fallback_timestamp: u32,
+    deferred: bool,
+}
+
+// Transient guards exist only inside one synchronous attempt. Neither a
+// pending quantum nor its queued output owns this type across a wait.
+struct CurrentTarget {
+    _leases: Vec<Box<dyn MediaAuthorityLease>>,
+    _admissions: Vec<audio_consumer::MediaAdmission>,
+    _subscriptions: Vec<PeerDeliveryGuard>,
+}
+
+impl PendingAudioQuantum {
+    pub(super) fn capture(
+        member: &mut AudioMember,
+        inputs: &HashMap<ConnectionId, (ParticipantId, Vec<Segment>)>,
+        rate: u32,
+    ) -> Option<Self> {
+        let subscription = member.subscriptions.stamp();
+        let target_ticket = member.ticket.clone();
+        let target_consumer = Some(member.stamp.clone());
+        let target_scene = member.controller.current_scene_stamp().ok()?;
+        let mut total = vec![0i32; (rate / 50) as usize];
+        let mut clocks = Vec::new();
+        let mut sources = Vec::<PendingSource>::new();
+        let mut oldest = Instant::now();
+        let mut bound = tokio::time::Instant::now() + Duration::from_millis(200);
+        for (participant, segments) in inputs.values() {
+            if participant == &member.participant {
+                continue;
+            }
+            for segment in segments {
+                if segment.admitted_at < member.target_started.max(subscription.started) {
+                    member.observations.note(
+                        AudioStage::TargetBeforeStart,
+                        None,
+                        segment.samples.len(),
+                    );
+                    continue;
+                }
+                if tokio::time::Instant::now() >= segment.deadline {
+                    member.observations.note(
+                        AudioStage::TargetExpired,
+                        None,
+                        segment.samples.len(),
+                    );
+                    continue;
+                }
+                let Some(source) = segment.origin.source.owner.upgrade() else {
+                    member
+                        .observations
+                        .note(AudioStage::SourceGone, None, segment.samples.len());
+                    continue;
+                };
+                let Ok(_selection) =
+                    subscription.begin(&source, &segment.origin.descriptor.logical_id)
+                else {
+                    member.observations.note(
+                        AudioStage::SubscriptionRefused,
+                        None,
+                        segment.samples.len(),
+                    );
+                    continue;
+                };
+                // This is privately retained selection intent. Publication still
+                // requires every exact source and target grant below, and again
+                // in QueuedMedia. No target grant is inferred from selection.
+                for (index, sample) in segment.samples.iter().enumerate() {
+                    total[segment.offset + index] += i32::from(*sample);
+                }
+                clocks.push(segment.clock.clone());
+                oldest = oldest.min(segment.admitted_at);
+                bound = bound.min(segment.deadline);
+                if let Some(existing) = sources
+                    .iter_mut()
+                    .find(|old| Arc::ptr_eq(&old.origin.source, &segment.origin.source))
+                {
+                    existing.admitted_at = existing.admitted_at.min(segment.admitted_at);
+                } else {
+                    sources.push(PendingSource {
+                        origin: segment.origin.clone(),
+                        admitted_at: segment.admitted_at,
+                    });
+                }
+            }
+        }
+        if sources.is_empty() {
+            member.observations.note(AudioStage::EmptyOutput, None, 0);
+            return None;
+        }
+        // The original target credential bound applies even if its first policy
+        // callback is busy. Rotation or a later grant can only shorten it.
+        bound = StreamController::command_deadline(
+            &member.controller.credential_snapshot().principal,
+            bound.min(tokio::time::Instant::from_std(
+                oldest + Duration::from_millis(200),
+            )),
+        );
+        for source in &mut sources {
+            source.origin.admission_deadline = Some(bound);
+        }
+        let quantum = Self {
+            samples: total
+                .into_iter()
+                .map(|sample| sample.clamp(i32::from(i16::MIN), i32::from(i16::MAX)) as i16)
+                .collect(),
+            clocks,
+            sources,
+            target: member.port.clone(),
+            target_ticket,
+            target_consumer,
+            target_scene,
+            subscription,
+            admitted_at: oldest,
+            deadline: bound,
+            fallback_timestamp: member
+                .ticks
+                .wrapping_mul(u64::from(member.codecs.info.clock_rate_hz / 50))
+                as u32,
+            deferred: false,
+        };
+        quantum
+            .current(&member.controller, &member.port)
+            .then_some(quantum)
+    }
+
+    fn current(&self, target: &Arc<StreamController>, port: &Arc<Port>) -> bool {
+        !target.shutdown.is_cancelled()
+            && Arc::ptr_eq(port, &self.target)
+            && self
+                .target
+                .owner
+                .upgrade()
+                .is_some_and(|owner| Arc::ptr_eq(&owner, target))
+            && self.target_ticket.is_current()
+            && self
+                .target_consumer
+                .as_ref()
+                .is_none_or(|stamp| stamp.active_at(self.admitted_at))
+            && self
+                .target_scene
+                .as_ref()
+                .is_none_or(|stamp| stamp.active_at(self.admitted_at))
+            && self.subscription.is_current()
+            && self.sources.iter().all(|source| {
+                source.origin.ticket.is_current()
+                    && source
+                        .origin
+                        .consumer
+                        .as_ref()
+                        .is_none_or(|stamp| stamp.active_at(source.admitted_at))
+                    && source
+                        .origin
+                        .scene
+                        .as_ref()
+                        .is_none_or(|stamp| stamp.active_at(source.admitted_at))
+                    && source
+                        .origin
+                        .source
+                        .owner
+                        .upgrade()
+                        .is_some_and(|owner| !owner.shutdown.is_cancelled())
+            })
+    }
+
+    fn admit(
+        &mut self,
+        target: &Arc<StreamController>,
+        phase: &mut AudioStage,
+    ) -> ControlResult<CurrentTarget> {
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        if !self.current(target, &self.target) {
+            return Err(StreamControlError::Cancelled);
+        }
+        self.subscription.require_target(target)?;
+        let mut current = CurrentTarget {
+            _leases: Vec::new(),
+            _admissions: Vec::new(),
+            _subscriptions: Vec::new(),
+        };
+        for source in &self.sources {
+            let provenance = &source.origin;
+            let owner = provenance
+                .source
+                .owner
+                .upgrade()
+                .ok_or(StreamControlError::Cancelled)?;
+            if owner.conversation != target.conversation
+                || owner.session != target.session
+                || !Arc::ptr_eq(&owner.policy, &target.policy)
+            {
+                return Err(StreamControlError::Authority);
+            }
+            current._subscriptions.push(
+                self.subscription
+                    .begin(&owner, &provenance.descriptor.logical_id)?,
+            );
+            *phase = AudioStage::TargetPendingSourceDeferred;
+            let (lease, admission, bound) = owner.admit_retained_source_with_deadline(
+                &provenance.source,
+                &provenance.ticket,
+                provenance.consumer.as_ref(),
+                provenance.scene.as_ref(),
+                &provenance.custody,
+                Some(&mut self.deadline),
+            )?;
+            self.deadline = self.deadline.min(bound);
+            current._leases.push(lease);
+            current._admissions.push(admission);
+            *phase = AudioStage::TargetDeferred;
+            let (lease, admission, bound) = target.admit_with_deadline(
+                &self.target,
+                &self.target_ticket,
+                true,
+                Some(&provenance.descriptor),
+                ConsumerCheck::Retained(self.target_consumer.as_ref()),
+                None,
+                scene_consumer::SceneCheck::retained_receive(
+                    self.target_scene.as_ref(),
+                    provenance.scene.as_ref(),
+                    source.admitted_at,
+                ),
+                None,
+                None,
+                current
+                    ._leases
+                    .last()
+                    .and_then(|lease| lease.packet_context()),
+                Some(&mut self.deadline),
+            )?;
+            self.deadline = self.deadline.min(bound);
+            current._leases.push(lease);
+            current._admissions.push(admission);
+        }
+        if tokio::time::Instant::now() >= self.deadline || !self.current(target, &self.target) {
+            return Err(StreamControlError::Deadline);
+        }
+        Ok(current)
+    }
+}
+
+impl AudioMember {
+    pub(super) fn prune_target_pending(&mut self) {
+        let mut retained = VecDeque::new();
+        while let Some(quantum) = self.target_pending.pop_front() {
+            let stage = if tokio::time::Instant::now() >= quantum.deadline {
+                Some(AudioStage::TargetPendingExpired)
+            } else if !quantum.current(&self.controller, &self.port) {
+                Some(AudioStage::TargetPendingRefused)
+            } else {
+                None
+            };
+            if let Some(stage) = stage {
+                self.observations.note(
+                    stage,
+                    Some(quantum.fallback_timestamp),
+                    quantum.samples.len(),
+                );
+            } else {
+                retained.push_back(quantum);
+            }
+        }
+        self.target_pending = retained;
+    }
+
+    pub(super) fn retain_target_quantum(&mut self, quantum: PendingAudioQuantum) {
+        if self.target_pending.len() >= MAX_PENDING_QUANTA {
+            self.observations.note(
+                AudioStage::TargetPendingFull,
+                Some(quantum.fallback_timestamp),
+                quantum.samples.len(),
+            );
+            return;
+        }
+        self.target_pending.push_back(quantum);
+    }
+
+    pub(super) fn prepare_target_outputs(
+        &mut self,
+        rate: u32,
+    ) -> Vec<(mpsc::OwnedPermit<QueuedMedia>, QueuedMedia)> {
+        let mut outputs = Vec::new();
+        // Two attempts provide bounded catch-up under continuous input. A busy
+        // original immediately stops this recipient; no retry spin or wait.
+        for _ in 0..MAX_RECOVERY_ATTEMPTS {
+            let Some(mut quantum) = self.target_pending.pop_front() else {
+                break;
+            };
+            let permit = match quantum.target.egress.clone().try_reserve_owned() {
+                Ok(permit) => permit,
+                Err(_) => {
+                    self.observations.note(
+                        AudioStage::OutputFull,
+                        Some(quantum.fallback_timestamp),
+                        quantum.samples.len(),
+                    );
+                    self.target_pending.push_front(quantum);
+                    break;
+                }
+            };
+            let mut phase = AudioStage::TargetPendingSourceDeferred;
+            let current = match quantum.admit(&self.controller, &mut phase) {
+                Ok(current) => current,
+                Err(StreamControlError::NotReady)
+                    if tokio::time::Instant::now() < quantum.deadline
+                        && quantum.current(&self.controller, &self.port) =>
+                {
+                    self.observations.note(
+                        phase,
+                        Some(quantum.fallback_timestamp),
+                        quantum.samples.len(),
+                    );
+                    if !quantum.deferred {
+                        self.observations.note(
+                            AudioStage::TargetRetained,
+                            Some(quantum.fallback_timestamp),
+                            quantum.samples.len(),
+                        );
+                        quantum.deferred = true;
+                    }
+                    self.target_pending.push_front(quantum);
+                    break;
+                }
+                Err(problem) => {
+                    self.observations.note(
+                        if matches!(problem, StreamControlError::Deadline) {
+                            AudioStage::TargetPendingExpired
+                        } else {
+                            AudioStage::TargetPendingRefused
+                        },
+                        Some(quantum.fallback_timestamp),
+                        quantum.samples.len(),
+                    );
+                    // A permanent refusal ends this retained programme. A
+                    // later permission restoration must not resurrect unseen
+                    // older copies behind the refused FIFO head.
+                    self.target_pending.clear();
+                    break;
+                }
+            };
+            let deferred = quantum.deferred;
+            let timestamp = quantum.fallback_timestamp;
+            let samples = quantum.samples.len();
+            let queued = self.encode_pending(quantum, rate);
+            drop(current);
+            if let Some(queued) = queued {
+                if deferred {
+                    self.observations
+                        .note(AudioStage::TargetRecovered, Some(timestamp), samples);
+                }
+                outputs.push((permit, queued));
+            }
+        }
+        outputs
+    }
+}
+
+impl AudioMember {
+    fn encode_pending(&mut self, quantum: PendingAudioQuantum, rate: u32) -> Option<QueuedMedia> {
+        let PendingAudioQuantum {
+            samples,
+            clocks,
+            sources,
+            target,
+            target_ticket,
+            target_consumer,
+            target_scene,
+            subscription,
+            admitted_at: oldest,
+            deadline: bound,
+            fallback_timestamp,
+            deferred: _,
+        } = quantum;
+        let size = (rate / 50) as usize;
+        let provenance = sources
+            .into_iter()
+            .map(|mut source| {
+                source.origin.admission_deadline = Some(
+                    source
+                        .origin
+                        .admission_deadline
+                        .map_or(bound, |old| old.min(bound)),
+                );
+                source.origin
+            })
+            .collect::<Vec<_>>();
+        let changed = self
+            .previous_subscription
+            .as_ref()
+            .is_none_or(|old| !old.is_current())
+            || self.previous_sources.len() != provenance.len()
+            || self.previous_sources.iter().any(|old| {
+                !old.ticket.is_current()
+                    || old
+                        .consumer
+                        .as_ref()
+                        .is_some_and(|stamp| !stamp.is_current())
+                    || !provenance
+                        .iter()
+                        .any(|new| Arc::ptr_eq(&old.source, &new.source))
+            });
+        if changed {
+            let Some(pt) = self
+                .port
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .payload_type
+            else {
+                return None;
+            };
+            let Ok(codecs) = Codecs::new(&self.port.binding.negotiated.format, pt, rate) else {
+                return None;
+            };
+            self.codecs.encoder = codecs.encoder;
+            self.codecs.from_mix = codecs.from_mix;
+        }
+        if tokio::time::Instant::now() >= bound {
+            self.observations
+                .note(AudioStage::OutputExpired, None, samples.len());
+            return None;
+        }
+        let timestamp = fallback_timestamp;
+        // Empty input ticks do not discard contiguous source PCM. Preserve
+        // its original RTP progression; genuine input gaps, trimmed PCM and
+        // missed executor quanta still advance by the actual skipped media.
+        let timestamp = source_timestamp(
+            &clocks,
+            rate,
+            self.codecs.info.clock_rate_hz,
+            timestamp,
+            &mut self.source_timeline,
+        );
+        let Ok(mut frame) = self.codecs.encode(samples, timestamp) else {
+            self.observations
+                .note(AudioStage::EncodeRefused, Some(timestamp), 0);
+            return None;
+        };
+        let route = self.clock_route.predicate();
+        let clock_ticket = target_ticket.clone();
+        let clock_consumer = target_consumer.clone();
+        let clock_subscription = subscription.clone();
+        frame.source_clock = mixed_clock(
+            clocks,
+            rate,
+            self.codecs.info.clock_rate_hz,
+            timestamp,
+            self.clock_source,
+            Arc::new(move || {
+                route()
+                    && clock_ticket.is_current()
+                    && clock_consumer
+                        .as_ref()
+                        .is_none_or(ConsumerStamp::is_current)
+                    && clock_subscription.is_current()
+            }),
+        );
+        frame.stream_id = self.port.binding.transport_id.clone();
+        if tokio::time::Instant::now() >= bound {
+            self.observations
+                .note(AudioStage::OutputExpired, Some(timestamp), size);
+            return None;
+        }
+        self.previous_subscription = Some(subscription.clone());
+        self.previous_sources = provenance.clone();
+        tracing::trace!(target: "rvoip_core::audio_path", target = %self.controller.connection,
+            age_us = oldest.elapsed().as_micros() as u64, "Guarded audio queued");
+        Some(QueuedMedia {
+            frame,
+            data: None,
+            local: None,
+            sources: provenance,
+            target,
+            target_ticket,
+            target_consumer,
+            target_scene,
+            subscription: Some(subscription),
+            direct: None,
+            admitted_at: oldest,
+        })
+    }
+}
