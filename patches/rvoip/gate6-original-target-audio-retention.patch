+//! Earlier original numeric bounds must survive a later, longer fresh grant.
+use super::*;
+
+const ANCHOR: u64 = 100u64 << 32;
+
+fn short_once(probe: &Probe) {
+    probe.grant_until.lock().unwrap().insert(
+        "a".into(),
+        chrono::Utc::now() + chrono::Duration::milliseconds(60),
+    );
+    // The real policy lease returned by this one read retains the shorter
+    // expiry. Every subsequent fresh read genuinely gets the longer grant.
+    probe
+        .clear_source_grant_after_read
+        .store(true, Ordering::Release);
+}
+
+fn publish_long_original(s: &Scene, owned_ingress: bool) {
+    let clock = source_clock(800, 8000, 8000, ANCHOR, Arc::new(AtomicBool::new(true)));
+    if !owned_ingress {
+        s.publish_clocked_ms(0, 1800, 8000, 40, Some(clock));
+        return;
+    }
+    let port = s.port(0);
+    let mut encoder =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap();
+    let payload = encoder
+        .encode(&rvoip_media_core::AudioFrame {
+            samples: vec![1800; 320],
+            sample_rate: 8000,
+            channels: 1,
+            duration: Duration::from_millis(40),
+            timestamp: 8000,
+        })
+        .unwrap();
+    let frame = MediaFrame {
+        stream_id: port.binding().transport_id.clone(),
+        kind: StreamKind::Audio,
+        payload: payload.into(),
+        timestamp_rtp: 8000,
+        source_clock: None,
+        captured_at: chrono::Utc::now(),
+        payload_type: Some(0),
+    };
+    let mut original = port
+        .retain_original_ingress(frame, Instant::now())
+        .unwrap()
+        .unwrap();
+    original
+        .try_publish_clocked(|current| {
+            let mut clock = clock;
+            clock.is_current = current;
+            Some(clock)
+        })
+        .unwrap();
+    assert!(matches!(
+        original.try_publish_clocked(|_| None),
+        Err(StreamControlError::Cancelled)
+    ));
+}
+
+async fn exercise(short_at_collect: bool, owned_ingress: bool) {
+    let (s, target, probe) = scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    let blocked = target.clone().write_owned().await;
+    let started = Instant::now();
+    if !short_at_collect {
+        short_once(&probe);
+    }
+    publish_long_original(&s, owned_ingress);
+    if short_at_collect {
+        short_once(&probe);
+    }
+    // Both actual original halves pass through collect, decoded Chunk and
+    // separate take calls. Carol proves decoding/mixing/source admission live.
+    for half in 0..2 {
+        s.mixer.tick();
+        decoded(
+            carol.try_recv().unwrap(),
+            &expected_pcm(1800),
+            ntp_ms(ANCHOR, half * 20),
+        )
+        .await;
+        assert!(bob.try_recv().is_err());
+        drop(
+            s.policy
+                .0
+                .try_write()
+                .expect("waiting PCM retained authority"),
+        );
+    }
+    assert!(!probe.clear_source_grant_after_read.load(Ordering::Acquire));
+    assert!(!probe.grant_until.lock().unwrap().contains_key("a"));
+    assert!(probe.refused_with_source_context.load(Ordering::Acquire) >= 2);
+    tokio::time::sleep(Duration::from_millis(80)).await;
+    assert!(
+        started.elapsed() < Duration::from_millis(180),
+        "fixture did not isolate shorter grant from 200ms media age"
+    );
+    drop(blocked);
+    s.mixer.tick();
+    assert!(
+        bob.try_recv().is_err(),
+        "a later grant renewed an earlier ingress/collect deadline"
+    );
+    // New original media remains usable under the fresh longer grant.
+    s.publish_clocked_ms(
+        0,
+        2600,
+        8320,
+        20,
+        Some(source_clock(
+            800,
+            8000,
+            8000,
+            ANCHOR,
+            Arc::new(AtomicBool::new(true)),
+        )),
+    );
+    s.mixer.tick();
+    for queued in [bob.try_recv().unwrap(), carol.try_recv().unwrap()] {
+        decoded(queued, &expected_pcm(2600), ntp_ms(ANCHOR, 40)).await;
+    }
+    s.mixer.tick();
+    assert!(bob.try_recv().is_err() && carol.try_recv().is_err());
+    drop(s.policy.0.try_write().unwrap());
+}
+
+#[tokio::test]
+async fn original_ingress_grant_bound_survives_longer_collect_take_and_target_grants() {
+    for owned_ingress in [false, true] {
+        exercise(false, owned_ingress).await;
+    }
+}
+
+#[tokio::test]
+async fn decoded_collect_grant_bound_survives_longer_take_and_target_grants() {
+    exercise(true, false).await;
+}
