+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if matches!(scope.purpose, MediaPurpose::Receive { .. }) {
+            return self.receive(scope, false);
+        }
+        if scope.connection.as_str() == "a" && matches!(scope.purpose, MediaPurpose::Publish) {
