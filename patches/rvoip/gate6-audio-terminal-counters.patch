+        TakeRefused,
+        TargetBeforeStart,
+        TargetExpired,
+        SubscriptionRefused,
+        SourceGone,
+        TargetRefused,
+        TargetDeferred,
+        EmptyOutput,
+        OutputExpired,
+        EncodeRefused,
+        OutputFull,
+    }
+    const NAMES: [&str; 24] = [
+        "refresh-refused",
+        "refresh-reset",
+        "collect-expired",
+        "collect-deferred",
+        "collect-refused",
+        "decode-refused",
+        "decode-expired",
+        "input-discontinuity",
+        "input-budget",
+        "burst-trim",
+        "missed-quanta",
+        "take-expired",
+        "take-deferred",
+        "take-refused",
+        "target-before-start",
+        "target-expired",
+        "subscription-refused",
+        "source-gone",
+        "target-refused",
+        "target-deferred",
+        "empty-output",
+        "output-expired",
+        "encode-refused",
+        "output-full",
+    ];
+    #[derive(Clone, Copy, Default)]
+    struct Counter {
+        events: u64,
+        samples: u64,
+        first: Option<(u64, Option<u32>)>,
+        last: Option<(u64, Option<u32>)>,
+    }
+    pub(super) struct Observations {
+        started: Instant,
+        counters: [Counter; 24],
+    }
+    impl Default for Observations {
+        fn default() -> Self {
+            Self {
+                started: Instant::now(),
+                counters: [Counter::default(); 24],
+            }
+        }
+    }
+    impl Observations {
+        pub(super) fn note(&mut self, stage: Stage, rtp: Option<u32>, samples: usize) {
+            let counter = &mut self.counters[stage as usize];
+            let at = (
+                self.started.elapsed().as_micros().min(u64::MAX as u128) as u64,
+                rtp,
+            );
+            counter.events = counter.events.saturating_add(1);
+            counter.samples = counter.samples.saturating_add(samples as u64);
+            counter.first.get_or_insert(at);
+            counter.last = Some(at);
+        }
+        pub(super) fn emit(&self, connection: &ConnectionId) {
+            for (index, counter) in self.counters.iter().enumerate() {
+                if counter.events != 0 {
+                    tracing::debug!(target: "rvoip_core::audio_summary", %connection,
+                        stage = NAMES[index], events = counter.events,
+                        samples = counter.samples, first = ?counter.first, last = ?counter.last,
+                        "Guarded audio member terminal counters");
+                }
+            }
+        }
+    }
+}
