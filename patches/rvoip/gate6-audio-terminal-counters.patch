+// packet path. Nonzero counters are emitted once when this member is dropped.
+mod observations {
+    use super::*;
+    #[derive(Clone, Copy)]
+    pub(super) enum Stage {
+        RefreshRefused,
+        RefreshReset,
+        CollectExpired,
+        CollectDeferred,
+        CollectRefused,
+        DecodeRefused,
+        DecodeExpired,
+        InputDiscontinuity,
+        InputBudget,
