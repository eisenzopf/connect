+#[tokio::test]
+async fn queued_grant_writer_cannot_deadlock_reply_key_or_scope_verification() {
+    use std::future::Future;
+    let (f, policy, resolver) = setup();
+    let h = Arc::new(ExchangeHandler::new());
+    let mut wire = open("quic", &f, h.clone()).await;
+    auth(&mut wire, &f, "old").await;
+    wire.send(f.sign(command())).await;
+    let callback = wire.read().await;
+    h.entered.notified().await;
+    let queued = Arc::new(Notify::new());
+    let signal = queued.clone();
+    let grants = policy.grants.clone();
+    let writer = tokio::spawn(async move {
+        let mut future = Box::pin(grants.write_owned());
+        let mut guard = futures::future::poll_fn(|cx| {
+            let r = future.as_mut().poll(cx);
+            if r.is_pending() {
+                signal.notify_one();
+            }
+            r
+        })
+        .await;
+        guard.deny = true;
+    });
+    queued.notified().await;
+    assert!(!writer.is_finished());
+    let reads = resolver.calls.load(Ordering::Acquire);
+    wire.send(f.sign(ack_for(&callback))).await;
+    assert_eq!(wire.read().await.kind(), "ack");
+    assert_eq!(resolver.calls.load(Ordering::Acquire), reads);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    wire.send(f.sign(command())).await;
+    assert_eq!(wire.read().await.kind(), "error");
+    assert_eq!(h.effects.load(Ordering::Acquire), 1);
+    wire.server.shutdown().await.unwrap();
