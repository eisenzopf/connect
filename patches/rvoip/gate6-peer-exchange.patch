+}
+fn signed(config: &PeerConfig, mut value: Value) -> Result<Envelope, DispatchError> {
+    value
+        .as_object_mut()
+        .ok_or(DispatchError::Closed)?
+        .remove("signature");
+    let env = Envelope::from_value(value)?;
+    Envelope::from_value(
+        config
+            .signer
+            .sign(env.original())
+            .map_err(|_| DispatchError::Signature)?,
+    )
+    .map_err(DispatchError::from)
+}
+fn problem(
+    config: &PeerConfig,
+    error: DispatchError,
+    request: Option<&Envelope>,
+) -> Result<PeerOutput, DispatchError> {
+    let mut v = json!({"v":2,"type":"error","id":fresh_id(),"ts":chrono::Utc::now(),"payload":{"code":error_code(error),"category":"auth","reason":error_reason(error)}});
