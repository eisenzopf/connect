+        .unwrap();
+    assert!(matches!(
+        f.config.verifier.verify_for_principal(&request, &p).await,
+        Err(Sig9421Error::ReplayDetected(_))
+    ));
+    let request: Value = serde_json::from_slice(&f.sign(command())).unwrap();
+    f.config
+        .verifier
+        .verify_for_principal(&request, &p)
+        .await
+        .unwrap();
+    assert!(matches!(
+        f.config
+            .verifier
+            .verify_with_current_key(&request, &p, &current)
+            .await,
+        Err(Sig9421Error::ReplayDetected(_))
+    ));
+    let mut wrong = p.clone();
+    wrong.subject = "bob".into();
+    let wrong_owner = PrincipalVerificationKey::from_current(
+        &wrong,
+        "client".into(),
+        key(f.client_public.clone()),
+    )
+    .unwrap();
+    let wrong_kid = PrincipalVerificationKey::from_current(
+        &p,
+        "other-key".into(),
+        key(f.client_public.clone()),
+    )
+    .unwrap();
+    let request: Value = serde_json::from_slice(&f.sign(command())).unwrap();
+    for proof in [wrong_owner, wrong_kid] {
+        assert!(matches!(
+            f.config
+                .verifier
+                .verify_with_current_key(&request, &p, &proof)
+                .await,
+            Err(Sig9421Error::KeyRejected)
+        ));
+    }
+}
