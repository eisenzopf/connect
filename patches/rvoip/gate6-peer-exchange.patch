+#[tokio::test]
+async fn expired_stepup_is_reported_before_a_reply_queued_behind_delivery_work() {
+    let (f, policy, _) = setup();
+    policy.require_user.store(true, Ordering::Release);
+    let (mut peer, registry, route) = routed_peer(&f);
+    f.authenticate(&mut peer, "old").await;
+    let original = command();
+    let challenge = {
+        let output = peer
+            .handle(
+                &f.sign(original.clone()),
+                &Handler::default(),
+                Instant::now() + Duration::from_millis(60),
+            )
+            .await
+            .unwrap();
+        output.envelopes()[0].clone()
+    };
+    assert_eq!(challenge.kind(), "identity.step-up-request");
+    let (input, rx) = mpsc::channel::<Vec<u8>>(4);
+    let reader = futures::stream::unfold(rx, |mut rx| async move {
+        rx.recv().await.map(|bytes| (Ok(Bytes::from(bytes)), rx))
+    });
+    let (output, mut observations) = mpsc::channel::<Bytes>(8);
+    let writer = futures::sink::unfold(output, |sender, bytes| async move {
+        sender
+            .send(bytes)
+            .await
+            .map_err(|_| DispatchError::Closed)?;
+        Ok::<_, DispatchError>(sender)
+    });
+    let run = tokio::spawn(async move {
+        peer.run_frames(Box::pin(reader), Box::pin(writer), &Handler::default())
+            .await
+    });
+    route.hold.store(true, Ordering::Release);
+    let handle = routes(&registry).remove(0);
+    let sending = tokio::spawn(async move { handle.submit(event(), deadline()).await });
+    route.entered.notified().await;
+    tokio::time::sleep(Duration::from_millis(80)).await;
+    let mut late = envelope(
+        "identity.step-up-response",
+        json!({"method":"bearer","credential":"user"}),
+    );
+    late["in_reply_to"] = json!(challenge.id());
+    for name in ["cid", "sid", "connid", "operation_id"] {
+        late[name] = original[name].clone();
+    }
+    let late_id = late["id"].as_str().unwrap().to_owned();
+    input.send(f.sign(late)).await.unwrap();
+    route.release.notify_one();
+    let mut seen = vec![];
+    for _ in 0..3 {
+        let bytes = tokio::time::timeout(Duration::from_secs(1), observations.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        seen.push(Envelope::parse(&bytes).unwrap());
+    }
+    assert_eq!(seen[0].kind(), "conversation.event");
+    assert_eq!(seen[1].scope(Scope::Reply), original["id"].as_str());
+    assert_eq!(
+        seen[1].original()["payload"]["reason"],
+        json!("step_up_expired")
+    );
+    assert_eq!(seen[2].scope(Scope::Reply), Some(late_id.as_str()));
+    sending.await.unwrap().unwrap();
+    drop(input);
+    run.await.unwrap().unwrap();
+}
+struct GateOutput {
+    values: Mutex<Vec<Envelope>>,
+    blocked: AtomicBool,
+    waker: futures::task::AtomicWaker,
+}
+struct GateSink(Arc<GateOutput>);
+impl Sink<Bytes> for GateSink {
+    type Error = DispatchError;
+    fn poll_ready(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), Self::Error>> {
+        std::task::Poll::Ready(Ok(()))
+    }
+    fn start_send(self: std::pin::Pin<&mut Self>, bytes: Bytes) -> Result<(), Self::Error> {
+        let envelope = Envelope::parse(&bytes)?;
+        if envelope.kind() == "ack" {
+            self.0.blocked.store(true, Ordering::Release);
+        }
+        self.0.values.lock().unwrap().push(envelope);
+        Ok(())
+    }
+    fn poll_flush(
+        self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), Self::Error>> {
+        self.0.waker.register(cx.waker());
+        if self.0.blocked.load(Ordering::Acquire) {
+            std::task::Poll::Pending
+        } else {
+            std::task::Poll::Ready(Ok(()))
+        }
+    }
+    fn poll_close(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), Self::Error>> {
+        std::task::Poll::Ready(Ok(()))
+    }
+}
+#[tokio::test]
+async fn writer_progress_breaks_the_queued_grant_writer_and_delivery_read_dependency() {
+    use std::future::Future;
+    let (f, _, _) = setup();
+    let (mut peer, registry, route) = routed_peer(&f);
+    f.authenticate(&mut peer, "old").await;
+    let h = Arc::new(ExchangeHandler::new());
+    let handler = h.clone();
+    let (input, rx) = mpsc::channel::<Vec<u8>>(4);
+    let reader = futures::stream::unfold(rx, |mut rx| async move {
+        rx.recv().await.map(|bytes| (Ok(Bytes::from(bytes)), rx))
+    });
+    let output = Arc::new(GateOutput {
+        values: Mutex::new(vec![]),
+        blocked: AtomicBool::new(false),
+        waker: futures::task::AtomicWaker::new(),
+    });
+    let sink = GateSink(output.clone());
+    let run = tokio::spawn(async move {
+        peer.run_frames(Box::pin(reader), sink, handler.as_ref())
+            .await
+    });
+    input.send(f.sign(command())).await.unwrap();
+    until(|| !output.values.lock().unwrap().is_empty()).await;
+    let callback = output.values.lock().unwrap()[0].clone();
+    input.send(f.sign(ack_for(&callback))).await.unwrap();
+    until(|| output.blocked.load(Ordering::Acquire)).await;
+    let queued = Arc::new(Notify::new());
+    let signal = queued.clone();
+    let grants = f.policy.revoked.clone();
+    let writer = tokio::spawn(async move {
+        let mut future = Box::pin(grants.write_owned());
+        let _guard = futures::future::poll_fn(|cx| {
+            let result = future.as_mut().poll(cx);
+            if result.is_pending() {
+                signal.notify_one();
+            }
+            result
+        })
+        .await;
+    });
+    queued.notified().await;
+    let handle = routes(&registry).remove(0);
+    let sending = tokio::spawn(async move { handle.submit(event(), deadline()).await });
+    route.entered.notified().await;
+    assert!(!writer.is_finished());
+    output.blocked.store(false, Ordering::Release);
+    output.waker.wake();
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(1), sending)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert_eq!(h.effects.load(Ordering::Acquire), 1);
+    let values = output.values.lock().unwrap();
+    assert_eq!(values.len(), 3);
+    assert_eq!(values[2].kind(), "conversation.event");
+    drop(values);
+    drop(input);
+    run.await.unwrap().unwrap();
+}
