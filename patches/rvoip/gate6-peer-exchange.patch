+//! Actual canonical peer actor exchanges, current read/key guard and bounded IO.
+use super::*;
+use rvoip_auth_core::sig9421::{PrincipalVerificationKey, Sig9421Error};
+use std::sync::Mutex;
+struct Grants {
+    deny: bool,
+    deny_request: bool,
+    deny_reply: bool,
+    key: ResolvedVerificationKey,
+}
+struct Held {
+    _base: AuthorityLease,
+    guard: tokio::sync::OwnedRwLockReadGuard<Grants>,
+}
+struct ExchangePolicy {
+    base: Arc<Policy>,
+    grants: Arc<RwLock<Grants>>,
+    requests: AtomicUsize,
+    replies: AtomicUsize,
+    require_user: AtomicBool,
+}
+impl ExchangePolicy {
+    async fn held(&self, base: AuthorityLease) -> Result<AuthorityLease, DispatchError> {
+        let guard = self.grants.clone().read_owned().await;
+        if guard.deny {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(Held { _base: base, guard }))
+    }
+}
+#[async_trait]
+impl PeerAuthority for ExchangePolicy {
+    fn assurance_requirement(
+        &self,
+        _: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        e: &Envelope,
+    ) -> Result<Option<AssuranceRequirement>, DispatchError> {
+        Ok(
+            (self.require_user.load(Ordering::Acquire) && e.kind() == "connection.update").then(
+                || AssuranceRequirement::UserAuthorized {
+                    user_id: rvoip_core::IdentityId::from_string("user-alice"),
+                    scopes: vec!["control".into()],
+                },
+            ),
+        )
+    }
+
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.held(self.base.guard(c, d, i, e).await?).await
+    }
+    async fn refresh(
+        &self,
+        old: &ValidatedBearer,
+        new: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.held(self.base.refresh(old, new, d, i, e).await?).await
+    }
+    fn exchange_request(
+        &self,
+        c: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        invocation: &Envelope,
+        request: &Envelope,
+        held: &AuthorityLease,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let current = held.authority::<Held>().ok_or(DispatchError::Authority)?;
+        if current.guard.deny
+            || current.guard.deny_request
+            || !c.principal.has_scope("control")
+            || invocation.scope(Scope::Conversation) != Some("conversation")
+            || request.kind() != "connection.update"
+        {
+            return Err(DispatchError::ScopeDenied);
+        }
+        self.requests.fetch_add(1, Ordering::AcqRel);
+        Ok(held.retained())
+    }
+    fn exchange_reply(
+        &self,
+        c: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        request: &Envelope,
+        _reply: &Envelope,
+        held: &AuthorityLease,
+    ) -> Result<ExchangeReplyAuthority, DispatchError> {
+        let current = held.authority::<Held>().ok_or(DispatchError::Authority)?;
+        if current.guard.deny
+            || current.guard.deny_reply
+            || request.scope(Scope::Conversation) != Some("conversation")
+            || request.scope(Scope::Session) != Some("session")
+            || request.scope(Scope::Connection) != Some("connection")
+        {
+            return Err(DispatchError::Authority);
+        }
+        self.replies.fetch_add(1, Ordering::AcqRel);
+        let key = PrincipalVerificationKey::from_current(
+            &c.principal,
+            "client".into(),
+            current.guard.key.clone(),
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        Ok(ExchangeReplyAuthority {
+            lease: held.retained(),
+            key,
+        })
+    }
+}
+struct CountingKeys {
+    key: Vec<u8>,
+    calls: AtomicUsize,
+}
+impl KeyResolver for CountingKeys {
+    fn resolve(&self, _: &str) -> Option<Vec<u8>> {
+        None
+    }
+    fn resolve_for_principal(
+        &self,
+        p: &AuthenticatedPrincipal,
+        k: &str,
+        a: &str,
+        _: chrono::DateTime<Utc>,
+    ) -> Option<ResolvedVerificationKey> {
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        (p.subject == "alice"
+            && p.issuer.as_deref() == Some("issuer")
+            && p.tenant.as_deref() == Some("tenant")
+            && k == "client"
+            && a == "EdDSA")
+            .then(|| key(self.key.clone()))
+    }
+}
+fn key(public_key: Vec<u8>) -> ResolvedVerificationKey {
+    ResolvedVerificationKey {
+        public_key,
+        algorithm: "EdDSA".into(),
+        not_before: None,
+        expires_at: None,
+        revoked: false,
+    }
+}
+struct DropWatch(Arc<AtomicUsize>);
+impl Drop for DropWatch {
+    fn drop(&mut self) {
+        self.0.fetch_add(1, Ordering::AcqRel);
+    }
+}
+struct ExchangeHandler {
+    entered: Notify,
+    effects: AtomicUsize,
+    drops: Arc<AtomicUsize>,
+    errors: Mutex<Vec<DispatchError>>,
+    peer: Mutex<Option<Arc<rvoip_core::peer_admission::PeerAdmission>>>,
+    timeout: Duration,
+    mismatch: bool,
+    parallel: bool,
+}
+impl ExchangeHandler {
+    fn new() -> Self {
+        Self {
+            entered: Notify::new(),
+            effects: AtomicUsize::new(0),
+            drops: Arc::new(AtomicUsize::new(0)),
+            errors: Mutex::new(vec![]),
+            peer: Mutex::new(None),
+            timeout: Duration::from_secs(2),
+            mismatch: false,
+            parallel: false,
+        }
+    }
+}
+fn ack_for(request: &Envelope) -> Value {
+    let mut v = envelope("ack", json!({"details":{"ready":true}}));
+    v["in_reply_to"] = json!(request.id());
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        if let Some(value) = request.original().get(field) {
+            v[field] = value.clone();
+        }
+    }
+    v
+}
+#[async_trait]
+impl AuthenticatedHandler for ExchangeHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let _drop = DropWatch(self.drops.clone());
+        *self.peer.lock().unwrap() = authorized.peer_admission().cloned();
+        self.entered.notify_one();
+        let original = authorized.envelope();
+        let mut request = command();
+        request["id"] = json!("backend-placeholder");
+        if self.mismatch {
+            request["connid"] = json!("another-connection");
+        }
+        let request = Envelope::from_value(request)?;
+        let reply = Envelope::from_value(ack_for(original))?;
+        let result = if self.parallel {
+            let (first, second, third) = tokio::join!(
+                authorized.exchange(request.clone(), Instant::now() + self.timeout),
+                authorized.exchange(request.clone(), Instant::now() + self.timeout),
+                authorized.exchange(request, Instant::now() + self.timeout)
+            );
+            let mut successes = 0;
+            for result in [first, second, third] {
+                match result {
+                    Ok(_) => successes += 1,
+                    Err(e) => self.errors.lock().unwrap().push(e),
+                }
+            }
+            if successes == 2 {
+                Ok(reply.clone())
+            } else {
+                Err(DispatchError::Authority)
+            }
+        } else {
+            authorized
+                .exchange(request, Instant::now() + self.timeout)
+                .await
+        };
+        match result {
+            Ok(observation) => {
+                if observation.kind() != "ack" {
+                    return Err(DispatchError::Authority);
+                }
+                self.effects.fetch_add(1, Ordering::AcqRel);
+                Ok(reply)
+            }
+            Err(e) => {
+                self.errors.lock().unwrap().push(e);
+                Err(e)
+            }
+        }
+    }
+}
