+impl ReplyContext {
+    fn active(&self, deadline: Instant) -> Result<(), DispatchError> {
+        if self.lifetime.is_cancelled() || deadline <= Instant::now() {
+            return Err(DispatchError::Closed);
+        }
+        checked_principal(self.principal.clone()).map(|_| ())
+    }
+}
+struct CancelWait {
+    cancel: CancellationToken,
+    changed: Arc<Notify>,
+}
+impl Drop for CancelWait {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+        self.changed.notify_one();
+    }
+}
+struct Call {
+    request: Envelope,
+    context: Arc<ReplyContext>,
+    held: AuthorityLease,
+    deadline: Instant,
+    cancel: CancellationToken,
+    started: Arc<AtomicBool>,
+    reply: oneshot::Sender<Result<Envelope, DispatchError>>,
+}
+struct PendingCall {
+    request: Envelope,
+    expectation: ReplyExpectation,
+    context: Arc<ReplyContext>,
+    held: AuthorityLease,
+    deadline: Instant,
+    cancel: CancellationToken,
+    started: Arc<AtomicBool>,
+    reply: parking_lot::Mutex<Option<oneshot::Sender<Result<Envelope, DispatchError>>>>,
+    verifying: AtomicBool,
+}
+impl PendingCall {
+    fn live(&self) -> bool {
+        !self.cancel.is_cancelled()
+            && self.context.active(self.deadline).is_ok()
+            && self
+                .reply
+                .lock()
+                .as_ref()
+                .is_some_and(|reply| !reply.is_closed())
+    }
+    async fn accept(&self, envelope: &Envelope) -> Result<(), DispatchError> {
+        if !self.live() {
+            return Err(DispatchError::Closed);
+        }
+        self.context.replay.preflight(envelope.id())?;
+        let authority = self.context.authority.exchange_reply(
+            &self.context.principal,
+            &self.request,
+            envelope,
+            &self.held,
+        )?;
