+struct BlockedSink {
+    polled: Arc<AtomicBool>,
+    dropped: Arc<AtomicBool>,
+}
+impl Drop for BlockedSink {
+    fn drop(&mut self) {
+        self.dropped.store(true, Ordering::Release);
+    }
+}
+impl Sink<Bytes> for BlockedSink {
+    type Error = DispatchError;
+    fn poll_ready(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), Self::Error>> {
+        self.polled.store(true, Ordering::Release);
+        std::task::Poll::Pending
+    }
+    fn start_send(self: std::pin::Pin<&mut Self>, _: Bytes) -> Result<(), Self::Error> {
+        panic!("blocked writer must not claim submission")
+    }
+    fn poll_flush(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), Self::Error>> {
+        std::task::Poll::Pending
+    }
+    fn poll_close(
+        self: std::pin::Pin<&mut Self>,
+        _: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Result<(), Self::Error>> {
+        std::task::Poll::Ready(Ok(()))
+    }
+}
+#[tokio::test]
+async fn reader_eof_interrupts_blocked_writer_and_pending_handler_without_detached_work() {
+    let (f, policy, _) = setup();
+    let mut p = f.peer();
+    f.authenticate(&mut p, "old").await;
+    let h = Arc::new(ExchangeHandler::new());
+    let handler = h.clone();
+    let (tx, rx) = mpsc::channel::<Vec<u8>>(2);
+    let reader = futures::stream::unfold(rx, |mut rx| async move {
+        rx.recv().await.map(|bytes| (Ok(Bytes::from(bytes)), rx))
+    });
+    let polled = Arc::new(AtomicBool::new(false));
+    let dropped = Arc::new(AtomicBool::new(false));
+    let sink = BlockedSink {
+        polled: polled.clone(),
+        dropped: dropped.clone(),
+    };
+    let run =
+        tokio::spawn(async move { p.run_frames(Box::pin(reader), sink, handler.as_ref()).await });
+    tx.send(f.sign(command())).await.unwrap();
+    until(|| polled.load(Ordering::Acquire)).await;
+    drop(tx);
+    tokio::time::timeout(Duration::from_secs(1), run)
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap();
+    assert!(dropped.load(Ordering::Acquire));
+    assert_eq!(h.drops.load(Ordering::Acquire), 1);
+    assert_eq!(h.effects.load(Ordering::Acquire), 0);
+    assert!(policy.grants.try_write().is_ok());
+    assert!(h.peer.lock().unwrap().as_ref().unwrap().is_closed());
