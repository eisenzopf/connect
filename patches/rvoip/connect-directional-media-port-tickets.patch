+// Every new directional control closes original resources before returning its
+// oracle, including unwinding assertions; no detached collector or retry owner.
+async fn directional_checked<T>(f:&Fixture, work:impl std::future::Future<Output=T>) -> T {
+    let mut work=Box::pin(work);
+    let result=std::future::poll_fn(|cx|match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||work.as_mut().poll(cx))) {
+        Ok(std::task::Poll::Pending)=>std::task::Poll::Pending,
+        Ok(std::task::Poll::Ready(value))=>std::task::Poll::Ready(Ok(value)),
+        Err(error)=>std::task::Poll::Ready(Err(error)),
+    }).await;
+    drop(work);
+    let remaining_a=f.a.shutdown(deadline()).await;
+    let remaining_b=f.b.shutdown(deadline()).await;
+    assert_eq!(remaining_a,0);
+    assert_eq!(remaining_b,0);
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire),0);
+    assert_eq!(f.ba.outstanding.load(Ordering::Acquire),0);
+    match result {Ok(value)=>value,Err(error)=>std::panic::resume_unwind(error)}
+}
