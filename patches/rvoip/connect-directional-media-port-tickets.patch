+        first.await.unwrap();assert!(second.await.is_err());
+        assert_eq!(f.a.revision(),revision+1);
+        assert!(before.ticket(TicketSide::Ingress).same_generation(&port.0.ticket(TicketSide::Ingress)));
+        assert!(!before.ticket(TicketSide::Egress).is_current());
+        assert!(port.0.ticket_snapshot().is_current());
