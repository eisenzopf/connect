diff --git a/crates/foundation/rvoip-core/src/staged_streams/directional_ticket.rs b/crates/foundation/rvoip-core/src/staged_streams/directional_ticket.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/directional_ticket.rs
@@ -0,0 +1,54 @@
+//! Independent port directions; readers only snapshot immutable metadata.
+use super::*;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum TicketSide { Ingress, Egress }
+#[derive(Clone)]
+pub(super) struct PortTickets { ingress: PeerRouteTicket, egress: PeerRouteTicket }
+impl PortTickets {
+    pub(super) fn initial() -> Self { Self { ingress:PeerRouteTicket::initial(), egress:PeerRouteTicket::initial() } }
+    pub(super) fn ticket(&self, side:TicketSide) -> PeerRouteTicket {
+        match side { TicketSide::Ingress=>self.ingress.clone(),TicketSide::Egress=>self.egress.clone() }
+    }
+    pub(super) fn all(&self) -> [PeerRouteTicket;2] { [self.ingress.clone(),self.egress.clone()] }
+    pub(super) fn is_current(&self) -> bool { self.ingress.is_current()&&self.egress.is_current() }
+    pub(super) fn committed_at(&self) -> Option<Instant> { Some(self.ingress.committed_at()?.max(self.egress.committed_at()?)) }
+    pub(super) fn stage(&self, changed:[bool;2]) -> ControlResult<Self> {
+        Ok(Self {
+            ingress:if changed[0] {self.ingress.stage().ok_or(MediaTransitionError::Capacity)?}else{self.ingress.clone()},
+            egress:if changed[1] {self.egress.stage().ok_or(MediaTransitionError::Capacity)?}else{self.egress.clone()},
+        })
+    }
+}
+pub(super) struct PortTicketChange {
+    pub(super) port:Arc<Port>,
+    before:Arc<PortTickets>,
+    after:Arc<PortTickets>,
+    changed:[bool;2],
+}
+impl PortTicketChange {
+    pub(super) fn stage(port:Arc<Port>, changed:[bool;2]) -> ControlResult<Self> {
+        let before=port.ticket_snapshot();let after=Arc::new(before.stage(changed)?);
+        Ok(Self {port,before,after,changed})
+    }
+    pub(super) fn old_tickets(&self) -> Vec<PeerRouteTicket> {
+        [TicketSide::Ingress,TicketSide::Egress].into_iter().zip(self.changed)
+            .filter_map(|(side,changed)|changed.then(||self.before.ticket(side))).collect()
+    }
+    pub(super) fn is_current(&self) -> bool {
+        Arc::ptr_eq(&self.before,&self.port.ticket_snapshot())&&self.before.is_current()
+    }
+    /// Caller holds this exact PortState through final validation/model effect,
+    /// directional commits and store. retire() uses the SAME mutex.
+    pub(super) fn validate(&self,state:&PortState) -> ControlResult<()> {
+        if !matches!(state.status,PortStatus::Active|PortStatus::Paused)||!self.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(())
+    }
+    pub(super) fn commit(&self,_state:&mut PortState) {
+        for (side,changed) in [TicketSide::Ingress,TicketSide::Egress].into_iter().zip(self.changed) {
+            if changed {assert!(self.after.ticket(side).commit_from(&self.before.ticket(side)),"quiesced directional generation changed");}
+        }
+        self.port.tickets.store(self.after.clone());
+    }
+}
