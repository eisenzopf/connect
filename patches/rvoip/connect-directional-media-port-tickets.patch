+#[tokio::test]
+async fn directional_pause_mute_end_replace_and_close_keep_permanent_scope() {
+    for action in 0..6 {
+        let f=Fixture::new(8);
+        directional_checked(&f,async {
+            f.start(&[Medium::Video]).await;
+            let id=desired(Medium::Video).logical_id;let ids=[id.clone()].into_iter().collect();
+            let port=f.aa.port(Medium::Video);let before=port.0.ticket_snapshot();
+            let mut original=port.retain_original_ingress(frame(&port,18000),Instant::now()).unwrap().unwrap();
+            match action {
+                0=>{f.a.set_paused(&id,f.a.revision(),true,deadline()).await.unwrap();f.a.set_paused(&id,f.a.revision(),false,deadline()).await.unwrap();},
+                1=>{f.a.set_media_gate(f.a.revision(),&ids,StreamGateAction::Mute,deadline()).await.unwrap();f.a.set_media_gate(f.a.revision(),&ids,StreamGateAction::Unmute,deadline()).await.unwrap();},
+                2=>{f.a.end_stream(&id,f.a.revision(),deadline()).await.unwrap();},
+                3=>{let mut receive=desired(Medium::Video);receive.direction=StreamDirection::Receive;f.a.change(f.a.revision(),&[receive],&BTreeSet::new(),deadline(),CancellationToken::new()).await.unwrap();},
+                4=>{assert_eq!(f.a.shutdown(deadline()).await,0);},
+                _=>{
+                    f.a.set_media_gate(f.a.revision(),&ids,StreamGateAction::Mute,deadline()).await.unwrap();
+                    let muted=port.0.ticket_snapshot();
+                    f.a.set_media_gate(f.a.revision(),&ids,StreamGateAction::Pause,deadline()).await.unwrap();
+                    assert!(!muted.ticket(TicketSide::Ingress).is_current()&&!muted.ticket(TicketSide::Egress).is_current());
+                    let paused=port.0.ticket_snapshot();
+                    f.a.set_media_gate(f.a.revision(),&ids,StreamGateAction::Resume,deadline()).await.unwrap();
+                    assert!(!paused.ticket(TicketSide::Ingress).is_current()&&!paused.ticket(TicketSide::Egress).is_current());
+                    f.a.set_media_gate(f.a.revision(),&ids,StreamGateAction::Unmute,deadline()).await.unwrap();
+                },
+            }
+            assert!(!before.ticket(TicketSide::Ingress).is_current());
+            if action!=1 {assert!(!before.ticket(TicketSide::Egress).is_current());}
+            else {assert!(before.ticket(TicketSide::Egress).is_current());}
+            assert!(original.try_publish_clocked(|_|None).is_err());
+            if action<=1 || action==5 {port.try_publish(&frame(&port,21000)).unwrap();}
+            if action==3 {assert_ne!(f.aa.port(Medium::Video).binding().transport_id,port.binding().transport_id);}
+        }).await;
+    }
+}
