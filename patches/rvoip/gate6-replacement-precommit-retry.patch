+//! Retry only the scene's definitely unpublished metadata collision.
+use super::*;
+use std::sync::Mutex;
+
+pub(crate) async fn run<T, F, Fut>(
+    cutoff: &Mutex<tokio::time::Instant>,
+    cancellation: &CancellationToken,
+    mut attempt: F,
+) -> ControlResult<T>
+where
+    F: FnMut() -> Fut,
+    Fut: std::future::Future<Output = ControlResult<T>>,
+{
+    loop {
+        if cancellation.is_cancelled() {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= *cutoff.lock().unwrap_or_else(|p| p.into_inner()) {
+            return Err(ParticipantControlError::Deadline);
+        }
+        match attempt().await {
+            // The scene completes all fallible audio/direct metadata checks
+            // before its first commit. Other errors, including uncertain
+            // outcomes, must never be replayed through this helper.
+            Err(ParticipantControlError::Media(StreamControlError::Backpressure)) => {}
+            result => return result,
+        }
+        let deadline = *cutoff.lock().unwrap_or_else(|p| p.into_inner());
+        tokio::select! { biased;
+            _ = cancellation.cancelled() => return Err(ParticipantControlError::Cancelled),
+            _ = tokio::time::sleep_until(deadline) => return Err(ParticipantControlError::Deadline),
+            _ = tokio::time::sleep(Duration::from_millis(2)) => {}
+        }
+    }
+}
