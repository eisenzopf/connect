+#[tokio::test]
+async fn replacement_metadata_collision_retries_original_plan_and_preserves_refusals() {
+    use crate::orchestrator::participant_control::{
+        replacement::metadata_retry, ParticipantControlError,
+    };
+    for mode in ["recover", "cancel", "expire", "revoke", "role-change"] {
+        let mut f = Move::new(false).await;
+        f.io().await;
+        f.confirm().await;
+        let plan = f.plan().unwrap();
+        let expected = plan.audience().request().expected_revision;
+        let candidate = f.room.nodes["device"].controller.clone();
+        let (entered, ready) = std::sync::mpsc::channel();
+        let (release, releasing) = std::sync::mpsc::channel();
+        let (finished, released) = std::sync::mpsc::channel();
+        let holder = std::thread::spawn(move || {
+            let _state = candidate.state.lock().unwrap();
+            entered.send(()).unwrap();
+            // Bound even a broken test path; never strand the executor.
+            let _ = releasing.recv_timeout(Duration::from_secs(2));
+            drop(_state);
+            let _ = finished.send(());
+        });
+        ready.recv_timeout(Duration::from_secs(2)).unwrap();
+        let release = Mutex::new(Some(release));
+        let calls = AtomicUsize::new(0);
+        let collisions = AtomicUsize::new(0);
+        let cutoff = Mutex::new(deadline());
+        let cancel = CancellationToken::new();
+        let result = metadata_retry::run(&cutoff, &cancel, || async {
+            calls.fetch_add(1, Ordering::SeqCst);
+            let grant = f
+                .room
+                .grant(Approval::Audience(plan.audience().clone()))
+                .await;
+            let until = *cutoff.lock().unwrap();
+            let result = f
+                .room
+                .scene
+                .commit_audio_device_replacement(plan.clone(), until, cancel.clone(), &grant)
+                .await;
+            drop(grant);
+            if matches!(result, Err(StreamControlError::Backpressure)) {
+                collisions.fetch_add(1, Ordering::SeqCst);
+                assert!(!f.room.nodes["alice"].controller.shutdown.is_cancelled());
+                release.lock().unwrap().take().unwrap().send(()).unwrap();
+                released.recv_timeout(Duration::from_secs(2)).unwrap();
+                match mode {
+                    "cancel" => cancel.cancel(),
+                    "expire" => *cutoff.lock().unwrap() = tokio::time::Instant::now(),
+                    "revoke" => {
+                        f.room
+                            .domain
+                            .base
+                            .0
+                            .write()
+                            .await
+                            .revoked
+                            .insert("alice".into());
+                    }
+                    "role-change" => {
+                        let ids = [ConnectionId::from_string("alice")];
+                        let target = f.room.scene.role_targets(&ids).remove(0);
+                        target
+                            .prepare_role(until, CancellationToken::new())
+                            .await
+                            .unwrap()
+                            .commit(false);
+                    }
+                    _ => {}
+                }
+            }
+            result.map_err(ParticipantControlError::from)
+        })
+        .await;
+        // This joins the actual metadata owner before examining outcomes.
+        if let Some(release) = release.lock().unwrap().take() {
+            let _ = release.send(());
+        }
+        holder.join().unwrap();
+        assert_eq!(
+            collisions.load(Ordering::SeqCst),
+            1,
+            "{mode}: actual publisher mutex collision required"
+        );
+        if mode == "recover" {
+            let (outcome, _) = result.unwrap();
+            assert_eq!(calls.load(Ordering::SeqCst), 2);
+            assert_eq!(outcome.media.audience_revision, expected + 1);
+            assert_eq!(outcome.admitted, ConnectionId::from_string("device"));
+            assert!(f.room.nodes["alice"].controller.shutdown.is_cancelled());
+            f.room.publish("device", 5200).unwrap();
+            f.room.tick();
+            f.room.heard("bob", 5200).await;
+        } else {
+            match mode {
+                "cancel" => assert!(matches!(result, Err(ParticipantControlError::Cancelled))),
+                "expire" => assert!(matches!(result, Err(ParticipantControlError::Deadline))),
+                _ => assert!(
+                    result.is_err(),
+                    "{mode}: stale authority or role cannot publish"
+                ),
+            }
+            assert_eq!(
+                calls.load(Ordering::SeqCst),
+                if mode == "cancel" || mode == "expire" {
+                    1
+                } else {
+                    2
+                }
+            );
+            assert!(!f.room.nodes["alice"].controller.shutdown.is_cancelled());
+            assert_eq!(f.room.scene.audience_revision(), expected);
+        }
+    }
+}
