+#[tokio::test]
+async fn concurrent_fresh_child_cannot_hide_older_live_packet_custody_behind_a_queued_writer() {
+    let armed = Arc::new(AtomicBool::new(false));
+    let (release_tx, release_rx) = std::sync::mpsc::channel();
+    let (released_tx, released_rx) = std::sync::mpsc::channel();
+    let released = std::sync::Mutex::new(released_rx);
+    let hook: Arc<dyn Fn() + Send + Sync> = Arc::new({
+        let armed = armed.clone();
+        move || {
+            if armed.swap(false, Ordering::AcqRel) {
+                release_tx.send(()).unwrap();
+                released
+                    .lock()
+                    .unwrap()
+                    .recv_timeout(Duration::from_secs(1))
+                    .unwrap();
+            }
+        }
+    });
+    let (s, fence, _) = weak_scene_with_hook(Some(hook)).await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    let mut dave = s.port(3).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let first = bob.try_recv().unwrap();
+    let same = carol.try_recv().unwrap();
+    let remaining = dave.try_recv().unwrap();
+    let custody = remaining.sources[0].custody.clone();
+    let mut sending = Box::pin(first.deliver(|_| std::future::pending::<ControlResult<()>>()));
+    assert!(sending
+        .as_mut()
+        .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+        .is_pending());
+    // Force just the source lookup to miss its busy metadata slot. Fresh source
+    // admission releases this lock before publishing the child's weak context.
+    let slot = custody.0.clone();
+    let (ready_tx, ready_rx) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        let locked = slot.lock().unwrap();
+        ready_tx.send(()).unwrap();
+        release_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+        drop(locked);
+        released_tx.send(()).unwrap();
+    });
+    ready_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    armed.store(true, Ordering::Release);
+    let child = same.admit_queued_media().unwrap();
+    worker.join().unwrap();
+    assert!(
+        !armed.load(Ordering::Acquire),
+        "fresh-admission race was not exercised"
+    );
+    drop(child);
+    assert!(
+        custody.active().is_some(),
+        "short-lived child hid an older still-owned source interval"
+    );
+    let mut writer = Box::pin(fence.clone().write_owned());
+    assert!(writer
+        .as_mut()
+        .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+        .is_pending());
+    heard(remaining, 1800).await;
+    drop(sending);
+    assert!(
+        custody.active().is_none(),
+        "queued weak metadata retained custody after final IO"
+    );
+    drop(writer.await);
+    assert!(fence.clone().try_write_owned().is_ok());
+}
