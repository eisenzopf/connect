+//! Actual managed scopes exercise identity, not fabricated native submission.
+use super::*;
+
+#[tokio::test]
+async fn submission_identity_is_exact_same_scope_weak_metadata_and_never_current_authority() {
+    let mut room=ManagedRoom::with_video(true).await;
+    let mut foreign=ManagedRoom::with_video(true).await;
+    let result=catch_original(async {
+        let(alice,old,source)=actors(&mut room).await;
+        let ready=prepared(&mut room,&alice,&old,&source).await;
+        freeze(&room,&ready.plan,&ready.grant,&ready.reservation).await;
+        room.world.warm_allowed.store(true,Ordering::Release);
+        let original_warm=warm(&room,&ready.plan,&ready.grant).await.unwrap();
+        let scope=original_warm.scope_with_original_owner_for_test().unwrap();
+        let clone=scope.clone();let weak=Arc::downgrade(&scope);
+        let marker=scope.submission_identity_for_test();
+        let(other_alice,other_old,other_source)=actors(&mut foreign).await;
+        let other_ready=prepared(&mut foreign,&other_alice,&other_old,&other_source).await;
+        freeze(&foreign,&other_ready.plan,&other_ready.grant,&other_ready.reservation).await;
+        foreign.world.warm_allowed.store(true,Ordering::Release);
+        let other_warm=warm(&foreign,&other_ready.plan,&other_ready.grant).await.unwrap();
+        let other_scope=other_warm.scope_with_original_owner_for_test().unwrap();
+        assert!(marker(&scope)&&marker(&clone));assert!(!marker(&other_scope));
+        assert!(scope.is_current());assert!(scope.successful_keyframe_submission().is_none());
+        assert!(ready.root.cancel());
+        assert!(!scope.is_current());assert!(marker(&scope),"historical identity is separate from revoked current authority");
+        assert!(scope.successful_keyframe_submission().is_none(),"identity metadata cannot fabricate native successful submission");
+        original_warm.close();drop(original_warm);drop(clone);drop(scope);
+        assert!(weak.upgrade().is_none(),"retained identity marker cannot keep original Scope alive");
+        assert!(!marker(&other_scope),"dead original allocation cannot be adopted as another actual managed Scope");
+        other_warm.close();
+    }).await;
+    let clean=room.close_originals().await.into_iter().all(|done|done);
+    let other_clean=foreign.close_originals().await.into_iter().all(|done|done);
+    assert!(clean&&other_clean);if let Err(error)=result {resume_unwind(error)}
+}
