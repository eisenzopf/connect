+    );
+}
+
+#[derive(::interceptor::Interceptor)]
+struct ObserveBindings<P> {
+    #[next]
+    inner: P,
+    seen: std::sync::Arc<std::sync::Mutex<Vec<::interceptor::StreamInfo>>>,
+}
+#[::interceptor::interceptor]
+impl<P: ::interceptor::Interceptor> ObserveBindings<P> {
+    #[overrides]
+    fn bind_remote_stream(&mut self, info: &::interceptor::StreamInfo) {
+        self.seen.lock().unwrap().push(info.clone());
+        self.inner.bind_remote_stream(info);
+    }
+}
+#[test]
+fn payload_audio_feedback_initialized_metadata_is_not_rebound() {
+    let seen = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+    let clone = seen.clone();
+    let mut m = media();
+    let r = register_default_interceptors(Registry::new(), &mut m)
+        .unwrap()
+        .with(move |inner| ObserveBindings { inner, seen: clone });
+    let mut f = Fixture::new(m, r);
+    assert!(seen.lock().unwrap().is_empty());
+    f.ingest(111, 10);
+    f.ingest(0, 11);
+    f.ingest(126, 12);
+    let rows = seen.lock().unwrap();
+    assert_eq!(
+        rows.len(),
+        1,
+        "initialized track metadata must not rebind from other payloads"
+    );
+    assert_eq!((rows[0].payload_type, rows[0].clock_rate), (111, 48000));
+}
