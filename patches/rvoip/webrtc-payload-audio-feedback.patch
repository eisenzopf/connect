+                    vec![RTCRtpEncodingParameters {
+                        rtp_coding_parameters: coding,
+                        ..Default::default()
+                    }],
+                ));
+                f.pc.rtp_transceivers.push(other);
+            }
+            "cross-kind-owner" => f.pc.rtp_transceivers.push(declared_receiver(
+                vec![codec(96, "video/VP8", 90000)],
+                RtpCodecKind::Video,
+            )),
+            "stopped-owner-first" | "inactive-owner-first" => {
+                let mut stale = receiver(codecs());
+                if case == "stopped-owner-first" {
+                    stale
+                        .stop(&f.pc.media_engine, &mut f.pc.interceptor)
+                        .unwrap();
+                } else {
+                    stale.set_current_direction(RTCRtpTransceiverDirection::Inactive);
+                }
+                f.pc.rtp_transceivers.insert(0, stale);
+            }
+            "video-primary" | "video-repair-pt" => {
+                f.pc.rtp_transceivers[0] = declared_receiver(
+                    vec![codec(96, "video/VP8", 90000), codec(97, "video/rtx", 90000)],
+                    RtpCodecKind::Video,
+                );
+                pt = if case == "video-primary" { 96 } else { 97 };
+            }
+            _ => unreachable!(),
+        }
+        let wire = f.packet(pt, 10, ssrc);
+        let _ = f.preflight(wire).unwrap();
+        f.unopened();
+        assert!(f.feedback().is_empty(), "{case} must not bind metadata");
+    }
+}
+#[test]
+fn payload_audio_feedback_replacement_uses_current_codec_set() {
+    let mut f = default_fixture();
+    f.ingest(111, 10);
+    let _ = f.feedback();
+    f.pc.rtp_transceivers[0]
+        .stop(&f.pc.media_engine, &mut f.pc.interceptor)
+        .unwrap();
+    f.pc.rtp_transceivers[0] = receiver(
+        codecs()
+            .into_iter()
+            .filter(|codec| codec.payload_type == 0 || codec.payload_type == 8)
+            .collect(),
+    );
+    f.pc.pipeline_context
+        .endpoint_handler_context
+        .event_outs
+        .clear();
+    f.now += Duration::from_millis(200);
+    let wire = f.packet(111, 11, 1001);
+    let _ = f.preflight(wire).unwrap();
+    f.unopened();
+    assert!(f.feedback().is_empty());
+    let wire = f.packet(0, 12, 1001);
+    let out = f.preflight(wire).unwrap();
+    f.unopened();
+    f.finish(out);
+    assert_eq!(f.selected(), ("audio/PCMU".into(), 8000));
+    assert_eq!(f.feedback(), vec![12]);
+}
