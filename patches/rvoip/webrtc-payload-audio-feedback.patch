+    /// Prepare hop feedback for the first authenticated declared audio packet.
+    /// Codec selection uses its negotiated payload type, never a preferred-codec
+    /// guess. Application codec assignment and OnOpen remain endpoint-owned.
+    fn prebind_declared_audio_feedback(&mut self, header: &rtp::Header) {
+        // A primary binding must not overwrite another stream's repair alias.
+        if self.rtp_transceivers.iter().any(|t| {
+            t.receiver().as_ref().is_some_and(|receiver| {
+                receiver.get_coding_parameters().iter().any(|coding| {
+                    coding
+                        .rtx
+                        .as_ref()
+                        .is_some_and(|repair| repair.ssrc == header.ssrc)
+                        || coding
+                            .fec
+                            .as_ref()
+                            .is_some_and(|repair| repair.ssrc == header.ssrc)
+                })
+            })
+        }) {
+            return;
+        }
+        // Endpoint's declared-primary lookup considers all receiver codings.
+        // Reject ambiguity even if a competing owner is stopped/nonreceiving,
+        // rather than bind feedback to a different receiver than endpoint.
+        let mut owners = self.rtp_transceivers.iter().enumerate().filter(|(_, t)| {
+            t.receiver().as_ref().is_some_and(|receiver| {
+                receiver
+                    .get_coding_parameters()
+                    .iter()
+                    .any(|coding| coding.ssrc == Some(header.ssrc))
+            })
+        });
+        let Some((index, _)) = owners.next() else {
+            return;
+        };
+        if owners.next().is_some() {
+            return;
+        }
+        let owner = &self.rtp_transceivers[index];
+        if owner.stopped()
+            || owner.kind() != RtpCodecKind::Audio
+            || !owner.direction().has_recv()
+            || !owner.current_direction().has_recv()
+        {
+            return;
+        }
+        let Some(receiver) = self.rtp_transceivers[index].receiver_mut() else {
+            return;
+        };
+        if !receiver
+            .track()
+            .get_codec_by_ssrc(header.ssrc)
+            .is_some_and(|codec| codec.mime_type.is_empty())
+        {
+            return;
+        }
+        // Endpoint disambiguates the wire payload from actual receive
+        // preferences. A media-engine/local codec identity alone is not enough.
+        let mut negotiated = receiver.get_codec_preferences().iter().filter(|codec| {
+            codec.payload_type == header.payload_type
+                && codec
+                    .rtp_codec
+                    .mime_type
+                    .to_ascii_lowercase()
+                    .starts_with("audio/")
+                && codec.rtp_codec.clock_rate != 0
+        });
+        let Some(codec) = negotiated.next().cloned() else {
+            return;
+        };
+        if negotiated.next().is_some() {
+            return;
+        }
+        // Merge hop feedback only when the current metadata agrees with that
+        // exact negotiated identity; inconsistent/stale mappings defer to the
+        // unchanged endpoint rather than guessing a local payload or clock.
+        let parameters = receiver.get_parameters(self.media_engine).clone();
+        let mut merged = parameters.rtp_parameters.codecs.iter().filter(|candidate| {
+            candidate.payload_type == codec.payload_type
+                && candidate
+                    .rtp_codec
+                    .mime_type
+                    .eq_ignore_ascii_case(&codec.rtp_codec.mime_type)
+                && candidate.rtp_codec.clock_rate == codec.rtp_codec.clock_rate
+                && candidate.rtp_codec.channels == codec.rtp_codec.channels
+                && candidate.rtp_codec.sdp_fmtp_line == codec.rtp_codec.sdp_fmtp_line
+        });
+        let Some(merged_codec) = merged.next() else {
+            return;
+        };
