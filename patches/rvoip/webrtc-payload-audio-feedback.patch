+//! Authenticated declared audio metadata preflight; no ICE/DTLS handshake claim.
+use super::first_audio_feedback_tests::{codec, context};
+use super::*;
+use crate::media_stream::MediaStreamTrack;
+use crate::peer_connection::RTCPeerConnectionBuilder;
+use crate::peer_connection::configuration::interceptor_registry::{
+    register_default_interceptors, register_default_interceptors_with_sender_clock,
+};
+use crate::peer_connection::configuration::media_engine::MediaEngine;
+use crate::rtp_transceiver::internal::RTCRtpTransceiverInternal;
+use crate::rtp_transceiver::rtp_sender::{
+    RTCRtpCodecParameters, RTCRtpCodingParameters, RTCRtpEncodingParameters, RtpCodecKind,
+};
+use crate::rtp_transceiver::{RTCRtpTransceiverDirection, RTCRtpTransceiverInit};
+use ::interceptor::{Registry, SenderClockHandle, StreamInfo, TaggedPacket};
+use ::srtp::context::Context;
+use sansio::Protocol;
+use shared::TransportContext;
+use shared::marshal::Marshal;
+
+fn codecs() -> Vec<RTCRtpCodecParameters> {
+    let mut values = vec![
+        codec(111, "audio/opus", 48000),
+        codec(0, "audio/PCMU", 8000),
+        codec(8, "audio/PCMA", 8000),
+        codec(110, "audio/telephone-event", 48000),
+        codec(126, "audio/telephone-event", 8000),
+    ];
+    for c in &mut values {
+        c.rtp_codec.channels = if c.payload_type == 111 { 2 } else { 1 };
+    }
+    values
+}
+fn media() -> MediaEngine {
+    let mut m = MediaEngine::default();
+    for c in codecs() {
+        m.register_codec(c, RtpCodecKind::Audio).unwrap();
+    }
+    m
+}
+fn receiver<P: ::interceptor::Interceptor>(
+    preferences: Vec<RTCRtpCodecParameters>,
+) -> RTCRtpTransceiverInternal<P> {
+    declared_receiver(preferences, RtpCodecKind::Audio)
+}
+fn declared_receiver<P: ::interceptor::Interceptor>(
+    preferences: Vec<RTCRtpCodecParameters>,
+    kind: RtpCodecKind,
+) -> RTCRtpTransceiverInternal<P> {
+    let mut t = RTCRtpTransceiverInternal::new(
+        kind,
+        None,
+        RTCRtpTransceiverInit {
+            direction: RTCRtpTransceiverDirection::Recvonly,
+            ..Default::default()
+        },
+    );
+    t.set_current_direction(RTCRtpTransceiverDirection::Recvonly);
+    t.set_mid("audio-0".into()).unwrap();
+    let r = t.receiver_mut().as_mut().unwrap();
+    r.set_codec_preferences(preferences);
+    let c = RTCRtpCodingParameters {
+        ssrc: Some(1001),
+        ..Default::default()
+    };
+    r.set_coding_parameters(vec![c.clone()]);
+    r.set_track(MediaStreamTrack::new(
+        "stream".into(),
+        "audio".into(),
+        "declared".into(),
+        kind,
+        vec![RTCRtpEncodingParameters {
+            rtp_coding_parameters: c,
+            ..Default::default()
+        }],
+    ));
+    t
+}
+struct Fixture<P: ::interceptor::Interceptor> {
+    pc: RTCPeerConnection<P>,
+    sender: Context,
+    now: Instant,
+    ext: u8,
+}
+impl<P: ::interceptor::Interceptor> Fixture<P> {
+    fn new(m: MediaEngine, registry: Registry<P>) -> Self {
+        let mut pc = RTCPeerConnectionBuilder::new()
+            .with_media_engine(m.clone())
+            .with_interceptor_registry(registry)
+            .build()
+            .unwrap();
+        let mut t = receiver(codecs());
+        let r = t.receiver_mut().as_mut().unwrap();
+        r.interceptor_remote_streams_op(&m, &mut pc.interceptor, true);
+        let ext = r
+            .get_parameters(&m)
+            .rtp_parameters
+            .header_extensions
+            .iter()
+            .find(|e| e.uri.contains("transport-wide-cc"))
+            .unwrap()
+            .id as u8;
+        pc.rtp_transceivers.push(t);
+        let mut h = pc.get_srtp_handler();
+        h.handle_event(RTCEventInternal::DTLSHandshakeComplete(
+            Some(context()),
+            Some(context()),
+        ))
+        .unwrap();
+        let evt = h.poll_event().unwrap();
+        drop(h);
+        pc.get_interceptor_handler().handle_event(evt).unwrap();
+        Self {
+            pc,
+            sender: context(),
+            now: Instant::now(),
+            ext,
+        }
+    }
+    fn packet(&mut self, pt: u8, seq: u16, ssrc: u32) -> bytes::BytesMut {
+        let mut p = rtp::Packet::default();
+        p.header.version = 2;
+        p.header.ssrc = ssrc;
+        p.header.payload_type = pt;
+        p.header.sequence_number = seq;
+        p.header.timestamp = u32::from(seq) * 160;
+        p.payload = vec![1, 0, 0, 80].into();
+        p.header
+            .set_extension(self.ext, seq.to_be_bytes().to_vec().into())
+            .unwrap();
+        self.sender.encrypt_rtp(&p.marshal().unwrap()).unwrap()
+    }
+    fn preflight(
+        &mut self,
+        bytes: bytes::BytesMut,
+    ) -> shared::error::Result<Vec<TaggedRTCMessageInternal>> {
+        let mut h = self.pc.get_srtp_handler();
+        h.handle_read(TaggedRTCMessageInternal {
+            now: self.now,
+            transport: TransportContext::default(),
+            message: RTCMessageInternal::Rtp(RTPMessage::Raw(bytes)),
+        })?;
+        let decoded = h.poll_read().unwrap();
+        drop(h);
+        let RTCMessageInternal::Rtp(RTPMessage::Packet(Packet::Rtp(ref p))) = decoded.message
+        else {
+            panic!()
+        };
+        let original = p.marshal().unwrap();
+        let mut h = self.pc.get_interceptor_handler();
+        h.handle_read(decoded)?;
+        let mut out = Vec::new();
+        while let Some(p) = h.poll_read() {
+            assert_eq!(p.now, self.now);
+            if let RTCMessageInternal::Rtp(RTPMessage::Packet(Packet::Rtp(ref pkt))) = p.message {
+                assert_eq!(
+                    pkt.marshal().unwrap(),
+                    original,
+                    "preflight cannot change bytes"
+                );
+            }
+            out.push(p);
+        }
+        Ok(out)
+    }
+    fn finish(&mut self, packets: Vec<TaggedRTCMessageInternal>) {
+        let mut h = self.pc.get_endpoint_handler();
+        for p in packets {
+            h.handle_read(p).unwrap();
+        }
+        while h.poll_read().is_some() {}
+    }
+    fn ingest(&mut self, pt: u8, seq: u16) {
+        let wire = self.packet(pt, seq, 1001);
+        let out = self.preflight(wire).unwrap();
+        self.finish(out);
+    }
+    fn selected(&self) -> (String, u32) {
+        let c = self.pc.rtp_transceivers[0]
+            .receiver()
+            .as_ref()
+            .unwrap()
+            .track()
+            .get_codec_by_ssrc(1001)
+            .unwrap();
+        (c.mime_type.clone(), c.clock_rate)
+    }
+    fn unopened(&self) {
+        assert!(self.selected().0.is_empty());
+        assert!(
+            self.pc
+                .pipeline_context
+                .endpoint_handler_context
+                .event_outs
+                .is_empty()
+        );
+    }
+    fn feedback(&mut self) -> Vec<u16> {
+        self.now += Duration::from_millis(101);
+        self.pc
+            .get_interceptor_handler()
+            .handle_timeout(self.now)
+            .unwrap();
+        let mut out = Vec::new();
+        while let Some(p) = self.pc.interceptor.poll_write() {
+            if let Packet::Rtcp(ps) = p.message {
+                for p in ps {
+                    if let Some(t) = p.as_any().downcast_ref::<rtcp::transport_feedbacks::transport_layer_cc::TransportLayerCc>() {
+                        use rtcp::transport_feedbacks::transport_layer_cc::{PacketStatusChunk, SymbolTypeTcc};
+                        let mut symbols = Vec::new();
+                        for chunk in &t.packet_chunks {
+                            match chunk {
+                                PacketStatusChunk::RunLengthChunk(c) => symbols.extend(std::iter::repeat_n(c.packet_status_symbol, c.run_length as usize)),
+                                PacketStatusChunk::StatusVectorChunk(c) => symbols.extend(c.symbol_list.iter().copied()),
+                            }
+                        }
+                        symbols.truncate(t.packet_status_count as usize);
+                        let received: Vec<_> = symbols.iter().enumerate()
+                            .filter(|(_, symbol)| **symbol != SymbolTypeTcc::PacketNotReceived)
+                            .map(|(index, _)| t.base_sequence_number.wrapping_add(index as u16)).collect();
+                        assert_eq!(received.len(), t.recv_deltas.len());
+                        out.extend(received);
+                    }
+                }
+            }
+        }
+        out
+    }
+}
+fn default_fixture() -> Fixture<impl ::interceptor::Interceptor> {
+    let mut m = media();
+    let r = register_default_interceptors(Registry::new(), &mut m).unwrap();
+    Fixture::new(m, r)
+}
+fn positive<P: ::interceptor::Interceptor>(mut f: Fixture<P>, pt: u8, mime: &str, rate: u32) {
+    f.unopened();
+    let wire = f.packet(pt, 10, 1001);
+    let out = f.preflight(wire).unwrap();
+    f.unopened();
+    f.finish(out);
+    assert_eq!(f.selected(), (mime.into(), rate));
+    assert_eq!(
+        f.pc.pipeline_context
+            .endpoint_handler_context
+            .event_outs
+            .len(),
+        1
+    );
+    assert_eq!(
+        f.feedback(),
+        vec![10],
+        "first actual negotiated payload receipt must survive preflight"
+    );
+}
+#[test]
+fn payload_audio_feedback_opus_actual_multicodec_answer() {
+    positive(default_fixture(), 111, "audio/opus", 48000);
+}
+#[test]
+fn payload_audio_feedback_pcmu_actual_multicodec_answer() {
+    positive(default_fixture(), 0, "audio/PCMU", 8000);
+}
+#[test]
+fn payload_audio_feedback_pcma_actual_multicodec_answer() {
+    positive(default_fixture(), 8, "audio/PCMA", 8000);
+}
+#[test]
+fn payload_audio_feedback_clock_registry_actual_multicodec_answer() {
+    let mut m = media();
+    let r = register_default_interceptors_with_sender_clock(
+        Registry::new(),
+        &mut m,
+        SenderClockHandle::default(),
+    )
+    .unwrap();
+    positive(Fixture::new(m, r), 111, "audio/opus", 48000);
+}
+#[test]
+fn payload_audio_feedback_telephone_first_keeps_application_timing() {
+    let mut f = default_fixture();
+    let wire = f.packet(126, 9, 1001);
+    let out = f.preflight(wire).unwrap();
+    f.unopened();
+    f.finish(out);
+    assert_eq!(f.selected(), ("audio/telephone-event".into(), 8000));
+    f.ingest(111, 10);
