+#[cfg(feature = "test-support")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_catalog_observer_distinguishes_released_source_lock_from_full_window_exclusion() {
+    use rvoip_core::orchestrator::participant_control::ParticipantControlError;
+    use rvoip_core::staged_streams::subscription_plan::{CatalogBusyLeafForTest, CatalogReadDiagnosticsForTest, MediaSelectionChange};
