+            let mut rows = Vec::new();
+            let mut observation_overflow = false;
+            let mut release_at = None;
+            // Keep observing to the original endpoint even after recovery.
+            while Instant::now() < until {
+                let row = match tokio::time::timeout_at(until, observations.recv()).await {
+                    Ok(Some(row)) => row,
+                    _ => break,
+                };
+                let source_busy = row.started >= held_at && row.at <= until
+                    && row.leaf == Some(CatalogBusyLeafForTest::SourceState(source_id.clone()))
+                    && matches!(row.outcome, CatalogObservedOutcome::Refused(NativeOfferError::Dispatch(DispatchError::StorageUnavailable)));
