+            assert!(!successful_during_full_exclusion, "a still-held source can never produce an in-window successful catalog kind={kind} rows={rows:?}");
+            assert!(!changed_catalog && unchanged && dropped == 0 && !observation_overflow, "full-window catalog/counters/observer capacity kind={kind} rows={rows:?} dropped={dropped}");
