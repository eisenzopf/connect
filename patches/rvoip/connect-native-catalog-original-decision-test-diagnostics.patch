+            let (mut s, mut other, policy) = setup(kind).await;
+            let receiver = s.native.adapters[&s.kind].media_controller(&s.second_id).unwrap();
+            other.send(s.f.sign(select(receiver.revision()))).await;
+            assert_eq!(other.read().await.kind(), "ack");
+            let (_, callback) = s.prepared(add_video(&s, 1, false)).await;
+            s.confirm(&callback).await;
+            s.wait(3).await;
+            let callback = other.read().await;
+            other.send(s.f.sign(s.confirmation(&callback))).await;
+            core_fixture::until(|| receiver.revision() == 3).await;
+            core_fixture::until(|| policy.operations.lock().unwrap().iter().any(|(_, v)| matches!(v, Ok(3)))).await;
+            tokio::time::sleep(Duration::from_millis(650)).await;
+            let before = s.native.core.orch.plan_staged_media_selection(&s.native.core.session, &s.second_id, 3, &MediaSelectionChange::Reconcile).unwrap();
+            let attempts = policy.attempts.load(Ordering::Acquire);
+            let operations = policy.operations.lock().unwrap().len();
+            let mut observations = arm_catalog_probe(&policy, &s.second_id, &before);
+            let source = s.controller();
+            let source_id = s.id.clone();
+            let (held_tx, held_rx) = tokio::sync::oneshot::channel();
+            let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+            let until = Instant::now() + Duration::from_millis(650);
+            let owner = tokio::task::spawn_blocking(move || source.with_model_state_exclusion_for_test(|| {
+                let _ = held_tx.send(());
+                release_rx.recv_timeout(until.saturating_duration_since(Instant::now())).is_ok()
+            }));
+            let entered = tokio::time::timeout_at(until, held_rx).await.is_ok_and(|v| v.is_ok());
+            let held_at = Instant::now();
+            let mut direct_diagnostics = CatalogReadDiagnosticsForTest::default();
+            let direct = entered.then(|| s.native.core.orch.plan_staged_media_selection_diagnosed_for_test(
