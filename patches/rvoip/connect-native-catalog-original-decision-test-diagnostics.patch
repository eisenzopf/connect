+                    release_at = Some(Instant::now());
+                    let _ = release_tx.send(());
+                }
+            }
+            tokio::time::sleep_until(until).await;
+            let released_by_signal = owner.await.unwrap();
+            drop(release_tx);
+            let saw_source_busy = rows.iter().any(|r| r.started >= held_at && r.at <= until
