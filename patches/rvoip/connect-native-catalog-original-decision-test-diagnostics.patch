+// Exact original try_lock decisions, not fabricated error values.
+#[cfg(feature = "test-support")]
+#[tokio::test]
+async fn catalog_diagnostics_report_original_members_target_source_decisions_without_effects() {
+    use crate::staged_streams::subscription_plan::{CatalogBusyLeafForTest, CatalogReadDiagnosticsForTest, MediaSelectionChange};
+    let s = wildcard_scene().await;
+    let expected = s.f.b.revision();
+    let budget = s.f.b.stream_open_budget();
+    let mut diagnostics = CatalogReadDiagnosticsForTest::default();
+    let input = MediaSelectionChange::Reconcile;
+    let held = s.scene.members.lock().unwrap();
+    let members = s.scene.plan_selection_diagnosed_for_test(&s.f.b.connection, expected, &input, &mut diagnostics).map(drop);
+    drop(held);
+    assert!(matches!(members, Err(StreamControlError::Backpressure)));
+    assert_eq!(diagnostics.busy_leaf, Some(CatalogBusyLeafForTest::Members));
+    let held = s.f.b.state.lock().unwrap();
+    let target = s.scene.plan_selection_diagnosed_for_test(&s.f.b.connection, expected, &input, &mut diagnostics).map(drop);
+    drop(held);
+    assert!(matches!(target, Err(StreamControlError::Backpressure)));
+    assert_eq!(diagnostics.busy_leaf, Some(CatalogBusyLeafForTest::TargetState));
+    let held = s.f.a.state.lock().unwrap();
+    let source = s.scene.plan_selection_diagnosed_for_test(&s.f.b.connection, expected, &input, &mut diagnostics).map(drop);
+    drop(held);
+    assert!(matches!(source, Err(StreamControlError::Backpressure)));
+    assert_eq!(diagnostics.busy_leaf, Some(CatalogBusyLeafForTest::SourceState(s.f.a.connection.clone())));
+    let observed = s.scene.plan_selection_diagnosed_for_test(&s.f.b.connection, expected, &input, &mut diagnostics).unwrap();
+    assert!(diagnostics.busy_leaf.is_none(), "a later success cannot inherit the prior leaf");
+    let plain = s.scene.plan_selection(&s.f.b.connection, expected, &input).unwrap();
+    assert!(observed.same_catalog(&plain));
+    assert!(matches!(s.scene.plan_selection_diagnosed_for_test(&s.f.b.connection, expected + 1, &input, &mut diagnostics), Err(StreamControlError::Model(MediaTransitionError::Conflict))));
+    assert!(diagnostics.busy_leaf.is_none(), "stale revision is not contention");
+    assert_eq!(s.f.b.revision(), expected);
+    assert_eq!(s.f.b.stream_open_budget(), budget);
+}
