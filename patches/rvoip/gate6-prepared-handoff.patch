+//! Actual isolated duplex IO, independent of the old private model audience.
+use super::*;
+use crate::staged_streams::{
+    consultation::PrivateConsultationHandle, local_audio::LocalAudioPurpose,
+};
+
+struct Prepared {
+    room: Room,
+    old: Option<PrivateConsultationHandle>,
+    incoming: AudioAudienceHandle,
+}
+impl Prepared {
+    async fn new(private: bool) -> Self {
+        let mut room =
+            Room::new_with_kinds(BTreeMap::from([("public".into(), ParticipantKind::Ai)])).await;
+        let old = if private {
+            Some(room.handoff_ready().await)
+        } else {
+            None
+        };
+        room.add("fresh", Some("public"), true).await;
+        let plan = room
+            .scene
+            .plan_audio_audience(AudioAudienceRequest {
+                operation_id: "isolated-fresh-public-target".into(),
+                expected_revision: room.scene.audience_revision(),
+                private_connections: BTreeSet::from([ConnectionId::from_string("fresh")]),
+                receivers: BTreeMap::from([(ConnectionId::from_string("fresh"), vec![])]),
+                activate_muted: Some(ConnectionId::from_string("fresh")),
+            })
+            .unwrap();
+        let (_, incoming) = room.apply(plan).await.unwrap();
+        room.domain
+            .local_preparations
+            .lock()
+            .unwrap()
+            .insert(ConnectionId::from_string("fresh"), "handoff-1".into());
+        Self {
+            room,
+            old,
+            incoming,
+        }
+    }
+    fn plan(&self, disposition: OldHandoffDisposition) -> ControlResult<AudioHandoffPlan> {
+        let mut request = self.room.handoff_request(disposition);
+        request.admitted = ConnectionId::from_string("fresh");
+        self.room.scene.plan_prepared_audio_handoff(
+            &self.incoming,
+            self.old.as_ref().map(|h| h.audience()),
+            request,
+        )
+    }
+    fn queue_silence(&mut self) -> ControlResult<()> {
+        use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+        let n = self.room.nodes.get_mut("fresh").unwrap();
+        n.sequence += 1;
+        let port = n.adapter.port(Medium::Audio);
+        let mut f = frame(&port, n.sequence);
+        f.payload = CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap()
+            .encode(&AudioFrame {
+                samples: vec![0; 160],
+                sample_rate: 8000,
+                channels: 1,
+                duration: Duration::from_millis(20),
+                timestamp: n.sequence,
+            })
+            .unwrap()
+            .into();
+        n.controller.try_queue_local_audio(
+            &desired(Medium::Audio).logical_id,
+            f,
+            LocalAudioPurpose::EndpointPreparation {
+                operation_id: "handoff-1".into(),
+            },
+        )
+    }
+    async fn ready(&mut self) {
+        self.room.publish("fresh", 12000).unwrap();
+        self.room.tick();
+        self.room
+            .silent(&["alice", "bob", "public", "hold", "fresh"]);
+        if self.old.is_some() {
+            self.room.silent(&["consult"]);
+        }
+        self.queue_silence().unwrap();
+        self.room.heard("fresh", 0).await;
+    }
+    async fn original(&mut self) {
+        self.room.publish("alice", 800).unwrap();
+        self.room.tick();
+        if self.old.is_some() {
+            self.room.heard("consult", 800).await;
+            self.room.silent(&["bob", "public", "fresh"]);
+            self.room.publish("consult", 5200).unwrap();
+            self.room.tick();
+            self.room.heard("alice", 5200).await;
+            self.room.silent(&["bob", "public", "fresh"]);
+        } else {
+            self.room.heard("bob", 800).await;
+            self.room.heard("public", 800).await;
+            self.room.silent(&["fresh"]);
+        }
+    }
+}
+#[tokio::test]
+async fn prepared_handoff_requires_actual_decoding_and_completed_local_delivery() {
+    for missing in ["both", "decoded", "delivery", "queued-only"] {
+        let mut p = Prepared::new(true).await;
+        if missing != "decoded" && missing != "both" {
+            p.room.publish("fresh", 12000).unwrap();
+            p.room.tick();
+        }
+        if missing != "delivery" && missing != "both" {
+            p.queue_silence().unwrap();
+            if missing == "decoded" {
+                p.room.heard("fresh", 0).await;
+            }
+        }
+        assert!(matches!(
+            p.plan(OldHandoffDisposition::Leave),
+            Err(StreamControlError::NotReady)
+        ));
+        if missing == "queued-only" {
+            p.room.heard("fresh", 0).await;
+        }
+        p.original().await;
+        p.ready().await;
+        assert!(p.plan(OldHandoffDisposition::Leave).is_ok());
+    }
+}
+#[tokio::test]
+async fn prepared_handoff_consumes_isolation_and_old_private_context_without_model_audio_leakage() {
+    for private in [false, true] {
+        for disposition in [
+            OldHandoffDisposition::Observer,
+            OldHandoffDisposition::Leave,
+        ] {
+            let mut p = Prepared::new(private).await;
+            p.original().await;
+            p.ready().await;
+            let remote = p.room.nodes["bob"].controller.active_bindings()[0].clone();
+            let before = p.room.scene.audience_revision();
+            let plan = p.plan(disposition).unwrap();
+            let stale = plan.clone();
+            assert!(!p.room.nodes["alice"].controller.shutdown.is_cancelled());
+            // A prompt queued in the old isolation may not cross the commit.
+            p.queue_silence().unwrap();
+            let queued = p
+                .room
+                .nodes
+                .get_mut("fresh")
+                .unwrap()
+                .out
+                .try_recv()
+                .unwrap();
+            let (outcome, handle) = p.room.handoff(plan).await.unwrap();
+            assert_eq!(outcome.media.audience_revision, before + 1);
+            assert_eq!(outcome.retained, ConnectionId::from_string("bob"));
+            assert_eq!(outcome.admitted, ConnectionId::from_string("fresh"));
+            assert!(queued
+                .deliver(|_| async { panic!("old isolation prompt crossed handoff") })
+                .await
+                .is_err());
+            assert!(p.room.handoff(stale).await.is_err());
+            assert!(p.plan(disposition).is_err());
+            assert!(p
+                .room
+                .scene
+                .plan_restore_audio_audience(
+                    &p.incoming,
+                    "reuse-preparation".into(),
+                    p.room.scene.audience_revision()
+                )
+                .is_err());
+            p.room.publish("bob", 2400).unwrap();
+            p.room.tick();
+            p.room.heard("fresh", 2400).await;
+            if disposition == OldHandoffDisposition::Observer {
+                p.room.heard("alice", 2400).await;
+            }
+            p.room.silent(&["public", "bob"]);
+            if private {
+                p.room.silent(&["consult"]);
+            }
+            assert!(p.room.publish("alice", 800).is_err());
+            if private {
+                let participant = p.room.nodes["fresh"]
+                    .controller
+                    .origin_member
+                    .participant()
+                    .clone();
+                p.room
+                    .select("bob", vec![AudioSubscription::Participant(participant)])
+                    .await;
+            }
+            p.room.publish("fresh", 7600).unwrap();
+            p.room.tick();
+            p.room.heard("bob", 7600).await;
+            if disposition == OldHandoffDisposition::Observer {
+                p.room.heard("alice", 7600).await;
+            }
+            p.room.silent(&["public", "fresh"]);
+            if private {
+                let old = p.old.as_ref().unwrap();
+                assert!(p
+                    .room
+                    .scene
+                    .plan_restore_audio_audience(
+                        old.audience(),
+                        "revive-private-model".into(),
+                        p.room.scene.audience_revision()
+                    )
+                    .is_err());
+                let c = &p.room.nodes["public"].controller;
+                assert!(matches!(
+                    p.room
+                        .scene
+                        .change_subscriptions(
+                            &c.connection,
+                            c.revision(),
+                            AudioSubscriptionChange::Subscribe(vec![
+                                AudioSubscription::Connection(ConnectionId::from_string("consult"))
+                            ]),
+                            deadline(),
+                            CancellationToken::new(),
+                            None
+                        )
+                        .await,
+                    Err(StreamControlError::Authority)
+                ));
+
+                p.room.publish("consult", 5200).unwrap();
+                p.room.tick();
+                p.room
+                    .silent(&["alice", "bob", "public", "fresh", "consult"]);
+                let registry = p.room.scene.audiences.lock().unwrap();
+                assert!(!registry.restorable.contains(old.audience().operation_id()));
+                assert!(
+                    registry
+                        .groups
+                        .values()
+                        .any(|g| g.origins.len() == 1
+                            && g.origins[0].connection.as_str() == "consult")
+                );
+            }
+            let now = p.room.nodes["bob"].controller.active_bindings()[0].clone();
+            assert_eq!(remote.transport_id, now.transport_id);
+            assert_eq!(remote.stream_local_id, now.stream_local_id);
+            assert_eq!(handle.old_disposition(), disposition);
+        }
+    }
+}
+#[tokio::test]
+async fn prepared_handoff_rejects_wrong_context_or_missing_private_replacement() {
+    let mut p = Prepared::new(true).await;
+    p.ready().await;
+    let mut request = p.room.handoff_request(OldHandoffDisposition::Leave);
+    request.admitted = ConnectionId::from_string("fresh");
+    assert!(p
+        .room
+        .scene
+        .plan_prepared_audio_handoff(&p.incoming, None, request.clone())
+        .is_err());
+    let old = p.old.as_ref().unwrap();
+    assert!(p
+        .room
+        .scene
+        .plan_prepared_audio_handoff(old.audience(), None, request.clone())
+        .is_err());
+    assert!(p
+        .room
+        .scene
+        .plan_prepared_audio_handoff(&p.incoming, Some(&p.incoming), request.clone())
+        .is_err());
+    let other = Prepared::new(false).await;
+    assert!(p
+        .room
+        .scene
+        .plan_prepared_audio_handoff(&other.incoming, Some(old.audience()), request)
+        .is_err());
+    p.original().await;
+    assert!(p.plan(OldHandoffDisposition::Leave).is_ok());
+}
+#[tokio::test]
+async fn prepared_handoff_current_revocation_and_cancellation_preserve_the_original_private_route()
+{
+    for revoke in [false, true] {
+        let mut p = Prepared::new(true).await;
+        p.ready().await;
+        let plan = p.plan(OldHandoffDisposition::Leave).unwrap();
+        let before = p.room.scene.audience_revision();
+        if revoke {
+            p.room
+                .domain
+                .base
+                .0
+                .write()
+                .await
+                .revoked
+                .insert("public".into());
+            assert!(p.room.handoff(plan).await.is_err());
+            p.room.domain.base.0.write().await.revoked.remove("public");
+        } else {
+            let cancel = CancellationToken::new();
+            cancel.cancel();
+            let grant = p
+                .room
+                .grant(Approval::Audience(plan.audience().clone()))
+                .await;
+            assert!(matches!(
+                p.room
+                    .scene
+                    .commit_audio_handoff(plan, deadline(), cancel, &grant)
+                    .await,
+                Err(StreamControlError::Cancelled)
+            ));
+            drop(grant);
+        }
+        assert_eq!(p.room.scene.audience_revision(), before);
+        assert!(!p.room.nodes["alice"].controller.shutdown.is_cancelled());
+        p.original().await;
+    }
