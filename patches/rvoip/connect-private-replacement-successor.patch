+#[tokio::test]
+async fn private_primary_successor_metadata_has_no_strong_controller_or_scene_owner_cycle() {
+    let mut f = Move::private_primary().await;
+    let original = f.consultation.clone().unwrap();
+    f.io().await;
+    f.confirm().await;
+    let plan = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    let (_, movement) = f.commit(plan).await.unwrap();
+    let successor = movement.private_successor().unwrap().clone();
+    let weak_scene = Arc::downgrade(&f.room.scene);
+    let weak_controllers = f
+        .room
+        .nodes
+        .values()
+        .map(|n| Arc::downgrade(&n.controller))
+        .collect::<Vec<_>>();
+    for node in f.room.nodes.values() {
+        assert_eq!(node.controller.shutdown(deadline()).await, 0);
+    }
+    drop(f);
+    assert!(weak_scene.upgrade().is_none());
+    assert!(weak_controllers
+        .iter()
+        .all(|owner| owner.upgrade().is_none()));
+    assert!(
+        successor.succeeds(&original),
+        "immutable lineage metadata survives without owning physical resources"
+    );
+    drop((successor, movement, original));
+}
