+    f.io().await;
+    f.confirm().await;
+    let stale = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    let target = f
+        .room
+        .scene
+        .role_targets(&[ConnectionId::from_string("alice")])
+        .remove(0);
+    target
+        .prepare_role(deadline(), CancellationToken::new())
+        .await
+        .unwrap()
+        .commit(false);
+    assert!(f.commit(stale).await.is_err());
+    let plan = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    assert!(!plan.old_may_speak());
+    let (_, movement) = f.commit(plan).await.unwrap();
+    let successor = movement.private_successor().unwrap().clone();
+    assert!(f.room.publish("device", 5200).is_err());
+    f.room.publish("consult", 6800).unwrap();
+    f.room.tick();
+    f.room.heard("device", 6800).await;
+    f.room.silent(&["bob", "public", "other", "alice"]);
+    f.room.restore_consultation(&successor).await;
+    assert!(
+        f.room.publish("device", 2400).is_err(),
+        "restoration cannot create current speaking permission"
+    );
+    f.room.publish("bob", 3200).unwrap();
+    f.room.tick();
+    f.room.heard("device", 3200).await;
+    f.room.heard("other", 3200).await;
+    f.room.silent(&["consult", "alice", "public"]);
+    close(f).await;
+}
