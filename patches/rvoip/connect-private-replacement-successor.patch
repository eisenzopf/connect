+//! Actual decoded PCM and same-commit private restoration. No Store projection
+//! or caller-provided receipt can fabricate the successor handle in these tests.
+use super::*;
+async fn close(f: Move) {
+    for node in f.room.nodes.values() {
+        assert_eq!(node.controller.shutdown(deadline()).await, 0);
+    }
+    drop(f);
+}
+
+#[tokio::test]
+async fn private_primary_successor_restores_original_public_programmes_after_actual_replacement() {
+    let mut f = Move::private_primary().await;
+    let original = f.consultation.clone().unwrap();
+    f.room.publish("alice", 800).unwrap();
+    f.room.tick();
+    f.room.heard("consult", 800).await;
+    f.room.silent(&["bob", "public", "other", "device"]);
+    f.room.publish("hold", 10400).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 10400).await;
+    f.room
+        .silent(&["alice", "consult", "public", "other", "device"]);
+    f.io().await;
+    f.confirm().await;
+    let plan = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    let (_, movement) = f.commit(plan).await.unwrap();
+    let successor = movement
+        .private_successor()
+        .expect("actual private commit supplies successor")
+        .clone();
+    assert!(successor.succeeds(&original));
+    assert!(!successor.same_restoration(&original));
+    assert_eq!(
+        successor.audience().operation_id(),
+        original.audience().operation_id()
+    );
+    assert_eq!(
+        successor.primary_connection(),
+        &ConnectionId::from_string("device")
+    );
+    assert!(f
+        .room
+        .scene
+        .plan_restore_audio_audience(
+            original.audience(),
+            "old-refused".into(),
+            f.room.scene.audience_revision()
+        )
+        .is_err());
+    assert!(f.room.publish("alice", 800).is_err());
+    f.room.publish("device", 5200).unwrap();
+    f.room.tick();
+    f.room.heard("consult", 5200).await;
+    f.room.silent(&["bob", "public", "other", "alice"]);
+    f.room.publish("consult", 6800).unwrap();
+    f.room.tick();
+    f.room.heard("device", 6800).await;
+    f.room.silent(&["bob", "public", "other", "alice"]);
+    f.room.restore_consultation(&successor).await;
+    f.room.publish("device", 2400).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 2400).await;
+    f.room.heard("public", 2400).await;
+    f.room.silent(&["consult", "alice", "other"]);
+    f.room.publish("bob", 3200).unwrap();
+    f.room.tick();
+    f.room.heard("device", 3200).await;
+    f.room.heard("other", 3200).await;
+    f.room.silent(&["consult", "alice", "public"]);
+    f.room.publish("other", 1800).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 1800).await;
+    f.room.heard("public", 1800).await;
+    f.room.silent(&["consult", "alice", "device"]);
+    assert!(
+        f.room.publish("consult", 6800).is_err(),
+        "restored private consultant stays quarantined"
+    );
+    assert!(f
+        .room
+        .scene
+        .plan_restore_audio_audience(
+            successor.audience(),
+            "duplicate-refused".into(),
+            f.room.scene.audience_revision()
+        )
+        .is_err());
+    close(f).await;
+}
+
+#[tokio::test]
+async fn private_primary_successor_rejects_foreign_handle_and_cancel_keeps_original_restore_owner()
+{
+    let mut f = Move::private_primary().await;
+    let foreign = Move::private_primary().await;
+    let original = f.consultation.clone().unwrap();
+    f.io().await;
+    f.confirm().await;
+    assert!(f
+        .plan()
+        .unwrap()
+        .with_private_consultation(foreign.consultation.as_ref().unwrap())
+        .is_err());
+    let plan = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    let grant = f
+        .room
+        .grant(Approval::Audience(plan.audience().clone()))
+        .await;
+    let cancel = CancellationToken::new();
+    cancel.cancel();
+    assert!(f
+        .room
+        .scene
+        .commit_audio_device_replacement(plan, deadline(), cancel, &grant)
+        .await
+        .is_err());
+    drop(grant);
+    f.room.publish("alice", 800).unwrap();
+    f.room.tick();
+    f.room.heard("consult", 800).await;
+    f.room.silent(&["bob", "public", "other", "device"]);
+    f.room.restore_consultation(&original).await;
+    f.room.publish("alice", 2400).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 2400).await;
+    f.room.heard("public", 2400).await;
+    f.room.silent(&["consult", "device"]);
+    close(foreign).await;
+    close(f).await;
+}
+
+#[tokio::test]
+async fn private_primary_successor_requires_current_authority_and_fresh_original_revision() {
+    let mut f = Move::private_primary().await;
+    let original = f.consultation.clone().unwrap();
+    f.io().await;
+    f.confirm().await;
+    let plan = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    f.room
+        .domain
+        .deny_replacement
+        .store(true, Ordering::Release);
+    assert!(f.commit(plan).await.is_err());
+    f.room
+        .domain
+        .deny_replacement
+        .store(false, Ordering::Release);
+    let stale = f
+        .plan()
+        .unwrap()
+        .with_private_consultation(&original)
+        .unwrap();
+    f.room.restore_consultation(&original).await;
+    assert!(
+        f.commit(stale).await.is_err(),
+        "restored private identity cannot be revived by a prepared replacement"
+    );
+    f.room.publish("alice", 2400).unwrap();
+    f.room.tick();
+    f.room.heard("bob", 2400).await;
+    f.room.heard("public", 2400).await;
+    f.room.silent(&["consult", "device"]);
+    close(f).await;
+}
