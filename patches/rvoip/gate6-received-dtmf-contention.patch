+// Mirrors SIP's physical fence: current() cannot distinguish busy from stale,
+// whereas poll() preserves NotReady/Pending and owns exact custody only in IO.
+struct BusyReceivedSource {
+    source: ControlledSource,
+    mode: AtomicUsize,
+}
+impl DtmfSourceFence for BusyReceivedSource {
+    fn current(&self) -> bool {
+        matches!(
+            self.poll(&mut || std::task::Poll::Ready(Ok(()))),
+            std::task::Poll::Ready(Ok(()))
+        )
+    }
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        match self.mode.load(Ordering::SeqCst) {
+            1 => std::task::Poll::Ready(Err(DtmfWriteError::NotReady)),
+            2 => std::task::Poll::Pending,
+            3 => std::task::Poll::Ready(Err(DtmfWriteError::Refused)),
+            _ => self.source.poll(io),
+        }
+    }
+}
+#[tokio::test]
+async fn accepted_received_physical_busy_waits_without_policy_or_io_and_cancel_deadline_stay_bounded(
+) {
+    for busy in [1, 2] {
+        for finish in ["release", "cancel", "deadline"] {
+            let r = Rig::new_source(Transport::WebRtc).await;
+            let registry = DtmfSourceRegistry::new(Transport::WebRtc);
+            let mut sub = registry
+                .subscribe(&r.core, r.origin.clone(), r.source.clone())
+                .unwrap();
+            let physical = Arc::new(BusyReceivedSource {
+                source: ControlledSource {
+                    adapter: r.origin.clone(),
+                    connection: r.source.clone(),
+                    stream: r.origin.streams.get(&r.source).unwrap().clone(),
+                },
+                mode: AtomicUsize::new(0),
+            });
+            let input = DtmfReceivedInput::rfc4733(
+                DtmfSourceKind::WebRtcRfc4733,
+                "original-busy-observation".into(),
+                received_input(&r, "unused", 800, true)
+                    .rtp()
+                    .unwrap()
+                    .clone(),
+                std::time::SystemTime::now(),
+                std::time::Instant::now(),
+                physical.clone(),
+            )
+            .unwrap();
+            assert!(registry.publish(&r.source, input));
+            let observation = sub.recv().await.unwrap();
+            physical.mode.store(busy, Ordering::SeqCst);
+            let route = observation
+                .prepare_route(
+                    &r.core,
+                    r.target.clone(),
+                    "stable-logical-operation".into(),
+                    DtmfMethod::Rfc4733,
+                )
+                .unwrap();
+            let policy = Policy::new(&r);
+            let cancel = CancellationToken::new();
+            let waiting = r.core.route_dtmf(
+                &route,
+                policy.clone(),
+                cancel.clone(),
+                Instant::now() + Duration::from_millis(180),
+            );
+            tokio::pin!(waiting);
+            assert!(
+                tokio::time::timeout(Duration::from_millis(30), &mut waiting)
+                    .await
+                    .is_err()
+            );
+            assert_eq!(policy.calls.load(Ordering::SeqCst), 0);
+            let mut packet = [0; 2048];
+            assert!(
+                matches!(r.receiver.try_recv(&mut packet), Err(e) if e.kind() == std::io::ErrorKind::WouldBlock)
+            );
+            match finish {
+                "release" => {
+                    physical.mode.store(0, Ordering::SeqCst);
+                    assert_eq!(waiting.await, Ok(()));
+                    assert_eq!(r.receive().await.payload[0], 5);
+                }
+                "cancel" => {
+                    cancel.cancel();
+                    assert_eq!(waiting.await, Err(DtmfWriteError::Refused));
+                }
+                _ => assert_eq!(waiting.await, Err(DtmfWriteError::DeadlineBeforeWrite)),
+            }
+            if finish != "release" {
+                assert_eq!(policy.calls.load(Ordering::SeqCst), 0);
+                physical.mode.store(0, Ordering::SeqCst);
+                assert!(
+                    matches!(r.receiver.try_recv(&mut packet), Err(e) if e.kind() == std::io::ErrorKind::WouldBlock)
+                );
+            }
+            physical.mode.store(3, Ordering::SeqCst);
+            assert_eq!(
+                observation
+                    .prepare_route(
+                        &r.core,
+                        r.target.clone(),
+                        "stable-logical-operation".into(),
+                        DtmfMethod::Rfc4733
+                    )
+                    .err(),
+                Some(DtmfWriteError::Refused)
+            );
+            physical.mode.store(0, Ordering::SeqCst);
+            drop(sub);
+            assert_eq!(
+                r.core
+                    .route_dtmf(
+                        &route,
+                        policy.clone(),
+                        CancellationToken::new(),
+                        Instant::now() + Duration::from_secs(1)
+                    )
+                    .await,
+                Err(DtmfWriteError::Refused)
+            );
+            assert!(policy.domain.try_write().is_ok());
+        }
+    }
+}
