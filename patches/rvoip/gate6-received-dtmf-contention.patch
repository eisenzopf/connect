+#[tokio::test]
+async fn accepted_received_source_metadata_busy_is_not_retirement_and_unaccepted_input_still_drops()
+{
+    let r = Rig::new_source(Transport::WebRtc).await;
+    let registry = DtmfSourceRegistry::new(Transport::WebRtc);
+    let mut sub = registry
+        .subscribe(&r.core, r.origin.clone(), r.source.clone())
+        .unwrap();
+    assert!(registry.publish(
+        &r.source,
+        received_input(&r, "accepted-before-busy", 800, true)
+    ));
+    let observation = sub.recv().await.unwrap();
+    let session = r.core.session(&r.sid).unwrap();
+    let held = session.write().unwrap();
+    assert_eq!(
+        observation
+            .prepare_route(
+                &r.core,
+                r.target.clone(),
+                "stable-logical-operation".into(),
+                DtmfMethod::Rfc4733
+            )
+            .err(),
+        Some(DtmfWriteError::NotReady)
+    );
+    assert!(!registry.publish(
+        &r.source,
+        received_input(&r, "unaccepted-while-busy", 800, true)
+    ));
+    assert_eq!(sub.dropped(), 1);
+    drop(held);
+    let route = observation
+        .prepare_route(
+            &r.core,
+            r.target.clone(),
+            "stable-logical-operation".into(),
+            DtmfMethod::Rfc4733,
+        )
+        .unwrap();
+    assert_eq!(
+        route.observation().observation_id(),
+        Some("accepted-before-busy")
+    );
+    r.core
+        .route_dtmf(
+            &route,
+            Policy::new(&r),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    assert_eq!(r.receive().await.payload[0], 5);
+    assert!(tokio::time::timeout(Duration::from_millis(30), sub.recv())
+        .await
+        .is_err());
+}
