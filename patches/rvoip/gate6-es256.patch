@@ -0,0 +1,333 @@
+use super::*;
+use crate::bearer::{AuthenticatedPrincipal, AuthenticationMethod};
+use ring::{
+    rand::SystemRandom,
+    signature::{KeyPair, ECDSA_P256_SHA256_ASN1_SIGNING, ECDSA_P384_SHA384_FIXED_SIGNING},
+};
+use serde_json::{json, Value};
+
+fn principal() -> AuthenticatedPrincipal {
+    AuthenticatedPrincipal {
+        subject: "alice".into(),
+        tenant: Some("tenant".into()),
+        issuer: Some("issuer".into()),
+        scopes: vec![],
+        expires_at: Some(Utc::now() + chrono::Duration::hours(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: rvoip_core_traits::identity::IdentityAssurance::Identified {
+            credential_kind: rvoip_core_traits::identity::CredentialKind::Oidc,
+        },
+    }
+}
+fn envelope() -> Value {
+    json!({"v":2,"type":"connection.update","id":format!("env_{}",uuid::Uuid::new_v4().simple()),"ts":Utc::now(),"cid":"conversation","sid":"session","connid":"connection","operation_id":"operation","in_reply_to":"callback","expected_revision":1,"payload":{"action":"hold"},"optional":{"z":1e-7,"a":"\u{1f600}"}})
+}
+fn signing_with_document() -> (
+    Sig9421Signer,
+    ResolvedVerificationKey,
+    ring::pkcs8::Document,
+) {
+    let rng = SystemRandom::new();
+    let doc = EcdsaKeyPair::generate_pkcs8(&ECDSA_P256_SHA256_FIXED_SIGNING, &rng).unwrap();
+    let public = EcdsaKeyPair::from_pkcs8(&ECDSA_P256_SHA256_FIXED_SIGNING, doc.as_ref(), &rng)
+        .unwrap()
+        .public_key()
+        .as_ref()
+        .to_vec();
+    (
+        Sig9421Signer::es256("p256", doc.as_ref()).unwrap(),
+        ResolvedVerificationKey {
+            public_key: public,
+            algorithm: "ES256".into(),
+            not_before: None,
+            expires_at: None,
+            revoked: false,
+        },
+        doc,
+    )
+}
+fn signing() -> (Sig9421Signer, ResolvedVerificationKey) {
+    let (signer, key, _document) = signing_with_document();
+    (signer, key)
+}
+struct Keys {
+    owner: crate::bearer::PrincipalOwnershipKey,
+    keys: HashMap<String, ResolvedVerificationKey>,
+}
+impl KeyResolver for Keys {
+    fn resolve(&self, _: &str) -> Option<Vec<u8>> {
+        None
+    }
+    fn resolve_for_principal(
+        &self,
+        p: &AuthenticatedPrincipal,
+        id: &str,
+        a: &str,
+        _: DateTime<Utc>,
+    ) -> Option<ResolvedVerificationKey> {
+        if p.ownership_key() != self.owner {
+            return None;
+        }
+        self.keys.get(id).filter(|key| key.algorithm == a).cloned()
+    }
+}
+fn verifier(p: &AuthenticatedPrincipal, key: ResolvedVerificationKey) -> Sig9421Verifier {
+    Sig9421Verifier::new(Arc::new(Keys {
+        owner: p.ownership_key(),
+        keys: [("p256".into(), key)].into_iter().collect(),
+    }))
+}
+
+#[tokio::test]
+async fn es256_signer_produces_jwa_raw_signature_over_full_original_jcs() {
+    let (signer, key) = signing();
+    let p = principal();
+    let original = envelope();
+    let signed = signer.sign(&original).unwrap();
+    assert_eq!(signer.algorithm(), "ES256");
+    assert_eq!(signed["signature"]["alg"], "ES256");
+    let signature = base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .decode(signed["signature"]["sig"].as_str().unwrap())
+        .unwrap();
+    assert_eq!(signature.len(), 64);
+    // Independent primitive verification prevents a self-consistent DER bug in
+    // our signer/verifier pair from masquerading as JWA compatibility.
+    UnparsedPublicKey::new(&ECDSA_P256_SHA256_FIXED, &key.public_key)
+        .verify(&serde_jcs::to_vec(&original).unwrap(), &signature)
+        .unwrap();
+    verifier(&p, key)
+        .verify_for_principal(&signed, &p)
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn es256_covers_optional_fields_scope_revision_and_replaces_only_signature() {
+    let (signer, key) = signing();
+    let p = principal();
+    let mut original = envelope();
+    original["signature"] = json!({"private":"obsolete"});
+    let signed = signer.sign(&original).unwrap();
+    let mut unsigned = signed.clone();
+    unsigned.as_object_mut().unwrap().remove("signature");
+    original.as_object_mut().unwrap().remove("signature");
+    assert_eq!(unsigned, original);
+    let v = verifier(&p, key);
+    for path in [
+        "cid",
+        "sid",
+        "connid",
+        "operation_id",
+        "in_reply_to",
+        "expected_revision",
+        "payload",
+        "optional",
+    ] {
+        let mut tampered = signed.clone();
+        tampered[path] = json!("tampered");
+        assert!(
+            matches!(
+                v.verify_for_principal(&tampered, &p).await,
+                Err(Sig9421Error::InvalidSignature)
+            ),
+            "{path}"
+        );
+    }
+    // Rejected signatures did not consume the actual original ID.
+    v.verify_for_principal(&signed, &p).await.unwrap();
+}
+
+#[tokio::test]
+async fn es256_current_key_checks_exact_owner_key_algorithm_validity_and_revocation() {
+    let (signer, key) = signing();
+    let p = principal();
+    let signed = signer.sign(&envelope()).unwrap();
+    let v = verifier(&p, key.clone());
+    for change in 0..7 {
+        let mut candidate = key.clone();
+        let mut owner = p.clone();
+        let mut id = "p256";
+        match change {
+            0 => candidate.revoked = true,
+            1 => candidate.expires_at = Some(Utc::now() - chrono::Duration::seconds(1)),
+            2 => candidate.not_before = Some(Utc::now() + chrono::Duration::minutes(1)),
+            3 => candidate.algorithm = "EdDSA".into(),
+            4 => owner.subject = "bob".into(),
+            5 => owner.issuer = Some("foreign-issuer".into()),
+            _ => id = "other-key",
+        }
+        let current = PrincipalVerificationKey::from_current(&owner, id.into(), candidate).unwrap();
+        assert!(
+            matches!(
+                v.verify_with_current_key(&signed, &p, &current).await,
+                Err(Sig9421Error::KeyRejected)
+            ),
+            "case {change}"
+        );
+    }
+    let current = PrincipalVerificationKey::from_current(&p, "p256".into(), key).unwrap();
+    v.verify_with_current_key(&signed, &p, &current)
+        .await
+        .unwrap();
+    assert!(matches!(
+        v.verify_for_principal(&signed, &p).await,
+        Err(Sig9421Error::ReplayDetected(_))
+    ));
+}
+
+#[tokio::test]
+async fn es256_wrong_subject_tenant_issuer_or_signature_algorithm_cannot_select_another_key() {
+    let (signer, key) = signing();
+    let p = principal();
+    let signed = signer.sign(&envelope()).unwrap();
+    let v = verifier(&p, key.clone());
+    for change in 0..3 {
+        let mut other = p.clone();
+        match change {
+            0 => other.subject = "bob".into(),
+            1 => other.tenant = Some("foreign".into()),
+            _ => other.issuer = Some("foreign".into()),
+        };
+        assert!(matches!(
+            v.verify_for_principal(&signed, &other).await,
+            Err(Sig9421Error::UnknownKeyid(_))
+        ));
+    }
+    let mut wrong = signed.clone();
+    wrong["signature"]["alg"] = json!("EdDSA");
+    assert!(v.verify_for_principal(&wrong, &p).await.is_err());
+    let mut unknown = signed.clone();
+    unknown["signature"]["keyid"] = json!("unknown");
+    assert!(v.verify_for_principal(&unknown, &p).await.is_err());
+    v.verify_for_principal(&signed, &p).await.unwrap();
+}
+
+#[tokio::test]
+async fn es256_resigning_or_switching_algorithms_cannot_reuse_consumed_envelope_id() {
+    let (p256, key) = signing();
+    let p = principal();
+    let rng = SystemRandom::new();
+    let doc = ring::signature::Ed25519KeyPair::generate_pkcs8(&rng).unwrap();
+    let ed_public = ring::signature::Ed25519KeyPair::from_pkcs8(doc.as_ref())
+        .unwrap()
+        .public_key()
+        .as_ref()
+        .to_vec();
+    let ed = Sig9421Signer::ed25519("ed25519", doc.as_ref()).unwrap();
+    let keys = Keys {
+        owner: p.ownership_key(),
+        keys: [
+            ("p256".into(), key),
+            (
+                "ed25519".into(),
+                ResolvedVerificationKey {
+                    public_key: ed_public,
+                    algorithm: "EdDSA".into(),
+                    not_before: None,
+                    expires_at: None,
+                    revoked: false,
+                },
+            ),
+        ]
+        .into_iter()
+        .collect(),
+    };
+    let v = Sig9421Verifier::new(Arc::new(keys));
+    let original = envelope();
+    v.verify_for_principal(&p256.sign(&original).unwrap(), &p)
+        .await
+        .unwrap();
+    assert!(matches!(
+        v.verify_for_principal(&p256.sign(&original).unwrap(), &p)
+            .await,
+        Err(Sig9421Error::ReplayDetected(_))
+    ));
+    assert!(matches!(
+        v.verify_for_principal(&ed.sign(&original).unwrap(), &p)
+            .await,
+        Err(Sig9421Error::ReplayDetected(_))
+    ));
+    v.verify_for_principal(&ed.sign(&envelope()).unwrap(), &p)
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn es256_rejects_der_truncation_padding_wrong_curve_and_stale_time_before_replay() {
+    let (signer, key, doc) = signing_with_document();
+    let p = principal();
+    let v = verifier(&p, key.clone());
+    let original = envelope();
+    let signed = signer.sign(&original).unwrap();
+    let rng = SystemRandom::new();
+    let der = EcdsaKeyPair::from_pkcs8(&ECDSA_P256_SHA256_ASN1_SIGNING, doc.as_ref(), &rng)
+        .unwrap()
+        .sign(&rng, &serde_jcs::to_vec(&original).unwrap())
+        .unwrap();
+    UnparsedPublicKey::new(&ring::signature::ECDSA_P256_SHA256_ASN1, &key.public_key)
+        .verify(&serde_jcs::to_vec(&original).unwrap(), der.as_ref())
+        .unwrap();
+    for signature in [
+        base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(der.as_ref()),
+        base64::engine::general_purpose::URL_SAFE_NO_PAD.encode([0u8; 63]),
+        format!("{}=", signed["signature"]["sig"].as_str().unwrap()),
+    ] {
+        let mut malformed = signed.clone();
+        malformed["signature"]["sig"] = json!(signature);
+        assert!(v.verify_for_principal(&malformed, &p).await.is_err());
+    }
+    let mut wrong_curve = key.clone();
+    wrong_curve.public_key = vec![4; 97];
+    assert!(verifier(&p, wrong_curve)
+        .verify_for_principal(&signed, &p)
+        .await
+        .is_err());
+    for seconds in [-301, 60] {
+        let mut old = envelope();
+        old["ts"] = json!(Utc::now() + chrono::Duration::seconds(seconds));
+        assert!(matches!(
+            v.verify_for_principal(&signer.sign(&old).unwrap(), &p)
+                .await,
+            Err(Sig9421Error::StaleTimestamp(_))
+        ));
+    }
+    v.verify_for_principal(&signed, &p).await.unwrap();
+}
+
+#[test]
+fn es256_signer_rejects_invalid_private_keys_identifiers_and_other_curves_without_disclosure() {
+    let rng = SystemRandom::new();
+    let p384 = EcdsaKeyPair::generate_pkcs8(&ECDSA_P384_SHA384_FIXED_SIGNING, &rng).unwrap();
+    assert!(matches!(
+        Sig9421Signer::es256("p256", p384.as_ref()),
+        Err(Sig9421Error::KeyRejected)
+    ));
+    let error = Sig9421Signer::es256("private-key-id", b"private-key-material").unwrap_err();
+    assert!(!format!("{error:?} {error}").contains("private-key"));
+    let doc = EcdsaKeyPair::generate_pkcs8(&ECDSA_P256_SHA256_FIXED_SIGNING, &rng).unwrap();
+    for id in ["", "bad\nkey"] {
+        assert!(Sig9421Signer::es256(id, doc.as_ref()).is_err());
+    }
+    assert!(!format!(
+        "{:?}",
+        Sig9421Signer::es256("secret-id", doc.as_ref()).unwrap()
+    )
+    .contains("secret-id"));
+}
+
+#[tokio::test]
+async fn es256_contextual_verification_and_current_key_share_the_same_atomic_replay_boundary() {
+    let (signer, key) = signing();
+    let p = principal();
+    let context = SignatureVerificationContext::new("tenant", "issuer").unwrap();
+    let mut resolver = StaticKeyResolver::new();
+    resolver.insert_contextual(&context, "p256", key.clone());
+    let v = Sig9421Verifier::new(Arc::new(resolver));
+    let signed = signer.sign(&envelope()).unwrap();
+    v.verify_with_context(&signed, &context).await.unwrap();
+    let held = PrincipalVerificationKey::from_current(&p, "p256".into(), key).unwrap();
+    assert!(matches!(
+        v.verify_with_current_key(&signed, &p, &held).await,
+        Err(Sig9421Error::ReplayDetected(_))
+    ));
+}
