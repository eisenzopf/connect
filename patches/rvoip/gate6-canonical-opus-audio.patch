diff --git a/crates/webrtc/rvoip-webrtc/src/media/core_audio_profile.rs b/crates/webrtc/rvoip-webrtc/src/media/core_audio_profile.rs
new file mode 100644
--- /dev/null
+++ b/crates/webrtc/rvoip-webrtc/src/media/core_audio_profile.rs
@@ -0,0 +1,204 @@
+//! The bounded canonical audio profile, distinct from SDP's channel capability.
+use crate::sdp::NegotiatedAudioPayload;
+use rvoip_core::{
+    capability::CodecInfo,
+    staged_streams::{ControlResult, StreamControlError as E},
+};
+
+/// Derive the actual mapping and reject packet-duration preferences outside
+/// this fixed encoder profile before any Core resources are activated.
+pub fn negotiated_profile(
+    offer: &str,
+    answer: &str,
+) -> ControlResult<(NegotiatedAudioPayload, CodecInfo)> {
+    use rvoip_sip_core::types::sdp::{ParsedAttribute, SdpSession};
+    for sdp in [offer, answer] {
+        let parsed: SdpSession = sdp.parse().map_err(|_| E::Unsupported)?;
+        let mut media = parsed
+            .media_descriptions
+            .iter()
+            .filter(|m| m.media == "audio" && m.port != 0);
+        let audio = media.next().ok_or(E::Unsupported)?;
+        if media.next().is_some() || audio.ptime.is_some_and(|p| p != 20) {
+            return Err(E::Unsupported);
+        }
+        for attr in &audio.generic_attributes {
+            if let ParsedAttribute::Ptime(ms) = attr {
+                if *ms != 20 {
+                    return Err(E::Unsupported);
+                }
+            }
+            if let ParsedAttribute::MaxPtime(ms) = attr {
+                if *ms < 20 {
+                    return Err(E::Unsupported);
+                }
+            }
+            if let ParsedAttribute::Value(name, value) = attr {
+                if name == "maxptime" && value.parse::<u32>().map_or(true, |ms| ms < 20) {
+                    return Err(E::Unsupported);
+                }
+            }
+        }
+    }
+    let mapping =
+        crate::sdp::negotiated_single_audio_payload(offer, answer).map_err(|_| E::Unsupported)?;
+    let codec = negotiated_codec(&mapping)?;
+    Ok((mapping, codec))
+}
+
+/// Validate both directional SDP parameter sets before selecting the fixed
+/// Core mono profile. RFC 7587 requires opus/48000/2 even for mono audio.
+/// The original SDP/PT remain the transport authority; this descriptor is only
+/// the supported decoded/encoded Core layout, never another negotiation.
+pub fn negotiated_codec(mapping: &NegotiatedAudioPayload) -> ControlResult<CodecInfo> {
+    for codec in [&mapping.offered_codec, &mapping.codec] {
+        wire_shape(&codec.name, codec.clock_rate_hz, u16::from(codec.channels))?;
+        if codec.name == "opus" {
+            opus_parameters(codec.fmtp.as_deref())?;
+        } else if codec.fmtp.as_ref().is_some_and(|p| !p.is_empty()) {
+            return Err(E::Unsupported);
+        }
+    }
+    let mut codec = mapping.codec.clone();
+    codec.channels = 1;
+    // The fixed Core profile uses 20 ms / 32 kbit/s mono Opus, no DTX or
+    // constant bitrate requirement. Only SDP preferences it can meet enter.
+    codec.fmtp = None;
+    Ok(codec)
+}
+
+pub(crate) fn wire_shape(name: &str, rate: u32, channels: u16) -> ControlResult<()> {
+    match name.to_ascii_lowercase().as_str() {
+        "opus" | "audio/opus" if rate == 48000 && channels == 2 => Ok(()),
+        "pcmu" | "g.711-mu" | "audio/pcmu" | "pcma" | "g.711-a" | "audio/pcma"
+            if rate == 8000 && channels == 1 =>
+        {
+            Ok(())
+        }
+        _ => Err(E::Unsupported),
+    }
+}
+
+fn opus_parameters(fmtp: Option<&str>) -> ControlResult<()> {
+    let mut seen = std::collections::BTreeSet::new();
+    for parameter in fmtp
+        .unwrap_or_default()
+        .split(';')
+        .filter(|p| !p.trim().is_empty())
+    {
+        let (name, value) = parameter.trim().split_once('=').ok_or(E::Unsupported)?;
+        let name = name.trim().to_ascii_lowercase();
+        if !seen.insert(name.clone()) {
+            return Err(E::Unsupported);
+        }
+        let value = value.trim().parse::<u32>().map_err(|_| E::Unsupported)?;
+        let supported = match name.as_str() {
+            "stereo" | "sprop-stereo" | "cbr" => value == 0,
+            "useinbandfec" | "usedtx" => value <= 1,
+            "minptime" => (1..=20).contains(&value),
+            "maxaveragebitrate" => (32000..=510000).contains(&value),
+            "maxplaybackrate" => value == 48000,
+            "sprop-maxcapturerate" => (8000..=48000).contains(&value),
+            _ => false,
+        };
+        if !supported {
+            return Err(E::Unsupported);
+        }
+    }
+    Ok(())
+}
+
+/// This first profile admits one 20 ms mono frame per packet. Inspect Opus's
+/// TOC, never estimate its duration from its variable encoded byte count.
+/// Longer/multi-frame/stereo packets need a separately supported profile.
+pub(crate) fn packet_samples(rate: u32, bytes: &[u8]) -> ControlResult<u32> {
+    if bytes.is_empty() || bytes.len() > 1600 {
+        return Err(E::NotReady);
+    }
+    if rate == 8000 {
+        return Ok(bytes.len() as u32);
+    }
+    if rate != 48000 || bytes.len() < 2 || bytes.len() > 1276 || bytes[0] & 7 != 0 {
+        return Err(E::NotReady);
+    }
+    let config = bytes[0] >> 3;
+    let twenty_ms = match config {
+        0..=11 => config & 3 == 1,
+        12..=15 => config & 1 == 1,
+        _ => config & 3 == 3,
+    };
+    if twenty_ms {
+        Ok(960)
+    } else {
+        Err(E::NotReady)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn mono_opus_retains_wire_mapping_and_rejects_unmet_directional_parameters() {
+        let mut wire = CodecInfo::from_name_with_defaults("opus");
+        wire.channels = 2;
+        wire.fmtp = Some("minptime=10;useinbandfec=1".into());
+        let mut mapping = NegotiatedAudioPayload {
+            codec: wire.clone(),
+            offered_codec: wire,
+            payload_type: 103,
+        };
+        let core = negotiated_codec(&mapping).unwrap();
+        assert_eq!(
+            (core.channels, core.clock_rate_hz, core.fmtp),
+            (1, 48000, None)
+        );
+        assert_eq!((mapping.codec.channels, mapping.payload_type), (2, 103));
+        for bad in [
+            "stereo=1",
+            "maxaveragebitrate=16000",
+            "cbr=1",
+            "minptime=40",
+            "usedtx=2",
+            "stereo=0;stereo=1",
+        ] {
+            mapping.offered_codec.fmtp = Some(bad.into());
+            assert!(negotiated_codec(&mapping).is_err(), "{bad}");
+        }
+        mapping.offered_codec.fmtp = None;
+        mapping.codec.channels = 1;
+        assert!(negotiated_codec(&mapping).is_err());
+    }
+
+    #[test]
+    fn packet_duration_limits_are_checked_before_canonical_admission() {
+        let sdp = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nc=IN IP4 127.0.0.1\r\nm=audio 9 UDP/TLS/RTP/SAVPF 103\r\na=rtpmap:103 opus/48000/2\r\n";
+        let answer = format!("{sdp}a=ptime:20\r\na=maxptime:20\r\n");
+        assert_eq!(
+            negotiated_profile(sdp, &answer).unwrap().0.payload_type,
+            103
+        );
+        for bound in ["a=maxptime:10\r\n", "a=ptime:40\r\n"] {
+            assert!(negotiated_profile(&format!("{sdp}{bound}"), &answer).is_err());
+            assert!(negotiated_profile(sdp, &format!("{sdp}{bound}")).is_err());
+        }
+    }
+
+    #[test]
+    fn opus_timestamp_duration_is_independent_of_compressed_packet_size() {
+        for bytes in [vec![0xf8, 0xff, 0xfe], vec![0x08; 80], vec![0x98; 140]] {
+            assert_eq!(packet_samples(48000, &bytes).unwrap(), 960);
+        }
+        for bytes in [
+            vec![],
+            vec![0xf8],
+            vec![0xfc, 0xff],
+            vec![0xf9, 0xff],
+            vec![0xf0, 0xff],
+            vec![0xf8; 1277],
+        ] {
+            assert!(packet_samples(48000, &bytes).is_err());
+        }
+        assert_eq!(packet_samples(8000, &[0x80; 160]).unwrap(), 160);
+    }
+}
