+#[tokio::test(flavor = "current_thread")]
+async fn rtc_video_input_budget_covers_normalized_and_in_order_source_turns() {
+    use futures::FutureExt as _;
+    for large in [false, true] {
+        let mut f = Fixture::new(Medium::Video).await;
+        let ports = Arc::new(DashMap::new());
+        let mut owner = BurstPortOwner::new(&f, &ports);
+        let work = std::panic::AssertUnwindSafe(async {
+            assert_eq!(input_capacity(Medium::Audio), 10);
+            assert_eq!(VIDEO_INPUT_CAPACITY + 1, 141);
+            fill_original_video_input(&f, &owner.io, 10).await;
+            let (ready, _ready_observation) = watch::channel(None);
+            let stop = CancellationToken::new();
+            let mut mapper = crate::media::video_normalize::SequenceMapper::default();
+            let expected = if large {
+                let (output, expected) = actual_reordered_burst(&f, true);
+                assert_eq!(expected.len(), 130);
+                publish_video(output, &mut mapper, &f.source, &ports, &ready, &stop);
+                expected
+            } else {
+                //65 INDEPENDENT in-order releases before any consumer poll.
+                let at = Instant::now();
+                let mut reorder = crate::media::video_reorder::PacketReorder::default();
+                let mut expected = Vec::new();
+                for sequence in 10..75 {
+                    let output =
+                        reorder.push(original_video_packet(&f, sequence, 90000, at, false), at);
+                    assert_eq!(output.packets.len(), 1);
+                    expected.push(output.packets[0].packet.marshal().unwrap().freeze());
+                    publish_video(output, &mut mapper, &f.source, &ports, &ready, &stop);
+                }
+                expected
+            };
+            assert_eq!(
+                owner.io.input.capacity(),
+                VIDEO_INPUT_CAPACITY - 10 - expected.len()
+            );
+            assert_eq!(owner.io.input_refused.load(Ordering::Acquire), 0);
+            assert!(f.policy.guard.clone().try_write_owned().is_ok());
+            assert!(
+                expected
+                    .iter()
+                    .all(|bytes| bytes.len() <= rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES)
+            );
+            f.policy.mode.store(0, Ordering::SeqCst);
+            let frames = f.delivered(11 + expected.len()).await;
+            let originals: Vec<_> = frames
+                .iter()
+                .filter(|frame| frame.timestamp_rtp == 90000)
+                .collect();
+            let exact = originals.len() == expected.len()
+                && originals
+                    .iter()
+                    .zip(&expected)
+                    .all(|(actual, bytes)| actual.payload == *bytes);
+            (exact, frames.len(), expected.len())
+        })
+        .catch_unwind()
+        .await;
+        let clean = owner.close(&f).await;
+        let empty = ports.is_empty();
+        assert!(clean && empty, "original positive owners did not join");
+        let facts = match work {
+            Ok(value) => value,
+            Err(error) => std::panic::resume_unwind(error),
+        };
+        assert!(
+            facts.0 && facts.1 == 11 + facts.2,
+            "original normalized/inorder loss/order large={large}"
+        );
+    }
+}
