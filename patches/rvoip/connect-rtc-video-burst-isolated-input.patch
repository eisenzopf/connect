+        )
+        .unwrap();
+        let physical = WebRtcPhysicalBinding::new(&owner.peer(), lifetime.child_token());
+        // EXACT same private channel constructor as Backend.prepare_port.
+        let (input, receive) = input_channel(Medium::Video);
+        let io = Arc::new(PortIo {
+            port: f.port.downgrade(),
+            binding: f.port.binding().clone(),
+            physical,
+            health: WorkerHealth::new(lifetime.child_token()),
+            input,
+            input_refused: AtomicU64::new(0),
+            close: OnceLock::new(),
+            map: Arc::downgrade(ports),
+        });
+        io.start(ingress(
+            io.port.clone(),
+            io.health.stop.clone(),
+            receive,
+            f.source.clone(),
+        ))
+        .unwrap();
+        {
+            let setup = io.health.setup.lock().unwrap();
+            io.health.activate(&setup).unwrap();
+        }
+        ports.insert(io.binding.transport_id.clone(), io.clone());
+        Self {
+            io,
+            lifetime,
+            peer_owner: Some(owner),
+        }
+    }
+    async fn close(&mut self, f: &Fixture) -> bool {
+        let closed = self.io.close().await.is_ok();
+        let joined = self.io.health.setup.lock().unwrap().tasks.is_empty();
+        let input_closed = self.io.input.is_closed();
+        let a = f.a.shutdown(deadline()).await;
+        let b = f.b.shutdown(deadline()).await;
+        let reader_free = f.policy.guard.clone().try_write_owned().is_ok();
+        let peer = self.peer_owner.as_ref().unwrap().peer();
+        self.lifetime.cancel();
+        drop(self.peer_owner.take());
+        closed && joined && input_closed && a == 0 && b == 0 && reader_free && peer.is_closed()
+    }
+}
+fn original_video_packet(
+    f: &Fixture,
+    sequence: u16,
+    timestamp: u32,
+    at: Instant,
+    large: bool,
+) -> crate::media::video_reorder::ReceivedPacket {
+    let mut original = f.packet(sequence, timestamp);
+    if large {
+        let mut payload = vec![0x10];
+        payload.extend((0..1499).map(|n| (n as u16 + sequence) as u8));
+        original.packet.payload = payload.into();
+    }
+    let mut received = crate::media::video_reorder::ReceivedPacket::new(original.packet, at);
+    received.source_clock = original.original_video_clock;
+    received
+}
+fn actual_reordered_burst(
+    f: &Fixture,
+    large: bool,
+) -> (crate::media::video_reorder::ReorderOutput, Vec<Bytes>) {
+    use crate::media::video_reorder::PacketReorder;
+    let at = Instant::now();
+    let mut reorder = PacketReorder::default();
+    assert_eq!(
+        reorder
+            .push(original_video_packet(f, 10, 90000, at, large), at)
+            .packets
+            .len(),
+        1
+    );
+    for sequence in 12..=75 {
+        assert!(
+            reorder
+                .push(original_video_packet(f, sequence, 90000, at, large), at)
+                .packets
+                .is_empty()
+        );
+    }
+    let output = reorder.push(original_video_packet(f, 11, 90000, at, large), at);
+    assert_eq!(output.packets.len(), 65);
+    let mut expected_mapper = crate::media::video_normalize::SequenceMapper::default();
+    let expected = output
+        .packets
+        .iter()
+        .flat_map(|received| {
+            crate::media::video_normalize::normalize(received.packet.clone(), &mut expected_mapper)
+                .unwrap()
+        })
+        .map(|packet| packet.marshal().unwrap().freeze())
+        .collect();
+    (output, expected)
+}
+async fn fill_original_video_input(f: &Fixture, io: &PortIo, queued: usize) -> Instant {
+    f.policy.mode.store(1, Ordering::SeqCst);
+    let first = f.packet(400, 1000);
+    let at = first.at;
+    io.input.send(first).await.unwrap();
+    f.wait_attempt(0).await;
+    for n in 0..queued {
+        io.input
+            .try_send(f.packet(401 + n as u16, 2000 + n as u32))
+            .unwrap();
+    }
+    assert_eq!(io.input.capacity(), VIDEO_INPUT_CAPACITY - queued);
+    at
+}
