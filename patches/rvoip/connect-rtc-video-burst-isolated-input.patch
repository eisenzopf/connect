+#[tokio::test(flavor = "current_thread")]
+async fn rtc_video_budget_preserves_age_stop_clock_and_current_gate() {
+    use futures::FutureExt as _;
+    for action in ["age", "stop", "withdrawal", "clock", "gate", "mixed-expiry"] {
+        let mut f = Fixture::new(Medium::Video).await;
+        let ports = Arc::new(DashMap::new());
+        let mut owner = BurstPortOwner::new(&f, &ports);
+        let work = std::panic::AssertUnwindSafe(async {
+            fill_original_video_input(&f, &owner.io, 0).await;
+            let (ready, _ready_observation) = watch::channel(None);
+            let stop = CancellationToken::new();
+            let (burst, mixed_expected) = if action == "mixed-expiry" {
+                // Actual monotonic wait, after controller/port activation: old12
+                // expires, then SAME push also releases genuinely fresh13.
+                let mut reorder = crate::media::video_reorder::PacketReorder::default();
+                let old = Instant::now();
+                assert_eq!(
+                    reorder
+                        .push(original_video_packet(&f, 10, 90000, old, false), old)
+                        .packets
+                        .len(),
+                    1
+                );
+                assert!(
+                    reorder
+                        .push(original_video_packet(&f, 12, 90000, old, false), old)
+                        .packets
+                        .is_empty()
+                );
+                tokio::time::sleep(Duration::from_millis(215)).await;
+                let now = Instant::now();
+                let fresh = original_video_packet(&f, 13, 90000, now, false);
+                let expected = fresh.packet.marshal().unwrap().freeze();
+                let output = reorder.push(fresh, now);
+                assert_eq!(
+                    output
+                        .packets
+                        .iter()
+                        .map(|r| r.packet.header.sequence_number)
+                        .collect::<Vec<_>>(),
+                    [12, 13]
+                );
+                assert!(output.packets[0].inserted.elapsed() >= Duration::from_millis(200));
+                assert_eq!(output.packets[1].inserted, now);
+                (output, Some(expected))
+            } else {
+                (actual_reordered_burst(&f, false).0, None)
+            };
+            let mut mapper = crate::media::video_normalize::SequenceMapper::default();
+            if action == "withdrawal" {
+                ports.remove(&owner.io.binding.transport_id);
+            }
+            let source_refused_before = f.source.refused.load(Ordering::Acquire);
+            publish_video(burst, &mut mapper, &f.source, &ports, &ready, &stop);
+            let mixed_refusal = action != "mixed-expiry"
+                || f.source.refused.load(Ordering::Acquire) == source_refused_before + 1;
+            if action == "age" {
+                tokio::time::sleep(Duration::from_millis(215)).await;
+            }
+            if action == "stop" {
+                owner.io.health.retire();
+            }
+            if action == "clock" {
+                f.clock.cname(77, b"successor-burst-clock");
+                assert!(f.clock.sender_report(77, 11 << 32, 90000, 2, 101 << 32));
+                assert!(f.source.lease.capture(77).is_some());
+            }
+            if action == "gate" {
+                let ids = [desired(Medium::Video).logical_id].into_iter().collect();
+                for change in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                    f.a.set_media_gate(f.a.revision(), &ids, change, deadline())
+                        .await
+                        .unwrap();
+                }
+            }
+            f.policy.mode.store(0, Ordering::SeqCst);
+            let frames = f
+                .delivered(if action == "withdrawal" { 1 } else { 66 })
+                .await;
+            let originals: Vec<_> = frames
+                .iter()
+                .filter(|frame| frame.timestamp_rtp == 90000)
+                .collect();
+            let original_count = originals.len();
+            let mixed_exact = mixed_expected
+                .as_ref()
+                .is_none_or(|bytes| originals.len() == 1 && originals[0].payload == *bytes);
+            let fresh_ok = if ["age", "clock", "gate"].contains(&action) {
+                let at = Instant::now();
+                let mut output = crate::media::video_reorder::ReorderOutput::default();
+                output
+                    .packets
+                    .push(original_video_packet(&f, 2000, 180000, at, false));
+                publish_video(
+                    output,
+                    &mut mapper,
+                    &f.source,
+                    &ports,
+                    &ready,
+                    &CancellationToken::new(),
+                );
+                timestamps(&f.delivered(1).await) == [180000]
+            } else {
+                true
+            };
+            (original_count, fresh_ok, mixed_refusal && mixed_exact)
+        })
+        .catch_unwind()
+        .await;
+        let clean = owner.close(&f).await;
+        let empty = ports.is_empty();
+        assert!(clean && empty, "original negative owners failed: {action}");
+        let facts = match work {
+            Ok(value) => value,
+            Err(error) => std::panic::resume_unwind(error),
+        };
+        assert_eq!(
+            facts.0,
+            if action == "mixed-expiry" { 1 } else { 0 },
+            "expired/old-epoch relabelled, or fresh original discarded: {action}"
+        );
+        assert!(
+            facts.1 && facts.2,
+            "fresh current/mixed-expiry bytes/accounting failed after {action}"
+        );
+    }
+}
