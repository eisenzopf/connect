+#[tokio::test(flavor = "current_thread")]
+async fn rtc_publisher_primitive_isolates_full_target_and_later_source_turn() {
+    use futures::FutureExt as _;
+    // Composed publisher primitive: two real independently guarded Core ports,
+    // NOT a claim canonical whole-ticket validation permits steady twoRx.
+    let mut blocked = Fixture::new(Medium::Video).await;
+    let mut healthy = Fixture::new(Medium::Video).await;
+    let ports = Arc::new(DashMap::new());
+    let mut blocked_owner = BurstPortOwner::new(&blocked, &ports);
+    let mut healthy_owner = BurstPortOwner::new(&healthy, &ports);
+    let work = std::panic::AssertUnwindSafe(async {
+        assert_ne!(
+            blocked_owner.io.binding.transport_id, healthy_owner.io.binding.transport_id,
+            "two distinct actual source port resources required"
+        );
+        let blocked_at =
+            fill_original_video_input(&blocked, &blocked_owner.io, VIDEO_INPUT_CAPACITY).await;
+        let (ready, _ready_observation) = watch::channel(None);
+        let stop = CancellationToken::new();
+        let mut mapper = crate::media::video_normalize::SequenceMapper::default();
+        let (burst, mut expected) = actual_reordered_burst(&healthy, false);
+        publish_video(burst, &mut mapper, &healthy.source, &ports, &ready, &stop);
+        // A LATER source-loop turn must run while the blocked target stays full.
+        let at = Instant::now();
+        let later = original_video_packet(&healthy, 90, 180000, at, false);
+        let mut output = crate::media::video_reorder::ReorderOutput::default();
+        let mut expected_mapper = crate::media::video_normalize::SequenceMapper::default();
+        expected.push(
+            crate::media::video_normalize::normalize(later.packet.clone(), &mut expected_mapper)
+                .unwrap()[0]
+                .marshal()
+                .unwrap()
+                .freeze(),
+        );
+        // Mapper90 preserves the actual source gap after original75.
+        output.packets.push(later);
+        publish_video(output, &mut mapper, &healthy.source, &ports, &ready, &stop);
+        let frames = healthy.delivered(66).await;
+        let before_release = blocked.policy.mode.load(Ordering::SeqCst) == 1
+            && blocked_owner.io.input.capacity() == 0
+            && blocked_at.elapsed() < Duration::from_millis(200);
+        let exact = frames.len() == 66
+            && frames
+                .iter()
+                .zip(&expected)
+                .all(|(actual, bytes)| actual.payload == *bytes);
+        let later_seen = frames
+            .last()
+            .is_some_and(|frame| frame.timestamp_rtp == 180000);
+        let blocked_refused = blocked_owner.io.input_refused.load(Ordering::Acquire);
+        blocked.policy.mode.store(0, Ordering::SeqCst);
+        let prior = blocked.delivered(VIDEO_INPUT_CAPACITY + 1).await;
+        (
+            before_release,
+            exact,
+            later_seen,
+            blocked_refused,
+            prior.len(),
+        )
+    })
+    .catch_unwind()
+    .await;
+    let blocked_clean = blocked_owner.close(&blocked).await;
+    let healthy_clean = healthy_owner.close(&healthy).await;
+    let empty = ports.is_empty();
+    assert!(
+        blocked_clean && healthy_clean && empty,
+        "original fanout owners did not join"
+    );
+    let facts = match work {
+        Ok(value) => value,
+        Err(error) => std::panic::resume_unwind(error),
+    };
+    assert!(
+        facts.0 && facts.1 && facts.2 && facts.3 == 66 && facts.4 == VIDEO_INPUT_CAPACITY + 1,
+        "full target stopped healthy burst or later source turn: {facts:?}"
+    );
+}
