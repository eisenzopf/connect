 }
+
+#[test]
+fn owned_input_mute_needs_no_output_grant_but_cannot_reopen_output() {
+    let f = Fixture::new();
+    let mut state = initial(&f);
+    let id = StreamId::from_string("audio");
+    let ids = [id.clone()].into_iter().collect();
+    let before = state.streams()[&id].clone();
+    let mut closing = f.authority();
+    closing.send_media.clear();
+    state.set_gates(&closing, 1, &ids, StreamGateAction::Mute).unwrap();
+    let muted = &state.streams()[&id];
+    assert!(muted.source_muted && !muted.permits(false));
+    assert_eq!(muted.transport_id, before.transport_id);
+    assert_eq!(muted.stream_local_id, before.stream_local_id);
+    assert_eq!(muted.generation, before.generation);
+    assert_eq!(state.revision(), 2);
+    assert_eq!(state.set_gates(&closing, 2, &ids, StreamGateAction::Unmute), Err(MediaTransitionError::Authority));
+    assert!(state.streams()[&id].source_muted);
+    assert_eq!(state.revision(), 2);
+    closing.may_negotiate = false;
+    assert_eq!(state.set_gates(&closing, 2, &ids, StreamGateAction::Mute), Err(MediaTransitionError::Authority));
+    state.set_gates(&f.authority(), 2, &ids, StreamGateAction::Unmute).unwrap();
+    assert!(!state.streams()[&id].source_muted);
+}
