+        let request=InitialVideoPictureRequest {original:self,source:AdapterMediaPort(source_port),descriptor:scope.source().clone(),deadline,cancel:cancel.clone()};
+        let warm=PublicVideoWarmStart {original:self,target:AdapterMediaPort(target_port),scope:scope.clone(),deadline,cancel};
+        let result=tokio::select! {biased;
+            _=audio_consumer::any_cancelled(tokens)=>Err(StreamControlError::Cancelled),
+            value=tokio::time::timeout_at(deadline,async {
+                if !request.is_current() {return Err(StreamControlError::NotReady);}
+                // Consume BEFORE constructing/polling adapter IO. A dropped,
+                // failed or uncertain callback can never be repeated as new.
+                attempted.compare_exchange(false,true,Ordering::AcqRel,Ordering::Acquire)
+                    .map_err(|_|StreamControlError::NotReady)?;
+                if start {
+                    callback_adapter.start_public_video_warm(&warm).await?;
+                    scope.owner.upgrade().ok_or(StreamControlError::Cancelled)?.started.store(true,Ordering::Release);
+                    Ok(())
+                }
+                else {callback_adapter.request_initial_video_picture(&request).await}
+            })=>value.map_err(|_|StreamControlError::Deadline)?,
+        };
+        // select!/timeout destroys the actual borrowed callback future before
+        // any fresh policy Reader or original delivery guard is released.
+        drop(admitted);
+        result
+    }
+}
