+//! Flat canonical accepted-native writer inventory. Metadata never grants IO.
+//! New families invalidate pending freezes. Retired/quarantined records remain
+//! until Core confirms its actual original cleanup joins; no history chain.
+use super::*;
+use super::super::physical_video_exposure::{PhysicalVideoExposureCoverage,PhysicalVideoExposureSeal,PhysicalVideoSealWitness};
+
+/// Trusted adapter setup only. This constructor does not establish native
+/// provenance: canonical UCTP alone supplies its original accepted-driver root.
+/// Generic external IO must not opt in; custom adapters need their own proof.
+struct PendingFamily {port:Weak<Port>,claim:Weak<()>}
+#[derive(Default)]
+struct Inventory {live:BTreeMap<u128,Arc<Cursor>>,pending:BTreeMap<StreamId,PendingFamily>}
+/// Cold exact batch reservation, never an IO or authority owner. Drop removes
+/// only this claim's never-writable pending entries; live history remains.
+pub struct NativeVideoRegistrationBatch {domain:Weak<NativeVideoPhysicalDomain>,claim:Arc<()>,keys:Vec<StreamId>}
+impl Drop for NativeVideoRegistrationBatch {
+    fn drop(&mut self) {if let Some(domain)=self.domain.upgrade(){if let Ok(mut inventory)=domain.families.lock(){inventory.pending.retain(|key,entry|!self.keys.contains(key)||!Weak::ptr_eq(&entry.claim,&Arc::downgrade(&self.claim)));}else{domain.unknown();}}}
+}
+/// Strict original freeze owns this once, independent of packet admission.
+/// It only excludes NEW visual registration; it cannot pause/resume/grant IO.
+pub(crate) struct NativeInventoryPin {domain:Arc<NativeVideoPhysicalDomain>,claim:u64,before:NativeFrozenPhysicalWitness}
+impl NativeInventoryPin {
+    pub(crate) fn before(&self)->NativeFrozenPhysicalWitness {self.before.clone()}
+    pub(crate) fn capture(&self,ports:&[Arc<Port>],seal:&PhysicalVideoExposureSeal,realm:u128)->ControlResult<NativeFrozenPhysicalWitness> {self.domain.capture(ports,seal,realm,Some(self.claim))}
+}
+impl Drop for NativeInventoryPin {fn drop(&mut self){let _=self.domain.pin.compare_exchange(self.claim,0,Ordering::AcqRel,Ordering::Acquire);}}
+pub struct NativeVideoPhysicalDomain {
+    pub(super) coverage:Arc<PhysicalVideoExposureCoverage>,
+    pub(super) realm:std::sync::OnceLock<u128>,pub(super) unknown:AtomicBool,
+    inventory:AtomicU64,io:AtomicU64,maximum:AtomicU64,inherited:AtomicU64,
+    families:Mutex<Inventory>,pin:AtomicU64,next_pin:AtomicU64,
+}
+impl NativeVideoPhysicalDomain {
+    pub fn new(coverage:Arc<PhysicalVideoExposureCoverage>)->Arc<Self> {
+        Arc::new(Self {coverage,realm:std::sync::OnceLock::new(),unknown:AtomicBool::new(false),
+            inventory:AtomicU64::new(0),io:AtomicU64::new(0),maximum:AtomicU64::new(0),inherited:AtomicU64::new(0),families:Mutex::new(Inventory::default()),pin:AtomicU64::new(0),next_pin:AtomicU64::new(1)})
+    }
+    pub(super) fn unknown(&self) {if !self.unknown.load(Ordering::Relaxed){self.unknown.store(true,Ordering::Release);}}
+    fn advance(&self,value:&AtomicU64) {
+        // Exhaustion changes only proof availability; ordinary IO continues.
+        if value.fetch_update(Ordering::AcqRel,Ordering::Acquire,|old|old.checked_add(1)).is_err() {self.unknown();}
+    }
+    pub(super) fn configure_realm(&self,value:Option<u128>) {
+        let Some(value)=value.filter(|v|*v!=0) else {self.unknown();return;};
+        if self.realm.get().is_some_and(|old|*old!=value) {self.unknown();return;}
+        if let Err(value)=self.realm.set(value) {if self.realm.get()!=Some(&value){self.unknown();}}
+    }
+    pub(super) fn record(&self,point:Option<SourceFrameRealmPoint>) {
+        // No registry/policy mutex or SQL on the native packet/repair path.
+        // This serial counts potential attempts, including definite failures.
+        self.advance(&self.io);
+        let Some(point)=point.filter(|p|self.realm.get()==Some(&p.incarnation())&&p.ordinal()!=0) else {self.unknown();return;};
+        if point.ordinal()>self.maximum.load(Ordering::Relaxed) {self.maximum.fetch_max(point.ordinal(),Ordering::AcqRel);}
+    }
+    fn prune_joined(&self,entries:&mut BTreeMap<u128,Arc<Cursor>>) {
+        entries.retain(|_,cursor| {
+            if !cursor.cleanup_joined.load(Ordering::Acquire)||cursor.live.load(Ordering::Acquire) {return true;}
+            if let Some(video)=&cursor.video {
+                // The exact Core successful cleanup transition is after all
+                // original guards and the adapter's actual shared task join.
+                // A failed/unconfirmed join never reaches this branch.
+                let Some(snapshot)=video.exposure.observer().snapshot() else {self.unknown();return true;};
+                if video.observed.load(Ordering::Acquire)||snapshot.inherited_potential_ordinal!=0 {
+                    if video.unknown.load(Ordering::Acquire)||snapshot.realm_incarnation!=self.realm.get().copied() {self.unknown();}
+                    self.maximum.fetch_max(snapshot.maximum_potential_ordinal,Ordering::AcqRel);
+                    self.inherited.fetch_max(snapshot.inherited_potential_ordinal,Ordering::AcqRel);
+                }
+            }
+            false
+        });
+    }
+    pub fn reserve_visual_registration(self:&Arc<Self>,ports:&[PortPreparation])->ControlResult<NativeVideoRegistrationBatch> {
+        let ports=ports.iter().filter(|p|p.is_new&&p.port.binding().sink_ready&&matches!(p.port.binding().negotiated.requested.medium,Medium::Video|Medium::Screen)).map(|p|p.port.0.clone()).collect::<Vec<_>>();
+        let claim=Arc::new(());let keys=ports.iter().map(|p|p.binding.transport_id.clone()).collect::<Vec<_>>();
+        if ports.is_empty(){return Ok(NativeVideoRegistrationBatch {domain:Arc::downgrade(self),claim,keys});}
+        let mut inventory=self.families.try_lock().map_err(metadata_lock_error)?;
+        if self.pin.load(Ordering::Acquire)!=0 {return Err(StreamControlError::NotReady);}
+        self.prune_joined(&mut inventory.live);
+        let mut unique=BTreeSet::new();
+        for port in &ports {
+            let key=&port.binding.transport_id;
+            if !unique.insert(key.clone())||inventory.pending.contains_key(key)||inventory.live.values().any(|cursor|&cursor.identity.transport==key) {return Err(StreamControlError::Authority);}
+        }
+        for port in ports {inventory.pending.insert(port.binding.transport_id.clone(),PendingFamily {port:Arc::downgrade(&port),claim:Arc::downgrade(&claim)});}
+        self.advance(&self.inventory);
+        Ok(NativeVideoRegistrationBatch {domain:Arc::downgrade(self),claim,keys})
+    }
+    pub(super) fn register(self:&Arc<Self>,cursor:Arc<Cursor>)->ControlResult<()> {
+        let mut inventory=self.families.lock().map_err(|_|StreamControlError::Authority)?;
+        if self.pin.load(Ordering::Acquire)!=0 {return Err(StreamControlError::NotReady);}
+        let port=cursor.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let pending=inventory.pending.get(&cursor.identity.transport).ok_or(StreamControlError::Authority)?;
+        if pending.claim.strong_count()==0||!Weak::ptr_eq(&pending.port,&Arc::downgrade(&port)) {return Err(StreamControlError::Authority);}
+        if inventory.live.contains_key(&cursor.identity.incarnation){self.unknown();return Err(StreamControlError::Authority);}
+        inventory.pending.remove(&cursor.identity.transport);
+        inventory.live.insert(cursor.identity.incarnation,cursor);
+        // Reservation already advanced inventory under this SAME exclusion.
+        Ok(())
+    }
+    fn pin(self:&Arc<Self>,ports:&[Arc<Port>],seal:&PhysicalVideoExposureSeal,realm:u128)->ControlResult<NativeInventoryPin> {
+        let mut inventory=self.families.try_lock().map_err(metadata_lock_error)?;
+        if self.pin.load(Ordering::Acquire)!=0||!inventory.pending.is_empty(){return Err(StreamControlError::NotReady);}
+        // Validate complete OLD set before claiming anything; known capability
+        // refusal is effect-free and does not pause existing media.
+        let _before=self.capture_locked(&mut inventory,ports,seal,realm,None)?;
+        let claim=self.next_pin.fetch_update(Ordering::AcqRel,Ordering::Acquire,|n|n.checked_add(1)).map_err(|_|{self.unknown();StreamControlError::Unsupported})?;
+        self.pin.store(claim,Ordering::Release);
+        let mut owner=NativeInventoryPin {domain:self.clone(),claim,before:_before};
+        // On any refusal/unwind, exact own claim is released. No IO pause or
+        // raw seal is released here; those have separate original owners.
+        owner.before=self.capture_locked(&mut inventory,ports,seal,realm,Some(claim))?;
+        Ok(owner)
+    }
+    fn capture(self:&Arc<Self>,ports:&[Arc<Port>],seal:&PhysicalVideoExposureSeal,realm:u128,claim:Option<u64>)->ControlResult<NativeFrozenPhysicalWitness> {
+        let mut inventory=self.families.try_lock().map_err(metadata_lock_error)?;
+        self.capture_locked(&mut inventory,ports,seal,realm,claim)
+    }
+    fn capture_locked(self:&Arc<Self>,inventory:&mut Inventory,ports:&[Arc<Port>],seal:&PhysicalVideoExposureSeal,realm:u128,claim:Option<u64>)->ControlResult<NativeFrozenPhysicalWitness> {
+        if self.pin.load(Ordering::Acquire)!=claim.unwrap_or(0)||!inventory.pending.is_empty(){return Err(StreamControlError::NotReady);}
+        if !seal.covers(&self.coverage)||self.unknown.load(Ordering::Acquire)||self.realm.get()!=Some(&realm) {return Err(StreamControlError::Unsupported);}
+        self.prune_joined(&mut inventory.live);
+        let entries=&inventory.live;
+        let epoch=self.inventory.load(Ordering::Acquire);
+        // Unresolved retired/quarantined/missing/foreign-controller families
+        // refuse BEFORE pause. Cleanup must run outside FreezeVideo Readers.
+        if entries.len()!=ports.len() {return Err(StreamControlError::Unsupported);}
+        for cursor in entries.values() {
+            let port=cursor.owner.upgrade().ok_or(StreamControlError::Unsupported)?;
+            if !ports.iter().any(|same|Arc::ptr_eq(same,&port))||!cursor.live.load(Ordering::Acquire)
+                ||cursor.cleanup_joined.load(Ordering::Acquire) {return Err(StreamControlError::Unsupported);}
+            let video=cursor.video.as_ref().ok_or(StreamControlError::Unsupported)?;
+            let snapshot=video.exposure.observer().snapshot_sealed(seal).ok_or(StreamControlError::Unsupported)?;
+            if video.expected.get()!=Some(&realm)||video.unknown.load(Ordering::Acquire)||!snapshot.coverage_complete {return Err(StreamControlError::Unsupported);}
+            self.maximum.fetch_max(snapshot.maximum_potential_ordinal,Ordering::AcqRel);
+            self.inherited.fetch_max(snapshot.inherited_potential_ordinal,Ordering::AcqRel);
+        }
+        let witness=NativeFrozenPhysicalWitness {domain:Arc::downgrade(self),claim,epoch,io:self.io.load(Ordering::Acquire),realm,
+            maximum:self.maximum.load(Ordering::Acquire).max(self.inherited.load(Ordering::Acquire)),seal:seal.witness()};
+        if !witness.is_current() {return Err(StreamControlError::NotReady);}
+        Ok(witness)
+    }
+}
+/// Pending-original freeze only. This is not retained as a public media
+/// permission after publication; ordinary current authorization owns that phase.
+#[derive(Clone)]
+pub(crate) struct NativeFrozenPhysicalWitness {
+    domain:Weak<NativeVideoPhysicalDomain>,claim:Option<u64>,epoch:u64,io:u64,realm:u128,maximum:u64,seal:PhysicalVideoSealWitness,
+}
+impl NativeFrozenPhysicalWitness {
+    pub(crate) fn is_current(&self)->bool {
+        self.seal.is_current()&&self.domain.upgrade().is_some_and(|root|!root.unknown.load(Ordering::Acquire)
+            &&root.pin.load(Ordering::Acquire)==self.claim.unwrap_or(0)&&root.realm.get()==Some(&self.realm)&&root.inventory.load(Ordering::Acquire)==self.epoch
+            &&root.io.load(Ordering::Acquire)==self.io&&root.maximum.load(Ordering::Acquire)<=self.maximum
+            &&root.inherited.load(Ordering::Acquire)<=self.maximum)
+    }
+    pub(crate) fn ordinal(&self)->u64 {self.maximum}
+    pub(crate) fn same_inventory(&self,other:&Self)->bool {Weak::ptr_eq(&self.domain,&other.domain)&&self.claim==other.claim&&self.epoch==other.epoch&&self.realm==other.realm}
+}
+/// RTC remains unchanged (None). A native partial/generic/mixed domain refuses.
+pub(in crate::staged_streams) fn capture_native_domain(ports:&[Arc<Port>],seal:&PhysicalVideoExposureSeal,realm:u128)->ControlResult<Option<NativeFrozenPhysicalWitness>> {
+    let Some(first)=ports.first() else {return Err(StreamControlError::Unsupported);};
+    let Some(cursor)=first.native_egress.get() else {
+        if ports.iter().any(|p|p.native_egress.get().is_some()){return Err(StreamControlError::Unsupported);}
+        return Ok(None);
+    };
+    let domain=cursor.video.as_ref().and_then(|v|v.domain.as_ref()).and_then(Weak::upgrade).ok_or(StreamControlError::Unsupported)?;
+    for port in ports {
+        let other=port.native_egress.get().and_then(|c|c.video.as_ref()).and_then(|v|v.domain.as_ref()).and_then(Weak::upgrade).ok_or(StreamControlError::Unsupported)?;
+        if !Arc::ptr_eq(&domain,&other){return Err(StreamControlError::Unsupported);}
+    }
+    domain.capture(ports,seal,realm,None).map(Some)
+}
+
+pub(in crate::staged_streams) fn pin_native_domain(ports:&[Arc<Port>],seal:&PhysicalVideoExposureSeal,realm:u128)->ControlResult<Option<NativeInventoryPin>> {
+    let Some(first)=ports.first() else{return Err(StreamControlError::Unsupported);};
+    let Some(cursor)=first.native_egress.get() else {
+        if ports.iter().any(|p|p.native_egress.get().is_some()){return Err(StreamControlError::Unsupported);}
+        return Ok(None);
+    };
+    let domain=cursor.video.as_ref().and_then(|video|video.domain.as_ref()).and_then(Weak::upgrade).ok_or(StreamControlError::Unsupported)?;
+    for port in ports {let other=port.native_egress.get().and_then(|c|c.video.as_ref()).and_then(|v|v.domain.as_ref()).and_then(Weak::upgrade).ok_or(StreamControlError::Unsupported)?;if !Arc::ptr_eq(&domain,&other){return Err(StreamControlError::Unsupported);}}
+    domain.pin(ports,seal,realm).map(Some)
+}
