+use super::*;
+impl Backend {
+    pub(super) fn preflight_initial_video_picture_source(&self,port:&AdapterMediaPort)->ControlResult<()> {
+        let binding=port.binding();
+        if !self.current() || !self.original_controller.get().is_some_and(|owner|port.matches_adapter_media_owner(owner))
