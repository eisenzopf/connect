+        publish_packet(&room.nodes[&source],packet,Some(original.clone())).await;
+        let writes=AtomicUsize::new(0);outgoing(&mut output).await.deliver(|_|async {
+            // Actual production native writer records inside SAME admitted
+            // Core callback, as canonical Native would before transport IO.
+            let mut writers=backend.native_writers.lock().unwrap();let writer=writers.get_mut(&port.binding().transport_id).unwrap();
+            writer.observe_video_potential(Some(&original));writer.reserve_next()?;
