+async fn owned_native_retired_inflight_family_blocks_capture_until_actual_original_cleanup_join_and_preserves_flat_history() {
+    for kind in ["quic","wt"] {
+        let mut room=OwnedRoom::new(kind).await;
+        let result=std::panic::AssertUnwindSafe(async {
+            let source=room.configure(0,0,&[Medium::Audio,Medium::Video]).await;
