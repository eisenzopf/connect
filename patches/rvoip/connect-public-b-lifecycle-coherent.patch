+//! Real original opaque native accepts and managed source realm. These are
+//! physical tracking/drain controls, not decoded media or a handoff receipt.
+use super::*;
+use futures::FutureExt;
+async fn pair_original_profile(
+    alpn: &[u8],
+    window: Option<u32>,
+    mtu: Option<u16>,
+) -> (
+    quinn::Endpoint,
+    quinn::Endpoint,
+    rvoip_uctp::substrate::AcceptedNativeConnection,
+    quinn::Connection,
+) {
+    use rvoip_uctp::substrate::{
+        dev_client_config_trusting, make_server_endpoint, self_signed_for_dev,
+    };
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let (cert, key) = self_signed_for_dev(&["localhost".into()]).unwrap();
+    let mut tls = rustls::ServerConfig::builder()
+        .with_no_client_auth()
+        .with_single_cert(vec![cert.clone()], key)
+        .unwrap();
+    tls.alpn_protocols = vec![alpn.to_vec()];
+    let mut host_transport = quinn::TransportConfig::default();
+    if let Some(mtu) = mtu {
+        host_transport.initial_mtu(mtu).mtu_discovery_config(None);
+    }
+    let server = make_server_endpoint(
+        "127.0.0.1:0".parse().unwrap(),
+        Arc::new(tls),
+        host_transport,
+    )
+    .unwrap();
+    let mut tls = dev_client_config_trusting(&cert).unwrap();
+    tls.alpn_protocols = vec![alpn.to_vec()];
+    let mut client = quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+    let mut config = quinn::ClientConfig::new(Arc::new(
+        quinn::crypto::rustls::QuicClientConfig::try_from(tls).unwrap(),
+    ));
+    let mut transport = quinn::TransportConfig::default();
+    if let Some(mtu) = mtu {
+        transport.initial_mtu(mtu).mtu_discovery_config(None);
+    }
+    if let Some(window) = window {
+        transport.stream_receive_window(window.into());
+        transport.receive_window((window * 4).into());
+    }
+    config.transport_config(Arc::new(transport));
+    client.set_default_client_config(config);
+    let connect = client
+        .connect(server.local_addr().unwrap(), "localhost")
+        .unwrap();
+    let accept = async { rvoip_uctp::substrate::AcceptedNativeConnection::accept_original(server.accept().await.unwrap()).await.unwrap() };
+    let (remote, host) = tokio::join!(connect, accept);
+    (server, client, host, remote.unwrap())
+}
+async fn wire_original(kind:&str,profile:CanonicalProfile)->Result<Wire,DispatchError> {
+    assert!(matches!(kind,"quic"|"wt"));
+    let path="/uctp";let origin=Some("https://allowed.example");
+    let(host_ep,remote_ep,host,remote)=pair_original_profile(if kind=="quic" {RAW_QUIC_ALPN}else{b"h3"},None,None).await;
+    let(send,receive)=mpsc::channel(4);
+    let server=if kind=="quic" {rvoip_quic::canonical::start_original(receive,profile,"quic://localhost:443".into())?}
+        else {rvoip_webtransport::canonical::start_original(receive,profile,"https://localhost/uctp".into(),"/uctp".into(),Some(HashSet::from(["https://allowed.example".into()])))?};
+    send.send(host).await.unwrap();
+        let wt = if kind == "wt" {
+            let mut request = web_transport_quinn::proto::ConnectRequest::from(
+                url::Url::parse(&format!("https://localhost{path}")).unwrap(),
+            );
+            if let Some(origin) = origin {
+                request.headers.insert("origin", origin.parse().unwrap());
+            }
+            match tokio::time::timeout(
+                Duration::from_secs(3),
+                web_transport_quinn::Session::connect(remote.clone(), request),
+            )
+            .await
+            .unwrap()
+            {
+                Ok(session) => Some(session),
+                Err(_) => {
+                    server.shutdown().await?;
+                    return Err(DispatchError::Authority);
+                }
+            }
+        } else {
+            None
+        };
+        if let Some(session) = wt {
+            let (writer, reader) = session.open_bi().await.unwrap();
+            // Client fixture also uses the native read API and explicit bounds.
+            let reader = futures::stream::unfold(
+                (reader, Vec::<u8>::new()),
+                |(mut reader, mut buffered)| async move {
+                    loop {
+                        if buffered.len() >= 4 {
+                            let length =
+                                u32::from_be_bytes(buffered[..4].try_into().unwrap()) as usize;
+                            if length > 1024 * 1024 {
+                                return Some((Err(DispatchError::Closed), (reader, buffered)));
+                            }
+                            if buffered.len() >= length + 4 {
+                                let bytes = Bytes::copy_from_slice(&buffered[4..4 + length]);
+                                buffered.drain(..4 + length);
+                                return Some((Ok(bytes), (reader, buffered)));
+                            }
+                        }
+                        let mut chunk = [0u8; 65536];
+                        match reader.read(&mut chunk).await {
+                            Ok(Some(n)) => buffered.extend_from_slice(&chunk[..n]),
+                            _ => return None,
+                        }
+                    }
+                },
+            );
+            let writer = futures::sink::unfold(writer, |mut writer, bytes: Bytes| async move {
+                let mut frame = Vec::new();
+                frame.extend_from_slice(&(bytes.len() as u32).to_be_bytes());
+                frame.extend_from_slice(&bytes);
+                writer
+                    .write_all(&frame)
+                    .await
+                    .map_err(|_| DispatchError::Closed)?;
+                tokio::io::AsyncWriteExt::flush(&mut writer)
+                    .await
+                    .map_err(|_| DispatchError::Closed)?;
+                Ok(writer)
+            });
+            Ok(Wire {
+                reader: Box::pin(reader),
+                writer: Box::pin(writer),
+                server,
+                quic: Some((host_ep, remote_ep, remote)),
+                wt: Some(session),
+            })
+        } else {
+            let (writer, reader) = remote.open_bi().await.unwrap();
+            let reader = FramedRead::new(reader, rvoip_uctp::substrate::length_prefixed_codec())
+                .map(|frame| {
+                    frame
+                        .map(|bytes| bytes.freeze())
+                        .map_err(|_| DispatchError::Closed)
+                });
+            let writer = FramedWrite::new(writer, rvoip_uctp::substrate::length_prefixed_codec())
+                .sink_map_err(|_| DispatchError::Closed);
+            Ok(Wire {
+                reader: Box::pin(reader),
+                writer: Box::pin(writer),
+                server,
+                quic: Some((host_ep, remote_ep, remote)),
+                wt: None,
+            })
+        }
+
+}
+
+struct OwnedRoom {
+    f:Fixture,factory:Arc<Factory>,grants:Arc<MediaGrants>,wires:Vec<Wire>,records:Vec<Arc<PhysicalRecord>>,
+    kinds:Vec<Transport>,controllers:Vec<Arc<StreamController>>,probes:Vec<NativeVideoSendProbe>,
+}
+impl OwnedRoom {
+    async fn new(target:&str)->Self {
+        let grants=Arc::new(MediaGrants(Arc::new(RwLock::new(PolicyState {owners:HashMap::new(),denied:BTreeSet::new(),private:false}))));
+        let(f,factory,_)=wire_setup_mode_with_media(true,Some(grants.clone()),false).await;
+        let mut room=Self {f,factory,grants,wires:vec![],records:vec![],kinds:vec![],controllers:vec![],probes:vec![]};
+        // Different actual physical peers, SAME original managed runtime/realm.
+        // Each supported receiver is tested; source uses the other substrate.
+        for kind in [if target=="quic" {"wt"}else{"quic"},target] {
+            let profile=CanonicalProfile::new(room.f.config.clone(),Arc::new(Handler::default()),8).unwrap().with_physical_handlers(room.factory.clone());
+            let before=room.factory.records.lock().unwrap().len();
+            let mut wire=wire_original(kind,profile).await.unwrap();
+            authenticate_wire(&mut wire,&room.f).await;
+            let record=room.factory.records.lock().unwrap()[before].clone();
+            room.wires.push(wire);room.records.push(record);room.kinds.push(if kind=="quic" {Transport::Quic}else{Transport::WebTransport});
+        }
+        room
+    }
+    async fn configure(&mut self,side:usize,n:usize,media:&[Medium])->Leg {
+        let kind=if self.kinds[side]==Transport::Quic {"quic"}else{"wt"};
+        self.wires[side].send(self.f.sign(native_offer(n,kind))).await;
+        assert_eq!(self.wires[side].read().await.kind(),"ack");
+        let id=self.records[side].connections.lock().unwrap().last().unwrap().clone();
+        self.grants.0.write().await.owners.insert(id.clone(),media_owner(&self.factory.core,&id,self.kinds[side]));
+        let readiness=Readiness::new();
+        let scope=StagedRtpScope {session:self.factory.core.session.clone(),connection:id.clone(),owner:principal("old").ownership_key(),wire_conversation:Some("conversation".into()),wire_session:"session".into(),wire_connection:format!("wire_{}",id.as_str())};
+        let adapter=&self.factory.adapters[&self.kinds[side]];
+        let controller=adapter.configure_rtp(&id,principal("old"),self.factory.core.conversation.clone(),scope,self.grants.clone(),readiness.clone(),16).unwrap();
+        self.controllers.push(controller.clone());
+        let media_owner=adapter.physical_source(&id).unwrap().media().unwrap();
+        if let Some(probe)=media_owner.original_video_send_probe_for_test(){self.probes.push(probe);}
+        controller.change(controller.revision(),&media.iter().map(|m|desired(*m)).collect::<Vec<_>>(),&BTreeSet::new(),deadline(),CancellationToken::new()).await.unwrap();
+        Leg {id,controller,readiness,media:media_owner}
+    }
+    async fn close(&mut self)->bool {
+        // Release every actual blocked callback before any original join, also
+        // after a test assertion/panic. Probe timeout independently refuses IO.
+        for probe in &self.probes {probe.release();}
+        let mut clean=true;
+        for wire in &self.wires {clean&=wire.server.shutdown().await.is_ok();}
+        clean&=self.factory.core.orch.end_session(self.factory.core.session.clone(),rvoip_core::session::EndReason::Normal).await.is_ok();
+        for controller in &self.controllers {clean&=controller.shutdown(deadline()).await==0;}
+        clean&=self.factory.core.orch.drain_connection_lifecycle_tasks().await.is_ok();
+        for wire in &self.wires {
+            if let Some((host,remote,connection))=&wire.quic {
+                connection.close(0u32.into(),b"native-domain-control-end");host.close(0u32.into(),b"native-domain-control-end");remote.close(0u32.into(),b"native-domain-control-end");
+                clean&=tokio::time::timeout(Duration::from_secs(4),host.wait_idle()).await.is_ok();
+                clean&=tokio::time::timeout(Duration::from_secs(4),remote.wait_idle()).await.is_ok();
