+async fn owned_native_domain_tracks_real_partial_failed_fragments_before_io_and_fresh_continuation_on_both_substrates() {
+    for kind in ["quic","wt"] {
+        let mut room=OwnedRoom::new(kind).await;
+        let result=std::panic::AssertUnwindSafe(async {
+            let source=room.configure(0,0,&[Medium::Audio,Medium::Video]).await;
+            let target=room.configure(1,1,&[Medium::Audio,Medium::Video]).await;select(&source,&target).await;
+            let logical=desired(Medium::Video).logical_id;let before=target.controller.native_video_potential_for_test(&logical).unwrap();
+            assert!(before.physical_io_coverage_complete&&before.guarded_source_points_known);
+            let realm=before.exposure.realm_incarnation.unwrap();let seal=target.media.try_seal_raw_access().unwrap();
+            let empty=target.controller.capture_native_video_domain_for_test(&[logical.clone()],&seal,realm).unwrap();assert_eq!(empty.ordinal(),0);
+            let probe=target.media.original_video_send_probe_for_test().unwrap();assert!(probe.arm(binding(&target,Medium::Video).stream_local_id,400,Some(2),None));
+            let mut input=source.controller.take_ingress(&logical).unwrap();let first=forward_original(&room,&source,&target,&mut input,1).await;
+            until_probe(&probe,|v|v.attempts==2&&v.accepted==1&&v.refused==1).await;
+            let point=first.frame_realm().unwrap();assert_eq!(realm,point.incarnation());assert!(!empty.is_current());
+            let first_metadata=target.controller.capture_native_video_domain_for_test(&[logical.clone()],&seal,realm).unwrap();assert!(first_metadata.ordinal()>=point.ordinal());
+            let actual=received(&room.wires[1]).await;assert_eq!(actual.stream_local_id,binding(&target,Medium::Video).stream_local_id);assert!(!actual.rtp.packet().header.marker);
+            let next=forward_original(&room,&source,&target,&mut input,2).await;until_probe(&probe,|v|v.attempts==5&&v.accepted==4&&v.refused==1).await;
+            assert!(next.frame_realm().unwrap().ordinal()>point.ordinal());assert!(!first_metadata.is_current());
+            let mut native_fragments=0;for _ in 0..3 {let packet=received(&room.wires[1]).await;assert_eq!(packet.rtp.packet().header.timestamp,6000);native_fragments+=1;}
+            let final_metadata=target.controller.capture_native_video_domain_for_test(&[logical],&seal,realm).unwrap();
+            let no_raw=target.media.router().is_none()&&target.media.datagrams().is_none();let current=seal.is_current();seal.retire();
+            (native_fragments==3,no_raw,current,final_metadata.ordinal()>=next.frame_realm().unwrap().ordinal(),!probe.snapshot().timed_out)
+        }).catch_unwind().await;
+        let clean=room.close().await;if let Err(panic)=result {std::panic::resume_unwind(panic);}
+        let(fragments,no_raw,current,history,no_timeout)=result.unwrap();assert!(clean&&fragments&&no_raw&&current&&history&&no_timeout);
+    }
+}
