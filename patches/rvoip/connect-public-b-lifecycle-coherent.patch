+//! Pre-cut B resource ownership, not a source/receive/publication permission.
+//! The actual candidate controller is already bound, but B has never had IO.
+//! One original preparation owns one seal; a dead Weak slot is a tombstone.
+use super::*;
+use super::direct_subscriptions::PublicVideoWarmTarget;
+use super::physical_video_exposure::{PhysicalVideoExposureSeal,PhysicalVideoSealWitness};
+use crate::orchestrator::participant_control::replacement::{DeviceReplacementPreparation,ReplacementPreparationIdentity};
+use crate::participant_transitions::ParticipantReplacementMutation;
+use std::sync::{OnceLock,atomic::AtomicBool};
+
+struct ReservationOwner {
+    preparation:Weak<DeviceReplacementPreparation>,identity:ReplacementPreparationIdentity,
+    original:ParticipantReplacementMutation,controller:Weak<StreamController>,port:Weak<Port>,
+    credential:CredentialSnapshot,ticket:PeerRouteTicket,target:PublicVideoWarmTarget,
+    conversation:ConversationId,session:SessionId,realm:u128,
+    deadline:tokio::time::Instant,cancellation:CancellationToken,
+    witness:PhysicalVideoSealWitness,consumed:AtomicBool,seal:Mutex<Option<PhysicalVideoExposureSeal>>,
+    frozen:OnceLock<Weak<super::old_video_freeze::FrozenOldVideoFrontier>>,
+}
+/// No public constructor, Clone, Deserialize or authority Reader. Root retains
+/// this exact owner before recording metadata or awaiting private readiness.
+pub struct PublicVideoReservationPreparation {owner:Arc<ReservationOwner>}
+impl PublicVideoReservationPreparation {
+    pub fn original_intent(&self)->&ParticipantReplacementMutation {&self.owner.original}
+    pub fn conversation(&self)->&ConversationId {&self.owner.conversation}
+    pub fn session(&self)->&SessionId {&self.owner.session}
+    pub fn target(&self)->&PublicVideoWarmTarget {&self.owner.target}
+    pub fn realm_incarnation(&self)->u128 {self.owner.realm}
+    pub fn matches_original_preparation(&self,p:&Arc<DeviceReplacementPreparation>)->bool {
+        Weak::ptr_eq(&self.owner.preparation,&Arc::downgrade(p))
+    }
+    pub fn is_current(&self)->bool {
+        let owner=&self.owner;
+        owner.preparation.strong_count()!=0 && !owner.cancellation.is_cancelled()
+            && tokio::time::Instant::now()<owner.deadline && owner.ticket.is_active()
+            && owner.witness.is_current() && !owner.consumed.load(Ordering::Acquire)
+            && owner.controller.upgrade().is_some_and(|target|!target.shutdown.is_cancelled()
+                && target.check_credential_snapshot(&owner.credential).is_ok())
+            && owner.port.upgrade().and_then(|port|port.video_exposure.get().and_then(|observer|observer.snapshot()))
+                .is_some_and(|physical|physical.coverage_complete && physical.realm_incarnation==Some(owner.realm)
+                    && physical.physical_family==owner.target.physical_writer_incarnation
+                    && physical.maximum_potential_ordinal==0 && physical.inherited_potential_ordinal==0)
+    }
+    pub(crate) fn witness(&self)->PhysicalVideoSealWitness {self.owner.witness.clone()}
+    pub(crate) fn matches_frontier(&self,frontier:&Arc<super::old_video_freeze::FrozenOldVideoFrontier>)->bool {
+        self.owner.frozen.get().is_some_and(|original|Weak::ptr_eq(original,&Arc::downgrade(frontier)))
+    }
+    pub(crate) fn matches_identity(&self,identity:&ReplacementPreparationIdentity)->bool {self.owner.identity.same(identity)}
+    fn validate(&self)->ControlResult<()> {
+        let target=self.owner.controller.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let state=target.state.try_lock().map_err(metadata_lock_error)?;
+        self.validate_locked(&target,&state)
+    }
+    /// No whole-model revision pin: legitimate private A/audio changes may
+    /// coexist. The original B Port/root/credential/family may never change.
+    pub(crate) fn validate_locked(&self,target:&Arc<StreamController>,state:&State)->ControlResult<()> {
+        if self.owner.preparation.strong_count()==0 || self.owner.cancellation.is_cancelled() || target.shutdown.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        if tokio::time::Instant::now()>=self.owner.deadline {return Err(StreamControlError::Deadline);}
+        if self.owner.controller.upgrade().is_none_or(|original|!Arc::ptr_eq(&original,target))
+            || !self.owner.ticket.is_active() || !self.owner.witness.is_current() || state.closed {
+            return Err(StreamControlError::NotReady);
+        }
+        target.check_credential_snapshot(&self.owner.credential)?;
+        let port=self.owner.port.upgrade().ok_or(StreamControlError::NotReady)?;
+        if state.active.get(&self.owner.target.logical_id).is_none_or(|current|!Arc::ptr_eq(current,&port)) {
+            return Err(StreamControlError::Authority);
+        }
+        let seal=self.owner.seal.try_lock().map_err(metadata_lock_error)?;
+        let seal=seal.as_ref().ok_or(StreamControlError::NotReady)?;
+        let physical=AdapterMediaPort(port.clone()).physical_video_exposure_sealed(seal).ok_or(StreamControlError::Unsupported)?;
+        let binding=&port.binding;
+        if !physical.coverage_complete || physical.realm_incarnation!=Some(self.owner.realm)
+            || physical.physical_family!=self.owner.target.physical_writer_incarnation
+            || physical.maximum_potential_ordinal!=0 || physical.inherited_potential_ordinal!=0
+            || binding.negotiated.requested.logical_id!=self.owner.target.logical_id || binding.transport_id!=self.owner.target.transport_id
+            || binding.generation!=self.owner.target.stream_generation || binding.connection_generation!=self.owner.target.connection_generation {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    pub(crate) fn validate_for_plan(&self,plan:&device_replacement::AudioDeviceReplacementPlan)->ControlResult<()> {
+        self.validate()?;
+        let intent=plan.audience().replacement.as_ref().ok_or(StreamControlError::Authority)?;
+        if self.owner.original.operation_id!=intent.request.operation_id || self.owner.original.source!=intent.request.source
+            || self.owner.original.replacement!=intent.request.admitted || self.owner.original.retained!=intent.request.retained
+            || intent.private_consultation_parent().is_some() || !plan.audience().group.origins.is_empty() {
+            return Err(StreamControlError::Authority);
+        }
+        let video=intent.video.as_ref().ok_or(StreamControlError::Unsupported)?;
+        if video.incoming.len()!=1 || video.incoming[0].receiver!=self.owner.target.logical_id
+            || plan.audience().controllers.get(&intent.request.admitted).is_none_or(|controller|!Weak::ptr_eq(controller,&self.owner.controller)) {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    /// Only the existing original p.flight caller may consume this once. This
+    /// moves the same seal; it never allocates a replacement token or writer.
+    pub(crate) fn consume_seal(&self,target:&Arc<StreamController>,state:&State)->ControlResult<PhysicalVideoExposureSeal> {
+        self.validate_locked(target,state)?;
+        let seal=self.owner.seal.try_lock().map_err(metadata_lock_error)?.take().ok_or(StreamControlError::NotReady)?;
+        self.owner.consumed.store(true,Ordering::Release);Ok(seal)
+    }
+}
+#[derive(Default)]
+pub(crate) struct PublicVideoReservationSlot {owner:OnceLock<Weak<ReservationOwner>>}
+impl PublicVideoReservationSlot {
+    pub(crate) fn install(&self,value:&PublicVideoReservationPreparation)->ControlResult<()> {
+        self.owner.set(Arc::downgrade(&value.owner)).map_err(|_|StreamControlError::NotReady)
+    }
+    pub(crate) fn is_used(&self)->bool {self.owner.get().is_some()}
+    pub(crate) fn current(&self,p:&Arc<DeviceReplacementPreparation>)->crate::orchestrator::participant_control::ControlResult<PublicVideoReservationPreparation> {
+        let owner=self.owner.get().and_then(Weak::upgrade).ok_or(crate::orchestrator::participant_control::ParticipantControlError::Media(StreamControlError::NotReady))?;
+        let value=PublicVideoReservationPreparation {owner};
+        if !value.matches_original_preparation(p) {return Err(crate::orchestrator::participant_control::ParticipantControlError::Media(StreamControlError::Authority));}
+        value.validate()?;Ok(value)
+    }
+    pub(crate) fn bind_frozen(&self,p:&Arc<DeviceReplacementPreparation>,value:&PublicVideoReservationPreparation,frontier:&Arc<super::old_video_freeze::FrozenOldVideoFrontier>)->crate::orchestrator::participant_control::ControlResult<()> {
+        self.validate(p,value)?;
+        value.owner.frozen.set(Arc::downgrade(frontier)).map_err(|_|crate::orchestrator::participant_control::ParticipantControlError::Media(StreamControlError::NotReady))
+    }
+    pub(crate) fn validate(&self,p:&Arc<DeviceReplacementPreparation>,value:&PublicVideoReservationPreparation)->crate::orchestrator::participant_control::ControlResult<()> {
+        if !value.matches_original_preparation(p) || self.owner.get().is_none_or(|owner|!Weak::ptr_eq(owner,&Arc::downgrade(&value.owner))) {
+            return Err(crate::orchestrator::participant_control::ParticipantControlError::Media(StreamControlError::Authority));
+        }
+        value.validate()?;Ok(())
+    }
+}
+impl StreamController {
+    pub(crate) fn reserve_public_video(
+        self:&Arc<Self>,preparation:&Arc<DeviceReplacementPreparation>,identity:ReplacementPreparationIdentity,
+        realm:u128,logical:&StreamId,deadline:tokio::time::Instant,cancellation:CancellationToken,
+        held:&(dyn Any+Send+Sync),
+    )->ControlResult<PublicVideoReservationPreparation> {
+        let original=preparation.intent();
+        if self.connection!=original.replacement || realm==0 || !identity.matches_scope(&self.conversation,&self.session,realm) {
+            return Err(StreamControlError::Authority);
+        }
+        let _flight=self.inflight.clone().try_acquire_owned().map_err(|_|MediaTransitionError::Conflict)?;
+        let credential=self.credential_snapshot();
+        let state=self.state.try_lock().map_err(metadata_lock_error)?;
+        if state.closed || cancellation.is_cancelled() || self.shutdown.is_cancelled() {return Err(StreamControlError::Cancelled);}
+        let port=Self::direct_port(&state,logical)?;
+        let binding=&port.binding;
+        if binding.negotiated.requested.medium!=Medium::Video || binding.negotiated.requested.direction!=StreamDirection::Send
+            || !binding.sink_ready || binding.source_ready
+            || !matches!(&binding.negotiated.format,MediaFormat::Encoded {name,clock_rate_hz:90000,channels:0,fmtp} if name.eq_ignore_ascii_case("vp8") && fmtp.as_ref().is_none_or(|v|v.is_empty())) {
+            return Err(StreamControlError::Unsupported);
+        }
+        let ticket=port.ticket(TicketSide::Egress);
+        if !ticket.is_active() {return Err(StreamControlError::NotReady);}
+        let seal=port.video_exposure.get().and_then(|observer|observer.try_seal_coverage()).ok_or(StreamControlError::Unsupported)?;
+        let physical=AdapterMediaPort(port.clone()).physical_video_exposure_sealed(&seal).ok_or(StreamControlError::Unsupported)?;
+        if !physical.coverage_complete || physical.realm_incarnation!=Some(realm)
+            || physical.maximum_potential_ordinal!=0 || physical.inherited_potential_ordinal!=0 {return Err(StreamControlError::Unsupported);}
+        let deadline=deadline.min(Self::command_deadline(&credential.principal,deadline));
+        let value=PublicVideoReservationPreparation {owner:Arc::new(ReservationOwner {
+            preparation:Arc::downgrade(preparation),identity,original:original.clone(),controller:Arc::downgrade(self),port:Arc::downgrade(port),
+            credential:credential.clone(),ticket,target:PublicVideoWarmTarget {logical_id:logical.clone(),transport_id:binding.transport_id.clone(),
+                stream_generation:binding.generation,connection_generation:binding.connection_generation,physical_writer_incarnation:physical.physical_family},
+            conversation:self.conversation.clone(),session:self.session.clone(),realm,deadline,cancellation,witness:seal.witness(),consumed:AtomicBool::new(false),seal:Mutex::new(Some(seal)),frozen:OnceLock::new(),
