+//! Fresh VP8 bootstrap under the existing physical Timeline serialization.
+//! No native IO, sequence allocation or source-point mint occurs here. Actual
+//! guarded successful writer callbacks alone commit progress/submission metadata.
+use super::*;
+use rvoip_core::staged_streams::direct_subscriptions::PostCutPublicVideoScope;
+use rvoip_core::staged_streams::direct_subscriptions::PublicVideoKeyframeRecorder;
+#[derive(Clone)]
+enum Bootstrap {Waiting, Collecting {source:Source,ordinal:u64,timestamp:u32,next:u16}, Open {source:Source}}
+pub(super) struct WarmVideo {
+    pub(super) scope:Arc<PostCutPublicVideoScope>,
+    progress:BootstrapProgress,
+    recorder:PublicVideoKeyframeRecorder,
+}
+impl WarmVideo {
+    pub(super) fn new(scope:Arc<PostCutPublicVideoScope>,recorder:PublicVideoKeyframeRecorder)->Self {
+        Self {scope,progress:BootstrapProgress::default(),recorder}
+    }
+    pub(super) fn preview(&mut self,source:&Source,input:&rtp::Packet,original:&Arc<rvoip_core::staged_streams::OriginalVideoFrame>)->ControlResult<Option<BootstrapCommit>> {
+        self.progress.preview_for_phase(self.scope.is_published(),source,input,original)
+    }
+    // Actual Producer calls ONLY after native write Ok, with its original IO
+    // object. Partial/unknown errors never call this and zero-write Ok cannot
+    // advance bootstrap or produce a receipt. Metadata does not change IO.
+    pub(super) fn commit(
+        &mut self,next:BootstrapCommit,original:&Arc<rvoip_core::staged_streams::OriginalVideoFrame>,
+        source:&Source,native_ssrc:u32,payload_type:u8,timestamp:u32,family:Option<u128>,
+        previously_written:bool,io:&dyn OwnedRtpIo,
+    ) {
+        if let Some(frame)=self.progress.commit_after_io(next,original,previously_written,io) {
+            if let Some(family)=family {
+                self.recorder.observe_complete_keyframe_submission(
+                    frame,&source.origin,source.ssrc,family,native_ssrc,payload_type,timestamp,
+                );
+            }
+        }
+    }
+}
+struct BootstrapProgress {
+    bootstrap:Bootstrap,original:Option<Arc<rvoip_core::staged_streams::OriginalVideoFrame>>,
+}
+impl Default for BootstrapProgress {
+    fn default()->Self {Self {bootstrap:Bootstrap::Waiting,original:None}}
+}
+impl BootstrapProgress {
+    // Bootstrap is pending-public decoder setup only. Actual publication ends
+    // that requirement; ordinary source switches can submit P-frames and issue
+    // their current feedback route. Producer ALWAYS checks the permanent
+    // original realm/F floor before calling this phase-specific preview.
+    fn preview_for_phase(&mut self,published:bool,source:&Source,input:&rtp::Packet,original:&Arc<rvoip_core::staged_streams::OriginalVideoFrame>)->ControlResult<Option<BootstrapCommit>> {
+        if published {return Ok(None);}
+        self.preview(source,input,original).map(Some)
+    }
+    fn preview(&mut self,source:&Source,input:&rtp::Packet,original:&Arc<rvoip_core::staged_streams::OriginalVideoFrame>)->ControlResult<BootstrapCommit> {
+        let ordinal=original.frame_realm().ok_or(StreamControlError::Unsupported)?.ordinal();
+        if matches!(&self.bootstrap,Bootstrap::Collecting {ordinal:point,timestamp,..}
+            if *point==ordinal && *timestamp==input.header.timestamp)
+            && self.original.as_ref().is_none_or(|old|!Arc::ptr_eq(old,original)) {
+            self.bootstrap=Bootstrap::Waiting;self.original=None;
+            return Err(StreamControlError::Authority);
+        }
+        let was_open=matches!(&self.bootstrap,Bootstrap::Open {source:old} if old==source);
+        match preview(&self.bootstrap,source,input,ordinal) {
+            Ok(next)=>{let complete=!was_open && matches!(&next,Bootstrap::Open {..});Ok(BootstrapCommit {next,complete})},
+            Err(error)=>{self.bootstrap=Bootstrap::Waiting;self.original=None;Err(error)},
+        }
+    }
+    fn commit_after_io(
+        &mut self,next:BootstrapCommit,original:&Arc<rvoip_core::staged_streams::OriginalVideoFrame>,
+        previously_written:bool,io:&dyn OwnedRtpIo,
+    )->Option<Arc<rvoip_core::staged_streams::OriginalVideoFrame>> {
+        if previously_written || !io.attempted() || !io.written() {return None;}
+        self.original=if matches!(&next.next,Bootstrap::Collecting {..}) {Some(original.clone())} else {None};
+        self.bootstrap=next.next;
+        next.complete.then(||original.clone())
+    }
+}
+pub(super) struct BootstrapCommit {next:Bootstrap,complete:bool}
+fn preview(state:&Bootstrap,source:&Source,input:&rtp::Packet,ordinal:u64)->ControlResult<Bootstrap> {
+    if matches!(state,Bootstrap::Open {source:old} if old==source) {return Ok(state.clone());}
+    let first=*input.payload.first().ok_or(StreamControlError::Unsupported)?;
+    let starts=first&0x10!=0 && first&0x0f==0;
+    if starts {
+        let size=super::super::video_normalize::vp8_descriptor_len(&input.payload).ok_or(StreamControlError::Unsupported)?;
+        let data=input.payload.get(size..).ok_or(StreamControlError::Unsupported)?;
+        // RFC6386 key-frame tag, sync code and nonzero visible dimensions.
+        if data.len()<10 || data[0]&1!=0 || data[3..6]!=[0x9d,0x01,0x2a]
+            || u16::from_le_bytes([data[6],data[7]])&0x3fff==0
+            || u16::from_le_bytes([data[8],data[9]])&0x3fff==0 {
+            return Err(StreamControlError::NotReady);
+        }
+    } else {
+        match state {
+            Bootstrap::Collecting {source:old,ordinal:point,timestamp,next}
+                if old==source && *point==ordinal && *timestamp==input.header.timestamp && *next==input.header.sequence_number=>{},
+            _=>return Err(StreamControlError::NotReady),
+        }
+    }
+    Ok(if input.header.marker {Bootstrap::Open {source:source.clone()}}
+        else {Bootstrap::Collecting {source:source.clone(),ordinal,timestamp:input.header.timestamp,next:input.header.sequence_number.wrapping_add(1)}})
+}
