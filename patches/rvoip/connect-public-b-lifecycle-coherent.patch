+//! Cold exact OLD programme snapshot for one qualified restore control only.
+use super::*;
+/// Core-derived current selected source, not a wire assertion or packet grant.
+pub struct OldVideoRestoreSource {source:MediaSource,receiver:StreamId,medium:Medium}
+impl OldVideoRestoreSource {
+    pub fn source(&self)->&MediaSource {&self.source}
+    pub fn receiver(&self)->&StreamId {&self.receiver}
+    pub fn medium(&self)->Medium {self.medium}
+}
+struct OriginalSource {stamp:DirectStamp,port:Weak<Port>,ticket:PeerRouteTicket,paused:bool}
+pub(in crate::staged_streams) struct RestoreSources {
+    descriptors:Vec<OldVideoRestoreSource>,original:Vec<OriginalSource>,
+}
+impl RestoreSources {
+    pub(in crate::staged_streams) fn descriptors(&self)->&[OldVideoRestoreSource] {&self.descriptors}
+    pub(in crate::staged_streams) fn preflight_initial_pictures(&self)->ControlResult<()> {
+        if self.original.is_empty() {return Err(StreamControlError::Unsupported);}
+        self.validate()?;
+        for original in &self.original {
+            let port=original.port.upgrade().ok_or(StreamControlError::NotReady)?;
+            let source=port.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+            port.require_ticket(TicketSide::Ingress,&original.ticket)?;
+            source.adapter.preflight_initial_video_picture(&AdapterMediaPort(port))?;
+        }
+        self.validate()
+    }
+    pub(in crate::staged_streams) fn has_paused_source(&self)->bool {self.original.iter().any(|source|source.paused)}
+    pub(in crate::staged_streams) fn validate(&self)->ControlResult<()> {
+        if self.original.iter().any(|source|!source.stamp.is_current() || !source.ticket.is_current() || (!source.paused && !source.ticket.is_active())
+            || source.port.upgrade().is_none_or(|port|port.owner.upgrade().is_none_or(|owner|owner.shutdown.is_cancelled()))) {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(())
+    }
+}
+impl StreamController {
+    pub(in crate::staged_streams) fn capture_video_restore_sources(self:&Arc<Self>,state:&State,ports:&[Arc<Port>])->ControlResult<RestoreSources> {
+        self.capture_video_restore_sources_inner(state,ports,false)
+    }
+    pub(in crate::staged_streams) fn capture_video_restore_readiness(self:&Arc<Self>,state:&State,ports:&[Arc<Port>])->ControlResult<RestoreSources> {
+        self.capture_video_restore_sources_inner(state,ports,true)
+    }
+    fn capture_video_restore_sources_inner(self:&Arc<Self>,state:&State,ports:&[Arc<Port>],allow_paused:bool)->ControlResult<RestoreSources> {
+        let routing=self.direct_subscriptions.routing.try_lock().map_err(metadata_lock_error)?;
+        let mut descriptors=Vec::new();let mut original=Vec::new();
+        for port in ports {
+            let receiver=&port.binding.negotiated.requested.logical_id;
+            let Some(route)=routing.program.get(receiver) else {continue;};
+            if route.preparation.is_some() || !route.ticket.is_current()
+                || route.post_cut.as_ref().is_some_and(|scope|!scope.is_published() || !scope.is_current()) {
+                return Err(StreamControlError::Authority);
+            }
+            if !state.model.streams().get(receiver).is_some_and(|stream|stream.permits(true)) {
+                return Err(StreamControlError::NotReady);
+            }
+            let publisher=route.selection.publisher().ok_or(StreamControlError::NotReady)?;
+            if publisher.conversation!=self.conversation || publisher.session!=self.session
+                || !Arc::ptr_eq(&publisher.policy,&self.policy) || publisher.shutdown.is_cancelled() {
+                return Err(StreamControlError::Authority);
+            }
+            let capture=|source_state:&State|->ControlResult<(Arc<Port>,PeerRouteTicket,bool)> {
+                let stream=source_state.model.streams().get(&route.selection.source.logical).ok_or(StreamControlError::NotReady)?;
+                // Only explicit reversible Pause is a resource status. Mute,
+                // direction/hold denial or Ended is NEVER classified as
+                // temporarily paused. No policy decision is made here: Host
+                // must independently require fresh current authorization.
+                let paused=allow_paused && stream.state==crate::stream_lifecycle::LogicalStreamState::Paused
+                    && matches!(stream.negotiated.requested.direction,StreamDirection::Receive|StreamDirection::Both) && !stream.source_muted
+                    && stream.hold_direction.is_none_or(|direction|matches!(direction,StreamDirection::Receive|StreamDirection::Both));
+                if !stream.permits(false) && !paused {return Err(StreamControlError::NotReady);}
+                let source=Self::direct_port(source_state,&route.selection.source.logical)?.clone();
+                let ticket=source.ticket(TicketSide::Ingress);
+                if !ticket.is_current() || (!paused && !ticket.is_active()) {return Err(StreamControlError::NotReady);}
+                if allow_paused {
+                    let status=source.state.try_lock().map_err(metadata_lock_error)?;
+                    if source_state.closed || !status.ready || !matches!(status.status,PortStatus::Active|PortStatus::Paused) {return Err(StreamControlError::NotReady);}
+                }
+                Ok((source,ticket,paused))
+            };
+            let(source,ticket,paused)=if Arc::ptr_eq(&publisher,self) {capture(state)?} else {
+                let source_state=publisher.state.try_lock().map_err(metadata_lock_error)?;capture(&source_state)?
+            };
+            let binding=&source.binding;let medium=binding.negotiated.requested.medium;
+            if !matches!(medium,Medium::Video|Medium::Screen) || medium!=port.binding.negotiated.requested.medium
+                || !binding.source_ready || binding.negotiated.format!=port.binding.negotiated.format {
+                return Err(StreamControlError::Unsupported);
+            }
+            let descriptor=MediaSource {conversation:publisher.conversation.clone(),session:publisher.session.clone(),connection:publisher.connection.clone(),
+                participant:publisher.origin_member.participant().clone(),membership_epoch:publisher.origin_member.epoch(),
+                connection_generation:binding.connection_generation,logical_id:route.selection.source.logical.clone(),transport_id:binding.transport_id.clone(),stream_generation:binding.generation};
+            let stamp=self.direct_subscriptions.stamp_from(&routing,&publisher,&route.selection.source.logical,receiver,Instant::now())?;
+            descriptors.push(OldVideoRestoreSource {source:descriptor,receiver:receiver.clone(),medium});
+            original.push(OriginalSource {stamp,port:Arc::downgrade(&source),ticket,paused});
+        }
+        let snapshot=RestoreSources {descriptors,original};snapshot.validate()?;Ok(snapshot)
+    }
+}
