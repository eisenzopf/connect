+        assert!(binding.peer(until).await.is_err(),"actual raw getter refuses; scalar signaling did not bypass/escape it");
+        assert!(binding.signaling_control(until).await.is_err(),"same original signaling claim cannot be reissued");
+        assert!(control.accept_offer_and_gather(&offer).await.is_err(),"one native accept only");
+        binding.shutdown().await.unwrap();assert!(!seal.is_current());assert!(!control.is_connected());
+        assert!(binding.peer(until).await.is_err());assert!(binding.signaling_control(until).await.is_err());
+    }).catch_unwind().await;
+    // BOTH original joins precede the causal verdict, including panic paths.
+    let closed=binding.shutdown().await;let remote_closed=remote.close().await;
