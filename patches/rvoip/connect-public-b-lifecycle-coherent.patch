+    }
+    /// Trusted adapter SPI, ONLY after actual guarded complete keyframe native
+    /// writes succeeded. Never call from start/sink_ready/peer/client metadata,
+    /// an attempted/partial/unknown write, repair or a different writer.
+    /// This records metadata only; refusal never retries or changes media IO.
+    pub fn observe_complete_keyframe_submission(
+        &self,original:Arc<OriginalVideoFrame>,source:&MediaDeliveryOrigin,source_ssrc:u32,
+        physical_family:u128,native_ssrc:u32,payload_type:u8,timestamp:u32,
+    ) {
+        let Some(scope)=self.scope.upgrade() else{return;};
+        if scope.submission.get().is_some() {return;}
+        let Some(port)=self.target.upgrade() else{return;};
+        let Some(physical)=port.physical_video_exposure() else{return;};
+        let Some(point)=original.frame_realm() else{return;};
+        let binding=port.binding();let expected=scope.source();
+        if !scope.is_current() || scope.is_published()
+            || original.ssrc()!=source_ssrc
+            || source.connection!=expected.connection || source.logical!=expected.logical_id
+            || source.transport!=expected.transport_id || source.generation!=expected.stream_generation
+            || native_ssrc!=self.native_ssrc || payload_type!=self.payload_type
+            || physical_family!=scope.target.physical_writer_incarnation
+            || !physical.coverage_complete || physical.physical_family!=physical_family
+            || physical.realm_incarnation!=Some(point.incarnation())
+            || physical.maximum_potential_ordinal<point.ordinal()
+            || physical.inherited_potential_ordinal<scope.frontier.ordinal()
+            || binding.transport_id!=scope.target.transport_id || binding.generation!=scope.target.stream_generation
+            || binding.connection_generation!=scope.target.connection_generation
+            || scope.require_original_frame(Some(&original)).is_err() {
+            return;
+        }
+        let _=scope.submission.set(Arc::new(PublicVideoKeyframeSubmission {
+            scope:Arc::downgrade(&scope),original,native_ssrc,payload_type,timestamp,
