+//! Arm the SAME originally reserved B output; never allocate a replacement
+//! queue, source worker, track, decoder or public mapping during warm start.
+use super::*;
+impl Backend {
+    pub(super) async fn start_reserved_public_video(&self,request:&direct_subscriptions::PublicVideoWarmStart<'_>)->ControlResult<()> {
+        let port=request.target_port();let scope=request.scope();let descriptor=scope.target();let binding=port.binding();
+        if !request.is_current() || !self.current()
+            || !self.original_controller.get().is_some_and(|original|port.matches_adapter_media_owner(original))
+            || port.context_ids()? != (scope.conversation().clone(),scope.session().clone(),scope.original_intent().replacement.clone())
+            || self.id!=scope.original_intent().replacement || binding.transport_id!=descriptor.transport_id
+            || binding.negotiated.requested.logical_id!=descriptor.logical_id
+            || binding.generation!=descriptor.stream_generation || binding.connection_generation!=descriptor.connection_generation
+            || binding.negotiated.requested.medium!=Medium::Video || !binding.sink_ready
+            || self.physical.reserved_video.as_ref().map(|profile|profile.role(&binding.negotiated.requested)).transpose()?.flatten()!=Some(super::super::reserved_video::VideoRole::PublicReserved)
+        {return Err(StreamControlError::Authority);}
+        let io=self.ports.get(&descriptor.transport_id).map(|entry|entry.value().clone()).ok_or(StreamControlError::NotReady)?;
+        let current=||self.current() && request.is_current() && io.health.confirmed()
+            && io.port.upgrade().is_some_and(|original|original.same_original(port) && original.status()==PortStatus::Active)
+            && same_binding(&io.binding,binding)
+            && self.ports.get(&descriptor.transport_id).is_some_and(|original|Arc::ptr_eq(original.value(),&io));
+        if !current() {return Err(StreamControlError::NotReady);}
+        // All potentially waiting native setup is BEFORE taking the reserved
+        // queue. No raw capability escapes and no worker/IO starts here.
+        let peer=tokio::select! {biased;
+            _=request.cancellation().cancelled()=>return Err(StreamControlError::Cancelled),
+            result=self.physical.peer_internal(request.deadline())=>result.map_err(|_|StreamControlError::NotReady)?,
+        };
+        if !current() {return Err(StreamControlError::NotReady);}
+        let owner=io.reserved_video.as_ref().and_then(Weak::upgrade).ok_or(StreamControlError::NotReady)?;
+        let mut setup=io.health.setup.try_lock().map_err(|_|StreamControlError::MetadataBusy)?;
+        if setup.closing || !setup.tasks.is_empty() || !current() {return Err(StreamControlError::NotReady);}
+        let mut slot=owner.video.try_lock().map_err(|_|StreamControlError::MetadataBusy)?;
+        let video=slot.as_mut().ok_or(StreamControlError::NotReady)?;
+        let (native_ssrc,payload_type,observed)=video.owned_binding_metadata(&peer).ok_or(StreamControlError::Authority)?;
+        if observed.physical_family!=descriptor.physical_writer_incarnation {return Err(StreamControlError::Authority);}
+        let recorder=request.keyframe_submission_recorder(native_ssrc,payload_type)?;
+        video.arm_public_warm(scope.clone(),recorder)?;
+        // No await follows queue consumption/worker installation. Close shares
+        // this exact setup exclusion and retains both original task joins.
+        let video=slot.take().ok_or(StreamControlError::NotReady)?;
+        let pictures=video.picture_requests();
+        io.start_locked(&mut setup,picture_feedback(pictures,peer.video_keyframe_requests(),peer.video_repair_requests(),self.routes.clone(),self.picture_next.clone(),io.health.stop.clone()))?;
+        io.start_locked(&mut setup,egress_loop(Egress::Video(video),io.health.stop.clone(),Medium::Video))?;
+        Ok(())
+    }
+}
