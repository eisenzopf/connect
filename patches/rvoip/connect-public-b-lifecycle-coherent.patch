+        if !self.current() || attempted.load(Ordering::Acquire) {return Err(StreamControlError::NotReady);}
+        let scope=self.direct.post_cut.as_ref().ok_or(StreamControlError::Authority)?;
+        let source_port=self.source.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let target_port=self.target.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let source=source_port.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let target=target_port.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if source.conversation!=target.conversation || source.session!=target.session
+            || !Arc::ptr_eq(&source.policy,&target.policy) {return Err(StreamControlError::Authority);}
+        let cancel=scope.cancellation()?;
+        let mut deadline=scope.deadline().ok_or(StreamControlError::Cancelled)?
+            .min(tokio::time::Instant::now()+Duration::from_millis(100));
