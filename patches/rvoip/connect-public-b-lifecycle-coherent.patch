+//! Test-support only: bounded gate around SAME private accepted native IO.
+//! It cannot return raw transport/native handles, replace bytes/authority,
+//! fabricate completion or allocate an F. Shipping builds exclude this module.
+use super::*;
+use std::sync::{Condvar,Mutex};
+struct Config {handle:u16,budget:usize,refuse:Option<u64>,latch:Option<u64>,latch_until:Option<Instant>}
+#[derive(Default)]
+struct State {
+    config:std::sync::OnceLock<Config>,attempts:AtomicU64,accepted:AtomicU64,refused:AtomicU64,
+    waiting:AtomicBool,timed_out:AtomicBool,released:Mutex<bool>,wake:Condvar,
+}
+#[derive(Clone)]
+pub struct NativeVideoSendProbe(Arc<State>);
+#[derive(Clone,Copy,Debug)]
+pub struct NativeVideoSendProbeSnapshot {pub attempts:u64,pub accepted:u64,pub refused:u64,pub waiting:bool,pub timed_out:bool}
+impl NativeVideoSendProbe {
+    pub fn arm(&self,handle:u16,budget:usize,refuse:Option<u64>,latch:Option<u64>)->bool {
+        if handle==0||!(128..=1180).contains(&budget)||refuse.into_iter().chain(latch).any(|n|n==0||n>64){return false;}
+        self.0.config.set(Config {handle,budget,refuse,latch,latch_until:latch.map(|_|Instant::now()+Duration::from_millis(100))}).is_ok()
+    }
+    pub fn release(&self) {let mut released=self.0.released.lock().unwrap_or_else(|p|p.into_inner());*released=true;self.0.wake.notify_all();}
+    pub fn snapshot(&self)->NativeVideoSendProbeSnapshot {NativeVideoSendProbeSnapshot {attempts:self.0.attempts.load(Ordering::Acquire),accepted:self.0.accepted.load(Ordering::Acquire),refused:self.0.refused.load(Ordering::Acquire),waiting:self.0.waiting.load(Ordering::Acquire),timed_out:self.0.timed_out.load(Ordering::Acquire)}}
+}
+pub(super) fn wrap(original:Arc<dyn NativeDatagramTransport>)->(Arc<dyn NativeDatagramTransport>,NativeVideoSendProbe) {
+    let state=Arc::new(State::default());let probe=NativeVideoSendProbe(state.clone());
+    (Arc::new(Probed {original,state}),probe)
+}
+struct Probed {original:Arc<dyn NativeDatagramTransport>,state:Arc<State>}
+impl StagedDatagramTransport for Probed {
+    fn maximum_datagram_bytes(&self)->Option<usize> {
+        self.original.maximum_datagram_bytes().map(|actual|self.state.config.get().map_or(actual,|config|actual.min(config.budget)))
+    }
+    fn is_closed(&self)->bool {self.original.is_closed()}
+    fn send_datagram(&self,bytes:Bytes)->rvoip_core::staged_streams::ControlResult<()> {
+        let selected=self.state.config.get().filter(|config|crate::substrate::observe_rtp_datagram(&bytes).is_ok_and(|rtp|rtp.stream_local_id==config.handle));
+        if let Some(config)=selected {
+            let ordinal=self.state.attempts.fetch_add(1,Ordering::AcqRel)+1;
+            if config.latch_until.is_some_and(|until|Instant::now()>=until) {
+                self.state.timed_out.store(true,Ordering::Release);self.state.refused.fetch_add(1,Ordering::AcqRel);
+                return Err(rvoip_core::staged_streams::StreamControlError::Backpressure);
+            }
+            if config.latch==Some(ordinal) {
+                let released=self.state.released.lock().unwrap_or_else(|p|p.into_inner());
+                self.state.waiting.store(true,Ordering::Release);
+                // A failed test cannot strand the original callback/task. It
+                // refuses BEFORE actual IO on timeout, inside the unchanged
+                // original 200ms media bound; no receipt/packet age is reset.
+                let(released,timeout)=self.state.wake.wait_timeout_while(released,config.latch_until.unwrap().saturating_duration_since(Instant::now()),|value|!*value).unwrap_or_else(|p|p.into_inner());
+                self.state.waiting.store(false,Ordering::Release);
+                if (timeout.timed_out()&&!*released)||config.latch_until.is_some_and(|until|Instant::now()>=until) {
+                    self.state.timed_out.store(true,Ordering::Release);self.state.refused.fetch_add(1,Ordering::AcqRel);
+                    return Err(rvoip_core::staged_streams::StreamControlError::Backpressure);
+                }
+            }
+            if config.refuse==Some(ordinal) {self.state.refused.fetch_add(1,Ordering::AcqRel);return Err(rvoip_core::staged_streams::StreamControlError::Backpressure);}
+            let result=self.original.send_datagram(bytes);
+            if result.is_ok(){self.state.accepted.fetch_add(1,Ordering::AcqRel);}else{self.state.refused.fetch_add(1,Ordering::AcqRel);}
+            result
+        }else {self.original.send_datagram(bytes)}
+    }
+}
+#[async_trait]
+impl NativeDatagramTransport for Probed {
+    async fn read_datagram(&self)->Result<Bytes,DispatchError> {self.original.read_datagram().await}
+}
