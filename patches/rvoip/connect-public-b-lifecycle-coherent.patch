+/// Actual original Core Port metadata. No SDP, public namespace generation,
+/// newly-generated family UUID or caller assertion substitutes for these fields.
+#[derive(Clone,Debug,PartialEq,Eq)]
+pub struct PublicVideoWarmTarget {
+    pub logical_id:StreamId,pub transport_id:StreamId,
+    pub stream_generation:u64,pub connection_generation:u64,pub physical_writer_incarnation:u128,
+}
+struct WarmOwner {
+    original:Weak<device_replacement::ReplacementIntent>,
+    frozen:FrozenVideoWarmWitness,
+    seal:Mutex<Option<PhysicalVideoExposureSeal>>,
+    witness:super::super::physical_video_exposure::PhysicalVideoSealWitness,
+    phase:AtomicU8, // 0 warm, 1 final publication owns transfer, 2 closed, 3 public
+    started:AtomicBool,
+    deadline:tokio::time::Instant,
+    initial_authority_cutoff:OnceLock<tokio::time::Instant>,
+    cancel:CancellationToken,
+    exposed:AtomicBool,
+}
+impl WarmOwner {
+    fn cutoff(&self)->tokio::time::Instant {self.initial_authority_cutoff.get().copied().unwrap_or(self.deadline).min(self.deadline)}
+    fn current(&self)->bool {
+        self.phase.load(Ordering::Acquire)==0 && self.original.strong_count()!=0 && self.frozen.is_current()
+            && self.witness.is_current()
+            && !self.cancel.is_cancelled() && tokio::time::Instant::now()<self.cutoff()
+    }
+}
+impl Drop for WarmOwner {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+        if self.exposed.load(Ordering::Acquire) {
+            // A not-transferred token may already have warm IO behind it.
+            // Never reopen raw access while candidate cleanup is outstanding.
+            if let Some(seal)=self.seal.get_mut().unwrap_or_else(|p|p.into_inner()).take() {seal.retire();}
+        }
+    }
+}
+/// Opaque Core-issued original pending-public context for one selected source
+/// and actual B Port. No public constructor, Deserialize or retained Reader.
+pub struct PostCutPublicVideoScope {
+    submission_recorder_claimed:AtomicBool,
+    submission:OnceLock<Arc<PublicVideoKeyframeSubmission>>,
+    owner:Weak<WarmOwner>,
+    published:OnceLock<PublishedVideoFloor>,
+    original:ParticipantReplacementMutation,
+    conversation:ConversationId,session:SessionId,
+    source:MediaSource,target:PublicVideoWarmTarget,
+    frontier:Arc<FrozenOldVideoFrontier>,
+}
+impl PostCutPublicVideoScope {
+    /// Immutable actual local whole-keyframe submission, not current authority
+    /// or native decode. Historical metadata remains usable during staged
+    /// token transfer; callers separately require Warm or published-current.
+    pub fn successful_keyframe_submission(&self)->Option<&Arc<PublicVideoKeyframeSubmission>> {
+        self.submission.get()
+    }
+    pub fn original_intent(&self)->&ParticipantReplacementMutation {&self.original}
+    pub fn conversation(&self)->&ConversationId {&self.conversation}
+    pub fn session(&self)->&SessionId {&self.session}
+    pub fn source(&self)->&MediaSource {&self.source}
+    pub fn target(&self)->&PublicVideoWarmTarget {&self.target}
+    pub fn frontier(&self)->&FrozenOldVideoFrontier {&self.frontier}
+    pub fn is_published(&self)->bool {self.published.get().is_some()}
+    pub fn is_current(&self)->bool {
+        self.published.get().map_or_else(||self.owner.upgrade().is_some_and(|owner|owner.current()),PublishedVideoFloor::current)
+    }
+    /// None after ordinary public adoption: the preparation cutoff is not a
+    /// public data-plane lifetime. Every packet still needs current authority.
+    pub fn deadline(&self)->Option<tokio::time::Instant> {if self.is_published(){None}else{self.owner.upgrade().map(|owner|owner.cutoff())}}
+    /// Must be called WITH the original current Core IO guards. This checks
+    /// immutable original-group provenance, not camera/content/capture birth.
+    pub fn require_original_frame(&self,original:Option<&Arc<OriginalVideoFrame>>)->ControlResult<()> {
+        if let Some(floor)=self.published.get(){return floor.require_original_frame(original);}
+        if !self.is_current() {return Err(StreamControlError::NotReady);}
+        let point=original.and_then(|frame|frame.frame_realm()).ok_or(StreamControlError::Unsupported)?;
+        if point.incarnation()!=self.frontier.realm_incarnation() || point.ordinal()<=self.frontier.ordinal() {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    pub(in crate::staged_streams) fn cancellation(&self)->ControlResult<CancellationToken> {
+        self.owner.upgrade().map(|owner|owner.cancel.clone()).ok_or(StreamControlError::Cancelled)
+    }
+}
+/// Owns ONLY temporary B routes/raw-access seal. No native writer/readiness or
+/// publication exists in W1. Drop removes only these exact routes, never A.
+pub struct PublicVideoWarmPreparation {
+    owner:Arc<WarmOwner>,gate:Weak<DirectGate>,routes:BTreeMap<StreamId,Arc<Route>>,
+    initial_picture:InitialPublicVideoPicture,
+}
+impl PublicVideoWarmPreparation {
+    /// At most one original selected-source hint. Refusal before adapter entry
+    /// is retryable only under this SAME owner and original cutoff.
+    /// Start the exact reserved output once under fresh source+Warm admissions.
+    /// No decoded readiness or publication is implied by successful setup.
+    pub async fn start(&self)->ControlResult<()> {self.initial_picture.start().await}
+    pub async fn request_initial_picture(&self)->ControlResult<()> {
+        self.initial_picture.dispatch().await
+    }
+    /// Exact plan identity only; this is not a decoded-ready or IO grant.
+    pub fn matches_original_plan(&self,plan:&crate::orchestrator::participant_control::ManagedAudioDeviceReplacementPlan)->bool {
+        plan.media().audience().replacement.as_ref().is_some_and(|intent|
+            self.owner.original.upgrade().is_some_and(|original|Arc::ptr_eq(&original,intent)))
+    }
+    pub fn scopes(&self)->Vec<&PostCutPublicVideoScope> {
+        self.routes.values().filter_map(|route|route.post_cut.as_deref()).collect()
+    }
+    pub fn is_current(&self)->bool {
+        self.owner.current() && !self.routes.is_empty() && self.routes.values().all(|route|
+            route.ticket.is_current() && route.preparation.as_ref().is_some_and(|p|p.is_current()))
+    }
+    pub fn close(&self) {
+        // Once the original final publication owns the transfer, dropping a
+        // preparation observer cannot tear down admitted public media.
+        if self.owner.phase.compare_exchange(0,2,Ordering::AcqRel,Ordering::Acquire).is_err(){return;}
+        self.owner.cancel.cancel();
+        for route in self.routes.values() {route.ticket.retire_if_current();}
+        if let Some(gate)=self.gate.upgrade() {
+            let mut routing=gate.routing.lock().unwrap_or_else(|v|v.into_inner());
+            routing.preparation.retain(|id,route|!self.routes.get(id).is_some_and(|original|Arc::ptr_eq(original,route)));
+        }
+    }
+}
+impl Drop for PublicVideoWarmPreparation {fn drop(&mut self){self.close();}}
+
+impl media_scene::GuardedMediaScene {
+    pub(crate) fn public_video_warm_unstarted(&self,plan:&device_replacement::AudioDeviceReplacementPlan)->bool {
