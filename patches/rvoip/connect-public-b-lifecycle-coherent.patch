+//! Initial scalar signaling over SAME original Core-reserved physical owner.
+//! No raw peer, track, sender, user callback or ordinary media grant escapes.
+use super::*;
+/// One original signaling claim. Cancellation/refusal cannot reset/reissue it;
+/// the original binding still owns its construction, shutdown and join tasks.
+pub struct OriginalWebRtcSignalingControl {peer:Arc<RvoipPeerConnection>,binding:Weak<WebRtcPhysicalBinding>,used:bool,deadline:tokio::time::Instant}
+impl WebRtcPhysicalBinding {
+    pub async fn signaling_control(self:&Arc<Self>,deadline:tokio::time::Instant)->Result<OriginalWebRtcSignalingControl> {
+        let peer=self.peer_internal(deadline).await?;
+        self.signaling_claimed.compare_exchange(false,true,Ordering::AcqRel,Ordering::Acquire)
+            .map_err(|_|RvoipError::AdmissionRejected("Original WebRTC signaling already claimed"))?;
+        Ok(OriginalWebRtcSignalingControl {peer,binding:Arc::downgrade(self),used:false,deadline})
+    }
+}
+impl OriginalWebRtcSignalingControl {
+    fn current(&self)->bool {self.binding.upgrade().is_some_and(|binding|binding.owner_current())}
+    pub async fn accept_offer_and_gather(&mut self,offer:&str)->crate::errors::Result<String> {
+        if self.used || !self.current() || tokio::time::Instant::now()>=self.deadline {return Err(crate::errors::WebRtcError::InvalidState("Original WebRTC signaling unavailable"));}
+        self.used=true; // before original native call, including dropped observation
+        let answer=self.peer.accept_offer_and_gather(offer).await?;
+        if !self.current() || tokio::time::Instant::now()>=self.deadline {return Err(crate::errors::WebRtcError::InvalidState("Original WebRTC signaling retired"));}
+        Ok(answer)
+    }
+    // Lifetime observations deliberately ignore the initial SDP cutoff: an
+    // admitted long-lived peer does not stop when preparation time expires.
+    pub fn is_connected(&self)->bool {self.current() && self.peer.is_connected()}
+    pub async fn wait_failed(&self) {if self.current(){self.peer.wait_failed().await;}}
+}
