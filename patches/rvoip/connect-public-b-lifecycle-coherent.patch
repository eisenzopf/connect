+//! Actual original managed plan/Warm policy/current Core guards; the adapter
+//! callback is modeled. Actual native PLI is separately controlled in RTC.
+use super::*;
+
+async fn initial_ready(room:&mut ManagedRoom)->(Ready,ConnectionId,ConnectionId,PublicVideoWarmPreparation,tokio::sync::mpsc::Receiver<QueuedMedia>) {
+    let(alice,source,retained)=actors(room).await;
+    let ready=prepared(room,&alice,&source,&retained).await;
+    let mut old=room.nodes[&source].backend.port(Medium::Video).take_egress().unwrap();
+    let(packet,first)=video_packet(&room.nodes[&retained],45000,None);let first=first.unwrap();
+    publish_packet(&room.nodes[&retained],packet,Some(first.clone())).await;
+    let family=room.nodes[&source].video_exposures[&desired(Medium::Video).logical_id].clone();
+    outgoing(&mut old).await.deliver(|_|async {family.record_potential(first.frame_realm());Ok(())}).await.unwrap();
+    let _frozen=freeze(room,&ready.plan,&ready.grant,&ready.reservation).await;
+    room.world.warm_allowed.store(true,Ordering::Release);
+    let owner=warm(room,&ready.plan,&ready.grant).await.unwrap();
+    (ready,source,retained,owner,old)
+}
+#[tokio::test]
+async fn managed_initial_picture_uses_distinct_current_warm_admission_then_consumes_one_original_attempt() {
+    let mut room=ManagedRoom::with_video(true).await;
+    let result=catch_original(async {
+        let(ready,_old,retained,owner,_old_output)=initial_ready(&mut room).await;
+        let candidate=ready.grant.intent.replacement.clone();
+        let source=room.nodes[&retained].backend.clone();
+        source.mode.store(10,Ordering::Release);
+        let before=room.nodes[&candidate].controller.revision();
+        room.world.warm_allowed.store(false,Ordering::Release);
+        let denied=matches!(owner.request_initial_picture().await,Err(StreamControlError::Unsupported));
+        let no_callback=source.initial_picture_calls.load(Ordering::Acquire)==0;
+        room.world.warm_allowed.store(true,Ordering::Release);
+        let retry=owner.request_initial_picture().await.is_ok();
+        let repeat=owner.request_initial_picture().await.is_err();
+        let count=source.initial_picture_calls.load(Ordering::Acquire);
+        let unchanged=room.nodes[&candidate].controller.revision()==before && ready.private.is_current();
+        let mut b=room.nodes[&candidate].backend.ports.lock().unwrap()[&b_id()].take_egress().unwrap();
+        let no_media=b.try_recv().is_err();
+        owner.close();
+        (denied,no_callback,retry,repeat,count,unchanged,no_media)
+    }).await;
+    let cleanup=room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done|done));
+    if let Err(error)=result {resume_unwind(error)}
+    let(denied,no_callback,retry,repeat,count,unchanged,no_media)=result.unwrap();
+    assert!(denied&&no_callback&&retry&&repeat&&count==1&&unchanged&&no_media,
+        "ordinary Receive cannot bootstrap B; same-owner retry before callback only, one hint is not media/readiness");
+}
+#[tokio::test]
+async fn managed_initial_picture_keeps_exact_source_and_b_tickets_and_destroys_pending_query_before_cleanup() {
+    let mut observations=Vec::new();
+    for action in 0..5 {
+        let mut room=ManagedRoom::with_video(true).await;
+        let result=catch_original(async {
+            let(ready,_old,retained,owner,_old_output)=initial_ready(&mut room).await;
+            let candidate=ready.grant.intent.replacement.clone();
+            let source=room.nodes[&retained].backend.clone();
+            source.mode.store(if action>=2 {11}else{10},Ordering::Release);
+            if action<=1 {
+                let controller=if action==0 {&room.nodes[&retained].controller}else{&room.nodes[&candidate].controller};
+                let logical=if action==0 {desired(Medium::Video).logical_id}else{b_id()};
+                controller.set_paused(&logical,controller.revision(),true,deadline()).await.unwrap();
+                let refused=owner.request_initial_picture().await.is_err();
+                let count=source.initial_picture_calls.load(Ordering::Acquire);
+                owner.close();
+                return (refused,true,count==0);
+            }
+            if action==4 {source.mode.store(12,Ordering::Release);}
+            let mut hint=Box::pin(owner.request_initial_picture());
+            let refused=if action==4 {
+                matches!(hint.as_mut().await,Err(StreamControlError::NotReady))
+            }else {
+                tokio::select! {biased;
+                    _=source.entered.notified()=>{},
+                    value=&mut hint=>panic!("pending original adapter unexpectedly ended: {value:?}"),
+                }
+                if action==3 {owner.close();}
+                matches!(hint.as_mut().await,Err(StreamControlError::Deadline|StreamControlError::Cancelled))
+            };
+            // No spawned query/task survives; drop the same original callback
+            // future before the repeated-attempt and all-owner cleanup checks.
+            drop(hint);
+            let repeat=owner.request_initial_picture().await.is_err();
+            let count=source.initial_picture_calls.load(Ordering::Acquire);
+            owner.close();
+            (refused,repeat,count==1)
+        }).await;
+        let cleanup=room.close_originals().await;
+        let clean=cleanup.into_iter().all(|done|done);
+        if let Err(error)=result {resume_unwind(error)}
+        let(refused,repeat,count)=result.unwrap();observations.push((action,clean,refused,repeat,count));
+    }
+    assert!(observations.iter().all(|(_,clean,refused,repeat,count)|*clean&&*refused&&*repeat&&*count),
+        "source/B retirement, pending timeout/cancel and unknown adapter error must not adopt current tickets or repeat an attempt: {observations:?}");
+}
