+            let logical=desired(Medium::Video).logical_id;let probe=old.media.original_video_send_probe_for_test().unwrap();assert!(probe.arm(binding(&old,Medium::Video).stream_local_id,400,None,Some(1)));
+            let mut input=source.controller.take_ingress(&logical).unwrap();let original=forward_original(&room,&source,&old,&mut input,1).await;
+            until_probe(&probe,|v|v.waiting&&v.attempts==1&&v.accepted==0).await;
+            let before=old.controller.native_video_potential_for_test(&logical).unwrap();let point=original.frame_realm().unwrap();
