+//! Historical exact cancelled candidate + current OLD/source restoration.
+//! Core never imports or constructs a native ClosedOriginalCandidate token.
+use super::*;
+use crate::orchestrator::participant_control::replacement::DeviceReplacementPreparation;
+use crate::participant_transitions::ParticipantReplacementMutation;
+use crate::staged_streams::direct_subscriptions::restore_sources::RestoreSources;
+pub use crate::staged_streams::direct_subscriptions::restore_sources::OldVideoRestoreSource;
+
+/// No public constructor/Deserialize/Clone. Host's dedicated current policy
+/// MUST own and verify the actual SAME native closed token plus fresh OLD
+/// source authority. The cancellation identity alone is never close evidence.
+pub struct OldVideoRestoreScope {
+    preparation:Weak<DeviceReplacementPreparation>,original:ParticipantReplacementMutation,
+    frontier:Arc<FrozenOldVideoFrontier>,conversation:ConversationId,session:SessionId,
+    sources:RestoreSources,
+}
+impl OldVideoRestoreScope {
+    pub fn original_intent(&self)->&ParticipantReplacementMutation {&self.original}
+    pub fn frontier(&self)->&FrozenOldVideoFrontier {&self.frontier}
+    pub fn conversation(&self)->&ConversationId {&self.conversation}
+    pub fn session(&self)->&SessionId {&self.session}
+    pub fn old_connection(&self)->&ConnectionId {self.frontier.source_connection()}
+    pub fn target_connection(&self)->&ConnectionId {self.frontier.target_connection()}
+    pub fn selected_sources(&self)->&[OldVideoRestoreSource] {self.sources.descriptors()}
+    pub fn matches_original_preparation(&self,p:&Arc<DeviceReplacementPreparation>)->bool {
+        Weak::ptr_eq(&self.preparation,&Arc::downgrade(p))
+    }
+}
+/// Resource metadata only. No Closed token, fresh current policy, admission
+/// or restore grant is represented by either variant.
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum OldVideoRestoreResourceState {Ready,SelectedSourcePaused}
+pub struct OldVideoRestoreReadiness {sources:Vec<MediaSource>,state:OldVideoRestoreResourceState}
+impl OldVideoRestoreReadiness {
+    pub fn sources(&self)->&[MediaSource] {&self.sources}
+    pub fn resource_state(&self)->OldVideoRestoreResourceState {self.state}
+}
+impl media_scene::GuardedMediaScene {
+    pub(crate) fn old_video_restore_source_hints(
+        &self, plan:&device_replacement::AudioDeviceReplacementPlan,
+        preparation:&Arc<DeviceReplacementPreparation>,
+    )->ControlResult<Vec<MediaSource>> {
+        Ok(self.old_video_restore_snapshot(plan,preparation,false)?.sources)
+    }
+    pub(crate) fn old_video_restore_readiness(
+        &self,plan:&device_replacement::AudioDeviceReplacementPlan,preparation:&Arc<DeviceReplacementPreparation>,
+    )->ControlResult<OldVideoRestoreReadiness> {self.old_video_restore_snapshot(plan,preparation,true)}
+    fn old_video_restore_snapshot(
+        &self,plan:&device_replacement::AudioDeviceReplacementPlan,preparation:&Arc<DeviceReplacementPreparation>,allow_paused:bool,
+    )->ControlResult<OldVideoRestoreReadiness> {
+        let audience=plan.audience();
+        let intent=audience.replacement.as_ref().ok_or(StreamControlError::Authority)?;
+        let owner={
+            let slot=intent.video_freeze.state.try_lock().map_err(metadata_lock_error)?;
+            match &*slot {FreezeState::Frozen(owner)=>owner.clone(),_=>return Err(StreamControlError::NotReady)}
+        };
+        if audience.scene!=self.id || owner.intent.upgrade().is_none_or(|original|!Arc::ptr_eq(&original,intent))
+            || owner.frontier.operation_id()!=preparation.intent().operation_id
+            || owner.frontier.source_connection()!=&preparation.intent().source
+            || owner.frontier.target_connection()!=&preparation.intent().replacement {
+            return Err(StreamControlError::Authority);
+        }
+        if owner.native.as_ref().is_some_and(|witness|!witness.is_current()) {
+            return Err(StreamControlError::NotReady);
+        }
+        let old=owner.old.upgrade().ok_or(StreamControlError::Cancelled)?;
+        {
+            let members=self.members.try_lock().map_err(metadata_lock_error)?;
+            if members.get(&old.connection).is_none_or(|member|!Arc::ptr_eq(&member.controller,&old)) {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        old.check_credential_snapshot(&owner.credential)?;
+        let state=old.state.try_lock().map_err(metadata_lock_error)?;
+        if old.shutdown.is_cancelled() || state.closed || state.model.revision()!=owner.revision {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        // Keep the exact frozen set/seal alive during the snapshot without
+        // unpausing, moving or replacing any original resource. Unlike the
+        // effectful restore helper, every metadata lock here is a try-lock.
+        let retained=owner.held.try_lock().map_err(metadata_lock_error)?;
+        let retained=retained.as_ref().ok_or(StreamControlError::NotReady)?;
+        let active=visual_sinks(&state)?;
+        if active.len()!=retained.ports.len() || active.iter().any(|port|
+            !retained.ports.iter().any(|original|Arc::ptr_eq(port,&original.port))) {
+            return Err(StreamControlError::Authority);
+        }
+        let seal=retained.seal.as_ref().ok_or(StreamControlError::NotReady)?;
+        for original in &retained.ports {
+            let status=original.port.state.try_lock().map_err(metadata_lock_error)?;
+            if !status.ready || !matches!(status.status,PortStatus::Active|PortStatus::Paused)
+                || !original.ticket.is_current()
+                || !original.port.ticket(TicketSide::Egress).same_generation(&original.ticket) {
+                return Err(StreamControlError::NotReady);
+            }
+            drop(status);
+            let physical=AdapterMediaPort(original.port.clone()).physical_video_exposure_sealed(seal.as_seal())
+                .ok_or(StreamControlError::Unsupported)?;
+            if !physical.coverage_complete || physical.physical_family!=original.family
+                || physical.realm_incarnation!=Some(owner.frontier.realm_incarnation())
+                || physical.maximum_potential_ordinal>owner.frontier.ordinal()
+                || physical.inherited_potential_ordinal>owner.frontier.ordinal() {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        let selected=if allow_paused {old.capture_video_restore_readiness(&state,&active)?}
+            else {old.capture_video_restore_sources(&state,&active)?};
+        selected.validate()?;
+        // Owner-held proof is still borrowed: no post-effect taken/released
+        // state can yield a retryable snapshot. Frozen slot cannot change while
+        // the original orchestrator p.flight is held across this call.
+        let state=if selected.has_paused_source(){OldVideoRestoreResourceState::SelectedSourcePaused}else{OldVideoRestoreResourceState::Ready};
+        Ok(OldVideoRestoreReadiness {sources:selected.descriptors().iter().map(|selected|selected.source().clone()).collect(),state})
+    }
+    pub(crate) fn restore_old_video(
+        &self,plan:&device_replacement::AudioDeviceReplacementPlan,preparation:&Arc<DeviceReplacementPreparation>,
+        held:&(dyn Any+Send+Sync),historical:&(dyn Fn()->ControlResult<()>+Send+Sync),
+    )->ControlResult<()> {
+        historical()?;
+        let intent=plan.audience().replacement.as_ref().ok_or(StreamControlError::Authority)?;
+        let owner=intent.video_freeze.owner().ok_or(StreamControlError::NotReady)?;
+        if owner.intent.upgrade().is_none_or(|original|!Arc::ptr_eq(&original,intent)) {
+            return Err(StreamControlError::Authority);
+        }
+        let old=owner.old.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if plan.audience().scene!=self.id || old.shutdown.is_cancelled()
+            || owner.frontier.operation_id()!=preparation.intent().operation_id
+            || owner.frontier.source_connection()!=&preparation.intent().source
+            || owner.frontier.target_connection()!=&preparation.intent().replacement {
+            return Err(StreamControlError::Authority);
+        }
+        // Candidate registry removal is expected after actual joins. It may
+        // not substitute another retained OLD owner or programme/Port set.
+        {
+            let members=self.members.try_lock().map_err(metadata_lock_error)?;
+            if members.get(&old.connection).is_none_or(|member|!Arc::ptr_eq(&member.controller,&old)) {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        old.check_credential_snapshot(&owner.credential)?;
+        let state=old.state.try_lock().map_err(metadata_lock_error)?;
+        owner.validate_old_state(&state)?;
+        let ports={let retained=owner.held.try_lock().map_err(metadata_lock_error)?;
+            retained.as_ref().ok_or(StreamControlError::NotReady)?.ports.iter().map(|entry|entry.port.clone()).collect::<Vec<_>>()};
+        let scope=OldVideoRestoreScope {preparation:Arc::downgrade(preparation),original:preparation.intent().clone(),
+            frontier:owner.frontier.clone(),conversation:old.conversation.clone(),session:old.session.clone(),
+            sources:old.capture_video_restore_sources(&state,&ports)?};
+        let media_scope=old.scope(&owner.credential.principal,MediaPurpose::Control);
+        // No generic current_control fallback: Host owns historical native
+        // close verification and current, non-target OLD source Readers.
+        let control=old.policy.current_original_old_video_restore(&media_scope,&scope,held)?;
+        control.valid()?;
+        let authority=control.authority()?;StreamController::check(&media_scope,&authority)?;
+        state.model.authorize_binding(&authority.current())?;
+        if !authority.may_control {return Err(StreamControlError::Authority);}
+        for selected in scope.selected_sources() {
+            let source=selected.source();let receive_scope=MediaScope {purpose:MediaPurpose::Receive {source},..media_scope};
+            let receive=control.lease.control_receive(source)?;
+            StreamController::check(&receive_scope,&receive)?;
+            state.model.authorize_binding(&receive.current())?;
+            if !receive.may_route_source || !receive.send_media.contains(&selected.medium()) {return Err(StreamControlError::Authority);}
+        }
+        // All checks precede the ownership effect. Expired TARGET/Root state is
+        // never consulted as permission; SAME original OLD credentials remain.
+        control.valid()?;historical()?;scope.sources.validate()?;
+        old.check_credential_snapshot(&owner.credential)?;owner.validate_old_state(&state)?;
+        if old.shutdown.is_cancelled(){return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=StreamController::command_deadline(&owner.credential.principal,control.deadline) {return Err(StreamControlError::Deadline);}
+        let members=self.members.try_lock().map_err(metadata_lock_error)?;
+        if members.get(&old.connection).is_none_or(|member|!Arc::ptr_eq(&member.controller,&old)) {return Err(StreamControlError::Authority);}
+        let mut slot=intent.video_freeze.state.try_lock().map_err(metadata_lock_error)?;
+        if !matches!(&*slot,FreezeState::Frozen(original) if Arc::ptr_eq(original,&owner)) {return Err(StreamControlError::Authority);}
+        let mut retained=owner.held.try_lock().map_err(metadata_lock_error)?.take().ok_or(StreamControlError::NotReady)?;
+        owner.warm_live.store(false,Ordering::Release); // before any original token/drain release
+        // Same published token returns before SAME old guards can reopen. First
+        // ordinary OLD only releases its temporary no-escape seal after Host
+        // verified actual closed B. Failure after taking this ownership retires
+        // its original tickets through the existing fail-closed RAII Drop.
+        retained.seal.take().ok_or(StreamControlError::NotReady)?.return_after_validated_restore(&old)?;
+        retained.ports.clear(); // qualified success alone disarms fail-closed Drop
+        retained.guards.clear(); // original generation unpauses, never a new ticket
+        *slot=FreezeState::Terminal; // no F reuse after OLD can attempt another frame
+        drop(retained); // original controller flight releases after exact guards
+        Ok(())
+    }
+}
