+//! Distinct current public-candidate Read, not private permission or Commit.
+use super::*;
+impl Orchestrator {
+    pub fn prepare_staged_public_video_warm_with_held(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,held:&(dyn Any+Send+Sync),
+    )->ControlResult<crate::staged_streams::direct_subscriptions::PublicVideoWarmPreparation> {
+        self.public_video_warm_attempt(plan,held,false)?
+            .ok_or(ParticipantControlError::Media(StreamControlError::NotReady))
+    }
+    /// None certifies typed MetadataBusy before this exact intent's one-shot
+    /// warm flag. No route/native start is replayed under a later Reader.
+    pub fn try_prepare_staged_public_video_warm_with_held(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,held:&(dyn Any+Send+Sync),
+    )->ControlResult<Option<crate::staged_streams::direct_subscriptions::PublicVideoWarmPreparation>> {
+        self.public_video_warm_attempt(plan,held,true)
+    }
+    fn public_video_warm_attempt(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,held:&(dyn Any+Send+Sync),defer_metadata:bool,
+    )->ControlResult<Option<crate::staged_streams::direct_subscriptions::PublicVideoWarmPreparation>> {
+        let p=&plan.preparation;
+        self.owns_replacement(p)?;p.check()?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let result=(||->ControlResult<_> {
+        let request=scope(p,ReplacementPhase::WarmVideo,Some(&plan.media));
+        let control=p.runtime.policy.current_replacement_control(&request,held)?;
+        let validate=||->std::result::Result<(),StreamControlError> {
+            self.owns_replacement(p).map_err(handoff::media_error)?;
+            p.check().map_err(handoff::media_error)?;
+            let authority=control.current(&request).map_err(handoff::media_error)?;
+            check_authority(&request,&authority).map_err(handoff::media_error)?;
+            if plan.media.old_may_speak() && !authority.may_send_audio {return Err(StreamControlError::Authority);}
+            Ok(())
+        };
+        validate()?;
+        let scene=p.runtime.mixer.staged.as_ref().ok_or(ParticipantControlError::Unsupported)?;
+        let reservation=p.public_video_reservation.current(p)?;
+        Ok(scene.prepare_public_video_warm(&plan.media,&p.intent,p.preparation_identity(),&reservation,
+            deadline_for(&p.principal,p.deadline.min(control.deadline)),p.cancellation.clone(),held,&validate)?)
+        })();
+        if defer_metadata && matches!(&result,Err(ParticipantControlError::Media(StreamControlError::MetadataBusy)))
+            && p.runtime.mixer.staged.as_ref().is_some_and(|scene|scene.public_video_warm_unstarted(&plan.media)) {
+            self.owns_replacement(p)?;p.check()?;
+            return Ok(None);
+        }
+        result.map(Some)
+    }
+}
