+++ b/crates/foundation/rvoip-core/src/orchestrator/participant_control/replacement/public_video_reservation.rs
@@ -0,0 +1,53 @@
+//! Original resource-only B reservation before private-ready or OLD freeze.
+use super::*;
+impl Orchestrator {
+    pub fn prepare_staged_public_video_reservation_with_held(
+        self:&Arc<Self>,p:&Arc<DeviceReplacementPreparation>,public_stream:&StreamId,
+        held:&(dyn Any+Send+Sync),
+    )->ControlResult<crate::staged_streams::public_video_reservation::PublicVideoReservationPreparation> {
+        self.public_video_reservation_attempt(p,public_stream,held,false)?
+            .ok_or(ParticipantControlError::Media(StreamControlError::NotReady))
+    }
+    /// None is ONLY typed pre-effect MetadataBusy while the SAME original
+    /// reservation slot is unused. The original p.flight stays held through
+    /// classification; dead Weak/used/unknown/other errors never become None.
+    pub fn try_prepare_staged_public_video_reservation_with_held(
+        self:&Arc<Self>,p:&Arc<DeviceReplacementPreparation>,public_stream:&StreamId,
+        held:&(dyn Any+Send+Sync),
+    )->ControlResult<Option<crate::staged_streams::public_video_reservation::PublicVideoReservationPreparation>> {
+        self.public_video_reservation_attempt(p,public_stream,held,true)
+    }
+    fn public_video_reservation_attempt(
+        self:&Arc<Self>,p:&Arc<DeviceReplacementPreparation>,public_stream:&StreamId,
+        held:&(dyn Any+Send+Sync), defer_metadata:bool,
+    )->ControlResult<Option<crate::staged_streams::public_video_reservation::PublicVideoReservationPreparation>> {
+        self.owns_replacement(p)?;p.check()?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let result=(||->ControlResult<_> {
+        if p.public_video_reservation.is_used() {return Err(ParticipantTransitionError::NotReady.into());}
+        let request=scope(p,ReplacementPhase::ReserveVideo,None);
+        let control=p.runtime.policy.current_replacement_control(&request,held)?;
+        check_authority(&request,&control.current(&request)?)?;
+        // Actual original attachment must exist, but private media confirmation
+        // and the final device plan are intentionally not prerequisites.
+        if p.state.try_lock().map_err(|_|ParticipantTransitionError::Conflict)?.context.is_none() {
+            return Err(ParticipantTransitionError::NotReady.into());
+        }
+        let target=self.adapter_for(&p.intent.replacement)?.staged_controller(&p.intent.replacement)
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let realm=p.runtime.frame_realm.as_ref().and_then(|realm|realm.handle().incarnation()).ok_or(ParticipantControlError::Unsupported)?;
+        let owner=target.reserve_public_video(p,p.preparation_identity(),realm,public_stream,
+            deadline_for(&p.principal,p.deadline.min(control.deadline)),p.cancellation.clone(),held)?;
+        self.owns_replacement(p)?;p.check()?;
+        check_authority(&request,&control.current(&request)?)?;
+        p.public_video_reservation.install(&owner)?;
+        Ok(owner)
+        })();
+        if defer_metadata && matches!(&result,Err(ParticipantControlError::Media(StreamControlError::MetadataBusy)))
+            && !p.public_video_reservation.is_used() {
+            self.owns_replacement(p)?;p.check()?;
+            return Ok(None);
+        }
+        result.map(Some)
+    }
+}
