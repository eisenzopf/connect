+            &source_port,&self.source_ticket,false,None,audio_consumer::ConsumerCheck::Retained(None),None,
+            scene_consumer::SceneCheck::retained_publish(self.source_scene.as_ref()),None,None,None,Some(&mut deadline))?;
+        deadline=deadline.min(source_bound);
+        // The exact pending-public stamp selects current_public_video_warm;
+        // never ordinary receive authorization or a private-preroll bypass.
+        let (target_lease,target_guard,target_bound)=target.admit_with_deadline(
+            &target_port,&self.target_ticket,true,Some(scope.source()),audio_consumer::ConsumerCheck::Retained(None),Some(&self.direct),
+            scene_consumer::SceneCheck::retained_receive(self.target_scene.as_ref(),self.source_scene.as_ref(),Instant::now()),
+            None,None,None,Some(&mut deadline))?;
+        deadline=deadline.min(target_bound);
+        let mut tokens=vec![source.shutdown.clone(),target.shutdown.clone(),self.direct.cancel.clone(),cancel.clone()];
+        for scene in [&self.source_scene,&self.target_scene].into_iter().flatten() {tokens.push(scene.cancel.clone());}
+        let admitted=QueuedMediaAdmission {target,tokens:tokens.clone(),deadline,
+            _leases:vec![source_lease,target_lease],_subscriptions:Vec::new(),_admissions:vec![source_guard,target_guard]};
