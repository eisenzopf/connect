+//! Actual original Endpoint source-lock contention, not a simulated adapter
+//! mode. Ordinary hint/send behavior remains Backpressure and once-only.
+use super::*;
+#[test]
+fn original_source_preflight_lock_contention_is_definitely_metadata_only_and_same_epoch_retryable() {
+    let(endpoint,wire,transport,notices,current)=endpoint();
+    endpoint.published(99,clock(current),1,3000).unwrap();
+    let original=notices.values.lock().unwrap()[0];
+    let held=endpoint.source.lock().unwrap();
+    let preflight=endpoint.preflight_initial(&binding(),&transport);
+    let ordinary=endpoint.dispatch(99);
+    assert_eq!(held.sequence,0);assert!(held.next.is_none());
+    assert_eq!(wire.attempts.load(Ordering::Acquire),0);drop(held);
+    let resumed=endpoint.preflight_initial(&binding(),&transport);
+    let sent=endpoint.request_initial(&binding(),&transport,&||true);
+    let packets=wire.packets.lock().unwrap().clone();endpoint.cancel.cancel();
+    assert!(matches!(preflight,Err(StreamControlError::MetadataBusy)));
+    assert!(matches!(ordinary,Err(StreamControlError::Backpressure)));
+    resumed.unwrap();sent.unwrap();assert_eq!(packets.len(),1);
+    let actual=observe_video_feedback_datagram(&packets[0]).unwrap();
+    assert_eq!(actual.activation_epoch,original.epoch);assert_eq!(actual.seq,0);
+    assert_eq!(notices.values.lock().unwrap().len(),1);
+}
