+        assert!(scope.original_intent()==&ready.grant.intent);assert_eq!(scope.frontier().ordinal(),frozen.ordinal());
+        assert_eq!(scope.target().logical_id,b_id());assert_eq!(scope.target().transport_id,b_port.binding().transport_id);
+        assert_eq!(scope.target().physical_writer_incarnation,room.nodes[&candidate].video_exposures[&b_id()].observer().snapshot().unwrap().physical_family);
+        assert_eq!(room.nodes[&candidate].controller.revision(),revision);assert_eq!(room.nodes[&source].controller.revision(),old_revision);
+        assert!(warm(&room,&ready.plan,&ready.grant).await.is_err());
+        // Known duplicate original group receives no fresh ordinal on fanout.
+        let(packet,_)=video_packet(&room.nodes[&retained],9000,Some(first.clone()));
