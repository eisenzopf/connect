+        let repair=queued.deliver_video_with_repair(|_,_|async {b_family.record_potential(next.frame_realm());io.fetch_add(1,Ordering::AcqRel);Ok(())}).await.unwrap();
+        assert!(Arc::ptr_eq(repair.original_video_frame().unwrap(),&next));
