+#[tokio::test]
+async fn published_source_switch_p_frame_performs_native_io_without_pending_bootstrap_or_new_receipt() {
+    let realm=realm();let original=frame(&realm,9000);let source1=source(1);let source2=source(2);
+    let mut progress=BootstrapProgress::default();
+    let(receipt,_)=fragment(&mut progress,&source1,packet(1,9000,true,true,true),&original,0).await;
+    assert!(Arc::ptr_eq(receipt.as_ref().unwrap(),&original));
+    let later=frame(&realm,12000);let delta=packet(2,12000,true,true,false);
+    assert!(progress.preview_for_phase(false,&source2,&delta,&later).is_err(),"pending B still requires its new source keyframe");
+    // This is the exact production phase branch, not a synthesized Core
+    // published owner. A real managed publication/feedback control below the
+    // Core boundary separately establishes the current public class.
+    let next=progress.preview_for_phase(true,&source2,&delta,&later).unwrap();
