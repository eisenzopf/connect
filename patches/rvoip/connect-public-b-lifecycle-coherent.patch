+async fn select(source:&Leg,target:&Leg) {
+    use rvoip_core::staged_streams::direct_subscriptions::{DirectSubscription,DirectSubscriptionChange};
+    target.controller.change_direct_subscriptions(target.controller.revision(),DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&source.controller,desired(Medium::Video).logical_id,desired(Medium::Video).logical_id)]),deadline(),CancellationToken::new(),None).await.unwrap();
+}
+fn original_packet(handle:u16,sequence:u16)->Bytes {
+    let mut packet=vec![0x80,0x80|96];packet.extend_from_slice(&sequence.to_be_bytes());packet.extend_from_slice(&(u32::from(sequence)*3000).to_be_bytes());packet.extend_from_slice(&7u32.to_be_bytes());
+    packet.extend_from_slice(&[0x10,1,2,3]);packet.resize(1012,7); // actual RTP input <= original Core1180 bound
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {flags:0,stream_local_id:handle,seq:u32::from(sequence),rtp:observe_rtp(packet.into()).unwrap()}).unwrap()
+}
+async fn until_probe(probe:&NativeVideoSendProbe,predicate:impl Fn(NativeVideoSendProbeSnapshot)->bool) {
+    tokio::time::timeout(Duration::from_millis(80),async {while !predicate(probe.snapshot()){tokio::task::yield_now().await;}}).await.unwrap();
+}
+async fn forward_original(room:&OwnedRoom,source:&Leg,target:&Leg,input:&mut mpsc::Receiver<MediaPacket>,sequence:u16)->Arc<rvoip_core::staged_streams::OriginalVideoFrame> {
