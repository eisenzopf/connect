+//! Actual RTP borrowed-writer calls through the production bootstrap-progress
+//! helper. No opaque Core submission receipt/native decoder is fabricated.
+use super::*;
+use rvoip_core::{ids::{ConnectionId,ConversationId,SessionId,StreamId},staged_streams::{OriginalVideoFrame,frame_realm::FrameRealmTestOwner}};
+
+struct NativeIo {mode:u8,attempted:bool,written:bool,packets:Vec<rtp::Packet>,control:OwnedRtpControl}
+impl NativeIo {
+    fn new(mode:u8)->Self {Self {mode,attempted:false,written:false,packets:vec![],control:OwnedRtpControl::new(std::time::Instant::now()+std::time::Duration::from_secs(1))}}
+}
+#[async_trait::async_trait]
+impl OwnedRtpIo for NativeIo {
+    async fn write(&mut self,packet:rtp::Packet)->rtc::shared::error::Result<()> {
+        self.attempted=true;
+        match self.mode {
+            0=>{self.written=true;self.packets.push(packet);Ok(())},
+            1=>Err(rtc::shared::error::Error::ErrRTPTransceiverCodecUnsupported),
+            2=>{self.written=true;self.packets.push(packet);Err(rtc::shared::error::Error::ErrRTPTransceiverCodecUnsupported)},
+            3=>Ok(()),
+            _=>std::future::pending().await,
+        }
+    }
+    async fn write_with_clock(&mut self,packet:rtp::Packet,_:SenderClockHandle,_:Option<SenderClockUpdate>)->rtc::shared::error::Result<()> {self.write(packet).await}
+    fn attempted(&self)->bool {self.attempted}
+    fn written(&self)->bool {self.written}
+    fn submission_control(&self)->OwnedRtpControl {self.control.clone()}
+}
+fn source(generation:u64)->Source {Source {ssrc:7,origin:MediaDeliveryOrigin {connection:ConnectionId::from_string("source"),logical:StreamId::from_string("video"),transport:StreamId::from_string("transport"),generation}}}
+fn packet(seq:u16,ts:u32,marker:bool,start:bool,key:bool)->rtp::Packet {
+    rtp::Packet {header:rtp::Header {version:2,ssrc:7,sequence_number:seq,timestamp:ts,marker,payload_type:96,..Default::default()},
+        payload:if start {vec![0x10,if key{0}else{1},0,0,0x9d,1,0x2a,0x80,2,0x68,1]}else{vec![0,8,9]}.into()}
+}
+fn realm()->FrameRealmTestOwner {FrameRealmTestOwner::new(ConversationId::from_string("conversation"),SessionId::from_string("session"))}
+fn frame(owner:&FrameRealmTestOwner,ts:u32)->Arc<OriginalVideoFrame> {OriginalVideoFrame::observed_in_realm(19,7,ts,u64::from(ts),Some(&owner.handle()))}
+async fn fragment(progress:&mut BootstrapProgress,source:&Source,packet:rtp::Packet,original:&Arc<OriginalVideoFrame>,mode:u8)->(Option<Arc<OriginalVideoFrame>>,NativeIo) {
+    let next=progress.preview(source,&packet,original).unwrap();
+    let mut io=NativeIo::new(mode);let before=io.written();
+    let result=io.write_with_clock(packet,SenderClockHandle::default(),None).await;
+    let receipt=if result.is_ok(){progress.commit_after_io(next,original,before,&io)}else{None};
+    (receipt,io)
+}
+
+#[tokio::test]
+async fn whole_post_f_keyframe_progress_requires_successful_native_final_fragment_and_retains_same_original_arc() {
+    let realm=realm();let original=frame(&realm,9000);let source=source(1);
+    let mut progress=BootstrapProgress::default();
+    let(first,first_io)=fragment(&mut progress,&source,packet(u16::MAX,9000,false,true,true),&original,0).await;
+    assert!(first.is_none());assert_eq!(first_io.packets.len(),1);
+    let(last,last_io)=fragment(&mut progress,&source,packet(0,9000,true,false,true),&original,0).await;
+    assert!(Arc::ptr_eq(last.as_ref().unwrap(),&original));assert_eq!(last_io.packets.len(),1);
+    let later=frame(&realm,12000);
+    let(delta,delta_io)=fragment(&mut progress,&source,packet(1,12000,true,true,false),&later,0).await;
+    assert!(delta.is_none(),"an already-open P-frame is not another bootstrap completion");
+    assert!(delta_io.written());
+    let mut single=BootstrapProgress::default();
+    let(complete,io)=fragment(&mut single,&source,packet(8,9000,true,true,true),&original,0).await;
+    assert!(Arc::ptr_eq(complete.as_ref().unwrap(),&original));assert_eq!(io.packets.len(),1);
+}
+
+#[tokio::test]
+async fn failed_partial_unknown_zero_and_cancelled_native_keyframe_writes_never_complete_submission() {
+    let realm=realm();let source=source(1);
+    for mode in [1,2,3,4] {
+        for fail_last in [false,true] {
+            let original=frame(&realm,9000);let mut progress=BootstrapProgress::default();
+            if fail_last {let(receipt,_)=fragment(&mut progress,&source,packet(10,9000,false,true,true),&original,0).await;assert!(receipt.is_none());}
+            let packet=if fail_last{packet(11,9000,true,false,true)}else{packet(10,9000,true,true,true)};
+            if mode==4 {
+                let _next=progress.preview(&source,&packet,&original).unwrap();
+                let mut io=NativeIo::new(mode);
+                let mut write=Box::pin(io.write_with_clock(packet,SenderClockHandle::default(),None));
+                std::future::poll_fn(|cx|{assert!(std::future::Future::poll(write.as_mut(),cx).is_pending());std::task::Poll::Ready(())}).await;
+                drop(write);assert!(io.attempted()&&!io.written());
+            } else {
+                let(receipt,io)=fragment(&mut progress,&source,packet,&original,mode).await;
+                assert!(receipt.is_none());assert_eq!(io.written(),mode==2);
+            }
+            assert!(!matches!(progress.bootstrap,Bootstrap::Open {..}));
+            // A new actual accepted source group/keyframe can recover; no
+            // reset/mint is applied to the failed original group or IO.
+            let fresh=frame(&realm,12000);
+            let(receipt,_)=fragment(&mut progress,&source,self::packet(14,12000,true,true,true),&fresh,0).await;
+            assert!(Arc::ptr_eq(receipt.as_ref().unwrap(),&fresh));
+        }
+    }
+}
