+        let repeated=outgoing(&mut b).await;
+        assert!(Arc::ptr_eq(repeated.original_video_frame().unwrap(),&first));
+        let io=AtomicUsize::new(0);
+        let refused=repeated.deliver(|_|async {io.fetch_add(1,Ordering::AcqRel);Ok(())}).await;
+        assert!(matches!(refused,Err(StreamControlError::Authority)));assert_eq!(io.load(Ordering::Acquire),0);
+        let(packet,next)=video_packet(&room.nodes[&retained],12000,None);let next=next.unwrap();
+        publish_packet(&room.nodes[&retained],packet,Some(next.clone())).await;
+        let queued=outgoing(&mut b).await;assert!(Arc::ptr_eq(queued.original_video_frame().unwrap(),&next));
