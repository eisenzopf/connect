+//! Real endpoint serializer/sequence/rate controls; Core borrowed-request and
+//! actual QUIC/WT warm integration remain separate qualification obligations.
+use super::*;
+use crate::substrate::observe_video_feedback_datagram;
+use std::sync::atomic::{AtomicBool, AtomicUsize};
+
+#[derive(Default)]
+struct Wire {
+    packets: Mutex<Vec<Bytes>>,
+    attempts: AtomicUsize,
+    refuse: AtomicBool,
+    closed: AtomicBool,
+}
+impl StagedDatagramTransport for Wire {
+    fn maximum_datagram_bytes(&self) -> Option<usize> { Some(1200) }
+    fn send_datagram(&self, packet: Bytes) -> ControlResult<()> {
+        self.attempts.fetch_add(1, Ordering::AcqRel);
+        if self.refuse.load(Ordering::Acquire) { return Err(StreamControlError::Backpressure); }
+        self.packets.lock().unwrap().push(packet);
+        Ok(())
+    }
+    fn is_closed(&self) -> bool { self.closed.load(Ordering::Acquire) }
+}
+#[derive(Default)]
+struct Notices {
+    values: Mutex<Vec<VideoFeedbackEpoch>>,
+    refuse: AtomicBool,
+}
+impl VideoFeedbackProfile for Notices {
+    fn announce(&self, _: &ReadyMediaBinding, epoch: VideoFeedbackEpoch, _: Arc<dyn Fn() -> bool + Send + Sync>) -> ControlResult<()> {
+        if self.refuse.load(Ordering::Acquire) { return Err(StreamControlError::Backpressure); }
+        self.values.lock().unwrap().push(epoch);
+        Ok(())
+    }
+}
+fn binding() -> ReadyMediaBinding {
+    ReadyMediaBinding {
+        negotiated: rvoip_core::stream_lifecycle::NegotiatedStream {
+            requested: rvoip_core::stream_lifecycle::DesiredStream {
+                logical_id: StreamId::from_string("original-camera"),
+                medium: Medium::Video, direction: StreamDirection::Receive,
+            },
+            format: MediaFormat::Encoded { name: "vp8".into(), clock_rate_hz: 90000, channels: 0, fmtp: None },
+        },
+        transport_id: StreamId::from_string("original-transport"), stream_local_id: 7,
+        generation: 3, connection_generation: 11, source_ready: true, sink_ready: false,
+    }
+}
+fn clock(current: Arc<AtomicBool>) -> MediaSourceClock {
+    MediaSourceClock { source_id: 17, generation: 1, anchor: None, supported: true,
+        rtp_offset: 0, is_current: Arc::new(move || current.load(Ordering::Acquire)) }
+}
+fn endpoint() -> (Arc<Endpoint>, Arc<Wire>, Arc<dyn StagedDatagramTransport>, Arc<Notices>, Arc<AtomicBool>) {
+    let wire = Arc::new(Wire::default());
+    let transport: Arc<dyn StagedDatagramTransport> = wire.clone();
+    let notices = Arc::new(Notices::default());
+    let current = Arc::new(AtomicBool::new(true));
+    let endpoint = Endpoint::new(binding(), notices.clone(), transport.clone(),
+        CancellationToken::new(), CancellationToken::new(), None).unwrap();
+    (endpoint, wire, transport, notices, current)
+}
+
+#[test]
+fn native_initial_hint_uses_actual_announced_source_epoch_and_existing_feedback_rate_sequence() {
+    let (endpoint, wire, transport, notices, current) = endpoint();
+    endpoint.published(0x12345678, clock(current), 19, 27000).unwrap();
+    let original = notices.values.lock().unwrap()[0];
+    let result = endpoint.request_initial(&binding(), &transport, &|| true);
+    let first = wire.packets.lock().unwrap().first().map(|p| observe_video_feedback_datagram(p).unwrap());
+    let duplicate = endpoint.request_initial(&binding(), &transport, &|| true);
+    // Deterministically model expiry of the ORIGINAL shared limiter; no sleep,
+    // new epoch, transport, grant or sequence reset is introduced.
+    endpoint.source.lock().unwrap().next = None;
+    let ordinary = endpoint.dispatch(original.ssrc);
+    let packets = wire.packets.lock().unwrap().clone();
+    let notices_count = notices.values.lock().unwrap().len();
+    let receiver_absent = endpoint.receiver.lock().unwrap().is_none();
+    endpoint.cancel.cancel();
+    result.unwrap(); ordinary.unwrap();
+    assert!(matches!(duplicate, Err(StreamControlError::Backpressure)));
+    let first = first.unwrap();
+    assert_eq!(first.stream_local_id, 7); assert_eq!(first.media_ssrc, original.ssrc);
+    assert_eq!(first.activation_epoch, original.epoch); assert_eq!(first.seq, 0);
+    assert_eq!(packets.len(), 2);
+    let second = observe_video_feedback_datagram(&packets[1]).unwrap();
+    assert_eq!(second.seq, 1); assert_eq!(second.activation_epoch, original.epoch);
+    assert_eq!(notices_count, 1, "initial hint never mints or reannounces a publisher epoch");
+    assert!(receiver_absent, "no successful receiver-feedback provenance is fabricated");
+}
+
+#[test]
+fn native_initial_hint_refuses_missing_unannounced_foreign_retired_and_cancelled_originals_without_io() {
+    for mode in 0..9 {
+        let (endpoint, wire, transport, notices, current) = endpoint();
+        if mode != 0 {
+            if mode == 1 { notices.refuse.store(true, Ordering::Release); }
+            let published = endpoint.published(99, clock(current.clone()), 1, 3000);
+            if mode == 1 { assert!(published.is_err()); } else { published.unwrap(); }
+        }
+        let mut original = binding();
+        let mut selected_transport = transport.clone();
+        match mode {
+            2 => original.generation += 1,
+            3 => original.connection_generation += 1,
+            4 => original.transport_id = StreamId::from_string("foreign-transport"),
+            5 => selected_transport = Arc::new(Wire::default()),
+            6 => current.store(false, Ordering::Release),
+            7 => endpoint.cancel.cancel(),
+            _ => {},
+        }
+        let result = endpoint.request_initial(&original, &selected_transport, &|| mode != 8);
+        let attempts = wire.attempts.load(Ordering::Acquire);
+        let packets = wire.packets.lock().unwrap().len();
+        endpoint.cancel.cancel();
+        assert!(result.is_err(), "refusal mode {mode}");
+        assert_eq!(attempts, 0, "refusal mode {mode}"); assert_eq!(packets, 0);
+    }
+}
+
+#[test]
+fn native_initial_hint_consumes_original_failed_send_sequence_and_never_adopts_changed_publisher_epoch() {
+    let (endpoint, wire, transport, notices, current) = endpoint();
+    endpoint.published(99, clock(current.clone()), 1, 3000).unwrap();
+    let original = notices.values.lock().unwrap()[0];
+    wire.refuse.store(true, Ordering::Release);
+    let refused = endpoint.request_initial(&binding(), &transport, &|| true);
+    let rate_refused = endpoint.dispatch(original.ssrc);
+    wire.refuse.store(false, Ordering::Release);
+    endpoint.source.lock().unwrap().next = None;
+    // This lower seam control deliberately supplies the stale epoch captured
+    // by request_initial, as if a source update occurred between its two locks.
+    let mut changed_clock = clock(current); changed_clock.generation = 2;
+    endpoint.published(99, changed_clock, 2, 6000).unwrap();
+    let stale = endpoint.dispatch_guarded(99, Some(original.epoch), &|| true);
+    let fresh = endpoint.request_initial(&binding(), &transport, &|| true);
+    let packets = wire.packets.lock().unwrap().clone();
+    let attempts = wire.attempts.load(Ordering::Acquire);
+    let announced = notices.values.lock().unwrap().clone();
+    endpoint.cancel.cancel();
+    assert!(matches!(refused, Err(StreamControlError::Backpressure)));
+    assert!(matches!(rate_refused, Err(StreamControlError::Backpressure)));
+    assert!(matches!(stale, Err(StreamControlError::Authority)));
+    fresh.unwrap(); assert_eq!(attempts, 2); assert_eq!(packets.len(), 1);
+    let actual = observe_video_feedback_datagram(&packets[0]).unwrap();
+    assert_eq!(actual.seq, 1, "failed original send cannot be retransmitted with its consumed sequence");
+    assert_ne!(actual.activation_epoch, original.epoch); assert_eq!(announced.len(), 2);
+    assert_eq!(actual.activation_epoch, announced[1].epoch);
+}
+
+#[test]
+fn native_source_preflight_observes_only_same_announced_live_epoch_without_io_or_rate_sequence_effects() {
+    let (endpoint, wire, transport, notices, current)=endpoint();
+    assert!(endpoint.preflight_initial(&binding(),&transport).is_err());
+    endpoint.published(77,clock(current.clone()),12,36000).unwrap();
+    let original=notices.values.lock().unwrap()[0];
+    let before={let state=endpoint.source.lock().unwrap();(state.sequence,state.next)};
+    for _ in 0..4 {endpoint.preflight_initial(&binding(),&transport).unwrap();}
+    let after={let state=endpoint.source.lock().unwrap();(state.sequence,state.next)};
+    let mut foreign=binding();foreign.generation+=1;
+    assert!(endpoint.preflight_initial(&foreign,&transport).is_err());
+    current.store(false,Ordering::Release);
+    assert!(endpoint.preflight_initial(&binding(),&transport).is_err());
+    let actual=notices.values.lock().unwrap().clone();
+    let attempts=wire.attempts.load(Ordering::Acquire);
+    endpoint.cancel.cancel();
+    assert_eq!(before,after);assert_eq!(actual,vec![original]);assert_eq!(attempts,0);
+}
