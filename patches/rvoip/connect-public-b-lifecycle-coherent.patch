+        target_port.require_ticket(TicketSide::Egress,&target_ticket)?;
+        let direct=DirectStamp {feedback:route.feedback.clone(),gate:Arc::downgrade(gate),
+            ticket:route.ticket.clone(),selection:route.selection.clone(),cancel:gate.cancel.clone(),
+            preparation:route.preparation.clone(),post_cut:route.post_cut.clone()};
+        Ok(Self {source,target,source_ticket,target_ticket,source_scene,target_scene,direct,attempted:AtomicBool::new(false),started:AtomicBool::new(false)})
