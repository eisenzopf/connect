@@ -0,0 +1,53 @@
+//! Separate historical cleanup identity and fresh OLD authority, never target
+//! admission renewal or a native-close receipt constructed in Core.
+use super::*;
+impl Orchestrator {
+    /// Exact frozen OLD programme metadata for a subsequent current Host read.
+    /// No restore, closed-candidate proof, authority or new preparation budget.
+    /// All Core locks/flight custody are released before returning the scalars.
+    pub fn staged_old_video_restore_source_hints(
+        self:&Arc<Self>, plan:&ManagedAudioDeviceReplacementPlan,
+    )->ControlResult<Vec<crate::staged_streams::MediaSource>> {
+        let p=&plan.preparation;
+        self.owns_replacement(p)?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let hints=p.runtime.mixer.staged.as_ref().ok_or(ParticipantControlError::Unsupported)?
+            .old_video_restore_source_hints(&plan.media,p)?;
+        self.owns_replacement(p)?;
+        Ok(hints)
+    }
+    /// Resource snapshot for SAME retained frozen custody. A paused result is
+    /// not permission: Host still obtains current OLD + selected-source Read.
+    /// Actual restore rederives these resources and all authorization.
+    pub fn staged_old_video_restore_readiness(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,
+    )->ControlResult<crate::staged_streams::old_video_freeze::OldVideoRestoreReadiness> {
+        let p=&plan.preparation;self.owns_replacement(p)?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let status=p.runtime.mixer.staged.as_ref().ok_or(ParticipantControlError::Unsupported)?
+            .old_video_restore_readiness(&plan.media,p)?;
+        self.owns_replacement(p)?;Ok(status)
+    }
+    pub fn restore_staged_device_replacement_video_with_held(
+        self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,held:&(dyn Any+Send+Sync),
+    )->ControlResult<()> {
+        let p=&plan.preparation;
+        self.owns_replacement(p)?;
+        let _flight=p.flight.clone().try_acquire_owned().map_err(|_|ParticipantTransitionError::Conflict)?;
+        let historical=||->std::result::Result<(),StreamControlError> {
+            self.owns_replacement(p).map_err(handoff::media_error)?;
+            if p.phase.load(Ordering::Acquire)!=CANCELLED || !p.cancellation.is_cancelled()
+                || !p.resource_lifetime.is_cancelled() || p.discard_context_issued.get().is_none()
+                || self.sessions_by_connection.contains_key(&p.intent.replacement) {
+                return Err(StreamControlError::Authority);
+            }
+            Ok(())
+        };
+        historical()?;
+        // The dedicated MediaPolicy callback verifies SAME actual closed token
+        // and fresh OLD/source authorization, after original target joins.
+        p.runtime.mixer.staged.as_ref().ok_or(ParticipantControlError::Unsupported)?
+            .restore_old_video(&plan.media,p,held,&historical)?;
+        Ok(())
+    }
+}
