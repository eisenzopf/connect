+#[tokio::test]
+async fn bootstrap_submission_refuses_old_io_flags_holes_foreign_source_and_different_original_group() {
+    let realm=realm();let source=source(1);let original=frame(&realm,9000);
+    let mut progress=BootstrapProgress::default();
+    let next=progress.preview(&source,&packet(1,9000,true,true,true),&original).unwrap();
+    let mut io=NativeIo::new(0);io.written=true;
+    io.write_with_clock(packet(1,9000,true,true,true),SenderClockHandle::default(),None).await.unwrap();
+    assert!(progress.commit_after_io(next,&original,true,&io).is_none());
+    assert!(matches!(progress.bootstrap,Bootstrap::Waiting));
+    let(receipt,_)=fragment(&mut progress,&source,packet(1,9000,false,true,true),&original,0).await;assert!(receipt.is_none());
+    assert!(progress.preview(&source,&packet(3,9000,true,false,true),&original).is_err());
+    let(receipt,_)=fragment(&mut progress,&source,packet(4,9000,false,true,true),&original,0).await;assert!(receipt.is_none());
+    let other=frame(&realm,9000);
+    assert!(progress.preview(&source,&packet(5,9000,true,false,true),&other).is_err());
+    let(receipt,_)=fragment(&mut progress,&source,packet(6,9000,false,true,true),&original,0).await;assert!(receipt.is_none());
+    assert!(progress.preview(&self::source(2),&packet(7,9000,true,false,true),&original).is_err());
+    assert!(!matches!(progress.bootstrap,Bootstrap::Open {..}));
+}
