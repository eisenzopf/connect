+            || descriptor.conversation!=publisher.conversation || descriptor.session!=publisher.session
+            || descriptor.participant!=*publisher.origin_member.participant()
+            || descriptor.membership_epoch!=publisher.origin_member.epoch()
+            || descriptor.logical_id!=binding.negotiated.requested.logical_id
+            || descriptor.transport_id!=binding.transport_id || descriptor.stream_generation!=binding.generation
+            || descriptor.connection_generation!=binding.connection_generation
+            || target_port.binding.transport_id!=scope.target().transport_id
+            || target_port.binding.generation!=scope.target().stream_generation
+            || target_port.binding.connection_generation!=scope.target().connection_generation
+            || target_port.binding.negotiated.requested.logical_id!=route.selection.receiver
+            || source_port.kind()!=StreamKind::Video || target_port.kind()!=StreamKind::Video
+            || source_port.binding.negotiated.requested.medium!=Medium::Video
+            || target_port.binding.negotiated.requested.medium!=Medium::Video
+            || !source_port.binding.source_ready || !target_port.binding.sink_ready
+            || route.preparation.is_none() || !scope.is_current()
