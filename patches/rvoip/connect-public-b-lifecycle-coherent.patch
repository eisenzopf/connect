+//! Actual managed Orchestrator/runtime/plan + queued Engine IO controls.
+//! Optional physical observer and native callback are modeled; no SDP/UDP,
+//! codec decode, server completed receipt or READY32 evidence is claimed.
+use super::*;
+#[path="public_video_warm/initial_source_preflight_controls.rs"]
+mod initial_source_preflight_controls;
+use crate::staged_streams::physical_video_exposure::{PhysicalVideoExposure,PhysicalVideoExposureCoverage};
+use crate::staged_streams::direct_subscriptions::{DirectSubscription,DirectSubscriptionChange,PostCutPublicVideoScope,PublicVideoWarmPreparation};
+use crate::staged_streams::device_replacement::{ReplacementVideoRequest,ReplacementVideoStream,VideoReplacementPreparation,VideoReplacementPreparationAttempt};
+
+pub(super) fn b_id()->StreamId {StreamId::from_string("public-video-b")}
+pub(super) fn candidate_streams()->Vec<DesiredStream> {
+    vec![desired(Medium::Audio),desired(Medium::Video),DesiredStream {logical_id:b_id(),medium:Medium::Video,direction:StreamDirection::Send}]
+}
+pub(super) fn physical_video_profile(enabled:bool,realm:Option<&SourceFrameRealm>,logical:impl IntoIterator<Item=StreamId>)->(BTreeMap<StreamId,Arc<PhysicalVideoExposure>>,Option<Arc<PhysicalVideoExposureCoverage>>) {
+    if !enabled {return (BTreeMap::new(),None);}
+    let coverage=Arc::new(PhysicalVideoExposureCoverage::new(false));
+    let mut families=BTreeMap::new();
+    for logical in logical {
+        let family=Arc::new(PhysicalVideoExposure::default());family.configure_expected_realm(realm.and_then(SourceFrameRealm::incarnation));family.bind_coverage(coverage.clone());
+        families.insert(logical,family);
+    }
+    (families,Some(coverage))
+}
+
+fn same_source(a:&MediaSource,b:&MediaSource)->bool {
+    a.conversation==b.conversation && a.session==b.session && a.connection==b.connection
+        && a.participant==b.participant && a.membership_epoch==b.membership_epoch
+        && a.connection_generation==b.connection_generation && a.logical_id==b.logical_id
+        && a.transport_id==b.transport_id && a.stream_generation==b.stream_generation
+}
+pub(super) fn current(world:&Arc<World>,scope:&MediaScope<'_>,original:&PostCutPublicVideoScope,held:Option<&(dyn Any+Send+Sync)>)->ControlResult<Box<dyn MediaAuthorityLease>> {
+    if !world.warm_allowed.load(Ordering::Acquire) {return Err(StreamControlError::Unsupported);}
+    let MediaPurpose::Receive {source}=scope.purpose else {return Err(StreamControlError::Authority);};
+    let resource=world.raw(scope.connection)?;
+    let pending=resource.pending.as_ref().ok_or(StreamControlError::Authority)?;
+    if !original.is_current() || original.original_intent()!=pending.intent()
+        || scope.connection!=&original.original_intent().replacement || scope.session!=original.session()
+        || scope.conversation!=original.conversation() || !same_source(source,original.source())
+        || original.target().logical_id!=b_id() {return Err(StreamControlError::Authority);}
+    if let Some(held)=held {
+        let root=replacement_grant(held).ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&root.world,world) || &root.intent!=original.original_intent() {return Err(StreamControlError::Authority);}
+    }
+    world.lease(scope)
+}
+pub(super) fn current_reservation(world:&Arc<World>,scope:&MediaScope<'_>,original:&public_video_reservation::PublicVideoReservationPreparation,held:&(dyn Any+Send+Sync))->ControlResult<Box<dyn MediaAuthorityLease>> {
+    if !matches!(scope.purpose,MediaPurpose::Control) {return Err(StreamControlError::Authority);}
+    let grant=replacement_grant(held).ok_or(StreamControlError::Authority)?;
+    if !Arc::ptr_eq(&grant.world,world) || &grant.intent!=original.original_intent()
+        || scope.connection!=&grant.intent.replacement || original.target().logical_id!=b_id()
+        || !original.is_current() || scope.session!=original.session() || scope.conversation!=original.conversation() {
+        return Err(StreamControlError::Authority);
+    }
+    // Reservation succeeds with Control only: no routing/send/receive grant.
+    let mut owner=world.scope(scope)?;owner.may_route_source=false;owner.send_media.clear();owner.receive_media.clear();
+    Ok(Box::new(WorldLease {world:world.clone(),owner}))
+}
+fn video_packet(node:&Node,timestamp:u32,original:Option<Arc<OriginalVideoFrame>>)->(MediaFrame,Option<Arc<OriginalVideoFrame>>) {
+    let port=node.backend.port(Medium::Video);
+    let mut packet=frame(&port,timestamp);
+    let mut bytes=packet.payload.to_vec();bytes[2..4].copy_from_slice(&((timestamp/3000)as u16).to_be_bytes());packet.payload=bytes.into();
+    let original=original.or_else(||Some(OriginalVideoFrame::observed_in_realm(node.video_source_incarnation,1,timestamp,u64::from(timestamp),node.video_realm.as_ref())));
+    (packet,original)
+}
+async fn publish_packet(node:&Node,packet:MediaFrame,original:Option<Arc<OriginalVideoFrame>>) {
+    let received=Instant::now();
+    let mut retained=node.backend.port(Medium::Video).retain_original_video_ingress(packet,received,original).unwrap().unwrap();
+    loop {match retained.try_publish_clocked(|_|None) {
+        Ok(())=>break,
+        Err(StreamControlError::MetadataBusy|StreamControlError::Backpressure)=>{assert!(received.elapsed()<Duration::from_millis(200));tokio::task::yield_now().await;},
+        Err(error)=>panic!("actual original video publish: {error:?}"),
+    }}
+}
+fn final_request()->ReplacementVideoRequest {ReplacementVideoRequest {
+    publications:vec![ReplacementVideoStream {previous:desired(Medium::Video).logical_id,replacement:desired(Medium::Video).logical_id}],
+    receivers:vec![ReplacementVideoStream {previous:desired(Medium::Video).logical_id,replacement:b_id()}],
+}}
+async fn actors(room:&mut ManagedRoom)->(Arc<Domain>,ConnectionId,ConnectionId) {
+    let alice=domain(&room.conversation,&room.session,"warm-alice","alice");let bob=domain(&room.conversation,&room.session,"warm-bob","bob");
+    let source=room.initial(alice.clone()).await;let retained=room.initial(bob).await;
+    for(receiver,publisher)in[(&source,&retained),(&retained,&source)] {room.select(receiver,vec![AudioSubscription::Connection(publisher.clone())]).await;}
+    let old=&room.nodes[&source].controller;let publisher=&room.nodes[&retained].controller;
+    old.change_direct_subscriptions(old.revision(),DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(publisher,desired(Medium::Video).logical_id,desired(Medium::Video).logical_id)]),deadline(),CancellationToken::new(),None).await.unwrap();
+    (alice,source,retained)
+}
+struct Ready {
+    root:Arc<DeviceReplacementPreparation>,grant:ReplacementGrant,private:VideoReplacementPreparation,plan:ManagedAudioDeviceReplacementPlan,
+    reservation:public_video_reservation::PublicVideoReservationPreparation,
+    _audio:crate::staged_streams::audio_subscriptions::AudioReplacementPreparation,
+    _probe:crate::staged_streams::endpoint_preparation::AudioEndpointPreparation,
+    _context:crate::staged_streams::audience::AudioAudienceHandle,
+}
+async fn prepared(room:&mut ManagedRoom,alice:&Arc<Domain>,source:&ConnectionId,retained:&ConnectionId)->Ready {
+    let mut next=domain(&room.conversation,&room.session,"warm-next","alice");let value=Arc::get_mut(&mut next).unwrap();value.principal=alice.principal.clone();value.member=alice.member.clone();
+    let(root,grant,signal,context,probe)=room.prepare_move(source,retained,next).await;
+    let reservation=room.orch.prepare_staged_public_video_reservation_with_held(&root,&b_id(),&grant).unwrap();
+    assert!(reservation.matches_original_preparation(&root) && reservation.is_current());
+    let private_request=ReplacementVideoRequest {publications:vec![],receivers:vec![ReplacementVideoStream {previous:desired(Medium::Video).logical_id,replacement:desired(Medium::Video).logical_id}]};
+    let held=Command::PrepareVideo {root:grant.clone(),expected:room.nodes[&grant.intent.replacement].controller.revision(),request:private_request.clone()};
+    let private=loop {match room.orch.prepare_staged_device_replacement_video_with_held(&root,&private_request,&held).unwrap() {
+        VideoReplacementPreparationAttempt::Prepared(owner)=>break owner,
+        VideoReplacementPreparationAttempt::MetadataBusy {deadline:until}=>{assert!(tokio::time::Instant::now()<until);tokio::task::yield_now().await;},
+    }};
+    let audio=room.prepare_audio(&root,&grant).await;
+    room.nodes.get_mut(retained).unwrap().publish(6000).unwrap();room.nodes.get_mut(&grant.intent.replacement).unwrap().hear(6000).await;
+    room.nodes.get_mut(&grant.intent.replacement).unwrap().publish(5200).unwrap();
+    assert!(audio.has_delivered_remote_audio());assert!(probe.has_duplex_io());
+    room.signal(&root,&grant,&signal,DeviceReplacementEndpointEvent::Answered);
+    room.signal(&root,&grant,&signal,DeviceReplacementEndpointEvent::MediaObserved);
+    assert_eq!(room.signal(&root,&grant,&signal,DeviceReplacementEndpointEvent::Dtmf {digits:"7".into()}),EndpointConfirmationObservation::Confirmed);
+    let plan=room.orch.plan_staged_device_replacement(&root,Some(final_request())).unwrap();
+    Ready {root,grant,private,plan,reservation,_audio:audio,_probe:probe,_context:context}
+}
+async fn freeze(room:&ManagedRoom,plan:&ManagedAudioDeviceReplacementPlan,grant:&ReplacementGrant,reservation:&public_video_reservation::PublicVideoReservationPreparation)->Arc<crate::staged_streams::old_video_freeze::FrozenOldVideoFrontier> {
+    let held=Command::Audience {root:grant.clone(),plan:plan.media().audience().clone()};
+    room.orch.freeze_staged_public_video_with_reservation(plan,reservation,&held).await.unwrap()
+}
+async fn warm(room:&ManagedRoom,plan:&ManagedAudioDeviceReplacementPlan,grant:&ReplacementGrant)->std::result::Result<PublicVideoWarmPreparation,ParticipantControlError> {
+    room.orch.prepare_staged_public_video_warm_with_held(plan,&Command::Audience {root:grant.clone(),plan:plan.media().audience().clone()})
+}
