+        assert!(port.0.native_egress.get().is_some(),"cold original Core native cursor must exist");
+        assert!(room.nodes[&old].video_exposures.is_empty(),"controlled RTC observer must not replace Native family");
+        let mut output=port.take_egress().unwrap();
