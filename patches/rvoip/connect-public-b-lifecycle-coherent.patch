+//! Exact original B writer capability and immutable whole-keyframe submission.
+//! Native local submission is not decoder readiness, delivery or authority.
+use super::*;
+
+/// No public constructor/Deserialize/Clone. Only the borrowed SAME original
+/// Warm start can issue this once, to the adapter that owns the actual B queue.
+pub struct PublicVideoKeyframeRecorder {
+    scope:Weak<PostCutPublicVideoScope>,target:WeakAdapterMediaPort,
+    native_ssrc:u32,payload_type:u8,
+}
+/// Historical actual successful whole post-F keyframe submission only. Current
+/// Warm/public policy and exact native binding are required independently.
+/// It intentionally carries no prep cutoff or strong Warm/controller/Reader.
+pub struct PublicVideoKeyframeSubmission {
+    scope:Weak<PostCutPublicVideoScope>,original:Arc<OriginalVideoFrame>,
+    native_ssrc:u32,payload_type:u8,timestamp:u32,
+}
+impl PublicVideoKeyframeSubmission {
+    pub fn matches_scope(&self,scope:&PostCutPublicVideoScope)->bool {
+        std::ptr::eq(self.scope.as_ptr(),scope)
+            && self.original.frame_realm().is_some_and(|point|
+                point.incarnation()==scope.frontier().realm_incarnation()
