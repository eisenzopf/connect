+#[tokio::test(flavor="multi_thread",worker_threads=4)]
+async fn owned_native_inventory_pin_orders_actual_new_visual_registration_before_effects_without_blocking_camera_audio_or_existing_ports() {
+    for kind in ["quic","wt"] {
+        let mut room=OwnedRoom::new(kind).await;
+        let result=std::panic::AssertUnwindSafe(async {
+            let source=room.configure(0,0,&[Medium::Audio,Medium::Video]).await;
+            let old=room.configure(1,1,&[Medium::Audio,Medium::Video]).await;
+            // Another logical controller on SAME actual accepted physical peer
+            // exists before the pin; audio is not a visual registration.
+            let newcomer=room.configure(1,2,&[Medium::Audio]).await;
+            let logical=desired(Medium::Video).logical_id;
+            let realm=old.controller.native_video_potential_for_test(&logical).unwrap().exposure.realm_incarnation.unwrap();
+            let seal=old.media.try_seal_raw_access().unwrap();
+            let pin=old.controller.pin_native_video_domain_for_test(&[logical.clone()],&seal,realm).unwrap();
+            let first=pin.capture(&seal,realm).unwrap();
+            assert!(old.controller.pin_native_video_domain_for_test(&[logical.clone()],&seal,realm).is_err(),"another claim must not take or release this pin");
+            let original_old=format!("{:?}",old.controller.active_bindings());let original_revision=old.controller.revision();
+            old.controller.change(original_revision,&[desired(Medium::Audio),desired(Medium::Video)],&BTreeSet::new(),deadline(),CancellationToken::new()).await.unwrap();
+            assert_eq!(format!("{:?}",old.controller.active_bindings()),original_old,"unchanged ports must not be registered again");
+            let revision=newcomer.controller.revision();let offers=format!("{:?}",*newcomer.readiness.offers.lock().unwrap());
+            let refused=newcomer.controller.change(revision,&[desired(Medium::Audio),desired(Medium::Video)],&BTreeSet::new(),deadline(),CancellationToken::new()).await;
+            assert!(matches!(refused,Err(StreamControlError::NotReady)));
+            assert_eq!(newcomer.controller.revision(),revision);
+            assert_eq!(format!("{:?}",*newcomer.readiness.offers.lock().unwrap()),offers,"pin refusal must precede native negotiator ready/queue/task effects");
+            assert!(newcomer.controller.active_bindings().iter().all(|b|b.negotiated.requested.medium==Medium::Audio));
+            // SAME physical OLD camera and audio ingress remain live under the
+            // pin. The actual source capsules still come from the sole reader.
+            let mut camera=old.controller.take_ingress(&logical).unwrap();
+            send(&room.wires[1],original_packet(binding(&old,Medium::Video).stream_local_id,1));
+            let camera_packet=packet(&mut camera).await;
+            assert!(camera_packet.original_video_frame().and_then(|frame|frame.frame_realm()).is_some_and(|point|point.incarnation()==realm));
+            let audio_id=desired(Medium::Audio).logical_id;
+            let mut old_audio=old.controller.take_ingress(&audio_id).unwrap();
+            send(&room.wires[1],audio(binding(&old,Medium::Audio).stream_local_id,0));
+            let old_audio_packet=packet(&mut old_audio).await;
+            old_audio_packet.try_forward_to(&source.controller,&audio_id).unwrap();
+            let actual_audio=received(&room.wires[0]).await;decoded(&actual_audio);
+            assert_eq!(actual_audio.stream_local_id,binding(&source,Medium::Audio).stream_local_id);
+            let mut source_audio=source.controller.take_ingress(&audio_id).unwrap();
+            send(&room.wires[0],audio(binding(&source,Medium::Audio).stream_local_id,0));
+            packet(&mut source_audio).await.try_forward_to(&old.controller,&audio_id).unwrap();
+            let actual_audio=received(&room.wires[1]).await;decoded(&actual_audio);
+            assert_eq!(actual_audio.stream_local_id,binding(&old,Medium::Audio).stream_local_id);
+            assert!(first.is_current()&&pin.capture(&seal,realm).unwrap().is_current(),"audio and camera input do not invalidate visual inventory");
+            drop(pin);assert!(!first.is_current(),"released exact claim cannot remain a pending-cut witness");
+            // Opposite ordering: actual native visual preparation owns its
+            // pending reservation while awaiting real negotiated readiness.
+            // A pin must refuse before OLD pause; it cannot overlook this IO.
+            newcomer.readiness.prepare_hold.store(true,Ordering::Release);
+            let update=[desired(Medium::Audio),desired(Medium::Video)];let replace=BTreeSet::new();
+            let cancellation=CancellationToken::new();
+            let mut change=Box::pin(newcomer.controller.change(newcomer.controller.revision(),&update,&replace,deadline(),cancellation));
+            tokio::select! {
+                finished=&mut change=>panic!("native candidate completed before held preparation: {finished:?}"),
+                entered=tokio::time::timeout(Duration::from_secs(2),newcomer.readiness.preparing.notified())=>entered.unwrap(),
+            }
+            assert!(matches!(old.controller.pin_native_video_domain_for_test(&[logical.clone()],&seal,realm),Err(StreamControlError::NotReady)),"in-progress visual family cannot be omitted from OLD coverage");
+            assert_eq!(format!("{:?}",*newcomer.readiness.offers.lock().unwrap()),offers,"actual native preparation is held before ready/queue ownership");
+            newcomer.readiness.prepare_hold.store(false,Ordering::Release);newcomer.readiness.continue_prepare.notify_one();
+            change.await.unwrap();
+            assert!(old.controller.pin_native_video_domain_for_test(&[logical.clone()],&seal,realm).is_err(),"new actual live family cannot be silently excluded");
+            newcomer.controller.retire();assert_eq!(newcomer.controller.reconcile_cleanup(deadline()).await,0);
+            let second=old.controller.pin_native_video_domain_for_test(&[logical.clone()],&seal,realm).unwrap();
+            let second_metadata=second.capture(&seal,realm).unwrap();
+            let another_audio=room.configure(1,3,&[Medium::Audio]).await;
+            let late=another_audio.controller.change(another_audio.controller.revision(),&update,&replace,deadline(),CancellationToken::new()).await;
+            let exact_pin_still_owned=matches!(late,Err(StreamControlError::NotReady))&&second_metadata.is_current();
+            let no_raw=old.media.router().is_none()&&old.media.datagrams().is_none();
+            drop(second);let released=!second_metadata.is_current();seal.retire();
+            (exact_pin_still_owned,released,no_raw)
+        }).catch_unwind().await;
+        let clean=room.close().await;if let Err(panic)=result {std::panic::resume_unwind(panic);}
+        let(exact,released,no_raw)=result.unwrap();assert!(clean&&exact&&released&&no_raw);
+    }
+}
