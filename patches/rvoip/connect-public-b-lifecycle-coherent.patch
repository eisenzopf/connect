+    fn current(&self)->bool {
+        self.direct.is_current() && self.source_ticket.is_current() && self.target_ticket.is_current()
+            && self.source.strong_count()!=0 && self.target.strong_count()!=0
+            && [&self.source_scene,&self.target_scene].into_iter().flatten().all(|s|!s.cancel.is_cancelled())
+    }
+    pub(super) async fn dispatch(&self)->ControlResult<()> {self.invoke(false).await}
+    pub(super) async fn start(&self)->ControlResult<()> {self.invoke(true).await}
