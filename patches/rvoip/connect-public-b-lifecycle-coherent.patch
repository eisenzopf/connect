+#[tokio::test]
+async fn managed_public_b_start_retired_tickets_timeout_and_cancel_never_reinvoke_or_adopt_current_owner() {
+    let mut facts=Vec::new();
+    for action in 0..5 {
+        let mut room=ManagedRoom::with_video(true).await;
+        let result=catch_original(async {
+            let(ready,_old,source,owner)=ready(&mut room).await;let target=ready.grant.intent.replacement.clone();
+            let backend=room.nodes[&target].backend.clone();backend.mode.store(if action>=2 {21} else {20},Ordering::Release);
+            if action<2 {
+                let controller=if action==0 {&room.nodes[&source].controller} else {&room.nodes[&target].controller};
+                let stream=if action==0 {desired(Medium::Video).logical_id} else {b_id()};
+                controller.set_paused(&stream,controller.revision(),true,deadline()).await.unwrap();
+                let refused=owner.start().await.is_err();return (refused,true,backend.public_warm_starts.load(Ordering::Acquire)==0);
+            }
+            if action==4 {backend.mode.store(22,Ordering::Release);}
+            let mut start=Box::pin(owner.start());
+            let refused=if action==4 {start.as_mut().await.is_err()} else {
+                tokio::select! {biased;_=backend.entered.notified()=>{},value=&mut start=>panic!("pending adapter ended: {value:?}")}
+                if action==3 {owner.close();}
+                matches!(start.as_mut().await,Err(StreamControlError::Cancelled|StreamControlError::Deadline))
+            };
+            drop(start);let repeat=owner.start().await.is_err();owner.close();
+            (refused,repeat,backend.public_warm_starts.load(Ordering::Acquire)==1)
+        }).await;
+        let cleanup=room.close_originals().await;let clean=cleanup.into_iter().all(|v|v);
+        if let Err(error)=result {resume_unwind(error)}
+        facts.push((clean,result.unwrap()));
+    }
+    assert!(facts.iter().all(|(clean,(refused,repeat,count))|*clean&&*refused&&*repeat&&*count),"{facts:?}");
+}
