+    fn packet(seq:u16,ts:u32,marker:bool,start:bool,key:bool)->rtp::Packet {
+        let mut packet=rtp::Packet {header:rtp::Header {version:2,ssrc:7,sequence_number:seq,timestamp:ts,marker,..Default::default()},payload:Default::default()};
+        packet.payload=if start {vec![0x10,if key {0} else {1},0,0,0x9d,1,0x2a,0x80,2,0x68,1]} else {vec![0,8,9]}.into();packet
+    }
+    #[test]
+    fn public_warm_bootstrap_requires_fresh_keyframe_and_all_successful_contiguous_fragments() {
+        let source=source(1);let mut state=Bootstrap::Waiting;
+        assert!(preview(&state,&source,&packet(10,90,true,true,false),1).is_err());
+        assert!(preview(&state,&source,&packet(10,90,true,false,true),1).is_err());
+        let candidate=preview(&state,&source,&packet(65535,90,false,true,true),1).unwrap();
+        // Without successful native IO there is no state commit: following
+        // fragment cannot bootstrap the receiver from a failed first write.
+        assert!(preview(&state,&source,&packet(0,90,true,false,true),1).is_err());
+        state=candidate;
+        assert!(preview(&state,&source,&packet(1,90,true,false,true),1).is_err());
+        assert!(preview(&state,&source,&packet(0,90,true,false,true),2).is_err());
+        assert!(preview(&state,&source,&packet(0,91,true,false,true),1).is_err());
+        state=preview(&state,&source,&packet(0,90,true,false,true),1).unwrap();
+        assert!(matches!(state,Bootstrap::Open {..}));
+        assert!(preview(&state,&source,&packet(1,100,true,true,false),2).is_ok());
+        assert!(preview(&state,&self::source(2),&packet(1,100,true,true,false),2).is_err());
+    }
+    #[test]
+    fn public_warm_bootstrap_rejects_truncated_or_non_key_headers_and_restarts_only_on_keyframe() {
+        let source=source(1);let state=Bootstrap::Waiting;
+        let mut short=packet(1,1,true,true,true);short.payload=vec![0x90,0x80].into();assert!(preview(&state,&source,&short,1).is_err());
+        let mut wrong=packet(1,1,true,true,true);let mut bytes=wrong.payload.to_vec();bytes[4]=0;wrong.payload=bytes.into();assert!(preview(&state,&source,&wrong,1).is_err());
+        let pending=preview(&state,&source,&packet(1,1,false,true,true),1).unwrap();
+        assert!(preview(&pending,&source,&packet(2,2,true,true,false),2).is_err());
+        assert!(matches!(preview(&pending,&source,&packet(3,3,true,true,true),3).unwrap(),Bootstrap::Open {..}));
+    }
+}
