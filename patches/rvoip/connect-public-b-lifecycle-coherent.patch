+        let ticket=port.0.ticket(TicketSide::Egress);let ingress=port.0.ticket(TicketSide::Ingress);let revision=room.nodes[&old].controller.revision();
+        assert!(ticket.is_current()&&!ticket.is_active()&&ingress.is_active());assert!(!coverage.mark_escaped());
