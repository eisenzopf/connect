+//! Cold exact-token ownership move inside the original compound publication.
+//! All actual writers/Root/current policy guards remain owned by the caller.
+use super::*;
+/// Pending metadata transfer; any failure is terminal for this exact B token.
+/// It owns no Host Reader and performs no native wait or writer allocation.
+pub(in crate::staged_streams) struct PublicVideoAdoption {
+    owner:Arc<WarmOwner>,scope:Arc<PostCutPublicVideoScope>,target:Weak<StreamController>,
+    protection:Option<PendingProtection>,published:bool,
+}
+impl PublicVideoAdoption {
+    pub(in crate::staged_streams) fn publish(&mut self,controller:&StreamController)->ControlResult<()> {
+        if self.published || self.owner.phase.load(Ordering::Acquire)!=1
+            || self.owner.cancel.is_cancelled() || !self.owner.frozen.is_current()
+            || !self.owner.witness.is_current() || tokio::time::Instant::now()>=self.owner.cutoff()
+            || self.target.upgrade().is_none_or(|actual|!std::ptr::eq(actual.as_ref(),controller)) {
+            return Err(StreamControlError::Cancelled);
+        }
+        let floor=self.protection.take().ok_or(StreamControlError::Authority)?.publish(controller)?;
+        // Phase CAS gives one sole setter. No model or programme effect has
+        // occurred, and all B writers are still quiesced by the original plan.
+        self.scope.published.set(floor).map_err(|_|StreamControlError::Authority)?;
+        self.owner.phase.store(3,Ordering::Release);
+        self.published=true;
+        Ok(())
+    }
+}
+impl Drop for PublicVideoAdoption {
+    fn drop(&mut self) {
+        if self.published {return;}
+        self.owner.phase.store(2,Ordering::Release);self.owner.cancel.cancel();
+        if let Some(seal)=self.owner.seal.lock().unwrap_or_else(|p|p.into_inner()).take(){seal.retire();}
+        // PendingProtection retires its still-owned token. This additionally
+        // handles publication into the slot followed by a later metadata error.
+        if let Some(target)=self.target.upgrade(){if let Some(slot)=target.published_video_protection.get(){slot.retire();}}
+    }
+}
+impl DirectCommit<'_> {
+    pub(in crate::staged_streams) fn prepare_public_video_adoption(
+        &self,plan:&DirectPlan,controller:&Arc<StreamController>,state:&State,
+        intent:&Arc<device_replacement::ReplacementIntent>,
+    )->ControlResult<Option<PublicVideoAdoption>> {
+        if controller.connection!=intent.request.admitted || !intent.public_video_warm_started.load(Ordering::Acquire) {return Ok(None);}
+        let routes=plan.changed.iter().filter_map(|id|self.0.preparation.get(id)).filter(|route|route.post_cut.is_some()).collect::<Vec<_>>();
+        if routes.len()!=1 {return Err(StreamControlError::Authority);}
+        let route=routes[0];let scope=route.post_cut.as_ref().ok_or(StreamControlError::Authority)?.clone();
+        let owner=scope.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if scope.is_published() || !scope.is_current() || !owner.started.load(Ordering::Acquire)
+            || owner.original.upgrade().is_none_or(|actual|!Arc::ptr_eq(&actual,intent))
+            || plan.old.contains_key(&route.selection.receiver)
+            || !plan.program.get(&route.selection.receiver).is_some_and(|selection|route.selection.same(selection))
+            || scope.original.operation_id!=intent.request.operation_id || scope.target.logical_id!=route.selection.receiver {
+            return Err(StreamControlError::Authority);
+        }
+        let port=state.active.get(&scope.target.logical_id).ok_or(StreamControlError::NotReady)?;
+        if port.binding.transport_id!=scope.target.transport_id || port.binding.generation!=scope.target.stream_generation
+            || port.binding.connection_generation!=scope.target.connection_generation {
+            return Err(StreamControlError::Authority);
+        }
+        let observed=port.video_exposure.get().and_then(|observer|observer.snapshot()).ok_or(StreamControlError::Unsupported)?;
+        if observed.physical_family!=scope.target.physical_writer_incarnation
+            || observed.realm_incarnation!=Some(scope.frontier.realm_incarnation())
+            || !observed.coverage_complete || observed.inherited_potential_ordinal<scope.frontier.ordinal() {return Err(StreamControlError::Authority);}
+        owner.phase.compare_exchange(0,1,Ordering::AcqRel,Ordering::Acquire).map_err(|_|StreamControlError::Cancelled)?;
+        let mut adoption=PublicVideoAdoption {owner:owner.clone(),scope:scope.clone(),target:Arc::downgrade(controller),protection:None,published:false};
+        let seal=owner.seal.lock().map_err(|_|StreamControlError::Authority)?.take().ok_or(StreamControlError::Authority)?;
+        adoption.protection=Some(controller.stage_published_video_protection(state,port,seal,&scope.frontier)?);
+        Ok(Some(adoption))
+    }
+}
+
+impl DirectPlan {
+    /// Only exact pending-public B may keep its continuously permitted output
+    /// lineage. The final direct ticket is separately quiesced in this plan,
+    /// and the complete sealed physical family rejects unclassified warm IO.
+    /// Audio/private A/ordinary receivers keep the existing whole-port fence.
+    pub(in crate::staged_streams) fn preserves_post_cut_egress(
+        &self,controller:&StreamController,state:&State,next:&crate::stream_lifecycle::StreamLifecycle,
+        logical:&StreamId,intent:&Arc<device_replacement::ReplacementIntent>,
+    )->bool {
+        let Some(route)=self.private.get(logical) else{return false;};
+        let Some(scope)=route.post_cut.as_ref() else{return false;};
+        let Some(owner)=scope.owner.upgrade() else{return false;};
+        let Some(port)=state.active.get(logical) else{return false;};
+        let Some(current)=state.model.streams().get(logical) else{return false;};
+        let Some(after)=next.streams().get(logical) else{return false;};
+        let snapshot=port.video_exposure.get().and_then(|observer|observer.snapshot());
+        !scope.is_published() && scope.is_current() && owner.started.load(Ordering::Acquire)
+            && owner.original.upgrade().is_some_and(|original|Arc::ptr_eq(&original,intent))
+            && controller.connection==intent.request.admitted && !self.old.contains_key(logical)
+            && self.program.get(logical).is_some_and(|selection|route.selection.same(selection))
+            && route.ticket.is_current() && self.changed.contains(logical)
+            && current.permits(true) && after.permits(true)
+            && current.transport_id==after.transport_id && current.generation==after.generation
+            && current.negotiated==after.negotiated
+            && port.binding.negotiated.requested.direction==StreamDirection::Send
+            && port.binding.transport_id==scope.target.transport_id && port.binding.generation==scope.target.stream_generation
+            && port.binding.connection_generation==scope.target.connection_generation
+            && snapshot.is_some_and(|value|value.coverage_complete && value.physical_family==scope.target.physical_writer_incarnation
+                && value.realm_incarnation==Some(scope.frontier.realm_incarnation()) && value.inherited_potential_ordinal>=scope.frontier.ordinal())
+    }
+}
