+        let frozen=intent.video_freeze.warm_witness(&intent)?;
+        let target=plan.audience().controllers.get(&intent.request.admitted).and_then(Weak::upgrade).ok_or(StreamControlError::NotReady)?;
+        if Arc::ptr_eq(&old,&target) || !Arc::ptr_eq(&old.policy,&target.policy) {return Err(StreamControlError::Authority);}
+        if !identity.matches_scope(&target.conversation,&target.session,frozen.frontier.realm_incarnation()) {return Err(StreamControlError::Authority);}
