+        calls:std::sync::atomic::AtomicUsize::new(0),deadline:policy.deadline});
+    let(context,replay)=crate::v2::auth_peer::exchange::resource_test_context(policy.clone(),a.principal.clone(),a.origin.lifetime.clone(),a.origin.deadline);
+    replay.consume(a.envelope.id()).unwrap();a.exchange=Some(context);
+    let original=a.envelope.original().clone();let cutoff=a.origin.deadline;
+    assert!(grants.clone().try_write_owned().is_err());
+    let(a,until)=a.into_replacement_ready_wait(None).unwrap();
+    assert_eq!(until,cutoff);assert_eq!(a.envelope.original(),&original);
+    drop(grants.clone().try_write_owned().expect("both original application and reply readers released"));
+    assert!(a.reply_authority.for_replies(&[result(&a)]).is_err());
+    assert!(a._lease.authority::<ResourcePreparation>().unwrap().permits(a.envelope()).is_err());
+    let current=a.reauthorize_resource_preparation().await.unwrap();
+    assert_eq!(policy.calls.load(Ordering::Acquire),1);
+    a.install_replacement_ready_reply_authority(&current).unwrap();
+    assert!(a.reply_authority.for_replies(&[ack(&a)]).is_ok());
+    a.origin.lifetime.cancel();assert!(a.reply_authority.for_replies(&[ack(&a)]).is_err());
+}
+#[tokio::test]
+async fn public_video_ready_wait_refuses_profile_shape_transport_scope_and_reconversion() {
+    for fault in 0..6 {
+        let(mut a,_,_,_)=ready_with_policy().await;let mut v=a.envelope.original().clone();
+        v["payload"]["substrate"]=json!("websocket+webrtc");
+    v["payload"]["substrate_setup"]["kind"]=json!("websocket+webrtc");
+        v["payload"]["replacement_preparation"]=json!({"profile":"connect-replacement-public-video-ready-v1",
+            "operation_record_id":"original-record","public_video_readiness":{"nonce":"original-public-nonce"}});
+        match fault {
+            0=>v["payload"]["replacement_preparation"]["public_video_readiness"]=json!(null),
+            1=>{let m=v["payload"]["replacement_preparation"].as_object_mut().unwrap();m.remove("public_video_readiness");m.insert("readiness".into(),json!({}));},
+            2=>v["payload"]["replacement_preparation"]["extra"]=json!(true),
+            3=>v["payload"]["substrate_setup"]["kind"]=json!("quic"),
+            4=>v.as_object_mut().unwrap().remove("operation_id").map(|_|()).unwrap_or(()),
+            _=>{},
+        }
+        if fault==4 {
+            assert!(matches!(Envelope::from_value(v),Err(crate::v2::WireError::MissingScope)));
+            continue;
+        }
+        a.envelope=Envelope::from_value(v).unwrap();
+        if fault==5 {let(a,_)=a.into_replacement_ready_wait(None).unwrap();assert!(a.into_replacement_ready_wait(None).is_err());}
+        else {assert!(a.into_replacement_ready_wait(None).is_err());}
+    }
+}
