+//! Initial-only cooldown controls. The existing shared rate boundary is
+//! modeled explicitly; no opaque Core grant/native encoder is fabricated.
+use super::*;
+async fn pending_once<F:std::future::Future>(future:std::pin::Pin<&mut F>) {
+    let mut future=future;
+    std::future::poll_fn(|cx|{assert!(std::future::Future::poll(future.as_mut(),cx).is_pending());std::task::Poll::Ready(())}).await;
+}
+#[tokio::test(start_paused=true)]
+async fn initial_rate_wait_retains_same_epoch_sequence_and_cutoff_without_lock_or_extra_send() {
+    let(endpoint,wire,transport,notices,current)=endpoint();
+    endpoint.published(99,clock(current),1,3000).unwrap();
+    endpoint.dispatch(99).unwrap();let original=notices.values.lock().unwrap()[0];
+    let binding=binding();let cancel=CancellationToken::new();let valid=||true;
+    let deadline=tokio::time::Instant::now()+Duration::from_millis(500);
+    let mut attempt=Box::pin(endpoint.request_initial_until(&binding,&transport,&valid,deadline,&cancel));
+    pending_once(attempt.as_mut()).await;
+    assert_eq!(wire.attempts.load(Ordering::Acquire),1);
+    // Acquiring this lock proves the wait retained no source mutex. Model the
+    // ORIGINAL std::Instant cooldown expiry before waking its Tokio timer.
+    {let mut state=endpoint.source.try_lock().unwrap();assert_eq!(state.sequence,1);state.next=None;}
+    tokio::time::advance(Duration::from_millis(101)).await;
+    let result=attempt.await;let packets=wire.packets.lock().unwrap().clone();endpoint.cancel.cancel();
+    result.unwrap();assert_eq!(packets.len(),2);
+    let last=observe_video_feedback_datagram(&packets[1]).unwrap();
+    assert_eq!(last.seq,1);assert_eq!(last.activation_epoch,original.epoch);
+    assert_eq!(notices.values.lock().unwrap().len(),1);
+}
+#[tokio::test(start_paused=true)]
+async fn initial_rate_wait_never_renews_deadline_adopts_publisher_or_retries_failed_io() {
+    for mode in 0..4 {
+        let(endpoint,wire,transport,notices,current)=endpoint();
+        endpoint.published(99,clock(current.clone()),1,3000).unwrap();endpoint.dispatch(99).unwrap();
+        // Each iteration has advanced Tokio's paused clock but std::Instant
+        // stays real. Anchor this modeled ORIGINAL limiter boundary to the
+        // current controlled timer epoch; no production rate logic changes.
+        endpoint.source.lock().unwrap().next=Some(tokio::time::Instant::now().into_std()+Duration::from_millis(100));
+        let binding=binding();let cancel=CancellationToken::new();let valid=||true;
+        let deadline=tokio::time::Instant::now()+Duration::from_millis(if mode==0{10}else{500});
+        let mut attempt=Box::pin(endpoint.request_initial_until(&binding,&transport,&valid,deadline,&cancel));
+        pending_once(attempt.as_mut()).await;
+        match mode {
+            0=>tokio::time::advance(Duration::from_millis(11)).await,
+            1=>cancel.cancel(),
+            2=>{let mut changed=clock(current);changed.generation=2;endpoint.published(99,changed,2,6000).unwrap();endpoint.source.lock().unwrap().next=None;tokio::time::advance(Duration::from_millis(101)).await;},
+            _=>{wire.refuse.store(true,Ordering::Release);endpoint.source.lock().unwrap().next=None;tokio::time::advance(Duration::from_millis(101)).await;},
+        }
+        let result=attempt.await;let count=wire.attempts.load(Ordering::Acquire);let sequence=endpoint.source.lock().unwrap().sequence;
+        endpoint.cancel.cancel();
+        match mode {
+            0=>assert!(matches!(result,Err(StreamControlError::Deadline))),
+            1=>assert!(matches!(result,Err(StreamControlError::Cancelled))),
+            2=>assert!(matches!(result,Err(StreamControlError::Authority))),
+            _=>assert!(matches!(result,Err(StreamControlError::Backpressure))),
+        }
+        assert_eq!(count,if mode==3{2}else{1});assert_eq!(sequence,if mode==3{2}else{1});
+        assert_eq!(wire.packets.lock().unwrap().len(),1);
+        assert_eq!(notices.values.lock().unwrap().len(),if mode==2{2}else{1});
+    }
+}
