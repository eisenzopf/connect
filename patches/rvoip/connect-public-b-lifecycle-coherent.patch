+//! Actual managed/Core cleanup and restore plumbing; Host native-close proof is
+//! MODELED. This SIP fixture cannot mint/qualify ClosedOriginalCandidate. Root
+//! must test the real canonical close-token + fresh OLD Store Reader partner.
+use super::*;
+use crate::orchestrator::participant_control::replacement::UnpublishedCandidateDiscardContext;
+use crate::staged_streams::old_video_freeze::{FrozenOldVideoFrontier,OldVideoRestoreScope};
+
+struct ModeledHostRestore {
+    root:Arc<DeviceReplacementPreparation>,context:UnpublishedCandidateDiscardContext,
+    world:Arc<World>,target:Arc<Adapter>,until:tokio::time::Instant,
+    expected:ParticipantReplacementMutation,deny_source:Option<ConnectionId>,
+}
+struct RestoreLease {world:Arc<World>,owner:MediaOwner,deny_source:Option<ConnectionId>}
+impl MediaAuthorityLease for RestoreLease {
+    fn authority(&self)->&MediaOwner {&self.owner}
+    fn control_owner(&self)->ControlResult<Box<MediaOwner>> {self.world.owner(self.owner.connection.connection()).map(Box::new)}
+    fn control_receive(&self,source:&MediaSource)->ControlResult<Box<MediaOwner>> {
+        if self.deny_source.as_ref()==Some(&source.connection) {return Err(StreamControlError::Authority);}
+        self.world.source(source)?;let mut owner=self.world.owner(self.owner.connection.connection())?;owner.may_route_source=true;Ok(Box::new(owner))
+    }
+}
+pub(in crate::staged_streams) fn current(world:&Arc<World>,scope:&MediaScope<'_>,original:&OldVideoRestoreScope,held:&(dyn Any+Send+Sync))->ControlResult<MediaControl> {
+    let host=held.downcast_ref::<ModeledHostRestore>().ok_or(StreamControlError::Unsupported)?;
+    if !Arc::ptr_eq(world,&host.world) || !original.matches_original_preparation(&host.root)
+        || !host.context.matches_preparation(&host.root) || !host.context.cancelled_original()
+        || original.original_intent()!=&host.expected || scope.connection!=original.old_connection()
+        || scope.conversation!=original.conversation() || scope.session!=original.session()
+        || !matches!(scope.purpose,MediaPurpose::Control) || host.target.outstanding.load(Ordering::Acquire)!=0 {
+        return Err(StreamControlError::Authority);
+    }
+    // This models only the policy trust boundary after actual original CORE
+    // cleanup. No native token or historical wire closure is synthesized here.
+    MediaControl::new(Box::new(RestoreLease {world:world.clone(),owner:world.scope(scope)?,deny_source:host.deny_source.clone()}),CancellationToken::new(),host.until)
+}
+async fn frozen(room:&mut ManagedRoom)->(Ready,ConnectionId,ConnectionId,tokio::sync::mpsc::Receiver<QueuedMedia>,Arc<FrozenOldVideoFrontier>) {
+    let(alice,old,source)=actors(room).await;let ready=prepared(room,&alice,&old,&source).await;
+    let mut output=room.nodes[&old].backend.port(Medium::Video).take_egress().unwrap();
+    let(packet,point)=video_packet(&room.nodes[&source],9000,None);let point=point.unwrap();publish_packet(&room.nodes[&source],packet,Some(point.clone())).await;
+    let family=room.nodes[&old].video_exposures[&desired(Medium::Video).logical_id].clone();
+    outgoing(&mut output).await.deliver(|_|async {family.record_potential(point.frame_realm());Ok(())}).await.unwrap();
+    let frontier=freeze(room,&ready.plan,&ready.grant,&ready.reservation).await;
+    (ready,old,source,output,frontier)
+}
+async fn original_cleanup(room:&ManagedRoom,ready:&Ready)->ModeledHostRestore {
+    let context=room.orch.discard_staged_device_replacement_with_held(&ready.root,&super::super::candidate_discard::CleanupGrant::known(&ready.grant)).unwrap();
+    let candidate=&ready.grant.intent.replacement;
+    assert_eq!(room.nodes[candidate].controller.shutdown(deadline()).await,0);
+    let target=room.nodes[candidate].backend.clone();assert_eq!(target.outstanding.load(Ordering::Acquire),0);
+    ModeledHostRestore {root:ready.root.clone(),context,world:room.world.clone(),target,until:deadline(),expected:ready.grant.intent.clone(),deny_source:None}
+}
