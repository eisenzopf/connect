+//! One initial selected-source hint for the exact original post-F B route.
+//! This owns weak lifecycle metadata only. It never issues successful-feedback
+//! provenance, retains policy readers, or proves a keyframe/readiness/IO result.
+use super::*;
+
+pub(super) struct InitialPublicVideoPicture {
+    source:Weak<Port>,target:Weak<Port>,
+    source_ticket:PeerRouteTicket,target_ticket:PeerRouteTicket,
+    source_scene:Option<scene_consumer::SceneStamp>,
+    target_scene:Option<scene_consumer::SceneStamp>,
+    direct:DirectStamp,
+    attempted:AtomicBool,started:AtomicBool,
+}
+/// Borrowed only inside the exact current source and B-warm admissions. No
+/// public constructor, Clone, Deserialize, or owned callback can mint a grant.
+pub struct InitialVideoPictureRequest<'a> {
+    original:&'a InitialPublicVideoPicture,
+    source:AdapterMediaPort,
+    descriptor:MediaSource,
+    deadline:tokio::time::Instant,
+    cancel:CancellationToken,
+}
+impl InitialVideoPictureRequest<'_> {
+    pub fn source_port(&self)->&AdapterMediaPort {&self.source}
+    pub fn source(&self)->&MediaSource {&self.descriptor}
+    pub fn deadline(&self)->tokio::time::Instant {self.deadline}
+    pub fn cancellation(&self)->&CancellationToken {&self.cancel}
+    /// Current weak/ticket metadata, not a replacement for the held admissions.
+    pub fn is_current(&self)->bool {
+        self.original.current() && !self.cancel.is_cancelled()
+            && tokio::time::Instant::now()<self.deadline
+    }
+}
+/// Borrowed only during current source Publish and exact target Warm admission.
+/// The Arc scope is immutable provenance; its Weak owner grants no standalone IO.
+pub struct PublicVideoWarmStart<'a> {
+    original:&'a InitialPublicVideoPicture,target:AdapterMediaPort,
+    scope:Arc<PostCutPublicVideoScope>,deadline:tokio::time::Instant,cancel:CancellationToken,
+}
+impl PublicVideoWarmStart<'_> {
+    /// Native tuple must come from the SAME actual held original B writer.
+    /// The nonclone capability moves to that queue/Timeline; this does no IO.
+    pub fn keyframe_submission_recorder(&self,native_ssrc:u32,payload_type:u8)->ControlResult<super::PublicVideoKeyframeRecorder> {
+        super::PublicVideoKeyframeRecorder::from_start(self,native_ssrc,payload_type)
+    }
+    pub fn target_port(&self)->&AdapterMediaPort {&self.target}
+    pub fn scope(&self)->&Arc<PostCutPublicVideoScope> {&self.scope}
+    pub fn deadline(&self)->tokio::time::Instant {self.deadline}
+    pub fn cancellation(&self)->&CancellationToken {&self.cancel}
+    pub fn is_current(&self)->bool {self.original.current() && self.scope.is_current()
+        && !self.cancel.is_cancelled() && tokio::time::Instant::now()<self.deadline}
+}
+impl InitialPublicVideoPicture {
+    pub(super) fn from_route(
+        gate:&Arc<DirectGate>,route:&Arc<Route>,source:Weak<Port>,
+        source_ticket:PeerRouteTicket,target:Weak<Port>,target_ticket:PeerRouteTicket,
+        source_scene:Option<scene_consumer::SceneStamp>,
+        target_scene:Option<scene_consumer::SceneStamp>,
+    )->ControlResult<Self> {
+        let scope=route.post_cut.as_ref().ok_or(StreamControlError::Authority)?;
+        let source_port=source.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let target_port=target.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let publisher=source_port.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let receiver=target_port.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let descriptor=scope.source();let binding=&source_port.binding;
+        if !Weak::ptr_eq(&route.selection.publisher,&Arc::downgrade(&publisher))
