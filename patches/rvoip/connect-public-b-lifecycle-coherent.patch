+//! Pending-public B is a distinct source class. It is never private preroll or
+//! an ordinary committed receiver. Metadata here alone grants no IO authority.
+use super::*;
+mod initial_picture;
+pub use initial_picture::{InitialVideoPictureRequest,PublicVideoWarmStart};
+use initial_picture::InitialPublicVideoPicture;
+use crate::participant_transitions::ParticipantReplacementMutation;
