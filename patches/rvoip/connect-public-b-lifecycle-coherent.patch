+            let unresolved=old.controller.reconcile_cleanup(tokio::time::Instant::now()+Duration::from_millis(2)).await;
+            let still_refused=next.controller.capture_native_video_domain_for_test(&[logical.clone()],&seal,realm).is_err();
+            let held=probe.snapshot();assert!(refused&&still_refused&&unresolved>0&&held.waiting&&held.accepted==0);
+            probe.release();until_probe(&probe,|v|v.accepted==3&&!v.waiting).await;
+            let joined=old.controller.reconcile_cleanup(deadline()).await==0;
+            let captured=next.controller.capture_native_video_domain_for_test(&[logical.clone()],&seal,realm).unwrap();
+            let retained=captured.ordinal()>=point.ordinal();
