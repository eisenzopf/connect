+//! The canonical physical peer's sole bounded datagram ingress. The driver
+//! owns/polls its reader alongside signaling; no media worker is detached.
+use super::{auth_dispatch::DispatchError, reachability::PeerTransport};
+use crate::{
+    staged_media::StagedDatagramTransport,
+    substrate::{observe_rtp_datagram, PeerMediaIngress, PeerMediaRouter},
+};
+use async_trait::async_trait;
+use bytes::Bytes;
+use futures::{future::BoxFuture, FutureExt};
+use rvoip_core::{
+    connection::Direction,
+    stream::{MediaFrame, StreamKind},
+};
+use std::{
+    num::NonZeroU16,
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        Arc,
+    },
+};
+use tokio_util::sync::CancellationToken;
+
+/// Implemented by the actual accepted native transport driver. One read belongs
+/// to the physical peer, never to an individual logical Connection or Stream.
+#[async_trait]
+pub trait NativeDatagramTransport: StagedDatagramTransport {
+    async fn read_datagram(&self) -> Result<Bytes, DispatchError>;
+}
+
+#[derive(Default)]
+struct Counters {
+    accepted: AtomicU64,
+    rejected: AtomicU64,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct NativeMediaSnapshot {
+    pub reader_claimed: bool,
+    pub reader_running: bool,
+    pub ingress_accepted: u64,
+    pub ingress_rejected: u64,
+}
+
+/// Trusted transport resource, not an authorization or readiness grant. Every
+/// route on this physical peer allocates from this same non-reusing router.
+pub struct NativePeerMedia {
+    transport: PeerTransport,
+    io: Arc<dyn NativeDatagramTransport>,
+    router: Arc<PeerMediaRouter>,
+    lifetime: CancellationToken,
+    claimed: AtomicBool,
+    running: AtomicBool,
+    counters: Counters,
+}
+struct ReaderOwner(Arc<NativePeerMedia>);
+impl Drop for ReaderOwner {
+    fn drop(&mut self) {
+        self.0.running.store(false, Ordering::Release);
+        self.0.lifetime.cancel();
+        // Immediately fence every binding, even if a handler retained its
+        // physical context or an asynchronous per-route cleanup wait is dropped.
+        self.0.router.shutdown();
+    }
+}
+impl NativePeerMedia {
+    pub fn new(
+        transport: PeerTransport,
+        io: Arc<dyn NativeDatagramTransport>,
+        lifetime: CancellationToken,
+    ) -> Result<Arc<Self>, DispatchError> {
+        if transport == PeerTransport::WebSocket
+            || io.maximum_datagram_bytes().is_none_or(|size| size < 20)
+        {
+            return Err(DispatchError::Unsupported);
+        }
+        if lifetime.is_cancelled() || io.is_closed() {
+            return Err(DispatchError::Closed);
+        }
+        Ok(Arc::new(Self {
+            transport,
+            io,
+            router: PeerMediaRouter::new(),
+            lifetime,
+            claimed: AtomicBool::new(false),
+            running: AtomicBool::new(false),
+            counters: Counters::default(),
+        }))
+    }
+    pub fn transport(&self) -> PeerTransport {
+        self.transport
+    }
+    pub fn router(&self) -> Arc<PeerMediaRouter> {
+        self.router.clone()
+    }
+    pub fn datagrams(&self) -> Arc<dyn StagedDatagramTransport> {
+        self.io.clone()
+    }
+    pub fn is_live(&self) -> bool {
+        self.running.load(Ordering::Acquire)
+            && !self.lifetime.is_cancelled()
+            && !self.io.is_closed()
+            && !self.router.is_shutdown()
+    }
+    pub fn snapshot(&self) -> NativeMediaSnapshot {
+        NativeMediaSnapshot {
+            reader_claimed: self.claimed.load(Ordering::Acquire),
+            reader_running: self.running.load(Ordering::Acquire),
+            ingress_accepted: self.counters.accepted.load(Ordering::Acquire),
+            ingress_rejected: self.counters.rejected.load(Ordering::Acquire),
+        }
+    }
+    /// Claim once, before passing the physical context to a handler. Dropping
+    /// even an unpolled returned future retires the router. The driver must poll
+    /// this future with signaling for the full physical lifetime.
+    pub fn reader(
+        self: &Arc<Self>,
+    ) -> Result<BoxFuture<'static, Result<(), DispatchError>>, DispatchError> {
+        if self.claimed.swap(true, Ordering::AcqRel) {
+            return Err(DispatchError::Capacity);
+        }
+        if self.lifetime.is_cancelled() || self.io.is_closed() {
+            self.router.shutdown();
+            return Err(DispatchError::Closed);
+        }
+        self.running.store(true, Ordering::Release);
+        let owner = ReaderOwner(self.clone());
+        Ok(async move {
+            let owner = owner;
+            loop {
+                let bytes = tokio::select! {
+                    biased;
+                    _=owner.0.lifetime.cancelled()=>return Err(DispatchError::Closed),
+                    result=owner.0.io.read_datagram()=>result?,
+                };
+                tokio::task::consume_budget().await;
+                if owner.0.route(&bytes) {
+                    owner.0.counters.accepted.fetch_add(1, Ordering::AcqRel);
+                } else {
+                    owner.0.counters.rejected.fetch_add(1, Ordering::AcqRel);
+                }
+            }
+        }
+        .boxed())
+    }
+    fn route(&self, bytes: &[u8]) -> bool {
+        // Bound parsing before RTP extension/CSRC processing. Audio payloads
+        // are bounded again by the staged engine; video has its tighter cap.
+        if bytes.len() > 16 * 1024 + 20 || self.lifetime.is_cancelled() {
+            return false;
+        }
+        let Ok(datagram) = observe_rtp_datagram(bytes) else {
+            return false;
+        };
+        let Some(local) = NonZeroU16::new(datagram.stream_local_id) else {
+            return false;
+        };
+        let Some(binding) = self.router.lookup(local) else {
+            return false;
+        };
+        if binding.is_cancelled() || binding.stream().direction() != Direction::Inbound {
+            return false;
+        }
+        let kind = binding.stream().kind();
+        let video = if kind == StreamKind::Video {
+            if bytes.len() > rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES + 8 {
+                return false;
+            }
+            match datagram.rtp.packet().serialize() {
+                Ok(bytes) => Some(bytes),
+                Err(_) => return false,
+            }
+        } else if kind == StreamKind::Audio {
+            None
+        } else {
+            return false;
+        };
+        let payload = datagram.rtp.into_media_payload();
+        if binding.stream().codec().payload_type != Some(payload.payload_type) {
+            return false;
+        }
+        let frame = MediaFrame {
+            source_clock: None,
+            stream_id: binding.route().stream_id.clone(),
+            kind,
+            payload: video.unwrap_or(payload.payload),
+            timestamp_rtp: payload.timestamp,
+            captured_at: chrono::Utc::now(),
+            payload_type: Some(payload.payload_type),
+        };
+        // Checked staged ingress rejects prepared/paused/revoked generations
+        // before any queue buffering. There is no unguarded fanout fallback.
+        match binding.ingress() {
+            PeerMediaIngress::Checked(ingress) => ingress.try_send(frame).is_ok(),
+            PeerMediaIngress::Channel(_) => false,
+        }
+    }
+}
+impl Drop for NativePeerMedia {
+    fn drop(&mut self) {
+        self.lifetime.cancel();
+        self.router.shutdown();
+    }
+}
