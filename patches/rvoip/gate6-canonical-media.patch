+fn rebind_owner(
+    mut owner: MediaOwner,
+    member: Membership,
+    ep: EndpointBinding,
+    id: &ConnectionId,
+) -> MediaOwner {
+    let presence =
+        SessionAppearance::admit(&member, owner.presence.session().clone(), None).unwrap();
+    let mut connection = ConnectionBinding::prepare(&member, &presence, &ep, id.clone()).unwrap();
+    connection
+        .observe_ready(&member, &presence, &ep, 1)
+        .unwrap();
+    connection.activate(&member, &presence, &ep).unwrap();
+    owner.member = member;
+    owner.presence = presence;
+    owner.endpoint = ep;
+    owner.connection = connection;
+    owner
+}
+#[tokio::test]
+async fn canonical_media_installation_cannot_lend_new_epoch_identity_or_endpoint_to_old_allocation()
+{
+    let mut n = Network::new("quic").await;
+    let id = n.reserve(0).await;
+    let baseline = media_owner(&n.factory.core, &id, n.kind);
+    let mut member = baseline.member.clone();
+    let binding = IdentityBinding::from_authenticated(
+        &actor("alice"),
+        IdentityId::from_string("id_alice"),
+        Utc::now(),
+    )
+    .unwrap();
+    member.remove(member.revision()).unwrap();
+    member.readmit(&binding, member.revision()).unwrap();
+    let mut variants = vec![rebind_owner(
+        baseline.clone(),
+        member,
+        baseline.endpoint.clone(),
+        &id,
+    )];
+    let bob =
+        n.factory.core.policy.0.read().unwrap().members[&core_fixture::participant("bob")].clone();
+    variants.push(rebind_owner(
+        baseline.clone(),
+        bob,
+        endpoint("bob", n.kind),
+        &id,
+    ));
+    for (epid, device, kind) in [
+        ("other-endpoint", "device_alice", Transport::Quic),
+        (
+            baseline.endpoint.endpoint().as_str(),
+            "other-device",
+            Transport::Quic,
+        ),
+        (
+            baseline.endpoint.endpoint().as_str(),
+            "device_alice",
+            Transport::WebTransport,
+        ),
+    ] {
+        let mut ep = EndpointBinding::provision(
+            binding.clone(),
+            EndpointId::from_string(epid),
+            DeviceId::from_string(device),
+            kind,
+            "fixture".into(),
+        )
+        .unwrap();
+        ep.verify(&binding, "new-proof".into(), Utc::now()).unwrap();
+        variants.push(rebind_owner(
+            baseline.clone(),
+            baseline.member.clone(),
+            ep,
+            &id,
+        ));
+    }
+    let foreign = IdentityBinding::from_authenticated(
+        &principal("other-issuer"),
+        IdentityId::from_string("id_alice"),
+        Utc::now(),
+    )
+    .unwrap();
+    let member = Membership::admit(
+        foreign.clone(),
+        n.factory.core.conversation.clone(),
+        core_fixture::participant("alice"),
+        rvoip_core::participant::ParticipantKind::Human,
+        rvoip_core::participant::ParticipantRole::Agent,
+    )
+    .unwrap();
+    let mut ep = EndpointBinding::provision(
+        foreign.clone(),
+        baseline.endpoint.endpoint().clone(),
+        baseline.endpoint.device().clone(),
+        n.kind,
+        "fixture".into(),
+    )
+    .unwrap();
+    ep.verify(&foreign, "foreign-proof".into(), Utc::now())
+        .unwrap();
+    variants.push(rebind_owner(baseline.clone(), member, ep, &id));
+    let media = n.adapter().physical_source(&id).unwrap().media().unwrap();
+    for owner in variants {
+        n.grants.0.write().await.owners.insert(id.clone(), owner);
+        assert!(n
+            .adapter()
+            .configure_rtp(
+                &id,
+                principal("old"),
+                n.factory.core.conversation.clone(),
+                n.scope(&id),
+                n.grants.clone(),
+                Readiness::new(),
+                16
+            )
+            .is_err());
+        assert!(n.adapter().staged_media(&id).is_none());
+        assert_eq!(media.router().snapshot().issued_local_ids, 0);
+    }
+    n.grants.0.write().await.owners.insert(id.clone(), baseline);
+    assert!(n
+        .adapter()
+        .configure_rtp(
+            &id,
+            principal("old"),
+            n.factory.core.conversation.clone(),
+            n.scope(&id),
+            n.grants.clone(),
+            Readiness::new(),
+            16
+        )
+        .is_ok());
+    n.stop().await;
+}
