+async fn canonical_native_end_cancellation_keeps_resources_and_quota_until_confirmed_cleanup() {
+    let mut n = Network::new("quic").await;
+    let a = n.configure(0).await;
+    n.start(&a, &[Medium::Audio]).await;
+    let peer = n.factory.records.lock().unwrap()[0]
+        .peer
+        .lock()
+        .unwrap()
+        .clone()
+        .unwrap();
+    a.readiness.hold.store(true, Ordering::Release);
+    let desireds = [desired(Medium::Audio), desired(Medium::Video)];
+    let replace = BTreeSet::new();
+    let mut change = Box::pin(a.controller.change(
+        a.controller.revision(),
+        &desireds,
+        &replace,
+        deadline(),
+        CancellationToken::new(),
+    ));
+    assert!(futures::poll!(change.as_mut()).is_pending());
+    // Keep the change future owned but deliberately unpolled during end: its
+    // in-flight permit models cancellation at an async suspension boundary.
+    let mut end = Box::pin(n.adapter().end(a.id.clone(), EndReason::Normal));
+    assert!(futures::poll!(end.as_mut()).is_pending());
+    drop(end);
+    assert_eq!(n.adapter().route_count(), 1);
+    assert!(n.adapter().is_connection_live(&a.id));
+    assert_eq!(peer.snapshot().connections, 1);
+    assert!(n.adapter().media_controller(&a.id).is_err());
+    assert!(a
+        .controller
+        .cleanup_status()
+        .iter()
+        .all(|(_, s)| *s != PortStatus::Active));
+    drop(change);
+    n.adapter()
+        .end(a.id.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    core_fixture::until(|| peer.snapshot().connections == 0).await;
+    assert_eq!(n.adapter().route_count(), 0);
+    assert!(a.controller.cleanup_status().is_empty());
+    n.stop().await;
