+//! Actual canonical TLS drivers and native staged ownership. The route policy
+//! and exact readiness provider are controlled fixtures, not Connect installation.
+use super::*;
+use rvoip_core::{relationships::*, staged_streams::*, stream_lifecycle::*};
+use rvoip_uctp::{staged_media::*, substrate::*, v2::native_media::*};
+use std::collections::{BTreeMap, BTreeSet};
+use tokio::sync::{mpsc, OwnedRwLockReadGuard};
+
+fn pcmu() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "pcmu".into(),
+        clock_rate_hz: 8000,
+        channels: 1,
+        fmtp: None,
+    }
+}
+fn vp8() -> MediaFormat {
+    MediaFormat::Encoded {
+        name: "vp8".into(),
+        clock_rate_hz: 90000,
+        channels: 0,
+        fmtp: None,
+    }
+}
+fn desired(medium: Medium) -> DesiredStream {
+    DesiredStream {
+        logical_id: StreamId::from_string(if medium == Medium::Audio {
+            "audio"
+        } else {
+            "video"
+        }),
+        medium,
+        direction: StreamDirection::Both,
+    }
+}
+fn capabilities() -> EndpointMediaCapabilities {
+    let modes = vec![
+        MediaCapability {
+            medium: Medium::Audio,
+            formats: vec![pcmu()],
+        },
+        MediaCapability {
+            medium: Medium::Video,
+            formats: vec![vp8()],
+        },
+    ];
+    EndpointMediaCapabilities {
+        send: modes.clone(),
+        receive: modes,
+        max_streams: 4,
+        renegotiation: true,
+    }
+}
+struct PolicyState {
+    owners: HashMap<ConnectionId, MediaOwner>,
+    denied: BTreeSet<ConnectionId>,
+    private: bool,
+}
+struct MediaGrants(Arc<RwLock<PolicyState>>);
+struct MediaLease {
+    owner: MediaOwner,
+    _guard: OwnedRwLockReadGuard<PolicyState>,
+}
+impl MediaAuthorityLease for MediaLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+impl MediaPolicy for MediaGrants {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        if guard.denied.contains(scope.connection) {
+            return Err(StreamControlError::Authority);
+        }
+        let mut owner = guard
+            .owners
+            .get(scope.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        if let MediaPurpose::Receive { source } = scope.purpose {
+            if guard.private || !guard.owners.contains_key(&source.connection) {
+                owner.may_route_source = false;
+            }
+        }
+        Ok(Box::new(MediaLease {
+            owner,
+            _guard: guard,
+        }))
+    }
+}
+struct Readiness {
+    offers: std::sync::Mutex<Vec<ReadyMediaBinding>>,
+    hold: AtomicBool,
+    entered: Notify,
+    release: Notify,
+}
+impl Readiness {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            offers: Default::default(),
+            hold: AtomicBool::new(false),
+            entered: Notify::new(),
+            release: Notify::new(),
+        })
+    }
+}
+#[async_trait]
+impl StagedRtpNegotiator for Readiness {
+    async fn prepare(
+        &self,
+        _: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        _: Instant,
+        _: CancellationToken,
+    ) -> ControlResult<Vec<PreparedRtpAnswer>> {
+        let mut recorded = self.offers.lock().unwrap();
+        for offer in offers {
+            recorded.retain(|old| {
+                old.negotiated.requested.logical_id != offer.negotiated.requested.logical_id
+            });
+            recorded.push(offer.clone());
+        }
+        drop(recorded);
+        Ok(offers
+            .iter()
+            .map(|binding| PreparedRtpAnswer {
+                binding: binding.clone(),
+                payload_type: if binding.negotiated.requested.medium == Medium::Audio {
+                    0
+                } else {
+                    96
+                },
+            })
+            .collect())
+    }
+    async fn confirm(
+        &self,
+        _: &StagedRtpScope,
+        _: &[PreparedRtpAnswer],
+        _: Instant,
+        _: CancellationToken,
+    ) -> ControlResult<()> {
+        self.entered.notify_one();
+        if self.hold.load(Ordering::Acquire) {
+            self.release.notified().await;
+        }
+        Ok(())
+    }
+}
