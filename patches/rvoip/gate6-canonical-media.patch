+            .unwrap();
+        let media = n.adapter().physical_source(&id).unwrap().media().unwrap();
+        let b = Leg {
+            id,
+            controller,
+            readiness,
+            media,
+        };
+        n.start(&b, &[Medium::Audio]).await;
+        assert!(!Arc::ptr_eq(&a.media, &b.media));
