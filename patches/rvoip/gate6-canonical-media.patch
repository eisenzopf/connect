+#[tokio::test]
+async fn parent_route_lifetime_cancels_admitted_send_and_releases_authority_without_refunding_history(
+) {
+    let mut f = Fixture::new(8);
+    let lifetime = CancellationToken::new();
+    f.a = StreamController::with_limits_and_lifetime(
+        f.a.conversation.clone(),
+        f.a.session.clone(),
+        f.a.connection.clone(),
+        f.a.principal.clone(),
+        f.policy.clone(),
+        f.aa.clone(),
+        f.a.handles.clone(),
+        8,
+        DEFAULT_OPENED_STREAM_LIMIT,
+        lifetime.child_token(),
+    )
+    .unwrap();
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let target = f.ba.port(Medium::Audio);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut output = target.take_egress().unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    let queued = outgoing(&mut output).await;
+    let entered = Arc::new(Notify::new());
+    let started = entered.clone();
+    let dropped = Arc::new(AtomicBool::new(false));
+    struct SendDrop(Arc<AtomicBool>);
+    impl Drop for SendDrop {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::Release);
+        }
+    }
+    let watch = dropped.clone();
+    let send = tokio::spawn(async move {
+        queued
+            .deliver(|_| async move {
+                let _drop = SendDrop(watch);
+                started.notify_one();
+                std::future::pending().await
+            })
+            .await
+    });
+    entered.notified().await;
+    lifetime.cancel();
+    assert!(matches!(
+        tokio::time::timeout(Duration::from_millis(100), send)
+            .await
+            .unwrap()
+            .unwrap(),
+        Err(StreamControlError::Cancelled)
+    ));
+    assert!(dropped.load(Ordering::Acquire));
+    assert!(f.policy.0.try_write().is_ok());
+    assert!(source.try_publish(&frame(&source, 320)).is_err());
+    assert_eq!(source.status(), PortStatus::Retired);
+    assert!(f
+        .a
+        .change(
+            f.a.revision(),
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new()
+        )
+        .await
+        .is_err());
+    assert_eq!(f.a.stream_open_budget(), (1, DEFAULT_OPENED_STREAM_LIMIT));
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(f.ba.outstanding.load(Ordering::Acquire), 1);
+    assert!(target.try_publish(&frame(&target, 320)).is_ok());
+    assert_eq!(f.b.shutdown(deadline()).await, 0);
+}
