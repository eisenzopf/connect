+    assert!(!media.is_live());
+    let reader = media.reader().unwrap();
+    assert!(media.is_live());
+    assert!(media.reader().is_err());
+    assert!(
+        NativeTransportContext::new(PeerTransport::WebTransport, CancellationToken::new(), ())
+            .with_media(media.clone())
+            .is_err()
+    );
+    let reservation = media.router().reserve().unwrap();
+    drop(reader);
+    assert!(!media.is_live());
+    assert!(media.router().is_shutdown());
+    assert!(reservation.cancellation_token().is_cancelled());
+    assert!(media.reader().is_err());
