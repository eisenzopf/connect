+#[tokio::test]
+async fn canonical_core_session_end_fences_staged_packets_before_async_adapter_cleanup() {
+    let mut n = Network::new("quic").await;
+    let a = n.configure(0).await;
+    let b = n.configure(1).await;
+    n.start(&a, &[Medium::Audio]).await;
+    n.start(&b, &[Medium::Audio]).await;
+    let mut input = a
+        .controller
+        .take_ingress(&StreamId::from_string("audio"))
+        .unwrap();
+    send(
+        &n.wire,
+        audio(binding(&a, Medium::Audio).stream_local_id, 0),
+    );
+    let held = packet(&mut input).await;
+    // end_session performs synchronous route retirement before its first real
+    // wait. Do not yield to the supervised adapter cleanup before this check.
+    n.factory
+        .core
+        .orch
+        .end_session(n.factory.core.session.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    assert!(held
+        .try_forward_to(&b.controller, &StreamId::from_string("audio"))
+        .is_err());
+    assert!(n.adapter().physical_source(&a.id).is_err());
+    assert!(a
+        .controller
+        .change(
+            a.controller.revision(),
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new()
+        )
+        .await
+        .is_err());
+    n.stop().await;
+}
