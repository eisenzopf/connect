+    let endpoint = endpoint("alice", kind);
+    // Controlled current policy and readiness baseline, not a wire assertion
+    // that the dormant Core route is already an admitted Participant.
+    let mut connection =
+        ConnectionBinding::prepare(&member, &presence, &endpoint, id.clone()).unwrap();
+    connection
+        .observe_ready(&member, &presence, &endpoint, 1)
+        .unwrap();
+    connection.activate(&member, &presence, &endpoint).unwrap();
+    MediaOwner {
+        actor: member.clone(),
+        member,
+        presence,
+        endpoint,
+        connection,
+        may_control: true,
+        send_media: [Medium::Audio, Medium::Video].into_iter().collect(),
+        receive_media: [Medium::Audio, Medium::Video].into_iter().collect(),
+        local: capabilities(),
+        remote: capabilities(),
+        may_route_source: true,
+    }
+}
+struct Leg {
+    id: ConnectionId,
+    controller: Arc<StreamController>,
+    readiness: Arc<Readiness>,
+    media: Arc<NativePeerMedia>,
+}
+struct Network {
+    f: Fixture,
+    factory: Arc<Factory>,
+    wire: Wire,
+    grants: Arc<MediaGrants>,
+    kind: Transport,
+}
+impl Network {
+    async fn new(kind: &str) -> Self {
+        let (f, factory, _) = wire_setup().await;
+        let profile = CanonicalProfile::new(f.config.clone(), Arc::new(Handler::default()), 8)
+            .unwrap()
+            .with_physical_handlers(factory.clone());
+        let mut wire = wire(kind, profile, "/uctp", Some("https://allowed.example"))
+            .await
+            .unwrap();
+        authenticate_wire(&mut wire, &f).await;
+        Self {
+            f,
+            factory,
+            wire,
+            grants: Arc::new(MediaGrants(Arc::new(RwLock::new(PolicyState {
+                owners: HashMap::new(),
+                denied: BTreeSet::new(),
+                private: false,
+            })))),
+            kind: match kind {
+                "wt" => Transport::WebTransport,
+                "ws" => Transport::WebSocket,
+                _ => Transport::Quic,
+            },
+        }
+    }
+    fn kind_name(&self) -> &str {
+        match self.kind {
+            Transport::Quic => "quic",
+            Transport::WebTransport => "wt",
+            _ => "ws",
+        }
+    }
+    async fn reserve(&mut self, n: usize) -> ConnectionId {
+        self.wire
+            .send(self.f.sign(native_offer(n, self.kind_name())))
+            .await;
+        assert_eq!(self.wire.read().await.kind(), "ack");
+        self.factory
+            .records
+            .lock()
+            .unwrap()
+            .last()
+            .unwrap()
+            .connections
+            .lock()
+            .unwrap()
+            .last()
+            .unwrap()
+            .clone()
+    }
+    fn scope(&self, id: &ConnectionId) -> StagedRtpScope {
+        StagedRtpScope {
+            session: self.factory.core.session.clone(),
+            connection: id.clone(),
+            owner: principal("old").ownership_key(),
+            wire_conversation: Some("conversation".into()),
+            wire_session: "session".into(),
+            wire_connection: format!("wire_{}", id.as_str()),
+        }
+    }
+    fn adapter(&self) -> &Arc<CanonicalNativeAdapter> {
+        &self.factory.adapters[&self.kind]
+    }
+    async fn configure(&mut self, n: usize) -> Leg {
+        let id = self.reserve(n).await;
+        self.grants
+            .0
+            .write()
+            .await
+            .owners
+            .insert(id.clone(), media_owner(&self.factory.core, &id, self.kind));
+        let readiness = Readiness::new();
+        let controller = self
+            .adapter()
+            .configure_rtp(
+                &id,
+                principal("old"),
+                self.factory.core.conversation.clone(),
+                self.scope(&id),
+                self.grants.clone(),
+                readiness.clone(),
+                16,
+            )
+            .unwrap();
+        let media = self
+            .adapter()
+            .physical_source(&id)
+            .unwrap()
+            .media()
+            .unwrap();
+        Leg {
+            id,
+            controller,
+            readiness,
+            media,
+        }
+    }
+    async fn start(&self, leg: &Leg, kinds: &[Medium]) {
+        leg.controller
+            .change(
+                leg.controller.revision(),
+                &kinds.iter().map(|m| desired(*m)).collect::<Vec<_>>(),
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+    }
+    async fn stop(&self) {
+        self.wire.server.shutdown().await.unwrap();
+        self.factory
+            .core
+            .orch
+            .drain_connection_lifecycle_tasks()
+            .await;
+    }
+}
+fn binding(leg: &Leg, medium: Medium) -> ReadyMediaBinding {
+    leg.readiness
+        .offers
+        .lock()
+        .unwrap()
+        .iter()
+        .find(|b| b.negotiated.requested.medium == medium)
+        .unwrap()
+        .clone()
+}
+fn tone() -> Bytes {
+    use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+    CodecFactory::create_codec(0, Some(8000), Some(1))
+        .unwrap()
+        .encode(&AudioFrame {
+            samples: vec![1800; 160],
+            sample_rate: 8000,
+            channels: 1,
+            duration: Duration::from_millis(20),
+            timestamp: 0,
+        })
+        .unwrap()
+        .into()
+}
+fn audio(id: u16, pt: u8) -> Bytes {
+    pack_rtp_datagram(&RtpDatagram {
+        flags: 0,
+        stream_local_id: id,
+        seq: 160,
+        rtp: RtpMediaPayload {
+            payload: tone(),
+            payload_type: pt,
+            sequence_number: 1,
+            timestamp: 160,
+            ssrc: 7,
+        },
+    })
+    .unwrap()
+}
+fn video(id: u16) -> Bytes {
+    let mut packet = vec![0x80, 0x80 | 96, 0, 1];
+    packet.extend_from_slice(&9000u32.to_be_bytes());
+    packet.extend_from_slice(&7u32.to_be_bytes());
+    packet.extend_from_slice(&[0x10, 1, 2, 3]);
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {
+        flags: 0,
+        stream_local_id: id,
+        seq: 1,
+        rtp: observe_rtp(packet.into()).unwrap(),
+    })
+    .unwrap()
+}
+fn send(wire: &Wire, bytes: Bytes) {
+    if let Some(wt) = &wire.wt {
+        wt.send_datagram(bytes).unwrap();
+    } else {
+        wire.quic.as_ref().unwrap().2.send_datagram(bytes).unwrap();
+    }
+}
+async fn received(wire: &Wire) -> ObservedRtpDatagram {
+    let bytes = tokio::time::timeout(Duration::from_secs(2), async {
+        if let Some(wt) = &wire.wt {
+            wt.read_datagram().await.unwrap()
+        } else {
+            wire.quic.as_ref().unwrap().2.read_datagram().await.unwrap()
+        }
+    })
+    .await
+    .unwrap();
+    observe_rtp_datagram(&bytes).unwrap()
+}
+async fn packet(input: &mut mpsc::Receiver<MediaPacket>) -> MediaPacket {
+    tokio::time::timeout(Duration::from_secs(2), input.recv())
+        .await
+        .unwrap()
+        .unwrap()
+}
+fn decoded(packet: &ObservedRtpDatagram) {
+    let mut decoder =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap();
+    assert!(decoder
+        .decode(&packet.rtp.packet().payload)
+        .unwrap()
+        .samples
+        .iter()
+        .any(|s| s.unsigned_abs() > 500));
+}
+async fn duplex(
+    n: &Network,
+    a: &Leg,
+    b: &Leg,
+    ai: &mut mpsc::Receiver<MediaPacket>,
+    bi: &mut mpsc::Receiver<MediaPacket>,
+) {
+    for (source, destination, input) in [(a, b, ai), (b, a, bi)] {
+        send(
+            &n.wire,
+            audio(binding(source, Medium::Audio).stream_local_id, 0),
+        );
+        packet(input)
+            .await
+            .try_forward_to(&destination.controller, &StreamId::from_string("audio"))
+            .unwrap();
+        let out = received(&n.wire).await;
+        assert_eq!(
+            out.stream_local_id,
+            binding(destination, Medium::Audio).stream_local_id
+        );
+        decoded(&out);
+    }
+}
