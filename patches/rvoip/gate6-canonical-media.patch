+struct Datagrams(web_transport_quinn::Session);
+impl rvoip_uctp::staged_media::StagedDatagramTransport for Datagrams {
+    fn maximum_datagram_bytes(&self) -> Option<usize> {
+        Some(self.0.max_datagram_size())
+    }
+    fn send_datagram(&self, bytes: bytes::Bytes) -> rvoip_core::staged_streams::ControlResult<()> {
+        self.0
+            .send_datagram(bytes)
+            .map_err(|_| rvoip_core::staged_streams::StreamControlError::Backpressure)
+    }
+    fn is_closed(&self) -> bool {
+        self.0.close_reason().is_some()
+    }
+}
+#[async_trait::async_trait]
+impl NativeDatagramTransport for Datagrams {
+    async fn read_datagram(&self) -> Result<bytes::Bytes, DispatchError> {
+        self.0
+            .read_datagram()
+            .await
+            .map_err(|_| DispatchError::Closed)
+    }
+}
