+        input: tokio::sync::Mutex::new(rx),
+        maximum: Some(1200),
+    });
+    assert!(NativePeerMedia::new(
+        PeerTransport::WebSocket,
+        io.clone(),
+        CancellationToken::new()
+    )
+    .is_err());
