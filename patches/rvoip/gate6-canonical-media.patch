+        authenticate_wire(&mut other, &n.f).await;
+        other.send(n.f.sign(native_offer(1, kind))).await;
+        assert_eq!(other.read().await.kind(), "ack");
+        let id = n.factory.records.lock().unwrap()[1]
+            .connections
+            .lock()
+            .unwrap()[0]
+            .clone();
+        n.grants
+            .0
+            .write()
+            .await
+            .owners
+            .insert(id.clone(), media_owner(&n.factory.core, &id, n.kind));
+        let readiness = Readiness::new();
+        let controller = n
+            .adapter()
+            .configure_rtp(
+                &id,
+                principal("old"),
