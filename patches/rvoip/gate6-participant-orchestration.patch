diff --git a/crates/foundation/rvoip-core/src/orchestrator/participant_control.rs b/crates/foundation/rvoip-core/src/orchestrator/participant_control.rs
new file mode 100644
index 0000000..1b6f361
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/orchestrator/participant_control.rs
@@ -0,0 +1,810 @@
+//! Current-authority participant control over the real conference mixer.
+//!
+//! This is an engine primitive. Connect owns durable admission/effects and
+//! installs a policy backed by its current grants. Policy leases hold authority
+//! stable only for a synchronous commit; no adapter I/O runs under a lease.
+
+use super::*;
+use crate::conference::{Conference, ConferenceMember, DeliveryGuard, DeliveryLease};
+use crate::participant_transitions::{
+    ParticipantChange, ParticipantMutation, ParticipantObservation, ParticipantSession,
+    ParticipantTransitionError, PreparedParticipantAdmission,
+};
+use crate::relationships::{EndpointBinding, Membership};
+use std::collections::BTreeMap;
+
+#[derive(Debug, thiserror::Error)]
+pub enum ParticipantControlError {
+    #[error(transparent)]
+    Transition(#[from] ParticipantTransitionError),
+    #[error(transparent)]
+    Core(#[from] RvoipError),
+    #[error("participant authority denied")]
+    Authority,
+    #[error("participant transition cancelled")]
+    Cancelled,
+    #[error("participant preparation deadline expired")]
+    Deadline,
+}
+pub type ControlResult<T> = std::result::Result<T, ParticipantControlError>;
+
+pub struct ParticipantScope<'a> {
+    pub session: &'a SessionId,
+    pub conversation: &'a ConversationId,
+    pub principal: &'a AuthenticatedPrincipal,
+    pub mutation: &'a ParticipantMutation,
+    pub connection_generation: Option<u64>,
+}
+
+/// Supplied by the trusted policy, never by a wire body. Permissions are
+/// independent of the requested role. Confirmation must be attributed to this
+/// precise connection generation when the endpoint requires it.
+pub struct ParticipantAuthority {
+    pub actor: Membership,
+    pub target: Membership,
+    pub endpoint: Option<EndpointBinding>,
+    pub may_send_audio: bool,
+    pub may_receive_audio: bool,
+    pub confirmation_required: bool,
+    pub confirmed_generation: Option<u64>,
+}
+
+/// Implementations retain a current-authority read/transaction lock until drop.
+/// Do not call the Orchestrator while holding that same authority lock elsewhere.
+pub trait ParticipantAuthorityLease {
+    fn authority(&self) -> &ParticipantAuthority;
+}
+pub trait ParticipantPolicy: Send + Sync {
+    fn current(
+        &self,
+        scope: &ParticipantScope<'_>,
+    ) -> ControlResult<Box<dyn ParticipantAuthorityLease + '_>>;
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct ParticipantLimits {
+    pub participants: usize,
+    pub connections: usize,
+    pub retained_operations: usize,
+    pub mix_rate_hz: u32,
+}
+impl Default for ParticipantLimits {
+    fn default() -> Self {
+        Self {
+            participants: 4,
+            connections: 6,
+            retained_operations: 4096,
+            mix_rate_hz: 8_000,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum ParticipantRuntimeEvent {
+    Committed(ParticipantObservation),
+    ConnectionEnded {
+        participant: ParticipantId,
+        connection: ConnectionId,
+        revision: u64,
+    },
+}
+
+struct PendingAdmission {
+    participant: ParticipantId,
+    cancellation: CancellationToken,
+}
+struct LiveRoute {
+    _slot: OwnedSemaphorePermit,
+    lifecycle: ConnectionLifecycleTicket,
+}
+struct ManagedState {
+    controller: ParticipantSession,
+    pending: HashMap<ConnectionId, PendingAdmission>,
+    routes: BTreeMap<ConnectionId, LiveRoute>,
+    ended: bool,
+}
+pub(super) struct ManagedParticipantSession {
+    session: SessionId,
+    conversation: ConversationId,
+    policy: Arc<dyn ParticipantPolicy>,
+    mixer: Arc<Conference>,
+    slots: Arc<Semaphore>,
+    limits: ParticipantLimits,
+    state: Mutex<ManagedState>,
+    events: broadcast::Sender<ParticipantRuntimeEvent>,
+}
+
+struct LifecycleDeliveryGuard(ConnectionLifecycleTicket);
+struct LifecycleDeliveryLease<'a> {
+    state: std::sync::MutexGuard<'a, ConnectionLifecycleState>,
+    generation: u64,
+}
+impl DeliveryLease for LifecycleDeliveryLease<'_> {
+    fn is_live(&self) -> bool {
+        self.state.active && !self.state.retired && self.state.generation == self.generation
+    }
+}
+impl DeliveryGuard for LifecycleDeliveryGuard {
+    fn acquire(&self) -> Box<dyn DeliveryLease + '_> {
+        Box::new(LifecycleDeliveryLease {
+            state: self.0.state.lock().unwrap_or_else(|p| p.into_inner()),
+            generation: self.0.generation,
+        })
+    }
+}
+
+/// Owns invisible preparation and its capacity. Dropping an unfinished future
+/// retires the candidate synchronously and schedules bounded supervised cleanup.
+struct AdmissionCandidate {
+    owner: Weak<Orchestrator>,
+    runtime: Arc<ManagedParticipantSession>,
+    connection: ConnectionId,
+    lifecycle: ConnectionLifecycleTicket,
+    ticket: Option<PreparedParticipantAdmission>,
+    member: Option<ConferenceMember>,
+    stream: Option<Arc<dyn crate::stream::MediaStream>>,
+    slot: Option<OwnedSemaphorePermit>,
+    cancellation: CancellationToken,
+    committed: bool,
+    inbound: bool,
+}
+impl Drop for AdmissionCandidate {
+    fn drop(&mut self) {
+        if self.committed {
+            return;
+        }
+        self.runtime
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .pending
+            .remove(&self.connection);
+        if let Some(owner) = self.owner.upgrade() {
+            owner.retire_participant_route(&self.connection);
+        }
+    }
+}
+
+impl Orchestrator {
+    /// Enable checked participant control on an empty initiating Session.
+    /// Its private mixer cannot be mutated through the raw conference API.
+    pub fn enable_participant_control(
+        &self,
+        session_id: &SessionId,
+        policy: Arc<dyn ParticipantPolicy>,
+        limits: ParticipantLimits,
+    ) -> ControlResult<()> {
+        if limits.participants == 0
+            || limits.participants > 256
+            || limits.connections == 0
+            || limits.connections > 512
+            || limits.retained_operations == 0
+            || limits.retained_operations > 65536
+            || ![8_000, 16_000, 24_000, 48_000].contains(&limits.mix_rate_hz)
+        {
+            return Err(ParticipantTransitionError::Invalid.into());
+        }
+        let session = self
+            .session(session_id)
+            .ok_or_else(|| RvoipError::SessionNotFound(session_id.clone()))?;
+        let _registry = self
+            .connection_registry_lock
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let session = session.write().expect("session lock poisoned");
+        if session.state != SessionState::Initiating
+            || !session.participants.is_empty()
+            || !session.connections.is_empty()
+            || self.participant_sessions.contains_key(session_id)
+        {
+            return Err(ParticipantTransitionError::Conflict.into());
+        }
+        let conversation = self
+            .conversation(&session.conversation_id)
+            .ok_or_else(|| RvoipError::ConversationNotFound(session.conversation_id.clone()))?;
+        let conversation = conversation.read().expect("conversation lock poisoned");
+        if conversation.state != ConversationState::Open {
+            return Err(ParticipantTransitionError::Ended.into());
+        }
+        let controller = ParticipantSession::new(
+            conversation.tenant_id.clone(),
+            conversation.id.clone(),
+            session_id.clone(),
+            limits.participants,
+            limits.connections,
+            limits.retained_operations,
+        )?;
+        let (events, _) = broadcast::channel(256);
+        self.participant_sessions.insert(
+            session_id.clone(),
+            Arc::new(ManagedParticipantSession {
+                session: session_id.clone(),
+                conversation: conversation.id.clone(),
+                policy,
+                mixer: Arc::new(Conference::start(limits.mix_rate_hz)),
+                slots: Arc::new(Semaphore::new(limits.connections)),
+                limits,
+                state: Mutex::new(ManagedState {
+                    controller,
+                    pending: HashMap::new(),
+                    routes: BTreeMap::new(),
+                    ended: false,
+                }),
+                events,
+            }),
+        );
+        Ok(())
+    }
+
+    fn participant_runtime(
+        &self,
+        session: &SessionId,
+    ) -> ControlResult<Arc<ManagedParticipantSession>> {
+        self.participant_sessions
+            .get(session)
+            .map(|e| Arc::clone(e.value()))
+            .ok_or_else(|| RvoipError::InvalidState("participant control is not enabled").into())
+    }
+
+    pub fn participant_revision(&self, session: &SessionId) -> ControlResult<u64> {
+        Ok(self
+            .participant_runtime(session)?
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .controller
+            .revision())
+    }
+
+    /// Trusted runtime projection; public callers require the owning service's
+    /// current authorization, as with the raw Session accessor.
+    pub fn participant_session_role(
+        &self,
+        session: &SessionId,
+        participant: &ParticipantId,
+    ) -> ControlResult<Option<ParticipantRole>> {
+        let runtime = self.participant_runtime(session)?;
+        let state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+        Ok(state.controller.role(participant).cloned())
+    }
+
+    /// Trusted process-internal hints. The returned mutation result and retained
+    /// operation receipt are authoritative; public clients need scoped journals.
+    pub fn subscribe_participant_events(
+        &self,
+        session: &SessionId,
+    ) -> ControlResult<broadcast::Receiver<ParticipantRuntimeEvent>> {
+        Ok(self.participant_runtime(session)?.events.subscribe())
+    }
+
+    pub fn participant_capacity(&self, session: &SessionId) -> ControlResult<(usize, usize)> {
+        let runtime = self.participant_runtime(session)?;
+        let state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+        Ok((state.routes.len(), state.pending.len()))
+    }
+
+    fn check_participant_authority(
+        scope: &ParticipantScope<'_>,
+        authority: &ParticipantAuthority,
+    ) -> ControlResult<()> {
+        if scope.principal.is_expired_at(Utc::now())
+            || authority.target.participant() != &scope.mutation.participant
+            || authority.actor.conversation() != scope.conversation
+            || authority.target.conversation() != scope.conversation
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        if !authority.may_receive_audio
+            && !matches!(scope.mutation.change, ParticipantChange::Depart { .. })
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        authority
+            .actor
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| ParticipantControlError::Authority)?;
+        Ok(())
+    }
+
+    /// One checked participant operation. No caller-supplied ready boolean.
+    /// Accepted transport signaling is followed by negotiated duplex stream
+    /// readiness, generation fencing and a NEW policy lease at final commit.
+    pub async fn change_session_participant(
+        self: &Arc<Self>,
+        session_id: &SessionId,
+        principal: AuthenticatedPrincipal,
+        mutation: ParticipantMutation,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<ParticipantObservation> {
+        let runtime = self.participant_runtime(session_id)?;
+        let deadline =
+            deadline.min(tokio::time::Instant::now() + self.config.bridge_stream_deadline);
+        let mut candidate = {
+            let mut state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = ParticipantScope {
+                session: session_id,
+                conversation: &runtime.conversation,
+                principal: &principal,
+                mutation: &mutation,
+                connection_generation: None,
+            };
+            let lease = runtime.policy.current(&scope)?;
+            let authority = lease.authority();
+            Self::check_participant_authority(&scope, authority)?;
+            if let Some(receipt) =
+                state
+                    .controller
+                    .replay(&authority.actor, &authority.target, &mutation)?
+            {
+                return Ok(receipt);
+            }
+            if state.ended {
+                return Err(ParticipantTransitionError::Ended.into());
+            }
+            if cancellation.is_cancelled() {
+                return Err(ParticipantControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(ParticipantControlError::Deadline);
+            }
+            if state.controller.revision() != mutation.expected_revision {
+                return Err(ParticipantTransitionError::Conflict.into());
+            }
+            match &mutation.change {
+                ParticipantChange::Admit {
+                    connection,
+                    role_override,
+                } => {
+                    let endpoint = authority
+                        .endpoint
+                        .as_ref()
+                        .ok_or(ParticipantControlError::Authority)?;
+                    if !authority.may_receive_audio {
+                        return Err(ParticipantControlError::Authority);
+                    }
+                    if state.pending.contains_key(connection)
+                        || self.sessions_by_connection.contains_key(connection)
+                    {
+                        return Err(ParticipantTransitionError::Conflict.into());
+                    }
+                    let pending_new: HashSet<_> = state
+                        .pending
+                        .values()
+                        .map(|p| p.participant.clone())
+                        .filter(|p| state.controller.role(p).is_none())
+                        .collect();
+                    if state.controller.role(&mutation.participant).is_none()
+                        && !pending_new.contains(&mutation.participant)
+                        && state.controller.participant_count() + pending_new.len()
+                            >= runtime.limits.participants
+                    {
+                        return Err(ParticipantTransitionError::Capacity.into());
+                    }
+                    let slot = Arc::clone(&runtime.slots)
+                        .try_acquire_owned()
+                        .map_err(|_| ParticipantTransitionError::Capacity)?;
+                    let ticket = state.controller.prepare_admission(
+                        &authority.target,
+                        endpoint,
+                        connection.clone(),
+                        role_override.clone(),
+                    )?;
+                    let mut lifecycles =
+                        self.capture_connection_lifecycles(std::slice::from_ref(connection))?;
+                    let lifecycle = lifecycles.remove(0);
+                    if endpoint.transport() != self.connection_transport(connection)? {
+                        return Err(ParticipantControlError::Authority);
+                    }
+                    let inbound = self
+                        .connections
+                        .get(connection)
+                        .is_some_and(|e| e.direction == Direction::Inbound);
+                    let _registry = self
+                        .connection_registry_lock
+                        .lock()
+                        .unwrap_or_else(|p| p.into_inner());
+                    // Match raw bridge reservation ordering without taking a
+                    // lifecycle mutex while holding bridge ownership.
+                    let _ownership = self
+                        .bridge_ownership_lock
+                        .lock()
+                        .unwrap_or_else(|p| p.into_inner());
+                    if self
+                        .managed_participant_connections
+                        .contains_key(connection)
+                        || self.sessions_by_connection.contains_key(connection)
+                        || self.cross_bridge_owners.contains_key(connection)
+                    {
+                        return Err(ParticipantTransitionError::Conflict.into());
+                    }
+                    let cancellation = CancellationToken::new();
+                    state.pending.insert(
+                        connection.clone(),
+                        PendingAdmission {
+                            participant: mutation.participant.clone(),
+                            cancellation: cancellation.clone(),
+                        },
+                    );
+                    self.managed_participant_connections
+                        .insert(connection.clone(), Arc::downgrade(&runtime));
+                    Some(AdmissionCandidate {
+                        owner: Arc::downgrade(self),
+                        runtime: Arc::clone(&runtime),
+                        connection: connection.clone(),
+                        lifecycle,
+                        ticket: Some(ticket),
+                        member: None,
+                        stream: None,
+                        slot: Some(slot),
+                        cancellation,
+                        committed: false,
+                        inbound,
+                    })
+                }
+                _ => None,
+            }
+        };
+        if let Some(ready) = &mut candidate {
+            let terminal_cancellation = ready.cancellation.clone();
+            let preparation = async {
+                let adapter = self.adapter_for(&ready.connection)?;
+                // Managed candidates are not yet Session-bound. This accepts
+                // only their exact physical route; failure/drop retires it.
+                if ready.inbound {
+                    adapter.accept(ready.connection.clone()).await?;
+                }
+                let stream = self
+                    .wait_for_stream(
+                        ready.connection.clone(),
+                        StreamSelector::new(StreamKind::Audio)
+                            .with_readiness(crate::stream::MediaReadiness::Bidirectional),
+                        deadline,
+                        ready.cancellation.clone(),
+                    )
+                    .await
+                    .map_err(|_| ParticipantTransitionError::NotReady)?;
+                let outbound = stream.try_frames_out()?;
+                let (tap, inbound) = self
+                    .media_tap_for_connection(
+                        ready.connection.clone(),
+                        crate::conference::MEMBER_TAP_CAPACITY,
+                    )
+                    .await?;
+                let mut member = crate::conference::build_member(
+                    ready.connection.clone(),
+                    inbound,
+                    outbound,
+                    stream.codec(),
+                    runtime.mixer.mix_rate_hz,
+                    Some(Box::new(tap)),
+                )?;
+                member.delivery_guard =
+                    Some(Arc::new(LifecycleDeliveryGuard(ready.lifecycle.clone())));
+                ready.member = Some(member);
+                ready.stream = Some(stream);
+                Ok::<(), ParticipantControlError>(())
+            };
+            tokio::select! {
+                _ = cancellation.cancelled() => return Err(ParticipantControlError::Cancelled),
+                _ = terminal_cancellation.cancelled() => return Err(ParticipantTransitionError::Inactive.into()),
+                result = tokio::time::timeout_at(deadline, preparation) => {
+                    result.map_err(|_| ParticipantControlError::Deadline)??;
+                }
+            }
+        }
+        let mut members = runtime.mixer.members.lock().await;
+        let result = {
+            let mut state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            let scope = ParticipantScope {
+                session: session_id,
+                conversation: &runtime.conversation,
+                principal: &principal,
+                mutation: &mutation,
+                connection_generation: candidate.as_ref().map(|c| c.lifecycle.generation),
+            };
+            let lease = runtime.policy.current(&scope)?;
+            let authority = lease.authority();
+            Self::check_participant_authority(&scope, authority)?;
+            if let Some(receipt) =
+                state
+                    .controller
+                    .replay(&authority.actor, &authority.target, &mutation)?
+            {
+                return Ok(receipt);
+            }
+            if state.ended {
+                return Err(ParticipantTransitionError::Ended.into());
+            }
+            if cancellation.is_cancelled() {
+                return Err(ParticipantControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(ParticipantControlError::Deadline);
+            }
+            let _registry = self
+                .connection_registry_lock
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            let lifecycle_tickets: Vec<_> = candidate
+                .as_ref()
+                .map(|c| vec![c.lifecycle.clone()])
+                .unwrap_or_default();
+            let _lifecycles = self.lock_connection_lifecycles(&lifecycle_tickets)?;
+            let conversation = self
+                .conversation(&runtime.conversation)
+                .ok_or_else(|| RvoipError::ConversationNotFound(runtime.conversation.clone()))?;
+            let mut conversation = conversation.write().expect("conversation lock poisoned");
+            let session = self
+                .session(session_id)
+                .ok_or_else(|| RvoipError::SessionNotFound(session_id.clone()))?;
+            let mut session = session.write().expect("session lock poisoned");
+            if conversation.state != ConversationState::Open
+                || matches!(
+                    session.state,
+                    SessionState::Ending | SessionState::Ended | SessionState::Failed
+                )
+            {
+                return Err(ParticipantTransitionError::Ended.into());
+            }
+            if let Some(existing) = conversation
+                .participants
+                .iter()
+                .find(|p| p.id == mutation.participant)
+            {
+                if existing.identity_ref.as_ref() != Some(authority.target.identity())
+                    || existing.kind != *authority.target.kind()
+                    || existing.left_at.is_some()
+                {
+                    return Err(ParticipantTransitionError::OwnerMismatch.into());
+                }
+            }
+            let ticket = if let Some(ready) = &mut candidate {
+                if authority.endpoint.as_ref().is_none_or(|e| {
+                    self.connection_transport(&ready.connection).ok() != Some(e.transport())
+                }) || !authority.may_receive_audio
+                    || (authority.confirmation_required
+                        && authority.confirmed_generation != Some(ready.lifecycle.generation))
+                {
+                    return Err(ParticipantControlError::Authority);
+                }
+                if ready.cancellation.is_cancelled()
+                    || self.sessions_by_connection.contains_key(&ready.connection)
+                {
+                    return Err(ParticipantTransitionError::Conflict.into());
+                }
+                let stream = ready
+                    .stream
+                    .as_ref()
+                    .ok_or(ParticipantTransitionError::NotReady)?;
+                if !stream.source_ready()
+                    || stream.try_frames_out()?.is_closed()
+                    || !self
+                        .adapter_for(&ready.connection)?
+                        .is_connection_live(&ready.connection)
+                {
+                    return Err(ParticipantTransitionError::NotReady.into());
+                }
+                let endpoint = authority
+                    .endpoint
+                    .as_ref()
+                    .ok_or(ParticipantControlError::Authority)?;
+                let mut ticket = ready
+                    .ticket
+                    .take()
+                    .ok_or(ParticipantTransitionError::NotReady)?;
+                ticket.observe_ready(&authority.target, endpoint, ticket.generation())?;
+                Some(ticket)
+            } else {
+                None
+            };
+            // Locks and adapter inspection can outlive a short credential or
+            // deadline. Recheck time-bound authority at the mutation decision.
+            Self::check_participant_authority(&scope, authority)?;
+            if cancellation.is_cancelled() {
+                return Err(ParticipantControlError::Cancelled);
+            }
+            if tokio::time::Instant::now() >= deadline {
+                return Err(ParticipantControlError::Deadline);
+            }
+            let observation = state.controller.apply(
+                &authority.actor,
+                &authority.target,
+                mutation.clone(),
+                ticket,
+                authority.endpoint.as_ref(),
+            )?;
+            // All fallible checks precede the state commit. Below are local map
+            // changes under the mixer, Session and authority commit fences.
+            if let Some(ready) = &mut candidate {
+                let mut member = ready.member.take().expect("prepared mixer member");
+                member.contributes = authority.may_send_audio;
+                members.insert(ready.connection.clone(), member);
+                session.participants.insert(mutation.participant.clone());
+                session.connections.insert(
+                    ready.connection.clone(),
+                    ConnectionRef {
+                        id: ready.connection.clone(),
+                        participant_id: mutation.participant.clone(),
+                    },
+                );
+                session.state = SessionState::Active;
+                self.sessions_by_connection
+                    .insert(ready.connection.clone(), session_id.clone());
+                state.pending.remove(&ready.connection);
+                state.routes.insert(
+                    ready.connection.clone(),
+                    LiveRoute {
+                        _slot: ready.slot.take().expect("reserved slot"),
+                        lifecycle: ready.lifecycle.clone(),
+                    },
+                );
+                ready.committed = true;
+                if !conversation
+                    .participants
+                    .iter()
+                    .any(|p| p.id == mutation.participant)
+                {
+                    conversation.participants.push(Participant {
+                        id: mutation.participant.clone(),
+                        conversation_id: runtime.conversation.clone(),
+                        identity_ref: Some(authority.target.identity().clone()),
+                        kind: authority.target.kind().clone(),
+                        role: authority.target.default_role().clone(),
+                        display_name: None,
+                        joined_at: Utc::now(),
+                        left_at: None,
+                    });
+                }
+            }
+            if matches!(mutation.change, ParticipantChange::Depart { .. }) {
+                for pending in state
+                    .pending
+                    .values()
+                    .filter(|p| p.participant == mutation.participant)
+                {
+                    pending.cancellation.cancel();
+                }
+            }
+            for connection in &observation.retired {
+                members.remove(connection);
+                session.connections.remove(connection);
+                self.sessions_by_connection.remove(connection);
+                if let Some(route) = state.routes.remove(connection) {
+                    let mut lifecycle = route
+                        .lifecycle
+                        .state
+                        .lock()
+                        .unwrap_or_else(|p| p.into_inner());
+                    lifecycle.active = false;
+                    lifecycle.retired = true;
+                    lifecycle.generation = lifecycle.generation.saturating_add(1);
+                }
+            }
+            if !observation.retired.is_empty() {
+                session.participants.remove(&mutation.participant);
+            }
+            if matches!(mutation.change, ParticipantChange::Depart { .. }) {
+                session.participants.remove(&mutation.participant);
+            }
+            for connection in state.controller.connections(&mutation.participant) {
+                if let Some(member) = members.get_mut(&connection) {
+                    member.contributes = authority.may_send_audio;
+                }
+            }
+            conversation.last_activity_at = Utc::now();
+            // FIFO hints are enqueued inside the same fence as state commit.
+            let _ = runtime
+                .events
+                .send(ParticipantRuntimeEvent::Committed(observation.clone()));
+            observation
+        };
+        drop(members);
+        for connection in &result.retired {
+            self.retire_participant_route(connection);
+        }
+        Ok(result)
+    }
+
+    /// Retire local media first. Physical cleanup may remain quarantined if the
+    /// adapter is uncertain; this never claims a confirmed provider hangup.
+    fn retire_participant_route(self: &Arc<Self>, connection: &ConnectionId) {
+        let adapter = self.adapter_for_cleanup(connection).ok();
+        let forgotten =
+            self.begin_connection_teardown(connection, InboundAdmissionTermination::Cancelled);
+        if let Some(adapter) = adapter {
+            let transport = adapter.transport();
+            let generation = self
+                .connection_lifecycles
+                .get(connection)
+                .map(|s| s.lock().unwrap_or_else(|p| p.into_inner()).generation)
+                .unwrap_or(0);
+            self.adapter_cleanup_quarantines.insert(
+                connection.clone(),
+                AdapterCleanupQuarantine {
+                    transport,
+                    lifecycle_generation: generation,
+                },
+            );
+            let owner = Arc::clone(self);
+            let connection = connection.clone();
+            let _ = self.connection_lifecycle_tasks.spawn(async move {
+                owner
+                    .finish_connection_teardown(&connection, forgotten)
+                    .await;
+                if !adapter.is_connection_live(&connection) {
+                    owner.resolve_adapter_cleanup_quarantine(&connection, transport, generation);
+                    return;
+                }
+                owner
+                    .cleanup_failed_adapter_route(
+                        adapter,
+                        transport,
+                        &connection,
+                        "participant route retired",
+                    )
+                    .await;
+            });
+        }
+    }
+
+    pub(super) fn participant_connection_retired(&self, connection: &ConnectionId) {
+        let runtime = self
+            .managed_participant_connections
+            .remove(connection)
+            .and_then(|(_, r)| r.upgrade());
+        let Some(runtime) = runtime else {
+            return;
+        };
+        let mut state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+        if let Some(pending) = state.pending.get(connection) {
+            pending.cancellation.cancel();
+        }
+        state.routes.remove(connection);
+        if let Some(session) = self.session(&runtime.session) {
+            let mut session = session.write().expect("session lock poisoned");
+            session.connections.remove(connection);
+            self.sessions_by_connection.remove(connection);
+            if session.connections.is_empty() && session.state == SessionState::Active {
+                session.state = SessionState::Initiating;
+            }
+        }
+        if let Ok(Some(participant)) = state.controller.connection_ended(connection) {
+            let _ = runtime
+                .events
+                .send(ParticipantRuntimeEvent::ConnectionEnded {
+                    participant,
+                    connection: connection.clone(),
+                    revision: state.controller.revision(),
+                });
+        }
+    }
+
+    pub(super) async fn end_managed_participant_session(&self, session: &SessionId) {
+        let Some(runtime) = self
+            .participant_sessions
+            .get(session)
+            .map(|e| Arc::clone(e.value()))
+        else {
+            return;
+        };
+        let routes = {
+            let mut mixer = runtime.mixer.members.lock().await;
+            let mut state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            state.ended = true;
+            for pending in state.pending.values() {
+                pending.cancellation.cancel();
+            }
+            let revision = state.controller.revision();
+            let _ = state.controller.end(revision);
+            mixer.clear();
+            runtime.mixer.task.abort();
+            std::mem::take(&mut state.routes)
+        };
+        if let Some(owner) = self.self_weak.get().and_then(Weak::upgrade) {
+            for (connection, _) in routes {
+                owner.retire_participant_route(&connection);
+            }
+        }
+    }
+}
