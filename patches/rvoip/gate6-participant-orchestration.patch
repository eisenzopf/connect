+use bytes::Bytes;
+use chrono::Utc;
+use rvoip_core::{
+    adapter::*, capability::*, connection::*, conversation::ConversationPolicy, identity::*,
+    ids::*, message::Message, orchestrator::participant_control::*, participant::*,
+    participant_transitions::*, relationships::*, session::*, stream::*, Config, Orchestrator,
+    Result, RvoipError,
+};
+use std::{
+    collections::{HashMap, HashSet},
+    sync::{
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        Arc, Mutex, RwLock, RwLockReadGuard,
+    },
+    time::Duration,
+};
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+
+pub struct TestStream {
+    id: StreamId,
+    pub ready: AtomicBool,
+    input: mpsc::Sender<MediaFrame>,
+    inbound: Mutex<Option<mpsc::Receiver<MediaFrame>>>,
+    output: mpsc::Sender<MediaFrame>,
+    receiver: tokio::sync::Mutex<mpsc::Receiver<MediaFrame>>,
+}
+impl TestStream {
+    fn new(ready: bool) -> Arc<Self> {
+        let (input, inbound) = mpsc::channel(128);
+        let (output, receiver) = mpsc::channel(128);
+        Arc::new(Self {
+            id: StreamId::new(),
+            ready: AtomicBool::new(ready),
+            input,
+            inbound: Mutex::new(Some(inbound)),
+            output,
+            receiver: tokio::sync::Mutex::new(receiver),
+        })
+    }
+    pub fn continuous_tone(self: &Arc<Self>) -> (CancellationToken, tokio::task::JoinHandle<()>) {
+        let cancellation = CancellationToken::new();
+        let token = cancellation.clone();
+        let source = Arc::clone(self);
+        let task = tokio::spawn(async move {
+            use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+            let mut encoder = CodecFactory::create_codec(0, Some(8_000), Some(1)).unwrap();
+            let payload = encoder
+                .encode(&AudioFrame {
+                    samples: vec![1800; 160],
+                    sample_rate: 8000,
+                    channels: 1,
+                    duration: Duration::from_millis(20),
+                    timestamp: 0,
+                })
+                .unwrap();
+            let mut timestamp = 0;
+            let mut ticker = tokio::time::interval(Duration::from_millis(20));
+            loop {
+                tokio::select! { _ = token.cancelled() => break, _ = ticker.tick() => {} }
+                if source
+                    .input
+                    .send(MediaFrame {
+                        source_clock: None,
+                        stream_id: source.id.clone(),
+                        kind: StreamKind::Audio,
+                        payload: Bytes::from(payload.clone()),
+                        timestamp_rtp: timestamp,
+                        captured_at: Utc::now(),
+                        payload_type: Some(0),
+                    })
+                    .await
+                    .is_err()
+                {
+                    break;
+                }
+                timestamp = timestamp.wrapping_add(160);
+            }
+        });
+        (cancellation, task)
+    }
+
+    pub async fn assert_receives_audio(&self) {
+        use rvoip_media_core::codec::factory::CodecFactory;
+        let mut receiver = self.receiver.lock().await;
+        while receiver.try_recv().is_ok() {}
+        let mut decoder = CodecFactory::create_codec(0, Some(8_000), Some(1)).unwrap();
