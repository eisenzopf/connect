+pub struct PolicyState {
+    pub members: HashMap<ParticipantId, Membership>,
+    pub endpoints: HashMap<ConnectionId, EndpointBinding>,
+    pub denied: bool,
+    pub send: bool,
+    pub confirmation_required: bool,
+    pub confirmation: Option<u64>,
+}
+pub struct TestPolicy(pub RwLock<PolicyState>);
+struct Lease<'a> {
+    _guard: RwLockReadGuard<'a, PolicyState>,
+    authority: ParticipantAuthority,
+}
+impl ParticipantAuthorityLease for Lease<'_> {
+    fn authority(&self) -> &ParticipantAuthority {
+        &self.authority
+    }
+}
+impl ParticipantPolicy for TestPolicy {
+    fn current(
+        &self,
+        scope: &ParticipantScope<'_>,
+    ) -> ControlResult<Box<dyn ParticipantAuthorityLease + '_>> {
+        let state = self.0.read().unwrap();
+        if state.denied || !scope.principal.has_scope("participant:manage") {
+            return Err(ParticipantControlError::Authority);
+        }
+        let actor = state
+            .members
+            .get(&participant(&scope.principal.subject))
+            .ok_or(ParticipantControlError::Authority)?
+            .clone();
+        let target = state
+            .members
+            .get(&scope.mutation.participant)
+            .ok_or(ParticipantControlError::Authority)?
+            .clone();
+        let endpoint = match &scope.mutation.change {
+            ParticipantChange::Admit { connection, .. } => state.endpoints.get(connection).cloned(),
+            _ => None,
+        };
+        let authority = ParticipantAuthority {
+            actor,
+            target,
+            endpoint,
+            may_send_audio: state.send,
+            may_receive_audio: true,
+            confirmation_required: state.confirmation_required,
+            confirmed_generation: state.confirmation,
+        };
+        Ok(Box::new(Lease {
+            _guard: state,
+            authority,
+        }))
+    }
+}
