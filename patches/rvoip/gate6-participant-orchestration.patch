@@ -0,0 +1,609 @@
+#[path = "support/participant_control_fixture.rs"]
+mod fixture;
+use fixture::*;
+use rvoip_core::{
+    adapter::EndReason, events::Event, orchestrator::participant_control::*, participant::*,
+    participant_transitions::*, session::SessionState,
+};
+use std::{sync::atomic::Ordering, time::Duration};
+use tokio_util::sync::CancellationToken;
+
+#[tokio::test]
+async fn four_participants_six_connections_add_and_remove_during_encoded_audio() {
+    let f = Fixture::new().await;
+    let mut legs = vec![];
+    for name in ["alice", "bob"] {
+        let (id, stream) = f.connection(name, true).await;
+        f.join(&f.session, name, &id).await;
+        legs.push((name, id, stream));
+    }
+    let (tone_cancel, tone_task) = legs[0].2.continuous_tone();
+    legs[1].2.assert_receives_audio().await;
+    for name in ["carol", "dave", "alice", "bob"] {
+        let (id, stream) = f.connection(name, true).await;
+        f.join(&f.session, name, &id).await;
+        legs.push((name, id, stream));
+    }
+    legs[1].2.assert_receives_audio().await;
+    assert_eq!(f.orch.participant_capacity(&f.session).unwrap(), (6, 0));
+    legs[1].2.assert_audible_from(&legs[2].2).await;
+    let intent = f.intent(
+        &f.session,
+        "alice",
+        "leave_alice",
+        ParticipantChange::Depart {
+            cause: DepartureCause::Left,
+        },
+    );
+    let result = f.apply(&f.session, intent).await.unwrap();
+    tone_cancel.cancel();
+    tone_task.await.unwrap();
+    assert_eq!(result.retired.len(), 2);
+    assert_eq!(result.kind, ParticipantObservationKind::Left);
+    assert_eq!(f.orch.participant_capacity(&f.session).unwrap(), (4, 0));
+    let session = f.orch.session(&f.session).unwrap();
+    let session = session.read().unwrap();
+    assert_eq!(session.state, SessionState::Active);
+    assert_eq!(session.connections.len(), 4);
+    assert_eq!(session.participants.len(), 3);
+    drop(session);
+    legs[1].2.assert_audible_from(&legs[3].2).await;
+    let conversation = f.orch.conversation(&f.conversation).unwrap();
+    assert!(conversation
+        .read()
+        .unwrap()
+        .participants
+        .iter()
+        .all(|p| p.left_at.is_none()));
+    until(|| f.adapter.ended.load(Ordering::Acquire) >= 2).await;
+}
+
+#[tokio::test]
+async fn readiness_wait_has_no_presence_and_rechecks_membership_after_negotiation() {
+    let f = Fixture::new().await;
+    let (id, stream) = f.connection("alice", false).await;
+    let intent = f.intent(
+        &f.session,
+        "alice",
+        "pending",
+        ParticipantChange::Admit {
+            connection: id.clone(),
+            role_override: None,
+        },
+    );
+    let orch = f.orch.clone();
+    let sid = f.session.clone();
+    let task = tokio::spawn(async move {
+        orch.change_session_participant(
+            &sid,
+            principal("owner"),
+            intent,
+            tokio::time::Instant::now() + Duration::from_secs(2),
