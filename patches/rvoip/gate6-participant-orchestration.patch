+pub struct TestAdapter {
+    streams: Mutex<HashMap<ConnectionId, Arc<TestStream>>>,
+    live: Mutex<HashSet<ConnectionId>>,
+    events: mpsc::Sender<AdapterEvent>,
+    receiver: Mutex<Option<mpsc::Receiver<AdapterEvent>>>,
+    pub accepted: AtomicUsize,
+    pub ended: AtomicUsize,
+    pub fail_end: AtomicBool,
+    pub delay_after_graph_ms: AtomicUsize,
+}
+impl TestAdapter {
+    fn new() -> Arc<Self> {
+        let (events, receiver) = mpsc::channel(128);
+        Arc::new(Self {
+            streams: Mutex::new(HashMap::new()),
+            live: Mutex::new(HashSet::new()),
+            events,
+            receiver: Mutex::new(Some(receiver)),
+            accepted: AtomicUsize::new(0),
+            ended: AtomicUsize::new(0),
+            fail_end: AtomicBool::new(false),
+            delay_after_graph_ms: AtomicUsize::new(0),
+        })
+    }
+    pub async fn terminate(&self, id: &ConnectionId) {
+        self.live.lock().unwrap().remove(id);
+        self.events
+            .send(AdapterEvent::Ended {
+                connection_id: id.clone(),
+                reason: EndReason::Normal,
+            })
+            .await
+            .unwrap();
+    }
+}
+#[async_trait::async_trait]
+impl ConnectionAdapter for TestAdapter {
+    fn transport(&self) -> Transport {
+        Transport::Sip
+    }
+    fn kind(&self) -> AdapterKind {
+        AdapterKind::Interop
+    }
+    fn is_connection_live(&self, id: &ConnectionId) -> bool {
+        let graph_exists = self
+            .streams
+            .lock()
+            .unwrap()
+            .get(id)
+            .is_some_and(|s| s.inbound.lock().unwrap().is_none());
+        if graph_exists {
+            let delay = self.delay_after_graph_ms.swap(0, Ordering::AcqRel);
+            if delay > 0 {
+                std::thread::sleep(Duration::from_millis(delay as u64));
+            }
+        }
+        self.live.lock().unwrap().contains(id)
+    }
+    async fn originate(&self, _: OriginateRequest) -> Result<ConnectionHandle> {
+        Err(RvoipError::NotImplemented("fixture originate"))
+    }
+    async fn accept(&self, _: ConnectionId) -> Result<()> {
+        self.accepted.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }
+    async fn reject(&self, id: ConnectionId, _: RejectReason) -> Result<()> {
+        self.live.lock().unwrap().remove(&id);
+        Ok(())
+    }
+    async fn end(&self, id: ConnectionId, _: EndReason) -> Result<()> {
+        self.ended.fetch_add(1, Ordering::SeqCst);
+        if self.fail_end.load(Ordering::Acquire) {
+            return Err(RvoipError::InvalidState("fixture end uncertain"));
+        }
+        self.live.lock().unwrap().remove(&id);
+        Ok(())
+    }
+    async fn hold(&self, _: ConnectionId) -> Result<()> {
+        Ok(())
+    }
+    async fn resume(&self, _: ConnectionId) -> Result<()> {
+        Ok(())
+    }
+    async fn transfer(&self, _: ConnectionId, _: TransferTarget) -> Result<()> {
+        Ok(())
+    }
+    async fn streams(&self, id: ConnectionId) -> Result<Vec<Arc<dyn MediaStream>>> {
+        Ok(self
+            .streams
+            .lock()
+            .unwrap()
+            .get(&id)
+            .map(|s| vec![s.clone() as Arc<dyn MediaStream>])
+            .unwrap_or_default())
+    }
+    async fn send_message(&self, _: ConnectionId, _: Message) -> Result<()> {
+        Ok(())
+    }
+    async fn send_dtmf(&self, _: ConnectionId, _: &str, _: u32) -> Result<()> {
+        Ok(())
+    }
+    async fn renegotiate_media(
+        &self,
+        _: ConnectionId,
+        _: CapabilityDescriptor,
+    ) -> Result<NegotiatedCodecs> {
+        Ok(NegotiatedCodecs::default())
+    }
+    fn subscribe_events(&self) -> mpsc::Receiver<AdapterEvent> {
+        self.receiver.lock().unwrap().take().unwrap()
+    }
+    fn capabilities(&self) -> CapabilityDescriptor {
+        CapabilityDescriptor::default()
+    }
+    async fn verify_request_signature(
+        &self,
+        _: ConnectionId,
+        _: SignatureHeaders,
+    ) -> Result<IdentityAssurance> {
+        Ok(IdentityAssurance::Anonymous)
+    }
+}
