+pub struct Fixture {
+    pub orch: Arc<Orchestrator>,
+    pub adapter: Arc<TestAdapter>,
+    pub policy: Arc<TestPolicy>,
+    pub conversation: ConversationId,
+    pub session: SessionId,
+}
+impl Fixture {
+    pub async fn new() -> Self {
+        let orch = Orchestrator::new(Config::default());
+        let adapter = TestAdapter::new();
+        orch.register(adapter.clone()).unwrap();
+        let conversation = orch
+            .open_conversation(
+                TenantId::from_string("tenant_test"),
+                ConversationPolicy::Persistent,
+                HashMap::new(),
+            )
+            .await
+            .unwrap();
+        let mut members = HashMap::new();
+        for name in ["owner", "alice", "bob", "carol", "dave"] {
+            let binding = IdentityBinding::from_authenticated(
+                &principal(name),
+                IdentityId::from_string(format!("id_{name}")),
+                Utc::now(),
+            )
+            .unwrap();
+            members.insert(
+                participant(name),
+                Membership::admit(
+                    binding,
+                    conversation.clone(),
+                    participant(name),
+                    ParticipantKind::Human,
+                    ParticipantRole::Agent,
+                )
+                .unwrap(),
+            );
+        }
+        let policy = Arc::new(TestPolicy(RwLock::new(PolicyState {
+            members,
+            endpoints: HashMap::new(),
+            denied: false,
+            send: true,
+            confirmation_required: false,
+            confirmation: None,
+        })));
+        let session = orch
+            .start_session(conversation.clone(), SessionMedium::Voice, vec![])
+            .await
+            .unwrap();
+        orch.enable_participant_control(&session, policy.clone(), ParticipantLimits::default())
+            .unwrap();
+        Self {
+            orch,
+            adapter,
+            policy,
+            conversation,
+            session,
+        }
+    }
+    pub async fn second_session(&self) -> SessionId {
+        let session = self
+            .orch
+            .start_session(self.conversation.clone(), SessionMedium::Voice, vec![])
+            .await
+            .unwrap();
+        self.orch
+            .enable_participant_control(&session, self.policy.clone(), ParticipantLimits::default())
+            .unwrap();
+        session
+    }
+    pub async fn connection(&self, name: &str, ready: bool) -> (ConnectionId, Arc<TestStream>) {
+        let id = ConnectionId::new();
+        let stream = TestStream::new(ready);
+        self.adapter
+            .streams
+            .lock()
+            .unwrap()
+            .insert(id.clone(), stream.clone());
+        self.adapter.live.lock().unwrap().insert(id.clone());
+        let binding = IdentityBinding::from_authenticated(
+            &principal(name),
+            IdentityId::from_string(format!("id_{name}")),
+            Utc::now(),
+        )
+        .unwrap();
+        let mut endpoint = EndpointBinding::provision(
+            binding.clone(),
+            EndpointId::new(),
+            DeviceId::new(),
+            Transport::Sip,
+            "sip:private-fixture.invalid".into(),
+        )
+        .unwrap();
+        endpoint
+            .verify(&binding, "proof_fixture".into(), Utc::now())
+            .unwrap();
+        self.policy
+            .0
+            .write()
+            .unwrap()
+            .endpoints
+            .insert(id.clone(), endpoint);
+        self.adapter
+            .events
+            .send(AdapterEvent::InboundConnection {
+                connection: Connection {
+                    id: id.clone(),
+                    session_id: SessionId::new(),
+                    participant_id: ParticipantId::new(),
+                    transport: Transport::Sip,
+                    direction: Direction::Inbound,
+                    state: ConnectionState::Connecting,
+                    capabilities: CapabilityDescriptor::default(),
+                    negotiated_codecs: NegotiatedCodecs::default(),
+                    streams: vec![],
+                    messaging_enabled: false,
+                    transport_handle: TransportHandle(Arc::new(())),
+                    opened_at: Utc::now(),
+                    closed_at: None,
+                },
+            })
+            .await
+            .unwrap();
+        until(|| self.orch.connection_transport(&id).is_ok()).await;
+        (id, stream)
+    }
+    pub fn intent(
+        &self,
+        session: &SessionId,
+        name: &str,
+        op: &str,
+        change: ParticipantChange,
+    ) -> ParticipantMutation {
+        ParticipantMutation {
+            operation_id: op.into(),
+            correlation_id: format!("corr_{op}"),
+            expected_revision: self.orch.participant_revision(session).unwrap(),
+            participant: participant(name),
+            change,
+        }
+    }
+    pub async fn apply(
+        &self,
+        session: &SessionId,
+        intent: ParticipantMutation,
+    ) -> ControlResult<ParticipantObservation> {
+        self.orch
+            .change_session_participant(
+                session,
+                principal("owner"),
+                intent,
+                tokio::time::Instant::now() + Duration::from_secs(2),
+                CancellationToken::new(),
+            )
+            .await
+    }
+    pub async fn join(
+        &self,
+        session: &SessionId,
+        name: &str,
+        id: &ConnectionId,
+    ) -> ParticipantObservation {
+        self.apply(
+            session,
+            self.intent(
+                session,
+                name,
+                &format!("join_{}", id.as_str()),
+                ParticipantChange::Admit {
+                    connection: id.clone(),
+                    role_override: None,
+                },
+            ),
+        )
+        .await
+        .unwrap()
+    }
+}
+pub async fn until(mut predicate: impl FnMut() -> bool) {
+    tokio::time::timeout(Duration::from_secs(3), async {
+        while !predicate() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("fixture condition");
+}
