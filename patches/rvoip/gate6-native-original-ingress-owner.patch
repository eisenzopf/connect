+#[tokio::test]
+async fn original_native_queue_preserves_order_other_stream_progress_expiry_and_shutdown() {
+    for action in 0..3 {
+        let mut network = Network::new("quic").await;
+        let policy = Arc::new(TemporaryMetadata {
+            policy: network.grants.clone(),
+            gate: std::sync::Mutex::new(()),
+            only: std::sync::Mutex::new(None),
+            entered: Notify::new(),
+            refused: std::sync::atomic::AtomicUsize::new(0),
+        });
+        let source = network.configure_policy(0, policy.clone()).await;
+        let other = network.configure_policy(1, policy.clone()).await;
+        network.start(&source, &[Medium::Audio]).await;
+        network.start(&other, &[Medium::Audio]).await;
+        *policy.only.lock().unwrap() = Some(source.id.clone());
+        let mut input = source
+            .controller
+            .take_ingress(&StreamId::from_string("audio"))
+            .unwrap();
+        let mut healthy = other
+            .controller
+            .take_ingress(&StreamId::from_string("audio"))
+            .unwrap();
+        let stream = binding(&source, Medium::Audio).stream_local_id;
+        let held = policy.gate.lock().unwrap();
+        send(&network.wire, ordered_audio(stream, 1));
+        tokio::time::timeout(Duration::from_secs(1), policy.entered.notified())
+            .await
+            .unwrap();
+        send(&network.wire, ordered_audio(stream, 2));
+        send(
+            &network.wire,
+            ordered_audio(binding(&other, Medium::Audio).stream_local_id, 1),
+        );
+        let fresh = tokio::time::timeout(Duration::from_millis(100), healthy.recv())
+            .await
+            .ok()
+            .flatten();
+        let independent = observed_original(&network, &source, fresh, 160).await;
+        let outcome;
+        if action == 2 {
+            network.stop().await;
+            drop(held);
+            outcome = input.try_recv().is_err();
+        } else {
+            if action == 1 {
+                tokio::time::sleep(Duration::from_millis(210)).await;
+            }
+            drop(held);
+            if action == 0 {
+                let first = tokio::time::timeout(Duration::from_millis(100), input.recv())
+                    .await
