+    pub(crate) async fn prepare_audience_cut(&self, facts: AudiencePreparationFacts) -> ControlResult<PreparedAudienceCut> {
+        if facts.cancellation.is_cancelled() { return Err(StreamControlError::Cancelled); }
+        if tokio::time::Instant::now() >= facts.deadline { return Err(StreamControlError::Deadline); }
+        let AudiencePreparationFacts { plan, members, targets, next_groups, muted_source,
+            original, receiver_origins, roles, freeze, deadline, cancellation } = facts;
+        let mut prepared = Vec::with_capacity(targets.len());
+        // Each facts value and reservation is consumed exactly once. A later
+        // final metadata Busy returns THIS completed prepared object, not facts.
+        for target in targets {
+            let audio=target.audio.prepare_cold(deadline,&cancellation).await?;
+            let direct=match target.direct {Some(direct)=>Some(direct.prepare_cold(deadline,&cancellation,&target.controller.shutdown).await?),None=>None};
+            let mut ports=Vec::with_capacity(target.ports.len());
+            for port in target.ports {ports.push(port.prepare_cold(deadline,&cancellation,&target.controller.shutdown).await?);}
+            prepared.push(PreparedAudienceTarget {
+                controller: target.controller, credential: target.credential,
+                audio,direct,ports,
+                gate: target.gate, inherited_gates: target.inherited_gates,
+            });
+        }
+        let mut prepared_roles=Vec::with_capacity(roles.len());
+        for (role,speaks) in roles {prepared_roles.push((role.prepare_cold(deadline,&cancellation).await?,speaks));}
+        let roles=prepared_roles;
+        let mut audio_adoption = None;
+        let mut public_adoptions = Vec::new();
+        if let Some(replacement) = &plan.replacement {
+            let old = &members[&replacement.request.source].controller;
+            let target = &members[&replacement.request.admitted];
+            audio_adoption = loop {
+                let result = target.audio_consumer.subscriptions.capture_audio_adoption_cut(old, &target.controller, &replacement.pending);
+                match result {
+                    Err(StreamControlError::MetadataBusy) => super::media_subscriptions::metadata_wait(target.controller.shutdown.clone(), cancellation.clone(), cancellation.clone(), deadline).await?,
+                    result => break result?,
+                }
+            };
+            for target in &prepared {
+                if let Some(direct) = &target.direct {
+                    let snapshot = &members[&target.controller.connection].state;
+                    let adoption = loop {
+                        match direct.prepare_public_video_adoption_snapshot(&target.controller, snapshot, replacement) {
+                            Err(StreamControlError::MetadataBusy) => super::media_subscriptions::metadata_wait(target.controller.shutdown.clone(), cancellation.clone(), cancellation.clone(), deadline).await?,
+                            result => break result?,
+                        }
+                    };
+                    if let Some(adoption) = adoption { public_adoptions.push((target.controller.clone(), adoption)); }
+                }
+            }
+            if replacement.public_video_warm_started.load(Ordering::Acquire) && public_adoptions.len()!=1 { return Err(StreamControlError::Authority); }
+        }
+        Ok(PreparedAudienceCut {
+            #[cfg(test)] test_panic_at:None, plan, members, targets: prepared, next_groups, muted_source,
+            original, receiver_origins, roles, freeze, audio_adoption, public_adoptions, deadline, cancellation })
+    }
+
+    pub(crate) fn begin_audience_final_turn(
+        &self, prepared: &PreparedAudienceCut,
+        grant: &crate::orchestrator::participant_control::FinalControlGrant<'_>,
+    ) -> ControlResult<AudienceFinalTurn> {
+        if prepared.cancellation.is_cancelled() || grant.cancellation().is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let mut deadline = prepared.deadline.min(grant.deadline());
+        if tokio::time::Instant::now() >= deadline { return Err(StreamControlError::Deadline); }
+        // Capture only TRY metadata, then release all registry/state guards
+        // before the first actual external current_control/receive callback.
+        let members = self.capture_control_members_matching(&prepared.members)?;
+        if !exact_members(&members, &prepared.plan) { return Err(MediaTransitionError::Conflict.into()); }
+        preflight_cut_metadata(&prepared.plan,&members,prepared.freeze.as_ref())?;
+        let mut direct_sources:Vec<super::direct_subscriptions::DirectSourceSnapshot>=Vec::new();
+        for target in &prepared.targets {
+            if let Some(direct)=&target.direct {
+                for (controller,logical) in direct.selected_source_scopes()? {
+                    if let Some(source)=direct_sources.iter_mut().find(|source|Arc::ptr_eq(&source.controller,&controller)) {source.logical.insert(logical);continue;}
+                    let (state,state_poisoned)=if let Some(member)=members.values().find(|member|Arc::ptr_eq(&member.controller,&controller)) {
+                        (member.state.control_metadata_snapshot(),member.state_poisoned)
+                    } else {
+                        let (state,poisoned)=match controller.state.try_lock() {Ok(state)=>(state,false),Err(std::sync::TryLockError::WouldBlock)=>return Err(StreamControlError::MetadataBusy),Err(std::sync::TryLockError::Poisoned(error))=>(error.into_inner(),true)};
+                        (state.control_metadata_snapshot(),poisoned)
+                    };
+                    direct_sources.push(super::direct_subscriptions::DirectSourceSnapshot {controller,state,state_poisoned,logical:BTreeSet::from([logical])});
+                }
+            }
+        }
+        let native_capabilities=prepared.targets.iter().map(|target|(target.controller.connection.clone(),target.controller.adapter.native_sequence_cursors())).collect::<BTreeMap<_,_>>();
+        let mut controls = BTreeMap::new();
+        let mut reads = super::control_turn_reads::Reads::default();
+        for target in &prepared.targets {
+            target.controller.check_credential_snapshot(&target.credential)?;
+            let scope = target.controller.scope(&target.credential.principal, MediaPurpose::Control);
+            let intent = if prepared.plan.replacement.is_some() {
+                MediaControlIntent::DeviceReplacement { plan: &prepared.plan }
+            } else { MediaControlIntent::Handoff { plan: &prepared.plan } };
+            grant.check_media_current(&target.controller, &scope, &intent)?;
+            let control = target.controller.policy.current_control(&scope, &intent, grant.held())?;
+            deadline = deadline.min(control.deadline);
+            let owner = reads.read(super::control_turn_reads::Key::owner(&scope), || control.authority())?;
+            StreamController::check(&scope, &owner)?;
+            let member = members.get(&target.controller.connection).ok_or(StreamControlError::Authority)?;
+            member.state.model.check_routing(&owner.current(), prepared.plan.expected[&target.controller.connection])?;
+            target.audio.validate_with_reads(self, &members, member, &member.state, &scope, &owner, Some(&control), None, &mut reads)?;
+            if let Some(direct) = &target.direct {
+                direct.validate_with_reads(&target.controller, &member.state, &scope, &control, &direct_sources, &mut reads)?;
+            }
+            control.valid()?;
+            grant.check_media_current(&target.controller, &scope, &intent)?;
+            controls.insert(target.controller.connection.clone(), control);
+        }
+        if tokio::time::Instant::now() >= deadline { return Err(StreamControlError::Deadline); }
+        let intent=if prepared.plan.replacement.is_some(){MediaControlIntent::DeviceReplacement {plan:&prepared.plan}}else{MediaControlIntent::Handoff {plan:&prepared.plan}};
+        reads.check_sources(grant,&intent)?;
+        reads.begin_guarded_validation();
+        Ok(AudienceFinalTurn { controls, reads, members, direct_sources, native_capabilities, deadline })
+    }
+
+    pub(crate) fn capture_audience_cut_facts(
+        &self, plan: AudioAudiencePlan, deadline: tokio::time::Instant,
+        cancel: CancellationToken, held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<AudiencePreparationFacts> {
+        // Failure-only metadata for private activation; no packet-path logging.
+        let refused = |stage: &'static str, id: &ConnectionId, error: StreamControlError| {
+            if plan.request.activate_muted.is_some() {
+                tracing::debug!(target: "rvoip_core::replacement_commit",
+                    operation = %plan.request.operation_id, connection = %id, stage, ?error,
+                    "Private audience refused before publication");
+            }
+            error
+        };
+        if plan.scene != self.id {
+            return Err(StreamControlError::Authority);
+        }
+        if let Some(restoration)=plan.replacement.as_ref().and_then(|replacement|replacement.restoration.as_ref()) {restoration.validate_replacement_commit(&plan)?;}
+        if plan.replacement.is_none() == plan.handoff.is_none() {
+            return Err(StreamControlError::Authority);
+        }
+        let members = self.capture_control_members()?;
+        if !exact_members(&members, &plan) { return Err(MediaTransitionError::Conflict.into()); }
+        let controllers = members.iter().map(|(id, member)| (id.clone(), member.controller.clone())).collect::<BTreeMap<_, _>>();
+        let registry = super::control_metadata::try_lock(&self.audiences)?.metadata_snapshot();
+        let freeze=plan.replacement.as_ref().map(|replacement|replacement.video_freeze.capture_cut_facts()).transpose()?;
+        preflight_cut_metadata(&plan,&members,freeze.as_ref())?;
+        // Only the sealed muted singleton may retain its already-installed
+        // rule identity. The original group remains an immutable same-owner
+        // predicate; the new handle still records this distinct activation.
+        let equivalent_preparation = if plan.preparation_muted {
+            Some(plan.require_equivalent_preparation()?.clone())
+        } else {
+            None
+        };
+        // Pending-public warm owns an unadopted actual B seal/writer. W1 may
+        // warm or abort, but cannot publish until exact protection/adoption is
+        // implemented; no generic Commit may silently drop/reseal that owner.
+        let mut controls = BTreeMap::new();
+        let mut deadline = deadline;
+        // Fresh publication authority cannot extend the original owned freeze.
+        // The same minimum is checked immediately before infallible effects.
+        if let Some(original)=freeze.as_ref().and_then(|freeze|freeze.original_deadline()) {
+            deadline=deadline.min(original);
+        }
+        if tokio::time::Instant::now()>=deadline {return Err(StreamControlError::Deadline);}
+        for (id, controller) in &controllers {
+            let credential = controller.credential_snapshot();
+            let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+            let intent = if plan.replacement.is_some() {
+                MediaControlIntent::DeviceReplacement { plan: &plan }
+            } else if plan.handoff.is_some() {
+                MediaControlIntent::Handoff { plan: &plan }
+            } else {
+                MediaControlIntent::AudioAudience { plan: &plan }
+            };
+            let control = controller
+                .policy
+                .current_control(&scope, &intent, held)
+                .map_err(|error| refused("current-control", id, error))?;
+            deadline = deadline
+                .min(control.deadline)
+                .min(StreamController::command_deadline(
+                    &credential.principal,
+                    deadline,
+                ));
+            controls.insert(id.clone(), (credential, control));
+        }
+        let mut original = BTreeMap::new();
+        let mut receiver_origins = BTreeMap::new();
+        let (targets, next_groups, muted_source) = {
+            if !exact_members(&members, &plan)
+                || registry.revision != plan.request.expected_revision
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            let mut groups = registry.groups.clone();
+            if plan
+                .replacement
+                .as_ref()
+                .is_some_and(|r| r.restoration.is_some())
+                && (plan.replaced_audiences.len() != 1
+                    || !registry
+                        .restorable
+                        .contains(&plan.replaced_audiences[0].operation))
+            {
+                return Err(StreamControlError::Authority);
+            }
+            let muted_source = if let Some(restore) = &plan.restore {
+                if !groups
+                    .get(&plan.group.operation)
+                    .is_some_and(|g| Arc::ptr_eq(g, &plan.group))
+                {
+                    return Err(MediaTransitionError::Conflict.into());
+                }
+                groups.remove(&plan.group.operation);
+                if let Some(source) = restore
+                    .muted_source
+                    .as_ref()
+                    .filter(|origin| members.values().any(|m| origin.matches(&m.controller)))
+                {
+                    // Keep the old private provider Context isolated after main
+                    // audio resumes, even if external cleanup is uncertain.
+                    groups.insert(
+                        plan.group.operation.clone(),
+                        Arc::new(ClosedAudience {
+                            operation: plan.group.operation.clone(),
+                            origins: vec![source.clone()],
+                            routing_identity: None,
+                            endpoint_probe_retired: std::sync::atomic::AtomicBool::new(false),
+                        }),
+                    );
+                }
+                original = restore.original.clone();
+                receiver_origins = restore.receivers.clone();
+                restore.muted_source.clone()
+            } else {
+                if let Some(prepared) = &plan.replaced_preparation {
+                    if !groups
+                        .remove(&prepared.operation)
+                        .is_some_and(|g| Arc::ptr_eq(&g, prepared))
+                    {
+                        return Err(MediaTransitionError::Conflict.into());
+                    }
+                }
+                if let Some(replacement) = &plan.replacement {
+                    if !groups
+                        .remove(&replacement.preparation.operation)
+                        .is_some_and(|g| Arc::ptr_eq(&g, &replacement.preparation))
+                    {
+                        return Err(MediaTransitionError::Conflict.into());
+                    }
+                }
+                for replaced in &plan.replaced_audiences {
+                    if !groups
+                        .remove(&replaced.operation)
+                        .is_some_and(|g| Arc::ptr_eq(&g, replaced))
+                    {
+                        return Err(MediaTransitionError::Conflict.into());
+                    }
+                    if let Some(handoff) = &plan.handoff {
+                        // A separate fresh target never inherits the old private
+                        // model's content. Unselected original private ports keep
+                        // a closed quarantine after their audience is consumed.
+                        let origins = replaced
+                            .origins
+                            .iter()
+                            .filter(|origin| {
+                                members.values().any(|m| origin.matches(&m.controller))
+                                    && !plan.group.origins.iter().any(|new| {
+                                        Weak::ptr_eq(&new.controller, &origin.controller)
+                                    })
+                                    && !handoff.outgoing.contains_key(&origin.connection)
+                            })
+                            .cloned()
+                            .collect::<Vec<_>>();
+                        if !origins.is_empty() {
+                            groups.insert(
+                                replaced.operation.clone(),
+                                Arc::new(ClosedAudience {
+                                    operation: replaced.operation.clone(),
+                                    origins,
+                                    routing_identity: None,
+                                    endpoint_probe_retired: std::sync::atomic::AtomicBool::new(
+                                        false,
+                                    ),
+                                }),
+                            );
+                        }
+                    }
+                }
+                groups.insert(plan.group.operation.clone(), plan.group.clone());
+                for id in plan.request.receivers.keys() {
+                    let target = &members[id];
+                    original.insert(
+                        id.clone(),
+                        target.audio_consumer.subscriptions.try_saved_program()?,
+                    );
+                    receiver_origins.insert(id.clone(), AudienceOrigin::new(&target.controller));
+                }
+                plan.request
+                    .activate_muted
+                    .as_ref()
+                    .map(|id| AudienceOrigin::new(&members[id].controller))
+            };
+            let mut targets = Vec::new();
+            for (id, controller) in &controllers {
+                let member = &members[id];
+                let (credential, control) = controls.remove(id).unwrap();
+                let state = &member.state;
+                if state.closed || controller.shutdown.is_cancelled() {
+                    return Err(StreamControlError::Cancelled);
+                }
+                // Exact readiness/F metadata already passed the try-only
+                // snapshot preflight; no old locking validator is called here.
+                let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+                let owner = control
+                    .authority()
+                    .map_err(|error| refused("prepare-owner", id, error))?;
+                StreamController::check(&scope, &owner)?;
+                state
+                    .model
+                    .check_routing(&owner.current(), plan.expected[id])?;
+                let mut rules = groups
+                    .values()
+                    .map(|group| {
+                        let group = group.routing_identity.as_ref().unwrap_or(group);
+                        AudioAudienceRule {
+                            group: group.clone(),
+                            inside: group.contains(controller),
+                        }
+                    })
+                    .collect::<Vec<_>>();
+                if equivalent_preparation.is_some() {
+                    // Preserve this receiver's actual installed rule order.
+                    // Private members can join between earlier activations.
+                    let current = member.audio_consumer.subscriptions.try_rules()?;
+                    let duplicate = |values: &[AudioAudienceRule]| {
+                        values.iter().enumerate().any(|(index, value)| {
+                            values[..index]
+                                .iter()
+                                .any(|prior| Arc::ptr_eq(&prior.group, &value.group))
+                        })
