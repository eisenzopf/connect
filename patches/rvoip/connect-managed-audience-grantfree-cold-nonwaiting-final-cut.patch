+/// have dropped. Only an actual committed cut may release its preexisting F.
+/// New final-turn pauses are never retained here.
+pub(crate) struct AudiencePostPublication {
+    prepared: Option<PreparedAudienceCut>,
+    committed: bool,
+    scene:Weak<GuardedMediaScene>,
+}
+impl AudiencePostPublication {
+    pub(crate) async fn finish(mut self)->ControlResult<()> {
+        if let Some(mut prepared)=self.prepared.take() {
+            if self.committed {
+                // Actual publication already happened. The original terminal
+                // supervisor retains this SAME cleanup obligation while map
+                // metadata is Busy; expiry/cancel cannot erase retirement.
+                if let Some(freeze)=prepared.freeze.take() {freeze.finish_committed();}
+                if let Some(scene)=self.scene.upgrade() {
+                    let mut expected=Vec::new();
+                    if let Some(replacement)=&prepared.plan.replacement {
+                        if let Some(member)=prepared.members.get(&replacement.request.source) {expected.push((replacement.request.source.clone(),Some(member.controller.clone())));}
+                    }
+                    if let Some(handoff)=&prepared.plan.handoff {
+                        if handoff.request.old_disposition==super::handoff::OldHandoffDisposition::Leave {
+                            for id in handoff.outgoing.keys() {if let Some(member)=prepared.members.get(id) {expected.push((id.clone(),Some(member.controller.clone())));}}
+                        }
+                    }
+                    expected.sort_by(|a,b|a.0.cmp(&b.0));expected.dedup_by(|a,b|a.0==b.0);
+                    loop {
+                        match scene.try_remove_committed_members(&expected) {
+                            Ok(())=>break,
+                            Err(StreamControlError::MetadataBusy)=>tokio::time::sleep(Duration::from_millis(2)).await,
+                            Err(error)=>return Err(error),
+                        }
+                    }
+                }
+            }
+            if !self.committed {for (_,adoption) in &mut prepared.public_adoptions {adoption.retire_partial_publication();}}
+            drop(prepared);
+        }
+        Ok(())
+    }
+}
