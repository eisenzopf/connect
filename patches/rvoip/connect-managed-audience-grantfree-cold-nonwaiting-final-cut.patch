+//! Immutable cold control facts. This owns neither an IO consumer nor a grant.
+//! Actual membership, model and port identities are rechecked at publication.
+use super::*;
+use super::media_scene::{GuardedMediaScene, SceneMember};
+use super::scene_consumer::SceneConsumer;
+
+pub(super) struct CapturedMember {
+    pub(super) controller: Arc<StreamController>,
+    pub(super) consumer: Arc<SceneConsumer>,
+    pub(super) audio_consumer: Arc<audio_consumer::AudioConsumer>,
+    pub(super) state: State,
+    pub(super) state_poisoned: bool,
+    logical: Option<StreamId>,
+}
+
+/// Borrowed view shared by ordinary live validation and cold snapshot paths.
+/// It has no Drop that retires a consumer and cannot be used to adopt a member.
+#[derive(Clone, Copy)]
+pub(super) struct MemberView<'a> {
+    pub(super) controller: &'a Arc<StreamController>,
+    pub(super) consumer: &'a Arc<SceneConsumer>,
+    pub(super) audio_consumer: &'a Arc<audio_consumer::AudioConsumer>,
+    pub(super) captured_state: Option<&'a State>,
+    pub(super) captured_poisoned: bool,
+    captured_logical: Option<&'a Option<StreamId>>,
+}
+pub(super) trait MemberRead {
+    fn view(&self) -> MemberView<'_>;
+}
+impl MemberRead for SceneMember {
+    fn view(&self) -> MemberView<'_> {
+        self.control_view()
+    }
+}
+impl MemberRead for CapturedMember {
+    fn view(&self) -> MemberView<'_> {
+        MemberView {
+            controller: &self.controller,
+            consumer: &self.consumer,
+            audio_consumer: &self.audio_consumer,
+            captured_state: Some(&self.state),
+            captured_poisoned: self.state_poisoned,
+            captured_logical: Some(&self.logical),
+        }
+    }
+}
+impl MemberRead for MemberView<'_> {
+    fn view(&self) -> MemberView<'_> { *self }
+}
+impl<'a> MemberView<'a> {
+    pub(super) fn live(
+        controller: &'a Arc<StreamController>,
+        consumer: &'a Arc<SceneConsumer>,
+        audio_consumer: &'a Arc<audio_consumer::AudioConsumer>,
+    ) -> Self {
+        Self { controller, consumer, audio_consumer, captured_state: None, captured_poisoned: false, captured_logical: None }
+    }
+    pub(super) fn current_logical(&self) -> Option<StreamId> {
+        match self.captured_logical {
+            Some(logical) => logical.clone(),
+            None => self.audio_consumer.logical(),
+        }
+    }
+    pub(super) fn current_descriptor(&self, state: &State, publishing: bool) -> ControlResult<Option<MediaSource>> {
+        if state.closed || self.controller.shutdown.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let Some(logical) = self.current_logical() else { return Ok(None); };
+        let Some(port) = state.active.get(&logical) else { return Ok(None); };
+        if state.model.streams().get(&logical).is_none_or(|stream| stream.state == LogicalStreamState::Ended) {
+            return Err(StreamControlError::NotReady);
+        }
+        let direction = port.binding.negotiated.requested.direction;
+        if (publishing && direction == StreamDirection::Send) || (!publishing && direction == StreamDirection::Receive) {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(Some(MediaSource {
+            conversation: self.controller.conversation.clone(), session: self.controller.session.clone(),
+            connection: self.controller.connection.clone(), participant: self.controller.origin_member.participant().clone(),
+            membership_epoch: self.controller.origin_member.epoch(), connection_generation: port.binding.connection_generation,
+            logical_id: logical, transport_id: port.binding.transport_id.clone(), stream_generation: port.binding.generation,
+        }))
+    }
+}
+
+impl GuardedMediaScene {
+    pub(super) fn capture_control_members(&self) -> ControlResult<std::collections::HashMap<ConnectionId, CapturedMember>> {
+        self.capture_control_members_checked(None)
+    }
+    pub(super) fn capture_control_members_matching(&self,expected:&std::collections::HashMap<ConnectionId,CapturedMember>)->ControlResult<std::collections::HashMap<ConnectionId,CapturedMember>> {
