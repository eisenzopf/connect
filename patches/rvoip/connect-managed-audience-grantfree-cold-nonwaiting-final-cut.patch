+//! Real recorded F, original warm B, managed model and queued video controls.
+//! This fixture models physical-native callbacks, not browser decoded quality,
+//! SQL Writer release, remote profiles or any complete Gate6 qualification.
+use super::*;
+use super::super::managed_model_cut_controls::ReplacementCutCurrent;
+use crate::orchestrator::participant_control::{ManagedCutAttempt,ManagedCutPublished,PreparedManagedCut};
+
+fn command(ready:&Ready)->Command {Command::Audience {root:ready.grant.clone(),plan:ready.plan.media().audience().clone()}}
+fn authority(ready:&Ready)->ParticipantReplacementAuthority {
+    ReplacementLease(ready.grant.clone()).current(&ParticipantReplacementScope {
+        conversation:ready.grant.domain.member.conversation(),session:&ready.grant.domain.session,
+        principal:&ready.grant.domain.principal,intent:&ready.grant.intent,phase:ReplacementPhase::Commit,
+        plan:Some(ready.plan.media()),
+    }).unwrap()
+}
+async fn cold(room:&ManagedRoom,ready:&Ready)->PreparedManagedCut {
+    let held=command(ready);
+    let facts=loop {
+        match room.orch.capture_staged_replacement_cut_facts(&ready.plan,ready.grant.until,CancellationToken::new(),&held) {
+            Ok(facts)=>break facts,
+            Err(ParticipantControlError::Media(StreamControlError::MetadataBusy))=> {
+                assert!(tokio::time::Instant::now()<ready.grant.until);
+                tokio::time::sleep(Duration::from_millis(1)).await;
+            }
+            Err(error)=>panic!("original warm capture refused: {error:?}"),
+        }
+    };
+    // No planning invocation alias survives asynchronous cold preparation.
+    drop(held);
+    room.orch.prepare_staged_managed_cut(facts).await.unwrap()
+}
+fn attempt(room:&ManagedRoom,ready:&Ready,prepared:PreparedManagedCut)->ManagedCutAttempt {
+    let witness=ReplacementCutCurrent::capture(room,&ready.grant,&ready.plan,"warm-original-attempt","warm-original-effect");
+    let role=authority(ready);let held=command(ready);let cancel=CancellationToken::new();
+    room.orch.try_commit_prepared_managed_cut(prepared,witness.grant(&role,&held,&cancel))
+}
+async fn publish(room:&ManagedRoom,ready:&Ready,mut prepared:PreparedManagedCut)->ManagedCutPublished {
+    loop {match attempt(room,ready,prepared) {
+        ManagedCutAttempt::Published(published)=>return published,
+        ManagedCutAttempt::StillUnpublished(returned)=> {
+            assert!(tokio::time::Instant::now()<ready.grant.until);
+            prepared=returned.into_prepared();tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+        ManagedCutAttempt::Refused {error,post}|ManagedCutAttempt::EffectPossible {error,post}=> {
+            room.orch.finish_managed_cut_publication(post).await.unwrap();panic!("original warm final cut refused: {error:?}");
+        }
+    }}
+}
+async fn healthy(room:&mut ManagedRoom)->(ConnectionId,ConnectionId,mpsc::Receiver<QueuedMedia>) {
+    let source=room.initial(domain(&room.conversation,&room.session,"warm-cut-healthy-source","carol")).await;
+    let target=room.initial(domain(&room.conversation,&room.session,"warm-cut-healthy-target","dave")).await;
+    room.select(&target,vec![AudioSubscription::Connection(source.clone())]).await;
+    let publisher=room.nodes[&source].controller.clone();let receiver=room.nodes[&target].controller.clone();
+    receiver.change_direct_subscriptions(receiver.revision(),DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(&publisher,desired(Medium::Video).logical_id,desired(Medium::Video).logical_id)]),deadline(),CancellationToken::new(),None).await.unwrap();
+    let output=room.nodes[&target].backend.port(Medium::Video).take_egress().unwrap();
+    (source,target,output)
+}
+async fn warm_io(room:&ManagedRoom,source:&ConnectionId,output:&mut mpsc::Receiver<QueuedMedia>,family:&Arc<PhysicalVideoExposure>,timestamp:u32)->usize {
+    let(packet,point)=video_packet(&room.nodes[source],timestamp,None);let point=point.unwrap();
