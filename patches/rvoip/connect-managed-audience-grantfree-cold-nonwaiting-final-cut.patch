+//! Exact all-or-none PortState ownership for one synchronous final cut.
+use super::*;
+pub(super) struct PortCutGuards<'a> {
+    states: Vec<(&'a Arc<Port>, std::sync::MutexGuard<'a, PortState>, bool)>,
+}
+impl<'a> PortCutGuards<'a> {
+    pub(super) fn try_acquire(ports: &'a [Arc<Port>]) -> ControlResult<Self> {
+        let mut unique=ports.iter().collect::<Vec<_>>();
+        unique.sort_by_key(|port|Arc::as_ptr(port) as usize);
+        unique.dedup_by(|a,b|Arc::ptr_eq(a,b));
+        let states=unique.into_iter().map(|port| {
+            let (state,poisoned)=match port.state.try_lock() {Ok(state)=>(state,false),Err(std::sync::TryLockError::WouldBlock)=>return Err(StreamControlError::MetadataBusy),Err(std::sync::TryLockError::Poisoned(error))=>(error.into_inner(),true)};
+            Ok((port,state,poisoned))
+        }).collect::<ControlResult<Vec<_>>>()?;
+        Ok(Self {states})
+    }
+    pub(super) fn get(&self,port:&Arc<Port>)->ControlResult<&PortState> {
+        self.states.iter().find(|(actual,_,_)|Arc::ptr_eq(actual,port)).map(|(_,state,_)|&**state).ok_or(StreamControlError::Authority)
+    }
+    pub(super) fn poisoned(&self,port:&Arc<Port>)->bool {self.states.iter().find(|(actual,_,_)|Arc::ptr_eq(actual,port)).is_some_and(|(_,_,poisoned)|*poisoned)}
+    pub(super) fn get_mut(&mut self,port:&Arc<Port>)->ControlResult<&mut PortState> {
+        self.states.iter_mut().find(|(actual,_,_)|Arc::ptr_eq(actual,port)).map(|(_,state,_)|&mut **state).ok_or(StreamControlError::Authority)
+    }
+    pub(super) fn tickets(&self)->Vec<PeerRouteTicket> {
+        self.states.iter().flat_map(|(port,_,_)|port.ticket_snapshot().all().into_iter().chain(port.baseline.all())).collect()
+    }
+    pub(super) fn retire(&mut self,port:&Arc<Port>,tickets:&mut rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>) {
+        let state=self.get_mut(port).expect("complete original retiring PortState set");
+        if matches!(state.status,PortStatus::Closed|PortStatus::Retired|PortStatus::Quarantined) {return;}
+        let current=port.ticket_snapshot();
+        for side in [TicketSide::Ingress,TicketSide::Egress] {
+            if !tickets.retire_if_current(&current.ticket(side)) {tickets.retire_if_current(&port.baseline.ticket(side));}
+        }
+        state.status=PortStatus::Retired;
+    }
+}
