+fn cut_resources(plan:&AudioAudiencePlan,members:&std::collections::HashMap<ConnectionId,CapturedMember>)->ControlResult<(Vec<Arc<Port>>,Vec<Arc<audio_consumer::AudioConsumer>>,Vec<PeerRouteTicket>)> {
+    let mut ports=members.values().flat_map(|member|member.state.active.values().cloned()).collect::<Vec<_>>();
+    let mut consumers=members.values().map(|member|member.audio_consumer.clone()).collect::<Vec<_>>();
+    let mut tickets=Vec::new();
+    if let Some(replacement)=&plan.replacement {ports.extend(replacement.cut_ports()?);consumers.extend(replacement.cut_consumers()?);tickets.extend(replacement.cut_tickets());}
+    if let Some(handoff)=&plan.handoff {ports.extend(handoff.cut_ports()?);consumers.extend(handoff.cut_consumers()?);tickets.extend(handoff.cut_tickets());}
+    Ok((ports,consumers,tickets))
+}
+fn peer_guard_error(error:rvoip_core_traits::peer_switch::PeerRouteGuardError)->StreamControlError {
+    match error {rvoip_core_traits::peer_switch::PeerRouteGuardError::MetadataBusy=>StreamControlError::MetadataBusy,
+        rvoip_core_traits::peer_switch::PeerRouteGuardError::DeliveryBusy=>StreamControlError::Backpressure,
+        _=>MediaTransitionError::Conflict.into(),}
+}
+fn preflight_cut_metadata(plan:&AudioAudiencePlan,members:&std::collections::HashMap<ConnectionId,CapturedMember>,freeze:Option<&super::old_video_freeze::OldVideoFreezeCutFacts>)->ControlResult<()> {
+    let (all_ports,all_consumers,mut all_tickets)=cut_resources(plan,members)?;
+    let frozen=freeze.map(|facts|facts.try_lock()).transpose()?;
+    let ports=super::control_port_guards::PortCutGuards::try_acquire(&all_ports)?;
+    let consumers=audio_consumer::ConsumerCutGuards::try_acquire(&all_consumers)?;
+    all_tickets.extend(ports.tickets());all_tickets.extend(consumers.tickets());
+    if let Some(frozen)=&frozen {all_tickets.extend(frozen.tickets());}
+    let tickets=rvoip_core_traits::peer_switch::PeerRouteGuardSet::try_acquire(&all_tickets).map_err(peer_guard_error)?;
+    for member in members.values() {
+        if let Some(replacement)=&plan.replacement {
+            replacement.validate_target_cut(&member.controller,&member.state,&consumers,&ports,&tickets)?;
+            frozen.as_ref().ok_or(StreamControlError::Authority)?.validate_target(replacement,&member.controller,&member.state,&ports,&tickets)?;
+        }
+        if let Some(handoff)=&plan.handoff {handoff.validate_target_cut(&member.controller,&member.state,&consumers,&ports,&tickets)?;}
+    }
+    Ok(())
