+// These controls use the actual Core publication/controller/queued IO, with the
+// existing explicit optional-adapter metadata recorder. They do not manufacture
+// native peer closure, B decoded readiness or a public media grant from a floor.
+#[tokio::test]
+async fn published_video_protection_survives_original_cutoff_after_actual_controller_publication() {
+    for mode in ["published","dropped","foreign","retired"] {
+    let (realm,old_exposure,old_coverage)=namespace();
+    let mut f=Preroll::new_with_physical_exposure(false,Some(old_exposure.clone())).await;
+    let target=f.movement.room.nodes["device"].controller.clone();
+    let target_port=f.movement.room.nodes["device"].adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+    let exposure=Arc::new(PhysicalVideoExposure::default());
+    let coverage=Arc::new(PhysicalVideoExposureCoverage::new(false));
+    exposure.configure_expected_realm(realm.handle().incarnation());exposure.bind_coverage(coverage.clone());
+    target_port.observe_physical_video_exposure(exposure.observer());
+    let plan=f.movement.plan_with_video(Some(request())).unwrap();
+    let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+    let result=caught(async {
+        let old_frame=OriginalVideoFrame::observed_in_realm(9,11,81,81,Some(&realm.handle()));
+        let before=old_frame.frame_realm().unwrap();
+        f.publish_video("bob",81);let original=outgoing(&mut f.old_output).await;
+        original.deliver(|_|async {old_exposure.record_potential(Some(before));Ok(())}).await.unwrap();
+        let cutoff=deadline();let check=||Ok(());
+        let frozen=f.movement.room.scene.freeze_old_video(&plan,before.incarnation(),cutoff,CancellationToken::new(),&grant,&check).await.unwrap();
+        exposure.inherit_frontier(frozen.frontier());
+        let seal=coverage.try_seal().unwrap();
+        let pending={let state=target.state.lock().unwrap();target.stage_published_video_protection(&state,&target_port.0,seal,frozen.frontier()).unwrap()};
+        assert!(pending.current());assert!(!coverage.mark_escaped());
+        match mode {
+            "dropped"=>{drop(pending);assert!(!coverage.mark_escaped());return None;},
+            "foreign"=>{assert!(pending.publish(&f.movement.room.nodes["bob"].controller).is_err());assert!(!coverage.mark_escaped());return None;},
+            "retired"=>{target.retire();assert!(!pending.current());assert!(pending.publish(&target).is_err());assert!(!coverage.mark_escaped());return None;},
+            _=>{},
+        }
+        let floor=pending.publish(&target).unwrap();
+        let committed=f.movement.commit(plan.clone()).await.unwrap();
+        assert_eq!(committed.1.finish_local_media_cleanup(deadline()).await,ReplacementCleanupOutcome::LocalMediaClosed);
+        assert_eq!(floor.ordinal(),before.ordinal());
+        assert_eq!(floor.realm(),before.incarnation());
+        // No original plan/FrozenOwner deadline, control Reader or WarmOwner is
+        // stored by the published lifetime. The original cutoff really expires.
+        tokio::time::sleep_until(cutoff).await;
+        assert!(floor.current());assert!(!coverage.mark_escaped());
+        assert!(matches!(floor.require_original_frame(Some(&old_frame)),Err(StreamControlError::Authority)));
+        // Controlled original producer grouping occurs once BEFORE publication/
+        // fanout; the optional adapter records this SAME point before target IO.
+        let original=OriginalVideoFrame::observed_in_realm(9,11,82,82,Some(&realm.handle()));
