+        assert_eq!(exposure.observer().snapshot().unwrap().maximum_potential_ordinal,original.frame_realm().unwrap().ordinal());
+        Some(floor)
+    }).await;
+    drop(grant);drop(plan);finish(&f).await;
+    if let Ok(Some(floor))=&result {assert!(!floor.current());}
+    assert!(!coverage.mark_escaped());assert!(!old_coverage.mark_escaped());
+    let weak=Arc::downgrade(&target);drop(target);drop(f);
+    assert!(weak.upgrade().is_none(),"published metadata must not retain its original Controller");
+    if let Err(error)=result {std::panic::resume_unwind(error)}
+    }
+}
