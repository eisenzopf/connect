@@ -0,0 +1,207 @@
+//! Continuous no-escape ownership after public admission. This is NOT an IO
+//! permission, source cut, physical drain or authorization to restore OLD.
+use super::*;
+use super::old_video_freeze::FrozenOldVideoFrontier;
+use super::physical_video_exposure::{PhysicalVideoExposureSeal,PhysicalVideoSealWitness};
+use std::sync::atomic::AtomicBool;
+
+enum State {
+    Empty,
+    Staging(Weak<()>),
+    Published(PhysicalVideoExposureSeal),
+    Loaned(Weak<()>),
+    Retired,
+}
+/// One original Controller owns this slot. Its fields own no Controller, Port,
+/// plan, Root, policy Reader, warm deadline/cancel token or ancestor chain.
+pub(super) struct ProtectionSlot {
+    owner:Weak<()>,
+    live:AtomicBool,
+    floor:std::sync::OnceLock<(u128,u64)>,
+    state:Mutex<State>,
+}
+impl ProtectionSlot {
+    fn new(owner:Weak<()>)->Arc<Self> {
+        Arc::new(Self {owner,live:AtomicBool::new(true),floor:std::sync::OnceLock::new(),state:Mutex::new(State::Empty)})
+    }
+    fn same_owner(&self,controller:&StreamController)->bool {
+        self.owner.strong_count()!=0 && Weak::ptr_eq(&self.owner,&Arc::downgrade(&controller.subscription_commit_identity))
+    }
+    pub(super) fn retire(&self) {
+        self.live.store(false,Ordering::Release);
+        let previous=std::mem::replace(&mut *self.state.lock().unwrap_or_else(|p|p.into_inner()),State::Retired);
+        if let State::Published(seal)=previous {seal.retire();}
+        // A staged/loan owner still owns the SAME token. Its Drop retires it;
+        // this live=false invalidates every observation immediately meanwhile.
+    }
+    fn stage(self:&Arc<Self>,seal:PhysicalVideoExposureSeal,realm:u128,floor:u64)->ControlResult<PendingProtection> {
+        let mut seal=Some(seal);
+        let result=(||{
+            if realm==0 || !self.live.load(Ordering::Acquire) || self.owner.strong_count()==0
+                || !seal.as_ref().unwrap().is_current() {return Err(StreamControlError::Cancelled);}
+            let mut state=self.state.lock().map_err(|_|StreamControlError::Authority)?;
+            if !matches!(*state,State::Empty) {return Err(StreamControlError::NotReady);}
+            self.floor.set((realm,floor)).map_err(|_|StreamControlError::Authority)?;
+            let claim=Arc::new(());
+            *state=State::Staging(Arc::downgrade(&claim));
+            Ok(PendingProtection{slot:Arc::downgrade(self),claim,seal:seal.take()})
+        })();
+        // Transfer failures never use the raw seal's default abort-to-unexposed
+        // semantics after possibly warmed B. This wrapper is explicitly terminal.
+        if let Some(seal)=seal {seal.retire();}
+        result
+    }
+    fn loan(self:&Arc<Self>,observer:&PhysicalVideoExposureObserver)->ControlResult<PreflightProtection> {
+        if !self.live.load(Ordering::Acquire) || self.owner.strong_count()==0 {return Err(StreamControlError::Cancelled);}
+        let mut state=self.state.lock().map_err(|_|StreamControlError::Authority)?;
+        let State::Published(seal)=&*state else {return Err(StreamControlError::NotReady);};
+        if !seal.is_current() || observer.snapshot_sealed(seal).is_none() {return Err(StreamControlError::Unsupported);}
+        let State::Published(seal)=std::mem::replace(&mut *state,State::Retired) else {unreachable!()};
+        let claim=Arc::new(());
+        *state=State::Loaned(Arc::downgrade(&claim));
+        Ok(PreflightProtection {seal:Some(seal),loan:Some(LoanKey{slot:Arc::downgrade(self),claim})})
+    }
+}
+impl Drop for ProtectionSlot {fn drop(&mut self){self.retire();}}
+
+/// A control-only pending move. The original final commit must install this
+/// before its infallible model publication, after all authority validation.
+/// Failed/dropped staging never reopens raw access.
+pub(super) struct PendingProtection {slot:Weak<ProtectionSlot>,claim:Arc<()>,seal:Option<PhysicalVideoExposureSeal>}
+impl PendingProtection {
+    pub(super) fn current(&self)->bool {
+        self.slot.upgrade().is_some_and(|slot|slot.live.load(Ordering::Acquire))
+            && self.seal.as_ref().is_some_and(PhysicalVideoExposureSeal::is_current)
+    }
+    pub(super) fn publish(mut self,controller:&StreamController)->ControlResult<PublishedVideoFloor> {
+        let slot=self.slot.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if !slot.same_owner(controller) || controller.shutdown.is_cancelled() || !self.current() {return Err(StreamControlError::Cancelled);}
+        let mut state=slot.state.lock().map_err(|_|StreamControlError::Authority)?;
+        if !matches!(&*state,State::Staging(key) if Weak::ptr_eq(key,&Arc::downgrade(&self.claim))) {return Err(StreamControlError::Authority);}
+        let seal=self.seal.take().ok_or(StreamControlError::Authority)?;
+        let witness=seal.witness();
+        *state=State::Published(seal);
+        let (realm,floor)=slot.floor.get().copied().ok_or(StreamControlError::Authority)?;
+        Ok(PublishedVideoFloor{slot:Arc::downgrade(&slot),seal:witness,realm,floor})
+    }
+}
+impl Drop for PendingProtection {
+    fn drop(&mut self) {
+        if let Some(seal)=self.seal.take(){seal.retire();
+            if let Some(slot)=self.slot.upgrade(){
+                let mut state=slot.state.lock().unwrap_or_else(|p|p.into_inner());
+                if matches!(&*state,State::Staging(key) if Weak::ptr_eq(key,&Arc::downgrade(&self.claim))) {
+                    slot.live.store(false,Ordering::Release);*state=State::Retired;
+                }
+            }
+        }
+    }
+}
+/// Immutable lifetime floor, independent of the OLD Root/preparation deadline.
+/// The ordinary public route must ALSO own its original current policy/IO guards.
+/// This weak metadata cannot retain the Controller or resurrect a retired peer.
+#[derive(Clone)]
+pub(super) struct PublishedVideoFloor {slot:Weak<ProtectionSlot>,seal:PhysicalVideoSealWitness,realm:u128,floor:u64}
+impl PublishedVideoFloor {
+    pub(super) fn current(&self)->bool {
+        self.slot.upgrade().is_some_and(|slot|slot.live.load(Ordering::Acquire) && slot.owner.strong_count()!=0)
+            && self.seal.is_current()
+    }
+    pub(super) fn realm(&self)->u128 {self.realm}
+    pub(super) fn ordinal(&self)->u64 {self.floor}
+    pub(super) fn require_original_frame(&self,frame:Option<&Arc<OriginalVideoFrame>>)->ControlResult<()> {
+        if !self.current(){return Err(StreamControlError::Cancelled);}
+        let point=frame.and_then(|frame|frame.frame_realm()).ok_or(StreamControlError::Unsupported)?;
+        if point.incarnation()!=self.realm || point.ordinal()<=self.floor {return Err(StreamControlError::Authority);}
+        Ok(())
+    }
+}
+struct LoanKey {slot:Weak<ProtectionSlot>,claim:Arc<()>}
+impl LoanKey {
+    fn return_exact(&self,seal:PhysicalVideoExposureSeal)->ControlResult<()> {
+        let mut seal=Some(seal);
+        let result=(||{
+            let slot=self.slot.upgrade().ok_or(StreamControlError::Cancelled)?;
+            if !slot.live.load(Ordering::Acquire) || slot.owner.strong_count()==0 || !seal.as_ref().unwrap().is_current(){return Err(StreamControlError::Cancelled);}
+            let mut state=slot.state.lock().map_err(|_|StreamControlError::Authority)?;
+            if !matches!(&*state,State::Loaned(key) if Weak::ptr_eq(key,&Arc::downgrade(&self.claim))){return Err(StreamControlError::Authority);}
+            *state=State::Published(seal.take().unwrap());Ok(())
+        })();
+        if let Some(seal)=seal {seal.retire();self.terminal();}
+        result
+    }
+    fn terminal(&self) {
+        if let Some(slot)=self.slot.upgrade(){
+            let mut state=slot.state.lock().unwrap_or_else(|p|p.into_inner());
+            if matches!(&*state,State::Loaned(key) if Weak::ptr_eq(key,&Arc::downgrade(&self.claim))){
+                slot.live.store(false,Ordering::Release);*state=State::Retired;
+            }
+        }
+    }
+}
+/// No IO quiescence has begun. A failed preflight returns an already-public
+/// seal to the same owner; it does not resume any IO or release raw exclusion.
+pub(super) struct PreflightProtection {seal:Option<PhysicalVideoExposureSeal>,loan:Option<LoanKey>}
+impl PreflightProtection {
+    pub(super) fn as_seal(&self)->&PhysicalVideoExposureSeal {self.seal.as_ref().expect("owned preflight seal")}
+    pub(super) fn freeze(mut self)->FrozenProtection {
+        FrozenProtection{seal:self.seal.take(),loan:self.loan.take()}
+    }
+}
+impl Drop for PreflightProtection {
+    fn drop(&mut self){
+        if let Some(seal)=self.seal.take(){if let Some(key)=&self.loan {let _=key.return_exact(seal);}else{drop(seal);}}
+    }
+}
+/// Nonclone exact token loan while OLD is frozen. Drop is fail-closed. Returning
+/// this metadata alone NEVER resumes a PeerQuiescenceGuard or grants OLD media.
+pub(super) struct FrozenProtection {seal:Option<PhysicalVideoExposureSeal>,loan:Option<LoanKey>}
+impl FrozenProtection {
+    pub(super) fn as_seal(&self)->&PhysicalVideoExposureSeal {self.seal.as_ref().expect("owned frozen seal")}
+    pub(super) fn is_current(&self)->bool {self.seal.as_ref().is_some_and(PhysicalVideoExposureSeal::is_current) && self.loan.as_ref().is_none_or(|key|key.slot.upgrade().is_some_and(|slot|slot.live.load(Ordering::Acquire)))}
+    pub(super) fn witness(&self)->PhysicalVideoSealWitness {self.as_seal().witness()}
+    pub(super) fn retire(self){drop(self);}
+    /// Core-internal ownership move ONLY, for the future exact-discard + fresh
+    /// OLD-authority restore transaction. There is intentionally no public
+    /// restore entrypoint or caller bool. Existing HeldOldVideo Drop still
+    /// retires all IO tickets unless that separate protocol consumes its guards.
+    pub(super) fn return_after_validated_restore(mut self,controller:&StreamController)->ControlResult<()> {
+        let key=self.loan.as_ref().ok_or(StreamControlError::Unsupported)?;
+        let slot=key.slot.upgrade().ok_or(StreamControlError::Cancelled)?;
+        if !slot.same_owner(controller) || controller.shutdown.is_cancelled(){return Err(StreamControlError::Authority);}
+        let seal=self.seal.take().ok_or(StreamControlError::Cancelled)?;
+        self.loan.take().ok_or(StreamControlError::Unsupported)?.return_exact(seal)
+    }
+}
+impl Drop for FrozenProtection {
+    fn drop(&mut self){if let Some(seal)=self.seal.take(){seal.retire();if let Some(key)=&self.loan{key.terminal();}}}
+}
+impl StreamController {
+    /// Original control-plane publication only. The caller owns the actual
+    /// target State guard; no policy/model lock is acquired by this helper.
+    pub(super) fn stage_published_video_protection(&self,state:&super::State,port:&Arc<Port>,seal:PhysicalVideoExposureSeal,frontier:&FrozenOldVideoFrontier)->ControlResult<PendingProtection> {
+        let mut seal=Some(seal);
+        let result=(||{
+            if self.shutdown.is_cancelled() || state.closed
+                || !port.owner.upgrade().is_some_and(|owner|std::ptr::eq(owner.as_ref(),self))
+                || !state.active.values().any(|actual|Arc::ptr_eq(actual,port))
+                || port.binding.negotiated.requested.medium!=Medium::Video
+                || !matches!(port.binding.negotiated.requested.direction,StreamDirection::Send|StreamDirection::Both) {return Err(StreamControlError::Authority);}
+            let snapshot=AdapterMediaPort(port.clone()).physical_video_exposure_sealed(seal.as_ref().unwrap()).ok_or(StreamControlError::Unsupported)?;
+            if !snapshot.coverage_complete || snapshot.realm_incarnation!=Some(frontier.realm_incarnation())
+                || snapshot.inherited_potential_ordinal<frontier.ordinal(){return Err(StreamControlError::Unsupported);}
+            let slot=self.published_video_protection.get_or_init(||ProtectionSlot::new(Arc::downgrade(&self.subscription_commit_identity)));
+            slot.stage(seal.take().unwrap(),frontier.realm_incarnation(),frontier.ordinal())
+        })();
+        if let Some(seal)=seal {seal.retire();}result
+    }
+    pub(super) fn preflight_old_video_protection(&self,observer:&PhysicalVideoExposureObserver)->ControlResult<PreflightProtection> {
+        if self.shutdown.is_cancelled(){return Err(StreamControlError::Cancelled);}
+        if let Some(slot)=self.published_video_protection.get(){
+            if !slot.same_owner(self){return Err(StreamControlError::Authority);}
+            return slot.loan(observer); // never drop/reseal or downgrade a protected peer
+        }
+        let seal=observer.try_seal_coverage().ok_or(StreamControlError::Unsupported)?;
+        Ok(PreflightProtection{seal:Some(seal),loan:None})
+    }
+}
