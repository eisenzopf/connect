+/// Per installed video writer feedback metadata only. The reserved role uses
+/// its actual PortIo stop; these channels grant neither media nor source IO.
+pub(crate) struct VideoFeedbackSignals {
+    pub(crate) picture: Arc<tokio::sync::Notify>,
+    pub(crate) repair: Arc<VideoRepairRequests>,
+    stop: Option<tokio_util::sync::CancellationToken>,
+}
+impl VideoFeedbackSignals {
+    #[cfg(test)]
+    pub(crate) fn preview(
+        picture: Arc<tokio::sync::Notify>,
+        repair: Arc<VideoRepairRequests>,
+    ) -> Self {
+        Self { picture, repair, stop: None }
+    }
+    pub(crate) fn reserved(stop: tokio_util::sync::CancellationToken) -> Self {
+        Self {
+            picture: Arc::new(tokio::sync::Notify::new()),
+            repair: Arc::new(VideoRepairRequests::default()),
+            stop: Some(stop),
+        }
+    }
+    fn current(&self) -> bool {
+        self.stop.as_ref().is_none_or(|stop| !stop.is_cancelled())
+    }
+}
+// Exactly one extra native writer role per peer, never an arbitrary SSRC map.
+// No native track, PortIo, worker, peer, policy reader or permission is retained.
+pub(crate) struct ReservedVideoFeedback {
+    ssrc: u32,
+    track: std::sync::Weak<webrtc::media_stream::track_local::static_rtp::TrackLocalStaticRTP>,
+    signals: std::sync::Weak<VideoFeedbackSignals>,
+}
+impl ReservedVideoFeedback {
+    pub(crate) fn new(
+        ssrc: u32,
+        track: &Arc<webrtc::media_stream::track_local::static_rtp::TrackLocalStaticRTP>,
+        signals: &Arc<VideoFeedbackSignals>,
+    ) -> Self {
+        Self { ssrc, track: Arc::downgrade(track), signals: Arc::downgrade(signals) }
+    }
+    pub(crate) fn signals_for(&self, ssrc: u32) -> Option<Arc<VideoFeedbackSignals>> {
+        if self.ssrc != ssrc || self.track.strong_count() == 0 {
+            return None;
+        }
+        self.signals.upgrade().filter(|signals| signals.current())
+    }
+    fn current_signals(&self) -> Option<Arc<VideoFeedbackSignals>> {
+        self.signals_for(self.ssrc)
     }
 }
 
