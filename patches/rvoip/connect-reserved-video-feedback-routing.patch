+//! Exact handler routing with two live writer identities and independent
+//! consumers. Native Track metadata is real; no RTP write or Core grant is
+//! modeled as successful here. The real two-MID transport control is separate.
+use super::*;
+use futures::FutureExt as _;
+use rtc::media_stream::MediaStreamTrack;
+use rtc::rtp_transceiver::rtp_sender::RtpCodecKind;
+use tokio_util::sync::CancellationToken;
+use webrtc::media_stream::track_local::static_rtp::TrackLocalStaticRTP;
+
+fn reserved(
+    channels: &HandlerChannels,
+    ssrc: u32,
+) -> (
+    Arc<TrackLocalStaticRTP>,
+    Arc<VideoFeedbackSignals>,
+    CancellationToken,
+) {
+    let track = Arc::new(TrackLocalStaticRTP::new(MediaStreamTrack::new(
+        "two-writers".into(),
+        format!("reserved-{ssrc}"),
+        "video".into(),
+        RtpCodecKind::Video,
+        vec![],
+    )));
+    let stop = CancellationToken::new();
+    let signals = Arc::new(VideoFeedbackSignals::reserved(stop.clone()));
+    assert!(channels
+        .reserved_video_feedback
+        .set(ReservedVideoFeedback::new(ssrc, &track, &signals))
+        .is_ok());
+    (track, signals, stop)
+}
+
+#[tokio::test]
+async fn two_writer_nacks_reach_only_their_own_armed_consumer_and_keep_each_bound() {
+    for bssrc in [0, 11] {
+        let (channels, _, _, _, _, _) = HandlerChannels::pair(8);
+        *channels.local_video_ssrc.lock() = Some(7);
+        let a = channels.video_repair_requests.clone();
+        let legacy_picture = channels.video_feedback.clone();
+        let (track, b, stop) = reserved(&channels, bssrc);
+        assert_eq!(Arc::strong_count(&track), 1, "registration retains Weak only");
+        let handler = ConnectionHandler::new(channels.clone());
+        let a_wait = a.changed();
+        let b_wait = b.repair.changed();
+        tokio::pin!(a_wait, b_wait);
+        assert!(a_wait.as_mut().now_or_never().is_none());
+        assert!(b_wait.as_mut().now_or_never().is_none());
+        // Both actual original waiters are registered before either event.
+        handler.on_unrepaired_video_nack(bssrc, &[100, 101]).await;
+        handler.on_unrepaired_video_nack(7, &[1, 2]).await;
+        handler.on_unrepaired_video_nack(13, &[99]).await;
+        tokio::time::timeout(std::time::Duration::from_secs(1), async {
+            tokio::join!(a_wait.as_mut(), b_wait.as_mut());
+        })
+        .await
+        .expect("neither writer may steal the other's only wake");
+        assert_eq!(a.take(), vec![(7, 1), (7, 2)]);
+        assert_eq!(b.repair.take(), vec![(bssrc, 100), (bssrc, 101)]);
+        assert!(a.take().is_empty() && b.repair.take().is_empty());
+        assert!(legacy_picture.notified().now_or_never().is_none());
+        let sequences = (0..80).collect::<Vec<u16>>();
+        for _ in 0..3 {
+            tokio::join!(
+                handler.on_unrepaired_video_nack(7, &sequences),
+                handler.on_unrepaired_video_nack(bssrc, &sequences),
+            );
+        }
+        let ap = a.take();
+        let bp = b.repair.take();
+        assert_eq!(ap.len(), 64);
+        assert_eq!(bp.len(), 64);
+        assert!(ap.iter().enumerate().all(|(i, key)| *key == (7, i as u16)));
+        assert!(bp
+            .iter()
+            .enumerate()
+            .all(|(i, key)| *key == (bssrc, i as u16)));
+        // Cancellation is the SAME original B PortIo stop in production.
+        // Even an observer retaining signals cannot reactivate the writer.
+        stop.cancel();
+        handler.on_unrepaired_video_nack(bssrc, &[1000]).await;
+        assert!(b.repair.take().is_empty());
+        assert!(channels
+            .reserved_video_feedback
+            .get()
+            .unwrap()
+            .signals_for(bssrc)
+            .is_none());
+        handler.on_unrepaired_video_nack(7, &[3]).await;
+        assert_eq!(a.take(), vec![(7, 3)]);
+    }
+}
