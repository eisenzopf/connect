+#[tokio::test]
+async fn two_writer_picture_feedback_matches_each_fir_role_once_and_refuses_retirement() {
+    use rtc::rtcp::payload_feedbacks::{
+        full_intra_request::FullIntraRequest, picture_loss_indication::PictureLossIndication,
+    };
+    let (channels, _, _, _, _, _) = HandlerChannels::pair(8);
+    *channels.local_video_ssrc.lock() = Some(7);
+    let a = channels.video_feedback.clone();
+    let (track, b, stop) = reserved(&channels, 11);
+    let handler = ConnectionHandler::new(channels.clone());
+    let pli = |ssrc| PictureLossIndication {
+        sender_ssrc: 1,
+        media_ssrc: ssrc,
+    };
+    assert!(!handler.on_rtcp_packet(&pli(13)).await);
+    assert!(a.notified().now_or_never().is_none());
+    assert!(b.picture.notified().now_or_never().is_none());
+    assert!(handler.on_rtcp_packet(&pli(11)).await);
+    assert!(b.picture.notified().now_or_never().is_some());
+    assert!(a.notified().now_or_never().is_none(), "unused preview cannot wake for B");
+    let mut fir = FullIntraRequest::default();
+    for ssrc in [11, 7, 11, 13, 7] {
+        fir.fir.push(Default::default());
+        fir.fir.last_mut().unwrap().ssrc = ssrc;
+    }
+    assert!(handler.on_rtcp_packet(&fir).await);
+    assert!(a.notified().now_or_never().is_some());
+    assert!(b.picture.notified().now_or_never().is_some());
+    assert!(a.notified().now_or_never().is_none());
+    assert!(b.picture.notified().now_or_never().is_none());
+    stop.cancel();
+    assert!(!handler.on_rtcp_packet(&pli(11)).await);
+    assert!(handler.on_rtcp_packet(&fir).await, "live preview still receives its FIR");
+    assert!(a.notified().now_or_never().is_some());
+    assert!(b.picture.notified().now_or_never().is_none());
+    // A registered weak identity never becomes a new owner of a track or
+    // worker. Their disappearance is terminal even if a signal observer lives.
+    drop(track);
+    assert!(channels
+        .reserved_video_feedback
+        .get()
+        .unwrap()
+        .signals_for(11)
+        .is_none());
+    drop(b);
+    assert!(!handler.on_rtcp_packet(&pli(11)).await);
+}
