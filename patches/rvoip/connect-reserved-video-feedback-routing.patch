+#[tokio::test]
+async fn controlled_replacement_tick_distinguishes_fresh_ordinary_input_from_private_ready_pcm() {
+    for fresh_before_first_tick in [true, false] {
+        let mut f = Move::for_audio_preroll().await;
+        let work = catch_original(async {
+            f.io().await;
+            f.confirm().await;
+            let prepared = prepare(&f, deadline(), CancellationToken::new()).await;
+            f.room.publish("bob", 6000).unwrap();
+            one_original_audio_tick(&f);
+            f.room.heard("device", 6000).await;
+            assert!(prepared.has_delivered_remote_audio());
+            drain_outputs(&mut f);
+
+            // The last output before the cut is genuinely OLD speech.
+            f.room.publish("alice", 800).unwrap();
+            one_original_audio_tick(&f);
+            let before = delivered_pcm_timestamp(&mut f, "bob", 800).await;
+            drain_outputs(&mut f);
+            let old = ConnectionId::from_string("alice");
+            let new = ConnectionId::from_string("device");
+            let old_codec = f
+                .room
+                .scene
+                .weak_media_owners_for_test(&old)
+                .unwrap()
+                .into_iter()
+                .find(|(name, _)| *name == "mixer-decoder")
+                .unwrap()
+                .1;
+            assert!(old_codec.upgrade().is_some());
+
+            // Both original producers submit genuine input before the cut.
+            // Candidate input is decoded privately and is NOT ordinary FIFO.
+            let captured = Instant::now();
+            f.room.publish("device", 5200).unwrap();
+            let private_sequence = f.room.nodes["device"].sequence;
+            let target = &f.room.nodes["device"].controller;
+            let consumer = target
+                .audio_consumer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .unwrap()
+                .upgrade()
+                .unwrap();
+            assert!(consumer.decoded_since(target, captured));
+            assert!(f._audio_probe.as_ref().unwrap().has_duplex_io());
+            assert!(f.room.scene.replacement_endpoint_ready(&f.context).is_ok());
+            assert_eq!(
+                f.room.scene.audio_queue_state_for_test(&new),
+                Some((0, false, 0, 0))
+            );
+            f.room.publish("alice", 800).unwrap();
+            assert_eq!(f.room.scene.audio_queue_state_for_test(&old).unwrap().0, 1);
+
+            // Exactly the existing actual model/cut path; no synthetic owner,
+            // ticket, private-to-public frame conversion or postcut renewal.
+            let owner = {
+                let read = f.room.domain.base.0.read().await;
+                f.room
+                    .domain
+                    .resource_owner(&read, read.owners["device"].clone())
+                    .unwrap()
+            };
+            let logical = f
+                .model
+                .stage_replacement(
+                    &owner.member,
+                    &owner.member,
+                    f.pending.intent().clone(),
+                    &f.pending,
+                    &owner.endpoint,
+                )
+                .unwrap();
+            let plan = f.plan().unwrap();
+            let (_outcome, _handle) = f.commit(plan).await.unwrap();
+            f.model.commit_replacement(logical);
+            f.model
+                .require_live_binding(&owner.member, &owner.connection)
+                .unwrap();
+            f.room
+                .domain
+                .base
+                .0
+                .write()
+                .await
+                .owners
+                .insert("device".into(), owner);
+            assert!(!f.room.scene.contains_connection(&old));
+            assert!(f.room.scene.audio_queue_state_for_test(&old).is_none());
+            assert!(old_codec.upgrade().is_none());
+            assert!(f.room.nodes["alice"].controller.shutdown.is_cancelled());
+            assert!(f.room.publish("alice", 9000).is_err());
+            assert_eq!(f.room.nodes["device"].sequence, private_sequence);
+            assert_eq!(
+                f.room.scene.audio_queue_state_for_test(&new),
+                Some((0, false, 0, 0))
+            );
+            assert!(captured.elapsed() < Duration::from_millis(200));
+
+            if fresh_before_first_tick {
+                // Same installed candidate, truly NEW ordinary ingress.
+                f.room.publish("device", 6800).unwrap();
+                assert_eq!(f.room.scene.audio_queue_state_for_test(&new).unwrap().0, 1);
+            }
+            one_original_audio_tick(&f);
+            if !fresh_before_first_tick {
+                // An empty first tick must neither leak the private5200 PCM
+                // nor replay the old queued800 PCM or invent concealment.
+                assert!(f.room.nodes.get_mut("bob").unwrap().out.try_recv().is_err());
+                f.room.publish("device", 6800).unwrap();
+                assert_eq!(f.room.scene.audio_queue_state_for_test(&new).unwrap().0, 1);
+                one_original_audio_tick(&f);
+            }
+            let after = delivered_pcm_timestamp(&mut f, "bob", 6800).await;
+            assert!(f.room.nodes.get_mut("bob").unwrap().out.try_recv().is_err());
+            drain_outputs(&mut f);
+            drop(prepared);
+            (before, after, fresh_before_first_tick)
+        })
+        .await;
+        let cleanup = close_originals(&f).await;
+        drop(f);
+        assert!(
+            cleanup
+                .iter()
+                .all(|(_, joined, outstanding)| *joined && *outstanding == 0),
+            "all original controllers/adapters must close before cadence oracle: {cleanup:?}"
+        );
+        let (before, after, fresh_before_first_tick) = match work {
+            Ok(value) => value,
+            Err(error) => resume_unwind(error),
+        };
+        let expected = if fresh_before_first_tick { 160 } else { 320 };
+        assert_eq!(
+            after.wrapping_sub(before),
+            expected,
+            "controlled original20ms tick must expose the actual empty quantum; fresh_before_first_tick={fresh_before_first_tick}"
+        );
+        eprintln!(
+            "controlled_audio_cut fresh_before_first_tick={fresh_before_first_tick} old_rtp={before} new_rtp={after} delta={} original_tick_ms=20 input_clock_hz=8000 originals_joined=true",
+            after.wrapping_sub(before)
+        );
+    }
+}
