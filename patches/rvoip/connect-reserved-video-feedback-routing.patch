+async fn verify_reserved_video_rtcp(
+    client: &RvoipPeerConnection,
+    server: &RvoipPeerConnection,
+    writers: [(&str, &Arc<TrackLocalStaticRTP>, u32); 2],
+) {
+    use rtc::rtcp::payload_feedbacks::picture_loss_indication::PictureLossIndication;
+    use rtc::rtcp::transport_feedbacks::transport_layer_nack::{NackPair, TransportLayerNack};
+
+    let stop = tokio_util::sync::CancellationToken::new();
+    let (_, track, ssrc) = writers[1];
+    let reserved = server
+        .register_reserved_video_feedback(track, ssrc, stop.clone())
+        .unwrap();
+    let preview = server.video_feedback_for(writers[0].2).unwrap();
+    for ((mid, writer, ssrc), feedback) in writers.into_iter().zip([preview, reserved.clone()]) {
+        let mut owner = None;
+        for transceiver in client.pc.get_transceivers().await {
+            if transceiver.mid().await.unwrap().as_deref() == Some(mid) {
+                owner = Some(transceiver);
+                break;
+            }
+        }
+        let owner = owner.expect("actual negotiated transceiver for the exact writer MID");
+        writer
+            .write_rtp(crate::media::vp8_rtp_packet_for_ssrc(ssrc, 1, 9000))
+            .await
+            .unwrap();
+        let remote = tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                if let Some(receiver) = owner.receiver().await.unwrap() {
+                    break receiver.track().clone();
+                }
+                tokio::time::sleep(Duration::from_millis(5)).await;
+            }
+        })
+        .await
+        .unwrap_or_else(|_| panic!("RTP receiver for MID {mid} must be installed by the driver"));
+        tokio::time::timeout(Duration::from_secs(2), async {
+            loop {
+                match remote.poll().await {
+                    Some(webrtc::media_stream::track_remote::TrackRemoteEvent::OnRtpPacket(
+                        packet,
+                        _,
+                    )) => {
+                        assert_eq!(packet.header.ssrc, ssrc);
+                        break;
+                    }
+                    Some(_) => continue,
+                    None => panic!("receiver {mid} ended before RTP"),
+                }
+            }
+        })
+        .await
+        .expect("actual writer RTP observed before sending receiver feedback");
+
+        remote
+            .write_rtcp(vec![
+                Box::new(PictureLossIndication {
+                    sender_ssrc: client.local_video_ssrc().unwrap(),
+                    media_ssrc: ssrc,
+                }),
+                Box::new(TransportLayerNack {
+                    sender_ssrc: client.local_video_ssrc().unwrap(),
+                    media_ssrc: ssrc,
+                    nacks: vec![NackPair {
+                        packet_id: 2,
+                        lost_packets: 0,
+                    }],
+                }),
+            ])
+            .await
+            .unwrap();
+        tokio::time::timeout(Duration::from_secs(2), feedback.picture.notified())
+            .await
+            .unwrap_or_else(|_| panic!("PLI must reach writer for MID {mid}"));
+        tokio::time::timeout(Duration::from_secs(2), feedback.repair.changed())
+            .await
+            .unwrap_or_else(|_| panic!("unsatisfied NACK must reach writer for MID {mid}"));
+        assert_eq!(feedback.repair.take(), vec![(ssrc, 2)]);
+    }
+
+    stop.cancel();
+    assert!(server.video_feedback_for(ssrc).is_none());
+}
