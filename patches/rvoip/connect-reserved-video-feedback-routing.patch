+// Observe a single original20ms mixer quantum without advancing wall time,
+// changing authority, supplying PCM or fabricating a source clock.
+fn one_original_audio_tick(f: &Move) {
+    let now = Instant::now();
+    f.room.scene.observe_audio_tick_for_test(now, now);
+    f.room.tick();
+}
+
+async fn delivered_pcm_timestamp(f: &mut Move, name: &str, expected: i16) -> u32 {
+    let queued = f
+        .room
+        .nodes
+        .get_mut(name)
+        .unwrap()
+        .out
+        .try_recv()
+        .expect("original guarded receiver has no output for the controlled tick");
+    let result = Arc::new(std::sync::Mutex::new(None));
+    let captured = result.clone();
+    queued
+        .deliver(move |frame| async move {
+            use rvoip_media_core::codec::factory::CodecFactory;
+            let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+            let decoded = codec.decode(&frame.payload).unwrap();
+            assert_eq!(
+                decoded.samples.len(),
+                160,
+                "actual codec output must be one20ms quantum"
+            );
+            let mean = decoded.samples.iter().map(|s| i32::from(*s)).sum::<i32>()
+                / decoded.samples.len() as i32;
+            assert!(
+                (mean - i32::from(expected)).abs() < 400,
+                "wrong original speaker: expected {expected}, got {mean}"
+            );
+            *captured.lock().unwrap() = Some(frame.timestamp_rtp);
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let timestamp = result.lock().unwrap().take().unwrap();
+    timestamp
+}
