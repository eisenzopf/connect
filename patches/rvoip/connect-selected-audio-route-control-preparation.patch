+    /// Current selection hints touching one actual live endpoint. This returns
+    /// owned IDs only, never permission. No Core lock survives the call and the
+    /// host must acquire fresh Store/physical admission for every hinted route.
+    pub(crate) fn audio_route_preparation_hints(
+        &self,
+        connection: &ConnectionId,
+    ) -> ControlResult<BTreeSet<(ConnectionId, Option<ConnectionId>)>> {
+        fn busy<T>(error: std::sync::TryLockError<T>) -> StreamControlError {
+            match error {
+                std::sync::TryLockError::WouldBlock => StreamControlError::MetadataBusy,
+                std::sync::TryLockError::Poisoned(_) => StreamControlError::Authority,
+            }
+        }
+        let members = self.members.try_lock().map_err(busy)?;
+        let target = members.get(connection).ok_or(StreamControlError::NotReady)?;
+        let (descriptor, receives) = {
+            let state = target.controller.state.try_lock().map_err(busy)?;
+            let source = match target.current_descriptor(&state, true) {
+                Ok(value) => value,
+                Err(StreamControlError::NotReady) => None,
+                Err(error) => return Err(error),
+            };
+            let receives = match target.current_descriptor(&state, false) {
+                Ok(value) => value.is_some(),
+                Err(StreamControlError::NotReady) => false,
+                Err(error) => return Err(error),
+            };
+            (source.filter(|_| target.audio_consumer.role_snapshot().0), receives)
+        };
+        let (program, rules) = {
+            let state = target.audio_consumer.subscriptions.state.try_lock().map_err(busy)?;
+            (state.program.clone(), state.rules.clone())
+        };
+        let mut routes = BTreeSet::new();
+        if descriptor.is_some() { routes.insert((connection.clone(), None)); }
+        // One source-catalog scan, not an all-receiver/all-source cross product.
+        for (id, member) in members.iter().filter(|(_, member)| {
+            member.controller.origin_member.participant()
+                != target.controller.origin_member.participant()
+        }) {
+            let (source, receiver) = {
+                let state = member.controller.state.try_lock().map_err(busy)?;
+                let source = match member.current_descriptor(&state, true) {
+                    Ok(value) => value,
+                    Err(StreamControlError::NotReady | StreamControlError::Cancelled) => None,
+                    Err(error) => return Err(error),
+                };
+                let receiver = match member.current_descriptor(&state, false) {
+                    Ok(value) => value.is_some(),
+                    Err(StreamControlError::NotReady | StreamControlError::Cancelled) => false,
+                    Err(error) => return Err(error),
+                };
+                (source.filter(|_| member.audio_consumer.role_snapshot().0), receiver)
+            };
+            if let Some(source) = source.filter(|_| receives) {
+                if program.allows(&member.controller, &source.logical_id)
+                    && rules.iter().all(|rule| rule.allows(&member.controller))
+                {
+                    routes.insert((id.clone(), None));
+                    routes.insert((connection.clone(), Some(id.clone())));
+                }
+            }
+            if let Some(source) = descriptor.as_ref().filter(|_| receiver) {
+                let state = member.audio_consumer.subscriptions.state.try_lock().map_err(busy)?;
+                if state.program.allows(&target.controller, &source.logical_id)
+                    && state.rules.iter().all(|rule| rule.allows(&target.controller))
+                {
+                    routes.insert((id.clone(), Some(connection.clone())));
+                }
+            }
+        }
+        Ok(routes)
+    }
