diff --git a/crates/webrtc/rvoip-webrtc/src/media/core_video_profile.rs b/crates/webrtc/rvoip-webrtc/src/media/core_video_profile.rs
new file mode 100644
--- /dev/null
+++ b/crates/webrtc/rvoip-webrtc/src/media/core_video_profile.rs
@@ -0,0 +1,163 @@
+//! One actual negotiated VP8 primary, with optional exact RTX association.
+use rvoip_core::staged_streams::{ControlResult, StreamControlError as E};
+use rvoip_sip_core::types::sdp::{MediaDescription, ParsedAttribute, SdpSession};
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NegotiatedVideo {
+    pub payload_type: u8,
+    pub rtx_payload_type: Option<u8>,
+    pub mid: Option<String>,
+}
+fn section(session: &SdpSession) -> ControlResult<(usize, &MediaDescription)> {
+    let mut media = session
+        .media_descriptions
+        .iter()
+        .enumerate()
+        .filter(|(_, m)| m.media == "video" && m.port != 0);
+    let one = media.next().ok_or(E::Unsupported)?;
+    if media.next().is_some() || session.media_descriptions.len() > 32 {
+        return Err(E::Unsupported);
+    }
+    if one.1.generic_attributes.iter().any(|a| match a {
+        ParsedAttribute::Rid(_) | ParsedAttribute::Simulcast(..) => true,
+        ParsedAttribute::Value(name, _) | ParsedAttribute::Flag(name) => {
+            matches!(name.to_ascii_lowercase().as_str(), "rid" | "simulcast")
+        }
+        ParsedAttribute::SsrcGroup(group) => {
+            group.semantics != "FID" || group.ssrcs.len() != 2 || group.ssrcs[0] == group.ssrcs[1]
+        }
+        _ => false,
+    }) {
+        return Err(E::Unsupported);
+    }
+    Ok(one)
+}
+fn mid(media: &MediaDescription) -> ControlResult<Option<String>> {
+    let mut values = media.generic_attributes.iter().filter_map(|a| {
+        if let ParsedAttribute::Mid(v) = a {
+            Some(v)
+        } else {
+            None
+        }
+    });
+    let value = values.next();
+    if values.next().is_some() {
+        return Err(E::Unsupported);
+    }
+    if value
+        .is_some_and(|v| v.is_empty() || v.len() > 16 || !v.bytes().all(|b| b.is_ascii_graphic()))
+    {
+        return Err(E::Unsupported);
+    }
+    Ok(value.cloned())
+}
+fn mapping(
+    media: &MediaDescription,
+    pt: u8,
+) -> ControlResult<&rvoip_sip_core::types::sdp::RtpMapAttribute> {
+    let mut entries = media.rtpmaps().filter(|r| r.payload_type == pt);
+    let r = entries.next().ok_or(E::Unsupported)?;
+    if pt >= 128
+        || entries.next().is_some()
+        || r.clock_rate != 90000
+        || r.encoding_params.as_ref().is_some_and(|p| p != "0")
+    {
+        return Err(E::Unsupported);
+    }
+    Ok(r)
+}
+/// An answer must retain one offered VP8 PT and at most one RTX apt. A rejected
+/// or ambiguous section, remapped MID/PT/codec and simulcast refuse explicitly.
+pub fn negotiated_profile(offer: &str, answer: &str) -> ControlResult<NegotiatedVideo> {
+    // Invalid/dangling RID lists may be normalized away by an SDP model. This
+    // profile must refuse their original declaration, not infer single-source.
+    for sdp in [offer, answer] {
+        if sdp.lines().map(str::trim).any(|line| {
+            line.strip_prefix("a=")
+                .and_then(|a| a.split_once(':'))
+                .is_some_and(|(name, _)| {
+                    name.eq_ignore_ascii_case("rid") || name.eq_ignore_ascii_case("simulcast")
+                })
+        }) {
+            return Err(E::Unsupported);
+        }
+    }
+
+    let offer: SdpSession = offer.parse().map_err(|_| E::Unsupported)?;
+    let answer: SdpSession = answer.parse().map_err(|_| E::Unsupported)?;
+    let (oi, o) = section(&offer)?;
+    let (ai, a) = section(&answer)?;
+    if oi != ai || o.protocol != a.protocol || mid(o)? != mid(a)? {
+        return Err(E::Unsupported);
+    }
+    let mut formats = std::collections::BTreeSet::new();
+    let mut primary = None;
+    let mut rtx = None;
+    for f in &a.formats {
+        let pt = f.parse::<u8>().map_err(|_| E::Unsupported)?;
+        if !formats.insert(pt) || !o.formats.iter().any(|f| f.parse::<u8>() == Ok(pt)) {
+            return Err(E::Unsupported);
+        }
+        for media in [o, a] {
+            if media.fmtps().filter(|v| v.format == *f).count() > 1 {
+                return Err(E::Unsupported);
+            }
+        }
+        let r = mapping(a, pt)?;
+        let offered = mapping(o, pt)?;
+        if !r.encoding_name.eq_ignore_ascii_case(&offered.encoding_name) {
+            return Err(E::Unsupported);
+        }
+        if r.encoding_name.eq_ignore_ascii_case("VP8") {
+            if primary.replace(pt).is_some()
+                || [o, a].iter().any(|m| {
+                    m.get_fmtp(f)
+                        .is_some_and(|v| !v.parameters.trim().is_empty())
+                })
+            {
+                return Err(E::Unsupported);
+            }
+        } else if r.encoding_name.eq_ignore_ascii_case("rtx") {
+            if rtx.replace(pt).is_some() {
+                return Err(E::Unsupported);
+            }
+        } else {
+            return Err(E::Unsupported);
+        }
+    }
+    let payload_type = primary.ok_or(E::Unsupported)?;
+    if let Some(pt) = rtx {
+        let expected = format!("apt={payload_type}");
+        for m in [o, a] {
+            if m.get_fmtp(&pt.to_string())
+                .is_none_or(|f| f.parameters.trim() != expected)
+            {
+                return Err(E::Unsupported);
+            }
+        }
+    }
+    Ok(NegotiatedVideo {
+        payload_type,
+        rtx_payload_type: rtx,
+        mid: mid(a)?,
+    })
+}
+
+pub(crate) fn outbound_mid(
+    offer: &str,
+    answer: &str,
+    local_is_offerer: bool,
+) -> ControlResult<Option<(u8, String)>> {
+    let parsed: SdpSession = answer.parse().map_err(|_| E::Unsupported)?;
+    let (_, video) = section(&parsed)?;
+    let has_mid=video.generic_attributes.iter().chain(&parsed.generic_attributes).any(|a|matches!(a,ParsedAttribute::ExtMap(_,_,uri,_)if uri==crate::peer::builder::HDREXT_SDES_MID));
+    let mid = crate::sdp::inspect::negotiated_sdes_mid_for_outbound_media(
+        offer,
+        answer,
+        local_is_offerer,
+        "video",
+    );
+    if has_mid && mid.is_none() {
+        return Err(E::Unsupported);
+    }
+    Ok(mid.map(|m| (m.extension_id, m.value)))
+}
