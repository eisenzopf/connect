+}
+/// Caller owns and joins its exact original bounded intake/handshake tasks.
+/// Only opaque Incoming-derived owners are accepted, never raw Connections.
+pub fn start_original(
+    incoming:mpsc::Receiver<rvoip_uctp::substrate::AcceptedNativeConnection>,
+    profile:CanonicalProfile,contact:String,
+)->Result<ProfileServer,DispatchError> {
+    start_original_inner(incoming,None,profile,contact)
+}
+fn start_original_inner(
+    incoming:mpsc::Receiver<rvoip_uctp::substrate::AcceptedNativeConnection>,
+    accept_lifetime:Option<rvoip_uctp::substrate::OwnedAcceptLifetime>,
+    profile:CanonicalProfile,contact:String,
+)->Result<ProfileServer,DispatchError> {
+    ProfileServer::spawn(incoming,profile.max_connections(),move|accepted,cancel| {
+        let _accept_lifetime=accept_lifetime.clone();
+        let profile=profile.clone();let contact=contact.clone();
+        async move {
+            let _accept_lifetime=_accept_lifetime;
+            let cancel=cancel.child_token();let _lifetime=cancel.clone().drop_guard();
+            let deadline=tokio::time::Instant::now()+AUTHENTICATION_TIMEOUT;
+            let peer=profile.peer(PeerTransport::Quic,&contact,cancel.clone())?.with_original_authentication_deadline(deadline);
+            let setup=NativeTransportContext::from_accepted_quic(accepted,cancel.clone(),deadline)?;
+            let control=setup.control;
+            struct CloseOwned(rvoip_uctp::v2::server::OriginalQuicControl);
+            impl Drop for CloseOwned {fn drop(&mut self){self.0.close(0u32.into(),b"canonical-peer-retired");}}
+            let _close=CloseOwned(control.clone());let mut media_reader=setup.media_reader;
+            let handler=profile.physical_handler(setup.context)?;
+            let(mut writer,reader)=tokio::select! {biased;
+                _=cancel.cancelled()=>return Err(DispatchError::Closed),
+                _=media_reader.as_mut()=>return Err(DispatchError::Closed),
+                result=tokio::time::timeout_at(deadline,control.accept_bi())=>result.map_err(|_|DispatchError::Closed)??,
+            };
+            let result=tokio::select! {biased;
+                _=media_reader.as_mut()=>Err(DispatchError::Closed),
+                value=peer.run(reader,&mut writer,handler.as_ref())=>value,
+            };
+            drop(media_reader);
+            if writer.finish().is_ok() {tokio::select! {biased;
+                _=cancel.cancelled()=>{},
+                _=tokio::time::timeout(std::time::Duration::from_secs(1),writer.stopped())=>{},
+            }}
+            result
+        }
+    },|accepted|accepted.close(0u32.into(),b"canonical-admission-closed"))
+}
