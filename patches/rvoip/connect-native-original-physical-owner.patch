+/// Owned original accepted transport; no raw Session/Connection crosses the
+/// strict setup facade, and this profile never falls back to generic accepts.
+pub fn start_owned(
+    incoming:rvoip_uctp::substrate::OwnedAlpnReceiver,
+    profile:CanonicalProfile,contact:String,mount:String,origins:Option<HashSet<String>>,
+)->Result<ProfileServer,DispatchError> {
+    let(incoming,lifetime)=incoming.into_parts();
+    start_original_inner(incoming,Some(lifetime),profile,contact,mount,origins)
+}
+/// The caller retains its original physical ingress slot, TLS bound, key
+/// cutoff and intake joins. No already-raw native connection can enter here.
+pub fn start_original(
+    incoming:mpsc::Receiver<rvoip_uctp::substrate::AcceptedNativeConnection>,
+    profile:CanonicalProfile,contact:String,mount:String,origins:Option<HashSet<String>>,
+)->Result<ProfileServer,DispatchError> {
+    start_original_inner(incoming,None,profile,contact,mount,origins)
+}
+fn start_original_inner(
+    incoming:mpsc::Receiver<rvoip_uctp::substrate::AcceptedNativeConnection>,
+    accept_lifetime:Option<rvoip_uctp::substrate::OwnedAcceptLifetime>,
+    profile:CanonicalProfile,contact:String,mount:String,origins:Option<HashSet<String>>,
+)->Result<ProfileServer,DispatchError> {
+
+    if !mount.starts_with('/')||mount.contains(['?','#']) {return Err(DispatchError::Unsupported);}
+    let origins=Arc::new(origins);
+    ProfileServer::spawn(incoming,profile.max_connections(),move|accepted,cancel| {
+        let _accept_lifetime=accept_lifetime.clone();
+        let profile=profile.clone();let contact=contact.clone();let mount=mount.clone();let origins=origins.clone();
+        async move {
+            let _accept_lifetime=_accept_lifetime;
+            let cancel=cancel.child_token();let _lifetime=cancel.clone().drop_guard();
+            let deadline=tokio::time::Instant::now()+AUTHENTICATION_TIMEOUT;
+            let peer=profile.peer(PeerTransport::WebTransport,&contact,cancel.clone())?.with_original_authentication_deadline(deadline);
+            let setup=NativeTransportContext::from_accepted_webtransport(accepted,cancel.clone(),deadline,&mount,origins.as_ref().as_ref()).await?;
+            let control=setup.control;
+            struct CloseOwned(rvoip_uctp::v2::server::OriginalWebTransportControl);
+            impl Drop for CloseOwned {fn drop(&mut self){self.0.close(0u32.into(),b"canonical-peer-retired");}}
+            let _close=CloseOwned(control.clone());let mut media_reader=setup.media_reader;
+            let handler=profile.physical_handler(setup.context)?;
+            let(mut transport_writer,reader)=tokio::select! {biased;
+                _=cancel.cancelled()=>return Err(DispatchError::Closed),
+                _=media_reader.as_mut()=>return Err(DispatchError::Closed),
+                value=tokio::time::timeout_at(deadline,control.accept_bi())=>value.map_err(|_|DispatchError::Closed)??,
+            };
+            let reader=futures::stream::unfold(crate::framing::EnvelopeReader::new(reader),|mut reader|async move {
+                match reader.next_bytes().await {Ok(Some(bytes))=>Some((Ok(bytes),reader)),Ok(None)=>None,Err(_)=>Some((Err(DispatchError::Closed),reader))}
+            });
+            let writer=futures::sink::unfold(&mut transport_writer,|writer,bytes:Bytes|async move {
+                if bytes.len()>MAX_ENVELOPE_BYTES {return Err(DispatchError::Closed);}
+                let mut frame=Vec::with_capacity(4+bytes.len());frame.extend_from_slice(&(bytes.len()as u32).to_be_bytes());frame.extend_from_slice(&bytes);
+                writer.write_all(&frame).await.map_err(|_|DispatchError::Closed)?;
+                tokio::io::AsyncWriteExt::flush(writer).await.map_err(|_|DispatchError::Closed)?;Ok(writer)
+            });
+            let result=tokio::select! {biased;
+                _=media_reader.as_mut()=>Err(DispatchError::Closed),
+                value=peer.run_frames(Box::pin(reader),Box::pin(writer),handler.as_ref())=>value,
+            };
+            drop(media_reader);
+            if transport_writer.finish().is_ok() {tokio::select! {biased;
+                _=cancel.cancelled()=>{},
+                _=tokio::time::timeout(std::time::Duration::from_secs(1),transport_writer.stopped())=>{},
+            }}
+            result
+        }
+    },|accepted|accepted.close(0u32.into(),b"canonical-admission-closed"))
+}
