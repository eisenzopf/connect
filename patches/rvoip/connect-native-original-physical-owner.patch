+//! Real TLS original accept/control tests. These prove no-escape ownership,
+//! not complete media writer coverage, Core F, native frame proof or readiness.
+use super::*;
+use futures::{FutureExt,future::BoxFuture};
+use crate::v2::{auth_dispatch::DispatchError,server::{NativeTransportContext,OriginalQuicControl,OriginalWebTransportControl}};
+struct ExternalDatagrams(quinn::Connection);
+impl crate::staged_media::StagedDatagramTransport for ExternalDatagrams {
+    fn maximum_datagram_bytes(&self)->Option<usize>{self.0.max_datagram_size()}
+    fn send_datagram(&self,bytes:bytes::Bytes)->rvoip_core::staged_streams::ControlResult<()> {
+        self.0.send_datagram(bytes).map_err(|_|rvoip_core::staged_streams::StreamControlError::Backpressure)
+    }
+    fn is_closed(&self)->bool{self.0.close_reason().is_some()}
+}
+#[async_trait::async_trait]
+impl crate::v2::native_media::NativeDatagramTransport for ExternalDatagrams {
+    async fn read_datagram(&self)->Result<bytes::Bytes,DispatchError>{self.0.read_datagram().await.map_err(|_|DispatchError::Closed)}
+}
+use tokio_util::sync::CancellationToken;
+use std::time::Duration;
+fn until()->tokio::time::Instant {tokio::time::Instant::now()+Duration::from_secs(4)}
+#[derive(Default)]
+struct Harness {
+    host:Option<Arc<quinn::Endpoint>>,raw_original:Option<quinn::Connection>,remote_endpoint:Option<quinn::Endpoint>,remote:Option<quinn::Connection>,
+    dispatcher:Option<OwnedAlpnRoutes>,accept_lifetime:Option<OwnedAcceptLifetime>,accepted:Option<AcceptedNativeConnection>,
+    observation:Option<OriginalNativeConnectionObservation>,context:Option<NativeTransportContext>,quic:Option<OriginalQuicControl>,wt:Option<OriginalWebTransportControl>,
+    reader:Option<BoxFuture<'static,Result<(),DispatchError>>>,remote_wt:Option<web_transport_quinn::Session>,
+}
+impl Harness {
+    async fn pair(&mut self,alpn:&[u8]) {self.pair_mode(alpn,false).await;}
+    async fn pair_mode(&mut self,alpn:&[u8],direct:bool) {
+        let _=rustls::crypto::ring::default_provider().install_default();
+        let(cert,key)=crate::substrate::self_signed_for_dev(&["localhost".into()]).unwrap();
+        let mut tls=rustls::ServerConfig::builder().with_no_client_auth().with_single_cert(vec![cert.clone()],key).unwrap();tls.alpn_protocols=vec![alpn.to_vec()];
+        let host=Arc::new(make_server_endpoint("127.0.0.1:0".parse().unwrap(),Arc::new(tls),quinn::TransportConfig::default()).unwrap());
+        self.host=Some(host.clone());
+        let mut receiver=if direct {None}else {
+            let mut dispatcher=dispatch_by_alpn_owned(host.clone(),&[alpn]).unwrap();
+            let(receiver,lifetime)=dispatcher.take(alpn).unwrap().into_parts();
+            self.dispatcher=Some(dispatcher);self.accept_lifetime=Some(lifetime);Some(receiver)
+        };
+        let mut tls=crate::substrate::dev_client_config_trusting(&cert).unwrap();tls.alpn_protocols=vec![alpn.to_vec()];
+        let mut client=quinn::Endpoint::client("127.0.0.1:0".parse().unwrap()).unwrap();
+        client.set_default_client_config(quinn::ClientConfig::new(Arc::new(quinn::crypto::rustls::QuicClientConfig::try_from(tls).unwrap())));
+        self.remote_endpoint=Some(client);
+        let connecting=self.remote_endpoint.as_ref().unwrap().connect(host.local_addr().unwrap(),"localhost").unwrap();
+        let original=async {
+            if direct {
+                // Same external custom-intake seam used by the Server partner:
+                // no raw completed Connection ever crosses this await.
+                AcceptedNativeConnection::accept_original(host.accept().await?).await.ok()
+            }else {receiver.as_mut().unwrap().recv().await}
+        };
+        let(remote,accepted)=tokio::join!(tokio::time::timeout_at(until(),connecting),tokio::time::timeout_at(until(),original));
+        // Register both actual owners before inspecting any setup assertion.
+        if let Ok(Ok(remote))=remote {self.remote=Some(remote);}
+        if let Ok(Some(accepted))=accepted {self.observation=Some(accepted.observation());self.accepted=Some(accepted);}
+        assert!(self.remote.is_some()&&self.accepted.is_some());
+    }
+    async fn setup(&mut self,wt:bool) {self.setup_mode(wt,false).await;}
+    async fn setup_mode(&mut self,wt:bool,direct:bool) {
+        self.pair_mode(if wt {b"h3"}else{crate::v2::RAW_QUIC_ALPN},direct).await;
+        let accepted=self.accepted.take().unwrap();
+        if wt {
+            let remote=self.remote.as_ref().unwrap().clone();
+            let upgrade=NativeTransportContext::from_accepted_webtransport(accepted,CancellationToken::new(),until(),"/uctp",None);
+            let client=web_transport_quinn::Session::connect(remote,"https://localhost/uctp".parse::<url::Url>().unwrap());
+            let(host,remote)=tokio::join!(tokio::time::timeout_at(until(),upgrade),tokio::time::timeout_at(until(),client));
+            if let Ok(Ok(remote))=remote {self.remote_wt=Some(remote);}
+            if let Ok(Ok(setup))=host {self.context=Some(setup.context);self.wt=Some(setup.control);self.reader=Some(setup.media_reader);}
+            assert!(self.remote_wt.is_some()&&self.context.is_some());
+        }else {
+            let setup=NativeTransportContext::from_accepted_quic(accepted,CancellationToken::new(),until()).unwrap();
+            self.context=Some(setup.context);self.quic=Some(setup.control);self.reader=Some(setup.media_reader);
+        }
+    }
+    async fn signal(&self,wt:bool)->bool {
+        if wt {
+            let(mut sent,_received)=tokio::time::timeout_at(until(),self.remote_wt.as_ref().unwrap().open_bi()).await.unwrap().unwrap();
+            sent.write_all(b"s").await.unwrap();
+            let(_sent,mut received)=tokio::time::timeout_at(until(),self.wt.as_ref().unwrap().accept_bi()).await.unwrap().unwrap();
+            let mut value=[0];received.read_exact(&mut value).await.unwrap();value==[b's']
+        }else {
+            let(mut sent,_received)=tokio::time::timeout_at(until(),self.remote.as_ref().unwrap().open_bi()).await.unwrap().unwrap();
+            sent.write_all(b"s").await.unwrap();
+            let(_sent,mut received)=tokio::time::timeout_at(until(),self.quic.as_ref().unwrap().accept_bi()).await.unwrap().unwrap();
+            let mut value=[0];received.read_exact(&mut value).await.unwrap();value==[b's']
+        }
+    }
+    async fn close(&mut self)->bool {
+        self.reader=None;self.accepted=None;
+        let observed=if let Some(observation)=self.observation.take() {
+            // Root intake uses only scalar RTT/ALPN/datagram metadata plus its
+            // same-original physical-close waiter; no native IO escapes.
+            let _rtt=observation.rtt();
+            observation.close(0u32.into(),b"owned-test-end");
+            tokio::time::timeout_at(until(),observation.closed()).await.is_ok()
+        }else {true};
+        if let Some(raw)=self.raw_original.take(){raw.close(0u32.into(),b"owned-test-end");}
+        if let Some(control)=self.quic.take(){control.close(0u32.into(),b"owned-test-end");}
+        if let Some(control)=self.wt.take(){control.close(0u32.into(),b"owned-test-end");}
+        if let Some(session)=self.remote_wt.take(){session.close(0,b"owned-test-end");}
+        if let Some(remote)=self.remote.take(){remote.close(0u32.into(),b"owned-test-end");}
+        self.context=None;
+        let joined=if let Some(dispatcher)=&self.dispatcher {dispatcher.shutdown().await.is_ok()}else{true};
+        self.dispatcher=None;self.accept_lifetime=None;
+        let mut idle=true;
+        if let Some(host)=self.host.take(){host.close(0u32.into(),b"owned-test-end");idle&=tokio::time::timeout_at(until(),host.wait_idle()).await.is_ok();}
+        if let Some(remote)=self.remote_endpoint.take(){remote.close(0u32.into(),b"owned-test-end");idle&=tokio::time::timeout_at(until(),remote.wait_idle()).await.is_ok();}
+        observed&&joined&&idle
+    }
+}
+#[tokio::test]
+async fn owned_native_actual_quic_and_wt_refuse_raw_escape_while_same_original_signaling_remains_live() {
+    let mut observations=Vec::new();
+    for (wt,direct) in [(false,false),(true,false),(false,true),(true,true)] {
+        let mut h=Harness::default();
+        let result=std::panic::AssertUnwindSafe(async {
+            h.setup_mode(wt,direct).await;
+            let observation=h.observation.as_ref().unwrap();
+            let metadata=observation.negotiated_alpn().as_deref()==Some(if wt {b"h3".as_slice()}else{crate::v2::RAW_QUIC_ALPN})
+                &&observation.maximum_datagram_bytes().is_some();
+            let _rtt=observation.rtt();
+            let context=h.context.as_ref().unwrap();let media=context.media().unwrap();
+            // No raw reference is returned by a wrong-type lookup. It must not
+            // permanently poison the same actual original coverage root.
+            let wrong_type=context.native::<String>().is_none();
+            let seal=media.try_seal_raw_access().unwrap();
+            let denied=context.native::<quinn::Connection>().is_none()
+                &&context.native::<web_transport_quinn::Session>().is_none()&&media.router().is_none()&&media.datagrams().is_none();
+            let signal=h.signal(wt).await;let same=seal.is_current();
+            seal.abort();
+            let raw=if wt {context.native::<web_transport_quinn::Session>().is_some()}else{context.native::<quinn::Connection>().is_some()};
+            let unavailable=media.try_seal_raw_access().is_err();
+            (metadata,wrong_type,denied,signal,same,raw,unavailable)
+        }).catch_unwind().await;
+        let clean=h.close().await;
+        if let Err(panic)=result {std::panic::resume_unwind(panic);}
+        observations.push((wt,direct,clean,result.unwrap()));
+    }
+    assert!(observations.iter().all(|(_,_,clean,(metadata,wrong_type,denied,signal,same,raw,unavailable))|*clean&&*metadata&&*wrong_type&&*denied&&*signal&&*same&&*raw&&*unavailable),
+        "owned signaling cannot borrow a raw DATAGRAM capability or reseal after actual exposure: {observations:?}");
+}
+#[tokio::test]
+async fn owned_native_public_router_or_datagrams_escape_and_reader_retirement_permanently_refuse_the_original_seal() {
+    let mut observations=Vec::new();
+    for mode in 0..3 {
+        let mut h=Harness::default();
+        let result=std::panic::AssertUnwindSafe(async {
+            h.setup(false).await;let media=h.context.as_ref().unwrap().media().unwrap();
+            if mode==0 {assert!(media.router().is_some());return media.try_seal_raw_access().is_err();}
+            if mode==1 {assert!(media.datagrams().is_some());return media.try_seal_raw_access().is_err();}
+            let seal=media.try_seal_raw_access().unwrap();h.reader=None;
+            !seal.is_current()&&media.router().is_none()&&media.datagrams().is_none()&&media.try_seal_raw_access().is_err()
+        }).catch_unwind().await;
+        let clean=h.close().await;if let Err(panic)=result {std::panic::resume_unwind(panic);}
+        observations.push((mode,clean,result.unwrap()));
+    }
+    assert!(observations.iter().all(|(_,clean,refused)|*clean&&*refused),"original raw escape/retirement cannot be reset by a new observation: {observations:?}");
+}
