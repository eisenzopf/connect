+/// Nonclone original accepted native transport. No public constructor, Default,
+/// Deserialize, claimed provenance flag or adoption of an external Connection.
+/// Only the library-owned original Incoming handshake can mint this type.
+pub struct AcceptedNativeConnection {
+    connection:Option<quinn::Connection>,
+    coverage:Arc<PhysicalVideoExposureCoverage>,
+}
+/// Read-only original connection observation for external intake ownership.
+/// Clone carries no DATAGRAM/stream/native/accepted-owner constructor. A close
+/// is terminal retirement only; observations cannot mint or reset provenance.
+#[derive(Clone)]
+pub struct OriginalNativeConnectionObservation {
+    connection:quinn::Connection,
+    coverage:Arc<PhysicalVideoExposureCoverage>,
+}
+impl OriginalNativeConnectionObservation {
+    pub fn negotiated_alpn(&self)->Option<Vec<u8>> {
+        self.connection.handshake_data()
+            .and_then(|data|data.downcast::<quinn::crypto::rustls::HandshakeData>().ok())
+            .and_then(|data|data.protocol.clone())
+    }
+    pub fn maximum_datagram_bytes(&self)->Option<usize> {self.connection.max_datagram_size()}
+    pub fn rtt(&self)->std::time::Duration {self.connection.stats().path.rtt}
+    pub async fn closed(&self) {let _=self.connection.closed().await;}
+    pub fn close(&self,code:quinn::VarInt,reason:&[u8]) {
+        self.coverage.retire();self.connection.close(code,reason);
+    }
+}
+impl AcceptedNativeConnection {
