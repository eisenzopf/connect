+    /// already-raw Connection cannot be adopted here. The caller retains its
+    /// original ingress slot, timeout, cancellation, intake and JoinSet owner.
+    /// Pinned quinn IncomingFuture owns Connecting/ConnectionRef: dropping a
+    /// pending handshake implicitly closes its last native application ref.
+    pub async fn accept_original(incoming:quinn::Incoming)->Result<Self,quinn::ConnectionError> {
+        Ok(Self::accepted(incoming.await?))
+    }
+    pub fn observation(&self)->OriginalNativeConnectionObservation {
+        OriginalNativeConnectionObservation {
+            connection:self.connection.as_ref().expect("same original accepted connection").clone(),
+            coverage:self.coverage.clone(),
+        }
+    }
+    pub(super) fn accepted(connection:quinn::Connection)->Self {
+        Self {connection:Some(connection),coverage:Arc::new(PhysicalVideoExposureCoverage::new(false))}
+    }
