+                let raw=threads.spawn(||{barrier.wait();context.native::<quinn::Connection>().is_some()});
+                let seal=threads.spawn(||{barrier.wait();media.try_seal_raw_access().ok()});
+                (raw.join().unwrap(),seal.join().unwrap())
