+//! Monotonic IO-worker lifetime. Join custody stays in setup; transient
+//! metadata exclusion is not evidence that an activated worker has ended.
+use rvoip_core::staged_streams::{ControlResult, StreamControlError};
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicBool, Ordering},
+};
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+pub(super) struct Setup {
+    pub(super) closing: bool,
+    pub(super) tasks: Vec<JoinHandle<ControlResult<()>>>,
+}
+#[derive(Clone)]
+pub(super) struct WorkerHealth {
+    pub(super) ready: Arc<AtomicBool>,
+    pub(super) stop: CancellationToken,
+    pub(super) setup: Arc<Mutex<Setup>>,
+}
+impl WorkerHealth {
+    pub(super) fn new(stop: CancellationToken) -> Self {
+        Self {
+            ready: Arc::new(AtomicBool::new(false)),
+            stop,
+            setup: Arc::new(Mutex::new(Setup {
+                closing: false,
+                tasks: vec![],
+            })),
+        }
+    }
+    pub(super) fn confirmed(&self) -> bool {
+        // Activation sets ready only after original workers and port readiness
+        // are installed. Every worker exit/drop retires the shared token before
+        // it waits for setup metadata. Close also retires before taking joins.
+        self.ready.load(Ordering::Acquire) && !self.stop.is_cancelled()
+    }
+    pub(super) fn activate(&self, setup: &Setup) -> ControlResult<()> {
+        if setup.closing || self.stop.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        if setup.tasks.is_empty() {
+            return Err(StreamControlError::NotReady);
+        }
+        self.ready.store(true, Ordering::Release);
+        Ok(())
+    }
+    pub(super) fn guard(&self) -> WorkerGuard {
+        WorkerGuard {
+            ready: self.ready.clone(),
+            stop: self.stop.clone(),
+        }
+    }
+    pub(super) fn retire(&self) {
+        self.ready.store(false, Ordering::Release);
+        self.stop.cancel();
+    }
+}
+pub(super) struct WorkerGuard {
+    ready: Arc<AtomicBool>,
+    stop: CancellationToken,
+}
+impl Drop for WorkerGuard {
+    fn drop(&mut self) {
+        self.ready.store(false, Ordering::Release);
+        self.stop.cancel();
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn metadata_observation_exclusion_is_not_worker_withdrawal() {
+        let h = WorkerHealth::new(CancellationToken::new());
+        assert!(!h.confirmed());
+        assert!(h.activate(&h.setup.lock().unwrap()).is_err());
+        h.setup.lock().unwrap().tasks.push(tokio::spawn(async {
+            std::future::pending::<()>().await;
+            Ok(())
+        }));
+        let setup = h.setup.lock().unwrap();
+        h.activate(&setup).unwrap();
+        assert!(!setup.closing && !setup.tasks[0].is_finished());
+        assert!(
+            h.confirmed(),
+            "a bounded metadata observer cannot revoke current activated IO"
+        );
+        drop(setup);
+        h.retire();
+        let tasks = std::mem::take(&mut h.setup.lock().unwrap().tasks);
+        for task in tasks {
+            task.abort();
+            let _ = task.await;
+        }
+    }
+    #[tokio::test]
+    async fn terminal_lifetime_cannot_be_reactivated_by_late_ready_observation() {
+        let h = WorkerHealth::new(CancellationToken::new());
+        h.setup.lock().unwrap().tasks.push(tokio::spawn(async {
+            std::future::pending::<()>().await;
+            Ok(())
+        }));
+        h.activate(&h.setup.lock().unwrap()).unwrap();
+        assert!(h.confirmed());
+        let setup = h.setup.lock().unwrap();
+        h.retire();
+        h.ready.store(true, Ordering::Release);
+        assert!(
+            !h.confirmed(),
+            "late ready cannot resurrect a retired worker"
+        );
+        drop(setup);
+        let tasks = std::mem::take(&mut h.setup.lock().unwrap().tasks);
+        for task in tasks {
+            task.abort();
+            let _ = task.await;
+        }
+    }
+    #[tokio::test]
+    async fn abort_before_first_poll_retires_the_captured_original_lifetime() {
+        let h = WorkerHealth::new(CancellationToken::new());
+        // Construct outside the future: abort-before-poll must still drop it.
+        let guard = h.guard();
+        let task = tokio::spawn(async move {
+            let _lifetime = guard;
+            std::future::pending::<()>().await;
+            Ok(())
+        });
+        h.setup.lock().unwrap().tasks.push(task);
+        h.activate(&h.setup.lock().unwrap()).unwrap();
+        let task = h.setup.lock().unwrap().tasks.pop().unwrap();
+        task.abort();
+        let _ = task.await;
+        assert!(!h.confirmed());
+        h.ready.store(true, Ordering::Release);
+        assert!(!h.confirmed());
+    }
+}
