+//! Actual managed Warm owner and scope; no fake identity, token or Root.
+use super::*;
+
+#[tokio::test]
+async fn opaque_warm_scope_recovers_same_owner_and_preserves_cancel_cutoff_and_weak_drop() {
+    let mut room=ManagedRoom::with_video(true).await;
+    let result=catch_original(async {
+        let(alice,old,source)=actors(&mut room).await;
+        let ready=prepared(&mut room,&alice,&old,&source).await;
+        let frontier=freeze(&room,&ready.plan,&ready.grant,&ready.reservation).await;
+        room.world.warm_allowed.store(true,Ordering::Release);
+        let warm=warm(&room,&ready.plan,&ready.grant).await.unwrap();
+        let scope=warm.scope_with_original_owner_for_test().expect("same original cold Arc recovery");
+        assert!(warm.is_current()&&scope.is_current());
+        assert!(std::ptr::eq(scope.frontier(),Arc::as_ref(&frontier)));
+        let original_cutoff=scope.deadline().expect("pending original cutoff");
+        let cancel=scope.cancellation().unwrap();assert!(!cancel.is_cancelled());
+        assert!(ready.root.cancel());
+        assert!(!scope.is_current()&&!warm.is_current(),"erased owner cannot bypass original cancellation");
+        assert_eq!(scope.deadline(),Some(original_cutoff),"no fresh cutoff from metadata recovery");
+        warm.close();assert!(cancel.is_cancelled());assert!(scope.cancellation().unwrap().is_cancelled());
+        drop(warm);
+        assert!(!scope.is_current());assert!(scope.deadline().is_none());
+        assert!(matches!(scope.cancellation(),Err(StreamControlError::Cancelled)),"retained scope owns only Weak");
+    }).await;
+    let cleanup=room.close_originals().await;
+    assert!(cleanup.into_iter().all(|done|done));if let Err(error)=result {resume_unwind(error)}
+}
