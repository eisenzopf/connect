+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    fn binding() -> ReadyMediaBinding {
+        ReadyMediaBinding {
+            negotiated: NegotiatedStream { requested: DesiredStream {
+                logical_id: StreamId::from_string("camera"), medium: Medium::Video, direction: StreamDirection::Both,
+            }, format: MediaFormat::Encoded { name:"vp8".into(), clock_rate_hz:90000, channels:0, fmtp:None } },
+            transport_id: StreamId::from_string("physical-camera"), stream_local_id:7,
+            generation:3, connection_generation:2, source_ready:true, sink_ready:true,
+        }
+    }
+    fn epoch(publisher: bool, id: u128) -> VideoFeedbackEpoch {
+        VideoFeedbackEpoch {publisher,epoch:id,ssrc:41,first_sequence:71,first_timestamp:9000}
+    }
+    #[test]
+    fn private_receiver_selection_skips_older_publisher_without_consuming_ordinary_history() {
+        let flow=NativeFlow::new(CancellationToken::new()); let binding=binding();
+        let profile=flow.video_feedback_profile(&binding,"original-op","original-offer");
+        profile.announce(&binding,epoch(true,1),Arc::new(||true)).unwrap();
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).is_none());
+        profile.announce(&binding,epoch(false,2),Arc::new(||true)).unwrap();
+        let receiver=flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).unwrap();
+        assert!(!receiver.epoch().publisher); assert_eq!(receiver.epoch(),epoch(false,2));
+        assert_eq!(receiver.original_operation(),"original-op"); assert_eq!(receiver.original_offer(),"original-offer");
+        let sent=BTreeMap::from([(receiver.key(),receiver.revision())]);
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&sent,true).is_none());
+        let publisher=flow.next_video_epoch(std::slice::from_ref(&binding),&sent,false).unwrap();
+        assert_eq!(publisher.epoch(),epoch(true,1)); assert!(publisher.revision()<receiver.revision());
+        assert_eq!(publisher.original_operation(),receiver.original_operation());
+        assert!(flow.next_video_epoch(&[],&sent,false).is_none());
+    }
+    #[test]
+    fn private_receiver_selection_refuses_retired_route_and_changed_binding_generation() {
+        let stop=CancellationToken::new(); let flow=NativeFlow::new(stop.clone()); let binding=binding();
+        let current=Arc::new(AtomicBool::new(true)); let live=current.clone();
+        flow.video_feedback_profile(&binding,"original-op","original-offer").announce(
+            &binding,epoch(false,2),Arc::new(move||live.load(Ordering::Acquire))).unwrap();
+        let mut changed=binding.clone(); changed.generation+=1;
+        assert!(flow.next_video_epoch(&[changed],&BTreeMap::new(),true).is_none());
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).is_some());
+        current.store(false,Ordering::Release);
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),true).is_none());
+        stop.cancel();
+        assert!(flow.next_video_epoch(std::slice::from_ref(&binding),&BTreeMap::new(),false).is_none());
+    }
