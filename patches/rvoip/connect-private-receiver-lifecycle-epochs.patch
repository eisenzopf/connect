+/// Real signed notices and media on the same two registrations. Controlled
+/// relationship authority here does not stand in for Connect Store authority.
+#[tokio::test]
+async fn signed_receiver_only_registration_suppresses_public_ready_until_ordinary_adoption() {
+    let profile=Arc::new((*profile(false)).clone().with_video_feedback());
+    let mut s=Scene::new_profiled("quic",false,true,true,profile,None).await;
+    s.record.lifecycle.store(true,Ordering::Release);
+    s.record.receiver_epochs_only.store(true,Ordering::Release);
+    let mut offered=lifecycle_offer(&s,0,0,"sendonly");
+    offered["payload"]["streams_offered"]=json!([{"id":"camera","kind":"video","direction":"sendonly","codec_preferences":["vp8"]}]);
+    let (_,callback)=s.prepared(offered).await; let source_handle=subscriptions::stream_handle(&callback,"camera");
+    s.confirm(&callback).await; s.wait(1).await;
+    let mut other=s.second_wire().await;
+    let mut offered=lifecycle_offer(&s,1,0,"recvonly");
+    offered["payload"]["streams_offered"]=json!([{"id":"camera","kind":"video","direction":"recvonly","codec_preferences":["vp8"]}]);
+    let (_,callback)=other_prepared(&s,&mut other,offered).await;
+    let target_handle=subscriptions::stream_handle(&callback,"camera");
+    other.send(s.f.sign(s.confirmation(&callback))).await; s.wait(2).await;
+    let receiver=s.native.adapters[&s.kind].media_controller(&s.second_id).unwrap();
+    other.send(s.f.sign(subscriptions::command("stream.subscribe",receiver.revision(),json!({"subscriptions":[{"strm_id":"camera"}]})))).await;
+    assert_eq!(other.read().await.kind(),"ack");
+    send(&s.wire,subscriptions::video_sequence(source_handle,2,6000));
+    let delivered=received(&other).await; assert_eq!(delivered.stream_local_id,target_handle);
+    let private=epoch(&s.f,&mut other).await;
+    assert_eq!(private["payload"]["direction"],"receiver");
+    // Both actual directions of these one-way bindings have flowed. Despite
+    // that, neither public Ready/open nor publisher metadata may be announced.
+    no_event(&mut s.wire).await; no_event(&mut other).await;
+    assert_eq!(s.record.event_approvals.load(Ordering::Acquire),1);
+    s.record.receiver_epochs_only.store(false,Ordering::Release);
+    let publisher=epoch(&s.f,&mut s.wire).await;
+    assert_eq!(publisher["payload"]["direction"],"publisher");
+    assert_eq!(publisher["payload"]["first_timestamp"],6000);
+    for wire in [&mut s.wire,&mut other] {
+        let ready=tokio::time::timeout(Duration::from_secs(3),wire.read()).await.unwrap();
+        assert_eq!(ready.kind(),"connection.ready"); s.f.verify_server(&ready).await;
+        let opened=tokio::time::timeout(Duration::from_secs(3),wire.read()).await.unwrap();
+        assert_eq!(opened.kind(),"stream.opened"); s.f.verify_server(&opened).await;
+    }
+    // No reoffer or new registration was made to resume ordinary lifecycle.
+    assert_eq!(s.record.results.lock().unwrap().len(),2);
+    s.wire.server.shutdown().await.unwrap(); other.server.shutdown().await.unwrap();
+}
