+//! Only exact owned queued audio retries an internal after-policy model race.
+use super::*;
+
+#[derive(Clone, Copy)]
+enum Failure {
+    None,
+    RevokedBeforeRetry,
+    GenerationBeforeRetry,
+    ExpiredBeforeRetry,
+    PolicyConflict,
+    PolicyAuthority,
+}
+struct ActionOwner(Arc<Domain>);
+impl Drop for ActionOwner {
+    fn drop(&mut self) {
+        self.0.original_visual_policy_action.lock().unwrap().take();
+        self.0.queued_visual_receive_action.lock().unwrap().take();
+    }
+}
+async fn exercise(target_callback: bool, failure: Failure) {
+    let mut room = Room::new().await;
+    // The existing Room starts Audio only, but its authentic owner capabilities
+    // already negotiate Video. Verify this before freezing the original PCM.
+    {
+        let policy = room.domain.base.0.read().await;
+        let owner = &policy.owners[if target_callback { "bob" } else { "alice" }];
+        assert!(owner.may_control);
+        assert!(owner.send_media.contains(&Medium::Video));
+        assert!(owner.receive_media.contains(&Medium::Video));
+        assert!(
+            negotiate_streams(
+                &owner.local,
+                &owner.remote,
+                &[desired(Medium::Audio), desired(Medium::Video)],
+            )
+            .is_ok()
+        );
+    }
+    room.publish("alice", 1800).unwrap();
+    room.tick();
+    let queued = room.nodes.get_mut("bob").unwrap().out.try_recv().unwrap();
+    assert!(queued.can_batch_audio());
+    let source = room.nodes["alice"].controller.clone();
+    let target = room.nodes["bob"].controller.clone();
+    let source_for_control = source.clone();
+    let target_for_control = target.clone();
+    let original_source_port = source
+        .active_bindings()
+        .into_iter()
+        .find(|binding| binding.negotiated.requested.medium == Medium::Audio)
+        .expect("original Audio binding disappeared")
+        .transport_id;
+    let original_target_port = target
+        .active_bindings()
+        .into_iter()
+        .find(|binding| binding.negotiated.requested.medium == Medium::Audio)
+        .expect("original Audio binding disappeared")
+        .transport_id;
+    let admitted_at = queued.admitted_at;
+    let source_ticket = queued.sources[0].ticket.clone();
+    let source_consumer = queued.sources[0].consumer.clone();
+    let source_scene = queued.sources[0].scene.clone();
+    let target_ticket = queued.target_ticket.clone();
+    let target_consumer = queued.target_consumer.clone();
+    let target_scene = queued.target_scene.clone();
+    let subscription = queued.subscription.clone();
+    let scene = room.scene.clone();
+    let runtime = tokio::runtime::Handle::current();
+    let completed = Arc::new(AtomicBool::new(false));
+    let completed_by_callback = completed.clone();
+    let applied = Arc::new(AtomicBool::new(false));
+    let applied_by_callback = applied.clone();
+    let action: OriginalVisualPolicyAction = Box::new(move |lease| {
+        // The existing historical visual-named hook observes this actual Audio
+        // policy call too. No new callback seam or fabricated grant is needed.
+        applied_by_callback.store(true, Ordering::Release);
+        if matches!(failure, Failure::PolicyConflict) {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        if matches!(failure, Failure::PolicyAuthority) {
+            return Err(StreamControlError::Authority);
+        }
+        drop(
+            source_for_control
+                .state
+                .try_lock()
+                .expect("source State held"),
+        );
+        drop(
+            target_for_control
+                .state
+                .try_lock()
+                .expect("target State held"),
+        );
+        drop(scene.members.try_lock().expect("scene members held"));
+        let before = (source_for_control.revision(), target_for_control.revision());
+        let worker = std::thread::spawn(move || {
+            runtime.block_on(async move {
+                let changed = if target_callback {
+                    &target_for_control
+                } else {
+                    &source_for_control
+                };
+                let original_cutoff =
+                    tokio::time::Instant::from_std(admitted_at + Duration::from_millis(200));
+                // Reuse Audio's exact Port and selection. No subscription or
+                // audio route reader has to quiesce for this independent add.
+                changed
+                    .change(
+                        changed.revision(),
+                        &[desired(Medium::Audio), desired(Medium::Video)],
+                        &BTreeSet::new(),
+                        original_cutoff,
+                        CancellationToken::new(),
+                    )
+                    .await?;
+                assert_eq!(source_for_control.revision() > before.0, !target_callback);
+                assert_eq!(target_for_control.revision() > before.1, target_callback);
+                assert!(
+                    changed
+                        .active_bindings()
+                        .iter()
+                        .any(|binding| { binding.negotiated.requested.medium == Medium::Video })
+                );
+                assert_eq!(
+                    source_for_control
+                        .active_bindings()
+                        .into_iter()
+                        .find(|binding| binding.negotiated.requested.medium == Medium::Audio)
+                        .expect("original Audio binding disappeared")
+                        .transport_id,
+                    original_source_port
+                );
+                assert_eq!(
+                    target_for_control
+                        .active_bindings()
+                        .into_iter()
+                        .find(|binding| binding.negotiated.requested.medium == Medium::Audio)
+                        .expect("original Audio binding disappeared")
+                        .transport_id,
+                    original_target_port
+                );
+                assert!(source_ticket.is_current() && target_ticket.is_current());
+                assert!(
+                    source_consumer
+                        .as_ref()
+                        .is_none_or(audio_consumer::ConsumerStamp::is_current)
+                );
+                assert!(
+                    target_consumer
+                        .as_ref()
+                        .is_none_or(audio_consumer::ConsumerStamp::is_current)
+                );
+                assert!(
+                    source_scene
+                        .as_ref()
+                        .is_none_or(|stamp| stamp.active_at(admitted_at))
+                );
+                assert!(
+                    target_scene
+                        .as_ref()
+                        .is_none_or(|stamp| stamp.active_at(admitted_at))
+                );
+                assert!(
+                    subscription
+                        .as_ref()
+                        .is_some_and(|stamp| stamp.is_current())
+                );
+                Ok::<(), StreamControlError>(())
+            })
+        });
+        // Join the actual mutation worker before examining its outcome.
+        let result = worker.join().expect("original control worker panicked");
+        eprintln!(
+            "queued-audio-independent-control target_callback={target_callback} result={result:?} age_us={}",
+            admitted_at.elapsed().as_micros(),
+        );
+        assert!(
+            result.is_ok(),
+            "actual independent control failed: {result:?}"
+        );
+        result?;
+        assert!(admitted_at.elapsed() < Duration::from_millis(200));
+        completed_by_callback.store(true, Ordering::Release);
+        Ok(lease)
+    });
+    let slot = if target_callback {
+        &room.domain.queued_visual_receive_action
+    } else {
+        &room.domain.original_visual_policy_action
+    };
+    assert!(slot.lock().unwrap().replace(action).is_none());
+    let _action_owner = ActionOwner(room.domain.clone());
+    let mut writes = 0;
+    let result = QueuedMedia::deliver_ready_audio_batch(vec![queued], |_, _, _| {
+        writes += 1;
+        Ok(())
+    });
+    assert!(
+        applied.load(Ordering::Acquire),
+        "actual callback was not entered"
+    );
+    assert_eq!(
+        completed.load(Ordering::Acquire),
+        !matches!(failure, Failure::PolicyConflict | Failure::PolicyAuthority),
+        "entered callback is not proof that its original control completed",
+    );
+    assert_eq!(writes, 0, "stale callback performed IO");
+    assert_eq!(result.len(), 1);
+    let (queued, problem) = match result.into_iter().next().unwrap() {
+        ReadyAudioDelivery::Refused { queued, problem } => (queued, problem),
+        ReadyAudioDelivery::Submitted(_) => panic!("stale callback submitted IO"),
+    };
+    if matches!(failure, Failure::PolicyConflict) {
+        assert!(matches!(
+            problem,
+            StreamControlError::Model(MediaTransitionError::Conflict)
+        ));
+        return;
+    }
+    if matches!(failure, Failure::PolicyAuthority) {
+        assert!(matches!(problem, StreamControlError::Authority));
+        return;
+    }
+    // Old production fails here with Model(Conflict), after its actual worker
+    // has joined. Neither grant nor permission is carried into the next call.
+    let provenance = &queued.sources[0];
+    eprintln!(
+        "queued-audio-first-refusal target_callback={target_callback} problem={problem:?} age_us={} can_batch={} source_audio={} target_audio={} source_consumer={} target_consumer={} source_scene={} target_scene={} source_ticket_current={} target_ticket_current={} source_consumer_current={} target_consumer_current={} source_scene_active={} target_scene_active={} subscription_current={}",
+        admitted_at.elapsed().as_micros(),
+        queued.can_batch_audio(),
+        provenance.source.binding.negotiated.requested.medium == Medium::Audio,
+        queued.target.binding.negotiated.requested.medium == Medium::Audio,
+        provenance.consumer.is_some(),
+        queued.target_consumer.is_some(),
+        provenance.scene.is_some(),
+        queued.target_scene.is_some(),
+        provenance.ticket.is_current(),
+        queued.target_ticket.is_current(),
+        provenance
+            .consumer
+            .as_ref()
+            .is_none_or(audio_consumer::ConsumerStamp::is_current),
+        queued
+            .target_consumer
+            .as_ref()
+            .is_none_or(audio_consumer::ConsumerStamp::is_current),
+        provenance
+            .scene
+            .as_ref()
+            .is_none_or(|stamp| stamp.active_at(admitted_at)),
+        queued
+            .target_scene
+            .as_ref()
+            .is_none_or(|stamp| stamp.active_at(admitted_at)),
+        queued
+            .subscription
+            .as_ref()
+            .is_some_and(|stamp| stamp.is_current()),
+    );
+    assert!(
+        matches!(problem, StreamControlError::NotReady),
+        "actual original queued-audio refusal: {problem:?}; target_callback={target_callback}"
+    );
+    match failure {
+        Failure::RevokedBeforeRetry => {
+            room.domain
+                .base
+                .0
+                .write()
+                .await
+                .revoked
+                .insert("alice".into());
+        }
+        Failure::GenerationBeforeRetry => {
+            let changed = if target_callback { &target } else { &source };
+            let logical = BTreeSet::from([desired(Medium::Audio).logical_id]);
+            for gate in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                changed
+                    .set_media_gate(changed.revision(), &logical, gate, deadline())
+                    .await
+                    .unwrap();
+            }
+        }
+        Failure::ExpiredBeforeRetry => {
+            tokio::time::sleep_until(tokio::time::Instant::from_std(
+                admitted_at + Duration::from_millis(210),
+            ))
+            .await;
+        }
+        _ => {}
+    }
+    let mut delivered = None;
+    let result = QueuedMedia::deliver_ready_audio_batch(vec![queued], |_, frame, _| {
+        writes += 1;
+        delivered = Some(frame);
+        Ok(())
+    });
+    let outcome = result.into_iter().next().unwrap();
+    if !matches!(failure, Failure::None) {
+        assert_eq!(
+            writes, 0,
+            "old refused PCM crossed a current negative fence"
+        );
+        match outcome {
+            ReadyAudioDelivery::Refused { problem, .. } => match failure {
+                Failure::RevokedBeforeRetry => {
+                    assert!(matches!(problem, StreamControlError::Authority))
+                }
+                Failure::ExpiredBeforeRetry => {
+                    assert!(matches!(problem, StreamControlError::Deadline))
+                }
+                Failure::GenerationBeforeRetry => {
+                    assert!(!matches!(problem, StreamControlError::Deadline))
+                }
+                _ => unreachable!(),
+            },
+            ReadyAudioDelivery::Submitted(_) => panic!("refused original reached IO"),
+        }
+        return;
+    }
+    assert!(matches!(outcome, ReadyAudioDelivery::Submitted(Ok(()))));
+    assert_eq!(writes, 1);
+    let frame = delivered.unwrap();
+    let mut codec =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap();
+    let pcm = codec.decode(&frame.payload).unwrap();
+    assert_eq!(pcm.samples.len(), 160);
+    assert!(
+        pcm.samples
+            .iter()
+            .all(|sample| (i32::from(*sample) - 1800).abs() < 400)
+    );
+    drop(
+        room.domain
+            .base
+            .0
+            .try_write()
+            .expect("completed delivery retained a reader"),
+    );
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn queued_audio_source_revision_race_retries_same_original_pcm_once() {
+    exercise(false, Failure::None).await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn queued_audio_target_revision_race_retries_same_original_pcm_once() {
+    exercise(true, Failure::None).await;
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn queued_audio_retry_preserves_policy_errors_current_revocation_generation_and_original_expiry()
+ {
+    for target in [false, true] {
+        for failure in [
+            Failure::RevokedBeforeRetry,
+            Failure::GenerationBeforeRetry,
+            Failure::ExpiredBeforeRetry,
+            Failure::PolicyConflict,
+            Failure::PolicyAuthority,
+        ] {
+            exercise(target, failure).await;
+        }
+    }
+}
