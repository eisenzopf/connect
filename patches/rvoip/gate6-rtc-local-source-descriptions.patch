+    /// Periodic reports carry the exact local SDP clock identity. This is
+    /// current sender metadata, not a forwarded remote identity or a media
+    /// permission. Never relabel unknown, stopped or ambiguous bindings.
+    fn append_local_source_descriptions(&mut self, packets: &mut Vec<Box<dyn rtcp::Packet>>) {
+        use rtcp::source_description::{
+            SdesType, SourceDescription, SourceDescriptionChunk, SourceDescriptionItem,
+        };
+        let mut described = packets
+            .iter()
+            .filter_map(|packet| packet.as_any().downcast_ref::<SourceDescription>())
+            .flat_map(|description| &description.chunks)
+            .filter(|chunk| {
+                chunk
+                    .items
+                    .iter()
+                    .any(|item| item.sdes_type == SdesType::SdesCname)
+            })
+            .map(|chunk| chunk.source)
+            .collect::<HashSet<_>>();
+        let sources = packets
+            .iter()
+            .filter_map(|packet| packet.as_any().downcast_ref::<SenderReport>())
+            .map(|report| report.ssrc)
+            .collect::<Vec<_>>();
+        let mut chunks = Vec::new();
+        for source in sources {
+            if described.contains(&source) {
+                continue;
+            }
+            let mut cname = None;
+            let mut ambiguous = false;
+            for transceiver in self.rtp_transceivers.iter_mut() {
+                if transceiver.stopped() || !transceiver.current_direction().has_send() {
+                    continue;
+                }
+                let Some(sender) = transceiver.sender_mut().as_mut() else {
+                    continue;
+                };
+                let owns = sender
+                    .get_parameters(self.media_engine)
+                    .encodings
+                    .iter()
+                    .any(|encoding| {
+                        let coding = &encoding.rtp_coding_parameters;
+                        coding.ssrc == Some(source)
+                            || coding
+                                .rtx
+                                .as_ref()
+                                .is_some_and(|repair| repair.ssrc == source)
+                            || coding
+                                .fec
+                                .as_ref()
+                                .is_some_and(|repair| repair.ssrc == source)
+                    });
+                if owns {
+                    if cname.is_some() {
+                        ambiguous = true;
+                        break;
+                    }
+                    cname = Some(sender.track().stream_id().clone());
+                }
+            }
+            let Some(cname) = cname else {
+                continue;
+            };
+            if ambiguous || cname.is_empty() || cname.len() > 255 {
+                continue;
+            }
+            described.insert(source);
+            chunks.push(SourceDescriptionChunk {
+                source,
+                items: vec![SourceDescriptionItem {
+                    sdes_type: SdesType::SdesCname,
+                    text: cname.as_bytes().to_vec().into(),
+                }],
+            });
+        }
+        // The RTCP source-count field has five bits. Ordinary peer reports
+        // contain one SR; preserve valid encoding even for a supplied batch.
+        for group in chunks.chunks(31) {
+            packets.push(Box::new(SourceDescription {
+                chunks: group.to_vec(),
+            }));
+        }
     }
 
