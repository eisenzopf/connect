+#[test]
+fn stopped_inactive_ambiguous_or_invalid_local_bindings_never_mint_clock_identities() {
+    let mut stopped = outgoing(RtpCodecKind::Audio, 11, "retired");
+    stopped
+        .stop(&MediaEngine::default(), &mut NoopInterceptor::default())
+        .unwrap();
+    let mut inactive = outgoing(RtpCodecKind::Audio, 11, "inactive");
+    inactive.set_current_direction(RTCRtpTransceiverDirection::Inactive);
+    let groups = vec![
+        vec![stopped],
+        vec![inactive],
+        vec![
+            outgoing(RtpCodecKind::Audio, 11, "one"),
+            outgoing(RtpCodecKind::Video, 11, "two"),
+        ],
+        vec![outgoing(RtpCodecKind::Audio, 11, "")],
+        vec![outgoing(RtpCodecKind::Audio, 11, &"x".repeat(256))],
+    ];
+    for mut tracks in groups {
+        let packets = output(vec![sr(11)], &mut tracks);
+        assert_eq!(
+            packets.len(),
+            1,
+            "unusable local metadata gained an identity"
+        );
+    }
+}
+#[test]
+fn batched_local_descriptions_respect_the_rtcp_source_count_field() {
+    let mut tracks = (1..=32)
+        .map(|ssrc| outgoing(RtpCodecKind::Audio, ssrc, "private-batch"))
+        .collect::<Vec<_>>();
+    let packets = output((1..=32).map(sr).collect(), &mut tracks);
+    let descriptions = packets
+        .iter()
+        .filter_map(|p| p.as_any().downcast_ref::<SourceDescription>())
+        .collect::<Vec<_>>();
+    assert_eq!(descriptions.len(), 2);
+    assert_eq!(descriptions[0].chunks.len(), 31);
+    assert_eq!(descriptions[1].chunks.len(), 1);
+    let sources = descriptions
+        .iter()
+        .flat_map(|d| d.chunks.iter().map(|c| c.source))
+        .collect::<std::collections::HashSet<_>>();
+    assert_eq!(sources, (1..=32).collect());
+}
