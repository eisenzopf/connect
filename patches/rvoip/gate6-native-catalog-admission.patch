+#[tokio::test]
+async fn catalog_probe_yields_while_the_actual_mixer_owns_scene_members() {
+    use crate::staged_streams::subscription_plan::{MediaSelection, MediaSelectionChange};
+    let s = wildcard_scene().await;
+    let expected = s.f.b.revision();
+    let held = s.scene.members.lock().unwrap();
+    probe_catalog_without_waiting(&s, expected, || drop(held));
+    let change = MediaSelectionChange::Subscribe(vec![MediaSelection::Participant {
+        participant: s.f.a.origin_member.participant().clone(),
+        media: BTreeSet::from([Medium::Audio]),
+    }]);
+    assert_eq!(
+        apply(&s, planned(&s, &change).routing().clone())
+            .await
+            .unwrap(),
+        2
+    );
+}
