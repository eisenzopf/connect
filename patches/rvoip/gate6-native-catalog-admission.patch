+fn probe_catalog_without_waiting(s: &Scene, expected: u64, release: impl FnOnce()) {
+    use crate::staged_streams::subscription_plan::MediaSelectionChange;
+    let scene = s.scene.clone();
+    let target = s.f.b.connection.clone();
+    let (sent, received) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        sent.send(
+            scene
+                .plan_selection(&target, expected, &MediaSelectionChange::Reconcile)
+                .map(|_| ()),
+        )
+        .unwrap();
+    });
+    // Release the lock even on a regression, so a blocking implementation
+    // fails the assertion rather than hanging the entire test process.
+    let result = received.recv_timeout(Duration::from_millis(500));
+    release();
+    worker.join().unwrap();
+    assert!(
+        matches!(result, Ok(Err(StreamControlError::Backpressure))),
+        "busy catalog must yield before the owner releases it: {result:?}"
+    );
+}
