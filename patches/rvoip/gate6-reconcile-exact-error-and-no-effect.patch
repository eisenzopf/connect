+/// Opaque historical proof that this exact unchanged-resource attempt failed
+/// before its single atomic routing commit. It owns no authority or IO handle.
+/// Only the adapter's completed routing-only call can construct this proof.
+#[derive(Clone)]
+pub struct NativeSubscriptionNoEffect {
+    origin: std::sync::Weak<super::native_lifecycle::NativeLifecycleScope>,
+    operation: String,
+    revision: u64,
+    generation: u64,
+    credential: u64,
+    conversation: rvoip_core::ids::ConversationId,
+    error: NativeOfferError,
+}
+impl NativeSubscriptionNoEffect {
+    pub(crate) fn from_failed_routing(
+        invocation: &NativeSubscriptionInvocation,
+        error: NativeOfferError,
+    ) -> Self {
+        assert!(!invocation.plan().changes_resources());
+        let scope = invocation.scope();
+        Self {
+            origin: std::sync::Arc::downgrade(&scope.origin),
+            operation: invocation.operation().into(),
+            revision: scope.stream_revision,
+            generation: scope.connection_generation,
+            credential: scope.credential_revision,
+            conversation: scope.conversation.clone(),
+            error,
+        }
+    }
+    /// Match original historical scope/error, not current permission. A match
+    /// authorizes no request, engine call, packet or different operation.
+    pub fn matches(
+        &self,
+        scope: &super::native_requests::NativeRequestScope,
+        operation: &str,
+        error: &NativeOfferError,
+    ) -> bool {
+        self.operation == operation
+            && self.revision == scope.stream_revision
+            && self.generation == scope.connection_generation
+            && self.credential == scope.credential_revision
+            && self.conversation == scope.conversation
+            && self.error == *error
+            && self
+                .origin
+                .ptr_eq(&std::sync::Arc::downgrade(&scope.origin))
+    }
 }
