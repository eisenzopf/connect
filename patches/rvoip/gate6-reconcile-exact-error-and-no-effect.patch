+            super::native_negotiation::NativeOfferError,
+        >,
+        Option<super::native_subscriptions::NativeSubscriptionNoEffect>,
+    ) {
+        let result = self
+            .reconcile_native_subscriptions_once(core, id, invocation.clone(), policy, slot)
+            .await;
