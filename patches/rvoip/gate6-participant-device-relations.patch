+#[test]
+fn endpoint_replacement_waits_for_current_readiness_and_retires_only_old_lineage() {
+    let member = membership("tenant_one", "id_alice", "conv_one");
+    let appearance = SessionAppearance::admit(&member, SessionId::new(), None).unwrap();
+    let ep_a = endpoint(&member.binding, "ep_a");
+    let ep_b = endpoint(&member.binding, "ep_b");
+    let mut old =
+        ConnectionBinding::prepare(&member, &appearance, &ep_a, ConnectionId::new()).unwrap();
+    old.observe_ready(&member, &appearance, &ep_a, 1).unwrap();
+    old.activate(&member, &appearance, &ep_a).unwrap();
+    let mut candidate = old
+        .replacement(&member, &appearance, &ep_b, ConnectionId::new())
+        .unwrap();
+    assert_eq!(candidate.replaces(), Some(old.connection()));
+    assert!(old
+        .commit_replacement(&mut candidate, &member, &appearance, &ep_b)
+        .is_err());
+    assert_eq!(old.state(), BindingState::Active);
+    assert_eq!(
+        candidate.observe_ready(&member, &appearance, &ep_b, 1),
+        Err(RelationshipError::Conflict)
+    );
+    candidate
+        .observe_ready(&member, &appearance, &ep_b, 2)
+        .unwrap();
+    old.commit_replacement(&mut candidate, &member, &appearance, &ep_b)
+        .unwrap();
+    assert_eq!(old.state(), BindingState::Retired);
+    assert_eq!(candidate.state(), BindingState::Active);
+    assert_eq!(candidate.participant(), old.participant());
+    assert_eq!(candidate.session(), old.session());
+    assert!(old.observe_ready(&member, &appearance, &ep_a, 1).is_err());
+    assert_eq!(old.state(), BindingState::Retired);
+}
