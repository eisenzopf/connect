+use super::*;
+use crate::identity::{AuthenticationMethod, IdentityAssurance};
+
+fn now() -> DateTime<Utc> {
+    DateTime::parse_from_rfc3339("2026-10-15T12:00:00Z")
+        .unwrap()
+        .with_timezone(&Utc)
+}
+fn principal(tenant: &str, subject: &str) -> AuthenticatedPrincipal {
+    AuthenticatedPrincipal {
+        subject: subject.into(),
+        tenant: Some(tenant.into()),
+        scopes: vec![],
+        issuer: Some("issuer".into()),
+        expires_at: Some(now() + chrono::Duration::hours(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Anonymous,
+    }
+}
+fn binding(tenant: &str, id: &str) -> IdentityBinding {
+    IdentityBinding::from_authenticated(&principal(tenant, id), IdentityId::from_string(id), now())
+        .unwrap()
+}
+fn membership(tenant: &str, id: &str, conv: &str) -> Membership {
+    Membership::admit(
+        binding(tenant, id),
+        ConversationId::from_string(conv),
+        ParticipantId::from_string("part_local"),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+    )
+    .unwrap()
+}
+fn endpoint(owner: &IdentityBinding, name: &str) -> EndpointBinding {
+    let mut value = EndpointBinding::provision(
+        owner.clone(),
+        EndpointId::from_string(name),
+        DeviceId::from_string(format!("dev_{name}")),
+        Transport::WebRtc,
+        "provider-private-address".into(),
+    )
+    .unwrap();
+    value.verify(owner, "proof_verified".into(), now()).unwrap();
+    value
+}
+
+#[test]
+fn roles_are_conversation_defaults_and_session_snapshots() {
+    let mut first = membership("tenant_one", "id_alice", "conv_one");
+    let second = membership("tenant_one", "id_alice", "conv_two");
+    let mut a = SessionAppearance::admit(&first, SessionId::from_string("sess_a"), None).unwrap();
+    let b = SessionAppearance::admit(&first, SessionId::from_string("sess_b"), None).unwrap();
+    first.change_role(1, ParticipantRole::Supervisor).unwrap();
+    assert_eq!(first.default_role(), &ParticipantRole::Supervisor);
+    assert_eq!(second.default_role(), &ParticipantRole::Agent);
+    assert_eq!(a.role(), &ParticipantRole::Agent);
+    assert_eq!(b.role(), &ParticipantRole::Agent);
+    a.change_role(&first, 1, ParticipantRole::Observer).unwrap();
+    assert_eq!(a.role(), &ParticipantRole::Observer);
+    assert_eq!(b.role(), &ParticipantRole::Agent);
+    assert_eq!(
+        a.change_role(&first, 1, ParticipantRole::Agent),
+        Err(RelationshipError::Conflict)
+    );
+    assert_eq!(
+        first.change_role(1, ParticipantRole::Agent),
+        Err(RelationshipError::Conflict)
+    );
+}
