+#[test]
+fn removal_and_rejoin_invalidate_old_presence_and_connection_epochs() {
+    let mut member = membership("tenant_one", "id_alice", "conv_one");
+    let mut appearance = SessionAppearance::admit(&member, SessionId::new(), None).unwrap();
+    let ep = endpoint(&member.binding, "ep_one");
+    let mut conn =
+        ConnectionBinding::prepare(&member, &appearance, &ep, ConnectionId::new()).unwrap();
+    member.remove(1).unwrap();
+    assert_eq!(
+        appearance.require_current(&member),
+        Err(RelationshipError::Inactive)
+    );
+    assert!(conn.observe_ready(&member, &appearance, &ep, 1).is_err());
+    member
+        .readmit(&binding("tenant_one", "id_alice"), 2)
+        .unwrap();
+    assert_eq!(member.epoch(), 2);
+    assert_eq!(member.revision(), 3);
+    assert_eq!(
+        appearance.require_current(&member),
+        Err(RelationshipError::OwnerMismatch)
+    );
+    assert!(appearance.leave(&member, 1).is_err());
+    assert!(conn.observe_ready(&member, &appearance, &ep, 1).is_err());
+    let fresh = SessionAppearance::admit(&member, SessionId::new(), None).unwrap();
+    assert_eq!(fresh.membership_epoch(), 2);
+}
