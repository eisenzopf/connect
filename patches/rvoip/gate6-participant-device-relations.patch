+#[test]
+fn leaving_one_session_preserves_membership_other_sessions_and_devices() {
+    let member = membership("tenant_one", "id_alice", "conv_one");
+    let mut a = SessionAppearance::admit(&member, SessionId::new(), None).unwrap();
+    let b = SessionAppearance::admit(&member, SessionId::new(), None).unwrap();
+    let ep_a = endpoint(&member.binding, "ep_a");
+    let ep_b = endpoint(&member.binding, "ep_b");
+    let first = ConnectionBinding::prepare(&member, &b, &ep_a, ConnectionId::new()).unwrap();
+    let second = ConnectionBinding::prepare(&member, &b, &ep_b, ConnectionId::new()).unwrap();
+    assert_eq!(first.participant(), second.participant());
+    assert_ne!(first.device(), second.device());
+    a.leave(&member, 1).unwrap();
+    assert!(member.is_active());
+    assert!(b.require_current(&member).is_ok());
+    assert!(first.require_current(&member, &b).is_ok());
+    assert!(second.require_current(&member, &b).is_ok());
+}
