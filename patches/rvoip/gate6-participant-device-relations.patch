+//! Checked identity, membership, presence and device relationships.
+//!
+//! These are pure values and transition guards, not a second registry or an
+//! authorization store. The owning application persists them transactionally,
+//! resolves authenticated identities and rechecks current grants/revocation.
+//! Provider addresses are endpoint data and never select a logical identity.
+
+use crate::{
+    connection::Transport,
+    identity::{AuthenticatedPrincipal, AuthenticationMethod, PrincipalOwnershipKey},
+    ids::{
+        ConnectionId, ConversationId, DeviceId, EndpointId, IdentityId, ParticipantId, SessionId,
+        TenantId,
+    },
+    participant::{ParticipantKind, ParticipantRole},
+};
+use chrono::{DateTime, Utc};
+
+const MAX_REVISION: u64 = 9_007_199_254_740_991;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, thiserror::Error)]
+pub enum RelationshipError {
+    #[error("invalid relationship identifier or role")]
+    InvalidValue,
+    #[error("authenticated identity binding does not match")]
+    OwnerMismatch,
+    #[error("membership or presence is inactive")]
+    Inactive,
+    #[error("stale relationship revision or generation")]
+    Conflict,
+    #[error("endpoint or candidate is not ready")]
+    NotReady,
+}
+
+fn identifier(value: &str) -> Result<(), RelationshipError> {
+    if value.is_empty()
+        || value.len() > 128
+        || !value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+    {
+        return Err(RelationshipError::InvalidValue);
+    }
+    Ok(())
+}
+
+fn role(value: &ParticipantRole) -> Result<(), RelationshipError> {
+    if let ParticipantRole::Custom(value) = value {
+        if value.is_empty() || value.len() > 64 || value.chars().any(char::is_control) {
+            return Err(RelationshipError::InvalidValue);
+        }
+    }
+    Ok(())
+}
+
+fn next(current: u64, expected: u64) -> Result<u64, RelationshipError> {
+    if current != expected || current >= MAX_REVISION {
+        return Err(RelationshipError::Conflict);
+    }
+    Ok(current + 1)
+}
+
+/// Supplied by the trusted authentication/identity resolver. Payload fields
+/// cannot overwrite any member of this binding. Subject-to-identity mappings
+/// belong to that resolver; a provider address is never such a mapping.
+#[derive(Clone)]
+pub struct IdentityBinding {
+    tenant: TenantId,
+    identity: IdentityId,
+    owner: PrincipalOwnershipKey,
+    expires_at: Option<DateTime<Utc>>,
+}
+
+impl IdentityBinding {
+    pub fn from_authenticated(
+        principal: &AuthenticatedPrincipal,
+        identity: IdentityId,
+        now: DateTime<Utc>,
+    ) -> Result<Self, RelationshipError> {
+        let tenant = principal
+            .tenant
+            .as_deref()
+            .ok_or(RelationshipError::OwnerMismatch)?;
+        identifier(tenant)?;
+        identifier(identity.as_str())?;
+        // Federation resolution is reserved; never silently localize an f_ ID.
+        if identity.as_str().starts_with("f_")
+            || principal.subject.is_empty()
+            || principal.method == AuthenticationMethod::Anonymous
+            || principal.is_expired_at(now)
+        {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        Ok(Self {
+            tenant: TenantId::from_string(tenant),
+            identity,
+            owner: principal.ownership_key(),
+            expires_at: principal.expires_at,
+        })
+    }
+    pub fn identity(&self) -> &IdentityId {
+        &self.identity
+    }
+    pub fn tenant(&self) -> &TenantId {
+        &self.tenant
+    }
+    pub fn assert_identity(&self, supplied: Option<&str>) -> Result<(), RelationshipError> {
+        if supplied.is_some_and(|value| value != self.identity.as_str()) {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        Ok(())
+    }
+    pub fn revalidate(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        now: DateTime<Utc>,
+    ) -> Result<(), RelationshipError> {
+        if self.owner != principal.ownership_key()
+            || principal.method == AuthenticationMethod::Anonymous
+            || principal.is_expired_at(now)
+            || self.expires_at.is_some_and(|expiry| expiry <= now)
+        {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        Ok(())
+    }
+    fn same_identity(&self, other: &Self) -> bool {
+        self.tenant == other.tenant && self.identity == other.identity && self.owner == other.owner
+    }
+}
+
+/// One participant in one conversation. Removal and readmission preserve the
+/// logical participant while advancing its access epoch, never old audiences.
+#[derive(Clone)]
+pub struct Membership {
+    binding: IdentityBinding,
+    conversation: ConversationId,
+    participant: ParticipantId,
+    kind: ParticipantKind,
+    default_role: ParticipantRole,
+    epoch: u64,
+    revision: u64,
+    active: bool,
+}
+
+impl Membership {
+    pub fn admit(
+        binding: IdentityBinding,
+        conversation: ConversationId,
+        participant: ParticipantId,
+        kind: ParticipantKind,
+        default_role: ParticipantRole,
+    ) -> Result<Self, RelationshipError> {
+        identifier(conversation.as_str())?;
+        identifier(participant.as_str())?;
+        role(&default_role)?;
+        Ok(Self {
+            binding,
+            conversation,
+            participant,
+            kind,
+            default_role,
+            epoch: 1,
+            revision: 1,
+            active: true,
+        })
+    }
+    pub fn identity(&self) -> &IdentityId {
+        self.binding.identity()
+    }
+    pub fn tenant(&self) -> &TenantId {
+        self.binding.tenant()
+    }
+    pub fn conversation(&self) -> &ConversationId {
+        &self.conversation
+    }
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn kind(&self) -> &ParticipantKind {
+        &self.kind
+    }
+    pub fn default_role(&self) -> &ParticipantRole {
+        &self.default_role
+    }
+    pub fn epoch(&self) -> u64 {
+        self.epoch
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn is_active(&self) -> bool {
+        self.active
+    }
+    pub fn change_role(
+        &mut self,
+        expected: u64,
+        value: ParticipantRole,
+    ) -> Result<(), RelationshipError> {
+        self.require_active()?;
+        role(&value)?;
+        let revision = next(self.revision, expected)?;
+        self.default_role = value;
+        self.revision = revision;
+        Ok(())
+    }
+    pub fn remove(&mut self, expected: u64) -> Result<(), RelationshipError> {
+        self.require_active()?;
+        let revision = next(self.revision, expected)?;
+        self.active = false;
+        self.revision = revision;
+        Ok(())
+    }
+    pub fn readmit(
+        &mut self,
+        binding: &IdentityBinding,
+        expected: u64,
+    ) -> Result<(), RelationshipError> {
+        if self.active {
+            return Err(RelationshipError::Conflict);
+        }
+        if !self.binding.same_identity(binding) {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        let revision = next(self.revision, expected)?;
+        let epoch = next(self.epoch, self.epoch)?;
+        self.binding = binding.clone();
+        self.active = true;
+        self.revision = revision;
+        self.epoch = epoch;
+        Ok(())
+    }
+    fn require_active(&self) -> Result<(), RelationshipError> {
+        if !self.active {
+            Err(RelationshipError::Inactive)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+/// Role is an admission snapshot or explicit session override. Changes to a
+/// conversation's default role do not silently rewrite concurrent sessions.
+#[derive(Clone)]
+pub struct SessionAppearance {
+    tenant: TenantId,
+    identity: IdentityId,
+    conversation: ConversationId,
+    session: SessionId,
+    participant: ParticipantId,
+    epoch: u64,
+    role: ParticipantRole,
+    revision: u64,
+    present: bool,
+}
+
+impl SessionAppearance {
+    pub fn admit(
+        member: &Membership,
+        session: SessionId,
+        role_override: Option<ParticipantRole>,
+    ) -> Result<Self, RelationshipError> {
+        member.require_active()?;
+        identifier(session.as_str())?;
+        let value = role_override.unwrap_or_else(|| member.default_role.clone());
+        role(&value)?;
+        Ok(Self {
+            tenant: member.tenant().clone(),
+            identity: member.identity().clone(),
+            conversation: member.conversation.clone(),
+            session,
+            participant: member.participant.clone(),
+            epoch: member.epoch,
+            role: value,
+            revision: 1,
+            present: true,
+        })
+    }
+    pub fn session(&self) -> &SessionId {
+        &self.session
+    }
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn role(&self) -> &ParticipantRole {
+        &self.role
+    }
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn membership_epoch(&self) -> u64 {
+        self.epoch
+    }
+    pub fn is_present(&self) -> bool {
+        self.present
+    }
+    pub fn require_current(&self, member: &Membership) -> Result<(), RelationshipError> {
+        member.require_active()?;
+        if !self.present {
+            return Err(RelationshipError::Inactive);
+        }
+        if &self.tenant != member.tenant()
+            || &self.identity != member.identity()
+            || self.conversation != member.conversation
+            || self.participant != member.participant
+            || self.epoch != member.epoch
+        {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        Ok(())
+    }
+    pub fn change_role(
+        &mut self,
+        member: &Membership,
+        expected: u64,
+        value: ParticipantRole,
+    ) -> Result<(), RelationshipError> {
+        self.require_current(member)?;
+        role(&value)?;
+        let revision = next(self.revision, expected)?;
+        self.role = value;
+        self.revision = revision;
+        Ok(())
+    }
+    pub fn leave(&mut self, member: &Membership, expected: u64) -> Result<(), RelationshipError> {
+        self.require_current(member)?;
+        let revision = next(self.revision, expected)?;
+        self.present = false;
+        self.revision = revision;
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum EndpointState {
+    Unverified,
+    Verified,
+    Revoked,
+}
+
+/// A reachable address belongs to an authenticated identity/device. Grants
+/// and membership remain separate. Verification is an attributed server fact.
+#[derive(Clone)]
+pub struct EndpointBinding {
+    binding: IdentityBinding,
+    endpoint: EndpointId,
+    device: DeviceId,
+    transport: Transport,
+    address: String,
+    state: EndpointState,
+    verification: Option<(String, DateTime<Utc>)>,
+}
+
+impl EndpointBinding {
+    pub fn provision(
+        binding: IdentityBinding,
+        endpoint: EndpointId,
+        device: DeviceId,
+        transport: Transport,
+        address: String,
+    ) -> Result<Self, RelationshipError> {
+        identifier(endpoint.as_str())?;
+        identifier(device.as_str())?;
+        if address.is_empty() || address.len() > 2048 || address.chars().any(char::is_control) {
+            return Err(RelationshipError::InvalidValue);
+        }
+        Ok(Self {
+            binding,
+            endpoint,
+            device,
+            transport,
+            address,
+            state: EndpointState::Unverified,
+            verification: None,
+        })
+    }
+    pub fn endpoint(&self) -> &EndpointId {
+        &self.endpoint
+    }
+    pub fn device(&self) -> &DeviceId {
+        &self.device
+    }
+    pub fn identity(&self) -> &IdentityId {
+        self.binding.identity()
+    }
+    pub fn transport(&self) -> Transport {
+        self.transport
+    }
+    pub fn address(&self) -> &str {
+        &self.address
+    }
+    pub fn state(&self) -> EndpointState {
+        self.state
+    }
+    /// Only the owning trusted adapter/provisioner may call this with verified
+    /// evidence; the service must never map a client-supplied boolean here.
+    pub fn verify(
+        &mut self,
+        owner: &IdentityBinding,
+        evidence: String,
+        at: DateTime<Utc>,
+    ) -> Result<(), RelationshipError> {
+        if !self.binding.same_identity(owner) {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        if self.state == EndpointState::Revoked {
+            return Err(RelationshipError::Inactive);
+        }
+        identifier(&evidence)?;
+        self.verification = Some((evidence, at));
+        self.state = EndpointState::Verified;
+        Ok(())
+    }
+    pub fn revoke(&mut self) {
+        self.state = EndpointState::Revoked;
+    }
+    fn usable_by(&self, member: &Membership) -> Result<(), RelationshipError> {
+        member.require_active()?;
+        if !self.binding.same_identity(&member.binding) {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        if self.state != EndpointState::Verified {
+            return Err(RelationshipError::NotReady);
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BindingState {
+    Preparing,
+    Ready,
+    Active,
+    Retired,
+}
+
+/// Logical lineage is distinct from the adapter's physical transport handle.
+/// Several bindings can coexist for one participant on different devices.
+#[derive(Clone)]
+pub struct ConnectionBinding {
+    conversation: ConversationId,
+    session: SessionId,
+    participant: ParticipantId,
+    epoch: u64,
+    connection: ConnectionId,
+    endpoint: EndpointId,
+    device: DeviceId,
+    generation: u64,
+    replaces: Option<ConnectionId>,
+    state: BindingState,
+}
+
+impl ConnectionBinding {
+    pub fn prepare(
+        member: &Membership,
+        presence: &SessionAppearance,
+        endpoint: &EndpointBinding,
+        connection: ConnectionId,
+    ) -> Result<Self, RelationshipError> {
+        presence.require_current(member)?;
+        endpoint.usable_by(member)?;
+        identifier(connection.as_str())?;
+        Ok(Self {
+            conversation: member.conversation.clone(),
+            session: presence.session.clone(),
+            participant: member.participant.clone(),
+            epoch: member.epoch,
+            connection,
+            endpoint: endpoint.endpoint.clone(),
+            device: endpoint.device.clone(),
+            generation: 1,
+            replaces: None,
+            state: BindingState::Preparing,
+        })
+    }
+    pub fn replacement(
+        &self,
+        member: &Membership,
+        presence: &SessionAppearance,
+        endpoint: &EndpointBinding,
+        connection: ConnectionId,
+    ) -> Result<Self, RelationshipError> {
+        self.require_current(member, presence)?;
+        if self.state != BindingState::Active || connection == self.connection {
+            return Err(RelationshipError::Conflict);
+        }
+        let mut candidate = Self::prepare(member, presence, endpoint, connection)?;
+        candidate.generation = next(self.generation, self.generation)?;
+        candidate.replaces = Some(self.connection.clone());
+        Ok(candidate)
+    }
+    pub fn connection(&self) -> &ConnectionId {
+        &self.connection
+    }
+    pub fn session(&self) -> &SessionId {
+        &self.session
+    }
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn endpoint(&self) -> &EndpointId {
+        &self.endpoint
+    }
+    pub fn device(&self) -> &DeviceId {
+        &self.device
+    }
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+    pub fn replaces(&self) -> Option<&ConnectionId> {
+        self.replaces.as_ref()
+    }
+    pub fn state(&self) -> BindingState {
+        self.state
+    }
+    pub fn require_current(
+        &self,
+        member: &Membership,
+        presence: &SessionAppearance,
+    ) -> Result<(), RelationshipError> {
+        presence.require_current(member)?;
+        if self.conversation != member.conversation
+            || self.session != presence.session
+            || self.participant != member.participant
+            || self.epoch != member.epoch
+        {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        if self.state == BindingState::Retired {
+            return Err(RelationshipError::Inactive);
+        }
+        Ok(())
+    }
+    /// Called only after the adapter proves negotiated ingress/egress and any
+    /// required endpoint confirmation, using this precise connection generation.
+    pub fn observe_ready(
+        &mut self,
+        member: &Membership,
+        presence: &SessionAppearance,
+        endpoint: &EndpointBinding,
+        generation: u64,
+    ) -> Result<(), RelationshipError> {
+        self.require_current(member, presence)?;
+        endpoint.usable_by(member)?;
+        if endpoint.endpoint != self.endpoint || endpoint.device != self.device {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        if generation != self.generation {
+            return Err(RelationshipError::Conflict);
+        }
+        if self.state == BindingState::Preparing {
+            self.state = BindingState::Ready;
+        }
+        Ok(())
+    }
+    pub fn activate(
+        &mut self,
+        member: &Membership,
+        presence: &SessionAppearance,
+        endpoint: &EndpointBinding,
+    ) -> Result<(), RelationshipError> {
+        self.require_current(member, presence)?;
+        endpoint.usable_by(member)?;
+        if endpoint.endpoint != self.endpoint || endpoint.device != self.device {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        if self.state != BindingState::Ready || self.replaces.is_some() {
+            return Err(RelationshipError::NotReady);
+        }
+        self.state = BindingState::Active;
+        Ok(())
+    }
+    pub fn retire(&mut self) {
+        self.state = BindingState::Retired;
+    }
+    /// Application persists both changed values in the same fenced transaction
+    /// that commits its media route. No earlier readiness event retires old.
+    pub fn commit_replacement(
+        &mut self,
+        candidate: &mut Self,
+        member: &Membership,
+        presence: &SessionAppearance,
+        endpoint: &EndpointBinding,
+    ) -> Result<(), RelationshipError> {
+        self.require_current(member, presence)?;
+        candidate.require_current(member, presence)?;
+        endpoint.usable_by(member)?;
+        if endpoint.endpoint != candidate.endpoint || endpoint.device != candidate.device {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        if self.state != BindingState::Active
+            || candidate.state != BindingState::Ready
+            || candidate.replaces.as_ref() != Some(&self.connection)
+            || candidate.generation != next(self.generation, self.generation)?
+        {
+            return Err(RelationshipError::NotReady);
+        }
+        self.state = BindingState::Retired;
+        candidate.state = BindingState::Active;
+        Ok(())
+    }
+}
+
+macro_rules! redacted_debug {
+    ($($name:ty),*) => { $(impl std::fmt::Debug for $name {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str(concat!(stringify!($name), "(redacted)")) }
+    })* };
+}
+redacted_debug!(
+    IdentityBinding,
+    Membership,
+    SessionAppearance,
+    EndpointBinding,
+    ConnectionBinding
+);
