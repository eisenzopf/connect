+#[test]
+fn authenticated_binding_cannot_be_rebound_by_actor_tenant_or_federation_fields() {
+    let identity = binding("tenant_one", "id_alice");
+    assert!(identity.assert_identity(Some("id_bob")).is_err());
+    assert!(identity.assert_identity(None).is_ok());
+    assert!(identity
+        .revalidate(&principal("tenant_two", "id_alice"), now())
+        .is_err());
+    assert!(identity
+        .revalidate(&principal("tenant_one", "id_bob"), now())
+        .is_err());
+    assert!(identity
+        .revalidate(
+            &principal("tenant_one", "id_alice"),
+            now() + chrono::Duration::hours(2)
+        )
+        .is_err());
+    assert!(IdentityBinding::from_authenticated(
+        &principal("tenant_one", "id_alice"),
+        IdentityId::from_string("f_remote"),
+        now()
+    )
+    .is_err());
+    let one = membership("tenant_one", "id_alice", "conv_same");
+    let other = membership("tenant_two", "id_alice", "conv_same");
+    let appearance = SessionAppearance::admit(&one, SessionId::new(), None).unwrap();
+    assert!(appearance.require_current(&other).is_err());
+}
