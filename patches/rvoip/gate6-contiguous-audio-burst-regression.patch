+#[tokio::test]
+async fn guarded_mixer_contiguous_original_packets_remain_ordered_across_one_tick() {
+    // Source RTP uses its negotiated8kHz clock even when the mixer is48kHz.
+    // Include timestamp wrap; this is ordered original audio, not duplication.
+    for (rate, start) in [(8000, 0u32), (48000, 0), (48000, u32::MAX - 79)] {
+        let s = Scene::new(&four()[..2], rate).await;
+        s.bind(0, true).await;
+        s.bind(1, true).await;
+        let mut out = s.port(1).take_egress().unwrap();
+        let budget = s.controllers[0].stream_open_budget();
+        s.publish_at(0, 1000, start);
+        s.publish_at(0, 7000, start.wrapping_add(160));
+        s.mixer.tick();
+        heard_labeled(
+            out.try_recv().unwrap(),
+            1000,
+            "contiguous original audio frame was discarded by newer input",
+        )
+        .await;
+        drop(
+            s.policy
+                .0
+                .try_write()
+                .expect("queued original PCM retained authority"),
+        );
+        s.mixer.tick();
+        heard(out.try_recv().unwrap(), 7000).await;
+        s.mixer.tick();
+        assert!(
+            out.try_recv().is_err(),
+            "original PCM was emitted more than once"
+        );
+
+        s.publish_at(0, 2000, start.wrapping_add(320));
+        s.publish_at(0, 4000, start.wrapping_add(480));
+        s.mixer.tick();
+        heard(out.try_recv().unwrap(), 2000).await;
+        let c = &s.controllers[0];
+        let logical = desired(Medium::Audio).logical_id;
+        c.set_paused(&logical, c.revision(), true, deadline())
+            .await
+            .unwrap();
+        s.mixer.tick();
+        assert!(out.try_recv().is_err(), "queued PCM survived source pause");
+        c.set_paused(&logical, c.revision(), false, deadline())
+            .await
+            .unwrap();
+        s.mixer.tick();
+        assert!(
+            out.try_recv().is_err(),
+            "pre-pause PCM replayed after resume"
+        );
+        s.publish_at(0, 7000, start.wrapping_add(640));
+        s.mixer.tick();
+        heard(out.try_recv().unwrap(), 7000).await;
+        assert_eq!(budget, c.stream_open_budget());
+    }
+}
