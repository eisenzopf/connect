+            .preparation
+            .try_lock()
+            .map_err(|_| StreamControlError::MetadataBusy)?;
+        if slot.as_ref().cloned().is_some() {
+            return Err(StreamControlError::Authority);
+        }
+        // No public target programme may be installed before ownership moves.
+        if !target_gate
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::MetadataBusy)?
+            .program
+            .selections
+            .is_empty()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        control.valid()?;
+        target.check_credential_snapshot(&credential)?;
+        if !binding.is_current() || tokio::time::Instant::now() >= install_until {
+            return Err(StreamControlError::NotReady);
+        }
+        let sources = binding
+            .sources
+            .iter()
+            .map(|s| s.descriptor.clone())
+            .collect();
+        *slot = Some(binding.clone());
+        Ok(AudioReplacementPreparation { binding, sources })
+    }
