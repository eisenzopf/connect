+        .domain
+        .base
+        .0
+        .write()
+        .await
+        .owners
+        .insert("device".into(), first_owner);
+    tokio::time::sleep_until(first_until).await;
+    assert!(!first.is_current());
+    let source = {
+        let read = f.room.domain.base.0.read().await;
+        f.room
+            .domain
+            .resource_owner(&read, read.owners["device"].clone())
+            .unwrap()
+    };
+    let endpoint = endpoint_for(&source, "replacement-next");
+    let intent = ParticipantReplacementMutation {
+        operation_id: "device-replace-next".into(),
+        correlation_id: "corr-next".into(),
+        expected_revision: f.model.revision(),
+        participant: source.member.participant().clone(),
+        source: ConnectionId::from_string("device"),
+        replacement: ConnectionId::from_string("device-next"),
+        retained: ConnectionId::from_string("bob"),
+        endpoint: endpoint.endpoint().clone(),
+        device: endpoint.device().clone(),
+        confirmation: EndpointConfirmationPolicy::MediaOnly,
+    };
+    let pending = f
+        .model
+        .prepare_replacement(&source.member, &endpoint, intent)
+        .unwrap();
+    assert_eq!(pending.generation(), 3);
+    let mut owner = source.clone();
+    owner.endpoint = endpoint;
+    owner.connection = pending.binding().clone();
+    owner.presence = pending.appearance().clone();
+    f.room
+        .add_owned_with_media(
+            "device-next",
+            "alice",
+            owner,
+            true,
+            Some(pending),
+            vec![desired(Medium::Audio)],
+        )
+        .await;
+    let mut isolation = f
+        .room
+        .scene
+        .plan_audio_audience(AudioAudienceRequest {
+            operation_id: "device-next-isolated".into(),
+            expected_revision: f.room.scene.audience_revision(),
+            private_connections: BTreeSet::from([ConnectionId::from_string("device-next")]),
+            receivers: BTreeMap::from([(ConnectionId::from_string("device-next"), vec![])]),
+            activate_muted: Some(ConnectionId::from_string("device-next")),
+        })
+        .unwrap();
+    isolation
+        .keep_endpoint_muted(&ConnectionId::from_string("device-next"))
+        .unwrap();
+    f.room.apply(isolation).await.unwrap();
+    let old = &f.room.nodes["device"].controller;
+    let target = &f.room.nodes["device-next"].controller;
+    let grant = f
+        .room
+        .grant(Approval::PrepareAudio {
+            source: old.connection.clone(),
+            connection: target.connection.clone(),
+            expected: target.revision(),
+        })
+        .await;
+    let second = f
+        .room
+        .scene
+        .prepare_replacement_audio(
+            old,
+            target,
+            &PrivateVideoBindingLifetime::for_test(target, deadline(), CancellationToken::new()),
+            deadline(),
+            &grant,
+        )
+        .unwrap();
+    drop(grant);
+    assert_eq!(
+        second.sources()[0].connection,
+        ConnectionId::from_string("bob")
+    );
+    assert!(second.is_current());
+    assert!(
+        !second.has_delivered_remote_audio(),
+        "newgeneration cannot reuse previous originaldelivery"
+    );
+    drain_outputs(&mut f);
+    f.room.publish("bob", 7000).unwrap();
+    f.room.tick();
+    f.room.heard("device-next", 7000).await;
+    assert!(second.has_delivered_remote_audio());
+    f.room.heard("device", 7000).await;
+    assert!(!f.room.nodes["device"].controller.shutdown.is_cancelled());
+    assert!(f.room.publish("device-next", 12000).is_err());
+}
