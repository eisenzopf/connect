+//! Receiver-only copy of an original audio programme; never a public programme.
+use super::*;
+use crate::orchestrator::participant_control::replacement::PrivateVideoBindingLifetime;
+use crate::staged_streams::media_scene::GuardedMediaScene;
+
+struct AudioSource {
+    descriptor: MediaSource,
+    owner: Weak<StreamController>,
+    port: Weak<Port>,
+    ticket: PeerRouteTicket,
+}
+impl AudioSource {
+    fn current(&self) -> bool {
+        self.ticket.is_current()
+            && self.owner.upgrade().is_some_and(|owner| {
+                !owner.shutdown.is_cancelled()
+                    && self.port.upgrade().is_some_and(|port| {
+                        port.owner
+                            .upgrade()
+                            .is_some_and(|actual| Arc::ptr_eq(&actual, &owner))
+                            && port.binding.connection_generation
+                                == self.descriptor.connection_generation
+                            && port.binding.generation == self.descriptor.stream_generation
+                            && port.binding.transport_id == self.descriptor.transport_id
+                            && port.binding.negotiated.requested.logical_id
+                                == self.descriptor.logical_id
+                    })
+            })
+    }
+}
+pub(super) struct AudioPrerollBinding {
+    original: SubscriptionStamp,
+    old: Weak<StreamController>,
+    adopted: std::sync::atomic::AtomicBool,
+    delivered: std::sync::atomic::AtomicBool,
+    target: Weak<StreamController>,
+    target_port: Weak<Port>,
+    target_ticket: PeerRouteTicket,
+    target_subscription: SubscriptionStamp,
+    sources: Vec<AudioSource>,
+    pub(super) started: Instant,
+    pub(super) ticket: PeerRouteTicket,
+    pub(super) cancel: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl AudioPrerollBinding {
+    pub(super) fn adopted(&self) -> bool {
+        self.adopted.load(Ordering::Acquire)
+    }
+    pub(super) fn is_current(&self) -> bool {
+        !self.adopted.load(Ordering::Acquire)
+            && !self.cancel.is_cancelled()
+            && self.ticket.is_current()
+            && tokio::time::Instant::now() < self.deadline
+            && self.original.preparation.is_none()
+            && self.original.is_current()
+            && self.target_subscription.preparation.is_none()
+            && self.target_subscription.is_current()
+            && self.target_ticket.is_current()
+            && self.sources.iter().all(AudioSource::current)
+            && self.target.upgrade().is_some_and(|owner| {
+                !owner.shutdown.is_cancelled()
+                    && self.target_port.upgrade().is_some_and(|p| {
+                        p.owner
+                            .upgrade()
+                            .is_some_and(|actual| Arc::ptr_eq(&owner, &actual))
+                    })
+            })
+    }
+    pub(super) fn begin(
+        &self,
+        source: &StreamController,
+        logical: &StreamId,
+    ) -> ControlResult<SubscriptionDelivery> {
+        if !self.is_current()
+            || !self.sources.iter().any(|s| {
+                &s.descriptor.logical_id == logical
+                    && s.owner
+                        .upgrade()
+                        .is_some_and(|owner| std::ptr::eq(owner.as_ref(), source))
+            })
+        {
+            return Err(StreamControlError::Authority);
+        }
+        // Preserve BOTH the original full programme+audience decision and its
+        // delivery fence, and this exact target's ordinary generation fence.
+        // Only its closed audience exclusion is bypassed by the sealed branch.
+        let mut held = self.original.begin(source, logical)?;
+        held._target = Some(
+            self.target_subscription
+                .ticket
+                .try_begin_delivery()
+                .ok_or(StreamControlError::NotReady)?,
+        );
+        if !self.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        Ok(held)
+    }
+    fn permits(&self, source: &MediaSource) -> bool {
+        self.is_current()
+            && self
+                .sources
+                .iter()
+                .any(|s| same_source(&s.descriptor, source))
+    }
+}
+fn same_source(a: &MediaSource, b: &MediaSource) -> bool {
+    a.conversation == b.conversation
+        && a.session == b.session
+        && a.connection == b.connection
+        && a.participant == b.participant
+        && a.membership_epoch == b.membership_epoch
+        && a.connection_generation == b.connection_generation
+        && a.logical_id == b.logical_id
+        && a.transport_id == b.transport_id
+        && a.stream_generation == b.stream_generation
+}
+/// Structural ownership only. Every actual packet still reacquires source and
+/// receiver grants; this original selection metadata is never a cached grant.
+pub enum AudioReplacementPreparationAttempt {
+    MetadataBusy { deadline: tokio::time::Instant },
+    Prepared(AudioReplacementPreparation),
+}
+pub struct AudioReplacementPreparation {
+    binding: Arc<AudioPrerollBinding>,
+    sources: Vec<MediaSource>,
+}
+impl AudioReplacementPreparation {
+    pub fn sources(&self) -> &[MediaSource] {
+        &self.sources
+    }
+    pub fn is_current(&self) -> bool {
+        self.binding.is_current()
+    }
+    /// Historical successful remote IO on this same structurally live route.
+    /// It only stops neutral probes, never grants permission or readiness.
+    pub fn has_delivered_remote_audio(&self) -> bool {
+        self.binding.is_current() && self.binding.delivered.load(Ordering::Acquire)
+    }
+    pub fn permits(&self, source: &MediaSource) -> bool {
+        self.binding.permits(source)
+    }
+    pub fn close(&self) {
+        self.binding.cancel.cancel();
+        self.binding.ticket.retire_if_current();
+        // Keep the sealed cancelled metadata in the gate until actual same-root
+        // adoption or physical target teardown. It owns no grants, ports, Core
+        // root or controller; dropping preparation cannot select ordinary mode.
+    }
+}
+impl Drop for AudioReplacementPreparation {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+impl GuardedMediaScene {
+    pub(crate) fn prepare_replacement_audio(
+        &self,
+        old: &Arc<StreamController>,
+        target: &Arc<StreamController>,
+        lifetime: &PrivateVideoBindingLifetime,
+        installation_deadline: tokio::time::Instant,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<AudioReplacementPreparation> {
+        if Arc::ptr_eq(old, target)
+            || old.conversation != target.conversation
+            || old.session != target.session
+            || old.origin_member.participant() != target.origin_member.participant()
+            || old.origin_member.identity() != target.origin_member.identity()
+            || old.origin_member.epoch() != target.origin_member.epoch()
+            || target.origin_binding.replaces() != Some(&old.connection)
+            || old.origin_binding.generation().checked_add(1)
+                != Some(target.origin_binding.generation())
+            || !Arc::ptr_eq(&old.policy, &target.policy)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let (deadline, cancel) = lifetime.metadata_for(target)?;
+        let expected = target.revision();
+        let credential = target.credential_snapshot();
+        let scope = target.scope(&credential.principal, MediaPurpose::Control);
+        let control = target.policy.current_control(
+            &scope,
+            &MediaControlIntent::PrepareReplacementAudio {
+                source: &old.connection,
+                expected,
+            },
+            held,
+        )?;
+        let install_until = deadline.min(installation_deadline).min(control.deadline);
+        control.valid()?;
+        let owner = control.authority()?;
+        StreamController::check(&scope, &owner)?;
+        if !owner.may_control || !owner.send_media.contains(&Medium::Audio) {
+            return Err(StreamControlError::Authority);
+        }
+        let members = self
+            .members
+            .try_lock()
+            .map_err(|_| StreamControlError::MetadataBusy)?;
+        let old_member = members
+            .get(&old.connection)
+            .filter(|m| Arc::ptr_eq(&m.controller, old))
+            .ok_or(StreamControlError::Authority)?;
+        let target_member = members
+            .get(&target.connection)
+            .filter(|m| Arc::ptr_eq(&m.controller, target))
+            .ok_or(StreamControlError::Authority)?;
+        let original = old_member.audio_consumer.subscriptions.stamp();
+        if original.preparation.is_some()
+            || old_member
+                .audio_consumer
+                .subscriptions
+                .preparation
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .cloned()
+                .is_some_and(|p| !p.adopted())
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let target_gate = &target_member.audio_consumer.subscriptions;
+        let target_subscription = target_gate.stamp();
+        let target_port = {
+            let state = target
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::MetadataBusy)?;
+            if state.closed || state.model.revision() != expected {
+                return Err(StreamControlError::NotReady);
+            }
+            state.model.authorize_binding(&owner.current())?;
+            let logical = target_member
+                .current_logical()
+                .ok_or(StreamControlError::NotReady)?;
+            let stream = state
+                .model
+                .streams()
+                .get(&logical)
+                .ok_or(StreamControlError::NotReady)?;
+            if !stream.source_muted
+                || stream.negotiated.requested.medium != Medium::Audio
+                || stream.negotiated.requested.direction == StreamDirection::Receive
+            {
+                return Err(StreamControlError::Authority);
+            }
+            state
+                .active
+                .get(&logical)
+                .cloned()
+                .ok_or(StreamControlError::NotReady)?
+        };
+        // Snapshot only actual currently selected originals, including the old
+        // programme's audience rules. No all-scene source widening or chaining.
+        let (program, rules) = {
+            let state = old_member
+                .audio_consumer
+                .subscriptions
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::MetadataBusy)?;
+            if !original.is_current() {
+                return Err(StreamControlError::NotReady);
+            }
+            (state.program.clone(), state.rules.clone())
+        };
+        let mut sources = Vec::new();
+        for member in members.values() {
+            if member.controller.origin_member.participant() == target.origin_member.participant() {
+                continue;
+            }
+            let state = member
+                .controller
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::MetadataBusy)?;
+            let Some(descriptor) = member.current_descriptor(&state, true)? else {
+                continue;
+            };
+            if !program.allows(&member.controller, &descriptor.logical_id)
+                || rules.iter().any(|r| !r.allows(&member.controller))
+            {
+                continue;
+            }
+            let source_port = state
+                .active
+                .get(&descriptor.logical_id)
+                .ok_or(StreamControlError::NotReady)?;
+            let _selected = original.begin(&member.controller, &descriptor.logical_id)?;
+            control.valid()?;
+            let receive = control.lease.control_receive(&descriptor)?;
+            StreamController::check(&scope, &receive)?;
+            if !receive.may_route_source || !receive.send_media.contains(&Medium::Audio) {
+                return Err(StreamControlError::Authority);
+            }
+            sources.push(AudioSource {
+                descriptor,
+                owner: Arc::downgrade(&member.controller),
+                port: Arc::downgrade(source_port),
+                ticket: source_port.ticket(),
+            });
+        }
+        let binding = Arc::new(AudioPrerollBinding {
+            original,
+            old: Arc::downgrade(old),
+            adopted: std::sync::atomic::AtomicBool::new(false),
+            delivered: std::sync::atomic::AtomicBool::new(false),
+            target: Arc::downgrade(target),
+            target_port: Arc::downgrade(&target_port),
+            target_ticket: target_port.ticket(),
+            target_subscription,
+            sources,
+            started: Instant::now(),
+            ticket: PeerRouteTicket::initial(),
+            cancel,
+            deadline,
+        });
