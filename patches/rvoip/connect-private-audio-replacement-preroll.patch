+/// Captured before any model/programme publication. This structural marker is
+/// not an authorization lease; actual publication already holds those grants.
+pub(in crate::staged_streams) struct AudioAdoption(Arc<AudioPrerollBinding>);
+impl AudioAdoption {
+    pub(in crate::staged_streams) fn commit(self) {
+        self.0.adopted.store(true, Ordering::Release);
+        self.0.cancel.cancel();
+        self.0.ticket.retire_if_current();
+    }
+}
+impl SubscriptionGate {
+    pub(in crate::staged_streams) fn prepare_audio_adoption(
+        &self,
+        old: &Arc<StreamController>,
+        target: &Arc<StreamController>,
+        pending: &crate::participant_transitions::PreparedParticipantReplacement,
+    ) -> ControlResult<Option<AudioAdoption>> {
+        let slot = self
+            .preparation
+            .try_lock()
+            .map_err(|_| StreamControlError::MetadataBusy)?;
+        let Some(binding) = slot.as_ref().cloned() else {
+            return Ok(None);
+        };
+        if !binding.is_current()
+            || binding
+                .old
+                .upgrade()
+                .is_none_or(|actual| !Arc::ptr_eq(&actual, old))
+            || binding
+                .target
+                .upgrade()
+                .is_none_or(|actual| !Arc::ptr_eq(&actual, target))
+            || !old
+                .origin_binding
+                .same_incarnation(pending.source_binding())
+            || !target.is_bound_to_replacement(pending)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(Some(AudioAdoption(binding)))
+    }
+    #[cfg(test)]
+    pub(in crate::staged_streams) fn private_mode_for_test(&self) -> bool {
+        self.preparation
+            .lock()
+            .unwrap()
+            .as_ref()
+            .is_some_and(|p| !p.adopted())
+    }
+    #[cfg(test)]
+    pub(in crate::staged_streams) fn ordinary_program_is_empty_for_test(&self) -> bool {
+        let state = self.state.lock().unwrap();
+        state.program.selections.is_empty() && state.program.excluded.is_empty()
+    }
+}
+
+impl SubscriptionStamp {
+    /// Only the existing actual guarded AudioConsumer writer completion calls
+    /// this; local-probe ordinary stamps have no private binding to mark.
+    pub(in crate::staged_streams) fn observed_remote_delivery(&self) {
+        if self.is_current() {
+            if let Some(binding) = &self.preparation {
+                binding.delivered.store(true, Ordering::Release);
+            }
+        }
+    }
+}
