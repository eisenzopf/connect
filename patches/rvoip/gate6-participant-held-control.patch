+/// Owned current grant for one control invocation, never a mixer/media grant.
+/// The policy rederives exact current facts under this same retained guard.
+pub trait ParticipantControlLease: Send + Sync {
+    fn current(&self, scope: &ParticipantScope<'_>) -> ControlResult<ParticipantAuthority>;
+}
+pub struct ParticipantControl {
+    lease: Box<dyn ParticipantControlLease>,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl ParticipantControl {
+    pub fn new(
+        lease: Box<dyn ParticipantControlLease>,
+        cancellation: CancellationToken,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<Self> {
+        let value = Self {
+            lease,
+            cancellation,
+            deadline: deadline.min(tokio::time::Instant::now() + Duration::from_secs(30)),
+        };
+        value.check()?;
+        Ok(value)
+    }
+    fn check(&self) -> ControlResult<()> {
+        if self.cancellation.is_cancelled() {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(ParticipantControlError::Deadline);
+        }
+        Ok(())
+    }
+    fn current(&self, scope: &ParticipantScope<'_>) -> ControlResult<ParticipantAuthority> {
+        self.check()?;
+        let authority = self.lease.current(scope)?;
+        self.check()?;
+        Ok(authority)
+    }
+}
+enum ControlRead<'a> {
+    Current(Box<dyn ParticipantAuthorityLease + 'a>),
+    Held(ParticipantAuthority),
+}
+impl ControlRead<'_> {
+    fn authority(&self) -> &ParticipantAuthority {
+        match self {
+            Self::Current(lease) => lease.authority(),
+            Self::Held(authority) => authority,
+        }
+    }
+}
+fn control_read<'a>(
+    policy: &'a dyn ParticipantPolicy,
+    scope: &ParticipantScope<'_>,
+    held: Option<&ParticipantControl>,
+) -> ControlResult<ControlRead<'a>> {
+    match held {
+        Some(control) => Ok(ControlRead::Held(control.current(scope)?)),
+        None => Ok(ControlRead::Current(policy.current(scope)?)),
+    }
+}
+fn principal_expiry(principal: &AuthenticatedPrincipal) -> Option<chrono::DateTime<Utc>> {
+    match &principal.assurance {
+        crate::identity::IdentityAssurance::TaskScoped { expires_at, .. } => Some(
+            principal
+                .expires_at
+                .map_or(*expires_at, |expiry| expiry.min(*expires_at)),
+        ),
+        _ => principal.expires_at,
+    }
+}
+fn invocation_current(
+    cancellation: &CancellationToken,
+    control: Option<&ParticipantControl>,
+    peer: Option<&CancellationToken>,
+    deadline: tokio::time::Instant,
+) -> ControlResult<()> {
+    if cancellation.is_cancelled() || peer.is_some_and(|p| p.is_cancelled()) {
+        return Err(ParticipantControlError::Cancelled);
+    }
+    if let Some(control) = control {
+        control.check()?;
+    }
+    if tokio::time::Instant::now() >= deadline {
+        return Err(ParticipantControlError::Deadline);
+    }
+    Ok(())
 }
 
