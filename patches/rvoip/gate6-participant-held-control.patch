+        let revision = f.base.orch.participant_revision(&f.session).unwrap();
+        let (id, stream) = f.base.connection("alice", false).await;
+        let mut context = f
+            .context(
+                f.mutation(
+                    "alice",
+                    "held-final-current",
+                    ParticipantChange::Admit {
+                        connection: id,
+                        role_override: None,
+                    },
+                ),
+                principal("owner"),
+            )
+            .await;
+        context.cancel_at_commit = cancel;
+        let owner = f.base.orch.clone();
+        let sid = f.session.clone();
+        let task = tokio::spawn(async move {
+            owner
+                .change_session_participant_with_held(
+                    &sid,
+                    context.principal.clone(),
+                    context.mutation.clone(),
+                    tokio::time::Instant::now() + Duration::from_secs(2),
