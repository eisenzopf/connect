+        let policy = Arc::new(Policy {
+            id: uuid::Uuid::new_v4(),
+            facts: base.policy.clone(),
+            grant: Arc::new(RwLock::new(true)),
+            standalone: AtomicUsize::new(0),
+        });
+        base.orch
+            .enable_participant_control(&session, policy.clone(), ParticipantLimits::default())
+            .unwrap();
+        Self {
+            base,
+            session,
+            policy,
+        }
+    }
+    async fn context(
+        &self,
+        mutation: ParticipantMutation,
+        principal: AuthenticatedPrincipal,
+    ) -> Context {
+        Context {
+            domain: self.policy.id,
+            session: self.session.clone(),
+            conversation: self.base.conversation.clone(),
+            principal,
+            mutation,
+            grant: Arc::new(self.policy.grant.clone().read_owned().await),
+            cancellation: CancellationToken::new(),
+            deadline: tokio::time::Instant::now() + Duration::from_secs(5),
+            cancel_at_commit: false,
+        }
+    }
+    fn mutation(&self, name: &str, id: &str, change: ParticipantChange) -> ParticipantMutation {
+        self.base.intent(&self.session, name, id, change)
+    }
+    async fn apply(&self, context: &Context) -> ControlResult<ParticipantObservation> {
+        self.base
+            .orch
+            .change_session_participant_with_held(
+                &self.session,
+                context.principal.clone(),
+                context.mutation.clone(),
+                tokio::time::Instant::now() + Duration::from_secs(2),
+                CancellationToken::new(),
+                context,
+            )
+            .await
+    }
+    async fn join(&self, name: &str) -> (ConnectionId, Arc<fixture::TestStream>) {
+        let (id, stream) = self.base.connection(name, true).await;
+        let context = self
+            .context(
+                self.mutation(
+                    name,
+                    &format!("held-join-{name}"),
+                    ParticipantChange::Admit {
+                        connection: id.clone(),
+                        role_override: None,
+                    },
+                ),
+                principal("owner"),
+            )
+            .await;
+        self.apply(&context).await.unwrap();
+        (id, stream)
+    }
+}
+#[tokio::test]
+async fn held_participant_admission_role_departure_progress_behind_real_writer_and_preserve_audio()
+{
+    let f = HeldFixture::new().await;
+    let (alice, audio) = f.base.connection("alice", true).await;
+    let context = f
+        .context(
+            f.mutation(
+                "alice",
+                "held-writer",
+                ParticipantChange::Admit {
+                    connection: alice,
+                    role_override: None,
+                },
+            ),
+            principal("owner"),
+        )
+        .await;
+    let gate = f.policy.grant.clone();
+    let writer = tokio::spawn(async move {
+        let _guard = gate.write_owned().await;
+    });
+    until(|| f.policy.grant.try_read().is_err()).await;
+    tokio::time::timeout(Duration::from_secs(1), f.apply(&context))
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        !writer.is_finished(),
+        "caller still owns proof through delivery"
+    );
+    assert_eq!(f.policy.standalone.load(Ordering::Acquire), 0);
+    drop(context);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    let (_, bob) = f.join("bob").await;
+    let (stop, tone) = audio.continuous_tone();
+    bob.assert_receives_audio().await;
+    f.join("carol").await;
+    bob.assert_receives_audio().await;
+    let role = f
+        .context(
+            f.mutation(
+                "carol",
+                "held-role",
+                ParticipantChange::SetSessionRole {
+                    role: ParticipantRole::Observer,
+                },
+            ),
+            principal("owner"),
+        )
+        .await;
+    f.apply(&role).await.unwrap();
+    drop(role);
+    let leave = f
+        .context(
+            f.mutation(
+                "carol",
+                "held-leave",
+                ParticipantChange::Depart {
+                    cause: DepartureCause::Left,
+                },
+            ),
+            principal("owner"),
+        )
+        .await;
+    f.apply(&leave).await.unwrap();
+    drop(leave);
+    bob.assert_receives_audio().await;
+    assert_eq!(
+        f.base.orch.participant_capacity(&f.session).unwrap(),
+        (2, 0)
+    );
+    assert_eq!(
+        f.base
+            .orch
+            .session(&f.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .state,
+        SessionState::Active
+    );
+    assert_eq!(f.policy.standalone.load(Ordering::Acquire), 0);
+    stop.cancel();
+    tone.await.unwrap();
+}
