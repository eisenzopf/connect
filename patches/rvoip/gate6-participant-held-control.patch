+async fn held_participant_unknown_foreign_or_changed_context_never_falls_back_or_prepares() {
+    let f = HeldFixture::new().await;
+    let (id, _) = f.base.connection("alice", true).await;
+    let mutation = f.mutation(
+        "alice",
+        "held-bound",
+        ParticipantChange::Admit {
+            connection: id,
+            role_override: None,
+        },
+    );
+    let context = f.context(mutation.clone(), principal("owner")).await;
+    for mode in 0..5 {
+        let mut changed = context.clone();
+        match mode {
+            0 => changed.domain = uuid::Uuid::new_v4(),
+            1 => changed.session = SessionId::new(),
+            2 => changed.mutation.expected_revision += 1,
+            3 => changed.mutation.operation_id = "other".into(),
+            _ => changed.principal.subject = "alice".into(),
+        }
+        assert!(matches!(
+            f.base
+                .orch
+                .change_session_participant_with_held(
+                    &f.session,
+                    principal("owner"),
+                    mutation.clone(),
+                    tokio::time::Instant::now() + Duration::from_secs(1),
+                    CancellationToken::new(),
+                    &changed
+                )
+                .await,
+            Err(ParticipantControlError::Authority)
+        ));
+    }
+    assert!(matches!(
+        f.base
+            .orch
+            .change_session_participant_with_held(
+                &f.session,
+                principal("owner"),
+                mutation.clone(),
+                tokio::time::Instant::now() + Duration::from_secs(1),
+                CancellationToken::new(),
+                &()
+            )
+            .await,
+        Err(ParticipantControlError::Unsupported)
+    ));
+    // Existing policies must explicitly opt in; no standalone read fallback.
+    assert!(matches!(
+        f.base
+            .orch
+            .change_session_participant_with_held(
+                &f.base.session,
+                principal("owner"),
+                mutation,
+                tokio::time::Instant::now() + Duration::from_secs(1),
+                CancellationToken::new(),
+                &context
+            )
+            .await,
+        Err(ParticipantControlError::Unsupported)
+    ));
+    assert_eq!(f.base.adapter.accepted.load(Ordering::Acquire), 0);
+    assert_eq!(
+        f.base.orch.participant_capacity(&f.session).unwrap(),
+        (0, 0)
+    );
+    assert_eq!(f.policy.standalone.load(Ordering::Acquire), 0);
+}
+#[tokio::test]
+async fn held_participant_cancel_and_future_drop_release_candidate_and_current_grant() {
+    let f = HeldFixture::new().await;
+    let (_, audio) = f.join("alice").await;
+    let (_, bob) = f.join("bob").await;
+    let (stop, tone) = audio.continuous_tone();
+    bob.assert_receives_audio().await;
+    for (name, abort) in [("carol", false), ("dave", true)] {
+        let (id, _) = f.base.connection(name, false).await;
+        let context = f
+            .context(
+                f.mutation(
+                    name,
+                    &format!("held-cancel-{name}"),
+                    ParticipantChange::Admit {
+                        connection: id.clone(),
+                        role_override: None,
+                    },
+                ),
+                principal("owner"),
+            )
+            .await;
+        let cancel = context.cancellation.clone();
+        let owner = f.base.orch.clone();
+        let sid = f.session.clone();
+        let task = tokio::spawn(async move {
+            owner
+                .change_session_participant_with_held(
+                    &sid,
+                    context.principal.clone(),
+                    context.mutation.clone(),
+                    tokio::time::Instant::now() + Duration::from_secs(2),
+                    CancellationToken::new(),
+                    &context,
+                )
+                .await
+        });
+        until(|| f.base.orch.participant_capacity(&f.session).unwrap() == (2, 1)).await;
+        let gate = f.policy.grant.clone();
+        let writer = tokio::spawn(async move {
+            let _guard = gate.write_owned().await;
+        });
+        until(|| f.policy.grant.try_read().is_err()).await;
+        if abort {
+            task.abort();
+            assert!(task.await.unwrap_err().is_cancelled());
+        } else {
+            cancel.cancel();
+            assert!(matches!(
+                task.await.unwrap(),
+                Err(ParticipantControlError::Cancelled)
+            ));
+        }
+        tokio::time::timeout(Duration::from_secs(1), writer)
+            .await
+            .unwrap()
+            .unwrap();
+        until(|| f.base.orch.participant_capacity(&f.session).unwrap() == (2, 0)).await;
+        assert!(!f
+            .base
+            .orch
+            .session(&f.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .connections
+            .contains_key(&id));
+        bob.assert_receives_audio().await;
+    }
+    stop.cancel();
+    tone.await.unwrap();
+}
+#[tokio::test]
+async fn held_participant_original_credential_and_task_expiry_bound_preparation() {
+    for task_expiry in [false, true] {
+        let f = HeldFixture::new().await;
+        let (id, _) = f.base.connection("alice", false).await;
+        let mut actor = principal("owner");
+        let expiry = Utc::now() + chrono::Duration::milliseconds(90);
+        if task_expiry {
+            actor.expires_at = Some(Utc::now() + chrono::Duration::seconds(20));
+            actor.assurance = crate::identity::IdentityAssurance::TaskScoped {
+                identity: IdentityId::from_string("id_owner"),
+                task_id: "held-task".into(),
+                scopes: actor.scopes.clone(),
+                expires_at: expiry,
+            };
+        } else {
+            actor.expires_at = Some(expiry);
+        }
+        let context = f
+            .context(
+                f.mutation(
+                    "alice",
+                    "held-expiry",
+                    ParticipantChange::Admit {
+                        connection: id,
+                        role_override: None,
+                    },
+                ),
+                actor,
+            )
+            .await;
+        assert!(Utc::now() < expiry);
+        let result = tokio::time::timeout(Duration::from_millis(700), f.apply(&context))
+            .await
+            .unwrap();
+        assert!(
+            matches!(
+                result,
+                Err(ParticipantControlError::Deadline) | Err(ParticipantControlError::Authority)
+            ),
+            "{result:?}"
+        );
+        assert_eq!(
+            f.base.orch.participant_capacity(&f.session).unwrap(),
+            (0, 0)
+        );
+        assert!(f
+            .base
+            .orch
+            .session(&f.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .participants
+            .is_empty());
+    }
+}
+#[tokio::test]
+async fn held_participant_cancellation_and_deadline_bound_mixer_wait_before_role_commit() {
+    let f = HeldFixture::new().await;
+    f.join("alice").await;
+    let revision = f.base.orch.participant_revision(&f.session).unwrap();
+    for deadline in [false, true] {
+        let mut context = f
+            .context(
+                f.mutation(
+                    "alice",
+                    if deadline {
+                        "held-mixer-deadline"
+                    } else {
+                        "held-mixer-cancel"
+                    },
+                    ParticipantChange::SetSessionRole {
+                        role: ParticipantRole::Observer,
+                    },
+                ),
+                principal("owner"),
+            )
+            .await;
+        if deadline {
+            context.deadline = tokio::time::Instant::now() + Duration::from_millis(75);
+        }
+        let runtime = f.base.orch.participant_runtime(&f.session).unwrap();
+        let mixer = runtime.mixer.members.clone().lock_owned().await;
+        let cancel = context.cancellation.clone();
+        let owner = f.base.orch.clone();
+        let sid = f.session.clone();
+        let task = tokio::spawn(async move {
+            owner
+                .change_session_participant_with_held(
+                    &sid,
+                    context.principal.clone(),
+                    context.mutation.clone(),
+                    tokio::time::Instant::now() + Duration::from_secs(2),
+                    CancellationToken::new(),
+                    &context,
+                )
+                .await
+        });
+        if !deadline {
+            tokio::time::sleep(Duration::from_millis(25)).await;
+            cancel.cancel();
+        }
+        let result = tokio::time::timeout(Duration::from_millis(600), task)
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            result,
+            Err(ParticipantControlError::Cancelled) | Err(ParticipantControlError::Deadline)
+        ));
+        assert_eq!(
+            f.base
+                .orch
+                .participant_session_role(&f.session, &participant("alice"))
+                .unwrap(),
+            Some(ParticipantRole::Agent)
+        );
+        assert_eq!(
+            f.base.orch.participant_revision(&f.session).unwrap(),
+            revision
+        );
+        drop(mixer);
+    }
+}
