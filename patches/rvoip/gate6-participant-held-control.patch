+use super::*;
+#[allow(dead_code)]
+#[path = "../../../tests/support/participant_control_fixture.rs"]
+mod fixture;
+use crate::ids::IdentityId;
+use crate::participant_transitions::DepartureCause;
+use fixture::{participant, principal, until, Fixture, TestPolicy};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use tokio::sync::{OwnedRwLockReadGuard, RwLock};
+
+struct Policy {
+    id: uuid::Uuid,
+    facts: Arc<TestPolicy>,
+    grant: Arc<RwLock<bool>>,
+    standalone: AtomicUsize,
+}
+#[derive(Clone)]
+struct Context {
+    domain: uuid::Uuid,
+    session: SessionId,
+    conversation: ConversationId,
+    principal: AuthenticatedPrincipal,
+    mutation: ParticipantMutation,
+    grant: Arc<OwnedRwLockReadGuard<bool>>,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+    cancel_at_commit: bool,
+}
+fn same_invocation(context: &Context, scope: &ParticipantScope<'_>) -> bool {
+    context.session == *scope.session
+        && context.conversation == *scope.conversation
+        && context.principal.ownership_key() == scope.principal.ownership_key()
+        && context.principal.expires_at == scope.principal.expires_at
+        && context.principal.scopes == scope.principal.scopes
+        && principal_expiry(&context.principal) == principal_expiry(scope.principal)
+        && context.principal.method == scope.principal.method
+        && context.mutation.operation_id == scope.mutation.operation_id
+        && context.mutation.correlation_id == scope.mutation.correlation_id
+        && context.mutation.expected_revision == scope.mutation.expected_revision
+        && context.mutation.participant == scope.mutation.participant
+        && context.mutation.change == scope.mutation.change
+}
+fn facts(policy: &TestPolicy, scope: &ParticipantScope<'_>) -> ControlResult<ParticipantAuthority> {
+    // Relationship/readiness facts have a separate short mutex; the real
+    // current grant is retained by Context and never reacquired here.
+    let lease = policy.current(scope)?;
+    let value = lease.authority();
+    Ok(ParticipantAuthority {
+        actor: value.actor.clone(),
+        target: value.target.clone(),
+        endpoint: value.endpoint.clone(),
+        may_send_audio: value.may_send_audio,
+        may_receive_audio: value.may_receive_audio,
+        confirmation_required: value.confirmation_required,
+        confirmed_generation: value.confirmed_generation,
+    })
+}
+struct Lease {
+    context: Context,
+    facts: Arc<TestPolicy>,
+}
+impl ParticipantControlLease for Lease {
+    fn current(&self, scope: &ParticipantScope<'_>) -> ControlResult<ParticipantAuthority> {
+        if !same_invocation(&self.context, scope) || !**self.context.grant {
+            return Err(ParticipantControlError::Authority);
+        }
+        let value = facts(&self.facts, scope)?;
+        if scope.connection_generation.is_some() && self.context.cancel_at_commit {
+            self.context.cancellation.cancel();
+        }
+        Ok(value)
+    }
+}
+struct Ordinary {
+    _grant: OwnedRwLockReadGuard<bool>,
+    authority: ParticipantAuthority,
+}
+impl ParticipantAuthorityLease for Ordinary {
+    fn authority(&self) -> &ParticipantAuthority {
+        &self.authority
+    }
+}
+impl ParticipantPolicy for Policy {
+    fn current(
+        &self,
+        scope: &ParticipantScope<'_>,
+    ) -> ControlResult<Box<dyn ParticipantAuthorityLease + '_>> {
+        self.standalone.fetch_add(1, Ordering::AcqRel);
+        let grant = self
+            .grant
+            .clone()
+            .try_read_owned()
+            .map_err(|_| ParticipantControlError::Authority)?;
+        if !*grant {
+            return Err(ParticipantControlError::Authority);
+        }
+        Ok(Box::new(Ordinary {
+            _grant: grant,
+            authority: facts(&self.facts, scope)?,
+        }))
+    }
+    fn current_control(
+        &self,
+        scope: &ParticipantScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<ParticipantControl> {
+        let context = held
+            .downcast_ref::<Context>()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        if context.domain != self.id || !same_invocation(context, scope) || !**context.grant {
+            return Err(ParticipantControlError::Authority);
+        }
+        ParticipantControl::new(
+            Box::new(Lease {
+                context: context.clone(),
+                facts: self.facts.clone(),
+            }),
+            context.cancellation.clone(),
+            context.deadline,
+        )
+    }
+}
+struct HeldFixture {
