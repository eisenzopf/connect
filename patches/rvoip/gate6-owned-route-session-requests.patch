+#[tokio::test]
+async fn session_decisions_require_exact_original_waiter_without_connection_or_command_execution() {
+    for kind in ["session.accept", "session.reject"] {
+        let kp = keypair();
+        let peer = peer(&kp, Arc::new(Policy::default()));
+        let handler = Handler::default();
+        let request = session_invite();
+        let ticket = peer.register_reply(&request, deadline()).unwrap();
+        for field in [
+            "cid",
+            "sid",
+            "operation_id",
+            "in_reply_to",
+            "connid",
+            "family",
+        ] {
+            let mut invalid = session_decision(&request, kind);
+            if field == "family" {
+                invalid["type"] = json!("session.cancel");
+                invalid["payload"] =
+                    json!({"by":"invitee","reason_code":487,"reason":"request-cancelled"});
+            } else {
+                invalid[field] = json!("wrong");
+            }
+            assert!(
+                peer.dispatch(&signed(invalid, &kp), &handler, deadline())
+                    .await
+                    .is_err(),
+                "{kind}/{field}"
+            );
+            assert_eq!(peer.pending_count(), 1);
+            assert_eq!(handler.calls.load(Ordering::SeqCst), 0);
+        }
+        let valid = session_decision(&request, kind);
+        assert!(matches!(
+            peer.dispatch(&signed(valid, &kp), &handler, deadline())
+                .await
+                .unwrap(),
+            DispatchOutcome::ReplyDelivered
+        ));
+        assert_eq!(ticket.wait().await.unwrap().kind(), kind);
+        assert_eq!(peer.pending_count(), 0);
