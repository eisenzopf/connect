+            let (tx, rx) = host.accept_bi().await.unwrap();
+            peer.run(rx, tx, server_handler.as_ref()).await
+        });
+        let (tx, rx) = remote.open_bi().await.unwrap();
+        let mut writer = FramedWrite::new(tx, rvoip_uctp::substrate::length_prefixed_codec());
+        let mut reader = FramedRead::new(rx, rvoip_uctp::substrate::length_prefixed_codec());
+        writer
+            .send(Bytes::from(serde_json::to_vec(&hello()).unwrap()))
+            .await
+            .unwrap();
+        let challenge = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+        writer
+            .send(Bytes::from(f.sign(response(&challenge, "old"))))
+            .await
+            .unwrap();
+        let session = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+        assert_eq!(session.kind(), "auth.session");
+        let handle = current(&registry).remove(0);
+        let original = invitation();
+        let template_id = original.id().to_owned();
+        let request = tokio::spawn(async move { handle.request(original, deadline()).await });
+        let received = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+        f.verify_server(&received).await;
+        assert_eq!(received.kind(), "session.invite");
+        assert_ne!(received.id(), template_id);
+        assert!(received.scope(Scope::Connection).is_none());
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        // The actual metadata write has finished; an arbitrary human/answer
+        // delay must not retain the old current-authority read lease.
+        assert!(f.policy.revoked.try_write().is_ok());
+        writer
+            .send(Bytes::from(f.sign(invitation_reply(&received, kind))))
+            .await
+            .unwrap();
+        let observed = request.await.unwrap().unwrap();
+        assert!(observed.current());
+        assert_eq!(observed.request_id().as_str(), received.id());
+        assert_eq!(observed.envelope().kind(), kind);
+        assert_eq!(observed.identity().as_str(), "identity-alice");
+        assert_eq!(observed.device().id.as_str(), "device-alice");
+        assert_eq!(observed.credential().token_id.as_deref(), Some("old"));
+        assert_eq!(handler.calls.load(Ordering::SeqCst), 0);
+        writer.close().await.unwrap();
+        assert!(server.await.unwrap().is_ok());
+        assert!(!observed.current());
+        drop(host_lifetime);
+    }
+}
+#[tokio::test]
+async fn invitation_request_deadline_and_credential_rotation_cannot_adopt_an_old_waiter() {
+    for rotate in [false, true] {
+        let f = Fixture::new();
+        let registry = ReachabilityRegistry::new(8).unwrap();
+        let policy = RoutePolicy::new(f.policy.clone());
+        let mut peer = routed_peer(&f, registry.clone(), policy, 5);
+        f.authenticate(&mut peer, "old").await;
+        let handle = current(&registry).remove(0);
+        let (a, b) = tokio::io::duplex(8192);
+        let (rd, wr) = tokio::io::split(a);
+        let (crd, cwr) = tokio::io::split(b);
+        let server = tokio::spawn(async move { peer.run(rd, wr, &Handler::default()).await });
+        let mut reader = FramedRead::new(crd, rvoip_uctp::substrate::length_prefixed_codec());
+        let mut writer = FramedWrite::new(cwr, rvoip_uctp::substrate::length_prefixed_codec());
+        let original = invitation();
+        let request = tokio::spawn(async move {
+            handle
+                .request(
+                    original,
+                    Instant::now() + Duration::from_millis(if rotate { 1000 } else { 80 }),
+                )
+                .await
+        });
+        let received = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+        if rotate {
+            writer
+                .send(Bytes::from(f.sign(envelope(
+                    "auth.refresh",
+                    json!({"method":"bearer","credential":"new"}),
+                ))))
+                .await
+                .unwrap();
+            let session = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+            assert_eq!(session.kind(), "auth.session");
+        }
+        assert!(matches!(request.await.unwrap(), Err(DispatchError::Closed)));
+        writer
+            .send(Bytes::from(
+                f.sign(invitation_reply(&received, "session.accept")),
+            ))
+            .await
+            .unwrap();
+        let refused = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+        assert_eq!(refused.kind(), "error");
+        writer.close().await.unwrap();
+        assert!(server.await.unwrap().is_ok());
+    }
+}
