+fn session_decision(request: &Envelope, kind: &str) -> Value {
+    let payload = if kind == "session.accept" {
+        json!({"by":"invitee","capabilities_answer":{"audio":["g.711-mu"]}})
+    } else {
+        json!({"by":"invitee","reason_code":486,"reason":"busy"})
+    };
+    let mut value = envelope(kind, payload);
+    value.as_object_mut().unwrap().remove("connid");
+    value["in_reply_to"] = json!(request.id());
+    value
