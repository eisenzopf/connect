+        assert!(observe(&mut observer,2,packet(1,90000,true),now,Some(handle)).unwrap().frame_realm().is_none());
+        let full=FrameRealmTestOwner::with_last_for_test(ConversationId::new(),SessionId::new(),u64::MAX);
+        assert!(observe(&mut observer,3,packet(1,90000,true),now,Some(full.handle())).unwrap().frame_realm().is_none());
+        // Metadata history has one peer-wide cap; no source/media is stopped.
+        for i in 4..400 {let _=observe(&mut observer,i,packet(1,90000,true),now,None).unwrap();}
+        assert_eq!(observer.recent.len(),HISTORY);assert_eq!(observer.order.len(),HISTORY);
+        assert!(observer.sources.len()>65);
+    }
