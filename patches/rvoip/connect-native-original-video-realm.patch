+//! Optional source-owned accepted RTP-group provenance. The sole original
+//! native reader mutates this before retain/retry; it never changes media IO.
+use bytes::Bytes;
+use rvoip_core::staged_streams::{OriginalVideoFrame,SourceFrameRealm};
+use rvoip_rtp_core::RtpPacket;
+use crate::substrate::{PeerMediaBinding,PeerMediaIngress};
+use std::{collections::{HashMap,VecDeque},sync::Arc,time::{Duration,Instant}};
+use tokio_util::sync::CancellationToken;
+const HISTORY:usize=256; // One peer-wide metadata history, not a delivery queue.
+const AGE:Duration=Duration::from_millis(200);
+struct Remembered {raw:Bytes,point:Option<Arc<OriginalVideoFrame>>,at:Instant}
+struct Group {point:Arc<OriginalVideoFrame>,first_sequence:u16,marker_sequence:Option<u16>,born:Instant}
+struct SourceGroups {
+    incarnation:Option<u128>,realm:Option<SourceFrameRealm>,cancel:CancellationToken,
+    identity:Option<(u32,u8)>,last_sequence:Option<u16>,group:Option<Group>,unavailable:bool,
+}
+impl SourceGroups {
+    fn new(incarnation:Option<u128>,realm:Option<SourceFrameRealm>,cancel:CancellationToken)->Self {
+        Self {incarnation,realm,cancel,identity:None,last_sequence:None,group:None,unavailable:incarnation.is_none()}
+    }
+    fn frame(&mut self,packet:&RtpPacket,now:Instant)->Option<Arc<OriginalVideoFrame>> {
+        if self.unavailable{return None;}
+        // Empty/padding-only RTP cannot establish a video frame ordinal.
+        if packet.payload.is_empty(){return None;}
+        let header=&packet.header;let identity=(header.ssrc,header.payload_type);
+        if self.identity.is_some_and(|old|old!=identity) {self.unavailable=true;return None;}
+        self.identity=Some(identity);
+        let sequence=header.sequence_number;
+        let forward=self.last_sequence.map_or(true,|old|{let delta=sequence.wrapping_sub(old);delta>0&&delta<(1u16<<15)});
+        let extended=if let Some(group)=&mut self.group {
+            let delta=header.timestamp.wrapping_sub(group.point.timestamp());
+            if delta==0 {
+                let in_group=sequence.wrapping_sub(group.first_sequence)<(1u16<<15);
+                let within_marker=group.marker_sequence.is_none_or(|end|sequence.wrapping_sub(group.first_sequence)<=end.wrapping_sub(group.first_sequence));
+                let marker_consistent=!header.marker||group.marker_sequence.is_none_or(|end|end==sequence);
+                if now.saturating_duration_since(group.born)>=AGE||!in_group||!within_marker||!marker_consistent {
+                    self.unavailable=true;return None;
+                }
+                if header.marker {group.marker_sequence=Some(sequence);}
+                if forward {self.last_sequence=Some(sequence);}
+                return Some(group.point.clone());
+            }
+            if !forward||delta>=(1u32<<31) {self.unavailable=true;return None;}
+            match group.point.extended_timestamp().checked_add(u64::from(delta)) {Some(value)=>value,None=>{self.unavailable=true;return None;}}
+        } else {
+            if !forward {self.unavailable=true;return None;}
+            u64::from(header.timestamp)
+        };
+        let point=OriginalVideoFrame::observed_in_realm(self.incarnation?,header.ssrc,header.timestamp,extended,self.realm.as_ref());
+        self.group=Some(Group {point:point.clone(),first_sequence:sequence,marker_sequence:header.marker.then_some(sequence),born:now});
+        self.last_sequence=Some(sequence);Some(point)
+    }
+}
+#[derive(Default)]
+pub(super) struct NativeOriginalVideo {
+    // Nonreused original physical peer stream IDs, not targets or Core Ports.
+    sources:HashMap<u16,SourceGroups>,
+    recent:HashMap<(u16,u16),Remembered>,order:VecDeque<(u16,u16)>,
+}
+impl NativeOriginalVideo {
+    pub(super) fn observe(&mut self,binding:&Arc<PeerMediaBinding>,packet:&RtpPacket,raw:&Bytes,now:Instant)->Option<Arc<OriginalVideoFrame>> {
+        let key=binding.local_id().get();
+        self.observe_prepared(key,packet,raw,now,|| {
+            let incarnation=match binding.ingress() {PeerMediaIngress::Checked(ingress)=>ingress.original_video_source_incarnation(),PeerMediaIngress::Channel(_)=>None};
+            SourceGroups::new(incarnation,binding.original_frame_realm(),binding.cancellation_token())
+        })
+    }
+    fn observe_prepared(&mut self,key:u16,packet:&RtpPacket,raw:&Bytes,now:Instant,setup:impl FnOnce()->SourceGroups)->Option<Arc<OriginalVideoFrame>> {
+        while self.order.front().is_some_and(|key|self.recent.get(key).is_none_or(|entry|now.saturating_duration_since(entry.at)>=AGE)) {
+            let key=self.order.pop_front().unwrap();self.recent.remove(&key);
+        }
+        if !self.sources.contains_key(&key) {
+            // State-change cleanup only; no per-packet scan or native/Port roots.
+            self.sources.retain(|_,source|!source.cancel.is_cancelled());
+            self.sources.insert(key,setup());
+        }
+        let cache_key=(key,packet.header.sequence_number);
+        if let Some(entry)=self.recent.get(&cache_key) {
+            if entry.raw==*raw {return entry.point.clone();}
+            self.sources.get_mut(&key).unwrap().unavailable=true;return None;
+        }
+        let source=self.sources.get_mut(&key).unwrap();
+        if raw.len()>rvoip_core::video_bridge::MAX_VIDEO_RTP_BYTES {source.unavailable=true;return None;}
+        let point=source.frame(packet,now);
+        if self.order.len()==HISTORY {let expired=self.order.pop_front().unwrap();self.recent.remove(&expired);}
+        self.order.push_back(cache_key);self.recent.insert(cache_key,Remembered {raw:raw.clone(),point:point.clone(),at:now});
+        point
+    }
+}
