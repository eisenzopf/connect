+#[test]
+fn native_original_binding_setup_cannot_adopt_late_or_foreign_runtime_handle() {
+    let (sender,receiver)=mpsc::channel(1);let media=NativePeerMedia::new(PeerTransport::Quic,Arc::new(Carrier {receiver:tokio::sync::Mutex::new(receiver)}),CancellationToken::new()).unwrap();
+    let session=SessionId::from_string("session");let connection=ConnectionId::from_string("source");let key=PeerMediaConnectionKey::new(session.clone(),connection.clone());
+    let a=FrameRealmTestOwner::new(ConversationId::from_string("conversation"),session.clone());let foreign_runtime=FrameRealmTestOwner::new(ConversationId::from_string("conversation"),session.clone());
+    let make=|connection:ConnectionId| {
+        let (tx,rx)=mpsc::channel(1);let stream=Arc::new(Stream {id:StreamId::new(),tx,rx:Mutex::new(Some(rx))});
+        let ingress=Arc::new(Ingress {source_reads:AtomicUsize::new(0),evidence:Arc::new(Mutex::new(Evidence::default())),done:Arc::new(Notify::new())});
+        media.router.reserve().unwrap().commit(PeerMediaRegistration::checked(owner_key(),PeerMediaRouteKey::new(session.clone(),connection,stream.id()),stream,ingress)).unwrap()
+    };
+    media.router.freeze_original_frame_realm(key.clone(),Some(a.handle()));let first=make(connection.clone());
+    assert_eq!(first.original_frame_realm().unwrap().incarnation(),a.handle().incarnation());
+    media.router.freeze_original_frame_realm(key,Some(foreign_runtime.handle()));
+    let next=make(connection);assert!(next.original_frame_realm().is_none());
+    assert_eq!(first.original_frame_realm().unwrap().incarnation(),a.handle().incarnation(),"immutable original binding cannot be rewritten");
+    let late_connection=ConnectionId::from_string("late-source");let missing=make(late_connection.clone());assert!(missing.original_frame_realm().is_none());
+    media.router.freeze_original_frame_realm(PeerMediaConnectionKey::new(session.clone(),late_connection.clone()),Some(a.handle()));
+    assert!(make(late_connection).original_frame_realm().is_none());
+    assert_ne!(a.handle().incarnation(),foreign_runtime.handle().incarnation());
+    let removed=media.router.shutdown();assert!(removed.iter().all(|binding|binding.is_cancelled()));assert_eq!(media.router.snapshot().connection_count,0);
+    drop(a);assert!(first.original_frame_realm().unwrap().incarnation().is_none());drop(sender);
+}
