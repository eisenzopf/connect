+//! Actual sole reader/parser/router/retained callback with a controlled local
+//! carrier. No TLS/network/Core authorization or media-delivery claim.
+use super::*;
+use super::super::{NativePeerMedia,NativeDatagramTransport,PeerTransport,DispatchError};
+use crate::staged_media::StagedDatagramTransport;
+use crate::substrate::{CheckedMediaIngress,PeerMediaRegistration,PeerMediaRouteKey,PeerMediaConnectionKey,ObservedRtpDatagram,observe_rtp,pack_observed_rtp_datagram};
+use crate::substrate::peer_media_router::PendingNativeIngress;
+use rvoip_core::{capability::CodecInfo,connection::Direction,ids::{ConversationId,SessionId,ConnectionId,StreamId},identity::{AuthenticatedPrincipal,AuthenticationMethod,IdentityAssurance},stream::{MediaStream,MediaFrame,StreamKind,QualitySnapshot},staged_streams::{ControlResult,StreamControlError,frame_realm::FrameRealmTestOwner}};
+use std::sync::{Mutex,atomic::{AtomicUsize,Ordering}};
+use tokio::sync::{mpsc,Notify};
+struct Carrier {receiver:tokio::sync::Mutex<mpsc::Receiver<Bytes>>}
+impl StagedDatagramTransport for Carrier {
+    fn maximum_datagram_bytes(&self)->Option<usize> {Some(1400)}
+    fn send_datagram(&self,_:Bytes)->ControlResult<()> {Err(StreamControlError::Unsupported)}
+    fn is_closed(&self)->bool {false}
+}
+#[async_trait::async_trait]
+impl NativeDatagramTransport for Carrier {
+    async fn read_datagram(&self)->Result<Bytes,DispatchError> {self.receiver.lock().await.recv().await.ok_or(DispatchError::Closed)}
+}
+struct Stream {id:StreamId,tx:mpsc::Sender<MediaFrame>,rx:Mutex<Option<mpsc::Receiver<MediaFrame>>>}
+#[async_trait::async_trait]
+impl MediaStream for Stream {
+    fn id(&self)->StreamId {self.id.clone()}
+    fn kind(&self)->StreamKind {StreamKind::Video}
+    fn codec(&self)->CodecInfo {CodecInfo {name:"vp8".into(),clock_rate_hz:90000,channels:0,fmtp:None,payload_type:Some(96)}}
+    fn direction(&self)->Direction {Direction::Inbound}
+    fn frames_in(&self)->mpsc::Receiver<MediaFrame> {self.rx.lock().unwrap().take().unwrap()}
+    fn frames_out(&self)->mpsc::Sender<MediaFrame> {self.tx.clone()}
+    fn quality_snapshot(&self)->QualitySnapshot {QualitySnapshot::default()}
+    async fn close(self:Arc<Self>)->rvoip_core::Result<()> {Ok(())}
+}
+#[derive(Default)]
+struct Evidence {retained:Vec<(Bytes,Option<Arc<OriginalVideoFrame>>)>,attempts:Vec<Option<Arc<OriginalVideoFrame>>>,completed:usize}
+struct Ingress {source_reads:AtomicUsize,evidence:Arc<Mutex<Evidence>>,done:Arc<Notify>}
+struct Pending {first:bool,point:Option<Arc<OriginalVideoFrame>>,evidence:Arc<Mutex<Evidence>>,done:Arc<Notify>}
+impl PendingNativeIngress for Pending {
+    fn try_publish(&mut self)->Option<bool> {
+        self.evidence.lock().unwrap().attempts.push(self.point.clone());
+        if self.first {self.first=false;return None;}
+        self.evidence.lock().unwrap().completed+=1;self.done.notify_one();Some(true)
+    }
+}
+impl CheckedMediaIngress for Ingress {
+    fn original_video_source_incarnation(&self)->Option<u128> {self.source_reads.fetch_add(1,Ordering::SeqCst);Some(77)}
+    fn try_send(&self,_:MediaFrame)->Result<(),mpsc::error::TrySendError<MediaFrame>> {Ok(())}
+    fn retain_rtp_observed(self:Arc<Self>,frame:MediaFrame,ssrc:u32,bytes:usize,seq:u32,at:Instant)->Result<Option<Box<dyn PendingNativeIngress>>,()> {self.retain_rtp_observed_original(frame,ssrc,bytes,seq,at,None)}
+    fn retain_rtp_observed_original(self:Arc<Self>,frame:MediaFrame,_:u32,_:usize,_:u32,_:Instant,point:Option<Arc<OriginalVideoFrame>>)->Result<Option<Box<dyn PendingNativeIngress>>,()> {
+        self.evidence.lock().unwrap().retained.push((frame.payload,point.clone()));
+        Ok(Some(Box::new(Pending {first:true,point,evidence:self.evidence.clone(),done:self.done.clone()})))
+    }
+    fn capacity(&self)->usize {32}
+    fn max_capacity(&self)->usize {32}
+    fn is_closed(&self)->bool {false}
+}
+fn owner_key()->rvoip_core::identity::PrincipalOwnershipKey {
+    AuthenticatedPrincipal {subject:"source".into(),tenant:Some("tenant".into()),issuer:Some("fixture".into()),scopes:vec![],expires_at:None,method:AuthenticationMethod::Bearer,assurance:IdentityAssurance::Anonymous}.ownership_key()
+}
+fn wire(local:u16,seq:u16,ts:u32,marker:bool,body:u8)->Bytes {
+    let mut header=rvoip_rtp_core::RtpHeader::new(96,seq,ts,77);header.marker=marker;
+    let raw=RtpPacket::new(header,Bytes::from(vec![0x10,body])).serialize().unwrap();
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {flags:0,stream_local_id:local,seq:u32::from(seq),rtp:observe_rtp(raw).unwrap()}).unwrap()
+}
+async fn complete(sender:&mpsc::Sender<Bytes>,done:&Notify,raw:Bytes) {sender.send(raw).await.unwrap();tokio::time::timeout(Duration::from_secs(1),done.notified()).await.unwrap();}
+#[tokio::test]
+async fn native_quic_and_webtransport_reader_freezes_capsule_once_across_actual_retained_retry() {
+    use futures::FutureExt as _;
+    for transport in [PeerTransport::Quic,PeerTransport::WebTransport] {
+        let realm=FrameRealmTestOwner::new(ConversationId::from_string("conversation"),SessionId::from_string("session"));
+        let (sender,receiver)=mpsc::channel(8);let cancel=CancellationToken::new();
+        let media=NativePeerMedia::new(transport,Arc::new(Carrier {receiver:tokio::sync::Mutex::new(receiver)}),cancel.clone()).unwrap();
+        let session=SessionId::from_string("session");let connection=ConnectionId::from_string("source");
+        let key=PeerMediaConnectionKey::new(session.clone(),connection.clone());
+        media.router.freeze_original_frame_realm(key.clone(),Some(realm.handle()));
+        let (tx,rx)=mpsc::channel(1);let stream=Arc::new(Stream {id:StreamId::new(),tx,rx:Mutex::new(Some(rx))});
+        let evidence=Arc::new(Mutex::new(Evidence::default()));let done=Arc::new(Notify::new());
+        let ingress=Arc::new(Ingress {source_reads:AtomicUsize::new(0),evidence:evidence.clone(),done:done.clone()});
+        let reservation=media.router.reserve().unwrap();let local=reservation.local_id().get();
+        let binding=reservation.commit(PeerMediaRegistration::checked(owner_key(),PeerMediaRouteKey::new(session,connection,stream.id()),stream,ingress.clone())).unwrap();
+        let reader=tokio::spawn(media.reader().unwrap());
+        let work=std::panic::AssertUnwindSafe(async {
+            complete(&sender,&done,wire(local,10,90000,false,1)).await;
+            complete(&sender,&done,wire(local,12,90000,true,3)).await;
+            complete(&sender,&done,wire(local,11,90000,false,2)).await;
+            complete(&sender,&done,wire(local,13,93000,true,4)).await;
+            // Exact prior raw packet gets SAME cached Arc; no new ordinal.
+            complete(&sender,&done,wire(local,10,90000,false,1)).await;
+            // Conflicting original metadata cannot suppress legacy IO.
+            complete(&sender,&done,wire(local,13,93000,true,99)).await;
+            let e=evidence.lock().unwrap();assert_eq!(e.completed,6);assert_eq!(e.retained.len(),6);assert_eq!(e.attempts.len(),12);
+            let first=e.retained[0].1.as_ref().unwrap();
+            for index in [1,2,4] {assert!(Arc::ptr_eq(first,e.retained[index].1.as_ref().unwrap()));}
+            assert_eq!(first.frame_realm().unwrap().ordinal(),1);assert_eq!(e.retained[3].1.as_ref().unwrap().frame_realm().unwrap().ordinal(),2);
+            assert!(e.retained[5].1.is_none());assert_eq!(e.retained[5].0.last(),Some(&99));
+            for (index,pair) in e.attempts.chunks_exact(2).enumerate() {
+                match &e.retained[index].1 {Some(expected)=>{assert!(Arc::ptr_eq(expected,pair[0].as_ref().unwrap()));assert!(Arc::ptr_eq(expected,pair[1].as_ref().unwrap()));},None=>assert!(pair.iter().all(Option::is_none))}
+            }
+            assert_eq!(ingress.source_reads.load(Ordering::SeqCst),1);
+        }).catch_unwind().await;
+        cancel.cancel();let joined=reader.await;
+        assert!(matches!(joined,Ok(Err(DispatchError::Closed))));assert!(!media.snapshot().reader_running);assert!(media.router.is_shutdown());assert!(binding.is_cancelled());
+        if let Err(error)=work {std::panic::resume_unwind(error)}
+    }
+}
