+//! Feedback retains exact route metadata, never packet bytes or policy readers.
+//! Native handle/SSRC negotiation and signed operation association remain the
+//! adapter/Service's responsibility; an echoed epoch is not authorization.
+use super::*;
+
+#[derive(Clone)]
+struct Scope {
+    source: Weak<Port>,
+    target: Weak<Port>,
+    source_ticket: PeerRouteTicket,
+    target_ticket: PeerRouteTicket,
+    source_scene: Option<scene_consumer::SceneStamp>,
+    target_scene: Option<scene_consumer::SceneStamp>,
+}
+impl Scope {
+    fn same(&self, other: &Self) -> bool {
+        let scene = |a: &Option<scene_consumer::SceneStamp>,
+                     b: &Option<scene_consumer::SceneStamp>| match (a, b) {
+            (None, None) => true,
+            (Some(a), Some(b)) => a.same_generation(b),
+            _ => false,
+        };
+        Weak::ptr_eq(&self.source, &other.source)
+            && Weak::ptr_eq(&self.target, &other.target)
+            && self.source_ticket.same_generation(&other.source_ticket)
+            && self.target_ticket.same_generation(&other.target_ticket)
+            && scene(&self.source_scene, &other.source_scene)
+            && scene(&self.target_scene, &other.target_scene)
+    }
+    fn cancelled(&self) -> bool {
+        self.source_scene
+            .as_ref()
+            .is_some_and(|s| s.cancel.is_cancelled())
+            || self
+                .target_scene
+                .as_ref()
+                .is_some_and(|s| s.cancel.is_cancelled())
+    }
+}
+#[derive(Default)]
+struct Rate {
+    sequence: Option<u32>,
+    next: Option<Instant>,
+}
+struct Epoch {
+    id: u128,
+    scope: Scope,
+    rate: Mutex<Rate>,
+}
+// One current epoch per direct selection. New packets share its rate/sequence
+// state; neither recording more packets nor unrelated Data controls resets it.
+#[derive(Default)]
+pub(super) struct FeedbackCache(Mutex<Option<Arc<Epoch>>>);
+
+#[derive(Clone)]
+pub struct VideoFeedbackRoute {
+    epoch: Arc<Epoch>,
+    source: MediaSource,
+    direct: direct_subscriptions::DirectStamp,
+}
+impl VideoFeedbackRoute {
+    // Called only inside the successful original packet's delivery guards.
+    fn issued(
+        scope: Scope,
+        source: MediaSource,
+        direct: direct_subscriptions::DirectStamp,
+    ) -> ControlResult<Self> {
+        if !direct.is_current()
+            || !scope.source_ticket.is_current()
+            || !scope.target_ticket.is_current()
+            || scope.cancelled()
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        let epoch = {
+            let mut slot = direct
+                .feedback
+                .0
+                .try_lock()
+                .map_err(|_| StreamControlError::Backpressure)?;
+            if slot.as_ref().is_none_or(|epoch| !epoch.scope.same(&scope)) {
+                *slot = Some(Arc::new(Epoch {
+                    id: uuid::Uuid::new_v4().as_u128(),
+                    scope,
+                    rate: Mutex::new(Rate::default()),
+                }));
+            }
+            slot.as_ref().unwrap().clone()
+        };
+        Ok(Self {
+            epoch,
+            source,
+            direct,
+        })
+    }
+    /// Opaque route/physical-port/scene generation identity, not a permission.
+    pub fn epoch(&self) -> u128 {
+        self.epoch.id
+    }
+
+    /// Invoke one bounded nonblocking local source dispatch under fresh source
+    /// publication and exact receiver-selection authority. The callback must
+    /// not detach IO or retain these guards. A failed dispatch consumes its
+    /// sequence too: it cannot be silently replayed after uncertain local IO.
+    pub fn dispatch<F>(&self, epoch: u128, sequence: u32, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(&AdapterMediaPort, &MediaSource) -> ControlResult<()>,
+    {
+        if epoch != self.epoch.id || !self.direct.is_current() || self.epoch.scope.cancelled() {
+            return Err(StreamControlError::Authority);
+        }
+        let scope = &self.epoch.scope;
+        let source_port = scope
+            .source
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let target_port = scope
+            .target
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let source = source_port
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let target = target_port
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if source.conversation != target.conversation
+            || source.session != target.session
+            || !Arc::ptr_eq(&source.policy, &target.policy)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut deadline = tokio::time::Instant::now() + Duration::from_millis(100);
+        // Fresh feedback has its own bounded admission, never a renewed media
+        // packet age. Retained metadata causes nonblocking queued policy reads.
+        let (source_lease, source_guard, source_bound) = source.admit_with_deadline(
+            &source_port,
+            &scope.source_ticket,
+            false,
+            None,
+            audio_consumer::ConsumerCheck::Retained(None),
+            None,
+            scene_consumer::SceneCheck::retained_publish(scope.source_scene.as_ref()),
+            None,
+            None,
+            None,
+            Some(&mut deadline),
+        )?;
+        deadline = deadline.min(source_bound);
+        let (target_lease, target_guard, target_bound) = target.admit_with_deadline(
+            &target_port,
+            &scope.target_ticket,
+            true,
+            Some(&self.source),
+            audio_consumer::ConsumerCheck::Retained(None),
+            Some(&self.direct),
+            scene_consumer::SceneCheck::retained_receive(
+                scope.target_scene.as_ref(),
+                scope.source_scene.as_ref(),
+                Instant::now(),
+            ),
+            None,
+            None,
+            None,
+            Some(&mut deadline),
+        )?;
+        deadline = deadline.min(target_bound);
+        if source.shutdown.is_cancelled()
+            || target.shutdown.is_cancelled()
+            || self.direct.cancel.is_cancelled()
+            || scope.cancelled()
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        {
+            let mut rate = self
+                .epoch
+                .rate
+                .try_lock()
+                .map_err(|_| StreamControlError::Backpressure)?;
+            if rate.sequence.is_some_and(|previous| {
+                let distance = sequence.wrapping_sub(previous);
+                distance == 0 || distance >= (1u32 << 31)
+            }) {
+                return Err(StreamControlError::Authority);
+            }
+            let now = Instant::now();
+            if rate.next.is_some_and(|next| now < next) {
+                return Err(StreamControlError::Backpressure);
+            }
+            rate.sequence = Some(sequence);
+            rate.next = Some(now + Duration::from_millis(100));
+        }
+        let result = send(&AdapterMediaPort(source_port.clone()), &self.source);
+        // Keep both current permission readers and all route/scene fences
+        // through the real local dispatch. None are stored in the route record.
+        drop((source_guard, target_guard, source_lease, target_lease));
+        result
+    }
+}
+
+impl QueuedMedia {
+    /// Return exact feedback metadata only after successful guarded native
+    /// video submission. The returned record retains no media or permission.
+    pub async fn deliver_video_with_feedback<F, Fut>(
+        self,
+        send: F,
+    ) -> ControlResult<VideoFeedbackRoute>
+    where
+        F: FnOnce(MediaFrame, Option<MediaDeliveryOrigin>) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        if self.frame.kind != StreamKind::Video
+            || self.data.is_some()
+            || self.local.is_some()
+            || self.sources.len() != 1
+            || self.target_consumer.is_some()
+            || self.target.binding.negotiated.requested.medium != Medium::Video
+            || self.sources[0].source.binding.negotiated.requested.medium != Medium::Video
+            || self.sources[0].consumer.is_some()
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let source = &self.sources[0];
+        let scope = Scope {
+            source: Arc::downgrade(&source.source),
+            target: Arc::downgrade(&self.target),
+            source_ticket: source.ticket.clone(),
+            target_ticket: self.target_ticket.clone(),
+            source_scene: source.scene.clone(),
+            target_scene: self.target_scene.clone(),
+        };
+        let descriptor = source.descriptor.clone();
+        let direct = self.direct.clone().ok_or(StreamControlError::Authority)?;
+        let mut installed = None;
+        let output = &mut installed;
+        self.deliver_with_origin(move |frame, origin| async move {
+            send(frame, origin).await?;
+            *output = Some(VideoFeedbackRoute::issued(scope, descriptor, direct)?);
+            Ok(())
+        })
+        .await?;
+        installed.ok_or(StreamControlError::NotReady)
+    }
+}
