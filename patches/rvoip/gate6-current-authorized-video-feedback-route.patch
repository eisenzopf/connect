+        .await
+        .unwrap();
+    assert!(selected
+        .dispatch(selected.epoch(), 1, |_, _| panic!(
+            "paused receiver reached IO"
+        ))
+        .is_err());
+    f.b.set_paused(&logical, f.b.revision(), false, deadline())
+        .await
+        .unwrap();
+    let resumed = feedback_record(&f, &mut input, &mut output, 13).await;
+    assert_ne!(resumed.epoch(), selected.epoch());
+    assert!(selected
+        .dispatch(selected.epoch(), 1, |_, _| panic!(
+            "old port generation reached IO"
+        ))
+        .is_err());
