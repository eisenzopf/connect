+    assert!(second
+        .dispatch(epoch, 0, |_, _| panic!(
+            "new packet reset duplicate suppression"
+        ))
+        .is_err());
+    assert!(second
+        .dispatch(epoch, u32::MAX, |_, _| panic!(
+            "backwards sequence reached IO"
+        ))
+        .is_err());
+    f.a.retire();
+    assert!(feedback
+        .dispatch(epoch, 1, |_, _| panic!("retired publisher reached IO"))
