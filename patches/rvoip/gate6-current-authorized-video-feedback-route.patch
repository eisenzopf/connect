+async fn feedback_reacquires_both_current_authorities_without_retaining_or_retiming_media() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Video).logical_id)
+            .unwrap();
