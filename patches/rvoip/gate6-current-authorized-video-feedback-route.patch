+    let epoch = feedback.epoch();
+    assert_ne!(epoch, 0);
+    publish(&f, Medium::Video, &mut input, 2)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Video).logical_id)
+        .unwrap();
+    let old_packet = outgoing(&mut output).await;
+    // A retained feedback record pins no policy reader. A new request after
+    // packet expiry is fresh admission, not renewed/replayed packet ownership.
+    assert!(f.policy.0.try_write().is_ok());
+    tokio::time::sleep(Duration::from_millis(210)).await;
+    assert!(matches!(
+        old_packet
+            .deliver(|_| async { panic!("expired media reached IO") })
+            .await,
+        Err(StreamControlError::Deadline)
+    ));
+    assert!(feedback
+        .dispatch(epoch ^ 1, u32::MAX, |_, _| panic!(
+            "foreign epoch reached IO"
+        ))
+        .is_err());
+    for subject in ["alice", "bob"] {
+        f.policy.0.write().await.revoked.insert(subject.into());
+        assert!(feedback
+            .dispatch(epoch, u32::MAX, |_, _| panic!(
+                "revoked authority reached IO"
+            ))
+            .is_err());
+        f.policy.0.write().await.revoked.clear();
+    }
+    f.policy.0.write().await.private = true;
+    assert!(feedback
+        .dispatch(epoch, u32::MAX, |_, _| panic!("denied receiver reached IO"))
+        .is_err());
+    f.policy.0.write().await.private = false;
+    feedback
+        .dispatch(epoch, u32::MAX, |port, source| {
+            assert_eq!(
+                port.binding().transport_id,
+                f.aa.port(Medium::Video).binding().transport_id
+            );
+            assert_eq!(source.connection, f.a.connection);
+            assert!(
+                f.policy.0.try_write().is_err(),
+                "both fresh readers must cover real local dispatch"
+            );
+            Ok(())
+        })
+        .unwrap();
+    assert!(f.policy.0.try_write().is_ok());
+    assert!(matches!(
+        feedback.dispatch(epoch, 0, |_, _| panic!("rate limit bypass")),
+        Err(StreamControlError::Backpressure)
+    ));
+    tokio::time::sleep(Duration::from_millis(110)).await;
+    // Wrap is valid; failed local IO consumes this original request too.
+    assert!(matches!(
+        feedback.dispatch(epoch, 0, |_, _| Err(StreamControlError::Unsupported)),
+        Err(StreamControlError::Unsupported)
+    ));
