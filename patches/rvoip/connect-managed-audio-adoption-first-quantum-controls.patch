+}
+struct ReplacementLease(ReplacementGrant);
+impl ParticipantReplacementLease for ReplacementLease {
+    fn current(
+        &self,
+        s: &ParticipantReplacementScope<'_>,
+    ) -> std::result::Result<ParticipantReplacementAuthority, ParticipantControlError> {
+        let g = &self.0;
+        let d = &g.domain;
+        if !g.world.allowed.load(Ordering::Acquire)
+            || !d.allowed.load(Ordering::Acquire)
+            || s.conversation != d.member.conversation()
+            || s.session != &d.session
+            || s.principal.ownership_key() != d.principal.ownership_key()
+            || s.principal.expires_at != d.principal.expires_at
+            || s.intent != &g.intent
+            || tokio::time::Instant::now() >= g.until
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        Ok(ParticipantReplacementAuthority {
+            actor: d.member.clone(),
+            target: d.member.clone(),
+            endpoint: d.endpoint.clone(),
+            may_send_audio: true,
+            may_receive_audio: true,
+        })
+    }
+}
+impl ParticipantPolicy for World {
+    fn current(
+        &self,
+        _: &ParticipantScope<'_>,
+    ) -> std::result::Result<Box<dyn ParticipantAuthorityLease + '_>, ParticipantControlError> {
+        Err(ParticipantControlError::Unsupported)
+    }
+    fn current_control(
+        &self,
+        s: &ParticipantScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> std::result::Result<ParticipantControl, ParticipantControlError> {
+        let Command::Initial(g) = held
+            .downcast_ref::<Command>()
+            .ok_or(ParticipantControlError::Authority)?
+        else {
+            return Err(ParticipantControlError::Authority);
+        };
+        if !self.allowed.load(Ordering::Acquire) {
+            return Err(ParticipantControlError::Authority);
+        }
+        g.domain.current_control(s, g)
+    }
+    fn current_replacement_control(
+        &self,
+        s: &ParticipantReplacementScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> std::result::Result<ParticipantReplacementControl, ParticipantControlError> {
+        let g = replacement_grant(held).ok_or(ParticipantControlError::Authority)?;
+        if !std::ptr::eq(self, g.world.as_ref()) {
+            return Err(ParticipantControlError::Authority);
+        }
+        ReplacementLease(g.clone()).current(s)?;
+        ParticipantReplacementControl::new(
+            Box::new(ReplacementLease(g.clone())),
+            CancellationToken::new(),
+            g.until,
+        )
+    }
+}
+impl World {
+    fn raw(&self, id: &ConnectionId) -> ControlResult<Resource> {
+        if !self.allowed.load(Ordering::Acquire) {
+            return Err(StreamControlError::Authority);
+        }
+        self.resources
+            .lock()
+            .unwrap()
+            .get(id)
+            .cloned()
+            .ok_or(StreamControlError::Authority)
+    }
+    fn owner(&self, id: &ConnectionId) -> ControlResult<MediaOwner> {
+        let r = self.raw(id)?;
+        match r.proof.as_ref().filter(|p| p.is_committed()) {
+            Some(p) => match &r.pending {
+                Some(pending) => p.current_replacement_resources(
+                    r.owner,
+                    &self.owner(&pending.intent().source)?,
+                    pending,
+                ),
+                None => p.current(r.owner),
+            },
+            None => Ok(r.owner),
+        }
+    }
+    fn source(&self, s: &MediaSource) -> ControlResult<()> {
+        let o = self.owner(&s.connection)?;
+        o.connection
+            .require_current(&o.member, &o.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if s.conversation != *o.member.conversation()
+            || s.session != *o.presence.session()
+            || s.participant != *o.member.participant()
+            || s.membership_epoch != o.member.epoch()
+            || s.connection_generation != o.connection.generation()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    fn scope(&self, s: &MediaScope<'_>) -> ControlResult<MediaOwner> {
+        let mut o = self.owner(s.connection)?;
+        o.actor
+            .revalidate_principal(s.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        if s.conversation != o.member.conversation()
+            || s.session != o.presence.session()
+            || s.connection != o.connection.connection()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        if let MediaPurpose::Receive { source } = s.purpose {
+            self.source(source)?;
+            o.may_route_source = true;
+        }
+        Ok(o)
+    }
+    fn lease(self: &Arc<Self>, s: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        Ok(Box::new(WorldLease {
+            world: self.clone(),
+            owner: self.scope(s)?,
+        }))
+    }
+}
+struct WorldLease {
+    world: Arc<World>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for WorldLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        self.world
+            .owner(self.owner.connection.connection())
+            .map(Box::new)
+    }
+    fn control_prepared(
+        &self,
+        p: &Arc<PreparedMediaObservation>,
+    ) -> ControlResult<Box<MediaOwner>> {
+        let id = self.owner.connection.connection();
+        let r = self.world.raw(id)?;
+        let o = match &r.pending {
+            Some(pending) => {
+                if !pending.binding().same_incarnation(&self.owner.connection) {
+                    return Err(StreamControlError::Authority);
+                }
+                p.activate_replacement_resources(
+                    self.owner.clone(),
+                    &self.world.owner(&pending.intent().source)?,
+                    pending,
+                )?
+            }
+            None => p.activate_for_commit(self.owner.clone())?,
+        };
+        self.world
+            .resources
+            .lock()
+            .unwrap()
+            .get_mut(id)
+            .unwrap()
+            .proof = Some(p.clone());
+        Ok(Box::new(o))
+    }
+    fn control_receive(&self, s: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        self.world.source(s)?;
+        let mut o = self.world.owner(self.owner.connection.connection())?;
+        o.may_route_source = true;
+        Ok(Box::new(o))
+    }
+    fn control_participant_receive(
+        &self,
+        s: &MediaParticipantSource,
+    ) -> ControlResult<Box<MediaOwner>> {
+        let source = self.world.owner(&s.connection)?;
+        source
+            .member
+            .revalidate_principal(&s.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        if s.conversation != *source.member.conversation()
+            || s.session != *source.presence.session()
+            || s.identity != *source.member.identity()
+            || s.participant != *source.member.participant()
+            || s.membership_epoch != source.member.epoch()
+            || s.medium != Medium::Audio
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut o = self.world.owner(self.owner.connection.connection())?;
+        o.may_route_source = true;
+        Ok(Box::new(o))
+    }
+}
+struct PolicyView(Arc<World>);
+impl MediaPolicy for PolicyView {
+    fn current(&self, s: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.0.lease(s)
+    }
+    fn current_participant_receive(
+        &self,
+        s: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let l = WorldLease {
+            world: self.0.clone(),
+            owner: self.0.scope(s)?,
+        };
+        let owner = *l.control_participant_receive(source)?;
+        Ok(Box::new(WorldLease {
+            world: self.0.clone(),
+            owner,
+        }))
+    }
+    fn current_audio_preparation(
