+            staged_outbound_activation: true,
+            ..Default::default()
+        }
+    }
+    fn install_lifecycle_sink(&self, sink: Arc<dyn AdapterLifecycleSink>) -> crate::Result<()> {
+        self.lifecycle
+            .install(sink)
+            .map_err(|_| RvoipError::InvalidState("fixture duplicate lifecycle"))
+    }
+    fn is_connection_live(&self, id: &ConnectionId) -> bool {
+        self.live.lock().unwrap().contains(id)
+    }
+    fn staged_controller(&self, id: &ConnectionId) -> Option<Arc<StreamController>> {
+        self.controllers.lock().unwrap().get(id).cloned()
+    }
+    async fn originate(&self, r: OriginateRequest) -> crate::Result<ConnectionHandle> {
+        self.allocations.fetch_add(1, Ordering::SeqCst);
+        let id = ConnectionId::new();
+        self.live.lock().unwrap().insert(id.clone());
+        Ok(ConnectionHandle::new(Connection {
+            id,
+            session_id: r.session_id,
+            participant_id: r.participant_id,
+            transport: Transport::Sip,
+            direction: Direction::Outbound,
+            state: ConnectionState::Connecting,
+            capabilities: r.capabilities,
+            negotiated_codecs: NegotiatedCodecs::default(),
+            streams: vec![],
+            messaging_enabled: false,
+            transport_handle: TransportHandle(Arc::new(())),
+            opened_at: chrono::Utc::now(),
+            closed_at: None,
+        }))
+    }
+    async fn activate_outbound(&self, id: ConnectionId) -> crate::Result<()> {
+        if !self.is_connection_live(&id) {
+            return Err(RvoipError::InvalidState("fixture ended"));
+        }
+        if self.activated.lock().unwrap().insert(id) {
+            self.signals.fetch_add(1, Ordering::SeqCst);
+        }
+        Ok(())
+    }
+    async fn accept(&self, _: ConnectionId) -> crate::Result<()> {
+        Err(RvoipError::NotImplemented("outbound fixture"))
+    }
+    async fn reject(&self, id: ConnectionId, _: RejectReason) -> crate::Result<()> {
+        self.end(id, EndReason::Normal).await
+    }
+    async fn end(&self, id: ConnectionId, _: EndReason) -> crate::Result<()> {
+        if self.live.lock().unwrap().remove(&id) {
+            self.ends.fetch_add(1, Ordering::SeqCst);
+        }
+        let controller = self.controllers.lock().unwrap().remove(&id);
+        if let Some(c) = controller {
+            c.shutdown(deadline()).await;
+        }
+        Ok(())
+    }
