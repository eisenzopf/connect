+    fn current_local_audio(
+        &self,
+        s: &MediaScope<'_>,
+        p: &LocalAudioPurpose,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let LocalAudioPurpose::EndpointPreparation { operation_id } = p;
+        let r = self.0.raw(s.connection)?;
+        if r.pending.is_none() || r.probe_operation.as_ref() != Some(operation_id) {
+            return Err(StreamControlError::Authority);
+        }
+        self.0.lease(s)
+    }
+    fn current_device_replacement_signal(
+        &self,
+        s: &DeviceReplacementSignalScope<'_>,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let g = held
+            .and_then(|h| replacement_grant(h))
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.0, &g.world)
+            || s.pending.intent() != &g.intent
+            || s.session != &g.domain.session
+            || s.conversation != g.domain.member.conversation()
+            || s.principal.ownership_key() != g.domain.principal.ownership_key()
+            || s.principal.expires_at != g.domain.principal.expires_at
+            || !s.target_principal.is_some_and(|p| {
+                p.ownership_key() == g.domain.principal.ownership_key()
+                    && p.expires_at == g.domain.principal.expires_at
+            })
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = self.0.owner(s.pending.binding().connection())?;
+        Ok(Box::new(WorldLease {
+            world: self.0.clone(),
+            owner,
+        }))
+    }
+    fn current_control(
+        &self,
+        s: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        if let Some(root) = held.downcast_ref::<ReplacementGrant>() {
+            if let MediaControlIntent::PreparePrivateAudio {
+                operation,
+                expected,
+            } = intent
+            {
+                let o = self.0.scope(s)?;
+                if !Arc::ptr_eq(&root.world, &self.0)
+                    || s.connection != &root.intent.replacement
+                    || *expected != 2
+                    || !operation.starts_with("replace_")
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                if root
+                    .private_operation
+                    .get_or_init(|| operation.to_string())
+                    .as_str()
+                    != *operation
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                return MediaControl::new(
+                    Box::new(WorldLease {
+                        world: self.0.clone(),
+                        owner: o,
+                    }),
+                    CancellationToken::new(),
+                    root.until,
+                );
+            }
+        }
+        let c = held
+            .downcast_ref::<Command>()
+            .ok_or(StreamControlError::Authority)?;
+        let ok = match (c, intent) {
+            (Command::Initial(g), MediaControlIntent::Initialize) => {
+                g.domain.principal.ownership_key() == s.principal.ownership_key()
+            }
+            (
+                Command::Initial(g),
+                MediaControlIntent::Change {
+                    expected,
+                    desired: actual,
+                    replace,
+                },
+            ) => {
+                g.domain.principal.ownership_key() == s.principal.ownership_key()
+                    && *expected == 0
+                    && *actual == [desired(Medium::Audio)]
+                    && replace.is_empty()
+            }
+            (Command::Resources { root, pending }, MediaControlIntent::Initialize) => {
+                Arc::ptr_eq(&root.world, &self.0) && s.connection == pending.binding().connection()
+            }
+            (
+                Command::Resources { root, pending },
+                MediaControlIntent::Change {
+                    expected,
+                    desired: actual,
+                    replace,
+                },
+            ) => {
+                Arc::ptr_eq(&root.world, &self.0)
+                    && s.connection == pending.binding().connection()
+                    && *expected == 0
+                    && *actual == [desired(Medium::Audio)]
+                    && replace.is_empty()
+            }
+            (
+                Command::Resources { root, pending },
+                MediaControlIntent::Gate {
+                    expected,
+                    streams,
+                    action,
+                },
+            ) => {
+                Arc::ptr_eq(&root.world, &self.0)
+                    && s.connection == pending.binding().connection()
+                    && *expected == 1
+                    && *streams == &BTreeSet::from([desired(Medium::Audio).logical_id])
+                    && *action == StreamGateAction::Mute
+            }
+            (
+                Command::Audience { root, plan },
+                MediaControlIntent::AudioAudience { plan: actual },
+            ) => {
+                Arc::ptr_eq(&root.world, &self.0)
+                    && plan.same_intent(actual)
+                    && actual.replacement_request().is_none()
+                    && actual.handoff_request().is_none()
+                    && actual
+                        .expected_receiver_revisions()
+                        .contains_key(s.connection)
+            }
+            (
+                Command::Audience { root, plan },
+                MediaControlIntent::DeviceReplacement { plan: actual },
+            ) => {
+                Arc::ptr_eq(&root.world, &self.0)
+                    && plan.same_intent(actual)
+                    && actual.replacement_request().is_some()
+                    && actual
+                        .expected_receiver_revisions()
+                        .contains_key(s.connection)
+            }
+            (
+                Command::Prepare { root, expected },
+                MediaControlIntent::PrepareReplacementAudio {
+                    source,
+                    expected: revision,
+                },
+            ) => {
+                Arc::ptr_eq(&root.world, &self.0)
+                    && s.connection == &root.intent.replacement
+                    && *source == &root.intent.source
+                    && expected == revision
+            }
+            (
+                Command::Select {
+                    connection,
+                    expected,
+                    change,
+                },
+                MediaControlIntent::AudioSubscriptions {
+                    expected: revision,
+                    change: actual,
+                },
+            ) => connection == s.connection && expected == revision && change == *actual,
+            _ => false,
+        };
+        if !ok {
+            return Err(StreamControlError::Authority);
+        }
+        MediaControl::new(self.0.lease(s)?, CancellationToken::new(), deadline())
+    }
+}
+fn domain(
+    conversation: &ConversationId,
+    session: &SessionId,
+    name: &str,
+    identity_name: &str,
+) -> Arc<Domain> {
+    let p = principal(identity_name);
+    let identity = IdentityBinding::from_authenticated(
+        &p,
+        IdentityId::from_string(identity_name),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let member = Membership::admit(
+        identity.clone(),
+        conversation.clone(),
+        ParticipantId::from_string(identity_name),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+    )
+    .unwrap();
+    let mut endpoint = EndpointBinding::provision(
+        identity.clone(),
+        EndpointId::from_string(format!("managed-{name}")),
+        DeviceId::from_string(format!("managed-{name}")),
+        Transport::Sip,
+        format!("sip:{name}@fixture.invalid"),
+    )
+    .unwrap();
+    endpoint
+        .verify(
+            &identity,
+            "owned-managed-endpoint".into(),
+            chrono::Utc::now(),
+        )
+        .unwrap();
+    Arc::new(Domain {
+        principal: p,
+        session: session.clone(),
+        member,
+        alternate_endpoint: endpoint.clone(),
+        endpoint,
+        owner: Mutex::new(None),
+        proof: Mutex::new(None),
+        allowed: AtomicBool::new(true),
+        private_allowed: AtomicBool::new(true),
+        changed_epoch: AtomicBool::new(false),
+        changed_endpoint: AtomicBool::new(false),
+        private_checks: AtomicUsize::new(0),
+        preparations: AtomicUsize::new(0),
+    })
+}
+struct Node {
+    controller: Arc<StreamController>,
+    backend: Arc<Adapter>,
+    out: mpsc::Receiver<QueuedMedia>,
+    sequence: u32,
+}
+impl Node {
+    fn frame(&mut self, sample: i16) -> MediaFrame {
+        use rvoip_media_core::{AudioFrame, codec::factory::CodecFactory};
+        self.sequence += 160;
+        let port = self.backend.port(Medium::Audio);
+        let mut f = frame(&port, self.sequence);
+        let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+        f.payload = codec
+            .encode(&AudioFrame {
+                samples: vec![sample; 160],
+                sample_rate: 8000,
+                channels: 1,
+                duration: Duration::from_millis(20),
+                timestamp: self.sequence,
+            })
+            .unwrap()
+            .into();
+        f
+    }
+    fn publish(&mut self, sample: i16) -> ControlResult<()> {
+        let f = self.frame(sample);
+        self.backend.port(Medium::Audio).try_publish(&f)
+    }
+    fn drain(&mut self) {
+        while self.out.try_recv().is_ok() {}
+    }
+    async fn hear(&mut self, expected: i16) {
+        outgoing(&mut self.out)
+            .await
+            .deliver(move |f| async move {
+                use rvoip_media_core::codec::factory::CodecFactory;
+                let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+                let pcm = codec.decode(&f.payload).unwrap();
+                let mean = pcm.samples.iter().map(|s| i32::from(*s)).sum::<i32>()
+                    / pcm.samples.len() as i32;
+                assert!(
+                    (mean - i32::from(expected)).abs() < 400,
+                    "expected {expected}, actual {mean}"
+                );
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+}
+struct ManagedRoom {
+    orch: Arc<Orchestrator>,
+    route: Arc<ManagedRoute>,
+    world: Arc<World>,
+    policy: Arc<PolicyView>,
+    session: SessionId,
+    conversation: ConversationId,
+    nodes: BTreeMap<ConnectionId, Node>,
+    original_owners: Arc<Mutex<Vec<(Arc<StreamController>, Arc<Adapter>)>>>,
+}
+impl ManagedRoom {
+    async fn new() -> Self {
+        let orch = Orchestrator::new(Config::default());
+        let route = ManagedRoute::new();
+        orch.register(route.clone()).unwrap();
+        let conversation = orch
+            .open_conversation(
+                TenantId::from_string("tenant"),
+                crate::conversation::ConversationPolicy::Persistent,
+                HashMap::new(),
+            )
+            .await
+            .unwrap();
+        let session = orch
+            .start_session(
+                conversation.clone(),
+                crate::session::SessionMedium::Voice,
+                vec![],
+            )
+            .await
+            .unwrap();
+        let world = Arc::new(World {
+            resources: Mutex::new(HashMap::new()),
+            allowed: AtomicBool::new(true),
+        });
+        let policy = Arc::new(PolicyView(world.clone()));
+        let mut limits = ParticipantLimits::default();
+        limits.mix_rate_hz = 8000;
+        orch.enable_staged_participant_control(&session, world.clone(), policy.clone(), limits)
+            .unwrap();
+        Self {
+            orch,
+            route,
+            world,
+            policy,
+            session,
+            conversation,
+            nodes: BTreeMap::new(),
+            original_owners: Arc::new(Mutex::new(Vec::new())),
+        }
+    }
+    async fn initial(&mut self, d: Arc<Domain>) -> ConnectionId {
+        let p = self
+            .orch
+            .prepare_outbound_connection(OriginateRequest {
+                session_id: self.session.clone(),
+                participant_id: d.member.participant().clone(),
+                target: d.endpoint.address().into(),
+                direction: Direction::Outbound,
+                capabilities: CapabilityDescriptor::default(),
+                transport: Some(Transport::Sip),
+                context: Default::default(),
+            })
+            .await
+            .unwrap();
+        let id = p.connection_id().clone();
+        let grant = Grant {
+            domain: d.clone(),
+            private_revision: None,
+            private_audio: false,
+            mutation: ParticipantMutation {
+                operation_id: format!("initial-{id}"),
+                correlation_id: format!("initial-{id}"),
+                expected_revision: self.orch.participant_revision(&self.session).unwrap(),
+                participant: d.member.participant().clone(),
+                change: ParticipantChange::Admit {
+                    connection: id.clone(),
+                    role_override: None,
+                },
+            },
+        };
+        let held = Command::Initial(grant.clone());
+        let active = p
+            .activate_initial_participant_with_held(
+                d.principal.clone(),
+                grant.mutation.clone(),
+                deadline(),
+                CancellationToken::new(),
+                Box::new(held.clone()),
+            )
+            .await
+            .unwrap();
+        let world = self.world.clone();
+        let policy = self.policy.clone();
+        let route = self.route.clone();
+        let built = Arc::new(Mutex::new(None));
+        let output = built.clone();
+        let original_owners = self.original_owners.clone();
+        active
+            .commit_staged_participant_with_held(
+                grant.mutation.clone(),
+                deadline(),
+                CancellationToken::new(),
+                Box::new(held.clone()),
+                move |p| async move {
+                    let mut caps = profile();
+                    caps.send.retain(|c| c.medium == Medium::Audio);
+                    caps.receive.retain(|c| c.medium == Medium::Audio);
+                    caps.max_streams = 1;
+                    let owner = MediaOwner {
+                        actor: p.member().clone(),
+                        member: p.member().clone(),
+                        presence: p.appearance().clone(),
+                        endpoint: p.endpoint().clone(),
+                        connection: p.binding().clone(),
+                        may_control: true,
+                        may_route_source: true,
+                        send_media: BTreeSet::from([Medium::Audio]),
+                        receive_media: BTreeSet::from([Medium::Audio]),
+                        local: caps.clone(),
+                        remote: caps,
+                    };
+                    world.resources.lock().unwrap().insert(
+                        p.binding().connection().clone(),
+                        Resource {
+                            owner,
+                            proof: None,
+                            pending: None,
+                            probe_operation: None,
+                        },
+                    );
+                    let backend = Adapter::new();
+                    let controller = StreamController::with_held_control(
+                        p.member().conversation().clone(),
+                        p.appearance().session().clone(),
+                        p.binding().connection().clone(),
+                        p.principal().clone(),
+                        policy,
+                        backend.clone(),
+                        Arc::new(StreamHandleAllocator::default()),
+                        4,
+                        8,
+                        p.cancellation(),
+                        &held,
+                    )?;
+                    // Own each original immediately, before any fallible setup.
+                    original_owners
+                        .lock()
+                        .unwrap()
+                        .push((controller.clone(), backend.clone()));
+                    controller
+                        .change_with_held(
+                            0,
+                            &[desired(Medium::Audio)],
+                            &BTreeSet::new(),
+                            deadline(),
+                            CancellationToken::new(),
+                            Arc::new(held.clone()),
+                        )
+                        .await?;
+                    let out = backend.port(Medium::Audio).take_egress()?;
+                    route
+                        .controllers
+                        .lock()
+                        .unwrap()
+                        .insert(p.binding().connection().clone(), controller.clone());
+                    *output.lock().unwrap() = Some(Node {
+                        controller,
+                        backend,
+                        out,
+                        sequence: 0,
+                    });
+                    Ok(Arc::new(held) as Arc<dyn Any + Send + Sync>)
+                },
+            )
+            .await
+            .unwrap();
+        self.nodes
+            .insert(id.clone(), built.lock().unwrap().take().unwrap());
+        id
+    }
+    async fn select(&self, id: &ConnectionId, sources: Vec<AudioSubscription>) {
+        let expected = self.nodes[id].controller.revision();
+        let change = AudioSubscriptionChange::Subscribe(sources);
+        let held = Command::Select {
+            connection: id.clone(),
+            expected,
+            change: change.clone(),
+        };
+        self.orch
+            .change_staged_audio_subscriptions(
+                &self.session,
+                id,
+                expected,
+                change,
+                deadline(),
+                CancellationToken::new(),
+                Some(&held),
+            )
+            .await
+            .unwrap();
+    }
+}
