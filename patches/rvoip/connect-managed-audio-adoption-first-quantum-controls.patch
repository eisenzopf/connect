+    async fn prepare_audio(
+        &self,
+        root: &Arc<DeviceReplacementPreparation>,
+        grant: &ReplacementGrant,
+    ) -> crate::staged_streams::audio_subscriptions::AudioReplacementPreparation {
+        let c = &self.nodes[&grant.intent.replacement].controller;
+        let held = Command::Prepare {
+            root: grant.clone(),
+            expected: c.revision(),
+        };
+        loop {
+            match self
+                .orch
+                .prepare_staged_device_replacement_audio_with_held(root, &held)
+                .unwrap()
+            {
+                AudioReplacementPreparationAttempt::Prepared(p) => return p,
+                AudioReplacementPreparationAttempt::MetadataBusy { deadline: until } => {
+                    assert!(tokio::time::Instant::now() < until.min(grant.until));
+                    tokio::task::yield_now().await;
+                }
+            }
+        }
+    }
+    fn signal(
+        &self,
+        root: &Arc<DeviceReplacementPreparation>,
+        grant: &ReplacementGrant,
+        context: &Arc<SignalContext>,
+        event: DeviceReplacementEndpointEvent,
+    ) -> EndpointConfirmationObservation {
+        self.orch
+            .capture_device_replacement_event(
+                root,
+                DeviceReplacementSignalSource::Adapter(context.clone()),
+                event,
+            )
+            .unwrap()
+            .observe_with_held(grant)
+            .unwrap()
+    }
+    async fn close_originals(&mut self) -> Vec<bool> {
+        let mut joined = Vec::new();
+        joined.push(matches!(
+            catch_original(
+                self.orch
+                    .end_session(self.session.clone(), EndReason::Normal)
+            )
+            .await,
+            Ok(Ok(()))
+        ));
+        // This list includes any controller whose later initialization failed,
+        // even when it never reached the complete Node/adapter route maps.
+        let owners = self.original_owners.lock().unwrap().clone();
+        for (controller, _) in &owners {
+            joined.push(matches!(
+                catch_original(controller.shutdown(deadline())).await,
+                Ok(0)
+            ));
+        }
+        let mut ids = self.nodes.keys().cloned().collect::<BTreeSet<_>>();
+        ids.extend(self.route.live.lock().unwrap().iter().cloned());
+        for id in &ids {
+            joined.push(matches!(
+                catch_original(self.route.end(id.clone(), EndReason::Normal)).await,
+                Ok(Ok(()))
+            ));
+        }
+        joined.push(matches!(
+            catch_original(self.orch.drain_prepared_outbound_connections()).await,
+            Ok(())
+        ));
+        joined.push(matches!(
+            catch_original(self.orch.drain_connection_lifecycle_tasks()).await,
+            Ok(Ok(()))
+        ));
+        joined.push(self.orch.connection_lifecycle_task_count() == 0);
+        joined.push(self.route.live.lock().unwrap().is_empty());
+        joined.push(
+            owners
+                .iter()
+                .all(|(_, backend)| backend.outstanding.load(Ordering::Acquire) == 0),
+        );
+        joined
+    }
+}
+async fn catch_original<F: Future>(future: F) -> std::thread::Result<F::Output> {
+    let mut f = std::pin::pin!(future);
+    poll_fn(
+        |cx| match catch_unwind(AssertUnwindSafe(|| Future::poll(f.as_mut(), cx))) {
+            Ok(Poll::Pending) => Poll::Pending,
+            Ok(Poll::Ready(x)) => Poll::Ready(Ok(x)),
+            Err(e) => Poll::Ready(Err(e)),
+        },
+    )
+    .await
+}
