+                .try_queue_local_audio(
+                    &desired(Medium::Audio).logical_id,
+                    prompt,
+                    LocalAudioPurpose::EndpointPreparation {
+                        operation_id: context.operation_id().into(),
+                    },
+                )
+                .unwrap();
+            node.hear(4000).await;
+            assert!(probe.has_duplex_io());
+            // The root-specific existing public method is called on OLD too.
+            let prepared = room.prepare_audio(&root, &grant).await;
+            room.nodes
+                .get_mut(&retained)
+                .unwrap()
+                .publish(6000)
+                .unwrap();
+            room.nodes.get_mut(&candidate).unwrap().hear(6000).await;
+            assert!(prepared.has_delivered_remote_audio());
+            for n in room.nodes.values_mut() {
+                n.drain();
+            }
+            let capture = Instant::now();
+            room.nodes
+                .get_mut(&candidate)
+                .unwrap()
+                .publish(5200)
+                .unwrap();
+            let target = &room.nodes[&candidate].controller;
+            let consumer = target
+                .audio_consumer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .unwrap()
+                .upgrade()
+                .unwrap();
+            let fresh_private_decode = consumer.decoded_since(target, capture);
+            assert!(fresh_private_decode);
+            assert_eq!(
+                room.signal(
+                    &root,
+                    &grant,
+                    &signal,
+                    DeviceReplacementEndpointEvent::Answered
+                ),
+                EndpointConfirmationObservation::Answered
+            );
+            room.signal(
+                &root,
+                &grant,
+                &signal,
+                DeviceReplacementEndpointEvent::MediaObserved,
+            );
+            assert_eq!(
+                room.signal(
+                    &root,
+                    &grant,
+                    &signal,
+                    DeviceReplacementEndpointEvent::Dtmf { digits: "7".into() }
+                ),
+                EndpointConfirmationObservation::Confirmed
+            );
+            let ready = probe.has_duplex_io();
+            let remote_delivered = prepared.has_delivered_remote_audio();
+            assert!(ready && remote_delivered);
+            let private_decoder = probe
+                .probe
+                .decoder
+                .lock()
+                .unwrap()
+                .weak_codec_owners_for_test()[0]
+                .clone();
+            let actual_candidate = room.world.owner(&candidate).unwrap();
+            let plan = room
+                .orch
+                .plan_staged_device_replacement(&root, None)
+                .unwrap();
+            assert_eq!(plan.media().request().source, source);
+            assert_eq!(plan.media().request().admitted, candidate);
+            let held = Command::Audience {
+                root: grant.clone(),
+                plan: plan.media().audience().clone(),
+            };
+            let (outcome, _successor) = room
+                .orch
+                .commit_staged_device_replacement_with_held(plan, &held)
+                .await
+                .unwrap();
+            assert!(root.is_committed());
+            assert_eq!(outcome.replaced, source);
+            assert_eq!(outcome.admitted, candidate);
+            assert_eq!(outcome.retained, retained);
+            assert_eq!(room.orch.session_of(&source), None);
+            assert_eq!(room.orch.session_of(&candidate), Some(room.session.clone()));
+            assert_eq!(
+                room.orch.participant_revision(&room.session).unwrap(),
+                grant.intent.expected_revision + 1
+            );
+            assert!(
+                actual_candidate
+                    .connection
+                    .same_incarnation(root.prepared_binding().binding())
+            );
+            assert_eq!(
+                actual_candidate.connection.endpoint(),
+                &grant.intent.endpoint
+            );
+            assert_eq!(actual_candidate.connection.device(), &grant.intent.device);
+            // Controlled host projection of the ACTUAL public commit result.
+            // No second model stage/commit, readiness construction or new epoch.
+            room.world.resources.lock().unwrap().insert(
+                candidate.clone(),
+                Resource {
+                    owner: actual_candidate,
+                    proof: None,
+                    pending: None,
+                    probe_operation: None,
+                },
+            );
+            let actual_decoder = room
+                .orch
+                .staged_media_weak_owners_for_test(&room.session, &candidate)
+                .unwrap()
+                .into_iter()
+                .find(|(name, _)| *name == "mixer-decoder")
+                .unwrap()
+                .1;
+            let decoder_transferred = private_decoder.ptr_eq(&actual_decoder);
+            let old_removed = room.nodes[&source].controller.shutdown.is_cancelled();
+            let old_codec_gone = old_codec.upgrade().is_none();
+            assert!(old_removed && old_codec_gone);
+            let age_us = capture.elapsed().as_micros();
+            assert!(age_us < 200_000);
+            // Prove an ACTUAL post-cut mixer quantum before checking absence.
+            // Bob's distinct9200 reaches the candidate under fresh guarded IO.
+            // Bob is excluded from his own mix, so this supplies no candidate
+            // source audio and cannot fill the first-output hole at Bob.
+            room.nodes
+                .get_mut(&retained)
+                .unwrap()
+                .publish(9200)
+                .unwrap();
+            room.nodes.get_mut(&candidate).unwrap().hear(9200).await;
+            let post_cut_progress = true;
+            let first = room.nodes.get_mut(&retained).unwrap().out.try_recv().ok();
+            let first_output_present = first.is_some();
+            let mut first_mean = None;
+            if let Some(first) = first {
+                first
+                    .deliver(|f| {
+                        use rvoip_media_core::codec::factory::CodecFactory;
+                        let mut c = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+                        let pcm = c.decode(&f.payload).unwrap();
+                        first_mean = Some(
+                            pcm.samples.iter().map(|s| i32::from(*s)).sum::<i32>()
+                                / pcm.samples.len() as i32,
+                        );
+                        std::future::ready(Ok(()))
+                    })
+                    .await
+                    .unwrap();
+            }
+            let first_playable = first_mean.is_some_and(|m| (m - 5200).abs() < 400);
+            for n in room.nodes.values_mut() {
+                n.drain();
+            }
+            room.nodes
+                .get_mut(&candidate)
+                .unwrap()
+                .publish(6800)
+                .unwrap();
+            room.nodes.get_mut(&retained).unwrap().hear(6800).await;
+            let recovery = true;
+            let fresh_decoder = room
+                .orch
+                .staged_media_weak_owners_for_test(&room.session, &candidate)
+                .unwrap()
+                .into_iter()
+                .find(|(name, _)| *name == "mixer-decoder")
+                .unwrap()
+                .1;
+            let decoder_survived_fresh = private_decoder.ptr_eq(&fresh_decoder);
+            assert!(room.nodes.get_mut(&source).unwrap().publish(9000).is_err());
+            cuts.push(Cut {
+                direction,
+                operation: grant.intent.operation_id.clone(),
+                source: source.clone(),
+                candidate: candidate.clone(),
+                retained: retained.clone(),
+                decoder_transferred,
+                decoder_survived_fresh,
+                ready,
+                remote_delivered,
+                fresh_private_decode,
+                public_commit: true,
+                post_cut_progress,
+                old_removed,
+                old_codec_gone,
+                first_output_present,
+                first_mean,
+                first_playable,
+                recovery,
+                age_us,
+            });
+            drop(prepared);
+            drop(probe);
+            source = candidate;
+        }
+        cuts
+    })
+    .await;
+    let cleanup = room.close_originals().await;
+    drop(room);
+    assert!(
+        cleanup.iter().all(|v| *v),
+        "original managed controllers/conference/adapter/lifecycle work unjoined: {cleanup:?}"
+    );
+    let cuts = match work {
+        Ok(c) => c,
+        Err(e) => resume_unwind(e),
+    };
+    for c in &cuts {
+        eprintln!(
+            "managed_adoption_quantum direction={} operation={} source={} candidate={} retained={} decoder_transferred={} decoder_survived_fresh={} ready={} remote_delivered={} fresh_private_decode={} public_commit={} post_cut_progress={} old_removed={} old_codec_gone={} first_output_present={} first_mean={:?} first_playable={} recovery={} age_us={} originals_joined=true",
+            c.direction,
+            c.operation,
+            c.source,
+            c.candidate,
+            c.retained,
+            c.decoder_transferred,
+            c.decoder_survived_fresh,
+            c.ready,
+            c.remote_delivered,
+            c.fresh_private_decode,
+            c.public_commit,
+            c.post_cut_progress,
+            c.old_removed,
+            c.old_codec_gone,
+            c.first_output_present,
+            c.first_mean,
+            c.first_playable,
+            c.recovery,
+            c.age_us
+        );
+    }
+    assert_eq!(cuts.len(), 2);
+    assert!(
+        cuts.iter()
+            .all(|c| c.first_playable && c.decoder_transferred && c.decoder_survived_fresh),
+        "actual managed-root Ready input was discarded and no first playable ordinary source quantum survived forward/return publication"
+    );
+}
