+}
+#[derive(Clone)]
+struct ReplacementGrant {
+    world: Arc<World>,
+    domain: Arc<Domain>,
+    intent: ParticipantReplacementMutation,
+    until: tokio::time::Instant,
+    private_operation: Arc<std::sync::OnceLock<String>>,
+}
+#[derive(Clone)]
+enum Command {
+    Initial(Grant),
+    Resources {
+        root: ReplacementGrant,
+        pending: PreparedParticipantReplacement,
+    },
+    Audience {
+        root: ReplacementGrant,
+        plan: crate::staged_streams::audience::AudioAudiencePlan,
+    },
+    Prepare {
