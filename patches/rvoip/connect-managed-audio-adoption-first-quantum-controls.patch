+fn replacement_grant(held: &(dyn Any + Send + Sync)) -> Option<&ReplacementGrant> {
+    if let Some(root) = held.downcast_ref::<ReplacementGrant>() {
+        return Some(root);
+    }
+    match held.downcast_ref::<Command>()? {
+        Command::Resources { root, .. }
+        | Command::Audience { root, .. }
+        | Command::Prepare { root, .. } => Some(root),
+        _ => None,
+    }
+}
