+}
+impl ManagedRoute {
+    fn new() -> Arc<Self> {
+        let (events, receiver) = mpsc::channel(32);
+        Arc::new(Self {
+            live: Mutex::new(HashSet::new()),
+            prepared: Mutex::new(HashMap::new()),
+            activated: Mutex::new(HashSet::new()),
+            controllers: Mutex::new(HashMap::new()),
+            events,
+            receiver: Mutex::new(Some(receiver)),
+            lifecycle: AdapterLifecycleSinkSlot::default(),
+            allocations: AtomicUsize::new(0),
+            signals: AtomicUsize::new(0),
+            ends: AtomicUsize::new(0),
+        })
+    }
+}
+#[async_trait::async_trait]
+impl ConnectionAdapter for ManagedRoute {
+    fn supports_device_replacement_preparation(&self) -> bool {
+        true
+    }
+    fn prepare_device_replacement_connection(
+        &self,
+        request: &DeviceReplacementAdapterRequest,
+    ) -> crate::Result<DeviceReplacementAdapterRoute> {
+        let supplied = request
+            .context::<SignalContext>()
+            .ok_or(RvoipError::InvalidState(
+                "missing owned replacement context",
+            ))?;
+        let record = self.prepared.lock().unwrap();
+        let exact = record
+            .get(request.pending().binding().connection())
+            .ok_or(RvoipError::InvalidState("no owned replacement route"))?;
+        if !Arc::ptr_eq(&supplied, &exact.context)
+            || supplied.connection != *request.pending().binding().connection()
+            || supplied.session != *request.session()
+            || supplied.endpoint != *request.frozen_endpoint().endpoint()
+            || supplied.participant != *request.frozen_member().participant()
+            || request.pending().intent() != &supplied.intent
+        {
+            return Err(RvoipError::InvalidState("foreign replacement route"));
+        }
+        self.live
+            .lock()
+            .unwrap()
+            .insert(supplied.connection.clone());
+        Ok(DeviceReplacementAdapterRoute {
+            handle: exact.handle.clone(),
+            principal: supplied.principal.clone(),
+        })
+    }
+    fn device_replacement_signal_principal(
+        &self,
+        id: &ConnectionId,
+        context: &(dyn Any + Send + Sync),
+    ) -> Option<AuthenticatedPrincipal> {
+        let context = context.downcast_ref::<SignalContext>()?;
+        let records = self.prepared.lock().unwrap();
+        let owned = records.get(id)?;
+        (std::ptr::eq(context, owned.context.as_ref())
+            && id == &context.connection
+            && self.is_connection_live(id))
+        .then(|| context.principal.clone())
+    }
