 impl MediaConfig {
+    pub fn with_negotiated_rtcp_peer(mut self, peer: SocketAddr, mux: bool) -> Self {
+        self.parameters.insert(
+            "negotiated_rtcp_peer".into(),
+            format!("{}|{}", if mux { "mux" } else { "split" }, peer),
+        );
+        self
+    }
+    /// Unconfigured generic RTP uses its explicit multiplexed profile. SIP
+    /// installs the complete validated offer/answer result before media flow.
+    pub fn rtcp_peer(&self, rtp: SocketAddr) -> crate::error::Result<(SocketAddr, bool)> {
+        let Some(value) = self.parameters.get("negotiated_rtcp_peer") else {
+            return Ok((rtp, true));
+        };
+        let invalid = || crate::error::Error::config("invalid negotiated RTCP peer");
+        if value.len() > 128 {
+            return Err(invalid());
+        }
+        let (mode, address) = value.split_once('|').ok_or_else(invalid)?;
+        let mux = match mode {
+            "mux" => true,
+            "split" => false,
+            _ => return Err(invalid()),
+        };
+        let peer: SocketAddr = address.parse().map_err(|_| invalid())?;
+        if peer.port() == 0
+            || peer.is_ipv4() != rtp.is_ipv4()
+            || peer.ip().is_unspecified()
+            || peer.ip().is_multicast()
+            || (mux && peer != rtp)
+            || (!mux && peer == rtp)
+        {
+            return Err(invalid());
+        }
+        Ok((peer, mux))
+    }
