+#[cfg(test)]
+mod gate6_negotiated_rtcp_tests {
+    use super::*;
+    fn sdp(attributes: &str, port: u16) -> SdpSession {
+        format!("v=0\r\no=fixture 1 1 IN IP4 127.0.0.1\r\ns=fixture\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\nm=audio {port} RTP/AVP 0\r\na=rtpmap:0 PCMU/8000\r\n{attributes}").parse().unwrap()
+    }
+    #[test]
+    fn negotiated_rtcp_default_explicit_and_mux_peers() {
+        let rtp: SocketAddr = "127.0.0.1:22000".parse().unwrap();
+        assert_eq!(
+            negotiated_audio_rtcp_peer(
+                &sdp("a=rtcp:23000\r\n", 65535),
+                false,
+                "127.0.0.1:65535".parse().unwrap()
+            )
+            .unwrap(),
+            Some("127.0.0.1:23000".parse().unwrap())
+        );
+
+        assert_eq!(
+            negotiated_audio_rtcp_peer(&sdp("", 22000), false, rtp).unwrap(),
+            Some("127.0.0.1:22001".parse().unwrap())
+        );
+        assert_eq!(
+            negotiated_audio_rtcp_peer(
+                &sdp("a=rtcp:23000 IN IP4 127.0.0.2\r\n", 22000),
+                false,
+                rtp
+            )
+            .unwrap(),
+            Some("127.0.0.2:23000".parse().unwrap())
+        );
+        assert_eq!(
+            negotiated_audio_rtcp_peer(&sdp("a=rtcp-mux\r\n", 22000), true, rtp).unwrap(),
+            Some(rtp)
+        );
+    }
+    #[test]
+    fn negotiated_rtcp_invalid_or_ambiguous_split_peer_refuses() {
+        let rtp: SocketAddr = "127.0.0.1:22000".parse().unwrap();
+        for attributes in [
+            "a=rtcp:0\r\n",
+            "a=rtcp:22000\r\n",
+            "a=rtcp:23000 IN IP4 224.0.0.1\r\n",
+            "a=rtcp:23000 IN IP4 0.0.0.0\r\n",
+            "a=rtcp:23000 IN IP6 ::1\r\n",
+            "a=rtcp:23000\r\na=rtcp:24000\r\n",
+        ] {
+            assert!(
+                negotiated_audio_rtcp_peer(&sdp(attributes, 22000), false, rtp).is_err(),
+                "{attributes}"
+            );
+        }
+        assert!(negotiated_audio_rtcp_peer(
+            &sdp("", 65535),
+            false,
+            "127.0.0.1:65535".parse().unwrap()
+        )
+        .is_err());
+        assert_eq!(
+            negotiated_audio_rtcp_peer(&sdp("", 0), false, "127.0.0.1:0".parse().unwrap()).unwrap(),
+            None
+        );
+    }
+}
