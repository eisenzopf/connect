+        || peer == rtp
+        || peer.is_ipv4() != rtp.is_ipv4()
+        || peer.ip().is_unspecified()
+        || peer.ip().is_multicast()
+    {
+        return Err(bounded_sdp_failure("rtcp", "peer").into());
+    }
+    Ok(Some(peer))
+}
