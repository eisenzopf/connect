+fn negotiated_audio_rtcp_peer(
+    session: &SdpSession,
+    mux: bool,
+    rtp: SocketAddr,
+) -> SrtpDetailedResult<Option<SocketAddr>> {
+    if rtp.port() == 0 {
+        return Ok(None);
+    }
+    if mux {
+        return Ok(Some(rtp));
+    }
+    let media = session
+        .media_descriptions
+        .iter()
+        .find(|m| m.media.eq_ignore_ascii_case("audio"))
+        .ok_or_else(|| bounded_sdp_failure("rtcp", "missing-audio"))?;
+    let attrs: Vec<_> = media
+        .generic_attributes
+        .iter()
+        .filter_map(|a| {
+            if let ParsedAttribute::Rtcp(a) = a {
+                Some(a)
+            } else {
+                None
+            }
+        })
+        .collect();
+    if attrs.len() > 1 {
+        return Err(bounded_sdp_failure("rtcp", "duplicate").into());
+    }
+    let mut peer = SocketAddr::new(
+        rtp.ip(),
+        if let Some(a) = attrs.first() {
+            a.port
+        } else {
+            rtp.port()
+                .checked_add(1)
+                .ok_or_else(|| bounded_sdp_failure("rtcp", "port-overflow"))?
+        },
+    );
