+/// Ed25519 signer for the UCTP inline envelope form. Private key material is
+/// owned by this backend and never serialized or included in diagnostics.
+pub struct Sig9421Signer {
+    keyid: String,
+    key: ring::signature::Ed25519KeyPair,
+}
+impl Sig9421Signer {
+    pub fn ed25519(keyid: impl Into<String>, pkcs8: &[u8]) -> Result<Self, Sig9421Error> {
+        let keyid = keyid.into();
+        if keyid.is_empty() || keyid.len() > 256 || keyid.chars().any(char::is_control) {
+            return Err(Sig9421Error::KeyRejected);
+        }
+        let key = ring::signature::Ed25519KeyPair::from_pkcs8(pkcs8)
+            .map_err(|_| Sig9421Error::KeyRejected)?;
+        Ok(Self { keyid, key })
+    }
+
+    /// Sign all original fields, replacing only an existing signature member.
+    /// The caller supplies a fresh ID/timestamp and validates its wire schema.
+    pub fn sign(&self, envelope: &serde_json::Value) -> Result<serde_json::Value, Sig9421Error> {
+        let mut value = envelope.clone();
+        value
+            .as_object_mut()
+            .ok_or(Sig9421Error::MalformedEnvelope)?
+            .remove("signature");
+        let canonical = serde_jcs::to_vec(&value).map_err(|_| Sig9421Error::MalformedEnvelope)?;
+        if canonical.len() > DEFAULT_MAX_SIGNED_ENVELOPE_BYTES {
+            return Err(Sig9421Error::EnvelopeTooLarge);
+        }
+        let sig = base64::engine::general_purpose::URL_SAFE_NO_PAD
+            .encode(self.key.sign(&canonical).as_ref());
+        value["signature"] = serde_json::to_value(EnvelopeSignature {
+            keyid: self.keyid.clone(),
+            alg: "EdDSA".into(),
+            sig,
+        })
+        .map_err(|_| Sig9421Error::MalformedEnvelope)?;
+        Ok(value)
+    }
+}
+impl fmt::Debug for Sig9421Signer {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("Sig9421Signer(redacted)")
+    }
+}
