@@ -0,0 +1,728 @@
+//! Canonical server peer: profile-bound authentication and credential lifecycle.
+//! Own one instance per reliable physical peer and drive `run` or `handle` from
+//! one actor. This never delegates a command to a v1 coordinator.
+
+use super::{
+    auth_dispatch::*, payloads::*, select_application_profile, Envelope, Identifier, Scope,
+    APPLICATION_PROFILE,
+};
+use async_trait::async_trait;
+use bytes::Bytes;
+use futures::{SinkExt, StreamExt};
+use rvoip_auth_core::{
+    bearer::{opaque_session_token_matches, AuthenticatedPrincipal, ValidatedBearer},
+    sig9421::{Sig9421Error, Sig9421Signer, Sig9421Verifier},
+};
+use rvoip_core::identity::IdentityAssurance;
+use serde_json::{json, Value};
+use std::{fmt, sync::Arc, time::Duration};
+use tokio::{
+    io::{AsyncRead, AsyncWrite},
+    time::Instant,
+};
+use tokio_util::{
+    codec::{FramedRead, FramedWrite},
+    sync::CancellationToken,
+};
+
+pub const AUTHENTICATION_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// Installed policy must validate the credential's token ID/issued-at metadata,
+/// current subject/issuer/tenant, signing-key revocation, device ownership and
+/// resource grants. Identity resolution is not a payload-selected actor.
+#[async_trait]
+pub trait PeerAuthority: Send + Sync {
+    async fn identity(
+        &self,
+        credential: &ValidatedBearer,
+        device: &Device,
+    ) -> Result<Identifier, DispatchError>;
+    /// The guard must also keep this identity/device mapping current.
+    async fn acquire(
+        &self,
+        credential: &ValidatedBearer,
+        device: &Device,
+        identity: &Identifier,
+        envelope: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError>;
+    /// Acquire current authority for BOTH credentials and the unchanged
+    /// identity/device mapping, approving any effective grant-scope changes.
+    /// Intrinsic assurance provenance is checked separately before this call.
+    async fn refresh(
+        &self,
+        previous: &ValidatedBearer,
+        next: &ValidatedBearer,
+        device: &Device,
+        identity: &Identifier,
+        envelope: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError>;
+}
+
+pub struct PeerConfig {
+    pub methods: Arc<AuthenticationMethods>,
+    pub verifier: Arc<Sig9421Verifier>,
+    pub signer: Arc<Sig9421Signer>,
+    pub authority: Arc<dyn PeerAuthority>,
+    pub pending_capacity: usize,
+}
+
+struct BoundAuthority {
+    credential: Arc<ValidatedBearer>,
+    device: Device,
+    identity: Identifier,
+    policy: Arc<dyn PeerAuthority>,
+}
+#[async_trait]
+impl CurrentAuthority for BoundAuthority {
+    async fn acquire(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        envelope: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if !principal.has_same_owner(&self.credential.principal) {
+            return Err(DispatchError::Authority);
+        }
+        self.policy
+            .acquire(&self.credential, &self.device, &self.identity, envelope)
+            .await
+    }
+}
+
+struct Challenge {
+    id: String,
+    device: Device,
+    methods: Vec<String>,
+}
+struct Binding {
+    credential: Arc<ValidatedBearer>,
+    device: Device,
+    identity: Identifier,
+    token: String,
+    dispatch: AuthenticatedDispatch,
+    expires: Instant,
+    generation: u64,
+}
+enum State {
+    Hello,
+    Challenge(Challenge),
+    Authenticated(Binding),
+    Closed,
+}
+
+/// Holds current authority until bounded reliable writer admission completes.
+/// Callers using `handle` directly must retain this object through their write.
+pub struct PeerOutput {
+    envelopes: Vec<Envelope>,
+    _lease: Option<AuthorityLease>,
+}
+impl PeerOutput {
+    pub fn envelopes(&self) -> &[Envelope] {
+        &self.envelopes
+    }
+}
+impl fmt::Debug for PeerOutput {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("PeerOutput")
+            .field("envelopes", &self.envelopes)
+            .finish_non_exhaustive()
+    }
+}
+
+pub struct CanonicalPeer {
+    config: Arc<PeerConfig>,
+    state: State,
+    lifetime: CancellationToken,
+    auth_deadline: Instant,
+    failures: u8,
+}
+impl CanonicalPeer {
+    pub fn new(config: Arc<PeerConfig>, parent: CancellationToken) -> Result<Self, DispatchError> {
+        if config.pending_capacity == 0 || config.pending_capacity > 256 {
+            return Err(DispatchError::Capacity);
+        }
+        Ok(Self {
+            config,
+            state: State::Hello,
+            lifetime: parent.child_token(),
+            auth_deadline: Instant::now() + AUTHENTICATION_TIMEOUT,
+            failures: 0,
+        })
+    }
+    /// Bind sibling media/signaling work to this incarnation. Closing this peer
+    /// cancels that work without cancelling a shared parent endpoint.
+    pub fn cancellation(&self) -> CancellationToken {
+        self.lifetime.clone()
+    }
+    pub fn authenticated_identity(&self) -> Option<&Identifier> {
+        match &self.state {
+            State::Authenticated(binding)
+                if !binding.credential.principal.is_expired() && !self.lifetime.is_cancelled() =>
+            {
+                Some(&binding.identity)
+            }
+            _ => None,
+        }
+    }
+    pub fn generation(&self) -> Option<u64> {
+        match &self.state {
+            State::Authenticated(b) => Some(b.generation),
+            _ => None,
+        }
+    }
+    pub fn register_reply(
+        &self,
+        request: &Envelope,
+        deadline: Instant,
+    ) -> Result<ReplyTicket, DispatchError> {
+        match &self.state {
+            State::Authenticated(b) => b.dispatch.register_reply(request, deadline),
+            _ => Err(DispatchError::Authentication),
+        }
+    }
+    pub fn close(&mut self) {
+        self.lifetime.cancel();
+        self.state = State::Closed;
+    }
+    fn effective_deadline(&self) -> Instant {
+        match &self.state {
+            State::Authenticated(binding) => binding.expires,
+            State::Closed => Instant::now() + Duration::from_secs(1),
+            _ => self.auth_deadline,
+        }
+    }
+
+    pub async fn handle(
+        &mut self,
+        bytes: &[u8],
+        handler: &dyn AuthenticatedHandler,
+        requested: Instant,
+    ) -> Result<PeerOutput, DispatchError> {
+        if self.lifetime.is_cancelled() || matches!(self.state, State::Closed) {
+            return Err(DispatchError::Closed);
+        }
+        let deadline = requested
+            .min(self.effective_deadline())
+            .min(Instant::now() + MAX_DISPATCH_WAIT);
+        if deadline <= Instant::now() {
+            if self.effective_deadline() <= Instant::now() {
+                self.close();
+            }
+            return Err(DispatchError::Closed);
+        }
+        let lifetime = self.lifetime.clone();
+        let result = tokio::select! {
+            biased;
+            _ = lifetime.cancelled() => Err(DispatchError::Closed),
+            _ = tokio::time::sleep_until(deadline) => Err(DispatchError::Closed),
+            result = self.handle_inner(bytes, handler, deadline) => result,
+        };
+        if result.is_err() {
+            self.failures = self.failures.saturating_add(1);
+            if self.lifetime.is_cancelled()
+                || self.effective_deadline() <= Instant::now()
+                || (!matches!(self.state, State::Authenticated(_)) && self.failures >= 8)
+            {
+                self.close();
+            }
+        }
+        result
+    }
+
+    async fn handle_inner(
+        &mut self,
+        bytes: &[u8],
+        handler: &dyn AuthenticatedHandler,
+        deadline: Instant,
+    ) -> Result<PeerOutput, DispatchError> {
+        let envelope = Envelope::parse(bytes)?;
+        match &self.state {
+            State::Hello => {
+                let Payload::AuthHello(hello) = envelope.payload() else {
+                    return Err(DispatchError::Authentication);
+                };
+                require_unscoped(&envelope, false)?;
+                select_application_profile(hello)?;
+                let methods: Vec<String> = self
+                    .config
+                    .methods
+                    .advertised()
+                    .into_iter()
+                    .filter(|method| hello.auth_methods.iter().any(|offered| offered == method))
+                    .map(str::to_owned)
+                    .collect();
+                if methods.is_empty() {
+                    return Err(DispatchError::UnsupportedMethod);
+                }
+                let challenge = self.reply("auth.challenge", json!({"nonce":fresh_token(),"accepted_methods":methods,"server_capabilities":{"application_profiles":[APPLICATION_PROFILE],"envelope_versions":[2],"signing_algorithms":["EdDSA"],"signature_required":true}}), Some(&envelope))?;
+                self.state = State::Challenge(Challenge {
+                    id: challenge.id().into(),
+                    device: hello.device.clone(),
+                    methods,
+                });
+                Ok(output(vec![challenge], None))
+            }
+            State::Challenge(challenge) => {
+                let Payload::AuthResponse(response) = envelope.payload() else {
+                    return Err(DispatchError::Authentication);
+                };
+                require_unscoped(&envelope, true)?;
+                if envelope.scope(Scope::Reply) != Some(challenge.id.as_str()) {
+                    return Err(DispatchError::ReplyMismatch);
+                }
+                if !challenge.methods.contains(&response.method) {
+                    return Err(DispatchError::UnsupportedMethod);
+                }
+                let device = challenge.device.clone();
+                let credential = Arc::new(
+                    self.config
+                        .methods
+                        .authenticate_credential(
+                            &response.method,
+                            &response.credential,
+                            response.actor_token.as_deref(),
+                            deadline,
+                        )
+                        .await?,
+                );
+                self.verify(&credential.principal, &envelope).await?;
+                let identity = self.config.authority.identity(&credential, &device).await?;
+                let lease = self
+                    .config
+                    .authority
+                    .acquire(&credential, &device, &identity, &envelope)
+                    .await?;
+                let binding = self.binding(credential, device, identity, 1)?;
+                let session = self.session(&binding, &envelope)?;
+                self.state = State::Authenticated(binding);
+                Ok(output(vec![session], Some(lease)))
+            }
+            State::Authenticated(binding) => match envelope.payload() {
+                Payload::AuthRefresh(refresh) => {
+                    require_unscoped(&envelope, false)?;
+                    // Old credential/key must authorize its own replacement.
+                    drop(
+                        self.config
+                            .authority
+                            .acquire(
+                                &binding.credential,
+                                &binding.device,
+                                &binding.identity,
+                                &envelope,
+                            )
+                            .await?,
+                    );
+                    self.verify(&binding.credential.principal, &envelope)
+                        .await?;
+                    let credential = Arc::new(
+                        self.config
+                            .methods
+                            .authenticate_credential(
+                                &refresh.method,
+                                &refresh.credential,
+                                refresh.actor_token.as_deref(),
+                                deadline,
+                            )
+                            .await?,
+                    );
+                    if !binding
+                        .credential
+                        .principal
+                        .has_same_owner(&credential.principal)
+                        || !preserves_assurance(
+                            &binding.credential.principal,
+                            &credential.principal,
+                        )
+                    {
+                        return Err(DispatchError::Authentication);
+                    }
+                    let identity = self
+                        .config
+                        .authority
+                        .identity(&credential, &binding.device)
+                        .await?;
+                    if identity != binding.identity {
+                        return Err(DispatchError::Authentication);
+                    }
+                    let lease = self
+                        .config
+                        .authority
+                        .refresh(
+                            &binding.credential,
+                            &credential,
+                            &binding.device,
+                            &identity,
+                            &envelope,
+                        )
+                        .await?;
+                    // A failed refresh never replaces or closes the prior gate.
+                    // A successful one retires old waiters; it cannot lend new
+                    // credential authority to an old in-flight invocation.
+                    let next = self.binding(
+                        credential,
+                        binding.device.clone(),
+                        identity,
+                        binding
+                            .generation
+                            .checked_add(1)
+                            .ok_or(DispatchError::Capacity)?,
+                    )?;
+                    let session = self.session(&next, &envelope)?;
+                    self.state = State::Authenticated(next);
+                    Ok(output(vec![session], Some(lease)))
+                }
+                Payload::AuthKeepalive(keepalive) => {
+                    require_unscoped(&envelope, false)?;
+                    drop(
+                        self.config
+                            .authority
+                            .acquire(
+                                &binding.credential,
+                                &binding.device,
+                                &binding.identity,
+                                &envelope,
+                            )
+                            .await?,
+                    );
+                    self.verify(&binding.credential.principal, &envelope)
+                        .await?;
+                    if !opaque_session_token_matches(&binding.token, &keepalive.session_token) {
+                        return Err(DispatchError::Authentication);
+                    }
+                    let lease = self
+                        .config
+                        .authority
+                        .acquire(
+                            &binding.credential,
+                            &binding.device,
+                            &binding.identity,
+                            &envelope,
+                        )
+                        .await?;
+                    let ack = self.reply("ack", json!({}), Some(&envelope))?;
+                    Ok(output(vec![ack], Some(lease)))
+                }
+                Payload::AuthBye(_) => {
+                    require_unscoped(&envelope, false)?;
+                    self.verify(&binding.credential.principal, &envelope)
+                        .await?;
+                    let lease = self
+                        .config
+                        .authority
+                        .acquire(
+                            &binding.credential,
+                            &binding.device,
+                            &binding.identity,
+                            &envelope,
+                        )
+                        .await?;
+                    let ack = self.reply("ack", json!({}), Some(&envelope))?;
+                    self.close();
+                    Ok(output(vec![ack], Some(lease)))
+                }
+                _ => {
+                    let result = binding.dispatch.dispatch(bytes, handler, deadline).await?;
+                    match result {
+                        DispatchOutcome::ReplyDelivered => Ok(output(Vec::new(), None)),
+                        DispatchOutcome::Handled(reply) => {
+                            let lease = self
+                                .config
+                                .authority
+                                .acquire(
+                                    &binding.credential,
+                                    &binding.device,
+                                    &binding.identity,
+                                    &envelope,
+                                )
+                                .await?;
+                            // Handler routing/correlation cannot replace the
+                            // invocation's authenticated scope or fresh wire ID.
+                            let mut value = reply.original().clone();
+                            value["id"] = json!(fresh_id());
+                            value["ts"] = json!(chrono::Utc::now());
+                            value["in_reply_to"] = json!(envelope.id());
+                            for field in ["cid", "sid", "connid", "operation_id"] {
+                                if let Some(value_in) = envelope.original().get(field) {
+                                    value[field] = value_in.clone();
+                                }
+                            }
+                            let reply = self.signed(value)?;
+                            Ok(output(vec![reply], Some(lease)))
+                        }
+                    }
+                }
+            },
+            State::Closed => Err(DispatchError::Closed),
+        }
+    }
+
+    fn binding(
+        &self,
+        credential: Arc<ValidatedBearer>,
+        device: Device,
+        identity: Identifier,
+        generation: u64,
+    ) -> Result<Binding, DispatchError> {
+        let expiry = credential_expiry(&credential.principal)?;
+        let dispatch = AuthenticatedDispatch::new(
+            credential.principal.clone(),
+            self.config.verifier.clone(),
+            Arc::new(BoundAuthority {
+                credential: credential.clone(),
+                device: device.clone(),
+                identity: identity.clone(),
+                policy: self.config.authority.clone(),
+            }),
+            self.lifetime.clone(),
+            self.config.pending_capacity,
+        )?;
+        Ok(Binding {
+            credential,
+            device,
+            identity,
+            token: fresh_token(),
+            dispatch,
+            expires: expiry,
+            generation,
+        })
+    }
+    async fn verify(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        envelope: &Envelope,
+    ) -> Result<(), DispatchError> {
+        self.config
+            .verifier
+            .verify_for_principal(envelope.original(), principal)
+            .await
+            .map_err(|error| match error {
+                Sig9421Error::ReplayDetected(_) => DispatchError::Replay,
+                Sig9421Error::ReplayStoreUnavailable => DispatchError::ReplayUnavailable,
+                _ => DispatchError::Signature,
+            })
+    }
+    fn session(&self, binding: &Binding, request: &Envelope) -> Result<Envelope, DispatchError> {
+        self.reply("auth.session", json!({"identity_id":binding.identity,"session_token":binding.token,"expires_at":effective_expiry(&binding.credential.principal)?,"assurance":binding.credential.principal.assurance.kind(),"application_profile":APPLICATION_PROFILE}), Some(request))
+    }
+    fn signed(&self, value: Value) -> Result<Envelope, DispatchError> {
+        let envelope = Envelope::from_value(value)?;
+        Envelope::from_value(
+            self.config
+                .signer
+                .sign(envelope.original())
+                .map_err(|_| DispatchError::Signature)?,
+        )
+        .map_err(DispatchError::from)
+    }
+    fn reply(
+        &self,
+        kind: &str,
+        payload: Value,
+        request: Option<&Envelope>,
+    ) -> Result<Envelope, DispatchError> {
+        let mut value =
+            json!({"v":2,"type":kind,"id":fresh_id(),"ts":chrono::Utc::now(),"payload":payload});
+        if let Some(request) = request {
+            value["in_reply_to"] = json!(request.id());
+            for field in ["cid", "sid", "connid", "operation_id"] {
+                if let Some(item) = request.original().get(field) {
+                    value[field] = item.clone();
+                }
+            }
+        }
+        self.signed(value)
+    }
+
+    /// Canonical length-prefixed server loop for an already negotiated secure
+    /// reliable stream. Its caller must enforce ALPN/profile ownership and TLS.
+    /// EOF, expiry, cancellation and write failure retire this peer's lifetime.
+    pub async fn run<R, W>(
+        mut self,
+        reader: R,
+        writer: W,
+        handler: &dyn AuthenticatedHandler,
+    ) -> Result<(), DispatchError>
+    where
+        R: AsyncRead + Send + Unpin,
+        W: AsyncWrite + Send + Unpin,
+    {
+        let mut reader = FramedRead::new(reader, crate::substrate::length_prefixed_codec());
+        let mut writer = FramedWrite::new(writer, crate::substrate::length_prefixed_codec());
+        loop {
+            let frame = tokio::select! {
+                biased;
+                _ = self.lifetime.cancelled() => return Err(DispatchError::Closed),
+                _ = tokio::time::sleep_until(self.effective_deadline()) => {
+                    if matches!(self.state, State::Authenticated(_)) {
+                        let bye = self.reply("auth.bye", json!({"reason":"session-expired"}), None)?;
+                        let _ = tokio::time::timeout(Duration::from_secs(1), writer.send(Bytes::from(serde_json::to_vec(&bye).map_err(|_| DispatchError::Closed)?))).await;
+                    }
+                    return Err(DispatchError::Closed);
+                }
+                frame = reader.next() => frame,
+            };
+            let Some(frame) = frame else {
+                return Ok(());
+            };
+            let frame = frame.map_err(|_| DispatchError::Closed)?;
+            let output = match self
+                .handle(&frame, handler, Instant::now() + MAX_DISPATCH_WAIT)
+                .await
+            {
+                Ok(output) => output,
+                Err(error) => {
+                    if matches!(self.state, State::Closed) {
+                        return Err(error);
+                    }
+                    // Correlate only a validated envelope. Never echo malformed
+                    // JSON or credential/payload content into a problem.
+                    let request = Envelope::parse(&frame).ok();
+                    output(
+                        vec![self.reply(
+                            "error",
+                            json!({"code":error_code(error),"category":"auth","reason":error_reason(error)}),
+                            request.as_ref(),
+                        )?],
+                        None,
+                    )
+                }
+            };
+            for envelope in output.envelopes() {
+                let bytes = serde_json::to_vec(envelope).map_err(|_| DispatchError::Closed)?;
+                let deadline = self
+                    .effective_deadline()
+                    .min(Instant::now() + MAX_DISPATCH_WAIT);
+                tokio::select! {
+                    biased;
+                    _ = self.lifetime.cancelled(), if !matches!(self.state, State::Closed) => return Err(DispatchError::Closed),
+                    _ = tokio::time::sleep_until(deadline) => return Err(DispatchError::Closed),
+                    result = writer.send(Bytes::from(bytes)) => result.map_err(|_| DispatchError::Closed)?,
+                }
+            }
+            if matches!(self.state, State::Closed) {
+                return Ok(());
+            }
+        }
+    }
+}
+impl Drop for CanonicalPeer {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+fn output(envelopes: Vec<Envelope>, lease: Option<AuthorityLease>) -> PeerOutput {
+    PeerOutput {
+        envelopes,
+        _lease: lease,
+    }
+}
+fn fresh_id() -> String {
+    format!("env_{}", uuid::Uuid::new_v4().simple())
+}
+fn fresh_token() -> String {
+    format!(
+        "{}{}",
+        uuid::Uuid::new_v4().simple(),
+        uuid::Uuid::new_v4().simple()
+    )
+}
+fn require_unscoped(envelope: &Envelope, reply: bool) -> Result<(), DispatchError> {
+    if [
+        Scope::Conversation,
+        Scope::Session,
+        Scope::Connection,
+        Scope::Operation,
+    ]
+    .iter()
+    .any(|field| envelope.scope(*field).is_some())
+        || (!reply && envelope.scope(Scope::Reply).is_some())
+    {
+        return Err(DispatchError::ReplyMismatch);
+    }
+    Ok(())
+}
+fn effective_expiry(
+    principal: &AuthenticatedPrincipal,
+) -> Result<chrono::DateTime<chrono::Utc>, DispatchError> {
+    super::auth_dispatch::checked_principal(principal.clone())?;
+    let mut expiry = principal.expires_at.ok_or(DispatchError::Authentication)?;
+    if let IdentityAssurance::TaskScoped { expires_at, .. } = &principal.assurance {
+        expiry = expiry.min(*expires_at);
+    }
+    Ok(expiry)
+}
+fn credential_expiry(principal: &AuthenticatedPrincipal) -> Result<Instant, DispatchError> {
+    let duration = (effective_expiry(principal)? - chrono::Utc::now())
+        .to_std()
+        .map_err(|_| DispatchError::Authentication)?;
+    Instant::now()
+        .checked_add(duration)
+        .ok_or(DispatchError::Authentication)
+}
+/// Refresh cannot assert a different assurance class or delegation provenance.
+/// Step-up needs its own correlated, verified transition rather than a rank.
+fn preserves_assurance(previous: &AuthenticatedPrincipal, next: &AuthenticatedPrincipal) -> bool {
+    if previous.method != next.method {
+        return false;
+    }
+    match (&previous.assurance, &next.assurance) {
+        (
+            IdentityAssurance::Identified { credential_kind: a },
+            IdentityAssurance::Identified { credential_kind: b },
+        ) => a == b,
+        (
+            IdentityAssurance::TaskScoped {
+                identity: a,
+                task_id: at,
+                scopes: as_,
+                ..
+            },
+            IdentityAssurance::TaskScoped {
+                identity: b,
+                task_id: bt,
+                scopes: bs,
+                ..
+            },
+        ) => a == b && at == bt && same_scopes(as_, bs),
+        (
+            IdentityAssurance::UserAuthorized {
+                identity: a,
+                user_id: au,
+                scopes: as_,
+            },
+            IdentityAssurance::UserAuthorized {
+                identity: b,
+                user_id: bu,
+                scopes: bs,
+            },
+        ) => a == b && au == bu && same_scopes(as_, bs),
+        _ => false,
+    }
+}
+fn same_scopes(a: &[String], b: &[String]) -> bool {
+    a.iter().collect::<std::collections::BTreeSet<_>>()
+        == b.iter().collect::<std::collections::BTreeSet<_>>()
+}
+fn error_reason(error: DispatchError) -> &'static str {
+    match error {
+        DispatchError::Replay => "envelope_replay",
+        DispatchError::ReplyMismatch => "reply_scope_mismatch",
+        DispatchError::UnsupportedMethod => "unsupported_auth_method",
+        DispatchError::Wire(_) => "invalid_envelope",
+        DispatchError::Unsupported => "unsupported_feature",
+        _ => "authentication_failed",
+    }
+}
+
+fn error_code(error: DispatchError) -> u16 {
+    match error {
+        DispatchError::Authority => 403,
+        DispatchError::Wire(
+            super::WireError::UnsupportedVersion | super::WireError::UnsupportedProfile,
+        ) => 426,
+        DispatchError::Wire(_) | DispatchError::ReplyMismatch => 400,
+        DispatchError::Unsupported => 501,
+        DispatchError::Capacity => 429,
+        DispatchError::Closed => 408,
+        _ => 401,
+    }
+}
