+}
+
+#[tokio::test]
+async fn keepalive_token_is_not_portable_to_another_authenticated_peer() {
+    let f = Fixture::new();
+    let mut first = f.peer();
+    let mut second = f.peer();
+    let h = Handler::default();
+    let session = f.authenticate(&mut first, "old").await;
+    f.authenticate(&mut second, "old").await;
+    let token = session.original()["payload"]["session_token"].clone();
+    assert_eq!(
+        second
+            .handle(
+                &f.sign(envelope("auth.keepalive", json!({"session_token":token}))),
+                &h,
+                deadline()
+            )
+            .await
+            .unwrap_err(),
+        DispatchError::Authentication
+    );
+    assert_eq!(second.generation(), Some(1));
+    assert_eq!(h.calls.load(Ordering::SeqCst), 0);
+}
