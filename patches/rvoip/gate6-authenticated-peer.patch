index 0000000..a185d97
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/tests/v2_auth_peer.rs
@@ -0,0 +1,976 @@
+//! Canonical handshake/lifecycle backend and real local uctp/2 TLS/QUIC.
+use async_trait::async_trait;
+use bytes::Bytes;
+use chrono::Utc;
+use futures::{SinkExt, StreamExt};
+use ring::signature::{Ed25519KeyPair, KeyPair};
+use rvoip_auth_core::{
+    bearer::{
+        AuthenticatedPrincipal, AuthenticationMethod, BearerAuthError, BearerValidator,
+        ValidatedBearer,
+    },
+    sig9421::{KeyResolver, ResolvedVerificationKey, Sig9421Signer, Sig9421Verifier},
+};
+use rvoip_core::identity::{CredentialKind, IdentityAssurance};
+use rvoip_uctp::v2::{
+    auth_dispatch::*, auth_peer::*, payloads::Device, Envelope, Identifier, Scope, RAW_QUIC_ALPN,
+};
+use serde_json::{json, Value};
+use std::{
+    collections::HashSet,
+    sync::{
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+use tokio::{
+    sync::{Notify, RwLock},
+    time::Instant,
+};
+use tokio_util::{
+    codec::{FramedRead, FramedWrite},
+    sync::CancellationToken,
+};
+
+fn deadline() -> Instant {
+    Instant::now() + Duration::from_secs(3)
+}
+fn envelope(kind: &str, payload: Value) -> Value {
+    json!({"v":2,"type":kind,"id":format!("env_{}",uuid::Uuid::new_v4().simple()),"ts":Utc::now(),"payload":payload})
+}
+fn hello() -> Value {
+    envelope(
+        "auth.hello",
+        json!({"device":{"id":"device-alice","kind":"desktop","platform":"fixture","sdk_version":"fixture"},"auth_methods":["unknown","bearer","aauth"],"application_profiles":["connect/2"]}),
+    )
+}
+fn response(challenge: &Envelope, token: &str) -> Value {
+    let mut v = envelope(
+        "auth.response",
+        json!({"method":"bearer","credential":token}),
+    );
+    v["in_reply_to"] = json!(challenge.id());
+    v
+}
+fn command() -> Value {
+    let mut v = envelope("connection.update", json!({"action":"hold"}));
+    v["cid"] = json!("conversation");
+    v["sid"] = json!("session");
+    v["connid"] = json!("connection");
+    v["operation_id"] = json!("logical-op");
+    v["expected_revision"] = json!(1);
+    v
+}
+fn principal(token: &str) -> AuthenticatedPrincipal {
+    let mut p = AuthenticatedPrincipal {
+        subject: "alice".into(),
+        tenant: Some("tenant".into()),
+        issuer: Some("issuer".into()),
+        scopes: vec!["control".into()],
+        expires_at: Some(Utc::now() + chrono::Duration::hours(1)),
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Identified {
+            credential_kind: CredentialKind::Oidc,
+        },
+    };
+    match token {
+        "bob" => p.subject = "bob".into(),
+        "other-tenant" => p.tenant = Some("other".into()),
+        "other-issuer" => p.issuer = Some("other".into()),
+        "expired" => p.expires_at = Some(Utc::now() - chrono::Duration::seconds(1)),
+        "no-expiry" => p.expires_at = None,
+        "short" => p.expires_at = Some(Utc::now() + chrono::Duration::seconds(1)),
+        "reduced" => p.scopes.clear(),
+        "user" | "user-new" => {
+            p.assurance = IdentityAssurance::UserAuthorized {
+                identity: rvoip_core::IdentityId::from_string("identity-alice"),
+                user_id: rvoip_core::IdentityId::from_string("user-alice"),
+                scopes: vec!["control".into()],
+            }
+        }
+        "wrong-user" => {
+            p.assurance = IdentityAssurance::UserAuthorized {
+                identity: rvoip_core::IdentityId::from_string("identity-alice"),
+                user_id: rvoip_core::IdentityId::from_string("user-bob"),
+                scopes: vec!["control".into()],
+            }
+        }
+        _ => {}
+    };
+    p
+}
+struct Validator {
+    calls: AtomicUsize,
+    hold: AtomicBool,
+    entered: Notify,
+    release: Notify,
+}
+#[async_trait]
+impl BearerValidator for Validator {
+    async fn validate(&self, token: &str) -> Result<IdentityAssurance, BearerAuthError> {
+        Ok(principal(token).assurance)
+    }
+    async fn validate_credential(&self, token: &str) -> Result<ValidatedBearer, BearerAuthError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.hold.load(Ordering::SeqCst) {
+            self.entered.notify_one();
+            self.release.notified().await;
+        }
+        if token == "unavailable" {
+            return Err(BearerAuthError::Unavailable(
+                "private-provider-detail".into(),
+            ));
+        }
+        ValidatedBearer::new(
+            principal(token),
+            Some(token.into()),
+            Some(std::time::SystemTime::now() - Duration::from_secs(1)),
+        )
+    }
+}
+#[derive(Default)]
+struct Policy {
+    revoked: Arc<RwLock<HashSet<String>>>,
+    deny_refresh: AtomicBool,
+    calls: AtomicUsize,
+}
+impl Policy {
+    async fn guard(
+        &self,
+        c: &ValidatedBearer,
+        device: &Device,
+        id: &Identifier,
+        env: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        let guard = self.revoked.clone().read_owned().await;
+        if c.token_id
+            .as_ref()
+            .is_none_or(|token| guard.contains(token))
+            || c.issued_at.is_none()
+            || c.principal.is_expired()
+            || device.id.as_str() != "device-alice"
+            || id.as_str() != "identity-alice"
+            || (env.kind() == "connection.update" && !c.principal.has_scope("control"))
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(guard))
+    }
+}
+#[async_trait]
+impl PeerAuthority for Policy {
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        if c.principal.subject != "alice" || d.id.as_str() != "device-alice" {
+            return Err(DispatchError::Authority);
+        }
+        Identifier::try_from("identity-alice".to_owned()).map_err(DispatchError::from)
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.guard(c, d, i, e).await
+    }
+    async fn refresh(
+        &self,
+        old: &ValidatedBearer,
+        new: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if self.deny_refresh.load(Ordering::SeqCst) {
+            return Err(DispatchError::Authority);
+        }
+        let lease = self.guard(new, d, i, e).await?;
+        if old.token_id.as_ref().is_none_or(|token| {
+            self.revoked
+                .try_read()
+                .map_or(true, |set| set.contains(token))
+        }) {
+            return Err(DispatchError::Authority);
+        }
+        Ok(lease)
+    }
+}
+struct Keys {
+    client: Vec<u8>,
+    server: Vec<u8>,
+}
+impl KeyResolver for Keys {
+    fn resolve(&self, _: &str) -> Option<Vec<u8>> {
+        None
+    }
+    fn resolve_for_principal(
+        &self,
+        p: &AuthenticatedPrincipal,
+        k: &str,
+        a: &str,
+        _: chrono::DateTime<Utc>,
+    ) -> Option<ResolvedVerificationKey> {
+        if p.tenant.as_deref() != Some("tenant")
+            || p.issuer.as_deref() != Some("issuer")
+            || a != "EdDSA"
+        {
+            return None;
+        }
+        let bytes = match (p.subject.as_str(), k) {
+            ("alice", "client") => self.client.clone(),
+            ("server", "server") => self.server.clone(),
+            _ => return None,
+        };
+        Some(ResolvedVerificationKey {
+            public_key: bytes,
+            algorithm: "EdDSA".into(),
+            not_before: None,
+            expires_at: None,
+            revoked: false,
+        })
+    }
+}
+#[derive(Default)]
+struct Handler {
+    calls: AtomicUsize,
+}
+#[async_trait]
+impl AuthenticatedHandler for Handler {
+    async fn handle(&self, env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        assert_eq!(env.principal().subject, "alice");
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Envelope::from_value(envelope("ack", json!({}))).map_err(DispatchError::from)
+    }
+}
+struct Fixture {
+    config: Arc<PeerConfig>,
+    client: Sig9421Signer,
+    server_verify: Sig9421Verifier,
+    policy: Arc<Policy>,
+    validator: Arc<Validator>,
+}
+impl Fixture {
+    fn new() -> Self {
+        let client_key = Ed25519KeyPair::generate_pkcs8(&ring::rand::SystemRandom::new()).unwrap();
+        let server_key = Ed25519KeyPair::generate_pkcs8(&ring::rand::SystemRandom::new()).unwrap();
+        let client = Sig9421Signer::ed25519("client", client_key.as_ref()).unwrap();
+        let server = Sig9421Signer::ed25519("server", server_key.as_ref()).unwrap();
+        let resolver = Arc::new(Keys {
+            client: Ed25519KeyPair::from_pkcs8(client_key.as_ref())
+                .unwrap()
+                .public_key()
+                .as_ref()
+                .to_vec(),
+            server: Ed25519KeyPair::from_pkcs8(server_key.as_ref())
+                .unwrap()
+                .public_key()
+                .as_ref()
+                .to_vec(),
+        });
+        let validator = Arc::new(Validator {
+            calls: AtomicUsize::new(0),
+            hold: AtomicBool::new(false),
+            entered: Notify::new(),
+            release: Notify::new(),
+        });
+        let policy = Arc::new(Policy::default());
+        let config = Arc::new(PeerConfig {
+            methods: Arc::new(AuthenticationMethods::new(Some(validator.clone()))),
+            verifier: Arc::new(Sig9421Verifier::new(resolver.clone())),
+            signer: Arc::new(server),
+            authority: policy.clone(),
+            pending_capacity: 2,
+        });
+        Self {
+            config,
+            client,
+            server_verify: Sig9421Verifier::new(resolver),
+            policy,
+            validator,
+        }
+    }
+    fn peer(&self) -> CanonicalPeer {
+        CanonicalPeer::new(self.config.clone(), CancellationToken::new()).unwrap()
+    }
+    fn sign(&self, v: Value) -> Vec<u8> {
+        serde_json::to_vec(&self.client.sign(&v).unwrap()).unwrap()
+    }
+    async fn authenticate(&self, peer: &mut CanonicalPeer, token: &str) -> Envelope {
+        let output = peer
+            .handle(
+                &serde_json::to_vec(&hello()).unwrap(),
+                &Handler::default(),
+                deadline(),
+            )
+            .await
+            .unwrap();
+        let challenge = output.envelopes()[0].clone();
+        drop(output);
+        let output = peer
+            .handle(
+                &self.sign(response(&challenge, token)),
+                &Handler::default(),
+                deadline(),
+            )
+            .await
