+/// Compare bounded opaque peer session tokens without content-dependent timing.
+/// This does not validate a credential, grant access or permit peer resumption.
+pub fn opaque_session_token_matches(expected: &str, supplied: &str) -> bool {
+    use subtle::ConstantTimeEq;
+    !expected.is_empty()
+        && expected.len() <= 512
+        && expected.len() == supplied.len()
+        && bool::from(expected.as_bytes().ct_eq(supplied.as_bytes()))
+}
