+struct FaultAdapter {
+    inner: Arc<CanonicalNativeAdapter>,
+    mode: AtomicUsize,
+    hold_end: AtomicBool,
+    accepted: AtomicUsize,
+    stream: Arc<core_fixture::TestStream>,
+}
+#[async_trait]
+impl ConnectionAdapter for FaultAdapter {
+    fn transport(&self) -> Transport {
+        self.inner.transport()
+    }
+    fn kind(&self) -> AdapterKind {
+        self.inner.kind()
+    }
+    fn lifecycle_capabilities(&self) -> AdapterLifecycleCapabilities {
+        self.inner.lifecycle_capabilities()
+    }
+    fn supports_peer_native_preparation(&self) -> bool {
+        true
+    }
+    fn prepare_peer_native_connection(
+        &self,
+        r: &NativeConnectionRequest,
+    ) -> CoreResult<ConnectionHandle> {
+        assert!(r.peer().snapshot().connections >= 1);
+        let handle = self.inner.prepare_peer_native_connection(r)?;
+        match self.mode.load(Ordering::Acquire) {
+            1 => Err(RvoipError::Adapter("controlled allocation failure".into())),
+            2 => panic!("controlled allocation panic"),
+            _ => Ok(handle),
+        }
+    }
+    fn is_peer_native_preparation_current(
+        &self,
+        id: &ConnectionId,
+        p: &Arc<PeerAdmission>,
+    ) -> bool {
+        self.inner.is_peer_native_preparation_current(id, p)
+    }
+    fn install_lifecycle_sink(&self, s: Arc<dyn AdapterLifecycleSink>) -> CoreResult<()> {
+        self.inner.install_lifecycle_sink(s)
+    }
+    fn is_connection_live(&self, id: &ConnectionId) -> bool {
+        self.inner.is_connection_live(id)
+    }
+    async fn originate(&self, r: OriginateRequest) -> CoreResult<ConnectionHandle> {
+        self.inner.originate(r).await
+    }
+    async fn accept(&self, _: ConnectionId) -> CoreResult<()> {
+        self.accepted.fetch_add(1, Ordering::AcqRel);
+        Ok(())
+    }
+    async fn reject(&self, id: ConnectionId, _: RejectReason) -> CoreResult<()> {
+        self.end(id, EndReason::Normal).await
+    }
+    async fn end(&self, id: ConnectionId, r: EndReason) -> CoreResult<()> {
+        if self.hold_end.load(Ordering::Acquire) {
+            Err(RvoipError::Adapter("controlled cleanup uncertainty".into()))
+        } else {
+            self.inner.end(id, r).await
+        }
+    }
+    async fn hold(&self, id: ConnectionId) -> CoreResult<()> {
+        self.inner.hold(id).await
+    }
+    async fn resume(&self, id: ConnectionId) -> CoreResult<()> {
+        self.inner.resume(id).await
+    }
+    async fn transfer(&self, id: ConnectionId, t: TransferTarget) -> CoreResult<()> {
+        self.inner.transfer(id, t).await
+    }
+    async fn streams(&self, id: ConnectionId) -> CoreResult<Vec<Arc<dyn MediaStream>>> {
+        self.inner.physical_source(&id)?;
+        Ok(vec![self.stream.clone()])
+    }
+    async fn send_message(&self, id: ConnectionId, m: Message) -> CoreResult<()> {
+        self.inner.send_message(id, m).await
+    }
+    async fn send_dtmf(&self, id: ConnectionId, d: &str, t: u32) -> CoreResult<()> {
+        self.inner.send_dtmf(id, d, t).await
+    }
+    async fn renegotiate_media(
+        &self,
+        id: ConnectionId,
+        c: rvoip_core::capability::CapabilityDescriptor,
+    ) -> CoreResult<rvoip_core::capability::NegotiatedCodecs> {
+        self.inner.renegotiate_media(id, c).await
+    }
+    async fn verify_request_signature(
+        &self,
+        id: ConnectionId,
+        s: SignatureHeaders,
+    ) -> CoreResult<IdentityAssurance> {
+        self.inner.verify_request_signature(id, s).await
+    }
+    fn subscribe_events(&self) -> mpsc::Receiver<AdapterEvent> {
+        self.inner.subscribe_events()
+    }
+    fn subscribe_orchestrator_events(&self) -> mpsc::Receiver<OrchestratorAdapterEvent> {
+        self.inner.subscribe_orchestrator_events()
+    }
+    fn capabilities(&self) -> rvoip_core::capability::CapabilityDescriptor {
+        self.inner.capabilities()
+    }
+}
