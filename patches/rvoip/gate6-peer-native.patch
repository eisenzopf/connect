+                .await;
+                assert_eq!(wire.read().await.kind(), "auth.session");
+            }
+            wire.send(f.sign(native_offer(n, kind))).await;
+            let reply = wire.read().await;
+            assert_eq!(reply.kind(), "ack");
+            f.verify_server(&reply).await;
+        }
+        let record = factory.records.lock().unwrap()[0].clone();
+        let p = record.peer.lock().unwrap().clone().unwrap();
+        assert_eq!(p.snapshot().connections, 64);
+        assert_eq!(p.snapshot().sessions, 1);
+        assert_eq!(record.connections.lock().unwrap().len(), 64);
+        let transport = match kind {
+            "quic" => Transport::Quic,
+            "wt" => Transport::WebTransport,
+            _ => Transport::WebSocket,
+        };
+        let adapter = &factory.adapters[&transport];
+        assert_eq!(adapter.total_allocations(), 64);
+        wire.send(f.sign(native_offer(64, kind))).await;
+        let error = wire.read().await;
+        assert_eq!(error.kind(), "error");
+        assert_eq!(adapter.total_allocations(), 64);
+        assert_eq!(adapter.route_count(), 64);
+        assert_eq!(p.snapshot().connections, 64);
+        assert_eq!(
+            factory
+                .core
+                .orch
+                .participant_capacity(&factory.core.session)
+                .unwrap(),
+            (0, 0)
+        );
+        wire.server.shutdown().await.unwrap();
+        core_fixture::until(|| adapter.route_count() == 0 && p.snapshot().connections == 0).await;
+        assert_eq!(
+            factory
+                .core
+                .orch
+                .session(&factory.core.session)
+                .unwrap()
+                .read()
+                .unwrap()
+                .state,
+            SessionState::Initiating
+        );
+    }
+}
+#[tokio::test]
+async fn rejected_tls_upgrade_never_creates_a_physical_handler_or_native_route() {
+    for kind in ["wt", "ws"] {
+        let (_, factory, _) = wire_setup().await;
+        let f = Fixture::new();
+        let profile = CanonicalProfile::new(f.config.clone(), Arc::new(Handler::default()), 8)
+            .unwrap()
+            .with_physical_handlers(factory.clone());
+        assert!(
+            wire(kind, profile, "/wrong", Some("https://allowed.example"))
+                .await
+                .is_err()
+        );
+        assert!(factory.records.lock().unwrap().is_empty());
+        assert!(factory
+            .adapters
+            .values()
+            .all(|a| a.total_allocations() == 0));
+    }
+}
+#[tokio::test]
+async fn native_cross_core_reuse_is_denied_before_second_adapter_allocation() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    retain(&f, &o.peer(), intent(&f, kind), &physical(kind)).unwrap();
+    let (other, b) = fixture(kind).await;
+    assert!(matches!(
+        prepare(&other, &o.peer(), intent(&other, kind), &physical(kind)),
+        Err(PeerNativeError::Authority)
+    ));
+    assert_eq!(a.total_allocations(), 1);
+    assert_eq!(b.total_allocations(), 0);
+    assert_eq!(o.peer().snapshot().connections, 1);
+}
+#[tokio::test]
+async fn claimed_wire_substrate_cannot_replace_the_actual_tls_transport() {
+    for kind in ["quic", "wt", "ws"] {
+        let (f, factory, _) = wire_setup().await;
+        let profile = CanonicalProfile::new(f.config.clone(), Arc::new(Handler::default()), 8)
+            .unwrap()
+            .with_physical_handlers(factory.clone());
+        let mut wire = wire(kind, profile, "/uctp", Some("https://allowed.example"))
+            .await
+            .unwrap();
+        authenticate_wire(&mut wire, &f).await;
+        let mut request = native_offer(0, kind);
+        request["payload"]["substrate"] = json!(if kind == "quic" { "websocket" } else { "quic" });
+        wire.send(f.sign(request)).await;
+        assert_eq!(wire.read().await.kind(), "error");
+        assert!(factory
+            .adapters
+            .values()
+            .all(|a| a.total_allocations() == 0));
+        wire.server.shutdown().await.unwrap();
+    }
+}
+#[tokio::test]
+async fn native_allocation_after_lifecycle_supervisor_drain_has_no_effect() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    f.orch.drain_connection_lifecycle_tasks().await;
+    assert!(matches!(
+        prepare(&f, &o.peer(), intent(&f, kind), &physical(kind)),
+        Err(PeerNativeError::Closed)
+    ));
+    assert_eq!(a.total_allocations(), 0);
+    assert_eq!(o.peer().snapshot().connections, 0);
+}
