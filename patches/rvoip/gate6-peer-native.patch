+++ b/crates/foundation/rvoip-core/src/orchestrator/peer_native.rs
@@ -0,0 +1,397 @@
+//! Core-owned native route IDs and quota, reserved before adapter allocation.
+//! Preparation is local and dormant; it is not media readiness or presence.
+use super::*;
+use crate::connection::ConnectionState;
+use crate::{
+    peer_admission::{PeerAdmission, PeerAdmissionError},
+    relationships::{EndpointBinding, Membership},
+};
+use std::any::Any;
+
+#[derive(Clone, PartialEq, Eq)]
+pub(super) struct NativePreparationScope {
+    session: SessionId,
+    participant: ParticipantId,
+    epoch: u64,
+    endpoint: crate::ids::EndpointId,
+}
+impl std::fmt::Debug for NativePreparationScope {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativePreparationScope(redacted)")
+    }
+}
+impl NativePreparationScope {
+    pub(super) fn matches(
+        &self,
+        session: &SessionId,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+    ) -> bool {
+        &self.session == session
+            && &self.participant == member.participant()
+            && self.epoch == member.epoch()
+            && &self.endpoint == endpoint.endpoint()
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+pub struct PeerNativeIntent {
+    pub session: SessionId,
+    pub connection: ConnectionId,
+    pub transport: Transport,
+}
+pub struct PeerNativeAuthority {
+    pub actor: Membership,
+    pub endpoint: EndpointBinding,
+    pub may_prepare: bool,
+}
+/// Trusted current policy composition. Hold the real grant/membership/device
+/// read guard through preparation/retention. A snapshot boolean is not a lease.
+pub trait PeerNativeAuthorityLease {
+    fn authority(&self) -> &PeerNativeAuthority;
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum PeerNativeError {
+    #[error("current native peer authority denied")]
+    Authority,
+    #[error("native peer capacity exhausted")]
+    Capacity,
+    #[error("native peer ID or route conflicts")]
+    Conflict,
+    #[error("native peer or Session closed")]
+    Closed,
+    #[error("native peer allocation unsupported")]
+    Unsupported,
+    #[error("native peer allocation failed")]
+    Adapter,
+}
+impl From<PeerAdmissionError> for PeerNativeError {
+    fn from(e: PeerAdmissionError) -> Self {
+        match e {
+            PeerAdmissionError::Authority => Self::Authority,
+            PeerAdmissionError::Capacity => Self::Capacity,
+            PeerAdmissionError::Conflict => Self::Conflict,
+            PeerAdmissionError::Closed => Self::Closed,
+        }
+    }
+}
+/// Only Core constructs requests. Adapter context is installed by the trusted
+/// physical transport factory, never deserialized from a wire body.
+pub struct NativeConnectionRequest {
+    intent: PeerNativeIntent,
+    peer: Arc<PeerAdmission>,
+    participant: ParticipantId,
+    context: Arc<dyn Any + Send + Sync>,
+    cancellation: CancellationToken,
+}
+impl NativeConnectionRequest {
+    pub fn intent(&self) -> &PeerNativeIntent {
+        &self.intent
+    }
+    pub fn peer(&self) -> &Arc<PeerAdmission> {
+        &self.peer
+    }
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn context<T: Any + Send + Sync>(&self) -> Option<Arc<T>> {
+        self.context.clone().downcast().ok()
+    }
+    pub fn cancellation(&self) -> CancellationToken {
+        self.cancellation.clone()
+    }
+}
+/// An unretained candidate retires on drop, including caller cancellation.
+/// Retention leaves a Connecting, peer-owned route; readiness and Participant
+/// admission remain separate checked operations.
+#[must_use = "drop retires this native candidate"]
+pub struct PreparedPeerNativeConnection {
+    owner: Weak<Orchestrator>,
+    peer: Arc<PeerAdmission>,
+    intent: PeerNativeIntent,
+    scope: NativePreparationScope,
+    retained: bool,
+}
+impl PreparedPeerNativeConnection {
+    pub fn connection_id(&self) -> &ConnectionId {
+        &self.intent.connection
+    }
+    pub fn retain(
+        mut self,
+        principal: &AuthenticatedPrincipal,
+        lease: &dyn PeerNativeAuthorityLease,
+    ) -> std::result::Result<ConnectionId, PeerNativeError> {
+        let core = self.owner.upgrade().ok_or(PeerNativeError::Closed)?;
+        let _serial = core
+            .externally_projected_sessions
+            .lock()
+            .expect("external projection lock poisoned");
+        let registry = core.peer_sessions.lock().unwrap_or_else(|p| p.into_inner());
+        core.check_native_authority(
+            &self.peer,
+            principal,
+            &self.intent,
+            lease.authority(),
+            &registry,
+        )?;
+        if !self.scope.matches(
+            &self.intent.session,
+            &lease.authority().actor,
+            &lease.authority().endpoint,
+        ) {
+            return Err(PeerNativeError::Authority);
+        }
+        let lifecycle = core
+            .connection_lifecycles
+            .get(&self.intent.connection)
+            .ok_or(PeerNativeError::Closed)?;
+        let state = lifecycle.lock().unwrap_or_else(|p| p.into_inner());
+        if !state.active
+            || state.retired
+            || state.peer_origin != Some(self.peer.incarnation())
+            || state.peer_preparation.as_ref() != Some(&self.scope)
+        {
+            return Err(PeerNativeError::Closed);
+        }
+        if !core.adapter(self.intent.transport).is_ok_and(|a| {
+            a.is_peer_native_preparation_current(&self.intent.connection, &self.peer)
+        }) {
+            return Err(PeerNativeError::Closed);
+        }
+        self.retained = true;
+        Ok(self.intent.connection.clone())
+    }
+}
+impl Drop for PreparedPeerNativeConnection {
+    fn drop(&mut self) {
+        if !self.retained {
+            if let Some(core) = self.owner.upgrade() {
+                core.retire_peer_admission_route(&self.intent.connection, self.peer.incarnation());
+            }
+        }
+    }
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+}
+impl Orchestrator {
+    pub(super) fn retire_native_session_connections(&self, session: &SessionId) {
+        let routes = self
+            .connection_lifecycles
+            .iter()
+            .filter_map(|entry| {
+                let state = entry.lock().unwrap_or_else(|p| p.into_inner());
+                if state.active
+                    && !state.retired
+                    && state
+                        .peer_preparation
+                        .as_ref()
+                        .is_some_and(|scope| &scope.session == session)
+                {
+                    state.peer_origin.map(|peer| (entry.key().clone(), peer))
+                } else {
+                    None
+                }
+            })
+            .collect::<Vec<_>>();
+        if let Some(owner) = self.self_weak.get().and_then(Weak::upgrade) {
+            for (connection, peer) in routes {
+                owner.retire_peer_admission_route(&connection, peer);
+            }
+        }
+    }
+    fn check_native_authority(
+        &self,
+        peer: &PeerAdmission,
+        principal: &AuthenticatedPrincipal,
+        intent: &PeerNativeIntent,
+        authority: &PeerNativeAuthority,
+        registry: &peer_sessions::PeerSessionRegistry,
+    ) -> std::result::Result<(), PeerNativeError> {
+        if !identifier(intent.connection.as_str()) || !identifier(intent.session.as_str()) {
+            return Err(PeerNativeError::Conflict);
+        }
+        if !matches!(
+            intent.transport,
+            Transport::Quic | Transport::WebTransport | Transport::WebSocket
+        ) {
+            return Err(PeerNativeError::Unsupported);
+        }
+        if !authority.may_prepare || authority.endpoint.transport() != intent.transport {
+            return Err(PeerNativeError::Authority);
+        }
+        peer.check_target(principal, &authority.actor, &authority.endpoint)?;
+        authority
+            .endpoint
+            .usable_by(&authority.actor)
+            .map_err(|_| PeerNativeError::Authority)?;
+        let session = self
+            .sessions
+            .get(&intent.session)
+            .ok_or(PeerNativeError::Authority)?;
+        let session = session.read().expect("session lock poisoned");
+        if matches!(
+            session.state,
+            SessionState::Ending | SessionState::Ended | SessionState::Failed
+        ) || registry.closing.contains(&session.conversation_id)
+        {
+            return Err(PeerNativeError::Closed);
+        }
+        if authority.actor.conversation() != &session.conversation_id {
+            return Err(PeerNativeError::Authority);
+        }
+        let conversation = self
+            .conversations
+            .get(&session.conversation_id)
+            .ok_or(PeerNativeError::Authority)?;
+        let conversation = conversation.read().expect("conversation lock poisoned");
+        if conversation.state != ConversationState::Open {
+            return Err(PeerNativeError::Closed);
+        }
+        if &conversation.tenant_id != authority.actor.tenant() {
+            return Err(PeerNativeError::Authority);
+        }
+        Ok(())
+    }
+    /// Reserve a never-reused Core ID and physical Session/Connection quota before
+    /// any adapter hook. Synchronous local preparation cannot escape an await.
+    /// Failed hooks keep lifecycle/quarantine ownership until actual local cleanup.
+    pub fn prepare_peer_native_connection(
+        self: &Arc<Self>,
+        peer: Arc<PeerAdmission>,
+        principal: &AuthenticatedPrincipal,
+        intent: PeerNativeIntent,
+        lease: &dyn PeerNativeAuthorityLease,
+        context: Arc<dyn Any + Send + Sync>,
+    ) -> std::result::Result<PreparedPeerNativeConnection, PeerNativeError> {
+        self.ensure_operational_event_stream_healthy()
+            .map_err(|_| PeerNativeError::Closed)?;
+        let adapter = self
+            .adapter(intent.transport)
+            .map_err(|_| PeerNativeError::Unsupported)?;
+        if !adapter.supports_peer_native_preparation()
+            || !adapter.lifecycle_capabilities().authoritative_liveness
+        {
+            return Err(PeerNativeError::Unsupported);
+        }
+        let authority = lease.authority();
+        let candidate = {
+            let _serial = self
+                .externally_projected_sessions
+                .lock()
+                .expect("external projection lock poisoned");
+            let registry = self.peer_sessions.lock().unwrap_or_else(|p| p.into_inner());
+            self.check_native_authority(&peer, principal, &intent, authority, &registry)?;
+            let _ids = self
+                .connection_registry_lock
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            if self.connection_lifecycles.contains_key(&intent.connection)
+                || self.connections.contains_key(&intent.connection)
+            {
+                return Err(PeerNativeError::Conflict);
+            }
+            if self.connection_lifecycles.len() >= self.connection_id_budget.load(Ordering::Relaxed)
+            {
+                return Err(PeerNativeError::Capacity);
+            }
+            if self
+                .connection_lifecycle_tasks
+                .draining
+                .load(Ordering::Acquire)
+            {
+                return Err(PeerNativeError::Closed);
+            }
+            let permit =
+                peer.reserve(self, &intent.session, &intent.connection, intent.transport)?;
+            let state = Arc::new(Mutex::new(ConnectionLifecycleState {
+                peer_admission: Some(permit),
+                peer_origin: Some(peer.incarnation()),
+                peer_preparation: Some(NativePreparationScope {
+                    session: intent.session.clone(),
+                    participant: authority.actor.participant().clone(),
+                    epoch: authority.actor.epoch(),
+                    endpoint: authority.endpoint.endpoint().clone(),
+                }),
+                generation: 1,
+                active: true,
+                retired: false,
+                admission_outcomes_notified: HashSet::new(),
+                operational_connected_emitted: false,
+            }));
+            self.connection_lifecycles
+                .insert(intent.connection.clone(), state.clone());
+            self.connections.insert(
+                intent.connection.clone(),
+                ConnectionEntry {
+                    transport: intent.transport,
+                    direction: Direction::Inbound,
+                    principal: Some(principal.clone()),
+                    inbound_context: None,
+                    inbound_context_retired: true,
+                    inbound_publication: InboundPublicationState::Published,
+                    inbound_admission_terminal: None,
+                    staged_inbound_data: None,
+                    normalized_lifecycle_was_visible: false,
+                    deferred_authentication: None,
+                    deferred_principal_authentication: None,
+                },
+            );
+            let candidate = PreparedPeerNativeConnection {
+                owner: Arc::downgrade(self),
+                peer: peer.clone(),
+                intent: intent.clone(),
+                scope: NativePreparationScope {
+                    session: intent.session.clone(),
+                    participant: authority.actor.participant().clone(),
+                    epoch: authority.actor.epoch(),
+                    endpoint: authority.endpoint.endpoint().clone(),
+                },
+                retained: false,
+            };
+            let request = NativeConnectionRequest {
+                intent: intent.clone(),
+                peer: peer.clone(),
+                participant: authority.actor.participant().clone(),
+                context,
+                cancellation: peer.cancellation().child_token(),
+            };
+            // The adapter hook is dormant and cannot call Core or publish events.
+            // Hold lifecycle ownership so simultaneous EOF cannot clean a route before
+            // its synchronous allocation has finished.
+            let current = state.lock().unwrap_or_else(|p| p.into_inner());
+            let result = if peer.is_closed() {
+                Err(PeerNativeError::Closed)
+            } else {
+                std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    let handle = adapter
+                        .prepare_peer_native_connection(&request)
+                        .map_err(|_| PeerNativeError::Adapter)?;
+                    let c = &handle.connection;
+                    if c.id != intent.connection
+                        || c.session_id != intent.session
+                        || c.participant_id != candidate.scope.participant
+                        || c.transport != intent.transport
+                        || c.direction != Direction::Inbound
+                        || c.state != ConnectionState::Connecting
+                        || !c.streams.is_empty()
+                        || !adapter.is_peer_native_preparation_current(&intent.connection, &peer)
+                    {
+                        Err(PeerNativeError::Adapter)
+                    } else {
+                        Ok(())
+                    }
+                }))
+                .unwrap_or(Err(PeerNativeError::Adapter))
+            };
+            drop(current);
+            (candidate, result)
+        };
+        let (candidate, result) = candidate;
+        result?;
+        Ok(candidate)
+    }
+}
