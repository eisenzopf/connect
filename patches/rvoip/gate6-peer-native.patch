+struct WireGrants {
+    denied: bool,
+    member: Membership,
+    connections: HashMap<String, ConnectionId>,
+}
+struct WireProof {
+    _base: AuthorityLease,
+    _guard: tokio::sync::OwnedRwLockReadGuard<WireGrants>,
+    authorities: HashMap<Transport, PeerNativeAuthority>,
+    connection: Option<ConnectionId>,
+}
+struct View<'a>(&'a PeerNativeAuthority);
+impl PeerNativeAuthorityLease for View<'_> {
+    fn authority(&self) -> &PeerNativeAuthority {
+        self.0
+    }
+}
+struct WirePolicy {
+    base: Arc<Policy>,
+    grants: Arc<RwLock<WireGrants>>,
+}
+impl WirePolicy {
+    async fn proof(
+        &self,
+        base: AuthorityLease,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let guard = self.grants.clone().read_owned().await;
+        if guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        let connection = if e.kind() == "connection.offer" {
+            if e.scope(Scope::Conversation) != Some("conversation")
+                || e.scope(Scope::Session) != Some("session")
+            {
+                return Err(DispatchError::Authority);
+            }
+            Some(
+                guard
+                    .connections
+                    .get(e.scope(Scope::Connection).ok_or(DispatchError::Authority)?)
+                    .ok_or(DispatchError::Authority)?
+                    .clone(),
+            )
+        } else {
+            None
+        };
+        let authorities = [
+            Transport::Quic,
+            Transport::WebTransport,
+            Transport::WebSocket,
+        ]
+        .into_iter()
+        .map(|kind| {
+            (
+                kind,
+                PeerNativeAuthority {
+                    actor: guard.member.clone(),
+                    endpoint: endpoint("alice", kind),
+                    may_prepare: true,
+                },
+            )
+        })
+        .collect();
+        Ok(AuthorityLease::holding(WireProof {
+            _base: base,
+            _guard: guard,
+            authorities,
+            connection,
+        }))
+    }
+}
+#[async_trait]
+impl PeerAuthority for WirePolicy {
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.proof(self.base.guard(c, d, i, e).await?, e).await
+    }
+    async fn refresh(
+        &self,
+        old: &ValidatedBearer,
+        new: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.proof(self.base.refresh(old, new, d, i, e).await?, e)
+            .await
+    }
+}
+#[derive(Default)]
+struct PhysicalRecord {
+    peer: std::sync::Mutex<Option<Arc<PeerAdmission>>>,
+    connections: std::sync::Mutex<Vec<ConnectionId>>,
+}
+struct Factory {
+    core: Arc<core_fixture::Fixture>,
+    adapters: HashMap<Transport, Arc<CanonicalNativeAdapter>>,
+    records: std::sync::Mutex<Vec<Arc<PhysicalRecord>>>,
+}
+struct NativeHandler {
+    core: Arc<core_fixture::Fixture>,
+    source: Arc<NativePhysicalBinding>,
+    record: Arc<PhysicalRecord>,
+}
+impl PhysicalHandlerFactory for Factory {
+    fn handler(
+        &self,
+        context: NativeTransportContext,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        if context.transport == PeerTransport::Quic {
+            assert!(context.native::<quinn::Connection>().is_some());
+        } else if context.transport == PeerTransport::WebSocket {
+            assert!(context.native::<()>().is_some());
+        } else {
+            assert!(context.native::<()>().is_none());
+        }
+        let record = Arc::new(PhysicalRecord::default());
+        self.records.lock().unwrap().push(record.clone());
+        Ok(Arc::new(NativeHandler {
+            core: self.core.clone(),
+            source: NativePhysicalBinding::new(context),
+            record,
+        }))
+    }
+}
+#[async_trait]
+impl AuthenticatedHandler for NativeHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let proof = authorized
+            .authority::<WireProof>()
+            .ok_or(DispatchError::Authority)?;
+        let peer = authorized
+            .peer_admission()
+            .ok_or(DispatchError::Authority)?
+            .clone();
+        let kind = self.source.transport();
+        let request = authorized.envelope();
+        if request.kind() != "connection.offer" {
+            return Err(DispatchError::Unsupported);
+        }
+        let expected = match kind {
+            Transport::Quic => "quic",
+            Transport::WebTransport => "webtransport",
+            _ => "websocket",
+        };
+        if request.original()["payload"]["substrate"] != json!(expected) {
+            return Err(DispatchError::Authority);
+        }
+        let connection = proof
+            .connection
+            .as_ref()
+            .ok_or(DispatchError::Authority)?
+            .clone();
+        {
+            let mut previous = self.record.peer.lock().unwrap();
+            if let Some(previous) = &*previous {
+                assert!(Arc::ptr_eq(previous, &peer));
+            } else {
+                *previous = Some(peer.clone());
+            }
+        }
+        let mut reply = envelope("ack", json!({"details":{"reserved":true}}));
+        for field in ["cid", "sid", "connid", "operation_id"] {
+            reply[field] = request.original()[field].clone();
+        }
+        reply["in_reply_to"] = json!(request.id());
+        let reply = Envelope::from_value(reply)?;
+        let intent = PeerNativeIntent {
+            session: self.core.session.clone(),
+            connection: connection.clone(),
+            transport: kind,
+        };
+        let lease = View(&proof.authorities[&kind]);
+        let pending = self
+            .core
+            .orch
+            .prepare_peer_native_connection(
+                peer,
+                authorized.principal(),
+                intent,
+                &lease,
+                self.source.clone(),
+            )
+            .map_err(|e| match e {
+                PeerNativeError::Capacity => DispatchError::Capacity,
+                _ => DispatchError::Authority,
+            })?;
+        pending
+            .retain(authorized.principal(), &lease)
+            .map_err(|_| DispatchError::Authority)?;
+        self.record.connections.lock().unwrap().push(connection);
+        Ok(reply)
+    }
+}
