+//! Native Core IDs/quota before allocation, actual canonical transport sources.
+use super::*;
+use rvoip_core::{
+    adapter::*,
+    connection::Transport,
+    error::{Result as CoreResult, RvoipError},
+    ids::*,
+    message::Message,
+    orchestrator::peer_native::*,
+    peer_admission::{PeerAdmissionLimits, PeerAdmissionOwner},
+    relationships::Membership,
+    session::SessionState,
+    stream::MediaStream,
+};
+use rvoip_uctp::v2::{
+    native::*,
+    reachability::PeerTransport,
+    server::{NativeTransportContext, PhysicalHandlerFactory},
+};
+use std::collections::HashMap;
+fn actor(name: &str) -> AuthenticatedPrincipal {
+    let mut p = core_fixture::principal(name);
+    p.expires_at = Some(Utc::now() + chrono::Duration::hours(1));
+    p.assurance = IdentityAssurance::Identified {
+        credential_kind: CredentialKind::Oidc,
+    };
+    p
+}
+fn owner(name: &str, limits: PeerAdmissionLimits) -> PeerAdmissionOwner {
+    PeerAdmissionOwner::new(
+        &actor(name),
+        IdentityId::from_string(format!("id_{name}")),
+        DeviceId::from_string(format!("device_{name}")),
+        CancellationToken::new(),
+        limits,
+    )
+    .unwrap()
+}
+fn peer_kind(kind: Transport) -> PeerTransport {
+    match kind {
+        Transport::Quic => PeerTransport::Quic,
+        Transport::WebTransport => PeerTransport::WebTransport,
+        Transport::WebSocket => PeerTransport::WebSocket,
+        _ => panic!(),
+    }
+}
+fn endpoint(name: &str, kind: Transport) -> EndpointBinding {
+    let binding = IdentityBinding::from_authenticated(
+        &actor(name),
+        IdentityId::from_string(format!("id_{name}")),
+        Utc::now(),
+    )
+    .unwrap();
+    let mut ep = EndpointBinding::provision(
+        binding.clone(),
+        EndpointId::from_string(format!("endpoint_{name}_{kind:?}")),
+        DeviceId::from_string(format!("device_{name}")),
+        kind,
+        "controlled-native-peer".into(),
+    )
+    .unwrap();
+    ep.verify(&binding, "native-transport-proof".into(), Utc::now())
+        .unwrap();
+    ep
+}
+struct Lease<'a> {
+    _guard: std::sync::RwLockReadGuard<'a, core_fixture::PolicyState>,
+    authority: PeerNativeAuthority,
+}
+impl PeerNativeAuthorityLease for Lease<'_> {
+    fn authority(&self) -> &PeerNativeAuthority {
+        &self.authority
+    }
+}
+fn lease<'a>(f: &'a core_fixture::Fixture, name: &str, kind: Transport) -> Lease<'a> {
+    let guard = f.policy.0.read().unwrap();
+    let authority = PeerNativeAuthority {
+        actor: guard.members[&core_fixture::participant(name)].clone(),
+        endpoint: endpoint(name, kind),
+        may_prepare: !guard.denied,
+    };
+    Lease {
+        _guard: guard,
+        authority,
+    }
+}
+fn physical(kind: Transport) -> Arc<NativePhysicalBinding> {
+    NativePhysicalBinding::new(NativeTransportContext::new(
+        peer_kind(kind),
+        CancellationToken::new(),
+        (),
+    ))
+}
+fn intent(f: &core_fixture::Fixture, kind: Transport) -> PeerNativeIntent {
+    PeerNativeIntent {
+        session: f.session.clone(),
+        connection: ConnectionId::new(),
+        transport: kind,
+    }
+}
+fn prepare(
+    f: &core_fixture::Fixture,
+    peer: &Arc<PeerAdmission>,
+    intent: PeerNativeIntent,
+    source: &Arc<NativePhysicalBinding>,
+) -> Result<PreparedPeerNativeConnection, PeerNativeError> {
+    f.orch.prepare_peer_native_connection(
+        peer.clone(),
+        &actor("alice"),
+        intent.clone(),
+        &lease(f, "alice", intent.transport),
+        source.clone(),
+    )
+}
+fn retain(
+    f: &core_fixture::Fixture,
+    p: &Arc<PeerAdmission>,
+    i: PeerNativeIntent,
+    s: &Arc<NativePhysicalBinding>,
+) -> Result<ConnectionId, PeerNativeError> {
+    let kind = i.transport;
+    prepare(f, p, i, s)?.retain(&actor("alice"), &lease(f, "alice", kind))
+}
+async fn fixture(kind: Transport) -> (Arc<core_fixture::Fixture>, Arc<CanonicalNativeAdapter>) {
+    let f = Arc::new(core_fixture::Fixture::new().await);
+    let adapter = CanonicalNativeAdapter::new(kind).unwrap();
+    f.orch.register(adapter.clone()).unwrap();
+    (f, adapter)
+}
+#[tokio::test]
+async fn native_default_sixty_four_is_reserved_before_allocation_and_eof_retires_only_resources() {
+    for kind in [
+        Transport::Quic,
+        Transport::WebTransport,
+        Transport::WebSocket,
+    ] {
+        let (f, a) = fixture(kind).await;
+        let o = owner("alice", Default::default());
+        let p = o.peer();
+        let s = physical(kind);
+        for _ in 0..64 {
+            let id = retain(&f, &p, intent(&f, kind), &s).unwrap();
+            assert_eq!(f.orch.connection_transport(&id).unwrap(), kind);
+            assert_eq!(
+                f.orch.connection_principal(&id).unwrap().ownership_key(),
+                actor("alice").ownership_key()
+            );
+        }
+        assert_eq!(p.snapshot().sessions, 1);
+        assert_eq!(p.snapshot().connections, 64);
+        assert_eq!(a.route_count(), 64);
+        let denied = intent(&f, kind);
+        assert!(matches!(
+            prepare(&f, &p, denied.clone(), &s),
+            Err(PeerNativeError::Capacity)
+        ));
+        assert_eq!(a.total_allocations(), 64);
+        assert!(f.orch.connection_transport(&denied.connection).is_err());
+        assert_eq!(f.orch.participant_capacity(&f.session).unwrap(), (0, 0));
+        drop(o);
+        core_fixture::until(|| a.route_count() == 0 && p.snapshot().connections == 0).await;
+        assert_eq!(
+            f.orch.session(&f.session).unwrap().read().unwrap().state,
+            SessionState::Initiating
+        );
+    }
+}
+#[tokio::test]
+async fn native_distinct_session_union_rejects_thirty_third_before_allocating() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    let s = physical(kind);
+    for _ in 0..32 {
+        let mut i = intent(&f, kind);
+        i.session = f.second_session().await;
+        retain(&f, &o.peer(), i, &s).unwrap();
+    }
+    let mut i = intent(&f, kind);
+    i.session = f.second_session().await;
+    assert!(matches!(
+        prepare(&f, &o.peer(), i, &s),
+        Err(PeerNativeError::Capacity)
+    ));
+    assert_eq!(a.total_allocations(), 32);
+    assert_eq!(o.peer().snapshot().sessions, 32);
+}
+#[tokio::test]
+async fn unretained_native_candidate_retires_and_core_id_cannot_be_reused() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    let s = physical(kind);
+    let i = intent(&f, kind);
+    let candidate = prepare(&f, &o.peer(), i.clone(), &s).unwrap();
+    assert_eq!(o.peer().snapshot().connections, 1);
+    drop(candidate);
+    core_fixture::until(|| o.peer().snapshot().connections == 0).await;
+    assert_eq!(a.route_count(), 0);
+    assert!(matches!(
+        prepare(&f, &o.peer(), i, &s),
+        Err(PeerNativeError::Conflict)
+    ));
+    assert_eq!(a.total_allocations(), 1);
+}
+#[tokio::test]
+async fn native_identity_device_current_grant_and_expiry_denials_precede_allocation() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    let s = physical(kind);
+    for which in [
+        "subject",
+        "issuer",
+        "expiry",
+        "endpoint",
+        "grant",
+        "transport",
+    ] {
+        let mut p = actor("alice");
+        let mut l = lease(&f, "alice", kind);
+        match which {
+            "subject" => p.subject = "bob".into(),
+            "issuer" => p.issuer = Some("other".into()),
+            "expiry" => p.expires_at = Some(Utc::now() - chrono::Duration::seconds(1)),
+            "endpoint" => l.authority.endpoint = endpoint("bob", kind),
+            "grant" => l.authority.may_prepare = false,
+            _ => l.authority.endpoint = endpoint("alice", Transport::WebTransport),
+        };
+        assert!(f
+            .orch
+            .prepare_peer_native_connection(o.peer(), &p, intent(&f, kind), &l, s.clone())
+            .is_err());
+    }
+    assert_eq!(a.total_allocations(), 0);
+    assert_eq!(o.peer().snapshot().connections, 0);
+}
+#[tokio::test]
+async fn native_source_cannot_be_borrowed_by_another_physical_peer_or_transport() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    let s = physical(kind);
+    retain(&f, &o.peer(), intent(&f, kind), &s).unwrap();
+    let other = owner("alice", Default::default());
+    assert!(prepare(&f, &other.peer(), intent(&f, kind), &s).is_err());
+    core_fixture::until(|| other.peer().snapshot().connections == 0).await;
+    assert_eq!(o.peer().snapshot().connections, 1);
+    assert_eq!(a.route_count(), 1);
+    assert_eq!(a.total_allocations(), 1);
+    let wrong = physical(Transport::WebTransport);
+    assert!(prepare(&f, &o.peer(), intent(&f, kind), &wrong).is_err());
+    core_fixture::until(|| o.peer().snapshot().connections == 1).await;
+    assert_eq!(a.route_count(), 1);
+}
+#[tokio::test]
+async fn ending_session_retires_native_routes_before_any_participant_admission() {
+    let kind = Transport::Quic;
+    let (f, a) = fixture(kind).await;
+    let o = owner("alice", Default::default());
+    let s = physical(kind);
