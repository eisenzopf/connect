+//! Dormant canonical native Connection routes, allocated only through Core's
+//! pre-admission ticket. No v1 coordinator, protocol downgrade or ready ACK.
+use super::{reachability::PeerTransport, server::NativeTransportContext};
+use dashmap::DashMap;
+use rvoip_core::{
+    adapter::*,
+    capability::{CapabilityDescriptor, NegotiatedCodecs},
+    connection::{Connection, ConnectionState, Direction, Transport, TransportHandle},
+    error::{Result, RvoipError},
+    ids::*,
+    message::Message,
+    orchestrator::peer_native::NativeConnectionRequest,
+    peer_admission::PeerAdmission,
+    stream::MediaStream,
+};
+use std::sync::{
+    atomic::{AtomicUsize, Ordering},
+    Arc, Mutex, Weak,
+};
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+
+/// One server-accepted TLS transport. It binds at most once to the exact
+/// authenticated physical resource context, surviving credential refresh.
+pub struct NativePhysicalBinding {
+    context: NativeTransportContext,
+    peer: Mutex<Option<Weak<PeerAdmission>>>,
+}
+impl NativePhysicalBinding {
+    pub fn new(context: NativeTransportContext) -> Arc<Self> {
+        Arc::new(Self {
+            context,
+            peer: Mutex::new(None),
+        })
+    }
+    pub fn transport(&self) -> Transport {
+        match self.context.transport {
+            PeerTransport::Quic => Transport::Quic,
+            PeerTransport::WebTransport => Transport::WebTransport,
+            PeerTransport::WebSocket => Transport::WebSocket,
+        }
+    }
+    pub fn native<T: std::any::Any + Send + Sync>(&self) -> Option<&T> {
+        self.context.native()
+    }
+    fn bind(&self, peer: &Arc<PeerAdmission>) -> Result<()> {
+        if peer.is_closed() || self.context.lifetime.is_cancelled() {
+            return Err(RvoipError::AdmissionRejected("native physical peer closed"));
+        }
+        let mut owner = self.peer.lock().unwrap_or_else(|p| p.into_inner());
+        let current = Arc::downgrade(peer);
+        if owner
+            .as_ref()
+            .is_some_and(|old| !Weak::ptr_eq(old, &current))
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "native physical owner conflicts",
+            ));
+        }
+        *owner = Some(current);
+        Ok(())
+    }
+}
+struct Route {
+    physical: Arc<NativePhysicalBinding>,
+    cancel: CancellationToken,
+}
+impl Drop for Route {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+    }
+}
+/// Register one adapter per native transport in the owning Core. Its routes
+/// start Connecting with no media/presence. Media negotiation/install and
+/// reliable data delivery must opt in separately; no readiness is invented.
+pub struct CanonicalNativeAdapter {
+    transport: Transport,
+    routes: DashMap<ConnectionId, Route>,
+    events: mpsc::Sender<OrchestratorAdapterEvent>,
+    receiver: Mutex<Option<mpsc::Receiver<OrchestratorAdapterEvent>>>,
+    allocated: AtomicUsize,
+    lifecycle: AdapterLifecycleSinkSlot,
+}
+impl CanonicalNativeAdapter {
+    pub fn new(transport: Transport) -> Result<Arc<Self>> {
+        if !matches!(
+            transport,
+            Transport::Quic | Transport::WebTransport | Transport::WebSocket
+        ) {
+            return Err(RvoipError::NotImplemented("non-native transport"));
+        }
+        let (events, receiver) = mpsc::channel(64);
+        Ok(Arc::new(Self {
+            transport,
+            routes: DashMap::new(),
+            events,
+            lifecycle: AdapterLifecycleSinkSlot::default(),
+            receiver: Mutex::new(Some(receiver)),
+            allocated: AtomicUsize::new(0),
+        }))
+    }
+    pub fn route_count(&self) -> usize {
+        self.routes.len()
+    }
+    pub fn total_allocations(&self) -> usize {
+        self.allocated.load(Ordering::Acquire)
+    }
+    /// Trusted server lookup of the exact physical source for further native
+    /// negotiation. Callers still need current authorization and Core lifecycle.
+    pub fn physical_source(&self, id: &ConnectionId) -> Result<Arc<NativePhysicalBinding>> {
+        let route = self
+            .routes
+            .get(id)
+            .ok_or_else(|| RvoipError::ConnectionNotFound(id.clone()))?;
+        if route.cancel.is_cancelled() || route.physical.context.lifetime.is_cancelled() {
+            return Err(RvoipError::AdmissionRejected("native route retired"));
+        }
+        Ok(route.physical.clone())
+    }
+}
+#[async_trait::async_trait]
+impl ConnectionAdapter for CanonicalNativeAdapter {
+    fn transport(&self) -> Transport {
+        self.transport
+    }
+    fn kind(&self) -> AdapterKind {
+        AdapterKind::Substrate
+    }
+    fn lifecycle_capabilities(&self) -> AdapterLifecycleCapabilities {
+        AdapterLifecycleCapabilities {
+            authoritative_liveness: true,
+            terminal_fallback: true,
+            ..Default::default()
+        }
+    }
+    fn install_lifecycle_sink(&self, sink: Arc<dyn AdapterLifecycleSink>) -> Result<()> {
+        self.lifecycle
+            .install(sink)
+            .map_err(|_| RvoipError::InvalidState("native lifecycle sink already installed"))
+    }
+    fn supports_peer_native_preparation(&self) -> bool {
+        true
+    }
+    fn prepare_peer_native_connection(
+        &self,
+        request: &NativeConnectionRequest,
+    ) -> Result<ConnectionHandle> {
+        let physical = request
+            .context::<NativePhysicalBinding>()
+            .ok_or(RvoipError::AdmissionRejected(
+                "native transport context required",
+            ))?
+            .clone();
+        if physical.transport() != self.transport || request.intent().transport != self.transport {
+            return Err(RvoipError::AdmissionRejected("native transport mismatch"));
+        }
+        physical.bind(request.peer())?;
+        let id = request.intent().connection.clone();
+        let route = Route {
+            physical,
+            cancel: request.cancellation(),
+        };
+        match self.routes.entry(id.clone()) {
+            dashmap::mapref::entry::Entry::Vacant(entry) => {
+                entry.insert(route);
+            }
+            dashmap::mapref::entry::Entry::Occupied(_) => {
+                return Err(RvoipError::AdmissionRejected("native route ID conflicts"))
+            }
+        }
+        self.allocated.fetch_add(1, Ordering::AcqRel);
+        Ok(ConnectionHandle::new(Connection {
+            id,
+            session_id: request.intent().session.clone(),
+            participant_id: request.participant().clone(),
+            transport: self.transport,
+            direction: Direction::Inbound,
+            state: ConnectionState::Connecting,
+            capabilities: CapabilityDescriptor::default(),
+            negotiated_codecs: NegotiatedCodecs::default(),
+            streams: vec![],
+            messaging_enabled: false,
+            transport_handle: TransportHandle(Arc::new(())),
+            opened_at: chrono::Utc::now(),
+            closed_at: None,
+        }))
+    }
+    fn is_peer_native_preparation_current(
+        &self,
+        id: &ConnectionId,
+        peer: &Arc<PeerAdmission>,
+    ) -> bool {
+        self.routes.get(id).is_some_and(|r| {
+            !peer.is_closed()
+                && !r.cancel.is_cancelled()
+                && !r.physical.context.lifetime.is_cancelled()
+                && r.physical
+                    .peer
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .as_ref()
+                    .is_some_and(|bound| Weak::ptr_eq(bound, &Arc::downgrade(peer)))
+        })
+    }
+    fn is_connection_live(&self, id: &ConnectionId) -> bool {
+        self.routes.contains_key(id)
+    }
+    async fn originate(&self, _: OriginateRequest) -> Result<ConnectionHandle> {
+        Err(RvoipError::NotImplemented(
+            "canonical native requires Core preparation",
+        ))
+    }
+    async fn accept(&self, _: ConnectionId) -> Result<()> {
+        Err(RvoipError::NotImplemented(
+            "canonical native media negotiation required",
+        ))
+    }
+    async fn reject(&self, id: ConnectionId, _: RejectReason) -> Result<()> {
+        self.end(id, EndReason::Normal).await
+    }
+    async fn end(&self, id: ConnectionId, reason: EndReason) -> Result<()> {
+        if let Some((_, route)) = self.routes.remove(&id) {
+            route.cancel.cancel();
+            self.lifecycle
+                .queue_or_deliver_orchestrator_terminal(
+                    &self.events,
+                    AdapterEvent::Ended {
+                        connection_id: id,
+                        reason,
+                    },
+                )
+                .await;
+        }
+        Ok(())
+    }
+    async fn hold(&self, _: ConnectionId) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical native hold"))
+    }
+    async fn resume(&self, _: ConnectionId) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical native resume"))
+    }
+    async fn transfer(&self, _: ConnectionId, _: TransferTarget) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical native transfer"))
+    }
+    async fn streams(&self, id: ConnectionId) -> Result<Vec<Arc<dyn MediaStream>>> {
+        self.physical_source(&id)?;
+        Ok(vec![])
+    }
+    async fn send_message(&self, _: ConnectionId, _: Message) -> Result<()> {
+        Err(RvoipError::NotImplemented(
+            "canonical native reliable data required",
+        ))
+    }
+    async fn send_dtmf(&self, _: ConnectionId, _: &str, _: u32) -> Result<()> {
+        Err(RvoipError::NotImplemented("canonical native DTMF"))
+    }
+    async fn renegotiate_media(
+        &self,
+        _: ConnectionId,
+        _: CapabilityDescriptor,
+    ) -> Result<NegotiatedCodecs> {
+        Err(RvoipError::NotImplemented(
+            "canonical native staged media required",
+        ))
+    }
+    async fn verify_request_signature(
+        &self,
+        _: ConnectionId,
+        _: SignatureHeaders,
+    ) -> Result<rvoip_core::identity::IdentityAssurance> {
+        Err(RvoipError::NotImplemented(
+            "canonical signatures require authenticated dispatch",
+        ))
+    }
+    fn subscribe_events(&self) -> mpsc::Receiver<AdapterEvent> {
+        legacy_normalized_event_receiver(self.subscribe_orchestrator_events(), 64)
+    }
+    fn subscribe_orchestrator_events(&self) -> mpsc::Receiver<OrchestratorAdapterEvent> {
+        self.receiver
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .unwrap_or_else(|| {
+                let (_, rx) = mpsc::channel(1);
+                rx
+            })
+    }
+    fn capabilities(&self) -> CapabilityDescriptor {
+        CapabilityDescriptor::default()
+    }
+}
