+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn queued_visual_policy_races_preserve_hard_authority_and_generation_fences() {
+    for medium in [Medium::Video, Medium::Screen] {
+        for side in [Side::Source, Side::Target] {
+            for mutation in [
+                Mutation::Gate,
+                Mutation::PauseResume,
+                Mutation::Credential,
+                Mutation::Port,
+                Mutation::Scene,
+                Mutation::Direct,
+                Mutation::PolicyAuthority,
+                Mutation::PolicyConflict,
+                Mutation::ExpiredLease,
+            ] {
+                let mut f = QueuedVisual::new(medium).await;
+                let applied = Arc::new(AtomicBool::new(false));
+                let _hook = f.install(
+                    medium,
+                    side,
+                    mutation,
+                    None,
+                    false,
+                    Arc::new(Mutex::new(None)),
+                    applied.clone(),
+                );
+                let queued = f.queued.take().unwrap();
+                let writes = Arc::new(AtomicUsize::new(0));
+                let result = deliver(
+                    queued,
+                    medium,
+                    writes.clone(),
+                    Arc::new(AtomicBool::new(false)),
+                    false,
+                )
+                .await;
+                assert!(
+                    applied.load(Ordering::Acquire) && f.consumed(),
+                    "{mutation:?} callback was not exercised"
+                );
+                assert!(
+                    result.is_err(),
+                    "{medium:?} {side:?} {mutation:?} adopted new eligibility"
+                );
+                if mutation == Mutation::PolicyAuthority {
+                    assert!(matches!(result, Err(StreamControlError::Authority)));
+                }
+                if mutation == Mutation::PolicyConflict || mutation == Mutation::Credential {
+                    assert!(matches!(
+                        result,
+                        Err(StreamControlError::Model(MediaTransitionError::Conflict))
+                    ));
+                }
+                if mutation == Mutation::ExpiredLease {
+                    assert!(matches!(result, Err(StreamControlError::Deadline)));
+                }
+                assert_eq!(
+                    writes.load(Ordering::SeqCst),
+                    0,
+                    "{mutation:?} reached writer"
+                );
+                drop(
+                    f.room
+                        .domain
+                        .base
+                        .0
+                        .try_write()
+                        .expect("hard refusal retained policy authority"),
+                );
+            }
+        }
+    }
+}
