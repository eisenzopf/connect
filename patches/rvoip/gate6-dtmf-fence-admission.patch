+
+#[tokio::test]
+async fn source_fence_attachment_preserves_metadata_busy_without_granting_io() {
+    let r = Rig::new().await;
+    let route = r.route("1", 60, DtmfMethod::Rfc4733);
+    let session = r.core.session(&r.sid).unwrap();
+    let held = session.write().unwrap();
+    let result = route.with_source_fence(Arc::new(ControlledSource {
+        adapter: r.origin.clone(),
+        connection: r.source.clone(),
+        stream: r.origin.streams.get(&r.source).unwrap().clone(),
+    }));
+    drop(held);
+    assert_eq!(result.err(), Some(DtmfWriteError::NotReady));
+    let mut packet = [0; 2048];
+    assert!(
+        matches!(r.receiver.try_recv(&mut packet), Err(e) if e.kind() == std::io::ErrorKind::WouldBlock)
+    );
+    let route = r.route("1", 60, DtmfMethod::Rfc4733);
+    assert_eq!(
+        r.core
+            .route_dtmf(
+                &route,
+                Policy::new(&r),
+                CancellationToken::new(),
+                Instant::now() + Duration::from_secs(2)
+            )
+            .await,
+        Ok(())
+    );
+    assert_eq!(r.receive().await.payload[0], 1);
+}
