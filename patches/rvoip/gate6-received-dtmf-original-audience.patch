+#[tokio::test]
+async fn received_dtmf_audience_owns_sip_source_without_reentering_native_target_and_releases_pending(
+) {
+    use crate::dtmf::*;
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "phone", None, false).await;
+    let phone = room.nodes["phone"].controller.clone();
+    let bob = room.nodes["bob"].controller.clone();
+    let actual = native_dtmf_recipient(&bob);
+    let disclosure = received_sip_disclosure(&room, &phone, std::time::Instant::now()).unwrap();
+    let audience = room
+        .scene
+        .received_native_dtmf_audience(&disclosure, &actual)
+        .unwrap();
+    for pending in [false, true] {
+        let result = bob.poll_dtmf_source_io(
+            &actual.principal,
+            actual.stream_revision,
+            actual.credential_revision,
+            &actual.audio_bindings,
+            &mut || {
+                audience.poll(&mut || {
+                    assert!(phone.state.try_lock().is_err());
+                    assert!(phone.credential.try_lock().is_err());
+                    assert!(bob.state.try_lock().is_err());
+                    assert!(bob.credential.try_lock().is_err());
+                    assert!(room.scene.members.try_lock().is_err());
+                    assert!(room.scene.audiences.try_lock().is_err());
+                    if pending {
+                        std::task::Poll::Pending
+                    } else {
+                        std::task::Poll::Ready(Ok(()))
+                    }
+                })
+            },
+        );
+        assert_eq!(
+            result,
+            if pending {
+                std::task::Poll::Pending
+            } else {
+                std::task::Poll::Ready(Ok(()))
+            }
+        );
+        assert!(phone.state.try_lock().is_ok());
+        assert!(phone.credential.try_lock().is_ok());
+        assert!(bob.state.try_lock().is_ok());
+        assert!(bob.credential.try_lock().is_ok());
+        assert!(room.scene.members.try_lock().is_ok());
+        assert!(room.scene.audiences.try_lock().is_ok());
+    }
+}
+#[tokio::test]
+async fn received_dtmf_original_private_audience_survives_queued_return_without_public_disclosure()
+{
+    use crate::dtmf::*;
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "consult", Some("public"), true).await;
+    let (_, handle) = room.apply(room.begin_plan()).await.unwrap();
+    let source = room.nodes["consult"].controller.clone();
+    let disclosure = received_sip_disclosure(&room, &source, std::time::Instant::now()).unwrap();
+    let inside = room
+        .scene
+        .received_native_dtmf_audience(
+            &disclosure,
+            &native_dtmf_recipient(&room.nodes["alice"].controller),
+        )
+        .unwrap();
+    let outside = room
+        .scene
+        .received_native_dtmf_audience(
+            &disclosure,
+            &native_dtmf_recipient(&room.nodes["public"].controller),
+        )
+        .unwrap();
+    assert_eq!(
+        inside.poll(&mut || std::task::Poll::Ready(Ok(()))),
+        std::task::Poll::Ready(Ok(()))
+    );
+    let calls = AtomicUsize::new(0);
+    let mut io = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    assert_eq!(
+        outside.poll(&mut io),
+        std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+    );
+    let restore = room
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "received-return".into(),
+            room.scene.audience_revision(),
+        )
+        .unwrap();
+    room.apply(restore).await.unwrap();
+    assert_eq!(
+        outside.poll(&mut io),
+        std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+}
