+    assert!(received_sip_disclosure(&room, &source, during).is_ok());
+    let restore = room
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "received-late-return".into(),
+            room.scene.audience_revision(),
+        )
+        .unwrap();
+    room.apply(restore).await.unwrap();
+    assert!(received_sip_disclosure(&room, &source, during).is_err());
+    let fresh = received_sip_disclosure(&room, &source, std::time::Instant::now()).unwrap();
+    let audience = room
+        .scene
+        .received_native_dtmf_audience(
+            &fresh,
+            &native_dtmf_recipient(&room.nodes["alice"].controller),
+        )
+        .unwrap();
+    assert_eq!(
+        audience.poll(&mut || std::task::Poll::Ready(Ok(()))),
+        std::task::Poll::Ready(Ok(()))
+    );
+}
