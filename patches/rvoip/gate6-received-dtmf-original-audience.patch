+#[tokio::test]
+async fn received_dtmf_fresh_io_refuses_changed_source_credential_and_retired_member() {
+    use crate::dtmf::*;
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "phone", None, false).await;
+    let source = room.nodes["phone"].controller.clone();
+    let disclosure = received_sip_disclosure(&room, &source, std::time::Instant::now()).unwrap();
+    let audience = room
+        .scene
+        .received_native_dtmf_audience(
+            &disclosure,
+            &native_dtmf_recipient(&room.nodes["bob"].controller),
+        )
+        .unwrap();
+    source.credential.lock().unwrap().revision += 1;
+    let calls = AtomicUsize::new(0);
+    let mut io = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    assert_eq!(
+        audience.poll(&mut io),
+        std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+    );
+    let fresh = received_sip_disclosure(&room, &source, std::time::Instant::now()).unwrap();
+    let audience = room
+        .scene
+        .received_native_dtmf_audience(
+            &fresh,
+            &native_dtmf_recipient(&room.nodes["bob"].controller),
+        )
+        .unwrap();
+    room.scene.remove(&source.connection);
+    assert_eq!(
+        audience.poll(&mut io),
+        std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+    );
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+}
