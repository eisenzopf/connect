+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn received_dtmf_input_during_member_commit_wait_cannot_borrow_post_commit_audience() {
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "phone", None, false).await;
+    let source = room.nodes["phone"].controller.clone();
+    let held = room.scene.selections.lock().unwrap();
+    let scene = room.scene.clone();
+    let worker = std::thread::spawn(move || scene.remove(&ConnectionId::from_string("public")));
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    while room.scene.members.try_lock().is_ok() {
+        assert!(std::time::Instant::now() < deadline);
+        std::thread::yield_now();
+    }
+    let during = std::time::Instant::now();
+    drop(held);
+    worker.join().unwrap();
+    assert!(received_sip_disclosure(&room, &source, during).is_err());
+    assert!(received_sip_disclosure(&room, &source, std::time::Instant::now()).is_ok());
+}
