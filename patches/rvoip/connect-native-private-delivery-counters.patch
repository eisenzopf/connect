+/// Fixed numeric metadata only. These counters retain no transport, port,
+/// authority, payload or task, and never grant readiness or delivery.
+#[derive(Default)]
+struct RtpIoCounters {
+    inputs: AtomicU64,
+    input_completions: AtomicU64,
+    input_ok: AtomicU64,
+    input_zero_datagrams: AtomicU64,
+    input_refused_before_primary: AtomicU64,
+    input_errors: [AtomicU64; 10],
+    primary_attempts: AtomicU64,
+    primary_accepted: AtomicU64,
+    primary_refused: AtomicU64,
+    primary_bytes_accepted: AtomicU64,
+    primary_errors: [AtomicU64; 10],
+}
+const RTP_IO_ERROR_CODES: [&str; 10] = [
+    "model",
+    "unsupported",
+    "authority",
+    "not-recipient",
+    "cancelled",
+    "deadline",
+    "not-ready",
+    "metadata-busy",
+    "backpressure",
+    "cleanup-unconfirmed",
+];
+fn rtp_io_error(error: &StreamControlError) -> usize {
+    match error {
+        StreamControlError::Model(_) => 0,
+        StreamControlError::Unsupported => 1,
+        StreamControlError::Authority => 2,
+        StreamControlError::NotRecipient => 3,
+        StreamControlError::Cancelled => 4,
+        StreamControlError::Deadline => 5,
+        StreamControlError::NotReady => 6,
+        StreamControlError::MetadataBusy => 7,
+        StreamControlError::Backpressure => 8,
+        StreamControlError::CleanupUnconfirmed => 9,
+    }
+}
+fn io_add(counter: &AtomicU64, amount: u64) {
+    let _ = counter.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |old| {
+        Some(old.saturating_add(amount))
+    });
+}
+#[derive(Clone, Debug)]
+pub struct RtpIoObservation {
+    pub medium: &'static str,
+    pub inputs: u64,
+    pub input_completions: u64,
+    pub inputs_in_flight_sample: u64,
+    pub input_ok: u64,
+    pub input_zero_datagrams: u64,
+    pub input_refused_before_primary: u64,
+    pub error_codes: [&'static str; 10],
+    pub input_errors: [u64; 10],
+    pub primary_attempts: u64,
+    pub primary_accepted: u64,
+    pub primary_refused: u64,
+    pub primary_in_flight_sample: u64,
+    pub primary_bytes_accepted: u64,
+    pub primary_errors: [u64; 10],
+    pub saturated: bool,
+}
+impl RtpIoCounters {
+    fn snapshot(&self, medium: &'static str) -> RtpIoObservation {
+        let load = |counter: &AtomicU64| counter.load(Ordering::Relaxed);
+        let inputs = load(&self.inputs);
+        let input_completions = load(&self.input_completions);
+        let primary_attempts = load(&self.primary_attempts);
+        let primary_accepted = load(&self.primary_accepted);
+        let primary_refused = load(&self.primary_refused);
+        let input_errors = self.input_errors.each_ref().map(load);
+        let primary_errors = self.primary_errors.each_ref().map(load);
+        let mut observation = RtpIoObservation {
+            medium,
+            inputs,
+            input_completions,
+            inputs_in_flight_sample: inputs.saturating_sub(input_completions),
+            input_ok: load(&self.input_ok),
+            input_zero_datagrams: load(&self.input_zero_datagrams),
+            input_refused_before_primary: load(&self.input_refused_before_primary),
+            error_codes: RTP_IO_ERROR_CODES,
+            input_errors,
+            primary_attempts,
+            primary_accepted,
+            primary_refused,
+            primary_in_flight_sample: primary_attempts
+                .saturating_sub(primary_accepted.saturating_add(primary_refused)),
+            primary_bytes_accepted: load(&self.primary_bytes_accepted),
+            primary_errors,
+            saturated: false,
+        };
+        observation.saturated = [
+            observation.inputs,
+            observation.input_completions,
+            observation.input_ok,
+            observation.input_zero_datagrams,
+            observation.input_refused_before_primary,
+            observation.primary_attempts,
+            observation.primary_accepted,
+            observation.primary_refused,
+            observation.primary_bytes_accepted,
+        ]
+        .contains(&u64::MAX)
+            || input_errors.contains(&u64::MAX)
+            || primary_errors.contains(&u64::MAX);
+        observation
+    }
+}
+impl StagedRtpCounters {
+    fn io_for(&self, kind: StreamKind) -> &RtpIoCounters {
+        &self.io[match kind {
+            StreamKind::Audio => 0,
+            StreamKind::Video => 1,
+            StreamKind::Data => 2,
+        }]
+    }
+    /// Concurrent independent atomic samples, not a coherent frozen final
+    /// total. In-flight differences saturate: a concurrent outcome load can
+    /// overtake its earlier attempt load. RTCP metadata is excluded.
+    pub fn io_snapshot(&self) -> [RtpIoObservation; 3] {
+        [
+            self.io[0].snapshot("audio"),
+            self.io[1].snapshot("video"),
+            self.io[2].snapshot("other"),
+        ]
+    }
+}
