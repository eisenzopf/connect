+#[cfg(test)]
+mod delivery_counter_tests {
+    use super::*;
+    struct Wire {
+        packets: Mutex<Vec<Bytes>>,
+        refuse: bool,
+        maximum: usize,
+    }
+    impl StagedDatagramTransport for Wire {
+        fn maximum_datagram_bytes(&self) -> Option<usize> {
+            Some(self.maximum)
+        }
+        fn is_closed(&self) -> bool {
+            false
+        }
+        fn send_datagram(&self, packet: Bytes) -> ControlResult<()> {
+            if self.refuse {
+                return Err(StreamControlError::Backpressure);
+            }
+            self.packets.lock().unwrap().push(packet);
+            Ok(())
+        }
+    }
+    fn fixture(video: bool, maximum: usize) -> (ReadyMediaBinding, Packetizer, Wire, MediaFrame) {
+        let binding = ReadyMediaBinding {
+            negotiated: rvoip_core::stream_lifecycle::NegotiatedStream {
+                requested: rvoip_core::stream_lifecycle::DesiredStream {
+                    logical_id: StreamId::new(),
+                    medium: if video { Medium::Video } else { Medium::Audio },
+                    direction: StreamDirection::Both,
+                },
+                format: MediaFormat::Encoded {
+                    name: if video { "vp8" } else { "pcmu" }.into(),
+                    clock_rate_hz: if video { 90000 } else { 8000 },
+                    channels: if video { 0 } else { 1 },
+                    fmtp: None,
+                },
+            },
+            transport_id: StreamId::new(),
+            stream_local_id: 7,
+            generation: 1,
+            connection_generation: 1,
+            source_ready: true,
+            sink_ready: true,
+        };
+        let packetizer = Packetizer {
+            cursor: None,
+            feedback_epoch: None,
+            outer: 0,
+            rtp: 0,
+            ssrc: 1,
+            video: Default::default(),
+            previous_video: None,
+            clock_origin: None,
+            audio_clock: Default::default(),
+            cname: "io-counter-test".into(),
+            packets: 0,
+            octets: 0,
+            last_report: None,
+        };
+        let payload = if video {
+            let mut payload = vec![0u8; 800];
+            payload[0] = 0x10;
+            let mut header = rvoip_rtp_core::RtpHeader::new(96, 1, 3000, 1);
+            header.marker = true;
+            rvoip_rtp_core::RtpPacket::new(header, Bytes::from(payload))
+                .serialize()
+                .unwrap()
+        } else {
+            Bytes::from_static(b"encoded")
