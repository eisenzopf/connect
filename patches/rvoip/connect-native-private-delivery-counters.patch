+                io.inputs,
+                io.input_completions,
+                io.input_refused_before_primary,
+                io.input_errors[6]
+            ),
+            (1, 1, 1, 1)
+        );
+        assert_eq!(io.primary_attempts, 0);
+        assert!(wire.packets.lock().unwrap().is_empty());
+    }
+    #[test]
+    fn repeated_video_input_with_zero_output_is_not_counted_as_a_writer_attempt() {
+        let (binding, mut packetizer, wire, frame) = fixture(true, 1200);
+        let counters = StagedRtpCounters::default();
+        assert_eq!(
+            packetizer
+                .send_observed(
+                    frame.clone(),
+                    None,
+                    None,
+                    &binding,
+                    96,
+                    &wire,
+                    Some(&counters),
+                    |_| {}
+                )
+                .unwrap(),
+            1
+        );
+        // Exact repeats intentionally reuse the original fragments and write.
+        assert_eq!(
+            packetizer
+                .send_observed(
+                    frame.clone(),
+                    None,
+                    None,
+                    &binding,
+                    96,
+                    &wire,
+                    Some(&counters),
+                    |_| {}
+                )
+                .unwrap(),
+            1
+        );
+        // A conflicting repeat keeps the same sequence and source identity,
+        // but its changed payload is rejected before any primary write.
+        let mut conflicting = frame;
+        let mut payload = conflicting.payload.to_vec();
+        *payload.last_mut().unwrap() ^= 1;
+        conflicting.payload = Bytes::from(payload);
+        assert!(matches!(
+            packetizer.send_observed(
+                conflicting,
+                None,
+                None,
+                &binding,
+                96,
+                &wire,
+                Some(&counters),
+                |_| panic!("conflicting repeat reached writer"),
+            ),
+            Err(StreamControlError::NotReady)
+        ));
+        let io = &counters.io_snapshot()[1];
+        assert_eq!(
+            (
+                io.inputs,
+                io.input_completions,
+                io.primary_attempts,
+                io.primary_accepted,
+                io.input_refused_before_primary,
+                io.input_errors[6],
+                io.input_zero_datagrams,
+            ),
+            (3, 3, 2, 2, 1, 1, 0)
+        );
+        assert_eq!(io.primary_refused, 0);
+        assert_eq!(io.input_ok, 2);
+        assert_eq!(wire.packets.lock().unwrap().len(), 2);
+    }
+    #[test]
+    fn saturating_and_concurrent_counter_samples_never_underflow() {
+        let counters = StagedRtpCounters::default();
+        let io = counters.io_for(StreamKind::Audio);
+        io.inputs.store(u64::MAX, Ordering::Relaxed);
+        io_add(&io.inputs, 1);
+        io.primary_attempts.store(1, Ordering::Relaxed);
+        io.primary_accepted.store(u64::MAX, Ordering::Relaxed);
+        io_add(&io.primary_accepted, 3);
+        io.primary_refused.store(u64::MAX, Ordering::Relaxed);
+        io.input_completions.store(u64::MAX, Ordering::Relaxed);
+        let snapshot = counters.io_snapshot();
+        assert_eq!(snapshot[0].inputs, u64::MAX);
+        assert_eq!(snapshot[0].primary_accepted, u64::MAX);
+        assert_eq!(snapshot[0].primary_in_flight_sample, 0);
+        assert!(snapshot[0].saturated);
+        io.inputs.store(0, Ordering::Relaxed);
+        assert_eq!(counters.io_snapshot()[0].inputs_in_flight_sample, 0);
+    }
+}
