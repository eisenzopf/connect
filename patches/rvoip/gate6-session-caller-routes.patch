+#[derive(Default)]
+struct PeerCapture(std::sync::Mutex<Option<Arc<rvoip_core::peer_admission::PeerAdmission>>>);
+#[async_trait]
+impl AuthenticatedHandler for PeerCapture {
+    async fn handle(&self, a: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        *self.0.lock().unwrap() = a.peer_admission().cloned();
+        let r = a.envelope();
+        let mut v = envelope("ack", json!({}));
+        v["in_reply_to"] = json!(r.id());
+        for key in ["cid", "sid", "connid", "operation_id"] {
+            v[key] = r.original()[key].clone();
+        }
+        Envelope::from_value(v).map_err(DispatchError::from)
+    }
+}
+#[tokio::test(start_paused = true)]
+async fn verified_commands_refresh_routes_without_extending_old_handles_or_aliasing_physical_peers()
+{
+    let f = Fixture::new();
+    let registry = ReachabilityRegistry::new(8).unwrap();
+    let policy = RoutePolicy::new(f.policy.clone());
+    let mut first = routed_peer(&f, registry.clone(), policy.clone(), 1);
+    f.authenticate(&mut first, "old").await;
+    let old = current(&registry).remove(0);
+    tokio::time::advance(Duration::from_secs(2)).await;
+    let capture = PeerCapture::default();
+    first
+        .handle(&f.sign(command()), &capture, deadline())
+        .await
+        .unwrap();
+    let peer = capture.0.lock().unwrap().clone().unwrap();
+    let refreshed = current(&registry).remove(0);
+    assert!(refreshed.matches_peer(&peer));
+    assert!(!old.matches_peer(&peer));
+    assert!(!old.is_current());
+    assert!(old.same_physical_peer(&refreshed));
+    let mut second = routed_peer(&f, registry.clone(), policy, 5);
+    f.authenticate(&mut second, "old").await;
+    let capture = PeerCapture::default();
+    second
+        .handle(&f.sign(command()), &capture, deadline())
+        .await
+        .unwrap();
+    let other = capture.0.lock().unwrap().clone().unwrap();
+    assert!(!refreshed.matches_peer(&other));
+    assert_eq!(
+        current(&registry)
+            .iter()
+            .filter(|r| r.matches_peer(&peer))
+            .count(),
+        1
+    );
+    first.close();
+    second.close();
+}
