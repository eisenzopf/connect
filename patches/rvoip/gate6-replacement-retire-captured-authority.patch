+#[tokio::test]
+async fn rejected_replacement_conversions_release_retained_reply_guard_at_the_requested_cutoff() {
+    // Both consuming conversions can refuse at supports_native_negotiation
+    // before their later deadline/stream validations. The reply slot outlives
+    // the consumed original exactly as it does in the real dispatcher.
+    for media in [false, true] {
+        for state in 0..4 {
+            let (mut a, policy, grants, replay) = allocation_with_policy().await;
+            if media {
+                let mut original = a.envelope.original().clone();
+                original["payload"]["replacement_preparation"]["profile"] =
+                    json!("connect-replacement-media-v1");
+                a.envelope = Envelope::from_value(original).unwrap();
+            }
+            let reply = result(&a);
+            let slot = a.reply_authority.clone();
+            let requested = if state == 2 {
+                Instant::now() - Duration::from_millis(1)
+            } else {
+                Instant::now() + Duration::from_millis(500)
+            };
+            if state == 0 {
+                a.invocation.cancel();
+            }
+            if state == 1 {
+                a._lease.deadline = Some(Instant::now() - Duration::from_millis(1));
+            }
+            if media {
+                // state3 exercises a current command with invalid parameters;
+                // the remaining states fail currentness/deadline first.
+                let participant = if state == 3 {
+                    String::new()
+                } else {
+                    "part_alice".into()
+                };
+                assert!(a
+                    .into_resource_preparation(
+                        participant,
+                        ["audio".into()].into_iter().collect(),
+                        requested
+                    )
+                    .is_err());
+            } else {
+                if state == 3 {
+                    a.exchange = None;
+                }
+                assert!(a.into_replacement_allocation_wait(requested).is_err());
+            }
+            drop(
+                grants
+                    .clone()
+                    .try_write_owned()
+                    .expect("rejected consuming transition must release actual final reply Read"),
+            );
+            assert!(slot.for_replies(&[reply]).is_err());
+            let lease = slot.0.lock();
+            assert!(
+                lease.deadline().unwrap() <= requested,
+                "refusal metadata cannot outlive the rejected requested bound"
+            );
+            let resource = lease.authority::<ResourcePreparation>().unwrap();
+            assert!(resource.permits(&resource.original).is_err());
+            if state == 2 {
+                assert!(!lease.current());
+            }
+            assert_eq!(policy.calls.load(Ordering::Acquire), 0);
+            assert_eq!(replay.usage().0, 1);
+        }
+    }
+}
