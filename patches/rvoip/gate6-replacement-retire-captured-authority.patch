+#[tokio::test]
+async fn replacement_capture_retirement_releases_real_original_and_reply_guards_after_cancel_or_expiry(
+) {
+    for state in 0..3 {
+        let (mut a, policy, grants, replay) = allocation_with_policy().await;
+        let reply = result(&a);
+        let slot = a.reply_authority.clone();
+        if state == 1 {
+            a.invocation.cancel();
+        }
+        if state == 2 {
+            a._lease.deadline = Some(Instant::now() - Duration::from_millis(1));
+        }
+        assert!(grants.clone().try_write_owned().is_err());
+        a.retire_replacement_authority().unwrap();
+        drop(grants.clone().try_write_owned().expect(
+            "consuming capture retirement releases BOTH real domain aliases even after refusal",
+        ));
+        assert!(slot.resource_only());
+        assert!(
+            slot.for_replies(&[reply]).is_err(),
+            "retirement never restores a positive result"
+        );
+        let lease = slot.0.lock();
+        let resource = lease.authority::<ResourcePreparation>().unwrap();
+        assert!(resource.kind == PreparationKind::ReplacementAllocation);
+        assert!(
+            resource.permits(&resource.original).is_err(),
+            "retirement never grants parameter IO"
+        );
+        assert_eq!(policy.calls.load(Ordering::Acquire), 0);
+        assert_eq!(replay.usage().0, 1);
+    }
+}
