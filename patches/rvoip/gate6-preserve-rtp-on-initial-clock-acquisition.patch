@@ -0,0 +1,113 @@
+use super::*;
+use crate::substrate::observe_rtp_datagram;
+use rvoip_core::stream::{MediaClockAnchor, MediaSourceClock};
+use rvoip_core::stream_lifecycle::{DesiredStream, NegotiatedStream};
+struct Wire(Mutex<Vec<Bytes>>);
+impl StagedDatagramTransport for Wire {
+    fn maximum_datagram_bytes(&self) -> Option<usize> {
+        Some(1200)
+    }
+    fn is_closed(&self) -> bool {
+        false
+    }
+    fn send_datagram(&self, b: Bytes) -> ControlResult<()> {
+        self.0.lock().unwrap().push(b);
+        Ok(())
+    }
+}
+#[test]
+fn acquiring_first_clock_keeps_in_progress_vp8_ssrc_sequence_and_sender_counts() {
+    let binding = ReadyMediaBinding {
+        negotiated: NegotiatedStream {
+            requested: DesiredStream {
+                logical_id: StreamId::new(),
+                medium: Medium::Video,
+                direction: StreamDirection::Both,
+            },
+            format: MediaFormat::Encoded {
+                name: "vp8".into(),
+                clock_rate_hz: 90000,
+                channels: 0,
+                fmtp: None,
+            },
+        },
+        transport_id: StreamId::new(),
+        stream_local_id: 7,
+        generation: 1,
+        connection_generation: 1,
+        source_ready: true,
+        sink_ready: true,
+    };
+    let mut p = Packetizer {
+        outer: 0,
+        rtp: 0,
+        ssrc: 1,
+        video: Default::default(),
+        previous_video: None,
+        clock_origin: None,
+        cname: "video-clock".into(),
+        packets: 0,
+        octets: 0,
+        last_report: None,
+    };
+    let wire = Wire(Mutex::new(Vec::new()));
+    let ntp = rtcp::now_ntp();
+    for (n, body) in [vec![0x10, 0, 1, 2], vec![0, 3, 4]].into_iter().enumerate() {
+        let mut header = rvoip_rtp_core::RtpHeader::new(96, n as u16, 3000, 70);
+        header.marker = n == 1;
+        let payload = rvoip_rtp_core::RtpPacket::new(header, Bytes::from(body))
+            .serialize()
+            .unwrap();
+        let frame = MediaFrame {
+            stream_id: binding.transport_id.clone(),
+            kind: StreamKind::Video,
+            payload,
+            timestamp_rtp: 3000,
+            captured_at: chrono::Utc::now(),
+            payload_type: Some(96),
+            source_clock: Some(MediaSourceClock {
+                source_id: 42,
+                generation: 1,
+                supported: true,
+                rtp_offset: 0,
+                anchor: (n == 1).then_some(MediaClockAnchor {
+                    ntp_time: ntp,
+                    rtp_time: 3000,
+                    clock_rate: 90000,
+                }),
+                is_current: Arc::new(|| true),
+            }),
+        };
+        assert_eq!(
+            p.send(frame, None, &binding, 96, &wire, |_| {}).unwrap(),
+            1,
+            "initial clock acquisition discarded an in-progress frame"
+        );
+    }
+    let packets = wire.0.lock().unwrap();
+    let media = packets
+        .iter()
+        .filter(|b| !rtcp::is_rtcp(b))
+        .map(|b| observe_rtp_datagram(b).unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(media.len(), 2);
+    assert_eq!(
+        media[0].rtp.packet().header.ssrc,
+        media[1].rtp.packet().header.ssrc,
+        "initial clock acquisition retired a still-current SSRC"
+    );
+    assert_eq!(
+        media[1].rtp.packet().header.sequence_number,
+        media[0].rtp.packet().header.sequence_number.wrapping_add(1)
+    );
+    assert!(!media[0].rtp.packet().header.marker);
+    assert!(media[1].rtp.packet().header.marker);
+    let reports = packets
+        .iter()
+        .filter_map(|b| rtcp::parse(b))
+        .collect::<Vec<_>>();
+    assert_eq!(reports.len(), 1);
+    assert_eq!(reports[0].1.ssrc, media[1].rtp.packet().header.ssrc);
+    assert_eq!(reports[0].1.packets, 2);
+    assert_eq!(reports[0].1.octets, 7);
+}
