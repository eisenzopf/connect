+async fn fixed_video_scene(two_sinks: bool) -> Scene {
+    let f = Fixture::new(8);
+    f.a.change(
+        0,
+        &[desired(Medium::Video)],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+    )
+    .await
+    .unwrap();
+    let mut sink = desired(Medium::Video);
+    sink.logical_id = StreamId::from_string("camera-target");
+    let mut sinks = vec![sink.clone()];
+    if two_sinks {
+        sink.logical_id = StreamId::from_string("camera-other");
+        sinks.push(sink);
+    }
+    f.b.change(
+        0,
+        &sinks,
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+    )
+    .await
+    .unwrap();
+    let scene = GuardedMediaScene::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        f.policy.clone(),
+        8000,
+    );
+    for c in [&f.a, &f.b] {
+        let mut m = scene.prepare(c.clone()).unwrap();
+        m.quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        scene.insert(c.connection.clone(), m, true);
+    }
+    Scene { f, scene }
+}
