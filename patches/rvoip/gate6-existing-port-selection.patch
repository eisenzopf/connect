+        .scene
+        .plan_selection_existing_ports(&s.f.b.connection, s.f.b.revision(), &unknown)
+        .unwrap();
+    assert!(noop.routing().direct.is_none());
+    apply(&s, noop.routing().clone()).await.unwrap();
+    s.publish(Medium::Video, 12);
+    s.scene.tick();
+    outgoing(&mut out)
+        .await
+        .deliver(|f| async move {
+            assert_eq!(f.timestamp_rtp, 12);
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let remove = MediaSelectionChange::Unsubscribe(vec![source.clone()]);
+    let plan = s
+        .scene
+        .plan_selection_existing_ports(&s.f.b.connection, s.f.b.revision(), &remove)
+        .unwrap();
+    let Some(DirectSubscriptionChange::Unsubscribe(ids)) = &plan.routing().direct else {
+        panic!()
+    };
+    assert_eq!(ids, &vec![StreamId::from_string("camera-target")]);
+    apply(&s, plan.routing().clone()).await.unwrap();
+    assert!(old
+        .deliver(|_| async { panic!("withdrawn selection reached IO") })
+        .await
+        .is_err());
+    s.publish(Medium::Video, 13);
+    s.scene.tick();
+    assert!(out.try_recv().is_err());
+    let plan = s
+        .scene
+        .plan_selection_existing_ports(&s.f.b.connection, s.f.b.revision(), &select)
+        .unwrap();
+    apply(&s, plan.routing().clone()).await.unwrap();
+    s.publish(Medium::Video, 14);
+    s.scene.tick();
+    outgoing(&mut out)
+        .await
+        .deliver(|f| async move {
+            assert_eq!(f.timestamp_rtp, 14);
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        s.f.b
+            .active_bindings()
+            .iter()
+            .map(|b| (&b.transport_id, b.stream_local_id))
+            .collect::<Vec<_>>(),
+        before
+            .iter()
+            .map(|b| (&b.transport_id, b.stream_local_id))
+            .collect::<Vec<_>>()
+    );
+    assert_eq!(s.f.b.stream_open_budget(), budget);
+}
+#[tokio::test]
+async fn existing_port_selection_refuses_ambiguous_sinks_and_future_video_without_changes() {
+    use crate::staged_streams::subscription_plan::{MediaSelection, MediaSelectionChange};
+    let s = fixed_video_scene(true).await;
+    let before = s.f.b.revision();
+    let budget = s.f.b.stream_open_budget();
+    let select = MediaSelectionChange::Subscribe(vec![MediaSelection::Stream(
+        desired(Medium::Video).logical_id,
+    )]);
+    assert!(s
+        .scene
+        .plan_selection_existing_ports(&s.f.b.connection, before, &select)
+        .is_err());
+    assert_eq!(s.f.b.revision(), before);
+    assert_eq!(s.f.b.stream_open_budget(), budget);
+    let s = fixed_video_scene(false).await;
+    let before = s.f.b.revision();
+    let future = MediaSelectionChange::Subscribe(vec![MediaSelection::Participant {
+        participant: s.f.a.origin_member.participant().clone(),
+        media: BTreeSet::from([Medium::Video]),
+    }]);
+    assert!(s
+        .scene
+        .plan_selection_existing_ports(&s.f.b.connection, before, &future)
+        .is_err());
+    assert_eq!(s.f.b.revision(), before);
+}
