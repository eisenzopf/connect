+async fn existing_port_selection_preserves_distinct_source_and_target_and_current_removals() {
+    use crate::staged_streams::subscription_plan::{MediaSelection, MediaSelectionChange};
+    let s = fixed_video_scene(false).await;
+    let mut out = current(&s.f.b, "camera-target").take_egress().unwrap();
+    let before = s.f.b.active_bindings();
+    let budget = s.f.b.stream_open_budget();
+    let source = desired(Medium::Video).logical_id;
+    let select = MediaSelectionChange::Subscribe(vec![MediaSelection::Stream(source.clone())]);
+    let plan = s
+        .scene
+        .plan_selection_existing_ports(&s.f.b.connection, s.f.b.revision(), &select)
+        .unwrap();
+    assert_eq!(plan.desired().len(), 1);
+    assert_eq!(plan.desired()[0].logical_id.as_str(), "camera-target");
+    let Some(DirectSubscriptionChange::Subscribe(items)) = &plan.routing().direct else {
+        panic!()
+    };
+    assert_eq!(items[0].source.logical, source);
+    assert_eq!(items[0].receiver.as_str(), "camera-target");
+    assert!(!plan.requires_reconciliation());
+    s.publish(Medium::Video, 10);
+    s.scene.tick();
+    assert!(out.try_recv().is_err());
+    apply(&s, plan.routing().clone()).await.unwrap();
+    s.publish(Medium::Video, 11);
+    s.scene.tick();
+    let old = outgoing(&mut out).await;
+    // A local target ID is not the subscribed source and cannot clear it.
+    let unknown = MediaSelectionChange::Unsubscribe(vec![StreamId::from_string("camera-target")]);
