+#[tokio::test]
+async fn capability_declaration_metadata_requires_exact_live_credential_revision_and_never_changes_ports(
+) {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let principal = f.a.credential_snapshot().principal;
+    let revision = f.a.revision();
+    let before =
+        f.a.active_bindings()
+            .iter()
+            .map(|b| (b.negotiated.clone(), b.stream_local_id, b.generation))
+            .collect::<Vec<_>>();
+    let budget = f.a.stream_open_budget();
+    let calls = AtomicUsize::new(0);
+    let received =
+        f.a.commit_capability_declaration(&principal, revision, || {
+            calls.fetch_add(1, Ordering::SeqCst);
+            "received"
+        })
+        .unwrap();
+    assert_eq!(received, "received");
+    assert_eq!(f.a.revision(), revision);
+    assert_eq!(f.a.stream_open_budget(), budget);
+    assert_eq!(
+        f.a.active_bindings()
+            .iter()
+            .map(|b| (b.negotiated.clone(), b.stream_local_id, b.generation))
+            .collect::<Vec<_>>(),
+        before
+    );
+    assert!(f
+        .a
+        .commit_capability_declaration(&principal, revision + 1, || calls
+            .fetch_add(1, Ordering::SeqCst))
+        .is_err());
+    let foreign = f.b.credential_snapshot().principal;
+    assert!(f
+        .a
+        .commit_capability_declaration(&foreign, revision, || calls.fetch_add(1, Ordering::SeqCst))
+        .is_err());
+    let held = f.a.state.lock().unwrap();
+    assert!(matches!(
+        f.a.commit_capability_declaration(&principal, revision, || calls
+            .fetch_add(1, Ordering::SeqCst)),
+        Err(StreamControlError::NotReady)
+    ));
+    drop(held);
+    let held = f.a.credential.lock().unwrap();
+    assert!(matches!(
+        f.a.commit_capability_declaration(&principal, revision, || calls
+            .fetch_add(1, Ordering::SeqCst)),
+        Err(StreamControlError::NotReady)
+    ));
+    drop(held);
+    f.a.shutdown.cancel();
+    assert!(f
+        .a
+        .commit_capability_declaration(&principal, revision, || calls
+            .fetch_add(1, Ordering::SeqCst))
+        .is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
