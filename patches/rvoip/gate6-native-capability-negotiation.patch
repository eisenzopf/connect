+// Preserve a specific already negotiated binding in an effective validation
+// snapshot. Planners separately validate every new choice against the latest
+// declaration, so this cannot become an unrestricted future capability.
+fn retain_binding(remote: &mut EndpointMediaCapabilities, binding: &NegotiatedStream) {
+    let add = |set: &mut Vec<MediaCapability>| {
+        if let Some(cap) = set
+            .iter_mut()
+            .find(|c| c.medium == binding.requested.medium)
+        {
+            if !cap.formats.contains(&binding.format) {
+                cap.formats.push(binding.format.clone());
+            }
+        } else {
+            set.push(MediaCapability {
+                medium: binding.requested.medium,
+                formats: vec![binding.format.clone()],
+            });
+        }
+    };
+    if matches!(
+        binding.requested.direction,
+        StreamDirection::Receive | StreamDirection::Both
+    ) {
+        add(&mut remote.send);
+    }
