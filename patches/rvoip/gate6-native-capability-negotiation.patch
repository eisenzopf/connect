+#[test]
+fn capability_declarations_replace_future_catalogs_without_expanding_the_local_profile() {
+    let profile = profile();
+    let before = profile.capabilities().clone();
+    let remote=NativeOfferPlan::declaration(&json!({"audio_codecs":[{"name":"pcma","params":{"sample_rate":8000}}],"data_protocols":["future-protocol","json"],"future":{"exact":true}}),&profile,&actor()).unwrap();
+    assert_eq!(remote.max_streams, 8);
+    assert_eq!(
+        remote
+            .send
+            .iter()
+            .find(|m| m.medium == Medium::Audio)
+            .unwrap()
+            .formats,
+        vec![audio("pcma")]
+    );
+    assert_eq!(
+        remote
+            .send
+            .iter()
+            .find(|m| m.medium == Medium::Data)
+            .unwrap()
+            .formats,
+        vec![MediaFormat::ReliableOrdered(
+            rvoip_core::capability::DataProtocol::Json
+        )]
+    );
+    let withdrawn = NativeOfferPlan::declaration(&json!({}), &profile, &actor()).unwrap();
+    assert!(withdrawn.send.is_empty() && withdrawn.receive.is_empty());
+    let zero = NativeOfferPlan::declaration(
+        &json!({"max_streams_per_connection":0,"audio_codecs":[{"name":"pcmu"}]}),
+        &profile,
+        &actor(),
+    )
+    .unwrap();
+    assert_eq!(zero.max_streams, 0);
+    assert_eq!(profile.capabilities(), &before);
+    assert!(NativeOfferPlan::declaration(
+        &json!({"identity_assurance_offered":"user-authorized"}),
+        &profile,
+        &actor()
+    )
+    .is_err());
+    assert!(NativeOfferPlan::declaration(
+        &json!({"identity_assurance_required":"user-authorized"}),
+        &profile,
+        &actor()
+    )
+    .is_err());
+    assert!(NativeOfferPlan::declaration(
+        &json!({"max_streams_per_connection":33}),
+        &profile,
+        &actor()
+    )
+    .is_err());
+}
+#[test]
+fn new_capability_declarations_invalidate_old_prepared_negotiation_metadata() {
+    let principal = actor();
+    let profile = Arc::new(profile());
+    let broker = NativeNegotiation::new(
+        StagedRtpScope {
+            session: SessionId::from_string("session"),
+            connection: ConnectionId::from_string("connection"),
+            owner: principal.ownership_key(),
+            wire_conversation: Some("conversation".into()),
+            wire_session: "session".into(),
+            wire_connection: "connection".into(),
+        },
+        profile.clone(),
+        ParticipantId::from_string("participant"),
+        None,
+        CancellationToken::new(),
+        "quic",
+    );
+    let initial = NativeOfferPlan::parse(&offer(), &profile, &principal).unwrap();
+    assert!(broker.declare_capabilities(initial.remote.clone()).is_err());
+    *broker.retained.lock().unwrap() = Some(RetainedPeer {
+        negotiated: initial.remote.clone(),
+        declared: None,
+        substrate: "quic".into(),
+        declaration_generation: 0,
+    });
+    let old = NativeNegotiation::stamp_declaration(initial.clone(), 0);
+    broker.require_declaration_generation(&old).unwrap();
+    let changed = NativeOfferPlan::declaration(
+        &json!({"audio_codecs":[{"name":"pcma","params":{}}]}),
+        &profile,
+        &principal,
+    )
+    .unwrap();
+    broker.declare_capabilities(changed).unwrap();
+    assert!(matches!(
+        broker.require_declaration_generation(&old),
+        Err(NativeOfferError::Conflict)
+    ));
+    let now = NativeNegotiation::stamp_declaration(initial, 1);
+    broker.require_declaration_generation(&now).unwrap();
+    let retained = broker.retained.lock().unwrap();
+    assert_eq!(
+        retained.as_ref().unwrap().declared.as_ref().unwrap().send[0].formats,
+        vec![audio("pcma")]
+    );
+    drop(retained);
+    broker
+        .retained
+        .lock()
+        .unwrap()
+        .as_mut()
+        .unwrap()
+        .declaration_generation = super::super::MAX_SAFE_REVISION;
+    assert!(matches!(
+        broker.declare_capabilities(
+            NativeOfferPlan::declaration(&json!({}), &profile, &principal).unwrap()
+        ),
+        Err(NativeOfferError::Capacity)
+    ));
+    assert_eq!(
+        broker
+            .retained
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .declared
+            .as_ref()
+            .unwrap()
+            .send[0]
+            .formats,
+        vec![audio("pcma")]
+    );
+}
