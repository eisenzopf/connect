+//! Peer declarations affect future negotiation, never current media bindings.
+use super::{auth_dispatch::*, native_lifecycle::NativeLifecycleScope};
+use serde_json::Value;
+/// Derive a current grant from the actual declaration's held original domain.
+/// The callback is pure: never enter Core/controller locks or acquire another
+/// policy reader. A descriptor is metadata, not authenticated/media authority.
+pub trait NativeCapabilityDeclarationPolicy: Send + Sync {
+    fn authorize(
+        &self,
+        _scope: &NativeLifecycleScope,
+        _request: &AuthorizedEnvelope,
+        _descriptor: &Value,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+}
