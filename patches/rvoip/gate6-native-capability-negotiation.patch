+//! Local declaration metadata serializes with stream and credential changes.
+use super::*;
+impl StreamController {
+    /// Run a synchronous metadata commit under this exact live incarnation.
+    /// The host must independently hold current named declaration authority.
+    /// `commit` must be a leaf: no Core/controller or domain-policy reentry,
+    /// network IO or retained guard. This never changes media or grants rights.
+    pub fn commit_capability_declaration<T>(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        expected_revision: u64,
+        commit: impl FnOnce() -> T,
+    ) -> ControlResult<T> {
+        let state = self
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        let credential = self
+            .credential
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if self.shutdown.is_cancelled() || state.closed {
+            return Err(StreamControlError::Cancelled);
+        }
+        if state.model.revision() != expected_revision {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        if !reliable_data::same_credential(&credential.principal, principal)
+            || Self::principal_expiry(&credential.principal)
+                .is_some_and(|t| t <= chrono::Utc::now())
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(commit())
+    }
+}
