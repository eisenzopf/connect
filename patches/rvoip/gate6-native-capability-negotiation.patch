+#[test]
+fn new_declarations_keep_untouched_confirmed_bindings_without_reauthorizing_new_withdrawn_formats()
+{
+    let profile = profile();
+    let principal = actor();
+    let mut original = offer();
+    original.streams_offered[0].codec_preferences = vec!["pcmu".into()];
+    let plan = NativeOfferPlan::parse(&original, &profile, &principal).unwrap();
+    let mut bindings = codec_bindings(&plan);
+    bindings[1].negotiated = NegotiatedStream {
+        requested: DesiredStream {
+            logical_id: StreamId::from_string("existing-data"),
+            medium: Medium::Data,
+            direction: StreamDirection::Both,
+        },
+        format: MediaFormat::ReliableOrdered(rvoip_core::capability::DataProtocol::Binary),
+    };
+    let latest = NativeOfferPlan::declaration(
+        &json!({"audio_codecs":[{"name":"pcma","params":{}}]}),
+        &profile,
+        &principal,
+    )
+    .unwrap();
+    let update = codec_request(Some(vec!["one"]), &["pcma"]);
+    let changed = NativeOfferPlan::codec_update(&update, &profile, &latest, &bindings).unwrap();
+    assert_eq!(changed.selected()[0].format, audio("pcma"));
+    assert_eq!(changed.selected()[1], bindings[1].negotiated);
+    assert!(changed
+        .remote
+        .receive
+        .iter()
+        .any(|c| c.medium == Medium::Data));
+    // The effective retained-port snapshot does not change the declaration.
+    assert!(latest.receive.iter().all(|c| c.medium != Medium::Data));
+    assert!(NativeOfferPlan::codec_update(
+        &codec_request(Some(vec!["one"]), &["pcmu"]),
+        &profile,
+        &latest,
+        &bindings
+    )
+    .is_err());
