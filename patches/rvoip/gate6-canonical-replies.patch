diff --git a/crates/uctp/rvoip-uctp/tests/support/reply_batches.rs b/crates/uctp/rvoip-uctp/tests/support/reply_batches.rs
new file mode 100644
index 0000000..a6a49f6
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/tests/support/reply_batches.rs
@@ -0,0 +1,189 @@
+use super::*;
+
+#[derive(Default)]
+struct BatchHandler {
+    calls: AtomicUsize,
+}
+#[async_trait]
+impl AuthenticatedHandler for BatchHandler {
+    async fn handle(&self, env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        self.handle_replies(env).await?.into_one()
+    }
+    async fn handle_replies(&self, _: AuthorizedEnvelope) -> Result<HandlerReplies, DispatchError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        HandlerReplies::new(
+            (0..3)
+                .map(|n| {
+                    Envelope::from_value(envelope("ack", json!({"details":{"index":n}}))).unwrap()
+                })
+                .collect(),
+        )
+    }
+}
+
+#[tokio::test]
+async fn ordered_signed_batch_retains_current_lease_through_last_frame_with_queued_revocation() {
+    let f = Fixture::new();
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let handler = BatchHandler::default();
+    let request = command();
+    let output = peer
+        .handle(&f.sign(request.clone()), &handler, deadline())
+        .await
+        .unwrap();
+    assert_eq!(output.envelopes().len(), 3);
+    let revocations = f.policy.revoked.clone();
+    let queued = Arc::new(Notify::new());
+    let started = queued.clone();
+    let writer = tokio::spawn(async move {
+        started.notify_one();
+        revocations.write().await.insert("old".into());
+    });
+    queued.notified().await;
+    let mut ids = HashSet::new();
+    for (i, frame) in output.envelopes().iter().enumerate() {
+        assert_eq!(frame.original()["payload"]["details"]["index"], i);
+        assert_eq!(frame.scope(Scope::Reply), request["id"].as_str());
+        assert_eq!(frame.scope(Scope::Operation), Some("logical-op"));
+        assert!(ids.insert(frame.id()));
+        f.verify_server(frame).await;
+        assert!(!writer.is_finished());
+    }
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 1);
+    drop(output);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        peer.handle(&f.sign(command()), &handler, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::Authority
+    );
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn empty_overcount_and_overbyte_batches_reject_without_truncating() {
+    assert!(matches!(
+        HandlerReplies::new(vec![]),
+        Err(DispatchError::Capacity)
+    ));
+    let frame = Envelope::from_value(envelope("ack", json!({}))).unwrap();
+    assert!(HandlerReplies::new(vec![frame.clone(); MAX_HANDLER_REPLIES]).is_ok());
+    assert!(matches!(
+        HandlerReplies::new(vec![frame; MAX_HANDLER_REPLIES + 1]),
+        Err(DispatchError::Capacity)
+    ));
+    let large = Envelope::from_value(envelope(
+        "ack",
+        json!({"details":{"blob":"x".repeat(600_000)}}),
+    ))
+    .unwrap();
+    assert!(HandlerReplies::new(vec![large.clone(); 3]).is_ok());
+    assert!(matches!(
+        HandlerReplies::new(vec![large; 4]),
+        Err(DispatchError::Capacity)
+    ));
+}
+
+#[tokio::test]
+async fn forged_correlated_mutation_cannot_execute_or_consume_a_different_reply_family() {
+    let f = Fixture::new();
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let handler = Handler::default();
+    let request = Envelope::from_value(command()).unwrap();
+    let ticket = peer.register_reply(&request, deadline()).unwrap();
+    let mut forged = envelope(
+        "message.send",
+        json!({"msg_id":"forged","to":"all","content_type":"text/plain","body":"no effect"}),
+    );
+    forged["cid"] = json!("conversation");
+    forged["sid"] = json!("session");
+    forged["connid"] = json!("connection");
+    forged["in_reply_to"] = json!(request.id());
+    assert!(Envelope::from_value(forged.clone()).is_ok());
+    assert_eq!(
+        peer.handle(&f.sign(forged.clone()), &handler, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::ReplyMismatch
+    );
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 0);
+    // Match every resource and operation field so only the wrong reply family
+    // can explain this second rejection. The original waiter still survives.
+    forged["id"] = json!("forged-with-matching-operation");
+    forged["operation_id"] = request.original()["operation_id"].clone();
+    assert_eq!(
+        peer.handle(&f.sign(forged), &handler, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::ReplyMismatch
+    );
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 0);
+    let mut valid = envelope("ack", json!({}));
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        valid[field] = request.original()[field].clone();
+    }
+    valid["in_reply_to"] = json!(request.id());
+    let output = peer
+        .handle(&f.sign(valid), &handler, deadline())
+        .await
+        .unwrap();
+    assert!(output.envelopes().is_empty());
+    assert_eq!(ticket.wait().await.unwrap().kind(), "ack");
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn actual_tls_quic_preserves_multi_reply_order_correlation_and_signatures() {
+    let f = Fixture::new();
+    let (_server, _client, host, remote) = quic_pair().await;
+    let peer = f.peer();
+    let handler = Arc::new(BatchHandler::default());
+    let used = handler.clone();
+    let server = tokio::spawn(async move {
+        let (tx, rx) = host.accept_bi().await.unwrap();
+        peer.run(rx, tx, used.as_ref()).await
+    });
+    let (tx, rx) = remote.open_bi().await.unwrap();
+    let mut writer = FramedWrite::new(tx, rvoip_uctp::substrate::length_prefixed_codec());
+    let mut reader = FramedRead::new(rx, rvoip_uctp::substrate::length_prefixed_codec());
+    writer
+        .send(Bytes::from(serde_json::to_vec(&hello()).unwrap()))
+        .await
+        .unwrap();
+    let challenge = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    writer
+        .send(Bytes::from(f.sign(response(&challenge, "old"))))
+        .await
+        .unwrap();
+    let session = Envelope::parse(&reader.next().await.unwrap().unwrap()).unwrap();
+    assert_eq!(session.kind(), "auth.session");
+    let request = command();
+    writer
+        .send(Bytes::from(f.sign(request.clone())))
+        .await
+        .unwrap();
+    for i in 0..3 {
+        let frame = tokio::time::timeout(Duration::from_secs(3), reader.next())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        let frame = Envelope::parse(&frame).unwrap();
+        f.verify_server(&frame).await;
+        assert_eq!(frame.original()["payload"]["details"]["index"], i);
+        assert_eq!(frame.scope(Scope::Reply), request["id"].as_str());
+    }
+    writer.close().await.unwrap();
+    assert!(tokio::time::timeout(Duration::from_secs(3), server)
+        .await
+        .unwrap()
+        .unwrap()
+        .is_ok());
+    assert_eq!(handler.calls.load(Ordering::SeqCst), 1);
+}
