+#[derive(Default)]
+struct MultiStep {
+    tracking: Tracking,
+}
+#[async_trait]
+impl AuthenticatedHandler for MultiStep {
+    async fn handle(&self, env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        self.handle_replies(env).await?.into_one()
+    }
+    async fn handle_replies(
+        &self,
+        env: AuthorizedEnvelope,
+    ) -> Result<HandlerReplies, DispatchError> {
+        let reply = self.tracking.handle(env).await?;
+        HandlerReplies::new(
+            (0..2)
+                .map(|i| {
+                    let mut value = reply.original().clone();
+                    value["payload"] = json!({"details":{"batch_index":i}});
+                    Envelope::from_value(value).unwrap()
+                })
+                .collect(),
+        )
+    }
+}
+#[tokio::test]
+async fn stepup_executes_one_held_command_and_signs_every_ordered_batch_reply_under_transition_lease(
+) {
+    let f = Fixture::new();
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    let handler = MultiStep::default();
+    let request = command();
+    let output = peer
+        .handle(&f.sign(request.clone()), &handler, deadline())
+        .await
+        .unwrap();
+    assert_eq!(output.envelopes()[0].kind(), "identity.step-up-request");
+    let challenge = output.envelopes()[0].clone();
+    drop(output);
+    assert_eq!(handler.tracking.calls.load(Ordering::SeqCst), 0);
+    let output = peer
+        .handle(&f.sign(proof(&challenge, "user")), &handler, deadline())
+        .await
+        .unwrap();
+    assert_eq!(
+        output
+            .envelopes()
+            .iter()
+            .map(Envelope::kind)
+            .collect::<Vec<_>>(),
+        ["auth.session", "identity.assurance-changed", "ack", "ack"]
+    );
+    let mut ids = HashSet::new();
+    for frame in output.envelopes() {
+        f.verify_server(frame).await;
+        assert!(ids.insert(frame.id()));
+    }
+    for (i, frame) in output.envelopes()[2..].iter().enumerate() {
+        assert_eq!(frame.scope(Scope::Reply), request["id"].as_str());
+        assert_eq!(frame.original()["payload"]["details"]["batch_index"], i);
+    }
+    assert_eq!(handler.tracking.calls.load(Ordering::SeqCst), 1);
+    assert!(f.policy.revoked.try_write().is_err());
+    drop(output);
+    assert!(f.policy.revoked.try_write().is_ok());
+    assert_eq!(peer.generation(), Some(2));
+    assert!(!peer.has_pending_step_up());
+}
