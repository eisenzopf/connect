+pub const MAX_HANDLER_REPLIES: usize = 128;
+pub const MAX_HANDLER_REPLY_BYTES: usize = 2 * super::MAX_ENVELOPE_BYTES;
+/// Bounded reliable application reply sequence, owned by one invocation. Never
+/// truncates a history page or releases its current guard between frames.
+pub struct HandlerReplies(Vec<Envelope>);
+impl HandlerReplies {
+    pub fn new(envelopes: Vec<Envelope>) -> Result<Self, DispatchError> {
+        if envelopes.is_empty() || envelopes.len() > MAX_HANDLER_REPLIES {
+            return Err(DispatchError::Capacity);
+        }
+        let mut bytes = 0usize;
+        for envelope in &envelopes {
+            bytes = bytes
+                .checked_add(
+                    serde_json::to_vec(envelope)
+                        .map_err(|_| DispatchError::Closed)?
+                        .len(),
+                )
+                .ok_or(DispatchError::Capacity)?;
+            if bytes > MAX_HANDLER_REPLY_BYTES {
+                return Err(DispatchError::Capacity);
+            }
+        }
+        Ok(Self(envelopes))
+    }
+    pub fn envelopes(&self) -> &[Envelope] {
+        &self.0
+    }
+    pub fn into_envelopes(self) -> Vec<Envelope> {
+        self.0
+    }
+    pub fn into_one(mut self) -> Result<Envelope, DispatchError> {
+        if self.0.len() != 1 {
+            return Err(DispatchError::Unsupported);
+        }
+        Ok(self.0.remove(0))
+    }
+}
+impl fmt::Debug for HandlerReplies {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("HandlerReplies")
+            .field("frames", &self.0.len())
+            .finish_non_exhaustive()
+    }
+}
