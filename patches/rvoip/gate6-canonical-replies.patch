+    /// One dispatch may produce a bounded sequence (for example history items
+    /// followed by its final ACK). Single-reply handlers are the one-item case.
+    async fn handle_replies(
+        &self,
+        envelope: AuthorizedEnvelope,
+    ) -> Result<HandlerReplies, DispatchError> {
+        HandlerReplies::new(vec![self.handle(envelope).await?])
