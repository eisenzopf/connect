+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn scene_pending_visual_stale_cache_retains_fresh_pre_admission_successor_and_fifo() {
+    for metadata_busy in [true, false] {
+        let f = RecipientScene::new(&[Medium::Video], 1).await;
+        let (target, adapter) = &f.candidates[0];
+        let old = adapter.port(Medium::Video);
+        let old_ticket = old.0.ticket(TicketSide::Egress);
+        let mut retired_output = old.take_egress().unwrap();
+        target.change(target.revision(), &[desired(Medium::Video)], &[desired(Medium::Video).logical_id].into_iter().collect(), deadline(), CancellationToken::new()).await.unwrap();
+        let successor = adapter.port(Medium::Video);
+        let successor_ticket = successor.0.ticket(TicketSide::Egress);
+        let mut output = successor.take_egress().unwrap();
+        let mut healthy = f.f.ba.port(Medium::Video).take_egress().unwrap();
+        assert!(!old_ticket.is_current() && !old.same_original(&successor));
+        let admitted_after_cutover = Instant::now();
+        assert!(successor_ticket.committed_at().is_some_and(|at| at <= admitted_after_cutover));
+        // Both packets are truly NEW after the legitimate port commit, but
+        // this member still has its original stale adoption cache.
+        f.publish(Medium::Video, 9000);
+        f.publish(Medium::Video, 9001);
+        let flight = (!metadata_busy).then(|| target.inflight.clone().try_acquire_owned().unwrap());
+        let held = metadata_busy.then(|| target.state.lock().unwrap());
+        let (worker, done) = pending_tick_worker(f.scene.clone());
+        let completed_while_excluded = done.recv_timeout(Duration::from_millis(80)).is_ok();
+        drop((held, flight));
+        worker.join().unwrap();
+        assert!(completed_while_excluded);
+        expect_timestamp(&mut healthy, 9000).await;
+        expect_timestamp(&mut healthy, 9001).await;
+        assert!(output.try_recv().is_err() && retired_output.try_recv().is_err());
+        assert_eq!(f.retained(), (2, 2, 0, 0), "stale cache discarded original unresolved recipients");
+        assert!(f.f.policy.0.try_write().is_ok());
+        // Resolve the SAME originals once from the next successful adoption
+        // map. New ingress cannot overtake their original per-receiver FIFO.
+        f.publish(Medium::Video, 9002);
+        f.scene.tick();
+        for stamp in [9000, 9001, 9002] { expect_timestamp(&mut output, stamp).await; }
+        expect_timestamp(&mut healthy, 9002).await;
+        assert!(successor_ticket.is_current());
+        assert_eq!(f.retained(), (0, 0, 0, 0));
+        f.scene.tick();
+        assert!(output.try_recv().is_err() && healthy.try_recv().is_err() && retired_output.try_recv().is_err());
+    }
