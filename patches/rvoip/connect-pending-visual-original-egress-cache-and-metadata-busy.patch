+            assert_eq!(maximum, available);
+            f.publish(Medium::Data, 1);
+            f.publish(Medium::Data, 2);
+            f.publish(Medium::Video, 9000);
+            let held = target_state.then(|| target.state.lock().unwrap());
+            let port_held = (!target_state).then(|| port.0.state.lock().unwrap());
+            let (worker, done) = pending_tick_worker(f.scene.clone());
+            let completed_while_excluded = done.recv_timeout(Duration::from_millis(80)).is_ok();
+            drop((held, port_held));
+            worker.join().unwrap();
+            assert!(completed_while_excluded, "reliable Data metadata stalled the shared scene");
+            expect_timestamp(&mut healthy_video, 9000).await;
+            expect_timestamp(&mut healthy_data, 1).await;
+            assert!(blocked.try_recv().is_err());
+            assert_eq!(source.ingress_capacity().1, maximum - 1, "second original message was dequeued out of order");
+            assert_eq!(f.scene.retained_visual_for_test(&f.f.a.connection, &desired(Medium::Data).logical_id), (1, 1, 0, 0));
+            assert!(f.f.policy.0.try_write().is_ok());
+            if revoke {
+                f.f.policy.0.write().await.revoked.insert(target.connection.as_str().into());
+                f.publish(Medium::Video, 18000);
+                f.scene.tick();
+                expect_timestamp(&mut healthy_video, 18000).await;
+                assert!(blocked.try_recv().is_err() && healthy_data.try_recv().is_err(), "revoked Data recipient gained IO or later message overtook original");
+                assert_eq!(source.ingress_capacity().1, maximum - 1);
+                f.f.policy.0.write().await.revoked.remove(target.connection.as_str());
+            }
+            f.scene.tick();
+            expect_timestamp(&mut blocked, 1).await;
+            expect_timestamp(&mut blocked, 2).await;
+            expect_timestamp(&mut healthy_data, 2).await;
+            assert_eq!(source.ingress_capacity().1, maximum);
+            assert_eq!(f.scene.retained_visual_for_test(&f.f.a.connection, &desired(Medium::Data).logical_id), (0, 0, 0, 0));
+            f.scene.tick();
+            assert!(blocked.try_recv().is_err() && healthy_data.try_recv().is_err());
+        }
+    }
+}
