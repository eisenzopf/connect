+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn scene_pending_visual_metadata_retry_cannot_revive_revoked_or_expired_original() {
+    for reason in ["revoked", "authority-expired", "packet-expired"] {
+        let f = RecipientScene::new(&[Medium::Video], 1).await;
+        let (target, adapter) = &f.candidates[0];
+        let mut blocked = adapter.port(Medium::Video).take_egress().unwrap();
+        let mut healthy = f.f.ba.port(Medium::Video).take_egress().unwrap();
+        let published_at = Instant::now();
+        f.publish(Medium::Video, 9000);
+        let held = target.state.lock().unwrap();
+        let (worker, done) = pending_tick_worker(f.scene.clone());
+        let completed_while_excluded = done.recv_timeout(Duration::from_millis(80)).is_ok();
+        drop(held);
+        worker.join().unwrap();
+        assert!(completed_while_excluded, "tick waited on the actual metadata exclusion");
+        expect_timestamp(&mut healthy, 9000).await;
+        assert!(blocked.try_recv().is_err());
+        assert_eq!(f.retained().0, 1);
+        assert!(f.f.policy.0.try_write().is_ok(), "original retry kept an authority reader");
+        if reason == "authority-expired" {
+            // Early metadata Busy precedes a policy read. First let this SAME
+            // pending destination observe the actual shorter source grant,
+            // then refuse Receive without retaining that reader. Only this
+            // observed expiry can constrain its later retry.
+            *f.source_expiry.lock().unwrap() = Some(chrono::Utc::now() + chrono::Duration::milliseconds(40));
+            f.blocked.store(true, Ordering::Release);
+            f.scene.tick();
+            assert!(blocked.try_recv().is_err());
+            assert_eq!(f.retained().0, 1);
+            assert!(f.f.policy.0.try_write().is_ok());
+            f.blocked.store(false, Ordering::Release);
+        }
+        *f.source_expiry.lock().unwrap() = None;
+        if reason == "revoked" {
+            f.f.policy.0.write().await.revoked.insert(target.connection.as_str().into());
+        } else {
+            tokio::time::sleep(Duration::from_millis(if reason == "authority-expired" { 60 } else { 210 })).await;
+            if reason == "authority-expired" {
+                assert!(published_at.elapsed() < Duration::from_millis(200), "expiry control accidentally tested the packet-age limit instead");
+            }
+        }
+        f.scene.tick();
+        assert!(blocked.try_recv().is_err(), "old pending packet revived after {reason}");
+        assert_eq!(f.retained().0, 0);
+        f.f.policy.0.write().await.revoked.remove(target.connection.as_str());
+        f.publish(Medium::Video, 18000);
+        f.scene.tick();
+        expect_timestamp(&mut blocked, 18000).await;
+        expect_timestamp(&mut healthy, 18000).await;
+    }
+}
