+// The original tick is joined even when the counterfactual blocking read
+// cannot finish while this test holds the real target metadata mutex.
+fn pending_tick_worker(
+    scene: Arc<GuardedMediaScene>,
+) -> (std::thread::JoinHandle<()>, std::sync::mpsc::Receiver<()>) {
+    let runtime = tokio::runtime::Handle::current();
+    let (done, observed) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        let _entered = runtime.enter();
+        scene.tick();
+        let _ = done.send(());
+    });
+    (worker, observed)
+}
