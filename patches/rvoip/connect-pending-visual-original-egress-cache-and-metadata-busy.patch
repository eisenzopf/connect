+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn scene_pending_visual_target_metadata_busy_keeps_original_and_healthy_recipient_progress() {
+    for medium in [Medium::Video, Medium::Screen] {
+        for target_state in [true, false] {
+            let f = RecipientScene::new(&[medium], 1).await;
+            let (target, adapter) = &f.candidates[0];
+            let port = adapter.port(medium);
+            let original_ticket = port.0.ticket(TicketSide::Egress);
+            let mut blocked = port.take_egress().unwrap();
+            let mut healthy = f.f.ba.port(medium).take_egress().unwrap();
+            f.publish(medium, 9000);
+            let state = target_state.then(|| target.state.lock().unwrap());
+            let port_state = (!target_state).then(|| port.0.state.lock().unwrap());
+            let (worker, done) = pending_tick_worker(f.scene.clone());
+            let completed_while_excluded = done.recv_timeout(Duration::from_millis(80)).is_ok();
+            // Release before joining/asserting, including a failed old-code
+            // counterfactual. No worker or held mutex outlives this control.
+            drop((state, port_state));
+            worker.join().unwrap();
+            assert!(completed_while_excluded, "original tick blocked on actual target metadata target_state={target_state} medium={medium:?}");
+            expect_timestamp(&mut healthy, 9000).await;
+            assert!(blocked.try_recv().is_err());
+            assert_eq!(f.scene.retained_visual_for_test(&f.f.a.connection, &desired(medium).logical_id), (1, 1, 0, 0));
+            assert!(original_ticket.is_current() && original_ticket.same_generation(&port.0.ticket(TicketSide::Egress)));
+            assert!(f.f.policy.0.try_write().is_ok(), "pending target retained permission");
+            f.scene.tick();
+            expect_timestamp(&mut blocked, 9000).await;
+            f.scene.tick();
+            assert!(blocked.try_recv().is_err() && healthy.try_recv().is_err(), "same original delivered twice");
+            assert_eq!(f.scene.retained_visual_for_test(&f.f.a.connection, &desired(medium).logical_id), (0, 0, 0, 0));
+        }
+    }
+}
