+#[tokio::test]
+async fn scene_pending_visual_never_captures_post_admission_port_or_egress_generation() {
+    for mode in ["stale-cache", "refreshed-cache", "same-port-successor"] {
+        for already_pending in [false, true] {
+            let f = RecipientScene::new(&[Medium::Video], 1).await;
+            let (target, adapter) = &f.candidates[0];
+            let old_port = adapter.port(Medium::Video);
+            let old_ticket = old_port.0.ticket(TicketSide::Egress);
+            let mut old_output = old_port.take_egress().unwrap();
+            let mut healthy = f.f.ba.port(Medium::Video).take_egress().unwrap();
+            f.blocked.store(already_pending, Ordering::Release);
+            f.publish(Medium::Video, 9000);
+            let admitted_before_cutover = Instant::now();
+            if already_pending {
+                f.scene.tick();
+                expect_timestamp(&mut healthy, 9000).await;
+                assert_eq!(f.retained().0, 1);
+            }
+            f.blocked.store(false, Ordering::Release);
+            let logical = desired(Medium::Video).logical_id;
+            let mut successor_output = if mode == "same-port-successor" {
+                let ids = [logical.clone()].into_iter().collect();
+                target.set_media_gate(target.revision(), &ids, StreamGateAction::Pause, deadline()).await.unwrap();
+                target.set_media_gate(target.revision(), &ids, StreamGateAction::Resume, deadline()).await.unwrap();
+                assert!(old_port.same_original(&adapter.port(Medium::Video)));
+                None
+            } else {
+                target.change(target.revision(), &[desired(Medium::Video)], &[logical.clone()].into_iter().collect(), deadline(), CancellationToken::new()).await.unwrap();
+                let successor = adapter.port(Medium::Video);
+                assert!(!old_port.same_original(&successor));
+                Some(successor.take_egress().unwrap())
+            };
+            let successor = adapter.port(Medium::Video);
+            let successor_ticket = successor.0.ticket(TicketSide::Egress);
+            assert!(!old_ticket.is_current());
+            assert!(successor_ticket.committed_at().is_some_and(|at| at > admitted_before_cutover));
+            // A live original control permit skips adoption and leaves only
+            // the old cached Weak. Otherwise adoption observes the successor.
+            let flight = (mode == "stale-cache").then(|| target.inflight.clone().try_acquire_owned().unwrap());
+            f.scene.tick();
+            drop(flight);
+            if !already_pending { expect_timestamp(&mut healthy, 9000).await; }
+            assert!(old_output.try_recv().is_err(), "pre-cutover packet returned to original port");
+            if let Some(output) = successor_output.as_mut() {
+                assert!(output.try_recv().is_err(), "old packet late-captured successor port");
+            }
+            if mode == "stale-cache" && !already_pending {
+                // The old weak cache cannot distinguish a future successor
+                // until the next real adoption snapshot. It retains this
+                // original destination, then rejects its known-late cutover.
+                assert_eq!(f.retained().0, 1);
+                f.scene.tick();
+                assert!(old_output.try_recv().is_err());
+                assert!(successor_output.as_mut().unwrap().try_recv().is_err());
+            }
+            assert_eq!(f.retained().0, 0);
+            // A genuinely fresh packet still reaches the exact new current
+            // receiver. The temporal refusal is not permanent suppression.
+            f.scene.tick();
+            f.publish(Medium::Video, 18000);
+            f.scene.tick();
+            if let Some(output) = successor_output.as_mut() {
+                expect_timestamp(output, 18000).await;
+            } else {
+                expect_timestamp(&mut old_output, 18000).await;
+            }
+            expect_timestamp(&mut healthy, 18000).await;
+        }
+    }
+}
