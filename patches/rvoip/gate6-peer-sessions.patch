+        &actor("alice"),
+        intent,
+        &lease(f, "alice", &["bob"]),
+    )
+}
+fn count_started(rx: &mut tokio::sync::broadcast::Receiver<Event>) -> usize {
+    let mut n = 0;
+    while let Ok(ev) = rx.try_recv() {
+        if matches!(ev, Event::SessionStarted { .. }) {
+            n += 1;
+        }
+    }
+    n
+}
