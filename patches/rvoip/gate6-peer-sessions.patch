diff --git a/crates/uctp/rvoip-uctp/tests/support/peer_sessions.rs b/crates/uctp/rvoip-uctp/tests/support/peer_sessions.rs
new file mode 100644
index 0000000..151fb7f
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/tests/support/peer_sessions.rs
@@ -0,0 +1,349 @@
+//! Canonical wire-to-Core mapping with one typed current authority lease.
+use super::*;
+use rvoip_core::{
+    ids::SessionId,
+    orchestrator::peer_sessions::*,
+    relationships::Membership,
+    session::{SessionMedium, SessionState},
+};
+use std::collections::HashMap;
+struct Grants {
+    denied: bool,
+    actor: Membership,
+    recipient: Membership,
+    sessions: HashMap<String, SessionId>,
+}
+struct Prepared {
+    _base: AuthorityLease,
+    _guard: tokio::sync::OwnedRwLockReadGuard<Grants>,
+    authority: PeerSessionAuthority,
+    intent: Option<PeerSessionStart>,
+}
+impl PeerSessionAuthorityLease for Prepared {
+    fn authority(&self) -> &PeerSessionAuthority {
+        &self.authority
+    }
+}
+struct SessionPolicy {
+    base: Arc<Policy>,
+    grants: Arc<RwLock<Grants>>,
+    conversation: rvoip_core::ConversationId,
+}
+impl SessionPolicy {
+    async fn lease(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let base = self.base.guard(c, d, i, e).await?;
+        self.prepare(base, e).await
+    }
+    async fn prepare(
+        &self,
+        base: AuthorityLease,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let guard = self.grants.clone().read_owned().await;
+        if guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        let intent = if e.kind() == "session.invite" {
+            if e.scope(Scope::Conversation) != Some("conversation")
+                || e.original()["payload"]["to"] != json!(["recipient-bob"])
+                || e.original()["payload"]["medium"] != "voice"
+            {
+                return Err(DispatchError::Authority);
+            }
+            let session = guard
+                .sessions
+                .get(e.scope(Scope::Session).ok_or(DispatchError::Authority)?)
+                .ok_or(DispatchError::Authority)?
+                .clone();
+            Some(PeerSessionStart {
+                session,
+                conversation: self.conversation.clone(),
+                medium: SessionMedium::Voice,
+                invitees: vec![guard.recipient.participant().clone()],
+            })
+        } else {
+            None
+        };
+        let authority = PeerSessionAuthority {
+            actor: guard.actor.clone(),
+            invitees: vec![guard.recipient.clone()],
+            may_create: true,
+            may_attach: true,
+        };
+        Ok(AuthorityLease::holding(Prepared {
+            _base: base,
+            _guard: guard,
+            authority,
+            intent,
+        }))
+    }
+}
+#[async_trait]
+impl PeerAuthority for SessionPolicy {
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.lease(c, d, i, e).await
+    }
+    async fn refresh(
+        &self,
+        old: &ValidatedBearer,
+        new: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        // Retain the old credential guard too; no re-read of the grant lock.
+        let lease = self.base.refresh(old, new, d, i, e).await?;
+        self.prepare(lease, e).await
+    }
+}
+struct SessionHandler {
+    core: Arc<core_fixture::Fixture>,
+    peer: std::sync::Mutex<Option<Arc<PeerAdmission>>>,
+    pause: AtomicBool,
+    entered: Notify,
+    release: Notify,
+    calls: AtomicUsize,
+}
+#[async_trait]
+impl AuthenticatedHandler for SessionHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        assert!(authorized.authority::<u64>().is_none());
+        let proof = authorized
+            .authority::<Prepared>()
+            .ok_or(DispatchError::Authority)?;
+        let intent = proof.intent.as_ref().ok_or(DispatchError::Authority)?;
+        let peer = authorized
+            .peer_admission()
+            .ok_or(DispatchError::Authority)?
+            .clone();
+        {
+            let mut first = self.peer.lock().unwrap();
+            if let Some(first) = &*first {
+                assert!(Arc::ptr_eq(first, &peer));
+            } else {
+                *first = Some(peer.clone());
+            }
+        }
+        let request = authorized.envelope();
+        let mut reply = envelope("ack", json!({"details":{"reserved":true}}));
+        for field in ["cid", "sid", "operation_id"] {
+            reply[field] = request.original()[field].clone();
+        }
+        reply["in_reply_to"] = json!(request.id());
+        let reply = Envelope::from_value(reply)?;
+        if self.pause.swap(false, Ordering::SeqCst) {
+            self.entered.notify_one();
+            self.release.notified().await;
+        }
+        self.core
+            .orch
+            .start_peer_session(peer, authorized.principal(), intent, proof)
+            .map_err(|e| match e {
+                PeerSessionError::Capacity => DispatchError::Capacity,
+                _ => DispatchError::Authority,
+            })?;
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Ok(reply)
+    }
+}
+async fn setup() -> (Fixture, Arc<SessionHandler>, Arc<SessionPolicy>) {
+    let mut f = Fixture::new();
+    let core = Arc::new(core_fixture::Fixture::new().await);
+    let (actor, recipient) = {
+        let state = core.policy.0.read().unwrap();
+        (
+            state.members[&core_fixture::participant("alice")].clone(),
+            state.members[&core_fixture::participant("bob")].clone(),
+        )
+    };
+    let policy = Arc::new(SessionPolicy {
+        base: f.policy.clone(),
+        grants: Arc::new(RwLock::new(Grants {
+            denied: false,
+            actor,
+            recipient,
+            sessions: (0..33)
+                .map(|i| (format!("pending_{i}"), SessionId::new()))
+                .collect(),
+        })),
+        conversation: core.conversation.clone(),
+    });
+    Arc::get_mut(&mut f.config).unwrap().authority = policy.clone();
+    let handler = Arc::new(SessionHandler {
+        core,
+        peer: std::sync::Mutex::new(None),
+        pause: AtomicBool::new(false),
+        entered: Notify::new(),
+        release: Notify::new(),
+        calls: AtomicUsize::new(0),
+    });
+    (f, handler, policy)
+}
+fn invite(index: usize) -> Value {
+    let mut v = envelope(
+        "session.invite",
+        json!({"from":"asserted-actor","to":["recipient-bob"],"medium":"voice","intent":"call","capabilities_offer":{}}),
+    );
+    v["cid"] = json!("conversation");
+    v["sid"] = json!(format!("pending_{index}"));
+    v["operation_id"] = json!(format!("reserve_{index}"));
+    v
+}
+#[tokio::test]
+async fn local_tls_pending_sessions_share_one_quota_across_refresh_and_physical_eof() {
+    for kind in ["quic", "wt", "ws"] {
+        let (f, h, policy) = setup().await;
+        let profile = CanonicalProfile::new(f.config.clone(), h.clone(), 8).unwrap();
+        let mut wire = wire(kind, profile, "/uctp", Some("https://allowed.example"))
+            .await
+            .unwrap();
+        authenticate_wire(&mut wire, &f).await;
+        for i in 0..32 {
+            if i == 16 {
+                wire.send(f.sign(envelope(
+                    "auth.refresh",
+                    json!({"method":"bearer","credential":"new"}),
+                )))
+                .await;
+                let session = wire.read().await;
+                assert_eq!(session.kind(), "auth.session");
+                f.verify_server(&session).await;
+            }
+            wire.send(f.sign(invite(i))).await;
+            let ack = wire.read().await;
+            assert_eq!(ack.kind(), "ack");
+            f.verify_server(&ack).await;
+        }
+        let peer = h.peer.lock().unwrap().clone().unwrap();
+        assert_eq!(peer.snapshot().sessions, 32);
+        assert_eq!(peer.snapshot().connections, 0);
+        assert_eq!(h.calls.load(Ordering::SeqCst), 32);
+        assert_eq!(h.core.adapter.accepted.load(Ordering::Acquire), 0);
+        wire.send(f.sign(invite(0))).await;
+        assert_eq!(wire.read().await.kind(), "ack");
+        assert_eq!(peer.snapshot().sessions, 32);
+        wire.server.shutdown().await.unwrap();
+        assert!(peer.is_closed());
+        assert_eq!(peer.snapshot().sessions, 0);
+        for sid in policy.grants.read().await.sessions.values() {
+            if let Some(session) = h.core.orch.session(sid) {
+                let s = session.read().unwrap();
+                assert_eq!(s.state, SessionState::Initiating);
+                assert!(s.connections.is_empty());
+                assert!(s.participants.is_empty());
+            }
+        }
+    }
+}
+#[tokio::test]
+async fn queued_grant_writer_waits_through_core_commit_and_output_then_denies_next_invocation() {
+    use std::future::Future;
+    let (f, h, policy) = setup().await;
+    let mut peer = f.peer();
+    f.authenticate(&mut peer, "old").await;
+    h.pause.store(true, Ordering::SeqCst);
+    let raw = f.sign(invite(0));
+    let handler = h.clone();
+    let task = tokio::spawn(async move {
+        let out = peer
+            .handle(&raw, handler.as_ref(), deadline())
+            .await
+            .unwrap();
+        (peer, out)
+    });
+    h.entered.notified().await;
+    let queued = Arc::new(Notify::new());
+    let signal = queued.clone();
+    let grants = policy.grants.clone();
+    let writer = tokio::spawn(async move {
+        let mut future = Box::pin(grants.write_owned());
+        let mut guard = futures::future::poll_fn(|cx| {
+            let result = future.as_mut().poll(cx);
+            if result.is_pending() {
+                signal.notify_one();
+            }
+            result
+        })
+        .await;
+        guard.denied = true;
+    });
+    queued.notified().await;
+    assert!(!writer.is_finished());
+    h.release.notify_one();
+    let (mut peer, out) = tokio::time::timeout(Duration::from_secs(2), task)
+        .await
+        .expect("Core call must reuse the held lease, despite queued writer")
+        .unwrap();
+    assert_eq!(h.calls.load(Ordering::SeqCst), 1);
+    assert!(!writer.is_finished());
+    drop(out);
+    tokio::time::timeout(Duration::from_secs(2), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(peer
+        .handle(&f.sign(invite(1)), h.as_ref(), deadline())
+        .await
+        .is_err());
+    assert_eq!(h.calls.load(Ordering::SeqCst), 1);
+    let context = h.peer.lock().unwrap().clone().unwrap();
+    assert_eq!(context.snapshot().sessions, 1);
+    drop(peer);
+    assert_eq!(context.snapshot().sessions, 0);
+}
+#[tokio::test]
+async fn mismatched_authority_type_denies_before_any_core_session_effect() {
+    let (f, h, _) = setup().await;
+    let plain = Fixture::new();
+    let mut config = PeerConfig {
+        methods: plain.config.methods.clone(),
+        verifier: f.config.verifier.clone(),
+        signer: f.config.signer.clone(),
+        authority: plain.policy.clone(),
+        pending_capacity: 2,
+    };
+    // Same trusted keys, but a backend which provides no Prepared Session lease.
+    config.methods = f.config.methods.clone();
+    let mut peer = CanonicalPeer::new(Arc::new(config), CancellationToken::new()).unwrap();
+    f.authenticate(&mut peer, "old").await;
+    let before = h
+        .core
+        .orch
+        .conversation(&h.core.conversation)
+        .unwrap()
+        .read()
+        .unwrap()
+        .sessions
+        .len();
+    assert!(peer
+        .handle(&f.sign(invite(0)), h.as_ref(), deadline())
+        .await
+        .is_err());
+    assert_eq!(h.calls.load(Ordering::SeqCst), 0);
+    assert_eq!(
+        h.core
+            .orch
+            .conversation(&h.core.conversation)
+            .unwrap()
+            .read()
+            .unwrap()
+            .sessions
+            .len(),
+        before
+    );
+}
