+async fn admit(
+    f: &Fixture,
+    peer: &std::sync::Arc<PeerAdmission>,
+    session: &rvoip_core::SessionId,
+    name: &str,
+    id: &rvoip_core::ConnectionId,
+) -> ControlResult<ParticipantObservation> {
+    let mutation = f.intent(
+        session,
+        name,
+        &format!("op_{}", uuid::Uuid::new_v4().simple()),
+        ParticipantChange::Admit {
+            connection: id.clone(),
+            role_override: None,
+        },
+    );
+    f.orch
+        .admit_peer_session_connection(
+            peer.clone(),
+            session,
+            actor(name),
+            mutation,
+            tokio::time::Instant::now() + Duration::from_secs(3),
+            CancellationToken::new(),
+        )
+        .await
+}
+use rvoip_core::{
+    adapter::EndReason,
+    events::Event,
+    orchestrator::peer_sessions::*,
