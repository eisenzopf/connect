+fn actor(name: &str) -> AuthenticatedPrincipal {
+    let mut p = principal(name);
+    p.expires_at = Some(chrono::Utc::now() + chrono::Duration::hours(1));
+    p.assurance = IdentityAssurance::Identified {
+        credential_kind: CredentialKind::Oidc,
+    };
+    p
+}
+fn scope_owner(
+    name: &str,
+    limits: PeerAdmissionLimits,
+    parent: CancellationToken,
+) -> PeerAdmissionOwner {
+    PeerAdmissionOwner::new(
+        &actor(name),
+        IdentityId::from_string(format!("id_{name}")),
+        DeviceId::from_string(format!("device_{name}")),
+        parent,
+        limits,
+    )
+    .unwrap()
+}
+async fn connection(
+    f: &Fixture,
+    name: &str,
+    ready: bool,
+) -> (rvoip_core::ConnectionId, std::sync::Arc<TestStream>) {
+    let (id, stream) = f.connection(name, ready).await;
+    let p = actor(name);
+    let binding = IdentityBinding::from_authenticated(
+        &p,
+        IdentityId::from_string(format!("id_{name}")),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let mut endpoint = EndpointBinding::provision(
+        binding.clone(),
+        EndpointId::new(),
+        DeviceId::from_string(format!("device_{name}")),
+        rvoip_core::Transport::Sip,
+        "sip:fixture.invalid".into(),
+    )
+    .unwrap();
+    endpoint
+        .verify(&binding, "controlled-proof".into(), chrono::Utc::now())
+        .unwrap();
+    f.policy
+        .0
+        .write()
+        .unwrap()
+        .endpoints
+        .insert(id.clone(), endpoint);
+    f.adapter.authenticate(&id, p).await;
+    until(|| f.orch.connection_principal(&id).is_ok()).await;
+    (id, stream)
