+    SessionId,
+};
+struct Lease<'a> {
+    _guard: std::sync::RwLockReadGuard<'a, PolicyState>,
+    authority: PeerSessionAuthority,
+}
+impl PeerSessionAuthorityLease for Lease<'_> {
+    fn authority(&self) -> &PeerSessionAuthority {
+        &self.authority
+    }
+}
+fn lease<'a>(f: &'a Fixture, name: &str, invitees: &[&str]) -> Lease<'a> {
+    let state = f.policy.0.read().unwrap();
+    let authority = PeerSessionAuthority {
+        actor: state.members[&participant(name)].clone(),
+        invitees: invitees
+            .iter()
+            .map(|name| state.members[&participant(name)].clone())
+            .collect(),
+        may_create: !state.denied,
+        may_attach: !state.denied,
+    };
+    Lease {
+        _guard: state,
+        authority,
+    }
+}
+fn intent(f: &Fixture, invitees: &[&str]) -> PeerSessionStart {
+    PeerSessionStart {
