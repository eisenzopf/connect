+++ b/crates/foundation/rvoip-core/src/orchestrator/peer_sessions.rs
@@ -0,0 +1,423 @@
+//! Physical Session views, including pending invitations without Connections.
+//! These are bounded runtime associations, not a durable invitation journal.
+//! The application selects stable IDs and supplies its already-held current
+//! authority lease. No second policy read is performed inside a Core call.
+use super::*;
+use crate::{
+    identity::AuthenticatedPrincipal,
+    ids::IdentityId,
+    peer_admission::{PeerAdmission, PeerAdmissionError, PeerSessionPermit},
+    relationships::Membership,
+};
+use uuid::Uuid;
+
+/// IDs come from the trusted application mapping/journal, never wire aliases.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PeerSessionStart {
+    pub session: SessionId,
+    pub conversation: ConversationId,
+    pub medium: SessionMedium,
+    pub invitees: Vec<ParticipantId>,
+}
+
+/// Resolved under the caller's current policy guard. Roles alone grant nothing.
+pub struct PeerSessionAuthority {
+    pub actor: Membership,
+    pub invitees: Vec<Membership>,
+    pub may_create: bool,
+    pub may_attach: bool,
+}
+/// Trusted composition boundary: hold current membership/grants and revocation
+/// protection through this synchronous call. A cached boolean is not a lease.
+pub trait PeerSessionAuthorityLease {
+    fn authority(&self) -> &PeerSessionAuthority;
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum PeerSessionError {
+    #[error("current Session authority denied")]
+    Authority,
+    #[error("Session resource capacity exhausted")]
+    Capacity,
+    #[error("Session intent conflicts")]
+    Conflict,
+    #[error("Session or physical peer closed")]
+    Closed,
+    #[error("Session runtime rejected creation")]
+    Runtime,
+}
+impl From<PeerAdmissionError> for PeerSessionError {
+    fn from(value: PeerAdmissionError) -> Self {
+        match value {
+            PeerAdmissionError::Authority => Self::Authority,
+            PeerAdmissionError::Capacity => Self::Capacity,
+            PeerAdmissionError::Conflict => Self::Conflict,
+            PeerAdmissionError::Closed => Self::Closed,
+        }
+    }
+}
+#[derive(Clone, PartialEq, Eq)]
+struct MemberEpoch {
+    participant: ParticipantId,
+    identity: IdentityId,
+    epoch: u64,
+}
+impl From<&Membership> for MemberEpoch {
+    fn from(member: &Membership) -> Self {
+        Self {
+            participant: member.participant().clone(),
+            identity: member.identity().clone(),
+            epoch: member.epoch(),
+        }
+    }
+}
+struct CreationOrigin {
+    physical: Uuid,
+    intent: PeerSessionStart,
+    creator: MemberEpoch,
+    invitees: Vec<MemberEpoch>,
+}
+pub(super) struct PeerSessionRegistry {
+    views: HashMap<(SessionId, Uuid), Arc<PeerSessionPermit>>,
+    origins: HashMap<SessionId, CreationOrigin>,
+    retention_limit: usize,
+    pub(super) closing: HashSet<ConversationId>,
+}
+impl PeerSessionRegistry {
+    pub(super) fn owns(&self, session: &SessionId) -> bool {
+        self.origins.contains_key(session)
+    }
+}
+impl Default for PeerSessionRegistry {
+    fn default() -> Self {
+        Self {
+            views: HashMap::new(),
+            origins: HashMap::new(),
+            retention_limit: 10_000,
+            closing: HashSet::new(),
+        }
+    }
+}
+/// Pending close excludes new Sessions while asynchronous media cleanup runs.
+/// Cancellation releases the fence; already-ended Sessions stay terminal.
+pub(super) struct ClosingConversation {
+    pub(super) registry: Arc<Mutex<PeerSessionRegistry>>,
+    pub(super) conversation: ConversationId,
+}
+impl Drop for ClosingConversation {
+    fn drop(&mut self) {
+        self.registry
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .closing
+            .remove(&self.conversation);
+    }
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+}
+fn normalized(
+    intent: &PeerSessionStart,
+    authority: &PeerSessionAuthority,
+) -> std::result::Result<(PeerSessionStart, Vec<MemberEpoch>), PeerSessionError> {
+    if !identifier(intent.session.as_str())
+        || !identifier(intent.conversation.as_str())
+        || intent.invitees.len() > 256
+        || authority.invitees.len() != intent.invitees.len()
+    {
+        return Err(PeerSessionError::Conflict);
+    }
+    let mut intent = intent.clone();
+    intent.invitees.sort_by(|a, b| a.as_str().cmp(b.as_str()));
+    if intent.invitees.windows(2).any(|pair| pair[0] == pair[1])
+        || intent.invitees.iter().any(|id| !identifier(id.as_str()))
+    {
+        return Err(PeerSessionError::Conflict);
+    }
+    let mut members = Vec::with_capacity(intent.invitees.len());
+    for member in &authority.invitees {
+        if !member.is_active()
+            || member.conversation() != &intent.conversation
+            || member.tenant() != authority.actor.tenant()
+        {
+            return Err(PeerSessionError::Authority);
+        }
+        members.push(MemberEpoch::from(member));
+    }
+    members.sort_by(|a, b| a.participant.as_str().cmp(b.participant.as_str()));
+    if members
+        .iter()
+        .map(|m| &m.participant)
+        .ne(intent.invitees.iter())
+    {
+        return Err(PeerSessionError::Authority);
+    }
+    Ok((intent, members))
+}
+impl Orchestrator {
+    fn check_peer_session_actor(
+        &self,
+        peer: &PeerAdmission,
+        principal: &AuthenticatedPrincipal,
+        conversation: &ConversationId,
+        authority: &PeerSessionAuthority,
+    ) -> std::result::Result<(), PeerSessionError> {
+        peer.check_member(principal, &authority.actor)?;
+        if authority.actor.conversation() != conversation {
+            return Err(PeerSessionError::Authority);
+        }
+        let current = self
+            .conversations
+            .get(conversation)
+            .ok_or(PeerSessionError::Authority)?;
+        if &current
+            .read()
+            .expect("conversation lock poisoned")
+            .tenant_id
+            != authority.actor.tenant()
+        {
+            return Err(PeerSessionError::Authority);
+        }
+        Ok(())
+    }
+    /// Set a finite retained origin budget before the first peer Session. Ended
+    /// origins are retained: exhaustion rejects new IDs instead of evicting an
+    /// old tombstone and resurrecting an uncertain logical request.
+    pub fn set_peer_session_retention_limit(
+        &self,
+        limit: usize,
+    ) -> std::result::Result<(), PeerSessionError> {
+        if !(1..=10_000).contains(&limit) {
+            return Err(PeerSessionError::Capacity);
+        }
+        let mut registry = self.peer_sessions.lock().unwrap_or_else(|p| p.into_inner());
+        if !registry.origins.is_empty() {
+            return Err(PeerSessionError::Conflict);
+        }
+        registry.retention_limit = limit;
+        Ok(())
+    }
+    /// Reserve the physical view before creating the real Core Session or
+    /// emitting SessionStarted. Requested invitees remain pending targets;
+    /// they are not active Participants, media recipients, or delivered invites.
+    pub fn start_peer_session(
+        self: &Arc<Self>,
+        peer: Arc<PeerAdmission>,
+        principal: &AuthenticatedPrincipal,
+        intent: &PeerSessionStart,
+        lease: &dyn PeerSessionAuthorityLease,
+    ) -> std::result::Result<SessionId, PeerSessionError> {
+        let authority = lease.authority();
+        self.check_peer_session_actor(&peer, principal, &intent.conversation, authority)?;
+        if !authority.may_create {
+            return Err(PeerSessionError::Authority);
+        }
+        let (intent, invitees) = normalized(intent, authority)?;
+        let creator = MemberEpoch::from(&authority.actor);
+        // Same order as administrative/external creation and Conversation close.
+        let _serial = self
+            .externally_projected_sessions
+            .lock()
+            .expect("external projection lock poisoned");
+        let mut registry = self.peer_sessions.lock().unwrap_or_else(|p| p.into_inner());
+        if let Some(origin) = registry.origins.get(&intent.session) {
+            if origin.physical != peer.incarnation()
+                || origin.intent != intent
+                || origin.creator != creator
+                || origin.invitees != invitees
+            {
+                return Err(PeerSessionError::Conflict);
+            }
+            // Read-only replay never recreates a released view or ended Session.
+            peer.validate_principal(principal)?;
+            return Ok(intent.session);
+        }
+        if registry.closing.contains(&intent.conversation) {
+            return Err(PeerSessionError::Closed);
+        }
+        if self
+            .conversations
+            .get(&intent.conversation)
+            .ok_or(PeerSessionError::Authority)?
+            .read()
+            .expect("conversation lock poisoned")
+            .state
+            != ConversationState::Open
+        {
+            return Err(PeerSessionError::Closed);
+        }
+        if self.sessions.contains_key(&intent.session) {
+            return Err(PeerSessionError::Conflict);
+        }
+        if registry.origins.len() >= registry.retention_limit {
+            return Err(PeerSessionError::Capacity);
+        }
+        let permit = peer.reserve_session(self, &intent.session)?;
+        let sid = self
+            .insert_runtime_session(
+                intent.conversation.clone(),
+                intent.medium,
+                vec![],
+                intent.session.clone(),
+            )
+            .map_err(|_| PeerSessionError::Runtime)?;
+        registry
+            .views
+            .insert((sid.clone(), peer.incarnation()), permit);
+        registry.origins.insert(
+            sid.clone(),
+            CreationOrigin {
+                physical: peer.incarnation(),
+                intent,
+                creator,
+                invitees,
+            },
+        );
+        Ok(sid)
+    }
+    /// Associate an authorized physical recipient with an existing live Session.
+    /// This creates no Participant presence and accepts no Connection/media.
+    pub fn attach_peer_session(
+        self: &Arc<Self>,
+        peer: Arc<PeerAdmission>,
+        principal: &AuthenticatedPrincipal,
+        session: &SessionId,
+        lease: &dyn PeerSessionAuthorityLease,
+    ) -> std::result::Result<(), PeerSessionError> {
+        let authority = lease.authority();
+        if !authority.may_attach {
+            return Err(PeerSessionError::Authority);
+        }
+        let _serial = self
+            .externally_projected_sessions
+            .lock()
+            .expect("external projection lock poisoned");
+        let mut registry = self.peer_sessions.lock().unwrap_or_else(|p| p.into_inner());
+        let current = self
+            .sessions
+            .get(session)
+            .ok_or(PeerSessionError::Conflict)?;
+        let current = current.read().expect("session lock poisoned");
+        self.check_peer_session_actor(&peer, principal, &current.conversation_id, authority)?;
+        if matches!(
+            current.state,
+            SessionState::Ended | SessionState::Failed | SessionState::Ending
+        ) || registry.closing.contains(&current.conversation_id)
+        {
+            return Err(PeerSessionError::Closed);
+        }
+        let conversation = self
+            .conversations
+            .get(&current.conversation_id)
+            .ok_or(PeerSessionError::Authority)?;
+        if conversation
+            .read()
+            .expect("conversation lock poisoned")
+            .state
+            != ConversationState::Open
+        {
+            return Err(PeerSessionError::Closed);
+        }
+        if let Some(origin) = registry.origins.get(session) {
+            let actor = MemberEpoch::from(&authority.actor);
+            if actor != origin.creator && !origin.invitees.contains(&actor) {
+                return Err(PeerSessionError::Authority);
+            }
+        }
+        let key = (session.clone(), peer.incarnation());
+        if !registry.views.contains_key(&key) {
+            registry
+                .views
+                .insert(key, peer.reserve_session(self, session)?);
+        }
+        Ok(())
+    }
+    /// Resource cleanup only, scoped by the immutable physical incarnation.
+    /// Connection permits keep their Session charge through uncertain cleanup.
+    pub fn release_peer_session_view(&self, peer: &PeerAdmission, session: &SessionId) {
+        self.peer_sessions
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .views
+            .remove(&(session.clone(), peer.incarnation()));
+    }
+    pub(crate) fn retire_peer_session_views(&self, physical: Uuid) {
+        self.peer_sessions
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .views
+            .retain(|(_, id), _| *id != physical);
+    }
+    pub(super) fn retire_session_views(&self, session: &SessionId) {
+        self.peer_sessions
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .views
+            .retain(|(sid, _), _| sid != session);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn cancelling_pending_close_guard_releases_all_creation_fences() {
+        let core = Orchestrator::new(crate::config::Config::default());
+        let cid = core
+            .open_conversation(
+                TenantId::new(),
+                ConversationPolicy::Persistent,
+                HashMap::new(),
+            )
+            .await
+            .unwrap();
+        let registry = core.peer_sessions.clone();
+        let conversation = cid.clone();
+        let entered = Arc::new(tokio::sync::Notify::new());
+        let signal = entered.clone();
+        let task = tokio::spawn(async move {
+            registry
+                .lock()
+                .unwrap()
+                .closing
+                .insert(conversation.clone());
+            let _closing = ClosingConversation {
+                registry,
+                conversation,
+            };
+            signal.notify_one();
+            std::future::pending::<()>().await;
+        });
+        entered.notified().await;
+        assert!(core
+            .start_session(cid.clone(), SessionMedium::Voice, vec![])
+            .await
+            .is_err());
+        assert!(core
+            .project_external_session(
+                cid.clone(),
+                SessionId::new(),
+                TenantId::new(),
+                SessionMedium::Voice,
+                vec![]
+            )
+            .is_err());
+        assert!(core.reopen_conversation(cid.clone()).await.is_err());
+        assert!(core
+            .conversation(&cid)
+            .unwrap()
+            .read()
+            .unwrap()
+            .sessions
+            .is_empty());
+        task.abort();
+        assert!(task.await.unwrap_err().is_cancelled());
+        core.start_session(cid.clone(), SessionMedium::Voice, vec![])
+            .await
+            .unwrap();
+        core.close_conversation(cid, true).await.unwrap();
+    }
+}
