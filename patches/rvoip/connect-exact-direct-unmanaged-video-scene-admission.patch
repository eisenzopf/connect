+// This checks proof scoping only; foreign gate metadata is NEVER installed on
+// the actual external publisher or used to authorize any successful packet.
+fn external_direct_scene_proof_negatives(
+    source:&Arc<StreamController>,target:&Arc<StreamController>,
+    port:&AdapterMediaPort,descriptor:&MediaSource,foreign:&Arc<StreamController>,
+) {
+    use crate::staged_streams::scene_consumer::{SceneCheck,SceneConsumer};
+    let now=Instant::now();
+    let stamp=target.direct_subscriptions.stamp(source,&descriptor.logical_id,&port.binding().negotiated.requested.logical_id,now).unwrap();
+    // The scope proof never escapes begin_with_scene; all callers must run
+    // the actual begin checks for their exact source/target/receiver inputs.
+    assert!(stamp.begin_with_scene(target,&port.0,descriptor,SceneCheck::receive(None,now)).is_ok());
+    let mut wrong=descriptor.clone();wrong.logical_id=StreamId::from_string("unselected-external-logical");
+    assert!(matches!(stamp.begin_with_scene(target,&port.0,&wrong,SceneCheck::receive(None,now)),Err(StreamControlError::Authority)));
+    wrong=descriptor.clone();wrong.connection=ConnectionId::from_string("unselected-external-source");
+    assert!(matches!(stamp.begin_with_scene(target,&port.0,&wrong,SceneCheck::receive(None,now)),Err(StreamControlError::Authority)));
+    assert!(matches!(stamp.begin_with_scene(foreign,&port.0,descriptor,SceneCheck::receive(None,now)),Err(StreamControlError::Authority)));
+    let other_port=target.state.lock().unwrap().active.values().find(|port|port.binding.negotiated.requested.medium==Medium::Audio).cloned().unwrap();
+    assert!(matches!(stamp.begin_with_scene(target,&other_port,descriptor,SceneCheck::receive(None,now)),Err(StreamControlError::Authority)),"an unselected receiver logical ID cannot use the route");
+    let actual_scene=target.scene_consumer.lock().unwrap().as_ref().and_then(Weak::upgrade).unwrap();
+    let foreign_scene=SceneConsumer::new(actual_scene.scene.wrapping_add(1));foreign_scene.activate();
+    *foreign.scene_consumer.lock().unwrap()=Some(Arc::downgrade(&foreign_scene));
+    let foreign_stamp=foreign.current_scene_stamp().unwrap().unwrap();
+    assert!(matches!(stamp.begin_with_scene(target,&port.0,descriptor,SceneCheck::receive(Some(&foreign_stamp),now)),Err(StreamControlError::Authority)),"an exact Direct proof cannot override a present cross-scene stamp");
+    *foreign.scene_consumer.lock().unwrap()=None;
+    assert!(source.current_scene_stamp().unwrap().is_none(),"the real publisher must remain honestly unmanaged");
+}
