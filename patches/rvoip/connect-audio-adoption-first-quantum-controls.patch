diff --git a/crates/foundation/rvoip-core/src/staged_streams/tests/private_consult/replacement/audio_preroll/adoption_quantum.rs b/crates/foundation/rvoip-core/src/staged_streams/tests/private_consult/replacement/audio_preroll/adoption_quantum.rs
