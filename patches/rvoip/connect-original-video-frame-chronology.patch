+#[cfg(test)]
+mod original_frame_incarnation_tests {
+    use super::*;
+    #[test]
+    fn original_frame_lease_identity_survives_clock_changes_but_not_track_replacement() {
+        let clock = SourceClock::default();
+        let track: Arc<dyn Send + Sync> = Arc::new(1u32);
+        clock.bind_identity(ClockTrack::Video, 77, 90000, &track);
+        let lease = clock.lease_identity(&[77], &track);
+        let original = lease.source_binding_id(77).unwrap();
+        clock.cname(77, b"first");
+        clock.sender_report(77, 10 << 32, 0, 1, 100 << 32);
+        clock.cname(77, b"second");
+        assert_eq!(lease.source_binding_id(77), Some(original));
+        assert_eq!(
+            clock.lease_identity(&[77], &track).source_binding_id(77),
+            Some(original)
+        );
+        let replacement: Arc<dyn Send + Sync> = Arc::new(2u32);
+        clock.bind_identity(ClockTrack::Video, 77, 90000, &replacement);
+        let new = clock.lease_identity(&[77], &replacement);
+        assert_ne!(new.source_binding_id(77), Some(original));
+        assert_eq!(lease.source_binding_id(77), Some(original));
+        assert!(lease.capture(77).is_none());
+    }
