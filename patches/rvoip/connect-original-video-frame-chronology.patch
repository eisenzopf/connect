+#[tokio::test(flavor = "current_thread")]
+async fn rtc_unavailable_or_mismatched_frame_metadata_does_not_change_original_io() {
+    use futures::FutureExt as _;
+    let mut fixture = Fixture::new(Medium::Video).await;
+    let (send, stop, task) = fixture.start();
+    let work = std::panic::AssertUnwindSafe(async {
+        for mismatch in 0..3 {
+            let timestamp = 90000 + mismatch * 3000;
+            let mut packet = fixture.packet(10 + mismatch as u16, timestamp);
+            packet.original_video_frame = (mismatch != 0).then(|| {
+                OriginalVideoFrame::observed(
+                    999,
+                    if mismatch == 1 { 88 } else { 77 },
+                    timestamp,
+                    u64::from(timestamp),
+                )
+            });
+            send.send(packet).await.unwrap();
+            let original = tokio::time::timeout(Duration::from_millis(100), fixture.input.recv())
+                .await
+                .unwrap()
+                .unwrap();
+            assert!(original.original_video_frame().is_none());
+            original
+                .try_forward_to(&fixture.b, &desired(Medium::Video).logical_id)
+                .unwrap();
+            let queued = fixture.output.try_recv().unwrap();
+            assert!(queued.original_video_frame().is_none());
+            queued.deliver(|_| async { Ok(()) }).await.unwrap();
+        }
+    })
+    .catch_unwind()
+    .await;
+    fixture.finish(stop, task).await;
+    if let Err(error) = work {
+        std::panic::resume_unwind(error)
+    }
+}
