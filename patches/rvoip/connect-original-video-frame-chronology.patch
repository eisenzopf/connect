+// Constant source-owned state; no per-source/recipient map or lifetime quota.
+#[derive(Default)]
+struct SourceChronology {
+    identity: Option<(u128, u32)>,
+    observed: bool,
+    unavailable: bool,
+    last: Option<Arc<OriginalVideoFrame>>,
+    closed: bool,
+}
+impl SourceChronology {
+    fn observe(&mut self, source: Option<u128>, ssrc: u32) {
+        let identity = source.map(|id| (id, ssrc));
+        if !self.observed {
+            self.observed = true;
+            self.identity = identity;
+            self.unavailable = identity.is_none();
+        } else if self.identity != identity {
+            self.unavailable = true;
+        }
+    }
+    fn frame(&mut self, packet: &rtp::Packet) -> Option<Arc<OriginalVideoFrame>> {
+        if !self.observed {
+            self.observed = true;
+            self.unavailable = true;
+        }
+        if self.unavailable {
+            return None;
+        }
+        let (id, ssrc) = self.identity?;
+        if ssrc != packet.header.ssrc {
+            self.unavailable = true;
+            return None;
+        }
+        let timestamp = packet.header.timestamp;
+        let extended = if let Some(last) = &self.last {
+            let delta = timestamp.wrapping_sub(last.timestamp());
+            if delta == 0 && !self.closed {
+                self.closed = packet.header.marker;
+                return Some(last.clone());
+            }
+            if delta == 0 || delta >= (1u32 << 31) {
+                self.unavailable = true;
+                return None;
+            }
+            match last.extended_timestamp().checked_add(u64::from(delta)) {
+                Some(value) => value,
+                None => {
+                    self.unavailable = true;
+                    return None;
+                }
+            }
+        } else {
+            u64::from(timestamp)
+        };
+        let frame = OriginalVideoFrame::observed(id, ssrc, timestamp, extended);
+        self.last = Some(frame.clone());
+        self.closed = packet.header.marker;
+        Some(frame)
+    }
