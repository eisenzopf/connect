+//! Original source RTP-frame metadata, never a delivery grant or capture proof.
+//! Only the original authenticated adapter may establish this before fanout.
+//! Core retains the same capsule; it never allocates/rebases it on publication.
+use std::sync::Arc;
+
+/// One original source RTP timestamp group. The physical source incarnation is
+/// independent of CNAME, clock anchors, Core route bindings and recipients.
+/// `extended_timestamp` is source-owned RTP progression, not a wall clock,
+/// session ordinal, decoded readiness, or proof of unique camera content.
+#[derive(Debug, PartialEq, Eq)]
+pub struct OriginalVideoFrame {
+    source_incarnation: u128,
+    ssrc: u32,
+    timestamp: u32,
+    extended_timestamp: u64,
+}
+impl OriginalVideoFrame {
+    /// Trusted producer SPI. Call only after original-source grouping, once
+    /// before recipient fanout. Unknown/ambiguous grouping must pass None.
+    /// This constructor grants no authority and cannot bypass current admission.
+    pub fn observed(
+        source_incarnation: u128,
+        ssrc: u32,
+        timestamp: u32,
+        extended_timestamp: u64,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            source_incarnation,
+            ssrc,
+            timestamp,
+            extended_timestamp,
+        })
+    }
+    pub fn source_incarnation(&self) -> u128 {
+        self.source_incarnation
+    }
+    pub fn ssrc(&self) -> u32 {
+        self.ssrc
+    }
+    pub fn timestamp(&self) -> u32 {
+        self.timestamp
+    }
+    pub fn extended_timestamp(&self) -> u64 {
+        self.extended_timestamp
+    }
+    pub(super) fn matches(&self, frame: &super::MediaFrame) -> bool {
+        frame.kind == super::StreamKind::Video
+            && frame.timestamp_rtp == self.timestamp
+            && self.extended_timestamp as u32 == self.timestamp
+            && frame
+                .payload
+                .get(8..12)
+                .is_some_and(|v| v == self.ssrc.to_be_bytes().as_slice())
+            && frame
+                .source_clock
+                .as_ref()
+                .is_none_or(|clock| clock.source_id == self.source_incarnation)
+    }
+}
