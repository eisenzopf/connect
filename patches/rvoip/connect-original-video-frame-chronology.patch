+#[cfg(test)]
+mod original_chronology_tests {
+    use super::*;
+    fn packet(sequence: u16, timestamp: u32, marker: bool, large: bool) -> rtp::Packet {
+        let mut body = vec![0x10];
+        body.extend(vec![7; if large { 1499 } else { 3 }]);
+        rtp::Packet {
+            header: rtp::Header {
+                version: 2,
+                sequence_number: sequence,
+                timestamp,
+                ssrc: 77,
+                payload_type: 96,
+                marker,
+                ..Default::default()
+            },
+            payload: body.into(),
+        }
+    }
+    fn mapper(id: u128) -> SequenceMapper {
+        let mut mapper = SequenceMapper::default();
+        mapper.observe_original_source(Some(id), 77);
+        mapper
+    }
+    #[test]
+    fn original_frame_groups_packets_fragments_and_exact_duplicate_mapping() {
+        let mut mapping = mapper(123);
+        let first = packet(10, 90000, false, true);
+        let fragments = normalize(first.clone(), &mut mapping).unwrap();
+        let original = mapping.original_frame().unwrap().clone();
+        assert_eq!(fragments.len(), 2);
+        assert!(fragments
+            .iter()
+            .all(|p| p.header.timestamp == original.timestamp()));
+        normalize(packet(11, 90000, true, false), &mut mapping).unwrap();
+        assert!(Arc::ptr_eq(mapping.original_frame().unwrap(), &original));
+        normalize(packet(12, 93000, true, false), &mut mapping).unwrap();
+        let next = mapping.original_frame().unwrap().clone();
+        assert!(!Arc::ptr_eq(&next, &original));
+        assert_eq!(
+            next.extended_timestamp() - original.extended_timestamp(),
+            3000
+        );
+        // Exact old duplicate is the original capsule, not the latest frame.
+        let repeated = normalize(first, &mut mapping).unwrap();
+        assert_eq!(
+            repeated[0].header.sequence_number,
+            fragments[0].header.sequence_number
+        );
+        assert!(Arc::ptr_eq(mapping.original_frame().unwrap(), &original));
+        normalize(packet(13, 96000, true, false), &mut mapping).unwrap();
+        assert_eq!(
+            mapping.original_frame().unwrap().extended_timestamp(),
+            96000
+        );
+    }
+    #[test]
+    fn original_frame_natural_wrap_and_cumulative_halfspace_have_no_call_quota() {
+        let mut mapping = mapper(123);
+        let timestamps = [
+            u32::MAX - 2999,
+            0,
+            0x40000000,
+            0x80000000,
+            0xc0000000,
+            0,
+            3000,
+        ];
+        let mut previous = None;
+        for (i, timestamp) in timestamps.into_iter().enumerate() {
+            normalize(
+                packet(
+                    (i as u16).wrapping_add(u16::MAX - 2),
+                    timestamp,
+                    true,
+                    false,
+                ),
+                &mut mapping,
+            )
+            .unwrap();
+            let point = mapping.original_frame().unwrap();
+            if let Some(previous) = previous {
+                assert!(point.extended_timestamp() > previous);
+            }
+            previous = Some(point.extended_timestamp());
+            assert_eq!(point.source_incarnation(), 123);
+        }
+        assert!(previous.unwrap() > 2 * u64::from(u32::MAX));
+    }
+    #[test]
+    fn original_frame_ambiguity_is_sticky_metadata_only_and_padding_has_no_frame() {
+        for cause in 0..6 {
+            let mut mapping = mapper(123);
+            normalize(packet(10, 90000, true, false), &mut mapping).unwrap();
+            match cause {
+                0 => {
+                    normalize(
+                        packet(11, 90000u32.wrapping_add(1 << 31), true, false),
+                        &mut mapping,
+                    )
+                    .unwrap();
+                }
+                1 => {
+                    let mut conflict = packet(10, 90000, true, false);
+                    conflict.payload = vec![0x10, 9].into();
+                    assert!(normalize(conflict, &mut mapping).is_err());
+                }
+                2 => {
+                    mapping.recent.front_mut().unwrap().inserted =
+                        std::time::Instant::now() - Duration::from_millis(201);
+                    assert!(normalize(packet(10, 90000, true, false), &mut mapping).is_err());
+                }
+                3 => {
+                    mapping.observe_original_source(Some(456), 77);
+                }
+                4 => {
+                    normalize(packet(11, 90000, true, false), &mut mapping).unwrap();
+                }
+                _ => {
+                    assert!(normalize(packet(9, 87000, true, false), &mut mapping).is_err());
+                }
+            }
+            let forward = packet(12, 100000, true, false);
+            let mut legacy = SequenceMapper::default();
+            let expected = normalize(forward.clone(), &mut legacy).unwrap();
+            let actual = normalize(forward, &mut mapping).unwrap();
+            assert_eq!(actual[0].payload, expected[0].payload);
+            assert_eq!(actual[0].header.timestamp, expected[0].header.timestamp);
+            assert!(mapping.original_frame().is_none());
+        }
+        let mut missing = SequenceMapper::default();
+        missing.observe_original_source(None, 77);
+        normalize(packet(10, 90000, true, false), &mut missing).unwrap();
+        missing.observe_original_source(Some(123), 77);
+        normalize(packet(11, 93000, true, false), &mut missing).unwrap();
+        assert!(missing.original_frame().is_none());
+        let mut exhausted = mapper(123);
+        let high = u64::MAX - 1000;
+        normalize(packet(10, high as u32, true, false), &mut exhausted).unwrap();
+        exhausted.chronology.last = Some(OriginalVideoFrame::observed(123, 77, high as u32, high));
+        assert!(!normalize(
+            packet(11, (high as u32).wrapping_add(3000), true, false),
+            &mut exhausted
+        )
+        .unwrap()
+        .is_empty());
+        assert!(exhausted.original_frame().is_none());
+        let mut mapping = mapper(123);
+        let mut padding = packet(1, 0, false, false);
+        padding.payload = bytes::Bytes::new();
+        padding.header.padding = true;
+        assert!(normalize(padding, &mut mapping).unwrap().is_empty());
+        assert!(mapping.original_frame().is_none());
+        normalize(packet(2, 90000, true, false), &mut mapping).unwrap();
+        assert_eq!(
+            mapping.original_frame().unwrap().extended_timestamp(),
+            90000
+        );
+    }
+    #[test]
+    fn original_frame_real_reorder_release_preserves_one_source_group() {
+        use crate::media::video_reorder::{PacketReorder, ReceivedPacket};
+        let mut reorder = PacketReorder::default();
+        let now = std::time::Instant::now();
+        let mut mapping = mapper(123);
+        let mut capsule = None;
+        for (seq, marker) in [(10, false), (12, true), (11, false)] {
+            let released = reorder.push(
+                ReceivedPacket::new(packet(seq, 90000, marker, false), now),
+                now,
+            );
+            for received in released.packets {
+                normalize(received.packet, &mut mapping).unwrap();
+                let original = mapping.original_frame().unwrap();
+                if let Some(capsule) = &capsule {
+                    assert!(Arc::ptr_eq(capsule, original));
+                } else {
+                    capsule = Some(original.clone());
+                }
+            }
+        }
+        assert!(capsule.is_some());
+        // Another true source owner gets another capsule/incarnation, no target dependency.
+        let mut replacement = mapper(456);
+        normalize(packet(10, 90000, true, false), &mut replacement).unwrap();
+        assert_ne!(
+            replacement.original_frame().unwrap().source_incarnation(),
+            capsule.unwrap().source_incarnation()
+        );
+    }
+}
