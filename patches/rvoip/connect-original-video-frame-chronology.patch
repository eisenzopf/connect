+#[tokio::test(flavor = "current_thread")]
+async fn rtc_original_frame_capsule_survives_fanout_metadata_retry_and_real_repair() {
+    use futures::FutureExt as _;
+    let mut first = Fixture::new(Medium::Video).await;
+    let mut second = Fixture::new(Medium::Video).await;
+    // Publisher primitive with two independently guarded Core ports, not a
+    // declaration that canonical whole-ticket policy permits steady twoRx.
+    second.source = first.source.clone();
+    let ports = Arc::new(DashMap::new());
+    let mut first_owner = BurstPortOwner::new(&first, &ports);
+    let mut second_owner = BurstPortOwner::new(&second, &ports);
+    let work = std::panic::AssertUnwindSafe(async {
+        first.policy.mode.store(1, Ordering::SeqCst);
+        second.policy.mode.store(1, Ordering::SeqCst);
+        let mut output = crate::media::video_reorder::ReorderOutput::default();
+        output.packets.push(original_video_packet(
+            &first,
+            10,
+            90000,
+            Instant::now(),
+            true,
+        ));
+        let mut mapper = original_video_mapper(&first.source);
+        let (ready, _) = watch::channel(None);
+        let stop = CancellationToken::new();
+        publish_video(output, &mut mapper, &first.source, &ports, &ready, &stop);
+        let capsule = mapper.original_frame().unwrap().clone();
+        first.wait_attempt(0).await;
+        second.wait_attempt(0).await;
+        first.policy.mode.store(0, Ordering::SeqCst);
+        second.policy.mode.store(0, Ordering::SeqCst);
+        let mut deliveries = 0;
+        for fixture in [&mut first, &mut second] {
+            for _ in 0..2 {
+                let packet = tokio::time::timeout(Duration::from_millis(100), fixture.input.recv())
+                    .await
+                    .unwrap()
+                    .unwrap();
+                assert!(Arc::ptr_eq(
+                    packet.original_video_frame().unwrap(),
+                    &capsule
+                ));
+                packet
+                    .try_forward_to(&fixture.b, &desired(Medium::Video).logical_id)
+                    .unwrap();
+                let queued = fixture.output.try_recv().unwrap();
+                assert!(Arc::ptr_eq(
+                    queued.original_video_frame().unwrap(),
+                    &capsule
+                ));
+                let expected = fixture.port.binding().clone();
+                let original_bytes = Arc::new(Mutex::new(None));
+                let sent = original_bytes.clone();
+                let repair = queued
+                    .deliver_video_with_repair(move |frame, origin| async move {
+                        let origin = origin.unwrap();
+                        assert_eq!(origin.connection.as_str(), "alice");
+                        assert_eq!(origin.logical, expected.negotiated.requested.logical_id);
+                        assert_eq!(origin.transport, expected.transport_id);
+                        assert_eq!(origin.generation, expected.generation);
+                        *sent.lock().unwrap() = Some(frame.payload);
+                        Ok(())
+                    })
+                    .await
+                    .unwrap();
+                assert!(Arc::ptr_eq(
+                    repair.original_video_frame().unwrap(),
+                    &capsule
+                ));
+                let bytes = original_bytes.lock().unwrap().clone().unwrap();
+                repair
+                    .repair(move |frame, _| async move {
+                        assert_eq!(frame.payload, bytes);
+                        Ok(())
+                    })
+                    .await
+                    .unwrap();
+                assert!(Arc::ptr_eq(
+                    repair.original_video_frame().unwrap(),
+                    &capsule
+                ));
+                deliveries += 1;
+            }
+        }
+        deliveries
+    })
+    .catch_unwind()
+    .await;
+    let clean_first = first_owner.close(&first).await;
+    let clean_second = second_owner.close(&second).await;
+    assert!(
+        clean_first && clean_second && ports.is_empty(),
+        "original frame capsule owners did not settle"
+    );
+    match work {
+        Ok(count) => assert_eq!(count, 4),
+        Err(error) => std::panic::resume_unwind(error),
+    }
+}
