+//! Exact encoded/PCM owners retain definite pre-effect metadata contention.
+use super::*;
+#[derive(Clone, Copy, Debug)]
+enum Stage {
+    Collect,
+    Take,
+    PendingSource,
+    PendingTarget,
+}
+const STAGES: [Stage; 4] = [
+    Stage::Collect,
+    Stage::Take,
+    Stage::PendingSource,
+    Stage::PendingTarget,
+];
+#[derive(Clone, Copy, Debug)]
+enum Failure {
+    None,
+    SourceRevoked,
+    TargetRevoked,
+    Generation,
+    Expired,
+    Authority,
+    Conflict,
+    Backpressure,
+    Cancelled,
+}
+struct Actions(Arc<Domain>);
+impl Drop for Actions {
+    fn drop(&mut self) {
+        self.0.original_visual_policy_action.lock().unwrap().take();
+        self.0.queued_visual_receive_action.lock().unwrap().take();
+    }
+}
+async fn opus_room() -> Room {
+    let base = Arc::new(Policy(Arc::new(RwLock::new(PolicyState {
+        owners: HashMap::new(),
+        revoked: HashSet::new(),
+        unsupported_participant_media: BTreeSet::new(),
+        private: false,
+    }))));
+    let domain = Arc::new(Domain {
+        base,
+        fresh: AtomicUsize::new(0),
+        preparation_action: Mutex::new(None),
+        preparation_expiry: Mutex::new(None),
+        audio_current_gate: Mutex::new(None),
+        original_visual_policy_action: Mutex::new(None),
+        queued_visual_receive_action: Mutex::new(None),
+        deny_handoff: AtomicBool::new(false),
+        deny_replacement: AtomicBool::new(false),
+        resources: Mutex::new(BTreeMap::new()),
+        local_preparations: Mutex::new(BTreeMap::new()),
+    });
+    let scene = GuardedMediaScene::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        domain.clone(),
+        48000,
+    );
+    let mut room = Room {
+        domain,
+        scene,
+        nodes: BTreeMap::new(),
+        kinds: BTreeMap::new(),
+    };
+    for name in ["alice", "bob", "public"] {
+        let mut authority = owner(name);
+        for caps in [&mut authority.local, &mut authority.remote] {
+            for media in caps.send.iter_mut().chain(caps.receive.iter_mut()) {
+                if media.medium == Medium::Audio {
+                    media.formats = vec![MediaFormat::Encoded {
+                        name: "opus".into(),
+                        clock_rate_hz: 48000,
+                        channels: 1,
+                        fmtp: None,
+                    }];
+                }
+            }
+        }
+        room.domain
+            .base
+            .0
+            .write()
+            .await
+            .owners
+            .insert(name.into(), authority);
+        let adapter = Adapter::new();
+        adapter.audio_pt.store(111, Ordering::Release);
+        let controller = StreamController::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            ConnectionId::from_string(name),
+            principal(name),
+            room.domain.clone(),
+            adapter.clone(),
+            Arc::new(StreamHandleAllocator::default()),
+            16,
+        )
+        .unwrap();
+        controller
+            .change(
+                0,
+                &[desired(Medium::Audio)],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        let mut member = room.scene.prepare(controller.clone()).unwrap();
+        member
+            .quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        assert!(member.ready());
+        room.scene
+            .insert(controller.connection.clone(), member, true);
+        let out = adapter.port(Medium::Audio).take_egress().unwrap();
+        room.nodes.insert(
+            name.into(),
+            Node {
+                controller,
+                adapter,
+                out,
+                sequence: 0,
+            },
+        );
+    }
+    room.select(
+        "bob",
+        vec![AudioSubscription::Connection(ConnectionId::from_string(
+            "alice",
+        ))],
+    )
+    .await;
+    room
+}
+fn publish(room: &mut Room, index: u32) -> MediaFrame {
+    publish_from(room, "alice", index)
+}
+fn publish_from(room: &mut Room, name: &str, index: u32) -> MediaFrame {
+    use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+    let port = room.nodes[name].adapter.port(Medium::Audio);
+    let mut codec = CodecFactory::create_codec(111, Some(48000), Some(1)).unwrap();
+    let samples = (0..960)
+        .map(|i| ((i as f64 * 0.08).sin() * 6000.0) as i16)
+        .collect();
+    let payload = codec
+        .encode(&AudioFrame {
+            samples,
+            sample_rate: 48000,
+            channels: 1,
+            duration: Duration::from_millis(20),
+            timestamp: index,
+        })
+        .unwrap();
+    let clock_ticket = port.0.ticket();
+    let source_clock = crate::stream::MediaSourceClock {
+        source_id: if name == "alice" { 77 } else { 88 },
+        generation: 1,
+        anchor: Some(crate::stream::MediaClockAnchor {
+            ntp_time: 100u64 << 32,
+            rtp_time: 0,
+            clock_rate: 48000,
+        }),
+        supported: true,
+        rtp_offset: 0,
+        is_current: Arc::new(move || clock_ticket.is_current()),
+    };
+    let frame = MediaFrame {
+        stream_id: port.binding().transport_id.clone(),
+        kind: StreamKind::Audio,
+        payload: payload.into(),
+        timestamp_rtp: index * 960,
+        captured_at: chrono::Utc::now(),
+        payload_type: Some(111),
+        source_clock: Some(source_clock),
+    };
+    port.try_publish(&frame).unwrap();
+    frame
+}
+fn publish_action(domain: Arc<Domain>, skip: usize, action: OriginalVisualPolicyAction) {
+    let next = domain.clone();
+    assert!(domain
+        .original_visual_policy_action
+        .lock()
+        .unwrap()
+        .replace(Box::new(move |lease| {
+            if skip == 0 {
+                action(lease)
+            } else {
+                publish_action(next, skip - 1, action);
+                Ok(lease)
+            }
+        }))
+        .is_none());
+}
+fn fault(room: &Room, stage: Stage, failure: Failure) -> Arc<AtomicBool> {
+    let fired = Arc::new(AtomicBool::new(false));
+    let observed = fired.clone();
+    let action: OriginalVisualPolicyAction = Box::new(move |lease| {
+        observed.store(true, Ordering::Release);
+        drop(lease);
+        Err(match failure {
+            Failure::Authority => StreamControlError::Authority,
+            Failure::Conflict => MediaTransitionError::Conflict.into(),
+            Failure::Backpressure => StreamControlError::Backpressure,
+            Failure::Cancelled => StreamControlError::Cancelled,
+            _ => StreamControlError::MetadataBusy,
+        })
+    });
+    match stage {
+        Stage::Collect => publish_action(room.domain.clone(), 0, action),
+        Stage::Take => publish_action(room.domain.clone(), 1, action),
+        Stage::PendingSource => publish_action(room.domain.clone(), 2, action),
+        Stage::PendingTarget => assert!(room
+            .domain
+            .queued_visual_receive_action
+            .lock()
+            .unwrap()
+            .replace(action)
+            .is_none()),
+    }
+    fired
+}
+fn no_readers(room: &Room) {
+    drop(
+        room.domain
+            .base
+            .0
+            .try_write()
+            .expect("refused attempt retained policy authority"),
+    );
+}
+fn delivered(queued: QueuedMedia) -> u32 {
+    let mut writes = 0;
+    let mut timestamp = None;
+    let result = QueuedMedia::deliver_ready_audio_batch(vec![queued], |_, frame, _| {
+        use rvoip_media_core::codec::factory::CodecFactory;
+        let mut decoder = CodecFactory::create_codec(111, Some(48000), Some(1)).unwrap();
+        let pcm = decoder.decode(&frame.payload).unwrap();
+        assert_eq!(pcm.samples.len(), 960);
+        assert!(pcm.samples.iter().any(|s| i32::from(*s).abs() > 100));
+        writes += 1;
+        timestamp = Some(frame.timestamp_rtp);
+        Ok(())
+    });
+    assert_eq!(writes, 1);
+    assert!(matches!(
+        result.as_slice(),
+        [ReadyAudioDelivery::Submitted(Ok(()))]
+    ));
+    timestamp.unwrap()
+}
+async fn retained(stage: Stage, failure: Failure) {
+    let mut room = opus_room().await;
+    let _actions = Actions(room.domain.clone());
+    let started = Instant::now();
+    let cutoff = tokio::time::Instant::from_std(started + Duration::from_millis(200));
+    publish(&mut room, 100);
+    let entered = fault(&room, stage, failure);
+    room.tick();
+    assert!(
+        entered.load(Ordering::Acquire),
+        "{stage:?}: missed actual policy seam"
+    );
+    assert!(
+        room.nodes.get_mut("bob").unwrap().out.try_recv().is_err(),
+        "refused original reached egress"
+    );
+    no_readers(&room);
+    let fresh = room.domain.fresh.load(Ordering::Acquire);
+    match failure {
+        Failure::SourceRevoked | Failure::TargetRevoked => {
+            room.domain.base.0.write().await.revoked.insert(
+                if matches!(failure, Failure::SourceRevoked) {
+                    "alice"
+                } else {
+                    "bob"
+                }
+                .into(),
+            );
+        }
+        Failure::Generation => {
+            let source = &room.nodes["alice"].controller;
+            let logical = BTreeSet::from([desired(Medium::Audio).logical_id]);
+            for gate in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                source
+                    .set_media_gate(source.revision(), &logical, gate, cutoff)
+                    .await
+                    .unwrap();
+            }
+        }
+        Failure::Expired => tokio::time::sleep_until(cutoff + Duration::from_millis(1)).await,
+        _ => {}
+    }
+    room.tick();
+    if !matches!(failure, Failure::None) {
+        assert!(
+            room.nodes.get_mut("bob").unwrap().out.try_recv().is_err(),
+            "{stage:?}/{failure:?}: refused PCM resurrected"
+        );
+        if matches!(failure, Failure::SourceRevoked | Failure::TargetRevoked) {
+            room.domain.base.0.write().await.revoked.clear();
+            room.tick();
+            assert!(
+                room.nodes.get_mut("bob").unwrap().out.try_recv().is_err(),
+                "permission restoration revived discarded original"
+            );
+        }
+        no_readers(&room);
+        return;
+    }
+    assert!(
+        room.domain.fresh.load(Ordering::Acquire) > fresh,
+        "retry reused failed permission"
+    );
+    let recovered = room
+        .nodes
+        .get_mut("bob")
+        .unwrap()
+        .out
+        .try_recv()
+        .expect("same original Opus quantum discarded");
+    assert!(
+        recovered.admitted_at >= started
+            && recovered.admitted_at.elapsed() < Duration::from_millis(200)
+    );
+    let first = delivered(recovered);
+    assert!(
+        room.nodes.get_mut("bob").unwrap().out.try_recv().is_err(),
+        "duplicated original"
+    );
+    publish(&mut room, 101);
+    room.tick();
+    let next = room.nodes.get_mut("bob").unwrap().out.try_recv().unwrap();
+    let second = delivered(next);
+    assert_eq!(
+        second.wrapping_sub(first),
+        960,
+        "retry skipped or fabricated a real20ms quantum"
+    );
+    publish(&mut room, 103);
+    room.tick();
+    let genuinely_later = room.nodes.get_mut("bob").unwrap().out.try_recv().unwrap();
+    assert_eq!(
+        delivered(genuinely_later).wrapping_sub(second),
+        1920,
+        "retry hid a genuine source-clock gap"
+    );
+    no_readers(&room);
+}
