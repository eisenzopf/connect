+fn keep_busy(domain: Arc<Domain>, attempts: Arc<AtomicUsize>) {
+    let again = domain.clone();
+    publish_action(
+        domain,
+        0,
+        Box::new(move |lease| {
+            drop(lease);
+            attempts.fetch_add(1, Ordering::AcqRel);
+            keep_busy(again, attempts);
+            Err(StreamControlError::MetadataBusy)
+        }),
+    );
+}
+#[tokio::test]
+async fn generic_audio_metadata_busy_retries_fresh_once_and_keeps_real_refusals_terminal() {
+    for failure in [
+        Failure::None,
+        Failure::SourceRevoked,
+        Failure::Cancelled,
+        Failure::Authority,
+        Failure::Backpressure,
+    ] {
+        let mut room = opus_room().await;
+        let _actions = Actions(room.domain.clone());
+        if matches!(failure, Failure::None) {
+            room.select(
+                "bob",
+                vec![
+                    AudioSubscription::Connection(ConnectionId::from_string("alice")),
+                    AudioSubscription::Connection(ConnectionId::from_string("public")),
+                ],
+            )
+            .await;
+            publish_from(&mut room, "public", 100);
+        }
+        publish(&mut room, 100);
+        room.tick();
+        let queued = room.nodes.get_mut("bob").unwrap().out.try_recv().unwrap();
+        if matches!(failure, Failure::None) {
+            assert_eq!(queued.sources.len(), 2);
+            assert!(
+                !queued.can_batch_audio(),
+                "mixed native audio must use the generic path shared with RTC/SIP"
+            );
+        }
+        let original = (
+            queued.frame.payload.clone(),
+            queued.frame.timestamp_rtp,
+            queued.admitted_at,
+        );
+        let domain = room.domain.clone();
+        let target = room.nodes["bob"].controller.clone();
+        let attempts = Arc::new(AtomicUsize::new(0));
+        let entered = attempts.clone();
+        publish_action(
+            room.domain.clone(),
+            0,
+            Box::new(move |lease| {
+                drop(lease);
+                entered.fetch_add(1, Ordering::AcqRel);
+                if matches!(failure, Failure::SourceRevoked) {
+                    domain
+                        .base
+                        .0
+                        .try_write()
+                        .expect("failed source kept another reader")
+                        .revoked
+                        .insert("alice".into());
+                }
+                if matches!(failure, Failure::Cancelled) {
+                    target.shutdown.cancel();
+                }
+                Err(match failure {
+                    Failure::Authority => StreamControlError::Authority,
+                    Failure::Backpressure => StreamControlError::Backpressure,
+                    _ => StreamControlError::MetadataBusy,
+                })
+            }),
+        );
+        let writes = Arc::new(AtomicUsize::new(0));
+        let write_count = writes.clone();
+        let result = queued
+            .deliver(move |frame| async move {
+                assert_eq!(
+                    (frame.payload.clone(), frame.timestamp_rtp),
+                    (original.0, original.1)
+                );
+                assert!(original.2.elapsed() < Duration::from_millis(200));
+                let mut decoder = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                    111,
+                    Some(48000),
+                    Some(1),
+                )
+                .unwrap();
+                assert_eq!(decoder.decode(&frame.payload).unwrap().samples.len(), 960);
+                write_count.fetch_add(1, Ordering::AcqRel);
+                Ok(())
+            })
+            .await;
+        assert_eq!(attempts.load(Ordering::Acquire), 1);
+        assert_eq!(
+            writes.load(Ordering::Acquire),
+            usize::from(matches!(failure, Failure::None))
+        );
+        match failure {
+            Failure::None => assert!(
+                result.is_ok(),
+                "generic pre-IO owner discarded actual audio: {result:?}"
+            ),
+            Failure::SourceRevoked | Failure::Authority => {
+                assert!(matches!(result, Err(StreamControlError::Authority)))
+            }
+            Failure::Cancelled => assert!(matches!(result, Err(StreamControlError::Cancelled))),
+            Failure::Backpressure => {
+                assert!(matches!(result, Err(StreamControlError::Backpressure)))
+            }
+            _ => unreachable!(),
+        }
+        no_readers(&room);
+    }
+}
