+struct Earlier {
+    lease: Box<dyn MediaAuthorityLease>,
+    until: chrono::DateTime<chrono::Utc>,
+}
+impl MediaAuthorityLease for Earlier {
+    fn authority(&self) -> &MediaOwner {
+        self.lease.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        Some(self.until)
+    }
+}
+fn refused(outcomes: Vec<ReadyAudioDelivery>) -> QueuedMedia {
+    assert_eq!(outcomes.len(), 1);
+    match outcomes.into_iter().next().unwrap() {
+        ReadyAudioDelivery::Refused {
+            queued,
+            problem: StreamControlError::MetadataBusy,
+        } => queued,
+        _ => panic!("pre-effect busy did not return exact owned audio"),
+    }
+}
