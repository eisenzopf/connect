+    let saved = original.sources[0].admission_deadline.unwrap();
+    assert!(
+        saved < original_age_cutoff,
+        "earlier grant was never captured"
+    );
+    tokio::time::sleep_until(saved + Duration::from_millis(1)).await;
+    assert!(
+        tokio::time::Instant::now() < original_age_cutoff,
+        "test only exercised packet age"
+    );
+    let result = QueuedMedia::deliver_ready_audio_batch(vec![original], |_, _, _| {
+        panic!("renewed expired original lease")
+    });
