+        logical_id: StreamId::from_string("audio"),
+        medium: Medium::Audio,
+        direction: StreamDirection::Both,
+    }
+}
+fn owner(name: &str) -> MediaOwner {
+    let identity = IdentityBinding::from_authenticated(
+        &principal(name),
+        IdentityId::from_string(name),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let member = Membership::admit(
+        identity.clone(),
+        ConversationId::from_string("conversation"),
+        ParticipantId::from_string(name),
+        ParticipantKind::Human,
+        ParticipantRole::Agent,
+    )
+    .unwrap();
+    let presence =
+        SessionAppearance::admit(&member, SessionId::from_string("session"), None).unwrap();
+    let mut endpoint = EndpointBinding::provision(
+        identity.clone(),
+        EndpointId::from_string(name),
+        DeviceId::from_string(name),
+        Transport::Quic,
+        "fixture".into(),
+    )
+    .unwrap();
+    endpoint
+        .verify(&identity, "fixture".into(), chrono::Utc::now())
+        .unwrap();
+    let mut connection = ConnectionBinding::prepare(
+        &member,
+        &presence,
+        &endpoint,
+        ConnectionId::from_string(name),
+    )
+    .unwrap();
+    connection
+        .observe_ready(&member, &presence, &endpoint, 1)
+        .unwrap();
+    connection.activate(&member, &presence, &endpoint).unwrap();
+    let caps = EndpointMediaCapabilities {
+        send: vec![MediaCapability {
+            medium: Medium::Audio,
+            formats: vec![MediaFormat::Encoded {
+                name: "pcmu".into(),
+                clock_rate_hz: 8000,
+                channels: 1,
+                fmtp: None,
+            }],
+        }],
+        receive: vec![MediaCapability {
+            medium: Medium::Audio,
+            formats: vec![MediaFormat::Encoded {
+                name: "pcmu".into(),
+                clock_rate_hz: 8000,
+                channels: 1,
+                fmtp: None,
+            }],
+        }],
+        max_streams: 8,
+        renegotiation: true,
+    };
+    MediaOwner {
+        actor: member.clone(),
+        member,
+        presence,
+        endpoint,
+        connection,
+        may_control: true,
+        send_media: BTreeSet::from([Medium::Audio]),
+        receive_media: BTreeSet::from([Medium::Audio]),
+        local: caps.clone(),
+        remote: caps,
+        may_route_source: true,
+    }
+}
+struct Lease {
+    owner: MediaOwner,
+    _read: OwnedRwLockReadGuard<BTreeMap<String, MediaOwner>>,
+}
+impl MediaAuthorityLease for Lease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+struct Policy {
+    owners: Arc<RwLock<BTreeMap<String, MediaOwner>>>,
+    busy: AtomicUsize,
+    refused: AtomicUsize,
+    revoked: AtomicBool,
+}
+impl MediaPolicy for Policy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if self.revoked.load(Ordering::Acquire) {
+            return Err(StreamControlError::Authority);
+        }
+        if scope.connection.as_str() == "alice" && matches!(scope.purpose, MediaPurpose::Publish) {
+            let busy = self.busy.load(Ordering::Acquire);
+            if busy != 0 {
+                self.refused.fetch_add(1, Ordering::AcqRel);
+                if busy != 2 {
+                    self.busy.store(0, Ordering::Release);
+                }
+                if busy == 3 {
+                    self.revoked.store(true, Ordering::Release);
+                }
+                // This is a genuine pre-effect policy refusal. No lease was
+                // created; the native owner must retry its SAME returned copy.
+                return Err(StreamControlError::MetadataBusy);
+            }
+        }
+        let read = self
+            .owners
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        let owner = read
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        Ok(Box::new(Lease { owner, _read: read }))
+    }
+}
+struct Cleanup;
+#[async_trait]
+impl MediaPortCleanup for Cleanup {
+    async fn close(&self) -> ControlResult<()> {
+        Ok(())
+    }
+}
+#[derive(Default)]
+struct Adapter(Mutex<Option<AdapterMediaPort>>);
+#[async_trait]
+impl StagedMediaAdapter for Adapter {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<()> {
+        for p in ports {
+            if p.is_new {
+                p.port.install_cleanup(Arc::new(Cleanup))?;
+            }
+            p.port
+                .observe_ready(&p.port.binding().negotiated.format, true, true, Some(0))?;
+            *self.0.lock().unwrap() = Some(p.port);
+        }
+        Ok(())
+    }
+}
+#[derive(Default)]
+struct Wire {
+    packets: Mutex<Vec<Bytes>>,
+    attempts: AtomicUsize,
+    refuse: AtomicBool,
+}
+impl StagedDatagramTransport for Wire {
+    fn maximum_datagram_bytes(&self) -> Option<usize> {
+        Some(1200)
+    }
+    fn is_closed(&self) -> bool {
+        false
+    }
+    fn send_datagram(&self, bytes: Bytes) -> ControlResult<()> {
+        if !rtcp::is_rtcp(&bytes) {
+            self.attempts.fetch_add(1, Ordering::AcqRel);
+            if self.refuse.swap(false, Ordering::AcqRel) {
+                return Err(StreamControlError::MetadataBusy);
+            }
+        }
+        self.packets.lock().unwrap().push(bytes);
+        Ok(())
+    }
+}
+fn packetizer() -> Packetizer {
+    Packetizer {
+        #[cfg(feature = "memory-diagnostics")]
+        _memory_owner: rvoip_infra_common::memory_diagnostics::ObjectGuard::new(
+            "native.packetizer",
+            0,
+        ),
+        cursor: None,
+        feedback_epoch: None,
+        outer: 0,
+        rtp: 0,
+        ssrc: 1,
+        video: Default::default(),
+        previous_video: None,
+        clock_origin: None,
+        audio_clock: Default::default(),
+        cname: "busy-recovery".into(),
+        packets: 0,
+        octets: 0,
+        last_report: None,
+    }
+}
+fn publish(port: &AdapterMediaPort, index: u32) {
+    use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+    let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+    let payload = codec
+        .encode(&AudioFrame {
+            samples: vec![1800; 160],
+            sample_rate: 8000,
+            channels: 1,
+            duration: Duration::from_millis(20),
+            timestamp: index,
+        })
+        .unwrap();
+    port.try_publish(&MediaFrame {
+        stream_id: port.binding().transport_id.clone(),
+        kind: StreamKind::Audio,
+        payload: payload.into(),
+        timestamp_rtp: index * 160,
+        captured_at: chrono::Utc::now(),
+        payload_type: Some(0),
+        source_clock: None,
+    })
+    .unwrap();
+}
+async fn exercise(mode: usize) {
+    use rvoip_core::staged_streams::{
+        audio_subscriptions::{AudioSubscription, AudioSubscriptionChange},
+        test_support::ControlledAudioScene,
+    };
+    let policy = Arc::new(Policy {
+        owners: Arc::new(RwLock::new(BTreeMap::from([
+            ("alice".into(), owner("alice")),
+            ("bob".into(), owner("bob")),
+        ]))),
+        busy: AtomicUsize::new(0),
+        refused: AtomicUsize::new(0),
+        revoked: AtomicBool::new(false),
+    });
+    let scene = ControlledAudioScene::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        policy.clone(),
+    );
+    let mut controllers = Vec::new();
+    let mut ports = Vec::new();
+    let cancel = CancellationToken::new();
+    // Register every actual controller before its first awaited preparation;
+    // setup failures have exactly the same cleanup owner as send assertions.
+    let work = std::panic::AssertUnwindSafe(async {
+        for name in ["alice", "bob"] {
+            let adapter = Arc::new(Adapter::default());
+            let controller = StreamController::new(
+                ConversationId::from_string("conversation"),
+                SessionId::from_string("session"),
+                ConnectionId::from_string(name),
+                principal(name),
+                policy.clone(),
+                adapter.clone(),
+                Arc::new(StreamHandleAllocator::default()),
+                8,
+            )
+            .unwrap();
+            controllers.push(controller.clone());
+            controller
+                .change(
+                    0,
+                    &[desired()],
+                    &BTreeSet::new(),
+                    tokio::time::Instant::now() + Duration::from_secs(2),
+                    CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+            scene
+                .attach(
+                    controller.clone(),
+                    tokio::time::Instant::now() + Duration::from_secs(2),
+                )
+                .await
+                .unwrap();
+            ports.push(adapter.0.lock().unwrap().as_ref().unwrap().clone());
+        }
+        scene
+            .change_subscriptions(
+                &ConnectionId::from_string("bob"),
+                controllers[1].revision(),
+                AudioSubscriptionChange::Subscribe(vec![AudioSubscription::Connection(
+                    ConnectionId::from_string("alice"),
+                )]),
+                tokio::time::Instant::now() + Duration::from_secs(2),
+            )
+            .await
+            .unwrap();
+        let mut out = ports[1].take_egress().unwrap();
+        let wire = Arc::new(Wire::default());
+        let route = Arc::new(SendRoute {
+            binding: ports[1].binding().clone(),
+            pt: 0,
+            transport: wire.clone(),
+            flow: None,
+            port: ports[1].downgrade(),
+            counters: Arc::new(StagedRtpCounters::default()),
+            cancel: cancel.clone(),
+            lifetime: CancellationToken::new(),
+        });
+        let ready = ReadyAudioEgress::new();
+        publish(&ports[0], 40);
+        scene.tick();
+        let queued = out.try_recv().unwrap();
+        assert!(queued.can_batch_audio());
+        policy
+            .busy
+            .store(if mode == 4 { 0 } else { mode }, Ordering::Release);
+        wire.refuse.store(mode == 4, Ordering::Release);
+        let (mut p, result) = ready
+            .send(queued, packetizer(), route.clone())
+            .await
+            .expect("actual native epoch did not join");
+        if mode == 1 {
+            assert!(
+                result.is_ok(),
+                "native discarded pre-effect metadata-busy original: {result:?}"
+            );
+            assert_eq!(policy.refused.load(Ordering::Acquire), 1);
+            assert_eq!(wire.attempts.load(Ordering::Acquire), 1);
+            assert!(
+                policy.owners.clone().try_write_owned().is_ok(),
+                "completion retained policy guards"
+            );
+            publish(&ports[0], 41);
+            scene.tick();
+            let next = out.try_recv().unwrap();
+            let done = ready
+                .send(next, p, route.clone())
+                .await
+                .expect("next native epoch unjoined");
+            p = done.0;
+            assert!(done.1.is_ok());
+            let packets: Vec<_> = wire
+                .packets
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|b| !rtcp::is_rtcp(b))
+                .map(|b| crate::substrate::unpack_rtp_datagram(b).unwrap().rtp)
+                .collect();
+            assert_eq!(packets.len(), 2);
+            assert_eq!(
+                packets[1]
+                    .sequence_number
+                    .wrapping_sub(packets[0].sequence_number),
+                1
+            );
+            assert_eq!(packets[1].timestamp.wrapping_sub(packets[0].timestamp), 160);
+            let mut decoder = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                0,
+                Some(8000),
+                Some(1),
+            )
+            .unwrap();
+            for packet in packets {
+                assert_eq!(decoder.decode(&packet.payload).unwrap().samples.len(), 160);
+            }
+            assert_eq!(wire.attempts.load(Ordering::Acquire), 2);
+            drop(p);
+        } else {
+            match mode {
+                2 => assert!(matches!(result, Err(StreamControlError::Deadline))),
+                3 => assert!(matches!(result, Err(StreamControlError::Authority))),
+                4 => assert!(matches!(result, Err(StreamControlError::MetadataBusy))),
+                _ => unreachable!(),
+            }
+            assert_eq!(
+                wire.attempts.load(Ordering::Acquire),
+                usize::from(mode == 4)
+            );
+        }
+        assert!(
+            policy.owners.clone().try_write_owned().is_ok(),
+            "terminal native owner retained readers"
+        );
+    })
+    .catch_unwind()
+    .await;
+    cancel.cancel();
+    let scene_closed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| drop(scene)));
+    let mut cleanup = Vec::new();
+    for controller in &controllers {
+        cleanup.push(
+            std::panic::AssertUnwindSafe(
+                controller.shutdown(tokio::time::Instant::now() + Duration::from_secs(2)),
+            )
+            .catch_unwind()
+            .await,
+        );
+    }
+    eprintln!(
+        "native fixture original cleanup scene_panic={} controller_results={:?}",
+        scene_closed.is_err(),
+        cleanup
+            .iter()
+            .map(|r| r.as_ref().ok().copied())
+            .collect::<Vec<_>>()
+    );
+    // Complete every original cleanup attempt before preserving the exact
+    // first work failure. A cleanup panic is never reported as a joined API.
+    if let Err(original) = work {
+        std::panic::resume_unwind(original);
+    }
+    if let Err(original) = scene_closed {
+        std::panic::resume_unwind(original);
+    }
+    for result in cleanup {
+        match result {
+            Ok(remaining) => assert_eq!(remaining, 0, "actual native fixture cleanup unjoined"),
+            Err(original) => std::panic::resume_unwind(original),
+        }
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_native_ready_loop_retains_one_packetizer_and_one_original_before_successful_rtp() {
