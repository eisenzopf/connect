+struct DtmfAudienceFence(crate::staged_streams::capability_disclosure::SceneDtmfAudience);
+impl crate::dtmf::DtmfIoFence for DtmfAudienceFence {
+    fn poll(&self, io: &mut dyn FnMut() -> crate::dtmf::DtmfIoPoll) -> crate::dtmf::DtmfIoPoll {
+        self.0.poll(io)
+    }
+}
+impl Orchestrator {
+    /// Capture a managed source's original private boundaries under its exact
+    /// current controller/credential metadata. No capability is advertised.
+    pub fn capture_native_dtmf_disclosure(
+        &self,
+        session: &SessionId,
+        source: &ConnectionId,
+        controller: &Arc<StreamController>,
+        principal: &AuthenticatedPrincipal,
+        stream_revision: u64,
+        credential_revision: u64,
+    ) -> ControlResult<NativeDtmfDisclosure> {
+        let (_, source) = self.commit_native_signal_metadata(
+            session,
+            source,
+            controller,
+            principal,
+            stream_revision,
+            || (),
+        )?;
+        if !source
+            .scene
+            .matches_dtmf_source(principal, credential_revision)
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        Ok(NativeDtmfDisclosure(source))
+    }
+
+    /// Derive a scene-only fence for this actual native recipient write scope.
+    /// Call during fresh route-policy acquisition, outside engine IO locks.
+    /// The host must check the same immutable source operation and recipient
+    /// authority, then attach this fence to its DtmfWriteLease. Core routing
+    /// and sealed native source/target physical fences must also surround IO;
+    /// this audience fence cannot supply their credential or lifecycle custody.
+    pub fn native_dtmf_audience_fence(
+        &self,
+        disclosure: &NativeDtmfDisclosure,
+        recipient: &crate::dtmf::DtmfNativeRecipient,
+    ) -> ControlResult<Arc<dyn crate::dtmf::DtmfIoFence>> {
+        let source = &disclosure.0;
+        if source.session != recipient.session
+            || source.source == recipient.connection
+            || !matches!(
+                recipient.transport,
+                crate::connection::Transport::Quic | crate::connection::Transport::WebTransport
+            )
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let runtime = self.participant_runtime(&source.session)?;
+        if !Weak::ptr_eq(&source.runtime, &Arc::downgrade(&runtime)) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let state = runtime.state.try_lock().map_err(|_| busy())?;
+        if state.ended {
+            return Err(ParticipantControlError::Authority);
+        }
+        let origin = state
+            .routes
+            .get(&source.source)
+            .ok_or(ParticipantControlError::Authority)?;
+        let target = state
+            .routes
+            .get(&recipient.connection)
+            .ok_or(ParticipantControlError::Authority)?;
+        if !source.life.matches(&origin.lifecycle) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let tickets = if source.source < recipient.connection {
+            [&origin.lifecycle, &target.lifecycle]
+        } else {
+            [&target.lifecycle, &origin.lifecycle]
+        };
+        let lives = tickets
+            .iter()
+            .map(|t| t.state.try_lock().map_err(|_| busy()))
+            .collect::<ControlResult<Vec<_>>>()?;
+        if tickets.iter().zip(&lives).any(|(t, l)| !live(t, l)) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let scene = runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        Ok(Arc::new(DtmfAudienceFence(
+            scene.native_dtmf_audience(&source.scene, recipient)?,
+        )))
+    }
+}
