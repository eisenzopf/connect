+/// Original managed signal audience. It retains no command or permission reader.
+/// It is sealed from the actual source controller before accepting DTMF input.
+#[derive(Clone)]
+pub struct NativeDtmfDisclosure(NativeCapabilityDisclosure);
+impl std::fmt::Debug for NativeDtmfDisclosure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeDtmfDisclosure(redacted)")
+    }
