+fn native_dtmf_recipient(controller: &Arc<StreamController>) -> crate::dtmf::DtmfNativeRecipient {
+    let member = &controller.origin_member;
+    let endpoint = &controller.origin_endpoint;
+    crate::dtmf::DtmfNativeRecipient {
+        conversation: controller.conversation.clone(),
+        session: controller.session.clone(),
+        connection: controller.connection.clone(),
+        participant: member.participant().clone(),
+        transport: endpoint.transport(),
+        principal: controller.credential_snapshot().principal.as_ref().clone(),
+        identity: member.identity().clone(),
+        endpoint: endpoint.endpoint().clone(),
+        device: endpoint.device().clone(),
+        membership_epoch: member.epoch(),
+        physical_incarnation: uuid::Uuid::new_v4(),
+        signing_key_id: "controlled-metadata-only".into(),
+        signing_algorithm: "EdDSA".into(),
+        wire_conversation: controller.conversation.to_string(),
+        wire_session: controller.session.to_string(),
+        wire_connection: controller.connection.to_string(),
+        stream_revision: controller.revision(),
+        credential_revision: controller.credential_snapshot().revision,
+        audio_bindings: controller.active_bindings(),
+    }
+}
+#[tokio::test]
+async fn native_dtmf_audience_composes_with_physical_controller_fences_and_releases_pending_guards()
+{
+    use crate::dtmf::*;
+    let room = Room::new().await;
+    let alice = room.nodes["alice"].controller.clone();
+    let bob = room.nodes["bob"].controller.clone();
+    let source = native_dtmf_recipient(&alice);
+    let target = native_dtmf_recipient(&bob);
+    let (_, disclosure) = room
+        .scene
+        .commit_capability_declaration(
+            &alice.connection,
+            &alice,
+            &source.principal,
+            source.stream_revision,
+            || (),
+        )
+        .unwrap();
+    let audience = room
+        .scene
+        .native_dtmf_audience(&disclosure, &target)
+        .unwrap();
+    let calls = AtomicUsize::new(0);
+    // This is the same controller nesting required by actual native IO. The
+    // audience callback must not reacquire either controller's state/credential.
+    let mut effect = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    let mut poll = || {
+        bob.poll_dtmf_source_io(
+            &target.principal,
+            target.stream_revision,
+            target.credential_revision,
+            &target.audio_bindings,
+            &mut || {
+                alice.poll_dtmf_source_io(
+                    &source.principal,
+                    source.stream_revision,
+                    source.credential_revision,
+                    &source.audio_bindings,
+                    &mut || audience.poll(&mut effect),
+                )
+            },
+        )
+    };
+    assert_eq!(poll(), std::task::Poll::Ready(Ok(())));
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    let held = room.scene.audiences.lock().unwrap();
+    assert_eq!(poll(), std::task::Poll::Pending);
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    // A Pending metadata poll must have released both actual controllers.
+    assert!(alice.state.try_lock().is_ok());
+    assert!(alice.credential.try_lock().is_ok());
+    assert!(bob.state.try_lock().is_ok());
+    assert!(bob.credential.try_lock().is_ok());
+    drop(held);
+    assert_eq!(poll(), std::task::Poll::Ready(Ok(())));
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    alice.retire();
+    assert_eq!(
+        audience.poll(&mut effect),
+        std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+    );
+}
+#[tokio::test]
+async fn native_dtmf_original_and_current_audiences_both_refuse_disclosure_across_private_return() {
+    use crate::dtmf::*;
+    let mut room = Room::new().await;
+    let alice = room.nodes["alice"].controller.clone();
+    let bob = room.nodes["bob"].controller.clone();
+    let public = room.nodes["public"].controller.clone();
+    let source = native_dtmf_recipient(&alice);
+    let (_, public_source) = room
+        .scene
+        .commit_capability_declaration(
+            &alice.connection,
+            &alice,
+            &source.principal,
+            source.stream_revision,
+            || (),
+        )
+        .unwrap();
+    let public_to_bob = room
+        .scene
+        .native_dtmf_audience(&public_source, &native_dtmf_recipient(&bob))
+        .unwrap();
+    let calls = AtomicUsize::new(0);
+    let mut effect = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    assert_eq!(
+        public_to_bob.poll(&mut effect),
+        std::task::Poll::Ready(Ok(()))
+    );
+    room.add("consult", Some("public"), true).await;
+    let consult = room.nodes["consult"].controller.clone();
+    let (_, handle) = room.apply(room.begin_plan()).await.unwrap();
+    let source = native_dtmf_recipient(&alice);
+    let (_, private_source) = room
+        .scene
+        .commit_capability_declaration(
+            &alice.connection,
+            &alice,
+            &source.principal,
+            source.stream_revision,
+            || (),
+        )
+        .unwrap();
+    let private_to_consult = room
+        .scene
+        .native_dtmf_audience(&private_source, &native_dtmf_recipient(&consult))
+        .unwrap();
+    let private_to_bob = room
+        .scene
+        .native_dtmf_audience(&private_source, &native_dtmf_recipient(&bob))
+        .unwrap();
+    let private_to_public = room
+        .scene
+        .native_dtmf_audience(&private_source, &native_dtmf_recipient(&public))
+        .unwrap();
+    assert_eq!(
+        private_to_consult.poll(&mut effect),
+        std::task::Poll::Ready(Ok(()))
+    );
+    for fence in [&private_to_bob, &private_to_public, &public_to_bob] {
+        assert_eq!(
+            fence.poll(&mut effect),
+            std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+        );
+    }
+    let restore = room
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "dtmf-return".into(),
+            room.scene.audience_revision(),
+        )
+        .unwrap();
+    room.apply(restore).await.unwrap();
+    assert_eq!(
+        public_to_bob.poll(&mut effect),
+        std::task::Poll::Ready(Ok(()))
+    );
+    // These are scene callbacks, not socket writes. Even if a later current
+    // physical scope is otherwise valid, the original private boundary remains.
+    for fence in [&private_to_bob, &private_to_public, &private_to_consult] {
+        assert_eq!(
+            fence.poll(&mut effect),
+            std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+        );
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+}
+#[tokio::test]
+async fn native_dtmf_audience_binding_requires_exact_actual_recipient_relationship_and_credential_metadata(
+) {
+    let room = Room::new().await;
+    let alice = room.nodes["alice"].controller.clone();
+    let bob = room.nodes["bob"].controller.clone();
+    let source = native_dtmf_recipient(&alice);
+    let (_, disclosure) = room
+        .scene
+        .commit_capability_declaration(
+            &alice.connection,
+            &alice,
+            &source.principal,
+            source.stream_revision,
+            || (),
+        )
+        .unwrap();
+    assert!(disclosure.matches_dtmf_source(&source.principal, source.credential_revision));
+    assert!(!disclosure.matches_dtmf_source(&source.principal, source.credential_revision + 1));
+    let original = native_dtmf_recipient(&bob);
+    room.scene
+        .native_dtmf_audience(&disclosure, &original)
+        .unwrap();
+    for field in [
+        "conversation",
+        "session",
+        "participant",
+        "identity",
+        "endpoint",
+        "device",
+        "epoch",
+        "credential",
+    ] {
+        let mut changed = original.clone();
+        match field {
+            "conversation" => changed.conversation = ConversationId::new(),
+            "session" => changed.session = SessionId::new(),
+            "participant" => changed.participant = ParticipantId::new(),
+            "identity" => changed.identity = IdentityId::new(),
+            "endpoint" => changed.endpoint = EndpointId::new(),
+            "device" => changed.device = DeviceId::new(),
+            "epoch" => changed.membership_epoch += 1,
+            _ => changed.credential_revision += 1,
+        }
+        assert!(
+            room.scene
+                .native_dtmf_audience(&disclosure, &changed)
+                .is_err(),
+            "{field}"
+        );
+    }
+}
