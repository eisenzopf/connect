+/// Only scene registries are acquired during signal IO. Exact source and target
+/// credential/audio custody is supplied by Core's sealed native DTMF fences;
+/// reacquiring either controller here would deadlock that physical composition.
+#[derive(Clone)]
+pub(crate) struct SceneDtmfAudience {
+    source: SceneCapabilityDisclosure,
+    target: SceneCapabilityListener,
+}
+impl SceneCapabilityDisclosure {
+    pub(crate) fn matches_dtmf_source(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        revision: u64,
+    ) -> bool {
+        self.source.credential.revision == revision
+            && reliable_data::same_credential(&self.source.credential.principal, principal)
+    }
+}
+impl GuardedMediaScene {
+    pub(crate) fn native_dtmf_audience(
+        self: &Arc<Self>,
+        source: &SceneCapabilityDisclosure,
+        target: &crate::dtmf::DtmfNativeRecipient,
+    ) -> ControlResult<SceneDtmfAudience> {
+        if !Weak::ptr_eq(&source.scene, &Arc::downgrade(self)) {
+            return Err(StreamControlError::Authority);
+        }
+        let controller = {
+            let members = self
+                .members
+                .try_lock()
+                .map_err(|_| StreamControlError::NotReady)?;
+            members
+                .get(&target.connection)
+                .map(|m| m.controller.clone())
+                .ok_or(StreamControlError::Authority)?
+        };
+        let member = &controller.origin_member;
+        let endpoint = &controller.origin_endpoint;
+        if controller.session != target.session
+            || controller.conversation != target.conversation
+            || member.participant() != &target.participant
+            || member.identity() != &target.identity
+            || member.epoch() != target.membership_epoch
+            || endpoint.endpoint() != &target.endpoint
+            || endpoint.device() != &target.device
+            || endpoint.transport() != target.transport
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let listener =
+            self.capability_listener(&target.connection, &controller, &target.principal)?;
+        if listener.recipient.credential.revision != target.credential_revision {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(SceneDtmfAudience {
+            source: source.clone(),
+            target: listener,
+        })
+    }
+}
+impl SceneDtmfAudience {
+    /// Called only inside the exact physical source/recipient DTMF IO fences.
+    /// Their credential checks bind these immutable principals to actual IO.
+    /// No controller, Core, or domain-policy reentry occurs here.
+    pub(crate) fn poll(
+        &self,
+        io: &mut dyn FnMut() -> crate::dtmf::DtmfIoPoll,
+    ) -> crate::dtmf::DtmfIoPoll {
+        use crate::dtmf::DtmfWriteError;
+        let refuse = || Poll::Ready(Err(DtmfWriteError::Refused));
+        let Some(scene) = self.source.scene.upgrade() else {
+            return refuse();
+        };
+        if !Weak::ptr_eq(&self.target.scene, &Arc::downgrade(&scene)) {
+            return refuse();
+        }
+        let (Some(source), Some(target)) = (
+            self.source.source.controller.upgrade(),
+            self.target.recipient.controller.upgrade(),
+        ) else {
+            return refuse();
+        };
+        if Arc::ptr_eq(&source, &target)
+            || source.shutdown.is_cancelled()
+            || target.shutdown.is_cancelled()
+        {
+            return refuse();
+        }
+        let Ok(members) = scene.members.try_lock() else {
+            return Poll::Pending;
+        };
+        let Ok(registry) = scene.audiences.try_lock() else {
+            return Poll::Pending;
+        };
+        if !members
+            .get(&source.connection)
+            .is_some_and(|m| Arc::ptr_eq(&m.controller, &source))
+            || !members
+                .get(&target.connection)
+                .is_some_and(|m| Arc::ptr_eq(&m.controller, &target))
+        {
+            return refuse();
+        }
+        let source_principal = &self.source.source.credential.principal;
+        let target_principal = &self.target.recipient.credential.principal;
+        if [source_principal, target_principal]
+            .iter()
+            .any(|p| StreamController::principal_expiry(p).is_some_and(|t| t <= chrono::Utc::now()))
+            || self.source.original.iter().any(|(group, inside)| {
+                *inside != group.contains_principal(&target, target_principal)
+            })
+            || registry.groups.values().any(|group| {
+                group.contains_principal(&source, source_principal)
+                    != group.contains_principal(&target, target_principal)
+            })
+        {
+            return refuse();
+        }
+        io()
+    }
+}
