+    #[tokio::test]
+    async fn actual_udp_slow_permission_keeps_tone_clock_and_skips_obsolete_ticks() {
+        use rvoip_rtp_core::session::RtpSessionConfig;
+        struct Slow {
+            calls: AtomicUsize,
+        }
+        #[async_trait]
+        impl DtmfWriteAuthority for Slow {
+            async fn acquire(
+                &self,
+                scope: &DtmfWriteScope<'_>,
+            ) -> std::result::Result<DtmfWriteLease, DtmfWriteError> {
+                assert_eq!(scope.digits, "1");
+                assert_eq!(scope.duration_ms, 600);
+                // Longer than one RTP tick, still within the existing IO bound.
+                tokio::time::sleep(Duration::from_millis(35)).await;
+                self.calls.fetch_add(1, Ordering::AcqRel);
+                Ok(DtmfWriteLease::new(
+                    (),
+                    tokio::time::Instant::now() + DTMF_WRITE_DEADLINE,
+                    || true,
+                ))
+            }
+        }
+        let receiver = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let session = RtpSession::new(RtpSessionConfig {
+            local_addr: "127.0.0.1:0".parse().unwrap(),
+            remote_addr: Some(receiver.local_addr().unwrap()),
+            ssrc: Some(0xcafebabe),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+        let transmitter = DtmfTransmitter::new(Arc::new(Mutex::new(session)));
+        let policy = Slow {
+            calls: AtomicUsize::new(0),
+        };
+        let started = tokio::time::Instant::now();
+        transmitter
+            .send_sequence_authorized("1", 600, 70, &policy)
+            .await
+            .unwrap();
+        let elapsed = started.elapsed();
+        assert!(
+            elapsed >= Duration::from_millis(600),
+            "tone ended early: {elapsed:?}"
+        );
+        assert!(
+            elapsed < Duration::from_millis(1000),
+            "permission work stretched the tone: {elapsed:?}"
+        );
+        let mut count = 0;
+        let mut ends = 0;
+        let mut last = 0;
+        while let Ok(packet) =
+            tokio::time::timeout(Duration::from_millis(40), receive(&receiver)).await
+        {
+            count += 1;
+            assert_eq!(packet.payload[0], 1);
+            let duration = u16::from_be_bytes([packet.payload[2], packet.payload[3]]);
+            assert!(duration >= last && duration <= 4800);
+            last = duration;
+            if packet.payload[1] & 0x80 != 0 {
+                assert_eq!(duration, 4800);
+                ends += 1;
+            }
+        }
+        assert_eq!(ends, 3);
+        assert_eq!(count, policy.calls.load(Ordering::Acquire));
+        assert!(
+            count > 5 && count < 30,
+            "obsolete ticks were not skipped: {count}"
+        );
+    }
