+//! Custody of the one original mixer task through cancelled/concurrent ends.
+use crate::error::{Result, RvoipError};
+use std::sync::atomic::{AtomicBool, Ordering};
+use tokio::sync::Mutex;
+use tokio::task::{AbortHandle, JoinHandle};
+
+struct JoinState {
+    original: Option<JoinHandle<()>>,
+    completed: Option<bool>,
+}
+pub(crate) struct ConferenceTask {
+    abort: AbortHandle,
+    stop_requested: AtomicBool,
+    state: Mutex<JoinState>,
+    #[cfg(test)]
+    original_id: tokio::task::Id,
+}
+impl ConferenceTask {
+    pub(super) fn new(original: JoinHandle<()>) -> Self {
+        Self {
+            abort: original.abort_handle(),
+            stop_requested: AtomicBool::new(false),
+            #[cfg(test)]
+            original_id: original.id(),
+            state: Mutex::new(JoinState {
+                original: Some(original),
+                completed: None,
+            }),
+        }
+    }
+    /// Fence synchronously before the first cleanup await, as before.
+    pub(crate) fn abort(&self) {
+        self.stop_requested.store(true, Ordering::Release);
+        self.abort.abort();
+    }
+    pub(crate) async fn join(&self) -> Result<()> {
+        let mut state = self.state.lock().await;
+        let completed = match state.completed {
+            Some(completed) => completed,
+            None => {
+                // Borrow in place: dropping this caller cannot detach or lose
+                // the original handle. Another caller resumes this same join.
+                let result = state
+                    .original
+                    .as_mut()
+                    .expect("original mixer task custody")
+                    .await;
+                let completed = match result {
+                    Ok(()) => true,
+                    Err(error) => {
+                        error.is_cancelled() && self.stop_requested.load(Ordering::Acquire)
+                    }
+                };
+                state.original.take();
+                state.completed = Some(completed);
+                completed
+            }
+        };
+        if completed {
+            Ok(())
+        } else {
+            Err(RvoipError::InvalidState(
+                "original conference mixer task failed during retirement",
+            ))
+        }
+    }
+    #[cfg(test)]
+    pub(crate) fn original_id(&self) -> tokio::task::Id {
+        self.original_id
+    }
+    #[cfg(test)]
+    pub(crate) async fn joined_and_released_for_test(&self) -> bool {
+        let state = self.state.lock().await;
+        state.original.is_none() && state.completed == Some(true)
+    }
+}
+impl Drop for ConferenceTask {
+    fn drop(&mut self) {
+        self.abort();
+    }
+}
+
+#[cfg(test)]
+pub(super) type FinalizerHook = std::sync::Arc<std::sync::Mutex<Option<Box<dyn FnOnce() + Send>>>>;
+#[cfg(test)]
+pub(super) fn new_finalizer_hook() -> FinalizerHook {
+    Default::default()
+}
+#[cfg(test)]
+pub(super) struct TaskFinalizer(pub(super) FinalizerHook);
+#[cfg(test)]
+impl Drop for TaskFinalizer {
+    fn drop(&mut self) {
+        let hook = self.0.lock().unwrap().take();
+        if let Some(hook) = hook {
+            hook();
+        }
+    }
+}
+#[cfg(test)]
+pub(crate) struct FinalizerHold {
+    entered: std::sync::Arc<tokio::sync::Notify>,
+    release: Option<std::sync::mpsc::Sender<()>>,
+}
+#[cfg(test)]
+impl FinalizerHold {
+    pub(crate) async fn entered(&self) {
+        self.entered.notified().await;
+    }
+    pub(crate) fn release(&mut self) {
+        if let Some(release) = self.release.take() {
+            let _ = release.send(());
+        }
+    }
+}
+#[cfg(test)]
+impl Drop for FinalizerHold {
+    fn drop(&mut self) {
+        self.release();
+    }
+}
+#[cfg(test)]
+pub(super) fn hold_finalizer(hook: &FinalizerHook) -> FinalizerHold {
+    let entered = std::sync::Arc::new(tokio::sync::Notify::new());
+    let signal = entered.clone();
+    let (release, waiting) = std::sync::mpsc::channel();
+    let mut original = hook.lock().unwrap();
+    assert!(original.is_none());
+    *original = Some(Box::new(move || {
+        signal.notify_one();
+        // The test owner releases on both normal completion and unwinding.
+        // This blocks only a deliberate test finalizer, never production IO.
+        let _ = waiting.recv();
+    }));
+    FinalizerHold {
+        entered,
+        release: Some(release),
+    }
+}
