+/// Only refused metadata can be retried; submitted IO consumes the queued copy.
+pub enum ReadyAudioDelivery {
+    Refused {
+        queued: QueuedMedia,
+        problem: StreamControlError,
+    },
+    Submitted(ControlResult<()>),
+}
