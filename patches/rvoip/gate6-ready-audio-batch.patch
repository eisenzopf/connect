+#[tokio::test]
+async fn ready_audio_batch_returns_busy_metadata_but_consumes_a_submitted_transport_error() {
+    let (s, fence, _) = weak_scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let queued = bob.try_recv().unwrap();
+    let writer = fence.clone().write_owned().await;
+    let mut outcomes = QueuedMedia::deliver_ready_audio_batch(vec![queued], |_, _, _| {
+        panic!("busy source performed IO")
+    });
+    let ReadyAudioDelivery::Refused {
+        queued,
+        problem: StreamControlError::NotReady,
+    } = outcomes.pop().unwrap()
+    else {
+        panic!("busy source did not return original metadata")
+    };
+    drop(writer);
+    let mut calls = 0;
+    let result = QueuedMedia::deliver_ready_audio_batch(vec![queued], |_, frame, _| {
+        hear_ready_audio(frame, 1800)?;
+        calls += 1;
+        Err(StreamControlError::NotReady)
+    });
+    assert_eq!(calls, 1);
+    assert!(matches!(
+        &result[0],
+        ReadyAudioDelivery::Submitted(Err(StreamControlError::NotReady))
+    ));
+    assert!(fence.clone().try_write_owned().is_ok());
+}
