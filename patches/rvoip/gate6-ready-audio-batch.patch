+fn hear_ready_audio(frame: MediaFrame, expected: i16) -> ControlResult<()> {
+    let mut decoder =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1))
+            .unwrap();
+    let samples = decoder.decode(&frame.payload).unwrap().samples;
+    assert_eq!(samples.len(), 160);
+    assert!((i32::from(samples[80]) - i32::from(expected)).abs() < 350);
+    Ok(())
+}
+#[tokio::test]
+async fn ready_audio_batch_reuses_only_live_original_source_and_releases_before_waiting_writer() {
+    let fresh = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let hook: Arc<dyn Fn() + Send + Sync> = Arc::new({
+        let fresh = fresh.clone();
+        move || {
+            fresh.fetch_add(1, Ordering::AcqRel);
+        }
+    });
+    let (s, fence, _) = weak_scene_with_hook(Some(hook)).await;
+    let mut outputs = (1..4)
+        .map(|i| s.port(i).take_egress().unwrap())
+        .collect::<Vec<_>>();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let frames = outputs
+        .iter_mut()
+        .map(|out| out.try_recv().unwrap())
+        .collect::<Vec<_>>();
+    let custody = frames[0].sources[0].custody.clone();
+    fresh.store(0, Ordering::Release);
+    let mut writer = Box::pin(fence.clone().write_owned());
+    let mut sent = 0;
+    let results = QueuedMedia::deliver_ready_audio_batch(frames, |index, frame, origin| {
+        assert_eq!(origin.unwrap().connection.as_str(), "a");
+        hear_ready_audio(frame, 1800)?;
+        sent += 1;
+        if index == 0 {
+            assert!(writer
+                .as_mut()
+                .poll(&mut std::task::Context::from_waker(std::task::Waker::noop()))
+                .is_pending());
+        }
+        Ok(())
+    });
+    assert_eq!(sent, 3);
+    assert!(results
+        .iter()
+        .all(|r| matches!(r, ReadyAudioDelivery::Submitted(Ok(())))));
+    assert_eq!(
+        fresh.load(Ordering::Acquire),
+        1,
+        "same original source reopened behind writer"
+    );
+    assert!(
+        custody.active().is_none(),
+        "batch retained a reader after actual IO"
+    );
+    drop(writer.await);
+    assert!(fence.clone().try_write_owned().is_ok());
+}
+#[tokio::test]
+async fn ready_audio_batch_rejects_other_original_packets_before_any_io() {
+    let (s, fence, _) = weak_scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let first = bob.try_recv().unwrap();
+    s.publish(0, 4800);
+    s.mixer.tick();
+    let other = bob.try_recv().unwrap();
+    assert!(!first.same_audio_packet(&other));
+    let results = QueuedMedia::deliver_ready_audio_batch(vec![first, other], |_, _, _| {
+        panic!("cross-packet permission borrowed")
+    });
+    assert_eq!(results.len(), 2);
+    assert!(results.iter().all(|r| matches!(
+        r,
+        ReadyAudioDelivery::Refused {
+            problem: StreamControlError::Authority,
+            ..
+        }
+    )));
+    assert!(
+        fence.clone().try_write_owned().is_ok(),
+        "returned metadata retained a reader"
+    );
+}
+#[tokio::test]
+async fn ready_audio_batch_checks_each_recipient_and_preserves_other_authorized_sends() {
+    let (s, fence, revoked) = weak_scene().await;
+    let mut outputs = (1..4)
+        .map(|i| s.port(i).take_egress().unwrap())
+        .collect::<Vec<_>>();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let frames = outputs
+        .iter_mut()
+        .map(|out| out.try_recv().unwrap())
+        .collect::<Vec<_>>();
+    revoked.store(true, Ordering::Release);
+    let mut sent = Vec::new();
+    let results = QueuedMedia::deliver_ready_audio_batch(frames, |index, frame, _| {
+        hear_ready_audio(frame, 1800)?;
+        sent.push(index);
+        Ok(())
+    });
+    assert_eq!(sent, vec![0, 2]);
+    assert!(matches!(&results[0], ReadyAudioDelivery::Submitted(Ok(()))));
+    assert!(matches!(
+        &results[1],
+        ReadyAudioDelivery::Refused {
+            problem: StreamControlError::Authority,
+            ..
+        }
+    ));
+    assert!(matches!(&results[2], ReadyAudioDelivery::Submitted(Ok(()))));
+    assert!(fence.clone().try_write_owned().is_ok());
+}
