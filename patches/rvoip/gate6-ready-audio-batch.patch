+#[tokio::test]
+async fn ready_audio_batch_never_extends_original_age_for_later_recipients() {
+    let (s, fence, _) = weak_scene().await;
+    let mut outputs = (1..4)
+        .map(|i| s.port(i).take_egress().unwrap())
+        .collect::<Vec<_>>();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let frames = outputs
+        .iter_mut()
+        .map(|out| out.try_recv().unwrap())
+        .collect::<Vec<_>>();
+    let mut sent = 0;
+    let results = QueuedMedia::deliver_ready_audio_batch(frames, |index, frame, _| {
+        assert_eq!(index, 0, "expired original reached a later recipient");
+        hear_ready_audio(frame, 1800)?;
+        sent += 1;
+        // IO completed while current. Force a subsequent scheduling delay
+        // while its first interval is still owned: no later copy may use it
+        // beyond the original age, even though source custody remains live.
+        std::thread::sleep(Duration::from_millis(210));
+        Ok(())
+    });
+    assert_eq!(sent, 1);
+    assert!(matches!(&results[0], ReadyAudioDelivery::Submitted(Ok(()))));
+    assert!(results[1..].iter().all(|r| matches!(
+        r,
+        ReadyAudioDelivery::Refused {
+            problem: StreamControlError::Deadline,
+            ..
+        }
+    )));
+    assert!(
+        fence.clone().try_write_owned().is_ok(),
+        "expired batch retained a reader"
+    );
+}
