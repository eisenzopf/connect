+    /// Whether this is one original non-local audio contribution. This exposes
+    /// metadata only and does not perform admission or retain a reader.
+    pub fn can_batch_audio(&self) -> bool {
+        self.frame.kind == StreamKind::Audio
+            && self.local.is_none()
+            && self.data.is_none()
+            && self.sources.len() == 1
+    }
+    /// Match exact original packet metadata, never a shared source permission.
+    pub fn same_audio_packet(&self, other: &Self) -> bool {
+        self.can_batch_audio()
+            && other.can_batch_audio()
+            && Arc::ptr_eq(&self.sources[0].source, &other.sources[0].source)
+            && Arc::ptr_eq(&self.sources[0].custody.0, &other.sources[0].custody.0)
+    }
+    /// Deliver already-dequeued copies of one original audio packet through
+    /// nonblocking synchronous local IO. Each recipient obtains its own current
+    /// admission. Only this active call retains the first interval; no reader
+    /// escapes in an outcome or survives a caller's retry/coalescing wait.
+    ///
+    /// A refused frame is returned unchanged. Retry only Refused(NotReady)
+    /// within its original age; Submitted is terminal even when IO returns an
+    /// error. This does not establish remote delivery or new audience rights.
+    pub fn deliver_ready_audio_batch<F>(frames: Vec<Self>, mut send: F) -> Vec<ReadyAudioDelivery>
+    where
+        F: FnMut(usize, MediaFrame, Option<MediaDeliveryOrigin>) -> ControlResult<()>,
+    {
+        if frames.len() > MAX_READY_AUDIO_BATCH {
+            return frames
+                .into_iter()
+                .map(|queued| ReadyAudioDelivery::Refused {
+                    queued,
+                    problem: StreamControlError::Backpressure,
+                })
+                .collect();
+        }
+        if frames.iter().any(|frame| !frame.can_batch_audio()) {
+            return frames
+                .into_iter()
+                .map(|queued| ReadyAudioDelivery::Refused {
+                    queued,
+                    problem: StreamControlError::Unsupported,
+                })
+                .collect();
+        }
+        if frames
+            .first()
+            .is_some_and(|first| frames.iter().any(|frame| !first.same_audio_packet(frame)))
+        {
+            return frames
+                .into_iter()
+                .map(|queued| ReadyAudioDelivery::Refused {
+                    queued,
+                    problem: StreamControlError::Authority,
+                })
+                .collect();
+        }
+        let mut outcomes = Vec::with_capacity(frames.len());
+        let mut interval = None;
+        for (index, queued) in frames.into_iter().enumerate() {
+            let admitted = match queued.admit_queued_media() {
+                Ok(admitted) => admitted,
+                Err(problem) => {
+                    outcomes.push(ReadyAudioDelivery::Refused { queued, problem });
+                    continue;
+                }
+            };
+            let refusal = if admitted.tokens.iter().any(CancellationToken::is_cancelled) {
+                Some(StreamControlError::Cancelled)
+            } else if tokio::time::Instant::now() >= admitted.deadline {
+                Some(StreamControlError::Deadline)
+            } else {
+                None
+            };
+            if let Some(problem) = refusal {
+                outcomes.push(ReadyAudioDelivery::Refused { queued, problem });
+                continue;
+            }
+            tracing::trace!(target: "rvoip_core::audio_path", target = %admitted.target.connection,
+                age_us = queued.admitted_at.elapsed().as_micros() as u64, batched = true,
+                "Guarded audio entering IO");
+            let result = send(index, queued.frame.clone(), queued.delivery_origin());
+            queued.observe_delivery(&admitted, &result);
+            if interval.is_none() {
+                interval = Some(admitted);
+            }
+            outcomes.push(ReadyAudioDelivery::Submitted(result));
+        }
+        drop(interval);
+        outcomes
+    }
+    pub async fn deliver<F, Fut>(self, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(MediaFrame) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        self.deliver_with_origin(move |frame, _| send(frame)).await
+    }
+    /// Observe exact original source binding only inside the guarded send.
+    /// Mixed audio has no single source; unmixed direct media always does.
+    pub async fn deliver_with_origin<F, Fut>(self, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(MediaFrame, Option<MediaDeliveryOrigin>) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        if self.local.is_some() {
+            return self.deliver_local_audio(send).await;
+        }
+        if self.data.is_some() {
+            let admission = self.admit_data()?;
+            let writing = admission.begin_write()?;
+            let origin = Some(MediaDeliveryOrigin {
+                connection: writing.source().connection.clone(),
+                logical: writing.source().logical_id.clone(),
+                transport: writing.source().transport_id.clone(),
+                generation: writing.source().stream_generation,
+            });
+            let frame = writing.frame().clone();
+            let result = tokio::select! { biased;
+                _ = admission.cancelled() => Err(StreamControlError::Cancelled),
+                result = tokio::time::timeout_at(admission.deadline(), send(frame, origin)) => result.map_err(|_| StreamControlError::Deadline)?,
+            };
+            drop(writing);
+            return result;
+        }
+        let admitted = loop {
+            match self.admit_queued_media() {
+                Ok(admitted) => break admitted,
+                Err(StreamControlError::NotReady) if self.frame.kind == StreamKind::Audio => {
+                    // Only metadata remains here: a failed attempt dropped every
+                    // source/target authority and generation reader. Never extend
+                    // the original frame's age or recapture a newer audience.
+                    let until = tokio::time::Instant::from_std(
+                        self.admitted_at + Duration::from_millis(200),
+                    );
+                    if tokio::time::Instant::now() >= until {
+                        return Err(StreamControlError::Deadline);
+                    }
+                    tokio::time::sleep_until(
+                        until.min(tokio::time::Instant::now() + Duration::from_millis(1)),
+                    )
+                    .await;
+                }
+                Err(problem) => return Err(problem),
+            }
+        };
+        let target = &admitted.target;
+        let tokens = &admitted.tokens;
+        let deadline = admitted.deadline;
+        let origin = self.delivery_origin();
+        tracing::trace!(target: "rvoip_core::audio_path", target = %target.connection,
+            age_us = self.admitted_at.elapsed().as_micros() as u64, "Guarded audio entering IO");
+        let result = tokio::select! {
+            biased;
+            _=audio_consumer::any_cancelled(tokens.to_vec())=>Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,send(self.frame.clone(),origin))=>result.map_err(|_|StreamControlError::Deadline)?,
+        };
+        self.observe_delivery(&admitted, &result);
         result
     }
     // Synchronous acquisition ensures a refused attempt releases all readers
