+            authority: policy.clone(),
+            pending_capacity: 2,
+        });
+        Self {
+            config,
+            client,
+            server_verify: Sig9421Verifier::new(resolver),
+            policy,
+            validator,
+        }
+    }
+    fn peer(&self) -> CanonicalPeer {
+        CanonicalPeer::new(self.config.clone(), CancellationToken::new()).unwrap()
+    }
+    fn sign(&self, v: Value) -> Vec<u8> {
+        serde_json::to_vec(&self.client.sign(&v).unwrap()).unwrap()
+    }
+    async fn authenticate(&self, peer: &mut CanonicalPeer, token: &str) -> Envelope {
+        let output = peer
+            .handle(
+                &serde_json::to_vec(&hello()).unwrap(),
+                &Handler::default(),
+                deadline(),
+            )
+            .await
+            .unwrap();
+        let challenge = output.envelopes()[0].clone();
+        drop(output);
+        let output = peer
+            .handle(
+                &self.sign(response(&challenge, token)),
+                &Handler::default(),
+                deadline(),
+            )
+            .await
+            .unwrap();
+        output.envelopes()[0].clone()
+    }
+    async fn verify_server(&self, env: &Envelope) {
+        let mut p = principal("old");
+        p.subject = "server".into();
+        self.server_verify
+            .verify_for_principal(env.original(), &p)
+            .await
+            .unwrap();
+    }
+}
+
+#[derive(Default)]
+struct Tracking {
+    calls: AtomicUsize,
+    effects: std::sync::Mutex<HashSet<String>>,
+    requests: std::sync::Mutex<Vec<Value>>,
+}
+#[async_trait]
+impl AuthenticatedHandler for Tracking {
+    async fn handle(&self, env: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        assert_eq!(env.principal().subject, "alice");
+        assert!(matches!(
+            env.principal().assurance,
+            IdentityAssurance::UserAuthorized { .. } | IdentityAssurance::TaskScoped { .. }
+        ));
+        self.effects
+            .lock()
+            .unwrap()
+            .insert(env.envelope().scope(Scope::Operation).unwrap().into());
+        self.requests
+            .lock()
+            .unwrap()
+            .push(env.envelope().signature_input());
+        Envelope::from_value(envelope("ack", json!({}))).map_err(DispatchError::from)
+    }
+}
+fn proof(challenge: &Envelope, token: &str) -> Value {
+    let mut value = envelope(
+        "identity.step-up-response",
+        json!({"method":"bearer","credential":token}),
+    );
+    value["in_reply_to"] = json!(challenge.id());
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        if let Some(item) = challenge.original().get(field) {
+            value[field] = item.clone();
+        }
+    }
+    value
+}
+async fn blocked(f: &Fixture, peer: &mut CanonicalPeer, h: &Tracking) -> (Value, Envelope) {
+    let request = command();
+    let output = peer
+        .handle(&f.sign(request.clone()), h, deadline())
+        .await
+        .unwrap();
+    assert_eq!(h.calls.load(Ordering::SeqCst), 0);
+    let challenge = output.envelopes()[0].clone();
+    assert_eq!(challenge.kind(), "identity.step-up-request");
+    assert!(peer.has_pending_step_up());
+    (request, challenge)
+}
+
+use rvoip_uctp::v2::reachability::{
+    PeerTransport, ReachabilityRegistry, RouteAuthority, RouteHandle, TrustedPeerRoute,
+};
+
+struct RoutePolicy {
+    policy: Arc<Policy>,
+    tokens: std::sync::Mutex<std::collections::HashMap<(String, String), CancellationToken>>,
+    deny: AtomicBool,
+    deny_lifetime: AtomicBool,
+    hold: AtomicBool,
+    entered: Notify,
+    release: Notify,
+    deliveries: AtomicUsize,
+}
+impl RoutePolicy {
+    fn new(policy: Arc<Policy>) -> Arc<Self> {
+        Arc::new(Self {
+            policy,
+            tokens: std::sync::Mutex::new(std::collections::HashMap::new()),
+            deny: AtomicBool::new(false),
+            deny_lifetime: AtomicBool::new(false),
+            hold: AtomicBool::new(false),
+            entered: Notify::new(),
+            release: Notify::new(),
+            deliveries: AtomicUsize::new(0),
+        })
+    }
+    fn revoke(&self, token: &str, device: &str) {
+        if let Some(token) = self
+            .tokens
+            .lock()
+            .unwrap()
+            .get(&(token.into(), device.into()))
+        {
+            token.cancel();
+        }
+    }
+}
+#[async_trait]
+impl RouteAuthority for RoutePolicy {
+    fn lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        _: &Identifier,
+    ) -> Result<CancellationToken, DispatchError> {
+        if self.deny_lifetime.load(Ordering::SeqCst) {
+            return Err(DispatchError::Authority);
+        }
+        let key = (
+            c.token_id.clone().ok_or(DispatchError::Authority)?,
+            d.id.as_str().to_owned(),
+        );
+        Ok(self.tokens.lock().unwrap().entry(key).or_default().clone())
+    }
+    async fn delivery(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.deliveries.fetch_add(1, Ordering::SeqCst);
+        self.entered.notify_one();
+        if self.hold.load(Ordering::SeqCst) {
+            self.release.notified().await;
+        }
+        if self.deny.load(Ordering::SeqCst)
+            || !c.principal.has_scope("control")
+            || e.scope(Scope::Conversation) != Some("conversation")
+        {
+            return Err(DispatchError::Authority);
+        }
+        self.policy.guard(c, d, i, e).await
+    }
+}
+fn owner() -> rvoip_auth_core::PrincipalOwnershipKey {
+    principal("old").ownership_key()
