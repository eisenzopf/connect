+fn routed_peer(
+    f: &Fixture,
+    registry: Arc<ReachabilityRegistry>,
+    policy: Arc<RoutePolicy>,
+    lease: u64,
+) -> CanonicalPeer {
+    CanonicalPeer::with_reachability(
+        f.config.clone(),
+        CancellationToken::new(),
+        registry,
+        route("127.0.0.1:4433", lease),
