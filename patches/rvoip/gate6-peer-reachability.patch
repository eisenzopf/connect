+//! Process-local authenticated live-peer routing, not membership or delivery
+//! receipts. Addresses come from trusted adapter configuration, never hello.
+
+use super::{
+    auth_dispatch::{AuthorityLease, DispatchError, MAX_DISPATCH_WAIT},
+    payloads::{Device, ReachabilityHint},
+    Envelope, Identifier,
+};
+use async_trait::async_trait;
+use chrono::{DateTime, Utc};
+use parking_lot::Mutex;
+use rvoip_auth_core::bearer::{PrincipalOwnershipKey, ValidatedBearer};
+use std::{
+    collections::HashMap,
+    fmt,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+use tokio::{
+    sync::{mpsc, oneshot},
+    time::Instant,
+};
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PeerTransport {
+    Quic,
+    WebTransport,
+    WebSocket,
+}
+impl PeerTransport {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Quic => "quic",
+            Self::WebTransport => "webtransport",
+            Self::WebSocket => "websocket",
+        }
+    }
+}
+
+/// Trusted server-side route description. The address is a configured server
+/// endpoint/contact, not evidence that an observed client UDP port is dialable.
+#[derive(Clone)]
+pub struct TrustedPeerRoute {
+    transport: PeerTransport,
+    address: String,
+    priority: u16,
+    lease: Duration,
+}
+impl TrustedPeerRoute {
+    pub fn new(
+        transport: PeerTransport,
+        address: impl Into<String>,
+        priority: u16,
+        lease: Duration,
+    ) -> Result<Self, DispatchError> {
+        let address = address.into();
+        if address.is_empty()
+            || address.len() > 2048
+            || address.chars().any(char::is_control)
+            || address.contains('@')
+            || lease.is_zero()
+            || lease > Duration::from_secs(60)
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(Self {
+            transport,
+            address,
+            priority,
+            lease,
+        })
+    }
+}
+impl fmt::Debug for TrustedPeerRoute {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TrustedPeerRoute")
+            .field("transport", &self.transport)
+            .field("lease", &self.lease)
+            .finish_non_exhaustive()
+    }
+}
+
+/// Both hooks are required to install reachability. The synchronous lifetime
+/// hook runs under the owning peer's current authority lease. Its token must
+/// retire on credential/key, mapped identity or device-ownership revocation.
+/// Delivery must reacquire current recipient/audience/resource authorization;
+/// the trusted submitting application independently authorizes its source.
+#[async_trait]
+pub trait RouteAuthority: Send + Sync {
+    fn lifetime(
+        &self,
+        credential: &ValidatedBearer,
+        device: &Device,
+        identity: &Identifier,
+    ) -> Result<CancellationToken, DispatchError>;
+    async fn delivery(
+        &self,
+        credential: &ValidatedBearer,
+        device: &Device,
+        identity: &Identifier,
+        envelope: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError>;
+}
+
+/// Metadata hints in this registry grant no Conversation or Session access.
+/// Expired/revoked rows retain their slot until the owning registration retires.
+pub struct ReachabilityRegistry {
+    capacity: usize,
+    entries: Mutex<HashMap<Uuid, Arc<RouteState>>>,
+}
+impl ReachabilityRegistry {
+    pub fn new(capacity: usize) -> Result<Arc<Self>, DispatchError> {
+        if capacity == 0 || capacity > 4096 {
+            return Err(DispatchError::Capacity);
+        }
+        Ok(Arc::new(Self {
+            capacity,
+            entries: Mutex::new(HashMap::new()),
+        }))
+    }
+    /// Trusted router lookup by the complete target owner and mapped Identity.
+    /// Public facades must authorize the viewer before exposing any hint.
+    pub fn routes_for(
+        &self,
+        owner: &PrincipalOwnershipKey,
+        identity: &Identifier,
+    ) -> Result<Vec<RouteHandle>, DispatchError> {
+        let entries = self.entries.lock();
+        let mut routes = Vec::new();
+        for state in entries.values() {
+            if &state.owner != owner || &state.identity != identity || !state.live() {
+                continue;
+            }
+            if routes.len() == 64 {
+                return Err(DispatchError::Capacity);
+            }
+            routes.push(RouteHandle {
+                state: state.clone(),
+                expires: *state.expires.lock(),
+            });
+        }
+        Ok(routes)
+    }
+    pub fn usage(&self) -> (usize, usize) {
+        (self.entries.lock().len(), self.capacity)
+    }
+}
+impl fmt::Debug for ReachabilityRegistry {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ReachabilityRegistry")
+            .field("usage", &self.usage())
+            .finish()
+    }
+}
+
+#[derive(Clone, Copy)]
+struct LeaseTime {
+    utc: DateTime<Utc>,
+    mono: Instant,
+}
+struct RouteState {
+    registry: std::sync::Weak<ReachabilityRegistry>,
+    id: Uuid,
+    generation: u64,
+    owner: PrincipalOwnershipKey,
+    identity: Identifier,
+    device: Identifier,
+    route: TrustedPeerRoute,
+    credential_expiry: DateTime<Utc>,
+    credential_deadline: Instant,
+    authority: CancellationToken,
+    physical: CancellationToken,
+    expires: Mutex<LeaseTime>,
+    sender: mpsc::Sender<Outbound>,
+}
+impl RouteState {
+    fn live(&self) -> bool {
+        let expires = *self.expires.lock();
+        !self.authority.is_cancelled()
+            && !self.physical.is_cancelled()
+            && Instant::now() < expires.mono
+            && Utc::now() < expires.utc
+            && Instant::now() < self.credential_deadline
+            && Utc::now() < self.credential_expiry
+            && !self.sender.is_closed()
+    }
+    fn hint(&self, expires: LeaseTime) -> ReachabilityHint {
+        ReachabilityHint {
+            transport: self.route.transport.name().into(),
+            address: self.route.address.clone(),
+            expires_at: expires.utc,
+            priority: self.route.priority as u64,
+            device_id: self.device.clone(),
+        }
+    }
+}
+
+/// A frozen route incarnation and lease, never a raw writer. Heartbeats do not
+/// extend an old handle's captured expiry; refresh/step-up cannot lend it a new
+/// credential. A fresh lookup obtains the current incarnation and lease.
+#[derive(Clone)]
+pub struct RouteHandle {
+    state: Arc<RouteState>,
+    expires: LeaseTime,
+}
+impl RouteHandle {
+    pub fn hint(&self) -> ReachabilityHint {
+        self.state.hint(self.expires)
+    }
+    fn current(&self) -> bool {
+        if !self.state.live()
+            || Instant::now() >= self.expires.mono
+            || Utc::now() >= self.expires.utc
+        {
+            return false;
+        }
+        self.state.registry.upgrade().is_some_and(|registry| {
+            registry
+                .entries
+                .lock()
+                .get(&self.state.id)
+                .is_some_and(|current| Arc::ptr_eq(current, &self.state))
+        })
+    }
+    /// Success means bounded local reliable-writer admission, not remote
+    /// delivery or acceptance. A deadline/closure once writing may have begun
+    /// returns SubmissionUnknown; preserve the logical operation ID.
+    pub async fn submit(
+        &self,
+        envelope: Envelope,
+        requested: Instant,
+    ) -> Result<LocalSubmission, DispatchError> {
+        if !self.current() {
+            return Err(DispatchError::Closed);
+        }
+        let deadline = requested
+            .min(self.expires.mono)
+            .min(Instant::now() + MAX_DISPATCH_WAIT);
+        if deadline <= Instant::now() {
+            return Err(DispatchError::Closed);
+        }
+        let (reply, receiver) = oneshot::channel();
+        let started = Arc::new(AtomicBool::new(false));
+        self.state
+            .sender
+            .try_send(Outbound {
+                envelope,
+                handle: self.clone(),
+                deadline,
+                reply,
+                started: started.clone(),
+            })
+            .map_err(|error| match error {
+                mpsc::error::TrySendError::Full(_) => DispatchError::Capacity,
+                mpsc::error::TrySendError::Closed(_) => DispatchError::Closed,
+            })?;
+        match tokio::time::timeout_at(deadline, receiver).await {
+            Ok(Ok(result)) => result,
+            _ => Err(if started.load(Ordering::Acquire) {
+                DispatchError::SubmissionUnknown
+            } else {
+                DispatchError::Closed
+            }),
+        }
+    }
+}
+impl fmt::Debug for RouteHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("RouteHandle")
+            .field("transport", &self.state.route.transport)
+            .field("generation", &self.state.generation)
+            .finish_non_exhaustive()
+    }
+}
+
+pub struct LocalSubmission {
+    envelope_id: Identifier,
+}
+impl LocalSubmission {
+    pub fn envelope_id(&self) -> &Identifier {
+        &self.envelope_id
+    }
+}
+impl fmt::Debug for LocalSubmission {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("LocalSubmission(redacted)")
+    }
+}
+
+pub(super) struct Outbound {
+    pub(super) envelope: Envelope,
+    pub(super) handle: RouteHandle,
+    pub(super) deadline: Instant,
+    pub(super) reply: oneshot::Sender<Result<LocalSubmission, DispatchError>>,
+    pub(super) started: Arc<AtomicBool>,
+}
+impl Outbound {
+    pub(super) fn current(&self, registration: &Registration) -> bool {
+        self.handle.current()
+            && Arc::ptr_eq(&self.handle.state, &registration.state)
+            && !self.reply.is_closed()
+            && self.deadline > Instant::now()
+    }
+    pub(super) fn submitted(id: Identifier) -> LocalSubmission {
+        LocalSubmission { envelope_id: id }
+    }
+}
+
+pub(super) struct PeerRoutes {
+    pub(super) policy: Arc<dyn RouteAuthority>,
+    registry: Arc<ReachabilityRegistry>,
+    route: TrustedPeerRoute,
+    id: Uuid,
+    sender: mpsc::Sender<Outbound>,
+}
+impl PeerRoutes {
+    pub(super) fn new(
+        registry: Arc<ReachabilityRegistry>,
+        route: TrustedPeerRoute,
+        policy: Arc<dyn RouteAuthority>,
+    ) -> (Self, mpsc::Receiver<Outbound>) {
+        let (sender, receiver) = mpsc::channel(32);
+        (
+            Self {
+                policy,
+                registry,
+                route,
+                id: Uuid::new_v4(),
+                sender,
+            },
+            receiver,
+        )
+    }
+    pub(super) fn prepare(
+        &self,
+        credential: &ValidatedBearer,
+        device: &Device,
+        identity: &Identifier,
+        generation: u64,
+        physical: CancellationToken,
+        credential_deadline: Instant,
+    ) -> Result<Registration, DispatchError> {
+        let authority = self.policy.lifetime(credential, device, identity)?;
+        let credential_expiry = super::auth_peer::effective_expiry(&credential.principal)?;
+        let state = Arc::new(RouteState {
+            registry: Arc::downgrade(&self.registry),
+            id: self.id,
+            generation,
+            owner: credential.principal.ownership_key(),
+            identity: identity.clone(),
+            device: device.id.clone(),
+            route: self.route.clone(),
+            credential_expiry,
+            credential_deadline,
+            authority,
+            physical,
+            expires: Mutex::new(lease_time(
+                self.route.lease,
+                credential_expiry,
+                credential_deadline,
+            )?),
+            sender: self.sender.clone(),
+        });
+        Ok(Registration {
+            registry: self.registry.clone(),
+            state,
+        })
+    }
+}
+fn lease_time(
+    lease: Duration,
+    credential: DateTime<Utc>,
+    deadline: Instant,
+) -> Result<LeaseTime, DispatchError> {
+    let now = Utc::now();
+    let mono = Instant::now();
+    if credential <= now || deadline <= mono {
+        return Err(DispatchError::Authentication);
+    }
+    Ok(LeaseTime {
+        utc: (now + chrono::Duration::from_std(lease).map_err(|_| DispatchError::Authority)?)
+            .min(credential),
+        mono: (mono + lease).min(deadline),
+    })
+}
+
+/// Preparation is invisible. Publish only at synchronous peer binding commit
+/// under current authority; dropping any candidate/old incarnation removes
+/// only that exact published state, never its successor.
+pub(super) struct Registration {
+    registry: Arc<ReachabilityRegistry>,
+    state: Arc<RouteState>,
+}
+impl Registration {
+    pub(super) fn publish(&self) -> Result<(), DispatchError> {
+        if !self.state.live() {
+            return Err(DispatchError::Closed);
+        }
+        let mut entries = self.registry.entries.lock();
+        if let Some(old) = entries.get(&self.state.id) {
+            if old.generation >= self.state.generation
+                || old.owner != self.state.owner
+                || old.identity != self.state.identity
+                || old.device != self.state.device
+            {
+                return Err(DispatchError::Authority);
+            }
+        } else if entries.len() >= self.registry.capacity {
+            return Err(DispatchError::Capacity);
+        }
+        entries.insert(self.state.id, self.state.clone());
+        Ok(())
+    }
+    pub(super) fn hint(&self) -> ReachabilityHint {
+        self.state.hint(*self.state.expires.lock())
+    }
+    pub(super) fn authority(&self) -> CancellationToken {
+        self.state.authority.clone()
+    }
+    pub(super) fn renew(&self) -> Result<ReachabilityHint, DispatchError> {
+        if self.state.authority.is_cancelled() || self.state.physical.is_cancelled() {
+            return Err(DispatchError::Authority);
+        }
+        let entries = self.registry.entries.lock();
+        if !entries
+            .get(&self.state.id)
+            .is_some_and(|current| Arc::ptr_eq(current, &self.state))
+        {
+            return Err(DispatchError::Closed);
+        }
+        *self.state.expires.lock() = lease_time(
+            self.state.route.lease,
+            self.state.credential_expiry,
+            self.state.credential_deadline,
+        )?;
+        Ok(self.hint())
+    }
+}
+impl Drop for Registration {
+    fn drop(&mut self) {
+        let mut entries = self.registry.entries.lock();
+        if entries
+            .get(&self.state.id)
+            .is_some_and(|current| Arc::ptr_eq(current, &self.state))
+        {
+            entries.remove(&self.state.id);
+        }
+    }
+}
