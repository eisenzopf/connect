+async fn authenticate_device(
+    f: &Fixture,
+    peer: &mut CanonicalPeer,
+    device: &str,
+    token: &str,
+) -> Envelope {
+    let mut hello = hello();
+    hello["payload"]["device"]["id"] = json!(device);
+    hello["payload"]["capabilities"] =
+        json!({"reachability":[{"address":"attacker-selected-address"}]});
+    let output = peer
+        .handle(
+            &serde_json::to_vec(&hello).unwrap(),
+            &Handler::default(),
+            deadline(),
+        )
+        .await
+        .unwrap();
+    let challenge = output.envelopes()[0].clone();
+    drop(output);
+    let output = peer
+        .handle(
+            &f.sign(response(&challenge, token)),
+            &Handler::default(),
+            deadline(),
+        )
+        .await
+        .unwrap();
+    output.envelopes()[0].clone()
+}
+fn current(registry: &ReachabilityRegistry) -> Vec<RouteHandle> {
+    registry.routes_for(&owner(), &identity()).unwrap()
+}
+fn event() -> Envelope {
+    let mut value = envelope(
+        "conversation.event",
+        json!({"event_id":"event-fixture","cursor":"cursor-fixture","kind":"fixture","revision":1,"data":{"text":"guarded-route-payload"}}),
+    );
+    value["cid"] = json!("conversation");
+    value["operation_id"] = json!("logical-route-operation");
+    Envelope::from_value(value).unwrap()
