+
+fn selected_video(callback: &Envelope, id: &str) -> Value {
+    callback.original()["payload"]["substrate_setup"]["streams"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|s| s["strm_id"] == id)
+        .unwrap()["video_feedback"]
+        .clone()
+}
+#[tokio::test]
+async fn signed_video_selection_binds_original_allocation_across_reoffers_and_refuses_forged_confirmation(
+) {
+    let profile = Arc::new((*profile(false)).clone().with_video_feedback());
+    let mut s = Scene::new_profiled("quic", false, true, true, profile, None).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    let offer = |s: &Scene, revision, id: &str| {
+        let mut v = lifecycle_offer(s, 0, revision, "sendonly");
+        v["payload"]["streams_offered"]
+            .as_array_mut()
+            .unwrap()
+            .push(
+                json!({"id":id,"kind":"video","direction":"sendonly","codec_preferences":["vp8"]}),
+            );
+        v
+    };
+    let first = offer(&s, 0, "camera");
+    let (_, cb) = s.prepared(first.clone()).await;
+    let original = selected_video(&cb, "camera");
+    assert_eq!(original.as_object().unwrap().len(), 5);
+    assert_eq!(original["profile"], "rtcp-pli-epoch/1");
+    assert_eq!(original["original_operation"], first["operation_id"]);
+    assert_eq!(original["original_offer"], first["id"]);
+    assert_eq!(original["stream_generation"], 1);
+    assert_eq!(original["connection_generation"], 1);
+    assert!(selected_video(&cb, "first").is_null());
+    let handle = subscriptions::stream_handle(&cb, "camera");
+    s.confirm(&cb).await;
+    s.wait(1).await;
+    let repeated = offer(&s, 1, "camera");
+    let (_, cb) = s.prepared(repeated.clone()).await;
+    assert_ne!(repeated["id"], original["original_offer"]);
+    assert_eq!(selected_video(&cb, "camera"), original);
+    assert_eq!(subscriptions::stream_handle(&cb, "camera"), handle);
+    s.confirm(&cb).await;
+    s.wait(2).await;
+    send(&s.wire, subscriptions::video_sequence(handle, 2, 6000));
+    let notice = epoch(&s.f, &mut s.wire).await;
+    for field in [
+        "profile",
+        "original_operation",
+        "original_offer",
+        "stream_generation",
+        "connection_generation",
+    ] {
+        assert_eq!(notice["payload"][field], original[field]);
+    }
+    let replacement = offer(&s, 2, "camera_new");
+    let (_, cb) = s.prepared(replacement.clone()).await;
+    let next = selected_video(&cb, "camera_new");
+    assert_eq!(next["original_operation"], replacement["operation_id"]);
+    assert_eq!(next["original_offer"], replacement["id"]);
+    let next_handle = subscriptions::stream_handle(&cb, "camera_new");
+    assert_ne!(next_handle, handle);
+    s.confirm(&cb).await;
+    s.wait(3).await;
+    assert!(s.record.results.lock().unwrap().iter().all(|r| r.is_ok()));
+    send(&s.wire, subscriptions::video_sequence(next_handle, 1, 9000));
+    let notice = epoch(&s.f, &mut s.wire).await;
+    for field in [
+        "profile",
+        "original_operation",
+        "original_offer",
+        "stream_generation",
+        "connection_generation",
+    ] {
+        assert_eq!(notice["payload"][field], next[field]);
+    }
+    let (_, cb) = s.prepared(offer(&s, 3, "camera_new")).await;
+    let mut forged = s.confirmation(&cb);
+    let stream = forged["payload"]["substrate_setup"]["streams"]
+        .as_array_mut()
+        .unwrap()
+        .iter_mut()
+        .find(|s| s["strm_id"] == "camera_new")
+        .unwrap();
+    stream["video_feedback"]["stream_generation"] = json!(99);
+    s.wire.send(s.f.sign(forged)).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.wait(4).await;
+    assert!(matches!(
+        s.record.results.lock().unwrap()[3],
+        Err(NativeOfferError::Confirmation)
+    ));
+    assert_eq!(s.controller().revision(), 3);
+    s.wire.server.shutdown().await.unwrap();
+}
