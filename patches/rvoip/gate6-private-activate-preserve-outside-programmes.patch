+#[tokio::test]
+async fn successive_muted_preparations_preserve_original_rule_identity_and_order() {
+    let mut room = room().await;
+    room.apply(muted_plan(&room, "zzz-activate-device"))
+        .await
+        .unwrap();
+    room.add_owned_with_media(
+        "device2",
+        "device2",
+        owner("device2"),
+        true,
+        None,
+        vec![desired(Medium::Audio), desired(Medium::Video)],
+    )
+    .await;
+    let before = room
+        .nodes
+        .iter()
+        .filter(|(name, _)| name.as_str() != "device2")
+        .map(|(name, node)| {
+            let consumer = node
+                .controller
+                .audio_consumer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .unwrap()
+                .upgrade()
+                .unwrap();
+            (
+                name.clone(),
+                (node.controller.revision(), consumer.subscriptions.stamp()),
+            )
+        })
+        .collect::<BTreeMap<_, _>>();
+    let mut plan = room
+        .scene
+        .plan_audio_audience(AudioAudienceRequest {
+            operation_id: "aaa-activate-device2".into(),
+            expected_revision: room.scene.audience_revision(),
+            private_connections: BTreeSet::from([ConnectionId::from_string("device2")]),
+            receivers: BTreeMap::from([(ConnectionId::from_string("device2"), vec![])]),
+            activate_muted: Some(ConnectionId::from_string("device2")),
+        })
+        .unwrap();
+    plan.keep_endpoint_muted(&ConnectionId::from_string("device2"))
+        .unwrap();
+    room.apply(plan).await.unwrap();
+    for (name, (revision, stamp)) in before {
+        assert_eq!(room.nodes[&name].controller.revision(), revision);
+        assert!(
+            stamp.is_current(),
+            "later preparation changed an existing rule identity"
+        );
+    }
+    room.publish("alice", 1800).unwrap();
+    room.tick();
+    room.heard("bob", 1800).await;
+    room.heard("public", 1800).await;
+    assert!(room.publish("device", 6000).is_err());
+    assert!(room.publish("device2", 6000).is_err());
+}
