+#[tokio::test]
+async fn muted_preparation_does_not_drain_admitted_old_audio_or_video_io() {
+    let mut room = room().await;
+    let mut video = room.nodes["bob"]
+        .adapter
+        .port(Medium::Video)
+        .take_egress()
+        .unwrap();
+    room.publish("alice", 1800).unwrap();
+    let source = room.nodes["alice"].adapter.port(Medium::Video);
+    source.try_publish(&frame(&source, 12345)).unwrap();
+    room.tick();
+    let audio = outgoing(&mut room.nodes.get_mut("bob").unwrap().out).await;
+    let video = outgoing(&mut video).await;
+    let audio_io = audio.admit_queued_media().unwrap();
+    let video_io = video.admit_queued_media().unwrap();
+    let plan = muted_plan(&room, "activate-with-outside-io");
+    assert!(plan.is_muted_endpoint_preparation());
+    room.apply(plan)
+        .await
+        .expect("private muted activation waited for unrelated admitted old IO");
+    drop(audio_io);
+    drop(video_io);
+    audio.deliver(|_| async { Ok(()) }).await.unwrap();
+    video.deliver(|_| async { Ok(()) }).await.unwrap();
+    assert!(room.publish("device", 6000).is_err());
+}
