+#[tokio::test]
+async fn ordinary_audience_change_still_retires_old_outside_ticket() {
+    let mut room = room().await;
+    room.publish("alice", 1800).unwrap();
+    room.tick();
+    let old = outgoing(&mut room.nodes.get_mut("bob").unwrap().out).await;
+    room.heard("public", 1800).await;
+    let controller = room.nodes["bob"].controller.clone();
+    let before = controller.revision();
+    let stamp = controller
+        .audio_consumer
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .upgrade()
+        .unwrap()
+        .subscriptions
+        .stamp();
+    let plan = room
+        .scene
+        .plan_audio_audience(AudioAudienceRequest {
+            operation_id: "real-private-route-change".into(),
+            expected_revision: room.scene.audience_revision(),
+            private_connections: BTreeSet::from([
+                ConnectionId::from_string("device"),
+                ConnectionId::from_string("alice"),
+            ]),
+            receivers: BTreeMap::from([
+                (ConnectionId::from_string("device"), vec![]),
+                (ConnectionId::from_string("alice"), vec![]),
+                (ConnectionId::from_string("bob"), vec![]),
+                (ConnectionId::from_string("public"), vec![]),
+            ]),
+            activate_muted: Some(ConnectionId::from_string("device")),
+        })
+        .unwrap();
+    assert!(!plan.is_muted_endpoint_preparation());
+    room.apply(plan).await.unwrap();
+    assert!(controller.revision() > before);
+    assert!(!stamp.is_current());
+    assert!(old.deliver(|_| async { Ok(()) }).await.is_err());
+    room.publish("alice", 1800).unwrap();
+    room.tick();
+    room.silent(&["bob", "public"]);
+}
