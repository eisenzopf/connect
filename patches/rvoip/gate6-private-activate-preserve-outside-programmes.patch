+#[tokio::test]
+async fn muted_preparation_rejects_foreign_controller_and_changed_original_credential() {
+    let room = room().await;
+    let before = room.scene.audience_revision();
+    let mut foreign = muted_plan(&room, "wrong-controller");
+    Arc::make_mut(&mut foreign.group).origins[0].controller =
+        Arc::downgrade(&room.nodes["alice"].controller);
+    assert!(foreign
+        .keep_endpoint_muted(&ConnectionId::from_string("device"))
+        .is_err());
+    assert!(room.apply(foreign).await.is_err());
+    assert_eq!(room.scene.audience_revision(), before);
+    let mut changed = muted_plan(&room, "changed-credential");
+    let candidate = &room.nodes["device"].controller;
+    let original_credential = candidate.credential_snapshot();
+    {
+        let mut current = candidate.credential.lock().unwrap();
+        let mut principal = (*current.principal).clone();
+        principal.scopes.push("changed-authorization".into());
+        current.principal = Arc::new(principal);
+        current.revision += 1;
+    }
+    Arc::make_mut(&mut changed.group).origins[0] = AudienceOrigin::new(candidate);
+    assert!(changed
+        .keep_endpoint_muted(&ConnectionId::from_string("device"))
+        .is_err());
+    assert!(room.apply(changed).await.is_err());
+    *candidate.credential.lock().unwrap() = original_credential;
+    assert_eq!(room.scene.audience_revision(), before);
+    let revoked = muted_plan(&room, "withdrawn-current-owner");
+    room.domain
+        .base
+        .0
+        .write()
+        .await
+        .revoked
+        .insert("device".into());
+    assert!(room.apply(revoked).await.is_err());
+    assert_eq!(room.scene.audience_revision(), before);
+}
