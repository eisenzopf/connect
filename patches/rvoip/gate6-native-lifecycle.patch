+    let answer = wire.read().await;
+    assert_eq!(answer.kind(), "connection.answer", "{answer:?}");
+    s.f.verify_server(&answer).await;
+    let callback = wire.read().await;
+    assert_eq!(callback.kind(), "connection.offer");
+    s.f.verify_server(&callback).await;
+    (answer, callback)
