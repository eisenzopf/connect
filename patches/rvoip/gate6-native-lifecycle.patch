+        .unwrap() as u16;
+    assert_ne!(new_handle, ah);
+    let closed = s.wire.read().await;
+    assert_eq!(closed.kind(), "stream.closed");
+    assert_eq!(closed.original()["payload"]["strm_id"], "first");
+    assert_eq!(closed.original()["payload"]["reason"], "codec-renegotiated");
+    s.f.verify_server(&closed).await;
+    no_event(&mut s.wire).await;
+    send(&s.wire, audio_sequence(ah, 2));
+    no_event(&mut s.wire).await;
+    send(&other, audio_sequence(bh, 2));
+    packet(&mut bi)
+        .await
+        .try_forward_to(&s.controller(), &first)
+        .unwrap();
+    let output = received(&s.wire).await;
+    assert_eq!(output.stream_local_id, new_handle);
+    decoded(&output);
+    no_event(&mut s.wire).await;
+    let mut new_input = s.controller().take_ingress(&first).unwrap();
+    send(&s.wire, audio_sequence(new_handle, 3));
+    let _new = packet(&mut new_input).await;
+    let opened = s.wire.read().await;
+    assert_eq!(opened.kind(), "stream.opened");
+    assert_eq!(
+        opened.original()["payload"]["stream"]["stream_local_id"],
+        new_handle
+    );
+    s.f.verify_server(&opened).await;
+    no_event(&mut s.wire).await;
+    no_event(&mut other).await;
+    s.wire.server.shutdown().await.unwrap();
+    other.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_event_denial_is_scoped_and_recovers_after_current_reauthorization() {
+    let mut s = Scene::new("quic", false).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    let (a, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    s.grants.0.write().await.event_denied.insert(s.id.clone());
+    let handle = a.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+        .as_u64()
+        .unwrap() as u16;
+    let mut input = s
+        .controller()
+        .take_ingress(&StreamId::from_string("first"))
+        .unwrap();
+    send(&s.wire, audio_sequence(handle, 1));
+    let _actual = packet(&mut input).await;
+    core_fixture::until(|| s.record.event_attempts.load(Ordering::Acquire) > 0).await;
+    no_event(&mut s.wire).await;
+    assert_eq!(s.record.event_approvals.load(Ordering::Acquire), 0);
+    s.grants.0.write().await.event_denied.clear();
+    let (again, callback) = s.prepared(lifecycle_offer(&s, 0, 1, "sendonly")).await;
+    s.confirm(&callback).await;
+    s.wait(2).await;
+    assert_eq!(
+        again.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"],
+        handle
+    );
+    ready_opened(&s.f, &mut s.wire, handle).await;
+    assert_eq!(s.controller().revision(), 2);
+    no_event(&mut s.wire).await;
+    s.wire.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn native_lifecycle_mux_denial_preserves_other_connection_on_same_physical_writer() {
+    let mut s = Scene::new("quic", false).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    s.record.probe_other_scope.store(true, Ordering::Release);
+    let (a, ca) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    s.confirm(&ca).await;
+    s.wait(1).await;
+    let (b, cb) = s.prepared(lifecycle_offer(&s, 1, 0, "sendonly")).await;
+    s.confirm(&cb).await;
+    s.wait(2).await;
+    let ah = a.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+        .as_u64()
+        .unwrap() as u16;
+    let bh = b.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+        .as_u64()
+        .unwrap() as u16;
+    assert_ne!(ah, bh);
+    let mut ai = s
+        .controller()
+        .take_ingress(&StreamId::from_string("first"))
+        .unwrap();
+    let second = s.native.adapters[&s.kind]
+        .media_controller(&s.second_id)
+        .unwrap();
+    let mut bi = second
+        .take_ingress(&StreamId::from_string("first"))
+        .unwrap();
+    s.grants.0.write().await.event_denied.insert(s.id.clone());
+    send(&s.wire, audio_sequence(ah, 1));
+    let _a = packet(&mut ai).await;
+    core_fixture::until(|| s.record.event_attempts.load(Ordering::Acquire) > 0).await;
+    send(&s.wire, audio_sequence(bh, 1));
+    let _b = packet(&mut bi).await;
+    for kind in ["connection.ready", "stream.opened"] {
+        let event = s.wire.read().await;
+        assert_eq!(event.kind(), kind);
+        assert_eq!(event.scope(Scope::Connection), Some("native_1"));
+        s.f.verify_server(&event).await;
+    }
+    no_event(&mut s.wire).await;
+    assert_eq!(s.controller().revision(), 1);
+    assert_eq!(second.revision(), 1);
+    assert_eq!(s.native.adapters[&s.kind].route_count(), 2);
+    assert!(s.record.other_scope_refused.load(Ordering::Acquire));
+    s.wire.server.shutdown().await.unwrap();
+}
