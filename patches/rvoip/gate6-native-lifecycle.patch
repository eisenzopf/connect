+struct EventPolicy {
+    grants: Arc<Grants>,
+    record: Arc<Record>,
+}
+#[async_trait]
+impl NativeLifecyclePolicy for EventPolicy {
+    async fn authorize(
+        &self,
+        s: &NativeLifecycleScope,
+        event: &NativeLifecycleEvent,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.record.event_attempts.fetch_add(1, Ordering::AcqRel);
+        let guard = self.grants.0.clone().read_owned().await;
+        let owner = credential_owner(
+            guard
+                .owners
+                .get(&s.media.connection)
+                .ok_or(DispatchError::Authority)?
+                .clone(),
+            &s.principal,
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        if guard.denied
+            || guard.event_denied.contains(&s.media.connection)
+            || !owner.may_control
+            || s.media.wire_conversation.as_deref() != Some("conversation")
+            || s.media.wire_session != "session"
+            || guard.wires.get(&s.media.wire_connection) != Some(&s.media.connection)
+            || s.media.owner != s.principal.ownership_key()
+            || s.participant != *owner.member.participant()
+            || s.membership_epoch != owner.member.epoch()
+            || s.device != *owner.endpoint.device()
+        {
+            return Err(DispatchError::Authority);
+        }
+        owner
+            .actor
+            .revalidate_principal(&s.principal, Utc::now())
+            .map_err(|_| DispatchError::Authority)?;
+        owner
+            .connection
+            .require_current(&owner.member, &owner.presence)
+            .map_err(|_| DispatchError::Authority)?;
+        if owner.endpoint.state() != EndpointState::Verified
+            || owner.endpoint.identity() != owner.member.identity()
+            || s.endpoint != *owner.endpoint.endpoint()
+            || s.identity != *owner.member.identity()
+            || owner.connection.endpoint() != owner.endpoint.endpoint()
+            || owner.connection.state() != BindingState::Active
+            || owner.actor.identity() != owner.member.identity()
+            || owner.actor.tenant() != owner.member.tenant()
+        {
+            return Err(DispatchError::Authority);
+        }
+        let streams = match event {
+            NativeLifecycleEvent::ConnectionReady { streams } => streams.as_slice(),
+            NativeLifecycleEvent::StreamOpened { stream }
+            | NativeLifecycleEvent::StreamClosed { stream, .. } => std::slice::from_ref(stream),
+        };
+        for b in streams {
+            if b.connection_generation != owner.connection.generation() {
+                return Err(DispatchError::Authority);
+            }
+            let req = &b.negotiated.requested;
+            if (req.direction != StreamDirection::Receive
+                && !owner.send_media.contains(&req.medium))
+                || (req.direction != StreamDirection::Send
+                    && !owner.receive_media.contains(&req.medium))
+            {
+                return Err(DispatchError::Authority);
+            }
+        }
+        self.record.event_approvals.fetch_add(1, Ordering::AcqRel);
+        Ok(AuthorityLease::holding(guard))
+    }
+}
