+/// One physical handler can own many Connections. A refused or expired event
+/// registration is removed locally; it does not retire unrelated Connections.
+#[derive(Default)]
+pub struct NativeLifecycleMux {
+    registrations: Mutex<BTreeMap<ConnectionId, Arc<NativeLifecycleRegistration>>>,
+    changed: tokio::sync::Notify,
+}
+impl NativeLifecycleMux {
+    pub fn register(
+        &self,
+        id: ConnectionId,
+        registration: Arc<NativeLifecycleRegistration>,
+    ) -> Result<(), DispatchError> {
+        let mut entries = self.registrations.lock().unwrap_or_else(|p| p.into_inner());
+        if entries.len() >= 64 && !entries.contains_key(&id) {
+            return Err(DispatchError::Capacity);
+        }
+        entries.insert(id, registration);
+        drop(entries);
+        self.changed.notify_waiters();
+        Ok(())
+    }
+    pub fn remove(&self, id: &ConnectionId) {
+        self.registrations
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .remove(id);
+        self.changed.notify_waiters();
+    }
+    pub async fn next_delivery(&self) -> Result<HandlerDelivery, DispatchError> {
+        use futures::{stream::FuturesUnordered, StreamExt};
+        loop {
+            let changed = self.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            let snapshot = self
+                .registrations
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .iter()
+                .map(|(id, reg)| (id.clone(), reg.clone()))
+                .collect::<Vec<_>>();
+            let mut waiting = FuturesUnordered::new();
+            for (id, registration) in snapshot {
+                waiting.push(async move {
+                    let result = registration.next_delivery().await;
+                    (id, registration, result)
+                });
+            }
+            let next = async {
+                if waiting.is_empty() {
+                    std::future::pending().await
+                } else {
+                    waiting.next().await.expect("nonempty registrations")
+                }
+            };
+            tokio::select! {
+                _=&mut changed=>continue,
+                (id,registration,result)=next=>match result{
+                    Ok(delivery)=>return Ok(delivery),
+                    Err(_)=>{let mut entries=self.registrations.lock().unwrap_or_else(|p|p.into_inner());if entries.get(&id).is_some_and(|current|Arc::ptr_eq(current,&registration)){entries.remove(&id);}}
+                }
+            }
+        }
+    }
+}
