+//! Signed native lifecycle facts derived from exact installed ports and real IO.
+//! This is not Participant presence, durable Session projection or a receipt.
+use super::auth_dispatch::lifecycle::{NativeLifecycleFence, NativeLifecycleOrigin};
+use super::{auth_dispatch::*, Envelope};
+use crate::{native_flow::NativeFlow, staged_media::StagedRtpScope};
+use async_trait::async_trait;
+use rvoip_core::{
+    identity::AuthenticatedPrincipal, ids::*, staged_streams::StreamController, stream_lifecycle::*,
+};
+use serde_json::{json, Value};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex, Weak},
+    time::Duration,
+};
+use tokio::time::Instant;
+use tokio_util::sync::CancellationToken;
+#[derive(Clone)]
+pub enum NativeLifecycleEvent {
+    ConnectionReady {
+        streams: Vec<ReadyMediaBinding>,
+    },
+    StreamOpened {
+        stream: ReadyMediaBinding,
+    },
+    StreamClosed {
+        stream: ReadyMediaBinding,
+        replaced: bool,
+    },
+}
+impl std::fmt::Debug for NativeLifecycleEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeLifecycleEvent(redacted)")
+    }
+}
+/// Immutable physical-origin scope. A host must derive a new current guard for
+/// the exact member/epoch/device, credential and event; metadata is no grant.
+pub struct NativeLifecycleScope {
+    pub principal: AuthenticatedPrincipal,
+    pub media: StagedRtpScope,
+    pub participant: ParticipantId,
+    pub membership_epoch: u64,
+    pub device: DeviceId,
+    pub endpoint: EndpointId,
+    pub identity: IdentityId,
+}
+#[async_trait]
+pub trait NativeLifecyclePolicy: Send + Sync {
+    async fn authorize(
+        &self,
+        scope: &NativeLifecycleScope,
+        event: &NativeLifecycleEvent,
+    ) -> Result<AuthorityLease, DispatchError>;
+}
+#[derive(Default)]
+pub(crate) struct Announcements {
+    ready: bool,
+    opened: BTreeMap<StreamId, ReadyMediaBinding>,
+    pending: Option<Pending>,
+}
+struct Pending {
+    event: NativeLifecycleEvent,
+    result: Arc<Mutex<Option<Result<(), DispatchError>>>>,
+    task: tokio::task::JoinHandle<()>,
+    permit: Arc<AnswerPermit>,
+}
+impl Drop for Pending {
+    fn drop(&mut self) {
+        self.permit.cancel();
+        self.task.abort();
+    }
+}
+struct FrameFence {
+    controller: Weak<StreamController>,
+    flow: Arc<NativeFlow>,
+    revision: u64,
+    event: NativeLifecycleEvent,
+    epoch: CancellationToken,
+}
+impl NativeLifecycleFence for FrameFence {
+    fn current(&self) -> bool {
+        if self.epoch.is_cancelled() || !self.flow.current() {
+            return false;
+        }
+        let Some(c) = self.controller.upgrade() else {
+            return false;
+        };
+        if c.revision() != self.revision {
+            return false;
+        }
+        let active = c.active_bindings();
+        let observed = match &self.event {
+            NativeLifecycleEvent::ConnectionReady { streams } => {
+                self.flow.confirmed_at(self.revision)
+                    && !streams.is_empty()
+                    && active.len() == streams.len()
+                    && streams.iter().all(|b| {
+                        active
+                            .iter()
+                            .any(|a| crate::staged_media::same_binding(a, b))
+                            && self.flow.flowing(b)
+                    })
+            }
+            NativeLifecycleEvent::StreamOpened { stream } => {
+                self.flow.confirmed_at(self.revision)
+                    && active
+                        .iter()
+                        .any(|a| crate::staged_media::same_binding(a, stream))
+                    && self.flow.flowing(stream)
+            }
+            NativeLifecycleEvent::StreamClosed { stream, .. } => {
+                !active.iter().any(|a| a.transport_id == stream.transport_id)
+            }
+        };
+        observed && !self.epoch.is_cancelled() && c.revision() == self.revision
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.epoch.child_token()
+    }
+}
+struct RouteFence {
+    flow: Arc<NativeFlow>,
+}
+impl NativeLifecycleFence for RouteFence {
+    fn current(&self) -> bool {
+        self.flow.current()
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.flow.epoch()
+    }
+}
+/// Register after actual signed parameter negotiation/local graph commit. The
+/// observer holds no original authority reader and cannot manufacture frames.
+pub struct NativeLifecycleRegistration {
+    origin: NativeLifecycleOrigin,
+    controller: Weak<StreamController>,
+    flow: Arc<NativeFlow>,
+    scope: NativeLifecycleScope,
+    policy: Arc<dyn NativeLifecyclePolicy>,
+    state: Arc<tokio::sync::Mutex<Announcements>>,
+    pending_write: Mutex<Option<Weak<AnswerPermit>>>,
+}
+impl Drop for NativeLifecycleRegistration {
+    fn drop(&mut self) {
+        self.origin.retire();
+        if let Some(permit) = self
+            .pending_write
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .and_then(Weak::upgrade)
+        {
+            permit.cancel();
+        }
+    }
+}
+impl NativeLifecycleRegistration {
+    pub(crate) fn new(
+        a: &AuthorizedEnvelope,
+        controller: &Arc<StreamController>,
+        flow: Arc<NativeFlow>,
+        scope: StagedRtpScope,
+        member: &rvoip_core::relationships::Membership,
+        endpoint: &rvoip_core::relationships::EndpointBinding,
+        policy: Arc<dyn NativeLifecyclePolicy>,
+        state: Arc<tokio::sync::Mutex<Announcements>>,
+    ) -> Result<Arc<Self>, DispatchError> {
+        if !flow.confirmed_for(controller.revision(), a.envelope().id())
+            || controller.revision() == 0
+        {
+            return Err(DispatchError::Authority);
+        }
+        let origin = NativeLifecycleOrigin::seal(
+            a,
+            controller,
+            scope.clone(),
+            member,
+            endpoint,
+            Arc::new(RouteFence { flow: flow.clone() }),
+        )?;
+        Ok(Arc::new(Self {
+            origin,
+            controller: Arc::downgrade(controller),
+            flow,
+            scope: NativeLifecycleScope {
+                principal: a.principal().clone(),
+                media: scope,
+                participant: member.participant().clone(),
+                membership_epoch: member.epoch(),
+                device: endpoint.device().clone(),
+                endpoint: endpoint.endpoint().clone(),
+                identity: member.identity().clone(),
+            },
+            policy,
+            state,
+            pending_write: Mutex::new(None),
+        }))
+    }
+    pub fn current(&self) -> bool {
+        self.origin.current()
+    }
+    pub async fn next_delivery(&self) -> Result<HandlerDelivery, DispatchError> {
+        loop {
+            if !self.origin.current() {
+                return Err(DispatchError::Closed);
+            }
+            let changed = self.flow.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            if !self.origin.ready() {
+                tokio::select! {_=self.origin.cancellation().cancelled_owned()=>return Err(DispatchError::Closed),_=tokio::time::sleep(Duration::from_millis(5))=>{}}
+                continue;
+            }
+            let Some(controller) = self.controller.upgrade() else {
+                return Err(DispatchError::Closed);
+            };
+            let revision = controller.revision();
+            let active = controller.active_bindings();
+            let mut state = self.state.lock().await;
+            if let Some(pending) = state.pending.as_ref() {
+                let result = *pending.result.lock().unwrap_or_else(|p| p.into_inner());
+                if let Some(result) = result {
+                    let pending = state.pending.take().expect("locked pending event");
+                    if result.is_ok() {
+                        apply(&mut state, pending.event.clone());
+                    }
+                    // A failed/uncertain hint is reconstructed only from current
+                    // facts. It does not manufacture a committed business result.
+                } else {
+                    drop(state);
+                    tokio::select! {_=self.origin.cancellation().cancelled_owned()=>return Err(DispatchError::Closed),_=&mut changed=>{},_=tokio::time::sleep(Duration::from_millis(10))=>{}}
+                    continue;
+                }
+            }
+            let event = choose(&state, &active, revision, &self.flow);
+            let Some(event) = event else {
+                drop(state);
+                tokio::select! {_=self.origin.cancellation().cancelled_owned()=>return Err(DispatchError::Closed),_=&mut changed=>{},_=tokio::time::sleep(Duration::from_millis(20))=>{}}
+                continue;
+            };
+            let fence = Arc::new(FrameFence {
+                controller: Arc::downgrade(&controller),
+                flow: self.flow.clone(),
+                revision,
+                event: event.clone(),
+                epoch: self.flow.epoch(),
+            });
+            let origin = self.origin.with_fence(fence);
+            let deadline = Instant::now() + Duration::from_secs(1);
+            let cancellation = origin.cancellation();
+            let authority = tokio::select! {biased;_=cancellation.cancelled()=>return Err(DispatchError::Closed),_=tokio::time::sleep_until(deadline)=>return Err(DispatchError::Closed),r=self.policy.authorize(&self.scope,&event)=>r?};
+            if !origin.current() {
+                continue;
+            }
+            let permit = AnswerPermit::new(authority, origin.event_cancellation(), deadline);
+            let (written, receipt) = tokio::sync::oneshot::channel();
+            let result = Arc::new(Mutex::new(None));
+            let frame = frame(&self.scope.media, &event)?;
+            let delivery = HandlerDelivery::native_lifecycle(
+                origin.clone(),
+                frame,
+                permit.clone(),
+                written,
+                deadline,
+            )?;
+            *self.pending_write.lock().unwrap_or_else(|p| p.into_inner()) =
+                Some(Arc::downgrade(&permit));
+            let pending_result = result.clone();
+            let pending_permit = permit.clone();
+            let changed_flow = self.flow.clone();
+            let task = tokio::spawn(async move {
+                // Producer custody exists only for this bounded pending write.
+                // The real guard leaves the slot only when actual IO claims it.
+                let _custody = AnswerCancellation(permit.clone());
+                let cancelled = origin.cancellation();
+                // Writer completion wins a simultaneous retirement. Dropping
+                // its consumed PendingAnswer also cancels the spent permit.
+                let outcome = tokio::select! {biased;r=receipt=>r.unwrap_or(Err(DispatchError::Closed)).map(|_|()),_=cancelled.cancelled()=>Err(DispatchError::Closed),_=permit.cancel.cancelled()=>Err(DispatchError::Closed),_=tokio::time::sleep_until(permit.deadline)=>Err(permit.uncertainty())};
+                *result.lock().unwrap_or_else(|p| p.into_inner()) = Some(outcome);
+                changed_flow.changed.notify_waiters();
+            });
+            state.pending = Some(Pending {
+                event,
+                result: pending_result,
+                task,
+                permit: pending_permit,
+            });
+            return Ok(delivery);
+        }
+    }
+}
+fn choose(
+    state: &Announcements,
+    active: &[ReadyMediaBinding],
+    revision: u64,
+    flow: &NativeFlow,
+) -> Option<NativeLifecycleEvent> {
+    if !state.ready {
+        return (!active.is_empty()
+            && flow.confirmed_at(revision)
+            && active.iter().all(|b| flow.flowing(b)))
+        .then(|| NativeLifecycleEvent::ConnectionReady {
+            streams: active.to_vec(),
+        });
+    }
+    for old in state.opened.values() {
+        if !active
+            .iter()
+            .any(|a| crate::staged_media::same_binding(a, old))
+        {
+            return Some(NativeLifecycleEvent::StreamClosed {
+                stream: old.clone(),
+                replaced: active.iter().any(|a| {
+                    a.negotiated.requested.logical_id == old.negotiated.requested.logical_id
+                }),
+            });
+        }
+    }
+    for binding in active {
+        if !state
+            .opened
+            .contains_key(&binding.negotiated.requested.logical_id)
+            && flow.confirmed_at(revision)
+            && flow.flowing(binding)
+        {
+            return Some(NativeLifecycleEvent::StreamOpened {
+                stream: binding.clone(),
+            });
+        }
+    }
+    None
+}
+fn apply(state: &mut Announcements, event: NativeLifecycleEvent) {
+    match event {
+        NativeLifecycleEvent::ConnectionReady { .. } => state.ready = true,
+        NativeLifecycleEvent::StreamOpened { stream } => {
+            state
+                .opened
+                .insert(stream.negotiated.requested.logical_id.clone(), stream);
+        }
+        NativeLifecycleEvent::StreamClosed { stream, .. } => {
+            state.opened.remove(&stream.negotiated.requested.logical_id);
+        }
+    }
+}
+fn binding(b: &ReadyMediaBinding) -> Value {
+    use super::native_negotiation::catalog::{codec_wire, direction, kind, payload_type};
+    json!({"strm_id":b.negotiated.requested.logical_id.as_str(),"kind":kind(b.negotiated.requested.medium),"codec":codec_wire(&b.negotiated.format,payload_type(&b.negotiated.format)),"direction":direction(b.negotiated.requested.direction),"stream_local_id":b.stream_local_id})
+}
+fn frame(scope: &StagedRtpScope, event: &NativeLifecycleEvent) -> Result<Envelope, DispatchError> {
+    let (name, payload) = match event {
+        NativeLifecycleEvent::ConnectionReady { streams } => (
+            "connection.ready",
+            json!({"streams":streams.iter().map(binding).collect::<Vec<_>>()}),
+        ),
+        NativeLifecycleEvent::StreamOpened { stream } => {
+            let mut b = binding(stream);
+            b["opened_at"] = json!(chrono::Utc::now());
+            ("stream.opened", json!({"stream":b}))
+        }
+        NativeLifecycleEvent::StreamClosed { stream, replaced } => (
+            "stream.closed",
+            json!({"strm_id":stream.negotiated.requested.logical_id.as_str(),"closed_at":chrono::Utc::now(),"reason_code":200,"reason":if *replaced{"codec-renegotiated"}else{"native-stream-ended"}}),
+        ),
+    };
+    Envelope::from_value(json!({"v":2,"type":name,"id":format!("native_event_{}",uuid::Uuid::new_v4().simple()),"ts":chrono::Utc::now(),"cid":scope.wire_conversation,"sid":scope.wire_session,"connid":scope.wire_connection,"payload":payload})).map_err(DispatchError::from)
+}
