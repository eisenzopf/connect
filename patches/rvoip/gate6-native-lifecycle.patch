@@ -0,0 +1,155 @@
+//! Native IO observations, never a permission grant or a peer ready assertion.
+use rvoip_core::{ids::StreamId, staged_streams::*, stream_lifecycle::*};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex},
+};
+use tokio::sync::Notify;
+use tokio_util::sync::CancellationToken;
+struct Observed {
+    port: WeakAdapterMediaPort,
+    binding: ReadyMediaBinding,
+    received: bool,
+    sent: bool,
+}
+struct State {
+    ports: BTreeMap<StreamId, Observed>,
+    epoch: CancellationToken,
+    confirmed_revision: Option<u64>,
+    confirmed_offer: Option<String>,
+}
+pub(crate) struct NativeFlow {
+    state: Mutex<State>,
+    lifetime: CancellationToken,
+    pub(crate) changed: Notify,
+}
+impl NativeFlow {
+    pub(crate) fn new(lifetime: CancellationToken) -> Arc<Self> {
+        Arc::new(Self {
+            state: Mutex::new(State {
+                ports: BTreeMap::new(),
+                epoch: lifetime.child_token(),
+                confirmed_revision: None,
+                confirmed_offer: None,
+            }),
+            lifetime,
+            changed: Notify::new(),
+        })
+    }
+    pub(crate) fn current(&self) -> bool {
+        !self.lifetime.is_cancelled()
+    }
+    pub(crate) fn epoch(&self) -> CancellationToken {
+        self.state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .epoch
+            .child_token()
+    }
+    pub(crate) fn preparing(&self, ports: &[PortPreparation]) -> ControlResult<()> {
+        let mut s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        // A candidate invalidates queued observations conservatively. Real IO
+        // already in progress retains its actual grant through sink abortion.
+        s.epoch.cancel();
+        s.epoch = self.lifetime.child_token();
+        for p in ports {
+            let b = p.port.binding();
+            if let Some(old) = s.ports.get(&b.transport_id) {
+                if !crate::staged_media::same_binding(&old.binding, b) {
+                    return Err(StreamControlError::Authority);
+                }
+            } else {
+                // Core's cumulative opening limit is smaller than this bound.
+                if s.ports.len() >= 64 {
+                    return Err(StreamControlError::Backpressure);
+                }
+                s.ports.insert(
+                    b.transport_id.clone(),
+                    Observed {
+                        port: p.port.downgrade(),
+                        binding: b.clone(),
+                        received: false,
+                        sent: false,
+                    },
+                );
+            }
+        }
+        drop(s);
+        self.changed.notify_waiters();
+        Ok(())
+    }
+    pub(crate) fn confirmed(&self, revision: u64, offer: &str) {
+        let mut s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        s.epoch.cancel();
+        s.epoch = self.lifetime.child_token();
+        s.confirmed_revision = Some(revision);
+        s.confirmed_offer = Some(offer.to_owned());
+        drop(s);
+        self.changed.notify_waiters();
+    }
+    pub(crate) fn confirmed_at(&self, revision: u64) -> bool {
+        self.current()
+            && self
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .confirmed_revision
+                == Some(revision)
+    }
+    pub(crate) fn confirmed_for(&self, revision: u64, offer: &str) -> bool {
+        let s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        self.current()
+            && s.confirmed_revision == Some(revision)
+            && s.confirmed_offer.as_deref() == Some(offer)
+    }
+    pub(crate) fn received(&self, port: &AdapterMediaPort) {
+        self.record(port, true);
+    }
+    pub(crate) fn sent(&self, port: &AdapterMediaPort) {
+        self.record(port, false);
+    }
+    fn record(&self, port: &AdapterMediaPort, received: bool) {
+        if !self.current() || port.status() != PortStatus::Active {
+            return;
+        }
+        let mut s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let Some(p) = s.ports.get_mut(&port.binding().transport_id) else {
+            return;
+        };
+        if !crate::staged_media::same_binding(&p.binding, port.binding()) {
+            return;
+        }
+        let value = if received {
+            &mut p.received
+        } else {
+            &mut p.sent
+        };
+        let changed = !*value;
+        *value = true;
+        drop(s);
+        if changed {
+            self.changed.notify_waiters();
+        }
+    }
+    pub(crate) fn flowing(&self, b: &ReadyMediaBinding) -> bool {
+        if !self.current() {
+            return false;
+        }
+        let s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        s.ports.get(&b.transport_id).is_some_and(|p| {
+            crate::staged_media::same_binding(&p.binding, b)
+                && p.port
+                    .upgrade()
+                    .is_some_and(|port| port.status() == PortStatus::Active)
+                && (b.negotiated.requested.direction == StreamDirection::Send || p.received)
+                && (b.negotiated.requested.direction == StreamDirection::Receive || p.sent)
+        })
+    }
+    pub(crate) fn terminal(&self) {
+        let mut s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        s.epoch.cancel();
+        s.epoch = self.lifetime.child_token();
+        drop(s);
+        self.changed.notify_waiters();
+    }
+}
