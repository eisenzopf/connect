diff --git a/crates/uctp/rvoip-uctp/src/v2/auth_dispatch/lifecycle.rs b/crates/uctp/rvoip-uctp/src/v2/auth_dispatch/lifecycle.rs
new file mode 100644
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/src/v2/auth_dispatch/lifecycle.rs
@@ -0,0 +1,106 @@
+//! A native lifecycle origin carries metadata, never an idle current grant.
+use super::data::DataOrigin;
+use super::*;
+use crate::staged_media::StagedRtpScope;
+use crate::v2::Identifier;
+use rvoip_core::{
+    relationships::{EndpointBinding, Membership},
+    staged_streams::StreamController,
+};
+pub(crate) trait NativeLifecycleFence: Send + Sync {
+    fn current(&self) -> bool;
+    fn cancellation(&self) -> CancellationToken;
+}
+#[derive(Clone)]
+pub(in crate::v2) struct NativeLifecycleOrigin {
+    route: DataOrigin,
+    fence: Arc<dyn NativeLifecycleFence>,
+}
+impl NativeLifecycleOrigin {
+    pub(crate) fn seal(
+        a: &AuthorizedEnvelope,
+        controller: &Arc<StreamController>,
+        scope: StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        fence: Arc<dyn NativeLifecycleFence>,
+    ) -> Result<Self, DispatchError> {
+        Ok(Self {
+            route: DataOrigin::seal(a, controller, scope, member, endpoint)?,
+            fence,
+        })
+    }
+    pub(crate) fn with_fence(&self, fence: Arc<dyn NativeLifecycleFence>) -> Self {
+        Self {
+            route: self.route.clone(),
+            fence,
+        }
+    }
+    pub(crate) fn ready(&self) -> bool {
+        self.route.is_ready()
+    }
+    pub(crate) fn current(&self) -> bool {
+        self.route.current() && self.fence.current()
+    }
+    pub(crate) fn incarnation(&self) -> uuid::Uuid {
+        self.route.incarnation()
+    }
+    pub(crate) fn cancellation(&self) -> CancellationToken {
+        self.route.cancellation()
+    }
+    pub(crate) fn event_cancellation(&self) -> CancellationToken {
+        self.fence.cancellation()
+    }
+    pub(crate) fn retire(&self) {
+        self.route.retire();
+    }
+}
+pub(in crate::v2) struct NativePending {
+    pub answer: PendingAnswer,
+    pub origin: NativeLifecycleOrigin,
+}
+impl HandlerDelivery {
+    pub(in crate::v2) fn native_lifecycle(
+        origin: NativeLifecycleOrigin,
+        frame: Envelope,
+        permit: Arc<AnswerPermit>,
+        completion: oneshot::Sender<Result<Identifier, DispatchError>>,
+        deadline: Instant,
+    ) -> Result<Self, DispatchError> {
+        if !origin.ready()
+            || !origin.current()
+            || !permit.current()
+            || !matches!(
+                frame.kind(),
+                "connection.ready" | "stream.opened" | "stream.closed"
+            )
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(Self {
+            origin: DeliveryOrigin::NativeLifecycle(origin.clone()),
+            frames: Some(HandlerReplies::new(vec![frame])?),
+            authority: None,
+            completion: None,
+            data: None,
+            native: Some(NativePending {
+                answer: PendingAnswer {
+                    cancel_on_drop: true,
+                    permit,
+                    completion: Some(completion),
+                },
+                origin,
+            }),
+            deadline,
+        })
+    }
+}
+
+impl NativeLifecycleFence for NativeLifecycleOrigin {
+    fn current(&self) -> bool {
+        NativeLifecycleOrigin::current(self)
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.event_cancellation()
+    }
+}
