+struct SubscriptionBusyPolicy {
+    expected: serde_json::Value,
+    grants: Arc<tokio::sync::RwLock<bool>>,
+    busy: CancellationToken,
+    calls: std::sync::atomic::AtomicUsize,
+    permanent: AtomicBool,
+    deadline: Instant,
+}
+#[async_trait::async_trait]
+impl CurrentAuthority for SubscriptionBusyPolicy {
+    async fn acquire(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        original: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        if principal.subject != "alice" || original.original() != &self.expected {
+            return Err(DispatchError::Authority);
+        }
+        if self.permanent.load(Ordering::Acquire) {
+            return Err(DispatchError::AuthorityUnavailable);
+        }
+        let guard = match self.grants.clone().try_read_owned() {
+            Ok(guard) => guard,
+            Err(_) => {
+                self.busy.cancel();
+                return Err(DispatchError::AuthorityBusy);
+            }
+        };
+        if *guard {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::checking(guard, self.deadline, || true))
+    }
+}
+fn busy_subscription() -> (
+    AuthorizedEnvelope,
+    Arc<SubscriptionBusyPolicy>,
+    Arc<crate::v2::replay::ReplayFence>,
+) {
+    let mut a = authorized();
+    let policy = Arc::new(SubscriptionBusyPolicy {
+        expected: a.envelope.original().clone(),
+        grants: Arc::new(tokio::sync::RwLock::new(false)),
+        busy: CancellationToken::new(),
+        calls: std::sync::atomic::AtomicUsize::new(0),
+        permanent: AtomicBool::new(false),
+        deadline: a.origin.deadline,
+    });
+    let (context, replay) = crate::v2::auth_peer::exchange::resource_test_context(
+        policy.clone(),
+        a.principal.clone(),
+        a.origin.lifetime.clone(),
+        a.origin.deadline,
+    );
+    replay.consume(a.envelope.id()).unwrap();
+    a.exchange = Some(context);
+    (a, policy, replay)
+}
+#[tokio::test]
+async fn same_prepared_subscription_retries_real_temporary_exclusion_without_new_command_or_cutoff()
+{
+    let (a, policy, replay) = busy_subscription();
+    let original = a.envelope.original().clone();
+    let deadline = a._lease.deadline().unwrap();
+    let marker = a
+        ._lease
+        .authority::<ResourcePreparation>()
+        .unwrap()
+        .marker
+        .clone();
+    let held = policy.grants.clone().write_owned().await;
+    let stop = CancellationToken::new();
+    let physical = CancellationToken::new();
+    let requested = deadline - Duration::from_millis(1);
+    let waiting = a.reauthorize_subscription_resource_preparation(&stop, &physical, requested);
+    let release = async {
+        policy.busy.cancelled().await;
+        drop(held);
+    };
+    let (current, ()) = tokio::join!(waiting, release);
+    let current = current.unwrap();
+    assert!(a.resource_activation_current(&current));
+    assert!(current.deadline <= requested);
+    assert!(
+        current
+            .authority::<tokio::sync::OwnedRwLockReadGuard<bool>>()
+            .is_some()
+    );
+    assert_eq!(a.envelope.original(), &original);
+    assert_eq!(a._lease.deadline(), Some(deadline));
+    assert!(Arc::ptr_eq(&marker, &current.marker));
+    assert_eq!(replay.usage().0, 1);
+    assert_eq!(policy.calls.load(Ordering::Acquire), 2);
+    // Only the genuine fresh admission may restore result rights; waiting did not.
+    a.install_resource_reply_authority(&current).unwrap();
+    assert!(a.reply_authority.for_replies(&[result(&a)]).is_ok());
+}
+#[tokio::test]
+async fn prepared_subscription_busy_then_actual_revocation_refuses_same_original() {
+    let (a, policy, replay) = busy_subscription();
+    let deadline = a._lease.deadline().unwrap();
+    let mut held = policy.grants.clone().write_owned().await;
+    let stop = CancellationToken::new();
+    let physical = CancellationToken::new();
+    let waiting = a.reauthorize_subscription_resource_preparation(&stop, &physical, deadline);
+    let revoke = async {
+        policy.busy.cancelled().await;
+        *held = true;
+        drop(held);
+    };
+    let (observed, ()) = tokio::join!(waiting, revoke);
+    assert!(matches!(observed, Err(DispatchError::Authority)));
+    assert_eq!(policy.calls.load(Ordering::Acquire), 2);
+    assert_eq!(replay.usage().0, 1);
+    assert!(a.reply_authority.for_replies(&[result(&a)]).is_err());
+}
+#[tokio::test]
+async fn prepared_subscription_permanent_authority_file_failure_is_not_retried() {
+    let (a, policy, replay) = busy_subscription();
+    policy.permanent.store(true, Ordering::Release);
+    let observed = a
+        .reauthorize_subscription_resource_preparation(
+            &CancellationToken::new(),
+            &CancellationToken::new(),
+            a.origin.deadline,
+        )
+        .await;
+    assert!(matches!(observed, Err(DispatchError::AuthorityUnavailable)));
+    assert_eq!(policy.calls.load(Ordering::Acquire), 1);
+    assert_eq!(replay.usage().0, 1);
+}
+#[tokio::test]
+async fn prepared_subscription_original_cutoff_and_all_original_cancellations_stop_busy_wait() {
+    for mode in ["cutoff", "physical", "stop", "invocation", "origin"] {
+        let (mut a, policy, replay) = busy_subscription();
+        let stop = CancellationToken::new();
+        let physical = CancellationToken::new();
+        let deadline = Instant::now() + Duration::from_millis(35);
+        if mode == "cutoff" {
+            a._lease.deadline = Some(deadline);
+            let resource = a
+                ._lease
+                ._guard
+                .downcast_ref::<ResourcePreparation>()
+                .unwrap();
+            assert!(resource.deadline >= deadline);
+        }
+        let held = policy.grants.clone().write_owned().await;
+        let waiting = a.reauthorize_subscription_resource_preparation(
+            &stop,
+            &physical,
+            if mode == "cutoff" {
+                deadline + Duration::from_secs(30)
+            } else {
+                a.origin.deadline
+            },
+        );
+        let cancel = async {
+            policy.busy.cancelled().await;
+            match mode {
+                "physical" => physical.cancel(),
+                "stop" => stop.cancel(),
+                "invocation" => a.invocation.cancel(),
+                "origin" => a.origin.lifetime.cancel(),
+                _ => (),
+            }
+        };
+        let (observed, ()) = tokio::join!(waiting, cancel);
+        drop(held);
+        assert!(matches!(observed, Err(DispatchError::Closed)), "{mode}");
+        assert_eq!(replay.usage().0, 1);
+        assert!(a.reply_authority.for_replies(&[result(&a)]).is_err());
+        if mode == "cutoff" {
+            assert_eq!(a._lease.deadline(), Some(deadline));
+        }
+    }
+}
+#[tokio::test]
+async fn prepared_subscription_retry_rejects_non_subscription_preparation_marker() {
+    let (a, policy, replay) = allocation_with_policy().await;
+    let (a, deadline) = a
+        .into_replacement_allocation_wait(Instant::now() + Duration::from_secs(1))
+        .unwrap();
+    assert!(matches!(
+        a.reauthorize_subscription_resource_preparation(
+            &CancellationToken::new(),
+            &CancellationToken::new(),
+            deadline
+        )
+        .await,
+        Err(DispatchError::Authority)
+    ));
+    assert_eq!(policy.calls.load(Ordering::Acquire), 0);
+    assert_eq!(replay.usage().0, 1);
+}
