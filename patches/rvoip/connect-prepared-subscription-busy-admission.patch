+    /// Retain this SAME prepared subscription while definite temporary policy
+    /// admission exclusion clears. This never prepares resources, publishes a
+    /// route, activates IO or consumes another signature. Every attempt obtains
+    /// fresh authority and is bounded by the ONE original resource cutoff.
+    /// Permanent refusal/unavailable errors return immediately; uncertain
+    /// activation must never be passed to this admission-only method.
+    pub async fn reauthorize_subscription_resource_preparation(
+        &self,
+        stop: &CancellationToken,
+        physical: &CancellationToken,
+        requested: Instant,
+    ) -> Result<Arc<ResourceActivationAuthority>, DispatchError> {
+        self.reauthorize_subscription_resource_preparation_observing(
+            stop,
+            physical,
+            requested,
+            || {},
+        )
+        .await
+    }
+    /// Same admission-only operation; the synchronous callback observes only
+    /// a definite busy return AFTER that policy attempt and its guards ended.
+    /// It supplies no authority, resource, payload or permission to replay IO.
+    pub async fn reauthorize_subscription_resource_preparation_observing(
+        &self,
+        stop: &CancellationToken,
+        physical: &CancellationToken,
+        requested: Instant,
+        mut busy: impl FnMut(),
+    ) -> Result<Arc<ResourceActivationAuthority>, DispatchError> {
+        let resource = self
+            ._lease
+            .authority::<ResourcePreparation>()
+            .filter(|r| r.kind == PreparationKind::Subscription)
+            .ok_or(DispatchError::Authority)?;
+        let deadline = self
+            .resource_preparation_cutoff(requested)
+            .min(resource.deadline);
+        let original = self.invocation.child_token();
+        loop {
+            if stop.is_cancelled()
+                || physical.is_cancelled()
+                || original.is_cancelled()
+                || self.origin.lifetime.is_cancelled()
+                || Instant::now() >= deadline
+            {
+                return Err(DispatchError::Closed);
+            }
+            // Join the ACTUAL policy future, including its Store admission.
+            // Cancellation cannot detach an acquired domain guard. Its result
+            // cannot activate or disclose anything after the original cutoff.
+            match self.reauthorize_resource_preparation().await {
+                Ok(mut current) => {
+                    if stop.is_cancelled()
+                        || physical.is_cancelled()
+                        || original.is_cancelled()
+                        || self.origin.lifetime.is_cancelled()
+                        || Instant::now() >= deadline
+                        || !self.resource_activation_current(&current)
+                    {
+                        return Err(DispatchError::Closed);
+                    }
+                    // This freshly constructed sealed token has no published
+                    // alias yet. Narrow its temporal bound to this caller too.
+                    let owned = Arc::get_mut(&mut current).ok_or(DispatchError::Authority)?;
+                    owned.deadline = owned.deadline.min(deadline);
+                    return Ok(current);
+                }
+                Err(DispatchError::AuthorityBusy) => {
+                    busy();
+                }
+                Err(error) => return Err(error),
+            }
+            // The failed admission returned no grant. Only this same original
+            // resource/cancellation metadata remains during the bounded pause.
+            tokio::select! { biased;
+                _ = stop.cancelled() => return Err(DispatchError::Closed),
+                _ = physical.cancelled() => return Err(DispatchError::Closed),
+                _ = original.cancelled() => return Err(DispatchError::Closed),
+                _ = self.origin.lifetime.cancelled() => return Err(DispatchError::Closed),
+                _ = tokio::time::sleep_until(deadline.min(Instant::now()+Duration::from_millis(20))) => {},
+            }
+        }
