@@ -0,0 +1,265 @@
+//! Bounded original-packet metadata. Native interceptors must not cache outgoing
+//! video on this opt-in profile. Only a fresh producer callback can disclose a
+//! repair packet to the actual guarded socket writer.
+use super::*;
+use crate::media_stream::track_local::owned_rtp::*;
+
+const MAX_PACKETS: usize = 512;
+const MAX_BYTES: usize = MAX_PACKETS * 1600;
+const MAX_REQUESTS: usize = 64;
+const MAX_ATTEMPTS: u8 = 4;
+
+pub(super) struct RepairEntry {
+    sender: RTCRtpSenderId,
+    fact: rtp::Packet,
+    track: String,
+    producer: Arc<dyn OwnedRtpProducer>,
+    expires: Instant,
+    attempts: u8,
+}
+impl RepairEntry {
+    pub(super) fn new(
+        sender: RTCRtpSenderId,
+        fact: rtp::Packet,
+        track: String,
+        producer: Arc<dyn OwnedRtpProducer>,
+        expires: Instant,
+    ) -> Self {
+        Self {
+            sender,
+            fact,
+            track,
+            producer,
+            expires,
+            attempts: 0,
+        }
+    }
+    fn size(&self) -> usize {
+        rtc::shared::marshal::MarshalSize::marshal_size(&self.fact)
+    }
+}
+#[derive(Default)]
+pub(super) struct RepairCache {
+    entries: VecDeque<RepairEntry>,
+    bytes: usize,
+}
+impl RepairCache {
+    pub(super) fn expire(&mut self, now: Instant) {
+        self.entries
+            .retain(|e| e.expires > now && e.attempts < MAX_ATTEMPTS);
+        self.bytes = self.entries.iter().map(RepairEntry::size).sum();
+    }
+    pub(super) fn next_expiry(&self) -> Option<Instant> {
+        self.entries.iter().map(|e| e.expires).min()
+    }
+    pub(super) fn insert(&mut self, entry: RepairEntry) {
+        self.expire(Instant::now());
+        let size = entry.size();
+        if size > 1600
+            || entry.track.len() > 256
+            || entry.expires <= Instant::now()
+            || entry.attempts >= MAX_ATTEMPTS
+        {
+            return;
+        }
+        self.entries.retain(|e| {
+            !(e.sender == entry.sender
+                && e.fact.header.ssrc == entry.fact.header.ssrc
+                && e.fact.header.sequence_number == entry.fact.header.sequence_number)
+        });
+        self.bytes = self.entries.iter().map(RepairEntry::size).sum();
+        while self.entries.len() >= MAX_PACKETS || self.bytes + size > MAX_BYTES {
+            if let Some(old) = self.entries.pop_front() {
+                self.bytes -= old.size();
+            } else {
+                break;
+            }
+        }
+        self.bytes += size;
+        self.entries.push_back(entry);
+    }
+    fn take(&mut self, ssrc: u32, sequence: u16) -> Option<RepairEntry> {
+        self.expire(Instant::now());
+        // A NACK carries no track ID. Never guess between colliding senders.
+        let mut indices = self
+            .entries
+            .iter()
+            .enumerate()
+            .filter(|(_, e)| {
+                e.fact.header.ssrc == ssrc && e.fact.header.sequence_number == sequence
+            })
+            .map(|(i, _)| i);
+        let index = indices.next()?;
+        if indices.next().is_some() {
+            return None;
+        }
+        let mut entry = self.entries.remove(index)?;
+        self.bytes -= entry.size();
+        entry.attempts += 1;
+        Some(entry)
+    }
+}
+pub(super) fn same_primary(a: &rtp::Packet, b: &rtp::Packet) -> bool {
+    a.header.version == 2 && a.header == b.header && a.payload == b.payload
+}
+struct RepairProducer(Arc<dyn OwnedRtpProducer>);
+#[async_trait::async_trait]
+impl OwnedRtpProducer for RepairProducer {
+    async fn write(&self, io: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+        self.0.repair(io).await
+    }
+}
+impl<I: Interceptor + 'static> PeerConnectionDriver<I> {
+    pub(super) async fn handle_owned_video_nack(
+        &mut self,
+        nack: &rtcp::transport_feedbacks::transport_layer_nack::TransportLayerNack,
+    ) -> bool {
+        if !self.inner.core.lock().await.supports_owned_video_io() {
+            return false;
+        }
+        let mut requested = std::collections::BTreeSet::new();
+        'pairs: for pair in nack.nacks.iter().take(32) {
+            for bit in 0..=16 {
+                if bit == 0 || pair.lost_packets & (1 << (bit - 1)) != 0 {
+                    requested.insert(pair.packet_id.wrapping_add(bit));
+                    if requested.len() == MAX_REQUESTS {
+                        break 'pairs;
+                    }
+                }
+            }
+        }
+        for sequence in requested {
+            let Some(entry) = self.video_repairs.take(nack.media_ssrc, sequence) else {
+                continue;
+            };
+            let control = OwnedRtpControl::new(entry.expires);
+            if !control.claim() {
+                continue;
+            }
+            {
+                let mut io = RtpIo {
+                    driver: self,
+                    sender: entry.sender,
+                    control: &control,
+                    attempted: false,
+                    written: false,
+                    expected: Some((entry.fact.clone(), entry.track.clone())),
+                    written_video: None,
+                };
+                // The callback must acquire fresh permission. The cache only
+                // checks its supplied packet; it never sends stored bytes.
+                let _ = complete(&RepairProducer(entry.producer.clone()), &mut io, &control).await;
+            }
+            self.video_repairs.insert(entry);
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    struct NoBytes;
+    #[async_trait::async_trait]
+    impl OwnedRtpProducer for NoBytes {
+        async fn write(&self, _: &mut dyn OwnedRtpIo) -> OwnedRtpResult {
+            Err(OwnedRtpError::Refused)
+        }
+    }
+    fn entry(sender: usize, sequence: u16) -> RepairEntry {
+        RepairEntry::new(
+            sender.into(),
+            rtp::Packet {
+                header: rtp::Header {
+                    version: 2,
+                    ssrc: 123,
+                    sequence_number: sequence,
+                    ..Default::default()
+                },
+                payload: vec![7; 100].into(),
+            },
+            "track".into(),
+            Arc::new(NoBytes),
+            Instant::now() + std::time::Duration::from_secs(5),
+        )
+    }
+    #[test]
+    fn packet_byte_bounds_evict_oldest_and_replace_without_accounting_leaks() {
+        let mut cache = RepairCache::default();
+        for sequence in 0..600 {
+            cache.insert(entry(0, sequence));
+        }
+        assert_eq!(cache.entries.len(), MAX_PACKETS);
+        assert!(cache.bytes <= MAX_BYTES);
+        assert!(cache.take(123, 0).is_none());
+        assert!(cache.take(123, 599).is_some());
+        for _ in 0..100 {
+            cache.insert(entry(0, 598));
+        }
+        assert_eq!(
+            cache
+                .entries
+                .iter()
+                .filter(|e| e.fact.header.sequence_number == 598)
+                .count(),
+            1
+        );
+        assert_eq!(
+            cache.bytes,
+            cache.entries.iter().map(RepairEntry::size).sum()
+        );
+        let mut over = entry(0, 600);
+        over.fact.payload = vec![1; 1600].into();
+        cache.insert(over);
+        assert!(cache.take(123, 600).is_none());
+    }
+    #[test]
+    fn ambiguous_sender_collision_never_guesses_and_expiry_releases_producers() {
+        let mut cache = RepairCache::default();
+        let mut a = entry(0, 1);
+        let deadline = a.expires;
+        let weak = Arc::downgrade(&a.producer);
+        a.track = "first".into();
+        cache.insert(a);
+        cache.insert(entry(1, 1));
+        assert!(cache.take(123, 1).is_none());
+        assert_eq!(cache.entries.len(), 2);
+        cache.expire(deadline + std::time::Duration::from_secs(1));
+        assert!(cache.entries.is_empty());
+        assert_eq!(cache.bytes, 0);
+        assert!(weak.upgrade().is_none());
+    }
+    #[test]
+    fn four_refused_attempts_do_not_renew_original_expiry() {
+        let mut cache = RepairCache::default();
+        let original = entry(0, 1);
+        let deadline = original.expires;
+        cache.insert(original);
+        for attempt in 1..=4 {
+            let e = cache.take(123, 1).unwrap();
+            assert_eq!(e.attempts, attempt);
+            assert_eq!(e.expires, deadline);
+            cache.insert(e);
+        }
+        assert!(cache.take(123, 1).is_none());
+        assert!(cache.entries.is_empty());
+        assert_eq!(cache.bytes, 0);
+    }
+    #[test]
+    fn retained_fact_checks_header_extensions_marker_ssrc_and_payload() {
+        let a = entry(0, 1).fact;
+        assert!(same_primary(&a, &a));
+        let mut b = a.clone();
+        b.header.marker = true;
+        assert!(!same_primary(&a, &b));
+        b = a.clone();
+        b.header.ssrc += 1;
+        assert!(!same_primary(&a, &b));
+        b = a.clone();
+        b.payload = vec![8; 100].into();
+        assert!(!same_primary(&a, &b));
+        b = a.clone();
+        b.header.set_extension(1, vec![1, 2].into()).unwrap();
+        assert!(!same_primary(&a, &b));
+    }
+}
