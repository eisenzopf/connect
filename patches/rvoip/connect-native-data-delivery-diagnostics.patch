diff --git a/crates/uctp/rvoip-uctp/src/staged_data/diagnostics.rs b/crates/uctp/rvoip-uctp/src/staged_data/diagnostics.rs
new file mode 100644
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/src/staged_data/diagnostics.rs
@@ -0,0 +1,255 @@
+//! Bounded observations of results the original delivery attempt already made.
+//! These rows are neither authority nor evidence of a durable observer receipt.
+use super::{DataDisposition, DispatchError, NativeDataOutcome, StreamControlError};
+use rvoip_core::stream_lifecycle::MediaTransitionError;
+use std::time::Instant;
+
+const MAX_REFUSAL_ROWS: u8 = 4;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Refusal {
+    stage: &'static str,
+    class: &'static str,
+}
+
+pub(super) struct DataDiagnostics {
+    started: Instant,
+    attempts: u64,
+    last: Option<Refusal>,
+    emitted: u8,
+    suppressed: u64,
+    terminal: bool,
+}
+impl DataDiagnostics {
+    pub(super) fn new() -> Self {
+        Self {
+            started: Instant::now(),
+            attempts: 0,
+            last: None,
+            emitted: 0,
+            suppressed: 0,
+            terminal: false,
+        }
+    }
+    pub(super) fn attempt(&mut self) {
+        self.attempts = self.attempts.saturating_add(1);
+    }
+    fn note(&mut self, refusal: Refusal) -> bool {
+        if self.last == Some(refusal) {
+            return false;
+        }
+        self.last = Some(refusal);
+        if self.emitted == MAX_REFUSAL_ROWS {
+            self.suppressed = self.suppressed.saturating_add(1);
+            return false;
+        }
+        self.emitted += 1;
+        true
+    }
+    pub(super) fn refuse(
+        &mut self,
+        outcome: &NativeDataOutcome,
+        stage: &'static str,
+        class: &'static str,
+    ) {
+        if !self.note(Refusal { stage, class }) {
+            return;
+        }
+        tracing::warn!(
+            target: "rvoip_uctp::staged_data",
+            operation_id = %outcome.operation_id,
+            message_id = %outcome.message_id,
+            source = %outcome.source,
+            target = %outcome.target,
+            stage, class,
+            attempts = self.attempts,
+            elapsed_us = self.started.elapsed().as_micros().min(u64::MAX as u128) as u64,
+            "Original Data delivery refused before its terminal outcome"
+        );
+    }
+    pub(super) fn refuse_control(
+        &mut self,
+        outcome: &NativeDataOutcome,
+        stage: &'static str,
+        error: &StreamControlError,
+    ) {
+        // Only fixed error classes; never format model or application contents.
+        let class = match error {
+            StreamControlError::Model(model) => match model {
+                MediaTransitionError::Invalid => "model-invalid",
+                MediaTransitionError::Conflict => "model-conflict",
+                MediaTransitionError::Unsupported => "model-unsupported",
+                MediaTransitionError::Capacity => "model-capacity",
+                MediaTransitionError::Authority => "model-authority",
+                MediaTransitionError::NotReady => "model-not-ready",
+                MediaTransitionError::Expired => "model-expired",
+            },
+            StreamControlError::Unsupported => "unsupported",
+            StreamControlError::Authority => "authority",
+            StreamControlError::NotRecipient => "not-recipient",
+            StreamControlError::Cancelled => "cancelled",
+            StreamControlError::Deadline => "deadline",
+            StreamControlError::NotReady => "not-ready",
+            StreamControlError::MetadataBusy => "metadata-busy",
+            StreamControlError::Backpressure => "backpressure",
+            StreamControlError::CleanupUnconfirmed => "cleanup-unconfirmed",
+        };
+        self.refuse(outcome, stage, class);
+    }
+    pub(super) fn refuse_dispatch(
+        &mut self,
+        outcome: &NativeDataOutcome,
+        stage: &'static str,
+        error: &DispatchError,
+    ) {
+        // DispatchError Display is explicitly bounded and omits envelope data.
+        // Use its stable variant name here rather than any nested wire details.
+        let class = match error {
+            DispatchError::Wire(_) => "wire",
+            DispatchError::UnsupportedMethod => "unsupported-method",
+            DispatchError::Authentication => "authentication",
+            DispatchError::Authority => "authority",
+            DispatchError::AuthorityUnavailable => "authority-unavailable",
+            DispatchError::StorageUnavailable => "storage-unavailable",
+            DispatchError::ScopeDenied => "scope-denied",
+            DispatchError::Signature => "signature",
+            DispatchError::SignatureRequired => "signature-required",
+            DispatchError::StaleSignature => "stale-signature",
+            DispatchError::ReplayCapacity => "replay-capacity",
+            DispatchError::Replay => "replay",
+            DispatchError::ReplayUnavailable => "replay-unavailable",
+            DispatchError::ReplyMismatch => "reply-mismatch",
+            DispatchError::Unsupported => "unsupported",
+            DispatchError::Capacity => "capacity",
+            DispatchError::SubmissionUnknown => "submission-unknown",
+            DispatchError::Closed => "closed",
+        };
+        self.refuse(outcome, stage, class);
+    }
+    pub(super) fn terminal(&mut self, outcome: &NativeDataOutcome, observer: &'static str) {
+        if self.terminal {
+            return;
+        }
+        self.terminal = true;
+        let disposition = match outcome.disposition {
+            DataDisposition::NotStarted => "not-started",
+            DataDisposition::LocalWritten => "local-written",
+            DataDisposition::SubmissionUnknown => "submission-unknown",
+        };
+        tracing::info!(
+            target: "rvoip_uctp::staged_data",
+            operation_id = %outcome.operation_id,
+            message_id = %outcome.message_id,
+            source = %outcome.source,
+            target = %outcome.target,
+            disposition, observer,
+            last_stage = self.last.map(|r| r.stage),
+            last_class = self.last.map(|r| r.class),
+            attempts = self.attempts,
+            refusal_rows = self.emitted,
+            suppressed_changes = self.suppressed,
+            elapsed_us = self.started.elapsed().as_micros().min(u64::MAX as u128) as u64,
+            "Original Data local delivery outcome"
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use rvoip_core::ids::{ConnectionId, MessageId};
+
+    fn outcome(disposition: DataDisposition) -> NativeDataOutcome {
+        NativeDataOutcome {
+            operation_id: "diagnostic-operation".into(),
+            message_id: MessageId::from_string("diagnostic-message"),
+            source: ConnectionId::from_string("diagnostic-source"),
+            target: ConnectionId::from_string("diagnostic-target"),
+            disposition,
+        }
+    }
+
+    #[test]
+    fn repeated_refusal_and_class_changes_have_a_fixed_bound() {
+        for (model, class) in [
+            (MediaTransitionError::Invalid, "model-invalid"),
+            (MediaTransitionError::Conflict, "model-conflict"),
+            (MediaTransitionError::Unsupported, "model-unsupported"),
+            (MediaTransitionError::Capacity, "model-capacity"),
+            (MediaTransitionError::Authority, "model-authority"),
+            (MediaTransitionError::NotReady, "model-not-ready"),
+            (MediaTransitionError::Expired, "model-expired"),
+        ] {
+            let mut diagnostic = DataDiagnostics::new();
+            let original = StreamControlError::Model(model);
+            diagnostic.refuse_control(&outcome(DataDisposition::NotStarted), "admit", &original);
+            assert_eq!(diagnostic.last.map(|r| r.class), Some(class));
+            assert!(matches!(original, StreamControlError::Model(value) if value == model));
+        }
+        let mut d = DataDiagnostics::new();
+        let busy = Refusal {
+            stage: "admit",
+            class: "metadata-busy",
+        };
+        assert!(d.note(busy));
+        for _ in 0..100 {
+            d.attempt();
+            assert!(!d.note(busy));
+        }
+        assert_eq!(d.emitted, 1);
+        for i in 0..100 {
+            d.note(Refusal {
+                stage: "admit",
+                class: if i % 2 == 0 { "not-ready" } else { "metadata-busy" },
+            });
+        }
+        assert_eq!(d.emitted, MAX_REFUSAL_ROWS);
+        assert_eq!(d.suppressed, 97);
+        assert_eq!(d.attempts, 100);
+    }
+
+    #[derive(Clone, Default)]
+    struct Lines(std::sync::Arc<std::sync::Mutex<Vec<u8>>>);
+    impl std::io::Write for Lines {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn diagnostic_cap_never_changes_original_error_or_terminal_disposition() {
+        let lines = Lines::default();
+        let writer = lines.clone();
+        let subscriber = tracing_subscriber::fmt()
+            .without_time().with_ansi(false)
+            .with_max_level(tracing::Level::TRACE)
+            .with_writer(move || writer.clone()).finish();
+        tracing::subscriber::with_default(subscriber, || {
+            let mut d = DataDiagnostics::new();
+            let mut original = outcome(DataDisposition::NotStarted);
+            let error = StreamControlError::MetadataBusy;
+            for _ in 0..100 {
+                d.refuse_control(&original, "admit", &error);
+                d.refuse_dispatch(&original, "submit", &DispatchError::Capacity);
+            }
+            assert!(matches!(error, StreamControlError::MetadataBusy));
+            original.disposition = DataDisposition::SubmissionUnknown;
+            d.terminal(&original, "observer-completed");
+            d.terminal(&original, "must-not-duplicate");
+            assert!(matches!(original.disposition, DataDisposition::SubmissionUnknown));
+            assert_eq!(d.emitted, MAX_REFUSAL_ROWS);
+            assert!(d.terminal);
+            assert!(d.suppressed > 0);
+        });
+        let bytes = lines.0.lock().unwrap();
+        let text = std::str::from_utf8(&bytes).unwrap();
+        assert_eq!(text.lines().count(), usize::from(MAX_REFUSAL_ROWS) + 1);
+        assert_eq!(text.matches("Original Data local delivery outcome").count(), 1);
+        assert!(text.contains("submission-unknown"));
+        assert!(!text.contains("must-not-duplicate"));
+    }
+}
