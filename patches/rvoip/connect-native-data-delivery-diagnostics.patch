+#[tokio::test]
+async fn queued_data_observer_reports_original_source_target_and_internal_refusals_once() {
+    let (f, calls) = fixture_counted(DataProtocol::Json, true).await;
+    let s = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let original = message(230).with_operation_id("observed-original").unwrap();
+    let mut q = queued(&f, &s, &mut out, &original).await;
+    let reset = || {
+        for count in calls.iter() { count.store(0, Ordering::Release); }
+    };
+    let snapshot = || calls.each_ref().map(|count| count.load(Ordering::Acquire));
+    for (subject, expected_stage, expected_calls) in [
+        ("alice", DataAdmissionStage::Source, [1, 0]),
+        ("bob", DataAdmissionStage::Target, [1, 1]),
+    ] {
+        f.policy.0.write().await.revoked.insert(subject.into());
+        reset();
+        let ordinary = q.admit_data();
+        let ordinary_calls = snapshot();
+        reset();
+        let mut observed = Vec::new();
+        let result = q.admit_data_observing(|stage, error| {
+            // Source leases acquired before a target refusal must be gone
+            // before this callback; diagnostics cannot extend their custody.
+            assert!(f.policy.0.try_write().is_ok());
+            observed.push((stage, matches!(error, StreamControlError::Authority)));
+        });
+        assert!(matches!(ordinary, Err(StreamControlError::Authority)));
+        assert!(matches!(result, Err(StreamControlError::Authority)));
+        assert_eq!(observed, vec![(expected_stage, true)]);
+        assert_eq!(snapshot(), expected_calls);
+        assert_eq!(snapshot(), ordinary_calls, "no added policy evaluation");
+        f.policy.0.write().await.revoked.clear();
+    }
+    reset();
+    let mut successful_callbacks = 0;
+    let admission = q.admit_data_observing(|_, _| successful_callbacks += 1).unwrap();
+    let success_calls = snapshot();
+    let writing = admission.begin_write().unwrap();
+    let same_message = admission.data().message() == original.message();
+    let same_operation = admission.data().operation_id() == Some("observed-original");
+    let same_bytes = writing.frame().payload == original.message().bytes;
+    drop(writing);
+    let refuses_duplicate_write = admission.begin_write().is_err();
+    let no_second_publication = out.try_recv().is_err();
+    // An internal pre-admission refusal also preserves its exact original error
+    // and invokes no policy. This is the same queued value, not copied logic.
+    q.frame.kind = StreamKind::Audio;
+    reset();
+    let mut internal = Vec::new();
+    let result = q.admit_data_observing(|stage, error| {
+        internal.push((stage, matches!(error, StreamControlError::Unsupported)));
+    });
+    let internal_calls = snapshot();
+    drop(admission);
+    drop(q);
+    drop(out);
+    s.remove(&f.a.connection);
+    s.remove(&f.b.connection);
+    drop(s);
+    let source_remaining = f.a.shutdown(deadline()).await;
+    let target_remaining = f.b.shutdown(deadline()).await;
+    assert_eq!((source_remaining, target_remaining), (0, 0));
+    assert_eq!(successful_callbacks, 0);
+    assert_eq!(success_calls, [1, 1]);
+    assert!(same_message && same_operation && same_bytes);
+    assert!(refuses_duplicate_write && no_second_publication);
+    assert!(matches!(result, Err(StreamControlError::Unsupported)));
+    assert_eq!(internal, vec![(DataAdmissionStage::Internal, true)]);
+    assert_eq!(internal_calls, [0, 0]);
+}
