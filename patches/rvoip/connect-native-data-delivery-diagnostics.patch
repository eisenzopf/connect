+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_native_data_diagnostics_preserve_repeated_busy_retry_and_one_original_write() {
+    let mut s = DataScene::new("quic", false).await;
+    s.select(0, 1).await;
+    // Park the observer after one real write, leaving the next original message
+    // queued before arming the transient current-policy refusals.
+    s.live[1].ready.busy.store(true, Ordering::Release);
+    let first = s.request(0, 220, "first original".into(), "utf8");
+    assert_eq!(s.publish(0, first).await.kind(), "ack");
+    s.receive(1, 0, 220, "first original", "utf8").await;
+    let second = s.request(0, 221, "same queued original".into(), "utf8");
+    assert_eq!(s.publish(0, second).await.kind(), "ack");
+    core_fixture::until(|| s.factory.adapter.queued_data(&s.live[1].id) == Some(1)).await;
+    let calls_before = {
+        let data = s.policy.0.read().await;
+        data.transient_receives.store(12, Ordering::Release);
+        data.receive_calls.load(Ordering::Acquire)
+    };
+    s.live[1].ready.busy.store(false, Ordering::Release);
+    s.receive(1, 0, 221, "same queued original", "utf8").await;
+    core_fixture::until(|| s.live[1].ready.observations.lock().unwrap().iter().any(|o| {
+        o.operation_id == "data_operation_0_221"
+            && o.disposition == DataDisposition::LocalWritten
+    })).await;
+    let calls = s.policy.0.read().await.receive_calls.load(Ordering::Acquire) - calls_before;
+    let accepted = s.factory.adapter.data_counters(&s.live[0].id).unwrap().snapshot();
+    let written = s.factory.adapter.data_counters(&s.live[1].id).unwrap().snapshot();
+    let outcomes = s.live[1].ready.observations.lock().unwrap().iter()
+        .filter(|o| o.operation_id == "data_operation_0_221").cloned().collect::<Vec<_>>();
+    // Original peer/adapter/Core owners join before the final evidence asserts.
+    s.stop().await;
+    assert_eq!(calls, 13, "12 refusals and one fresh successful target policy evaluation");
+    assert_eq!(accepted.ingress_accepted, 2, "no diagnostic-triggered republication");
+    assert_eq!(written.writer_submissions, 2);
+    assert_eq!(written.local_writes, 2);
+    assert_eq!(outcomes.len(), 1);
+    assert_eq!(outcomes[0].message_id.as_str(), "data_message_221");
+    assert_eq!(outcomes[0].disposition, DataDisposition::LocalWritten);
+}
