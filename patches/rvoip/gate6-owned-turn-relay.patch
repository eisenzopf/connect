+//! TURN-over-TCP framing. This socket belongs to the original RTC driver;
+//! the sans-I/O TURN client still requests a UDP *relay* allocation.
+use crate::runtime::AsyncUdpSocket;
+use std::{
+    future::Future,
+    io,
+    net::SocketAddr,
+    pin::Pin,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Duration,
+};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{
+    TcpSocket,
+    tcp::{OwnedReadHalf, OwnedWriteHalf},
+};
+use tokio::sync::Mutex;
+
+pub(super) struct TurnTcp {
+    local: SocketAddr,
+    remote: SocketAddr,
+    reader: Mutex<OwnedReadHalf>,
+    writer: Mutex<OwnedWriteHalf>,
+    write_tainted: AtomicBool,
+}
+struct WriteAttempt<'a> {
+    tainted: &'a AtomicBool,
+    complete: bool,
+}
+impl Drop for WriteAttempt<'_> {
+    fn drop(&mut self) {
+        if !self.complete {
+            self.tainted.store(true, Ordering::Release);
+        }
+    }
+}
+impl std::fmt::Debug for TurnTcp {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("TurnTcp([owned])")
+    }
+}
+impl TurnTcp {
+    pub(super) async fn connect(
+        local: SocketAddr,
+        remote: SocketAddr,
+    ) -> io::Result<Arc<dyn AsyncUdpSocket>> {
+        let socket = if local.is_ipv4() {
+            TcpSocket::new_v4()?
+        } else {
+            TcpSocket::new_v6()?
+        };
+        socket.bind(SocketAddr::new(local.ip(), 0))?;
+        let stream = tokio::time::timeout(Duration::from_secs(3), socket.connect(remote)).await??;
+        stream.set_nodelay(true)?;
+        let local = stream.local_addr()?;
+        let (reader, writer) = stream.into_split();
+        Ok(Arc::new(Self {
+            local,
+            remote,
+            reader: Mutex::new(reader),
+            writer: Mutex::new(writer),
+            write_tainted: AtomicBool::new(false),
+        }))
+    }
+}
+impl AsyncUdpSocket for TurnTcp {
+    fn local_addr(&self) -> io::Result<SocketAddr> {
+        Ok(self.local)
+    }
+    fn send_to<'a>(
+        &'a self,
+        buf: &'a [u8],
+        target: SocketAddr,
+    ) -> Pin<Box<dyn Future<Output = io::Result<usize>> + Send + 'a>> {
+        Box::pin(async move {
+            if target != self.remote || buf.len() < 4 {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "Invalid TURN control target/frame",
+                ));
+            }
+            let mut writer = self.writer.lock().await;
+            if self.write_tainted.load(Ordering::Acquire) {
+                return Err(io::Error::new(
+                    io::ErrorKind::BrokenPipe,
+                    "Prior TURN write incomplete",
+                ));
+            }
+            let mut attempt = WriteAttempt {
+                tainted: &self.write_tainted,
+                complete: false,
+            };
+            tokio::time::timeout(Duration::from_millis(500), async {
+                writer.write_all(buf).await?;
+                // ChannelData uses four-byte alignment on TCP (RFC8656 section12).
+                if buf[0] & 0xc0 == 0x40 {
+                    let padding = (4 - buf.len() % 4) % 4;
+                    writer.write_all(&[0u8; 3][..padding]).await?;
+                }
+                Ok::<(), io::Error>(())
+            })
+            .await??;
+            attempt.complete = true;
+            Ok(buf.len())
+        })
+    }
+    fn recv_from<'a>(
+        &'a self,
+        buf: &'a mut [u8],
+    ) -> Pin<Box<dyn Future<Output = io::Result<(usize, SocketAddr)>> + Send + 'a>> {
+        Box::pin(async move {
+            if buf.len() < 20 {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "TURN receive capacity",
+                ));
+            }
+            let mut reader = self.reader.lock().await;
+            // The driver retains this one receive future between polls. It is
+            // dropped only with the owned connection, never resumed after cancel.
+            reader.read_exact(&mut buf[..4]).await?;
+            let payload = usize::from(u16::from_be_bytes([buf[2], buf[3]]));
+            let size = match buf[0] & 0xc0 {
+                0 => 20 + payload,
+                0x40 => 4 + payload,
+                _ => {
+                    return Err(io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        "Invalid TURN TCP frame",
+                    ));
+                }
+            };
+            if size > buf.len() {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "TURN TCP frame exceeds receive bound",
+                ));
+            }
+            reader.read_exact(&mut buf[4..size]).await?;
+            if buf[0] & 0xc0 == 0x40 {
+                let padding = (4 - size % 4) % 4;
+                reader.read_exact(&mut [0u8; 3][..padding]).await?;
+            }
+            Ok((size, self.remote))
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn framed_tcp_reads_split_and_coalesced_messages_and_refuses_wrong_target() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let server = listener.local_addr().unwrap();
+        let client = TurnTcp::connect("127.0.0.1:0".parse().unwrap(), server)
+            .await
+            .unwrap();
+        let task = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let mut input = [0u8; 20];
+            socket.read_exact(&mut input).await.unwrap();
+            assert_eq!(input, [0u8; 20]);
+            socket.write_all(&[0u8; 2]).await.unwrap();
+            tokio::task::yield_now().await;
+            let mut rest = vec![0u8; 18];
+            rest.extend_from_slice(&[0x40, 1, 0, 3, 7, 8, 9, 0]);
+            socket.write_all(&rest).await.unwrap();
+        });
+        let mut wrong = server;
+        wrong.set_port(if server.port() == 65535 {
+            65534
+        } else {
+            server.port() + 1
+        });
+        assert!(client.send_to(&[0u8; 20], wrong).await.is_err());
+        assert_eq!(client.send_to(&[0u8; 20], server).await.unwrap(), 20);
+        let mut buf = [0u8; 64];
+        assert_eq!(client.recv_from(&mut buf).await.unwrap(), (20, server));
+        assert_eq!(&buf[..20], &[0u8; 20]);
+        assert_eq!(client.recv_from(&mut buf).await.unwrap(), (7, server));
+        assert_eq!(&buf[..7], &[0x40, 1, 0, 3, 7, 8, 9]);
+        task.await.unwrap();
+    }
+    #[tokio::test]
+    async fn oversized_tcp_frame_refuses_before_payload_delivery() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let server = listener.local_addr().unwrap();
+        let client = TurnTcp::connect("127.0.0.1:0".parse().unwrap(), server)
+            .await
+            .unwrap();
+        let task = tokio::spawn(async move {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            socket.write_all(&[0, 1, 255, 255]).await.unwrap();
+        });
+        let mut buf = [0u8; 64];
+        assert_eq!(
+            client.recv_from(&mut buf).await.unwrap_err().kind(),
+            io::ErrorKind::InvalidData
+        );
+        task.await.unwrap();
+    }
+}
