+//! Owned TURN client state; all network IO remains in the original RTC driver.
+//! No detached relay tasks, implicit public services or retained media queue.
+use super::ice_gatherer::RTCIceGathererEvent;
+use rtc::peer_connection::configuration::RTCIceServer;
+use rtc::peer_connection::transport::{CandidateConfig, CandidateRelayConfig, RTCIceCandidate};
+use rtc::sansio::Protocol;
+use rtc::shared::error::{Error, Result};
+use rtc::shared::{TaggedBytesMut, TransportContext, TransportProtocol};
+use rtc::stun::{
+    attributes::ATTR_REALM,
+    integrity::MessageIntegrity,
+    message::{
+        CLASS_ERROR_RESPONSE, CLASS_SUCCESS_RESPONSE, Getter, METHOD_REFRESH, Message,
+        TransactionId,
+    },
+    textattrs::Realm,
+};
+use rtc::turn::{
+    client::{Client, ClientConfig, Event},
+    proto::lifetime::Lifetime,
+};
+use std::{collections::VecDeque, net::SocketAddr, time::Instant};
+
+pub(super) struct Relays {
+    routes: Vec<Route>,
+    events: VecDeque<RTCIceGathererEvent>,
+    closing: bool,
+    control: VecDeque<TaggedBytesMut>,
+}
+struct Route {
+    client: Client,
+    local: SocketAddr,
+    server: SocketAddr,
+    allocated: Option<SocketAddr>,
+    pending: bool,
+    uncertain: bool,
+    closed: bool,
+    close_transaction: Option<TransactionId>,
+    integrity: Option<MessageIntegrity>,
+    username: String,
+    password: String,
+}
+impl Relays {
+    pub(super) fn validate(servers: &[RTCIceServer]) -> Result<()> {
+        for server in servers {
+            for url in &server.urls {
+                if url.starts_with("turn:") {
+                    let (authority, query) = url[5..]
+                        .split_once('?')
+                        .map_or((&url[5..], None), |(a, q)| (a, Some(q)));
+                    if authority.is_empty()
+                        || query.is_some_and(|q| !matches!(q, "transport=udp" | "transport=tcp"))
+                        || server.username.is_empty()
+                        || server.credential.is_empty()
+                    {
+                        return Err(Error::Other(
+                            "unsupported TURN transport or missing credentials".into(),
+                        ));
+                    }
+                } else if !url.starts_with("stun:") {
+                    return Err(Error::Other("unsupported ICE service transport".into()));
+                }
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn prepare<'a>(
+        locals: &'a [SocketAddr],
+        servers: &'a [RTCIceServer],
+        sockets: &'a mut std::collections::HashMap<
+            SocketAddr,
+            std::sync::Arc<dyn crate::runtime::AsyncUdpSocket>,
+        >,
+    ) -> std::pin::Pin<Box<dyn std::future::Future<Output = Result<Self>> + Send + 'a>> {
+        // Erase transport setup's future at this non-generic IO boundary rather
+        // than exporting its TCP/DNS auto-trait graph through every RTC user.
+        Box::pin(async move {
+            Self::validate(servers)?;
+            let mut routes = Vec::<Route>::new();
+            // This stage opens only bounded owned control sockets. No allocation
+            // exists before all configuration/transport preparation succeeds.
+            for server in servers {
+                for url in &server.urls {
+                    let Some(rest) = url.strip_prefix("turn:") else {
+                        continue;
+                    };
+                    let (authority, query) = rest
+                        .split_once('?')
+                        .map_or((rest, None), |(a, q)| (a, Some(q)));
+                    let tcp = query == Some("transport=tcp");
+                    let endpoint = if authority.starts_with('[') {
+                        if authority.contains("]:") {
+                            authority.to_owned()
+                        } else {
+                            format!("{authority}:3478")
+                        }
+                    } else if authority.contains(':') {
+                        authority.to_owned()
+                    } else {
+                        format!("{authority}:3478")
+                    };
+                    let addresses = crate::runtime::resolve_host(&endpoint).await?;
+                    for base in locals {
+                        let Some(remote) = addresses
+                            .iter()
+                            .find(|a| a.is_ipv4() == base.is_ipv4())
+                            .copied()
+                        else {
+                            continue;
+                        };
+                        if !tcp
+                            && routes
+                                .iter()
+                                .any(|r| r.local == *base && r.server == remote)
+                        {
+                            continue;
+                        }
+                        if routes.len() >= 16 {
+                            return Err(Error::Other("TURN route capacity exceeded".into()));
+                        }
+                        let local = if tcp {
+                            let socket = super::turn_tcp::TurnTcp::connect(*base, remote).await?;
+                            let local = socket.local_addr()?;
+                            if sockets.contains_key(&local) {
+                                return Err(Error::Other("TURN control address collision".into()));
+                            }
+                            sockets.insert(local, socket);
+                            local
+                        } else {
+                            *base
+                        };
+                        let client = Client::new(ClientConfig {
+                            stun_serv_addr: String::new(),
+                            turn_serv_addr: remote.to_string(),
+                            local_addr: local,
+                            // TURN control transport and requested relay transport are independent.
+                            transport_protocol: TransportProtocol::UDP,
+                            username: server.username.clone(),
+                            password: server.credential.clone(),
+                            realm: String::new(),
+                            software: String::new(),
+                            rto_in_ms: 200,
+                        })?;
+                        routes.push(Route {
+                            client,
+                            local,
+                            server: remote,
+                            allocated: None,
+                            pending: false,
+                            uncertain: false,
+                            closed: false,
+                            close_transaction: None,
+                            integrity: None,
+                            username: server.username.clone(),
+                            password: server.credential.clone(),
+                        });
+                    }
+                }
+            }
+            Ok(Self {
+                routes,
+                events: VecDeque::new(),
+                closing: false,
+                control: VecDeque::new(),
+            })
+        })
+    }
+    pub(super) fn gather(&mut self) -> Result<()> {
+        for route in &mut self.routes {
+            if let Some(address) = route.allocated {
+                if !route.closed {
+                    let candidate = CandidateRelayConfig {
+                        base_config: CandidateConfig {
+                            network: "udp".into(),
+                            address: address.ip().to_string(),
+                            port: address.port(),
+                            component: 1,
+                            ..Default::default()
+                        },
+                        rel_addr: route.local.ip().to_string(),
+                        rel_port: route.local.port(),
+                        ..Default::default()
+                    }
+                    .new_candidate_relay()?;
+                    self.events
+                        .push_back(RTCIceGathererEvent::LocalIceCandidate(
+                            RTCIceCandidate::from(&candidate).to_json()?,
+                        ));
+                }
+            } else if !route.pending && !route.closed {
+                route.client.allocate()?;
+                route.pending = true;
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn pending(&self) -> bool {
+        self.routes.iter().any(|r| r.pending)
+    }
+    pub(super) fn matches(&self, msg: &TaggedBytesMut) -> bool {
+        self.routes.iter().any(|r| {
+            !r.closed && r.local == msg.transport.local_addr && r.server == msg.transport.peer_addr
+        })
+    }
+    pub(super) fn encapsulate(&mut self, msg: &TaggedBytesMut) -> Result<Option<TaggedBytesMut>> {
+        let Some(route) = self
+            .routes
+            .iter_mut()
+            .find(|r| !r.closed && r.allocated == Some(msg.transport.local_addr))
+        else {
+            return Ok(None);
+        };
+        if self.closing {
+            return Err(Error::ErrConnectionClosed);
+        }
+        let mut relay = route.client.relay(msg.transport.local_addr)?;
+        relay.create_permission(msg.transport.peer_addr)?;
+        // Permission preparation may drop an initial ICE check; ICE owns its
+        // retransmission. Application packets never wait in a relay queue.
+        relay.send_to(&msg.message, msg.transport.peer_addr)?;
+        let mut output = None;
+        let mut invalid = false;
+        while let Some(wire) = route.client.poll_write() {
+            let bytes = &wire.message;
+            let (application, matches_original) = if bytes.len() >= 4 && bytes[0] & 0xc0 == 0x40 {
+                let size = usize::from(u16::from_be_bytes([bytes[2], bytes[3]]));
+                (true, bytes.get(4..4 + size) == Some(msg.message.as_ref()))
+            } else if rtc::stun::message::is_stun_message(bytes) {
+                let mut packet = Message::new();
+                packet.raw = bytes.to_vec();
+                let mut data = rtc::turn::proto::data::Data::default();
+                let application =
+                    packet.decode().is_ok() && packet.typ.method == rtc::stun::message::METHOD_SEND;
+                (
+                    application,
+                    application
+                        && data.get_from(&packet).is_ok()
+                        && data.0.as_slice() == msg.message.as_ref(),
+                )
+            } else {
+                (false, false)
+            };
+            if application {
+                if !matches_original || output.is_some() {
+                    invalid = true;
+                } else {
+                    output = Some(wire);
+                }
+            } else if self.control.len() < 64 {
+                self.control.push_back(wire);
+            } else {
+                invalid = true;
+            }
+        }
+        // Always drain the client after this original send, including refusal.
+        // No error path can leave application bytes for a later unguarded poll.
+        if invalid {
+            return Err(Error::ErrConnectionClosed);
+        }
+        output.map(Some).ok_or(Error::ErrConnectionClosed)
+    }
+
+    pub(super) fn read(&mut self, msg: TaggedBytesMut) -> Result<()> {
+        let route = self
+            .routes
+            .iter_mut()
+            .find(|r| {
+                !r.closed
+                    && r.local == msg.transport.local_addr
+                    && r.server == msg.transport.peer_addr
+            })
+            .ok_or(Error::ErrConnectionClosed)?;
+        if rtc::stun::message::is_stun_message(&msg.message) {
+            let mut response = Message::new();
+            response.raw = msg.message.to_vec();
+            response.decode()?;
+            if response.typ.class == CLASS_ERROR_RESPONSE && route.integrity.is_none() {
+                if let Ok(realm) = Realm::get_from_as(&response, ATTR_REALM) {
+                    route.integrity = Some(MessageIntegrity::new_long_term_integrity(
+                        route.username.clone(),
+                        realm.text,
+                        route.password.clone(),
+                    ));
+                }
+            }
+            if response.typ.class == CLASS_SUCCESS_RESPONSE {
+                route
+                    .integrity
+                    .as_ref()
+                    .ok_or(Error::ErrIntegrityMismatch)?
+                    .check(&mut response)?;
+                if response.typ.method == METHOD_REFRESH
+                    && route.close_transaction == Some(response.transaction_id)
+                {
+                    let mut lifetime = Lifetime::default();
+                    lifetime.get_from(&response)?;
+                    if lifetime.0.is_zero() {
+                        route.closed = true;
+                        route.pending = false;
+                        return Ok(());
+                    }
+                }
+            }
+        }
+        route.client.handle_read(msg)
+    }
+    pub(super) fn poll_write(&mut self) -> Option<TaggedBytesMut> {
+        if let Some(msg) = self.control.pop_front() {
+            return Some(msg);
+        }
+        for route in &mut self.routes {
+            if route.closed {
+                continue;
+            }
+            if let Some(msg) = route.client.poll_write() {
+                if self.closing && rtc::stun::message::is_stun_message(&msg.message) {
+                    let mut request = Message::new();
+                    request.raw = msg.message.to_vec();
+                    if request.decode().is_ok() && request.typ.method == METHOD_REFRESH {
+                        route.close_transaction = Some(request.transaction_id);
+                    }
+                }
+                return Some(msg);
+            }
+        }
+        None
+    }
+    pub(super) fn poll_event(&mut self) -> Option<RTCIceGathererEvent> {
+        for route in &mut self.routes {
+            if route.closed {
+                continue;
+            }
+            while let Some(event) = route.client.poll_event() {
+                match event {
+                    Event::AllocateResponse(_, address) => {
+                        route.pending = false;
+                        route.allocated = Some(address);
+                        if self.closing {
+                            if let Ok(mut relay) = route.client.relay(address) {
+                                let _ = relay.close();
+                            }
+                            continue;
+                        }
+                        let candidate = CandidateRelayConfig {
+                            base_config: CandidateConfig {
+                                network: "udp".into(),
+                                address: address.ip().to_string(),
+                                port: address.port(),
+                                component: 1,
+                                ..Default::default()
+                            },
+                            rel_addr: route.local.ip().to_string(),
+                            rel_port: route.local.port(),
+                            ..Default::default()
+                        }
+                        .new_candidate_relay()
+                        .and_then(|c| RTCIceCandidate::from(&c).to_json());
+                        if let Ok(candidate) = candidate {
+                            self.events
+                                .push_back(RTCIceGathererEvent::LocalIceCandidate(candidate));
+                        }
+                    }
+                    Event::AllocateError(..) => {
+                        route.pending = false;
+                    }
+                    Event::TransactionTimeout(..) => {
+                        route.pending = false;
+                        route.uncertain = true;
+                    }
+                    Event::DataIndicationOrChannelData(_, peer_addr, message) => {
+                        if let Some(local_addr) = route.allocated {
+                            self.events.push_back(RTCIceGathererEvent::RelayedDatagram(
+                                TaggedBytesMut {
+                                    now: Instant::now(),
+                                    transport: TransportContext {
+                                        local_addr,
+                                        peer_addr,
+                                        transport_protocol: TransportProtocol::UDP,
+                                        ecn: None,
+                                    },
+                                    message,
+                                },
+                            ));
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        self.events.pop_front()
+    }
+    pub(super) fn timeout(&mut self, now: Instant) -> Result<()> {
+        for route in &mut self.routes {
+            if !route.closed {
+                route.client.handle_timeout(now)?;
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn next_timeout(&mut self) -> Option<Instant> {
+        self.routes
+            .iter_mut()
+            .filter(|r| !r.closed)
+            .filter_map(|r| r.client.poll_timeout())
+            .min()
+    }
+    pub(super) fn begin_close(&mut self) -> Result<()> {
+        self.closing = true;
+        for route in &mut self.routes {
+            if let Some(address) = route.allocated {
+                if !route.closed {
+                    route.client.relay(address)?.close()?;
+                }
+            } else if !route.pending && !route.uncertain {
+                route.closed = true;
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn closed(&self) -> bool {
+        self.routes.iter().all(|r| r.closed)
+    }
+}
