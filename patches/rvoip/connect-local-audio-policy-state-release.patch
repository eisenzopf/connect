+// Separate from ordinary Publish/Receive callbacks: the real local-audio entry
+// must release State for its own independently authorized preparation callback.
+struct LocalCallbackPolicy {
+    inner: Arc<Policy>,
+    target: Arc<Mutex<Weak<StreamController>>>,
+    actions: Actions,
+}
+impl MediaPolicy for LocalCallbackPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current(scope)
+    }
+    fn current_local_audio(
+        &self,
+        scope: &MediaScope<'_>,
+        purpose: &local_audio::LocalAudioPurpose,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if scope.connection.as_str() != "bob"
+            || *purpose
+                != (local_audio::LocalAudioPurpose::EndpointPreparation {
+                    operation_id: "local-state-read".into(),
+                })
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let action = self.actions.lock().unwrap().take();
+        if let Some(action) = action {
+            action(&self.target.lock().unwrap().upgrade().unwrap());
+        }
+        self.inner.current(scope)
+    }
+}
+async fn local_fixture(kinds: &[Medium]) -> (Fixture, Actions, Arc<audio_consumer::AudioConsumer>) {
+    let actions = Arc::new(Mutex::new(None));
+    let target = Arc::new(Mutex::new(Weak::new()));
+    let fixture = Fixture::with_policy(
+        8,
+        Some(Box::new({
+            let actions = actions.clone();
+            let target = target.clone();
+            move |inner| {
+                Arc::new(LocalCallbackPolicy {
+                    inner,
+                    target,
+                    actions,
+                })
+            }
+        })),
+    );
+    *target.lock().unwrap() = Arc::downgrade(&fixture.b);
+    fixture.start(kinds).await;
+    let consumer =
+        audio_consumer::AudioConsumer::optional(Some(desired(Medium::Audio).logical_id), 8000);
+    consumer.activate(true);
+    *fixture.b.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&consumer));
+    (fixture, actions, consumer)
+}
+fn local_silence(controller: &StreamController) -> ControlResult<()> {
+    controller.try_queue_local_silence(
+        &desired(Medium::Audio).logical_id,
+        local_audio::LocalAudioPurpose::EndpointPreparation {
+            operation_id: "local-state-read".into(),
+        },
+        960,
+    )
+}
+#[tokio::test]
+async fn local_audio_enqueue_and_actual_send_policy_release_state_and_keep_neutral_origin() {
+    let (f, actions, _consumer) = local_fixture(&[Medium::Audio]).await;
+    let mut output = f.ba.port(Medium::Audio).take_egress().unwrap();
+    *actions.lock().unwrap() = Some(Box::new(|controller| {
+        assert!(
+            controller.state.try_lock().is_ok(),
+            "local enqueue policy holds State"
+        );
+    }));
+    local_silence(&f.b).unwrap();
+    assert!(
+        actions.lock().unwrap().is_none(),
+        "local enqueue callback was not entered"
+    );
+    let queued = outgoing(&mut output).await;
+    let admitted = queued.admitted_at;
+    *actions.lock().unwrap() = Some(Box::new(|controller| {
+        assert!(
+            controller.state.try_lock().is_ok(),
+            "local send policy holds State"
+        );
+    }));
+    queued
+        .deliver_with_origin(|frame, origin| async move {
+            assert!(
+                origin.is_none(),
+                "local silence borrowed a remote media origin"
+            );
+            assert_eq!(frame.timestamp_rtp, 960);
+            let mut decoder = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                0,
+                Some(8000),
+                Some(1),
+            )
+            .unwrap();
+            assert!(
+                decoder
+                    .decode(&frame.payload)
+                    .unwrap()
+                    .samples
+                    .iter()
+                    .all(|v| v.unsigned_abs() < 20)
+            );
+            assert!(admitted.elapsed() < Duration::from_millis(200));
+            Ok(())
+        })
+        .await
+        .unwrap();
+    assert!(
+        actions.lock().unwrap().is_none(),
+        "local send callback was not entered"
+    );
+    assert!(
+        f.policy.0.try_write().is_ok(),
+        "local output retained authority after send"
+    );
+}
+#[tokio::test]
+async fn blocked_local_audio_policy_allows_the_same_targets_original_queued_video_writer() {
+    let (f, actions, _consumer) = local_fixture(&[Medium::Audio, Medium::Video]).await;
+    let source = f.aa.port(Medium::Video);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Video).logical_id)
+            .unwrap();
+    let mut output = f.ba.port(Medium::Video).take_egress().unwrap();
+    source.try_publish(&frame(&source, 930)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Video).logical_id)
+        .unwrap();
+    let queued = outgoing(&mut output).await;
+    let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+    let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+    *actions.lock().unwrap() = Some(Box::new(move |controller| {
+        assert!(
+            controller.state.try_lock().is_ok(),
+            "local callback still excludes video"
+        );
+        entered_tx.send(()).unwrap();
+        release_rx
+            .recv_timeout(Duration::from_secs(2))
+            .expect("original owner releases local callback");
+    }));
+    let controller = f.b.clone();
+    let worker = std::thread::spawn(move || local_silence(&controller));
+    let entered = entered_rx.recv_timeout(Duration::from_secs(1));
+    let delivered = if entered.is_ok() {
+        queued.deliver(|_| async { Ok(()) }).await
+    } else {
+        Err(StreamControlError::NotReady)
+    };
+    let released = release_tx.send(());
+    let joined = worker.join();
+    assert!(entered.is_ok(), "original local callback was not entered");
+    assert!(released.is_ok());
+    assert!(
+        joined.is_ok_and(|result| result.is_ok()),
+        "original local queue worker did not succeed"
+    );
+    assert!(
+        delivered.is_ok(),
+        "queued video could not drain while local policy was blocked"
+    );
+    assert!(actions.lock().unwrap().is_none());
+}
+#[tokio::test]
+async fn local_audio_policy_refuses_model_aba_credential_and_original_port_changes() {
+    for changed in 0..5 {
+        let (f, actions, _consumer) = local_fixture(&[Medium::Audio]).await;
+        let mut output = f.ba.port(Medium::Audio).take_egress().unwrap();
+        let authority = f.policy.0.try_read().unwrap().owners["bob"].clone();
+        *actions.lock().unwrap() = Some(Box::new(move |controller| {
+            assert!(controller.state.try_lock().is_ok());
+            match changed {
+                0 => {
+                    let mut state = controller.state.lock().unwrap();
+                    for paused in [true, false] {
+                        let expected = state.model.revision();
+                        state
+                            .model
+                            .set_paused(
+                                &authority.current(),
+                                expected,
+                                &desired(Medium::Audio).logical_id,
+                                paused,
+                            )
+                            .unwrap();
+                    }
+                }
+                1 => controller.credential.lock().unwrap().revision += 1,
+                2 => controller.state.lock().unwrap().closed = true,
+                3 => controller.state.lock().unwrap().active[&desired(Medium::Audio).logical_id]
+                    .retire(),
+                4 => controller.shutdown.cancel(),
+                _ => unreachable!(),
+            }
+        }));
+        assert!(local_silence(&f.b).is_err(), "changed={changed}");
+        assert!(
+            actions.lock().unwrap().is_none(),
+            "original callback was not entered"
+        );
+        assert!(
+            output.try_recv().is_err(),
+            "changed={changed} reached egress"
+        );
+        assert!(f.policy.0.try_write().is_ok());
+    }
+}
+#[tokio::test]
+async fn local_audio_policy_freezes_consumer_and_scene_activation_before_enqueue_and_send() {
+    for queued_send in [false, true] {
+        for changed in 0..4 {
+            let (f, actions, consumer) = local_fixture(&[Medium::Audio]).await;
+            let scene = scene_consumer::SceneConsumer::new(930);
+            scene.activate();
+            *f.b.scene_consumer.lock().unwrap() = Some(Arc::downgrade(&scene));
+            let mut output = f.ba.port(Medium::Audio).take_egress().unwrap();
+            let queued = if queued_send {
+                local_silence(&f.b).unwrap();
+                Some(outgoing(&mut output).await)
+            } else {
+                None
+            };
+            *actions.lock().unwrap() = Some(Box::new({
+                let consumer = consumer.clone();
+                let scene = scene.clone();
+                move |controller| {
+                    assert!(controller.state.try_lock().is_ok());
+                    match changed {
+                        0 => consumer.activate(true),
+                        1 => *controller.audio_consumer.lock().unwrap() = None,
+                        2 => scene.activate(),
+                        3 => *controller.scene_consumer.lock().unwrap() = None,
+                        _ => unreachable!(),
+                    }
+                }
+            }));
+            let writes = Arc::new(AtomicUsize::new(0));
+            let result = if let Some(queued) = queued {
+                queued
+                    .deliver({
+                        let writes = writes.clone();
+                        move |_| async move {
+                            writes.fetch_add(1, Ordering::SeqCst);
+                            Ok(())
+                        }
+                    })
+                    .await
+            } else {
+                local_silence(&f.b)
+            };
+            assert!(result.is_err(), "queued={queued_send} changed={changed}");
+            assert!(
+                actions.lock().unwrap().is_none(),
+                "original callback was not entered"
+            );
+            assert_eq!(writes.load(Ordering::SeqCst), 0);
+            assert!(output.try_recv().is_err());
+            assert!(f.policy.0.try_write().is_ok());
+        }
+    }
+}
