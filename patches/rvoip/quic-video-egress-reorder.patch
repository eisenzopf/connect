+//! Bounded source-packet reordering before variable-width VP8 sequence expansion.
+//! Original work values (including capture time and route tickets) stay attached.
+use bytes::Bytes;
+use std::time::{Duration, Instant};
+
+pub const CAPACITY: usize = 64;
+pub const GAP_WAIT: Duration = Duration::from_millis(100);
+
+pub struct Reordered<T> {
+    pub packet: Bytes,
+    pub value: T,
+}
+struct Pending<T> {
+    item: Reordered<T>,
+    sequence: u16,
+    inserted: Instant,
+}
+/// Ordered traffic is released immediately. A missing source packet waits at
+/// most 100ms; advancing past a loss preserves its sequence hole in the mapper.
+/// Startup waits for a partition-zero key start rather than anchoring on a
+/// reordered continuation. Pending storage never exceeds 64 packets.
+pub struct Vp8Reorder<T> {
+    ssrc: Option<u32>,
+    next: Option<u16>,
+    pending: Vec<Pending<T>>,
+}
+impl<T> Default for Vp8Reorder<T> {
+    fn default() -> Self {
+        Self {
+            ssrc: None,
+            next: None,
+            pending: Vec::new(),
+        }
+    }
+}
+impl<T> Vp8Reorder<T> {
+    pub fn len(&self) -> usize {
+        self.pending.len()
+    }
+    pub fn is_empty(&self) -> bool {
+        self.pending.is_empty()
+    }
+    /// Deadline must be polled even when the input channel becomes idle.
+    pub fn deadline(&self) -> Option<Instant> {
+        self.pending.iter().map(|p| p.inserted + GAP_WAIT).min()
+    }
+    pub fn push(&mut self, packet: Bytes, value: T, now: Instant) -> Vec<Reordered<T>> {
+        if packet.len() > crate::video_bridge::MAX_VIDEO_RTP_BYTES
+            || packet.len() <= 13
+            || packet[0] != 0x80
+        {
+            return Vec::new();
+        }
+        let Some(descriptor) = super::video_packetizer::descriptor_len(&packet[12..]) else {
+            return Vec::new();
+        };
+        let source = u16::from_be_bytes([packet[2], packet[3]]);
+        let ssrc = u32::from_be_bytes(packet[8..12].try_into().expect("checked RTP header"));
+        if self.ssrc != Some(ssrc) {
+            self.ssrc = Some(ssrc);
+            self.next = None;
+            self.pending.clear();
+        }
+        if self.pending.iter().any(|p| p.sequence == source) {
+            return Vec::new();
+        }
+        let key_start = packet[12] & 0x1f == 0x10 && packet[12 + descriptor] & 1 == 0;
+        if self.next.is_none() && key_start {
+            self.next = Some(source);
+            self.pending
+                .retain(|p| (p.sequence.wrapping_sub(source) as i16) >= 0);
+        }
+        if self
+            .next
+            .is_some_and(|next| (source.wrapping_sub(next) as i16) < 0)
+        {
+            // The packetizer alone knows whether this is an exact recent
+            // duplicate. Unknown late input cannot rewrite an emitted map.
+            return vec![Reordered { packet, value }];
+        }
+        let mut ready = Vec::new();
+        // Never insert a 65th retained packet. At pressure, prefer a newly
+        // arrived nearer gap-fill over advancing past it to old queued input.
+        if self.pending.len() == CAPACITY && self.next != Some(source) {
+            if let Some(next) = self.next {
+                let nearest = self
+                    .pending
+                    .iter()
+                    .map(|p| p.sequence.wrapping_sub(next))
+                    .min()
+                    .expect("full queue");
+                if source.wrapping_sub(next) < nearest {
+                    self.next = Some(source);
+                } else {
+                    self.advance();
+                }
+                ready.extend(self.drain());
+            } else {
+                self.pending.remove(0);
+            }
+        }
+        if self.next == Some(source) {
+            // The active packet is separate from the at-most-64 queued items.
+            ready.push(Reordered { packet, value });
+            self.next = Some(source.wrapping_add(1));
+            ready.extend(self.drain());
+        } else {
+            self.pending.push(Pending {
+                item: Reordered { packet, value },
+                sequence: source,
+                inserted: now,
+            });
+        }
+        ready.extend(self.expire(now));
+        ready
+    }
+    pub fn expire(&mut self, now: Instant) -> Vec<Reordered<T>> {
+        if !self.deadline().is_some_and(|deadline| deadline <= now) {
+            return Vec::new();
+        }
+        if self.next.is_none() {
+            self.pending
+                .retain(|p| now.saturating_duration_since(p.inserted) < GAP_WAIT);
+            return Vec::new();
+        }
+        self.advance();
+        self.drain()
+    }
+    fn advance(&mut self) {
+        if let Some(next) = self.next {
+            if let Some(p) = self
+                .pending
+                .iter()
+                .min_by_key(|p| p.sequence.wrapping_sub(next))
+            {
+                self.next = Some(p.sequence);
+            }
+        }
+    }
+    fn drain(&mut self) -> Vec<Reordered<T>> {
+        let mut ready = Vec::new();
+        while let Some(next) = self.next {
+            let Some(index) = self.pending.iter().position(|p| p.sequence == next) else {
+                break;
+            };
+            ready.push(self.pending.remove(index).item);
+            self.next = Some(next.wrapping_add(1));
+        }
+        ready
+    }
+}
