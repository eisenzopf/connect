+// Retain only numeric media coordinates. No packet, route, clock predicate or
+// delivery authority survives a mixer tick in this timeline.
+fn source_timestamp(
+    points: &[ClockPoint],
+    mix_rate: u32,
+    output_rate: u32,
+    fallback: u32,
+    timeline: &mut Option<SourceTimeline>,
+) -> u32 {
+    let calculate = || -> Option<(u128, u64, CapturePosition)> {
+        let first = points.first()?;
+        let clock = first.clock.as_ref()?;
+        let position = first.position?;
+        if !first.supported
+            || !clock.supported
+            || position.rate == 0
+            || mix_rate == 0
+            || output_rate == 0
+        {
+            return None;
+        }
+        for point in points {
+            let c = point.clock.as_ref()?;
+            let p = point.position?;
+            if !point.supported
+                || !c.supported
+                || c.source_id != clock.source_id
+                || c.generation != clock.generation
+                || p.rate != position.rate
+            {
+                return None;
+            }
+            let delta = p.rtp.wrapping_sub(position.rtp) as i32;
+            if delta == i32::MIN {
+                return None;
+            }
+            let distance = i128::from(delta) * i128::from(mix_rate)
+                + (p.offset - position.offset) * i128::from(position.rate);
+            // Every contributing segment must name the same original start,
+            // within one mix sample, including partial/resampled packets.
+            if distance.abs() > i128::from(position.rate) {
+                return None;
+            }
+        }
+        Some((clock.source_id, clock.generation, position))
+    };
+    let Some((source, generation, position)) = calculate() else {
+        *timeline = None;
+        return fallback;
+    };
+    let denominator = i128::from(position.rate) * i128::from(mix_rate);
+    if let Some(previous) = timeline.as_mut().filter(|t| {
+        t.source == source
+            && t.generation == generation
+            && t.previous.rate == position.rate
+            && t.mix_rate == mix_rate
+            && t.output_rate == output_rate
+    }) {
+        let delta = position.rtp.wrapping_sub(previous.previous.rtp) as i32;
+        let input = i128::from(delta) * i128::from(mix_rate)
+            + (position.offset - previous.previous.offset) * i128::from(position.rate);
+        let scaled = input * i128::from(output_rate) + previous.remainder;
+        let step = scaled.div_euclid(denominator);
+        if delta != i32::MIN && input >= 0 && step < i128::from(1u32 << 31) {
+            previous.timestamp = previous.timestamp.wrapping_add(step as u32);
+            previous.previous = position;
+            previous.remainder = scaled.rem_euclid(denominator);
+            return previous.timestamp;
+        }
+    }
+    *timeline = Some(SourceTimeline {
+        source,
+        generation,
+        mix_rate,
+        output_rate,
+        previous: position,
+        timestamp: fallback,
+        remainder: denominator / 2,
+    });
+    fallback
