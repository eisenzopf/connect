 #[tokio::test]
+async fn guarded_mixer_capture_timeline_preserves_real_gaps_and_waiting_rate_conversion() {
+    for output_rate in [8000, 48000] {
+        for waiting in [false, true] {
+            let output = if output_rate == 8000 {
+                audio()
+            } else {
+                MediaFormat::Encoded {
+                    name: "opus".into(),
+                    clock_rate_hz: 48000,
+                    channels: 1,
+                    fmtp: None,
+                }
+            };
+            let people = vec![
+                ("source", "alice", audio(), 0),
+                (
+                    "target",
+                    "bob",
+                    output,
+                    if output_rate == 8000 { 0 } else { 111 },
+                ),
+            ];
+            let s = Scene::new(&people, 48000).await;
+            s.bind(0, true).await;
+            s.bind(1, false).await;
+            let mut out = s.port(1).take_egress().unwrap();
+            let live = Arc::new(std::sync::atomic::AtomicBool::new(true));
+            let start = u32::MAX - 79;
+            let mut clock = source_clock(72, 8000, start, 100u64 << 32, live);
+            clock.rtp_offset = 160;
+            if waiting {
+                clock.anchor = None;
+            }
+            s.publish_clocked_ms(0, 1000, start, 10, Some(clock.clone()));
+            s.publish_clocked_ms(0, 1000, start.wrapping_add(80), 10, Some(clock.clone()));
+            s.mixer.tick();
+            let first = mixed_frame(out.try_recv().unwrap()).await;
+            s.mixer.tick();
+            assert!(out.try_recv().is_err());
+            // This time 40ms of actual source PCM is absent. Preserve that
+            // gap even though only one output tick was empty.
+            s.publish_clocked_ms(0, 1000, start.wrapping_add(480), 20, Some(clock.clone()));
+            s.mixer.tick();
+            let next = mixed_frame(out.try_recv().unwrap()).await;
+            assert_eq!(
+                next.timestamp_rtp.wrapping_sub(first.timestamp_rtp),
+                output_rate * 3 / 50
+            );
+            s.publish_clocked_ms(0, 1000, start.wrapping_add(640), 20, Some(clock));
+            s.mixer.tick();
+            let last = mixed_frame(out.try_recv().unwrap()).await;
+            assert_eq!(
+                last.timestamp_rtp.wrapping_sub(next.timestamp_rtp),
+                output_rate / 50
+            );
+            for frame in [first, next, last] {
+                let clock = frame.source_clock.unwrap();
+                assert!(clock.supported && (clock.is_current)());
+                assert_eq!(clock.anchor.is_none(), waiting);
+            }
+            drop(
+                s.policy
+                    .0
+                    .try_write()
+                    .expect("numeric capture timeline retained authority"),
+            );
+        }
+    }
+}
