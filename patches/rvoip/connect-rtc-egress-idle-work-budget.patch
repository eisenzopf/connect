diff --git a/crates/webrtc/rvoip-webrtc/src/media/egress_deadline.rs b/crates/webrtc/rvoip-webrtc/src/media/egress_deadline.rs
new file mode 100644
--- /dev/null
+++ b/crates/webrtc/rvoip-webrtc/src/media/egress_deadline.rs
@@ -0,0 +1,33 @@
+//! Separate an adapter's idle poll from one original packet's work budget.
+//! Nothing here admits media or renews an already-created submission control.
+use rvoip_core::staged_streams::{ControlResult, QueuedMedia, StreamControlError};
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy)]
+pub(super) enum EgressDeadline {
+    /// The public caller supplied an absolute cutoff: it remains strict.
+    Absolute(Instant),
+    /// Only canonical's bounded idle poll may start the existing work cap once
+    /// an actual queued original exists. Its original receipt cutoff still wins.
+    PollUntil(Instant),
+}
+impl EgressDeadline {
+    pub(super) fn poll_until(self) -> Instant {
+        match self {
+            Self::Absolute(until) | Self::PollUntil(until) => until,
+        }
+    }
+    pub(super) fn for_packet(self, queued: &QueuedMedia) -> ControlResult<Instant> {
+        let now = Instant::now();
+        let work_until = match self {
+            Self::Absolute(until) => until,
+            Self::PollUntil(_) => now + Duration::from_millis(100),
+        };
+        let until = work_until.min(queued.original_realtime_deadline()?);
+        if now >= until {
+            Err(StreamControlError::Deadline)
+        } else {
+            Ok(until)
+        }
+    }
+}
