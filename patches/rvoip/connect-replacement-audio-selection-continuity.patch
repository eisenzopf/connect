+
+    fn exact_audience_unchanged(
+        &self,
+        previous: &[AudioAudienceRule],
+        next: &[AudioAudienceRule],
+    ) -> bool {
+        !self.selections.is_empty() && self.selections.iter().all(|selection| {
+            // A participant can resolve to a different publisher. Only a
+            // selection pinned to the original physical owner can prove this.
+            if matches!(selection.request, AudioSubscription::Participant(_)) {
+                return false;
+            }
+            let Some(publisher) = selection.publisher.upgrade() else {
+                return false;
+            };
+            if publisher.shutdown.is_cancelled() || !selection.owner_matches(&publisher) {
+                return false;
+            }
+            let allowed = |rules: &[AudioAudienceRule]| {
+                rules.iter().all(|rule| {
+                    rule.inside == rule.group.contains_principal(&publisher, &selection.owner)
+                })
+            };
+            allowed(previous) == allowed(next)
+        })
     }
 }
