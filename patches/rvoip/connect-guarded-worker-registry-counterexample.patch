@@ -1626,3 +1626,31 @@
 mod lookahead;
 
 mod late_source_catchup;
+
+// The actual production Conference worker must not depend on the unrelated
+// unguarded member registry when the guarded scene owns its own routes.
+#[tokio::test]
+async fn original_guarded_worker_delivers_audio_while_unguarded_registry_is_locked() {
+    let mut s = Scene::new(&four()[..2], 8000).await;
+    let conference = crate::conference::Conference::start_staged(
+        8000,
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        s.policy.clone(),
+    );
+    let held = conference.members.clone().lock_owned().await;
+    conference.started_for_test.notified().await;
+    s.mixer = conference.staged.as_ref().unwrap().clone();
+    s.bind(0, true).await;
+    s.bind(1, true).await;
+    let mut output = s.port(1).take_egress().unwrap();
+    s.publish_at(0, 1200, 160);
+    let result = tokio::time::timeout(Duration::from_millis(100), output.recv()).await;
+    // Always stop and join the original worker, including the negative run.
+    conference.task.abort();
+    drop(held);
+    conference.task.join().await.unwrap();
+    let packet = result.expect("guarded audio waited for the unguarded conference registry")
+        .expect("guarded audio output closed");
+    heard(packet, 1200).await;
+}
