--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/direct_subscriptions.rs
@@ -0,0 +1,463 @@
+//! Exact receiver bindings for unmixed video, screen and reliable data.
+//! Intent is retained across transport replacement; grants are never retained.
+use super::*;
+use rvoip_core_traits::peer_switch::PeerDeliveryGuard;
+
+#[derive(Clone)]
+pub struct DirectSubscription {
+    publisher: Weak<StreamController>,
+    pub source: audio_subscriptions::MediaStreamRef,
+    pub receiver: StreamId,
+}
+impl DirectSubscription {
+    /// Trusted process-local selection, not a wire authorization assertion.
+    pub fn new(publisher: &Arc<StreamController>, logical: StreamId, receiver: StreamId) -> Self {
+        Self {
+            publisher: Arc::downgrade(publisher),
+            source: audio_subscriptions::MediaStreamRef {
+                connection: publisher.connection.clone(),
+                logical,
+            },
+            receiver,
+        }
+    }
+    pub fn publisher(&self) -> Option<Arc<StreamController>> {
+        self.publisher.upgrade()
+    }
+    fn same(&self, other: &Self) -> bool {
+        self.source == other.source
+            && self.receiver == other.receiver
+            && Weak::ptr_eq(&self.publisher, &other.publisher)
+    }
+    fn matches(&self, source: &StreamController, logical: &StreamId) -> bool {
+        self.source.connection == source.connection
+            && &self.source.logical == logical
+            && self
+                .publisher
+                .upgrade()
+                .is_some_and(|owner| std::ptr::eq(owner.as_ref(), source))
+    }
+}
+impl PartialEq for DirectSubscription {
+    fn eq(&self, other: &Self) -> bool {
+        self.same(other)
+    }
+}
+impl Eq for DirectSubscription {}
+#[derive(Clone, PartialEq, Eq)]
+pub enum DirectSubscriptionChange {
+    Subscribe(Vec<DirectSubscription>),
+    /// Exact receiver logical IDs. Unknown removals are idempotent.
+    Unsubscribe(Vec<StreamId>),
+    Clear,
+}
+struct Route {
+    selection: DirectSubscription,
+    ticket: PeerRouteTicket,
+    started: Instant,
+}
+impl Drop for Route {
+    fn drop(&mut self) {
+        self.ticket.retire_if_current();
+    }
+}
+struct Routing {
+    program: BTreeMap<StreamId, Arc<Route>>,
+}
+pub(super) struct DirectGate {
+    routing: Mutex<Routing>,
+    cancel: CancellationToken,
+}
+impl DirectGate {
+    pub(super) fn new(cancel: CancellationToken) -> Arc<Self> {
+        Arc::new(Self {
+            routing: Mutex::new(Routing {
+                program: BTreeMap::new(),
+            }),
+            cancel,
+        })
+    }
+    pub(super) fn stamp(
+        self: &Arc<Self>,
+        source: &StreamController,
+        logical: &StreamId,
+        receiver: &StreamId,
+        admitted: Instant,
+    ) -> ControlResult<DirectStamp> {
+        let state = self.routing.lock().unwrap_or_else(|p| p.into_inner());
+        let selection = state
+            .program
+            .get(receiver)
+            .filter(|route| route.selection.matches(source, logical))
+            .ok_or(StreamControlError::Authority)?;
+        if admitted < selection.started || self.cancel.is_cancelled() {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(DirectStamp {
+            gate: Arc::downgrade(self),
+            ticket: selection.ticket.clone(),
+            selection: selection.selection.clone(),
+            cancel: self.cancel.clone(),
+        })
+    }
+}
+impl Drop for DirectGate {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+        for route in self
+            .routing
+            .get_mut()
+            .unwrap_or_else(|p| p.into_inner())
+            .program
+            .values()
+        {
+            route.ticket.retire_if_current();
+        }
+    }
+}
+#[derive(Clone)]
+pub(super) struct DirectStamp {
+    gate: Weak<DirectGate>,
+    ticket: PeerRouteTicket,
+    selection: DirectSubscription,
+    pub(super) cancel: CancellationToken,
+}
+impl DirectStamp {
+    pub(super) fn begin(
+        &self,
+        target: &StreamController,
+        port: &Port,
+        source: &MediaSource,
+    ) -> ControlResult<PeerDeliveryGuard> {
+        if !Weak::ptr_eq(&self.gate, &Arc::downgrade(&target.direct_subscriptions))
+            || self.cancel.is_cancelled()
+            || !self.ticket.is_current()
+            || self.selection.receiver != port.binding.negotiated.requested.logical_id
+            || self.selection.source.connection != source.connection
+            || self.selection.source.logical != source.logical_id
+        {
+            return Err(StreamControlError::Authority);
+        }
+        // No new controller, member epoch or credential owner may borrow intent.
+        let publisher = self
+            .selection
+            .publisher
+            .upgrade()
+            .ok_or(StreamControlError::NotReady)?;
+        if publisher.origin_member.participant() != &source.participant
+            || publisher.origin_member.epoch() != source.membership_epoch
+            || publisher.conversation != source.conversation
+            || publisher.session != source.session
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)
+    }
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+}
+fn validate(change: &DirectSubscriptionChange) -> ControlResult<()> {
+    let valid = match change {
+        DirectSubscriptionChange::Subscribe(items) => {
+            !items.is_empty()
+                && items.len() <= 32
+                && items.iter().all(|s| {
+                    identifier(s.source.connection.as_str())
+                        && identifier(s.source.logical.as_str())
+                        && identifier(s.receiver.as_str())
+                })
+                && items
+                    .iter()
+                    .map(|s| &s.receiver)
+                    .collect::<BTreeSet<_>>()
+                    .len()
+                    == items.len()
+        }
+        DirectSubscriptionChange::Unsubscribe(items) => {
+            !items.is_empty() && items.len() <= 32 && items.iter().all(|s| identifier(s.as_str()))
+        }
+        DirectSubscriptionChange::Clear => true,
+    };
+    if valid {
+        Ok(())
+    } else {
+        Err(MediaTransitionError::Invalid.into())
+    }
+}
+impl StreamController {
+    /// Apply explicit unmixed subscriptions on this receiver's stream revision.
+    /// Public handlers must compose this trusted SPI with durable receipts and
+    /// the exact held authority hook; this method does not create wire commands.
+    pub async fn change_direct_subscriptions(
+        self: &Arc<Self>,
+        expected: u64,
+        change: DirectSubscriptionChange,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<u64> {
+        validate(&change)?;
+        let _flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let credential = self.credential_snapshot();
+        let scope = self.scope(&credential.principal, MediaPurpose::Control);
+        let control = match held {
+            Some(held) => Some(self.policy.current_control(
+                &scope,
+                &MediaControlIntent::DirectSubscriptions {
+                    expected,
+                    change: &change,
+                },
+                held,
+            )?),
+            None => None,
+        };
+        let deadline = Self::command_deadline(&credential.principal, deadline)
+            .min(control.as_ref().map_or(deadline, |c| c.deadline));
+        direct_invocation(self, &credential, control.as_ref(), deadline, &cancel)?;
+        let gate = &self.direct_subscriptions;
+        let (program, old) = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let lease = control_read(self.policy.as_ref(), &scope, control.as_ref())?;
+            Self::check(&scope, lease.authority())?;
+            state
+                .model
+                .check_routing(&lease.authority().current(), expected)?;
+            let routing = gate.routing.lock().unwrap_or_else(|p| p.into_inner());
+            let old = routing.program.clone();
+            let mut program = old
+                .iter()
+                .map(|(id, r)| (id.clone(), r.selection.clone()))
+                .collect::<BTreeMap<_, _>>();
+            drop(routing);
+            match &change {
+                DirectSubscriptionChange::Subscribe(items) => {
+                    for selection in items {
+                        program.insert(selection.receiver.clone(), selection.clone());
+                    }
+                }
+                DirectSubscriptionChange::Unsubscribe(items) => {
+                    for id in items {
+                        program.remove(id);
+                    }
+                }
+                DirectSubscriptionChange::Clear => program.clear(),
+            }
+            if program.len() > 32 {
+                return Err(MediaTransitionError::Capacity.into());
+            }
+            let _receive = self.validate_direct(&state, &scope, &change, control.as_ref())?;
+            direct_invocation(self, &credential, control.as_ref(), deadline, &cancel)?;
+            (program, old)
+        };
+        let changed = old
+            .keys()
+            .chain(program.keys())
+            .filter(|id| match (old.get(*id), program.get(*id)) {
+                (Some(old), Some(next)) => !old.selection.same(next),
+                _ => true,
+            })
+            .cloned()
+            .collect::<BTreeSet<_>>();
+        let mut staged = BTreeMap::new();
+        for id in &changed {
+            if program.contains_key(id) {
+                let ticket = match old.get(id) {
+                    Some(old) => old.ticket.stage().ok_or(MediaTransitionError::Capacity)?,
+                    None => PeerRouteTicket::initial(),
+                };
+                staged.insert(id.clone(), ticket);
+            }
+        }
+        let held_cancel = control.as_ref().map(|c| c.cancellation.clone());
+        let mut drained = Vec::new();
+        for id in &changed {
+            if let Some(old) = old.get(id) {
+                drained.push(tokio::select! {
+                    biased;
+                    _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+                    _=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),
+                    _=async {match &held_cancel {Some(c)=>c.cancelled().await,None=>std::future::pending::<()>().await}}=>return Err(StreamControlError::Cancelled),
+                    result=tokio::time::timeout_at(deadline,old.ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+                });
+            }
+        }
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let lease = control_read(self.policy.as_ref(), &scope, control.as_ref())?;
+        Self::check(&scope, lease.authority())?;
+        let _receive = self.validate_direct(&state, &scope, &change, control.as_ref())?;
+        let mut routing = gate.routing.lock().unwrap_or_else(|p| p.into_inner());
+        direct_invocation(self, &credential, control.as_ref(), deadline, &cancel)?;
+        if state.closed
+            || gate.cancel.is_cancelled()
+            || old.values().any(|r| !r.ticket.is_current())
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        let revision = state.model.commit_routing(
+            &lease.authority().current(),
+            expected,
+            !changed.is_empty(),
+        )?;
+        for id in changed {
+            match program.get(&id) {
+                Some(selection) => {
+                    let next = staged.remove(&id).expect("changed route staged its ticket");
+                    if let Some(previous) = old.get(&id) {
+                        assert!(
+                            next.commit_from(&previous.ticket),
+                            "direct routing changed outside controller fence"
+                        );
+                    }
+                    routing.program.insert(
+                        id,
+                        Arc::new(Route {
+                            selection: selection.clone(),
+                            ticket: next,
+                            started: Instant::now(),
+                        }),
+                    );
+                }
+                None => {
+                    if let Some(previous) = old.get(&id) {
+                        assert!(
+                            previous.ticket.retire_if_current(),
+                            "direct route retired outside controller fence"
+                        );
+                    }
+                    routing.program.remove(&id);
+                }
+            }
+        }
+        drop(routing);
+        drop(drained);
+        Ok(revision)
+    }
+    fn validate_direct(
+        &self,
+        state: &State,
+        scope: &MediaScope<'_>,
+        change: &DirectSubscriptionChange,
+        control: Option<&MediaControl>,
+    ) -> ControlResult<Vec<ControlRead>> {
+        let DirectSubscriptionChange::Subscribe(items) = change else {
+            return Ok(Vec::new());
+        };
+        let mut leases = Vec::new();
+        for selection in items {
+            let publisher = selection
+                .publisher
+                .upgrade()
+                .ok_or(StreamControlError::NotReady)?;
+            if publisher.connection != selection.source.connection
+                || publisher.conversation != self.conversation
+                || publisher.session != self.session
+                || !Arc::ptr_eq(&publisher.policy, &self.policy)
+            {
+                return Err(StreamControlError::Authority);
+            }
+            let target = Self::direct_port(state, &selection.receiver)?;
+            let binding = if std::ptr::eq(publisher.as_ref(), self) {
+                Self::direct_port(state, &selection.source.logical)?
+                    .binding
+                    .clone()
+            } else {
+                let source_state = publisher
+                    .state
+                    .try_lock()
+                    .map_err(|_| MediaTransitionError::Conflict)?;
+                Self::direct_port(&source_state, &selection.source.logical)?
+                    .binding
+                    .clone()
+            };
+            let medium = binding.negotiated.requested.medium;
+            if medium == Medium::Audio
+                || medium != target.binding.negotiated.requested.medium
+                || binding.negotiated.format != target.binding.negotiated.format
+                || binding.negotiated.requested.direction == StreamDirection::Send
+                || target.binding.negotiated.requested.direction == StreamDirection::Receive
+            {
+                return Err(StreamControlError::Unsupported);
+            }
+            if publisher.shutdown.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            let descriptor = MediaSource {
+                conversation: self.conversation.clone(),
+                session: self.session.clone(),
+                connection: publisher.connection.clone(),
+                participant: publisher.origin_member.participant().clone(),
+                membership_epoch: publisher.origin_member.epoch(),
+                connection_generation: binding.connection_generation,
+                logical_id: selection.source.logical.clone(),
+                transport_id: binding.transport_id,
+                stream_generation: binding.generation,
+            };
+            let receive_scope = MediaScope {
+                purpose: MediaPurpose::Receive {
+                    source: &descriptor,
+                },
+                ..*scope
+            };
+            let authority = match control {
+                Some(c) => {
+                    c.valid()?;
+                    ControlRead::Held(c.lease.control_receive(&descriptor)?)
+                }
+                None => ControlRead::Current(self.policy.current(&receive_scope)?),
+            };
+            Self::check(&receive_scope, authority.authority())?;
+            if !authority.authority().may_route_source
+                || !authority.authority().send_media.contains(&medium)
+            {
+                return Err(StreamControlError::Authority);
+            }
+            leases.push(authority);
+        }
+        Ok(leases)
+    }
+    fn direct_port<'a>(state: &'a State, logical: &StreamId) -> ControlResult<&'a Arc<Port>> {
+        if state.closed
+            || state
+                .model
+                .streams()
+                .get(logical)
+                .is_none_or(|s| s.state == LogicalStreamState::Ended)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        state
+            .active
+            .get(logical)
+            .ok_or(StreamControlError::NotReady)
+    }
+}
+
+fn direct_invocation(
+    controller: &StreamController,
+    credential: &CredentialSnapshot,
+    control: Option<&MediaControl>,
+    deadline: tokio::time::Instant,
+    cancel: &CancellationToken,
+) -> ControlResult<()> {
+    if cancel.is_cancelled() || controller.shutdown.is_cancelled() {
+        return Err(StreamControlError::Cancelled);
+    }
+    if tokio::time::Instant::now() >= deadline {
+        return Err(StreamControlError::Deadline);
+    }
+    if let Some(c) = control {
+        c.valid()?;
+    }
+    controller.check_credential_snapshot(credential)
+}
