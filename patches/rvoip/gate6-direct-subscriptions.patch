+        })
+        .await
+        .unwrap();
+    // The receiver can renegotiate independently; its new codec cannot borrow the
+    // former source's subscription as permission to forward incompatible packets.
+    {
+        let mut state = f.policy.0.write().await;
+        let owner = state.owners.get_mut("bob").unwrap();
+        for caps in [&mut owner.local, &mut owner.remote] {
+            for c in caps.send.iter_mut().chain(caps.receive.iter_mut()) {
+                if c.medium == Medium::Screen {
+                    c.formats = vec![MediaFormat::Encoded {
+                        name: "h264".into(),
+                        clock_rate_hz: 90000,
+                        channels: 0,
+                        fmtp: None,
+                    }];
+                }
+            }
+        }
+    }
+    f.b.change(
+        f.b.revision(),
+        &[DesiredStream {
+            logical_id: logical.clone(),
+            medium: Medium::Screen,
+            direction: StreamDirection::Both,
+        }],
+        &[logical.clone()].into_iter().collect(),
+        deadline(),
+        CancellationToken::new(),
+    )
+    .await
+    .unwrap();
+    let before = f.b.revision();
+    assert!(matches!(
+        route(&f, DirectSubscriptionChange::Subscribe(vec![select])).await,
+        Err(StreamControlError::Unsupported)
