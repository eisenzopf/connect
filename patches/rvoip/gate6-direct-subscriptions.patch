+    let port = f.b.state.lock().unwrap().active[&logical].clone();
+    let mut output = AdapterMediaPort(port.clone()).take_egress().unwrap();
+    publish(&f, Medium::Screen, &mut input, 10)
+        .await
+        .try_forward_to(&f.b, &logical)
+        .unwrap();
+    let stale = outgoing(&mut output).await;
+    f.b.set_paused(&logical, f.b.revision(), true, deadline())
+        .await
+        .unwrap();
+    assert!(stale
+        .deliver(|_| async { panic!("paused receiver reached IO") })
+        .await
+        .is_err());
+    assert!(publish(&f, Medium::Screen, &mut input, 20)
+        .await
+        .try_forward_to(&f.b, &logical)
+        .is_err());
+    f.b.set_paused(&logical, f.b.revision(), false, deadline())
+        .await
+        .unwrap();
+    publish(&f, Medium::Screen, &mut input, 30)
+        .await
+        .try_forward_to(&f.b, &logical)
+        .unwrap();
+    let transport = port.binding.transport_id.clone();
+    outgoing(&mut output)
+        .await
+        .deliver(|v| async move {
+            assert_eq!(v.stream_id, transport);
