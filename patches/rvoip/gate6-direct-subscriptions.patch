+    assert_eq!(before, f.b.revision());
+    assert!(publish(&f, Medium::Screen, &mut input, 40)
+        .await
+        .try_forward_to(&f.b, &logical)
+        .is_err());
+    f.b.end_stream(&logical, f.b.revision(), deadline())
+        .await
+        .unwrap();
+    route(&f, DirectSubscriptionChange::Clear).await.unwrap();
+}
+
+#[tokio::test]
+async fn direct_video_removal_does_not_drain_or_invalidate_unrelated_reliable_data() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video, Medium::Data]).await;
+    let mut input = f.a.take_ingress(&desired(Medium::Data).logical_id).unwrap();
+    let mut output = f.ba.port(Medium::Data).take_egress().unwrap();
+    for seq in 0..2 {
+        publish(&f, Medium::Data, &mut input, seq)
+            .await
+            .try_forward_to(&f.b, &desired(Medium::Data).logical_id)
+            .unwrap();
+    }
+    let first = outgoing(&mut output).await;
+    let queued = outgoing(&mut output).await;
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let sending = tokio::spawn({
+        let entered = entered.clone();
+        let release = release.clone();
+        async move {
+            first
+                .deliver(|_| async move {
+                    entered.notify_one();
+                    release.notified().await;
+                    Ok(())
+                })
+                .await
+        }
+    });
+    entered.notified().await;
+    tokio::time::timeout(
+        Duration::from_millis(50),
+        route(
+            &f,
+            DirectSubscriptionChange::Unsubscribe(vec![desired(Medium::Video).logical_id]),
+        ),
+    )
+    .await
+    .expect("video change waited for unrelated data IO")
+    .unwrap();
+    queued
+        .deliver(|v| async move {
+            assert_eq!(
+                serde_json::from_slice::<serde_json::Value>(&v.payload).unwrap()["sequence"],
+                1
+            );
+            Ok(())
+        })
+        .await
+        .unwrap();
+    release.notify_one();
+    sending.await.unwrap().unwrap();
+}
