+#[tokio::test]
+async fn held_message_publication_uses_exact_invocation_guard_behind_a_queued_policy_writer() {
+    let f = fixture(DataProtocol::Json, true).await;
+    let s = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let held = held_context(&f, CancellationToken::new(), deadline()).await;
+    let mut writer = tokio::spawn({
+        let state = f.policy.0.clone();
+        async move { state.write_owned().await }
+    });
+    assert!(tokio::time::timeout(Duration::from_millis(15), &mut writer)
+        .await
+        .is_err());
+    let source = f.aa.port(Medium::Data);
+    let data = message(0);
+    assert!(source.try_publish_data(&data, None).is_err());
+    source.try_publish_data(&data, Some(held.as_ref())).unwrap();
+    s.tick();
+    assert!(
+        out.try_recv().is_err(),
+        "outgoing delivery needs a fresh grant"
+    );
+    held.cancellation.cancel();
+    assert!(source
+        .try_publish_data(&message(1), Some(held.as_ref()))
+        .is_err());
+    drop(held);
+    drop(
+        tokio::time::timeout(Duration::from_millis(100), writer)
+            .await
+            .unwrap()
+            .unwrap(),
+    );
+    s.tick();
+    let attempt = outgoing(&mut out).await.admit_data().unwrap();
+    assert_eq!(attempt.data().message(), data.message());
+    attempt.cancel();
+}
