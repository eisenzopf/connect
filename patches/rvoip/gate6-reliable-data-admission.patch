+//! Controlled-policy Core tests. These do not qualify a native physical writer.
+use super::*;
+use crate::staged_streams::{
+    direct_subscriptions::*, media_scene::GuardedMediaScene, reliable_data::*,
+};
+use crate::{DataMessage, DataReliability};
+
+#[derive(Clone)]
+struct Context {
+    operation: String,
+    original: DataMessage,
+    source: ConnectionId,
+    receiver: ConnectionId,
+}
+struct DataPolicy(Arc<Policy>);
+impl MediaPolicy for DataPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.0.current(scope)
+    }
+    fn current_data(
+        &self,
+        scope: &MediaScope<'_>,
+        data: &StagedData,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let context = data
+            .context::<Context>()
+            .ok_or(StreamControlError::Authority)?;
+        if data.message() != &context.original || context.operation.is_empty() {
+            return Err(StreamControlError::Authority);
+        }
+        match scope.purpose {
+            MediaPurpose::Publish if scope.connection == &context.source => {}
+            MediaPurpose::Receive { source }
+                if scope.connection == &context.receiver && source.connection == context.source => {
+            }
+            _ => return Err(StreamControlError::Authority),
+        }
+        if let Some(held) = held {
+            let held = held
+                .downcast_ref::<HeldControlContext>()
+                .ok_or(StreamControlError::Authority)?;
+            if !matches!(scope.purpose, MediaPurpose::Publish)
+                || !Arc::ptr_eq(&held.domain, &self.0)
+                || held.connection != *scope.connection
+                || !same_credential(&held.principal, scope.principal)
+                || held.cancellation.is_cancelled()
+                || held.deadline <= tokio::time::Instant::now()
+                || held.guard.revoked.contains(&scope.principal.subject)
+            {
+                return Err(StreamControlError::Authority);
+            }
+            let owner = held
+                .guard
+                .owners
+                .get(scope.connection.as_str())
+                .ok_or(StreamControlError::Authority)?
+                .clone();
+            return Ok(Box::new(HeldOwnerLease {
+                owner,
+                _guard: held.guard.clone(),
+            }));
+        }
+        self.0.current(scope)
+    }
+}
+fn data(body: impl Into<Bytes>, mime: &str) -> StagedData {
+    let original = DataMessage::reliable("data", mime, body);
+    StagedData::new(
+        original.clone(),
+        Context {
+            original,
+            operation: "stable-operation".into(),
+            source: ConnectionId::from_string("alice"),
+            receiver: ConnectionId::from_string("bob"),
+        },
+    )
+    .unwrap()
+}
+fn message(sequence: u32) -> StagedData {
+    data(format!("{{\"sequence\":{sequence}}}"), "application/json")
+}
+async fn fixture(protocol: DataProtocol, messages_only: bool) -> Fixture {
+    let f = Fixture::with_policy(8, Some(Box::new(|base| Arc::new(DataPolicy(base)))));
+    {
+        let mut state = f.policy.0.write().await;
+        for owner in state.owners.values_mut() {
+            for capabilities in [&mut owner.local, &mut owner.remote] {
+                for direction in [&mut capabilities.send, &mut capabilities.receive] {
+                    direction
+                        .iter_mut()
+                        .find(|cap| cap.medium == Medium::Data)
+                        .unwrap()
+                        .formats = vec![MediaFormat::ReliableOrdered(protocol.clone())];
+                }
+            }
+        }
+    }
+    if messages_only {
+        f.aa.mode.store(5, Ordering::Release);
+        f.ba.mode.store(5, Ordering::Release);
+    }
+    f.start(&[Medium::Data]).await;
+    f
+}
+async fn scene(f: &Fixture) -> Arc<GuardedMediaScene> {
+    let s = GuardedMediaScene::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        f.a.policy.clone(),
+        8000,
+    );
+    for c in [&f.a, &f.b] {
+        let mut candidate = s.prepare(c.clone()).unwrap();
+        candidate
+            .quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        s.insert(c.connection.clone(), candidate, true);
+    }
+    s
+}
+async fn queued(
+    f: &Fixture,
+    s: &GuardedMediaScene,
+    output: &mut mpsc::Receiver<QueuedMedia>,
+    data: &StagedData,
+) -> QueuedMedia {
+    f.aa.port(Medium::Data)
+        .try_publish_data(data, None)
+        .unwrap();
+    s.tick();
+    outgoing(output).await
+}
