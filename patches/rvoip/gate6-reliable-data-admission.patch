+#[tokio::test]
+async fn temporary_port_quiescence_drains_the_same_one_use_writer_guard() {
+    let f = fixture(DataProtocol::Json, true).await;
+    let s = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let q = queued(&f, &s, &mut out, &message(0)).await;
+    let attempt = q.admit_data().unwrap();
+    let writing = attempt.begin_write().unwrap();
+    let ticket = f.aa.port(Medium::Data).0.ticket();
+    let mut drain = Box::pin(ticket.quiesce());
+    assert!(tokio::time::timeout(Duration::from_millis(15), &mut drain)
+        .await
+        .is_err());
+    assert!(
+        attempt.current(),
+        "temporary drain must allow already-admitted IO to finish"
+    );
+    let mut cancelled = Box::pin(attempt.cancelled());
+    assert!(
+        tokio::time::timeout(Duration::from_millis(15), &mut cancelled)
+            .await
+            .is_err()
+    );
+    drop(cancelled);
+    drop(writing);
+    let pause = tokio::time::timeout(Duration::from_millis(100), drain)
+        .await
+        .unwrap()
+        .unwrap();
+    drop(pause);
+    assert!(f.policy.0.try_write().is_ok());
+}
