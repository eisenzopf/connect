+#[test]
+fn exact_data_credential_checks_scopes_expiry_method_and_full_assurance_claims() {
+    let a = principal("alice");
+    assert!(same_credential(&a, &a.clone()));
+    let mut changed_method = a.clone();
+    changed_method.method = AuthenticationMethod::ApiKey;
+    assert!(!same_credential(&a, &changed_method));
+    let mut b = a.clone();
+    b.scopes.push("new-grant".into());
+    assert!(!same_credential(&a, &b));
+    let mut b = a.clone();
+    b.expires_at = Some(chrono::Utc::now());
+    assert!(!same_credential(&a, &b));
+    let mut b = a.clone();
+    b.assurance = IdentityAssurance::UserAuthorized {
+        identity: IdentityId::from_string("alice"),
+        user_id: IdentityId::from_string("user"),
+        scopes: vec!["send".into()],
+    };
+    let mut c = b.clone();
+    c.assurance = IdentityAssurance::UserAuthorized {
+        identity: IdentityId::from_string("alice"),
+        user_id: IdentityId::from_string("another-user"),
+        scopes: vec!["send".into()],
+    };
+    assert!(!same_credential(&b, &c));
+    let mut c = b.clone();
+    c.issuer = Some("another-issuer".into());
+    assert!(!same_credential(&b, &c));
+}
