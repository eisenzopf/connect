+#[tokio::test]
+async fn aborting_guarded_callback_drops_the_io_future_and_releases_writer_guards() {
+    struct IoDrop(Arc<AtomicBool>);
+    impl Drop for IoDrop {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::Release);
+        }
+    }
+    let f = fixture(DataProtocol::Json, true).await;
+    let s = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let q = queued(&f, &s, &mut out, &message(0)).await;
+    let entered = Arc::new(Notify::new());
+    let dropped = Arc::new(AtomicBool::new(false));
+    let task = tokio::spawn({
+        let entered = entered.clone();
+        let dropped = dropped.clone();
+        async move {
+            q.deliver(move |_| async move {
+                let _io = IoDrop(dropped);
+                entered.notify_one();
+                std::future::pending::<()>().await;
+                Ok(())
+            })
+            .await
+        }
+    });
+    entered.notified().await;
+    assert!(f.policy.0.try_write().is_err());
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    assert!(dropped.load(Ordering::Acquire));
+    assert!(f.policy.0.try_write().is_ok());
+}
