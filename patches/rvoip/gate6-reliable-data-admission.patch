+    );
+    assert!(StagedData::new(oversized.clone(), ()).is_err());
+    oversized.bytes = Bytes::new();
+    for reliability in [
+        DataReliability::ReliableUnordered,
+        DataReliability::MaxRetransmits {
+            ordered: true,
+            count: 1,
+        },
+        DataReliability::MaxLifetime {
+            ordered: true,
+            milliseconds: 1,
+        },
+    ] {
+        oversized.reliability = reliability;
+        assert!(matches!(
+            StagedData::new(oversized.clone(), ()),
+            Err(StreamControlError::Unsupported)
+        ));
+    }
+    for protocol in [DataProtocol::Json, DataProtocol::Text, DataProtocol::Binary] {
+        let f = fixture(protocol.clone(), true).await;
+        let _s = scene(&f).await;
+        let source = f.aa.port(Medium::Data);
+        assert!(
+            source.require_data_messages().is_err(),
+            "live ports cannot change their profile"
+        );
+        let mut wrong = message(1).message().clone();
+        wrong.label = "another-source".into();
+        assert!(source
+            .try_publish_data(&StagedData::new(wrong, ()).unwrap(), None)
+            .is_err());
+        let empty = data(Bytes::new(), "text/plain");
+        let invalid = data(Bytes::from_static(&[0xff]), "application/octet-stream");
+        assert_eq!(
+            source.try_publish_data(&empty, None).is_ok(),
+            protocol != DataProtocol::Json
+        );
+        assert_eq!(
+            source.try_publish_data(&invalid, None).is_ok(),
+            protocol == DataProtocol::Binary
+        );
+    }
