+//! Typed application data and one-use, cancellable ownership of writer grants.
+//! Message context is immutable transport/application metadata, never authority.
+use super::*;
+use crate::{DataMessage, DataReliability};
+
+#[derive(Clone)]
+pub struct StagedData {
+    message: DataMessage,
+    context: Arc<dyn Any + Send + Sync>,
+}
+impl StagedData {
+    pub fn new<T: Any + Send + Sync>(message: DataMessage, context: T) -> ControlResult<Self> {
+        message
+            .validate()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if message.reliability != DataReliability::ReliableOrdered {
+            return Err(StreamControlError::Unsupported);
+        }
+        Ok(Self {
+            message,
+            context: Arc::new(context),
+        })
+    }
+    pub fn message(&self) -> &DataMessage {
+        &self.message
+    }
+    pub fn context<T: Any + Send + Sync>(&self) -> Option<&T> {
+        self.context.downcast_ref()
+    }
+}
+impl std::fmt::Debug for StagedData {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("StagedData(redacted)")
+    }
+}
+impl AdapterMediaPort {
+    /// Restrict a prepared data port to the typed reliable-message profile.
+    /// Generic frames cannot discard logical message identity at this boundary.
+    pub fn require_data_messages(&self) -> ControlResult<()> {
+        let mut state = self.0.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.status != PortStatus::Prepared || self.0.kind() != StreamKind::Data {
+            return Err(StreamControlError::NotReady);
+        }
+        state.messages_only = true;
+        Ok(())
+    }
+    pub fn try_publish_data(
+        &self,
+        data: &StagedData,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<()> {
+        if self.0.kind() != StreamKind::Data
+            || data.message.label != self.0.binding.negotiated.requested.logical_id.as_str()
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let frame = MediaFrame {
+            stream_id: self.0.binding.transport_id.clone(),
+            kind: StreamKind::Data,
+            payload: data.message.bytes.clone(),
+            timestamp_rtp: 0,
+            source_clock: None,
+            captured_at: chrono::Utc::now(),
+            payload_type: None,
+        };
+        self.publish_data_frame(&frame, Some(data), held)
+    }
+}
+struct OwnedGuards {
+    _leases: Vec<Box<dyn MediaAuthorityLease>>,
+    _admissions: Vec<audio_consumer::MediaAdmission>,
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Phase {
+    Pending,
+    Writing,
+    Cancelled,
+    Done,
+}
+struct AdmissionState {
+    phase: Phase,
+    guards: Option<OwnedGuards>,
+}
+/// Exact target observed under the retained current message grant. An origin
+/// must additionally bind this target to its authenticated physical writer.
+pub struct DataTarget {
+    owner: Weak<StreamController>,
+    pub conversation: ConversationId,
+    pub session: SessionId,
+    pub connection: ConnectionId,
+    pub participant: crate::ids::ParticipantId,
+    pub identity: crate::ids::IdentityId,
+    pub device: crate::ids::DeviceId,
+    pub membership_epoch: u64,
+    pub principal: Arc<AuthenticatedPrincipal>,
+    pub binding: ReadyMediaBinding,
+    pub credential_revision: u64,
+}
+impl DataTarget {
+    pub fn belongs_to(&self, controller: &Arc<StreamController>) -> bool {
+        Weak::ptr_eq(&self.owner, &Arc::downgrade(controller))
+    }
+}
+impl std::fmt::Debug for DataTarget {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DataTarget(redacted)")
+    }
+}
+/// One fresh local delivery attempt. Pending cancellation releases its readers
+/// even if a stalled physical actor has not dequeued it. Once writing begins,
+/// only DataWriteGuard owns those readers until IO finishes or is aborted.
+#[must_use = "retain cancellation custody until the physical writer finishes"]
+pub struct AdmittedData {
+    state: Mutex<AdmissionState>,
+    data: StagedData,
+    frame: MediaFrame,
+    source: MediaSource,
+    target: DataTarget,
+    tickets: Vec<PeerRouteTicket>,
+    tokens: Vec<CancellationToken>,
+    cancel: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl std::fmt::Debug for AdmittedData {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("AdmittedData(redacted)")
+    }
+}
+impl AdmittedData {
+    pub fn data(&self) -> &StagedData {
+        &self.data
+    }
+    pub fn source(&self) -> &MediaSource {
+        &self.source
+    }
+    pub fn target(&self) -> &DataTarget {
+        &self.target
+    }
+    pub fn deadline(&self) -> tokio::time::Instant {
+        self.deadline
+    }
+    fn valid(&self) -> bool {
+        tokio::time::Instant::now() < self.deadline
+            && !self.cancel.is_cancelled()
+            && !self.tokens.iter().any(CancellationToken::is_cancelled)
+            && self.tickets.iter().all(PeerRouteTicket::is_current)
+    }
+    pub fn current(&self) -> bool {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        matches!(state.phase, Phase::Pending | Phase::Writing) && self.valid()
+    }
+    /// The producer retains this handle while its attempt is queued or being
+    /// written. Dropping it cancels pending work and wakes an active writer,
+    /// whose non-cloneable guard alone retains authority through IO abortion.
+    pub fn cancel_on_drop(self: &Arc<Self>) -> DataCancellation {
+        DataCancellation(self.clone())
+    }
+    pub fn cancel(&self) {
+        self.cancel.cancel();
+        let guards = {
+            let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state.phase == Phase::Pending {
+                state.phase = Phase::Cancelled;
+                state.guards.take()
+            } else {
+                None
+            }
+        };
+        drop(guards);
+    }
+    pub async fn cancelled(&self) {
+        let mut tokens = self.tokens.clone();
+        tokens.push(self.cancel.clone());
+        let mut invalidated = self
+            .tickets
+            .iter()
+            .map(|ticket| Box::pin(ticket.invalidated()))
+            .collect::<Vec<_>>();
+        let retired = std::future::poll_fn(move |context| {
+            for future in &mut invalidated {
+                if future.as_mut().poll(context).is_ready() {
+                    return std::task::Poll::Ready(());
+                }
+            }
+            std::task::Poll::Pending
+        });
+        tokio::select! {biased;_=audio_consumer::any_cancelled(tokens)=>{},_=retired=>{},_=tokio::time::sleep_until(self.deadline)=>{}}
+        self.cancel();
+    }
+    pub fn begin_write(self: &Arc<Self>) -> ControlResult<DataWriteGuard> {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.phase != Phase::Pending || !self.valid() {
+            let guards = if state.phase == Phase::Pending {
+                state.phase = Phase::Cancelled;
+                state.guards.take()
+            } else {
+                None
+            };
+            drop(state);
+            drop(guards);
+            return Err(StreamControlError::Cancelled);
+        }
+        let guards = state.guards.take().ok_or(StreamControlError::Cancelled)?;
+        state.phase = Phase::Writing;
+        Ok(DataWriteGuard {
+            admission: self.clone(),
+            _guards: guards,
+        })
+    }
+}
+impl Drop for AdmittedData {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+    }
+}
+/// Producer-side cancellation custody, independent of copies in writer queues.
+#[must_use]
+pub struct DataCancellation(Arc<AdmittedData>);
+impl Drop for DataCancellation {
+    fn drop(&mut self) {
+        self.0.cancel();
+    }
+}
+/// Must remain owned by the actual awaited physical writer; never a detached
+/// producer. It is not Clone and a ticket can begin writing at most once.
+#[must_use = "retain this guard through actual IO completion or abortion"]
+pub struct DataWriteGuard {
+    admission: Arc<AdmittedData>,
+    _guards: OwnedGuards,
+}
+impl DataWriteGuard {
+    pub fn frame(&self) -> &MediaFrame {
+        &self.admission.frame
+    }
+    pub fn data(&self) -> &StagedData {
+        &self.admission.data
+    }
+    pub fn source(&self) -> &MediaSource {
+        &self.admission.source
+    }
+    pub fn target(&self) -> &DataTarget {
+        &self.admission.target
+    }
+}
+impl Drop for DataWriteGuard {
+    fn drop(&mut self) {
+        self.admission
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .phase = Phase::Done;
+    }
+}
+impl QueuedMedia {
+    /// Reacquire current message-specific source and destination authority.
+    /// The queued value remains available for a fresh retry after backpressure.
+    pub fn admit_data(&self) -> ControlResult<Arc<AdmittedData>> {
+        if self.frame.kind != StreamKind::Data || self.sources.len() != 1 {
+            return Err(StreamControlError::Unsupported);
+        }
+        let data = self.data.as_ref().ok_or(StreamControlError::Unsupported)?;
+        if self.frame.payload != data.message.bytes {
+            return Err(StreamControlError::NotReady);
+        }
+        let target = self
+            .target
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let provenance = &self.sources[0];
+        let source = provenance
+            .source
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if source.conversation != target.conversation
+            || source.session != target.session
+            || !Arc::ptr_eq(&source.policy, &target.policy)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut tokens = vec![target.shutdown.clone(), source.shutdown.clone()];
+        for stamp in [self.target_scene.as_ref(), provenance.scene.as_ref()]
+            .into_iter()
+            .flatten()
+        {
+            tokens.push(stamp.cancel.clone());
+        }
+        if let Some(stamp) = &self.direct {
+            tokens.push(stamp.cancel.clone());
+        }
+        let (source_lease, source_admission, source_end) = source.admit_with_data(
+            &provenance.source,
+            &provenance.ticket,
+            false,
+            None,
+            audio_consumer::ConsumerCheck::Retained(provenance.consumer.as_ref()),
+            None,
+            scene_consumer::SceneCheck::retained_publish(provenance.scene.as_ref()),
+            Some(data),
+            None,
+        )?;
+        let (target_lease, target_admission, target_end) = target.admit_with_data(
+            &self.target,
+            &self.target_ticket,
+            true,
+            Some(&provenance.descriptor),
+            audio_consumer::ConsumerCheck::Retained(self.target_consumer.as_ref()),
+            self.direct.as_ref(),
+            scene_consumer::SceneCheck::retained_receive(
+                self.target_scene.as_ref(),
+                provenance.scene.as_ref(),
+                self.admitted_at,
+            ),
+            Some(data),
+            None,
+        )?;
+        let owner = target_lease.authority();
+        let target_view = DataTarget {
+            owner: Arc::downgrade(&target),
+            conversation: target.conversation.clone(),
+            session: target.session.clone(),
+            connection: target.connection.clone(),
+            participant: owner.member.participant().clone(),
+            identity: owner.member.identity().clone(),
+            device: owner.endpoint.device().clone(),
+            membership_epoch: owner.member.epoch(),
+            principal: target.credential_snapshot().principal,
+            binding: self.target.binding.clone(),
+            credential_revision: target.credential_revision(),
+        };
+        let mut tickets = vec![provenance.ticket.clone(), self.target_ticket.clone()];
+        if let Some(direct) = &self.direct {
+            tickets.push(direct.delivery_ticket());
+        }
+        let admission = Arc::new(AdmittedData {
+            state: Mutex::new(AdmissionState {
+                phase: Phase::Pending,
+                guards: Some(OwnedGuards {
+                    _leases: vec![source_lease, target_lease],
+                    _admissions: vec![source_admission, target_admission],
+                }),
+            }),
+            data: data.clone(),
+            frame: self.frame.clone(),
+            source: provenance.descriptor.clone(),
+            target: target_view,
+            tickets,
+            tokens,
+            cancel: CancellationToken::new(),
+            deadline: source_end.min(target_end),
+        });
+        if !admission.current() {
+            admission.cancel();
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(admission)
+    }
+}
+
+/// Exact credential claims for an authenticated data-origin binding. Resource
+/// ownership alone is insufficient after refresh, scope or assurance changes.
+pub fn same_credential(a: &AuthenticatedPrincipal, b: &AuthenticatedPrincipal) -> bool {
+    use crate::identity::IdentityAssurance::*;
+    a.has_same_owner(b)
+        && a.expires_at == b.expires_at
+        && a.scopes == b.scopes
+        && a.method == b.method
+        && match (&a.assurance, &b.assurance) {
+            (Anonymous, Anonymous) => true,
+            (Pseudonymous { ephemeral_key: a }, Pseudonymous { ephemeral_key: b }) => a.0 == b.0,
+            (Identified { credential_kind: a }, Identified { credential_kind: b }) => {
+                a.as_str() == b.as_str()
+            }
+            (
+                TaskScoped {
+                    identity: a,
+                    task_id: at,
+                    scopes: as_,
+                    expires_at: ae,
+                },
+                TaskScoped {
+                    identity: b,
+                    task_id: bt,
+                    scopes: bs,
+                    expires_at: be,
+                },
+            ) => a == b && at == bt && as_ == bs && ae == be,
+            (
+                UserAuthorized {
+                    identity: a,
+                    user_id: au,
+                    scopes: as_,
+                },
+                UserAuthorized {
+                    identity: b,
+                    user_id: bu,
+                    scopes: bs,
+                },
+            ) => a == b && au == bu && as_ == bs,
+            (
+                DtlsFingerprint {
+                    algorithm: a,
+                    value: av,
+                },
+                DtlsFingerprint {
+                    algorithm: b,
+                    value: bv,
+                },
+            ) => a == b && av == bv,
+            _ => false,
+        }
+}
+impl StreamController {
+    pub fn matches_data_credential(&self, principal: &AuthenticatedPrincipal) -> bool {
+        let current = self.credential_snapshot();
+        same_credential(&current.principal, principal)
+    }
+}
