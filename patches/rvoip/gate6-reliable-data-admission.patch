+#[tokio::test]
+async fn typed_ordered_backpressure_retries_the_original_message_and_operation_context() {
+    let f = fixture(DataProtocol::Json, true).await;
+    let s = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let messages = (0..66).map(message).collect::<Vec<_>>();
+    let source = f.aa.port(Medium::Data);
+    for data in &messages[..64] {
+        source.try_publish_data(data, None).unwrap();
+    }
+    assert!(matches!(
+        source.try_publish_data(&messages[64], None),
+        Err(StreamControlError::Backpressure)
+    ));
+    s.tick();
+    s.tick();
+    source.try_publish_data(&messages[64], None).unwrap();
+    source.try_publish_data(&messages[65], None).unwrap();
+    for data in &messages {
+        s.tick();
+        let q = outgoing(&mut out).await;
+        assert!(
+            f.policy.0.try_write().is_ok(),
+            "queue retains metadata, never an old grant"
+        );
+        let attempt = q.admit_data().unwrap();
+        assert_eq!(attempt.data().message(), data.message());
+        assert_eq!(
+            attempt.data().context::<Context>().unwrap().operation,
+            "stable-operation"
+        );
+        let writing = attempt.begin_write().unwrap();
+        assert_eq!(writing.frame().payload, data.message().bytes);
+        drop(writing);
+    }
+    s.tick();
+    assert!(out.try_recv().is_err());
+}
