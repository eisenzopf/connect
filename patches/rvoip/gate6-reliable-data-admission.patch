+#[tokio::test]
+async fn typed_message_identity_context_and_distinct_receiver_label_survive_fresh_retry() {
+    let f = fixture(DataProtocol::Json, true).await;
+    let mut receiver = desired(Medium::Data);
+    receiver.logical_id = StreamId::from_string("inbox");
+    f.b.change(
+        f.b.revision(),
+        &[receiver.clone()],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+    )
+    .await
+    .unwrap();
+    f.b.change_direct_subscriptions(
+        f.b.revision(),
+        DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+            &f.a,
+            desired(Medium::Data).logical_id,
+            receiver.logical_id.clone(),
+        )]),
+        deadline(),
+        CancellationToken::new(),
+        None,
+    )
+    .await
+    .unwrap();
+    let s = scene(&f).await;
+    // The test adapter stores by logical ID; retrieve the renamed port exactly.
+    let target = f.ba.ports.lock().unwrap()[&receiver.logical_id].clone();
+    let mut out = target.take_egress().unwrap();
+    let data = message(42);
+    let q = queued(&f, &s, &mut out, &data).await;
+    let attempt = q.admit_data().unwrap();
+    assert!(attempt.target().belongs_to(&f.b));
+    assert!(!attempt.target().belongs_to(&f.a));
+    let impostor = StreamController::new(
+        f.b.conversation.clone(),
+        f.b.session.clone(),
+        f.b.connection.clone(),
+        f.b.credential_snapshot().principal.as_ref().clone(),
+        f.b.policy.clone(),
+        Adapter::new(),
+        Arc::new(StreamHandleAllocator::default()),
+        8,
+    )
+    .unwrap();
+    assert!(
+        !attempt.target().belongs_to(&impostor),
+        "matching resource IDs cannot borrow another controller's writer"
+    );
+    assert_eq!(
+        attempt.target().credential_revision,
+        f.b.credential_revision()
+    );
+    assert!(same_credential(
+        &attempt.target().principal,
+        &f.b.credential_snapshot().principal
+    ));
+
+    assert_eq!(
+        attempt.target().binding.negotiated.requested.logical_id,
+        receiver.logical_id
+    );
+    assert_eq!(
+        attempt.source().logical_id,
+        desired(Medium::Data).logical_id
+    );
+    assert_eq!(attempt.data().message(), data.message());
+    assert_eq!(
+        attempt.data().context::<Context>().unwrap().operation,
+        "stable-operation"
+    );
+    attempt.cancel();
+    assert!(attempt.begin_write().is_err());
+    let retry = q.admit_data().unwrap();
+    assert_eq!(retry.data().message(), data.message());
+    let writer = retry.begin_write().unwrap();
+    assert_eq!(writer.frame().payload, data.message().bytes);
+    assert_eq!(writer.frame().stream_id, target.binding().transport_id);
+    drop(writer);
+    assert!(!retry.current());
+    assert!(retry.begin_write().is_err());
+}
