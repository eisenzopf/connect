+#[tokio::test]
+async fn dropping_pending_producer_releases_readers_while_the_writer_queue_still_retains_work() {
+    let f = fixture(DataProtocol::Json, true).await;
+    let s = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let q = queued(&f, &s, &mut out, &message(0)).await;
+    let attempt = q.admit_data().unwrap();
+    let producer = attempt.cancel_on_drop();
+    let queued_copy = attempt.clone();
+    let mut writer = tokio::spawn({
+        let state = f.policy.0.clone();
+        async move { state.write_owned().await }
+    });
+    assert!(tokio::time::timeout(Duration::from_millis(15), &mut writer)
+        .await
+        .is_err());
+    drop(producer);
+    let writer = tokio::time::timeout(Duration::from_millis(100), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!queued_copy.current());
+    assert!(queued_copy.begin_write().is_err());
+    drop(writer);
+    let retry = q.admit_data().unwrap();
+    assert_eq!(
+        retry.data().message().message_id,
+        q.data.as_ref().unwrap().message().message_id
+    );
+    retry.cancel();
