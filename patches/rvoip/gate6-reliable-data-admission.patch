+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let q = queued(&f, &s, &mut out, &message(0)).await;
+    let attempt = q.admit_data().unwrap();
+    let producer = attempt.cancel_on_drop();
+    let writing = attempt.begin_write().unwrap();
+    assert!(attempt.begin_write().is_err());
+    drop(producer);
+    attempt.cancelled().await;
+    assert!(!attempt.current());
+    assert!(
+        f.policy.0.try_write().is_err(),
+        "cancellation cannot release readers under active IO"
+    );
+    assert_eq!(writing.data().message(), q.data.as_ref().unwrap().message());
+    drop(writing);
+    assert!(f.policy.0.try_write().is_ok());
