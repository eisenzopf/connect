+async fn nack_identity_cannot_select_foreign_or_previous_source_and_rechecks_authority() {
+    let peers = Peers::new().await;
+    let mut f = Fixture::new(Medium::Video).await;
+    let sequence = next_primary_sequence(&peers).await;
+    let (output, primary) = peers.primary(&mut f, sequence).await;
+    let pictures = output.picture_requests();
+    let (ssrc, sequence) = *pictures.state.lock().unwrap().sent.back().unwrap();
+    let old_source = pictures.state.lock().unwrap().latest.as_ref().unwrap().1.clone();
+    let foreign = pictures.request_for_nack(&[(ssrc ^ 1, sequence)]).is_none();
+    let unsent = pictures.request_for_nack(&[(ssrc, sequence.wrapping_add(7))]).is_none();
+    let original_request = pictures.request_for_nack(&[(ssrc, sequence)]).unwrap();
+    f.policy.mode.store(3, Ordering::SeqCst);
+    let invoked = Arc::new(AtomicBool::new(false));
+    let did = invoked.clone();
+    let refused = pictures.forward_for_request(deadline(), Some(&original_request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    f.policy.mode.store(0, Ordering::SeqCst);
+    let (route, _) = pictures.state.lock().unwrap().latest.clone().unwrap();
+    let mut successor = old_source.clone();
+    successor.ssrc ^= 1;
+    // A source change without an optional feedback publication invalidates NACK
+    // identity history while ordinary PLI retains its original latest metadata.
+    pictures.record(None, successor.clone(), ssrc, sequence.wrapping_add(1));
+    let no_feedback_stale = pictures.request_for_nack(&[(ssrc, sequence)]).is_none();
+    let ordinary_unchanged = pictures.state.lock().unwrap().latest.as_ref().unwrap().1 == old_source;
+    let did = invoked.clone();
+    let no_feedback_old_request = pictures.forward_for_request(deadline(), Some(&original_request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    pictures.record(Some(route), successor, ssrc, sequence.wrapping_add(1));
+    let stale = pictures.request_for_nack(&[(ssrc, sequence)]).is_none();
+    let did = invoked.clone();
+    let old_after_change = pictures.forward_for_request(deadline(), Some(&original_request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    let bound = pictures.state.lock().unwrap().sent.len();
+    drop(output);
+    let core_joined = f.close().await;
+    let peers_joined = peers.close().await;
+    assert!(primary && core_joined && peers_joined);
+    assert!(foreign && unsent && no_feedback_stale && ordinary_unchanged && stale && bound == 1);
+    assert!(!invoked.load(Ordering::SeqCst));
+    assert!(matches!(refused, PictureAttempt::MetadataRefused));
+    assert!(matches!(no_feedback_old_request, PictureAttempt::MetadataRefused));
+    assert!(matches!(old_after_change, PictureAttempt::MetadataRefused));
+}
