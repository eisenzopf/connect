+/// Bounded authenticated repair misses, separate from ordinary PLI/FIR. The
+/// canonical egress must match these wire coordinates to its current source.
+#[derive(Default)]
+pub(crate) struct VideoRepairRequests {
+    pending: SyncMutex<Vec<(u32, u16)>>,
+    changed: tokio::sync::Notify,
+}
+impl VideoRepairRequests {
+    fn note(&self, ssrc: u32, sequences: &[u16]) {
+        let mut pending = self.pending.lock();
+        for sequence in sequences.iter().take(64) {
+            let key = (ssrc, *sequence);
+            if pending.len() < 64 && !pending.contains(&key) {
+                pending.push(key);
+            }
+        }
+        let notify = !pending.is_empty();
+        drop(pending);
+        if notify {
+            self.changed.notify_one();
+        }
+    }
+    pub(crate) async fn changed(&self) {
+        self.changed.notified().await;
+    }
+    pub(crate) fn take(&self) -> Vec<(u32, u16)> {
+        std::mem::take(&mut *self.pending.lock())
+    }
+}
 
