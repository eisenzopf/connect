+        loop {
+            match track.poll().await {
+                Some(webrtc::media_stream::track_remote::TrackRemoteEvent::OnRtpPacket(packet, at))
+                    if packet.header.ssrc == ssrc && packet.header.sequence_number == sequence => break (packet, at),
+                None => panic!("original RTC peer ended before actual RTP"),
+                _ => {},
+            }
+        }
+    }).await.unwrap()
+}
+async fn actual_source_packet(peers: &Peers, sequence: u16, delta: bool) -> (rtp::Packet, Instant) {
+    let ssrc = peers.publisher.local_video_ssrc().unwrap();
