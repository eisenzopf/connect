+async fn expired_original_nack_requests_fresh_source_pli_without_replaying_media() {
+    let peers = Peers::new().await;
+    let mut f = Fixture::new(Medium::Video).await;
+    let ssrc = peers.publisher.local_video_ssrc().unwrap();
+    let mut output = peers.publisher.core_video_egress(&f.target, deadline().into_std()).await.unwrap();
+    let sequence = next_primary_sequence(&peers).await;
+    f.enqueue(ssrc, sequence).await;
+    let original_until = tokio::time::Instant::now() + Duration::from_millis(100);
+    let write = output.submit_next(original_until.into_std()).await.unwrap().unwrap();
+    let primary = write.result().await.is_ok();
+    let original_joined = write.cancel_and_drain().await.is_ok();
+    let pictures = output.picture_requests();
+    let wire_sequence = pictures.state.lock().unwrap().sent.back().unwrap().1;
+    let before = matching_packets(&peers, ssrc, wire_sequence,
+        original_until + Duration::from_millis(20)).await;
+    let hints = nack_hint(&peers, ssrc, wire_sequence).await;
+    let missing = !hints.is_empty();
+    let request = pictures.request_for_nack(&hints);
+    let source_pli = peers.publisher.video_keyframe_requests();
+    // Drain negotiation PLI/FIR before observing the exact new fresh hint.
+    for _ in 0..8 {
+        if tokio::time::timeout(Duration::from_millis(1), source_pli.notified()).await.is_err() { break; }
+    }
+    let peer = peers.receiver.clone();
+    let attempt = if let Some(request) = request.as_ref() {
+        pictures.forward_for_request(
+            tokio::time::Instant::now() + Duration::from_millis(100), Some(request),
+            move |_, source_ssrc| async move {
+                peer.request_picture_for_source(source_ssrc).await
+                    .map_err(|_| StreamControlError::NotReady)
+            },
+        ).await
+    } else {
+        PictureAttempt::MetadataRefused
+    };
+    let pli = tokio::time::timeout(Duration::from_millis(100), source_pli.notified()).await.is_ok();
+    let resent = matching_packets(&peers, ssrc, wire_sequence,
+        tokio::time::Instant::now() + Duration::from_millis(50)).await;
+    drop(output);
+    let core_joined = f.close().await;
+    let peers_joined = peers.close().await;
+    assert!(primary && original_joined && core_joined && peers_joined);
+    assert_eq!(before, 1, "original actual packet was not delivered exactly once");
+    assert!(missing && request.is_some(), "expired repair produced no current-source recovery request");
+    assert!(matches!(attempt, PictureAttempt::Invoked) && pli, "actual fresh source SRTCP PLI was absent");
+    assert_eq!(resent, 0, "expired original RTP bytes were replayed");
+}
