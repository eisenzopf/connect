+// Three real RTC pairs: old inbound publisher, different inbound publisher,
+// and one unchanged target. The trusted Core adapter SPI is the existing
+// fixture boundary; actual RTP/SRTCP traverses each connected DTLS/SRTP peer.
+struct SourceSwitchRoom {
+    policy: Arc<Policy>,
+    controllers: Vec<Arc<StreamController>>,
+    adapters: Vec<Arc<Adapter>>,
+    inputs: Vec<mpsc::Receiver<MediaPacket>>,
+}
+impl SourceSwitchRoom {
+    async fn new() -> Self {
+        let names = ["alice", "alice-next", "bob"];
+        let policy = Arc::new(Policy {
+            owners: names.iter().map(|name| (name.to_string(), owner(name))).collect(),
+            guard: Arc::new(RwLock::new(())), mode: AtomicUsize::new(0),
+            attempts: AtomicUsize::new(0), original_attempts: AtomicUsize::new(0),
+            grant_until: Mutex::new(None),
+        });
+        let handles = Arc::new(StreamHandleAllocator::default());
+        let adapters = names.iter().map(|_| Arc::new(Adapter::default())).collect::<Vec<_>>();
+        let controllers = names.iter().zip(&adapters).map(|(name, adapter)| {
+            StreamController::new(ConversationId::from_string("conversation"),
+                SessionId::from_string("session"), ConnectionId::from_string(*name),
+                principal(name), policy.clone(), adapter.clone(), handles.clone(), 8).unwrap()
+        }).collect::<Vec<_>>();
+        for controller in &controllers {
+            controller.change(controller.revision(), &[desired(Medium::Video)],
+                &BTreeSet::new(), deadline(), CancellationToken::new()).await.unwrap();
+        }
+        let logical = desired(Medium::Video).logical_id;
+        let inputs = controllers[..2].iter().map(|c| c.take_ingress(&logical).unwrap()).collect();
+        let room = Self { policy, controllers, adapters, inputs };
+        room.select(0).await;
+        room
+    }
+    async fn select(&self, source: usize) {
+        let target = &self.controllers[2];
+        let logical = desired(Medium::Video).logical_id;
+        for change in [DirectSubscriptionChange::Clear,
+            DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                &self.controllers[source], logical.clone(), logical.clone(),
+            )])] {
+            target.change_direct_subscriptions(target.revision(), change,
+                deadline(), CancellationToken::new(), None).await.unwrap();
+        }
+    }
+    async fn forward(&mut self, index: usize, packet: rtp::Packet, at: Instant) {
+        let source = self.adapters[index].port(Medium::Video);
+        source.try_publish(&MediaFrame {
+            stream_id: source.binding().transport_id.clone(), kind: StreamKind::Video,
+            timestamp_rtp: packet.header.timestamp, payload_type: Some(packet.header.payload_type),
+            payload: packet.marshal().unwrap().freeze(), source_clock: None,
+            captured_at: Utc::now() - chrono::Duration::from_std(at.elapsed()).unwrap(),
+        }).unwrap();
+        tokio::time::timeout_at(deadline(), self.inputs[index].recv()).await.unwrap().unwrap()
+            .try_forward_to(&self.controllers[2], &desired(Medium::Video).logical_id).unwrap();
+    }
+    async fn close(self) -> bool {
+        let mut joined = true;
+        for controller in self.controllers { joined &= controller.shutdown(deadline()).await == 0; }
+        joined && self.policy.guard.clone().try_write_owned().is_ok()
+    }
+}
+async fn actual_remote_video(peers: &Peers) -> Arc<dyn webrtc::media_stream::track_remote::TrackRemote> {
+    tokio::time::timeout_at(deadline(), async {
+        loop {
+            if let Some(track) = peers.receiver.discover_remote_video_track().await { break track; }
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    }).await.unwrap()
