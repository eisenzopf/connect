+/// Send actual authenticated SRTCP NACK, then consume only the driver's actual
+/// unavailable-repair notification. A test never calls that callback directly.
+async fn nack_hint(peers: &Peers, ssrc: u32, sequence: u16) -> Vec<(u32, u16)> {
+    let requests = peers.publisher.video_repair_requests();
+    requests.take();
+    let track = peers.receiver.discover_remote_video_track().await.unwrap();
+    track.write_rtcp(vec![Box::new(
+        rtc::rtcp::transport_feedbacks::transport_layer_nack::TransportLayerNack {
+            sender_ssrc: peers.receiver.local_video_ssrc().unwrap_or(0),
+            media_ssrc: ssrc,
+            nacks: vec![rtc::rtcp::transport_feedbacks::transport_layer_nack::NackPair {
+                packet_id: sequence, lost_packets: 0,
+            }],
+        },
+    )]).await.unwrap();
+    let until = tokio::time::Instant::now() + Duration::from_millis(150);
+    loop {
+        if tokio::time::timeout_at(until, requests.changed()).await.is_err() {
+            return Vec::new();
+        }
+        let hints = requests.take();
+        // The normal receiver may also NACK priming/source sequence gaps. Only
+        // this exact authenticated request is this regression's witness.
+        if hints.contains(&(ssrc, sequence)) {
+            return hints;
+        }
+    }
+}
+async fn matching_packets(
+    peers: &Peers, ssrc: u32, sequence: u16, until: tokio::time::Instant,
+) -> usize {
+    let track = peers.receiver.discover_remote_video_track().await.unwrap();
+    let mut count = 0;
+    loop {
+        match tokio::time::timeout_at(until, track.poll()).await {
+            Ok(Some(webrtc::media_stream::track_remote::TrackRemoteEvent::OnRtpPacket(packet, _))) => {
+                if packet.header.ssrc == ssrc && packet.header.sequence_number == sequence {
+                    count += 1;
+                }
+            },
+            Ok(None) | Err(_) => break,
+            _ => {},
+        }
+    }
+    count
+}
