+    let initial = pictures.take_source_change().is_none();
+    let mut successor = original.clone();
+    successor.origin.generation += 1;
+    pictures.record(None, successor.clone(), wire.0, wire.1.wrapping_add(1));
+    let waiting = pictures.take_source_change().is_none();
+    let ordinary_unchanged = pictures.state.lock().unwrap().latest.as_ref().unwrap().1 == original;
+    let no_old_nack = pictures.request_for_nack(&[wire]).is_none();
+    pictures.record(None, successor.clone(), wire.0, wire.1.wrapping_add(2));
+    let still_waiting = pictures.take_source_change().is_none();
+    pictures.record(Some(route.clone()), successor.clone(), wire.0, wire.1.wrapping_add(3));
+    let request = pictures.take_source_change();
+    let current = request.as_ref().is_some_and(|r| r.source == successor);
+    pictures.record(Some(route), successor, wire.0, wire.1.wrapping_add(4));
+    let once = pictures.take_source_change().is_none();
+    drop(output);
+    let core_joined = f.close().await;
+    let peers_joined = peers.close().await;
+    assert!(primary && core_joined && peers_joined);
+    assert!(initial && waiting && ordinary_unchanged && no_old_nack && still_waiting && current && once);
