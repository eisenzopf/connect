+#[tokio::test]
+async fn source_switch_hint_refuses_superseded_revoked_and_closed_sources() {
+    let mut observations = Vec::new();
+    for action in 0..3 {
+        let peers = Peers::new().await;
+        let mut f = Fixture::new(Medium::Video).await;
+        let next = next_primary_sequence(&peers).await;
+        let (mut output, primary) = peers.primary(&mut f, next).await;
+        let changed = replace_and_deliver_delta(&peers, &mut f, &mut output).await;
+        let pictures = output.picture_requests();
+        let request = pictures.take_source_change().expect("actual source transition absent");
+        let mut successor_sent = true;
+        match action {
+            0 => {
+                successor_sent = replace_and_deliver_delta(&peers, &mut f, &mut output).await;
+                // The old request remains pinned even after the original shared
+                // debounce interval; it cannot refresh itself to the successor.
+                tokio::time::sleep(Duration::from_millis(260)).await;
+            },
+            1 => f.policy.mode.store(3, Ordering::SeqCst),
+            2 => { let _ = f.a.shutdown(deadline()).await; },
+            _ => unreachable!(),
+        }
+        let invoked = Arc::new(AtomicBool::new(false));
+        let did = invoked.clone();
+        let result = pictures.forward_for_request(
+            tokio::time::Instant::now() + Duration::from_millis(100), Some(&request),
+            move |_, _| async move { did.store(true, Ordering::SeqCst); Ok(()) },
+        ).await;
+        f.policy.mode.store(0, Ordering::SeqCst);
+        drop(output);
+        let core_joined = f.close().await;
+        let peers_joined = peers.close().await;
+        observations.push((primary, changed, successor_sent, invoked.load(Ordering::SeqCst),
+            matches!(result, PictureAttempt::MetadataRefused), core_joined, peers_joined));
+    }
+    assert!(observations.iter().all(|(primary, changed, successor, invoked, refused, joined, peers_joined)|
+        *primary && *changed && *successor && !*invoked && *refused && *joined && *peers_joined));
+}
