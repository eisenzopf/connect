+// Continue after actual negotiation priming, rather than creating thousands
+// of unrelated missing sequence slots that could fill the bounded hint owner.
+async fn next_primary_sequence(peers: &Peers) -> u16 {
+    let track = peers.receiver.discover_remote_video_track().await.unwrap();
+    let until = tokio::time::Instant::now() + Duration::from_millis(100);
+    let mut last = None;
+    loop {
+        match tokio::time::timeout_at(until, track.poll()).await {
+            Ok(Some(webrtc::media_stream::track_remote::TrackRemoteEvent::OnRtpPacket(packet, _))) => {
+                last = Some(packet.header.sequence_number);
+            },
+            Ok(None) | Err(_) => break,
+            _ => {},
+        }
+    }
+    last.expect("real negotiation priming produced no received video packet").wrapping_add(1)
+}
