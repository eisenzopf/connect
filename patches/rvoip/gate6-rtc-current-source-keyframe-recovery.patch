+    drop(output);
+    let core_joined = room.close().await;
+    let (old_joined, new_joined, target_joined) = tokio::join!(old_source.close(), new_source.close(), target.close());
+    assert!(primary && primary_joined && delta && delta_joined && repeated && repeated_joined
+        && core_joined && old_joined && new_joined && target_joined);
+    assert!(initial_unchanged && no_metadata_only, "initial source or metadata-only selection gained an unsolicited source-switch hint");
+    assert_eq!(new_wire, (old_wire.0, old_wire.1.wrapping_add(1)));
+    assert_eq!(second_target.header.ssrc, first_target.header.ssrc);
+    assert_eq!(second_target.header.sequence_number, first_target.header.sequence_number.wrapping_add(1));
+    assert_eq!(second_target.payload.as_ref(), &[0x10, 1, 1, 2], "actual new-source delta framing was changed");
+    assert!(notice && request.is_some(), "source switch emitted no current keyframe request");
+    assert!(matches!(attempt, PictureAttempt::Invoked) && new_pli && !old_pli,
+        "source switch did not send fresh SRTCP PLI to only the actual new physical source");
+    assert!(no_repeat, "unchanged source media repeated the keyframe request");
+}
