+#[tokio::test]
+async fn bounded_nack_holes_keep_current_serial_suffix_and_recheck_fresh_admission() {
+    let peers = Peers::new().await;
+    let mut f = Fixture::new(Medium::Video).await;
+    use futures::FutureExt;
+    let result = std::panic::AssertUnwindSafe(async {
+    let (output, primary) = peers.primary(&mut f, 1200).await;
+    let pictures = output.picture_requests();
+    let (route, source, ssrc) = {
+        let state = pictures.state.lock().unwrap();
+        let (route, source) = state.latest.clone().unwrap();
+        (route, source, state.sent.back().unwrap().0)
+    };
+    // Scalar vectors only; canonical control separately proves actual writes.
+    let cases: &[(&[u16], u16, bool)] = &[
+        (&[100, 102], 101, true), (&[65534, 0], 65535, true),
+        (&[0, 2, 512], 1, true), (&[100], 101, false), (&[102], 101, false),
+        (&[100, 102], 99, false), (&[100, 102], 103, false),
+        (&[100, 613], 101, false), (&[100, 32868], 101, false),
+        (&[100, 104, 102], 101, false), (&[100, 102, 615], 101, false),
+        (&[100, 102, 32869, 100], 101, false), (&[0, 2, 513], 1, false),
+    ];
+    let mut vectors = Vec::new();
+    for (history, missing, expected) in cases {
+        let mut state = pictures.state.lock().unwrap();
+        state.sent = history.iter().map(|sequence| (ssrc, *sequence)).collect();
+        vectors.push((history.to_vec(), *missing, state.recognizes_nack(&(ssrc, *missing)), *expected));
+        assert!(!state.recognizes_nack(&(ssrc ^ 1, *missing)));
+    }
+    {
+        let mut state = pictures.state.lock().unwrap();
+        state.sent = [(ssrc ^ 1, 0), (ssrc, 2)].into();
+        assert!(!state.recognizes_nack(&(ssrc, 1)), "Both neighbors require exact output SSRC");
+        state.sent = [(ssrc, 0), (ssrc, 2)].into();
+    }
+    let request = pictures.request_for_nack(&[(ssrc, 1)]).unwrap();
+    let invoked = Arc::new(AtomicBool::new(false));
+    f.policy.mode.store(3, Ordering::SeqCst);
+    let did = invoked.clone();
+    let revoked = pictures.forward_for_request(deadline(), Some(&request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    f.policy.mode.store(0, Ordering::SeqCst);
+    let state = pictures.state.clone();
+    *f.policy.before_feedback_admit.lock().unwrap() = Some(Box::new(move || {
+        // Same source; left witness retires AFTER forward snapshots its route.
+        state.lock().unwrap().sent.pop_front();
+    }));
+    let did = invoked.clone();
+    let raced = pictures.forward_for_request(deadline(), Some(&request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    let hook_consumed = f.policy.before_feedback_admit.lock().unwrap().is_none();
+    let evicted = pictures.request_for_nack(&[(ssrc, 1)]).is_none();
+    {
+        let mut state = pictures.state.lock().unwrap();
+        state.sent = (2..514).map(|sequence| (ssrc, sequence)).collect();
+        assert!(!state.recognizes_nack(&(ssrc, 1)), "A512-entry count cannot recreate retired left anchor");
+    }
+    let mut successor = source.clone(); successor.ssrc ^= 1;
+    pictures.record(None, successor.clone(), ssrc, 3);
+    let changed_without_feedback = pictures.request_for_nack(&[(ssrc, 1)]).is_none();
+    let did = invoked.clone();
+    let stale_without_feedback = pictures.forward_for_request(deadline(), Some(&request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    pictures.record(Some(route), successor, ssrc, 3);
+    let did = invoked.clone();
+    let stale = pictures.forward_for_request(deadline(), Some(&request), move |_, _| async move {
+        did.store(true, Ordering::SeqCst); Ok(())
+    }).await;
+    drop(output);
+    (primary, vectors, hook_consumed, evicted, changed_without_feedback,
