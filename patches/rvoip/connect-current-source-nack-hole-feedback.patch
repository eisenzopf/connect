+#[tokio::test]
+async fn canonical_never_sent_vp8_fragment_nack_requests_current_source_and_fresh_decode() {
+    let mut h = Harness::new();
+    let result = std::panic::AssertUnwindSafe(async {
+        h.setup().await;
+        h.baseline().await;
+        let output_ssrc = h.physical[1].peer(until()).await.unwrap().local_video_ssrc().unwrap();
+        let missing = h.next_sequence.wrapping_add(1);
+        let source_notice = h.remote[0].video_keyframe_requests();
+        let notice = source_notice.notified();
+        tokio::pin!(notice); notice.as_mut().enable();
+        let (old_ts, old_seq) = h.send_key_with_unforwarded_fragment(Some(1)).await;
+        assert_eq!(old_seq[1], missing);
+        let old = h.collect(old_ts, &old_seq,
+            tokio::time::Instant::now() + Duration::from_millis(100)).await;
+        let neighbors = old.iter().any(|packet| packet.header.sequence_number == missing.wrapping_sub(1))
+            && old.iter().any(|packet| packet.header.sequence_number == missing.wrapping_add(1));
+        h.actual_nack(output_ssrc, missing).await;
+        let pli = tokio::time::timeout_at(until(), notice).await.is_ok();
+        let _late_old = h.collect(old_ts, &old_seq,
+            tokio::time::Instant::now() + Duration::from_millis(20)).await;
+        let replayed = h.observed.contains(&(old_ts, missing));
+        let fresh_at = Instant::now();
+        let (fresh_ts, fresh_seq) = h.send_key().await;
+        let fresh = h.collect(fresh_ts, &fresh_seq, until()).await;
+        (neighbors, pli, replayed, assemble(&old), assemble(&fresh), fresh_ts != old_ts, fresh_at.elapsed())
+    }).catch_unwind().await;
+    let clean = h.close().await;
+    if let Err(panic) = result { std::panic::resume_unwind(panic); }
+    let (neighbors, pli, replayed, old, fresh, new_timestamp, fresh_age) = result.unwrap();
+    let (codec_joined, codec) = match &fresh {
+        Some(bytes) => decoded_key(bytes).await,
+        None => (true, false),
+    };
+    assert!(clean && codec_joined);
+    assert!(neighbors && old.is_none() && !replayed,
+        "Actual successful neighbors must bracket never-sent original; no synthetic/replayed RTP");
+    assert!(pli, "Never-sent hole produced no current-source SRTCP PLI through production feedback");
+    assert!(new_timestamp && fresh_age < Duration::from_millis(200) && fresh.as_deref() == Some(KEY) && codec,
+        "Fresh guarded source keyframe did not recover actual selected receiver and decode");
