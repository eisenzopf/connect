+impl PictureState {
+    fn recognizes_nack(&self, key: &(u32, u16)) -> bool {
+        // Preserve the original exact successful-send identity path.
+        if self.sent.contains(key) {
+            return true;
+        }
+        let Some((_, current)) = self.latest.as_ref() else {
+            return false;
+        };
+        if self.actual_source.as_ref() != Some(current) {
+            return false;
+        }
+        let mut history = self.sent.iter().rev();
+        let Some(mut right) = history.next() else {
+            return false;
+        };
+        let mut distance = 0usize;
+        for left in history {
+            if left.0 != key.0 || right.0 != key.0 {
+                break;
+            }
+            let span = usize::from(right.1.wrapping_sub(left.1));
+            // Packet-count custody is not a sequence-distance bound. Walk only
+            // the latest unambiguous forward serial suffix, including wrap.
+            if span == 0 || span > 512 || distance + span > 512 {
+                break;
+            }
+            let offset = usize::from(key.1.wrapping_sub(left.1));
+            if 0 < offset && offset < span {
+                return true;
+            }
+            distance += span;
+            right = left;
+        }
+        false
+    }
+}
