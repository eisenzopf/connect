+#[cfg(test)]
+mod screen_profile_tests {
+    use super::*;
+    #[test]
+    fn logical_screen_uses_video_rtp_without_changing_its_binding_kind() {
+        let logical = Medium::Screen;
+        assert_eq!(rtp_medium(logical).unwrap(), Medium::Video);
+        assert_eq!(logical, Medium::Screen);
+        assert!(validate_rtp_slots([Medium::Audio, logical]).is_ok());
+        assert!(validate_rtp_slots([Medium::Audio, Medium::Video]).is_ok());
+    }
+    #[test]
+    fn a_single_video_rtp_slot_cannot_admit_camera_and_screen_or_data() {
+        assert!(validate_rtp_slots([Medium::Video, Medium::Screen]).is_err());
+        assert!(validate_rtp_slots([Medium::Screen, Medium::Screen]).is_err());
+        assert!(validate_rtp_slots([Medium::Audio, Medium::Data]).is_err());
+        assert!(rtp_medium(Medium::Data).is_err());
+    }
+}
