+// One physical RTP video source may back a logical camera OR screen Stream.
+// Logical bindings retain their original Medium; only source/SDP slots use this
+// mapping. Data and a simultaneous camera+screen profile remain unsupported.
+fn rtp_medium(medium: Medium) -> ControlResult<Medium> {
+    match medium {
+        Medium::Audio => Ok(Medium::Audio),
+        Medium::Video | Medium::Screen => Ok(Medium::Video),
+        _ => Err(StreamControlError::Unsupported),
+    }
+}
+fn validate_rtp_slots(media: impl IntoIterator<Item = Medium>) -> ControlResult<()> {
+    let mut kinds = std::collections::BTreeSet::new();
+    for medium in media {
+        if !kinds.insert(rtp_medium(medium)?) {
+            return Err(StreamControlError::Unsupported);
+        }
+    }
+    Ok(())
 }
