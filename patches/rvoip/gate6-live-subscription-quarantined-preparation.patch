+            .collect::<Vec<_>>();
+        owner.check_credential_snapshot(&self.staged.credential)?;
+        self.staged.control = Some(owner.policy.current_control(
+            &owner.scope(&self.staged.credential.principal, MediaPurpose::Control),
+            &MediaControlIntent::ChangeSubscriptions {
+                expected: self.staged.expected,
+                desired: &desired,
+                replace: &self.replace,
+                change: &self.change,
+            },
+            held.as_ref(),
+        )?);
+        self.staged.control_cancel = self
+            .staged
+            .control
+            .as_ref()
+            .expect("fresh subscription control")
+            .cancellation
+            .clone();
+        owner.finish_change(self.staged).await
+    }
