+async fn exercise(mode: &str) {
+    let (scene, expected, selected, change) = fixture().await;
+    let old = scene.f.b.active_bindings()[0].clone();
+    let mut audio_output = scene.f.ba.port(Medium::Audio).take_egress().unwrap();
+    audio(&scene, &mut audio_output, 961).await;
+    let calls = scene.f.ba.prepare_calls.load(Ordering::Acquire);
+    let original = held(&scene, expected, &selected, &change, false).await;
+    let candidate = scene
+        .f
+        .b
+        .stage_selected_subscriptions_with_held(
+            expected,
+            &selected,
+            &BTreeSet::new(),
+            scene.scene.clone(),
+            &change,
+            deadline(),
+            CancellationToken::new(),
+            Arc::new(original.clone()),
+        )
+        .await
+        .unwrap();
+    // The caller owns metadata only during prepare too. Do not accidentally
+    // retain this fixture's real domain reader outside the production token.
+    drop(original);
+    assert_eq!(scene.f.ba.prepare_calls.load(Ordering::Acquire), calls);
+    scene.f.ba.mode.store(1, Ordering::Release);
+    let prepare = tokio::spawn(candidate.prepare());
+    tokio::time::timeout(Duration::from_millis(100), scene.f.ba.entered.notified())
+        .await
+        .unwrap();
+    let candidate_port = scene.f.ba.port(Medium::Data);
+    let mut data_output = candidate_port.take_egress().unwrap();
+    assert_eq!(candidate_port.status(), PortStatus::Prepared);
+    assert_eq!(scene.f.b.revision(), expected);
+    assert!(data_output.try_recv().is_err());
+    // The adapter is still inside its actual original prepare. This write
+    // must acquire now, not only after the resource call has returned.
+    let writer = scene.f.policy.0.clone().try_write_owned();
+    let writer_progressed = writer.is_ok();
+    if let Ok(mut writer) = writer {
+        if mode == "withdraw-data" {
+            let target = writer
+                .owners
+                .get_mut(scene.f.b.connection.as_str())
+                .unwrap();
+            target.send_media.remove(&Medium::Data);
+            target.receive_media.remove(&Medium::Data);
+        } else {
+            writer.revoked.insert("unrelated-identity".into());
+        }
+    }
+    // Audio is independently authorized, and its old port remains in service
+    // both during the stalled candidate and after any failed fresh admission.
+    audio(&scene, &mut audio_output, 962).await;
+    assert_eq!(scene.f.ba.prepare_calls.load(Ordering::Acquire), calls + 1);
+    scene.f.ba.release.notify_one();
+    let prepared = prepare.await.unwrap().unwrap();
+    assert!(data_output.try_recv().is_err());
+    assert_eq!(scene.f.b.revision(), expected);
+    let fresh = held(
+        &scene,
+        expected,
+        &selected,
+        &change,
+        mode == "foreign-owner",
+    )
+    .await;
+    let result = prepared.activate_with_held(Arc::new(fresh.clone())).await;
+    drop(fresh);
+    let revision = scene.f.b.revision();
+    let candidate_status = candidate_port.status();
+    assert!(scene
+        .f
+        .b
+        .active_bindings()
+        .iter()
+        .any(|b| b.transport_id == old.transport_id
+            && b.stream_local_id == old.stream_local_id
+            && b.generation == old.generation));
+    if mode == "current" {
+        if result.is_ok() {
+            scene.publish(Medium::Data, 963);
+            scene.scene.tick();
+            outgoing(&mut data_output)
+                .await
+                .deliver(|frame| async move {
+                    assert_eq!(frame.timestamp_rtp, 963);
+                    Ok(())
+                })
+                .await
+                .unwrap();
+            assert!(data_output.try_recv().is_err());
+        }
+    } else {
+        assert!(data_output.try_recv().is_err());
+    }
+    audio(&scene, &mut audio_output, 964).await;
+    let prepares = scene.f.ba.prepare_calls.load(Ordering::Acquire);
+    assert_eq!(scene.f.b.shutdown(deadline()).await, 0);
+    assert_eq!(scene.f.a.shutdown(deadline()).await, 0);
+    assert_eq!(scene.f.ba.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(scene.f.aa.outstanding.load(Ordering::Acquire), 0);
+    // Defer this exact counterfactual assertion until all original owners join.
+    assert!(
+        writer_progressed,
+        "quarantined live subscription preparation retained the original domain reader"
+    );
+    assert_eq!(
+        prepares,
+        calls + 1,
+        "original adapter.prepare must never repeat"
+    );
+    if mode == "current" {
