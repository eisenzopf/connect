+            .permits(&Envelope::from_value(bad).unwrap())
+            .is_err());
+    }
+    let mut bad = offered.clone();
+    bad["in_reply_to"] = json!(a.envelope().id());
+    assert!(resource
+        .permits(&Envelope::from_value(bad).unwrap())
+        .is_err());
+    let mut bad = offered.clone();
+    bad["payload"]["streams_offered"][0]["id"] = json!("foreign-stream");
