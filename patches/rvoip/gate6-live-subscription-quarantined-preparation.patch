+//! Sealed activation marker/currentness and final reply custody only.
+use super::*;
+use serde_json::json;
+use std::sync::atomic::{AtomicBool, Ordering};
+fn envelope(kind: &str, payload: serde_json::Value) -> Envelope {
+    Envelope::from_value(json!({"v":2,"type":kind,"id":format!("test_{}",uuid::Uuid::new_v4().simple()),"ts":chrono::Utc::now(),"cid":"conversation","sid":"session","connid":"connection","operation_id":"subscription","expected_revision":0,"payload":payload})).unwrap()
+}
+fn authorized() -> AuthorizedEnvelope {
+    let original = envelope(
+        "stream.subscribe",
+        json!({"by_participant":"part_alice","subscriptions":[{"from_participant":"part_bob","kinds":["audio"]}]}),
+    );
+    let physical = CancellationToken::new();
+    let invocation = physical.child_token();
+    let deadline = Instant::now() + Duration::from_secs(3);
+    let resource = ResourcePreparation {
+        kind: PreparationKind::Subscription,
+        marker: Arc::new(()),
+        original: original.clone(),
+        participant: "part_alice".into(),
+        streams: ["audio".into()].into_iter().collect(),
+        cancellation: invocation.child_token(),
+        deadline,
+    };
+    let mut final_resource = resource.clone();
+    final_resource.cancellation = physical.child_token();
+    let final_current = final_resource.cancellation.clone();
+    let current = resource.cancellation.clone();
+    let reply_authority = ReplyAuthority::new(AuthorityLease::checking(
+        final_resource,
+        deadline,
+        move || !final_current.is_cancelled(),
+    ));
+    reply_authority.note_resource_preparation();
+    AuthorizedEnvelope {
+        envelope: original,
+        principal: AuthenticatedPrincipal {
+            subject: "alice".into(),
+            tenant: None,
+            scopes: vec!["control".into()],
+            issuer: None,
+            expires_at: Some(chrono::Utc::now() + chrono::Duration::minutes(1)),
+            method: rvoip_auth_core::bearer::AuthenticationMethod::Bearer,
+            assurance: IdentityAssurance::Identified {
+                credential_kind: rvoip_core::identity::CredentialKind::Oidc,
+            },
+        },
+        _lease: AuthorityLease::checking(resource, deadline, move || !current.is_cancelled()),
+        reply_authority,
+        origin: RequestOrigin {
+            incarnation: uuid::Uuid::new_v4(),
+            lifetime: physical,
+            deadline,
+        },
+        peer: None,
+        exchange: None,
+        invocation,
+        answer_state: Arc::new(offer_answer::OfferAnswerState::default()),
+    }
+}
+fn token(
+    a: &AuthorizedEnvelope,
+    valid: Arc<AtomicBool>,
+    until: Instant,
+) -> Arc<ResourceActivationAuthority> {
+    let resource = a._lease.authority::<ResourcePreparation>().unwrap();
+    Arc::new(ResourceActivationAuthority {
+        marker: resource.marker.clone(),
+        lease: AuthorityLease::checking(17u64, until, move || valid.load(Ordering::Acquire)),
+        invocation: resource.cancellation.clone(),
+        physical: a.origin.lifetime.child_token(),
+        deadline: until.min(resource.deadline),
+    })
+}
+fn result(a: &AuthorizedEnvelope) -> Envelope {
+    let mut value=envelope("operation.updated",json!({"operation_id":"subscription","record_id":"record","command_type":"stream.subscribe","expected_revision":0,"state":"completed","revision":1,"result":{"stream_revision":1}})).original().clone();
+    value["in_reply_to"] = json!(a.envelope().id());
+    Envelope::from_value(value).unwrap()
+}
+#[test]
+fn resource_subscription_results_require_exact_current_activation_and_final_reply_survives_handler_drop(
+) {
+    let a = authorized();
+    let reply = result(&a);
+    assert_eq!(
+        a.reply_authority.for_replies(&[reply.clone()]).unwrap_err(),
+        DispatchError::ReplyMismatch
+    );
+    let valid = Arc::new(AtomicBool::new(true));
+    let fresh = token(&a, valid.clone(), Instant::now() + Duration::from_secs(2));
+    assert_eq!(fresh.authority::<u64>(), Some(&17));
+    a.install_resource_reply_authority(&fresh).unwrap();
+    // Final fresh application rights must not erase the earlier domain release
+    // fact used by resumed step-up BOTH-credential publication revalidation.
+    assert!(a.reply_authority.resource_only());
+    a.invocation.cancel();
+    assert!(!fresh.current());
+    assert!(
+        a.reply_authority.for_replies(&[reply.clone()]).is_ok(),
+        "final reply retains fresh domain proof beyond handler child only"
+    );
+    valid.store(false, Ordering::Release);
+    assert_eq!(
+        a.reply_authority.for_replies(&[reply]).unwrap_err(),
+        DispatchError::Authority
+    );
+}
+#[test]
+fn resource_subscription_foreign_marker_expired_or_physical_cancel_cannot_install_reply_authority()
+{
+    let a = authorized();
+    let foreign = authorized();
+    let valid = Arc::new(AtomicBool::new(true));
+    let other = token(
+        &foreign,
+        valid.clone(),
+        Instant::now() + Duration::from_secs(1),
+    );
+    assert!(other.current());
+    assert_eq!(
+        a.install_resource_reply_authority(&other),
+        Err(DispatchError::Authority)
+    );
+    let expired = token(&a, valid.clone(), Instant::now() - Duration::from_millis(1));
+    assert_eq!(
+        a.install_resource_reply_authority(&expired),
+        Err(DispatchError::Authority)
+    );
+    let fresh = token(&a, valid, Instant::now() + Duration::from_secs(1));
+    a.origin.lifetime.cancel();
+    assert_eq!(
+        a.install_resource_reply_authority(&fresh),
+        Err(DispatchError::Authority)
+    );
+}
+#[test]
+fn resource_subscription_parameter_scope_revision_and_streams_stay_frozen() {
+    let a = authorized();
+    let resource = a._lease.authority::<ResourcePreparation>().unwrap();
+    let mut offered=envelope("connection.offer",json!({"by_participant":"part_alice","substrate":"quic","capabilities":{},"streams_offered":[{"id":"audio","kind":"audio","direction":"sendrecv","codec_preferences":["pcmu"]}],"substrate_setup":{"kind":"native-prepared/1","revision":1,"offer_id":a.envelope().id(),"streams":[]}})).original().clone();
+    assert!(resource
