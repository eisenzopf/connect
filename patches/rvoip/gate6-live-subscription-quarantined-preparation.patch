+pub struct QuarantinedNativeSubscription {
+    staged: QuarantinedSubscriptionMedia,
+    broker: Arc<NativeNegotiation>,
+    flow: Arc<crate::native_flow::NativeFlow>,
+    original: Envelope,
+    principal: AuthenticatedPrincipal,
+    peer: Arc<PeerAdmission>,
+    participant: String,
+    plan: NativeSubscriptionPlan,
+    deadline: Instant,
+}
+pub struct PreparedNativeSubscription {
+    prepared: PreparedSubscriptionMedia,
+    guard: NegotiationGuard,
+    flow: Arc<crate::native_flow::NativeFlow>,
+    authorized: Arc<AuthorizedEnvelope>,
+    expected: u64,
+}
+impl CanonicalNativeAdapter {
+    /// Stage the exact already-authorized plan before releasing command/source
+    /// readers. The returned object retains no application authority or command.
+    pub async fn stage_native_subscription_resources(
+        &self,
+        core: &Orchestrator,
+        id: &ConnectionId,
+        a: &Arc<AuthorizedEnvelope>,
+        held: Arc<dyn Any + Send + Sync>,
+        plan: NativeSubscriptionPlan,
+        deadline: Instant,
+    ) -> std::result::Result<QuarantinedNativeSubscription, NativeOfferError> {
+        if !plan.changes_resources()
+            || !matches!(
+                a.envelope().kind(),
+                "stream.subscribe" | "stream.unsubscribe"
+            )
+            || a.envelope().expected_revision() != Some(plan.selection().expected_revision())
+            || !a.supports_native_negotiation()
+        {
+            return Err(NativeOfferError::Scope);
+        }
+        let deadline = a.resource_preparation_cutoff(deadline);
+        if Instant::now() >= deadline {
+            return Err(NativeOfferError::Deadline);
+        }
+        let route = self.data_route(id, a)?;
+        let peer = route.peer.upgrade().ok_or(NativeOfferError::NotReady)?;
+        let (broker, flow) = {
+            let installed = route.installation.lock().unwrap_or_else(|p| p.into_inner());
+            let installed = installed.as_ref().ok_or(NativeOfferError::NotReady)?;
+            if installed.controller.revision() != plan.selection().expected_revision() {
+                return Err(NativeOfferError::Conflict);
+            }
+            (
+                installed
+                    .backend
+                    .negotiation
+                    .clone()
+                    .ok_or(NativeOfferError::Unsupported)?,
+                installed.backend.flow.clone(),
+            )
+        };
+        let staged = core
+            .stage_staged_media_and_subscriptions_with_held(
+                &route.session,
+                id,
+                plan.selection().expected_revision(),
+                plan.media().selected(),
+                &BTreeSet::new(),
+                plan.selection().routing(),
+                deadline,
+                a.invocation_cancellation(),
+                held,
+            )
+            .await
+            .map_err(core_error)?;
+        Ok(QuarantinedNativeSubscription {
+            staged,
+            broker,
+            flow,
+            original: a.envelope().clone(),
+            principal: a.principal().clone(),
+            peer,
+            participant: route.member.participant().as_str().into(),
+            plan,
+            deadline,
+        })
+    }
+}
+impl QuarantinedNativeSubscription {
+    /// Consume the UNIQUE original command only after its old invocation/plan
+    /// aliases are released. Resource conversion replaces the outer reply alias
+    /// before broker/adapter preparation can retain this exact command again.
+    pub async fn prepare(
+        self,
+        a: AuthorizedEnvelope,
+    ) -> std::result::Result<PreparedNativeSubscription, NativeOfferError> {
+        if a.envelope().original() != self.original.original()
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                a.principal(),
+                &self.principal,
+            )
+            || !a
+                .peer_admission()
+                .is_some_and(|peer| Arc::ptr_eq(peer, &self.peer))
+        {
+            return Err(NativeOfferError::Scope);
+        }
+        let streams = self
+            .plan
+            .media()
+            .selected()
+            .iter()
+            .map(|stream| stream.requested.logical_id.as_str().to_owned())
+            .collect();
+        let a = Arc::new(a.into_subscription_resource_preparation(
+            self.participant,
+            streams,
+            self.deadline,
+        )?);
+        let expected = self.plan.selection().expected_revision();
+        // Begin only AFTER conversion: the broker may retain this Arc for the
+        // entire signed answer, but it contains no Store/application reader.
+        let guard =
+            self.broker
+                .begin_subscriptions(a.clone(), expected, self.plan.media.clone())?;
+        let prepared = self
+            .staged
+            .prepare()
+            .await
+            .map_err(|error| guard.error(error))?;
+        Ok(PreparedNativeSubscription {
+            prepared,
+            guard,
+            flow: self.flow,
+            authorized: a,
+            expected,
+        })
+    }
+}
+impl PreparedNativeSubscription {
+    pub fn authorized(&self) -> Arc<AuthorizedEnvelope> {
+        self.authorized.clone()
+    }
+    /// Only a separately reconstructed current host invocation can activate.
+    /// A signed parameter answer alone never publishes routes or grants IO.
+    pub async fn activate_with_held(
+        self,
+        held: Arc<dyn Any + Send + Sync>,
+    ) -> std::result::Result<NativeSubscriptionOutcome, NativeOfferError> {
+        self.prepared
+            .activate_with_held(held)
+            .await
+            .map_err(|error| self.guard.error(error))?;
+        self.guard.committed();
+        self.flow
+            .confirmed(self.expected + 1, self.authorized.envelope().id());
+        Ok(NativeSubscriptionOutcome {
+            revision: self.expected + 1,
+            resources_changed: true,
+        })
+    }
+}
