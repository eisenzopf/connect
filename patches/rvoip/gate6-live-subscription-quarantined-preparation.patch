+//! Live resource-changing subscription: original stage, authority-free prepare,
+//! then one fresh authorized activation. Existing media stays published meanwhile.
+use super::*;
+use crate::v2::{
+    auth_dispatch::AuthorizedEnvelope,
+    native_negotiation::{NativeNegotiation, NativeOfferError, NegotiationGuard},
+    native_subscriptions::{core_error, NativeSubscriptionOutcome, NativeSubscriptionPlan},
+    Envelope,
+};
