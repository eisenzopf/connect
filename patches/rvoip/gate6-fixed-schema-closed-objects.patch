+#[test]
+fn closed_preparation_metadata_refuses_asserted_authority_without_disabling_ordinary_extensions() {
+    let vectors: Value = serde_json::from_str(include_str!("golden-vectors.json")).unwrap();
+    let mut value = vectors["vectors"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|v| v["valid"] == true && v["envelope"]["payload"]["handoff_preparation"].is_object())
+        .unwrap()["envelope"]
+        .clone();
+    value["future-envelope"] = json!({"retained":true});
+    value["payload"]["future-payload"] = json!({"retained":true});
+    assert_eq!(
+        Envelope::from_value(value.clone()).unwrap().original(),
+        &value
+    );
+    for field in ["ready", "asserted_authority", "operation_id"] {
+        let mut bad = value.clone();
+        bad["payload"]["handoff_preparation"][field] = json!(true);
+        assert!(Envelope::from_value(bad).is_err(), "{field}");
+    }
+}
