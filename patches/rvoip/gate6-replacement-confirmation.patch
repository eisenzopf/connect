+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_configured_confirmation_accepts_sixteen_keys_and_rejects_malformed_batches() {
+    let s = Scene::new_replacement("quic").await;
+    let expected = "1234567890ABCD*#";
+    let c = Candidate::new(
+        &s,
+        "quic",
+        EndpointConfirmationPolicy::AnsweredDtmf {
+            digits: expected.into(),
+        },
+    )
+    .await;
+    c.io().await;
+    assert_eq!(
+        c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+        Observation::Answered
+    );
+    assert_eq!(
+        c.event(
+            &s,
+            DeviceReplacementEndpointEvent::Dtmf { digits: "1".into() }
+        )
+        .await,
+        Observation::PendingDigits
+    );
+    assert_eq!(
+        c.event(
+            &s,
+            DeviceReplacementEndpointEvent::Dtmf {
+                digits: "2é".into()
+            }
+        )
+        .await,
+        Observation::IncorrectDigits
+    );
+    for digit in expected[1..].chars() {
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf {
+                    digits: digit.to_string()
+                }
+            )
+            .await,
+            Observation::IncorrectDigits
+        );
+    }
+    assert!(s
+        .core
+        .orch
+        .plan_staged_device_replacement(&c.pending)
+        .is_err());
+    for (i, digit) in expected.chars().enumerate() {
+        let observed = c
+            .event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf {
+                    digits: digit.to_string(),
+                },
+            )
+            .await;
+        assert_eq!(
+            observed,
+            if i + 1 == expected.len() {
+                Observation::Confirmed
+            } else {
+                Observation::PendingDigits
+            }
+        );
+    }
+    assert!(s
+        .core
+        .orch
+        .plan_staged_device_replacement(&c.pending)
+        .is_ok());
+    assert!(c.pending.cancel());
+    c.stop().await;
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    s.stop().await;
