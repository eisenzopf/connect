+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_confirmation_replay_gaps_and_media_epochs_cannot_assemble_old_digits() {
+    for mode in [
+        "replay",
+        "out-of-order",
+        "lost",
+        "media-epoch",
+        "confirmed-epoch",
+    ] {
+        let s = Scene::new_replacement("quic").await;
+        let c = Candidate::new(
+            &s,
+            "quic",
+            EndpointConfirmationPolicy::AnsweredDtmf {
+                digits: "55#".into(),
+            },
+        )
+        .await;
+        c.io().await;
+        assert_eq!(
+            c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+            Observation::Answered
+        );
+        let five = DeviceReplacementEndpointEvent::Dtmf { digits: "5".into() };
+        let captured = c.capture(&s, five.clone());
+        let g = grant(
+            &s,
+            c.pending.intent(),
+            &c.principal,
+            Approval::Signal(five.clone()),
+        )
+        .await;
+        if mode == "out-of-order" {
+            let later = c.capture(&s, five.clone());
+            assert_eq!(
+                later.observe_with_held(&g).unwrap(),
+                Observation::PendingDigits
+            );
+            assert_eq!(
+                captured.observe_with_held(&g).unwrap(),
+                Observation::AlreadyObserved
+            );
+        } else {
+            assert_eq!(
+                captured.observe_with_held(&g).unwrap(),
+                Observation::PendingDigits
+            );
+            if mode == "replay" {
+                assert_eq!(
+                    captured.observe_with_held(&g).unwrap(),
+                    Observation::AlreadyObserved
+                );
+            }
+        }
+        drop(g);
+        if mode == "lost" {
+            drop(c.capture(&s, five.clone()));
+        }
+        if mode == "media-epoch" {
+            let queued = c.capture(&s, five.clone());
+            for action in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                let controller = &c.live.leg.controller;
+                let revision = controller.revision();
+                let g = grant(
+                    &s,
+                    c.pending.intent(),
+                    &c.principal,
+                    Approval::ConfirmationGate(revision, action),
+                )
+                .await;
+                controller
+                    .set_media_gate_with_held(
+                        revision,
+                        &BTreeSet::from([desired(Medium::Audio).logical_id]),
+                        action,
+                        deadline(),
+                        Arc::new(g.clone()),
+                    )
+                    .await
+                    .unwrap();
+            }
+            c.io_at(2).await;
+            let g = grant(
+                &s,
+                c.pending.intent(),
+                &c.principal,
+                Approval::Signal(five.clone()),
+            )
+            .await;
+            assert_eq!(
+                queued.observe_with_held(&g).unwrap(),
+                Observation::BeforeAnswerOrMedia
+            );
+            drop(g);
+        }
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf { digits: "#".into() }
+            )
+            .await,
+            Observation::IncorrectDigits,
+            "{mode}"
+        );
+        assert!(s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .is_err());
+        assert_eq!(c.event(&s, five.clone()).await, Observation::PendingDigits);
+        assert_eq!(c.event(&s, five).await, Observation::PendingDigits);
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf { digits: "#".into() }
+            )
+            .await,
+            Observation::Confirmed
+        );
+        let old_plan = s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .unwrap();
+        if mode == "confirmed-epoch" {
+            for action in [StreamGateAction::Pause, StreamGateAction::Resume] {
+                let controller = &c.live.leg.controller;
+                let revision = controller.revision();
+                let g = grant(
+                    &s,
+                    c.pending.intent(),
+                    &c.principal,
+                    Approval::ConfirmationGate(revision, action),
+                )
+                .await;
+                controller
+                    .set_media_gate_with_held(
+                        revision,
+                        &BTreeSet::from([desired(Medium::Audio).logical_id]),
+                        action,
+                        deadline(),
+                        Arc::new(g.clone()),
+                    )
+                    .await
+                    .unwrap();
+            }
+            c.io_at(3).await;
+            assert!(
+                s.core
+                    .orch
+                    .plan_staged_device_replacement(&c.pending)
+                    .is_err(),
+                "old completed confirmation survived a media epoch"
+            );
+            let g = grant(
+                &s,
+                c.pending.intent(),
+                &c.operator,
+                Approval::Commit(old_plan.clone()),
+            )
+            .await;
+            assert!(s
+                .core
+                .orch
+                .commit_staged_device_replacement_with_held(old_plan, &g)
+                .await
+                .is_err());
+            drop(g);
+            for (digit, expected) in [
+                ("5", Observation::PendingDigits),
+                ("5", Observation::PendingDigits),
+                ("#", Observation::Confirmed),
+            ] {
+                assert_eq!(
+                    c.event(
+                        &s,
+                        DeviceReplacementEndpointEvent::Dtmf {
+                            digits: digit.into()
+                        }
+                    )
+                    .await,
+                    expected
+                );
+            }
+            assert!(s
+                .core
+                .orch
+                .plan_staged_device_replacement(&c.pending)
+                .is_ok());
+        }
+        assert!(c.pending.cancel());
+        c.stop().await;
+        s.tone(0, 1).await;
+        s.tone(1, 0).await;
+        s.stop().await;
+    }
