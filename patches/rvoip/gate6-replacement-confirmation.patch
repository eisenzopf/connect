+/// Captured actual duplex incarnation. Metadata only, never a permission lease.
+#[derive(Clone)]
+pub(crate) struct ReplacementReadinessStamp {
+    controller: Weak<StreamController>,
+    revision: u64,
+    duplex: AudioDuplexStamp,
+}
+impl ReplacementReadinessStamp {
+    pub(crate) fn check(&self) -> ControlResult<()> {
+        let controller = self
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let state = controller
+            .state
+            .try_lock()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        self.current(&controller, &state)
+    }
+    fn current(&self, controller: &StreamController, state: &State) -> ControlResult<()> {
+        if state.model.revision() != self.revision {
+            return Err(StreamControlError::NotReady);
+        }
+        self.duplex
+            .current(controller, state)
+            .map_err(|error| match error {
+                // A changed credential is a stale IO incarnation. Only failure to
+                // acquire mutation state above is retryable metadata contention.
+                StreamControlError::Model(MediaTransitionError::Conflict) => {
+                    StreamControlError::NotReady
+                }
+                other => other,
+            })
+    }
+}
