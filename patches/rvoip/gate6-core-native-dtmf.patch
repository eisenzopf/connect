+//! Core signal metadata waits without permission. The sole physical writer
+//! acquires fresh exact source/recipient authority after its own dequeue.
+use super::{
+    auth_dispatch::{lifecycle::NativeLifecycleOrigin, DispatchError},
+    Envelope,
+};
+use rvoip_core::dtmf::*;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+use tokio::{sync::oneshot, time::Instant};
+use tokio_util::sync::CancellationToken;
+
+pub(in crate::v2) struct SignalPermit {
+    pub cancel: CancellationToken,
+    pub deadline: Instant,
+    pub touched: AtomicBool,
+}
+impl SignalPermit {
+    pub fn error(&self) -> DtmfWriteError {
+        if self.touched.load(Ordering::Acquire) {
+            DtmfWriteError::OutcomeUnknown
+        } else if Instant::now() >= self.deadline {
+            DtmfWriteError::DeadlineBeforeWrite
+        } else {
+            DtmfWriteError::Refused
+        }
+    }
+}
+pub(in crate::v2) struct PendingSignal {
+    pub intent: DtmfIntent,
+    pub observation: DtmfSourceObservation,
+    pub recipient: DtmfNativeRecipient,
+    pub policy: Arc<dyn DtmfNativeWriteAuthority>,
+    pub fence: Arc<dyn DtmfIoFence>,
+    pub permit: Arc<SignalPermit>,
+    pub completion: Option<oneshot::Sender<Result<(), DtmfWriteError>>>,
+}
+impl Drop for PendingSignal {
+    fn drop(&mut self) {
+        self.permit.cancel.cancel();
+        if let Some(done) = self.completion.take() {
+            let _ = done.send(Err(self.permit.error()));
+        }
+    }
+}
+pub(in crate::v2) struct SignalSubmission {
+    pub permit: Arc<SignalPermit>,
+    pub receipt: Option<oneshot::Receiver<Result<(), DtmfWriteError>>>,
+}
+impl Drop for SignalSubmission {
+    fn drop(&mut self) {
+        self.permit.cancel.cancel();
+    }
+}
+impl SignalSubmission {
+    pub async fn written(mut self) -> Result<(), DtmfWriteError> {
+        let receipt = self.receipt.take().ok_or(DtmfWriteError::Refused)?;
+        tokio::select! {biased;r=receipt=>r.unwrap_or_else(|_|Err(self.permit.error())),_=self.permit.cancel.cancelled()=>Err(self.permit.error()),_=tokio::time::sleep_until(self.permit.deadline)=>Err(self.permit.error())}
+    }
+}
+/// Own and destroy a stalled sink before the real write guard is released.
+/// A definite pre-IO refusal preserves the unrelated healthy physical writer.
+pub(in crate::v2) async fn write<
+    W: futures::Sink<bytes::Bytes, Error = DispatchError> + Send + Unpin,
+>(
+    writer: &mut Option<W>,
+    frame: &Envelope,
+    pending: PendingSignal,
+    origin: &NativeLifecycleOrigin,
+    physical: &CancellationToken,
+    authority: Option<&CancellationToken>,
+    stop: &CancellationToken,
+    job_deadline: Instant,
+) -> Result<(), DispatchError> {
+    write_owned(
+        writer,
+        frame,
+        pending,
+        &|| origin.current(),
+        physical,
+        authority,
+        stop,
+        job_deadline,
+    )
+    .await
+}
+async fn write_owned<W: futures::Sink<bytes::Bytes, Error = DispatchError> + Send + Unpin>(
+    writer: &mut Option<W>,
+    frame: &Envelope,
+    mut pending: PendingSignal,
+    current: &(dyn Fn() -> bool + Sync),
+    physical: &CancellationToken,
+    authority: Option<&CancellationToken>,
+    stop: &CancellationToken,
+    job_deadline: Instant,
+) -> Result<(), DispatchError> {
+    use futures::SinkExt;
+    let deadline = job_deadline.min(pending.permit.deadline);
+    let ready = || {
+        !pending.permit.cancel.is_cancelled()
+            && !physical.is_cancelled()
+            && !stop.is_cancelled()
+            && !authority.is_some_and(CancellationToken::is_cancelled)
+            && Instant::now() < deadline
+            && current()
+    };
+    let result = async {
+        if !ready() {
+            return Err(pending.permit.error());
+        }
+        let bytes = serde_json::to_vec(frame).map_err(|_| DtmfWriteError::Refused)?;
+        let scope = DtmfNativeWriteScope {
+            intent: &pending.intent,
+            observation: &pending.observation,
+            recipient: &pending.recipient,
+            wire_envelope: &bytes,
+        };
+        let bound = deadline.min(Instant::now() + DTMF_WRITE_DEADLINE);
+        let lease = tokio::time::timeout_at(bound, pending.policy.acquire_native(&scope))
+            .await
+            .map_err(|_| DtmfWriteError::DeadlineBeforeWrite)??;
+        if !ready() {
+            return Err(pending.permit.error());
+        }
+        let lease = lease.with_outer_fence(pending.fence.clone())?;
+        // Nothing takes the physical writer until all source/recipient IO fences
+        // admit this actual future poll. Early refusal therefore leaves it usable.
+        with_dtmf_write_lease(lease, bound, async {
+            let mut owned = writer.take().ok_or(DispatchError::Closed)?;
+            pending.permit.touched.store(true, Ordering::Release);
+            let result = owned.send(bytes::Bytes::from(bytes)).await;
+            if result.is_ok() {
+                *writer = Some(owned);
+            }
+            // If the future is cancelled while send is pending, `owned` drops here
+            // before with_dtmf_write_lease releases its actual store/domain readers.
+            result
+        })
+        .await
+    };
+    let result = tokio::select! {biased;
+     _=pending.permit.cancel.cancelled()=>Err(pending.permit.error()),
+     _=physical.cancelled()=>Err(pending.permit.error()),
+     _=stop.cancelled()=>Err(pending.permit.error()),
+     _=async{match authority{Some(t)=>t.cancelled().await,None=>std::future::pending().await}}=>Err(pending.permit.error()),
+     _=tokio::time::sleep_until(deadline)=>Err(if pending.permit.touched.load(Ordering::Acquire){DtmfWriteError::OutcomeUnknown}else{DtmfWriteError::DeadlineBeforeWrite}),
+     r=result=>r,
+    };
+    let result = if result.is_err() && pending.permit.touched.load(Ordering::Acquire) {
+        Err(DtmfWriteError::OutcomeUnknown)
+    } else {
+        result
+    };
+    if let Some(done) = pending.completion.take() {
+        let _ = done.send(result);
+    }
+    if matches!(result, Err(DtmfWriteError::OutcomeUnknown)) {
+        physical.cancel();
+        Err(DispatchError::SubmissionUnknown)
+    } else {
+        Ok(())
+    }
+}
