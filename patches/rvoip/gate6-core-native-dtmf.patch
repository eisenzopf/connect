+        p.clone(),
+        CancellationToken::new(),
+        Instant::now() + Duration::from_secs(2),
+    );
+    timeout(Duration::from_secs(1), pause.entered.notified())
+        .await
+        .unwrap();
+    assert_eq!(p.calls.load(Ordering::Acquire), 1);
+    r.scene.controller().retire();
+    pause.release.store(true, Ordering::Release);
+    assert_eq!(job.await.unwrap(), Err(DtmfWriteError::Refused));
+    r.no_native_signal().await;
+    drop(r.scene.grants.0.try_write().unwrap());
+    r.stop().await;
+}
