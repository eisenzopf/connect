+
+struct NativeSignalPolicy {
+    source: DtmfEndpoint,
+    recipient: DtmfEndpoint,
+    operation: String,
+    observation: DtmfSourceObservation,
+    domain: Arc<Grants>,
+    wire: Arc<WirePolicy>,
+    source_allowed: Arc<RwLock<bool>>,
+    recipient_allowed: Arc<RwLock<bool>>,
+    calls: AtomicUsize,
+    facts: Mutex<Vec<Vec<u8>>>,
+    source_observed: Option<NativeDtmfObservation>,
+    pause: Mutex<Option<Arc<PauseWrite>>>,
+}
+impl NativeSignalPolicy {
+    fn new(r: &RouteRig, route: &DtmfRoute) -> Arc<Self> {
+        Arc::new(Self {
+            source: route.source().clone(),
+            recipient: route.recipient().clone(),
+            operation: route.intent().operation_id().into(),
+            observation: route.observation().clone(),
+            domain: r.scene.grants.clone(),
+            wire: r.scene.wire_policy.clone(),
+            source_allowed: Arc::new(RwLock::new(true)),
+            recipient_allowed: Arc::new(RwLock::new(true)),
+            calls: AtomicUsize::new(0),
+            facts: Mutex::new(vec![]),
+            source_observed: None,
+            pause: Mutex::new(None),
+        })
+    }
+}
+#[async_trait]
+impl DtmfRoutePolicy for NativeSignalPolicy {
+    async fn acquire(
+        &self,
+        _: &DtmfRouteScope<'_>,
+        _: &DtmfWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        panic!("native signaling borrowed RTP authority")
+    }
+    async fn acquire_info(
+        &self,
+        _: &DtmfRouteScope<'_>,
+        _: &DtmfInfoWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        panic!("native signaling borrowed INFO authority")
+    }
+    async fn acquire_native(
+        &self,
+        scope: &DtmfRouteScope<'_>,
+        native: &DtmfNativeWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        assert!(scope.source == &self.source && scope.recipient == &self.recipient);
+        assert_eq!(scope.intent.operation_id(), self.operation);
+        assert_eq!(scope.observation, &self.observation);
+        assert!(scope.intent == native.intent && scope.observation == native.observation);
+        let frame =
+            Envelope::parse(native.wire_envelope).expect("actual signed native writer bytes");
+        assert_eq!(frame.kind(), "dtmf.received");
+        assert_eq!(frame.scope(Scope::Operation), Some(self.operation.as_str()));
+        assert_eq!(
+            frame.original()["payload"]["digits"],
+            json!(scope.intent.digits())
+        );
+        assert_eq!(
+            frame.original()["payload"]["duration_ms"],
+            json!(scope.intent.duration_ms())
+        );
+        assert_eq!(
+            frame.original()["payload"]["source"],
+            json!(scope.observation.kind().as_str())
+        );
+        assert_eq!(frame.original()["signature"]["keyid"], json!("server"));
+        let actual = native.recipient;
+        assert_eq!(actual.connection, *self.recipient.connection());
+        assert_eq!(actual.session, *self.recipient.session());
+        assert_eq!(actual.conversation, *self.recipient.conversation());
+        assert_eq!(actual.participant, *self.recipient.participant());
+        assert_eq!(actual.transport, self.recipient.transport());
+        assert!(matches!(
+            actual.transport,
+            Transport::Quic | Transport::WebTransport
+        ));
+        assert_eq!(actual.signing_key_id, "client");
+        assert_eq!(actual.signing_algorithm, "EdDSA");
+        assert_eq!(actual.stream_revision, 1);
+        assert_eq!(actual.credential_revision, 1);
+        assert!(!actual.audio_bindings.is_empty());
+        assert_eq!(
+            frame.scope(Scope::Connection),
+            Some(actual.wire_connection.as_str())
+        );
+        assert_eq!(
+            frame.scope(Scope::Session),
+            Some(actual.wire_session.as_str())
+        );
+        assert_eq!(
+            frame.scope(Scope::Conversation),
+            Some(actual.wire_conversation.as_str())
+        );
+        let wire = self.wire.grants.clone().read_owned().await;
+        let grant = self.domain.0.clone().read_owned().await;
+        let source = self.source_allowed.clone().read_owned().await;
+        let recipient = self.recipient_allowed.clone().read_owned().await;
+        let owner = grant
+            .owners
+            .get(&actual.connection)
+            .ok_or(DtmfWriteError::Refused)?;
+        let owner = credential_owner(owner.clone(), &actual.principal)
+            .map_err(|_| DtmfWriteError::Refused)?;
+        owner
+            .member
+            .revalidate_principal(&actual.principal, Utc::now())
+            .map_err(|_| DtmfWriteError::Refused)?;
+        if !owner.member.is_active()
+            || owner.endpoint.state() != rvoip_core::relationships::EndpointState::Verified
+            || owner.endpoint.identity() != owner.member.identity()
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        if owner.member.conversation() != &actual.conversation
+            || owner.member.participant() != &actual.participant
+            || owner.presence.session() != &actual.session
+            || owner.endpoint.transport() != actual.transport
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        if grant.denied
+            || wire.denied
+            || grant.key.revoked
+            || grant.key.algorithm != actual.signing_algorithm
+            || grant.key.not_before.is_some_and(|time| time > Utc::now())
+            || grant.key.expires_at.is_some_and(|time| time <= Utc::now())
+            || !*source
+            || !*recipient
+            || wire.connections.get(&actual.wire_connection) != Some(&actual.connection)
+            || owner.member.epoch() != actual.membership_epoch
+            || owner.member.identity() != &actual.identity
+            || owner.endpoint.endpoint() != &actual.endpoint
+            || owner.endpoint.device() != &actual.device
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        if let Some(observed) = &self.source_observed {
+            let owner = grant
+                .owners
+                .get(observed.connection())
+                .ok_or(DtmfWriteError::Refused)?;
+            owner
+                .member
+                .revalidate_principal(observed.principal(), Utc::now())
+                .map_err(|_| DtmfWriteError::Refused)?;
+            if !owner.member.is_active()
+                || owner.endpoint.state() != rvoip_core::relationships::EndpointState::Verified
+                || owner.endpoint.identity() != owner.member.identity()
+            {
+                return Err(DtmfWriteError::Refused);
+            }
+            if owner.member.conversation() != observed.conversation()
+                || owner.member.participant() != observed.participant()
+                || owner.member.identity() != observed.identity()
+                || owner.member.epoch() != observed.membership_epoch()
+                || owner.endpoint.endpoint() != observed.endpoint()
+                || owner.endpoint.device() != observed.device()
+                || owner.presence.session() != observed.session()
+                || !grant.dtmf_allowed.contains(observed.connection())
+                || !grant
+                    .dtmf_forward_allowed
+                    .contains(&(observed.connection().clone(), actual.connection.clone()))
+            {
+                return Err(DtmfWriteError::Refused);
+            }
+            if observed.operation_id() != scope.intent.operation_id()
+                || observed.connection() != scope.source.connection()
+                || observed.participant() != scope.source.participant()
+                || observed.session() != scope.source.session()
+                || observed.conversation() != scope.source.conversation()
+                || observed.signing_key_id() != "client"
+                || scope.observation.kind() != DtmfSourceKind::Native
+                || scope.observation.observation_id() != Some(observed.observation_id())
+            {
+                return Err(DtmfWriteError::Refused);
+            }
+        } else {
+            assert_eq!(scope.observation.kind(), DtmfSourceKind::Application);
+            assert!(scope.observation.observation_id().is_none());
+        }
+        self.facts
+            .lock()
+            .unwrap()
+            .push(native.wire_envelope.to_vec());
+        let lease = DtmfWriteLease::new(
+            (wire, grant, source, recipient),
+            Instant::now() + Duration::from_millis(200),
+            || true,
+        );
+        match self.pause.lock().unwrap().clone() {
+            Some(pause) => lease.with_fence(pause),
+            None => Ok(lease),
+        }
+    }
+}
+impl RouteRig {
+    fn native_route(&self, op: &str, method: DtmfMethod) -> DtmfRoute {
+        let route = self
+            .scene
+            .native
+            .core
+            .orch
+            .prepare_dtmf_route(
+                self.target.clone(),
+                self.scene.id.clone(),
+                DtmfIntent::new(op.into(), "12#".into(), 100, method).unwrap(),
+            )
+            .unwrap();
+        assert_eq!(route.source().session(), &self.target_session);
+        assert_eq!(route.source().participant(), &self.target_participant);
+        assert_eq!(route.recipient().session(), &self.scene.native.core.session);
+        assert_eq!(route.recipient().connection(), &self.scene.id);
+        route
+    }
+    fn start_native(
+        &self,
+        route: DtmfRoute,
+        policy: Arc<dyn DtmfRoutePolicy>,
+        cancel: CancellationToken,
+        deadline: Instant,
+    ) -> tokio::task::JoinHandle<Result<(), DtmfWriteError>> {
+        let core = self.scene.native.core.orch.clone();
+        tokio::spawn(async move { core.route_dtmf(&route, policy, cancel, deadline).await })
+    }
+    async fn no_native_signal(&mut self) {
+        assert!(
+            timeout(Duration::from_millis(100), self.scene.wire.read())
+                .await
+                .is_err(),
+            "unexpected native signal effect"
+        );
+    }
+    async fn native_frame(&mut self) -> Envelope {
+        let frame = timeout(Duration::from_secs(2), self.scene.wire.read())
+            .await
+            .expect("actual native DTMF deadline");
+        assert_eq!(frame.kind(), "dtmf.received");
+        self.scene.f.verify_server(&frame).await;
+        frame
+    }
+}
