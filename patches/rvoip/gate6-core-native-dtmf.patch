+    pub wire_conversation: String,
+    pub wire_session: String,
+    pub wire_connection: String,
+    pub stream_revision: u64,
+    pub credential_revision: u64,
+    pub audio_bindings: Vec<crate::stream_lifecycle::ReadyMediaBinding>,
+}
+impl std::fmt::Debug for DtmfNativeRecipient {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
