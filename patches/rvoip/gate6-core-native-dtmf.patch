+}
+pub struct DtmfNativeWriteScope<'a> {
+    pub intent: &'a DtmfIntent,
+    pub observation: &'a DtmfSourceObservation,
+    pub recipient: &'a DtmfNativeRecipient,
+    /// Actual signed envelope bytes passed to the sole physical writer.
+    pub wire_envelope: &'a [u8],
+}
+impl std::fmt::Debug for DtmfNativeWriteScope<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfNativeWriteScope(redacted)")
+    }
+}
+#[async_trait::async_trait]
+pub trait DtmfNativeWriteAuthority: Send + Sync {
+    async fn acquire_native(
+        &self,
+        _scope: &DtmfNativeWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        Err(DtmfWriteError::Refused)
+    }
+}
