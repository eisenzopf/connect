+        let stop = CancellationToken::new();
+        {
+            let writing = write_owned(
+                &mut writer,
+                &frame,
+                pending,
+                &|| true,
+                &physical,
+                None,
+                &stop,
+                Instant::now() + Duration::from_secs(1),
+            );
+            tokio::pin!(writing);
+            tokio::select! {r=&mut writing=>panic!("ended early: {r:?}"),_=tokio::time::sleep(Duration::from_millis(10))=>{}}
+            assert!(polls.load(Ordering::Acquire) > 0);
+        }
+        assert!(dropped.load(Ordering::Acquire));
+        assert_eq!(receipt.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown));
+        assert!(p.domain.try_write().is_ok());
+    }
+    #[tokio::test]
+    async fn native_denial_and_stale_physical_fence_preserve_healthy_writer_for_fresh_authorized_command(
+    ) {
+        for reject in ["permission", "fence"] {
+            let p = policy();
+            if reject == "permission" {
+                *p.domain.write().await = false;
+            }
+            let (mut writer, polls, dropped) = sink(&p, false);
+            let (frame, pending, receipt) = test_pending(
+                p.clone(),
+                Arc::new(AtomicBool::new(reject != "fence")),
+                CancellationToken::new(),
+            );
+            let physical = CancellationToken::new();
+            let stop = CancellationToken::new();
+            assert_eq!(
+                write_owned(
+                    &mut writer,
+                    &frame,
+                    pending,
+                    &|| true,
+                    &physical,
+                    None,
+                    &stop,
+                    Instant::now() + Duration::from_secs(1)
+                )
+                .await,
+                Ok(())
+            );
+            assert_eq!(receipt.await.unwrap(), Err(DtmfWriteError::Refused));
+            assert_eq!(polls.load(Ordering::Acquire), 0);
+            assert!(!dropped.load(Ordering::Acquire));
+            assert!(!physical.is_cancelled());
+            assert!(p.domain.try_write().is_ok());
+            *p.domain.write().await = true;
+            let valid = Arc::new(AtomicBool::new(true));
+            let (frame, pending, receipt) =
+                test_pending(p.clone(), valid.clone(), CancellationToken::new());
+            assert_eq!(
+                write_owned(
+                    &mut writer,
+                    &frame,
+                    pending,
+                    &|| true,
+                    &physical,
+                    None,
+                    &stop,
+                    Instant::now() + Duration::from_secs(1)
+                )
+                .await,
+                Ok(())
+            );
+            assert_eq!(receipt.await.unwrap(), Ok(()));
+            assert!(polls.load(Ordering::Acquire) > 0);
+            assert!(!p.live.load(Ordering::Acquire));
+        }
+    }
+}
