+/// Actual source provenance is separate from the requested gateway method.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DtmfSourceKind {
+    Application,
+    Native,
+    SipInfo,
+    SipRfc4733,
+    WebRtcRfc4733,
+}
+impl DtmfSourceKind {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Application => "application",
+            Self::Native => "uctp-native",
+            Self::SipInfo => "sip-info",
+            Self::SipRfc4733 => "rfc4733",
+            Self::WebRtcRfc4733 => "webrtc-rfc4733",
+        }
+    }
+}
+/// Trusted ingress metadata, never a permission grant. Native/SIP/WebRTC
+/// adapters must derive this from actual accepted input, not payload claims.
+#[derive(Clone, PartialEq, Eq)]
+pub struct DtmfSourceObservation {
+    kind: DtmfSourceKind,
+    id: Option<String>,
+    received_at: chrono::DateTime<chrono::Utc>,
+}
+impl std::fmt::Debug for DtmfSourceObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfSourceObservation(redacted)")
+    }
+}
+impl DtmfSourceObservation {
+    pub(crate) fn command() -> Self {
+        Self {
+            kind: DtmfSourceKind::Application,
+            id: None,
+            received_at: chrono::Utc::now(),
+        }
+    }
+    pub fn observed(
+        kind: DtmfSourceKind,
+        id: String,
+        received_at: chrono::DateTime<chrono::Utc>,
+    ) -> Result<Self, DtmfWriteError> {
+        if kind == DtmfSourceKind::Application
+            || id.is_empty()
+            || id.len() > 128
+            || id.chars().any(char::is_control)
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        Ok(Self {
+            kind,
+            id: Some(id),
+            received_at,
+        })
+    }
+    pub fn kind(&self) -> DtmfSourceKind {
+        self.kind
+    }
+    pub fn observation_id(&self) -> Option<&str> {
+        self.id.as_deref()
+    }
+    pub fn received_at(&self) -> chrono::DateTime<chrono::Utc> {
+        self.received_at
+    }
+}
