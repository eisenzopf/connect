+#[tokio::test]
+async fn actual_native_observation_routes_to_another_managed_native_connection_without_forged_source_or_old_grant(
+) {
+    for kind in ["quic", "wt"] {
+        let mut r = RouteRig::new_recipient(kind).await;
+        let mut target = r.scene.second_wire().await;
+        let offer = lifecycle_offer(&r.scene, 1, 0, "recvonly");
+        target.send(r.scene.f.sign(offer)).await;
+        let answer = target.read().await;
+        assert_eq!(answer.kind(), "connection.answer");
+        r.scene.f.verify_server(&answer).await;
+        let callback = target.read().await;
+        assert_eq!(callback.kind(), "connection.offer");
+        target
+            .send(r.scene.f.sign(r.scene.confirmation(&callback)))
+            .await;
+        r.scene.wait(2).await;
+        core_fixture::until(|| {
+            r.scene
+                .native
+                .core
+                .orch
+                .session(&r.scene.native.core.session)
+                .unwrap()
+                .read()
+                .unwrap()
+                .connections
+                .contains_key(&r.scene.second_id)
+        })
+        .await;
+        let observed = r.observation("12#", 100, "info").await;
+        r.scene
+            .grants
+            .0
+            .write()
+            .await
+            .dtmf_forward_allowed
+            .insert((observed.connection().clone(), r.scene.second_id.clone()));
+        let route = observed
+            .prepare_core_route(&r.scene.native.core.orch, r.scene.second_id.clone())
+            .unwrap();
+        assert_eq!(route.observation().kind(), DtmfSourceKind::Native);
+        assert_eq!(
+            route.observation().observation_id(),
+            Some(observed.observation_id())
+        );
+        let mut p = NativeSignalPolicy::new(&r, &route);
+        Arc::get_mut(&mut p).unwrap().source_observed = Some(observed.clone());
+        let job = r.start_native(
+            route,
+            p.clone(),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(2),
+        );
+        let frame = timeout(Duration::from_secs(2), target.read())
+            .await
+            .unwrap();
+        assert_eq!(frame.kind(), "dtmf.received");
+        r.scene.f.verify_server(&frame).await;
+        assert_eq!(frame.scope(Scope::Connection), Some("native_1"));
+        assert_eq!(frame.scope(Scope::Operation), Some(observed.operation_id()));
+        assert_eq!(frame.original()["payload"]["source"], json!("uctp-native"));
+        assert_eq!(
+            frame.original()["payload"]["received_at"],
+            json!(observed.received_at())
+        );
+        assert_eq!(job.await.unwrap(), Ok(()));
+        assert_eq!(p.calls.load(Ordering::Acquire), 1);
+        r.no_native_signal().await;
+        target.server.shutdown().await.unwrap();
+        r.stop().await;
+    }
+}
