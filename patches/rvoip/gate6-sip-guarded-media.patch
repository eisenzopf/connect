+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_sip_ordinary_stream_duplex_survives_guarded_driver_integration() {
+    let peer = Peer::new(true).await;
+    let coordinator = UnifiedCoordinator::new(SipConfig::local("ordinary-uac", 0))
+        .await
+        .unwrap();
+    let adapter = SipAdapter::new(coordinator.clone()).await.unwrap();
+    let request = rvoip_core::adapter::OriginateRequest::new(
+        rvoip_core::ids::SessionId::new(),
+        rvoip_core::ids::ParticipantId::new(),
+        format!("sip:peer@{}", peer.address()),
+        rvoip_core::connection::Direction::Outbound,
+        rvoip_core::capability::CapabilityDescriptor::default(),
+    )
+    .with_transport(Transport::Sip);
+    let handle = adapter.originate(request).await.unwrap();
+    let id = handle.connection.id.clone();
+    let streams = adapter.streams(id.clone()).await.unwrap();
+    assert_eq!(streams.len(), 1);
+    let stream = streams[0].clone();
+    let mut input = stream.try_frames_in().unwrap();
+    adapter.activate_outbound(id.clone()).await.unwrap();
+    core_fixture::until(|| stream.source_ready()).await;
+    core_fixture::until(|| peer.methods.lock().unwrap().contains(&Method::Ack)).await;
+    let (_, heard) = tokio::join!(peer.rtp(marked_audio(), 30), async {
+        let until = tokio::time::Instant::now() + Duration::from_millis(900);
+        let mut heard = 0;
+        while let Ok(Some(frame)) = tokio::time::timeout_at(until, input.recv()).await {
+            if frame.payload_type == Some(0) && non_silent(&frame.payload) {
+                heard += 1;
+            }
+        }
+        heard
+    });
+    assert!(heard > 10, "ordinary SIP decoded input: {heard}");
+    let sender = stream.frames_out();
+    let (_, (_, heard)) = tokio::join!(
+        async {
+            for seq in 1..=30 {
+                sender
+                    .send(MediaFrame {
+                        stream_id: stream.id(),
+                        kind: StreamKind::Audio,
+                        payload: marked_audio(),
+                        timestamp_rtp: seq * 160,
+                        source_clock: None,
+                        captured_at: Utc::now(),
+                        payload_type: Some(0),
+                    })
+                    .await
+                    .unwrap();
+                tokio::time::sleep(Duration::from_millis(20)).await;
+            }
+        },
+        peer.audio(Duration::from_millis(900))
+    );
+    assert!(heard > 10, "ordinary SIP decoded output: {heard}");
+    adapter.end(id, EndReason::Normal).await.unwrap();
+    adapter.drain().await.unwrap();
+    coordinator
+        .shutdown_gracefully(Some(Duration::from_secs(3)))
+        .await
+        .unwrap();
+    assert_eq!(peer.calls(), 1);
+}
