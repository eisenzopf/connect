+impl SipAudioWriter {
+    fn reconfigure(&mut self, runtime: SipMediaCodecRuntime) -> Result<(), &'static str> {
+        self.decoder = SipPayloadCodec::from_negotiated(&runtime.negotiated, runtime.payload_type)
+            .map_err(|_| "sip-codec-reconfigure-failed")?;
+        self.channels = runtime.negotiated.channels.max(1);
+        self.runtime = runtime;
+        Ok(())
+    }
+    async fn write(&mut self, media_frame: MediaFrame, guarded: bool) -> Result<(), &'static str> {
+        if media_frame
+            .payload_type
+            .is_some_and(|pt| pt != self.runtime.payload_type)
+        {
+            return Err("sip-unnegotiated-payload");
+        }
+        let mut frame = self
+            .decoder
+            .decode(&media_frame.payload)
+            .map_err(|_| "sip-invalid-audio-frame")?;
+        let samples = frame.samples.len() / usize::from(self.channels.max(1));
+        frame.timestamp =
+            advance_outbound_timestamp(&mut self.clock, samples, media_frame.timestamp_rtp);
+        if guarded {
+            let exact = self.exact.as_ref().ok_or("sip-exact-writer-unavailable")?;
+            self.coordinator
+                .send_audio_exact(exact, frame)
+                .await
+                .map_err(|_| "sip-audio-send-failed")
+        } else {
+            self.coordinator
+                .send_audio(&self.session_id, frame)
+                .await
+                .map_err(|_| "sip-audio-send-failed")
+        }
+    }
+}
