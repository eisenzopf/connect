+    peer.digit("5").await;
+    assert_eq!(c.signal(&s).await, Observation::Confirmed);
+    let plan = s
+        .core
+        .orch
+        .plan_staged_device_replacement(&c.pending)
+        .unwrap();
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.principal,
+        Approval::Commit(plan.clone()),
+    )
+    .await;
+    let (outcome, _) = s
+        .core
+        .orch
+        .commit_staged_device_replacement_with_held(plan, &g)
+        .await
+        .unwrap();
+    drop(g);
+    assert_eq!(
+        outcome
+            .media
+            .participant_replacement
+            .as_ref()
+            .unwrap()
+            .generation,
+        2
+    );
+    assert!(!c.pending.cancel());
+    assert_eq!(peer.calls(), 1);
+    s.live[0].wire.server.shutdown().await.unwrap();
+    let (_, heard) = tokio::join!(
+        peer.rtp(marked_audio(), 30),
+        native_audio(&s.live[1].wire, Duration::from_millis(900))
+    );
+    assert!(heard > 10, "actual SIP-to-native decoded output: {heard}");
+    let (_, (_, heard)) = tokio::join!(
+        native_rtp(
+            &s.live[1].wire,
+            binding(&s.live[1].leg, Medium::Audio).stream_local_id,
+            2,
+            30
+        ),
+        peer.audio(Duration::from_millis(900))
+    );
+    assert!(heard > 10, "actual native-to-SIP decoded output: {heard}");
+    assert!(c
+        .adapter
+        .is_connection_live(&c.pending.intent().replacement));
+    s.core
+        .orch
+        .end_connection(c.pending.intent().replacement.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    assert_eq!(
+        controller
+            .shutdown(tokio::time::Instant::now() + Duration::from_secs(3))
+            .await,
+        0
+    );
+    c.adapter.drain().await.unwrap();
+    c.coordinator
+        .shutdown_gracefully(Some(Duration::from_secs(3)))
+        .await
+        .unwrap();
+    assert_eq!(peer.calls(), 1);
+    s.stop().await;
+    eprintln!("actual SIP guarded media passed: real RTP private output/input, no pre-confirmation main leakage, wrong/correct attributed DTMF, one generation2 move, retained native duplex after old-device loss");
+}
