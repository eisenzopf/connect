+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_sip_guarded_preparation_cancel_and_remote_eof_keep_original_audio_and_release_ports(
+) {
+    for mode in ["cancel", "remote-eof"] {
+        let s = Scene::new_replacement("quic").await;
+        let peer = Peer::new(true).await;
+        let mut c = Candidate::new(&s, &peer).await;
+        let g = grant(&s, c.pending.intent(), &c.principal, Approval::Start).await;
+        s.core
+            .orch
+            .start_adapter_device_replacement_with_held(&c.pending, &g)
+            .await
+            .unwrap();
+        drop(g);
+        assert_eq!(c.signal(&s).await, Observation::Answered);
+        let controller = c.media(&s).await;
+        let (_, leaked) = tokio::join!(
+            peer.rtp(marked_audio(), 20),
+            native_audio(&s.live[1].wire, Duration::from_millis(700))
+        );
+        assert_eq!(leaked, 0);
+        assert!(s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .is_err());
+        if mode == "remote-eof" {
+            peer.bye().await;
+            tokio::time::timeout(Duration::from_secs(3), c.pending.cancellation().cancelled())
+                .await
+                .unwrap();
+            c.stop(&peer, None).await;
+        } else {
+            c.stop(&peer, Some(Method::Bye)).await;
+        }
+        assert_eq!(
+            controller
+                .shutdown(tokio::time::Instant::now() + Duration::from_secs(3))
+                .await,
+            0
+        );
+        assert_eq!(c.coordinator.allocated_media_port_count().await, 0);
+        assert_eq!(peer.calls(), 1);
+        s.tone(0, 1).await;
+        s.tone(1, 0).await;
+        s.stop().await;
+    }
+}
