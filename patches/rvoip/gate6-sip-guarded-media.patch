@@ -0,0 +1,302 @@
+//! One exact negotiated SIP audio port, under Core's guarded packet custody.
+use super::*;
+use crate::retained_tasks::RetainedTasks;
+use rvoip_core::{
+    ids::{ConnectionId, ConversationId, SessionId as CoreSessionId},
+    staged_streams::{
+        ControlResult, MediaPortCleanup, PortPreparation, StagedMediaAdapter, StreamControlError,
+        WeakAdapterMediaPort,
+    },
+    stream_lifecycle::{MediaFormat, Medium},
+};
+use std::sync::atomic::AtomicU8;
+use std::time::Duration;
+use tokio_util::sync::CancellationToken;
+const NOT_STARTED: u8 = 0;
+const RUNNING: u8 = 1;
+const CLOSING: u8 = 2;
+const STOPPED: u8 = 3;
+struct Runtime {
+    state: AtomicU8,
+    cancel: CancellationToken,
+    stopped: CancellationToken,
+}
+impl Runtime {
+    fn new() -> Arc<Self> {
+        Arc::new(Self {
+            state: AtomicU8::new(NOT_STARTED),
+            cancel: CancellationToken::new(),
+            stopped: CancellationToken::new(),
+        })
+    }
+    fn stop(&self) {
+        self.state.store(STOPPED, Ordering::Release);
+        self.stopped.cancel();
+    }
+}
+struct Completion(Arc<Runtime>);
+impl Drop for Completion {
+    fn drop(&mut self) {
+        self.0.stop();
+    }
+}
+#[async_trait]
+impl MediaPortCleanup for Runtime {
+    async fn close(&self) -> ControlResult<()> {
+        self.cancel.cancel();
+        loop {
+            match self.state.load(Ordering::Acquire) {
+                NOT_STARTED => {
+                    if self
+                        .state
+                        .compare_exchange(NOT_STARTED, STOPPED, Ordering::AcqRel, Ordering::Acquire)
+                        .is_ok()
+                    {
+                        self.stopped.cancel();
+                        return Ok(());
+                    }
+                }
+                RUNNING => {
+                    let _ = self.state.compare_exchange(
+                        RUNNING,
+                        CLOSING,
+                        Ordering::AcqRel,
+                        Ordering::Acquire,
+                    );
+                }
+                STOPPED => return Ok(()),
+                CLOSING => break,
+                _ => unreachable!(),
+            }
+        }
+        tokio::time::timeout(Duration::from_secs(2), self.stopped.cancelled())
+            .await
+            .map_err(|_| StreamControlError::CleanupUnconfirmed)
+    }
+}
+struct Active {
+    port: WeakAdapterMediaPort,
+    runtime: Arc<Runtime>,
+}
+pub(crate) struct SipGuardedMedia {
+    stream: Arc<SipMediaStream>,
+    ids: (ConversationId, CoreSessionId, ConnectionId),
+    generation: u64,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+    lifetime: CancellationToken,
+    tasks: Arc<RetainedTasks>,
+    active: Mutex<Option<Active>>,
+}
+fn codec_name(name: &str) -> String {
+    match name.to_ascii_lowercase().as_str() {
+        "pcmu" | "g.711-mu" | "g711-mu" | "g711-u" => "pcmu".into(),
+        "pcma" | "g.711-a" | "g711-a" => "pcma".into(),
+        other => other.to_owned(),
+    }
+}
+fn matches(format: &MediaFormat, codec: &CodecInfo) -> bool {
+    match format {
+        MediaFormat::Encoded {
+            name,
+            clock_rate_hz,
+            channels,
+            fmtp,
+        } => {
+            codec_name(name) == codec_name(&codec.name)
+                && *clock_rate_hz == codec.clock_rate_hz
+                && *channels == codec.channels
+                && fmtp == &codec.fmtp
+        }
+        _ => false,
+    }
+}
+impl SipGuardedMedia {
+    pub(crate) fn new(
+        stream: Arc<SipMediaStream>,
+        ids: (ConversationId, CoreSessionId, ConnectionId),
+        generation: u64,
+        current: Arc<dyn Fn() -> bool + Send + Sync>,
+        lifetime: CancellationToken,
+        tasks: Arc<RetainedTasks>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            stream,
+            ids,
+            generation,
+            current,
+            lifetime,
+            tasks,
+            active: Mutex::new(None),
+        })
+    }
+    pub(crate) fn bind_controller(&self, controller: &Arc<StreamController>) -> ControlResult<()> {
+        let mut owner = self
+            .stream
+            .inner
+            .guarded_owner
+            .lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if owner.is_some() {
+            return Err(StreamControlError::NotReady);
+        }
+        *owner = Some(Arc::downgrade(controller));
+        Ok(())
+    }
+}
+#[async_trait]
+impl StagedMediaAdapter for SipGuardedMedia {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<()> {
+        if ports.len() != 1 {
+            return Err(StreamControlError::Unsupported);
+        }
+        let p = &ports[0];
+        let port = p.port.clone();
+        if !p.is_new {
+            let active = self
+                .active
+                .lock()
+                .map_err(|_| StreamControlError::NotReady)?;
+            let same = active.as_ref().is_some_and(|a| {
+                a.runtime.state.load(Ordering::Acquire) == RUNNING
+                    && a.port.upgrade().is_some_and(|old| {
+                        old.binding().transport_id == port.binding().transport_id
+                            && old.binding().generation == port.binding().generation
+                    })
+            });
+            return if same
+                && (self.current)()
+                && matches(&port.binding().negotiated.format, &self.stream.codec())
+            {
+                Ok(())
+            } else {
+                Err(StreamControlError::Unsupported)
+            };
+        }
+        let runtime = Runtime::new();
+        port.install_cleanup(runtime.clone())?;
+        if port.context_ids()? != self.ids
+            || port.binding().connection_generation != self.generation
+            || port.binding().negotiated.requested.medium != Medium::Audio
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        {
+            let mut active = self
+                .active
+                .lock()
+                .map_err(|_| StreamControlError::NotReady)?;
+            if active.is_some() {
+                return Err(StreamControlError::Unsupported);
+            }
+            *active = Some(Active {
+                port: port.downgrade(),
+                runtime: runtime.clone(),
+            });
+        }
+        let mut lifecycle = self.stream.subscribe_lifecycle();
+        loop {
+            if !(self.current)() {
+                return Err(StreamControlError::Cancelled);
+            }
+            if self.stream.source_ready()
+                && self
+                    .stream
+                    .inner
+                    .outbound_writes_activated
+                    .load(Ordering::Acquire)
+            {
+                break;
+            }
+            if matches!(
+                *lifecycle.borrow(),
+                SipMediaLifecycle::Closing | SipMediaLifecycle::Closed | SipMediaLifecycle::Failed
+            ) {
+                return Err(StreamControlError::Cancelled);
+            }
+            tokio::select! {biased;
+                _=runtime.cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=self.lifetime.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=cancellation.cancelled()=>return Err(StreamControlError::Cancelled),
+                _=tokio::time::sleep_until(deadline)=>return Err(StreamControlError::Deadline),
+                value=lifecycle.changed()=>if value.is_err(){return Err(StreamControlError::Cancelled);},
+            }
+        }
+        let codec = self.stream.codec();
+        if !matches(&port.binding().negotiated.format, &codec) {
+            return Err(StreamControlError::Unsupported);
+        }
+        let payload_type = codec.payload_type.ok_or(StreamControlError::NotReady)?;
+        let input = self
+            .stream
+            .reserve_frames_in()
+            .map_err(|_| StreamControlError::NotReady)?;
+        let mut output = port.take_egress()?;
+        if runtime
+            .state
+            .compare_exchange(NOT_STARTED, RUNNING, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        let mut input = input.commit();
+        let current = self.current.clone();
+        let lifetime = self.lifetime.clone();
+        let stream = self.stream.clone();
+        let stop = runtime.clone();
+        let task_port = port.clone();
+        let complete = Completion(runtime.clone());
+        let spawned=self.tasks.spawn(async move {
+            let _complete=complete;
+            loop {
+                if stop.cancel.is_cancelled()||!current()||!matches(&task_port.binding().negotiated.format,&stream.codec()){break;}
+                tokio::select!{biased;
+                    _=stop.cancel.cancelled()=>break,
+                    _=lifetime.cancelled()=>break,
+                    value=lifecycle.changed()=>{
+                        if value.is_err()||!stream.source_ready(){break;}
+                    }
+                    value=input.recv()=>match value {
+                        Some(mut frame)=>{
+                            if !current()||!matches(&task_port.binding().negotiated.format,&stream.codec()){break;}
+                            frame.stream_id=task_port.binding().transport_id.clone();
+                            if frame.payload_type!=Some(payload_type){break;}
+                            // This goes through Core's current ingress authority;
+                            // a closed/private preparation never publishes into
+                            // the main programme merely because RTP arrived.
+                            let _=task_port.try_publish(&frame);
+                        }
+                        None=>break,
+                    },
+                    value=output.recv()=>match value {
+                        Some(packet)=>{
+                            if !current(){break;}
+                            tokio::select!{biased;
+                                _=stop.cancel.cancelled()=>break,
+                                _=lifetime.cancelled()=>break,
+                                result=stream.inner.guarded_out_tx.send(packet)=>if result.is_err(){break;},
+                            }
+                        }
+                        None=>break,
+                    },
+                }
+            }
+            let _=task_port.report_terminal();
+        });
+        if !spawned {
+            runtime.stop();
+            return Err(StreamControlError::Cancelled);
+        }
+        port.observe_ready(
+            &port.binding().negotiated.format,
+            true,
+            true,
+            Some(payload_type),
+        )?;
+        Ok(())
+    }
+}
