+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_sip_expired_target_principal_refuses_start_without_faking_route_absence_or_dialing()
+{
+    let s = Scene::new_replacement("quic").await;
+    let peer = Peer::new(true).await;
+    let expires = Utc::now() + chrono::Duration::seconds(2);
+    let c = Candidate::new_target(&s, &peer, Some(expires)).await;
+    tokio::time::sleep(
+        (expires - Utc::now()).to_std().unwrap_or_default() + Duration::from_millis(20),
+    )
+    .await;
+    assert!(
+        c.adapter
+            .is_connection_live(&c.pending.intent().replacement),
+        "authorization expiry is not physical absence"
+    );
+    let g = grant(&s, c.pending.intent(), &c.principal, Approval::Start).await;
+    assert!(s
+        .core
+        .orch
+        .start_adapter_device_replacement_with_held(&c.pending, &g)
+        .await
+        .is_err());
+    drop(g);
+    core_fixture::until(|| {
+        !c.adapter
+            .is_connection_live(&c.pending.intent().replacement)
+    })
+    .await;
+    assert!(peer.methods.lock().unwrap().is_empty());
+    assert_eq!(peer.calls(), 0);
+    c.stop(&peer, None).await;
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    s.stop().await;
+}
