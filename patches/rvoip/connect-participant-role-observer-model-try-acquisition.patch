+    /// Observe actual role and revision under one immediate metadata guard.
+    /// Busy is not a cached role, completion or permission. A terminated
+    /// coordinator preserves its exact terminal revision and no live role.
+    pub fn try_participant_role_snapshot(&self,session:&SessionId,participant:&ParticipantId)
+        ->ControlResult<(u64,Option<ParticipantRole>)> {
+        self.try_participant_model_snapshot(session,Some(participant))?
+            .ok_or_else(||RvoipError::InvalidState("participant control is not enabled").into())
+    }
+    /// Immediate read-only revision; includes the actual terminal scalar.
+    /// MetadataBusy is distinct from missing/uninitialized participant control.
+    pub fn try_participant_revision(&self,session:&SessionId)->ControlResult<u64> {
+        self.try_participant_model_snapshot(session,None)?.map(|snapshot|snapshot.0)
+            .ok_or_else(||RvoipError::InvalidState("participant control is not enabled").into())
+    }
+    /// An existence-only initialization probe. An existing coordinator needs no
+    /// model lock; its retained terminal scalar also prevents reinitialization.
+    /// Busy/poison never becomes false or authorizes initialization/reset.
+    pub fn try_participant_control_enabled(&self,session:&SessionId)->ControlResult<bool> {
+        if self.try_participant_runtime(session)?.is_some() {return Ok(true);}
+        self.try_participant_terminal_revision(session).map(|revision|revision.is_some())
+    }
+    fn try_participant_model_snapshot(&self,session:&SessionId,participant:Option<&ParticipantId>)
+        ->ControlResult<Option<(u64,Option<ParticipantRole>)>> {
+        if let Some(runtime)=self.try_participant_runtime(session)? {
+            let state=participant_model_state(&runtime,true)?;
+            return Ok(Some((state.controller.revision(),participant.and_then(|id|state.controller.role(id).cloned()))));
+        }
+        Ok(self.try_participant_terminal_revision(session)?.map(|revision|(revision,None)))
+    }
+    fn try_participant_terminal_revision(&self,session:&SessionId)->ControlResult<Option<u64>> {
+        let record=match self.sessions.try_get(session) {
+            dashmap::try_result::TryResult::Present(record)=>Arc::clone(record.value()),
+            dashmap::try_result::TryResult::Absent=>return Ok(None),
+            dashmap::try_result::TryResult::Locked=>return Err(ParticipantControlError::Media(crate::staged_streams::StreamControlError::MetadataBusy)),
+        };
+        let terminal=match record.try_read() {
+            Ok(record)=>record.participant_terminal_revision,
+            Err(std::sync::TryLockError::WouldBlock)=>return Err(ParticipantControlError::Media(crate::staged_streams::StreamControlError::MetadataBusy)),
+            Err(std::sync::TryLockError::Poisoned(_))=>return Err(ParticipantControlError::Authority),
+        };
+        Ok(terminal)
+    }
