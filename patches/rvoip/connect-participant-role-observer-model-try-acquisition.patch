+// Only periodic role projection opts into immediate model acquisition.
+// Ordinary APIs preserve their existing wait/poison behavior.
+fn participant_model_state(runtime:&ManagedParticipantSession,immediate:bool)
+    ->ControlResult<std::sync::MutexGuard<'_,ManagedState>> {
+    if !immediate {return Ok(runtime.state.lock().unwrap_or_else(|poison|poison.into_inner()));}
+    match runtime.state.try_lock() {
+        Ok(state)=>Ok(state),
+        Err(std::sync::TryLockError::WouldBlock)=>Err(ParticipantControlError::Media(crate::staged_streams::StreamControlError::MetadataBusy)),
+        Err(std::sync::TryLockError::Poisoned(_))=>Err(ParticipantControlError::Authority),
+    }
 }
 
