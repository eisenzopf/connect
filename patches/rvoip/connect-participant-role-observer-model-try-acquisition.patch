+#[tokio::test(flavor="multi_thread",worker_threads=4)]
+async fn role_watcher_model_busy_preserves_executor_same_mutation_and_real_revocation() {
+    let f=HeldFixture::new().await;
+    let _alice=f.join("alice").await;
+    let who=participant("alice");
+    let before=f.base.orch.try_participant_role_snapshot(&f.session,&who).unwrap();
+    let mutation=f.mutation("alice","same-periodic-role",ParticipantChange::SetSessionRole {role:ParticipantRole::Observer});
+    let context=f.context(mutation.clone(),principal("owner")).await;
+    let runtime=f.base.orch.participant_runtime(&f.session).unwrap();
+    let held=Arc::new(std::sync::atomic::AtomicBool::new(true));
+    let held_owner=held.clone();
+    let (entered,entered_rx)=std::sync::mpsc::channel();
+    let (release,release_rx)=std::sync::mpsc::channel();
+    let owner=std::thread::spawn(move || {
+        let state=runtime.state.lock().unwrap();
+        let _=entered.send(());
+        // A regressed blocking observation cannot strand the owner forever:
+        // release after the fuse, join, then fail its held-before-return proof.
+        let requested=release_rx.recv_timeout(Duration::from_secs(2)).is_ok();
+        drop(state);held_owner.store(false,Ordering::Release);requested
+    });
+    entered_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    let mut readers=Vec::new();
+    for _ in 0..4 {
+        let orch=f.base.orch.clone();let session=f.session.clone();let who=who.clone();let held=held.clone();
+        readers.push(tokio::spawn(async move {
+            let snapshot=orch.try_participant_role_snapshot(&session,&who);
+            let revision=orch.try_participant_revision(&session);
+            let enabled=orch.try_participant_control_enabled(&session);
+            (snapshot,revision,enabled,held.load(Ordering::Acquire))
+        }));
+    }
+    let held_timer=held.clone();
+    let timer=tokio::spawn(async move {
+        tokio::time::sleep(Duration::from_millis(1)).await;
+        held_timer.load(Ordering::Acquire)
+    });
+    let busy=f.base.orch.try_project_session_role_with_held(&f.session,context.principal.clone(),mutation.clone(),context.deadline,context.cancellation.clone(),&context).await;
+    drop(context); // The actual policy reader must not survive a Busy return.
+    let reader_released=f.policy.grant.try_write().map(|mut writer|{*writer=false;}).is_ok();
+    let denied=f.context(mutation.clone(),principal("owner")).await;
+    let revoked=f.base.orch.try_project_session_role_with_held(&f.session,denied.principal.clone(),mutation.clone(),denied.deadline,denied.cancellation.clone(),&denied).await;
+    drop(denied);
+    let mut observations=Vec::new();
+    for reader in readers {observations.push(reader.await);}
+    let timer_returned=timer.await;
+    let release_sent=release.send(()).is_ok();
+    let joined=owner.join(); // All assertions follow original owner closure.
+    assert!(release_sent&&matches!(joined,Ok(true)),"model-holder fuse elapsed before bounded observations returned");
+    assert!(matches!(busy,Err(ParticipantControlError::Media(crate::staged_streams::StreamControlError::MetadataBusy))));
+    assert!(reader_released,"Busy retained an actual external authority reader");
+    assert!(matches!(revoked,Err(ParticipantControlError::Authority)),"real policy revocation must not become temporary metadata Busy");
+    for observed in observations {
+        let(snapshot,revision,enabled,while_held)=observed.unwrap();
+        assert!(while_held,"observation waited for actual model release");
+        assert!(matches!(snapshot,Err(ParticipantControlError::Media(crate::staged_streams::StreamControlError::MetadataBusy))));
+        assert!(matches!(revision,Err(ParticipantControlError::Media(crate::staged_streams::StreamControlError::MetadataBusy))));
+        assert!(matches!(enabled,Ok(true)),"existence never needs the held live model");
+    }
+    assert!(matches!(timer_returned,Ok(true)),"four observer tasks starved the actual four-worker reactor until model release");
+    assert_eq!(f.base.orch.try_participant_role_snapshot(&f.session,&who).unwrap(),before);
+    *f.policy.grant.write().await=true;
+    let current=f.context(mutation.clone(),principal("owner")).await;
+    let applied=f.base.orch.try_project_session_role_with_held(&f.session,current.principal.clone(),mutation.clone(),current.deadline,current.cancellation.clone(),&current).await.unwrap();
+    assert_eq!((&applied.operation_id,&applied.correlation_id),(&mutation.operation_id,&mutation.correlation_id));
+    assert_eq!(applied.role,ParticipantRole::Observer);assert_eq!(applied.revision,before.0+1);
+    let replay=f.base.orch.try_project_session_role_with_held(&f.session,current.principal.clone(),mutation.clone(),current.deadline,current.cancellation.clone(),&current).await.unwrap();
+    assert_eq!(replay,applied,"same actual mutation must replay, not commit twice");
+    assert_eq!(f.base.orch.try_participant_role_snapshot(&f.session,&who).unwrap(),(applied.revision,Some(ParticipantRole::Observer)));
+    drop(current);
+    let denied_mutation=f.mutation("alice","denied-periodic-role",ParticipantChange::SetSessionRole {role:ParticipantRole::Agent});
+    *f.policy.grant.write().await=false;
+    let denied=f.context(denied_mutation.clone(),principal("owner")).await;
+    assert!(matches!(f.base.orch.try_project_session_role_with_held(&f.session,denied.principal.clone(),denied_mutation,denied.deadline,denied.cancellation.clone(),&denied).await,Err(ParticipantControlError::Authority)));
+    drop(denied);
+    assert_eq!(f.base.orch.try_participant_revision(&f.session).unwrap(),applied.revision);
+    let absent=SessionId::from_string("actual-missing-role-observer-session");
+    assert!(matches!(f.base.orch.try_participant_control_enabled(&absent),Ok(false)));
+    assert!(f.base.orch.try_participant_revision(&absent).is_err());
+    *f.policy.grant.write().await=true;
+    f.base.orch.end_session(f.session.clone(),EndReason::Normal).await.unwrap();
+    assert!(matches!(f.base.orch.try_participant_control_enabled(&f.session),Ok(true)));
+    let terminal=f.base.orch.participant_revision(&f.session).unwrap();
+    assert!(terminal>=applied.revision);
+    assert_eq!(f.base.orch.try_participant_revision(&f.session).unwrap(),terminal);
+    assert_eq!(f.base.orch.try_participant_role_snapshot(&f.session,&who).unwrap(),(terminal,None));
+}
