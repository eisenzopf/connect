+use super::*;
+
+#[tokio::test]
+async fn native_video_partial_failed_io_keeps_original_potential_and_never_claims_complete_coverage() {
+    let (observed,point,calls,errors,before)=exercise(3,|c|(c.target.native_video_potential_observation().unwrap(),c.point.frame_realm().unwrap(),c.wire.calls.load(Ordering::Acquire),c.send_errors,c.wire.snapshots.lock().unwrap().clone())).await;
+    assert_eq!(calls,2);assert_eq!(errors,1,"failed original native prefix is still a real error");
+    assert_eq!(observed.exposure.maximum_potential_ordinal,point.ordinal());assert!(observed.guarded_source_points_known);
+    assert!(!observed.physical_io_coverage_complete&&!observed.exposure.coverage_complete);
+    assert!(before.iter().all(|snapshot|snapshot.is_some_and(|value|value.maximum_potential_ordinal==point.ordinal())));
+}
+
+#[tokio::test]
+async fn native_video_unknown_foreign_or_mismatched_capsule_never_changes_native_io_or_adopts_a_realm() {
+    for mode in [1,2,5,7] {
+        let (observed,calls,binding,expected)=exercise(mode,|c|(c.target.native_video_potential_observation().unwrap(),c.wire.calls.load(Ordering::Acquire),c.target.binding().clone(),c.realm.handle().incarnation().unwrap())).await;
+        assert!(calls>=3,"optional unavailable provenance cannot change normal IO");
+        assert!(!observed.guarded_source_points_known&&!observed.physical_io_coverage_complete&&!observed.exposure.coverage_complete);
+        assert_eq!(observed.exposure.maximum_potential_ordinal,0);
+        assert_eq!(observed.identity.logical(),&binding.negotiated.requested.logical_id);
+        assert_eq!(observed.identity.transport(),&binding.transport_id);assert_eq!(observed.identity.handle(),binding.stream_local_id);
+        assert_eq!((observed.identity.generation(),observed.identity.connection_generation()),(binding.generation,binding.connection_generation));
+        assert_eq!(observed.exposure.realm_incarnation,if mode==5 {None}else{Some(expected)},"foreign source never establishes target realm");
+    }
+}
+
+#[tokio::test]
+async fn native_video_unknown_is_sticky_across_a_later_real_original_group_on_same_writer() {
+    let (observed,point,calls)=exercise(6,|c|(c.target.native_video_potential_observation().unwrap(),c.point.frame_realm().unwrap(),c.wire.calls.load(Ordering::Acquire))).await;
+    assert!(calls>=6);assert_eq!(point.ordinal(),2);assert_eq!(observed.exposure.maximum_potential_ordinal,2);
+    assert!(!observed.guarded_source_points_known&&!observed.physical_io_coverage_complete&&!observed.exposure.coverage_complete);
+}
+
+#[tokio::test]
+async fn native_video_tracking_never_substitutes_for_current_core_authority_or_allocates_a_point_after_refusal() {
+    let (observed,authority,calls,source_identity)=exercise(4,|c|(c.target.native_video_potential_observation().unwrap(),matches!(c.publish,Err(StreamControlError::Authority)),c.wire.calls.load(Ordering::Acquire),c.source.native_egress_identity().unwrap())).await;
+    assert!(authority);assert_eq!(calls,0);assert_eq!(observed.exposure.maximum_potential_ordinal,0);
+    assert_ne!(observed.identity.connection(),source_identity.connection());
+    assert!(!observed.physical_io_coverage_complete&&!observed.exposure.coverage_complete);
+    let (video,ordinary_audio)=exercise(8,|c|(c.target.native_video_potential_observation().unwrap(),c.audio.as_ref().is_some_and(|audio|audio.native_egress_identity().is_some()&&audio.native_video_potential_observation().is_none()&&audio.physical_video_exposure().is_none()))).await;
+    assert!(ordinary_audio,"original audio writer/cursor never acquires a video exposure role");
+    assert_eq!(video.exposure.maximum_potential_ordinal,1);assert!(video.guarded_source_points_known);
+}
