+struct Held {
+    domain: Arc<Policy>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    connection: ConnectionId,
+    expected: u64,
+    change: AudioSubscriptionChange,
+    cancel: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+struct HeldLease {
+    held: Arc<Held>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for HeldLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_receive(&self, source: &MediaSource) -> ControlResult<Box<MediaOwner>> {
+        let original = self
+            .held
+            .guard
+            .owners
+            .get(source.connection.as_str())
+            .ok_or(StreamControlError::Authority)?;
+        if original.member.participant() != &source.participant
+            || original.member.epoch() != source.membership_epoch
+            || original.connection.generation() != source.connection_generation
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut target = self.owner.clone();
+        target.may_route_source = !self.held.guard.private;
+        Ok(Box::new(target))
+    }
+}
+struct RoutingPolicy {
+    base: Arc<Policy>,
+    fresh: Arc<AtomicUsize>,
+}
+impl MediaPolicy for RoutingPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.fresh.fetch_add(1, Ordering::AcqRel);
+        self.base.current(scope)
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<Arc<Held>>()
+            .ok_or(StreamControlError::Authority)?;
+        let MediaControlIntent::AudioSubscriptions { expected, change } = intent else {
+            return Err(StreamControlError::Unsupported);
+        };
+        if !Arc::ptr_eq(&self.base, &held.domain)
+            || scope.connection != &held.connection
+            || *expected != held.expected
+            || *change != &held.change
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = held
+            .guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        MediaControl::new(
+            Box::new(HeldLease {
+                held: held.clone(),
+                owner,
+            }),
+            held.cancel.clone(),
+            held.deadline,
+        )
+    }
+}
