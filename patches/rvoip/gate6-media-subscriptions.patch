+            held.expected,
+            change,
+            deadline(),
+            CancellationToken::new(),
+            Some(&held),
+        )
+        .await
+        .unwrap();
+    assert_eq!(before, fresh.load(Ordering::Acquire));
+    drop(held);
+    tokio::time::timeout(Duration::from_millis(100), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    let mut out = s.port(1).take_egress().unwrap();
+    s.publish(0, 1000);
+    s.mixer.tick();
+    assert!(out.try_recv().is_err());
+}
