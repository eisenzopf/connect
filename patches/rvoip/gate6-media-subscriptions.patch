+++ b/crates/foundation/rvoip-core/src/staged_streams/audio_subscriptions.rs
@@ -0,0 +1,493 @@
+//! Retained audio selection intent. Grants are rederived for every frame.
+use super::guarded_audio::GuardedAudioMixer;
+use super::*;
+use crate::ids::ParticipantId;
+use rvoip_core_traits::peer_switch::{PeerDeliveryGuard, PeerQuiescenceGuard};
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct MediaStreamRef {
+    pub connection: ConnectionId,
+    pub logical: StreamId,
+}
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum AudioSubscription {
+    Stream(MediaStreamRef),
+    /// All current and future selected audio streams of this admitted owner.
+    Participant(ParticipantId),
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum AudioSubscriptionChange {
+    Subscribe(Vec<AudioSubscription>),
+    Unsubscribe(Vec<MediaStreamRef>),
+    Clear,
+}
+
+#[derive(Clone)]
+struct Selection {
+    request: AudioSubscription,
+    origin: Membership,
+    owner: Arc<AuthenticatedPrincipal>,
+    publisher: Weak<StreamController>,
+}
+impl Selection {
+    fn owner_matches(&self, source: &StreamController) -> bool {
+        self.origin.identity() == source.origin_member.identity()
+            && self.origin.participant() == source.origin_member.participant()
+            && self.origin.epoch() == source.origin_member.epoch()
+            && self
+                .owner
+                .has_same_owner(&source.credential_snapshot().principal)
+    }
+    fn matches(&self, source: &StreamController, logical: &StreamId) -> bool {
+        if !self.owner_matches(source) {
+            return false;
+        }
+        match &self.request {
+            AudioSubscription::Stream(key) => {
+                key.connection == source.connection
+                    && &key.logical == logical
+                    && self
+                        .publisher
+                        .upgrade()
+                        .is_some_and(|original| std::ptr::eq(original.as_ref(), source))
+            }
+            AudioSubscription::Participant(id) => id == source.origin_member.participant(),
+        }
+    }
+    fn same(&self, other: &Self) -> bool {
+        self.request == other.request
+            && self.origin.identity() == other.origin.identity()
+            && self.origin.epoch() == other.origin.epoch()
+            && self.owner.has_same_owner(&other.owner)
+            && match self.request {
+                AudioSubscription::Stream(_) => Weak::ptr_eq(&self.publisher, &other.publisher),
+                _ => true,
+            }
+    }
+}
+#[derive(Clone, Default)]
+struct Program {
+    selections: Vec<Selection>,
+    excluded: BTreeSet<MediaStreamRef>,
+}
+impl Program {
+    fn allows(&self, source: &StreamController, logical: &StreamId) -> bool {
+        !self.excluded.contains(&MediaStreamRef {
+            connection: source.connection.clone(),
+            logical: logical.clone(),
+        }) && self
+            .selections
+            .iter()
+            .any(|selection| selection.matches(source, logical))
+    }
+    fn same(&self, other: &Self) -> bool {
+        self.excluded == other.excluded
+            && self.selections.len() == other.selections.len()
+            && self
+                .selections
+                .iter()
+                .all(|selection| other.selections.iter().any(|other| selection.same(other)))
+    }
+}
+struct GateState {
+    ticket: PeerRouteTicket,
+    program: Program,
+    started: Instant,
+}
+pub(super) struct SubscriptionGate {
+    state: Mutex<GateState>,
+    cancel: CancellationToken,
+}
+impl SubscriptionGate {
+    pub(super) fn new() -> Arc<Self> {
+        Arc::new(Self {
+            state: Mutex::new(GateState {
+                ticket: PeerRouteTicket::initial(),
+                program: Program::default(),
+                started: Instant::now(),
+            }),
+            cancel: CancellationToken::new(),
+        })
+    }
+    pub(super) fn retire(&self) {
+        self.cancel.cancel();
+        self.state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .ticket
+            .retire_if_current();
+    }
+    pub(super) fn stamp(self: &Arc<Self>) -> SubscriptionStamp {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        SubscriptionStamp {
+            gate: Arc::downgrade(self),
+            ticket: state.ticket.clone(),
+            started: state.started,
+            cancel: self.cancel.clone(),
+        }
+    }
+}
+impl Drop for SubscriptionGate {
+    fn drop(&mut self) {
+        self.cancel.cancel();
+        self.state
+            .get_mut()
+            .unwrap_or_else(|p| p.into_inner())
+            .ticket
+            .retire_if_current();
+    }
+}
+#[derive(Clone)]
+pub(super) struct SubscriptionStamp {
+    gate: Weak<SubscriptionGate>,
+    ticket: PeerRouteTicket,
+    pub(super) started: Instant,
+    pub(super) cancel: CancellationToken,
+}
+impl SubscriptionStamp {
+    pub(super) fn require_target(&self, target: &StreamController) -> ControlResult<()> {
+        let slot = target
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let owner = slot
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .ok_or(StreamControlError::NotReady)?;
+        if !Weak::ptr_eq(&self.gate, &Arc::downgrade(&owner.subscriptions)) {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    pub(super) fn is_current(&self) -> bool {
+        !self.cancel.is_cancelled() && self.ticket.is_current() && self.gate.strong_count() > 0
+    }
+    pub(super) fn begin(
+        &self,
+        source: &StreamController,
+        logical: &StreamId,
+    ) -> ControlResult<PeerDeliveryGuard> {
+        let gate = self.gate.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let state = gate.state.lock().unwrap_or_else(|p| p.into_inner());
+        if self.cancel.is_cancelled()
+            || !self.ticket.is_current()
+            || !state.program.allows(source, logical)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)
+    }
+}
+fn identifier(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 128
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+}
+fn validate(change: &AudioSubscriptionChange) -> ControlResult<()> {
+    let key = |key: &MediaStreamRef| {
+        identifier(key.connection.as_str()) && identifier(key.logical.as_str())
+    };
+    let valid = match change {
+        AudioSubscriptionChange::Subscribe(items) => {
+            !items.is_empty()
+                && items.len() <= 128
+                && items.iter().all(|item| match item {
+                    AudioSubscription::Stream(item) => key(item),
+                    AudioSubscription::Participant(id) => identifier(id.as_str()),
+                })
+        }
+        AudioSubscriptionChange::Unsubscribe(items) => {
+            !items.is_empty() && items.len() <= 128 && items.iter().all(key)
+        }
+        AudioSubscriptionChange::Clear => true,
+    };
+    if valid {
+        Ok(())
+    } else {
+        Err(MediaTransitionError::Invalid.into())
+    }
+}
+fn invocation(
+    controller: &StreamController,
+    credential: &CredentialSnapshot,
+    control: Option<&MediaControl>,
+    deadline: tokio::time::Instant,
+    cancel: &CancellationToken,
+) -> ControlResult<()> {
+    if cancel.is_cancelled() || controller.shutdown.is_cancelled() {
+        return Err(StreamControlError::Cancelled);
+    }
+    if tokio::time::Instant::now() >= deadline {
+        return Err(StreamControlError::Deadline);
+    }
+    if let Some(control) = control {
+        control.valid()?;
+    }
+    controller.check_credential_snapshot(credential)
+}
+
+impl GuardedAudioMixer {
+    #[cfg(test)]
+    pub(crate) fn contains_connection(&self, id: &ConnectionId) -> bool {
+        self.members
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .contains_key(id)
+    }
+    /// A trusted engine operation, not a durable operation receipt. Public
+    /// handlers must use the held variant and their retained mutation identity.
+    pub(crate) async fn change_subscriptions(
+        &self,
+        target: &ConnectionId,
+        expected: u64,
+        change: AudioSubscriptionChange,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<u64> {
+        validate(&change)?;
+        let (controller, gate) = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let member = members.get(target).ok_or(StreamControlError::NotReady)?;
+            (member.controller.clone(), member.subscriptions.clone())
+        };
+        let _flight = controller
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let credential = controller.credential_snapshot();
+        let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+        let control = match held {
+            Some(held) => Some(controller.policy.current_control(
+                &scope,
+                &MediaControlIntent::AudioSubscriptions {
+                    expected,
+                    change: &change,
+                },
+                held,
+            )?),
+            None => None,
+        };
+        let deadline = StreamController::command_deadline(&credential.principal, deadline).min(
+            control
+                .as_ref()
+                .map_or(deadline, |control| control.deadline),
+        );
+        invocation(
+            &controller,
+            &credential,
+            control.as_ref(),
+            deadline,
+            &cancel,
+        )?;
+        let next_program = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let target = members.get(target).ok_or(StreamControlError::NotReady)?;
+            let mut program = gate
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .program
+                .clone();
+            let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+            let lease = control_read(controller.policy.as_ref(), &scope, control.as_ref())?;
+            StreamController::check(&scope, lease.authority())?;
+            state
+                .model
+                .check_routing(&lease.authority().current(), expected)?;
+            match &change {
+                AudioSubscriptionChange::Clear => program = Program::default(),
+                AudioSubscriptionChange::Unsubscribe(keys) => {
+                    for key in keys {
+                        program.selections.retain(|selection| {
+                            selection.request != AudioSubscription::Stream(key.clone())
+                        });
+                        program.excluded.insert(key.clone());
+                    }
+                }
+                AudioSubscriptionChange::Subscribe(selections) => {
+                    for request in selections {
+                        let source = members
+                            .values()
+                            .find(|member| match request {
+                                AudioSubscription::Stream(key) => {
+                                    member.controller.connection == key.connection
+                                        && member.logical == key.logical
+                                }
+                                AudioSubscription::Participant(id) => &member.participant == id,
+                            })
+                            .ok_or(StreamControlError::NotReady)?;
+                        let selection = Selection {
+                            request: request.clone(),
+                            origin: source.controller.origin_member.clone(),
+                            owner: source.controller.credential_snapshot().principal,
+                            publisher: Arc::downgrade(&source.controller),
+                        };
+                        program.selections.retain(|old| old.request != *request);
+                        program.selections.push(selection);
+                        match request {
+                            AudioSubscription::Stream(key) => {
+                                program.excluded.remove(key);
+                            }
+                            AudioSubscription::Participant(id) => {
+                                program.excluded.retain(|key| {
+                                    members
+                                        .get(&key.connection)
+                                        .is_none_or(|member| &member.participant != id)
+                                });
+                            }
+                        }
+                    }
+                }
+            }
+            if program.selections.len() > 128 || program.excluded.len() > 4096 {
+                return Err(MediaTransitionError::Capacity.into());
+            }
+            let _receive_leases = self.validate_program(
+                &members,
+                target,
+                &scope,
+                &program,
+                &change,
+                control.as_ref(),
+                Some(&state),
+            )?;
+            invocation(
+                &controller,
+                &credential,
+                control.as_ref(),
+                deadline,
+                &cancel,
+            )?;
+            program
+        };
+        let old = gate.stamp();
+        let next = old.ticket.stage().ok_or(MediaTransitionError::Capacity)?;
+        let held_cancel = control.as_ref().map(|control| control.cancellation.clone());
+        let _drained: PeerQuiescenceGuard = tokio::select! {
+            biased;
+            _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=controller.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=gate.cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=async{match &held_cancel {Some(cancel)=>cancel.cancelled().await,None=>std::future::pending::<()>().await}}=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,old.ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        };
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let target = members.get(target).ok_or(StreamControlError::NotReady)?;
+        if !Arc::ptr_eq(&target.controller, &controller)
+            || !Arc::ptr_eq(&target.subscriptions, &gate)
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let mut state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        let lease = control_read(controller.policy.as_ref(), &scope, control.as_ref())?;
+        StreamController::check(&scope, lease.authority())?;
+        if state.closed {
+            return Err(StreamControlError::Cancelled);
+        }
+        let _receive_leases = self.validate_program(
+            &members,
+            target,
+            &scope,
+            &next_program,
+            &change,
+            control.as_ref(),
+            Some(&state),
+        )?;
+        let mut routing = gate.state.lock().unwrap_or_else(|p| p.into_inner());
+        if gate.cancel.is_cancelled() || !old.ticket.is_current() {
+            return Err(StreamControlError::Cancelled);
+        }
+        invocation(
+            &controller,
+            &credential,
+            control.as_ref(),
+            deadline,
+            &cancel,
+        )?;
+        let changed = !routing.program.same(&next_program);
+        let revision =
+            state
+                .model
+                .commit_routing(&lease.authority().current(), expected, changed)?;
+        if changed {
+            assert!(
+                next.commit_from(&old.ticket),
+                "routing gate changed outside scene fence"
+            );
+            routing.ticket = next;
+            routing.program = next_program;
+            routing.started = Instant::now();
+        }
+        Ok(revision)
+    }
+    fn validate_program(
+        &self,
+        members: &std::collections::HashMap<ConnectionId, super::guarded_audio::AudioMember>,
+        target: &super::guarded_audio::AudioMember,
+        scope: &MediaScope<'_>,
+        program: &Program,
+        change: &AudioSubscriptionChange,
+        control: Option<&MediaControl>,
+        target_state: Option<&State>,
+    ) -> ControlResult<Vec<ControlRead>> {
+        let mut leases = Vec::new();
+        let AudioSubscriptionChange::Subscribe(requests) = change else {
+            return Ok(leases);
+        };
+        target.current_descriptor(target_state.ok_or(StreamControlError::NotReady)?)?;
+        for request in requests {
+            let selection = program
+                .selections
+                .iter()
+                .find(|selection| &selection.request == request)
+                .ok_or(StreamControlError::NotReady)?;
+            let sources = members
+                .values()
+                .filter(|source| selection.matches(&source.controller, &source.logical))
+                .collect::<Vec<_>>();
+            if sources.is_empty() {
+                return Err(StreamControlError::NotReady);
+            }
+            for source in sources {
+                let descriptor = if Arc::ptr_eq(&source.controller, &target.controller) {
+                    let state = target_state.ok_or(StreamControlError::NotReady)?;
+                    source.current_descriptor(state)?
+                } else {
+                    let state = source
+                        .controller
+                        .state
+                        .lock()
+                        .unwrap_or_else(|p| p.into_inner());
+                    source.current_descriptor(&state)?
+                };
+                let receive_scope = MediaScope {
+                    purpose: MediaPurpose::Receive {
+                        source: &descriptor,
+                    },
+                    ..*scope
+                };
+                let authority = match control {
+                    Some(control) => {
+                        control.valid()?;
+                        ControlRead::Held(control.lease.control_receive(&descriptor)?)
+                    }
+                    None => ControlRead::Current(target.controller.policy.current(&receive_scope)?),
+                };
+                StreamController::check(&receive_scope, authority.authority())?;
+                if !authority.authority().may_route_source
+                    || !authority.authority().send_media.contains(&Medium::Audio)
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                leases.push(authority);
+            }
+        }
+        Ok(leases)
+    }
