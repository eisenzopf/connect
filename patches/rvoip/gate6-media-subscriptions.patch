+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_audio_subscriptions_remove_one_listener_without_disturbing_other_media_or_handles(
+) {
+    use rvoip_core::staged_streams::audio_subscriptions::*;
+    for kind in ["quic", "wt"] {
+        let s = Scene::new(kind).await;
+        let target = &s.live[1].leg;
+        let budget = target.controller.stream_open_budget();
+        let original = binding(target, Medium::Audio);
+        let revision = target.controller.revision();
+        s.core
+            .orch
+            .change_staged_audio_subscriptions(
+                &s.core.session,
+                &target.id,
+                revision,
+                AudioSubscriptionChange::Clear,
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+            .unwrap();
+        s.core.orch.add_subscription(
+            s.core.session.clone(),
+            target.id.clone(),
+            s.live[0].leg.id.clone(),
+            desired(Medium::Audio).logical_id,
+        );
+        s.no_tone(0, 1).await;
+        s.tone(0, 2).await;
+        let change =
+            AudioSubscriptionChange::Subscribe(vec![AudioSubscription::Stream(MediaStreamRef {
+                connection: s.live[0].leg.id.clone(),
+                logical: desired(Medium::Audio).logical_id,
+            })]);
+        s.core
+            .orch
+            .change_staged_audio_subscriptions(
+                &s.core.session,
+                &target.id,
+                target.controller.revision(),
+                change,
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+            .unwrap();
+        s.tone(0, 1).await;
+        s.no_tone(2, 1).await;
+        assert_eq!(budget, target.controller.stream_open_budget());
+        assert_eq!(
+            original.transport_id,
+            binding(target, Medium::Audio).transport_id
+        );
+        assert!(s
+            .live
+            .iter()
+            .all(|live| live.peer.snapshot().connections == 1));
+        s.stop().await;
+    }
+}
