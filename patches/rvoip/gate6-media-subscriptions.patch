+async fn unsubscribe_drains_admitted_send_invalidates_old_mix_and_preserves_other_listeners() {
+    let s = Scene::new(&four()[..3], 8000).await;
+    for i in 0..3 {
+        s.bind(i, true).await;
+    }
+    let mut out = s.port(1).take_egress().unwrap();
+    let mut other = s.port(2).take_egress().unwrap();
+    s.publish(0, 1000);
+    s.mixer.tick();
+    let first = out.try_recv().unwrap();
+    let stale = other.try_recv().unwrap();
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let sent = tokio::spawn({
+        let entered = entered.clone();
+        let release = release.clone();
+        async move {
+            first
+                .deliver(|_| async move {
+                    entered.notify_one();
+                    release.notified().await;
+                    Ok(())
+                })
+                .await
+        }
+    });
+    entered.notified().await;
+    s.publish(0, 1000);
+    s.mixer.tick();
+    let queued = out.try_recv().unwrap();
+    let _ = other.try_recv();
+    let mixer = s.mixer.clone();
+    let c = s.controllers[1].clone();
+    let key = match stream(&s, 0) {
+        AudioSubscription::Stream(key) => key,
+        _ => unreachable!(),
+    };
+    let mut update = tokio::spawn(async move {
+        mixer
+            .change_subscriptions(
+                &c.connection,
+                c.revision(),
+                AudioSubscriptionChange::Unsubscribe(vec![key]),
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+    });
+    assert!(tokio::time::timeout(Duration::from_millis(25), &mut update)
+        .await
+        .is_err());
+    heard(stale, 1000).await;
+    release.notify_one();
+    sent.await.unwrap().unwrap();
+    update.await.unwrap().unwrap();
+    assert!(queued
+        .deliver(|_| async { panic!("removed subscription reached IO") })
+        .await
+        .is_err());
+    s.publish(0, 2000);
+    s.mixer.tick();
+    assert!(out.try_recv().is_err());
+    heard(other.try_recv().unwrap(), 2000).await;
+}
