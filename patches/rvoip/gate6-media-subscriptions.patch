+#[tokio::test]
+async fn subscription_controls_refuse_denied_audience_wrong_revision_and_unsupported_held_hook() {
+    let s = Scene::new(&four()[..2], 8000).await;
+    for i in 0..2 {
+        s.bind_unsubscribed(i, true).await;
+    }
+    let target = &s.controllers[1];
+    let before = target.revision();
+    let change = AudioSubscriptionChange::Subscribe(vec![stream(&s, 0)]);
+    s.policy.0.write().await.private = true;
+    assert!(matches!(
+        route(&s, 1, change.clone()).await,
+        Err(StreamControlError::Authority)
+    ));
+    assert_eq!(before, target.revision());
+    s.policy.0.write().await.private = false;
+    assert!(matches!(
+        s.mixer
+            .change_subscriptions(
+                &target.connection,
+                before,
+                change.clone(),
+                deadline(),
+                CancellationToken::new(),
+                Some(&())
+            )
+            .await,
+        Err(StreamControlError::Unsupported)
+    ));
+    assert!(route(
+        &s,
+        1,
+        AudioSubscriptionChange::Subscribe(vec![AudioSubscription::Stream(MediaStreamRef {
+            connection: ConnectionId::from_string("bad/identifier"),
+            logical: StreamId::from_string("audio")
+        })])
+    )
+    .await
+    .is_err());
+    assert_eq!(before, target.revision());
+    route(&s, 1, change.clone()).await.unwrap();
+    let same = target.revision();
+    assert_eq!(route(&s, 1, change).await.unwrap(), same);
+}
