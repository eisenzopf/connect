+//! Real endpoint preparation, definitive adoption, and original ingress custody.
+//! PCMU fixture decodes actual160-sample audio; no Opus/network/FPS claim.
+use super::*;
+
+fn audio_packet(f: &mut Move, name: &str) -> (AdapterMediaPort, MediaFrame) {
+    let node = f.room.nodes.get_mut(name).unwrap();
+    node.sequence += 1;
+    let port = node.adapter.port(Medium::Audio);
+    let mut packet = frame(&port, node.sequence);
+    packet.timestamp_rtp = node.sequence * 160;
+    (port, packet)
+}
+async fn finish(f: &mut Move) -> Vec<usize> {
+    f.room.scene.clear();
+    let until = deadline();
+    let mut remaining = Vec::new();
+    for node in f.room.nodes.values() {
+        remaining.push(node.controller.shutdown(until).await);
+    }
+    remaining
+}
