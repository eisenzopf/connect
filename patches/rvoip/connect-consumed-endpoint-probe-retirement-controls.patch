+#[tokio::test]
+async fn active_and_failed_endpoint_preparation_stay_closed_and_retirement_never_grants_revoked_audio(
+) {
+    let mut f = Move::for_audio_preroll().await;
+    f.io().await;
+    f.confirm().await;
+    let probe = f._audio_probe.as_ref().unwrap().probe.clone();
+    let plan = f.plan().unwrap();
+    f.room
+        .domain
+        .deny_replacement
+        .store(true, Ordering::Release);
+    let denied = f.commit(plan).await;
+    let (port, packet) = audio_packet(&mut f, "device");
+    let scene = f.room.scene.clone();
+    let registry = scene.audiences.lock().unwrap();
+    let still_registered = registry
+        .groups
+        .get(&probe.group.operation)
+        .is_some_and(|g| Arc::ptr_eq(g, &probe.group));
+    let active_busy = port.retain_original_ingress(packet.clone(), Instant::now());
+    drop(registry);
+    // Successful active probing consumes the actual decoder input privately.
+    let private = port.retain_original_ingress(packet, Instant::now());
+    let no_public_input = f.room.nodes.get_mut("bob").unwrap().out.try_recv().is_err();
+    drop(f._audio_probe.take());
+    let cancelled = probe.cancel.is_cancelled();
+    let (_, packet) = audio_packet(&mut f, "device");
+    let cancelled_capture = port.retain_original_ingress(packet, Instant::now());
+    // Removing a cancelled private observer is not public permission: the
+    // current muted model still refuses this uncommitted endpoint.
+    let current_refused = matches!(cancelled_capture, Err(StreamControlError::NotReady));
+    f.room
+        .domain
+        .deny_replacement
+        .store(false, Ordering::Release);
+    let cleanup = finish(&mut f).await;
+    assert!(cleanup.iter().all(|n| *n == 0));
+    assert!(matches!(denied, Err(StreamControlError::Unsupported)));
+    assert!(still_registered && !probe.group.origins.is_empty());
+    assert!(matches!(
+        active_busy,
+        Err(StreamControlError::Model(MediaTransitionError::Conflict))
+    ));
+    assert!(matches!(private, Ok(None)) && no_public_input);
+    assert!(cancelled && current_refused);
+}
+
+#[tokio::test]
+async fn consumed_endpoint_probe_does_not_bypass_current_revocation_or_retired_original_generation()
+{
+    let mut f = Move::for_audio_preroll().await;
+    f.io().await;
+    f.confirm().await;
+    let plan = f.plan().unwrap();
+    f.commit(plan).await.unwrap();
+    let (port, packet) = audio_packet(&mut f, "device");
+    f.room
+        .domain
+        .base
+        .0
+        .write()
+        .await
+        .revoked
+        .insert("alice".into());
+    let mut original = port
+        .retain_original_ingress(packet, Instant::now())
+        .unwrap()
+        .unwrap();
+    let refused = original.try_publish_clocked(|_| None);
+    f.room.domain.base.0.write().await.revoked.remove("alice");
+    let (_, packet) = audio_packet(&mut f, "device");
+    let mut stale = port
+        .retain_original_ingress(packet, Instant::now())
+        .unwrap()
+        .unwrap();
+    f.room.nodes["device"].controller.retire();
+    let retired = stale.try_publish_clocked(|_| None);
+    let empty = f.room.nodes.get_mut("bob").unwrap().out.try_recv().is_err();
+    let cleanup = finish(&mut f).await;
+    assert!(cleanup.iter().all(|n| *n == 0));
+    assert!(matches!(refused, Err(StreamControlError::Authority)));
+    assert!(matches!(retired, Err(StreamControlError::NotReady)));
+    assert!(empty, "refused original audio reached a remote queue");
+}
