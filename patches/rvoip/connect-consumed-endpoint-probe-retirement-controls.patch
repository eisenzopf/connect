+#[tokio::test]
+async fn consumed_endpoint_probe_kept_alive_after_commit_never_shadows_original_public_audio() {
+    let mut f = Move::for_audio_preroll().await;
+    f.io().await;
+    f.confirm().await;
+    let (old_port, old_frame) = audio_packet(&mut f, "alice");
+    let mut old = old_port
+        .retain_original_ingress(old_frame, Instant::now())
+        .unwrap()
+        .unwrap();
+    let probe = f._audio_probe.as_ref().unwrap().probe.clone();
+    let weak = Arc::downgrade(&probe);
+    let plan = f.plan().unwrap();
+    f.commit(plan).await.unwrap();
+    let old_refused = old.try_publish_clocked(|_| None).is_err();
+    let (port, packet) = audio_packet(&mut f, "device");
+    let scene = f.room.scene.clone();
+    let registry = scene.audiences.lock().unwrap();
+    let consumed = !registry
+        .groups
+        .get(&probe.group.operation)
+        .is_some_and(|g| Arc::ptr_eq(g, &probe.group));
+    let still_owned = weak.upgrade().is_some() && !probe.cancel.is_cancelled();
+    // The original REAL registry mutex is held, just like unrelated private
+    // preparation. Old code returns Model(Conflict) before OriginalIngress.
+    let retained = port.retain_original_ingress(packet, Instant::now());
+    let error = retained.as_ref().err().map(|e| format!("{e:?}"));
+    let mut original = retained.ok().flatten();
+    let submitted = original.as_mut().map(|p| p.try_publish_clocked(|_| None));
+    drop(registry);
+    f.room.tick();
+    let mean = Arc::new(std::sync::atomic::AtomicI32::new(i32::MIN));
+    let callback_mean = mean.clone();
+    let heard = match f.room.nodes.get_mut("bob").unwrap().out.try_recv() {
+        Ok(queued) => Some(
+            queued
+                .deliver(move |frame| async move {
+                    use rvoip_media_core::codec::factory::CodecFactory;
+                    let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+                    let decoded = codec.decode(&frame.payload).unwrap();
+                    let actual = decoded.samples.iter().map(|s| i32::from(*s)).sum::<i32>()
+                        / decoded.samples.len() as i32;
+                    callback_mean.store(actual, Ordering::Release);
+                    Ok(())
+                })
+                .await,
+        ),
+        Err(_) => None,
+    };
+    let actual_mean = mean.load(Ordering::Acquire);
+    let cleanup = finish(&mut f).await;
+    eprintln!("consumed endpoint original audio group_consumed={consumed} retained_owner_alive={still_owned} capture_error={error:?} submitted={submitted:?} decoded_mean={actual_mean} cleanup={cleanup:?}");
+    assert!(cleanup.iter().all(|n| *n == 0));
+    assert!(consumed && still_owned && old_refused);
+    assert!(
+        original.is_some(),
+        "consumed probe intercepted ordinary original audio: {error:?}"
+    );
+    assert!(matches!(submitted, Some(Ok(()))));
+    assert!(matches!(heard, Some(Ok(()))));
+    assert!(
+        (actual_mean - 1800).abs() < 400,
+        "actual ordinary PCM was not delivered"
+    );
+}
