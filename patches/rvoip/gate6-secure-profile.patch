+#[test]
+fn typed_floor_mapping_covers_all_sixty_five_wire_families() {
+    let vectors: Value =
+        serde_json::from_str(include_str!("../src/v2/golden-vectors.json")).unwrap();
+    let mut kinds = HashSet::new();
+    let mut counts = [0usize; 4];
+    for row in
+        vectors["vectors"].as_array().unwrap().iter().filter(|row| {
+            row["valid"] == true && row["id"].as_str().unwrap().starts_with("schema-")
+        })
+    {
+        let value = Envelope::from_value(row["envelope"].clone()).unwrap();
+        kinds.insert(value.kind().to_owned());
+        let floor = scope_policy::required_scope(value.payload());
+        counts[match floor {
+            Some(scope_policy::SESSION) => 0,
+            Some(scope_policy::DATA) => 1,
+            Some(scope_policy::SUBSCRIBE) => 2,
+            None => 3,
+            _ => panic!("unknown scope floor"),
+        }] += 1;
+        if matches!(
+            value.payload(),
+            Payload::MessageSend(_) | Payload::DtmfSend(_)
+        ) {
+            assert_eq!(floor, Some(scope_policy::DATA));
+        }
+        if matches!(
+            value.payload(),
+            Payload::StreamSubscribe(_) | Payload::StreamUnsubscribe(_)
+        ) {
+            assert_eq!(floor, Some(scope_policy::SUBSCRIBE));
+        }
+    }
+    assert_eq!(kinds.len(), 65);
+    assert_eq!(counts, [38, 6, 5, 16]);
+}
