+    assert!(StreamLifecycle::with_open_limit(&f.authority(), MAX_BINDINGS + 1).is_err());
+    let state = StreamLifecycle::with_open_limit(&f.authority(), 23).unwrap();
+    assert_eq!(state.opened_stream_limit(), 23);
+    assert_eq!(state.opened_binding_count(), 0);
+}
