+#[tokio::test]
+async fn cumulative_open_limit_rejects_replacement_before_adapter_io_and_preserves_old_media() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    let replacement = [desired(Medium::Audio).logical_id].into_iter().collect();
+    for _ in 1..16 {
+        f.a.change(
+            f.a.revision(),
+            &[desired(Medium::Audio)],
+            &replacement,
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(f.a.reconcile_cleanup(deadline()).await, 0);
+    }
+    assert_eq!(f.a.stream_open_budget(), (16, 16));
+    let old = f.aa.port(Medium::Audio);
+    let revision = f.a.revision();
+    assert!(matches!(
+        f.a.change(
+            revision,
+            &[desired(Medium::Audio)],
+            &replacement,
+            deadline(),
+            CancellationToken::new()
+        )
+        .await,
+        Err(StreamControlError::Model(MediaTransitionError::Capacity))
+    ));
+    assert_eq!(f.a.revision(), revision);
+    assert_eq!(f.a.stream_open_budget(), (16, 16));
+    assert_eq!(f.aa.outstanding.load(Ordering::Acquire), 1);
+    old.try_publish(&frame(&old, 1)).unwrap();
+    f.a.change(
+        revision,
+        &[desired(Medium::Audio)],
+        &BTreeSet::new(),
+        deadline(),
+        CancellationToken::new(),
+    )
+    .await
+    .unwrap();
+    assert_eq!(f.a.stream_open_budget(), (16, 16));
+    assert_eq!(f.a.reconcile_cleanup(deadline()).await, 0);
+    assert_eq!(f.a.shutdown(deadline()).await, 0);
+    assert_eq!(f.a.stream_open_budget(), (16, 16));
+}
+#[tokio::test]
+async fn failed_prepare_batches_consume_open_budget_without_reset_on_cleanup() {
+    let f = Fixture::new(8);
