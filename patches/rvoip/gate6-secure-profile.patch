+#[test]
+fn default_cumulative_stream_limit_survives_reoffers_endings_and_unchanged_bindings() {
+    let f = Fixture::new();
+    let mut state = initial(&f);
+    let p = profile();
+    let now = Instant::now();
+    let request = [desired("audio", Medium::Audio)];
+    assert_eq!(state.opened_stream_limit(), 16);
+    for index in 2..=16u64 {
+        let candidate = state
+            .prepare(
+                &f.authority(),
+                state.revision(),
+                &p,
+                &p,
+                &request,
+                now,
+                now + Duration::from_secs(10),
+            )
+            .unwrap();
+        let mut ready = bindings(&candidate);
+        ready[0].transport_id = StreamId::from_string(format!("transport-{index}"));
+        ready[0].stream_local_id = index as u16;
+        ready[0].generation = index;
+        state
+            .commit(&f.authority(), &candidate, &ready, now)
+            .unwrap();
+    }
+    assert_eq!(state.opened_binding_count(), 16);
+    let last = state.streams().values().next().unwrap().clone();
+    let candidate = state
+        .prepare(
+            &f.authority(),
+            state.revision(),
+            &p,
+            &p,
+            &request,
+            now,
+            now + Duration::from_secs(10),
+        )
+        .unwrap();
+    let ready = [ReadyMediaBinding {
+        negotiated: last.negotiated.clone(),
+        transport_id: last.transport_id.clone(),
+        stream_local_id: last.stream_local_id,
+        generation: last.generation,
+        connection_generation: 1,
+        source_ready: true,
+        sink_ready: true,
+    }];
+    state
+        .commit(&f.authority(), &candidate, &ready, now)
+        .unwrap();
+    assert_eq!(state.opened_binding_count(), 16);
+    let candidate = state
+        .prepare(
+            &f.authority(),
+            state.revision(),
+            &p,
+            &p,
+            &request,
+            now,
+            now + Duration::from_secs(10),
+        )
+        .unwrap();
+    let mut overflow = ready.clone();
+    overflow[0].generation = 17;
+    overflow[0].stream_local_id = 17;
+    overflow[0].transport_id = StreamId::from_string("overflow");
+    assert_eq!(
+        state.commit(&f.authority(), &candidate, &overflow, now),
+        Err(MediaTransitionError::Capacity)
+    );
+    state.abort(candidate).unwrap();
+    state
+        .end_stream(
+            &f.authority(),
+            state.revision(),
+            &StreamId::from_string("audio"),
+        )
+        .unwrap();
+    assert_eq!(state.opened_binding_count(), 16);
+    let new = [desired("new-audio", Medium::Audio)];
+    let candidate = state
+        .prepare(
+            &f.authority(),
+            state.revision(),
+            &p,
+            &p,
+            &new,
+            now,
+            now + Duration::from_secs(10),
+        )
+        .unwrap();
+    overflow[0].negotiated = candidate.streams()[0].clone();
+    overflow[0].generation = 1;
+    assert_eq!(
+        state.commit(&f.authority(), &candidate, &overflow, now),
+        Err(MediaTransitionError::Capacity)
+    );
+    assert_eq!(state.opened_binding_count(), 16);
+}
+#[test]
+fn configured_cumulative_stream_limit_is_bounded_and_reported() {
+    let f = Fixture::new();
