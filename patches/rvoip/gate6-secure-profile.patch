+struct ScopeValidator(Arc<Validator>);
+#[async_trait]
+impl BearerValidator for ScopeValidator {
+    async fn validate(&self, token: &str) -> Result<IdentityAssurance, BearerAuthError> {
+        Ok(principal(token).assurance)
+    }
+    async fn validate_credential(&self, token: &str) -> Result<ValidatedBearer, BearerAuthError> {
+        let mut credential = self.0.validate_credential(token).await?;
+        let scope = match token {
+            "no-default" => None,
+            "session-only" => Some(scope_policy::SESSION),
+            "data-only" => Some(scope_policy::DATA),
+            "subscribe-only" => Some(scope_policy::SUBSCRIBE),
+            _ => return Ok(credential),
+        };
+        credential.principal.scopes = vec!["control".into()];
+        if let Some(scope) = scope {
+            credential.principal.scopes.push(scope.into());
+        }
+        Ok(credential)
+    }
