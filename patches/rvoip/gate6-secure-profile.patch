+++ b/crates/uctp/rvoip-uctp/src/v2/scope_policy.rs
@@ -0,0 +1,88 @@
+//! Canonical secure command floors, independent of resource authorization.
+use super::{auth_dispatch::DispatchError, Payload};
+use rvoip_auth_core::bearer::AuthenticatedPrincipal;
+pub const SESSION: &str = "uctp:session";
+pub const DATA: &str = "uctp:data";
+pub const SUBSCRIBE: &str = "uctp:subscribe";
+
+/// Exhaustive typed mapping: adding a wire family requires reviewing its floor.
+/// Generic operation commands are resolved by the installed current-authority
+/// policy against their original operation/resource; they have no blanket grant.
+/// Authentication and step-up prove credentials; the resumed command is checked
+/// again against the successor principal's floor and resource authority.
+pub fn required_scope(payload: &Payload) -> Option<&'static str> {
+    use Payload::*;
+    match payload {
+        ConversationCreate(_)
+        | ConversationOpened(_)
+        | ConversationClosed(_)
+        | ConversationClose(_)
+        | ConversationList(_)
+        | ConversationGet(_)
+        | ConversationParticipantAdd(_)
+        | ConversationParticipantUpdate(_)
+        | ConversationParticipantRemove(_)
+        | ConversationParticipantChanged(_)
+        | SessionInvite(_)
+        | SessionAccept(_)
+        | SessionReject(_)
+        | SessionCancel(_)
+        | SessionEnd(_)
+        | SessionStarted(_)
+        | SessionEnded(_)
+        | SessionUpdate(_)
+        | SessionParticipantJoined(_)
+        | SessionParticipantLeft(_)
+        | SessionConsult(_)
+        | SessionHandoff(_)
+        | SessionObservation(_)
+        | ConnectionOffer(_)
+        | ConnectionAnswer(_)
+        | ConnectionReady(_)
+        | ConnectionUpdate(_)
+        | ConnectionEnd(_)
+        | ConnectionIceCandidate(_)
+        | ConnectionQuality(_)
+        | ConnectionReplace(_)
+        | StreamOpened(_)
+        | StreamClosed(_)
+        | StreamActiveSpeaker(_)
+        | CapabilityAdvertise(_)
+        | RecordingVconReady(_)
+        | RecordingVconFetch(_)
+        | RecordingVconFetched(_) => Some(SESSION),
+        MessageSend(_) | MessageDelivered(_) | MessageRead(_) | MessageHistory(_) | DtmfSend(_)
+        | DtmfReceived(_) => Some(DATA),
+        StreamSubscribe(_)
+        | StreamUnsubscribe(_)
+        | ConversationSubscribe(_)
+        | ConversationSnapshot(_)
+        | ConversationEvent(_) => Some(SUBSCRIBE),
+        AuthHello(_)
+        | AuthChallenge(_)
+        | AuthResponse(_)
+        | AuthSession(_)
+        | AuthKeepalive(_)
+        | AuthBye(_)
+        | AuthRefresh(_)
+        | IdentityAssuranceChanged(_)
+        | IdentityStepUpRequest(_)
+        | IdentityStepUpResponse(_)
+        | Ack(_)
+        | Error(_)
+        | OperationGet(_)
+        | OperationCancel(_)
+        | OperationReconcile(_)
+        | OperationUpdated(_) => None,
+    }
+}
+pub(super) fn require(
+    principal: &AuthenticatedPrincipal,
+    payload: &Payload,
+) -> Result<(), DispatchError> {
+    if required_scope(payload).is_some_and(|scope| !principal.has_scope(scope)) {
+        Err(DispatchError::ScopeDenied)
+    } else {
+        Ok(())
+    }
+}
