+// This clock owns no media or authority. Keep the original20ms phase when
+// the executor misses ticks; replaying one old quantum per wake would leave
+// every subsequent input permanently behind the realtime schedule.
+#[derive(Default)]
+struct MixerCadence {
+    next: Option<Instant>,
+}
+impl MixerCadence {
+    fn advance(&mut self, now: Instant) -> u64 {
+        let next = self.next.unwrap_or(now);
+        let late = now.saturating_duration_since(next).as_millis() / 20;
+        let quanta = u64::try_from(late)
+            .unwrap_or(u64::MAX - 1)
+            .saturating_add(1);
+        self.next = Some(
+            next.checked_add(Duration::from_millis(quanta.saturating_mul(20)))
+                .unwrap_or(now + Duration::from_millis(20)),
+        );
+        quanta
+    }
+}
 pub(crate) struct GuardedAudioMixer {
+    cadence: Mutex<MixerCadence>,
