+#[cfg(test)]
+mod cadence_tests {
+    use super::*;
+    #[test]
+    fn missed_ticks_preserve_the_original_phase() {
+        let start = Instant::now();
+        let mut cadence = MixerCadence::default();
+        assert_eq!(cadence.advance(start), 1);
+        assert_eq!(cadence.advance(start + Duration::from_millis(20)), 1);
+        assert_eq!(cadence.advance(start + Duration::from_millis(85)), 3);
+        assert_eq!(cadence.advance(start + Duration::from_millis(100)), 1);
+        assert_eq!(cadence.advance(start + Duration::from_secs(60)), 2995);
+        assert_eq!(cadence.advance(start + Duration::from_millis(60020)), 1);
+    }
+    #[test]
+    fn fractional_delays_do_not_accumulate_permanent_backlog() {
+        let start = Instant::now();
+        let mut cadence = MixerCadence::default();
+        let mut quanta = cadence.advance(start);
+        for i in 1..=40 {
+            quanta += cadence.advance(start + Duration::from_millis(i * 21));
+            assert_eq!(quanta, i * 21 / 20 + 1);
+        }
+    }
+}
