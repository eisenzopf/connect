+use super::*;
+use crate::staged_streams::guarded_audio::GuardedAudioMixer;
+
+struct Scene {
+    policy: Arc<Policy>,
+    mixer: Arc<GuardedAudioMixer>,
+    controllers: Vec<Arc<StreamController>>,
+    adapters: Vec<Arc<Adapter>>,
+}
+impl Scene {
+    async fn new(people: &[(&str, &str, MediaFormat, u8)], rate: u32) -> Self {
+        let mut owners = HashMap::new();
+        for (connection, person, format, _) in people {
+            let mut own = owner(person);
+            let identity = IdentityBinding::from_authenticated(
+                &principal(person),
+                own.member.identity().clone(),
+                chrono::Utc::now(),
+            )
+            .unwrap();
+            let mut ep = EndpointBinding::provision(
+                identity.clone(),
+                EndpointId::from_string(format!("ep-{connection}")),
+                DeviceId::from_string(format!("device-{connection}")),
+                Transport::Quic,
+                "local-fixture".into(),
+            )
+            .unwrap();
+            ep.verify(&identity, "local-proof".into(), chrono::Utc::now())
+                .unwrap();
+            let mut binding = ConnectionBinding::prepare(
+                &own.member,
+                &own.presence,
+                &ep,
+                ConnectionId::from_string(*connection),
+            )
+            .unwrap();
+            binding
+                .observe_ready(&own.member, &own.presence, &ep, 1)
+                .unwrap();
+            binding.activate(&own.member, &own.presence, &ep).unwrap();
+            own.endpoint = ep;
+            own.connection = binding;
+            let caps = EndpointMediaCapabilities {
+                send: vec![MediaCapability {
+                    medium: Medium::Audio,
+                    formats: vec![format.clone()],
+                }],
+                receive: vec![MediaCapability {
+                    medium: Medium::Audio,
+                    formats: vec![format.clone()],
+                }],
+                max_streams: 8,
+                renegotiation: true,
+            };
+            own.local = caps.clone();
+            own.remote = caps;
+            owners.insert(connection.to_string(), own);
+        }
+        let policy = Arc::new(Policy(Arc::new(RwLock::new(PolicyState {
+            owners,
+            revoked: HashSet::new(),
+            private: false,
+        }))));
+        let mixer = GuardedAudioMixer::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            policy.clone(),
+            rate,
+        );
+        let mut controllers = Vec::new();
+        let mut adapters = Vec::new();
+        for (connection, person, _, pt) in people {
+            let adapter = Adapter::new();
+            adapter.audio_pt.store((*pt).into(), Ordering::Release);
+            let controller = StreamController::new(
+                ConversationId::from_string("conversation"),
+                SessionId::from_string("session"),
+                ConnectionId::from_string(*connection),
+                principal(person),
+                policy.clone(),
+                adapter.clone(),
+                Arc::new(StreamHandleAllocator::default()),
+                16,
+            )
+            .unwrap();
+            controller
+                .change(
+                    0,
+                    &[desired(Medium::Audio)],
+                    &BTreeSet::new(),
+                    deadline(),
+                    CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+            controllers.push(controller);
+            adapters.push(adapter);
+        }
+        Self {
+            policy,
+            mixer,
+            controllers,
+            adapters,
+        }
+    }
+    async fn bind(&self, index: usize, speaks: bool) {
+        let controller = self.controllers[index].clone();
+        let mut member = self.mixer.prepare(controller.clone()).unwrap();
+        member
+            .quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        assert!(member.ready());
+        self.mixer
+            .insert(controller.connection.clone(), member, speaks);
+    }
+    fn port(&self, index: usize) -> AdapterMediaPort {
+        self.adapters[index].port(Medium::Audio)
+    }
+    fn publish(&self, index: usize, value: i16) {
+        let port = self.port(index);
+        let MediaFormat::Encoded {
+            name,
+            clock_rate_hz,
+            channels,
+            fmtp,
+        } = &port.binding().negotiated.format
+        else {
+            panic!()
+        };
+        let selector = if name.eq_ignore_ascii_case("opus") {
+            111
+        } else {
+            0
+        };
+        let mut codec = rvoip_media_core::codec::factory::CodecFactory::create_negotiated_codec(
+            selector,
+            name,
+            Some(*clock_rate_hz),
+            Some((*channels).into()),
+            fmtp.as_deref(),
+        )
+        .unwrap();
+        let payload = codec
+            .encode(&rvoip_media_core::AudioFrame {
+                samples: vec![value; (*clock_rate_hz / 50) as usize * usize::from(*channels)],
+                sample_rate: *clock_rate_hz,
+                channels: *channels,
+                duration: Duration::from_millis(20),
+                timestamp: 0,
+            })
+            .unwrap();
+        let payload_type = port.0.state.lock().unwrap().payload_type;
+        port.try_publish(&MediaFrame {
+            stream_id: port.binding().transport_id.clone(),
+            kind: StreamKind::Audio,
+            payload: payload.into(),
+            timestamp_rtp: 0,
+            source_clock: None,
+            captured_at: chrono::Utc::now(),
+            payload_type,
+        })
+        .unwrap();
+    }
+}
+async fn heard(queue: QueuedMedia, expected: i16) {
+    queue
+        .deliver(|frame| async move {
+            let mut decoder = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                0,
+                Some(8000),
+                Some(1),
+            )
+            .unwrap();
+            let samples = decoder.decode(&frame.payload).unwrap().samples;
+            assert_eq!(samples.len(), 160);
+            assert!(
+                (i32::from(samples[80]) - i32::from(expected)).abs() < 350,
+                "expected {expected}, got {}",
+                samples[80]
+            );
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
+fn four() -> Vec<(&'static str, &'static str, MediaFormat, u8)> {
+    vec![
+        ("alice-one", "alice", audio(), 0),
+        ("bob-one", "bob", audio(), 0),
+        ("carol-one", "carol", audio(), 0),
+        ("alice-two", "alice", audio(), 0),
+        ("dave-one", "dave", audio(), 0),
+    ]
+}
