+//! Guarded audio scene bindings for the general participant controller.
+use super::audio_consumer::{AudioConsumer, ConsumerCheck, ConsumerStamp};
+use super::*;
+use crate::capability::CodecInfo;
+use crate::ids::ParticipantId;
+use rvoip_media_core::{
+    codec::factory::CodecFactory, processing::format::resampler::Resampler, AudioFrame,
+};
+use std::collections::{HashMap, VecDeque};
+
+struct Codecs {
+    info: CodecInfo,
+    decoder: Box<dyn rvoip_media_core::codec::audio::common::AudioCodec>,
+    encoder: Box<dyn rvoip_media_core::codec::audio::common::AudioCodec>,
+    to_mix: Option<Resampler>,
+    from_mix: Option<Resampler>,
+}
+impl Codecs {
+    fn new(format: &MediaFormat, payload_type: u8, mix_rate: u32) -> ControlResult<Self> {
+        let MediaFormat::Encoded {
+            name,
+            clock_rate_hz,
+            channels,
+            fmtp,
+        } = format
+        else {
+            return Err(StreamControlError::Unsupported);
+        };
+        let normalized = name.to_ascii_lowercase();
+        let valid_layout = match normalized.as_str() {
+            "pcmu" | "pcma" | "g729" | "amr" => *clock_rate_hz == 8000 && *channels == 1,
+            "amr-wb" => *clock_rate_hz == 16000 && *channels == 1,
+            "opus" => *clock_rate_hz == 48000 && [1, 2].contains(channels),
+            _ => false,
+        };
+        if !valid_layout || payload_type > 127 {
+            return Err(StreamControlError::Unsupported);
+        }
+        let selector = match normalized.as_str() {
+            "pcmu" => 0,
+            "pcma" => 8,
+            "g729" => 18,
+            "opus" => 111,
+            "amr" | "amr-wb" => payload_type,
+            _ => return Err(StreamControlError::Unsupported),
+        };
+        if payload_type < 96 && payload_type != selector {
+            return Err(StreamControlError::Unsupported);
+        }
+        let make = || {
+            CodecFactory::create_negotiated_codec(
+                selector,
+                name,
+                Some(*clock_rate_hz),
+                Some((*channels).into()),
+                fmtp.as_deref(),
+            )
+            .map_err(|_| StreamControlError::Unsupported)
+        };
+        let resample = |from, to| {
+            if from == to {
+                Ok(None)
+            } else {
+                Resampler::new(from, to, 5)
+                    .map(Some)
+                    .map_err(|_| StreamControlError::Unsupported)
+            }
+        };
+        let decoder = make()?;
+        let encoder = make()?;
+        for actual in [decoder.get_info(), encoder.get_info()] {
+            if actual.sample_rate != *clock_rate_hz || actual.channels != *channels {
+                return Err(StreamControlError::Unsupported);
+            }
+        }
+        Ok(Self {
+            info: CodecInfo {
+                name: name.clone(),
+                clock_rate_hz: *clock_rate_hz,
+                channels: *channels,
+                fmtp: fmtp.clone(),
+                payload_type: Some(payload_type),
+            },
+            decoder,
+            encoder,
+            to_mix: resample(*clock_rate_hz, mix_rate)?,
+            from_mix: resample(mix_rate, *clock_rate_hz)?,
+        })
+    }
+    fn decode(&mut self, frame: &MediaFrame) -> ControlResult<Vec<i16>> {
+        let decoded = self
+            .decoder
+            .decode(&frame.payload)
+            .map_err(|_| StreamControlError::NotReady)?;
+        let channels = usize::from(decoded.channels);
+        if decoded.sample_rate != self.info.clock_rate_hz
+            || decoded.channels != self.info.channels
+            || channels == 0
+            || !decoded.samples.len().is_multiple_of(channels)
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let mono = decoded
+            .samples
+            .chunks_exact(channels)
+            .map(|frame| {
+                (frame.iter().map(|v| i64::from(*v)).sum::<i64>() / channels as i64) as i16
+            })
+            .collect::<Vec<_>>();
+        match &mut self.to_mix {
+            Some(resample) => resample
+                .resample(&mono)
+                .map_err(|_| StreamControlError::NotReady),
+            None => Ok(mono),
+        }
+    }
+    fn encode(&mut self, mono: Vec<i16>, timestamp: u32) -> ControlResult<MediaFrame> {
+        let samples = match &mut self.from_mix {
+            Some(resample) => resample
+                .resample(&mono)
+                .map_err(|_| StreamControlError::NotReady)?,
+            None => mono,
+        };
+        let interleaved = samples
+            .into_iter()
+            .flat_map(|sample| std::iter::repeat_n(sample, usize::from(self.info.channels)))
+            .collect();
+        let payload = self
+            .encoder
+            .encode(&AudioFrame {
+                samples: interleaved,
+                sample_rate: self.info.clock_rate_hz,
+                channels: self.info.channels,
+                duration: Duration::from_millis(20),
+                timestamp,
+            })
+            .map_err(|_| StreamControlError::NotReady)?;
+        Ok(MediaFrame {
+            source_clock: None,
+            stream_id: StreamId::from_string("unbound-mix"),
+            kind: StreamKind::Audio,
+            payload: payload.into(),
+            timestamp_rtp: timestamp,
+            captured_at: chrono::Utc::now(),
+            payload_type: self.info.payload_type,
+        })
+    }
+}
+struct Chunk {
+    packet: MediaPacket,
+    samples: VecDeque<i16>,
+}
+struct Segment {
+    offset: usize,
+    samples: Vec<i16>,
+    origin: Contribution,
+    admitted_at: Instant,
+    deadline: tokio::time::Instant,
+}
+pub(crate) struct AudioMember {
+    controller: Arc<StreamController>,
+    logical: StreamId,
+    participant: ParticipantId,
+    consumer: Arc<AudioConsumer>,
+    port: Arc<Port>,
+    ticket: PeerRouteTicket,
+    stamp: ConsumerStamp,
+    input: mpsc::Receiver<MediaPacket>,
+    codecs: Codecs,
+    pending: VecDeque<Chunk>,
+    ticks: u64,
+    target_started: Instant,
+    previous_sources: Vec<Contribution>,
+    flight: Option<OwnedSemaphorePermit>,
+    preparation: Option<rvoip_core_traits::peer_switch::PeerQuiescenceGuard>,
+}
+impl AudioMember {
+    /// The inactive scene marker refuses new admissions while the original
+    /// physical port's admitted local sends drain. Keep this gate until commit.
+    pub(crate) async fn quiesce(
+        &mut self,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<()> {
+        self.preparation = Some(tokio::select! {
+            biased;
+            _=cancellation.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=self.controller.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,self.ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        });
+        Ok(())
+    }
+    pub(crate) fn ready(&self) -> bool {
+        let state = self
+            .controller
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        self.preparation.is_some()
+            && !state.closed
+            && !self.controller.shutdown.is_cancelled()
+            && state
+                .active
+                .get(&self.logical)
+                .is_some_and(|port| Arc::ptr_eq(port, &self.port))
+            && state
+                .model
+                .streams()
+                .get(&self.logical)
+                .is_some_and(|stream| stream.state == LogicalStreamState::Active)
+            && self
+                .port
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .status
+                == PortStatus::Active
+    }
+    pub(crate) fn bound_to(&self, member: &Membership, endpoint: &EndpointBinding) -> bool {
+        self.controller.is_bound_to(member, endpoint)
+    }
+    pub(crate) fn activate(&mut self, speaks: bool) {
+        self.consumer.activate(speaks);
+        self.stamp = self.consumer.stamp();
+        self.target_started = self.stamp.started;
+        self.preparation.take();
+        self.flight.take();
+    }
+    fn refresh(&mut self) -> ControlResult<()> {
+        let port = {
+            let state = self
+                .controller
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            if state.closed || self.controller.shutdown.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            state
+                .active
+                .get(&self.logical)
+                .cloned()
+                .ok_or(StreamControlError::NotReady)?
+        };
+        let stamp = self.consumer.stamp();
+        let changed = !Arc::ptr_eq(&port, &self.port);
+        let epoch = !self.ticket.is_current() || !self.stamp.is_current();
+        if changed || epoch {
+            let pt = port
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .payload_type
+                .ok_or(StreamControlError::NotReady)?;
+            let codecs = Codecs::new(&port.binding.negotiated.format, pt, self.consumer.mix_rate)?;
+            if changed {
+                self.input = port
+                    .input
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .take()
+                    .ok_or(MediaTransitionError::Conflict)?;
+            }
+            self.port = port;
+            self.ticket = self.port.ticket();
+            self.stamp = stamp;
+            self.codecs = codecs;
+            self.pending.clear();
+            self.previous_sources.clear();
+            self.target_started = Instant::now().max(self.stamp.started);
+        }
+        Ok(())
+    }
+    fn collect(&mut self) {
+        for _ in 0..16 {
+            let Ok(packet) = self.input.try_recv() else {
+                break;
+            };
+            if packet.admitted_at.elapsed() > Duration::from_millis(200) {
+                continue;
+            }
+            let Ok((_lease, _admission, deadline)) = self.controller.admit(
+                &packet.source,
+                &packet.ticket,
+                false,
+                None,
+                ConsumerCheck::Retained(packet.consumer.as_ref()),
+            ) else {
+                continue;
+            };
+            let Ok(samples) = self.codecs.decode(&packet.frame) else {
+                continue;
+            };
+            if tokio::time::Instant::now() >= deadline {
+                continue;
+            }
+            self.pending.push_back(Chunk {
+                packet,
+                samples: samples.into(),
+            });
+        }
+        let mut count = self
+            .pending
+            .iter()
+            .map(|chunk| chunk.samples.len())
+            .sum::<usize>();
+        while count > 8000 {
+            let first = self.pending.front_mut().unwrap();
+            let remove = (count - 8000).min(first.samples.len());
+            first.samples.drain(..remove);
+            count -= remove;
+            if first.samples.is_empty() {
+                self.pending.pop_front();
+            }
+        }
+    }
+    fn take(
+        &mut self,
+        size: usize,
+        leases: &mut Vec<Box<dyn MediaAuthorityLease>>,
+        admissions: &mut Vec<audio_consumer::MediaAdmission>,
+    ) -> Vec<Segment> {
+        let mut segments = Vec::new();
+        let mut offset = 0;
+        while offset < size {
+            let Some(chunk) = self.pending.front_mut() else {
+                break;
+            };
+            if chunk.packet.admitted_at.elapsed() > Duration::from_millis(200) {
+                self.pending.pop_front();
+                continue;
+            }
+            let Ok((lease, admission, deadline)) = self.controller.admit(
+                &chunk.packet.source,
+                &chunk.packet.ticket,
+                false,
+                None,
+                ConsumerCheck::Retained(chunk.packet.consumer.as_ref()),
+            ) else {
+                self.pending.pop_front();
+                continue;
+            };
+            let descriptor = MediaSource {
+                conversation: self.controller.conversation.clone(),
+                session: self.controller.session.clone(),
+                connection: self.controller.connection.clone(),
+                participant: self.participant.clone(),
+                membership_epoch: self.controller.origin_member.epoch(),
+                connection_generation: chunk.packet.source.binding.connection_generation,
+                logical_id: self.logical.clone(),
+                transport_id: chunk.packet.source.binding.transport_id.clone(),
+                stream_generation: chunk.packet.source.binding.generation,
+            };
+            let amount = (size - offset).min(chunk.samples.len());
+            let samples = chunk.samples.drain(..amount).collect();
+            segments.push(Segment {
+                offset,
+                samples,
+                origin: Contribution {
+                    source: chunk.packet.source.clone(),
+                    ticket: chunk.packet.ticket.clone(),
+                    consumer: chunk.packet.consumer.clone(),
+                    descriptor,
+                },
+                admitted_at: chunk.packet.admitted_at,
+                deadline,
+            });
+            leases.push(lease);
+            admissions.push(admission);
+            offset += amount;
+            if chunk.samples.is_empty() {
+                self.pending.pop_front();
+            }
+        }
+        segments
+    }
+}
+pub(crate) struct GuardedAudioMixer {
+    conversation: ConversationId,
+    session: SessionId,
+    policy: Arc<dyn MediaPolicy>,
+    rate: u32,
+    members: Mutex<HashMap<ConnectionId, AudioMember>>,
+}
+impl GuardedAudioMixer {
+    pub(crate) fn new(
+        conversation: ConversationId,
+        session: SessionId,
+        policy: Arc<dyn MediaPolicy>,
+        rate: u32,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            conversation,
+            session,
+            policy,
+            rate,
+            members: Mutex::new(HashMap::new()),
+        })
+    }
+    pub(crate) fn prepare(&self, controller: Arc<StreamController>) -> ControlResult<AudioMember> {
+        if controller.conversation != self.conversation
+            || controller.session != self.session
+            || !Arc::ptr_eq(&controller.policy, &self.policy)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let flight = controller
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.closed || controller.shutdown.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let ports = state
+            .active
+            .values()
+            .filter(|port| {
+                port.binding.negotiated.requested.medium == Medium::Audio
+                    && state
+                        .model
+                        .streams()
+                        .get(&port.binding.negotiated.requested.logical_id)
+                        .is_some_and(|stream| stream.state == LogicalStreamState::Active)
+            })
+            .cloned()
+            .collect::<Vec<_>>();
+        if ports.is_empty() {
+            return Err(StreamControlError::NotReady);
+        }
+        if ports.len() != 1 {
+            return Err(StreamControlError::Unsupported);
+        }
+        let port = ports[0].clone();
+        if port.binding.negotiated.requested.direction != StreamDirection::Both {
+            return Err(StreamControlError::Unsupported);
+        }
+        let pt = {
+            let state = port.state.lock().unwrap_or_else(|p| p.into_inner());
+            if !state.ready || state.status != PortStatus::Active {
+                return Err(StreamControlError::NotReady);
+            }
+            state.payload_type.ok_or(StreamControlError::NotReady)?
+        };
+        let codecs = Codecs::new(&port.binding.negotiated.format, pt, self.rate)?;
+        let mut slot = controller
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        if slot.is_some() {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let input = port
+            .input
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(MediaTransitionError::Conflict)?;
+        let consumer = AudioConsumer::new(
+            port.binding.negotiated.requested.logical_id.clone(),
+            self.rate,
+        );
+        let stamp = consumer.stamp();
+        *slot = Some(Arc::downgrade(&consumer));
+        drop(slot);
+        drop(state);
+        Ok(AudioMember {
+            logical: consumer.logical.clone(),
+            participant: controller.origin_member.participant().clone(),
+            controller,
+            consumer,
+            port: port.clone(),
+            ticket: port.ticket(),
+            stamp,
+            input,
+            codecs,
+            pending: VecDeque::new(),
+            ticks: 0,
+            target_started: Instant::now(),
+            previous_sources: Vec::new(),
+            flight: Some(flight),
+            preparation: None,
+        })
+    }
+    pub(crate) fn insert(&self, id: ConnectionId, mut member: AudioMember, speaks: bool) {
+        // Final current-readiness checks precede the Participant commit. EOF
+        // may linearize immediately afterwards; it must retire that committed
+        // route rather than panic after the logical mutation already applied.
+        assert!(
+            member.preparation.is_some(),
+            "staged member must drain original sends before admission"
+        );
+        member.activate(speaks);
+        self.members
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .insert(id, member);
+    }
+    pub(crate) fn remove(&self, id: &ConnectionId) {
+        if let Some(member) = self
+            .members
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .remove(id)
+        {
+            member.consumer.retire();
+        }
+    }
+    pub(crate) fn clear(&self) {
+        for (_, member) in self
+            .members
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .drain()
+        {
+            member.consumer.retire();
+        }
+    }
+    pub(crate) fn role_targets(&self, ids: &[ConnectionId]) -> Vec<Arc<AudioConsumer>> {
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        ids.iter()
+            .filter_map(|id| members.get(id).map(|member| member.consumer.clone()))
+            .collect()
+    }
+    pub(crate) fn tick(&self) {
+        let mut members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let mut leases = Vec::new();
+        let mut admissions = Vec::new();
+        let mut inputs = HashMap::new();
+        for (id, member) in &mut *members {
+            member.ticks = member.ticks.wrapping_add(1);
+            if member.refresh().is_err() {
+                member.pending.clear();
+                continue;
+            }
+            member.collect();
+            let segments = member.take((self.rate / 50) as usize, &mut leases, &mut admissions);
+            inputs.insert(id.clone(), (member.participant.clone(), segments));
+        }
+        for member in members.values_mut() {
+            let mut total = vec![0i32; (self.rate / 50) as usize];
+            let mut provenance = Vec::new();
+            let mut oldest = Instant::now();
+            let target_ticket = member.port.ticket();
+            let mut target_consumer = None;
+            let mut bound = tokio::time::Instant::now() + Duration::from_millis(200);
+            for (participant, segments) in inputs.values() {
+                if participant == &member.participant {
+                    continue;
+                }
+                for segment in segments {
+                    if segment.admitted_at < member.target_started
+                        || tokio::time::Instant::now() >= segment.deadline
+                    {
+                        continue;
+                    }
+                    let Ok((lease, admission, deadline)) = member.controller.admit(
+                        &member.port,
+                        &target_ticket,
+                        true,
+                        Some(&segment.origin.descriptor),
+                        ConsumerCheck::Current,
+                    ) else {
+                        continue;
+                    };
+                    target_consumer = admission.consumer.clone();
+                    bound = bound.min(deadline).min(segment.deadline);
+                    for (index, sample) in segment.samples.iter().enumerate() {
+                        total[segment.offset + index] += i32::from(*sample);
+                    }
+                    oldest = oldest.min(segment.admitted_at);
+                    // All retained source guards stay live through this tick,
+                    // so one current port/scene generation covers its chunks.
+                    if !provenance
+                        .iter()
+                        .any(|old: &Contribution| Arc::ptr_eq(&old.source, &segment.origin.source))
+                    {
+                        provenance.push(segment.origin.clone());
+                    }
+                    leases.push(lease);
+                    admissions.push(admission);
+                }
+            }
+            if provenance.is_empty() {
+                member.previous_sources.clear();
+                continue;
+            }
+            let changed = member.previous_sources.len() != provenance.len()
+                || member.previous_sources.iter().any(|old| {
+                    !old.ticket.is_current()
+                        || old
+                            .consumer
+                            .as_ref()
+                            .is_some_and(|stamp| !stamp.is_current())
+                        || !provenance
+                            .iter()
+                            .any(|new| Arc::ptr_eq(&old.source, &new.source))
+                });
+            if changed {
+                let Some(pt) = member
+                    .port
+                    .state
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .payload_type
+                else {
+                    continue;
+                };
+                let Ok(codecs) = Codecs::new(&member.port.binding.negotiated.format, pt, self.rate)
+                else {
+                    continue;
+                };
+                member.codecs.encoder = codecs.encoder;
+                member.codecs.from_mix = codecs.from_mix;
+            }
+            if tokio::time::Instant::now() >= bound {
+                continue;
+            }
+            let timestamp = (member
+                .ticks
+                .wrapping_mul(u64::from(member.codecs.info.clock_rate_hz / 50)))
+                as u32;
+            let Ok(mut frame) = member.codecs.encode(
+                total
+                    .into_iter()
+                    .map(|sample| sample.clamp(i32::from(i16::MIN), i32::from(i16::MAX)) as i16)
+                    .collect(),
+                timestamp,
+            ) else {
+                continue;
+            };
+            frame.stream_id = member.port.binding.transport_id.clone();
+            if tokio::time::Instant::now() >= bound {
+                continue;
+            }
+            member.previous_sources = provenance.clone();
+            let _ = member.port.egress.try_send(QueuedMedia {
+                frame,
+                sources: provenance,
+                target: member.port.clone(),
+                target_ticket,
+                target_consumer,
+                admitted_at: oldest,
+            });
+        }
+    }
+}
+
+impl StreamController {
+    pub(super) fn validate_audio_consumer_plans(
+        &self,
+        plans: &[NegotiatedStream],
+    ) -> ControlResult<()> {
+        let slot = self
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let Some(consumer) = slot.as_ref() else {
+            return Ok(());
+        };
+        let consumer = consumer.upgrade().ok_or(StreamControlError::NotReady)?;
+        if plans.iter().any(|plan| {
+            plan.requested.medium == Medium::Audio && plan.requested.logical_id != consumer.logical
+        }) {
+            return Err(StreamControlError::Unsupported);
+        }
+        for plan in plans
+            .iter()
+            .filter(|plan| plan.requested.logical_id == consumer.logical)
+        {
+            if plan.requested.medium != Medium::Audio
+                || plan.requested.direction != StreamDirection::Both
+            {
+                return Err(StreamControlError::Unsupported);
+            }
+            Codecs::new(&plan.format, 96, consumer.mix_rate)?;
+        }
+        Ok(())
+    }
+    pub(super) fn validate_audio_consumer_ports(
+        &self,
+        ports: &[PortPreparation],
+    ) -> ControlResult<()> {
+        let slot = self
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let Some(consumer) = slot.as_ref() else {
+            return Ok(());
+        };
+        let consumer = consumer.upgrade().ok_or(StreamControlError::NotReady)?;
+        for selected in ports
+            .iter()
+            .filter(|port| port.port.0.binding.negotiated.requested.logical_id == consumer.logical)
+        {
+            let state = selected
+                .port
+                .0
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            Codecs::new(
+                &selected.port.0.binding.negotiated.format,
+                state.payload_type.ok_or(StreamControlError::NotReady)?,
+                consumer.mix_rate,
+            )?;
+        }
+        Ok(())
+    }
+}
