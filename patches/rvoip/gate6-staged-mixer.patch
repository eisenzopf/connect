+//! Local signed TLS peers plus trusted participant SPI, not public workflow installation.
+use super::*;
+use rvoip_core::orchestrator::participant_control::ParticipantLimits;
+use rvoip_core::participant::ParticipantRole;
+use rvoip_core::participant_transitions::DepartureCause;
+fn named_actor(name: &str) -> AuthenticatedPrincipal {
+    let mut p = principal("old");
+    p.subject = name.into();
+    p
+}
+struct NamedValidator(&'static str);
+#[async_trait]
+impl BearerValidator for NamedValidator {
+    async fn validate(&self, token: &str) -> Result<IdentityAssurance, BearerAuthError> {
+        Ok(self.validate_credential(token).await?.principal.assurance)
+    }
+    async fn validate_credential(&self, token: &str) -> Result<ValidatedBearer, BearerAuthError> {
+        if token != self.0 {
+            return Err(BearerAuthError::Unavailable("fixture credential".into()));
+        }
+        ValidatedBearer::new(
+            named_actor(self.0),
+            Some(format!("fixture-{}", self.0)),
+            Some(std::time::SystemTime::now() - Duration::from_secs(1)),
+        )
+    }
+}
+struct NamedKeys {
+    name: &'static str,
+    base: Keys,
+}
+impl KeyResolver for NamedKeys {
+    fn resolve(&self, _: &str) -> Option<Vec<u8>> {
+        None
+    }
+    fn resolve_for_principal(
+        &self,
+        p: &AuthenticatedPrincipal,
+        k: &str,
+        a: &str,
+        time: chrono::DateTime<Utc>,
+    ) -> Option<ResolvedVerificationKey> {
+        if p.subject != self.name && p.subject != "server" {
+            return None;
+        }
+        let mut bound = p.clone();
+        if p.subject == self.name {
+            bound.subject = "alice".into();
+        }
+        self.base.resolve_for_principal(&bound, k, a, time)
+    }
+}
+struct NamedPolicy {
+    name: &'static str,
+    grants: Arc<RwLock<WireGrants>>,
+}
+#[async_trait]
+impl PeerAuthority for NamedPolicy {
+    fn authority_lifetime(
+        &self,
+        _: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        _: &AuthorityLease,
+    ) -> Result<AuthorityLifetime, DispatchError> {
+        Ok(AuthorityLifetime::new(
+            CancellationToken::new(),
+            RetirementReason::AuthorityRetired,
+        ))
+    }
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        if c.principal.subject != self.name || d.id.as_str() != format!("device_{}", self.name) {
+            return Err(DispatchError::Authority);
+        }
+        Identifier::try_from(format!("id_{}", self.name)).map_err(DispatchError::from)
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if self.identity(c, d).await? != *i || c.principal.is_expired() {
+            return Err(DispatchError::Authority);
+        }
+        let guard = self.grants.clone().read_owned().await;
+        if guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        let connection = if e.kind() == "connection.offer" {
+            if e.scope(Scope::Conversation) != Some("conversation")
+                || e.scope(Scope::Session) != Some("session")
+            {
+                return Err(DispatchError::Authority);
+            }
+            Some(
+                guard
+                    .connections
+                    .get(e.scope(Scope::Connection).ok_or(DispatchError::Authority)?)
+                    .ok_or(DispatchError::Authority)?
+                    .clone(),
+            )
+        } else {
+            None
+        };
+        let authorities = [Transport::Quic, Transport::WebTransport]
+            .into_iter()
+            .map(|kind| {
+                (
+                    kind,
+                    PeerNativeAuthority {
+                        actor: guard.member.clone(),
+                        endpoint: endpoint(self.name, kind),
+                        may_prepare: true,
+                    },
+                )
+            })
+            .collect();
+        Ok(AuthorityLease::holding(WireProof {
+            _base: AuthorityLease::holding(()),
+            _guard: guard,
+            authorities,
+            connection,
+        }))
+    }
+    async fn refresh(
+        &self,
+        _: &ValidatedBearer,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.acquire(c, d, i, e).await
+    }
+}
+fn named_fixture(name: &'static str, member: Membership, id: ConnectionId) -> Fixture {
+    let mut f = Fixture::new();
+    let client_key = Ed25519KeyPair::generate_pkcs8(&ring::rand::SystemRandom::new()).unwrap();
+    let server_key = Ed25519KeyPair::generate_pkcs8(&ring::rand::SystemRandom::new()).unwrap();
+    let keys = Arc::new(NamedKeys {
+        name,
+        base: Keys {
+            client: Ed25519KeyPair::from_pkcs8(client_key.as_ref())
+                .unwrap()
+                .public_key()
+                .as_ref()
+                .to_vec(),
+            server: Ed25519KeyPair::from_pkcs8(server_key.as_ref())
+                .unwrap()
+                .public_key()
+                .as_ref()
+                .to_vec(),
+        },
+    });
+    f.client = Sig9421Signer::ed25519("client", client_key.as_ref()).unwrap();
+    f.server_verify = Sig9421Verifier::new(keys.clone());
+    let config = Arc::get_mut(&mut f.config).unwrap();
+    config.methods = Arc::new(AuthenticationMethods::new(Some(Arc::new(NamedValidator(
+        name,
+    )))));
+    config.verifier = Arc::new(Sig9421Verifier::new(keys));
+    config.signer = Arc::new(Sig9421Signer::ed25519("server", server_key.as_ref()).unwrap());
+    config.authority = Arc::new(NamedPolicy {
+        name,
+        grants: Arc::new(RwLock::new(WireGrants {
+            denied: false,
+            member,
+            connections: HashMap::from([("native_0".into(), id)]),
+        })),
+    });
+    f
+}
+struct Live {
+    wire: Wire,
+    leg: Leg,
+    peer: Arc<PeerAdmission>,
+}
+struct Scene {
+    core: Arc<core_fixture::Fixture>,
+    factory: Arc<Factory>,
+    grants: Arc<MediaGrants>,
+    live: Vec<Live>,
+}
+impl Scene {
+    async fn new(kind_name: &str) -> Self {
+        let grants = Arc::new(MediaGrants(Arc::new(RwLock::new(PolicyState {
+            owners: HashMap::new(),
+            denied: BTreeSet::new(),
+            private: false,
+        }))));
+        let mut core = core_fixture::Fixture::new().await;
+        let session = core
+            .orch
+            .start_session(
+                core.conversation.clone(),
+                rvoip_core::session::SessionMedium::Voice,
+                vec![],
+            )
+            .await
+            .unwrap();
+        core.orch
+            .enable_staged_participant_control(
+                &session,
+                core.policy.clone(),
+                grants.clone(),
+                ParticipantLimits::default(),
+            )
+            .unwrap();
+        core.session = session;
+        let core = Arc::new(core);
+        let kind = if kind_name == "quic" {
+            Transport::Quic
+        } else {
+            Transport::WebTransport
+        };
+        let adapter = CanonicalNativeAdapter::new(kind).unwrap();
+        core.orch.register(adapter.clone()).unwrap();
+        let factory = Arc::new(Factory {
+            core: core.clone(),
+            adapters: HashMap::from([(kind, adapter.clone())]),
+            records: Default::default(),
+        });
+        let mut live = Vec::new();
+        for name in ["alice", "bob", "carol", "dave"] {
+            let member =
+                core.policy.0.read().unwrap().members[&core_fixture::participant(name)].clone();
+            let id = ConnectionId::new();
+            let f = named_fixture(name, member.clone(), id.clone());
+            let profile = CanonicalProfile::new(f.config.clone(), Arc::new(Handler::default()), 8)
+                .unwrap()
+                .with_physical_handlers(factory.clone());
+            let mut wire = wire(kind_name, profile, "/uctp", Some("https://allowed.example"))
+                .await
+                .unwrap();
+            let mut greeting = hello();
+            greeting["payload"]["device"]["id"] = json!(format!("device_{name}"));
+            wire.send(serde_json::to_vec(&greeting).unwrap()).await;
+            let challenge = wire.read().await;
+            assert_eq!(challenge.kind(), "auth.challenge");
+            f.verify_server(&challenge).await;
+            wire.send(f.sign(response(&challenge, name))).await;
+            let auth = wire.read().await;
+            assert_eq!(auth.kind(), "auth.session");
+            f.verify_server(&auth).await;
+            wire.send(f.sign(native_offer(0, kind_name))).await;
+            let ack = wire.read().await;
+            assert_eq!(ack.kind(), "ack");
+            f.verify_server(&ack).await;
+            let record = factory.records.lock().unwrap().last().unwrap().clone();
+            assert_eq!(record.connections.lock().unwrap().as_slice(), &[id.clone()]);
+            let peer = record.peer.lock().unwrap().as_ref().unwrap().clone();
+            assert_eq!(peer.snapshot().connections, 1);
+            let presence = SessionAppearance::admit(&member, core.session.clone(), None).unwrap();
+            let ep = endpoint(name, kind);
+            let mut binding =
+                ConnectionBinding::prepare(&member, &presence, &ep, id.clone()).unwrap();
+            binding.observe_ready(&member, &presence, &ep, 1).unwrap();
+            binding.activate(&member, &presence, &ep).unwrap();
+            core.policy
+                .0
+                .write()
+                .unwrap()
+                .endpoints
+                .insert(id.clone(), ep.clone());
+            grants.0.write().await.owners.insert(
+                id.clone(),
+                MediaOwner {
+                    actor: member.clone(),
+                    member,
+                    presence,
+                    endpoint: ep,
+                    connection: binding,
+                    may_control: true,
+                    send_media: [Medium::Audio, Medium::Video].into_iter().collect(),
+                    receive_media: [Medium::Audio, Medium::Video].into_iter().collect(),
+                    local: capabilities(),
+                    remote: capabilities(),
+                    may_route_source: true,
+                },
+            );
+            let readiness = Readiness::new();
+            let controller = adapter
+                .configure_rtp(
+                    &id,
+                    named_actor(name),
+                    core.conversation.clone(),
+                    StagedRtpScope {
+                        session: core.session.clone(),
+                        connection: id.clone(),
+                        owner: named_actor(name).ownership_key(),
+                        wire_conversation: Some("conversation".into()),
+                        wire_session: "session".into(),
+                        wire_connection: "native_0".into(),
+                    },
+                    grants.clone(),
+                    readiness.clone(),
+                    16,
+                )
+                .unwrap();
+            controller
+                .change(
+                    0,
+                    &[desired(Medium::Audio)],
+                    &BTreeSet::new(),
+                    deadline(),
+                    CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+            let intent = core.intent(
+                &core.session,
+                name,
+                &format!("admit-{name}"),
+                ParticipantChange::Admit {
+                    connection: id.clone(),
+                    role_override: None,
+                },
+            );
+            core.orch
+                .admit_peer_session_connection(
+                    peer.clone(),
+                    &core.session,
+                    named_actor(name),
+                    intent,
+                    deadline(),
+                    CancellationToken::new(),
+                )
+                .await
+                .unwrap();
+            let media = adapter.physical_source(&id).unwrap().media().unwrap();
+            live.push(Live {
+                wire,
+                leg: Leg {
+                    id,
+                    controller,
+                    readiness,
+                    media,
+                },
+                peer,
+            });
+        }
+        assert_eq!(
+            core.orch.participant_capacity(&core.session).unwrap(),
+            (4, 0)
+        );
+        assert_eq!(
+            core.orch
+                .session(&core.session)
+                .unwrap()
+                .read()
+                .unwrap()
+                .connections
+                .len(),
+            4
+        );
+        Self {
+            core,
+            factory,
+            grants,
+            live,
+        }
+    }
+    async fn drain(wire: &Wire) {
+        loop {
+            let bytes = tokio::time::timeout(Duration::from_millis(30), async {
+                if let Some(wt) = &wire.wt {
+                    let _ = wt.read_datagram().await;
+                } else {
+                    let _ = wire.quic.as_ref().unwrap().2.read_datagram().await;
+                }
+            })
+            .await;
+            if bytes.is_err() {
+                break;
+            }
+        }
+    }
+    async fn no_tone(&self, source: usize, target: usize) {
+        Self::drain(&self.live[target].wire).await;
+        let offer = binding(&self.live[source].leg, Medium::Audio);
+        send(&self.live[source].wire, audio(offer.stream_local_id, 0));
+        let wire = &self.live[target].wire;
+        assert!(
+            tokio::time::timeout(Duration::from_millis(100), async {
+                if let Some(wt) = &wire.wt {
+                    wt.read_datagram().await.unwrap()
+                } else {
+                    wire.quic.as_ref().unwrap().2.read_datagram().await.unwrap()
+                }
+            })
+            .await
+            .is_err(),
+            "denied source reached native output"
+        );
+    }
+    async fn tone(&self, source: usize, target: usize) {
+        Self::drain(&self.live[target].wire).await;
+        let offer = binding(&self.live[source].leg, Medium::Audio);
+        send(&self.live[source].wire, audio(offer.stream_local_id, 0));
+        let packet = received(&self.live[target].wire).await;
+        assert_eq!(
+            packet.stream_local_id,
+            binding(&self.live[target].leg, Medium::Audio).stream_local_id
+        );
+        decoded(&packet);
+    }
+    async fn stop(&self) {
+        for live in &self.live {
+            live.wire.server.shutdown().await.unwrap();
+        }
+        self.core.orch.drain_connection_lifecycle_tasks().await;
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_guarded_mixer_admits_four_distinct_people_reoffers_and_preserves_other_audio() {
+    for kind in ["quic", "wt"] {
+        let s = Scene::new(kind).await;
+        s.tone(0, 1).await;
+        let before = binding(&s.live[0].leg, Medium::Audio);
+        let controller = &s.live[0].leg.controller;
+        controller
+            .change(
+                controller.revision(),
+                &[desired(Medium::Audio), desired(Medium::Video)],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(
+            binding(&s.live[0].leg, Medium::Audio).transport_id,
+            before.transport_id
+        );
+        s.tone(0, 2).await;
+        controller
+            .change(
+                controller.revision(),
+                &[desired(Medium::Audio), desired(Medium::Video)],
+                &[desired(Medium::Audio).logical_id].into_iter().collect(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        assert_ne!(
+            binding(&s.live[0].leg, Medium::Audio).transport_id,
+            before.transport_id
+        );
+        tokio::time::sleep(Duration::from_millis(25)).await;
+        s.tone(0, 3).await;
+        assert!(s
+            .live
+            .iter()
+            .all(|live| live.peer.snapshot().connections == 1));
+        let leave = s.core.intent(
+            &s.core.session,
+            "alice",
+            "leave-alice",
+            ParticipantChange::Depart {
+                cause: DepartureCause::Left,
+            },
+        );
+        s.core.apply(&s.core.session, leave).await.unwrap();
+        assert_eq!(
+            s.core.orch.participant_capacity(&s.core.session).unwrap(),
+            (3, 0)
+        );
+        s.tone(1, 2).await;
+        s.stop().await;
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_guarded_mixer_role_permission_revocation_and_eof_preserve_remaining_routes() {
+    for kind in ["quic", "wt"] {
+        let s = Scene::new(kind).await;
+        s.tone(0, 1).await;
+        s.core.policy.0.write().unwrap().send = false;
+        let mute = s.core.intent(
+            &s.core.session,
+            "alice",
+            "mute-alice",
+            ParticipantChange::SetSessionRole {
+                role: ParticipantRole::Supervisor,
+            },
+        );
+        s.core.apply(&s.core.session, mute).await.unwrap();
+        s.no_tone(0, 1).await;
+        // A label does not grant publication; explicit current speaking permission does.
+        assert_eq!(
+            s.core
+                .orch
+                .participant_session_role(&s.core.session, &core_fixture::participant("alice"))
+                .unwrap(),
+            Some(ParticipantRole::Supervisor)
+        );
+        s.core.policy.0.write().unwrap().send = true;
+        let unmute = s.core.intent(
+            &s.core.session,
+            "alice",
+            "unmute-alice",
+            ParticipantChange::SetSessionRole {
+                role: ParticipantRole::Supervisor,
+            },
+        );
+        s.core.apply(&s.core.session, unmute).await.unwrap();
+        tokio::time::sleep(Duration::from_millis(25)).await;
+        s.tone(0, 2).await;
+        s.grants
+            .0
+            .write()
+            .await
+            .denied
+            .insert(s.live[0].leg.id.clone());
+        s.no_tone(0, 1).await;
+        s.tone(1, 3).await;
+        s.live[0].wire.server.shutdown().await.unwrap();
+        core_fixture::until(|| s.core.orch.participant_capacity(&s.core.session).unwrap().0 == 3)
+            .await;
+        s.tone(1, 2).await;
+        s.core
+            .orch
+            .end_session(s.core.session.clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        s.core.orch.drain_connection_lifecycle_tasks().await;
+        assert_eq!(
+            s.core.orch.participant_capacity(&s.core.session).unwrap(),
+            (0, 0)
+        );
+        assert!(s
+            .live
+            .iter()
+            .all(|live| live.peer.snapshot().connections == 0));
+        assert!(s
+            .factory
+            .adapters
+            .values()
+            .all(|adapter| adapter.route_count() == 0));
+        s.no_tone(1, 2).await;
+        for live in &s.live[1..] {
+            live.wire.server.shutdown().await.unwrap();
+        }
+        s.core.orch.drain_connection_lifecycle_tasks().await;
+    }
+}
