+use super::*;
+
+struct ConsumerState {
+    ticket: PeerRouteTicket,
+    epoch: u64,
+    active: bool,
+    speaks: bool,
+    started: Instant,
+}
+/// Additional live scene fence, never a substitute for current MediaPolicy.
+pub(crate) struct AudioConsumer {
+    pub(super) logical: StreamId,
+    pub(super) mix_rate: u32,
+    state: Mutex<ConsumerState>,
+    cancellation: CancellationToken,
+}
+impl Drop for AudioConsumer {
+    fn drop(&mut self) {
+        self.cancellation.cancel();
+        self.state
+            .get_mut()
+            .unwrap_or_else(|p| p.into_inner())
+            .ticket
+            .retire_if_current();
+    }
+}
+#[derive(Clone)]
+pub(super) struct ConsumerStamp {
+    owner: Weak<AudioConsumer>,
+    ticket: PeerRouteTicket,
+    epoch: u64,
+    pub(super) started: Instant,
+    pub(super) cancellation: CancellationToken,
+}
+impl ConsumerStamp {
+    pub(super) fn is_current(&self) -> bool {
+        self.owner.upgrade().is_some_and(|owner| {
+            let state = owner.state.lock().unwrap_or_else(|p| p.into_inner());
+            state.active
+                && state.epoch == self.epoch
+                && self.ticket.is_current()
+                && !self.cancellation.is_cancelled()
+        })
+    }
+}
+pub(super) enum ConsumerCheck<'a> {
+    Current,
+    OrdinaryForward,
+    Retained(Option<&'a ConsumerStamp>),
+}
+pub(super) struct MediaAdmission {
+    pub(super) consumer: Option<ConsumerStamp>,
+    _port: rvoip_core_traits::peer_switch::PeerDeliveryGuard,
+    _consumer: Option<rvoip_core_traits::peer_switch::PeerDeliveryGuard>,
+}
+pub(crate) struct PreparedAudioRole {
+    consumer: Arc<AudioConsumer>,
+    previous: ConsumerStamp,
+    next: PeerRouteTicket,
+    _drained: rvoip_core_traits::peer_switch::PeerQuiescenceGuard,
+}
+impl PreparedAudioRole {
+    pub(crate) fn commit(self, speaks: bool) {
+        let mut state = self
+            .consumer
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        assert_eq!(
+            state.epoch, self.previous.epoch,
+            "private audio role epoch changed outside scene fence"
+        );
+        state.speaks = speaks;
+        assert!(
+            self.next.commit_from(&self.previous.ticket),
+            "private audio role delivery changed outside scene fence"
+        );
+        state.ticket = self.next.clone();
+        state.epoch += 1;
+        state.started = Instant::now();
+    }
+}
+impl AudioConsumer {
+    pub(crate) fn retire(&self) {
+        self.cancellation.cancel();
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.active = false;
+        state.ticket.retire_if_current();
+    }
+    pub(super) fn new(logical: StreamId, mix_rate: u32) -> Arc<Self> {
+        Arc::new(Self {
+            logical,
+            mix_rate,
+            state: Mutex::new(ConsumerState {
+                ticket: PeerRouteTicket::initial(),
+                epoch: 1,
+                active: false,
+                speaks: false,
+                started: Instant::now(),
+            }),
+            cancellation: CancellationToken::new(),
+        })
+    }
+    pub(super) fn activate(&self, speaks: bool) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.speaks = speaks;
+        state.started = Instant::now();
+        state.active = true;
+    }
+    pub(super) fn stamp(self: &Arc<Self>) -> ConsumerStamp {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        ConsumerStamp {
+            owner: Arc::downgrade(self),
+            ticket: state.ticket.clone(),
+            epoch: state.epoch,
+            started: state.started,
+            cancellation: self.cancellation.clone(),
+        }
+    }
+    pub(super) fn begin(
+        self: &Arc<Self>,
+        stamp: &ConsumerStamp,
+        sending: bool,
+    ) -> ControlResult<rvoip_core_traits::peer_switch::PeerDeliveryGuard> {
+        if !Weak::ptr_eq(&Arc::downgrade(self), &stamp.owner) {
+            return Err(StreamControlError::Authority);
+        }
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if !state.active || state.epoch != stamp.epoch || self.cancellation.is_cancelled() {
+            return Err(StreamControlError::NotReady);
+        }
+        if !sending && !state.speaks {
+            return Err(StreamControlError::Authority);
+        }
+        stamp
+            .ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)
+    }
+    pub(crate) async fn prepare_role(
+        self: &Arc<Self>,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+    ) -> ControlResult<PreparedAudioRole> {
+        let previous = self.stamp();
+        let next = previous
+            .ticket
+            .stage()
+            .ok_or(MediaTransitionError::Capacity)?;
+        let drained = tokio::select! {
+            biased;
+            _=cancellation.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=self.cancellation.cancelled()=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,previous.ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        };
+        Ok(PreparedAudioRole {
+            consumer: self.clone(),
+            previous,
+            next,
+            _drained: drained,
+        })
+    }
+}
+impl StreamController {
+    pub(super) fn consumer_admission(
+        &self,
+        port: &Port,
+        sending: bool,
+        expected: ConsumerCheck<'_>,
+        port_guard: rvoip_core_traits::peer_switch::PeerDeliveryGuard,
+    ) -> ControlResult<MediaAdmission> {
+        let slot = self
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let consumer = match slot.as_ref() {
+            None => None,
+            Some(owner) => Some(owner.upgrade().ok_or(StreamControlError::NotReady)?),
+        };
+        let consumer =
+            consumer.filter(|owner| owner.logical == port.binding.negotiated.requested.logical_id);
+        let Some(consumer) = consumer else {
+            if matches!(expected, ConsumerCheck::Retained(Some(_))) {
+                return Err(StreamControlError::NotReady);
+            }
+            return Ok(MediaAdmission {
+                consumer: None,
+                _port: port_guard,
+                _consumer: None,
+            });
+        };
+        let stamp = match expected {
+            ConsumerCheck::Current | ConsumerCheck::OrdinaryForward => consumer.stamp(),
+            ConsumerCheck::Retained(Some(stamp)) => stamp.clone(),
+            ConsumerCheck::Retained(None) => return Err(StreamControlError::NotReady),
+        };
+        let guard = consumer.begin(&stamp, sending)?;
+        Ok(MediaAdmission {
+            consumer: Some(stamp),
+            _port: port_guard,
+            _consumer: Some(guard),
+        })
+    }
+}
+
+pub(super) async fn any_cancelled(tokens: Vec<CancellationToken>) {
+    let mut futures = tokens
+        .into_iter()
+        .map(|token| Box::pin(token.cancelled_owned()))
+        .collect::<Vec<_>>();
+    std::future::poll_fn(move |context| {
+        for future in &mut futures {
+            if future.as_mut().poll(context).is_ready() {
+                return std::task::Poll::Ready(());
+            }
+        }
+        std::task::Poll::Pending
+    })
+    .await
+}
