+use super::*;
+use crate::ids::TenantId;
+use crate::participant_transitions::{
+    EndpointConfirmationPolicy, ParticipantChange, ParticipantMutation,
+    ParticipantReplacementMutation, ParticipantSession, PreparedParticipantReplacement,
+};
+struct ReplacementPolicy {
+    base: Arc<Policy>,
+    pending: PreparedParticipantReplacement,
+    proof: Arc<Mutex<Option<Arc<PreparedMediaObservation>>>>,
+    approved: bool,
+    cancel_after: bool,
+}
+struct ReplacementLease {
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    owner: MediaOwner,
+    source: MediaOwner,
+    pending: PreparedParticipantReplacement,
+    proof: Arc<Mutex<Option<Arc<PreparedMediaObservation>>>>,
+    approved: bool,
+    cancel_after: bool,
+    cancellation: CancellationToken,
+}
+impl MediaAuthorityLease for ReplacementLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        let _held = &self.guard;
+        let owner = match self
+            .proof
+            .lock()
+            .unwrap()
+            .as_ref()
+            .filter(|p| p.is_committed())
+        {
+            Some(p) => {
+                p.current_replacement_resources(self.owner.clone(), &self.source, &self.pending)?
+            }
+            None => self.owner.clone(),
+        };
+        Ok(Box::new(owner))
+    }
+    fn control_prepared(
+        &self,
+        p: &Arc<PreparedMediaObservation>,
+    ) -> ControlResult<Box<MediaOwner>> {
+        if !self.approved {
+            return Err(StreamControlError::Unsupported);
+        }
+        assert!(!p.is_committed());
+        assert!(
+            p.activate_for_commit(self.owner.clone()).is_err(),
+            "ordinary activation cannot discard replacement lineage"
+        );
+        assert!(p
+            .current_replacement_resources(self.owner.clone(), &self.source, &self.pending)
+            .is_err());
+        let owner =
+            p.activate_replacement_resources(self.owner.clone(), &self.source, &self.pending)?;
+        *self.proof.lock().unwrap() = Some(p.clone());
+        if self.cancel_after {
+            self.cancellation.cancel();
+        }
+        Ok(Box::new(owner))
+    }
+}
+impl ReplacementPolicy {
+    fn lease(
+        &self,
+        guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+        scope: &MediaScope<'_>,
+        cancellation: CancellationToken,
+    ) -> ControlResult<ReplacementLease> {
+        if guard.revoked.contains(&scope.principal.subject) {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        let source = guard
+            .owners
+            .get(self.pending.intent().source.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        Ok(ReplacementLease {
+            guard,
+            owner,
+            source,
+            pending: self.pending.clone(),
+            proof: self.proof.clone(),
+            approved: self.approved,
+            cancel_after: self.cancel_after,
+            cancellation,
+        })
+    }
+}
+impl MediaPolicy for ReplacementPolicy {
+    fn current(&self, s: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let guard = Arc::new(
+            self.base
+                .0
+                .clone()
+                .try_read_owned()
+                .map_err(|_| StreamControlError::Authority)?,
+        );
+        let lease = self.lease(guard, s, CancellationToken::new())?;
+        let owner = *lease.control_owner()?;
+        Ok(Box::new(PhaseCurrentLease {
+            owner,
+            _guard: Box::new(lease),
+        }))
+    }
+    fn current_control(
+        &self,
+        s: &MediaScope<'_>,
+        _: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<HeldControlContext>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&held.domain, &self.base)
+            || held.connection != *s.connection
+            || !held.principal.has_same_owner(s.principal)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        MediaControl::new(
+            Box::new(self.lease(held.guard.clone(), s, held.cancellation.clone())?),
+            held.cancellation.clone(),
+            held.deadline,
+        )
+    }
+}
+fn join_model(s: &mut ParticipantSession, o: &MediaOwner) {
+    let mut ticket = s
+        .prepare_admission(
+            &o.member,
+            &o.endpoint,
+            o.connection.connection().clone(),
+            None,
+        )
+        .unwrap();
+    ticket
+        .observe_ready(&o.member, &o.endpoint, ticket.generation())
+        .unwrap();
+    s.apply(
+        &o.member,
+        &o.member,
+        ParticipantMutation {
+            operation_id: format!("join_{}", o.connection.connection()),
+            correlation_id: "corr_join".into(),
+            expected_revision: s.revision(),
+            participant: o.member.participant().clone(),
+            change: ParticipantChange::Admit {
+                connection: o.connection.connection().clone(),
+                role_override: None,
+            },
+        },
+        Some(ticket),
+        Some(&o.endpoint),
+    )
+    .unwrap();
+}
+async fn setup(
+    approved: bool,
+    cancel_after: bool,
+) -> (
+    ParticipantSession,
+    Arc<ReplacementPolicy>,
+    Arc<HeldControlContext>,
+    Arc<StreamController>,
+    Arc<Adapter>,
+) {
+    let mut source = owner("alice");
+    let remote = owner("bob");
+    let mut model = ParticipantSession::new(
+        TenantId::from_string("tenant"),
+        source.member.conversation().clone(),
+        source.presence.session().clone(),
+        4,
+        6,
+        64,
+    )
+    .unwrap();
+    join_model(&mut model, &source);
+    join_model(&mut model, &remote);
+    let credential = principal("alice");
+    let identity = IdentityBinding::from_authenticated(
+        &credential,
+        source.member.identity().clone(),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let mut endpoint = EndpointBinding::provision(
+        identity.clone(),
+        EndpointId::from_string("replacement_endpoint"),
+        DeviceId::from_string("replacement_device"),
+        Transport::Quic,
+        "replacement-private-address".into(),
+    )
+    .unwrap();
+    endpoint
+        .verify(&identity, "replacement-proof".into(), chrono::Utc::now())
+        .unwrap();
+    let intent = ParticipantReplacementMutation {
+        operation_id: "replacement_resource".into(),
+        correlation_id: "corr_resource".into(),
+        expected_revision: model.revision(),
+        participant: source.member.participant().clone(),
+        source: source.connection.connection().clone(),
+        replacement: ConnectionId::from_string("candidate"),
+        retained: remote.connection.connection().clone(),
+        endpoint: endpoint.endpoint().clone(),
+        device: endpoint.device().clone(),
+        confirmation: EndpointConfirmationPolicy::AnsweredDtmf { digits: "1".into() },
+    };
+    let pending = model
+        .prepare_replacement(&source.member, &endpoint, intent)
+        .unwrap();
+    source.connection = pending.source_binding().clone();
+    source.presence = pending.appearance().clone();
+    let mut candidate = source.clone();
+    candidate.connection = pending.binding().clone();
+    candidate.endpoint = endpoint;
+    let base = Arc::new(Policy(Arc::new(RwLock::new(PolicyState {
+        owners: [("alice".into(), source), ("candidate".into(), candidate)]
+            .into_iter()
+            .collect(),
+        revoked: HashSet::new(),
+        private: true,
+    }))));
+    let policy = Arc::new(ReplacementPolicy {
+        base: base.clone(),
+        pending,
+        proof: Arc::new(Mutex::new(None)),
+        approved,
+        cancel_after,
+    });
+    let held = Arc::new(HeldControlContext {
+        domain: base.clone(),
+        guard: Arc::new(base.0.clone().read_owned().await),
+        principal: credential,
+        connection: ConnectionId::from_string("candidate"),
+        cancellation: CancellationToken::new(),
+        deadline: deadline(),
+    });
+    let adapter = Adapter::new();
+    let controller = StreamController::with_held_control(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        held.connection.clone(),
+        held.principal.clone(),
+        policy.clone(),
+        adapter.clone(),
+        Arc::new(StreamHandleAllocator::default()),
+        8,
+        16,
+        CancellationToken::new(),
+        held.as_ref(),
+    )
+    .unwrap();
+    (model, policy, held, controller, adapter)
+}
+#[tokio::test]
+async fn replacement_resource_observation_prepares_same_participant_io_without_model_route_or_endpoint_confirmation(
+) {
+    let (model, policy, held, controller, adapter) = setup(true, false).await;
+    let revision = model.revision();
+    let store = policy.base.0.clone();
+    let writer = tokio::spawn(async move { store.write_owned().await });
+    tokio::task::yield_now().await;
+    assert!(policy.base.0.clone().try_read_owned().is_err());
+    controller
+        .change_with_held(
+            0,
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+            held.clone(),
+        )
+        .await
+        .unwrap();
+    let proof = policy.proof.lock().unwrap().clone().unwrap();
+    assert!(proof.is_committed());
+    assert_eq!(proof.committed_generation(), Some(2));
+    assert_eq!(model.revision(), revision);
+    let source = &held.guard.owners["alice"];
+    let candidate = &held.guard.owners["candidate"];
+    assert!(model
+        .connections(source.member.participant())
+        .contains(source.connection.connection()));
+    assert!(!model
+        .connections(source.member.participant())
+        .contains(candidate.connection.connection()));
+    assert!(
+        model
+            .stage_replacement(
+                &source.member,
+                &source.member,
+                policy.pending.intent().clone(),
+                &policy.pending,
+                &candidate.endpoint
+            )
+            .is_err(),
+        "resource confirmation is not actual duplex IO or endpoint confirmation"
+    );
+    assert!(!writer.is_finished());
+    drop(held);
+    drop(writer.await.unwrap());
+    let port = adapter.port(Medium::Audio);
+    port.try_publish(&frame(&port, 160)).unwrap();
+    assert_eq!(controller.shutdown(deadline()).await, 0);
+    assert!(!proof.is_committed());
+}
+#[tokio::test]
+async fn replacement_resource_observation_refuses_missing_policy_or_cancelled_generation_and_foreign_source(
+) {
+    for (approved, cancel_after) in [(false, false), (true, true)] {
+        let (_model, policy, held, controller, adapter) = setup(approved, cancel_after).await;
+        assert!(controller
+            .change_with_held(
+                0,
+                &[desired(Medium::Audio)],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+                held.clone()
+            )
+            .await
+            .is_err());
+        assert_eq!(controller.revision(), 0);
+        let port = adapter.port(Medium::Audio);
+        assert!(port.try_publish(&frame(&port, 160)).is_err());
+        if let Some(p) = policy.proof.lock().unwrap().clone() {
+            assert!(!p.is_committed());
+            assert!(p
+                .current_replacement_resources(
+                    held.guard.owners["candidate"].clone(),
+                    &held.guard.owners["alice"],
+                    &policy.pending
+                )
+                .is_err());
+        }
+        drop(held);
+        assert_eq!(controller.shutdown(deadline()).await, 0);
+    }
+    let (_model, policy, held, controller, _) = setup(true, false).await;
+    controller
+        .change_with_held(
+            0,
+            &[desired(Medium::Audio)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+            held.clone(),
+        )
+        .await
+        .unwrap();
+    let proof = policy.proof.lock().unwrap().clone().unwrap();
+    let candidate = held.guard.owners["candidate"].clone();
+    let source = held.guard.owners["alice"].clone();
+    assert!(proof
+        .current_replacement_resources(candidate.clone(), &owner("bob"), &policy.pending)
+        .is_err());
+    let mut retired = source.clone();
+    retired.connection.retire();
+    assert!(proof
+        .current_replacement_resources(candidate.clone(), &retired, &policy.pending)
+        .is_err());
+    let mut revoked = source.clone();
+    revoked.endpoint.revoke();
+    assert!(proof
+        .current_replacement_resources(candidate.clone(), &revoked, &policy.pending)
+        .is_err());
+    let mut recreated = source.clone();
+    recreated.connection = ConnectionBinding::prepare(
+        &source.member,
+        &source.presence,
+        &source.endpoint,
+        source.connection.connection().clone(),
+    )
+    .unwrap();
+    assert!(proof
+        .current_replacement_resources(candidate, &recreated, &policy.pending)
+        .is_err());
+    drop(held);
+    assert_eq!(controller.shutdown(deadline()).await, 0);
+}
