+async fn controlled_telephone_deadline_and_remote_loss_release_preparation_without_a_second_origination(
+) {
+    for mode in ["deadline", "remote-end"] {
+        let s = Scene::new_replacement("quic").await;
+        let c = Candidate::new(&s, Transport::Sip).await;
