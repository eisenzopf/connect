+++ b/crates/foundation/rvoip-core/src/participant_transitions/replacement.rs
@@ -0,0 +1,425 @@
+//! Same-participant binding replacement staged for the owner's media commit.
+//! Adapter observations carry no permission and never publish or retire a route.
+use super::*;
+use crate::ids::{DeviceId, EndpointId};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum EndpointConfirmationPolicy {
+    MediaOnly,
+    AnsweredDtmf { digits: String },
+}
+impl EndpointConfirmationPolicy {
+    fn validate(&self) -> Result<()> {
+        if let Self::AnsweredDtmf { digits } = self {
+            if digits.is_empty()
+                || digits.len() > 16
+                || !digits
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || b"*#ABCD".contains(&b))
+            {
+                return Err(ParticipantTransitionError::Invalid);
+            }
+        }
+        Ok(())
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EndpointConfirmationObservation {
+    Answered,
+    MediaReady,
+    NotRequired,
+    BeforeAnswerOrMedia,
+    IncorrectDigits,
+    Confirmed,
+    AlreadyConfirmed,
+}
+#[derive(Clone, PartialEq, Eq)]
+pub struct ParticipantReplacementMutation {
+    pub operation_id: String,
+    pub correlation_id: String,
+    pub expected_revision: u64,
+    pub participant: ParticipantId,
+    pub source: ConnectionId,
+    pub replacement: ConnectionId,
+    pub retained: ConnectionId,
+    pub endpoint: EndpointId,
+    pub device: DeviceId,
+    pub confirmation: EndpointConfirmationPolicy,
+}
+#[derive(Clone, PartialEq, Eq)]
+pub struct ParticipantReplacementObservation {
+    pub session: SessionId,
+    pub participant: ParticipantId,
+    pub membership_epoch: u64,
+    pub operation_id: String,
+    pub correlation_id: String,
+    pub revision: u64,
+    pub replaced: ConnectionId,
+    pub admitted: ConnectionId,
+    pub retained: ConnectionId,
+    pub endpoint: EndpointId,
+    pub device: DeviceId,
+    pub generation: u64,
+    pub role: ParticipantRole,
+    pub confirmation: EndpointConfirmationPolicy,
+}
+#[derive(Clone)]
+pub(super) struct ReplacementReceipt {
+    actor_identity: IdentityId,
+    actor_participant: ParticipantId,
+    actor_epoch: u64,
+    target_identity: IdentityId,
+    intent: ParticipantReplacementMutation,
+    observation: ParticipantReplacementObservation,
+}
+/// Only the trusted adapter/coordinator may record observations, after matching
+/// its actual callback/IO to this ticket's exact connection and generation.
+/// A wire body must never be mapped directly to these methods. The owner must
+/// additionally validate actual media IO generations at the atomic graph fence.
+#[derive(Clone)]
+pub struct PreparedParticipantReplacement {
+    intent: ParticipantReplacementMutation,
+    membership_revision: u64,
+    appearance: SessionAppearance,
+    source: ConnectionBinding,
+    candidate: ConnectionBinding,
+    answered: bool,
+    confirmed: bool,
+}
+impl PreparedParticipantReplacement {
+    pub fn generation(&self) -> u64 {
+        self.candidate.generation()
+    }
+    pub fn binding(&self) -> &ConnectionBinding {
+        &self.candidate
+    }
+    pub(crate) fn source_binding(&self) -> &ConnectionBinding {
+        &self.source
+    }
+    pub fn appearance(&self) -> &SessionAppearance {
+        &self.appearance
+    }
+    fn check_callback(&self, connection: &ConnectionId, generation: u64) -> Result<()> {
+        if connection != self.candidate.connection() || generation != self.candidate.generation() {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        Ok(())
+    }
+    pub fn observe_answer(
+        &mut self,
+        connection: &ConnectionId,
+        generation: u64,
+    ) -> Result<EndpointConfirmationObservation> {
+        self.check_callback(connection, generation)?;
+        self.answered = true;
+        Ok(EndpointConfirmationObservation::Answered)
+    }
+    pub fn observe_media_ready(
+        &mut self,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        generation: u64,
+    ) -> Result<()> {
+        self.candidate
+            .observe_ready(member, &self.appearance, endpoint, generation)?;
+        Ok(())
+    }
+    pub fn observe_dtmf(
+        &mut self,
+        connection: &ConnectionId,
+        generation: u64,
+        digits: &str,
+    ) -> Result<EndpointConfirmationObservation> {
+        self.check_callback(connection, generation)?;
+        let EndpointConfirmationPolicy::AnsweredDtmf { digits: expected } =
+            &self.intent.confirmation
+        else {
+            return Ok(EndpointConfirmationObservation::NotRequired);
+        };
+        if self.confirmed {
+            return Ok(EndpointConfirmationObservation::AlreadyConfirmed);
+        }
+        if !self.answered || self.candidate.state() != crate::relationships::BindingState::Ready {
+            return Ok(EndpointConfirmationObservation::BeforeAnswerOrMedia);
+        }
+        if digits != expected {
+            return Ok(EndpointConfirmationObservation::IncorrectDigits);
+        }
+        self.confirmed = true;
+        Ok(EndpointConfirmationObservation::Confirmed)
+    }
+    pub fn intent(&self) -> &ParticipantReplacementMutation {
+        &self.intent
+    }
+    /// A physical resource view only, under the host's explicit provisional IO
+    /// policy. The model ticket remains pending and its old route stays active.
+    pub(crate) fn activate_prepared_binding(
+        &self,
+        member: &Membership,
+        presence: &SessionAppearance,
+        endpoint: &EndpointBinding,
+        source: &ConnectionBinding,
+        current: &mut ConnectionBinding,
+    ) -> Result<()> {
+        if member.revision() != self.membership_revision
+            || !source.same_incarnation(&self.source)
+            || !current.same_incarnation(&self.candidate)
+            || source.state() != crate::relationships::BindingState::Active
+            || source.generation() != self.source.generation()
+            || current.generation() != self.candidate.generation()
+            || current.replaces() != Some(source.connection())
+        {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        source.require_current(member, presence)?;
+        current.require_current(member, presence)?;
+        endpoint.usable_by(member)?;
+        if current.state() != crate::relationships::BindingState::Active {
+            current.observe_ready(member, presence, endpoint, current.generation())?;
+            let mut old = source.clone();
+            old.commit_replacement(current, member, presence, endpoint)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn confirmation_ready(&self) -> bool {
+        self.candidate.state() == crate::relationships::BindingState::Ready
+            && (self.intent.confirmation == EndpointConfirmationPolicy::MediaOnly
+                || (self.answered && self.confirmed))
+    }
+}
+pub(crate) struct PreparedParticipantReplacementCommit {
+    expected: u64,
+    next: ParticipantSession,
+    observation: ParticipantReplacementObservation,
+}
+impl ParticipantSession {
+    pub fn prepare_replacement(
+        &self,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        intent: ParticipantReplacementMutation,
+    ) -> Result<PreparedParticipantReplacement> {
+        self.check_member(member, true)?;
+        identifier(&intent.operation_id)?;
+        identifier(&intent.correlation_id)?;
+        intent.confirmation.validate()?;
+        if self.ended {
+            return Err(ParticipantTransitionError::Ended);
+        }
+        if self.revision != intent.expected_revision || self.revision >= MAX_REVISION {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if member.participant() != &intent.participant
+            || endpoint.endpoint() != &intent.endpoint
+            || endpoint.device() != &intent.device
+        {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        if self.used_connections.contains(&intent.replacement)
+            || intent.source == intent.replacement
+            || intent.source == intent.retained
+            || intent.replacement == intent.retained
+        {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if self.used_connections.len() >= self.max_operations {
+            return Err(ParticipantTransitionError::Capacity);
+        }
+        let presence = self
+            .participants
+            .get(member.participant())
+            .ok_or(ParticipantTransitionError::Inactive)?;
+        self.check_presence(member, presence)?;
+        let source = presence
+            .connections
+            .get(&intent.source)
+            .ok_or(ParticipantTransitionError::NotReady)?;
+        // A path change/reconnect on the same provisioned endpoint is not a
+        // device replacement. It uses that Connection's own media lifecycle.
+        if source.endpoint() == endpoint.endpoint() {
+            return Err(ParticipantTransitionError::Invalid);
+        }
+        if !self.participants.iter().any(|(id, p)| {
+            id != member.participant() && p.connections.contains_key(&intent.retained)
+        }) {
+            return Err(ParticipantTransitionError::NotReady);
+        }
+        let candidate = source.replacement(
+            member,
+            &presence.appearance,
+            endpoint,
+            intent.replacement.clone(),
+        )?;
+        Ok(PreparedParticipantReplacement {
+            intent,
+            membership_revision: member.revision(),
+            appearance: presence.appearance.clone(),
+            source: source.clone(),
+            candidate,
+            answered: false,
+            confirmed: false,
+        })
+    }
+    pub fn replay_replacement(
+        &self,
+        actor: &Membership,
+        target: &Membership,
+        intent: &ParticipantReplacementMutation,
+    ) -> Result<Option<ParticipantReplacementObservation>> {
+        identifier(&intent.operation_id)?;
+        identifier(&intent.correlation_id)?;
+        self.check_member(actor, true)?;
+        self.check_member(target, false)?;
+        if target.participant() != &intent.participant {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        let key = (actor.participant().clone(), intent.operation_id.clone());
+        if self.receipts.contains_key(&key) || self.handoffs.contains_key(&key) {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        let Some(old) = self.replacements.get(&key) else {
+            return Ok(None);
+        };
+        if old.actor_identity != *actor.identity()
+            || old.actor_participant != *actor.participant()
+            || old.actor_epoch != actor.epoch()
+            || old.target_identity != *target.identity()
+            || old.observation.membership_epoch != target.epoch()
+        {
+            return Err(ParticipantTransitionError::OwnerMismatch);
+        }
+        let mut actual = intent.clone();
+        actual.correlation_id = old.intent.correlation_id.clone();
+        if actual != old.intent {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        Ok(Some(old.observation.clone()))
+    }
+    pub(crate) fn stage_replacement(
+        &self,
+        actor: &Membership,
+        target: &Membership,
+        intent: ParticipantReplacementMutation,
+        prepared: &PreparedParticipantReplacement,
+        endpoint: &EndpointBinding,
+    ) -> Result<PreparedParticipantReplacementCommit> {
+        if self.replay_replacement(actor, target, &intent)?.is_some() {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        self.check_member(target, true)?;
+        if self.ended {
+            return Err(ParticipantTransitionError::Ended);
+        }
+        if self.revision != intent.expected_revision
+            || self.revision >= MAX_REVISION
+            || prepared.intent != intent
+            || prepared.membership_revision != target.revision()
+        {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        if self.receipts.len() + self.handoffs.len() + self.replacements.len()
+            >= self.max_operations
+            || self.used_connections.len() >= self.max_operations
+        {
+            return Err(ParticipantTransitionError::Capacity);
+        }
+        if self.used_connections.contains(&intent.replacement) {
+            return Err(ParticipantTransitionError::Conflict);
+        }
+        let current = self
+            .participants
+            .get(target.participant())
+            .ok_or(ParticipantTransitionError::Inactive)?;
+        self.check_presence(target, current)?;
+        current.appearance.require_current(target)?;
+        let original = current
+            .connections
+            .get(&intent.source)
+            .ok_or(ParticipantTransitionError::NotReady)?;
+        if !original.same_incarnation(&prepared.source)
+            || original.generation() != prepared.source.generation()
+            || original.state() != crate::relationships::BindingState::Active
+            || !prepared.confirmation_ready()
+        {
+            return Err(ParticipantTransitionError::NotReady);
+        }
+        if !self.participants.iter().any(|(id, p)| {
+            id != target.participant() && p.connections.contains_key(&intent.retained)
+        }) {
+            return Err(ParticipantTransitionError::NotReady);
+        }
+        let mut source = original.clone();
+        let mut candidate = prepared.candidate.clone();
+        source.commit_replacement(&mut candidate, target, &current.appearance, endpoint)?;
+        let observation = ParticipantReplacementObservation {
+            session: self.session.clone(),
+            participant: target.participant().clone(),
+            membership_epoch: target.epoch(),
+            operation_id: intent.operation_id.clone(),
+            correlation_id: intent.correlation_id.clone(),
+            revision: self.revision + 1,
+            replaced: intent.source.clone(),
+            admitted: intent.replacement.clone(),
+            retained: intent.retained.clone(),
+            endpoint: candidate.endpoint().clone(),
+            device: candidate.device().clone(),
+            generation: candidate.generation(),
+            role: current.appearance.role().clone(),
+            confirmation: intent.confirmation.clone(),
+        };
+        let mut participants = self.participants.clone();
+        let presence = participants
+            .get_mut(target.participant())
+            .expect("validated target");
+        presence.connections.remove(&intent.source);
+        presence
+            .connections
+            .insert(intent.replacement.clone(), candidate);
+        let mut used_connections = self.used_connections.clone();
+        used_connections.insert(intent.replacement.clone());
+        let mut replacements = self.replacements.clone();
+        replacements.insert(
+            (actor.participant().clone(), intent.operation_id.clone()),
+            ReplacementReceipt {
+                actor_identity: actor.identity().clone(),
+                actor_participant: actor.participant().clone(),
+                actor_epoch: actor.epoch(),
+                target_identity: target.identity().clone(),
+                intent,
+                observation: observation.clone(),
+            },
+        );
+        Ok(PreparedParticipantReplacementCommit {
+            expected: self.revision,
+            observation,
+            next: ParticipantSession {
+                tenant: self.tenant.clone(),
+                conversation: self.conversation.clone(),
+                session: self.session.clone(),
+                revision: self.revision + 1,
+                ended: false,
+                max_participants: self.max_participants,
+                max_connections: self.max_connections,
+                max_operations: self.max_operations,
+                participants,
+                used_connections,
+                receipts: self.receipts.clone(),
+                handoffs: self.handoffs.clone(),
+                replacements,
+            },
+        })
+    }
+    /// Infallible only while the owner retains the exact Session publication
+    /// fence used to stage this candidate and its actual media graph candidate.
+    pub(crate) fn commit_replacement(
+        &mut self,
+        candidate: PreparedParticipantReplacementCommit,
+    ) -> ParticipantReplacementObservation {
+        assert_eq!(
+            self.revision, candidate.expected,
+            "replacement owner must retain publication fence"
+        );
+        *self = candidate.next;
+        candidate.observation
+    }
+}
