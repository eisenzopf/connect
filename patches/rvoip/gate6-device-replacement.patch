+impl SavedAudioProgram {
+    /// Retarget only this exact admitted source. Participant intent, unrelated
+    /// selections and exclusions remain intact; physical IDs are never reused.
+    pub(super) fn replacing_connection(
+        &self,
+        old: &Arc<StreamController>,
+        new: &Arc<StreamController>,
+        old_logical: &StreamId,
+        new_logical: &StreamId,
+    ) -> ControlResult<Self> {
+        if old.origin_member.participant() != new.origin_member.participant()
+            || old.origin_member.identity() != new.origin_member.identity()
+            || old.origin_member.epoch() != new.origin_member.epoch()
+            || old.origin_member.tenant() != new.origin_member.tenant()
+            || !old
+                .credential_snapshot()
+                .principal
+                .has_same_owner(&new.credential_snapshot().principal)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let mut program = self.0.clone();
+        for selection in &mut program.selections {
+            let replace = match &selection.request {
+                AudioSubscription::Connection(id) => id == &old.connection,
+                AudioSubscription::Stream(key) => {
+                    key.connection == old.connection && &key.logical == old_logical
+                }
+                AudioSubscription::Participant(_) => false,
+            };
+            if replace {
+                if !selection.owner_matches(old)
+                    || !selection
+                        .publisher
+                        .upgrade()
+                        .is_some_and(|p| Arc::ptr_eq(&p, old))
+                {
+                    return Err(MediaTransitionError::Conflict.into());
+                }
+                selection.request = match &selection.request {
+                    AudioSubscription::Stream(_) => AudioSubscription::Stream(MediaStreamRef {
+                        connection: new.connection.clone(),
+                        logical: new_logical.clone(),
+                    }),
+                    _ => AudioSubscription::Connection(new.connection.clone()),
+                };
+                selection.publisher = Arc::downgrade(new);
+                selection.origin = new.origin_member.clone();
+                selection.owner = new.credential_snapshot().principal;
+            }
+        }
+        if program.excluded.contains(&MediaStreamRef {
+            connection: old.connection.clone(),
+            logical: old_logical.clone(),
+        }) {
+            program.excluded.insert(MediaStreamRef {
+                connection: new.connection.clone(),
+                logical: new_logical.clone(),
+            });
+        }
+        if program.excluded.len() > 4096 {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+        Ok(Self(program))
+    }
