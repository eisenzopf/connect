+#[test]
+fn replacement_model_staged_admission_preserves_actual_media_incarnation_and_refuses_lineage_as_ordinary_admission(
+) {
+    let (a, b) = member("tenant_test", "alice");
+    let ep = endpoint(&b, "browser");
+    let mut s = session("sess_actual");
+    let mut ticket = s
+        .prepare_admission(&a, &ep, ConnectionId::from_string("actual"), None)
+        .unwrap();
+    let invented = ticket.connection.clone();
+    let mut actual = ConnectionBinding::prepare(
+        &a,
+        &ticket.appearance,
+        &ep,
+        ConnectionId::from_string("actual"),
+    )
+    .unwrap();
+    actual
+        .observe_ready(&a, &ticket.appearance, &ep, 1)
+        .unwrap();
+    actual.activate(&a, &ticket.appearance, &ep).unwrap();
+    assert!(!actual.same_incarnation(&invented));
+    ticket.adopt_confirmed_binding(&a, &ep, &actual).unwrap();
+    ticket.observe_ready(&a, &ep, 1).unwrap();
+    let intent = mutation(
+        &s,
+        &a,
+        "join_actual",
+        ParticipantChange::Admit {
+            connection: actual.connection().clone(),
+            role_override: None,
+        },
+    );
+    s.apply(&a, &a, intent, Some(ticket), Some(&ep)).unwrap();
+    let (remote, rb) = member("tenant_test", "bob");
+    join(&mut s, &remote, &endpoint(&rb, "remote"), "remote");
+    let new_ep = endpoint(&b, "next_device");
+    let intent = ParticipantReplacementMutation {
+        operation_id: "move_actual".into(),
+        correlation_id: "corr_move".into(),
+        expected_revision: s.revision(),
+        participant: a.participant().clone(),
+        source: actual.connection().clone(),
+        replacement: ConnectionId::from_string("next"),
+        retained: ConnectionId::from_string("remote"),
+        endpoint: new_ep.endpoint().clone(),
+        device: new_ep.device().clone(),
+        confirmation: EndpointConfirmationPolicy::MediaOnly,
+    };
+    let pending = s.prepare_replacement(&a, &new_ep, intent).unwrap();
+    assert!(pending.source_binding().same_incarnation(&actual));
+    let mut ordinary = s
+        .prepare_admission(&a, &new_ep, ConnectionId::from_string("next"), None)
+        .unwrap();
+    assert!(
+        ordinary
+            .adopt_confirmed_binding(&a, &new_ep, pending.binding())
+            .is_err(),
+        "a pending replacement cannot become an ordinary extra admitted Connection"
+    );
+    assert_eq!(s.connection_count(), 2);
+    assert!(s.connections(a.participant()).contains(actual.connection()));
+}
