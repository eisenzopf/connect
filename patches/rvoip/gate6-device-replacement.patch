+++ b/crates/foundation/rvoip-core/src/participant_transitions/tests/replacement.rs
@@ -0,0 +1,330 @@
+use super::*;
+fn setup(
+    policy: EndpointConfirmationPolicy,
+) -> (
+    ParticipantSession,
+    Membership,
+    EndpointBinding,
+    ParticipantReplacementMutation,
+) {
+    let mut s = session("sess_replace");
+    let (a, b) = member("tenant_test", "alice");
+    let old = endpoint(&b, "browser");
+    join(&mut s, &a, &old, "conn_old");
+    join(&mut s, &a, &endpoint(&b, "other_device"), "conn_other");
+    let (remote, rb) = member("tenant_test", "bob");
+    join(&mut s, &remote, &endpoint(&rb, "remote"), "conn_remote");
+    let new = endpoint(&b, "phone");
+    let intent = ParticipantReplacementMutation {
+        operation_id: "replace_1".into(),
+        correlation_id: "corr_original".into(),
+        expected_revision: s.revision(),
+        participant: a.participant().clone(),
+        source: ConnectionId::from_string("conn_old"),
+        replacement: ConnectionId::from_string("conn_new"),
+        retained: ConnectionId::from_string("conn_remote"),
+        endpoint: new.endpoint().clone(),
+        device: new.device().clone(),
+        confirmation: policy,
+    };
+    (s, a, new, intent)
+}
+fn ready(
+    s: &ParticipantSession,
+    a: &Membership,
+    ep: &EndpointBinding,
+    i: &ParticipantReplacementMutation,
+) -> PreparedParticipantReplacement {
+    let mut ticket = s.prepare_replacement(a, ep, i.clone()).unwrap();
+    ticket
+        .observe_media_ready(a, ep, ticket.generation())
+        .unwrap();
+    ticket
+}
+#[test]
+fn replacement_model_stages_one_binding_then_commits_one_revision_preserving_other_devices_and_remote(
+) {
+    let (mut s, a, ep, i) = setup(EndpointConfirmationPolicy::MediaOnly);
+    let before = s.revision();
+    let role = s.role(a.participant()).cloned();
+    let ticket = ready(&s, &a, &ep, &i);
+    assert_eq!(ticket.binding().replaces(), Some(&i.source));
+    assert_eq!(ticket.generation(), 2);
+    let candidate = s
+        .stage_replacement(&a, &a, i.clone(), &ticket, &ep)
+        .unwrap();
+    assert_eq!(s.revision(), before);
+    assert!(s.connections(a.participant()).contains(&i.source));
+    assert!(!s.connections(a.participant()).contains(&i.replacement));
+    let obs = s.commit_replacement(candidate);
+    assert_eq!(obs.revision, before + 1);
+    assert_eq!(obs.role, role.unwrap());
+    assert_eq!(s.connection_count(), 3);
+    assert_eq!(s.participant_count(), 2);
+    assert_eq!(
+        s.connections(a.participant()),
+        vec![
+            i.replacement.clone(),
+            ConnectionId::from_string("conn_other")
+        ]
+    );
+    let rev = s.revision();
+    assert_eq!(s.connection_ended(&i.source).unwrap(), None);
+    assert_eq!(s.revision(), rev);
+    assert!(s.connections(a.participant()).contains(&i.replacement));
+    let mut retry = i.clone();
+    retry.correlation_id = "new_correlation".into();
+    assert_eq!(s.replay_replacement(&a, &a, &retry).unwrap(), Some(obs));
+    assert!(s
+        .stage_replacement(&a, &a, i.clone(), &ticket, &ep)
+        .is_err());
+    assert!(
+        s.prepare_admission(&a, &ep, i.source, None).is_err(),
+        "old ID stays tombstoned"
+    );
+}
+#[test]
+fn replacement_model_answer_and_attributed_dtmf_are_required_after_media_and_duplicates_are_observations(
+) {
+    let (mut s, a, ep, i) = setup(EndpointConfirmationPolicy::AnsweredDtmf {
+        digits: "42#".into(),
+    });
+    let mut t = s.prepare_replacement(&a, &ep, i.clone()).unwrap();
+    let g = t.generation();
+    assert_eq!(
+        t.observe_dtmf(&i.replacement, g, "42#").unwrap(),
+        EndpointConfirmationObservation::BeforeAnswerOrMedia
+    );
+    t.observe_answer(&i.replacement, g).unwrap();
+    assert_eq!(
+        t.observe_dtmf(&i.replacement, g, "42#").unwrap(),
+        EndpointConfirmationObservation::BeforeAnswerOrMedia
+    );
+    assert!(s.stage_replacement(&a, &a, i.clone(), &t, &ep).is_err());
+    t.observe_media_ready(&a, &ep, g).unwrap();
+    // Answer alone (including voicemail) never steals the live route.
+    assert!(s.stage_replacement(&a, &a, i.clone(), &t, &ep).is_err());
+    assert_eq!(
+        t.observe_dtmf(&i.replacement, g, "1").unwrap(),
+        EndpointConfirmationObservation::IncorrectDigits
+    );
+    assert!(t.observe_dtmf(&i.source, g, "42#").is_err());
+    assert!(t.observe_dtmf(&i.replacement, g - 1, "42#").is_err());
+    assert!(s.stage_replacement(&a, &a, i.clone(), &t, &ep).is_err());
+    assert_eq!(
+        t.observe_dtmf(&i.replacement, g, "42#").unwrap(),
+        EndpointConfirmationObservation::Confirmed
+    );
+    assert_eq!(
+        t.observe_dtmf(&i.replacement, g, "42#").unwrap(),
+        EndpointConfirmationObservation::AlreadyConfirmed
+    );
+    let staged = s.stage_replacement(&a, &a, i.clone(), &t, &ep).unwrap();
+    assert!(s.connections(a.participant()).contains(&i.source));
+    let obs = s.commit_replacement(staged);
+    assert_eq!(obs.confirmation, i.confirmation);
+}
