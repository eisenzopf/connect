+impl PhysicalHandlerFactory for ReplacementFactory {
+    fn handler(
+        &self,
+        context: NativeTransportContext,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        let record = Arc::new(PhysicalRecord::default());
+        self.records.lock().unwrap().push(record.clone());
+        Ok(Arc::new(ReplacementHandler {
+            core: self.core.clone(),
+            pending: self.pending.clone(),
+            source: NativePhysicalBinding::new(context),
