+struct DevicePolicy {
+    base: NamedPolicy,
+    endpoint: EndpointBinding,
+}
+#[async_trait]
+impl PeerAuthority for DevicePolicy {
+    fn authority_lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        l: &AuthorityLease,
+    ) -> Result<AuthorityLifetime, DispatchError> {
+        self.base.authority_lifetime(c, d, i, l)
+    }
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        if c.principal.subject != "alice" || d.id.as_str() != self.endpoint.device().as_str() {
+            return Err(DispatchError::Authority);
+        }
+        Identifier::try_from("id_alice".to_owned()).map_err(DispatchError::from)
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        if self.identity(c, d).await? != *i || c.principal.is_expired() {
+            return Err(DispatchError::Authority);
+        }
+        let guard = self.base.grants.clone().read_owned().await;
+        if guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        let connection = if e.kind() == "connection.offer" {
+            if e.scope(Scope::Conversation) != Some("conversation")
+                || e.scope(Scope::Session) != Some("session")
+            {
+                return Err(DispatchError::Authority);
+            }
+            Some(
+                guard
+                    .connections
+                    .get(e.scope(Scope::Connection).ok_or(DispatchError::Authority)?)
+                    .ok_or(DispatchError::Authority)?
+                    .clone(),
+            )
+        } else {
+            None
+        };
+        let authority = PeerNativeAuthority {
+            actor: guard.member.clone(),
+            endpoint: self.endpoint.clone(),
+            may_prepare: true,
+        };
+        Ok(AuthorityLease::holding(WireProof {
+            _base: AuthorityLease::holding(()),
+            _guard: guard,
+            authorities: HashMap::from([(self.endpoint.transport(), authority)]),
+            connection,
+        }))
+    }
+    async fn refresh(
+        &self,
+        _: &ValidatedBearer,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.acquire(c, d, i, e).await
+    }
+}
