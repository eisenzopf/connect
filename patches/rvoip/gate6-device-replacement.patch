+        drop(foreign);
+        assert!(matches!(
+            s.core.orch.prepare_adapter_device_replacement_with_held(
+                &pending,
+                adapter.context.clone(),
+                &g
+            ),
+            Err(ParticipantControlError::Unsupported)
+        ));
+        assert!(!adapter.live.load(Ordering::Acquire));
+        adapter.supported.store(true, Ordering::Release);
+        assert_eq!(
+            s.core
+                .orch
+                .prepare_adapter_device_replacement_with_held(&pending, adapter.context.clone(), &g)
+                .unwrap(),
+            id
+        );
+        drop(g);
+        assert_eq!(adapter.starts.load(Ordering::Acquire), 0);
+        let g = grant(s, &intent, &operator, Approval::Start).await;
+        assert!(s
+            .core
+            .orch
+            .start_adapter_device_replacement_with_held(&pending, &g)
+            .await
+            .is_err());
+        drop(g);
+        assert_eq!(adapter.starts.load(Ordering::Acquire), 1);
+        for _ in 0..2 {
+            let g = grant(s, &intent, &operator, Approval::Start).await;
+            let receipt = s
+                .core
+                .orch
+                .start_adapter_device_replacement_with_held(&pending, &g)
+                .await
+                .unwrap();
+            assert_eq!(receipt.external_references().len(), 1);
+            drop(g);
+        }
+        assert_eq!(adapter.starts.load(Ordering::Acquire), 1);
+        let g = grant(s, &intent, &operator, Approval::Resources).await;
+        let controller = StreamController::with_held_control(
+            s.core.conversation.clone(),
+            s.core.session.clone(),
+            id.clone(),
+            adapter.context.principal.clone(),
+            media.clone(),
+            adapter.clone(),
+            Arc::new(StreamHandleAllocator::default()),
+            4,
+            4,
+            adapter.lifetime.lock().unwrap().clone(),
+            &g,
+        )
+        .unwrap();
+        *adapter.controller.lock().unwrap() = Some(controller.clone());
+        controller
+            .change_with_held(
+                0,
+                &[desired(Medium::Audio)],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+                Arc::new(g.clone()),
+            )
+            .await
+            .unwrap();
+        controller
+            .set_media_gate_with_held(
+                controller.revision(),
+                &BTreeSet::from([desired(Medium::Audio).logical_id]),
+                StreamGateAction::Mute,
+                deadline(),
+                Arc::new(g.clone()),
+            )
+            .await
+            .unwrap();
+        drop(g);
+        let output = adapter.port().take_egress().unwrap();
+        let g = grant(s, &intent, &operator, Approval::Attach).await;
+        s.core
+            .orch
+            .attach_staged_device_replacement_with_held(&pending, None, &g)
+            .await
+            .unwrap();
+        drop(g);
+        let plan = s
+            .core
+            .orch
+            .plan_staged_device_replacement_activation(&pending)
+            .unwrap();
+        let g = grant(s, &intent, &operator, Approval::Audience(plan.clone())).await;
+        s.core
+            .orch
+            .activate_staged_device_replacement_with_held(&pending, plan, &g)
+            .await
+            .unwrap();
+        drop(g);
+        Self {
+            pending,
+            adapter,
+            operator,
+            output,
+            caller_cancel,
+        }
+    }
+    async fn event(&self, s: &Scene, event: DeviceReplacementEndpointEvent) -> Observation {
+        let captured = s
+            .core
+            .orch
+            .capture_device_replacement_event(
+                &self.pending,
+                DeviceReplacementSignalSource::Adapter(self.adapter.context.clone()),
+                event.clone(),
+            )
+            .unwrap();
+        let g = grant(
+            s,
+            self.pending.intent(),
+            &self.adapter.context.principal,
+            Approval::Signal(event),
+        )
+        .await;
+        captured.observe_with_held(&g).unwrap()
+    }
+    async fn prompt(&mut self) {
+        self.adapter
+            .port()
+            .try_publish(&self.adapter.frame())
+            .unwrap();
+        tokio::time::sleep(Duration::from_millis(35)).await;
+        let controller = self
+            .adapter
+            .controller
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .clone();
+        controller
+            .try_queue_local_audio(
+                &desired(Medium::Audio).logical_id,
+                self.adapter.frame(),
+                LocalAudioPurpose::EndpointPreparation {
+                    operation_id: self.pending.intent().operation_id.clone(),
+                },
+            )
+            .unwrap();
+        self.heard().await;
+    }
+    async fn heard(&mut self) {
+        let packet = tokio::time::timeout(Duration::from_secs(1), self.output.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        packet
+            .deliver(|frame| async move {
+                let mut codec = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                    0,
+                    Some(8000),
+                    Some(1),
+                )
+                .unwrap();
+                assert!(codec
+                    .decode(&frame.payload)
+                    .unwrap()
+                    .samples
+                    .iter()
+                    .any(|v| v.unsigned_abs() > 500));
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn controlled_browser_and_telephone_replacement_use_reserved_route_and_confirmed_duplex_once()
+{
+    for kind in [Transport::WebRtc, Transport::Sip] {
+        let s = Scene::new_replacement("quic").await;
+        let mut c = Candidate::new(&s, kind).await;
+        let id = c.pending.intent().replacement.clone();
+        let revision = c.pending.intent().expected_revision;
+        let foreign = Arc::new(RouteContext {
+            principal: c.adapter.context.principal.clone(),
+        });
+        assert!(s
+            .core
+            .orch
+            .capture_device_replacement_event(
+                &c.pending,
+                DeviceReplacementSignalSource::Adapter(foreign),
+                DeviceReplacementEndpointEvent::Answered
+            )
+            .is_err());
+        assert!(s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .is_err());
+        s.tone(0, 1).await;
+        s.tone(1, 0).await;
+        c.prompt().await;
+        assert_eq!(
+            c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+            Observation::Answered
+        );
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf { digits: "9".into() }
+            )
+            .await,
+            Observation::IncorrectDigits
+        );
+        assert!(s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .is_err());
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf {
+                    digits: "5#".into()
+                }
+            )
+            .await,
+            Observation::Confirmed
+        );
+        assert_eq!(
+            c.event(
+                &s,
+                DeviceReplacementEndpointEvent::Dtmf {
+                    digits: "5#".into()
+                }
+            )
+            .await,
+            Observation::AlreadyConfirmed
+        );
+        let late = s
+            .core
+            .orch
+            .capture_device_replacement_event(
+                &c.pending,
+                DeviceReplacementSignalSource::Adapter(c.adapter.context.clone()),
+                DeviceReplacementEndpointEvent::Answered,
+            )
+            .unwrap();
+        let plan = s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .unwrap();
+        let g = grant(
+            &s,
+            c.pending.intent(),
+            &c.operator,
+            Approval::Commit(plan.clone()),
+        )
+        .await;
+        let (outcome, _) = s
+            .core
+            .orch
+            .commit_staged_device_replacement_with_held(plan, &g)
+            .await
+            .unwrap();
+        drop(g);
+        assert_eq!(
+            outcome
+                .media
+                .participant_replacement
+                .as_ref()
+                .unwrap()
+                .revision,
+            revision + 1
+        );
+        assert_eq!(
+            s.core.orch.participant_capacity(&s.core.session).unwrap(),
+            (4, 0)
+        );
+        let g = grant(
+            &s,
+            c.pending.intent(),
+            &c.adapter.context.principal,
+            Approval::Signal(DeviceReplacementEndpointEvent::Answered),
+        )
+        .await;
+        assert!(late.observe_with_held(&g).is_err());
+        drop(g);
+        s.live[0].wire.server.shutdown().await.unwrap();
+        core_fixture::until(|| s.live[0].peer.snapshot().connections == 0).await;
+        c.caller_cancel.cancel();
+        tokio::time::sleep(Duration::from_millis(30)).await;
+        assert!(c.adapter.current(&id));
+        assert!(!c.pending.cancel());
+        Scene::drain(&s.live[1].wire).await;
+        c.adapter.port().try_publish(&c.adapter.frame()).unwrap();
+        decoded(&received(&s.live[1].wire).await);
+        while c.output.try_recv().is_ok() {}
+        send(
+            &s.live[1].wire,
+            audio(binding(&s.live[1].leg, Medium::Audio).stream_local_id, 0),
+        );
+        c.heard().await;
+        assert_eq!(c.adapter.starts.load(Ordering::Acquire), 1);
+        s.core
+            .orch
+            .end_connection(id.clone(), EndReason::Normal)
+            .await
+            .unwrap();
+        assert!(!c.adapter.current(&id));
+        s.stop().await;
+    }
+}
