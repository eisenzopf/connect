diff --git a/crates/foundation/rvoip-core/src/orchestrator/participant_control/replacement.rs b/crates/foundation/rvoip-core/src/orchestrator/participant_control/replacement.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/orchestrator/participant_control/replacement.rs
@@ -0,0 +1,1554 @@
+//! Owned make-before-break preparation and one managed model/media publication.
+use super::*;
+use crate::participant_transitions::{
+    EndpointConfirmationObservation, ParticipantReplacementMutation,
+    ParticipantReplacementObservation, PreparedParticipantReplacement,
+    PreparedParticipantReplacementCommit,
+};
+use crate::peer_admission::PeerAdmission;
+use crate::staged_streams::{
+    audience::{AudioAudienceHandle, AudioAudiencePlan, AudioAudienceRequest},
+    device_replacement::{
+        AudioDeviceReplacementHandle, AudioDeviceReplacementOutcome, AudioDeviceReplacementPlan,
+        AudioDeviceReplacementRequest,
+    },
+    signal::ControllerSignalStamp,
+    StreamControlError,
+};
+use std::collections::BTreeSet;
+use std::sync::atomic::{AtomicU8, Ordering};
+const PREPARING: u8 = 0;
+const ATTACHED: u8 = 1;
+const COMMITTED: u8 = 2;
+const CANCELLED: u8 = 3;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReplacementPhase {
+    Prepare,
+    Allocate,
+    Start,
+    Attach,
+    Activate,
+    Commit,
+    Replay,
+}
+pub struct ParticipantReplacementScope<'a> {
+    pub conversation: &'a ConversationId,
+    pub session: &'a SessionId,
+    pub principal: &'a AuthenticatedPrincipal,
+    pub intent: &'a ParticipantReplacementMutation,
+    pub phase: ReplacementPhase,
+    pub plan: Option<&'a AudioDeviceReplacementPlan>,
+}
+pub struct ParticipantReplacementAuthority {
+    pub actor: Membership,
+    pub target: Membership,
+    pub endpoint: EndpointBinding,
+    pub may_send_audio: bool,
+    pub may_receive_audio: bool,
+}
+pub trait ParticipantReplacementLease: Send + Sync {
+    fn current(
+        &self,
+        scope: &ParticipantReplacementScope<'_>,
+    ) -> ControlResult<ParticipantReplacementAuthority>;
+}
+pub struct ParticipantReplacementControl {
+    lease: Box<dyn ParticipantReplacementLease>,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+impl ParticipantReplacementControl {
+    pub fn new(
+        lease: Box<dyn ParticipantReplacementLease>,
+        cancellation: CancellationToken,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<Self> {
+        let value = Self {
+            lease,
+            cancellation,
+            deadline: deadline.min(tokio::time::Instant::now() + Duration::from_secs(60)),
+        };
+        value.check()?;
+        Ok(value)
+    }
+    fn check(&self) -> ControlResult<()> {
+        if self.cancellation.is_cancelled() {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(ParticipantControlError::Deadline);
+        }
+        Ok(())
+    }
+    fn current(
+        &self,
+        scope: &ParticipantReplacementScope<'_>,
+    ) -> ControlResult<ParticipantReplacementAuthority> {
+        self.check()?;
+        let current = self.lease.current(scope)?;
+        self.check()?;
+        Ok(current)
+    }
+}
+struct PendingReplacementState {
+    ticket: PreparedParticipantReplacement,
+    context: Option<AudioAudienceHandle>,
+    slot: Option<OwnedSemaphorePermit>,
+    cleanup_started: bool,
+}
+/// Metadata/resource owner, not an authority lease. The exact ID is reserved
+/// before allocation and remains a tombstone if preparation is cancelled.
+pub struct DeviceReplacementPreparation {
+    owner: Weak<Orchestrator>,
+    runtime: Arc<ManagedParticipantSession>,
+    intent: ParticipantReplacementMutation,
+    nonce: u128,
+    principal: AuthenticatedPrincipal,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+    state: Mutex<PendingReplacementState>,
+    phase: AtomicU8,
+    flight: Arc<Semaphore>,
+    resource_lifetime: CancellationToken,
+    source_lifecycles: Vec<ConnectionLifecycleTicket>,
+    candidate: ConnectionLifecycleTicket,
+}
+impl DeviceReplacementPreparation {
+    pub fn intent(&self) -> &ParticipantReplacementMutation {
+        &self.intent
+    }
+    pub fn prepared_binding(&self) -> PreparedParticipantReplacement {
+        self.state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .ticket
+            .clone()
+    }
+    pub fn is_committed(&self) -> bool {
+        self.phase.load(Ordering::Acquire) == COMMITTED
+    }
+    pub fn cancellation(&self) -> CancellationToken {
+        self.cancellation.child_token()
+    }
+    fn check(&self) -> ControlResult<()> {
+        if self.is_committed() {
+            return Err(ParticipantTransitionError::Conflict.into());
+        }
+        if self.phase.load(Ordering::Acquire) == CANCELLED || self.cancellation.is_cancelled() {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(ParticipantControlError::Deadline);
+        }
+        Ok(())
+    }
+    /// A committed replacement cannot be cancelled into rollback or teardown of
+    /// the new route. Cancellation owns only this preparation's candidate.
+    pub fn cancel(&self) -> bool {
+        let cleanup = {
+            let mut pending = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            if self.is_committed() {
+                return false;
+            }
+            self.phase.store(CANCELLED, Ordering::Release);
+            self.cancellation.cancel();
+            self.resource_lifetime.cancel();
+            pending.slot.take();
+            if pending.cleanup_started {
+                false
+            } else {
+                pending.cleanup_started = true;
+                true
+            }
+        };
+        if cleanup {
+            self.abort_candidate();
+        }
+        true
+    }
+    fn abort_candidate(&self) {
+        {
+            let mut state = self.runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state
+                .pending
+                .get(&self.intent.replacement)
+                .is_some_and(|p| p.replacement_nonce == Some(self.nonce))
+            {
+                state.pending.remove(&self.intent.replacement);
+            }
+        }
+        if let Some(owner) = self.owner.upgrade() {
+            {
+                let _registry = owner
+                    .connection_registry_lock
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner());
+                let mut state = self
+                    .candidate
+                    .state
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner());
+                if state.replacement_reservation == Some(self.nonce) {
+                    state.replacement_reservation = None;
+                    state.retired = true;
+                    state.active = false;
+                    state.generation = state.generation.saturating_add(1);
+                }
+            }
+            if let Some(scene) = &self.runtime.mixer.staged {
+                scene.remove(&self.intent.replacement);
+            }
+            owner.retire_participant_route(&self.intent.replacement);
+        }
+    }
+}
+impl Drop for DeviceReplacementPreparation {
+    fn drop(&mut self) {
+        if !self.is_committed() {
+            self.cancel();
+        }
+    }
+}
+#[derive(Clone)]
+pub struct ManagedAudioDeviceReplacementPlan {
+    media: AudioDeviceReplacementPlan,
+    preparation: Arc<DeviceReplacementPreparation>,
+}
+impl ManagedAudioDeviceReplacementPlan {
+    pub fn media(&self) -> &AudioDeviceReplacementPlan {
+        &self.media
+    }
+    pub fn same_intent(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.preparation, &other.preparation)
+            && self.media.audience().same_intent(other.media.audience())
+    }
+}
+fn deadline_for(
+    principal: &AuthenticatedPrincipal,
+    deadline: tokio::time::Instant,
+) -> tokio::time::Instant {
+    principal_expiry(principal).map_or(deadline, |expiry| {
+        deadline
+            .min(tokio::time::Instant::now() + (expiry - Utc::now()).to_std().unwrap_or_default())
+    })
+}
+fn scope<'a>(
+    p: &'a DeviceReplacementPreparation,
+    phase: ReplacementPhase,
+    plan: Option<&'a AudioDeviceReplacementPlan>,
+) -> ParticipantReplacementScope<'a> {
+    ParticipantReplacementScope {
+        conversation: &p.runtime.conversation,
+        session: &p.runtime.session,
+        principal: &p.principal,
+        intent: &p.intent,
+        phase,
+        plan,
+    }
+}
+fn check_authority(
+    scope: &ParticipantReplacementScope<'_>,
+    a: &ParticipantReplacementAuthority,
+) -> ControlResult<()> {
+    a.actor
+        .revalidate_principal(scope.principal, Utc::now())
+        .map_err(|_| ParticipantControlError::Authority)?;
+    if a.target.participant() != &scope.intent.participant
+        || a.actor.conversation() != scope.conversation
+        || a.target.conversation() != scope.conversation
+        || a.endpoint.endpoint() != &scope.intent.endpoint
+        || a.endpoint.device() != &scope.intent.device
+        || (scope.phase != ReplacementPhase::Replay && !a.may_receive_audio)
+    {
+        return Err(ParticipantControlError::Authority);
+    }
+    if scope.phase != ReplacementPhase::Replay {
+        a.endpoint
+            .usable_by(&a.target)
+            .map_err(|_| ParticipantControlError::Authority)?;
+    }
+    Ok(())
+}
+impl Orchestrator {
+    fn owns_replacement(&self, p: &DeviceReplacementPreparation) -> ControlResult<()> {
+        if p.owner
+            .upgrade()
+            .is_some_and(|owner| std::ptr::eq(owner.as_ref(), self))
+        {
+            Ok(())
+        } else {
+            Err(ParticipantControlError::Authority)
+        }
+    }
+    pub fn prepare_staged_device_replacement_with_held(
+        self: &Arc<Self>,
+        session: &SessionId,
+        principal: AuthenticatedPrincipal,
+        intent: ParticipantReplacementMutation,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Arc<DeviceReplacementPreparation>> {
+        let runtime = self.participant_runtime(session)?;
+        if runtime.mixer.staged.is_none() {
+            return Err(ParticipantControlError::Unsupported);
+        }
+        let request = ParticipantReplacementScope {
+            conversation: &runtime.conversation,
+            session,
+            principal: &principal,
+            intent: &intent,
+            phase: ReplacementPhase::Prepare,
+            plan: None,
+        };
+        let control = runtime.policy.current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        let deadline = deadline_for(
+            &principal,
+            deadline
+                .min(control.deadline)
+                .min(tokio::time::Instant::now() + Duration::from_secs(60)),
+        );
+        if cancellation.is_cancelled() || control.cancellation.is_cancelled() {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= deadline {
+            return Err(ParticipantControlError::Deadline);
+        }
+        let prepared = {
+            let mut state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state.ended
+                || state.pending.contains_key(&intent.replacement)
+                || self
+                    .sessions_by_connection
+                    .contains_key(&intent.replacement)
+            {
+                return Err(ParticipantTransitionError::Conflict.into());
+            }
+            let ticket = state.controller.prepare_replacement(
+                &authority.target,
+                &authority.endpoint,
+                intent.clone(),
+            )?;
+            let source_lifecycles = BTreeSet::from([&intent.source, &intent.retained])
+                .into_iter()
+                .map(|id| {
+                    state
+                        .routes
+                        .get(id)
+                        .map(|r| r.lifecycle.clone())
+                        .ok_or(ParticipantControlError::Authority)
+                })
+                .collect::<ControlResult<Vec<_>>>()?;
+            self.validate_connection_lifecycles(&source_lifecycles)?;
+            for id in [&intent.source, &intent.retained] {
+                if !self.adapter_for(id)?.is_connection_live(id) {
+                    return Err(ParticipantTransitionError::NotReady.into());
+                }
+            }
+            let slot = runtime
+                .replacement_slots
+                .clone()
+                .try_acquire_owned()
+                .map_err(|_| ParticipantTransitionError::Capacity)?;
+            let _registry = self
+                .connection_registry_lock
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            if self.connections.contains_key(&intent.replacement)
+                || self.connection_lifecycles.contains_key(&intent.replacement)
+            {
+                return Err(ParticipantTransitionError::Conflict.into());
+            }
+            if self.connection_lifecycles.len() >= self.connection_id_budget.load(Ordering::Relaxed)
+            {
+                return Err(ParticipantTransitionError::Capacity.into());
+            }
+            let nonce = uuid::Uuid::new_v4().as_u128();
+            let life = Arc::new(Mutex::new(ConnectionLifecycleState {
+                replacement_reservation: Some(nonce),
+                peer_admission: None,
+                peer_origin: None,
+                peer_preparation: None,
+                generation: 1,
+                active: false,
+                retired: false,
+                admission_outcomes_notified: HashSet::new(),
+                operational_connected_emitted: false,
+            }));
+            self.connection_lifecycles
+                .insert(intent.replacement.clone(), life.clone());
+            let cancellation = cancellation.child_token();
+            state.pending.insert(
+                intent.replacement.clone(),
+                PendingAdmission {
+                    replacement_nonce: Some(nonce),
+                    participant: intent.participant.clone(),
+                    cancellation: cancellation.clone(),
+                },
+            );
+            self.managed_participant_connections
+                .insert(intent.replacement.clone(), Arc::downgrade(&runtime));
+            Arc::new(DeviceReplacementPreparation {
+                owner: Arc::downgrade(self),
+                runtime: runtime.clone(),
+                candidate: ConnectionLifecycleTicket {
+                    connection_id: intent.replacement.clone(),
+                    generation: 1,
+                    state: life,
+                },
+                source_lifecycles,
+                resource_lifetime: CancellationToken::new(),
+                intent,
+                nonce,
+                principal,
+                cancellation,
+                deadline,
+                state: Mutex::new(PendingReplacementState {
+                    ticket,
+                    context: None,
+                    slot: Some(slot),
+                    cleanup_started: false,
+                }),
+                phase: AtomicU8::new(PREPARING),
+                flight: Arc::new(Semaphore::new(1)),
+            })
+        };
+        let weak = Arc::downgrade(&prepared);
+        let cancel = prepared.cancellation.clone();
+        let _ = self.connection_lifecycle_tasks.spawn(async move {
+            let mut tick = tokio::time::interval(Duration::from_millis(20));
+            tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+            loop {
+                let terminal = tokio::select! {
+                    _ = cancel.cancelled() => true,
+                    _ = tokio::time::sleep_until(deadline) => true,
+                    _ = tick.tick() => false,
+                };
+                let Some(p) = weak.upgrade() else {
+                    break;
+                };
+                if p.is_committed() {
+                    break;
+                }
+                let current = p.owner.upgrade().is_some_and(|owner| {
+                    owner
+                        .validate_connection_lifecycles(&p.source_lifecycles)
+                        .is_ok()
+                        && p.source_lifecycles.iter().all(|t| {
+                            owner
+                                .adapter_for(&t.connection_id)
+                                .is_ok_and(|a| a.is_connection_live(&t.connection_id))
+                        })
+                });
+                let candidate_bad = p.owner.upgrade().is_none_or(|owner| {
+                    // Serialize with allocation: an active lifecycle and its
+                    // adapter route become visible as one reserved-ID action.
+                    let _registry = owner
+                        .connection_registry_lock
+                        .lock()
+                        .unwrap_or_else(|v| v.into_inner());
+                    let life = p.candidate.state.lock().unwrap_or_else(|v| v.into_inner());
+                    life.retired
+                        || life
+                            .peer_admission
+                            .as_ref()
+                            .is_some_and(|r| r.peer.is_closed())
+                        || (life.active
+                            && !owner
+                                .adapter_for(&p.intent.replacement)
+                                .is_ok_and(|a| a.is_connection_live(&p.intent.replacement)))
+                });
+                if terminal || !current || candidate_bad {
+                    p.cancel();
+                    break;
+                }
+            }
+        });
+        Ok(prepared)
+    }
+    /// Native allocation consumes the exact Core reservation, not a caller ID
+    /// exception. Ordinary native preparation still refuses reserved IDs.
+    pub fn prepare_peer_native_device_replacement(
+        self: &Arc<Self>,
+        preparation: &Arc<DeviceReplacementPreparation>,
+        peer: Arc<PeerAdmission>,
+        principal: &AuthenticatedPrincipal,
+        lease: &dyn super::peer_native::PeerNativeAuthorityLease,
+        context: Arc<dyn Any + Send + Sync>,
+    ) -> ControlResult<super::peer_native::PreparedPeerNativeConnection> {
+        preparation.check()?;
+        if !preparation
+            .owner
+            .upgrade()
+            .is_some_and(|o| Arc::ptr_eq(&o, self))
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let authority = lease.authority();
+        if authority.actor.participant() != &preparation.intent.participant
+            || authority.endpoint.endpoint() != &preparation.intent.endpoint
+            || authority.endpoint.device() != &preparation.intent.device
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let result = self
+            .prepare_peer_native_connection_inner(
+                peer,
+                principal,
+                super::peer_native::PeerNativeIntent {
+                    session: preparation.runtime.session.clone(),
+                    connection: preparation.intent.replacement.clone(),
+                    transport: authority.endpoint.transport(),
+                },
+                lease,
+                context,
+                Some(preparation.nonce),
+            )
+            .map_err(|e| match e {
+                crate::orchestrator::peer_native::PeerNativeError::Authority => {
+                    ParticipantControlError::Authority
+                }
+                crate::orchestrator::peer_native::PeerNativeError::Capacity => {
+                    ParticipantTransitionError::Capacity.into()
+                }
+                crate::orchestrator::peer_native::PeerNativeError::Conflict => {
+                    ParticipantTransitionError::Conflict.into()
+                }
+                crate::orchestrator::peer_native::PeerNativeError::Closed => {
+                    ParticipantControlError::Cancelled
+                }
+                crate::orchestrator::peer_native::PeerNativeError::Unsupported => {
+                    ParticipantControlError::Unsupported
+                }
+                crate::orchestrator::peer_native::PeerNativeError::Adapter => {
+                    ParticipantControlError::Core(RvoipError::InvalidState(
+                        "replacement adapter allocation failed",
+                    ))
+                }
+            })?;
+        preparation.check()?;
+        Ok(result)
+    }
+    pub async fn attach_staged_device_replacement_with_held(
+        self: &Arc<Self>,
+        p: &Arc<DeviceReplacementPreparation>,
+        peer: Option<Arc<PeerAdmission>>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<()> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        let _flight = p
+            .flight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| ParticipantTransitionError::Conflict)?;
+        if !p.owner.upgrade().is_some_and(|o| Arc::ptr_eq(&o, self)) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let request = scope(p, ReplacementPhase::Attach, None);
+        let control = p
+            .runtime
+            .policy
+            .current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        let adapter = self.adapter_for(&p.intent.replacement)?;
+        if !adapter.lifecycle_capabilities().authoritative_liveness
+            || !adapter.is_connection_live(&p.intent.replacement)
+            || adapter.transport() != authority.endpoint.transport()
+        {
+            return Err(ParticipantControlError::Unsupported);
+        }
+        let controller = adapter
+            .staged_controller(&p.intent.replacement)
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let scene = p
+            .runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let mut member =
+            scene.prepare_private(controller, &format!("replace_{}", p.nonce), held)?;
+        member
+            .quiesce(p.deadline.min(control.deadline), p.cancellation.clone())
+            .await?;
+        let state = p.runtime.state.lock().unwrap_or_else(|v| v.into_inner());
+        let _registry = self
+            .connection_registry_lock
+            .lock()
+            .unwrap_or_else(|v| v.into_inner());
+        let tickets = vec![p.candidate.clone()];
+        let mut lives = self.lock_connection_lifecycles(&tickets)?;
+        let life = &mut lives[0];
+        let pending = p.state.lock().unwrap_or_else(|v| v.into_inner());
+        p.check()?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        if state.ended
+            || state.controller.revision() != p.intent.expected_revision
+            || !state
+                .pending
+                .get(&p.intent.replacement)
+                .is_some_and(|q| q.replacement_nonce == Some(p.nonce))
+            || pending.context.is_some()
+            || p.phase.load(Ordering::Acquire) != PREPARING
+            || self
+                .sessions_by_connection
+                .contains_key(&p.intent.replacement)
+            || !member.ready()
+            || !member.bound_to(&authority.target, &authority.endpoint)
+            || !member.binding().same_incarnation(pending.ticket.binding())
+        {
+            return Err(ParticipantTransitionError::Conflict.into());
+        }
+        match peer {
+            Some(peer) => {
+                let actual = self.connection_principal(&p.intent.replacement)?;
+                peer.check_target(&actual, &authority.target, &authority.endpoint)
+                    .map_err(peer_error)?;
+                if !life
+                    .peer_admission
+                    .as_ref()
+                    .is_some_and(|r| r.belongs_to(peer.incarnation()))
+                    || !life.peer_preparation.as_ref().is_some_and(|s| {
+                        s.matches(&p.runtime.session, &authority.target, &authority.endpoint)
+                    })
+                    || !adapter.is_peer_native_preparation_current(&p.intent.replacement, &peer)
+                {
+                    return Err(ParticipantControlError::Authority);
+                }
+                life.peer_preparation = None;
+            }
+            None => {
+                if matches!(
+                    adapter.transport(),
+                    Transport::Quic | Transport::WebTransport | Transport::WebSocket
+                ) {
+                    return Err(ParticipantControlError::Authority);
+                }
+            }
+        }
+        scene.insert(p.intent.replacement.clone(), member, true);
+        p.phase.store(ATTACHED, Ordering::Release);
+        drop(pending);
+        drop(state);
+        Ok(())
+    }
+    pub fn plan_staged_device_replacement_activation(
+        &self,
+        p: &Arc<DeviceReplacementPreparation>,
+    ) -> ControlResult<AudioAudiencePlan> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        if p.phase.load(Ordering::Acquire) != ATTACHED {
+            return Err(ParticipantTransitionError::NotReady.into());
+        }
+        let scene = p
+            .runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        Ok(scene.plan_audio_audience(AudioAudienceRequest {
+            operation_id: format!("activate_{}", p.nonce),
+            expected_revision: scene.audience_revision(),
+            private_connections: BTreeSet::from([p.intent.replacement.clone()]),
+            receivers: BTreeMap::from([(p.intent.replacement.clone(), vec![])]),
+            activate_muted: Some(p.intent.replacement.clone()),
+        })?)
+    }
+    pub async fn activate_staged_device_replacement_with_held(
+        self: &Arc<Self>,
+        p: &Arc<DeviceReplacementPreparation>,
+        plan: AudioAudiencePlan,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<AudioAudienceHandle> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        let _flight = p
+            .flight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| ParticipantTransitionError::Conflict)?;
+        let request = scope(p, ReplacementPhase::Activate, None);
+        let control = p
+            .runtime
+            .policy
+            .current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        if plan.request().operation_id != format!("activate_{}", p.nonce)
+            || plan.request().private_connections != BTreeSet::from([p.intent.replacement.clone()])
+            || plan.request().activate_muted.as_ref() != Some(&p.intent.replacement)
+            || plan.request().receivers != BTreeMap::from([(p.intent.replacement.clone(), vec![])])
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let scene = p
+            .runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let (_, context) = scene
+            .apply_audio_audience(
+                plan,
+                p.deadline.min(control.deadline),
+                p.cancellation.clone(),
+                held,
+            )
+            .await?;
+        let mut pending = p.state.lock().unwrap_or_else(|v| v.into_inner());
+        p.check()?;
+        if pending.context.is_some() {
+            return Err(ParticipantTransitionError::Conflict.into());
+        }
+        pending.context = Some(context.clone());
+        Ok(context)
+    }
+    pub fn plan_staged_device_replacement(
+        &self,
+        p: &Arc<DeviceReplacementPreparation>,
+    ) -> ControlResult<ManagedAudioDeviceReplacementPlan> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        let pending = p.state.lock().unwrap_or_else(|v| v.into_inner());
+        let context = pending
+            .context
+            .as_ref()
+            .ok_or(ParticipantTransitionError::NotReady)?;
+        let scene = p
+            .runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let media = scene.plan_audio_device_replacement(
+            context,
+            &pending.ticket,
+            AudioDeviceReplacementRequest {
+                operation_id: p.intent.operation_id.clone(),
+                expected_revision: scene.audience_revision(),
+                source: p.intent.source.clone(),
+                admitted: p.intent.replacement.clone(),
+                retained: p.intent.retained.clone(),
+            },
+        )?;
+        Ok(ManagedAudioDeviceReplacementPlan {
+            media,
+            preparation: p.clone(),
+        })
+    }
+    pub async fn commit_staged_device_replacement_with_held(
+        self: &Arc<Self>,
+        plan: ManagedAudioDeviceReplacementPlan,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<(AudioDeviceReplacementOutcome, AudioDeviceReplacementHandle)> {
+        let p = &plan.preparation;
+        self.owns_replacement(p)?;
+        p.check()?;
+        let request = scope(p, ReplacementPhase::Commit, Some(&plan.media));
+        let control = p
+            .runtime
+            .policy
+            .current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        let mut lifecycles = p.source_lifecycles.clone();
+        lifecycles.push(p.candidate.clone());
+        lifecycles.sort_by(|a, b| a.connection_id.cmp(&b.connection_id));
+        let context = ManagedReplacementContext {
+            owner: self.clone(),
+            runtime: p.runtime.clone(),
+            plan: plan.clone(),
+            control,
+            conversation: self
+                .conversation(&p.runtime.conversation)
+                .ok_or_else(|| RvoipError::ConversationNotFound(p.runtime.conversation.clone()))?,
+            session: self
+                .session(&p.runtime.session)
+                .ok_or_else(|| RvoipError::SessionNotFound(p.runtime.session.clone()))?,
+            lifecycles,
+        };
+        let result = p
+            .runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?
+            .commit_audio_device_replacement_managed(
+                plan.media.clone(),
+                p.deadline,
+                p.cancellation.clone(),
+                held,
+                Some(context),
+            )
+            .await?;
+        self.retire_participant_route(&result.0.replaced);
+        Ok(result)
+    }
+    pub fn replay_staged_device_replacement(
+        &self,
+        p: &Arc<DeviceReplacementPreparation>,
+        principal: &AuthenticatedPrincipal,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Option<ParticipantReplacementObservation>> {
+        self.owns_replacement(p)?;
+        let request = ParticipantReplacementScope {
+            conversation: &p.runtime.conversation,
+            session: &p.runtime.session,
+            principal,
+            intent: &p.intent,
+            phase: ReplacementPhase::Replay,
+            plan: None,
+        };
+        let control = p
+            .runtime
+            .policy
+            .current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        let state = p.runtime.state.lock().unwrap_or_else(|v| v.into_inner());
+        Ok(state
+            .controller
+            .replay_replacement(&authority.actor, &authority.target, &p.intent)?)
+    }
+}
