+struct RoleLease(Arc<Grant>);
+impl ParticipantReplacementLease for RoleLease {
+    fn current(
+        &self,
+        scope: &ParticipantReplacementScope<'_>,
+    ) -> pc::ControlResult<ParticipantReplacementAuthority> {
+        let g = &self.0;
+        if g.intent != *scope.intent
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &g.principal,
+                scope.principal,
+            )
+        {
+            return Err(ParticipantControlError::Authority);
+        }
+        let valid = matches!(
+            (&g.approval, scope.phase),
+            (Approval::Prepare, ReplacementPhase::Prepare)
+                | (Approval::Allocate, ReplacementPhase::Allocate)
+                | (Approval::Start, ReplacementPhase::Start)
+                | (Approval::Attach, ReplacementPhase::Attach)
+                | (Approval::Audience(_), ReplacementPhase::Activate)
+                | (Approval::Commit(_), ReplacementPhase::Commit)
+                | (Approval::Replay, ReplacementPhase::Replay)
+        );
+        if !valid {
+            return Err(ParticipantControlError::Authority);
+        }
+        if let Approval::Commit(p) = &g.approval {
+            if !scope
+                .plan
+                .is_some_and(|plan| p.media().audience().same_intent(plan.audience()))
+            {
+                return Err(ParticipantControlError::Authority);
+            }
+        }
+        let old = g
+            .media
+            .raw(&g.guard, &g.intent.source)
+            .map_err(|_| ParticipantControlError::Authority)?;
+        let new = g
+            .media
+            .raw(&g.guard, &g.intent.replacement)
+            .map_err(|_| ParticipantControlError::Authority)?;
+        if !old.may_control || !new.may_control {
+            return Err(ParticipantControlError::Authority);
+        }
+        old.actor
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| ParticipantControlError::Authority)?;
+        Ok(ParticipantReplacementAuthority {
+            actor: old.actor,
+            target: new.member,
+            endpoint: new.endpoint,
+            may_send_audio: new.send_media.contains(&Medium::Audio),
+            may_receive_audio: new.receive_media.contains(&Medium::Audio),
+        })
+    }
+}
+impl ParticipantPolicy for Roles {
+    fn current(
+        &self,
+        scope: &ParticipantScope<'_>,
+    ) -> pc::ControlResult<Box<dyn ParticipantAuthorityLease + '_>> {
+        self.base.current(scope)
+    }
+    fn current_replacement_control(
+        &self,
+        scope: &ParticipantReplacementScope<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> pc::ControlResult<ParticipantReplacementControl> {
+        let g = self
+            .media
+            .grant(held)
+            .map_err(|_| ParticipantControlError::Authority)?;
+        let lease = RoleLease(g.clone());
+        let _ = lease.current(scope)?;
+        ParticipantReplacementControl::new(Box::new(lease), CancellationToken::new(), deadline())
+    }
+}
