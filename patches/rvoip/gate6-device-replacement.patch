+pub(crate) struct ManagedAudienceObservation {
+    pub(crate) handoff: Option<crate::participant_transitions::ParticipantHandoffObservation>,
+    pub(crate) replacement: Option<ParticipantReplacementObservation>,
+}
+impl ManagedAudienceContext {
+    pub(crate) fn deadline(&self) -> tokio::time::Instant {
+        match self {
+            Self::Handoff(v) => v.deadline(),
+            Self::Replacement(v) => v.deadline(),
+        }
+    }
+    pub(crate) fn cancellation(&self) -> CancellationToken {
+        match self {
+            Self::Handoff(v) => v.cancellation(),
+            Self::Replacement(v) => v.control.cancellation.clone(),
+        }
+    }
+    pub(crate) fn check(
+        &self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<(), StreamControlError> {
+        match self {
+            Self::Handoff(v) => v.check(plan),
+            Self::Replacement(v) => v.check(plan),
+        }
+    }
+    pub(crate) fn lock<'a>(
+        &'a self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<ManagedAudienceGuard<'a>, StreamControlError> {
+        match self {
+            Self::Handoff(v) => v.lock(plan).map(ManagedAudienceGuard::Handoff),
+            Self::Replacement(v) => v.lock(plan).map(ManagedAudienceGuard::Replacement),
+        }
+    }
+}
+impl ManagedAudienceGuard<'_> {
+    pub(crate) fn check(
+        &self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<(), StreamControlError> {
+        match self {
+            Self::Handoff(v) => v.check(plan),
+            Self::Replacement(v) => v.context.check(plan),
+        }
+    }
+    pub(crate) fn commit(&mut self) -> ManagedAudienceObservation {
+        match self {
+            Self::Handoff(v) => ManagedAudienceObservation {
+                handoff: Some(v.commit()),
+                replacement: None,
+            },
+            Self::Replacement(v) => ManagedAudienceObservation {
+                handoff: None,
+                replacement: Some(v.commit()),
+            },
+        }
+    }
+}
+/// Captured by the trusted transport/adapter handler for one authenticated
+/// endpoint event. It is not an authority assertion accepted from a wire body.
+pub enum DeviceReplacementSignalSource {
+    NativePeer(Arc<PeerAdmission>),
+    Adapter(Arc<dyn Any + Send + Sync>),
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DeviceReplacementEndpointEvent {
+    Answered,
+    /// Evaluate actual isolated decoded input and successful output; no caller readiness flag.
+    MediaObserved,
+    Dtmf {
+        digits: String,
+    },
+}
+pub struct DeviceReplacementSignalScope<'a> {
+    pub conversation: &'a ConversationId,
+    pub session: &'a SessionId,
+    pub principal: &'a AuthenticatedPrincipal,
+    pub target_principal: Option<&'a AuthenticatedPrincipal>,
+    pub pending: &'a PreparedParticipantReplacement,
+    pub event: &'a DeviceReplacementEndpointEvent,
+    pub source: &'a DeviceReplacementSignalSource,
+}
+pub struct DeviceReplacementEvent {
+    owner: Weak<Orchestrator>,
+    preparation: Weak<DeviceReplacementPreparation>,
+    source: DeviceReplacementSignalSource,
+    event: DeviceReplacementEndpointEvent,
+    principal: AuthenticatedPrincipal,
+    controller: Option<ControllerSignalStamp>,
+}
+impl DeviceReplacementEvent {
+    pub fn observe(&self) -> ControlResult<EndpointConfirmationObservation> {
+        self.observe_inner(None)
+    }
+    pub fn observe_with_held(
+        &self,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<EndpointConfirmationObservation> {
+        self.observe_inner(Some(held))
+    }
+    fn observe_inner(
+        &self,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<EndpointConfirmationObservation> {
+        let owner = self
+            .owner
+            .upgrade()
+            .ok_or(ParticipantControlError::Cancelled)?;
+        let p = self
+            .preparation
+            .upgrade()
+            .ok_or(ParticipantControlError::Cancelled)?;
+        p.check()?;
+        let mut lives = p.source_lifecycles.clone();
+        lives.push(p.candidate.clone());
+        lives.sort_by(|a, b| a.connection_id.cmp(&b.connection_id));
+        let _registry = owner
+            .connection_registry_lock
+            .lock()
+            .unwrap_or_else(|v| v.into_inner());
+        let _lives = owner.lock_connection_lifecycles(&lives)?;
+        let index = lives
+            .iter()
+            .position(|t| t.connection_id == p.intent.replacement)
+            .expect("captured candidate");
+        let current =
+            owner.device_replacement_signal_principal(&p, &self.source, &_lives[index])?;
+        if !crate::staged_streams::reliable_data::same_credential(&self.principal, &current) {
+            return Err(ParticipantControlError::Authority);
+        }
+        if let Some(stamp) = &self.controller {
+            stamp.check()?;
+        }
+        let mut state = p.state.lock().unwrap_or_else(|v| v.into_inner());
+        p.check()?;
+        let g = state.ticket.generation();
+        let scene = p
+            .runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        let signal_scope = DeviceReplacementSignalScope {
+            conversation: &p.runtime.conversation,
+            session: &p.runtime.session,
+            principal: &self.principal,
+            target_principal: self
+                .controller
+                .as_ref()
+                .map(ControllerSignalStamp::principal),
+            pending: &state.ticket,
+            event: &self.event,
+            source: &self.source,
+        };
+        let lease = scene.replacement_signal_authority(&signal_scope, held)?;
+        match &self.event {
+            DeviceReplacementEndpointEvent::Answered => {
+                Ok(state.ticket.observe_answer(&p.intent.replacement, g)?)
+            }
+            DeviceReplacementEndpointEvent::MediaObserved
+            | DeviceReplacementEndpointEvent::Dtmf { .. } => {
+                if self.controller.is_none() {
+                    return Ok(EndpointConfirmationObservation::BeforeAnswerOrMedia);
+                }
+                let Some(context) = &state.context else {
+                    return Ok(EndpointConfirmationObservation::BeforeAnswerOrMedia);
+                };
+                match scene.replacement_endpoint_ready(context) {
+                    Ok(()) => {}
+                    Err(StreamControlError::NotReady) => {
+                        return Ok(EndpointConfirmationObservation::BeforeAnswerOrMedia)
+                    }
+                    Err(v) => return Err(v.into()),
+                }
+                let current = lease.authority();
+                state
+                    .ticket
+                    .observe_media_ready(&current.member, &current.endpoint, g)?;
+                match &self.event {
+                    DeviceReplacementEndpointEvent::Dtmf { digits } => Ok(state
+                        .ticket
+                        .observe_dtmf(&p.intent.replacement, g, digits)?),
+                    _ => Ok(
+                        if matches!(
+                            p.intent.confirmation,
+                            crate::participant_transitions::EndpointConfirmationPolicy::MediaOnly
+                        ) {
+                            EndpointConfirmationObservation::NotRequired
+                        } else {
+                            EndpointConfirmationObservation::MediaReady
+                        },
+                    ),
+                }
+            }
+        }
+    }
+}
+impl Orchestrator {
+    fn device_replacement_signal_principal(
+        &self,
+        p: &DeviceReplacementPreparation,
+        source: &DeviceReplacementSignalSource,
+        current: &ConnectionLifecycleState,
+    ) -> ControlResult<AuthenticatedPrincipal> {
+        let adapter = self.adapter_for(&p.intent.replacement)?;
+        if !adapter.is_connection_live(&p.intent.replacement) {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        match source {
+            DeviceReplacementSignalSource::NativePeer(peer) => {
+                let principal = self.connection_principal(&p.intent.replacement)?;
+                peer.validate_principal(&principal).map_err(peer_error)?;
+                if !current
+                    .peer_admission
+                    .as_ref()
+                    .is_some_and(|v| v.belongs_to(peer.incarnation()))
+                    || !adapter.is_peer_native_preparation_current(&p.intent.replacement, peer)
+                {
+                    return Err(ParticipantControlError::Authority);
+                }
+                Ok(principal)
+            }
+            DeviceReplacementSignalSource::Adapter(context) => {
+                let principal = adapter
+                    .device_replacement_signal_principal(&p.intent.replacement, context.as_ref())
+                    .ok_or(ParticipantControlError::Authority)?;
+                if principal.is_expired()
+                    || principal.method == crate::identity::AuthenticationMethod::Anonymous
+                {
+                    return Err(ParticipantControlError::Authority);
+                }
+                Ok(principal)
+            }
+        }
+    }
+    pub fn capture_device_replacement_event(
+        self: &Arc<Self>,
+        p: &Arc<DeviceReplacementPreparation>,
+        source: DeviceReplacementSignalSource,
+        event: DeviceReplacementEndpointEvent,
+    ) -> ControlResult<DeviceReplacementEvent> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        let tickets = [p.candidate.clone()];
+        let _registry = self
+            .connection_registry_lock
+            .lock()
+            .unwrap_or_else(|v| v.into_inner());
+        let lives = self.lock_connection_lifecycles(&tickets)?;
+        let principal = self.device_replacement_signal_principal(p, &source, &lives[0])?;
+        let controller = self
+            .adapter_for(&p.intent.replacement)?
+            .staged_controller(&p.intent.replacement)
+            .map(|c| c.capture_signal_stamp())
+            .transpose()?;
+        Ok(DeviceReplacementEvent {
+            owner: Arc::downgrade(self),
+            preparation: Arc::downgrade(p),
+            principal,
+            controller,
+            source,
+            event,
+        })
+    }
+}
+
+/// Trusted adapter allocation request. Frozen relationship facts compare
+/// identity/epoch/endpoint only; they are neither current grants nor readiness.
+/// This request can only be created after Core reserves the bounded candidate.
+pub struct DeviceReplacementAdapterRequest {
+    conversation: ConversationId,
+    session: SessionId,
+    pending: PreparedParticipantReplacement,
+    member: Membership,
+    endpoint: EndpointBinding,
+    context: Arc<dyn Any + Send + Sync>,
+    lifetime: CancellationToken,
+}
+impl DeviceReplacementAdapterRequest {
+    pub fn conversation(&self) -> &ConversationId {
+        &self.conversation
+    }
+    pub fn session(&self) -> &SessionId {
+        &self.session
+    }
+    pub fn pending(&self) -> &PreparedParticipantReplacement {
+        &self.pending
+    }
+    pub fn frozen_member(&self) -> &Membership {
+        &self.member
+    }
+    pub fn frozen_endpoint(&self) -> &EndpointBinding {
+        &self.endpoint
+    }
+    pub fn context<T: Any + Send + Sync>(&self) -> Option<Arc<T>> {
+        self.context.clone().downcast().ok()
+    }
+    /// Independent physical lifetime. Cancelling the preparation after known
+    /// commit never cancels this route; normal adapter teardown owns it then.
+    pub fn resource_lifetime(&self) -> CancellationToken {
+        self.lifetime.clone()
+    }
+}
+/// The installed adapter derives the principal from its trusted exact route
+/// context. Neither an arbitrary caller nor a wire body can assert this proof.
+pub struct DeviceReplacementAdapterRoute {
+    pub handle: ConnectionHandle,
+    pub principal: AuthenticatedPrincipal,
+}
+impl Orchestrator {
+    /// Allocate a non-native browser/telephone candidate using its exact
+    /// never-reused Core ID. Ordinary origination cannot consume a reservation.
+    /// External signaling is a separate current-authorized, bounded action.
+    pub fn prepare_adapter_device_replacement_with_held(
+        self: &Arc<Self>,
+        p: &Arc<DeviceReplacementPreparation>,
+        context: Arc<dyn Any + Send + Sync>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<ConnectionId> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        let _flight = p
+            .flight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| ParticipantTransitionError::Conflict)?;
+        let request = scope(p, ReplacementPhase::Allocate, None);
+        let control = p
+            .runtime
+            .policy
+            .current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        let adapter = self.adapter(authority.endpoint.transport())?;
+        let capabilities = adapter.lifecycle_capabilities();
+        if matches!(
+            adapter.transport(),
+            Transport::Quic | Transport::WebTransport | Transport::WebSocket
+        ) || !adapter.supports_device_replacement_preparation()
+            || !capabilities.authoritative_liveness
+            || !capabilities.staged_outbound_activation
+        {
+            return Err(ParticipantControlError::Unsupported);
+        }
+        self.validate_connection_lifecycles(&p.source_lifecycles)?;
+        let result = {
+            let _registry = self
+                .connection_registry_lock
+                .lock()
+                .unwrap_or_else(|v| v.into_inner());
+            let mut life = p.candidate.state.lock().unwrap_or_else(|v| v.into_inner());
+            p.check()?;
+            if life.active
+                || life.retired
+                || life.replacement_reservation != Some(p.nonce)
+                || self.connections.contains_key(&p.intent.replacement)
+                || self
+                    .connection_lifecycle_tasks
+                    .draining
+                    .load(Ordering::Acquire)
+            {
+                return Err(ParticipantTransitionError::Conflict.into());
+            }
+            // Publish only internal physical ownership. The main Session and
+            // ParticipantSession continue to contain only the original route.
+            life.active = true;
+            self.connections.insert(
+                p.intent.replacement.clone(),
+                ConnectionEntry {
+                    transport: adapter.transport(),
+                    direction: Direction::Outbound,
+                    principal: None,
+                    inbound_context: None,
+                    inbound_context_retired: true,
+                    inbound_publication: InboundPublicationState::Published,
+                    inbound_admission_terminal: None,
+                    staged_inbound_data: None,
+                    normalized_lifecycle_was_visible: false,
+                    deferred_authentication: None,
+                    deferred_principal_authentication: None,
+                },
+            );
+            let allocation = DeviceReplacementAdapterRequest {
+                conversation: p.runtime.conversation.clone(),
+                session: p.runtime.session.clone(),
+                pending: p.prepared_binding(),
+                member: authority.target.clone(),
+                endpoint: authority.endpoint.clone(),
+                context,
+                lifetime: p.resource_lifetime.clone(),
+            };
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| -> ControlResult<()> {
+                let route = adapter.prepare_device_replacement_connection(&allocation)?;
+                let c = &route.handle.connection;
+                if c.id != p.intent.replacement
+                    || c.session_id != p.runtime.session
+                    || c.participant_id != p.intent.participant
+                    || c.transport != adapter.transport()
+                    || c.direction != Direction::Outbound
+                    || c.state != crate::connection::ConnectionState::Connecting
+                    || !c.streams.is_empty()
+                    || !adapter.is_connection_live(&p.intent.replacement)
+                    || route.principal.is_expired()
+                    || route.principal.method == crate::identity::AuthenticationMethod::Anonymous
+                {
+                    return Err(ParticipantControlError::Authority);
+                }
+                authority
+                    .target
+                    .revalidate_principal(&route.principal, Utc::now())
+                    .map_err(|_| ParticipantControlError::Authority)?;
+                // Revalidate under the same owned domain authority, not a
+                // second reader queued behind a writer.
+                check_authority(&request, &control.current(&request)?)?;
+                p.check()?;
+                self.connections
+                    .get_mut(&p.intent.replacement)
+                    .ok_or(ParticipantControlError::Cancelled)?
+                    .principal = Some(route.principal);
+                Ok(())
+            }))
+            .unwrap_or(Err(ParticipantControlError::Core(
+                RvoipError::InvalidState("replacement adapter panicked"),
+            )))
+        };
+        if result.is_err() {
+            p.cancel();
+        }
+        result?;
+        Ok(p.intent.replacement.clone())
+    }
+    /// Start the same dormant route. The adapter's activation is idempotent and
+    /// returns stable external identifiers. Failure/timeout leaves uncertainty;
+    /// it never allocates a second route, retries automatically or rolls back a
+    /// committed replacement. The host journals the returned external receipt.
+    pub async fn start_adapter_device_replacement_with_held(
+        self: &Arc<Self>,
+        p: &Arc<DeviceReplacementPreparation>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<crate::adapter::OutboundActivation> {
+        self.owns_replacement(p)?;
+        p.check()?;
+        let _flight = p
+            .flight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| ParticipantTransitionError::Conflict)?;
+        let request = scope(p, ReplacementPhase::Start, None);
+        let control = p
+            .runtime
+            .policy
+            .current_replacement_control(&request, held)?;
+        let authority = control.current(&request)?;
+        check_authority(&request, &authority)?;
+        let adapter = self.adapter_for(&p.intent.replacement)?;
+        if !adapter.supports_device_replacement_preparation()
+            || !adapter.lifecycle_capabilities().staged_outbound_activation
+            || adapter.transport() != authority.endpoint.transport()
+        {
+            return Err(ParticipantControlError::Unsupported);
+        }
+        let mut lives = p.source_lifecycles.clone();
+        lives.push(p.candidate.clone());
+        lives.sort_by(|a, b| a.connection_id.cmp(&b.connection_id));
+        self.validate_connection_lifecycles(&lives)?;
+        if !adapter.is_connection_live(&p.intent.replacement) {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        let deadline = p.deadline.min(control.deadline);
+        let activation = tokio::select! {
+            biased;
+            _=p.cancellation.cancelled()=>return Err(ParticipantControlError::Cancelled),
+            _=control.cancellation.cancelled()=>return Err(ParticipantControlError::Cancelled),
+            _=tokio::time::sleep_until(deadline)=>return Err(ParticipantControlError::Deadline),
+            result=adapter.activate_outbound_with_receipt(p.intent.replacement.clone())=>result?,
+        };
+        p.check()?;
+        check_authority(&request, &control.current(&request)?)?;
+        self.validate_connection_lifecycles(&lives)?;
+        if !adapter.is_connection_live(&p.intent.replacement) {
+            return Err(ParticipantControlError::Cancelled);
+        }
+        Ok(activation)
+    }
+}
