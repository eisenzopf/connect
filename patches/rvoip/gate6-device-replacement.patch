+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_managed_replacement_no_answer_voicemail_and_cancel_keep_original_device() {
+    for mode in ["no-answer", "voicemail", "cancel"] {
+        let s = Scene::new_replacement("quic").await;
+        let c = Candidate::new(
+            &s,
+            "quic",
+            EndpointConfirmationPolicy::AnsweredDtmf {
+                digits: "5#".into(),
+            },
+        )
+        .await;
+        let revision = c.pending.intent().expected_revision;
+        // An actual old physical peer cannot supply a new-device observation.
+        assert!(s
+            .core
+            .orch
+            .capture_device_replacement_event(
+                &c.pending,
+                DeviceReplacementSignalSource::NativePeer(s.live[0].peer.clone()),
+                DeviceReplacementEndpointEvent::Answered
+            )
+            .is_err());
+        c.io().await;
+        if mode == "voicemail" {
+            assert_eq!(
+                c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+                Observation::Answered
+            );
+        }
+        assert_eq!(
+            c.event(&s, DeviceReplacementEndpointEvent::MediaObserved)
+                .await,
+            Observation::MediaReady
+        );
+        assert!(s
+            .core
+            .orch
+            .plan_staged_device_replacement(&c.pending)
+            .is_err());
+        assert_eq!(
+            s.core.orch.participant_revision(&s.core.session).unwrap(),
+            revision
+        );
+        let old_signal = c.capture(&s, DeviceReplacementEndpointEvent::Answered);
+        assert!(c.pending.cancel());
+        let g = grant(
+            &s,
+            c.pending.intent(),
+            &c.principal,
+            Approval::Signal(DeviceReplacementEndpointEvent::Answered),
+        )
+        .await;
+        assert!(old_signal.observe_with_held(&g).is_err());
+        drop(g);
+        core_fixture::until(|| c.live.peer.snapshot().connections == 0).await;
+        assert_eq!(
+            s.core.orch.participant_capacity(&s.core.session).unwrap(),
+            (4, 0)
+        );
+        assert_eq!(
+            s.core.orch.participant_revision(&s.core.session).unwrap(),
+            revision
+        );
+        s.tone(0, 1).await;
+        s.tone(1, 0).await;
+        s.tone(2, 3).await;
+        c.stop().await;
+        s.stop().await;
+    }
+}
