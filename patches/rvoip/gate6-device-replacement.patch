+//! Same-participant audio binding swap. Preparation and actual duplex IO are
+//! separate from current operator permission and the managed logical commit.
+use super::{
+    audience::*, audio_consumer::AudioDuplexStamp, audio_subscriptions::*,
+    media_scene::GuardedMediaScene, *,
+};
+use crate::participant_transitions::PreparedParticipantReplacement;
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioDeviceReplacementRequest {
+    pub operation_id: String,
+    pub expected_revision: u64,
+    pub source: ConnectionId,
+    pub admitted: ConnectionId,
+    pub retained: ConnectionId,
+}
+pub(super) struct ReplacementIntent {
+    pub(super) request: AudioDeviceReplacementRequest,
+    pub(super) preparation: Arc<ClosedAudience>,
+    pub(super) programs: BTreeMap<ConnectionId, SavedAudioProgram>,
+    origins: BTreeMap<ConnectionId, AudienceOrigin>,
+    readiness: AudioDuplexStamp,
+    pub(super) old_speaks: bool,
+    old_role: super::audio_consumer::ConsumerStamp,
+    pub(super) old_logical: StreamId,
+    pub(super) new_logical: StreamId,
+    pub(super) old_gate: LogicalStream,
+    pending: PreparedParticipantReplacement,
+}
+impl ReplacementIntent {
+    pub(super) fn validate_target(
+        &self,
+        controller: &StreamController,
+        state: &State,
+    ) -> ControlResult<()> {
+        if self
+            .origins
+            .get(&controller.connection)
+            .is_some_and(|o| !o.matches(controller))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        if !self.old_role.is_current() {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        if !self.pending.confirmation_ready() {
+            return Err(StreamControlError::NotReady);
+        }
+        if controller.connection == self.request.admitted {
+            self.readiness.current(controller, state)?;
+        }
+        Ok(())
+    }
+}
+#[derive(Clone)]
+pub struct AudioDeviceReplacementPlan {
+    audience: AudioAudiencePlan,
+}
+impl AudioDeviceReplacementPlan {
+    pub fn audience(&self) -> &AudioAudiencePlan {
+        &self.audience
+    }
+    pub fn request(&self) -> &AudioDeviceReplacementRequest {
+        &self
+            .audience
+            .replacement
+            .as_ref()
+            .expect("sealed replacement")
+            .request
+    }
+    pub fn old_may_speak(&self) -> bool {
+        self.audience
+            .replacement
+            .as_ref()
+            .expect("sealed replacement")
+            .old_speaks
+    }
+    pub fn pending(&self) -> &PreparedParticipantReplacement {
+        &self
+            .audience
+            .replacement
+            .as_ref()
+            .expect("sealed replacement")
+            .pending
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReplacementCleanupOutcome {
+    Pending,
+    LocalMediaClosed,
+    Unconfirmed,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AudioDeviceReplacementOutcome {
+    pub media: AudioAudienceOutcome,
+    pub replaced: ConnectionId,
+    pub admitted: ConnectionId,
+    pub retained: ConnectionId,
+    pub old_stream: MediaStreamRef,
+    pub new_stream: MediaStreamRef,
+    pub cleanup: ReplacementCleanupOutcome,
+}
+#[derive(Clone)]
+pub struct AudioDeviceReplacementHandle {
+    audience: AudioAudienceHandle,
+    source: AudienceOrigin,
+}
+impl AudioDeviceReplacementHandle {
+    pub fn audience(&self) -> &AudioAudienceHandle {
+        &self.audience
+    }
+    pub async fn finish_local_media_cleanup(
+        &self,
+        deadline: tokio::time::Instant,
+    ) -> ReplacementCleanupOutcome {
+        let Some(controller) = self.source.controller.upgrade() else {
+            return ReplacementCleanupOutcome::Unconfirmed;
+        };
+        if !self.source.matches(&controller) {
+            return ReplacementCleanupOutcome::Unconfirmed;
+        }
+        let fenced = {
+            let s = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+            s.closed && controller.shutdown.is_cancelled()
+        };
+        if fenced && controller.shutdown(deadline).await == 0 {
+            ReplacementCleanupOutcome::LocalMediaClosed
+        } else {
+            ReplacementCleanupOutcome::Unconfirmed
+        }
+    }
+}
+impl GuardedMediaScene {
+    pub(crate) fn replacement_endpoint_ready(
+        &self,
+        context: &AudioAudienceHandle,
+    ) -> ControlResult<()> {
+        if context.scene != self.id || context.group.origins.len() != 1 {
+            return Err(StreamControlError::Authority);
+        }
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+        if !registry
+            .groups
+            .get(&context.group.operation)
+            .is_some_and(|g| Arc::ptr_eq(g, &context.group))
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let origin = &context.group.origins[0];
+        let member = members
+            .get(&origin.connection)
+            .ok_or(StreamControlError::NotReady)?;
+        if !origin.matches(&member.controller) {
+            return Err(StreamControlError::Authority);
+        }
+        let state = member
+            .controller
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        member
+            .audio_consumer
+            .duplex_since(&member.controller, context.committed_at, &state)?;
+        Ok(())
+    }
+    pub(crate) fn plan_audio_device_replacement(
+        &self,
+        context: &AudioAudienceHandle,
+        pending: &PreparedParticipantReplacement,
+        request: AudioDeviceReplacementRequest,
+    ) -> ControlResult<AudioDeviceReplacementPlan> {
+        if context.scene != self.id
+            || request.source == request.admitted
+            || request.source == request.retained
+            || request.admitted == request.retained
+            || !pending.confirmation_ready()
+            || pending.intent().operation_id != request.operation_id
+            || pending.intent().source != request.source
+            || pending.intent().replacement != request.admitted
+            || pending.intent().retained != request.retained
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let registry = self.audiences.lock().unwrap_or_else(|p| p.into_inner());
+        if registry.revision != request.expected_revision
+            || registry.revision == u64::MAX
+            || registry.groups.contains_key(&request.operation_id)
+            || !registry
+                .groups
+                .get(&context.group.operation)
+                .is_some_and(|g| Arc::ptr_eq(g, &context.group))
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let old = &members
+            .get(&request.source)
+            .ok_or(StreamControlError::NotReady)?
+            .controller;
+        let new = &members
+            .get(&request.admitted)
+            .ok_or(StreamControlError::NotReady)?
+            .controller;
+        let remote = &members
+            .get(&request.retained)
+            .ok_or(StreamControlError::NotReady)?
+            .controller;
+        if context.group.origins.len() != 1
+            || !context.group.contains(new)
+            || old.origin_member.participant() != new.origin_member.participant()
+            || old.origin_member.participant() == remote.origin_member.participant()
+            || !old
+                .origin_binding
+                .same_incarnation(pending.source_binding())
+            || !new.origin_binding.same_incarnation(pending.binding())
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let old_logical = members[&request.source]
+            .current_logical()
+            .ok_or(StreamControlError::NotReady)?;
+        let new_logical = members[&request.admitted]
+            .current_logical()
+            .ok_or(StreamControlError::NotReady)?;
+        let old_gate = {
+            let state = old
+                .state
+                .try_lock()
+                .map_err(|_| MediaTransitionError::Conflict)?;
+            state
+                .model
+                .streams()
+                .get(&old_logical)
+                .filter(|s| s.state != LogicalStreamState::Ended)
+                .ok_or(StreamControlError::NotReady)?
+                .clone()
+        };
+        let readiness = {
+            let state = new
+                .state
+                .try_lock()
+                .map_err(|_| MediaTransitionError::Conflict)?;
+            members[&request.admitted].audio_consumer.duplex_since(
+                new,
+                context.committed_at,
+                &state,
+            )?
+        };
+        let replaced_audience = registry.groups.values().find(|g| g.contains(old)).cloned();
+        let origins = replaced_audience.as_ref().map_or_else(Vec::new, |g| {
+            g.origins
+                .iter()
+                .map(|o| {
+                    if o.matches(old) {
+                        AudienceOrigin::new(new)
+                    } else {
+                        o.clone()
+                    }
+                })
+                .collect()
+        });
+        let group = Arc::new(ClosedAudience {
+            operation: request.operation_id.clone(),
+            origins,
+        });
+        let original = members[&request.source]
+            .audio_consumer
+            .subscriptions
+            .saved_program();
+        let mut programs = BTreeMap::new();
+        for (id, member) in members.iter() {
+            let program = if id == &request.source {
+                SavedAudioProgram::default()
+            } else {
+                let saved = if id == &request.admitted {
+                    original.clone()
+                } else {
+                    member.audio_consumer.subscriptions.saved_program()
+                };
+                saved.replacing_connection(old, new, &old_logical, &new_logical)?
+            };
+            programs.insert(id.clone(), program);
+        }
+        let origins = [old, new, remote]
+            .into_iter()
+            .map(|c| (c.connection.clone(), AudienceOrigin::new(c)))
+            .collect();
+        let expected = members
+            .iter()
+            .map(|(id, m)| (id.clone(), m.controller.revision()))
+            .collect();
+        let controllers = members
+            .iter()
+            .map(|(id, m)| (id.clone(), Arc::downgrade(&m.controller)))
+            .collect();
+        let audience_request = AudioAudienceRequest {
+            operation_id: request.operation_id.clone(),
+            expected_revision: request.expected_revision,
+            private_connections: group.origins.iter().map(|o| o.connection.clone()).collect(),
+            receivers: programs.keys().map(|id| (id.clone(), vec![])).collect(),
+            activate_muted: None,
+        };
+        let (old_speaks, old_role) = members[&request.source].audio_consumer.role_snapshot();
+        let replacement = Arc::new(ReplacementIntent {
+            request,
+            preparation: context.group.clone(),
+            programs,
+            origins,
+            readiness,
+            old_speaks,
+            old_role,
+            old_logical,
+            new_logical,
+            old_gate,
+            pending: pending.clone(),
+        });
+        Ok(AudioDeviceReplacementPlan {
+            audience: AudioAudiencePlan {
+                scene: self.id,
+                request: audience_request,
+                group,
+                expected,
+                controllers,
+                restore: None,
+                replaced_preparation: None,
+                replaced_audience,
+                handoff: None,
+                replacement: Some(replacement),
+            },
+        })
+    }
+    /// Engine-local primitive. The production entry point must pair this with
+    /// one managed ParticipantSession replacement publication fence.
+    pub(crate) async fn commit_audio_device_replacement(
+        &self,
+        plan: AudioDeviceReplacementPlan,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<(AudioDeviceReplacementOutcome, AudioDeviceReplacementHandle)> {
+        self.commit_audio_device_replacement_managed(plan, deadline, cancel, held, None)
+            .await
+    }
+    pub(crate) async fn commit_audio_device_replacement_managed(
+        &self,
+        plan: AudioDeviceReplacementPlan,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+        managed: Option<
+            crate::orchestrator::participant_control::replacement::ManagedReplacementContext,
+        >,
+    ) -> ControlResult<(AudioDeviceReplacementOutcome, AudioDeviceReplacementHandle)> {
+        let intent = plan
+            .audience
+            .replacement
+            .clone()
+            .ok_or(StreamControlError::Authority)?;
+        let (media, audience) = self
+            .apply_audio_audience_managed(
+                plan.audience,
+                deadline,
+                cancel,
+                held,
+                managed.map(
+                    crate::orchestrator::participant_control::ManagedAudienceContext::Replacement,
+                ),
+            )
+            .await?;
+        self.remove(&intent.request.source);
+        Ok((
+            AudioDeviceReplacementOutcome {
+                media,
+                replaced: intent.request.source.clone(),
+                admitted: intent.request.admitted.clone(),
+                retained: intent.request.retained.clone(),
+                old_stream: MediaStreamRef {
+                    connection: intent.request.source.clone(),
+                    logical: intent.old_logical.clone(),
+                },
+                new_stream: MediaStreamRef {
+                    connection: intent.request.admitted.clone(),
+                    logical: intent.new_logical.clone(),
+                },
+                cleanup: ReplacementCleanupOutcome::Pending,
+            },
+            AudioDeviceReplacementHandle {
+                audience,
+                source: intent.origins[&intent.request.source].clone(),
+            },
+        ))
+    }
+}
