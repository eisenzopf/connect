+impl GuardedMediaScene {
+    pub(crate) fn replacement_signal_authority(
+        &self,
+        scope: &crate::orchestrator::participant_control::DeviceReplacementSignalScope<'_>,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if scope.conversation != &self.conversation || scope.session != &self.session {
+            return Err(StreamControlError::Authority);
+        }
+        let lease = self.policy.current_device_replacement_signal(scope, held)?;
+        let current = lease.authority();
+        current
+            .actor
+            .revalidate_principal(scope.principal, chrono::Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        current
+            .connection
+            .require_current(&current.member, &current.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        current
+            .endpoint
+            .usable_by(&current.member)
+            .map_err(|_| StreamControlError::Authority)?;
+        if !current.may_control
+            || current.member.conversation() != scope.conversation
+            || current.presence.session() != scope.session
+            || current.member.participant() != &scope.pending.intent().participant
+            || !current.connection.same_incarnation(scope.pending.binding())
+            || current.endpoint.endpoint() != &scope.pending.intent().endpoint
+            || current.endpoint.device() != &scope.pending.intent().device
+        {
+            return Err(StreamControlError::Authority);
+        }
+        if let Some(principal) = scope.target_principal {
+            current
+                .member
+                .revalidate_principal(principal, chrono::Utc::now())
+                .map_err(|_| StreamControlError::Authority)?;
+        }
+        if matches!(
+            scope.event,
+            crate::orchestrator::participant_control::DeviceReplacementEndpointEvent::Dtmf { .. } | crate::orchestrator::participant_control::DeviceReplacementEndpointEvent::MediaObserved
+        ) && (!current.send_media.contains(&Medium::Audio)
+            || !current.receive_media.contains(&Medium::Audio))
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(lease)
+    }
+}
