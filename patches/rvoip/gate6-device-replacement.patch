+//! Controlled browser/telephone adapter SPI. Actual encoded guarded IO with
+//! native TLS on the retained call; no browser/PSTN/provider-network claim.
+use super::*;
+use rvoip_core::{
+    adapter::*,
+    capability::*,
+    connection::*,
+    error::Result as CoreResult,
+    message::Message,
+    stream::{MediaFrame, MediaStream, StreamKind},
+};
+use std::sync::atomic::AtomicUsize;
+struct RouteContext {
+    principal: AuthenticatedPrincipal,
+}
+struct Cleanup;
+#[async_trait]
+impl MediaPortCleanup for Cleanup {
+    async fn close(&self) -> MediaResult<()> {
+        Ok(())
+    }
+}
+struct Adapter {
+    kind: Transport,
+    context: Arc<RouteContext>,
+    id: Mutex<Option<ConnectionId>>,
+    lifetime: Mutex<CancellationToken>,
+    live: AtomicBool,
+    activated: AtomicBool,
+    lose_receipt: AtomicBool,
+    supported: AtomicBool,
+    starts: AtomicUsize,
+    controller: Mutex<Option<Arc<StreamController>>>,
+    port: Mutex<Option<AdapterMediaPort>>,
+    events: mpsc::Sender<AdapterEvent>,
+    receiver: Mutex<Option<mpsc::Receiver<AdapterEvent>>>,
+}
+impl Adapter {
+    fn new(kind: Transport) -> Arc<Self> {
+        let (events, receiver) = mpsc::channel(16);
+        Arc::new(Self {
+            kind,
+            context: Arc::new(RouteContext {
+                principal: named_actor("alice"),
+            }),
+            id: Default::default(),
+            lifetime: Mutex::new(CancellationToken::new()),
+            live: AtomicBool::new(false),
+            activated: AtomicBool::new(false),
+            lose_receipt: AtomicBool::new(true),
+            supported: AtomicBool::new(false),
+            starts: AtomicUsize::new(0),
+            controller: Default::default(),
+            port: Default::default(),
+            events,
+            receiver: Mutex::new(Some(receiver)),
+        })
+    }
+    fn port(&self) -> AdapterMediaPort {
+        self.port.lock().unwrap().as_ref().unwrap().clone()
+    }
+    fn frame(&self) -> MediaFrame {
+        MediaFrame {
+            stream_id: self.port().binding().transport_id.clone(),
+            kind: StreamKind::Audio,
+            payload: tone(),
+            timestamp_rtp: 160,
+            source_clock: None,
+            captured_at: Utc::now(),
+            payload_type: Some(0),
+        }
+    }
+    fn current(&self, id: &ConnectionId) -> bool {
+        self.id.lock().unwrap().as_ref() == Some(id)
+            && self.live.load(Ordering::Acquire)
+            && !self.lifetime.lock().unwrap().is_cancelled()
+    }
+}
+#[async_trait]
+impl StagedMediaAdapter for Adapter {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        _: Instant,
+        _: CancellationToken,
+    ) -> MediaResult<()> {
+        for p in ports {
+            if p.port.binding().negotiated.requested.medium != Medium::Audio {
+                return Err(StreamControlError::Unsupported);
+            }
+            if p.is_new {
+                p.port.install_cleanup(Arc::new(Cleanup))?;
+                p.port
+                    .observe_ready(&p.port.binding().negotiated.format, true, true, Some(0))?;
+            }
+            *self.port.lock().unwrap() = Some(p.port);
+        }
+        Ok(())
+    }
+}
+#[async_trait]
+impl ConnectionAdapter for Adapter {
+    fn transport(&self) -> Transport {
+        self.kind
+    }
+    fn kind(&self) -> AdapterKind {
+        AdapterKind::Interop
+    }
+    fn lifecycle_capabilities(&self) -> AdapterLifecycleCapabilities {
+        AdapterLifecycleCapabilities {
+            authoritative_liveness: true,
+            staged_outbound_activation: true,
+            ..Default::default()
+        }
+    }
+    fn supports_device_replacement_preparation(&self) -> bool {
+        self.supported.load(Ordering::Acquire)
+    }
+    fn prepare_device_replacement_connection(
+        &self,
+        r: &DeviceReplacementAdapterRequest,
+    ) -> CoreResult<DeviceReplacementAdapterRoute> {
+        let context = r
+            .context::<RouteContext>()
+            .ok_or(rvoip_core::RvoipError::InvalidState(
+                "foreign adapter context",
+            ))?;
+        if !Arc::ptr_eq(&context, &self.context)
+            || self.id.lock().unwrap().is_some()
+            || r.frozen_endpoint().transport() != self.kind
+        {
+            return Err(rvoip_core::RvoipError::InvalidState("foreign allocation"));
+        }
+        let id = r.pending().intent().replacement.clone();
+        *self.id.lock().unwrap() = Some(id.clone());
+        *self.lifetime.lock().unwrap() = r.resource_lifetime();
+        self.live.store(true, Ordering::Release);
+        Ok(DeviceReplacementAdapterRoute {
+            principal: context.principal.clone(),
+            handle: ConnectionHandle::new(Connection {
+                id,
+                session_id: r.session().clone(),
+                participant_id: r.frozen_member().participant().clone(),
+                transport: self.kind,
+                direction: Direction::Outbound,
+                state: ConnectionState::Connecting,
+                capabilities: CapabilityDescriptor::default(),
+                negotiated_codecs: NegotiatedCodecs::default(),
+                streams: vec![],
+                messaging_enabled: false,
+                transport_handle: TransportHandle(context),
+                opened_at: Utc::now(),
+                closed_at: None,
+            }),
+        })
+    }
+    fn device_replacement_signal_principal(
+        &self,
+        id: &ConnectionId,
+        context: &(dyn Any + Send + Sync),
+    ) -> Option<AuthenticatedPrincipal> {
+        let context = context.downcast_ref::<RouteContext>()?;
+        if !self.current(id) || !std::ptr::eq(context, self.context.as_ref()) {
+            return None;
+        }
+        Some(context.principal.clone())
+    }
+    fn is_connection_live(&self, id: &ConnectionId) -> bool {
+        self.current(id)
+    }
+    fn staged_controller(&self, id: &ConnectionId) -> Option<Arc<StreamController>> {
+        self.current(id)
+            .then(|| self.controller.lock().unwrap().clone())
+            .flatten()
+    }
+    async fn originate(&self, _: OriginateRequest) -> CoreResult<ConnectionHandle> {
+        Err(rvoip_core::RvoipError::NotImplemented(
+            "ordinary originate cannot consume reservation",
+        ))
+    }
+    async fn activate_outbound_with_receipt(
+        &self,
+        id: ConnectionId,
+    ) -> CoreResult<OutboundActivation> {
+        if !self.current(&id) {
+            return Err(rvoip_core::RvoipError::InvalidState("closed preparation"));
+        }
+        if !self.activated.swap(true, Ordering::AcqRel) {
+            self.starts.fetch_add(1, Ordering::AcqRel);
+        }
+        if self.lose_receipt.swap(false, Ordering::AcqRel) {
+            return Err(rvoip_core::RvoipError::InvalidState(
+                "controlled activation acknowledgment lost",
+            ));
+        }
+        Ok(OutboundActivation::with_external_reference(
+            ExternalConnectionReference::new("controlled_call", "same-call").unwrap(),
+        ))
+    }
+    async fn accept(&self, _: ConnectionId) -> CoreResult<()> {
+        Ok(())
+    }
+    async fn reject(&self, id: ConnectionId, _: RejectReason) -> CoreResult<()> {
+        self.end(id, EndReason::Normal).await
+    }
+    async fn end(&self, id: ConnectionId, _: EndReason) -> CoreResult<()> {
+        if self.id.lock().unwrap().as_ref() == Some(&id) {
+            self.live.store(false, Ordering::Release);
+            self.lifetime.lock().unwrap().cancel();
+        }
+        Ok(())
+    }
+    async fn hold(&self, _: ConnectionId) -> CoreResult<()> {
+        Ok(())
+    }
+    async fn resume(&self, _: ConnectionId) -> CoreResult<()> {
+        Ok(())
+    }
+    async fn transfer(&self, _: ConnectionId, _: TransferTarget) -> CoreResult<()> {
+        Err(rvoip_core::RvoipError::NotImplemented("fixture transfer"))
+    }
+    async fn streams(&self, _: ConnectionId) -> CoreResult<Vec<Arc<dyn MediaStream>>> {
+        Ok(vec![])
+    }
+    async fn send_message(&self, _: ConnectionId, _: Message) -> CoreResult<()> {
+        Err(rvoip_core::RvoipError::NotImplemented("fixture messages"))
+    }
+    async fn send_dtmf(&self, _: ConnectionId, _: &str, _: u32) -> CoreResult<()> {
+        Err(rvoip_core::RvoipError::NotImplemented(
+            "fixture outbound DTMF",
+        ))
+    }
+    async fn renegotiate_media(
+        &self,
+        _: ConnectionId,
+        _: CapabilityDescriptor,
+    ) -> CoreResult<NegotiatedCodecs> {
+        Ok(NegotiatedCodecs::default())
+    }
+    fn subscribe_events(&self) -> mpsc::Receiver<AdapterEvent> {
+        let _ = &self.events;
+        self.receiver.lock().unwrap().take().unwrap()
+    }
+    fn capabilities(&self) -> CapabilityDescriptor {
+        CapabilityDescriptor::default()
+    }
+    async fn verify_request_signature(
+        &self,
+        _: ConnectionId,
+        _: SignatureHeaders,
+    ) -> CoreResult<IdentityAssurance> {
+        Err(rvoip_core::RvoipError::NotImplemented(
+            "fixture request signature",
+        ))
+    }
+}
+struct Candidate {
