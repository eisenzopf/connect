+//! Explicit current-authorized host-generated audio, without a forged remote
+//! source or implicit routing permission. Queued payloads carry no live grant.
+use super::*;
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum LocalAudioPurpose {
+    EndpointPreparation { operation_id: String },
+}
+impl LocalAudioPurpose {
+    fn validate(&self) -> ControlResult<()> {
+        let Self::EndpointPreparation { operation_id } = self;
+        if operation_id.is_empty()
+            || operation_id.len() > 128
+            || !operation_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"-._~:".contains(&b))
+        {
+            return Err(MediaTransitionError::Invalid.into());
+        }
+        Ok(())
+    }
+}
+#[derive(Clone)]
+pub(super) struct LocalAudioStamp {
+    purpose: LocalAudioPurpose,
+    credential: CredentialSnapshot,
+}
+impl StreamController {
+    fn admit_local_audio(
+        &self,
+        port: &Arc<Port>,
+        ticket: &PeerRouteTicket,
+        purpose: &LocalAudioPurpose,
+        consumer: audio_consumer::ConsumerCheck<'_>,
+        scene: scene_consumer::SceneCheck<'_>,
+    ) -> ControlResult<(
+        Box<dyn MediaAuthorityLease>,
+        audio_consumer::MediaAdmission,
+        tokio::time::Instant,
+    )> {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let logical = &port.binding.negotiated.requested.logical_id;
+        if self.shutdown.is_cancelled()
+            || state.closed
+            || !state
+                .active
+                .get(logical)
+                .is_some_and(|p| Arc::ptr_eq(p, port))
+            || port.binding.negotiated.requested.medium != Medium::Audio
+            || state
+                .model
+                .streams()
+                .get(logical)
+                .is_none_or(|s| !s.permits(true))
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let credential = self.credential_snapshot();
+        let scope = self.scope(&credential.principal, MediaPurpose::Control);
+        let lease = self.policy.current_local_audio(&scope, purpose)?;
+        let owner = lease.authority();
+        Self::check(&scope, owner)?;
+        state.model.authorize_binding(&owner.current())?;
+        if !owner.may_control
+            || !owner.may_route_source
+            || !owner.send_media.contains(&Medium::Audio)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let guard = ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)?;
+        let (scene_stamp, scene_guard) = self.scene_admission(scene)?;
+        let mut admission = self.consumer_admission(port, true, consumer, guard)?;
+        admission.scene = scene_stamp;
+        admission._scene = scene_guard;
+        Ok((
+            lease,
+            admission,
+            Self::command_deadline(
+                &credential.principal,
+                tokio::time::Instant::now() + Duration::from_millis(200),
+            ),
+        ))
+    }
+    /// The host encodes an authorized local prompt using this exact negotiated
+    /// binding. No call media is borrowed, and enqueuing is not output readiness.
+    /// The installed policy must independently authorize this exact purpose at
+    /// enqueue AND actual send; the default is Unsupported.
+    pub fn try_queue_local_audio(
+        &self,
+        logical: &StreamId,
+        frame: MediaFrame,
+        purpose: LocalAudioPurpose,
+    ) -> ControlResult<()> {
+        purpose.validate()?;
+        let port = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            state
+                .active
+                .get(logical)
+                .cloned()
+                .ok_or(StreamControlError::NotReady)?
+        };
+        port.validate(&frame)?;
+        let ticket = port.ticket();
+        let credential = self.credential_snapshot();
+        let (_lease, admission, deadline) = self.admit_local_audio(
+            &port,
+            &ticket,
+            &purpose,
+            audio_consumer::ConsumerCheck::Current,
+            scene_consumer::SceneCheck::publish(),
+        )?;
+        self.check_credential_snapshot(&credential)?;
+        if tokio::time::Instant::now() >= deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        let consumer = self
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .ok_or(StreamControlError::NotReady)?;
+        let subscription = consumer.subscriptions.stamp();
+        subscription.require_target(self)?;
+        let _subscription_guard = subscription.begin_local(self)?;
+        port.egress
+            .try_send(QueuedMedia {
+                frame,
+                data: None,
+                local: Some(LocalAudioStamp {
+                    purpose,
+                    credential,
+                }),
+                sources: vec![],
+                target: port.clone(),
+                target_ticket: ticket,
+                target_consumer: admission.consumer.clone(),
+                target_scene: admission.scene.clone(),
+                subscription: Some(subscription),
+                direct: None,
+                admitted_at: Instant::now(),
+            })
+            .map_err(|e| match e {
+                mpsc::error::TrySendError::Full(_) => StreamControlError::Backpressure,
+                mpsc::error::TrySendError::Closed(_) => StreamControlError::NotReady,
+            })
+    }
+}
+impl QueuedMedia {
+    pub(super) async fn deliver_local_audio<F, Fut>(self, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(MediaFrame, Option<MediaDeliveryOrigin>) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        let local = self.local.as_ref().ok_or(StreamControlError::Authority)?;
+        if self.data.is_some() || !self.sources.is_empty() || self.frame.kind != StreamKind::Audio {
+            return Err(StreamControlError::Authority);
+        }
+        if self.admitted_at.elapsed() > Duration::from_millis(200) {
+            return Err(StreamControlError::Deadline);
+        }
+        let target = self
+            .target
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        target.check_credential_snapshot(&local.credential)?;
+        let subscription = self
+            .subscription
+            .as_ref()
+            .ok_or(StreamControlError::Authority)?;
+        let _subscription = subscription.begin_local(&target)?;
+        let (_lease, admission, deadline) = target.admit_local_audio(
+            &self.target,
+            &self.target_ticket,
+            &local.purpose,
+            audio_consumer::ConsumerCheck::Retained(self.target_consumer.as_ref()),
+            scene_consumer::SceneCheck::retained_publish(self.target_scene.as_ref()),
+        )?;
+        let mut tokens = vec![target.shutdown.clone(), subscription.cancel.clone()];
+        if let Some(s) = &admission.consumer {
+            tokens.push(s.cancellation.clone());
+        }
+        if let Some(s) = &admission.scene {
+            tokens.push(s.cancel.clone());
+        }
+        let result = tokio::select! {biased;
+            _=audio_consumer::any_cancelled(tokens.clone())=>Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,send(self.frame,None))=>result.map_err(|_|StreamControlError::Deadline)?,
+        };
+        if result.is_ok()
+            && !tokens.iter().any(CancellationToken::is_cancelled)
+            && tokio::time::Instant::now() < deadline
+        {
+            if let Some(stamp) = &admission.consumer {
+                if let Some(consumer) = target
+                    .audio_consumer
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .as_ref()
+                    .and_then(Weak::upgrade)
+                {
+                    consumer.observed_delivery(
+                        &self.target,
+                        &self.target_ticket,
+                        stamp,
+                        subscription,
+                        self.admitted_at,
+                    );
+                }
+            }
+        }
+        result
+    }
+}
