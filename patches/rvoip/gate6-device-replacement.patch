+pub(crate) struct ManagedReplacementContext {
+    owner: Arc<Orchestrator>,
+    runtime: Arc<ManagedParticipantSession>,
+    plan: ManagedAudioDeviceReplacementPlan,
+    control: ParticipantReplacementControl,
+    conversation: Arc<RwLock<Conversation>>,
+    session: Arc<RwLock<Session>>,
+    lifecycles: Vec<ConnectionLifecycleTicket>,
+}
+impl ManagedReplacementContext {
+    fn deadline(&self) -> tokio::time::Instant {
+        deadline_for(
+            &self.plan.preparation.principal,
+            self.control.deadline.min(self.plan.preparation.deadline),
+        )
+    }
+    fn check(&self, plan: &AudioAudiencePlan) -> std::result::Result<(), StreamControlError> {
+        let p = &self.plan.preparation;
+        p.check().map_err(handoff::media_error)?;
+        if !self.plan.media.audience().same_intent(plan) {
+            return Err(StreamControlError::Authority);
+        }
+        let request = scope(p, ReplacementPhase::Commit, Some(&self.plan.media));
+        let authority = self
+            .control
+            .current(&request)
+            .map_err(handoff::media_error)?;
+        check_authority(&request, &authority).map_err(handoff::media_error)?;
+        if self.plan.media.old_may_speak() && !authority.may_send_audio {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(())
+    }
+    fn lock<'a>(
+        &'a self,
+        plan: &AudioAudiencePlan,
+    ) -> std::result::Result<ManagedReplacementGuard<'a>, StreamControlError> {
+        let mixer = self
+            .runtime
+            .mixer
+            .members
+            .try_lock()
+            .map_err(|_| crate::stream_lifecycle::MediaTransitionError::Conflict)?;
+        let state = self.runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+        let registry = self
+            .owner
+            .connection_registry_lock
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let lifecycles = self
+            .owner
+            .lock_connection_lifecycles(&self.lifecycles)
+            .map_err(|e| handoff::media_error(e.into()))?;
+        if lifecycles.iter().any(|s| {
+            s.peer_admission
+                .as_ref()
+                .is_some_and(|p| p.peer.is_closed())
+        }) {
+            return Err(StreamControlError::Cancelled);
+        }
+        let conversation = self.conversation.write().unwrap_or_else(|p| p.into_inner());
+        let session = self.session.write().unwrap_or_else(|p| p.into_inner());
+        let p = &self.plan.preparation;
+        let pending = p.state.lock().unwrap_or_else(|v| v.into_inner());
+        self.check(plan)?;
+        if state.ended
+            || state.controller.revision() != p.intent.expected_revision
+            || conversation.state != ConversationState::Open
+            || matches!(
+                session.state,
+                SessionState::Ending | SessionState::Ended | SessionState::Failed
+            )
+            || p.phase.load(Ordering::Acquire) != ATTACHED
+            || !state
+                .pending
+                .get(&p.intent.replacement)
+                .is_some_and(|v| v.replacement_nonce == Some(p.nonce))
+            || pending.context.is_none()
+            || pending.slot.is_none()
+            || !pending
+                .ticket
+                .binding()
+                .same_incarnation(self.plan.media.pending().binding())
+        {
+            return Err(crate::stream_lifecycle::MediaTransitionError::Conflict.into());
+        }
+        for id in [&p.intent.source, &p.intent.retained, &p.intent.replacement] {
+            if !self
+                .owner
+                .adapter_for(id)
+                .is_ok_and(|a| a.is_connection_live(id))
+            {
+                return Err(StreamControlError::NotReady);
+            }
+            let ticket = if id == &p.intent.replacement {
+                if session.connections.contains_key(id)
+                    || self.owner.sessions_by_connection.contains_key(id)
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                &p.candidate
+            } else {
+                if !session.connections.contains_key(id) {
+                    return Err(StreamControlError::NotReady);
+                }
+                &state
+                    .routes
+                    .get(id)
+                    .ok_or(StreamControlError::NotReady)?
+                    .lifecycle
+            };
+            if !self.lifecycles.iter().any(|v| {
+                v.connection_id == *id
+                    && v.generation == ticket.generation
+                    && Arc::ptr_eq(&v.state, &ticket.state)
+            }) {
+                return Err(StreamControlError::NotReady);
+            }
+        }
+        let request = scope(p, ReplacementPhase::Commit, Some(&self.plan.media));
+        let a = self
+            .control
+            .current(&request)
+            .map_err(handoff::media_error)?;
+        check_authority(&request, &a).map_err(handoff::media_error)?;
+        let prepared = state
+            .controller
+            .stage_replacement(
+                &a.actor,
+                &a.target,
+                p.intent.clone(),
+                &pending.ticket,
+                &a.endpoint,
+            )
+            .map_err(|e| handoff::media_error(e.into()))?;
+        Ok(ManagedReplacementGuard {
+            context: self,
+            _mixer: mixer,
+            state,
+            _registry: registry,
+            lifecycles,
+            conversation,
+            session,
+            pending,
+            prepared: Some(prepared),
+        })
+    }
+}
+pub(crate) struct ManagedReplacementGuard<'a> {
+    context: &'a ManagedReplacementContext,
+    _mixer: tokio::sync::MutexGuard<'a, HashMap<ConnectionId, ConferenceMember>>,
+    state: std::sync::MutexGuard<'a, ManagedState>,
+    _registry: std::sync::MutexGuard<'a, ()>,
+    lifecycles: Vec<std::sync::MutexGuard<'a, ConnectionLifecycleState>>,
+    conversation: std::sync::RwLockWriteGuard<'a, Conversation>,
+    session: std::sync::RwLockWriteGuard<'a, Session>,
+    pending: std::sync::MutexGuard<'a, PendingReplacementState>,
+    prepared: Option<PreparedParticipantReplacementCommit>,
+}
+impl ManagedReplacementGuard<'_> {
+    fn commit(&mut self) -> ParticipantReplacementObservation {
+        let observation = self.state.controller.commit_replacement(
+            self.prepared
+                .take()
+                .expect("one compound replacement commit"),
+        );
+        self.session.connections.remove(&observation.replaced);
+        self.context
+            .owner
+            .sessions_by_connection
+            .remove(&observation.replaced);
+        let original_route = self
+            .state
+            .routes
+            .remove(&observation.replaced)
+            .expect("validated original route owns its admitted slot");
+        let index = self
+            .context
+            .lifecycles
+            .iter()
+            .position(|v| v.connection_id == observation.replaced)
+            .expect("validated original lifecycle");
+        let old = &mut self.lifecycles[index];
+        old.active = false;
+        old.retired = true;
+        if let Some(permit) = &old.peer_admission {
+            permit.retire_delivery();
+        }
+        old.generation = old.generation.saturating_add(1);
+        self.session.connections.insert(
+            observation.admitted.clone(),
+            ConnectionRef {
+                id: observation.admitted.clone(),
+                participant_id: observation.participant.clone(),
+            },
+        );
+        self.context.owner.sessions_by_connection.insert(
+            observation.admitted.clone(),
+            self.context.runtime.session.clone(),
+        );
+        self.state.routes.insert(
+            observation.admitted.clone(),
+            LiveRoute {
+                _slot: original_route._slot,
+                lifecycle: self.context.plan.preparation.candidate.clone(),
+            },
+        );
+        let index = self
+            .context
+            .lifecycles
+            .iter()
+            .position(|v| v.connection_id == observation.admitted)
+            .expect("validated candidate lifecycle");
+        self.lifecycles[index].replacement_reservation = None;
+        // The new live route inherits the original admitted slot. Only its
+        // additional temporary preparation reservation is released here.
+        drop(
+            self.pending
+                .slot
+                .take()
+                .expect("reserved temporary replacement slot"),
+        );
+        self.state.pending.remove(&observation.admitted);
+        self.context
+            .plan
+            .preparation
+            .phase
+            .store(COMMITTED, Ordering::Release);
+        self.conversation.last_activity_at = Utc::now();
+        let _ = self
+            .context
+            .runtime
+            .events
+            .send(ParticipantRuntimeEvent::ConnectionReplaced(
+                observation.clone(),
+            ));
+        observation
+    }
+}
+pub(crate) enum ManagedAudienceContext {
+    Handoff(handoff::ManagedHandoffContext),
+    Replacement(ManagedReplacementContext),
+}
+pub(crate) enum ManagedAudienceGuard<'a> {
+    Handoff(handoff::ManagedHandoffGuard<'a>),
+    Replacement(ManagedReplacementGuard<'a>),
+}
