+        };
+        let pending = model
+            .prepare_replacement(&source.member, &ep, intent)
+            .unwrap();
+        let mut owner = source.clone();
+        owner.endpoint = ep;
+        owner.connection = pending.binding().clone();
+        owner.presence = pending.appearance().clone();
+        room.add_owned("device", "alice", owner, true, Some(pending.clone()))
+            .await;
+        let p = room
+            .scene
+            .plan_audio_audience(AudioAudienceRequest {
+                operation_id: "device-isolated".into(),
+                expected_revision: room.scene.audience_revision(),
+                private_connections: BTreeSet::from([ConnectionId::from_string("device")]),
+                receivers: BTreeMap::from([(ConnectionId::from_string("device"), vec![])]),
+                activate_muted: Some(ConnectionId::from_string("device")),
+            })
+            .unwrap();
+        let (_, context) = room.apply(p).await.unwrap();
+        Self {
+            room,
+            model,
+            pending,
+            context,
+        }
+    }
+    fn plan(&self) -> ControlResult<AudioDeviceReplacementPlan> {
+        self.room.scene.plan_audio_device_replacement(
+            &self.context,
+            &self.pending,
+            AudioDeviceReplacementRequest {
+                operation_id: self.pending.intent().operation_id.clone(),
+                expected_revision: self.room.scene.audience_revision(),
+                source: self.pending.intent().source.clone(),
+                admitted: self.pending.intent().replacement.clone(),
+                retained: self.pending.intent().retained.clone(),
+            },
+        )
+    }
+    fn queue_prompt(&mut self, sample: i16) -> ControlResult<()> {
+        use rvoip_media_core::{codec::factory::CodecFactory, AudioFrame};
+        let node = self.room.nodes.get_mut("device").unwrap();
+        node.sequence += 1;
+        let port = node.adapter.port(Medium::Audio);
+        let mut f = frame(&port, node.sequence);
+        let mut codec = CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+        f.payload = codec
+            .encode(&AudioFrame {
+                samples: vec![sample; 160],
+                sample_rate: 8000,
+                channels: 1,
+                duration: Duration::from_millis(20),
+                timestamp: node.sequence,
+            })
+            .unwrap()
+            .into();
+        node.controller.try_queue_local_audio(
+            &desired(Medium::Audio).logical_id,
+            f,
+            LocalAudioPurpose::EndpointPreparation {
+                operation_id: self.pending.intent().operation_id.clone(),
+            },
+        )
+    }
+    async fn io(&mut self) {
+        self.room.publish("device", 12000).unwrap();
+        self.room.tick();
+        self.room
+            .silent(&["alice", "bob", "public", "other", "hold", "device"]);
+        self.queue_prompt(4000).unwrap();
+        self.room.heard("device", 4000).await;
+    }
+    async fn confirm(&mut self) {
+        let owner = self.room.domain.base.0.read().await.owners["device"].clone();
+        let g = self.pending.generation();
+        self.pending
+            .observe_media_ready(&owner.member, &owner.endpoint, g)
+            .unwrap();
+        self.pending
+            .observe_answer(&owner.connection.connection(), g)
+            .unwrap();
+        self.pending
+            .observe_dtmf(owner.connection.connection(), g, "7")
+            .unwrap();
+    }
+    async fn commit(
+        &self,
+        plan: AudioDeviceReplacementPlan,
+    ) -> ControlResult<(AudioDeviceReplacementOutcome, AudioDeviceReplacementHandle)> {
+        let grant = self
+            .room
+            .grant(Approval::Audience(plan.audience().clone()))
+            .await;
+        self.room
+            .scene
+            .commit_audio_device_replacement(plan, deadline(), CancellationToken::new(), &grant)
+            .await
+    }
+}
