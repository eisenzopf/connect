+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_managed_replacement_separate_signal_permission_and_held_callback_behind_writer()
+{
+    let s = Scene::new_replacement("quic").await;
+    let c = Candidate::new(
+        &s,
+        "quic",
+        EndpointConfirmationPolicy::AnsweredDtmf {
+            digits: "5#".into(),
+        },
+    )
+    .await;
+    c.io().await;
+    let media = s.replacement_media.as_ref().unwrap();
+    media.signal.store(false, Ordering::Release);
+    let captured = c.capture(&s, DeviceReplacementEndpointEvent::Answered);
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.principal,
+        Approval::Signal(DeviceReplacementEndpointEvent::Answered),
+    )
+    .await;
+    assert!(matches!(
+        captured.observe_with_held(&g),
+        Err(ParticipantControlError::Media(
+            StreamControlError::Unsupported
+        ))
+    ));
+    drop(g);
+    media.signal.store(true, Ordering::Release);
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.principal,
+        Approval::Signal(DeviceReplacementEndpointEvent::Answered),
+    )
+    .await;
+    let writer = tokio::spawn({
+        let domain = s.grants.0.clone();
+        async move {
+            let _exclusive = domain.write().await;
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    assert!(!writer.is_finished());
+    assert_eq!(
+        tokio::time::timeout(Duration::from_secs(1), async {
+            captured.observe_with_held(&g)
+        })
+        .await
+        .unwrap()
+        .unwrap(),
+        Observation::Answered
+    );
+    drop(g);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        c.event(
+            &s,
+            DeviceReplacementEndpointEvent::Dtmf {
+                digits: "5#".into()
+            }
+        )
+        .await,
+        Observation::Confirmed
+    );
+    let plan = s
+        .core
+        .orch
+        .plan_staged_device_replacement(&c.pending)
+        .unwrap();
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&c.live.leg.id)
+        .unwrap()
+        .may_control = false;
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.operator,
+        Approval::Commit(plan.clone()),
+    )
+    .await;
+    assert!(matches!(
+        s.core
+            .orch
+            .commit_staged_device_replacement_with_held(plan.clone(), &g)
+            .await,
+        Err(ParticipantControlError::Authority)
+    ));
+    drop(g);
+    s.tone(0, 1).await;
+    s.tone(1, 0).await;
+    s.grants
+        .0
+        .write()
+        .await
+        .owners
+        .get_mut(&c.live.leg.id)
+        .unwrap()
+        .may_control = true;
+    let g = grant(
+        &s,
+        c.pending.intent(),
+        &c.operator,
+        Approval::Commit(plan.clone()),
+    )
+    .await;
+    let writer = tokio::spawn({
+        let domain = s.grants.0.clone();
+        let id = c.live.leg.id.clone();
+        async move {
+            domain.write().await.denied.insert(id);
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(10)).await;
+    assert!(!writer.is_finished());
+    let (outcome, _) = tokio::time::timeout(
+        Duration::from_secs(2),
+        s.core
+            .orch
+            .commit_staged_device_replacement_with_held(plan, &g),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(
+        outcome
+            .media
+            .participant_replacement
+            .as_ref()
+            .unwrap()
+            .revision,
+        c.pending.intent().expected_revision + 1
+    );
+    drop(g);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    let g = grant(&s, c.pending.intent(), &c.operator, Approval::Replay).await;
+    assert!(matches!(
+        s.core
+            .orch
+            .replay_staged_device_replacement(&c.pending, &c.operator, &g),
+        Err(ParticipantControlError::Authority)
+    ));
+    drop(g);
+    s.tone(2, 3).await;
+    c.stop().await;
+    s.stop().await;
+}
