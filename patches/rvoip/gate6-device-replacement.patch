+fn replacement_model_no_answer_and_revoked_endpoint_or_changed_revision_preserve_source() {
+    let (mut s, a, mut ep, i) =
+        setup(EndpointConfirmationPolicy::AnsweredDtmf { digits: "1".into() });
+    let mut t = ready(&s, &a, &ep, &i);
+    let before = s.revision();
+    assert!(s.stage_replacement(&a, &a, i.clone(), &t, &ep).is_err());
+    assert_eq!(s.revision(), before);
+    t.observe_answer(&i.replacement, t.generation()).unwrap();
+    t.observe_dtmf(&i.replacement, t.generation(), "1").unwrap();
+    ep.revoke();
+    assert!(s.stage_replacement(&a, &a, i.clone(), &t, &ep).is_err());
+    assert_eq!(s.revision(), before);
+    assert!(s.connections(a.participant()).contains(&i.source));
+    s.connection_ended(&i.retained).unwrap();
+    assert!(s.stage_replacement(&a, &a, i.clone(), &t, &ep).is_err());
+    assert!(s.connections(a.participant()).contains(&i.source));
+}
+#[test]
+fn replacement_model_receipt_binds_actor_epoch_intent_and_shared_operation_namespace() {
+    let (mut s, a, ep, i) = setup(EndpointConfirmationPolicy::MediaOnly);
+    let t = ready(&s, &a, &ep, &i);
+    let c = s.stage_replacement(&a, &a, i.clone(), &t, &ep).unwrap();
+    s.commit_replacement(c);
+    let mut changed = i.clone();
+    changed.confirmation = EndpointConfirmationPolicy::AnsweredDtmf { digits: "1".into() };
+    assert!(s.replay_replacement(&a, &a, &changed).is_err());
+    let (foreign, _) = member("tenant_other", "alice");
+    assert!(s.replay_replacement(&foreign, &foreign, &i).is_err());
+    let regular = ParticipantMutation {
+        operation_id: i.operation_id.clone(),
+        correlation_id: "corr_role".into(),
+        expected_revision: s.revision(),
+        participant: a.participant().clone(),
+        change: ParticipantChange::SetSessionRole {
+            role: ParticipantRole::Observer,
+        },
+    };
+    assert!(matches!(
+        s.replay(&a, &a, &regular),
+        Err(ParticipantTransitionError::Conflict)
+    ));
+    let handoff = ParticipantHandoffMutation {
+        operation_id: i.operation_id.clone(),
+        correlation_id: "corr_handoff".into(),
+        expected_revision: s.revision(),
+        outgoing: a.participant().clone(),
+        incoming: ParticipantId::from_string("part_bob"),
+        retained: i.retained.clone(),
+        admitted: i.replacement.clone(),
+        incoming_role: ParticipantRole::Agent,
+        outgoing_disposition: ParticipantHandoffDisposition::Observe,
+    };
+    let (bob, _) = member("tenant_test", "bob");
+    assert!(s.replay_handoff(&a, &a, &bob, &handoff).is_err());
+    let mut readmitted = a.clone();
+    let (_, binding) = member("tenant_test", "alice");
+    readmitted.remove(readmitted.revision()).unwrap();
+    readmitted.readmit(&binding, readmitted.revision()).unwrap();
+    assert!(matches!(
+        s.replay_replacement(&readmitted, &readmitted, &i),
+        Err(ParticipantTransitionError::OwnerMismatch)
+    ));
+    let mut other = i.clone();
+    other.operation_id = "join_conn_old".into();
+    assert!(matches!(
+        s.replay_replacement(&a, &a, &other),
+        Err(ParticipantTransitionError::Conflict)
+    ));
+}
+#[test]
+fn replacement_model_full_connection_capacity_and_same_endpoint_transport_migration_are_distinct() {
+    let (mut s, a, ep, i) = setup(EndpointConfirmationPolicy::MediaOnly);
+    s.max_connections = s.connection_count();
+    let t = ready(&s, &a, &ep, &i);
+    let c = s.stage_replacement(&a, &a, i.clone(), &t, &ep).unwrap();
+    s.commit_replacement(c);
+    assert_eq!(s.connection_count(), s.max_connections);
+    let mut next = i.clone();
+    next.operation_id = "same_endpoint".into();
+    next.expected_revision = s.revision();
+    next.source = i.replacement.clone();
+    next.replacement = ConnectionId::from_string("conn_migration");
+    assert!(matches!(
+        s.prepare_replacement(&a, &ep, next),
+        Err(ParticipantTransitionError::Invalid)
+    ));
+    let mut invalid = i.clone();
+    invalid.operation_id = "invalid_confirmation".into();
+    invalid.expected_revision = s.revision();
+    invalid.source = i.replacement.clone();
+    invalid.replacement = ConnectionId::from_string("conn_invalid");
+    invalid.confirmation = EndpointConfirmationPolicy::AnsweredDtmf {
+        digits: "\n".into(),
+    };
+    assert!(matches!(
+        s.prepare_replacement(&a, &ep, invalid),
+        Err(ParticipantTransitionError::Invalid)
+    ));
