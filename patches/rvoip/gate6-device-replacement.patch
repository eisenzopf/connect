+async fn replacement_scene_preserves_original_closed_audience_and_combined_mute_hold_pause_gates() {
+    for actions in [
+        vec![StreamGateAction::Mute],
+        vec![StreamGateAction::Hold {
+            direction: StreamDirection::Receive,
+        }],
+        vec![
+            StreamGateAction::Mute,
+            StreamGateAction::Hold {
+                direction: StreamDirection::Send,
+            },
+            StreamGateAction::Pause,
+        ],
+    ] {
+        let mut f = Move::new(true).await;
+        f.io().await;
+        f.confirm().await;
+        let old = f.room.nodes["alice"].controller.clone();
+        let logical = desired(Medium::Audio).logical_id;
+        for action in actions {
+            old.set_media_gate(
+                old.revision(),
+                &BTreeSet::from([logical.clone()]),
+                action,
+                deadline(),
+            )
+            .await
+            .unwrap();
+        }
+        let expected = old.state.lock().unwrap().model.streams()[&logical].clone();
+        let plan = f.plan().unwrap();
+        f.commit(plan).await.unwrap();
+        let actual = f.room.nodes["device"]
+            .controller
+            .state
+            .lock()
+            .unwrap()
+            .model
+            .streams()[&logical]
+            .clone();
+        assert_eq!(
+            (actual.state, actual.source_muted, actual.hold_direction),
+            (
+                expected.state,
+                expected.source_muted,
+                expected.hold_direction
+            )
+        );
+        if expected.permits(false) {
+            f.room.publish("device", 5200).unwrap();
+            f.room.tick();
+            f.room.heard("bob", 5200).await;
+        } else {
+            assert!(f.room.publish("device", 5200).is_err());
+        }
+        f.room.silent(&["public", "other", "alice"]);
+        f.room.publish("bob", 2400).unwrap();
+        f.room.tick();
+        if expected.permits(true) {
+            f.room.heard("device", 2400).await;
+        } else {
+            f.room.silent(&["device"]);
+        }
+        f.room.silent(&["public", "other", "alice"]);
+    }
