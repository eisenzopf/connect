+//! A credential incarnation pinned by the actual engine, never a wire claim.
+use super::*;
+pub(crate) struct ControllerSignalStamp {
+    controller: Weak<StreamController>,
+    credential: CredentialSnapshot,
+}
+impl ControllerSignalStamp {
+    pub(crate) fn principal(&self) -> &AuthenticatedPrincipal {
+        &self.credential.principal
+    }
+
+    pub(crate) fn check(&self) -> ControlResult<()> {
+        let c = self
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        c.check_credential_snapshot(&self.credential)?;
+        if StreamController::principal_expiry(&self.credential.principal)
+            .is_some_and(|v| v <= chrono::Utc::now())
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let state = c.state.lock().unwrap_or_else(|v| v.into_inner());
+        if c.shutdown.is_cancelled() || state.closed {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(())
+    }
+}
+impl StreamController {
+    pub(crate) fn capture_signal_stamp(self: &Arc<Self>) -> ControlResult<ControllerSignalStamp> {
+        let value = ControllerSignalStamp {
+            controller: Arc::downgrade(self),
+            credential: self.credential_snapshot(),
+        };
+        value.check()?;
+        Ok(value)
+    }
+}
