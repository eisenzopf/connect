+//! Controlled endpoint confirmations over actual signed native TLS and decoded audio.
+use super::*;
+use rvoip_core::{
+    orchestrator::participant_control::{self as pc, *},
+    participant_transitions::{
+        EndpointConfirmationObservation as Observation, EndpointConfirmationPolicy,
+        ParticipantReplacementMutation, PreparedParticipantReplacement,
+    },
+    staged_streams::{
+        audience::*, local_audio::LocalAudioPurpose, ControlResult as MediaResult, *,
+    },
+};
+use std::{any::Any, sync::Mutex};
+use tokio::sync::OwnedRwLockReadGuard;
+
+struct Resources {
+    pending: PreparedParticipantReplacement,
+    proof: Option<Arc<PreparedMediaObservation>>,
+}
+pub(super) struct Media {
+    domain: Arc<MediaGrants>,
+    resources: Mutex<HashMap<ConnectionId, Resources>>,
+    signal: AtomicBool,
+    local: AtomicBool,
+}
+#[derive(Clone)]
+enum Approval {
+    Prepare,
+    Allocate,
+    Start,
+    Resources,
+    Attach,
+    Audience(AudioAudiencePlan),
+    Commit(ManagedAudioDeviceReplacementPlan),
+    Signal(DeviceReplacementEndpointEvent),
+    Replay,
+}
+struct Grant {
+    media: Arc<Media>,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    principal: AuthenticatedPrincipal,
+    intent: ParticipantReplacementMutation,
+    approval: Approval,
+}
+struct Held {
+    grant: Arc<Grant>,
+    owner: MediaOwner,
+}
+struct Fresh {
+    owner: MediaOwner,
+    _guard: OwnedRwLockReadGuard<PolicyState>,
+}
+impl MediaAuthorityLease for Fresh {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+impl Media {
+    pub(super) fn new(domain: Arc<MediaGrants>) -> Self {
+        Self {
+            domain,
+            resources: Default::default(),
+            signal: AtomicBool::new(true),
+            local: AtomicBool::new(true),
+        }
+    }
+    fn raw(&self, guard: &PolicyState, id: &ConnectionId) -> MediaResult<MediaOwner> {
+        if guard.private || guard.denied.contains(id) {
+            return Err(StreamControlError::Authority);
+        }
+        guard
+            .owners
+            .get(id)
+            .cloned()
+            .ok_or(StreamControlError::Authority)
+    }
+    fn owner(&self, guard: &PolicyState, id: &ConnectionId) -> MediaResult<MediaOwner> {
+        let owner = self.raw(guard, id)?;
+        let records = self.resources.lock().unwrap();
+        if let Some(r) = records.get(id) {
+            if let Some(proof) = r.proof.as_ref().filter(|p| p.is_committed()) {
+                let source = self.raw(guard, &r.pending.intent().source)?;
+                return proof.current_replacement_resources(owner, &source, &r.pending);
+            }
+        }
+        Ok(owner)
+    }
+    fn participant_owner(
+        &self,
+        guard: &PolicyState,
+        id: &ConnectionId,
+        source: &MediaParticipantSource,
+    ) -> MediaResult<MediaOwner> {
+        let original = self.owner(guard, &source.connection)?;
+        original
+            .member
+            .revalidate_principal(&source.principal, Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        original
+            .connection
+            .require_current(&original.member, &original.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if source.conversation != *original.member.conversation()
+            || source.session != *original.presence.session()
+            || source.participant != *original.member.participant()
+            || source.identity != *original.member.identity()
+            || source.membership_epoch != original.member.epoch()
+            || source.medium != Medium::Audio
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.owner(guard, id)
+    }
+    fn grant<'a>(&self, held: &'a (dyn Any + Send + Sync)) -> MediaResult<&'a Arc<Grant>> {
+        let g = held
+            .downcast_ref::<Arc<Grant>>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.domain, &g.media.domain) {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(g)
+    }
+}
+impl MediaAuthorityLease for Held {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> MediaResult<Box<MediaOwner>> {
+        self.grant
+            .media
+            .owner(&self.grant.guard, self.owner.connection.connection())
+            .map(Box::new)
+    }
+    fn control_prepared(
+        &self,
+        proof: &Arc<PreparedMediaObservation>,
+    ) -> MediaResult<Box<MediaOwner>> {
+        if !matches!(self.grant.approval, Approval::Resources) {
+            return self.control_owner();
+        }
+        let mut resources = self.grant.media.resources.lock().unwrap();
+        let r = resources
+            .get_mut(self.owner.connection.connection())
+            .ok_or(StreamControlError::Authority)?;
+        let source = self
+            .grant
+            .media
+            .raw(&self.grant.guard, &r.pending.intent().source)?;
+        let owner =
+            proof.activate_replacement_resources(self.owner.clone(), &source, &r.pending)?;
+        r.proof = Some(proof.clone());
+        Ok(Box::new(owner))
+    }
+    fn control_receive(&self, source: &MediaSource) -> MediaResult<Box<MediaOwner>> {
+        let original = self
+            .grant
+            .media
+            .owner(&self.grant.guard, &source.connection)?;
+        original
+            .connection
+            .require_current(&original.member, &original.presence)
+            .map_err(|_| StreamControlError::Authority)?;
+        if source.conversation != *original.member.conversation()
+            || source.session != *original.presence.session()
+            || source.participant != *original.member.participant()
+            || source.membership_epoch != original.member.epoch()
+            || source.connection_generation != original.connection.generation()
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.control_owner()
+    }
+    fn control_participant_receive(
+        &self,
+        source: &MediaParticipantSource,
+    ) -> MediaResult<Box<MediaOwner>> {
+        self.grant
+            .media
+            .participant_owner(
+                &self.grant.guard,
+                self.owner.connection.connection(),
+                source,
+            )
+            .map(Box::new)
+    }
+}
+impl MediaPolicy for Media {
+    fn current(&self, scope: &MediaScope<'_>) -> MediaResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .domain
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        let mut owner = self.owner(&guard, scope.connection)?;
+        if let MediaPurpose::Receive { source } = scope.purpose {
+            let original = self.owner(&guard, &source.connection)?;
+            if source.conversation != *original.member.conversation()
+                || source.session != *original.presence.session()
+                || source.participant != *original.member.participant()
+                || source.membership_epoch != original.member.epoch()
+                || source.connection_generation != original.connection.generation()
+            {
+                return Err(StreamControlError::Authority);
+            }
+            owner.may_route_source = true;
+        }
+        Ok(Box::new(Fresh {
+            owner,
+            _guard: guard,
+        }))
+    }
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> MediaResult<Box<dyn MediaAuthorityLease>> {
+        let guard = self
+            .domain
+            .0
+            .clone()
+            .try_read_owned()
+            .map_err(|_| StreamControlError::Authority)?;
+        let owner = self.participant_owner(&guard, scope.connection, source)?;
+        Ok(Box::new(Fresh {
+            owner,
+            _guard: guard,
+        }))
+    }
+    fn current_local_audio(
+        &self,
+        scope: &MediaScope<'_>,
+        purpose: &LocalAudioPurpose,
+    ) -> MediaResult<Box<dyn MediaAuthorityLease>> {
+        if !self.local.load(Ordering::Acquire) {
+            return Err(StreamControlError::Unsupported);
+        }
+        let LocalAudioPurpose::EndpointPreparation { operation_id } = purpose;
+        if !self
+            .resources
+            .lock()
+            .unwrap()
+            .get(scope.connection)
+            .is_some_and(|r| r.pending.intent().operation_id == *operation_id)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.current(scope)
+    }
+    fn current_device_replacement_signal(
+        &self,
+        scope: &DeviceReplacementSignalScope<'_>,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> MediaResult<Box<dyn MediaAuthorityLease>> {
+        if !self.signal.load(Ordering::Acquire) {
+            return Err(StreamControlError::Unsupported);
+        }
+        let g = self.grant(held.ok_or(StreamControlError::Unsupported)?)?;
+        if !matches!(&g.approval,Approval::Signal(e) if e==scope.event)
+            || g.intent != *scope.pending.intent()
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                &g.principal,
+                scope.principal,
+            )
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = self.owner(&g.guard, &g.intent.replacement)?;
+        owner
+            .member
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        Ok(Box::new(Held {
+            grant: g.clone(),
+            owner,
+        }))
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> MediaResult<MediaControl> {
+        let g = self.grant(held)?;
+        let valid = match (&g.approval, intent) {
+            (Approval::Resources, MediaControlIntent::Initialize) => {
+                scope.connection == &g.intent.replacement
+            }
+            (
+                Approval::Resources,
+                MediaControlIntent::Change {
+                    expected,
+                    desired: streams,
+                    replace,
+                },
+            ) => {
+                scope.connection == &g.intent.replacement
+                    && *expected == 0
+                    && streams == &vec![desired(Medium::Audio)]
+                    && replace.is_empty()
+            }
+            (
+                Approval::Resources,
+                MediaControlIntent::Gate {
+                    expected,
+                    streams,
+                    action,
+                },
+            ) => {
+                scope.connection == &g.intent.replacement
+                    && *expected == 1
+                    && *streams == &BTreeSet::from([desired(Medium::Audio).logical_id])
+                    && *action == StreamGateAction::Mute
+            }
+            (Approval::Attach, MediaControlIntent::PreparePrivateAudio { expected, .. }) => {
+                scope.connection == &g.intent.replacement && *expected == 2
+            }
+            (Approval::Audience(p), MediaControlIntent::AudioAudience { plan }) => {
+                p.same_intent(plan)
+            }
+            (Approval::Commit(p), MediaControlIntent::DeviceReplacement { plan }) => {
+                p.media().audience().same_intent(plan)
+            }
+            _ => false,
+        };
+        if !valid {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = self.raw(&g.guard, scope.connection)?;
+        owner
+            .actor
+            .revalidate_principal(scope.principal, Utc::now())
+            .map_err(|_| StreamControlError::Authority)?;
+        MediaControl::new(
+            Box::new(Held {
+                grant: g.clone(),
+                owner,
+            }),
+            CancellationToken::new(),
+            deadline(),
+        )
+    }
+}
