+    /// One revision transfers a source's runtime gates to a new physical
+    /// binding without copying codec, handle, transport or resource identity.
+    pub(crate) fn inherit_audio_gates(
+        &mut self,
+        authority: &CurrentMediaAuthority<'_>,
+        expected: u64,
+        id: &StreamId,
+        source: &LogicalStream,
+        routing_changed: bool,
+    ) -> Result<()> {
+        if source.state == LogicalStreamState::Ended
+            || source.negotiated.requested.medium != Medium::Audio
+        {
+            return Err(MediaTransitionError::Invalid);
+        }
+        let ids = BTreeSet::from([id.clone()]);
+        self.validate_gate(authority, expected, &ids, StreamGateAction::Mute)?;
+        self.validate_gate(authority, expected, &ids, StreamGateAction::Resume)?;
+        let stream = self
+            .streams
+            .get_mut(id)
+            .ok_or(MediaTransitionError::Conflict)?;
+        if stream.negotiated.requested.medium != Medium::Audio {
+            return Err(MediaTransitionError::Invalid);
+        }
+        let changed = stream.state != source.state
+            || stream.source_muted != source.source_muted
+            || stream.hold_direction != source.hold_direction;
+        stream.state = source.state;
+        stream.source_muted = source.source_muted;
+        stream.hold_direction = source.hold_direction;
+        if changed || routing_changed {
+            self.revision += 1;
+        }
+        Ok(())
+    }
