+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn controlled_browser_and_telephone_no_answer_voicemail_and_silent_resource_loss_preserve_old(
+) {
+    for kind in [Transport::WebRtc, Transport::Sip] {
+        for mode in ["no-answer", "voicemail", "lost-adapter"] {
+            let s = Scene::new_replacement("quic").await;
+            let mut c = Candidate::new(&s, kind).await;
+            let revision = c.pending.intent().expected_revision;
+            c.prompt().await;
+            if mode == "voicemail" {
+                assert_eq!(
+                    c.event(&s, DeviceReplacementEndpointEvent::Answered).await,
+                    Observation::Answered
+                );
+            }
+            assert_eq!(
+                c.event(&s, DeviceReplacementEndpointEvent::MediaObserved)
+                    .await,
+                Observation::MediaReady
+            );
+            assert!(s
+                .core
+                .orch
+                .plan_staged_device_replacement(&c.pending)
+                .is_err());
+            if mode == "lost-adapter" {
+                // No event hint is sent: bounded ownership observes actual
+                // adapter liveness and releases only the candidate resources.
+                c.adapter.live.store(false, Ordering::Release);
+            } else {
+                assert!(c.pending.cancel());
+            }
+            core_fixture::until(|| {
+                s.core.orch.participant_capacity(&s.core.session).unwrap() == (4, 0)
+            })
+            .await;
+            assert_eq!(
+                s.core.orch.participant_revision(&s.core.session).unwrap(),
+                revision
+            );
+            assert!(c.adapter.lifetime.lock().unwrap().is_cancelled());
+            s.tone(0, 1).await;
+            s.tone(1, 0).await;
+            s.tone(2, 3).await;
+            s.stop().await;
+        }
+    }
+}
