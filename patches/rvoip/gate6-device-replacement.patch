+struct Move {
+    room: Room,
+    model: ParticipantSession,
+    pending: PreparedParticipantReplacement,
+    context: AudioAudienceHandle,
+}
+fn endpoint_for(source: &MediaOwner, name: &str) -> EndpointBinding {
+    let id = IdentityBinding::from_authenticated(
+        &principal("alice"),
+        source.member.identity().clone(),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let mut ep = EndpointBinding::provision(
+        id.clone(),
+        EndpointId::from_string(format!("endpoint_{name}")),
+        DeviceId::from_string(format!("device_{name}")),
+        Transport::Quic,
+        "fixture-private-device".into(),
+    )
+    .unwrap();
+    ep.verify(&id, "verified_device".into(), chrono::Utc::now())
+        .unwrap();
+    ep
+}
+fn admit_actual(model: &mut ParticipantSession, owner: &MediaOwner) {
+    let mut ticket = model
+        .prepare_admission(
+            &owner.member,
+            &owner.endpoint,
+            owner.connection.connection().clone(),
+            None,
+        )
+        .unwrap();
+    ticket
+        .adopt_confirmed_binding(&owner.member, &owner.endpoint, &owner.connection)
+        .unwrap();
+    ticket
+        .observe_ready(&owner.member, &owner.endpoint, ticket.generation())
+        .unwrap();
+    let intent = ParticipantMutation {
+        operation_id: format!("join_{}", owner.connection.connection()),
+        correlation_id: "join".into(),
+        expected_revision: model.revision(),
+        participant: owner.member.participant().clone(),
+        change: ParticipantChange::Admit {
+            connection: owner.connection.connection().clone(),
+            role_override: None,
+        },
+    };
+    model
+        .apply(
+            &owner.member,
+            &owner.member,
+            intent,
+            Some(ticket),
+            Some(&owner.endpoint),
+        )
+        .unwrap();
+}
+impl Move {
+    async fn new(closed: bool) -> Self {
+        let mut room = Room::new().await;
+        let source = room.domain.base.0.read().await.owners["alice"].clone();
+        let mut other = source.clone();
+        other.endpoint = endpoint_for(&source, "other");
+        other.connection = ConnectionBinding::prepare(
+            &other.member,
+            &other.presence,
+            &other.endpoint,
+            ConnectionId::from_string("other"),
+        )
+        .unwrap();
+        other
+            .connection
+            .observe_ready(&other.member, &other.presence, &other.endpoint, 1)
+            .unwrap();
+        other
+            .connection
+            .activate(&other.member, &other.presence, &other.endpoint)
+            .unwrap();
+        room.add_owned("other", "alice", other, false, None).await;
+        room.select(
+            "other",
+            vec![AudioSubscription::Connection(ConnectionId::from_string(
+                "bob",
+            ))],
+        )
+        .await;
+        room.select(
+            "public",
+            vec![AudioSubscription::Participant(
+                source.member.participant().clone(),
+            )],
+        )
+        .await;
+        room.select(
+            "bob",
+            vec![AudioSubscription::Connection(ConnectionId::from_string(
+                "other",
+            ))],
+        )
+        .await;
+        let mut model = ParticipantSession::new(
+            TenantId::from_string("tenant"),
+            source.member.conversation().clone(),
+            source.presence.session().clone(),
+            4,
+            6,
+            128,
+        )
+        .unwrap();
+        for owner in room.domain.base.0.read().await.owners.values() {
+            admit_actual(&mut model, owner);
+        }
+        if closed {
+            let request = AudioAudienceRequest {
+                operation_id: "original_private".into(),
+                expected_revision: room.scene.audience_revision(),
+                private_connections: BTreeSet::from([
+                    ConnectionId::from_string("alice"),
+                    ConnectionId::from_string("bob"),
+                ]),
+                receivers: BTreeMap::from([
+                    (
+                        ConnectionId::from_string("alice"),
+                        vec![AudioSubscription::Connection(ConnectionId::from_string(
+                            "bob",
+                        ))],
+                    ),
+                    (
+                        ConnectionId::from_string("bob"),
+                        vec![AudioSubscription::Connection(ConnectionId::from_string(
+                            "alice",
+                        ))],
+                    ),
+                ]),
+                activate_muted: None,
+            };
+            let p = room.scene.plan_audio_audience(request).unwrap();
+            room.apply(p).await.unwrap();
+        }
+        let ep = endpoint_for(&source, "replacement");
+        let intent = ParticipantReplacementMutation {
+            operation_id: "device-replace".into(),
+            correlation_id: "corr-device".into(),
