+#[async_trait]
+impl AuthenticatedHandler for ReplacementHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let proof = authorized
+            .authority::<WireProof>()
+            .ok_or(DispatchError::Authority)?;
+        let peer = authorized
+            .peer_admission()
+            .ok_or(DispatchError::Authority)?
+            .clone();
+        let request = authorized.envelope();
+        if request.kind() != "connection.offer"
+            || proof.connection.as_ref() != Some(&self.pending.intent().replacement)
+        {
+            return Err(DispatchError::Authority);
+        }
+        let lease = View(&proof.authorities[&self.source.transport()]);
+        let pending = self
+            .core
+            .orch
+            .prepare_peer_native_device_replacement(
+                &self.pending,
+                peer.clone(),
+                authorized.principal(),
+                &lease,
+                self.source.clone(),
+            )
+            .map_err(|_| DispatchError::Authority)?;
+        pending
+            .retain(authorized.principal(), &lease)
+            .map_err(|_| DispatchError::Authority)?;
+        *self.record.peer.lock().unwrap() = Some(peer);
+        self.record
+            .connections
+            .lock()
+            .unwrap()
+            .push(self.pending.intent().replacement.clone());
+        let mut reply = envelope("ack", json!({"details":{"reserved":true}}));
+        for field in ["cid", "sid", "connid", "operation_id"] {
+            reply[field] = request.original()[field].clone();
+        }
+        reply["in_reply_to"] = json!(request.id());
+        Ok(Envelope::from_value(reply)?)
+    }
+}
