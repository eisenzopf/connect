+                &s,
+                c.pending.intent(),
+                &c.operator,
+                Approval::Commit(plan.clone()),
+            )
+            .await;
+            let (outcome, _handle) = s
+                .core
+                .orch
+                .commit_staged_device_replacement_with_held(plan.clone(), &g)
+                .await
+                .unwrap();
+            drop(g);
+            let g = grant(
+                &s,
+                c.pending.intent(),
+                &c.operator,
+                Approval::Commit(plan.clone()),
+            )
+            .await;
+            assert!(s
+                .core
+                .orch
+                .commit_staged_device_replacement_with_held(plan, &g)
+                .await
+                .is_err());
+            drop(g);
+            // A delayed physical terminal event for the retired old device
+            // cannot remove the freshly committed same-participant binding.
+            s.live[0].wire.server.shutdown().await.unwrap();
+            core_fixture::until(|| s.live[0].peer.snapshot().connections == 0).await;
+            let logical = outcome
+                .media
+                .participant_replacement
+                .as_ref()
+                .expect("managed logical commit");
+            assert_eq!(logical.revision, revision + 1);
+            assert_eq!(logical.replaced, s.live[0].leg.id);
+            assert_eq!(logical.admitted, c.live.leg.id);
+            assert_eq!(
+                s.core.orch.participant_revision(&s.core.session).unwrap(),
+                revision + 1
+            );
+            assert!(c.pending.is_committed());
+            assert!(!c.pending.cancel());
+            assert_eq!(
+                s.core.orch.participant_capacity(&s.core.session).unwrap(),
+                (4, 0)
+            );
+            let session = s.core.orch.session(&s.core.session).unwrap();
+            assert_eq!(session.read().unwrap().connections.len(), 4);
+            assert!(!session
+                .read()
+                .unwrap()
+                .connections
+                .contains_key(&s.live[0].leg.id));
+            assert!(session
+                .read()
+                .unwrap()
+                .connections
+                .contains_key(&c.live.leg.id));
+            let g = grant(&s, c.pending.intent(), &c.operator, Approval::Replay).await;
+            let replay = s
+                .core
+                .orch
+                .replay_staged_device_replacement(&c.pending, &c.operator, &g)
+                .unwrap()
+                .unwrap();
+            assert!(replay == *logical);
+            drop(g);
+            Scene::drain(&s.live[1].wire).await;
+            send(
+                &c.live.wire,
+                audio(binding(&c.live.leg, Medium::Audio).stream_local_id, 0),
+            );
+            decoded(&received(&s.live[1].wire).await);
+            Scene::drain(&c.live.wire).await;
+            send(&s.live[1].wire, audio(remote.stream_local_id, 0));
+            decoded(&received(&c.live.wire).await);
+            assert_eq!(
+                binding(&s.live[1].leg, Medium::Audio).transport_id,
+                remote.transport_id
+            );
