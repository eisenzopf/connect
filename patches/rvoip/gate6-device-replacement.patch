+#[test]
+fn replacement_model_later_move_keeps_lineage_and_original_history_without_reviving_either_old_leg()
+{
+    let (mut s, a, ep, first) = setup(EndpointConfirmationPolicy::MediaOnly);
+    let t = ready(&s, &a, &ep, &first);
+    let staged = s.stage_replacement(&a, &a, first.clone(), &t, &ep).unwrap();
+    let original = s.commit_replacement(staged);
+    let (_, binding) = member("tenant_test", "alice");
+    let next_endpoint = endpoint(&binding, "native");
+    let mut next = first.clone();
+    next.operation_id = "replace_again".into();
+    next.expected_revision = s.revision();
+    next.source = first.replacement.clone();
+    next.replacement = ConnectionId::from_string("conn_latest");
+    next.endpoint = next_endpoint.endpoint().clone();
+    next.device = next_endpoint.device().clone();
+    let t = ready(&s, &a, &next_endpoint, &next);
+    assert_eq!(t.generation(), 3);
+    let staged = s
+        .stage_replacement(&a, &a, next.clone(), &t, &next_endpoint)
+        .unwrap();
+    let latest = s.commit_replacement(staged);
+    assert_eq!(latest.generation, 3);
+    let revision = s.revision();
+    for old in [&first.source, &first.replacement] {
+        assert_eq!(s.connection_ended(old).unwrap(), None);
+    }
+    assert_eq!(s.revision(), revision);
+    assert_eq!(s.connection_count(), 3);
+    assert!(s.connections(a.participant()).contains(&next.replacement));
+    assert!(s
+        .connections(a.participant())
+        .contains(&ConnectionId::from_string("conn_other")));
+    assert_eq!(
+        s.replay_replacement(&a, &a, &first).unwrap(),
+        Some(original)
+    );
+    assert_eq!(s.replay_replacement(&a, &a, &next).unwrap(), Some(latest));
+}
