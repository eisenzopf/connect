+        id: &str,
+        expires: DateTime<Utc>,
+        now: DateTime<Utc>,
+    ) -> Result<(), ReplayConsumeError> {
+        self.entered.notify_one();
+        self.release.notified().await;
+        self.backing.consume(context, id, expires, now).await
+    }
