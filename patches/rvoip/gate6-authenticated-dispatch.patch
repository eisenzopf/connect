+    assert_eq!(ticket.wait().await.unwrap_err(), DispatchError::Closed);
+    assert_eq!(Instant::now() - started, MAX_DISPATCH_WAIT);
+    assert_eq!(peer.pending_count(), 0);
+}
+struct UnavailableReplay;
+#[async_trait]
+impl SignatureReplayStore for UnavailableReplay {
+    async fn consume(
+        &self,
+        _: &SignatureVerificationContext,
+        _: &str,
+        _: DateTime<Utc>,
+        _: DateTime<Utc>,
+    ) -> Result<(), ReplayConsumeError> {
+        Err(ReplayConsumeError::Unavailable)
+    }
+}
+#[tokio::test]
+async fn unavailable_replay_storage_never_calls_the_handler() {
+    let kp = keypair();
+    let verifier = Arc::new(
+        Sig9421Verifier::with_security_dependencies(
+            Arc::new(OwnedKey {
+                public: kp.public_key().as_ref().to_vec(),
+            }),
+            Arc::new(UnavailableReplay),
+            Arc::new(SystemSignatureClock),
+            Duration::from_secs(300),
+            Duration::from_secs(30),
+            1_048_576,
+        )
+        .unwrap(),
+    );
+    let peer = AuthenticatedDispatch::new(
+        principal(),
+        verifier,
+        Arc::new(Policy::default()),
+        CancellationToken::new(),
+        2,
+    )
+    .unwrap();
+    let h = Handler::default();
+    assert_eq!(
+        peer.dispatch(&signed(request(), &kp), &h, deadline())
+            .await
+            .unwrap_err(),
+        DispatchError::ReplayUnavailable
+    );
+    assert_eq!(h.calls.load(Ordering::SeqCst), 0);
+}
+#[tokio::test(start_paused = true)]
+async fn dropping_a_pending_handler_future_releases_current_authority() {
+    let kp = keypair();
+    let policy = Arc::new(Policy::default());
+    let peer = peer(&kp, policy.clone());
+    let h = HeldHandler {
+        entered: Notify::new(),
+        release: Notify::new(),
+    };
+    let wire = signed(request(), &kp);
+    let mut dispatch = Box::pin(peer.dispatch(&wire, &h, deadline()));
+    tokio::select! {result=&mut dispatch=>panic!("completed early: {result:?}"),_ = h.entered.notified()=>{} }
+    assert!(policy.revoked.try_write().is_err());
+    drop(dispatch);
+    assert!(policy.revoked.try_write().is_ok());
+}
