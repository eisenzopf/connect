diff --git a/crates/uctp/rvoip-uctp/src/v2/auth_dispatch.rs b/crates/uctp/rvoip-uctp/src/v2/auth_dispatch.rs
new file mode 100644
index 0000000..35ef083
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/src/v2/auth_dispatch.rs
@@ -0,0 +1,483 @@
+//! Authenticated envelope-v2 dispatch and bounded, scoped response admission.
+//!
+//! This is an explicit backend for an authenticated peer. The transport/profile
+//! handshake must install it deliberately; it never upgrades a v1 coordinator.
+//! All post-auth envelopes are signed. Application policy supplies owned current
+//! authority through execution, and logical operation recovery stays in the
+//! application handler. A correlated reply is an observation, never an authority
+//! grant for a subsequent effect.
+
+use super::{Envelope, Scope, WireError};
+use async_trait::async_trait;
+use parking_lot::Mutex;
+use rvoip_auth_core::bearer::{ensure_principal_active, AuthenticatedPrincipal, BearerValidator};
+use rvoip_auth_core::sig9421::{Sig9421Error, Sig9421Verifier};
+use rvoip_core::identity::IdentityAssurance;
+use std::{collections::HashMap, fmt, sync::Arc, time::Duration};
+use tokio::{sync::oneshot, time::Instant};
+use tokio_util::sync::CancellationToken;
+
+/// Upper bound for one backend invocation or correlated waiter. Application
+/// operations that outlive it must use their durable logical-operation ledger.
+pub const MAX_DISPATCH_WAIT: Duration = Duration::from_secs(30);
+
+/// Stable errors omit credentials, envelope contents, key IDs and resource IDs.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum DispatchError {
+    #[error("invalid envelope")]
+    Wire(WireError),
+    #[error("authentication method unavailable")]
+    UnsupportedMethod,
+    #[error("authentication failed")]
+    Authentication,
+    #[error("current authority unavailable or denied")]
+    Authority,
+    #[error("signature required or invalid")]
+    Signature,
+    #[error("envelope replay")]
+    Replay,
+    #[error("signature replay protection unavailable")]
+    ReplayUnavailable,
+    #[error("reply does not match a current scoped request")]
+    ReplyMismatch,
+    #[error("unsupported dispatch or request family")]
+    Unsupported,
+    #[error("request capacity exhausted")]
+    Capacity,
+    #[error("peer closed or deadline expired")]
+    Closed,
+}
+
+impl From<WireError> for DispatchError {
+    fn from(value: WireError) -> Self {
+        Self::Wire(value)
+    }
+}
+
+/// Keeps current authority in force until the handler returns. The installed
+/// policy must put its owned read/delivery guard here, including credential
+/// and signing-key revocation, effective grant and current resource scope. Never wrap a stale
+/// boolean authorization result. Construction is trusted backend composition.
+pub struct AuthorityLease {
+    _guard: Box<dyn Send + Sync>,
+}
+impl AuthorityLease {
+    pub fn holding<T: Send + Sync + 'static>(guard: T) -> Self {
+        Self {
+            _guard: Box::new(guard),
+        }
+    }
+}
+impl fmt::Debug for AuthorityLease {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("AuthorityLease(redacted)")
+    }
+}
+
+#[async_trait]
+pub trait CurrentAuthority: Send + Sync {
+    async fn acquire(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        envelope: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError>;
+}
+
+/// Only the dispatch gate can construct this proof. The handler receives the
+/// authenticated actor separately from optional presentation fields in payloads.
+/// Holding this value retains authority for this invocation, not for a future
+/// operation, detached task or durable replay.
+pub struct AuthorizedEnvelope {
+    envelope: Envelope,
+    principal: AuthenticatedPrincipal,
+    _lease: AuthorityLease,
+}
+impl AuthorizedEnvelope {
+    pub fn envelope(&self) -> &Envelope {
+        &self.envelope
+    }
+    pub fn principal(&self) -> &AuthenticatedPrincipal {
+        &self.principal
+    }
+}
+impl fmt::Debug for AuthorizedEnvelope {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AuthorizedEnvelope")
+            .field("envelope", &self.envelope)
+            .finish_non_exhaustive()
+    }
+}
+
+#[async_trait]
+pub trait AuthenticatedHandler: Send + Sync {
+    /// Exactly one application dispatch. Stable logical-operation deduplication
+    /// belongs here; a fresh signed envelope never bypasses current authority.
+    /// Cancellation may mean uncertain work: reconcile the same operation ID.
+    async fn handle(&self, envelope: AuthorizedEnvelope) -> Result<Envelope, DispatchError>;
+}
+
+/// Advertise only the credential validator actually installed at this boundary.
+/// Experimental AAuth, DPoP and unknown strings never fall back to bearer.
+pub struct AuthenticationMethods {
+    bearer: Option<Arc<dyn BearerValidator>>,
+}
+impl AuthenticationMethods {
+    pub fn new(bearer: Option<Arc<dyn BearerValidator>>) -> Self {
+        Self { bearer }
+    }
+    pub fn advertised(&self) -> Vec<&'static str> {
+        if self.bearer.is_some() {
+            vec!["bearer"]
+        } else {
+            Vec::new()
+        }
+    }
+    /// Credential backend only, not the public four-envelope handshake. Profile
+    /// selection/challenge binding must complete before installing the peer.
+    pub async fn authenticate(
+        &self,
+        method: &str,
+        credential: &str,
+        actor_token: Option<&str>,
+        deadline: Instant,
+    ) -> Result<AuthenticatedPrincipal, DispatchError> {
+        if method != "bearer" {
+            return Err(DispatchError::UnsupportedMethod);
+        }
+        let validator = self
+            .bearer
+            .as_ref()
+            .ok_or(DispatchError::UnsupportedMethod)?;
+        // The bearer backend has no actor-token/delegation verification path.
+        if actor_token.is_some() || credential.is_empty() || credential.len() > 65_536 {
+            return Err(DispatchError::Authentication);
+        }
+        if deadline <= Instant::now() {
+            return Err(DispatchError::Closed);
+        }
+        let deadline = deadline.min(Instant::now() + MAX_DISPATCH_WAIT);
+        let validated =
+            tokio::time::timeout_at(deadline, validator.validate_credential(credential))
+                .await
+                .map_err(|_| DispatchError::Closed)?
+                .map_err(|_| DispatchError::Authentication)?;
+        checked_principal(validated.principal)
+    }
+}
+
+fn checked_principal(
+    principal: AuthenticatedPrincipal,
+) -> Result<AuthenticatedPrincipal, DispatchError> {
+    let principal =
+        ensure_principal_active(principal).map_err(|_| DispatchError::Authentication)?;
+    if principal.tenant.is_none()
+        || principal.issuer.is_none()
+        || principal.expires_at.is_none()
+        || matches!(principal.assurance.kind(), "anonymous" | "pseudonymous")
+    {
+        return Err(DispatchError::Authentication);
+    }
+    if let IdentityAssurance::TaskScoped { expires_at, .. } = &principal.assurance {
+        if *expires_at <= chrono::Utc::now() {
+            return Err(DispatchError::Authentication);
+        }
+    }
+    Ok(principal)
+}
+
+pub enum DispatchOutcome {
+    Handled(Envelope),
+    ReplyDelivered,
+}
+impl fmt::Debug for DispatchOutcome {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Handled(envelope) => f.debug_tuple("Handled").field(envelope).finish(),
+            Self::ReplyDelivered => f.write_str("ReplyDelivered"),
+        }
+    }
+}
+
+/// One authenticated peer incarnation. Reauthentication creates a new one;
+/// pending requests never move across peer incarnations. This backend does not
+/// advertise a wire profile or handle refresh/step-up credentials itself.
+pub struct AuthenticatedDispatch {
+    principal: AuthenticatedPrincipal,
+    verifier: Arc<Sig9421Verifier>,
+    authority: Arc<dyn CurrentAuthority>,
+    lifetime: CancellationToken,
+    pending: Arc<Mutex<HashMap<String, PendingEntry>>>,
+    capacity: usize,
+}
+impl AuthenticatedDispatch {
+    /// `principal` is a trusted validator result, not a deserialized payload.
+    pub fn new(
+        principal: AuthenticatedPrincipal,
+        verifier: Arc<Sig9421Verifier>,
+        authority: Arc<dyn CurrentAuthority>,
+        lifetime: CancellationToken,
+        pending_capacity: usize,
+    ) -> Result<Self, DispatchError> {
+        if pending_capacity == 0 || pending_capacity > 256 {
+            return Err(DispatchError::Capacity);
+        }
+        Ok(Self {
+            principal: checked_principal(principal)?,
+            verifier,
+            authority,
+            lifetime: lifetime.child_token(),
+            pending: Arc::new(Mutex::new(HashMap::new())),
+            capacity: pending_capacity,
+        })
+    }
+
+    pub fn close(&self) {
+        self.lifetime.cancel();
+        self.pending.lock().clear();
+    }
+
+    pub fn pending_count(&self) -> usize {
+        let mut pending = self.pending.lock();
+        if self.lifetime.is_cancelled() {
+            pending.clear();
+        }
+        pending.retain(|_, entry| entry.deadline > Instant::now() && !entry.sender.is_closed());
+        pending.len()
+    }
+
+    fn require_active(&self, deadline: Instant) -> Result<(), DispatchError> {
+        if self.lifetime.is_cancelled() || deadline <= Instant::now() {
+            return Err(DispatchError::Closed);
+        }
+        checked_principal(self.principal.clone()).map(|_| ())
+    }
+
+    fn active_deadline(&self, requested: Instant) -> Result<Instant, DispatchError> {
+        self.require_active(requested)?;
+        let now = chrono::Utc::now();
+        let mut expiry = self
+            .principal
+            .expires_at
+            .ok_or(DispatchError::Authentication)?;
+        if let IdentityAssurance::TaskScoped { expires_at, .. } = &self.principal.assurance {
+            expiry = expiry.min(*expires_at);
+        }
+        let remaining = (expiry - now)
+            .to_std()
+            .map_err(|_| DispatchError::Authentication)?;
+        Ok(requested.min(Instant::now() + remaining.min(MAX_DISPATCH_WAIT)))
+    }
+
+    /// Register before writing a request, retaining the ticket until completion.
+    /// Only already scoped families are supported here. Resource creation and
+    /// unscoped auth handshakes need their own explicit correlation policies.
+    pub fn register_reply(
+        &self,
+        request: &Envelope,
+        deadline: Instant,
+    ) -> Result<ReplyTicket, DispatchError> {
+        let deadline = self.active_deadline(deadline)?;
+        let expectation = ReplyExpectation::new(request)?;
+        let mut pending = self.pending.lock();
+        pending.retain(|_, entry| entry.deadline > Instant::now() && !entry.sender.is_closed());
+        if pending.contains_key(request.id()) || pending.len() >= self.capacity {
+            return Err(DispatchError::Capacity);
+        }
+        let (sender, receiver) = oneshot::channel();
+        let token = uuid::Uuid::new_v4();
+        pending.insert(
+            request.id().to_owned(),
+            PendingEntry {
+                expectation,
+                sender,
+                token,
+                deadline,
+            },
+        );
+        Ok(ReplyTicket {
+            pending: self.pending.clone(),
+            id: request.id().to_owned(),
+            token,
+            receiver: Some(receiver),
+            deadline,
+            lifetime: self.lifetime.clone(),
+        })
+    }
+
+    pub async fn dispatch(
+        &self,
+        bytes: &[u8],
+        handler: &dyn AuthenticatedHandler,
+        deadline: Instant,
+    ) -> Result<DispatchOutcome, DispatchError> {
+        let deadline = self.active_deadline(deadline)?;
+        let envelope = Envelope::parse(bytes)?;
+        // Pre-auth, refresh and assurance transitions have a separate state
+        // machine. Never send credentials or server-only observations to an
+        // ordinary application handler.
+        if envelope.kind().starts_with("auth.") || envelope.kind().starts_with("identity.") {
+            return Err(DispatchError::Unsupported);
+        }
+        tokio::select! {
+            biased;
+            _ = self.lifetime.cancelled() => Err(DispatchError::Closed),
+            _ = tokio::time::sleep_until(deadline) => Err(DispatchError::Closed),
+            result = self.dispatch_inner(envelope, handler, deadline) => result,
+        }
+    }
+
+    async fn dispatch_inner(
+        &self,
+        envelope: Envelope,
+        handler: &dyn AuthenticatedHandler,
+        deadline: Instant,
+    ) -> Result<DispatchOutcome, DispatchError> {
+        // Check current revocation/scope even before expensive verification.
+        // Drop that lease before awaiting replay storage, then reacquire after
+        // verification so a revocation during verification cannot slip through.
+        drop(self.authority.acquire(&self.principal, &envelope).await?);
+        self.require_active(deadline)?;
+        self.verifier
+            .verify_for_principal(envelope.original(), &self.principal)
+            .await
+            .map_err(|error| match error {
+                Sig9421Error::ReplayDetected(_) => DispatchError::Replay,
+                Sig9421Error::ReplayStoreUnavailable => DispatchError::ReplayUnavailable,
+                _ => DispatchError::Signature,
+            })?;
+        let lease = self.authority.acquire(&self.principal, &envelope).await?;
+        self.require_active(deadline)?;
+        if let Some(reply_to) = envelope.scope(Scope::Reply) {
+            let mut pending = self.pending.lock();
+            let entry = pending.get(reply_to).ok_or(DispatchError::ReplyMismatch)?;
+            if entry.deadline <= Instant::now() || !entry.expectation.matches(&envelope) {
+                return Err(DispatchError::ReplyMismatch);
+            }
+            let entry = pending
+                .remove(reply_to)
+                .expect("entry held under same lock");
+            // Retain authority through nonblocking local waiter admission. No
+            // authority guard is parked indefinitely in an unpolled receiver.
+            entry
+                .sender
+                .send(envelope)
+                .map_err(|_| DispatchError::ReplyMismatch)?;
+            drop(lease);
+            return Ok(DispatchOutcome::ReplyDelivered);
+        }
+        if is_reply_kind(envelope.kind()) {
+            return Err(DispatchError::ReplyMismatch);
+        }
+        handler
+            .handle(AuthorizedEnvelope {
+                envelope,
+                principal: self.principal.clone(),
+                _lease: lease,
+            })
+            .await
+            .map(DispatchOutcome::Handled)
+    }
+}
+
+impl Drop for AuthenticatedDispatch {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+fn is_reply_kind(kind: &str) -> bool {
+    matches!(
+        kind,
+        "ack"
+            | "error"
+            | "connection.answer"
+            | "connection.ready"
+            | "operation.updated"
+            | "conversation.snapshot"
+            | "conversation.opened"
+            | "conversation.closed"
+            | "recording.vcon-fetched"
+    )
+}
+
+struct PendingEntry {
+    expectation: ReplyExpectation,
+    sender: oneshot::Sender<Envelope>,
+    deadline: Instant,
+    token: uuid::Uuid,
+}
+struct ReplyExpectation {
+    cid: String,
+    sid: String,
+    connid: String,
+    operation: Option<String>,
+    family: &'static str,
+}
+impl ReplyExpectation {
+    fn new(request: &Envelope) -> Result<Self, DispatchError> {
+        if request.scope(Scope::Reply).is_some() {
+            return Err(DispatchError::Unsupported);
+        }
+        let family = match request.kind() {
+            "connection.offer" => "connection.answer",
+            "connection.update" | "stream.subscribe" | "stream.unsubscribe" => "ack",
+            "operation.get" | "operation.cancel" | "operation.reconcile" => "operation.updated",
+            _ => return Err(DispatchError::Unsupported),
+        };
+        let required = |scope| {
+            request
+                .scope(scope)
+                .map(str::to_owned)
+                .ok_or(DispatchError::ReplyMismatch)
+        };
+        Ok(Self {
+            cid: required(Scope::Conversation)?,
+            sid: required(Scope::Session)?,
+            connid: required(Scope::Connection)?,
+            operation: request.scope(Scope::Operation).map(str::to_owned),
+            family,
+        })
+    }
+    fn matches(&self, reply: &Envelope) -> bool {
+        reply.scope(Scope::Conversation) == Some(self.cid.as_str())
+            && reply.scope(Scope::Session) == Some(self.sid.as_str())
+            && reply.scope(Scope::Connection) == Some(self.connid.as_str())
+            && reply.scope(Scope::Operation) == self.operation.as_deref()
+            && (reply.kind() == self.family || reply.kind() == "error")
+    }
+}
+
+/// Dropping a send/await future removes only its own registration. Waiting is
+/// bounded by its original absolute deadline and the physical peer lifetime.
+pub struct ReplyTicket {
+    pending: Arc<Mutex<HashMap<String, PendingEntry>>>,
+    id: String,
+    token: uuid::Uuid,
+    receiver: Option<oneshot::Receiver<Envelope>>,
+    deadline: Instant,
+    lifetime: CancellationToken,
+}
+impl ReplyTicket {
+    /// Validated observation only. Reacquire current application authority at
+    /// every later mutation/media activation; receiving a reply grants none.
+    pub async fn wait(mut self) -> Result<Envelope, DispatchError> {
+        let receiver = self.receiver.take().expect("owned single wait");
+        tokio::select! {
+            biased;
+            _ = self.lifetime.cancelled() => Err(DispatchError::Closed),
+            _ = tokio::time::sleep_until(self.deadline) => Err(DispatchError::Closed),
+            result = receiver => result.map_err(|_| DispatchError::Closed),
+        }
+    }
+}
+impl Drop for ReplyTicket {
+    fn drop(&mut self) {
+        let mut pending = self.pending.lock();
+        if pending
+            .get(&self.id)
+            .is_some_and(|entry| entry.token == self.token)
+        {
+            pending.remove(&self.id);
+        }
+    }
+}
