+//! Canonical backend tests: real Ed25519/JCS verification and current policy.
+//! No v1 handshake, live provider, public transport or durable service claim.
+use async_trait::async_trait;
+use base64::Engine;
+use chrono::{DateTime, Duration as ChronoDuration, Utc};
+use ring::signature::{Ed25519KeyPair, KeyPair};
+use rvoip_auth_core::{
+    bearer::{AuthenticatedPrincipal, AuthenticationMethod, BearerAuthError, BearerValidator},
+    sig9421::{
+        jcs_canonicalize, InMemorySignatureReplayStore, KeyResolver, ReplayConsumeError,
+        ResolvedVerificationKey, Sig9421Verifier, SignatureReplayStore,
+        SignatureVerificationContext, StaticKeyResolver, SystemSignatureClock,
+    },
+};
+use rvoip_core::identity::{CredentialKind, IdentityAssurance};
+use rvoip_uctp::v2::{auth_dispatch::*, Envelope, Scope};
+use serde_json::{json, Value};
+use std::{
+    collections::HashSet,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+use tokio::{
+    sync::{Notify, RwLock},
+    time::Instant,
+};
+use tokio_util::sync::CancellationToken;
+
+fn deadline() -> Instant {
+    Instant::now() + Duration::from_secs(3)
+}
+fn principal() -> AuthenticatedPrincipal {
+    AuthenticatedPrincipal {
+        subject: "alice".into(),
+        tenant: Some("tenant".into()),
+        issuer: Some("issuer".into()),
+        expires_at: Some(Utc::now() + ChronoDuration::hours(1)),
+        scopes: vec!["control".into()],
+        method: AuthenticationMethod::Bearer,
+        assurance: IdentityAssurance::Identified {
+            credential_kind: CredentialKind::Oidc,
+        },
+    }
+}
+fn keypair() -> Ed25519KeyPair {
+    Ed25519KeyPair::from_pkcs8(
+        Ed25519KeyPair::generate_pkcs8(&ring::rand::SystemRandom::new())
+            .unwrap()
+            .as_ref(),
+    )
+    .unwrap()
+}
+struct OwnedKey {
+    public: Vec<u8>,
+}
+impl KeyResolver for OwnedKey {
+    fn resolve(&self, _: &str) -> Option<Vec<u8>> {
+        Some(self.public.clone())
+    }
+    fn resolve_for_principal(
+        &self,
+        p: &AuthenticatedPrincipal,
+        key: &str,
+        alg: &str,
+        _: DateTime<Utc>,
+    ) -> Option<ResolvedVerificationKey> {
+        (p.subject == "alice"
+            && p.issuer.as_deref() == Some("issuer")
+            && p.tenant.as_deref() == Some("tenant")
+            && key == "owned"
+            && alg == "EdDSA")
+            .then(|| ResolvedVerificationKey {
+                public_key: self.public.clone(),
+                algorithm: "EdDSA".into(),
+                not_before: None,
+                expires_at: None,
+                revoked: false,
+            })
+    }
+}
+fn verifier(kp: &Ed25519KeyPair) -> Arc<Sig9421Verifier> {
+    Arc::new(Sig9421Verifier::new(Arc::new(OwnedKey {
+        public: kp.public_key().as_ref().to_vec(),
+    })))
+}
+fn envelope(kind: &str, payload: Value) -> Value {
+    json!({"v":2,"type":kind,"id":format!("env_{}",uuid::Uuid::new_v4().simple()),"ts":Utc::now().to_rfc3339(),"cid":"conversation","sid":"session","connid":"connection","operation_id":"logical_operation","payload":payload})
+}
+fn request() -> Value {
+    let mut value = envelope("connection.update", json!({"action":"hold"}));
+    value["expected_revision"] = json!(1);
+    value
+}
+fn ack(request: &Value) -> Value {
+    let mut value = envelope("ack", json!({"details":{"received":request["id"]}}));
+    value["in_reply_to"] = request["id"].clone();
+    value
+}
+fn signed(mut value: Value, kp: &Ed25519KeyPair) -> Vec<u8> {
+    value.as_object_mut().unwrap().remove("signature");
+    let sig = kp.sign(jcs_canonicalize(&value).as_bytes());
+    value["signature"] = json!({"keyid":"owned","alg":"EdDSA","sig":base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(sig.as_ref())});
+    serde_json::to_vec(&value).unwrap()
+}
+#[derive(Default)]
+struct Policy {
+    revoked: Arc<RwLock<bool>>,
+    calls: AtomicUsize,
+}
+#[async_trait]
+impl CurrentAuthority for Policy {
+    async fn acquire(
+        &self,
+        p: &AuthenticatedPrincipal,
+        env: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        let guard = self.revoked.clone().read_owned().await;
+        if *guard
+            || !p.has_scope("control")
+            || !matches!(
+                env.scope(Scope::Conversation),
+                Some("conversation" | "wrong")
+            )
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(guard))
+    }
+}
+#[derive(Default)]
+struct Handler {
+    calls: AtomicUsize,
+    effects: parking_lot::Mutex<HashSet<String>>,
+}
+#[async_trait]
+impl AuthenticatedHandler for Handler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        assert_eq!(authorized.principal().subject, "alice");
+        let env = authorized.envelope();
+        assert!(env.execution_value().get("optional_extension").is_none());
+        self.effects
+            .lock()
+            .insert(env.scope(Scope::Operation).unwrap().into());
+        Envelope::from_value(ack(env.original())).map_err(DispatchError::from)
+    }
+}
+fn peer(kp: &Ed25519KeyPair, policy: Arc<Policy>) -> AuthenticatedDispatch {
+    AuthenticatedDispatch::new(
+        principal(),
+        verifier(kp),
+        policy,
+        CancellationToken::new(),
+        2,
+    )
+    .unwrap()
+}
