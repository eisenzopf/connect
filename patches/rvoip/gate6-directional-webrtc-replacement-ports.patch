+fn validate_rtp_slots(
+    media: impl IntoIterator<Item = (Medium, StreamDirection)>,
+) -> ControlResult<()> {
+    // A replacement may name its video publication and receive selection
+    // separately while retaining one physical sendrecv video m-line. Each
+    // physical direction still has exactly one logical owner. Audio remains
+    // one duplex-or-directional logical port, as in the ordinary profile.
+    let mut slots = std::collections::BTreeMap::new();
+    for (medium, direction) in media {
+        let physical = rtp_medium(medium)?;
+        let receive = direction != StreamDirection::Send;
+        let send = direction != StreamDirection::Receive;
+        match slots.entry(physical) {
+            std::collections::btree_map::Entry::Vacant(slot) => {
+                slot.insert((medium, receive, send));
+            }
+            std::collections::btree_map::Entry::Occupied(mut slot) => {
+                let (kind, received, sent) = *slot.get();
+                if physical == Medium::Audio
+                    || kind != medium
+                    || received && receive
+                    || sent && send
+                {
+                    return Err(StreamControlError::Unsupported);
+                }
+                slot.insert((medium, received || receive, sent || send));
+            }
         }
     }
     Ok(())
+}
+fn receives_rtp(binding: &ReadyMediaBinding, physical: Medium) -> bool {
+    binding.source_ready
+        && binding.negotiated.requested.direction != StreamDirection::Send
+        && rtp_medium(binding.negotiated.requested.medium).ok() == Some(physical)
 }
