+    #[test]
+    fn received_rtp_is_never_fanned_into_the_receive_selection_egress_queue() {
+        let binding = |direction, medium| ReadyMediaBinding {
+            negotiated: NegotiatedStream {
+                requested: DesiredStream {
+                    logical_id: StreamId::new(),
+                    medium,
+                    direction,
+                },
+                format: MediaFormat::Encoded {
+                    name: "vp8".into(),
+                    clock_rate_hz: 90000,
+                    channels: 0,
+                    fmtp: None,
+                },
+            },
+            transport_id: StreamId::new(),
+            stream_local_id: 1,
+            generation: 1,
+            connection_generation: 1,
+            source_ready: direction != StreamDirection::Send,
+            sink_ready: direction != StreamDirection::Receive,
+        };
+        let publication = binding(StreamDirection::Receive, Medium::Video);
+        let receiver = binding(StreamDirection::Send, Medium::Video);
+        let duplex = binding(StreamDirection::Both, Medium::Video);
+        assert!(receives_rtp(&publication, Medium::Video));
+        assert!(!receives_rtp(&receiver, Medium::Video));
+        assert!(receives_rtp(&duplex, Medium::Video));
+        assert!(!receives_rtp(&publication, Medium::Audio));
+        let mut unavailable = publication.clone();
+        unavailable.source_ready = false;
+        assert!(!receives_rtp(&unavailable, Medium::Video));
+        assert!(receives_rtp(
+            &binding(StreamDirection::Receive, Medium::Screen),
+            Medium::Video
+        ));
+    }
