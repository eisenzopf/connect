+    #[test]
+    fn replacement_video_halves_share_one_physical_slot_without_duplicate_direction() {
+        use StreamDirection::{Both, Receive, Send};
+        for (first, second) in [(Receive, Send), (Send, Receive)] {
+            assert!(
+                validate_rtp_slots([
+                    (Medium::Audio, Both),
+                    (Medium::Video, first),
+                    (Medium::Video, second),
+                ])
+                .is_ok()
+            );
+        }
+        for first in [Receive, Send, Both] {
+            for second in [Receive, Send, Both] {
+                let result = validate_rtp_slots([
+                    (Medium::Audio, Both),
+                    (Medium::Video, first),
+                    (Medium::Video, second),
+                ]);
+                let complementary = matches!((first, second), (Receive, Send) | (Send, Receive));
+                assert_eq!(result.is_ok(), complementary, "{first:?} and {second:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn directional_profile_does_not_alias_camera_screen_or_split_audio() {
+        use StreamDirection::{Both, Receive, Send};
+        assert!(
+            validate_rtp_slots([
+                (Medium::Audio, Both),
+                (Medium::Video, Receive),
+                (Medium::Screen, Send),
+            ])
+            .is_err()
+        );
+        assert!(
+            validate_rtp_slots([
+                (Medium::Audio, Both),
+                (Medium::Screen, Receive),
+                (Medium::Video, Send),
+            ])
+            .is_err()
+        );
+        assert!(validate_rtp_slots([(Medium::Audio, Receive), (Medium::Audio, Send),]).is_err());
+        assert!(
+            validate_rtp_slots([
+                (Medium::Audio, Both),
+                (Medium::Video, Receive),
+                (Medium::Video, Send),
+                (Medium::Video, Send),
+            ])
+            .is_err()
+        );
+    }
