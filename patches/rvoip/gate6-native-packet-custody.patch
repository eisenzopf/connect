+++ b/crates/foundation/rvoip-core/src/staged_streams/tests/guarded_mixer/packet_context.rs
@@ -0,0 +1,142 @@
+//! The active source context supplies custody, never recipient permission.
+use super::*;
+
+struct PacketContext {
+    domain: Arc<()>,
+    source: ConnectionId,
+}
+struct PacketLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    context: PacketContext,
+}
+impl MediaAuthorityLease for PacketLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn packet_context(&self) -> Option<&(dyn Any + Send + Sync)> {
+        Some(&self.context)
+    }
+}
+struct PacketPolicy {
+    inner: Arc<Policy>,
+    domain: Arc<()>,
+    active: Arc<std::sync::atomic::AtomicBool>,
+    paired: Arc<AtomicUsize>,
+}
+impl MediaPolicy for PacketPolicy {
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current_participant_receive(scope, source)
+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if self.active.load(Ordering::Acquire)
+            && matches!(scope.purpose, MediaPurpose::Receive { .. })
+        {
+            return Err(StreamControlError::Authority);
+        }
+        Ok(Box::new(PacketLease {
+            inner: self.inner.current(scope)?,
+            context: PacketContext {
+                domain: self.domain.clone(),
+                source: scope.connection.clone(),
+            },
+        }))
+    }
+    fn current_packet(
+        &self,
+        scope: &MediaScope<'_>,
+        context: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let context = context
+            .downcast_ref::<PacketContext>()
+            .ok_or(StreamControlError::Authority)?;
+        let MediaPurpose::Receive { source } = scope.purpose else {
+            return Err(StreamControlError::Authority);
+        };
+        if !Arc::ptr_eq(&self.domain, &context.domain) || context.source != source.connection {
+            return Err(StreamControlError::Authority);
+        }
+        self.paired.fetch_add(1, Ordering::AcqRel);
+        self.inner.current(scope)
+    }
+}
+async fn scene() -> (Scene, Arc<AtomicUsize>) {
+    let active = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let paired = Arc::new(AtomicUsize::new(0));
+    let s = Scene::new_inner(
+        &[
+            ("a", "alice", audio(), 0),
+            ("b", "bob", audio(), 0),
+            ("c", "carol", audio(), 0),
+        ],
+        8000,
+        Some(Box::new({
+            let active = active.clone();
+            let paired = paired.clone();
+            move |inner| {
+                Arc::new(PacketPolicy {
+                    inner,
+                    domain: Arc::new(()),
+                    active,
+                    paired,
+                })
+            }
+        })),
+    )
+    .await;
+    for i in 0..3 {
+        s.bind(i, true).await;
+    }
+    active.store(true, Ordering::Release);
+    paired.store(0, Ordering::Release);
+    (s, paired)
+}
+
+#[tokio::test]
+async fn guarded_mixer_and_egress_use_only_their_active_source_packet_context() {
+    let (s, paired) = scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    assert_eq!(paired.load(Ordering::Acquire), 2);
+    heard(bob.try_recv().unwrap(), 1800).await;
+    heard(carol.try_recv().unwrap(), 1800).await;
+    assert_eq!(
+        paired.load(Ordering::Acquire),
+        4,
+        "each dequeue rechecks its own current recipient"
+    );
+}
+
+#[tokio::test]
+async fn guarded_packet_context_keeps_no_queued_reader_and_cannot_borrow_recipient_permission() {
+    let (s, paired) = scene().await;
+    let mut bob = s.port(1).take_egress().unwrap();
+    let mut carol = s.port(2).take_egress().unwrap();
+    s.publish(0, 1800);
+    s.mixer.tick();
+    let queued = bob.try_recv().unwrap();
+    s.policy
+        .0
+        .try_write()
+        .expect("queued frame retained a policy reader")
+        .revoked
+        .insert("bob".into());
+    let sent = std::sync::atomic::AtomicBool::new(false);
+    assert!(matches!(
+        queued
+            .deliver(|_| async {
+                sent.store(true, Ordering::Release);
+                Ok(())
+            })
+            .await,
+        Err(StreamControlError::Authority)
+    ));
+    assert!(!sent.load(Ordering::Acquire));
+    heard(carol.try_recv().unwrap(), 1800).await;
+    assert_eq!(paired.load(Ordering::Acquire), 4);
+}
