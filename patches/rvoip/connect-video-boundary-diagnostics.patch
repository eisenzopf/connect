+//! Test-support numeric Core forwarding decisions. No IO/authority/payload retained.
+use super::*;
+use std::sync::{
+    atomic::{AtomicU64, Ordering},
+    OnceLock,
+};
+// 16 exceptional categories * first4 = fixed64 slots. One category cannot
+// consume another's evidence; all counters continue beyond these samples.
+const EXCEPTION_STAGES: usize = 16;
+const PER_STAGE: usize = 4;
+const STAGES: [&str; 18] = [
+    "capture",
+    "forward-ok",
+    "forward-model",
+    "forward-authority",
+    "forward-not-recipient",
+    "forward-not-ready",
+    "forward-metadata-busy",
+    "forward-backpressure",
+    "forward-other",
+    "drop-source",
+    "drop-target",
+    "drop-target-deadline",
+    "drop-target-age",
+    "retain-not-ready",
+    "drop-not-ready",
+    "drop-pending-age",
+    "other",
+    "drop-pending-capacity",
+];
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Event {
+    pub stage: &'static str,
+    pub elapsed_us: u128,
+    pub source_ssrc: Option<u32>,
+    pub source_sequence: Option<u16>,
+    pub rtp_timestamp: Option<u32>,
+}
+#[derive(Debug)]
+pub struct Snapshot {
+    pub began_unix_us: u128,
+    pub clock_pair_window_us: u128,
+    pub counts: Vec<(&'static str, u64)>,
+    pub total_exception_events: u64,
+    pub sampling: &'static str,
+    pub category_overflow: Vec<(&'static str, u64)>,
+    pub unreported_reserved: usize,
+    pub events: Vec<Option<Event>>,
+}
+pub struct Counters {
+    began: Instant,
+    began_unix_us: u128,
+    clock_pair_window_us: u128,
+    counts: [AtomicU64; 18],
+    reserved: AtomicU64,
+    occurrences: [AtomicU64; EXCEPTION_STAGES],
+    events: [[OnceLock<Event>; PER_STAGE]; EXCEPTION_STAGES],
+}
+fn increment(counter: &AtomicU64) -> u64 {
+    counter
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |v| {
+            Some(v.saturating_add(1))
+        })
+        .unwrap()
+}
+fn classify(stage: &str, error: Option<&StreamControlError>) -> usize {
+    if stage == "capture" {
+        0
+    } else if stage == "forward-result" {
+        match error {
+            None => 1,
+            Some(StreamControlError::Model(_)) => 2,
+            Some(StreamControlError::Authority) => 3,
+            Some(StreamControlError::NotRecipient) => 4,
+            Some(StreamControlError::NotReady) => 5,
+            Some(StreamControlError::MetadataBusy) => 6,
+            Some(StreamControlError::Backpressure) => 7,
+            _ => 8,
+        }
+    } else if stage.starts_with("drop-source") {
+        9
+    } else if stage == "drop-target-deadline" {
+        11
+    } else if stage == "drop-target-age" {
+        12
+    } else if stage.starts_with("drop-target") {
+        10
+    } else if stage == "retain-not-ready" {
+        13
+    } else if stage == "drop-not-ready" {
+        14
+    } else if stage == "drop-pending-age" {
+        15
+    } else if stage == "drop-pending-capacity" {
+        17
+    } else {
+        16
+    }
+}
+impl Counters {
+    pub(super) fn new() -> Self {
+        let began = Instant::now();
+        let began_unix_us = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |d| d.as_micros());
+        let clock_pair_window_us = began.elapsed().as_micros();
+        Self {
+            began,
+            began_unix_us,
+            clock_pair_window_us,
+            counts: std::array::from_fn(|_| AtomicU64::new(0)),
+            reserved: AtomicU64::new(0),
+            occurrences: std::array::from_fn(|_| AtomicU64::new(0)),
+            events: std::array::from_fn(|_| std::array::from_fn(|_| OnceLock::new())),
+        }
+    }
+    pub(super) fn record(
+        &self,
+        stage: &'static str,
+        error: Option<&StreamControlError>,
+        rtp: &[u8],
+    ) {
+        let code = classify(stage, error);
+        increment(&self.counts[code]);
+        // Healthy path adds only its scalar count: no clock/header parse/log.
+        if code <= 1 {
+            return;
+        }
+        increment(&self.reserved);
+        let category = code - 2;
+        let n = increment(&self.occurrences[category]);
+        let Some(slot) = self.events[category].get(usize::try_from(n).unwrap_or(usize::MAX)) else {
+            return;
+        };
+        let valid = rtp.len() >= 12 && rtp[0] >> 6 == 2;
+        let event = Event {
+            stage: if stage == "forward-result" {
+                STAGES[code]
+            } else {
+                stage
+            },
+            elapsed_us: self.began.elapsed().as_micros(),
+            source_ssrc: valid.then(|| u32::from_be_bytes(rtp[8..12].try_into().unwrap())),
+            source_sequence: valid.then(|| u16::from_be_bytes(rtp[2..4].try_into().unwrap())),
+            rtp_timestamp: valid.then(|| u32::from_be_bytes(rtp[4..8].try_into().unwrap())),
+        };
+        // Unique reserved slot has one writer; get() never waits on publication.
+        let _ = slot.set(event);
+    }
+    pub fn snapshot(&self) -> Snapshot {
+        let total = self.reserved.load(Ordering::Relaxed);
+        let mut unreported = 0;
+        let mut events = Vec::new();
+        let mut category_overflow = Vec::new();
+        for category in 0..EXCEPTION_STAGES {
+            let count = self.occurrences[category].load(Ordering::Relaxed);
+            if count > PER_STAGE as u64 {
+                category_overflow.push((STAGES[category + 2], count - PER_STAGE as u64));
+            }
+            for slot in self.events[category]
+                .iter()
+                .take(count.min(PER_STAGE as u64) as usize)
+            {
+                let event = slot.get().copied();
+                if event.is_none() {
+                    unreported += 1;
+                }
+                events.push(event);
+            }
+        }
+        Snapshot {
+            began_unix_us: self.began_unix_us,
+            clock_pair_window_us: self.clock_pair_window_us,
+            counts: self
+                .counts
+                .iter()
+                .enumerate()
+                .filter_map(|(i, n)| {
+                    let n = n.load(Ordering::Relaxed);
+                    (n > 0).then_some((STAGES[i], n))
+                })
+                .collect(),
+            total_exception_events: total,
+            sampling: "first4-per-exception-category; max64; no overwrite",
+            category_overflow,
+            unreported_reserved: unreported,
+            events,
+        }
+    }
+}
+impl AdapterMediaPort {
+    #[doc(hidden)]
+    pub fn video_boundary_snapshot_for_test(&self) -> Option<Snapshot> {
+        self.0
+            .video_boundary
+            .as_ref()
+            .map(|counter| counter.snapshot())
+    }
+    #[doc(hidden)]
+    pub fn video_boundary_observation_for_test(&self) -> Option<Arc<Counters>> {
+        self.0.video_boundary.clone()
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn core_video_boundary_counters_distinguish_forward_refusal_and_unpublished_events() {
+        let a = Counters::new();
+        let b = Counters::new();
+        let bytes = [0x80, 96, 0, 9, 0, 0, 0, 30, 0, 0, 0, 3];
+        a.record("capture", None, &bytes);
+        a.record(
+            "forward-result",
+            Some(&StreamControlError::NotReady),
+            &bytes,
+        );
+        b.record(
+            "forward-result",
+            Some(&StreamControlError::MetadataBusy),
+            &bytes,
+        );
+        let x = a.snapshot();
+        assert_eq!(x.counts, vec![("capture", 1), ("forward-not-ready", 1)]);
+        assert_eq!(x.events[0].unwrap().source_sequence, Some(9));
+        assert_eq!(x.events[0].unwrap().rtp_timestamp, Some(30));
+        assert_eq!(b.snapshot().counts, vec![("forward-metadata-busy", 1)]);
+        increment(&a.reserved);
+        increment(&a.occurrences[3]);
+        let x = a.snapshot();
+        assert_eq!(x.events[1], None);
+        assert_eq!(x.unreported_reserved, 1);
+        a.record("drop-target-age", None, &[]);
+        assert!(a
+            .snapshot()
+            .events
+            .iter()
+            .flatten()
+            .any(|e| e.stage == "drop-target-age" && e.source_ssrc.is_none()));
+        let c = Counters::new();
+        for sequence in 0..100u16 {
+            let mut rtp = bytes;
+            rtp[2..4].copy_from_slice(&sequence.to_be_bytes());
+            c.record("forward-result", Some(&StreamControlError::NotReady), &rtp);
+            c.record(
+                "forward-result",
+                Some(&StreamControlError::NotRecipient),
+                &rtp,
+            );
+            c.record("drop-target-selection", None, &rtp);
+        }
+        c.record("drop-source-ticket", None, &bytes);
+        let snapshot = c.snapshot();
+        let sequences = snapshot
+            .events
+            .iter()
+            .flatten()
+            .filter(|e| e.stage == "forward-not-ready")
+            .map(|e| e.source_sequence.unwrap())
+            .collect::<Vec<_>>();
+        assert_eq!(sequences, vec![0, 1, 2, 3]);
+        assert_eq!(snapshot.total_exception_events, 301);
+        assert_eq!(snapshot.events.len(), 13);
+        assert!(snapshot
+            .events
+            .iter()
+            .flatten()
+            .any(|e| e.stage == "drop-source-ticket"));
+        assert!(snapshot
+            .events
+            .iter()
+            .flatten()
+            .any(|e| e.stage == "drop-target-selection"));
+        assert!(snapshot.counts.contains(&("forward-not-recipient", 100)));
+        assert!(snapshot.counts.contains(&("drop-target", 100)));
+        assert!(snapshot
+            .category_overflow
+            .contains(&("forward-not-ready", 96)));
+    }
+}
