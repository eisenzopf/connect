+//! Fixed numeric evidence only. Disabled unless the explicit debug target is enabled.
+//! No media, route, current permission, callback, mutex, task or timer is retained.
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+const LIMIT: usize = 64;
+const STAGES: [&str; 16] = [
+    "ingress-before-owner",
+    "ingress-owned-final",
+    "ingress-abandoned",
+    "queued-before-packetizer",
+    "feedback-receiver",
+    "feedback-source",
+    "history-announced",
+    "packetizer-callback-refused",
+    "publisher-history-announced",
+    "receiver-history-announced",
+    "publisher-metadata-lock",
+    "publisher-current-refusal",
+    "publisher-fan-in-cooldown",
+    "publisher-transport-refused",
+    "receiver-metadata-lock",
+    "receiver-history-refused",
+];
+const ERRORS: [&str; 12] = [
+    "model",
+    "unsupported",
+    "authority",
+    "not-recipient",
+    "cancelled",
+    "deadline",
+    "not-ready",
+    "metadata-busy",
+    "backpressure",
+    "cleanup-unconfirmed",
+    "ok",
+    "unknown",
+];
+#[derive(Default)]
+struct Slot {
+    ready: AtomicBool,
+    at: AtomicU64,
+    stamp: AtomicU64,
+    source: AtomicU64,
+    class: AtomicU64,
+    known: AtomicBool,
+}
+pub(super) struct Events {
+    began: Instant,
+    began_unix_us: u128,
+    clock_pair_window_us: u128,
+    reserved: AtomicU64,
+    counts: [[AtomicU64; 12]; 16],
+    slots: [Slot; LIMIT],
+}
+#[derive(Debug, PartialEq, Eq)]
+pub(super) struct Event {
+    elapsed_us: u64,
+    stage: &'static str,
+    error: &'static str,
+    source_ssrc: Option<u32>,
+    sequence: Option<u32>,
+    rtp_timestamp: Option<u32>,
+}
+#[derive(Debug)]
+pub(super) struct Snapshot {
+    began_unix_us: u128,
+    clock_pair_window_us: u128,
+    total_events: u64,
+    overflow: u64,
+    unreported_reserved: usize,
+    counts: Vec<(&'static str, &'static str, u64)>,
+    events: Vec<Option<Event>>,
+}
+fn increment(value: &AtomicU64) -> u64 {
+    value
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |v| {
+            Some(v.saturating_add(1))
+        })
+        .unwrap()
+}
+impl Events {
+    pub(super) fn enabled() -> bool {
+        tracing::enabled!(target: "rvoip_uctp::video_recovery", tracing::Level::DEBUG)
+    }
+    pub(super) fn new() -> Self {
+        let began = Instant::now();
+        let began_unix_us = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_or(0, |d| d.as_micros());
+        let clock_pair_window_us = began.elapsed().as_micros();
+        Self {
+            began,
+            began_unix_us,
+            clock_pair_window_us,
+            reserved: AtomicU64::new(0),
+            counts: std::array::from_fn(|_| std::array::from_fn(|_| AtomicU64::new(0))),
+            slots: std::array::from_fn(|_| Slot::default()),
+        }
+    }
+    pub(super) fn record(
+        &self,
+        stage: usize,
+        error: usize,
+        source_ssrc: u32,
+        sequence: u32,
+        timestamp: u32,
+    ) {
+        self.record_actual(stage, error, Some((source_ssrc, sequence, timestamp)));
+    }
+    pub(super) fn record_optional(
+        &self,
+        stage: usize,
+        error: usize,
+        stamp: Option<(u32, u16, u32)>,
+    ) {
+        self.record_actual(
+            stage,
+            error,
+            stamp.map(|(ssrc, seq, ts)| (ssrc, u32::from(seq), ts)),
+        );
+    }
+    fn record_actual(&self, stage: usize, error: usize, stamp: Option<(u32, u32, u32)>) {
+        let (source_ssrc, sequence, timestamp) = stamp.unwrap_or_default();
+        debug_assert!(stage < STAGES.len() && error < ERRORS.len());
+        if stage >= STAGES.len() || error >= ERRORS.len() {
+            return;
+        }
+        increment(&self.counts[stage][error]);
+        let ordinal = increment(&self.reserved);
+        let Some(slot) = self
+            .slots
+            .get(usize::try_from(ordinal).unwrap_or(usize::MAX))
+        else {
+            return;
+        };
+        // Each reserved slot has exactly one writer, then release-publishes.
+        slot.at.store(
+            self.began.elapsed().as_micros().min(u128::from(u64::MAX)) as u64,
+            Ordering::Relaxed,
+        );
+        slot.stamp.store(
+            (u64::from(sequence) << 32) | u64::from(timestamp),
+            Ordering::Relaxed,
+        );
+        slot.source.store(u64::from(source_ssrc), Ordering::Relaxed);
+        slot.class
+            .store((stage * ERRORS.len() + error) as u64, Ordering::Relaxed);
+        slot.known.store(stamp.is_some(), Ordering::Relaxed);
+        slot.ready.store(true, Ordering::Release);
+    }
+    pub(super) fn snapshot(&self) -> Snapshot {
+        let total = self.reserved.load(Ordering::Relaxed);
+        let mut unreported = 0;
+        let events = self
+            .slots
+            .iter()
+            .take(total.min(LIMIT as u64) as usize)
+            .map(|slot| {
+                if !slot.ready.load(Ordering::Acquire) {
+                    unreported += 1;
+                    return None;
+                }
+                let class = slot.class.load(Ordering::Relaxed) as usize;
+                let stamp = slot.stamp.load(Ordering::Relaxed);
+                Some(Event {
+                    elapsed_us: slot.at.load(Ordering::Relaxed),
+                    stage: STAGES[class / ERRORS.len()],
+                    error: ERRORS[class % ERRORS.len()],
+                    source_ssrc: slot
+                        .known
+                        .load(Ordering::Relaxed)
+                        .then_some(slot.source.load(Ordering::Relaxed) as u32),
+                    sequence: (slot.known.load(Ordering::Relaxed)
+                        && (![5, 10, 11, 12].contains(&(class / ERRORS.len()))
+                            || class % ERRORS.len() == 10))
+                        .then_some((stamp >> 32) as u32),
+                    rtp_timestamp: (slot.known.load(Ordering::Relaxed)
+                        && ![4, 5, 10, 11, 12, 13, 14, 15].contains(&(class / ERRORS.len())))
+                    .then_some(stamp as u32),
+                })
+            })
+            .collect();
+        let counts = self
+            .counts
+            .iter()
+            .enumerate()
+            .flat_map(|(s, entries)| {
+                entries.iter().enumerate().filter_map(move |(e, count)| {
+                    let count = count.load(Ordering::Relaxed);
+                    (count > 0).then_some((STAGES[s], ERRORS[e], count))
+                })
+            })
+            .collect();
+        Snapshot {
+            began_unix_us: self.began_unix_us,
+            clock_pair_window_us: self.clock_pair_window_us,
+            total_events: total,
+            overflow: total.saturating_sub(LIMIT as u64),
+            unreported_reserved: unreported,
+            counts,
+            events,
