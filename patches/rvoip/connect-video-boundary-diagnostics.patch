+    use super::*;
+    #[test]
+    fn numeric_video_boundary_diagnostics_isolate_ports_stages_and_unreported_slots() {
+        let counter = super::super::StagedRtpCounters::default();
+        super::super::io_add(
+            &counter
+                .io_for(rvoip_core::stream::StreamKind::Audio)
+                .input_errors[7],
+            1,
+        );
+        super::super::io_add(
+            &counter
+                .io_for(rvoip_core::stream::StreamKind::Video)
+                .input_errors[8],
+            2,
+        );
+        let snapshot = counter.io_snapshot();
+        assert_eq!(snapshot[0].medium, "audio");
+        assert_eq!(snapshot[0].input_errors[7], 1);
+        assert_eq!(snapshot[0].input_errors[8], 0);
+        assert_eq!(snapshot[1].input_errors[8], 2);
+        assert_eq!(snapshot[1].input_errors[7], 0);
+        assert_eq!(snapshot[2].input_errors, [0; 10]);
+        let a = Events::new();
+        let b = Events::new();
+        a.record(0, 7, 3, 9, 30);
+        a.record(3, 6, 3, 10, 60);
+        b.record(4, 2, 4, 11, 90);
+        let x = a.snapshot();
+        let y = b.snapshot();
+        assert_eq!(
+            x.counts,
+            vec![
+                ("ingress-before-owner", "metadata-busy", 1),
+                ("queued-before-packetizer", "not-ready", 1)
+            ]
+        );
+        assert_eq!(y.counts, vec![("feedback-receiver", "authority", 1)]);
+        assert_eq!(x.events[0].as_ref().unwrap().sequence, Some(9));
+        // Model a reserved but not release-published concurrent slot.
+        increment(&a.reserved);
+        let x = a.snapshot();
+        assert_eq!(x.unreported_reserved, 1);
+        assert_eq!(x.events[2], None);
+        for i in 0..70 {
+            b.record(5, 10, 4, i, i * 3000);
+        }
+        let y = b.snapshot();
+        assert_eq!(y.events.len(), LIMIT);
+        assert_eq!(y.overflow, 7);
+        assert_eq!(
+            y.counts,
+            vec![
+                ("feedback-receiver", "authority", 1),
+                ("feedback-source", "ok", 70)
+            ]
+        );
+    }
+}
