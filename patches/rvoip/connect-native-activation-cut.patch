+#[tokio::test]
+async fn native_cursor_failed_reservation_exhaustion_and_original_close_are_not_new_owners() {
+    let f=Preroll::new().await;let adapter=&f.movement.room.nodes["device"].adapter;
+    let port=adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+    let identity=port.native_egress_identity().unwrap();
+    assert!(port.install_native_egress_cursor().is_err(),"a second cursor cannot replace this actual original reader");
+    assert_eq!(cut_writer(adapter,&port,0).unwrap(),0);
+    assert!(cut_writer(adapter,&port,0).is_err(),"failed stale reservation cannot reuse an original sequence");
+    assert_eq!(port.0.native_egress.get().unwrap().ordinal.load(Ordering::Acquire),1);
+    let maximum=9_007_199_254_740_991u64;
+    port.0.native_egress.get().unwrap().ordinal.store(maximum-1,Ordering::Release);
+    assert_eq!(cut_writer(adapter,&port,(maximum-1)as u32).unwrap(),(maximum-1)as u32);
+    assert!(cut_writer(adapter,&port,maximum as u32).is_err());
+    assert_eq!(port.0.native_egress.get().unwrap().ordinal.load(Ordering::Acquire),maximum);
+    assert_eq!(port.native_egress_identity().unwrap(),identity);
+    assert_eq!(f.movement.room.nodes["device"].controller.shutdown(deadline()).await,0);
+    assert!(cut_writer(adapter,&port,maximum as u32).is_err());
+}
