+fn original_clock(handle:u16,ssrc:u32,rtp:u32)->Bytes {
+    use bytes::BufMut;use rvoip_rtp_core::packet::rtcp::*;
+    let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap();
+    let ntp=((now.as_secs()+2_208_988_800)<<32)|((u64::from(now.subsec_nanos())<<32)/1_000_000_000);
+    let mut sr=RtcpSenderReport::new(ssrc);sr.ntp_timestamp=NtpTimestamp::from_u64(ntp);sr.rtp_timestamp=rtp;sr.sender_packet_count=1;sr.sender_octet_count=4;
+    let mut c=RtcpCompoundPacket::new_with_sr(sr);let mut chunk=RtcpSdesChunk::new(ssrc);chunk.add_item(RtcpSdesItem::cname("original-duplex-clock".into()));
