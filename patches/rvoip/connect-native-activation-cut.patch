+use super::*;
+
+// Real Core route/ticket/queue tests. The test adapter installs the original
+// cursor before taking its original egress reader; these tests do not claim a
+// native wire/decoder run, which remains a separate adapter/signed fixture.
+fn cut_writer(adapter:&Adapter, port:&AdapterMediaPort, sequence:u32)->ControlResult<u32> {
+    adapter.native_writers.lock().unwrap().get_mut(&port.binding().transport_id).unwrap().reserve(sequence)
+}
+fn enable_cut(f:&Preroll) { f.movement.room.nodes["device"].adapter.native_cursors.store(true,Ordering::Release); }
+fn native_video_cut(outcome:&AudioDeviceReplacementOutcome)->NativeSequenceCut {
+    let receipt=outcome.media.replacement_activation.as_ref().unwrap();
+    assert_eq!(receipt.scope(),&ReplacementActivationScope::PublicNative);
+    receipt.streams().iter().find(|s|s.identity().logical()==&request().receivers[0].replacement).unwrap().clone()
+}
+#[tokio::test]
+async fn native_cut_waits_for_actual_private_writer_and_keeps_original_cursor() {
+    let mut f=Preroll::new().await;enable_cut(&f);
+    let prepared=f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob",70);delivered(&mut f.old_output,70).await;
+    let queued=outgoing(&mut f.target_output).await;
+    let adapter=f.movement.room.nodes["device"].adapter.clone();
+    let port=adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+    let original=port.native_egress_identity().unwrap();let ticket=port.0.ticket();
+    let (entered,seen)=tokio::sync::oneshot::channel();let (release,released)=tokio::sync::oneshot::channel();
+    let writer_adapter=adapter.clone();let writer_port=port.clone();
+    let writing=tokio::spawn(async move {queued.deliver(|_|async move {
+        assert_eq!(cut_writer(&writer_adapter,&writer_port,0).unwrap(),0);
+        entered.send(()).unwrap();released.await.unwrap();Ok(())
+    }).await});seen.await.unwrap();
+    let plan=f.movement.plan_with_video(Some(request())).unwrap();
+    let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+    let scene=f.movement.room.scene.clone();
+    let committing=tokio::spawn(async move {scene.commit_audio_device_replacement(plan,deadline(),CancellationToken::new(),&grant).await});
+    tokio::time::timeout(Duration::from_millis(100),async {while ticket.is_active(){tokio::task::yield_now().await;}}).await.unwrap();
+    assert!(!committing.is_finished());assert!(!f.movement.room.nodes["alice"].controller.shutdown.is_cancelled());
+    release.send(()).unwrap();writing.await.unwrap().unwrap();
+    let (outcome,handle)=committing.await.unwrap().unwrap();let cut=native_video_cut(&outcome);
+    assert_eq!(cut.identity(),&original);assert_eq!(cut.ordinal(),1);assert_eq!(cut.public_sequence_floor(),1);
+    f.publish_video("bob",71);let public=outgoing(&mut f.target_output).await;
+    public.deliver(|_|async {assert_eq!(cut_writer(&adapter,&port,1).unwrap(),1);Ok(())}).await.unwrap();
+    assert_eq!(cut.ordinal(),1,"sealed result did not wait for or change after public IO");
+    prepared.close();assert_eq!(handle.finish_local_media_cleanup(deadline()).await,ReplacementCleanupOutcome::LocalMediaClosed);
+}
+#[tokio::test]
+async fn native_cut_rejects_queued_private_video_local_audio_and_retired_ready_audio() {
+    let mut f=Preroll::new().await;enable_cut(&f);let prepared=f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob",72);delivered(&mut f.old_output,72).await;let private=outgoing(&mut f.target_output).await;
+    f.movement.queue_prompt(4000).unwrap();let local=f.movement.room.nodes.get_mut("device").unwrap().out.try_recv().unwrap();
+    // This real already-dequeued public old-owner audio is eligible for the
+    // adapter's ready-audio batch, but its original owner is retired by commit.
+    f.movement.room.publish("bob",3000).unwrap();f.movement.room.tick();
+    let old=f.movement.room.nodes.get_mut("alice").unwrap().out.try_recv().unwrap();assert!(old.can_batch_audio());
+    let adapter=f.movement.room.nodes["device"].adapter.clone();let port=adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+    let (outcome,handle)=f.movement.commit(f.movement.plan_with_video(Some(request())).unwrap()).await.unwrap();
+    let cut=native_video_cut(&outcome);assert_eq!(cut.ordinal(),0);
+    assert!(private.deliver(|_|async {panic!("private video reserved after cut")}).await.is_err());
+    assert!(local.deliver(|_|async {panic!("queued local preparation audio reserved after cut")}).await.is_err());
+    let results=QueuedMedia::deliver_ready_audio_batch(vec![old],|_,_,_|panic!("retired ready-audio work reserved after cut"));
+    assert!(matches!(&results[0],ReadyAudioDelivery::Refused{..}));
+    let old_adapter=&f.movement.room.nodes["alice"].adapter;let old_port=old_adapter.port(Medium::Audio);
+    assert!(cut_writer(old_adapter,&old_port,0).is_err(),"original retired writer itself must refuse");
+    assert_eq!(port.0.native_egress.get().unwrap().ordinal.load(Ordering::Acquire),0);
+    f.publish_video("bob",73);outgoing(&mut f.target_output).await.deliver(|_|async {cut_writer(&adapter,&port,0)?;Ok(())}).await.unwrap();
+    prepared.close();assert_eq!(handle.finish_local_media_cleanup(deadline()).await,ReplacementCleanupOutcome::LocalMediaClosed);
+}
+#[tokio::test]
+async fn native_cut_missing_original_writer_and_half_range_refuse_before_publication() {
+    for stopped in [false,true] {
+        let mut f=Preroll::new().await;enable_cut(&f);let prepared=f.prepare(CancellationToken::new()).await;
+        let adapter=&f.movement.room.nodes["device"].adapter;let port=adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+        let revision=f.movement.room.nodes["device"].controller.revision();
+        if stopped {drop(adapter.native_writers.lock().unwrap().remove(&port.binding().transport_id));}
+        else {port.0.native_egress.get().unwrap().ordinal.store(0x8000_0000,Ordering::Release);}
+        assert!(f.movement.commit(f.movement.plan_with_video(Some(request())).unwrap()).await.is_err());
+        assert_eq!(f.movement.room.nodes["device"].controller.revision(),revision);
+        assert!(!f.movement.room.nodes["alice"].controller.shutdown.is_cancelled());prepared.close();
+    }
+}
+#[tokio::test]
+async fn native_cut_muted_mapping_finishes_without_inventing_submission() {
+    let mut f=Preroll::new().await;enable_cut(&f);
+    let old=&f.movement.room.nodes["alice"].controller;
+    old.set_media_gate(old.revision(),&BTreeSet::from([desired(Medium::Video).logical_id]),StreamGateAction::Mute,deadline()).await.unwrap();
+    let (outcome,handle)=f.movement.commit(f.movement.plan_with_video(Some(request())).unwrap()).await.unwrap();
+    let receipt=outcome.media.replacement_activation.clone().unwrap();let cut=native_video_cut(&outcome);assert_eq!(cut.ordinal(),0);
+    f.publish_video("bob",74);assert!(f.target_output.try_recv().is_err());
+    assert_eq!(outcome.media.replacement_activation.as_ref(),Some(&receipt));
+    assert_eq!(handle.finish_local_media_cleanup(deadline()).await,ReplacementCleanupOutcome::LocalMediaClosed);
+}
+#[tokio::test]
+async fn native_cut_cancelled_commit_has_no_boundary_and_no_cursor_owner_cycle() {
+    let mut f=Preroll::new().await;enable_cut(&f);let prepared=f.prepare(CancellationToken::new()).await;
+    let adapter=f.movement.room.nodes["device"].adapter.clone();let port=adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+    let weak=Arc::downgrade(&port.0);let cursor=Arc::downgrade(port.0.native_egress.get().unwrap());
+    let plan=f.movement.plan_with_video(Some(request())).unwrap();let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+    let cancelled=CancellationToken::new();cancelled.cancel();
+    assert!(f.movement.room.scene.commit_audio_device_replacement(plan,deadline(),cancelled,&grant).await.is_err());
+    assert!(!f.movement.room.nodes["alice"].controller.shutdown.is_cancelled());drop(grant);prepared.close();drop(prepared);
+    for node in f.movement.room.nodes.values(){assert_eq!(node.controller.shutdown(deadline()).await,0);}
+    drop(port);drop(adapter);drop(f);assert!(weak.upgrade().is_none());assert!(cursor.upgrade().is_none());
+}
