+#[tokio::test(flavor="multi_thread",worker_threads=2)]
+async fn native_cut_waits_for_original_feedback_reader_then_retires_its_selection() {
+    let mut f=Preroll::new().await;enable_cut(&f);let prepared=f.prepare(CancellationToken::new()).await;
+    f.publish_video("bob",75);delivered(&mut f.old_output,75).await;
+    let private=feedback_delivery(&mut f.target_output,75).await;
+    let plan=f.movement.plan_with_video(Some(request())).unwrap();
+    let grant=f.movement.room.grant(Approval::Audience(plan.audience().clone())).await;
+    let (entered,seen)=tokio::sync::oneshot::channel();let (release,released)=std::sync::mpsc::channel();
+    let original=private.clone();
+    let reader=std::thread::spawn(move||original.dispatch(original.epoch(),31,|_,_| {
+        entered.send(()).unwrap();released.recv_timeout(Duration::from_secs(1)).unwrap();Ok(())
+    }));seen.await.unwrap();
+    let scene=f.movement.room.scene.clone();
