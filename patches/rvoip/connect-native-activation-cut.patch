diff --git a/crates/foundation/rvoip-core/src/staged_streams/native_activation.rs b/crates/foundation/rvoip-core/src/staged_streams/native_activation.rs
new file mode 100644
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/native_activation.rs
@@ -0,0 +1,167 @@
+//! Historical native packetization boundaries. No payload, IO permission,
+//! packet completion, strong controller, or independently running task.
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicU64};
+const MAX_ORDINAL: u64 = 9_007_199_254_740_991;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeEgressIdentity {
+    incarnation: u128,
+    connection: ConnectionId,
+    logical: StreamId,
+    transport: StreamId,
+    handle: u16,
+    generation: u64,
+    connection_generation: u64,
+}
+impl NativeEgressIdentity {
+    pub fn incarnation(&self) -> u128 { self.incarnation }
+    pub fn connection(&self) -> &ConnectionId { &self.connection }
+    pub fn logical(&self) -> &StreamId { &self.logical }
+    pub fn transport(&self) -> &StreamId { &self.transport }
+    pub fn handle(&self) -> u16 { self.handle }
+    pub fn generation(&self) -> u64 { self.generation }
+    pub fn connection_generation(&self) -> u64 { self.connection_generation }
+}
+pub(super) struct Cursor {
+    identity: NativeEgressIdentity,
+    owner: Weak<Port>,
+    pub(super) ordinal: AtomicU64,
+    live: AtomicBool,
+    feedback_issued:AtomicBool,
+}
+/// The adapter's sole original sequence allocator. Deliberately not Clone.
+/// Installation can happen only before the original egress reader is taken.
+pub struct NativeEgressWriter(Arc<Cursor>);
+impl NativeEgressWriter {
+    /// Reserve exactly one original outer sequence before any RTP/RTCP write.
+    /// Failed/partial writes keep that reservation; it is not an IO receipt.
+    pub fn reserve(&mut self,expected:u32)->ControlResult<u32>{self.0.reserve(Some(expected))}
+    pub fn reserve_next(&mut self)->ControlResult<u32>{self.0.reserve(None)}
+    /// One weak reservation capability for the existing original feedback
+    /// endpoint. It creates no task, current authority, or physical lifetime.
+    pub fn take_feedback_reservation(&mut self)->ControlResult<NativeFeedbackReservation>{
+        if self.0.feedback_issued.compare_exchange(false,true,Ordering::AcqRel,Ordering::Acquire).is_err(){return Err(StreamControlError::Authority);}
+        Ok(NativeFeedbackReservation(Arc::downgrade(&self.0)))
+    }
+}
+pub struct NativeFeedbackReservation(Weak<Cursor>);
+impl NativeFeedbackReservation {
+    pub fn reserve_next(&mut self)->ControlResult<u32>{self.0.upgrade().ok_or(StreamControlError::Cancelled)?.reserve(None)}
+}
+impl Cursor {
+    fn reserve(&self,expected:Option<u32>)->ControlResult<u32>{
+        let port=self.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+        let state=port.state.lock().map_err(|_|StreamControlError::Authority)?;
+        if !self.live.load(Ordering::Acquire)||!state.ready||!matches!(state.status,PortStatus::Active|PortStatus::Paused){return Err(StreamControlError::Cancelled);}
+        let ordinal=self.ordinal.load(Ordering::Relaxed);
+        if expected.is_some_and(|expected|ordinal as u32!=expected)||ordinal>=MAX_ORDINAL{return Err(StreamControlError::Authority);}
+        self.ordinal.store(ordinal+1,Ordering::Release);Ok(ordinal as u32)
+    }
+}
+
+impl Drop for NativeEgressWriter {
+    fn drop(&mut self) { self.0.live.store(false, Ordering::Release); }
+}
+impl AdapterMediaPort {
+    pub fn install_native_egress_cursor(&self) -> ControlResult<NativeEgressWriter> {
+        let output = self.0.output.lock().map_err(|_| StreamControlError::Authority)?;
+        let state = self.0.state.lock().map_err(|_| StreamControlError::Authority)?;
+        if state.status != PortStatus::Prepared || output.is_none() || !self.0.binding.sink_ready {
+            return Err(StreamControlError::Authority);
+        }
+        install(&self.0)
+    }
+    /// Original negotiation metadata only. Does not expose or clone the writer.
+    pub fn native_egress_identity(&self) -> Option<NativeEgressIdentity> {
+        self.0.native_egress.get().filter(|c|c.live.load(Ordering::Acquire)).map(|c|c.identity.clone())
+    }
+}
+fn install(port: &Arc<Port>) -> ControlResult<NativeEgressWriter> {
+    let owner=port.owner.upgrade().ok_or(StreamControlError::Cancelled)?;
+    let b=&port.binding;
+    let cursor=Arc::new(Cursor {
+        identity:NativeEgressIdentity { incarnation:uuid::Uuid::new_v4().as_u128(), connection:owner.connection.clone(),
+            logical:b.negotiated.requested.logical_id.clone(),transport:b.transport_id.clone(),handle:b.stream_local_id,
+            generation:b.generation,connection_generation:b.connection_generation },
+        owner:Arc::downgrade(port),ordinal:AtomicU64::new(0),live:AtomicBool::new(true),feedback_issued:AtomicBool::new(false),
+    });
+    port.native_egress.set(cursor.clone()).map_err(|_|StreamControlError::Authority)?;
+    Ok(NativeEgressWriter(cursor))
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeSequenceCut { identity:NativeEgressIdentity, ordinal:u64 }
+impl NativeSequenceCut {
+    pub fn identity(&self)->&NativeEgressIdentity { &self.identity }
+    pub fn ordinal(&self)->u64 { self.ordinal }
+    pub fn public_sequence_floor(&self)->u32 { self.ordinal as u32 }
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ReplacementActivationScope {
+    PublicNative,
+    PrivateConsultation { original_operation:String },
+    UnsupportedAdapter,
+}
+/// Minted only inside the compound replacement publication while the original
+/// private/audio/direct/port writers are quiesced. Never deserializable.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReplacementActivationBoundary {
+    operation:String, source:ConnectionId,target:ConnectionId,generation:u64,revision:u64,
+    scope:ReplacementActivationScope,streams:Vec<NativeSequenceCut>,
+}
+impl ReplacementActivationBoundary {
+    pub fn operation(&self)->&str { &self.operation }
+    pub fn source(&self)->&ConnectionId { &self.source }
+    pub fn target(&self)->&ConnectionId { &self.target }
+    pub fn generation(&self)->u64 { self.generation }
+    pub fn revision(&self)->u64 { self.revision }
+    pub fn scope(&self)->&ReplacementActivationScope { &self.scope }
+    pub fn streams(&self)->&[NativeSequenceCut] { &self.streams }
+}
+/// Caller holds every quiescence guard plus final model/authority checks. Only
+/// explicitly inherited receiving streams are included; an omitted, still
+/// quarantined auxiliary receiver is not silently assigned public membership.
+pub(super) fn capture(
+    replacement:&device_replacement::ReplacementIntent,
+    target:&Arc<StreamController>,state:&State,closed_audience:bool, inherited:&[(StreamId,LogicalStream)],revision:u64,
+)->ControlResult<ReplacementActivationBoundary> {
+    if target.connection!=replacement.request.admitted || state.closed || target.shutdown.is_cancelled() {
+        return Err(StreamControlError::Authority);
+    }
+    let mut result=ReplacementActivationBoundary { operation:replacement.request.operation_id.clone(),
+        source:replacement.request.source.clone(),target:target.connection.clone(),
+        generation:replacement.pending.generation(),revision,scope:ReplacementActivationScope::UnsupportedAdapter,streams:vec![] };
+    let valid_id=|v:&str|!v.is_empty() && v.len()<=256 && !v.chars().any(char::is_control);
+    if !valid_id(&result.operation) || !valid_id(result.source.as_str()) || !valid_id(result.target.as_str()) || result.source==result.target ||
+        !(1..=MAX_ORDINAL).contains(&result.generation) || !(3..=MAX_ORDINAL).contains(&revision) {return Err(StreamControlError::Authority);}
+    if let Some(parent)=replacement.private_consultation_parent() {
+        if !valid_id(parent) {return Err(StreamControlError::Authority);}
+        result.scope=ReplacementActivationScope::PrivateConsultation { original_operation:parent.to_owned() };
+        return Ok(result);
+    }
+    if closed_audience && target.adapter.native_sequence_cursors(){return Err(StreamControlError::Authority);}
+    let ports=state.active.values().filter(|p|p.binding.sink_ready && p.binding.negotiated.requested.medium!=Medium::Data &&
+        inherited.iter().any(|(id,_)|*id==p.binding.negotiated.requested.logical_id)).collect::<Vec<_>>();
+    if ports.is_empty() || ports.len()>32 { return Err(StreamControlError::Authority); }
+    if !target.adapter.native_sequence_cursors() { return Ok(result); }
+    let (mut handles,mut physical)=(BTreeSet::new(),BTreeSet::new());
+    for port in ports {
+        let current=port.state.lock().map_err(|_|StreamControlError::Authority)?;
+        if !current.ready || !matches!(current.status,PortStatus::Active|PortStatus::Paused) { return Err(StreamControlError::NotReady); }
+        let cursor=port.native_egress.get().ok_or(StreamControlError::NotReady)?;
+        let b=&port.binding;let i=&cursor.identity;
+        if !cursor.live.load(Ordering::Acquire) || !Weak::ptr_eq(&cursor.owner,&Arc::downgrade(port)) ||
+            i.connection!=target.connection || i.logical!=b.negotiated.requested.logical_id || i.transport!=b.transport_id ||
+            i.handle!=b.stream_local_id || i.generation!=b.generation || i.connection_generation!=result.generation {
+            return Err(StreamControlError::Authority);
+        }
+        if !valid_id(i.logical.as_str()) || i.handle==0 || !(1..=MAX_ORDINAL).contains(&i.generation) ||
+            i.incarnation==0 || !handles.insert(i.handle) || !physical.insert(i.incarnation) {return Err(StreamControlError::Authority);}
+        let ordinal=cursor.ordinal.load(Ordering::Acquire);
+        if ordinal>=MAX_ORDINAL || ordinal>=0x8000_0000 { return Err(StreamControlError::Authority); }
+        result.streams.push(NativeSequenceCut {identity:i.clone(),ordinal});
+    }
+    result.streams.sort_by(|a,b|a.identity.logical.cmp(&b.identity.logical));
+    result.scope=ReplacementActivationScope::PublicNative;
+    Ok(result)
+}
diff --git a/crates/foundation/rvoip-core/src/staged_streams/tests/private_consult/replacement/video/preroll/native_cut.rs b/crates/foundation/rvoip-core/src/staged_streams/tests/private_consult/replacement/video/preroll/native_cut.rs
