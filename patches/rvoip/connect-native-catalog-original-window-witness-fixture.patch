+// Same exact source/selector snapshots as the old final direct read, obtained
+// by the actual ordinary runtime instead. A late/straddling read gets NO credit.
+#[cfg(feature = "test-support")]
+fn catalog_window_snapshot(
+    rows: &[CatalogObserved],
+    before: &rvoip_core::staged_streams::subscription_plan::MediaSubscriptionPlan,
+    start: Instant,
+    until: Instant,
+) -> Result<Option<rvoip_core::staged_streams::subscription_plan::MediaSubscriptionPlan>, &'static str> {
+    let mut recovered = None;
+    for row in rows.iter().filter(|row| row.started >= start && row.at <= until) {
+        if row.at < row.started { return Err("invalid original plan time bracket"); }
+        match &row.outcome {
+            CatalogObservedOutcome::Planned { same_catalog, selection } => {
+                if !*same_catalog || !before.same_catalog(selection) { return Err("actual background catalog changed"); }
+                recovered = Some(selection.clone());
+            }
+            CatalogObservedOutcome::Refused(NativeOfferError::Dispatch(DispatchError::StorageUnavailable)) if row.leaf.is_some() => {},
+            _ => return Err("original background result was not an unchanged plan or explicit catalog metadata Busy"),
+        }
+    }
+    Ok(recovered)
+}
