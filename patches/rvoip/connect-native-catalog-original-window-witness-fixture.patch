+// A direct fixture snapshot may encounter the same explicit metadata exclusion
+// as the ordinary poller. Retry ONLY that pre-effect decision, with no reader
+// held and no renewed deadline. Callers still observe their WHOLE old window.
+#[cfg(feature = "test-support")]
+async fn catalog_snapshot_before(
+    s: &Scene,
+    until: Instant,
+) -> Result<Option<rvoip_core::staged_streams::subscription_plan::MediaSubscriptionPlan>, rvoip_core::orchestrator::participant_control::ParticipantControlError> {
+    use rvoip_core::orchestrator::participant_control::ParticipantControlError;
+    use rvoip_core::staged_streams::subscription_plan::{CatalogReadDiagnosticsForTest, MediaSelectionChange};
+    loop {
+        if Instant::now() >= until { return Ok(None); }
+        let mut diagnostics = CatalogReadDiagnosticsForTest::default();
+        match s.native.core.orch.plan_staged_media_selection_diagnosed_for_test(
+            &s.native.core.session, &s.second_id, 3, &MediaSelectionChange::Reconcile, &mut diagnostics,
+        ) {
+            Ok(plan) => return Ok((Instant::now() <= until).then_some(plan)),
+            Err(ParticipantControlError::Media(StreamControlError::Backpressure)) if diagnostics.busy_leaf.is_some() => {
+                tokio::task::yield_now().await;
+            }
+            Err(error) => return Err(error),
+        }
+    }
+}
