+#[cfg(feature = "test-support")]
+async fn observed_catalog_baseline(
+    s: &Scene,
+    policy: &Policy,
+    kind: &str,
+    phase: &str,
+) -> (rvoip_core::staged_streams::subscription_plan::MediaSubscriptionPlan, tokio::sync::mpsc::Receiver<CatalogObserved>) {
+    let until = Instant::now() + Duration::from_millis(650);
+    let before = catalog_snapshot_before(s, until).await.unwrap().expect("original650ms baseline needs an actual metadata snapshot");
+    let mut observations = arm_catalog_probe(policy, &s.second_id, &before);
+    let armed = Instant::now();
+    // Existing Core selection wake hint: unlike policy.changed, its runtime
+    // branch does NOT clear last or request another policy reconciliation.
+    s.native.core.orch.staged_media_selection_changes(&s.native.core.session).unwrap().notify_waiters();
+    tokio::time::sleep_until(until).await;
+    let (rows, overflow) = drain_catalog_rows(&mut observations);
+    let dropped = policy.catalog_probe.get().unwrap().dropped.load(Ordering::Relaxed);
+    eprintln!("catalog baseline kind={kind} phase={phase} armed={armed:?} until={until:?} dropped={dropped} overflow={overflow} rows={rows:?}");
+    assert!(dropped == 0 && !overflow, "baseline observations must be complete");
+    let actual = catalog_window_snapshot(&rows, &before, armed, until).unwrap().expect("original650ms baseline requires a real post-arm ordinary background plan");
+    assert!(before.same_catalog(&actual));
+    (before, observations)
+}
