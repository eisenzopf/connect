+#[cfg(feature = "test-support")]
+fn drain_catalog_rows(rx: &mut tokio::sync::mpsc::Receiver<CatalogObserved>) -> (Vec<CatalogObserved>, bool) {
+    let rows = std::iter::from_fn(|| rx.try_recv().ok()).take(128).collect();
+    let overflow = rx.try_recv().is_ok();
+    (rows, overflow)
+}
