+#[tokio::test]
+async fn activated_closed_muted_endpoint_keeps_plan_identity_and_observer_isolation_until_real_duplex(
+) {
+    for observer in [false, true] {
+        let mut room = Room::new().await;
+        room.add("fresh", Some("public"), true).await;
+        let id = ConnectionId::from_string("fresh");
+        if observer {
+            room.scene
+                .role_targets(&[id.clone()])
+                .remove(0)
+                .prepare_role(deadline(), CancellationToken::new())
+                .await
+                .unwrap()
+                .commit(false);
+        }
+        let mut plan = room
+            .scene
+            .plan_audio_audience(AudioAudienceRequest {
+                operation_id: "activate-isolated-fresh".into(),
+                expected_revision: room.scene.audience_revision(),
+                private_connections: BTreeSet::from([id.clone()]),
+                receivers: BTreeMap::from([(id.clone(), vec![])]),
+                activate_muted: Some(id.clone()),
+            })
+            .unwrap();
+        let ordinary = plan.clone();
+        assert!(plan
+            .keep_endpoint_muted(&ConnectionId::from_string("bob"))
+            .is_err());
+        plan.keep_endpoint_muted(&id).unwrap();
+        assert!(!plan.same_intent(&ordinary));
+        assert!(plan.same_intent(&plan.clone()));
+        let grant = room.grant(Approval::Audience(plan.clone())).await;
+        let (_, context) = room
+            .scene
+            .apply_audio_audience(plan, deadline(), CancellationToken::new(), &grant)
+            .await
+            .unwrap();
+        drop(grant);
+        assert!(room.publish("fresh", 12000).is_err());
+        room.domain
+            .local_preparations
+            .lock()
+            .unwrap()
+            .insert(id.clone(), context.operation_id().into());
+        let preparation = room
+            .scene
+            .prepare_audio_endpoint(&id, context.operation_id())
+            .unwrap();
+        let mut target = Target {
+            room,
+            preparation,
+            operation: context.operation_id().into(),
+        };
+        assert!(!target.preparation.has_duplex_io());
+        target.room.publish("fresh", 12000).unwrap();
+        target.room.tick();
+        target
+            .room
+            .silent(&["alice", "bob", "public", "hold", "fresh"]);
+        assert!(!target.preparation.has_duplex_io());
+        target.queue();
+        target.room.heard("fresh", 0).await;
+        assert!(target.preparation.has_duplex_io());
+        let controller = &target.room.nodes["fresh"].controller;
+        assert!(
+            controller.state.lock().unwrap().model.streams()[&desired(Medium::Audio).logical_id]
+                .source_muted
+        );
+        assert_eq!(
+            controller
+                .audio_consumer
+                .lock()
+                .unwrap()
+                .as_ref()
+                .unwrap()
+                .upgrade()
+                .unwrap()
+                .role_snapshot()
+                .0,
+            !observer
+        );
+        target.room.scene.remove(&id);
+        assert!(!target
+            .room
+            .scene
+            .audiences
+            .lock()
+            .unwrap()
+            .groups
+            .contains_key(context.operation_id()));
+        assert!(!target.preparation.has_duplex_io());
+    }
+}
