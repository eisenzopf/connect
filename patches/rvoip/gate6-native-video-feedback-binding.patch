+//! Real canonical local QUIC driver + Core/adapter dispatch. Epoch announcement
+//! is a controlled provider: these cases do NOT prove signed epoch negotiation.
+use super::*;
+use rvoip_core::staged_streams::direct_subscriptions::*;
+#[derive(Default)]
+struct Notices {
+    values: std::sync::Mutex<Vec<(ReadyMediaBinding, VideoFeedbackEpoch)>>,
+    refuse: AtomicBool,
+}
+impl VideoFeedbackProfile for Notices {
+    fn announce(
+        &self,
+        binding: &ReadyMediaBinding,
+        epoch: VideoFeedbackEpoch,
+    ) -> ControlResult<()> {
+        if self.refuse.load(Ordering::Acquire) {
+            return Err(StreamControlError::Backpressure);
+        }
+        self.values.lock().unwrap().push((binding.clone(), epoch));
+        Ok(())
+    }
+}
+impl Notices {
+    fn latest(&self, handle: u16, publisher: bool) -> VideoFeedbackEpoch {
+        self.values
+            .lock()
+            .unwrap()
+            .iter()
+            .rev()
+            .find(|(b, e)| b.stream_local_id == handle && e.publisher == publisher)
+            .unwrap()
+            .1
+    }
+    async fn announced(&self, handle: u16, publisher: bool) {
+        core_fixture::until(|| {
+            self.values
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|(b, e)| b.stream_local_id == handle && e.publisher == publisher)
+        })
+        .await;
+    }
+}
+async fn select(n: &Network, source: &Leg, receiver: &Leg) {
+    let logical = desired(Medium::Video).logical_id;
+    receiver
+        .controller
+        .change_direct_subscriptions(
+            receiver.controller.revision(),
+            DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                &source.controller,
+                logical.clone(),
+                logical,
+            )]),
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+        .unwrap();
+    assert!(n.wire.quic.is_some());
+}
+fn request(handle: u16, e: VideoFeedbackEpoch, seq: u32) -> VideoFeedbackDatagram {
+    VideoFeedbackDatagram {
+        stream_local_id: handle,
+        seq,
+        sender_ssrc: 83,
+        media_ssrc: e.ssrc,
+        activation_epoch: e.epoch,
+    }
+}
+async fn rejected(n: &Network, leg: &Leg, request: &VideoFeedbackDatagram) {
+    let before = leg.media.snapshot().feedback_rejected;
+    send(&n.wire, pack_video_feedback_datagram(request).unwrap());
+    core_fixture::until(|| leg.media.snapshot().feedback_rejected > before).await;
+}
+async fn feedback(n: &Network) -> VideoFeedbackDatagram {
+    let bytes = tokio::time::timeout(
+        Duration::from_secs(2),
+        n.wire.quic.as_ref().unwrap().2.read_datagram(),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    observe_video_feedback_datagram(&bytes).unwrap()
+}
+fn source_video(handle: u16, seq: u16, ssrc: u32) -> Bytes {
+    let mut packet = vec![0x80, 0x80 | 96];
+    packet.extend_from_slice(&seq.to_be_bytes());
+    packet.extend_from_slice(&(u32::from(seq) * 3000).to_be_bytes());
+    packet.extend_from_slice(&ssrc.to_be_bytes());
+    packet.extend_from_slice(&[0x10, 1, 2, 3]);
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {
+        flags: 0,
+        stream_local_id: handle,
+        seq: u32::from(seq),
+        rtp: observe_rtp(packet.into()).unwrap(),
+    })
+    .unwrap()
+}
+#[tokio::test]
+async fn native_feedback_binds_actual_handles_ssrc_epochs_authority_and_shared_publisher_rate() {
+    let mut n = Network::new("quic").await;
+    let a = n.configure(0).await;
+    let b = n.configure(1).await;
+    let c = n.configure(2).await;
+    let notices = Arc::new(Notices::default());
+    for leg in [&a, &b, &c] {
+        *leg.readiness.feedback.lock().unwrap() = Some(notices.clone());
+        n.start(leg, &[Medium::Audio, Medium::Video]).await;
+    }
+    select(&n, &a, &b).await;
+    select(&n, &a, &c).await;
+    let ah = binding(&a, Medium::Video).stream_local_id;
+    let bh = binding(&b, Medium::Video).stream_local_id;
+    let ch = binding(&c, Medium::Video).stream_local_id;
+    let mut input = a
+        .controller
+        .take_ingress(&desired(Medium::Video).logical_id)
+        .unwrap();
+    send(&n.wire, source_video(ah, 1, 7));
+    let incoming = packet(&mut input).await;
+    for leg in [&b, &c] {
+        incoming
+            .try_forward_to(&leg.controller, &desired(Medium::Video).logical_id)
+            .unwrap();
+    }
+    let outputs = [received(&n.wire).await, received(&n.wire).await];
+    for h in [bh, ch] {
+        notices.announced(h, false).await;
+    }
+    notices.announced(ah, true).await;
+    let publisher = notices.latest(ah, true);
+    let be = notices.latest(bh, false);
+    let ce = notices.latest(ch, false);
+    assert_ne!(be.epoch, ce.epoch);
+    assert_ne!(be.epoch, publisher.epoch);
+    for out in outputs {
+        let e = notices.latest(out.stream_local_id, false);
+        assert_eq!(e.ssrc, out.rtp.packet().header.ssrc);
+        assert_eq!(out.rtp.packet().header.timestamp, 3000);
+    }
+    // Echoing another stream's real epoch/SSRC is insufficient.
+    let good = request(bh, be, 900);
+    let mut wrong = good.clone();
+    wrong.stream_local_id = ch;
+    rejected(&n, &b, &wrong).await;
+    wrong = good.clone();
+    wrong.media_ssrc = wrong.media_ssrc.wrapping_add(1).max(1);
+    rejected(&n, &b, &wrong).await;
+    wrong = good.clone();
+    wrong.activation_epoch = publisher.epoch;
+    rejected(&n, &b, &wrong).await;
+    send(&n.wire, pack_video_feedback_datagram(&good).unwrap());
+    let first = feedback(&n).await;
+    assert_eq!(first.stream_local_id, ah);
+    assert_eq!(first.media_ssrc, 7);
+    assert_eq!(first.activation_epoch, publisher.epoch);
+    assert_eq!(first.seq, 0);
+    assert_ne!(first.sender_ssrc, good.sender_ssrc);
+    rejected(&n, &b, &good).await; // duplicate
+    rejected(&n, &c, &request(ch, ce, 800)).await; // separate receiver, same source limit
+    tokio::time::sleep(Duration::from_millis(110)).await;
+    send(
+        &n.wire,
+        pack_video_feedback_datagram(&request(ch, ce, 801)).unwrap(),
+    );
+    let next = feedback(&n).await;
+    assert_eq!(next.seq, 1);
+    assert_eq!(next.activation_epoch, publisher.epoch);
+    // No retained permission: either current endpoint's denial refuses dispatch.
+    for denied in [&a, &b] {
+        n.grants.0.write().await.denied.insert(denied.id.clone());
+        rejected(&n, &b, &request(bh, be, 901)).await;
+        n.grants.0.write().await.denied.remove(&denied.id);
+    }
+    n.grants.0.write().await.private = true;
+    rejected(&n, &b, &request(bh, be, 901)).await;
+    n.grants.0.write().await.private = false;
+    // Changing the actual publisher SSRC replaces both announced histories.
+    send(&n.wire, source_video(ah, 2, 19));
+    packet(&mut input)
+        .await
+        .try_forward_to(&b.controller, &desired(Medium::Video).logical_id)
+        .unwrap();
+    let out = received(&n.wire).await;
+    core_fixture::until(|| notices.latest(bh, false).ssrc != be.ssrc).await;
+    let fresh = notices.latest(bh, false);
+    let fresh_source = notices.latest(ah, true);
+    assert_eq!(fresh.ssrc, out.rtp.packet().header.ssrc);
+    assert_ne!(fresh_source.epoch, publisher.epoch);
+    rejected(&n, &b, &request(bh, be, 902)).await;
+    tokio::time::sleep(Duration::from_millis(110)).await;
+    send(
+        &n.wire,
+        pack_video_feedback_datagram(&request(bh, fresh, 902)).unwrap(),
+    );
+    let changed = feedback(&n).await;
+    assert_eq!(changed.media_ssrc, 19);
+    assert_eq!(changed.activation_epoch, fresh_source.epoch);
+    assert_eq!(changed.seq, 2);
+    b.controller
+        .change_direct_subscriptions(
+            b.controller.revision(),
+            DirectSubscriptionChange::Clear,
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+        .unwrap();
+    rejected(&n, &b, &request(bh, fresh, 903)).await;
+    assert!(n.grants.0.try_write().is_ok());
+    assert_eq!(a.controller.shutdown(deadline()).await, 0);
+    rejected(&n, &c, &request(ch, ce, 802)).await;
+    assert_eq!(b.controller.shutdown(deadline()).await, 0);
+    assert_eq!(c.controller.shutdown(deadline()).await, 0);
+    n.stop().await;
+}
