+//! One bounded feedback endpoint per physical stream allocation. No payload,
+//! retained permission, detached send, or global source registry.
+use super::*;
+use crate::substrate::{pack_video_feedback_datagram, VideoFeedbackDatagram};
+use rvoip_core::stream::MediaSourceClock;
+use std::time::{Duration, Instant};
+
+/// Metadata describing an actually admitted publisher or submitted receiver
+/// packet. This is not readiness or a permission to use prepared media.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VideoFeedbackEpoch {
+    pub publisher: bool,
+    pub epoch: u128,
+    pub ssrc: u32,
+}
+/// Installed only by a profile that separately negotiated rtcp-pli-epoch/1 for
+/// this exact binding. Implementations must bind notices to the authenticated
+/// original operation, physical incarnation, logical stream and generations.
+/// The callback performs bounded nonblocking local admission of that signed
+/// notice, with no policy reentry. Success is not remote receipt. Returning an
+/// error leaves feedback disabled for the unannounced epoch; media is not retried.
+pub trait VideoFeedbackProfile: Send + Sync {
+    fn announce(&self, binding: &ReadyMediaBinding, epoch: VideoFeedbackEpoch)
+        -> ControlResult<()>;
+}
+struct Publisher {
+    epoch: VideoFeedbackEpoch,
+    current: Arc<dyn Fn() -> bool + Send + Sync>,
+    clock: (u128, u64),
+    announced: bool,
+}
+struct Receiver {
+    route: VideoFeedbackRoute,
+    ssrc: u32,
+    source_ssrc: u32,
+    announced: bool,
+}
+#[derive(Default)]
+struct SourceState {
+    publisher: Option<Publisher>,
+    next: Option<Instant>,
+    sequence: u32,
+}
+pub(super) struct Endpoint {
+    binding: ReadyMediaBinding,
+    profile: Arc<dyn VideoFeedbackProfile>,
+    transport: Arc<dyn StagedDatagramTransport>,
+    cancel: CancellationToken,
+    lifetime: CancellationToken,
+    source: Mutex<SourceState>,
+    receiver: Mutex<Option<Receiver>>,
+}
+impl Endpoint {
+    pub fn new(
+        binding: ReadyMediaBinding,
+        profile: Arc<dyn VideoFeedbackProfile>,
+        transport: Arc<dyn StagedDatagramTransport>,
+        cancel: CancellationToken,
+        lifetime: CancellationToken,
+    ) -> ControlResult<Arc<Self>> {
+        if binding.negotiated.requested.medium != Medium::Video {
+            return Err(StreamControlError::Unsupported);
+        }
+        Ok(Arc::new(Self {
+            binding,
+            profile,
+            transport,
+            cancel,
+            lifetime,
+            source: Mutex::new(SourceState::default()),
+            receiver: Mutex::new(None),
+        }))
+    }
+    fn live(&self) -> bool {
+        !self.cancel.is_cancelled() && !self.lifetime.is_cancelled() && !self.transport.is_closed()
+    }
+    // Called only after the original ingress packet was accepted, using its
+    // weak current clock/generation predicate. No packet custody is extended.
+    pub fn published(&self, ssrc: u32, clock: MediaSourceClock) -> ControlResult<()> {
+        if !self.live() || !self.binding.source_ready || ssrc == 0 || !(clock.is_current)() {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut state = self
+            .source
+            .try_lock()
+            .map_err(|_| StreamControlError::Backpressure)?;
+        let identity = (clock.source_id, clock.generation);
+        if state
+            .publisher
+            .as_ref()
+            .is_none_or(|p| p.epoch.ssrc != ssrc || p.clock != identity || !(p.current)())
+        {
+            state.publisher = Some(Publisher {
+                epoch: VideoFeedbackEpoch {
+                    publisher: true,
+                    epoch: uuid::Uuid::new_v4().as_u128(),
+                    ssrc,
+                },
+                current: clock.is_current,
+                clock: identity,
+                announced: false,
+            });
+        }
+        let publisher = state.publisher.as_mut().unwrap();
+        if !publisher.announced {
+            self.profile.announce(&self.binding, publisher.epoch)?;
+            publisher.announced = true;
+        }
+        Ok(())
+    }
+    pub fn delivered(
+        &self,
+        route: VideoFeedbackRoute,
+        ssrc: u32,
+        source_ssrc: u32,
+    ) -> ControlResult<()> {
+        if !self.live() || !self.binding.sink_ready || ssrc == 0 || source_ssrc == 0 {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut state = self
+            .receiver
+            .try_lock()
+            .map_err(|_| StreamControlError::Backpressure)?;
+        if state.as_ref().is_none_or(|r| {
+            r.route.epoch() != route.epoch() || r.ssrc != ssrc || r.source_ssrc != source_ssrc
+        }) {
+            *state = Some(Receiver {
+                route,
+                ssrc,
+                source_ssrc,
+                announced: false,
+            });
+        }
+        let receiver = state.as_mut().unwrap();
+        if !receiver.announced {
+            self.profile.announce(
+                &self.binding,
+                VideoFeedbackEpoch {
+                    publisher: false,
+                    epoch: receiver.route.epoch(),
+                    ssrc,
+                },
+            )?;
+            receiver.announced = true;
+        }
+        Ok(())
+    }
+    pub fn receive(&self, request: &VideoFeedbackDatagram) -> ControlResult<()> {
+        if !self.live() || request.stream_local_id != self.binding.stream_local_id {
+            return Err(StreamControlError::Authority);
+        }
+        let (route, source_ssrc) = {
+            let state = self
+                .receiver
+                .try_lock()
+                .map_err(|_| StreamControlError::Backpressure)?;
+            let receiver = state.as_ref().ok_or(StreamControlError::NotReady)?;
+            if !receiver.announced
+                || request.media_ssrc != receiver.ssrc
+                || request.activation_epoch != receiver.route.epoch()
+            {
+                return Err(StreamControlError::Authority);
+            }
+            (receiver.route.clone(), receiver.source_ssrc)
+        };
+        route.dispatch(request.activation_epoch, request.seq, |port, _| {
+            // Resolve the source from Core's admitted physical port. Never
+            // accept a source handle, identity or transport supplied by a peer.
+            let allocation = port
+                .allocation_owner()?
+                .downcast::<RouterHandle>()
+                .map_err(|_| StreamControlError::Authority)?;
+            if allocation.id.get() != port.binding().stream_local_id
+                || allocation.cancellation.is_cancelled()
+            {
+                return Err(StreamControlError::Cancelled);
+            }
+            let source = allocation
+                .feedback
+                .try_lock()
+                .map_err(|_| StreamControlError::Backpressure)?
+                .clone()
+                .ok_or(StreamControlError::Unsupported)?;
+            if !same_binding(&source.binding, port.binding()) {
+                return Err(StreamControlError::Authority);
+            }
+            source.dispatch(source_ssrc)
+        })
+    }
+    // Only called under Core's fresh source+receiver authority and generation
+    // guards. A shared publisher limit also bounds fan-in from many receivers.
+    fn dispatch(&self, ssrc: u32) -> ControlResult<()> {
+        if !self.live() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let mut state = self
+            .source
+            .try_lock()
+            .map_err(|_| StreamControlError::Backpressure)?;
+        let publisher = state
+            .publisher
+            .as_ref()
+            .ok_or(StreamControlError::NotReady)?;
+        if !publisher.announced || publisher.epoch.ssrc != ssrc || !(publisher.current)() {
+            return Err(StreamControlError::Authority);
+        }
+        let epoch = publisher.epoch.epoch;
+        let now = Instant::now();
+        if state.next.is_some_and(|next| now < next) {
+            return Err(StreamControlError::Backpressure);
+        }
+        let bytes = pack_video_feedback_datagram(&VideoFeedbackDatagram {
+            stream_local_id: self.binding.stream_local_id,
+            seq: state.sequence,
+            sender_ssrc: 1,
+            media_ssrc: ssrc,
+            activation_epoch: epoch,
+        })
+        .map_err(|_| StreamControlError::NotReady)?;
+        if self
+            .transport
+            .maximum_datagram_bytes()
+            .is_none_or(|max| max < bytes.len())
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        // Consume even an uncertain local send. Never retransmit one request
+        // behind renewed policy, or pass the receiver's sequence to a source.
+        state.sequence = state.sequence.wrapping_add(1);
+        state.next = Some(now + Duration::from_millis(100));
+        self.transport.send_datagram(bytes)
+    }
+}
