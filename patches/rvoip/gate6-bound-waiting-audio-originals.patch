+
+#[tokio::test]
+async fn guarded_mixer_playing_long_original_keeps_its_remainder_and_latest_future_packet() {
+    for rate in [8000, 48000] {
+        let s = Scene::new(&four()[..2], rate).await;
+        s.bind(0, true).await;
+        s.bind(1, true).await;
+        let mut out = s.port(1).take_egress().unwrap();
+        let budget = s.controllers[0].stream_open_budget();
+        s.publish_duration(0, 1000, 0, 5);
+        s.publish_at(0, 3000, 800);
+        s.publish_at(0, 5000, 960);
+        s.publish_at(0, 7000, 1120);
+        for _ in 0..5 {
+            s.mixer.tick();
+            heard(out.try_recv().unwrap(), 1000).await;
+            drop(
+                s.policy
+                    .0
+                    .try_write()
+                    .expect("pending original retained idle authority"),
+            );
+        }
+        s.mixer.tick();
+        heard(out.try_recv().unwrap(), 7000).await;
+        s.mixer.tick();
+        assert!(
+            out.try_recv().is_err(),
+            "trimmed future originals replayed later"
+        );
+        assert_eq!(budget, s.controllers[0].stream_open_budget());
+    }
+}
