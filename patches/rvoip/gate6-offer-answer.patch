+#[tokio::test]
+async fn resumed_step_up_offer_writes_answer_and_preserves_authentication_transition_replies() {
+    let (f, p, h) = setup(Mode::Normal);
+    p.require_user.store(true, Ordering::Release);
+    let mut w = open("quic", &f, h.clone(), None).await;
+    let offer = offered();
+    w.send(f.sign(offer.clone())).await;
+    let challenge = w.read().await;
+    assert_eq!(challenge.kind(), "identity.step-up-request");
+    let mut next = envelope(
+        "identity.step-up-response",
+        json!({"method":"bearer","credential":"user"}),
+    );
+    next["in_reply_to"] = json!(challenge.id());
+    for key in ["cid", "sid", "connid", "operation_id"] {
+        next[key] = offer[key].clone();
+    }
+    w.send(f.sign(next)).await;
+    let answer = w.read().await;
+    assert_eq!(answer.kind(), "connection.answer");
+    assert_eq!(answer.scope(Scope::Reply), offer["id"].as_str());
+    f.verify_server(&answer).await;
+    assert_eq!(w.read().await.kind(), "auth.session");
+    assert_eq!(w.read().await.kind(), "identity.assurance-changed");
+    assert!(tokio::time::timeout(Duration::from_millis(40), w.read())
+        .await
+        .is_err());
+    w.send(f.sign(query())).await;
+    assert_eq!(w.read().await.kind(), "ack");
+    w.server.shutdown().await.unwrap();
+}
