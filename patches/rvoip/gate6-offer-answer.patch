new file mode 100644
--- /dev/null
+++ b/crates/uctp/rvoip-uctp/tests/support/offer_answers.rs
@@ -0,0 +1,646 @@
+//! Real signed answers during one ongoing offer; no media readiness is inferred.
+use super::*;
+use rvoip_uctp::v2::server::{NativeTransportContext, PhysicalHandlerFactory};
+use std::sync::Mutex;
+struct Grants {
+    deny: bool,
+}
+struct Proof {
+    _base: AuthorityLease,
+    grant: tokio::sync::OwnedRwLockReadGuard<Grants>,
+}
+struct AnswerPolicy {
+    base: Arc<Policy>,
+    grants: Arc<RwLock<Grants>>,
+    approvals: AtomicUsize,
+    require_user: AtomicBool,
+    allow_rpc: AtomicBool,
+}
+#[async_trait]
+impl PeerAuthority for AnswerPolicy {
+    fn authority_lifetime(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        h: &AuthorityLease,
+    ) -> Result<AuthorityLifetime, DispatchError> {
+        self.base.authority_lifetime(c, d, i, h)
+    }
+    async fn identity(&self, c: &ValidatedBearer, d: &Device) -> Result<Identifier, DispatchError> {
+        self.base.identity(c, d).await
+    }
+    async fn acquire(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let base = self.base.guard(c, d, i, e).await?;
+        if e.kind() != "connection.offer" {
+            return Ok(base);
+        }
+        Ok(AuthorityLease::holding(Proof {
+            _base: base,
+            grant: self.grants.clone().read_owned().await,
+        }))
+    }
+    async fn refresh(
+        &self,
+        a: &ValidatedBearer,
+        b: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.base.refresh(a, b, d, i, e).await
+    }
+    fn assurance_requirement(
+        &self,
+        _: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        e: &Envelope,
+    ) -> Result<Option<AssuranceRequirement>, DispatchError> {
+        Ok(
+            (self.require_user.load(Ordering::Acquire) && e.kind() == "connection.offer").then(
+                || AssuranceRequirement::UserAuthorized {
+                    user_id: rvoip_core::IdentityId::from_string("user-alice"),
+                    scopes: vec!["control".into()],
+                },
+            ),
+        )
+    }
+    async fn step_up(
+        &self,
+        previous: &ValidatedBearer,
+        next: &ValidatedBearer,
+        d: &Device,
+        i: &Identifier,
+        _: &AssuranceRequirement,
+        _: &Envelope,
+        response: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let base = self.base.guard(next, d, i, response).await?;
+        let revoked = base
+            .authority::<tokio::sync::OwnedRwLockReadGuard<HashSet<String>>>()
+            .ok_or(DispatchError::Authority)?;
+        if previous.principal.is_expired()
+            || !previous.principal.has_same_owner(&next.principal)
+            || previous
+                .token_id
+                .as_ref()
+                .is_none_or(|id| revoked.contains(id))
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(Proof {
+            _base: base,
+            grant: self.grants.clone().read_owned().await,
+        }))
+    }
+    fn exchange_request(
+        &self,
+        _: &ValidatedBearer,
+        _: &Device,
+        _: &Identifier,
+        offer: &Envelope,
+        request: &Envelope,
+        held: &AuthorityLease,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let proof = held.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if !self.allow_rpc.load(Ordering::Acquire)
+            || proof.grant.deny
+            || offer.kind() != "connection.offer"
+            || request.kind() != "connection.update"
+        {
+            return Err(DispatchError::Unsupported);
+        }
+        Ok(held.retained())
+    }
+    fn negotiation_answer(
+        &self,
+        c: &ValidatedBearer,
+        d: &Device,
+        _: &Identifier,
+        offer: &Envelope,
+        answer: &Envelope,
+        h: &AuthorityLease,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let proof = h.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if proof.grant.deny
+            || c.principal.subject != "alice"
+            || d.id.as_str() != "device_alice"
+            || offer.kind() != "connection.offer"
+            || answer.original()["payload"]["by_participant"] != "part_alice"
+        {
+            return Err(DispatchError::ScopeDenied);
+        }
+        self.approvals.fetch_add(1, Ordering::AcqRel);
+        Ok(h.retained())
+    }
+}
+#[derive(Clone, Copy)]
+enum Mode {
+    Normal,
+    WrongScopes,
+    Concurrent,
+    DuplicateFinal,
+    NoWrite,
+    Saved,
+    Pending,
+    Partial,
+    CapacityRetry,
+}
+struct AnswerHandler {
+    mode: Mode,
+    entered: Notify,
+    release: Notify,
+    finished: Notify,
+    full: Notify,
+    hold: AtomicBool,
+    large_control: AtomicBool,
+    errors: Mutex<Vec<DispatchError>>,
+    saved: Mutex<Option<Arc<AuthorizedEnvelope>>>,
+    written: AtomicUsize,
+    connection: Mutex<Option<::quinn::Connection>>,
+}
+impl AnswerHandler {
+    fn new(mode: Mode) -> Self {
+        Self {
+            mode,
+            entered: Notify::new(),
+            release: Notify::new(),
+            finished: Notify::new(),
+            full: Notify::new(),
+            hold: AtomicBool::new(false),
+            large_control: AtomicBool::new(false),
+            errors: Mutex::new(vec![]),
+            saved: Mutex::new(None),
+            written: AtomicUsize::new(0),
+            connection: Mutex::new(None),
+        }
+    }
+}
+struct Factory(Arc<AnswerHandler>);
+impl PhysicalHandlerFactory for Factory {
+    fn handler(
+        &self,
+        c: NativeTransportContext,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        *self.0.connection.lock().unwrap() = c.native::<::quinn::Connection>().cloned();
+        Ok(self.0.clone())
+    }
+}
+fn query() -> Value {
+    let mut v = envelope("conversation.get", json!({}));
+    v["cid"] = json!("conversation");
+    v
+}
+fn offered() -> Value {
+    let mut v = envelope(
+        "connection.offer",
+        json!({"by_participant":"part_alice","substrate":"quic","capabilities":{},"streams_offered":[{"id":"audio","kind":"audio","direction":"sendrecv","codec_preferences":["pcmu"]}]}),
+    );
+    for (k, vv) in [
+        ("cid", "conversation"),
+        ("sid", "session"),
+        ("connid", "connection"),
+        ("operation_id", "offer_operation"),
+    ] {
+        v[k] = json!(vv);
+    }
+    v
+}
+fn answered(a: &AuthorizedEnvelope, large: bool) -> Envelope {
+    let mut v = envelope(
+        "connection.answer",
+        json!({"by_participant":"part_alice","substrate":"quic","capabilities":{},"streams_answered":[{"id":"audio","kind":"audio","direction":"sendrecv","codec":{"name":"pcmu","params":{"sample_rate":8000,"channels":1}}}]}),
+    );
+    v["id"] = json!("backend_answer_placeholder");
+    v["in_reply_to"] = json!(a.envelope().id());
+    for k in ["cid", "sid", "connid", "operation_id"] {
+        v[k] = a.envelope().original()[k].clone();
+    }
+    if large {
+        v["payload"]["capabilities"]["bounded_answer_fixture"] = json!("x".repeat(65536));
+    }
+    Envelope::from_value(v).unwrap()
+}
+#[async_trait]
+impl AuthenticatedHandler for AnswerHandler {
+    async fn handle(&self, _: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+    async fn handle_replies(&self, a: AuthorizedEnvelope) -> Result<HandlerReplies, DispatchError> {
+        if a.envelope().kind() != "connection.offer" {
+            let mut v = envelope("ack", json!({}));
+            v["in_reply_to"] = json!(a.envelope().id());
+            if self.large_control.swap(false, Ordering::AcqRel) {
+                v["payload"]["details"] = json!({"bounded_control_fixture":"x".repeat(65536)});
+            }
+            return HandlerReplies::new(vec![Envelope::from_value(v)?]);
+        }
+        let a = Arc::new(a);
+        self.entered.notify_one();
+        if matches!(self.mode, Mode::NoWrite) {
+            return a.finish_answered_offer();
+        }
+        if self.hold.load(Ordering::Acquire) {
+            self.release.notified().await;
+        }
+        if matches!(self.mode, Mode::WrongScopes) {
+            for field in [
+                "cid",
+                "sid",
+                "connid",
+                "operation_id",
+                "in_reply_to",
+                "type",
+            ] {
+                let mut v = answered(&a, false).original().clone();
+                v[field] = json!(if field == "type" {
+                    "connection.ready"
+                } else {
+                    "foreign"
+                });
+                if field == "type" {
+                    v["payload"] = json!({"streams":[{"strm_id":"audio","kind":"audio","direction":"sendrecv","stream_local_id":1,"codec":{"name":"pcmu","params":{"sample_rate":8000,"channels":1}}}]});
+                }
+                let error = a
+                    .answer_offer(Envelope::from_value(v)?, deadline())
+                    .await
+                    .unwrap_err();
+                self.errors.lock().unwrap().push(error);
+            }
+        }
+        if matches!(self.mode, Mode::CapacityRetry) {
+            let mut full = false;
+            for _ in 0..32 {
+                let mut request = command();
+                request["operation_id"] = json!("offer_operation");
+                match a
+                    .exchange(
+                        Envelope::from_value(request)?,
+                        Instant::now() + Duration::from_millis(20),
+                    )
+                    .await
+                {
+                    Err(DispatchError::Capacity) => {
+                        full = true;
+                        break;
+                    }
+                    Err(DispatchError::Closed) => {}
+                    other => panic!("unexpected blocked pre-IO request result: {other:?}"),
+                }
+            }
+            assert!(full, "fixture must fill the actual bounded writer queue");
+            let refused = a
+                .answer_offer(answered(&a, false), deadline())
+                .await
+                .unwrap_err();
+            self.errors.lock().unwrap().push(refused);
+            self.full.notify_one();
+            self.release.notified().await;
+        }
+        let frame = answered(&a, matches!(self.mode, Mode::Partial));
+        let end = if matches!(self.mode, Mode::Pending | Mode::Partial) {
+            Instant::now() + Duration::from_millis(150)
+        } else {
+            deadline()
+        };
+        let result = if matches!(self.mode, Mode::Concurrent) {
+            let (a1, a2) = tokio::join!(
+                a.answer_offer(frame.clone(), end),
+                a.answer_offer(frame.clone(), end)
+            );
+            let mut success = None;
+            for r in [a1, a2] {
+                match r {
+                    Ok(v) => success = Some(v),
+                    Err(e) => self.errors.lock().unwrap().push(e),
+                }
+            }
+            success.ok_or(DispatchError::Closed)
+        } else {
+            a.answer_offer(frame.clone(), end).await
+        };
+        let receipt = match result {
+            Ok(r) => r,
+            Err(e) => {
+                self.errors.lock().unwrap().push(e);
+                self.finished.notify_one();
+                return Err(e);
+            }
+        };
+        assert_ne!(receipt.envelope_id.as_str(), "backend_answer_placeholder");
+        self.written.fetch_add(1, Ordering::AcqRel);
+        self.finished.notify_one();
+        if matches!(self.mode, Mode::DuplicateFinal) {
+            return HandlerReplies::new(vec![frame]);
+        }
+        let complete = a.finish_answered_offer();
+        if matches!(self.mode, Mode::Saved) {
+            *self.saved.lock().unwrap() = Some(a);
+        }
+        complete
+    }
+}
+fn setup(mode: Mode) -> (Fixture, Arc<AnswerPolicy>, Arc<AnswerHandler>) {
+    let mut f = Fixture::new();
+    let p = Arc::new(AnswerPolicy {
+        base: f.policy.clone(),
+        grants: Arc::new(RwLock::new(Grants { deny: false })),
+        approvals: AtomicUsize::new(0),
+        require_user: AtomicBool::new(false),
+        allow_rpc: AtomicBool::new(false),
+    });
+    let c = Arc::get_mut(&mut f.config).unwrap();
+    c.authority = p.clone();
+    c.pending_capacity = 4;
+    (f, p, Arc::new(AnswerHandler::new(mode)))
+}
+async fn open(kind: &str, f: &Fixture, h: Arc<AnswerHandler>, window: Option<u32>) -> Wire {
+    let profile = CanonicalProfile::new(f.config.clone(), h.clone(), 8)
+        .unwrap()
+        .with_physical_handlers(Arc::new(Factory(h)));
+    let mut w = wire_with_window(
+        kind,
+        profile,
+        "/uctp",
+        Some("https://allowed.example"),
+        window,
+    )
+    .await
+    .unwrap();
+    w.send(serde_json::to_vec(&hello()).unwrap()).await;
+    let challenge = w.read().await;
+    w.send(f.sign(response(&challenge, "old"))).await;
+    assert_eq!(w.read().await.kind(), "auth.session");
+    w
+}
+async fn progress(mut f: impl FnMut() -> bool) {
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while !f() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
+#[tokio::test]
+async fn signed_answer_finishes_without_fake_ack_or_readiness_on_all_native_transports() {
+    for kind in ["quic", "wt", "ws"] {
+        let (f, p, h) = setup(Mode::Normal);
+        let mut w = open(kind, &f, h.clone(), None).await;
+        let offer = offered();
+        w.send(f.sign(offer.clone())).await;
+        let answer = w.read().await;
+        f.verify_server(&answer).await;
+        assert_eq!(answer.kind(), "connection.answer");
+        assert_eq!(answer.scope(Scope::Reply), offer["id"].as_str());
+        assert_eq!(answer.scope(Scope::Operation), Some("offer_operation"));
+        assert_ne!(answer.id(), "backend_answer_placeholder");
+        progress(|| h.written.load(Ordering::Acquire) == 1).await;
+        assert!(tokio::time::timeout(Duration::from_millis(40), w.read())
+            .await
+            .is_err());
+        w.send(f.sign(query())).await;
+        assert_eq!(w.read().await.kind(), "ack");
+        assert_eq!(p.approvals.load(Ordering::Acquire), 1);
+        w.server.shutdown().await.unwrap();
