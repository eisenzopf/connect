+// One ongoing offer owns one answer. Pending cancellation releases its real
+// guard promptly; after claim the sink/IO alone owns it through abortion.
+async fn write_answer<W: Sink<Bytes, Error = DispatchError> + Send + Unpin>(
+    writer: &mut Option<W>,
+    job: &mut WriteJob,
+    mut answer: PendingAnswer,
