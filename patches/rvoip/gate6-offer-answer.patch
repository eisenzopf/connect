+#[tokio::test]
+async fn refused_full_writer_queue_reports_capacity_and_retries_same_offer_without_late_rpc_io() {
+    let (f, p, h) = setup(Mode::CapacityRetry);
+    p.allow_rpc.store(true, Ordering::Release);
+    h.large_control.store(true, Ordering::Release);
+    let mut w = open("quic", &f, h.clone(), Some(2048)).await;
+    w.send(f.sign(query())).await;
+    let conn = h.connection.lock().unwrap().clone().unwrap();
+    progress(|| conn.stats().frame_tx.stream_data_blocked > 0).await;
+    let offer = offered();
+    w.send(f.sign(offer.clone())).await;
+    tokio::time::timeout(Duration::from_secs(2), h.full.notified())
+        .await
+        .unwrap();
+    assert_eq!(
+        h.errors.lock().unwrap().as_slice(),
+        &[DispatchError::Capacity]
+    );
+    assert_eq!(w.read().await.kind(), "ack");
+    // Draining the blocked control write lets cancelled queued RPCs be dropped.
+    h.release.notify_one();
+    let answer = w.read().await;
+    assert_eq!(answer.kind(), "connection.answer");
+    assert_eq!(answer.scope(Scope::Reply), offer["id"].as_str());
+    f.verify_server(&answer).await;
+    assert!(tokio::time::timeout(Duration::from_millis(40), w.read())
+        .await
+        .is_err());
+    w.send(f.sign(query())).await;
+    assert_eq!(w.read().await.kind(), "ack");
+    w.server.shutdown().await.unwrap();
+}
