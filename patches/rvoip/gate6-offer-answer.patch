+//! One exact answer to an ongoing offer, through its physical actor's writer.
+//! An answer establishes negotiated parameters, never readiness or presence.
+use super::*;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+/// Actual local signed-writer completion only, not a durable/media receipt.
+#[derive(Debug)]
+pub struct OfferAnswerSubmission {
+    pub envelope_id: super::super::Identifier,
+}
+pub(in crate::v2) fn validate_offer_answer(
+    invocation: &Envelope,
+    answer: &Envelope,
+) -> Result<(), DispatchError> {
+    if invocation.kind() != "connection.offer"
+        || invocation.scope(Scope::Reply).is_some()
+        || answer.kind() != "connection.answer"
+        || answer.scope(Scope::Reply) != Some(invocation.id())
+    {
+        return Err(DispatchError::ReplyMismatch);
+    }
+    for scope in [
+        Scope::Conversation,
+        Scope::Session,
+        Scope::Connection,
+        Scope::Operation,
+    ] {
+        if invocation.scope(scope).is_none() || invocation.scope(scope) != answer.scope(scope) {
+            return Err(DispatchError::ReplyMismatch);
+        }
+    }
+    if invocation.scope(Scope::Operation) != answer.scope(Scope::Operation) {
+        return Err(DispatchError::ReplyMismatch);
+    }
+    if serde_json::to_vec(answer)
+        .map_err(|_| DispatchError::Capacity)?
+        .len()
+        .checked_add(4096)
+        .ok_or(DispatchError::Capacity)?
+        > super::super::MAX_ENVELOPE_BYTES
+    {
+        return Err(DispatchError::Capacity);
+    }
+    // Application policy additionally checks actual membership/participant,
+    // capabilities, exact native route and negotiated bindings under its guard.
+    Ok(())
+}
+
+#[derive(Default)]
+pub(super) struct OfferAnswerState {
+    pub(super) submitted: AtomicBool,
+    pub(super) written: AtomicBool,
+}
+pub(in crate::v2) struct AnswerPermit {
+    lease: Mutex<Option<AuthorityLease>>,
+    claimed: AtomicBool,
+    pub cancel: CancellationToken,
+    pub deadline: Instant,
+}
+impl AnswerPermit {
+    pub fn new(lease: AuthorityLease, cancel: CancellationToken, deadline: Instant) -> Arc<Self> {
+        Arc::new(Self {
+            deadline: lease.deadline().map_or(deadline, |end| end.min(deadline)),
+            lease: Mutex::new(Some(lease)),
+            claimed: AtomicBool::new(false),
+            cancel,
+        })
+    }
+    pub fn current(&self) -> bool {
+        !self.cancel.is_cancelled() && Instant::now() < self.deadline
+    }
+    /// Actual writer alone transfers the real guard after its dequeue. Queue
+    /// copies own only this cancellable slot, not independent retained readers.
+    pub fn begin_write(&self) -> Result<AuthorityLease, DispatchError> {
+        let mut lease = self.lease.lock();
+        if !self.current() || self.claimed.load(Ordering::Acquire) {
+            return Err(DispatchError::Closed);
+        }
+        if lease.as_ref().is_none_or(|guard| !guard.current()) {
+            lease.take();
+            return Err(DispatchError::Closed);
+        }
+        // Claim and pending cancellation serialize under the same mutex.
+        self.claimed.store(true, Ordering::Release);
+        lease.take().ok_or(DispatchError::Closed)
+    }
+    pub fn cancel(&self) {
+        self.cancel.cancel();
+        // An active guard has already moved into actual sink/IO custody.
+        self.lease.lock().take();
+    }
+    pub fn uncertainty(&self) -> DispatchError {
+        if self.claimed.load(Ordering::Acquire) {
+            DispatchError::SubmissionUnknown
+        } else {
+            DispatchError::Closed
+        }
+    }
+}
+pub(in crate::v2) struct AnswerCancellation(pub Arc<AnswerPermit>);
+impl Drop for AnswerCancellation {
+    fn drop(&mut self) {
+        self.0.cancel();
+    }
+}
+pub(in crate::v2) struct PendingAnswer {
+    pub permit: Arc<AnswerPermit>,
+    pub completion: Option<oneshot::Sender<Result<super::super::Identifier, DispatchError>>>,
+}
+impl Drop for PendingAnswer {
+    fn drop(&mut self) {
+        self.permit.cancel();
+        if let Some(done) = self.completion.take() {
+            let _ = done.send(Err(self.permit.uncertainty()));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn pending_answer_cancel_drops_reader_while_active_writer_custody_retains_it() {
+        let domain = Arc::new(tokio::sync::RwLock::new(()));
+        let pending = AnswerPermit::new(
+            AuthorityLease::holding(domain.clone().read_owned().await),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(1),
+        );
+        let queue_copy = pending.clone();
+        assert!(domain.try_write().is_err());
+        pending.cancel();
+        assert!(domain.try_write().is_ok());
+        assert!(queue_copy.begin_write().is_err());
+        let active = AnswerPermit::new(
+            AuthorityLease::holding(domain.clone().read_owned().await),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(1),
+        );
+        let actual_writer_guard = active.begin_write().unwrap();
+        active.cancel();
+        assert!(domain.try_write().is_err());
+        assert!(active.begin_write().is_err());
+        drop(actual_writer_guard);
+        assert!(domain.try_write().is_ok());
+    }
+    #[test]
+    fn completed_answer_proof_cannot_be_borrowed_or_replaced_by_a_duplicate_answer() {
+        let source = Arc::new(OfferAnswerState::default());
+        source.submitted.store(true, Ordering::Release);
+        let proof = HandlerReplies(Vec::new(), Some(source.clone()));
+        assert_eq!(
+            proof.validate_answer_completion(&source),
+            Err(DispatchError::ReplyMismatch)
+        );
+        source.written.store(true, Ordering::Release);
+        assert!(proof.validate_answer_completion(&source).is_ok());
+        let other = Arc::new(OfferAnswerState::default());
+        other.written.store(true, Ordering::Release);
+        assert_eq!(
+            proof.validate_answer_completion(&other),
+            Err(DispatchError::ReplyMismatch)
+        );
+        assert_eq!(
+            HandlerReplies(Vec::new(), None).validate_answer_completion(&source),
+            Err(DispatchError::ReplyMismatch)
+        );
+    }
+    #[test]
+    fn logical_operation_is_required_on_offer_and_preserved_on_answer() {
+        use serde_json::json;
+        let mut offer = json!({"v":2,"type":"connection.offer","id":"offer","ts":chrono::Utc::now(),"cid":"c","sid":"s","connid":"n","payload":{"substrate":"quic","capabilities":{},"streams_offered":[]}});
+        let mut answer = json!({"v":2,"type":"connection.answer","id":"answer","ts":chrono::Utc::now(),"cid":"c","sid":"s","connid":"n","in_reply_to":"offer","payload":{"substrate":"quic","capabilities":{},"streams_answered":[]}});
+        assert_eq!(
+            Envelope::from_value(offer.clone()).unwrap_err(),
+            WireError::MissingScope
+        );
+        offer["operation_id"] = json!("stable_operation");
+        assert_eq!(
+            validate_offer_answer(
+                &Envelope::from_value(offer.clone()).unwrap(),
+                &Envelope::from_value(answer.clone()).unwrap()
+            ),
+            Err(DispatchError::ReplyMismatch)
+        );
+        answer["operation_id"] = json!("stable_operation");
+        assert!(validate_offer_answer(
+            &Envelope::from_value(offer).unwrap(),
+            &Envelope::from_value(answer).unwrap()
+        )
+        .is_ok());
+    }
+}
