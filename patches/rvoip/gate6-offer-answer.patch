+    assert!(tokio::time::timeout(Duration::from_millis(20), &mut writer)
+        .await
+        .is_err());
+    drop(
+        tokio::time::timeout(Duration::from_secs(1), writer)
+            .await
+            .unwrap()
+            .unwrap(),
+    );
+    w.retired().await;
+    assert_eq!(h.written.load(Ordering::Acquire), 0);
+    assert!(h
+        .errors
