+#[tokio::test]
+async fn answer_uses_same_held_guard_behind_a_queued_authority_writer() {
+    use std::future::Future;
+    let (f, p, h) = setup(Mode::Normal);
+    h.hold.store(true, Ordering::Release);
+    let mut w = open("quic", &f, h.clone(), None).await;
+    w.send(f.sign(offered())).await;
+    h.entered.notified().await;
+    let queued = Arc::new(Notify::new());
+    let notify = queued.clone();
+    let grants = p.grants.clone();
+    let writer = tokio::spawn(async move {
+        let mut wait = Box::pin(grants.write_owned());
+        let mut guard = futures::future::poll_fn(|cx| {
+            let r = wait.as_mut().poll(cx);
+            if r.is_pending() {
+                notify.notify_one();
+            }
+            r
+        })
+        .await;
+        guard.deny = true;
+    });
+    queued.notified().await;
+    let calls = f.policy.calls.load(Ordering::Acquire);
+    h.hold.store(false, Ordering::Release);
+    h.release.notify_one();
+    assert_eq!(w.read().await.kind(), "connection.answer");
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(f.policy.calls.load(Ordering::Acquire), calls);
+    w.send(f.sign(offered())).await;
+    assert_eq!(w.read().await.kind(), "error");
+    w.server.shutdown().await.unwrap();
+}
