+#[test]
+fn active_speaker_is_session_scoped_and_preserves_explicit_null_silence() {
+    let mut value = sample("stream.active-speaker");
+    value.as_object_mut().unwrap().remove("connid");
+    value["payload"]["active_participant"] = Value::Null;
+    let envelope = Envelope::from_value(value.clone()).unwrap();
+    let Payload::StreamActiveSpeaker(speaker) = envelope.payload() else {
+        panic!()
+    };
+    assert!(speaker.active_participant.is_none());
+    let serialized = serde_json::to_value(envelope.payload()).unwrap();
+    assert!(serialized["payload"]
+        .as_object()
+        .unwrap()
+        .contains_key("active_participant"));
+    assert!(serialized["payload"]["active_participant"].is_null());
+    value["payload"]
+        .as_object_mut()
+        .unwrap()
+        .remove("active_participant");
+    assert!(Envelope::from_value(value).is_err());
+}
