+async fn wildcard_scene() -> Scene {
+    let s = Scene::new(&[Medium::Audio]).await;
+    // The general Scene fixture intentionally reuses logical IDs for direct
+    // routing tests. Selector catalogs require a distinct published source ID.
+    s.f.a
+        .change(
+            1,
+            &[audio("wildcard-source")],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+    s
+}
+
+#[tokio::test]
+async fn wildcard_participant_defers_unsupported_kind_but_preserves_future_intent() {
+    use crate::staged_streams::subscription_plan::{MediaSelection, MediaSelectionChange};
+    let s = wildcard_scene().await;
+    s.f.policy
+        .0
+        .write()
+        .await
+        .unsupported_participant_media
+        .insert(Medium::Video);
+    let all = MediaSelectionChange::Subscribe(vec![MediaSelection::ParticipantAll {
+        participant: s.f.a.origin_member.participant().clone(),
+        media: BTreeSet::from([Medium::Audio, Medium::Video]),
+    }]);
+    let first = planned(&s, &all);
+    assert_eq!(apply(&s, first.routing().clone()).await.unwrap(), 2);
+    // An explicit unsupported kind is still refused; it cannot borrow the
+    // broader retained wildcard or erase its original receive intent.
+    assert!(matches!(
+        apply(&s, planned(&s, &future_video(&s)).routing().clone()).await,
+        Err(StreamControlError::Unsupported)
+    ));
+    assert_eq!(s.f.b.revision(), 2);
+    s.f.policy
+        .0
+        .write()
+        .await
+        .unsupported_participant_media
+        .clear();
+    s.f.a
+        .change(
+            2,
+            &[audio("wildcard-source"), desired(Medium::Video)],
+            &BTreeSet::new(),
+            deadline(),
+            CancellationToken::new(),
+        )
+        .await
+        .unwrap();
+    let next = planned(&s, &MediaSelectionChange::Reconcile);
+    assert!(!first.same_catalog(&next));
+    assert_eq!(next.desired().len(), 2);
+    assert_eq!(
+        next.required_formats()[&desired(Medium::Video).logical_id],
+        video()
+    );
+    // Intent alone still supplies neither the missing target port nor a grant.
+    assert!(apply(&s, next.routing().clone()).await.is_err());
+    assert_eq!(s.f.b.revision(), 2);
+}
+#[tokio::test]
+async fn wildcard_participant_never_skips_authority_or_accepts_zero_compatible_kinds() {
+    use crate::staged_streams::subscription_plan::{MediaSelection, MediaSelectionChange};
+    for revoked in [false, true] {
+        let s = wildcard_scene().await;
+        let all = MediaSelectionChange::Subscribe(vec![MediaSelection::ParticipantAll {
+            participant: s.f.a.origin_member.participant().clone(),
+            media: BTreeSet::from([Medium::Audio, Medium::Video]),
+        }]);
+        let plan = planned(&s, &all);
+        {
+            let mut policy = s.f.policy.0.write().await;
+            policy.unsupported_participant_media = BTreeSet::from([Medium::Audio, Medium::Video]);
+            if revoked {
+                policy.revoked.insert("alice".into());
+            }
+        }
+        let error = apply(&s, plan.routing().clone()).await.unwrap_err();
+        assert!(if revoked {
+            matches!(error, StreamControlError::Authority)
+        } else {
+            matches!(error, StreamControlError::Unsupported)
+        });
+        assert_eq!(s.f.b.revision(), 1);
+    }
+}
