+//! Only private, definitely unpublished preparation metadata. No ordinary
+//! ingress, queue, delivery or public subscription lock behavior changes.
+use super::*;
+use std::sync::{Mutex, MutexGuard, TryLockError};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(in crate::staged_streams) enum Leaf {
+    InitialTargetRevision,
+    OriginalPlanSelection,
+    TargetPlanSelection,
+    TargetState,
+    PublisherState,
+    OriginalSelection,
+    Routing,
+}
+
+pub(super) fn try_lock<'a, T>(
+    lock: &'a Mutex<T>,
+    leaf: Leaf,
+) -> ControlResult<Option<MutexGuard<'a, T>>> {
+    #[cfg(test)]
+    let _exclusion = fixture::exclude(lock, leaf);
+    #[cfg(not(test))]
+    let _ = leaf;
+    match lock.try_lock() {
+        Ok(guard) => Ok(Some(guard)),
+        Err(TryLockError::WouldBlock) => Ok(None),
+        // Poison is a terminal refusal, never a definite temporary exclusion.
+        Err(TryLockError::Poisoned(_)) => Err(StreamControlError::NotReady),
+    }
+}
+
+#[cfg(test)]
+pub(in crate::staged_streams) mod fixture {
+    use super::*;
+    use std::cell::Cell;
+    #[derive(Clone, Copy)]
+    pub(in crate::staged_streams) enum Action {
+        Hold,
+        Poison,
+    }
+    thread_local! {static NEXT:Cell<Option<(Leaf,Action)>>=const {Cell::new(None)};}
+    pub(in crate::staged_streams) fn with<T>(
+        leaf: Leaf,
+        action: Action,
+        call: impl FnOnce() -> T,
+    ) -> T {
+        assert!(
+            NEXT.with(|slot| slot.replace(Some((leaf, action))))
+                .is_none(),
+            "one exact private metadata exclusion only"
+        );
+        struct Reset;
+        impl Drop for Reset {
+            fn drop(&mut self) {
+                NEXT.with(|slot| slot.set(None));
+            }
+        }
+        let _reset = Reset;
+        let result = call();
+        assert!(
+            NEXT.with(|slot| slot.get()).is_none(),
+            "the exact selected private lock boundary was not reached"
+        );
+        result
+    }
+    pub(super) fn exclude<T>(lock: &Mutex<T>, leaf: Leaf) -> Option<MutexGuard<'_, T>> {
+        let selected = NEXT.with(|slot| {
+            if slot.get().is_some_and(|(at, _)| at == leaf) {
+                slot.take()
+            } else {
+                None
+            }
+        });
+        match selected {
+            Some((_, Action::Hold)) => {
+                Some(lock.lock().expect("fixture mutex was already poisoned"))
+            }
+            Some((_, Action::Poison)) => {
+                let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                    let _held = lock.lock().expect("fixture mutex was already poisoned");
+                    panic!("controlled exact private metadata poison");
+                }));
+                assert!(result.is_err());
+                None
+            }
+            None => None,
+        }
+    }
+}
