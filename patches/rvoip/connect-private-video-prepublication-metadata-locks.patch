+            );
+            assert_eq!(
+                target.direct_subscriptions.private_route_count_for_test(),
+                0
+            );
+            assert!(f.target_output.try_recv().is_err());
+        }
+    }
+}
+#[tokio::test]
+async fn poisoned_private_metadata_is_terminal_and_ordinary_original_stamp_keeps_its_contract() {
+    for leaf in LEAVES {
+        let f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let revision = target.revision();
+        let cutoff = deadline();
+        let cancel = CancellationToken::new();
+        let grant = f
+            .movement
+            .room
+            .grant(approval(&old, &target, revision))
+            .await;
+        let result = fixture::with(leaf, Action::Poison, || {
+            attempt(&f, &old, &target, cutoff, &cancel, &grant)
+        });
+        assert!(
+            matches!(
+                result,
+                Err(StreamControlError::NotReady | StreamControlError::Model(_))
+            ),
+            "poison cannot request retry"
+        );
+        assert_eq!(
+            target.direct_subscriptions.private_route_count_for_test(),
+            0
+        );
+        assert!(f.target_output.try_recv().is_err());
+        assert_eq!(Arc::strong_count(&grant), 1);
+        assert_eq!(Arc::strong_count(&grant.guard), 1);
+        if leaf == Leaf::OriginalSelection {
+            let publisher = &f.movement.room.nodes["bob"].controller;
+            assert!(
+                old.direct_subscriptions
+                    .stamp(
+                        publisher,
+                        &desired(Medium::Video).logical_id,
+                        &request().receivers[0].previous,
+                        Instant::now()
+                    )
+                    .is_ok(),
+                "ordinary stamp poison recovery was changed"
+            );
+        }
+    }
+}
