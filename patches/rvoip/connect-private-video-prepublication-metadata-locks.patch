+//! Exact actual metadata mutex exclusions at each unpublished leaf; no fake
+//! policy error, renewed operation, detached thread or route publication.
+use super::*;
+use crate::staged_streams::direct_subscriptions::preparation_metadata::{
+    fixture::{self, Action},
+    Leaf,
+};
+const LEAVES: [Leaf; 7] = [
+    Leaf::InitialTargetRevision,
+    Leaf::OriginalPlanSelection,
+    Leaf::TargetPlanSelection,
+    Leaf::TargetState,
+    Leaf::PublisherState,
+    Leaf::OriginalSelection,
+    Leaf::Routing,
+];
+fn approval(old: &StreamController, target: &StreamController, revision: u64) -> Approval {
+    Approval::PrepareVideo {
+        source: old.connection.clone(),
+        connection: target.connection.clone(),
+        expected: revision,
+        request: request(),
+    }
+}
+fn attempt(
+    f: &Preroll,
+    old: &Arc<StreamController>,
+    target: &Arc<StreamController>,
+    cutoff: tokio::time::Instant,
+    cancel: &CancellationToken,
+    grant: &Arc<Grant>,
+) -> ControlResult<VideoReplacementPreparationAttempt> {
+    let _ = f;
+    target.prepare_replacement_video(
+        old,
+        &request(),
+        &PrivateVideoBindingLifetime::for_test(target, cutoff, cancel.clone()),
+        cutoff,
+        grant,
+    )
+}
+#[tokio::test]
+async fn unpublished_private_metadata_leaves_release_all_custody_and_recover_same_capture_with_fresh_proof(
+) {
+    for leaf in LEAVES {
+        let mut f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let revision = target.revision();
+        let before = bindings(&target);
+        let incarnation = f.movement.pending.binding().clone();
+        let cutoff = deadline();
+        let cancel = CancellationToken::new();
+        let grant = f
+            .movement
+            .room
+            .grant(approval(&old, &target, revision))
+            .await;
+        let result = fixture::with(leaf, Action::Hold, || {
+            attempt(&f, &old, &target, cutoff, &cancel, &grant)
+        })
+        .unwrap();
+        assert!(
+            matches!(result,VideoReplacementPreparationAttempt::MetadataBusy {deadline}if deadline<=cutoff)
+        );
+        assert_eq!(
+            target.direct_subscriptions.private_route_count_for_test(),
+            0
+        );
+        assert!(f.target_output.try_recv().is_err());
+        assert_eq!(
+            Arc::strong_count(&grant),
+            1,
+            "temporary ControlReads/control lease retained original capture"
+        );
+        assert_eq!(
+            Arc::strong_count(&grant.guard),
+            1,
+            "capture's shared authority remained retained"
+        );
+        drop(grant);
+        drop(
+            target
+                .state
+                .try_lock()
+                .expect("target State retained across refusal"),
+        );
+        drop(
+            f.movement.room.nodes["bob"]
+                .controller
+                .state
+                .try_lock()
+                .expect("publisher State retained across refusal"),
+        );
+        // Existing selected old route remains usable BEFORE any new capture.
+        f.publish_video("bob", 501);
+        delivered(&mut f.old_output, 501).await;
+        assert!(f.target_output.try_recv().is_err());
+        let fresh = f
+            .movement
+            .room
+            .grant(approval(&old, &target, revision))
+            .await;
+        let prepared = match attempt(&f, &old, &target, cutoff, &cancel, &fresh).unwrap() {
+            VideoReplacementPreparationAttempt::Prepared(p) => p,
+            _ => panic!("released exact metadata did not recover"),
+        };
+        assert!(prepared.is_current());
+        assert!(tokio::time::Instant::now() < cutoff);
+        assert_eq!(target.revision(), revision);
+        assert_eq!(bindings(&target), before);
+        assert!(f.movement.pending.binding().same_incarnation(&incarnation));
+        f.publish_video("bob", 502);
+        delivered(&mut f.old_output, 502).await;
+        delivered(&mut f.target_output, 502).await;
+        prepared.close();
+        assert_eq!(
+            target.direct_subscriptions.private_route_count_for_test(),
+            0
+        );
+        assert!(!cancel.is_cancelled());
+    }
+}
+#[tokio::test]
+async fn unpublished_private_metadata_cannot_extend_original_expiry_or_bypass_cancellation() {
+    for leaf in LEAVES {
+        for expire in [false, true] {
+            let f = Preroll::new().await;
+            let old = f.movement.room.nodes["alice"].controller.clone();
+            let target = f.movement.room.nodes["device"].controller.clone();
+            let revision = target.revision();
+            let cutoff = if expire {
+                tokio::time::Instant::now() + Duration::from_millis(200)
+            } else {
+                deadline()
+            };
+            let cancel = CancellationToken::new();
+            let grant = f
+                .movement
+                .room
+                .grant(approval(&old, &target, revision))
+                .await;
+            assert!(matches!(
+                fixture::with(leaf, Action::Hold, || attempt(
+                    &f, &old, &target, cutoff, &cancel, &grant
+                )),
+                Ok(VideoReplacementPreparationAttempt::MetadataBusy { .. })
+            ));
+            drop(grant);
+            if expire {
+                tokio::time::sleep_until(cutoff).await;
+            } else {
+                cancel.cancel();
+            }
+            let fresh = f
+                .movement
+                .room
+                .grant(approval(&old, &target, revision))
+                .await;
+            assert!(matches!(
+                attempt(&f, &old, &target, cutoff, &cancel, &fresh),
+                Err(StreamControlError::Cancelled)
+            ));
+            assert_eq!(
+                target.direct_subscriptions.private_route_count_for_test(),
+                0
+            );
+            assert!(!target.shutdown.is_cancelled());
+        }
+    }
+}
