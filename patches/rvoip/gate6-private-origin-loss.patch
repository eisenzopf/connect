+#[tokio::test]
+async fn private_audience_all_private_origins_departed_restores_survivors_once() {
+    let mut r = Room::new().await;
+    r.select(
+        "public",
+        vec![AudioSubscription::Connection(ConnectionId::from_string(
+            "bob",
+        ))],
+    )
+    .await;
+    r.add("consult", Some("public"), true).await;
+    let (_, handle) = r.apply(r.begin_plan()).await.unwrap();
+    r.publish("consult", 5200).unwrap();
+    r.tick();
+    let tail = r.nodes.get_mut("alice").unwrap().out.try_recv().unwrap();
+    for id in ["alice", "consult"] {
+        r.scene.remove(&ConnectionId::from_string(id));
+    }
+    let plan = r
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "all-private-origins-ended".into(),
+            r.scene.audience_revision(),
+        )
+        .unwrap();
+    let (outcome, _) = r.apply(plan).await.unwrap();
+    assert_eq!(
+        outcome.departed_connections,
+        BTreeSet::from([
+            ConnectionId::from_string("alice"),
+            ConnectionId::from_string("consult")
+        ])
+    );
+    assert!(tail
+        .deliver(|_| async { panic!("private tail survived restoration") })
+        .await
+        .is_err());
+    r.publish("public", 1600).unwrap();
+    r.tick();
+    r.heard("bob", 1600).await;
+    r.silent(&["alice", "consult", "public"]);
+    r.publish("bob", 2400).unwrap();
+    r.tick();
+    r.heard("public", 2400).await;
+    r.silent(&["alice", "consult", "bob"]);
+    assert!(r.publish("alice", 800).is_err());
+    assert!(r.publish("consult", 5200).is_err());
+    // Consumed identity must not overwrite a later receiver decision.
+    r.select(
+        "public",
+        vec![AudioSubscription::Connection(ConnectionId::from_string(
+            "hold",
+        ))],
+    )
+    .await;
+    assert!(r
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "replayed-ended-origins".into(),
+            r.scene.audience_revision()
+        )
+        .is_err());
+}
+
+#[tokio::test]
+async fn private_audience_departed_unsubmitted_preparation_releases_its_reservation() {
+    let mut r = Room::new().await;
+    // Every preparation is a distinct logical operation, as in production.
+    // Retired preparations must not exhaust the 256-group registry.
+    for index in 0..257 {
+        let name = format!("unsubmitted-{index}");
+        r.add(&name, Some("public"), true).await;
+        assert!(r.publish(&name, 5200).is_err());
+        r.scene.remove(&ConnectionId::from_string(name));
+    }
+    r.publish("alice", 800).unwrap();
+    r.tick();
+    r.heard("bob", 800).await;
+    r.heard("public", 800).await;
+    r.silent(&["unsubmitted-256"]);
+}
