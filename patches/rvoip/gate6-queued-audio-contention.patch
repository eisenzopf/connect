+//! Exact-frame recovery while fresh policy metadata is temporarily unavailable.
+use super::*;
+struct BusyPolicy {
+    inner: Arc<Policy>,
+    blocked: Arc<AtomicUsize>,
+    entered: Arc<Notify>,
+}
+impl MediaPolicy for BusyPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let blocked = self.blocked.load(Ordering::Acquire);
+        if (blocked == 1 && scope.connection.as_str() == "alice")
+            || (blocked == 2 && scope.connection.as_str() == "bob")
+        {
+            self.entered.notify_one();
+            return Err(StreamControlError::NotReady);
+        }
+        self.inner.current(scope)
+    }
+}
+async fn queued() -> (Fixture, QueuedMedia, Arc<AtomicUsize>, Arc<Notify>) {
+    let blocked = Arc::new(AtomicUsize::new(0));
+    let entered = Arc::new(Notify::new());
+    let b = blocked.clone();
+    let e = entered.clone();
+    let f = Fixture::with_policy(
+        8,
+        Some(Box::new(move |inner| {
+            Arc::new(BusyPolicy {
+                inner,
+                blocked: b,
+                entered: e,
+            })
+        })),
+    );
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut output = f.ba.port(Medium::Audio).take_egress().unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    let q = outgoing(&mut output).await;
+    (f, q, blocked, entered)
+}
+#[tokio::test]
+async fn queued_audio_busy_retries_same_frame_and_releases_all_readers() {
+    for stage in [1, 2] {
+        let (f, q, blocked, entered) = queued().await;
+        blocked.store(stage, Ordering::Release);
+        let calls = AtomicUsize::new(0);
+        let mut delivery = Box::pin(q.deliver(|frame| {
+            assert_eq!(frame.timestamp_rtp, 160);
+            assert_eq!(
+                frame.stream_id,
+                f.ba.port(Medium::Audio).binding().transport_id
+            );
+            calls.fetch_add(1, Ordering::AcqRel);
+            std::future::ready(Ok(()))
+        }));
+        tokio::select! {
+            _ = entered.notified() => (),
+            result = delivery.as_mut() => panic!("busy delivery completed: {result:?}"),
+        }
+        // A target refusal must release the source reader too, before waiting.
+        drop(
+            f.policy
+                .0
+                .try_write()
+                .expect("authority retained during retry wait"),
+        );
+        assert_eq!(calls.load(Ordering::Acquire), 0);
+        blocked.store(0, Ordering::Release);
+        delivery.await.unwrap();
+        assert_eq!(calls.load(Ordering::Acquire), 1);
+    }
+}
+#[tokio::test]
+async fn queued_audio_busy_rechecks_source_and_target_revocation_without_output() {
+    for stage in [1, 2] {
+        for revoked in ["alice", "bob"] {
+            let (f, q, blocked, entered) = queued().await;
+            blocked.store(stage, Ordering::Release);
+            let calls = AtomicUsize::new(0);
+            let mut delivery = Box::pin(q.deliver(|_| {
+                calls.fetch_add(1, Ordering::AcqRel);
+                std::future::ready(Ok(()))
+            }));
+            tokio::select! {
+                _ = entered.notified() => (),
+                result = delivery.as_mut() => panic!("busy delivery completed: {result:?}"),
+            }
+            f.policy
+                .0
+                .try_write()
+                .unwrap()
+                .revoked
+                .insert(revoked.into());
+            blocked.store(0, Ordering::Release);
+            assert!(matches!(delivery.await, Err(StreamControlError::Authority)));
+            assert_eq!(calls.load(Ordering::Acquire), 0);
+        }
+    }
+}
+#[tokio::test]
+async fn queued_audio_busy_original_generation_and_cancellation_remain_fenced() {
+    for cancelled in [false, true] {
+        let (f, q, blocked, entered) = queued().await;
+        blocked.store(2, Ordering::Release);
+        let calls = AtomicUsize::new(0);
+        let mut delivery = Box::pin(q.deliver(|_| {
+            calls.fetch_add(1, Ordering::AcqRel);
+            std::future::ready(Ok(()))
+        }));
+        tokio::select! {
+            _ = entered.notified() => (),
+            result = delivery.as_mut() => panic!("busy delivery completed: {result:?}"),
+        }
+        drop(f.policy.0.try_write().unwrap());
+        if cancelled {
+            f.a.shutdown.cancel();
+        } else {
+            f.aa.port(Medium::Audio).0.retire();
+        }
+        blocked.store(0, Ordering::Release);
+        assert!(matches!(
+            delivery.await,
+            Err(StreamControlError::Deadline | StreamControlError::Cancelled)
+        ));
+        assert_eq!(calls.load(Ordering::Acquire), 0);
+    }
+}
+#[tokio::test]
+async fn queued_audio_busy_deadline_is_original_and_releases_readers() {
+    let (f, q, blocked, _) = queued().await;
+    blocked.store(2, Ordering::Release);
+    let calls = AtomicUsize::new(0);
+    assert!(matches!(
+        tokio::time::timeout(
+            Duration::from_millis(500),
+            q.deliver(|_| {
+                calls.fetch_add(1, Ordering::AcqRel);
+                std::future::ready(Ok(()))
+            })
+        )
+        .await
+        .unwrap(),
+        Err(StreamControlError::Deadline)
+    ));
+    assert_eq!(calls.load(Ordering::Acquire), 0);
+    drop(f.policy.0.try_write().unwrap());
+}
+#[tokio::test]
+async fn queued_audio_io_not_ready_is_never_resubmitted() {
+    let (_f, q, _, _) = queued().await;
+    let calls = AtomicUsize::new(0);
+    assert!(matches!(
+        q.deliver(|_| {
+            calls.fetch_add(1, Ordering::AcqRel);
+            std::future::ready(Err(StreamControlError::NotReady))
+        })
+        .await,
+        Err(StreamControlError::NotReady)
+    ));
+    assert_eq!(calls.load(Ordering::Acquire), 1);
+}
