+    let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+    *room.domain.audio_current_gate.lock().unwrap() = Some(AudioCurrentGate {
+        entered: entered_tx,
+        release: release_rx,
+    });
+    let scene = room.scene.clone();
+    let tick = std::thread::spawn(move || scene.tick());
+    let mut original = AudioGateWorkers::new(release_tx, tick);
+    entered_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    let original_preparation = room
+        .scene
+        .prepare_audio_endpoint(&ConnectionId::from_string("fresh"), "prepare-fresh");
+    // The blocked callback has not captured a current lease yet. A real
+    // revocation here must still exclude this same original PCM after release.
+    room.domain
+        .base
+        .0
+        .write()
+        .await
+        .revoked
+        .insert("alice".into());
+    original.finish();
+    assert!(
+        original_preparation.is_ok(),
+        "audio callback held the scene member mutex"
+    );
+    room.silent(&["alice", "bob", "public", "hold", "fresh"]);
