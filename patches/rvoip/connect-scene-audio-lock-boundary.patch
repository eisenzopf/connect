+#[tokio::test]
+async fn removal_during_audio_callback_retires_original_consumer_before_direct_reacquisition() {
+    let mut room = Room::new().await;
+    room.publish("alice", 800).unwrap();
+    let stamp = room.nodes["alice"]
+        .controller
+        .audio_consumer
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .upgrade()
+        .unwrap()
+        .stamp();
+    let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+    let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+    *room.domain.audio_current_gate.lock().unwrap() = Some(AudioCurrentGate {
+        entered: entered_tx,
+        release: release_rx,
+    });
+    let scene = room.scene.clone();
+    let tick = std::thread::spawn(move || scene.tick());
+    let mut original = AudioGateWorkers::new(release_tx, tick);
+    entered_rx.recv_timeout(Duration::from_secs(1)).unwrap();
+    let scene = room.scene.clone();
+    let removal = std::thread::spawn(move || scene.remove(&ConnectionId::from_string("alice")));
+    original.workers.push(removal);
+    let retired =
+        tokio::time::timeout(Duration::from_secs(1), stamp.cancellation.cancelled()).await;
+    original.finish();
+    assert!(
+        retired.is_ok(),
+        "removal could not retire the original consumer during audio callback"
+    );
+    assert!(!stamp.is_current());
+    room.silent(&["alice", "bob", "public", "hold"]);
+}
