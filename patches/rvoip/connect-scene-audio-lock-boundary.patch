+}
+struct AudioCurrentGate {
+    entered: std::sync::mpsc::SyncSender<()>,
+    release: std::sync::mpsc::Receiver<()>,
+}
+// The original blocked tick and any removal must join even if an assertion or
+// entered wait fails. Release first, then join every owned worker on unwind.
+struct AudioGateWorkers {
+    release: Option<std::sync::mpsc::SyncSender<()>>,
+    workers: Vec<std::thread::JoinHandle<()>>,
+}
+impl AudioGateWorkers {
+    fn new(release: std::sync::mpsc::SyncSender<()>, tick: std::thread::JoinHandle<()>) -> Self {
+        Self {
+            release: Some(release),
+            workers: vec![tick],
+        }
+    }
+    fn finish(&mut self) {
+        let released = self.release.take().map(|release| release.send(()));
+        let joined = self
+            .workers
+            .drain(..)
+            .map(|worker| worker.join())
+            .collect::<Vec<_>>();
+        assert!(
+            released.is_none_or(|result| result.is_ok()),
+            "original callback receiver exited before release"
+        );
+        assert!(
+            joined.into_iter().all(|result| result.is_ok()),
+            "original scene worker failed"
+        );
+    }
+}
+impl Drop for AudioGateWorkers {
+    fn drop(&mut self) {
+        if let Some(release) = self.release.take() {
+            let _ = release.send(());
+        }
+        for worker in self.workers.drain(..) {
+            let _ = worker.join();
+        }
+    }
 }
