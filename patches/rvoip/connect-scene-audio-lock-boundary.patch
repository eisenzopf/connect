+#[cfg(test)]
+mod preparation_refusal_diagnostics {
+    use super::*;
+    use tracing_subscriber::{
+        Layer,
+        layer::{Context, SubscriberExt},
+    };
+    struct Fields {
+        stage: Option<String>,
+        kind: Option<String>,
+    }
+    impl tracing::field::Visit for Fields {
+        fn record_str(&mut self, field: &tracing::field::Field, value: &str) {
+            match field.name() {
+                "stage" => self.stage = Some(value.to_owned()),
+                "kind" => self.kind = Some(value.to_owned()),
+                _ => {}
+            }
+        }
+        fn record_debug(&mut self, _: &tracing::field::Field, _: &dyn std::fmt::Debug) {}
+    }
+    struct OriginalGuards {
+        scene: Arc<GuardedMediaScene>,
+        controller: Arc<StreamController>,
+        port: Arc<Port>,
+        domain: Arc<Domain>,
+        externally_held: usize,
+        events: Arc<Mutex<Vec<(String, String)>>>,
+    }
+    impl<S: tracing::Subscriber> Layer<S> for OriginalGuards {
+        fn on_event(&self, event: &tracing::Event<'_>, _: Context<'_, S>) {
+            let mut fields = Fields {
+                stage: None,
+                kind: None,
+            };
+            event.record(&mut fields);
+            let Some(stage) = fields.stage else {
+                return;
+            };
+            assert_eq!(event.metadata().target(), "rvoip_core::audio_summary");
+            // The one deliberately held external guard is not owned by the
+            // refused invocation. Every other original guard must be gone
+            // before tracing can run this observer synchronously.
+            if self.externally_held != 0 {
+                assert!(self.scene.members.try_lock().is_ok());
+            }
+            if self.externally_held != 1 {
+                assert!(self.scene.audiences.try_lock().is_ok());
+            }
+            if self.externally_held != 2 {
+                assert!(self.controller.state.try_lock().is_ok());
+            }
+            if self.externally_held != 4 {
+                assert!(self.port.state.try_lock().is_ok());
+            }
+            if self.externally_held != 5 {
+                assert!(self.controller.audio_preparation.try_lock().is_ok());
+            }
+            assert!(
+                self.domain.base.0.try_write().is_ok(),
+                "refused invocation retained its current authority reader into tracing"
+            );
+            assert_eq!(
+                self.scene.preparation_refusals.load(Ordering::Relaxed),
+                1 << self.externally_held
+            );
+            self.events
+                .lock()
+                .unwrap()
+                .push((stage, fields.kind.expect("normalized refusal kind")));
+        }
+    }
+    async fn fresh() -> Room {
+        let mut room = Room::new().await;
+        room.add("fresh", Some("public"), true).await;
+        room.domain
+            .local_preparations
+            .lock()
+            .unwrap()
+            .insert(ConnectionId::from_string("fresh"), "prepare-fresh".into());
+        assert_eq!(room.scene.preparation_refusals.load(Ordering::Relaxed), 0);
+        room
+    }
+    fn observer(
+        room: &Room,
+        held: usize,
+        events: Arc<Mutex<Vec<(String, String)>>>,
+    ) -> impl tracing::Subscriber + Send + Sync {
+        let controller = room.nodes["fresh"].controller.clone();
+        let port = {
+            let state = controller.state.lock().unwrap();
+            state
+                .active
+                .values()
+                .find(|port| port.binding.negotiated.requested.medium == Medium::Audio)
+                .unwrap()
+                .clone()
+        };
+        tracing_subscriber::registry()
+            .with(tracing_subscriber::EnvFilter::new(
+                "warn,rvoip_core::audio_summary=debug",
+            ))
+            .with(OriginalGuards {
+                scene: room.scene.clone(),
+                controller,
+                port,
+                domain: room.domain.clone(),
+                externally_held: held,
+                events,
+            })
+    }
+    fn conflict(room: &Room) {
+        assert!(matches!(
+            room.scene
+                .prepare_audio_endpoint(&ConnectionId::from_string("fresh"), "prepare-fresh"),
+            Err(StreamControlError::Model(MediaTransitionError::Conflict))
+        ));
+    }
+    #[tokio::test]
+    async fn actual_endpoint_lock_refusals_emit_one_fixed_leaf_after_all_other_owned_guards_drop() {
+        for (leaf, expected) in [
+            (0, "scene-members-lock"),
+            (1, "audience-registry-lock"),
+            (2, "controller-state-lock"),
+            (4, "audio-port-lock"),
+            (5, "audio-preparation-slot-lock"),
+        ] {
+            let room = fresh().await;
+            let controller = room.nodes["fresh"].controller.clone();
+            let port = {
+                let state = controller.state.lock().unwrap();
+                state
+                    .active
+                    .values()
+                    .find(|port| port.binding.negotiated.requested.medium == Medium::Audio)
+                    .unwrap()
+                    .clone()
+            };
+            let events = Arc::new(Mutex::new(Vec::new()));
+            tracing::subscriber::with_default(
+                observer(&room, leaf, events.clone()),
+                || match leaf {
+                    0 => {
+                        let _held = room.scene.members.lock().unwrap();
+                        conflict(&room);
+                        conflict(&room);
+                    }
+                    1 => {
+                        let _held = room.scene.audiences.lock().unwrap();
+                        conflict(&room);
+                        conflict(&room);
+                    }
+                    2 => {
+                        let _held = controller.state.lock().unwrap();
+                        conflict(&room);
+                        conflict(&room);
+                    }
+                    4 => {
+                        let _held = port.state.lock().unwrap();
+                        conflict(&room);
+                        conflict(&room);
+                    }
+                    5 => {
+                        let _held = controller.audio_preparation.lock().unwrap();
+                        conflict(&room);
+                        conflict(&room);
+                    }
+                    _ => unreachable!(),
+                },
+            );
+            assert_eq!(
+                *events.lock().unwrap(),
+                vec![(expected.to_owned(), "would-block".to_owned())]
+            );
+            assert_eq!(
+                room.scene.preparation_refusals.load(Ordering::Relaxed),
+                1 << leaf
+            );
+            let original = room
+                .scene
+                .prepare_audio_endpoint(&ConnectionId::from_string("fresh"), "prepare-fresh");
+            assert!(
+                original.is_ok(),
+                "temporary lock contention cannot permanently consume the original preparation"
+            );
+        }
+    }
