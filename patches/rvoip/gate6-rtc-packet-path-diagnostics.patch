+// Power-of-two numeric refusal observations only. Never log packet payloads,
+// credentials or SDP, and never alter a delivery, deadline or permission check.
+fn packet_refusal(
+    counter: &AtomicU64,
+    medium: Medium,
+    stage: &'static str,
+    reason: impl std::fmt::Debug,
+) {
+    let count = counter
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+            Some(n.saturating_add(1))
+        })
+        .unwrap()
+        .saturating_add(1);
+    if count.is_power_of_two() {
+        tracing::debug!(target: "rvoip_webrtc::canonical::media", ?medium, stage, count, ?reason, "RTC original packet path refused");
+    }
+}
