+
+
+async fn original_endpoint_install_room() -> Room {
+    let mut room = Room::new().await;
+    room.add("fresh", Some("public"), true).await;
+    room.domain
+        .local_preparations
+        .lock()
+        .unwrap()
+        .insert(ConnectionId::from_string("fresh"), "prepare-fresh".into());
+    room
+}
+
+#[tokio::test]
+async fn endpoint_install_current_policy_releases_scene_registry_and_state_for_original_playout() {
+    let mut room = original_endpoint_install_room().await;
+    room.publish("alice", 800).unwrap();
+    let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+    let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+    *room.domain.preparation_action.lock().unwrap() = Some(Box::new(move || {
+        entered_tx.send(()).unwrap();
+        release_rx
+            .recv_timeout(Duration::from_secs(2))
+            .expect("original install owner releases policy");
+    }));
+    let scene = room.scene.clone();
+    let (result_tx, result_rx) = std::sync::mpsc::sync_channel(1);
+    let worker = std::thread::spawn(move || {
+        let result =
+            scene.prepare_audio_endpoint(&ConnectionId::from_string("fresh"), "prepare-fresh");
+        assert!(result_tx.send(result).is_ok());
+    });
+    let mut original = AudioGateWorkers::new(release_tx, worker);
+    let entered = entered_rx.recv_timeout(Duration::from_secs(1));
+    let available = [
+        room.scene.members.try_lock().is_ok(),
+        room.scene.audiences.try_lock().is_ok(),
+        room.nodes["fresh"].controller.state.try_lock().is_ok(),
+    ];
+    if entered.is_ok() && available.iter().all(|v| *v) {
+        room.tick();
+        room.heard("bob", 800).await;
+        room.heard("public", 800).await;
+    }
+    original.finish();
+    let result = result_rx.recv().unwrap();
+    assert!(entered.is_ok(), "actual policy callback must execute");
+    assert_eq!(
+        available, [true; 3],
+        "external installation authority excluded original scene work"
+    );
+    assert!(result.is_ok());
+    assert!(room.domain.preparation_action.lock().unwrap().is_none());
+    drop(result);
+}
+
+#[tokio::test]
+async fn endpoint_install_revalidates_original_owners_generations_activation_and_probe_slot() {
+    for changed in 0..12 {
+        let room = original_endpoint_install_room().await;
+        let controller = room.nodes["fresh"].controller.clone();
+        let owner = room.domain.base.0.read().await.owners["fresh"].clone();
+        let scene = room.scene.clone();
+        let domain = room.domain.clone();
+        *room.domain.preparation_action.lock().unwrap() = Some(Box::new({
+            let controller = controller.clone();
+            move || {
+                assert!(scene.members.try_lock().is_ok());
+                assert!(scene.audiences.try_lock().is_ok());
+                assert!(controller.state.try_lock().is_ok());
+                match changed {
+                    0 => controller.credential.lock().unwrap().revision += 1,
+                    1 => {
+                        let mut s = controller.state.lock().unwrap();
+                        for paused in [true, false] {
+                            let revision = s.model.revision();
+                            s.model
+                                .set_paused(
+                                    &owner.current(),
+                                    revision,
+                                    &desired(Medium::Audio).logical_id,
+                                    paused,
+                                )
+                                .unwrap();
+                        }
+                    }
+                    2 => controller.state.lock().unwrap().active
+                        [&desired(Medium::Audio).logical_id]
+                        .retire(),
+                    3 => controller.shutdown.cancel(),
+                    4 => {
+                        scene
+                            .audiences
+                            .lock()
+                            .unwrap()
+                            .groups
+                            .remove("prepare-fresh");
+                    }
+                    5 => {
+                        let mut r = scene.audiences.lock().unwrap();
+                        let old = r.groups["prepare-fresh"].clone();
+                        r.groups
+                            .insert("prepare-fresh".into(), Arc::new((*old).clone()));
+                    }
+                    6 => controller
+                        .audio_consumer
+                        .lock()
+                        .unwrap()
+                        .as_ref()
+                        .unwrap()
+                        .upgrade()
+                        .unwrap()
+                        .activate(false),
+                    7 => controller
+                        .scene_consumer
+                        .lock()
+                        .unwrap()
+                        .as_ref()
+                        .unwrap()
+                        .upgrade()
+                        .unwrap()
+                        .activate(),
+                    8 => *controller.audio_consumer.lock().unwrap() = None,
+                    9 => *controller.scene_consumer.lock().unwrap() = None,
+                    10 => *controller.audio_preparation.lock().unwrap() = Some(Weak::new()),
+                    11 => {
+                        *domain.preparation_expiry.lock().unwrap() =
+                            Some(chrono::Utc::now() - chrono::Duration::milliseconds(1))
+                    }
+                    _ => unreachable!(),
+                }
+            }
+        }));
+        assert!(
+            room.scene
+                .prepare_audio_endpoint(&ConnectionId::from_string("fresh"), "prepare-fresh")
+                .is_err(),
+            "changed={changed}"
+        );
+        assert!(
+            room.domain.preparation_action.lock().unwrap().is_none(),
+            "actual callback must execute changed={changed}"
+        );
+        assert!(controller
+            .audio_preparation
+            .lock()
+            .unwrap()
+            .as_ref()
+            .and_then(Weak::upgrade)
+            .is_none());
+    }
+}
