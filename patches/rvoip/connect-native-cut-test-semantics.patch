+#[tokio::test]
+async fn native_cut_muted_receive_held_mapping_has_no_output_or_submission() {
+    let mut f=Preroll::new().await;enable_cut(&f);
+    let old=&f.movement.room.nodes["alice"].controller;
+    let ids=BTreeSet::from([desired(Medium::Video).logical_id]);
+    old.set_media_gate(old.revision(),&ids,StreamGateAction::Mute,deadline()).await.unwrap();
+    // Hold is Core-relative: Receive permits endpoint input only. With Mute it
+    // also retains the publication gate, so neither direction may submit.
+    old.set_media_gate(old.revision(),&ids,StreamGateAction::Hold {
+        direction:StreamDirection::Receive,
+    },deadline()).await.unwrap();
+    let (outcome,handle)=f.movement.commit(f.movement.plan_with_video(Some(request())).unwrap()).await.unwrap();
+    let receipt=outcome.media.replacement_activation.clone().unwrap();let cut=native_video_cut(&outcome);
+    let target=f.movement.room.nodes["device"].controller.clone();
+    let adapter=f.movement.room.nodes["device"].adapter.clone();
+    let camera=adapter.port(Medium::Video);
+    let port=adapter.ports.lock().unwrap()[&request().receivers[0].replacement].clone();
+    {
+        let state=target.state.lock().unwrap();
+        let publication=&state.model.streams()[&desired(Medium::Video).logical_id];
+        let incoming=&state.model.streams()[&request().receivers[0].replacement];
+        assert!(publication.source_muted);assert!(!publication.permits(false));
+        assert_eq!(incoming.hold_direction,Some(StreamDirection::Receive));
+        assert!(!incoming.permits(true));
+    }
+    assert!(matches!(camera.try_publish(&frame(&camera,76)),Err(StreamControlError::NotReady)));
+    assert_eq!(cut.identity(),&port.native_egress_identity().unwrap());
+    assert_eq!(cut.ordinal(),0);assert_eq!(cut.public_sequence_floor(),0);
+    f.publish_video("bob",76);
+    assert!(matches!(f.target_output.try_recv(),Err(mpsc::error::TryRecvError::Empty)),
+        "receive hold must refuse the selected incoming frame before queueing it");
+    assert_eq!(port.0.native_egress.get().unwrap().ordinal.load(Ordering::Acquire),0);
     assert_eq!(outcome.media.replacement_activation.as_ref(),Some(&receipt));
     assert_eq!(handle.finish_local_media_cleanup(deadline()).await,ReplacementCleanupOutcome::LocalMediaClosed);
 }
