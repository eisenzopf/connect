+//! Actual protocol handlers, with authenticated transport boundary explicit.
+use super::*;
+use crate::media_stream::MediaStreamTrack;
+use crate::peer_connection::configuration::media_engine::MediaEngine;
+use crate::peer_connection::handler::endpoint::{EndpointHandler, EndpointHandlerContext};
+use crate::rtp_transceiver::rtp_sender::{
+    RTCRtpCodec, RTCRtpCodingParameters, RTCRtpEncodingParameters, RtpCodecKind,
+};
+use crate::rtp_transceiver::{
+    RTCRtpTransceiverDirection, RTCRtpTransceiverInit, internal::RTCRtpTransceiverInternal,
+};
+use ::interceptor::NoopInterceptor;
+use rtcp::{
+    reception_report::ReceptionReport,
+    source_description::{
+        SdesType, SourceDescription, SourceDescriptionChunk, SourceDescriptionItem,
+    },
+};
+use sansio::Protocol;
+use shared::TransportContext;
+#[derive(Default)]
+struct RecordingHop {
+    inner: NoopInterceptor,
+    seen: Vec<Vec<u8>>,
+}
+impl Protocol<TaggedPacket, TaggedPacket, ()> for RecordingHop {
+    type Rout = TaggedPacket;
+    type Wout = TaggedPacket;
+    type Eout = ();
+    type Error = Error;
+    type Time = Instant;
+    fn handle_read(&mut self, msg: TaggedPacket) -> Result<()> {
+        if let Packet::Rtcp(packets) = &msg.message {
+            self.seen.push(
+                packets
+                    .iter()
+                    .map(|p| p.header().packet_type as u8)
+                    .collect(),
+            );
+        }
+        self.inner.handle_read(msg)
+    }
+    fn poll_read(&mut self) -> Option<TaggedPacket> {
+        self.inner.poll_read()
+    }
+    fn handle_write(&mut self, msg: TaggedPacket) -> Result<()> {
+        self.inner.handle_write(msg)
+    }
+    fn poll_write(&mut self) -> Option<TaggedPacket> {
+        self.inner.poll_write()
+    }
+    fn handle_event(&mut self, e: ()) -> Result<()> {
+        self.inner.handle_event(e)
+    }
+    fn poll_event(&mut self) -> Option<()> {
+        self.inner.poll_event()
+    }
+    fn handle_timeout(&mut self, t: Instant) -> Result<()> {
+        self.inner.handle_timeout(t)
+    }
+    fn poll_timeout(&mut self) -> Option<Instant> {
+        self.inner.poll_timeout()
+    }
+    fn close(&mut self) -> Result<()> {
+        self.inner.close()
+    }
+}
+impl Interceptor for RecordingHop {
+    fn bind_local_stream(&mut self, i: &::interceptor::StreamInfo) {
+        self.inner.bind_local_stream(i)
+    }
+    fn unbind_local_stream(&mut self, i: &::interceptor::StreamInfo) {
+        self.inner.unbind_local_stream(i)
+    }
+    fn bind_remote_stream(&mut self, i: &::interceptor::StreamInfo) {
+        self.inner.bind_remote_stream(i)
+    }
+    fn unbind_remote_stream(&mut self, i: &::interceptor::StreamInfo) {
+        self.inner.unbind_remote_stream(i)
+    }
+}
+fn cname(source: u32) -> SourceDescriptionChunk {
+    SourceDescriptionChunk {
+        source,
+        items: vec![SourceDescriptionItem {
+            sdes_type: SdesType::SdesCname,
+            text: b"same".to_vec().into(),
+        }],
+    }
+}
+fn source_report(source: u32, foreign_report: bool) -> Box<dyn rtcp::Packet> {
+    Box::new(SenderReport {
+        ssrc: source,
+        ntp_time: 100 << 32,
+        rtp_time: 48000,
+        packet_count: 1,
+        reports: if foreign_report {
+            vec![ReceptionReport {
+                ssrc: 999,
+                ..Default::default()
+            }]
+        } else {
+            vec![]
+        },
+        ..Default::default()
+    })
+}
+fn unknown_source_with_known_report_target() -> Box<dyn rtcp::Packet> {
+    Box::new(SenderReport {
+        ssrc: 999,
+        reports: vec![ReceptionReport {
+            ssrc: 11,
+            ..Default::default()
+        }],
+        ..Default::default()
+    })
+}
+fn source_description() -> Box<dyn rtcp::Packet> {
+    Box::new(SourceDescription {
+        chunks: vec![cname(999), cname(11)],
+    })
+}
+fn msg(packets: Vec<Box<dyn rtcp::Packet>>) -> TaggedRTCMessageInternal {
+    TaggedRTCMessageInternal {
+        now: Instant::now(),
+        transport: TransportContext::default(),
+        message: RTCMessageInternal::Rtp(RTPMessage::Packet(Packet::Rtcp(packets))),
+    }
+}
+fn active() -> RTCRtpTransceiverInternal<NoopInterceptor> {
+    let mut t = RTCRtpTransceiverInternal::new(
+        RtpCodecKind::Audio,
+        None,
+        RTCRtpTransceiverInit {
+            direction: RTCRtpTransceiverDirection::Recvonly,
+            ..Default::default()
+        },
+    );
+    t.set_current_direction(RTCRtpTransceiverDirection::Recvonly);
+    let r = t.receiver_mut().as_mut().unwrap();
+    r.set_coding_parameters(vec![RTCRtpCodingParameters {
+        ssrc: Some(11),
+        ..Default::default()
+    }]);
+    r.set_track(MediaStreamTrack::new(
+        "s".into(),
+        "source".into(),
+        "active".into(),
+        RtpCodecKind::Audio,
+        vec![RTCRtpEncodingParameters {
+            rtp_coding_parameters: RTCRtpCodingParameters {
+                ssrc: Some(11),
+                ..Default::default()
+            },
+            codec: RTCRtpCodec {
+                mime_type: "audio/opus".into(),
+                clock_rate: 48000,
+                ..Default::default()
+            },
+            ..Default::default()
+        }],
+    ));
+    t
+}
+fn drain_endpoint(
+    ctx: &mut EndpointHandlerContext,
+    tracks: &mut Vec<RTCRtpTransceiverInternal<NoopInterceptor>>,
+    messages: Vec<TaggedRTCMessageInternal>,
+) -> Vec<u8> {
+    let mut chain = NoopInterceptor::default();
+    let media = MediaEngine::default();
+    let mut stats = RTCStatsAccumulator::new();
+    let mut handler = EndpointHandler::new(ctx, tracks, &media, &mut chain, &mut stats);
+    for message in messages {
+        handler.handle_read(message).unwrap();
+    }
+    let mut result = vec![];
+    while let Some(m) = handler.poll_read() {
+        if let RTCMessageInternal::Rtp(RTPMessage::TrackPacket(p)) = m.message {
+            assert_eq!(p.track_id.to_string(), "source");
+            if let Packet::Rtcp(packets) = p.packet {
+                for packet in packets {
+                    result.push(packet.header().packet_type as u8);
+                }
+            }
+        }
+    }
+    assert!(
+        handler.poll_event().is_none(),
+        "RTCP cannot open or allocate a track"
+    );
+    result
+}
+#[test]
+fn source_clock_activation_authenticated_handlers_preserve_source_metadata_once() {
+    let mut ctx = InterceptorHandlerContext::default();
+    ctx.is_dtls_handshake_complete = true;
+    let mut chain = RecordingHop::default();
+    let mut stats = RTCStatsAccumulator::new();
+    let mut h = InterceptorHandler::new(&mut ctx, &mut chain, &mut stats);
+    h.handle_read(msg(vec![
+        Box::new(ReceiverReport::default()),
+        unknown_source_with_known_report_target(),
+        source_description(),
+        source_report(11, true),
+    ]))
+    .unwrap();
+    let mut messages = vec![];
+    while let Some(m) = h.poll_read() {
+        messages.push(m);
+    }
+    let mut endpoint = EndpointHandlerContext::default();
+    let mut tracks = vec![active()];
+    assert_eq!(
+        drain_endpoint(&mut endpoint, &mut tracks, messages),
+        vec![202, 200]
+    );
+    assert_eq!(
+        chain.seen,
+        vec![vec![201, 200, 202, 200]],
+        "the complete original compound traverses hop ownership once"
+    );
+    assert!(
+        chain.poll_read().is_none(),
+        "terminal hop still consumes RTCP"
+    );
+}
+#[test]
+fn source_clock_activation_endpoint_mixed_compound_uses_source_not_report_targets() {
+    let mut ctx = EndpointHandlerContext::default();
+    let mut tracks = vec![active()];
+    let got = drain_endpoint(
+        &mut ctx,
+        &mut tracks,
+        vec![msg(vec![
+            Box::new(ReceiverReport::default()),
+            unknown_source_with_known_report_target(),
+            source_description(),
+            source_report(11, true),
+        ])],
+    );
+    assert_eq!(got, vec![202, 200]);
+}
+#[test]
+fn source_clock_activation_endpoint_rejects_stopped_and_nonreceiving_sources() {
+    let mut ctx = EndpointHandlerContext::default();
+    let mut tracks = vec![active()];
+    assert_eq!(
+        drain_endpoint(
+            &mut ctx,
+            &mut tracks,
+            vec![msg(vec![source_report(11, false)])]
+        ),
+        vec![200]
+    );
+    tracks[0].set_current_direction(RTCRtpTransceiverDirection::Inactive);
+    assert!(
+        drain_endpoint(
+            &mut ctx,
+            &mut tracks,
+            vec![msg(vec![
+                source_report(11, false),
+                source_description(),
+                source_report(999, false)
+            ])]
+        )
+        .is_empty()
+    );
+    tracks[0].set_current_direction(RTCRtpTransceiverDirection::Recvonly);
+    tracks[0]
+        .stop(&MediaEngine::default(), &mut NoopInterceptor::default())
+        .unwrap();
+    assert!(
+        drain_endpoint(
+            &mut ctx,
+            &mut tracks,
+            vec![msg(vec![source_report(11, false), source_description()])]
+        )
+        .is_empty()
+    );
+    tracks = vec![active()];
+    tracks[0]
+        .receiver_mut()
+        .as_mut()
+        .unwrap()
+        .track_mut()
+        .set_codec_by_ssrc(RTCRtpCodec::default(), 11);
+    assert!(
+        drain_endpoint(
+            &mut ctx,
+            &mut tracks,
+            vec![msg(vec![source_report(11, false), source_description()])]
+        )
+        .is_empty(),
+        "declared but unopened source must not be activated by RTCP"
+    );
+}
