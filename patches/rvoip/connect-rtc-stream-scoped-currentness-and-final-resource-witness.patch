+async fn actual_rtc_current_and_final_resource_witness_do_not_wait_for_original_port_map() {
+    let mut h = resource_harness();
+    let outcome = std::panic::AssertUnwindSafe(async {
+        let (activation, prepared, owner) = original_resource_observation(&mut h, "alice").await;
+        let witness = activation.try_current_resource_witness().unwrap();
+        let expected_generation = witness.committed_generation();
+        let backend = h.backends[0].clone();
+        let stream = prepared.bindings()[0].transport_id.clone();
+        let held = backend.ports.get_mut(&stream).unwrap();
+        let (sent, returned) = std::sync::mpsc::sync_channel(1);
+        let reader = activation.clone();
+        let current = owner.clone();
+        let worker = std::thread::spawn(move || {
+            let _ = sent.send(reader.current(current).map(|_| ()));
+        });
+        let completed_before_release = returned.recv_timeout(Duration::from_millis(500));
+        let same_witness_current = witness.is_current();
+        let recaptured = activation.try_current_resource_witness().is_ok();
+        let prepare_busy = matches!(
+            activation.prepare(&prepared, owner.clone()),
+            Err(StreamControlError::MetadataBusy)
+        );
+        let selected_busy = matches!(
+            activation.try_current_resource_witness_for(prepared.bindings()),
+            Err(StreamControlError::MetadataBusy)
+        );
+        let physical_current = activation.try_physical_current_witness().is_ok();
+        // Release and join the original reader before asserting, including the
+        // old blocking map-read counterfactual. No observation timeout restarts.
+        drop(held);
+        let joined = worker.join();
+        assert!(
+            joined.is_ok() && matches!(completed_before_release, Ok(Ok(()))),
+            "actual current waited on original port registry"
+        );
+        assert!(
+            same_witness_current && recaptured && prepare_busy && selected_busy && physical_current
+        );
+        assert!(activation.current(owner).is_ok());
+        assert!(witness.belongs_to(&h.controllers[0]));
+        assert!(
+            witness.bindings().len() == prepared.bindings().len()
+                && witness
+                    .bindings()
+                    .iter()
+                    .zip(prepared.bindings())
+                    .all(|(a, b)| same_binding(a, b))
+        );
+        assert!(
+            witness.committed_generation() == expected_generation && expected_generation.is_some()
+        );
+        assert!(
+            tokio::time::timeout(Duration::from_secs(1), h.policy.guard.clone().write_owned())
+                .await
+                .is_ok()
+        );
+        witness
+    })
+    .catch_unwind()
+    .await;
+    let clean = h.close().await;
+    let witness = outcome.unwrap();
+    assert!(clean && !witness.is_current());
