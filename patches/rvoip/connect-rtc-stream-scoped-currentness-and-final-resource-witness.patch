+// Capture only the real Core-issued observation from the same normal initial
+// change. After activation the same real policy leases derive current owners
+// through the adapter, including original ingress; no ready/commit bits are set.
+struct ResourceObservationPolicy {
+    inner: Arc<Policy>,
+    observation: Arc<Mutex<Option<Arc<PreparedMediaObservation>>>>,
+    activation: Arc<OnceLock<Weak<RtcMediaActivation>>>,
+}
+struct ResourceObservationLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    observation: Arc<Mutex<Option<Arc<PreparedMediaObservation>>>>,
+    owner: MediaOwner,
+}
+impl MediaAuthorityLease for ResourceObservationLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<Utc>> {
+        self.inner.expires_at()
+    }
+    fn control_prepared(
+        &self,
+        prepared: &Arc<PreparedMediaObservation>,
+    ) -> ControlResult<Box<MediaOwner>> {
+        let owner = self.inner.control_prepared(prepared)?;
+        *self.observation.lock().unwrap() = Some(prepared.clone());
+        Ok(owner)
+    }
+}
+impl ResourceObservationPolicy {
+    fn read(
+        &self,
+        scope: &MediaScope<'_>,
+        original: bool,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let inner = if original {
+            self.inner.current_original_ingress(scope)?
+        } else {
+            self.inner.current(scope)?
+        };
+        let mut owner = inner.authority().clone();
+        if let Some(activation) = self.activation.get() {
+            owner = activation
+                .upgrade()
+                .ok_or(StreamControlError::Cancelled)?
+                .current(owner)?;
+        }
+        Ok(Box::new(ResourceObservationLease {
+            inner,
+            observation: self.observation.clone(),
+            owner,
+        }))
+    }
+}
+struct ResourceControlInvocation {
+    domain: Arc<Policy>,
+    cancellation: CancellationToken,
+    deadline: OnceLock<tokio::time::Instant>,
+}
+impl MediaPolicy for ResourceObservationPolicy {
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn std::any::Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let invocation = held
+            .downcast_ref::<ResourceControlInvocation>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&invocation.domain, &self.inner)
+            || !matches!(scope.purpose, MediaPurpose::Control)
+            || !matches!(intent, MediaControlIntent::Change { expected: 0, .. })
+        {
+            return Err(StreamControlError::Authority);
+        }
+        MediaControl::new(
+            self.current(scope)?,
+            invocation.cancellation.clone(),
+            *invocation.deadline.get_or_init(until),
+        )
+    }
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.read(scope, false)
+    }
+    fn current_original_ingress(
+        &self,
+        scope: &MediaScope<'_>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.read(scope, true)
+    }
+}
+fn resource_harness() -> Harness {
+    let mut h = Harness::new();
+    // The real VP8+audio SDP fixture negotiates Opus. Match its supported Core
+    // mono layout, without editing any existing video test's capabilities.
+    for owner in Arc::get_mut(&mut h.policy).unwrap().owners.values_mut() {
+        for capabilities in [&mut owner.local, &mut owner.remote] {
+            for capability in capabilities
+                .send
+                .iter_mut()
+                .chain(capabilities.receive.iter_mut())
+            {
+                if capability.medium == Medium::Audio {
+                    capability.formats = vec![MediaFormat::Encoded {
+                        name: "opus".into(),
+                        clock_rate_hz: 48000,
+                        channels: 1,
+                        fmtp: None,
+                    }];
+                }
+            }
+        }
+    }
+    h
+}
+async fn original_resource_observation_streams(
+    h: &mut Harness,
+    name: &str,
+    streams: &[DesiredStream],
+) -> (
+    Arc<RtcMediaActivation>,
+    Arc<PreparedMediaObservation>,
+    MediaOwner,
+) {
+    let captured = Arc::new(Mutex::new(None));
+    let activated = Arc::new(OnceLock::new());
+    let policy = Arc::new(ResourceObservationPolicy {
+        inner: h.policy.clone(),
+        observation: captured.clone(),
+        activation: activated.clone(),
+    });
+    let invocation = Arc::new(ResourceControlInvocation {
+        domain: h.policy.clone(),
+        cancellation: CancellationToken::new(),
+        deadline: OnceLock::new(),
+    });
+    h.pair_with_policy_streams(name, false, policy, streams, Some(invocation))
+        .await;
+    let prepared = captured
+        .lock()
+        .unwrap()
+        .take()
+        .expect("real Core initial prepared hook");
+    assert!(prepared.is_committed());
+    let route = h
+        .routes
+        .get(&ConnectionId::from_string(name))
+        .unwrap()
+        .clone();
+    let activation = route
+        .installation
+        .lock()
+        .unwrap()
+        .as_ref()
+        .unwrap()
+        .activation
+        .clone();
+    let owner = h.policy.owners[name].clone();
+    activation.prepare(&prepared, owner.clone()).unwrap();
+    activated.set(Arc::downgrade(&activation)).unwrap();
+    (activation, prepared, owner)
+}
+async fn original_resource_observation(
+    h: &mut Harness,
+    name: &str,
+) -> (
+    Arc<RtcMediaActivation>,
+    Arc<PreparedMediaObservation>,
+    MediaOwner,
+) {
+    original_resource_observation_streams(h, name, &[desired(Medium::Video)]).await
+}
