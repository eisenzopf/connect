+// Drive the real remote track into the ordinary SourceJob and Core ingress.
+// The policy uses activation.current on this original-ingress path.
+async fn receive_original_audio(
+    h: &Harness,
+    input: &mut mpsc::Receiver<MediaPacket>,
+    timestamp: &mut u32,
+) -> bool {
+    while input.try_recv().is_ok() {}
+    let bound = until();
+    let writer = h.remote[0].outbound_audio_writer().unwrap();
+    loop {
+        writer
+            .write_audio(
+                crate::peer::builder::OPUS_PAYLOAD_TYPE,
+                *timestamp,
+                crate::media::pump::silent_opus_payload(),
+            )
+            .await
+            .unwrap();
+        *timestamp += 960;
+        tokio::select! {
+            packet = input.recv() => return packet.is_some(),
+            _ = tokio::time::sleep_until(bound) => return false,
+            _ = tokio::time::sleep(Duration::from_millis(20)) => {},
+        }
+    }
+}
