+++ b/crates/foundation/rvoip-core/src/staged_streams/tests/guarded_mixer/tick_publication.rs
@@ -0,0 +1,119 @@
+use super::*;
+
+#[derive(Default)]
+struct Probe {
+    queue: std::sync::Mutex<Option<mpsc::Receiver<QueuedMedia>>>,
+    early: std::sync::atomic::AtomicBool,
+}
+struct ObservedLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    probe: Arc<Probe>,
+}
+impl MediaAuthorityLease for ObservedLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        self.inner.expires_at()
+    }
+    fn packet_context(&self) -> Option<&(dyn std::any::Any + Send + Sync)> {
+        self.inner.packet_context()
+    }
+}
+impl Drop for ObservedLease {
+    fn drop(&mut self) {
+        // This real policy reader is still held here. Observe the actual
+        // receiver without sending, inventing authority or awaiting a callback.
+        let mut queue = self.probe.queue.lock().unwrap();
+        if queue.as_mut().is_some_and(|q| q.try_recv().is_ok()) {
+            self.probe.early.store(true, Ordering::Release);
+        }
+    }
+}
+struct ObservedPolicy {
+    inner: Arc<Policy>,
+    probe: Arc<Probe>,
+}
+impl MediaPolicy for ObservedPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        Ok(Box::new(ObservedLease {
+            inner: self.inner.current(scope)?,
+            probe: self.probe.clone(),
+        }))
+    }
+    fn current_participant_receive(
+        &self,
+        scope: &MediaScope<'_>,
+        source: &MediaParticipantSource,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current_participant_receive(scope, source)
+    }
+}
+#[tokio::test]
+async fn queued_output_is_published_after_tick_readers_release_and_rechecks_current_authority() {
+    for withdrawn in [false, true] {
+        let probe = Arc::new(Probe::default());
+        let observed = probe.clone();
+        let s = Scene::new_inner(
+            &four()[..2],
+            8000,
+            Some(Box::new(move |inner| {
+                Arc::new(ObservedPolicy {
+                    inner,
+                    probe: observed,
+                })
+            })),
+        )
+        .await;
+        s.bind(0, true).await;
+        s.bind(1, false).await;
+        *probe.queue.lock().unwrap() = Some(s.port(1).take_egress().unwrap());
+        s.publish(0, 3000);
+        s.mixer.tick();
+        assert!(
+            !probe.early.load(Ordering::Acquire),
+            "queued output woke its consumer before producer policy readers released"
+        );
+        drop(
+            s.policy
+                .0
+                .try_write()
+                .expect("idle queued output retained a producer reader"),
+        );
+        let queued = probe
+            .queue
+            .lock()
+            .unwrap()
+            .as_mut()
+            .unwrap()
+            .try_recv()
+            .unwrap();
+        if withdrawn {
+            s.policy
+                .0
+                .try_write()
+                .unwrap()
+                .revoked
+                .insert("alice".into());
+            let calls = std::sync::atomic::AtomicUsize::new(0);
+            let result = queued
+                .deliver(|_| {
+                    calls.fetch_add(1, Ordering::AcqRel);
+                    std::future::ready(Ok(()))
+                })
+                .await;
+            assert!(matches!(result, Err(StreamControlError::Authority)));
+            assert_eq!(calls.load(Ordering::Acquire), 0);
+        } else {
+            heard(queued, 3000).await;
+        }
+        assert!(probe
+            .queue
+            .lock()
+            .unwrap()
+            .as_mut()
+            .unwrap()
+            .try_recv()
+            .is_err());
+    }
+}
