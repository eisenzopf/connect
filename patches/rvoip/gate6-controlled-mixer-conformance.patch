+//! Feature-gated host conformance access to the actual owned scene tick.
+//! This creates no policy grant, replacement, or transport. Callers supply
+//! already negotiated controllers and their exact current policy instance.
+use super::*;
+
+pub struct ControlledAudioScene(Arc<media_scene::GuardedMediaScene>);
+impl ControlledAudioScene {
+    pub fn new(
+        conversation: ConversationId,
+        session: SessionId,
+        policy: Arc<dyn MediaPolicy>,
+    ) -> Self {
+        Self(media_scene::GuardedMediaScene::new(
+            conversation,
+            session,
+            policy,
+            8000,
+        ))
+    }
+    pub async fn attach(
+        &self,
+        controller: Arc<StreamController>,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<()> {
+        let id = controller.connection.clone();
+        let mut member = self.0.prepare(controller)?;
+        member.quiesce(deadline, CancellationToken::new()).await?;
+        if !member.ready() {
+            return Err(StreamControlError::NotReady);
+        }
+        self.0.insert(id, member, true);
+        Ok(())
+    }
+    /// Same production scene tick, including current admission, decoding,
+    /// source leases, receiver policy, and bounded queued output ownership.
+    pub fn tick(&self) {
+        self.0.tick();
+    }
+}
+impl Drop for ControlledAudioScene {
+    fn drop(&mut self) {
+        self.0.clear();
+    }
+}
