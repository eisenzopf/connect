+    /// return no IO grant; actual subscription commit still reauthorizes.
+    pub fn validate_staged_media_selection_sources(
+        &self,
+        session: &SessionId,
+        connection: &ConnectionId,
+        plan: &crate::staged_streams::subscription_plan::MediaSubscriptionPlan,
+        receive: impl FnMut(
+            &crate::staged_streams::MediaSource,
+            crate::stream_lifecycle::Medium,
+        ) -> crate::staged_streams::ControlResult<()>,
+        participant: impl FnMut(
+            &crate::staged_streams::MediaParticipantSource,
+        ) -> crate::staged_streams::ControlResult<()>,
+    ) -> ControlResult<()> {
+        let runtime = self.participant_runtime(session)?;
+        let scene = runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        {
+            let state = runtime.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state.ended || !state.routes.contains_key(connection) {
+                return Err(ParticipantTransitionError::Inactive.into());
+            }
+        }
+        Ok(scene.validate_selection_sources(connection, plan, receive, participant)?)
