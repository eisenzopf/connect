+    /// Check only scene-issued source metadata. This cannot acquire ports,
+    /// quiesce delivery, install intent or mint a media-control grant. Callers
+    /// must repeat current authorization during the actual commit.
+    pub(crate) fn validate_selection_sources(
+        &self,
+        target_id: &ConnectionId,
+        plan: &MediaSubscriptionPlan,
+        mut receive: impl FnMut(&MediaSource, Medium) -> ControlResult<()>,
+        participant: impl FnMut(&MediaParticipantSource) -> ControlResult<()>,
+    ) -> ControlResult<()> {
+        let members = self
+            .members
+            .try_lock()
+            .map_err(|_| StreamControlError::Backpressure)?;
+        let target = members.get(target_id).ok_or(StreamControlError::NotReady)?;
+        {
+            let state = target
+                .controller
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::Backpressure)?;
+            if state.closed || state.model.revision() != plan.expected {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+        }
+        if let Some(selection) = &plan.change.selection {
+            selection.validate_scope(self, &target.controller, plan.expected)?;
+            selection.check_requested_sources(&members, participant)?;
+        }
+        for snapshot in &plan.sources {
+            let publisher = snapshot
+                .publisher
+                .upgrade()
+                .ok_or(StreamControlError::NotReady)?;
+            if !members
+                .get(&publisher.connection)
+                .is_some_and(|m| Arc::ptr_eq(&m.controller, &publisher))
+                || publisher.shutdown.is_cancelled()
+            {
+                return Err(StreamControlError::Authority);
+            }
+            let credential = publisher.credential_snapshot();
+            publisher.check_credential_snapshot(&credential)?;
+            let state = publisher
+                .state
+                .try_lock()
+                .map_err(|_| StreamControlError::Backpressure)?;
+            let binding = &snapshot.binding;
+            let logical = &binding.negotiated.requested.logical_id;
+            if state.closed
+                || !state
+                    .active
+                    .get(logical)
+                    .is_some_and(|p| same_binding(&p.binding, binding))
+                || !state
+                    .model
+                    .streams()
+                    .get(logical)
+                    .is_some_and(|s| s.state != LogicalStreamState::Ended)
+            {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            let descriptor = MediaSource {
+                conversation: publisher.conversation.clone(),
+                session: publisher.session.clone(),
+                connection: publisher.connection.clone(),
+                participant: publisher.origin_member.participant().clone(),
+                membership_epoch: publisher.origin_member.epoch(),
+                connection_generation: binding.connection_generation,
+                logical_id: logical.clone(),
+                transport_id: binding.transport_id.clone(),
+                stream_generation: binding.generation,
+            };
+            receive(&descriptor, binding.negotiated.requested.medium)?;
+        }
+        Ok(())
+    }
