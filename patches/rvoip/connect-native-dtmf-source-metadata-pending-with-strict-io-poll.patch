+async fn native_dtmf_pending_source_metadata_cancel_deadline_and_retirement_never_lend_io() {
+    for mode in ["cancel","deadline","retire","recipient-rebind"] {
+        let (mut s,mut target,registration) = delivery_pair().await;
+        let original = observation(&mut s).await;let controller = s.controller();
+        let installed = Installed {domain:s.grants.clone(),record:s.record.clone()};
+        let mut holder = DtmfSourceMetadataHolder::new(original.clone(),controller.clone(),true);
+        let cancel = CancellationToken::new();
+        let until = Instant::now()+Duration::from_millis(if mode=="deadline" {80}else{1_000});
+        let submission = registration.prepare_delivery(&original,&installed,None,until,cancel.clone()).unwrap();
+        no_signal(&mut target).await;
+        let retiring = if mode=="retire" {
+            let c=controller.clone();Some(std::thread::spawn(move||c.retire()))
+        }else{None};
+        if mode=="cancel" {cancel.cancel();}
+        if mode=="recipient-rebind" {
+            let recipient=s.native.adapters[&s.kind].media_controller(&s.second_id).unwrap();
+            let principal=original.principal().clone();
+            assert!(recipient.matches_data_credential(&principal));
+            let previous=recipient.credential_revision();let stream_revision=recipient.revision();
+            let guard=Arc::new(s.grants.0.clone().read_owned().await);
+            let held=RecipientRebindControl {domain:s.grants.clone(),guard,connection:s.second_id.clone(),principal:principal.clone(),credential_revision:previous,stream_revision,until};
+            let next=recipient.rebind_credential_with_held(principal.clone(),previous,stream_revision,until,CancellationToken::new(),&held).await.unwrap();
+            drop(held);
+            assert_eq!(next,previous+1);assert_eq!(recipient.credential_revision(),previous+1);
+            assert!(recipient.matches_data_credential(&principal),"principal bytes unchanged; only actual credential epoch advanced");
+            holder.close();
+        }
+        if mode=="retire" {
+            tokio::time::timeout_at(until,async {while !controller.retirement_requested_for_test(){tokio::task::yield_now().await;}}).await.unwrap();
+            holder.close();
+            retiring.unwrap().join().unwrap();
+        }
+        assert_eq!(tokio::time::timeout_at(until+Duration::from_millis(100),submission.written()).await.unwrap(),Err(DispatchError::Closed));
+        if mode=="deadline" {assert!(Instant::now()>=until);}
+        holder.close();
+        no_signal(&mut target).await;
+        tokio::time::timeout(Duration::from_secs(1),async {while s.grants.0.try_write().is_err(){tokio::task::yield_now().await;}}).await.unwrap();
+        if mode=="retire" || mode=="recipient-rebind" {
+            assert!(matches!(registration.prepare_delivery(&original,&installed,None,deadline(),CancellationToken::new()),Err(DispatchError::Closed)),"old registration must not borrow a later identical-principal credential epoch");
+            no_signal(&mut target).await;
+        }
+        assert_eq!(s.record.dtmf_count.load(Ordering::Acquire),1);
+        s.wire.server.shutdown().await.unwrap();target.server.shutdown().await.unwrap();
+    }
