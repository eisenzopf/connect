+        submission = registration.prepare_delivery(&original,&installed,None,original_until,CancellationToken::new())
+            .expect("metadata contention must keep the same original pending, never Closed");
+    }
+    // This evaluates the exact historical boolean on the REAL held source.
+    // It demonstrates the old collapse without simulating its lock outcome.
+    let historical_closed = !original.source_current_baseline_for_test();
+    let metadata = original.prepare_core_route(&s.native.core.orch,s.second_id.clone());
+    let snapshot = original.source_state_diagnostics_for_test().unwrap();
+    let mut written = Box::pin(submission.written());
+    tokio::select! { biased;
+        result = &mut written => panic!("held actual source prematurely completed: {result:?}"),
+        _ = async {if self_recipient {no_signal(&mut s.wire).await}else{no_signal(&mut target).await}} => {}
+    }
+    holder.close();
+    assert!(historical_closed && matches!(metadata,Err(rvoip_core::dtmf::DtmfWriteError::NotReady)));
+    assert!(snapshot.not_ready >= 2 && snapshot.last_tag == 2 && snapshot.refused == 0);
+    let (frame,receipt) = tokio::time::timeout_at(original_until,async {
+        let frame = if self_recipient {s.wire.read().await}else{target.read().await};
+        let receipt = written.await.unwrap();
+        (frame,receipt)
+    }).await.expect("same original source did not recover within its unchanged bound");
+    assert_eq!(frame.kind(),"dtmf.received");s.f.verify_server(&frame).await;
+    assert_eq!(frame.scope(Scope::Connection),Some(if self_recipient {"native_0"}else{"native_1"}));
+    assert_eq!(frame.original()["operation_id"],json!(original.operation_id()));
+    assert_eq!(frame.original()["payload"]["digits"],json!(original.digits()));
+    assert_eq!(receipt.as_str(),frame.id());
+    assert_eq!(s.record.dtmf_count.load(Ordering::Acquire),1,"no new signed operation or second observation");
+    if self_recipient {no_signal(&mut s.wire).await}else{no_signal(&mut target).await}
+    controller.retire();
+    assert!(!original.source_current_baseline_for_test());
+    assert!(matches!(registration.prepare_delivery(&original,&installed,None,original_until,CancellationToken::new()),Err(DispatchError::Closed)));
+    if self_recipient {no_signal(&mut s.wire).await}else{no_signal(&mut target).await}
+    s.wire.server.shutdown().await.unwrap();target.server.shutdown().await.unwrap();
+}
