+#[cfg(feature = "test-support")]
+async fn source_busy_delivery(queued: bool, flow: bool, self_recipient: bool) {
+    let (mut s, mut target, remote) = delivery_pair().await;
+    let registration = if self_recipient {
+        s.grants.0.write().await.dtmf_forward_allowed.insert((s.id.clone(),s.id.clone()));
+        s.record.dtmf_registrations.lock().unwrap()[&s.id].clone()
+    } else { remote };
+    let original = observation(&mut s).await;
+    assert!(original.enable_source_state_diagnostics_for_test());
+    let controller = s.controller();
+    let installed = Installed { domain: s.grants.clone(), record: s.record.clone() };
+    let original_until = Instant::now() + Duration::from_secs(1);
+    let mut holder;
+    let submission;
+    if queued {
+        s.record.dtmf_pause_delivery.store(true,Ordering::Release);
+        submission = registration.prepare_delivery(&original,&installed,None,original_until,CancellationToken::new()).unwrap();
+        tokio::time::timeout_at(original_until,s.record.dtmf_delivery_entered.notified()).await.unwrap();
+        holder = DtmfSourceMetadataHolder::new(original.clone(),controller.clone(),flow);
+        s.record.dtmf_pause_delivery.store(false,Ordering::Release);
+        s.record.dtmf_delivery_release.notify_one();
+    } else {
