+#[tokio::test]
+async fn private_video_publisher_poison_and_original_expiry_remain_terminal_before_routes() {
+    for refusal in ["poisoned", "expired"] {
+        let f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let publisher = f.movement.room.nodes["bob"].controller.clone();
+        let mapping = request();
+        let approval = || Approval::PrepareVideo {
+            source: old.connection.clone(),
+            connection: target.connection.clone(),
+            expected: target.revision(),
+            request: mapping.clone(),
+        };
+        let grant = f.movement.room.grant(approval()).await;
+        let cutoff;
+        if refusal == "poisoned" {
+            let original = publisher.clone();
+            assert!(std::thread::spawn(move || {
+                let _held = original.state.lock().unwrap();
+                panic!("controlled publisher metadata poison");
+            })
+            .join()
+            .is_err());
+            cutoff = deadline();
+        } else {
+            cutoff = tokio::time::Instant::now() + Duration::from_millis(200);
+            let held = publisher.state.lock().unwrap();
+            assert!(matches!(
+                target.prepare_replacement_video(
+                    &old, &mapping,
+                    &PrivateVideoBindingLifetime::for_test(&target, cutoff, CancellationToken::new()),
+                    cutoff, &grant,
+                ),
+                Ok(VideoReplacementPreparationAttempt::MetadataBusy { deadline }) if deadline == cutoff
+            ));
+            assert_eq!(
+                target.direct_subscriptions.private_route_count_for_test(),
+                0
+            );
+            drop(grant);
+            tokio::time::sleep_until(cutoff).await;
+            assert!(tokio::time::Instant::now() >= cutoff);
+            drop(held);
+            // A new current authority capture cannot renew the exact original
+            // structural preparation or installation cutoff after expiry.
+            let fresh = f.movement.room.grant(approval()).await;
+            let result = target.prepare_replacement_video(
+                &old,
+                &mapping,
+                &PrivateVideoBindingLifetime::for_test(&target, cutoff, CancellationToken::new()),
+                cutoff,
+                &fresh,
+            );
+            assert!(matches!(result, Err(StreamControlError::Cancelled)));
+            assert_eq!(
+                target.direct_subscriptions.private_route_count_for_test(),
+                0
+            );
+            assert!(!target.shutdown.is_cancelled());
+            continue;
+        }
+        let result = target.prepare_replacement_video(
+            &old,
+            &mapping,
+            &PrivateVideoBindingLifetime::for_test(&target, cutoff, CancellationToken::new()),
+            cutoff,
+            &grant,
+        );
+        assert!(matches!(
+            result,
+            Err(StreamControlError::Model(MediaTransitionError::Conflict))
+        ));
+        assert_eq!(
+            target.direct_subscriptions.private_route_count_for_test(),
+            0
+        );
+        assert!(!target.shutdown.is_cancelled());
+    }
+}
