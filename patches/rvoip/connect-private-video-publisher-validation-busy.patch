+#[tokio::test]
+async fn private_video_publisher_exclusion_does_not_bypass_cancel_revocation_or_expected_revision()
+{
+    for refusal in ["cancel", "revoke", "revision"] {
+        let mut f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let revision = target.revision();
+        let cancellation = CancellationToken::new();
+        let cutoff = deadline();
+        let approval = || Approval::PrepareVideo {
+            source: old.connection.clone(),
+            connection: target.connection.clone(),
+            expected: revision,
+            request: request(),
+        };
+        let grant = f.movement.room.grant(approval()).await;
+        let publisher = f.movement.room.nodes["bob"].controller.clone();
+        let held = publisher.state.lock().unwrap();
+        assert!(matches!(
+            target.prepare_replacement_video(
+                &old,
+                &request(),
+                &PrivateVideoBindingLifetime::for_test(&target, cutoff, cancellation.clone()),
+                cutoff,
+                &grant
+            ),
+            Ok(VideoReplacementPreparationAttempt::MetadataBusy { .. })
+        ));
+        drop(held);
+        drop(grant);
+        match refusal {
+            "cancel" => cancellation.cancel(),
+            "revoke" => {
+                f.movement
+                    .room
+                    .domain
+                    .base
+                    .0
+                    .write()
+                    .await
+                    .revoked
+                    .insert("alice".into());
+            }
+            "revision" => {
+                let media = target
+                    .active_bindings()
+                    .into_iter()
+                    .map(|binding| binding.negotiated.requested)
+                    .collect::<Vec<_>>();
+                target
+                    .change(
+                        revision,
+                        &media,
+                        &BTreeSet::from([request().receivers[0].replacement.clone()]),
+                        cutoff,
+                        CancellationToken::new(),
+                    )
+                    .await
+                    .unwrap();
+            }
+            _ => unreachable!(),
+        }
+        let grant = f.movement.room.grant(approval()).await;
+        let result = target.prepare_replacement_video(
+            &old,
+            &request(),
+            &PrivateVideoBindingLifetime::for_test(&target, cutoff, cancellation.clone()),
+            cutoff,
+            &grant,
+        );
+        assert!(matches!(
+            result,
+            Err(StreamControlError::Cancelled | StreamControlError::Authority)
+        ));
+        assert!(target.direct_subscriptions.private_route_count_for_test() == 0);
+        assert!(f.target_output.try_recv().is_err());
+        assert!(!old.shutdown.is_cancelled());
+    }
+}
