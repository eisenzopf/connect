+use super::*;
+
+#[tokio::test]
+async fn private_video_publisher_exclusion_is_unpublished_preserves_ordinary_mapping_and_recovers()
+{
+    for who in ["bob"] {
+        let mut f = Preroll::new().await;
+        let old = f.movement.room.nodes["alice"].controller.clone();
+        let target = f.movement.room.nodes["device"].controller.clone();
+        let connection_before = f.movement.pending.binding().clone();
+        let revision = target.revision();
+        let expected_bindings = bindings(&target);
+        let cancellation = CancellationToken::new();
+        let cutoff = deadline();
+        let grant = f
+            .movement
+            .room
+            .grant(Approval::PrepareVideo {
+                source: old.connection.clone(),
+                connection: target.connection.clone(),
+                expected: revision,
+                request: request(),
+            })
+            .await;
+        let controller = f.movement.room.nodes[who].controller.clone();
+        let held = controller.state.lock().unwrap();
+        let attempt = target
+            .prepare_replacement_video(
+                &old,
+                &request(),
+                &PrivateVideoBindingLifetime::for_test(&target, cutoff, cancellation.clone()),
+                cutoff,
+                &grant,
+            )
+            .unwrap();
+        assert!(
+            matches!(attempt, VideoReplacementPreparationAttempt::MetadataBusy { deadline } if deadline <= cutoff)
+        );
+        assert!(target.direct_subscriptions.private_route_count_for_test() == 0);
+        assert!(f.target_output.try_recv().is_err());
+        // The same actual held publisher state keeps the ordinary API's
+        // Backpressure meaning; only private preparation consumes its tag.
+        let target_state = target.state.lock().unwrap();
+        let credential = target.credential_snapshot();
+        let scope = target.scope(&credential.principal, MediaPurpose::Control);
+        let change = DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+            &controller,
+            desired(Medium::Video).logical_id,
+            request().receivers[0].replacement.clone(),
+        )]);
+        assert!(matches!(
+            target.validate_direct_for_test(&target_state, &scope, &change),
+            Err(StreamControlError::Backpressure)
+        ));
+        drop(target_state);
+        drop(held);
+        assert_eq!(target.revision(), revision);
+        assert_eq!(bindings(&target), expected_bindings);
+        assert!(f
+            .movement
+            .pending
+            .binding()
+            .same_incarnation(&connection_before));
+        assert!(!cancellation.is_cancelled());
+        // Same captured root, expected revision, request and original cutoff.
+        let prepared = match target
+            .prepare_replacement_video(
+                &old,
+                &request(),
+                &PrivateVideoBindingLifetime::for_test(&target, cutoff, cancellation.clone()),
+                cutoff,
+                &grant,
+            )
+            .unwrap()
+        {
+            VideoReplacementPreparationAttempt::Prepared(prepared) => prepared,
+            _ => panic!("released original metadata did not recover"),
+        };
+        assert!(prepared.is_current());
+        assert_eq!(
+            target.direct_subscriptions.private_route_count_for_test(),
+            1
+        );
+        f.publish_video("bob", 200);
+        delivered(&mut f.old_output, 200).await;
+        delivered(&mut f.target_output, 200).await;
+        prepared.close();
+        assert!(target.direct_subscriptions.private_route_count_for_test() == 0);
+        assert_eq!(target.revision(), revision);
+        assert_eq!(bindings(&target), expected_bindings);
+        assert!(!cancellation.is_cancelled());
+    }
+}
