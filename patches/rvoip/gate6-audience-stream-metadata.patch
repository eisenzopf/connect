+#[tokio::test]
+async fn audience_commit_metadata_legacy_isolation_has_no_gate_mutation() {
+    let mut p = Prepared::new(false).await;
+    p.ready().await;
+    let controller = p.room.nodes["fresh"].controller.clone();
+    assert!(
+        !controller.state.lock().unwrap().model.streams()[&desired(Medium::Audio).logical_id]
+            .source_muted
+    );
+    let plan = p.plan(OldHandoffDisposition::Leave).unwrap();
+    let (_, handle) = p.room.handoff(plan).await.unwrap();
+    assert!(handle
+        .audience()
+        .commit()
+        .captured_gates(&ConnectionId::from_string("fresh"))
+        .unwrap()
+        .is_empty());
+    assert!(handle
+        .audience()
+        .commit()
+        .captured_gates(&ConnectionId::from_string("bob"))
+        .unwrap()
+        .is_empty());
+    assert!(handle
+        .audience()
+        .commit()
+        .revisions_for(&controller)
+        .is_ok());
+}
