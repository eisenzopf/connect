+
+#[tokio::test]
+async fn audience_commit_metadata_endpoint_gate_facts_do_not_extend_live_confirmation() {
+    let mut t = Target::new(false).await;
+    t.room.publish("fresh", 12000).unwrap();
+    t.queue();
+    t.room.heard("fresh", 0).await;
+    let controller = t.room.nodes["fresh"].controller.clone();
+    assert!(
+        controller.state.lock().unwrap().model.streams()[&desired(Medium::Audio).logical_id]
+            .source_muted
+    );
+    let plan = t.plan().unwrap();
+    let (_, handle) = t.room.handoff(plan).await.unwrap();
+    let incoming = ConnectionId::from_string("fresh");
+    let commit = handle.audience().commit();
+    let facts = commit.captured_gates(&incoming).unwrap().to_vec();
+    assert_eq!(facts.len(), 1);
+    assert_eq!(
+        facts[0].negotiated.requested.logical_id,
+        desired(Medium::Audio).logical_id
+    );
+    assert_eq!(
+        facts[0].state,
+        crate::stream_lifecycle::LogicalStreamState::Active
+    );
+    assert!(!facts[0].source_muted);
+    assert!(commit
+        .captured_gates(&ConnectionId::from_string("bob"))
+        .unwrap()
+        .is_empty());
+    assert!(commit
+        .captured_gates(&ConnectionId::from_string("foreign"))
+        .is_none());
+    assert!(commit.revisions_for(&controller).is_ok());
+    t.room.publish("fresh", 7600).unwrap();
+    t.room.tick();
+    t.room.heard("bob", 7600).await;
+    let (_, changed) = controller
+        .set_media_gate(
+            controller.revision(),
+            &BTreeSet::from([desired(Medium::Audio).logical_id]),
+            StreamGateAction::Mute,
+            deadline(),
+        )
+        .await
+        .unwrap();
+    assert!(changed[0].source_muted);
+    assert_eq!(changed[0].generation, facts[0].generation);
+    assert_eq!(changed[0].stream_local_id, facts[0].stream_local_id);
+    assert_eq!(commit.captured_gates(&incoming), Some(facts.as_slice()));
+    assert!(
+        commit.revisions_for(&controller).is_err(),
+        "historical facts must not confirm a later physical revision"
+    );
+}
