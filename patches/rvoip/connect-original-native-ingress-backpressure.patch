+#[tokio::test]
+async fn original_native_backpressure_retains_expiry_retirement_and_terminal_policy_refusals() {
+    for action in [
+        "expiry",
+        "retirement",
+        "authority",
+        "unsupported",
+        "cancelled",
+        "not-ready",
+    ] {
+        let (network, source, _target, policy, mut input) = full_video_ingress().await;
+        let counters = network.adapter().media_counters(&source.id).unwrap();
+        send(
+            &network.wire,
+            ordered_queue_video(binding(&source, Medium::Video).stream_local_id, 65),
+        );
+        let deferred = tokio::time::timeout(Duration::from_millis(100), async {
+            while counters.snapshot().original_backpressure_deferred == 0 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .is_ok();
+        let mut shutdown_remaining = None;
+        match action {
+            "expiry" => tokio::time::sleep(Duration::from_millis(210)).await,
+            "retirement" => {
+                shutdown_remaining = Some(source.controller.shutdown(deadline()).await);
+            }
+            "authority" => policy.refusal.store(1, Ordering::SeqCst),
+            "unsupported" => policy.refusal.store(2, Ordering::SeqCst),
+            "cancelled" => policy.refusal.store(3, Ordering::SeqCst),
+            "not-ready" => policy.refusal.store(4, Ordering::SeqCst),
+            _ => unreachable!(),
+        }
+        let terminal = tokio::time::timeout(Duration::from_millis(100), async {
+            while source.media.snapshot().ingress_rejected == 0 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .is_ok();
+        // Exactly the originally accepted64 remain. The65th never receives a
+        // renewed200ms bound, new route, or fallback around the current denial.
+        let mut drained = 0;
+        while input.try_recv().is_ok() {
+            drained += 1;
+        }
+        let no_extra = input.try_recv().is_err();
+        network.stop().await;
+        let after = counters.snapshot();
+        assert!(
+            !source.media.snapshot().reader_running && source.media.router().is_shutdown(),
+            "{action}: reader unjoined"
+        );
+        assert!(
+            deferred && terminal,
+            "{action}: did not exercise retained then terminal original"
+        );
+        assert_eq!(drained, 64, "{action}: stale65th original escaped");
+        assert!(no_extra);
+        assert_eq!(
+            after.original_recovered, 0,
+            "{action}: refused original was recovered"
+        );
+        assert_eq!(after.ingress_accepted, 64);
+        assert_eq!(after.ingress_rejected, 1);
+        if action == "expiry" {
+            assert_eq!(after.original_expired, 1);
+        }
+        if action == "retirement" {
+            assert_eq!(
+                shutdown_remaining,
+                Some(0),
+                "original Core cleanup incomplete"
+            );
+            assert_eq!(
+                after.original_refused, 1,
+                "retired original ticket was not refused"
+            );
+            assert_eq!(
+                after.original_expired, 0,
+                "expiry substituted for retirement"
+            );
+            assert_eq!(
+                after.original_abandoned, 0,
+                "physical close substituted for ticket retirement"
+            );
+        }
+        if ["authority", "unsupported", "cancelled", "not-ready"].contains(&action) {
+            assert_eq!(after.original_refused, 1);
+        }
+    }
+}
