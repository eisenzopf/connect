+// Same real canonical reader and Core queue as metadata retry, but this
+// original is already authorized and is refused only by the full ingress64.
+struct OriginalQueuePolicy {
+    policy: Arc<MediaGrants>,
+    calls: AtomicUsize,
+    refusal: std::sync::atomic::AtomicU8,
+}
+impl MediaPolicy for OriginalQueuePolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.policy.current(scope)
+    }
+    fn current_original_ingress(
+        &self,
+        scope: &MediaScope<'_>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        match self.refusal.load(Ordering::SeqCst) {
+            1 => Err(StreamControlError::Authority),
+            2 => Err(StreamControlError::Unsupported),
+            3 => Err(StreamControlError::Cancelled),
+            4 => Err(StreamControlError::NotReady),
+            _ => self.policy.current(scope),
+        }
+    }
+}
+fn ordered_queue_video(stream: u16, sequence: u16) -> Bytes {
+    let mut packet = vec![0x80, 0x80 | 96];
+    packet.extend_from_slice(&sequence.to_be_bytes());
+    packet.extend_from_slice(&(u32::from(sequence) * 3000).to_be_bytes());
+    packet.extend_from_slice(&7u32.to_be_bytes());
+    packet.extend_from_slice(&[0x10, 1, 2, 3]);
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {
+        flags: 0,
+        stream_local_id: stream,
+        seq: u32::from(sequence),
+        rtp: observe_rtp(packet.into()).unwrap(),
+    })
+    .unwrap()
+}
+async fn full_video_ingress() -> (
+    Network,
+    Leg,
+    Leg,
+    Arc<OriginalQueuePolicy>,
+    mpsc::Receiver<MediaPacket>,
+) {
+    use rvoip_core::staged_streams::direct_subscriptions::{
+        DirectSubscription, DirectSubscriptionChange,
+    };
+    let mut network = Network::new("quic").await;
+    let policy = Arc::new(OriginalQueuePolicy {
+        policy: network.grants.clone(),
+        calls: AtomicUsize::new(0),
+        refusal: std::sync::atomic::AtomicU8::new(0),
+    });
+    let source = network.configure_policy(0, policy.clone()).await;
+    let target = network.configure_policy(1, policy.clone()).await;
+    network.start(&source, &[Medium::Video]).await;
+    network.start(&target, &[Medium::Video]).await;
+    // Real video receive eligibility must precede every original arrival.
+    // A later subscription cannot retroactively authorize a retained packet.
+    let logical = StreamId::from_string("video");
+    let subscription =
+        DirectSubscription::new(&source.controller, logical.clone(), logical.clone());
+    target
+        .controller
+        .change_direct_subscriptions(
+            target.controller.revision(),
+            DirectSubscriptionChange::Subscribe(vec![subscription]),
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+        .unwrap();
+    let input = source
+        .controller
+        .take_ingress(&StreamId::from_string("video"))
+        .unwrap();
+    let stream = binding(&source, Medium::Video).stream_local_id;
+    for sequence in 1..=64 {
+        send(&network.wire, ordered_queue_video(stream, sequence));
+    }
+    let full = tokio::time::timeout(Duration::from_secs(1), async {
+        while source.media.snapshot().ingress_accepted < 64 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .is_ok();
+    if !full {
+        network.stop().await;
+        panic!("the real original Core video ingress did not fill64");
+    }
+    (network, source, target, policy, input)
+}
+
+#[tokio::test]
+async fn original_native_backpressure_preserves_same_video_until_fresh_authorized_single_delivery()
+{
+    let (network, source, target, policy, mut input) = full_video_ingress().await;
+    let counters = network.adapter().media_counters(&source.id).unwrap();
+    let target_counters = network.adapter().media_counters(&target.id).unwrap();
+    let stream = binding(&source, Medium::Video).stream_local_id;
+    send(&network.wire, ordered_queue_video(stream, 65));
+    let deferred = tokio::time::timeout(Duration::from_millis(100), async {
+        while counters.snapshot().original_backpressure_deferred == 0 {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .is_ok();
+    let before = counters.snapshot();
+    let calls = policy.calls.load(Ordering::SeqCst);
+    let mut drained = 0;
+    for _ in 0..64 {
+        if input.try_recv().is_ok() {
+            drained += 1;
+        }
+    }
+    let original = tokio::time::timeout(Duration::from_millis(100), input.recv())
+        .await
+        .ok()
+        .flatten();
+    let recovered = original.is_some();
+    let forward_result = original
+        .as_ref()
+        .map(|packet| packet.try_forward_to(&target.controller, &StreamId::from_string("video")));
+    let forwarded = forward_result.as_ref().is_some_and(|result| result.is_ok());
+    let timestamp = if forwarded {
+        tokio::time::timeout(Duration::from_millis(100), received(&network.wire))
+            .await
+            .ok()
+            .map(|packet| packet.rtp.packet().header.timestamp)
+    } else {
+        None
+    };
+    let after = counters.snapshot();
+    let fresh_authorization = policy.calls.load(Ordering::SeqCst) > calls;
+    let no_extra = input.try_recv().is_err();
+    network.stop().await;
+    let joined = !source.media.snapshot().reader_running && source.media.router().is_shutdown();
+    assert!(joined, "original canonical reader did not join");
+    assert!(deferred && before.ingress_accepted == 64 && before.ingress_rejected == 0);
+    assert_eq!(drained, 64);
+    assert!(recovered, "the SAME65th original was not recovered: deferred={deferred} before={before:?} after={after:?}");
+    assert!(
+        forwarded,
+        "selected receiver refused recovered original: result={forward_result:?}"
+    );
+    assert_eq!(
+        timestamp,
+        Some(65 * 3000),
+        "recovered original timestamp changed or target IO was absent"
+    );
+    assert!(
+        fresh_authorization,
+        "retry borrowed the former queue-full authority"
+    );
+    assert_eq!(after.original_recovered, 1);
+    assert_eq!(after.ingress_accepted, 65);
+    assert_eq!(after.ingress_rejected, 0);
+    assert!(
+        no_extra,
+        "the original was delivered more than once: after={after:?}"
+    );
+    assert_eq!(
+        target_counters.io_snapshot()[1].primary_accepted,
+        1,
+        "same original target primary IO count differs from one"
+    );
+}
