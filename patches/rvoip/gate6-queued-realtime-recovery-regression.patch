+// Queued realtime recovery owns no policy reader while metadata is unavailable.
+async fn queued_realtime_for_recovery(f: &Fixture, medium: Medium) -> QueuedMedia {
+    let source = f.aa.port(medium);
+    let mut input = f.a.take_ingress(&desired(medium).logical_id).unwrap();
+    let mut output = f.ba.port(medium).take_egress().unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(medium).logical_id)
+        .unwrap();
+    outgoing(&mut output).await
+}
+async fn queued_realtime_collision(target: bool, changed: u8) {
+    for medium in [Medium::Audio, Medium::Video] {
+        let (f, _) = fixture();
+        f.start(&[medium]).await;
+        let packet = queued_realtime_for_recovery(&f, medium).await;
+        let calls = Arc::new(AtomicUsize::new(0));
+        let count = calls.clone();
+        let sending = packet.deliver(move |frame| async move {
+            count.fetch_add(1, Ordering::AcqRel);
+            assert_eq!(frame.timestamp_rtp, 160);
+            Ok(())
+        });
+        tokio::pin!(sending);
+        let controller = if target { f.b.clone() } else { f.a.clone() };
+        let held = controller.state.lock().unwrap();
+        let first = std::future::poll_fn(|cx| {
+            std::task::Poll::Ready(std::future::Future::poll(sending.as_mut(), cx))
+        })
+        .await;
+        let reader_free = f.policy.0.try_write().is_ok();
+        match changed {
+            0 => (),
+            1 => tokio::time::sleep(Duration::from_millis(205)).await,
+            2 => {
+                f.policy.0.try_write().unwrap().revoked.insert("alice".into());
+            }
+            3 => f.a.shutdown.cancel(),
+            _ => unreachable!(),
+        }
+        drop(held);
+        assert!(
+            first.is_pending(),
+            "queued metadata refusal discarded original: {medium:?}"
+        );
+        assert!(
+            reader_free,
+            "queued metadata wait retained authority: {medium:?}"
+        );
+        assert_eq!(calls.load(Ordering::Acquire), 0);
+        let result = sending.await;
+        if changed == 0 {
+            result.unwrap();
+            assert_eq!(calls.load(Ordering::Acquire), 1);
+        } else {
+            assert!(result.is_err(), "changed={changed} medium={medium:?}");
+            if changed == 1 {
+                assert!(matches!(result, Err(StreamControlError::Deadline)));
+            }
+            assert_eq!(calls.load(Ordering::Acquire), 0);
+        }
+        assert!(f.policy.0.try_write().is_ok());
+    }
+}
+#[tokio::test]
+async fn queued_realtime_source_metadata_collision_recovers_one_original_without_idle_authority() {
+    queued_realtime_collision(false, 0).await;
+}
