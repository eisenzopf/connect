+//! Original native receive custody across definite temporary metadata refusal.
+//! No authority, model lock or delivery guard survives a retry boundary.
+use super::*;
+
+pub(super) struct OriginalStamp {
+    revision: u64,
+    credential: CredentialSnapshot,
+    consumer: Option<audio_consumer::ConsumerStamp>,
+    scene: Option<scene_consumer::SceneStamp>,
+}
+impl OriginalStamp {
+    pub(super) fn validate(&self, owner: &StreamController, state: &State) -> ControlResult<()> {
+        if state.model.revision() != self.revision {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        owner.check_credential_snapshot(&self.credential)
+    }
+}
+/// One original frame, not cloneable and never an authorization. The owner
+/// must discard it on any error except MetadataBusy and must bound its queue.
+pub struct OriginalIngress {
+    port: AdapterMediaPort,
+    frame: MediaFrame,
+    ticket: PeerRouteTicket,
+    stamp: OriginalStamp,
+    received_at: Instant,
+    deadline: tokio::time::Instant,
+    finished: bool,
+}
+impl AdapterMediaPort {
+    /// Capture the original active route and generations before policy can
+    /// refuse temporarily. An unavailable initial snapshot cannot be recaptured
+    /// later: no unqualified pre-ready packet enters retained custody.
+    /// None means an isolated preparation observer consumed the frame.
+    pub fn retain_original_ingress(
+        &self,
+        frame: MediaFrame,
+        received_at: Instant,
+    ) -> ControlResult<Option<OriginalIngress>> {
+        if self.0.kind() == StreamKind::Data {
+            return Err(StreamControlError::Unsupported);
+        }
+        let now = Instant::now();
+        if received_at > now || now.duration_since(received_at) >= Duration::from_millis(200) {
+            return Err(StreamControlError::Deadline);
+        }
+        self.0.validate(&frame)?;
+        if self
+            .0
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .messages_only
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let owner = self
+            .0
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if self.0.kind() == StreamKind::Audio {
+            let probe = owner
+                .audio_preparation
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .as_ref()
+                .and_then(Weak::upgrade);
+            if let Some(result) = probe.and_then(|p| p.observe(&owner, &self.0, &frame)) {
+                return result.map(|()| None);
+            }
+        }
+        let state = owner
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::NotReady)?;
+        if owner.shutdown.is_cancelled()
+            || state.closed
+            || !state
+                .active
+                .get(&self.0.binding.negotiated.requested.logical_id)
+                .is_some_and(|p| Arc::ptr_eq(p, &self.0))
+            || state
+                .model
+                .streams()
+                .get(&self.0.binding.negotiated.requested.logical_id)
+                .is_none_or(|s| !s.permits(false))
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let ticket = self.0.ticket();
+        if !ticket.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        let stamp = OriginalStamp {
+            revision: state.model.revision(),
+            credential: owner.credential_snapshot(),
+            consumer: owner.current_consumer_stamp(&self.0)?,
+            scene: owner.current_scene_stamp()?,
+        };
+        Ok(Some(OriginalIngress {
+            port: self.clone(),
+            frame,
+            ticket,
+            stamp,
+            received_at,
+            deadline: (received_at + Duration::from_millis(200)).into(),
+            finished: false,
+        }))
+    }
+}
+impl OriginalIngress {
+    /// One nonblocking admission attempt. Only MetadataBusy leaves this object
+    /// retryable. Success consumes it logically, preventing duplicate publish.
+    pub fn try_publish_clocked(
+        &mut self,
+        observe: impl FnOnce(
+            Arc<dyn Fn() -> bool + Send + Sync>,
+        ) -> Option<crate::stream::MediaSourceClock>,
+    ) -> ControlResult<()> {
+        if self.finished {
+            return Err(StreamControlError::Cancelled);
+        }
+        let result = self.publish(observe);
+        if !matches!(result, Err(StreamControlError::MetadataBusy)) {
+            self.finished = true;
+        }
+        result
+    }
+    fn publish(
+        &mut self,
+        observe: impl FnOnce(
+            Arc<dyn Fn() -> bool + Send + Sync>,
+        ) -> Option<crate::stream::MediaSourceClock>,
+    ) -> ControlResult<()> {
+        let owner = self
+            .port
+            .0
+            .owner
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        if !self.ticket.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        let (lease, admission, deadline) = owner.admit_original_or_queued(
+            &self.port.0,
+            &self.ticket,
+            false,
+            None,
+            audio_consumer::ConsumerCheck::Retained(self.stamp.consumer.as_ref()),
+            None,
+            scene_consumer::SceneCheck::retained_publish(self.stamp.scene.as_ref()),
+            None,
+            None,
+            None,
+            Some(&mut self.deadline),
+            Some(&self.stamp),
+        )?;
+        if tokio::time::Instant::now() >= deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        let mut frame = self.frame.clone();
+        frame.source_clock = observe(self.port.clock_liveness(self.ticket.clone(), &admission));
+        self.port
+            .0
+            .enqueue_ingress(MediaPacket {
+                frame,
+                data: None,
+                source: self.port.0.clone(),
+                ticket: self.ticket.clone(),
+                admitted_at: self.received_at,
+                consumer: admission.consumer.clone(),
+                scene: admission.scene.clone(),
+                custody: if self.port.0.kind() == StreamKind::Audio {
+                    PacketCustody::from_lease(lease.as_ref())
+                } else {
+                    PacketCustody::default()
+                },
+            })
+            .map_err(|e| match e {
+                mpsc::error::TrySendError::Full(_) => StreamControlError::Backpressure,
+                mpsc::error::TrySendError::Closed(_) => StreamControlError::NotReady,
+            })
+    }
+}
