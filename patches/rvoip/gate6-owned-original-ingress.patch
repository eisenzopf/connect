+//! Original receive recovery must retain generations, not a positive grant.
+use super::*;
+use crate::staged_streams::{audio_consumer::AudioConsumer, scene_consumer::SceneConsumer};
+struct OriginalPolicy {
+    inner: Arc<Policy>,
+    mode: Arc<AtomicUsize>,
+}
+impl MediaPolicy for OriginalPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.inner.current(scope)
+    }
+    fn current_original_ingress(
+        &self,
+        scope: &MediaScope<'_>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        match self.mode.load(Ordering::SeqCst) {
+            1 => Err(StreamControlError::MetadataBusy),
+            2 => Err(StreamControlError::NotReady),
+            _ => self.inner.current(scope),
+        }
+    }
+}
+async fn fixture() -> (Fixture, Arc<AtomicUsize>) {
+    let mode = Arc::new(AtomicUsize::new(1));
+    let m = mode.clone();
+    let f = Fixture::with_policy(
+        8,
+        Some(Box::new(move |inner| {
+            Arc::new(OriginalPolicy { inner, mode: m })
+        })),
+    );
+    f.start(&[Medium::Audio, Medium::Video]).await;
+    (f, mode)
+}
+#[tokio::test]
+async fn original_ingress_recovers_exact_frame_and_releases_authority_between_attempts() {
+    for medium in [Medium::Audio, Medium::Video] {
+        let (f, mode) = fixture().await;
+        let port = f.aa.port(medium);
+        let mut input = f.a.take_ingress(&desired(medium).logical_id).unwrap();
+        let at = Instant::now();
+        let frame = frame(&port, 160);
+        let mut original = port
+            .retain_original_ingress(frame.clone(), at)
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::MetadataBusy)
+        ));
+        assert!(input.try_recv().is_err());
+        drop(f.policy.0.try_write().expect("busy receive kept authority"));
+        // The original model generation is also preserved through a definite
+        // nonblocking model mutex collision, with no authority retained.
+        mode.store(0, Ordering::SeqCst);
+        let held = f.a.state.lock().unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::MetadataBusy)
+        ));
+        drop(held);
+        original.try_publish_clocked(|_| None).unwrap();
+        let packet = receive(&mut input).await;
+        assert_eq!(packet.frame.timestamp_rtp, frame.timestamp_rtp);
+        assert_eq!(packet.frame.payload, frame.payload);
+        assert_eq!(packet.admitted_at, at);
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::Cancelled)
+        ));
+        assert!(input.try_recv().is_err(), "original submitted twice");
+    }
+}
+#[tokio::test]
+async fn original_ingress_refuses_revocation_aba_new_audience_and_semantic_readiness() {
+    for action in 0..9 {
+        let (f, mode) = fixture().await;
+        let port = f.aa.port(Medium::Audio);
+        let id = desired(Medium::Audio).logical_id;
+        let mut input = f.a.take_ingress(&id).unwrap();
+        let mut original = port
+            .retain_original_ingress(frame(&port, 160), Instant::now())
+            .unwrap()
+            .unwrap();
+        assert!(matches!(
+            original.try_publish_clocked(|_| None),
+            Err(StreamControlError::MetadataBusy)
+        ));
+        let mut consumer = None;
+        let mut scene = None;
+        match action {
+            0 => {
+                f.policy
+                    .0
+                    .try_write()
+                    .unwrap()
+                    .revoked
+                    .insert("alice".into());
+            }
+            1 => f.a.shutdown.cancel(),
+            2 => port.0.retire(),
+            3 => {
+                let ids = [id.clone()].into_iter().collect();
+                f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Mute, deadline())
+                    .await
+                    .unwrap();
+                f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Unmute, deadline())
+                    .await
+                    .unwrap();
+            }
+            4 => {
+                let c = AudioConsumer::optional(Some(id.clone()), 8000);
+                c.activate(true);
+                *f.a.audio_consumer.lock().unwrap() = Some(Arc::downgrade(&c));
+                consumer = Some(c);
+            }
+            5 => {
+                let s = SceneConsumer::new(11);
+                s.activate();
+                *f.a.scene_consumer.lock().unwrap() = Some(Arc::downgrade(&s));
+                scene = Some(s);
+            }
+            6 => {
+                f.a.credential.lock().unwrap().revision += 1;
+            }
+            7 => tokio::time::sleep(Duration::from_millis(205)).await,
+            8 => {
+                mode.store(2, Ordering::SeqCst);
+                assert!(matches!(
+                    original.try_publish_clocked(|_| None),
+                    Err(StreamControlError::NotReady)
+                ));
+            }
+            _ => unreachable!(),
+        }
+        mode.store(0, Ordering::SeqCst);
+        assert!(
+            original.try_publish_clocked(|_| None).is_err(),
+            "old original adopted action {action}"
+        );
+        assert!(
+            input.try_recv().is_err(),
+            "action {action} published old frame"
+        );
+        drop(f.policy.0.try_write().expect("refusal kept authority"));
+        drop((consumer, scene));
+    }
+}
+#[tokio::test]
+async fn original_ingress_cannot_capture_prepared_muted_future_or_expired_inputs() {
+    let (f, mode) = fixture().await;
+    mode.store(0, Ordering::SeqCst);
+    let port = f.aa.port(Medium::Audio);
+    for at in [
+        Instant::now() + Duration::from_secs(1),
+        Instant::now() - Duration::from_millis(201),
+    ] {
+        assert!(matches!(
+            port.retain_original_ingress(frame(&port, 160), at),
+            Err(StreamControlError::Deadline)
+        ));
+    }
+    let ids = [desired(Medium::Audio).logical_id].into_iter().collect();
+    f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Mute, deadline())
+        .await
+        .unwrap();
+    assert!(port
+        .retain_original_ingress(frame(&port, 160), Instant::now())
+        .is_err());
+    f.a.set_media_gate(f.a.revision(), &ids, StreamGateAction::Unmute, deadline())
+        .await
+        .unwrap();
+    // A model busy at the initial snapshot cannot promise an active generation.
+    let held = f.a.state.lock().unwrap();
+    assert!(matches!(
+        port.retain_original_ingress(frame(&port, 160), Instant::now()),
+        Err(StreamControlError::NotReady)
+    ));
+    drop(held);
+    port.0.state.lock().unwrap().ready = false;
+    assert!(port
+        .retain_original_ingress(frame(&port, 160), Instant::now())
+        .is_err());
+}
