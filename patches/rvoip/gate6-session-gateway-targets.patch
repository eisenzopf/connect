+//! Bounded invitation selectors. URI syntax never grants gateway or dial rights.
+use super::{Identifier, WireError};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(try_from = "String", into = "String")]
+pub struct SessionTarget(String);
+impl SessionTarget {
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+pub(super) fn gateway_syntax(value: &str) -> bool {
+    value.split_once(':').is_some_and(|(scheme, body)| {
+        matches!(scheme, "sip" | "sips" | "tel")
+            && !body.is_empty()
+            && body.bytes().all(|b| (b'!'..=b'~').contains(&b))
+    })
+}
+impl TryFrom<String> for SessionTarget {
+    type Error = WireError;
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        if Identifier::try_from(value.clone()).is_ok()
+            || (value.len() <= 2048 && gateway_syntax(&value))
+        {
+            Ok(Self(value))
+        } else {
+            Err(WireError::InvalidPayload)
+        }
+    }
+}
+impl From<SessionTarget> for String {
+    fn from(value: SessionTarget) -> Self {
+        value.0
+    }
+}
+impl From<Identifier> for SessionTarget {
+    fn from(value: Identifier) -> Self {
+        Self(value.into())
+    }
+}
+impl std::fmt::Debug for SessionTarget {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("SessionTarget(redacted)")
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn gateway_selectors_do_not_weaken_resource_identifiers() {
+        for value in ["part_one", "id_two", "sip:bob@example.com", "tel:+14155550123"] {
+            let target: SessionTarget = serde_json::from_value(value.into()).unwrap();
+            assert_eq!(target.as_str(), value);
+            assert_eq!(serde_json::to_value(target).unwrap(), value);
+        }
+        for value in ["sip:bob@example.com", "tel:+14155550123"] {
+            assert!(serde_json::from_value::<Identifier>(value.into()).is_err());
+        }
+        for value in ["", "https://example.com", "sip:", "sip:a b@example.com", "tel:+1\n2"] {
+            assert!(serde_json::from_value::<SessionTarget>(value.into()).is_err());
+        }
+        assert!(SessionTarget::try_from(format!("sip:{}", "x".repeat(2045))).is_err());
+    }
+}
