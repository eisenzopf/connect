+//! Deterministic guarded-IO milestone controls, not WebRTC/network proof.
+use super::*;
+use crate::staged_streams::audience::AudioAudienceHandle;
+use crate::orchestrator::participant_control::replacement::metadata_test_support::pending_signal_snapshot;
+
+async fn initial_pair(room: &mut ManagedRoom) -> (ConnectionId, ConnectionId, Arc<Domain>) {
+    let original = domain(&room.conversation, &room.session, "duplex-old", "alice");
+    let source = room.initial(original.clone()).await;
+    let retained = room.initial(domain(&room.conversation, &room.session, "duplex-retained", "bob")).await;
+    room.select(&source, vec![AudioSubscription::Connection(retained.clone())]).await;
+    room.select(&retained, vec![AudioSubscription::Connection(source.clone())]).await;
+    let mut replacement = domain(&room.conversation, &room.session, "duplex-new", "alice");
+    let next = Arc::get_mut(&mut replacement).unwrap();
+    next.principal = original.principal.clone();
+    next.member = original.member.clone();
+    (source, retained, replacement)
+}
+
+fn queue_prompt(room: &mut ManagedRoom, candidate: &ConnectionId, context: &AudioAudienceHandle) {
+    let node = room.nodes.get_mut(candidate).unwrap();
+    let frame = node.frame(4000);
+    node.controller.try_queue_local_audio(
+        &desired(Medium::Audio).logical_id,
+        frame,
+        LocalAudioPurpose::EndpointPreparation { operation_id: context.operation_id().into() },
+    ).unwrap();
+}
+
+fn not_ready(result: Result<(), ParticipantControlError>) {
+    assert!(matches!(result, Err(ParticipantControlError::Media(StreamControlError::NotReady))));
+}
+
+async fn finish(room: &mut ManagedRoom, work: std::thread::Result<()>) {
+    let cleanup = room.close_originals().await;
+    assert!(cleanup.iter().all(|joined| *joined), "original managed owners unjoined: {cleanup:?}");
+    if let Err(error) = work { resume_unwind(error); }
+}
+
+#[tokio::test]
+async fn managed_replacement_duplex_metadata_waits_for_original_guarded_write_completion() {
+    let mut room = ManagedRoom::new().await;
+    let work = catch_original(async {
+        let (source, retained, next) = initial_pair(&mut room).await;
+        let (root, grant, signal, context, _probe) = room.prepare_move(&source, &retained, next).await;
+        let candidate = grant.intent.replacement.clone();
+        room.nodes.get_mut(&candidate).unwrap().publish(12000).unwrap();
+        queue_prompt(&mut room, &candidate, &context);
+        let queued = outgoing(&mut room.nodes.get_mut(&candidate).unwrap().out).await;
+        let (heard, observed) = tokio::sync::oneshot::channel();
+        let (complete, completion) = tokio::sync::oneshot::channel();
+        // Poll the ORIGINAL guarded writer, without a detached task or new IO.
+        // Its actual sink decodes the payload before the same send can finish.
+        let writer = queued.deliver(move |frame| async move {
+            let mut codec = rvoip_media_core::codec::factory::CodecFactory::create_codec(0, Some(8000), Some(1)).unwrap();
+            let pcm = codec.decode(&frame.payload).unwrap();
+            let mean = pcm.samples.iter().map(|value| i32::from(*value)).sum::<i32>() / pcm.samples.len() as i32;
+            assert!((mean - 4000).abs() < 400);
+            heard.send(()).map_err(|_| StreamControlError::Cancelled)?;
+            completion.await.map_err(|_| StreamControlError::Cancelled)?;
+            Ok(())
+        });
+        tokio::pin!(writer);
+        tokio::select! {
+            result = &mut writer => panic!("writer completed before its original completion was released: {result:?}"),
+            result = observed => result.unwrap(),
+        }
+        // This is the old fixture's insufficient milestone: actual remote/sink
+        // decoded sound. Core has not published guarded delivery completion.
+        let before = pending_signal_snapshot(&root);
+        for _ in 0..3 {
+            not_ready(room.orch.staged_device_replacement_endpoint_ready_for_test(&root));
+            assert_eq!(pending_signal_snapshot(&root), before);
+        }
+        assert_eq!(room.signal(&root, &grant, &signal, DeviceReplacementEndpointEvent::MediaObserved), EndpointConfirmationObservation::BeforeAnswerOrMedia);
+        complete.send(()).unwrap();
+        writer.await.unwrap();
+        let before = pending_signal_snapshot(&root);
+        for _ in 0..3 {
+            room.orch.staged_device_replacement_endpoint_ready_for_test(&root).unwrap();
+            assert_eq!(pending_signal_snapshot(&root), before);
+        }
+        assert_eq!(room.signal(&root, &grant, &signal, DeviceReplacementEndpointEvent::MediaObserved), EndpointConfirmationObservation::MediaReady);
+        assert!(!root.prepared_binding().confirmation_ready());
+        assert!(room.orch.plan_staged_device_replacement(&root, None).is_err());
+        assert!(root.cancel());
+    }).await;
+    finish(&mut room, work).await;
+}
+
+#[tokio::test]
+async fn managed_replacement_duplex_metadata_requires_actual_post_activation_ingress() {
+    let mut room = ManagedRoom::new().await;
+    let work = catch_original(async {
+        let (source, retained, next) = initial_pair(&mut room).await;
+        let (root, grant, signal, context, _probe) = room.prepare_move(&source, &retained, next).await;
+        let candidate = grant.intent.replacement.clone();
+        // The actual endpoint has been activated; hold ALL input while the
+        // original outbound preparation prompt is decoded and fully delivered.
+        queue_prompt(&mut room, &candidate, &context);
+        room.nodes.get_mut(&candidate).unwrap().hear(4000).await;
+        let before = pending_signal_snapshot(&root);
+        not_ready(room.orch.staged_device_replacement_endpoint_ready_for_test(&root));
+        assert_eq!(pending_signal_snapshot(&root), before);
+        assert_eq!(room.signal(&root, &grant, &signal, DeviceReplacementEndpointEvent::MediaObserved), EndpointConfirmationObservation::BeforeAnswerOrMedia);
+        room.nodes.get_mut(&candidate).unwrap().publish(12000).unwrap();
+        room.orch.staged_device_replacement_endpoint_ready_for_test(&root).unwrap();
+        assert_eq!(room.signal(&root, &grant, &signal, DeviceReplacementEndpointEvent::MediaObserved), EndpointConfirmationObservation::MediaReady);
+        assert!(!root.prepared_binding().confirmation_ready());
+        assert!(root.cancel());
+        room.nodes.get_mut(&source).unwrap().publish(800).unwrap();
+        room.nodes.get_mut(&retained).unwrap().hear(800).await;
+    }).await;
+    finish(&mut room, work).await;
+}
+
+#[tokio::test]
+async fn managed_replacement_duplex_metadata_refuses_foreign_stale_and_cancelled_owners_without_signal_effects() {
+    for change in ["stale-port", "cancelled"] {
+        let mut room = ManagedRoom::new().await;
+        let mut foreign = ManagedRoom::new().await;
+        let work = catch_original(async {
+            let (source, retained, next) = initial_pair(&mut room).await;
+            let (root, grant, _signal, context, _probe) = room.prepare_move(&source, &retained, next).await;
+            let candidate = grant.intent.replacement.clone();
+            room.nodes.get_mut(&candidate).unwrap().publish(12000).unwrap();
+            queue_prompt(&mut room, &candidate, &context);
+            room.nodes.get_mut(&candidate).unwrap().hear(4000).await;
+            room.orch.staged_device_replacement_endpoint_ready_for_test(&root).unwrap();
+            let before = pending_signal_snapshot(&root);
+            assert!(matches!(foreign.orch.staged_device_replacement_endpoint_ready_for_test(&root), Err(ParticipantControlError::Authority)));
+            assert_eq!(pending_signal_snapshot(&root), before);
+            let controller = room.nodes[&candidate].controller.clone();
+            {
+                let held = controller.state.lock().unwrap();
+                assert!(matches!(room.orch.staged_device_replacement_endpoint_ready_for_test(&root), Err(ParticipantControlError::Media(StreamControlError::MetadataBusy))));
+                assert_eq!(pending_signal_snapshot(&root), before);
+                drop(held);
+            }
+            if change == "stale-port" {
+                room.nodes[&candidate].backend.port(Medium::Audio).report_terminal().unwrap();
+                let result = room.orch.staged_device_replacement_endpoint_ready_for_test(&root);
+                assert!(matches!(result, Err(ParticipantControlError::Media(StreamControlError::NotReady | StreamControlError::Cancelled)) | Err(ParticipantControlError::Cancelled)));
+            } else {
+                assert!(root.cancel());
+                assert!(matches!(room.orch.staged_device_replacement_endpoint_ready_for_test(&root), Err(ParticipantControlError::Cancelled)));
+            }
+            // Refusal may initiate original cleanup, but it must not fabricate
+            // any signal sequence, answer, digits or confirmation.
+            assert_eq!(pending_signal_snapshot(&root), before);
+            root.cancel();
+        }).await;
+        let foreign_cleanup = foreign.close_originals().await;
+        let cleanup = room.close_originals().await;
+        assert!(foreign_cleanup.iter().chain(cleanup.iter()).all(|joined| *joined),
+            "original foreign/owned managed owners unjoined: {foreign_cleanup:?} {cleanup:?}");
+        if let Err(error) = work { resume_unwind(error); }
+    }
+}
