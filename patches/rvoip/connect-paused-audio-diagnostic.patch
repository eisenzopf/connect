--- /dev/null
+++ b/crates/foundation/rvoip-core/src/staged_streams/audio_diagnostic.rs
@@ -0,0 +1,368 @@
+//! Test-support-only, bounded numeric observation of two original controllers.
+//! No payload, grant, ticket, controller, timer or task is retained. All counters
+//! are observational; missing metadata never changes a production result.
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub enum Stage {
+    IngressRetain,
+    IngressPreparation,
+    IngressPublish,
+    CollectAdmission,
+    Decoded,
+    TargetCapture,
+    TargetAdmission,
+    Encoded,
+    WriterAdmission,
+    WriterSubmit,
+    PolicyResult,
+    PolicyStore,
+    PolicyReadState,
+    PolicyOwner,
+    PolicyActivation,
+    PolicyPublication,
+    PublicationScope,
+    PublicationRoute,
+    PublicationBinding,
+    PublicationLifetime,
+    PublicationTicket,
+}
+const NAMES: [&str; 21] = [
+    "ingress-retain",
+    "ingress-preparation",
+    "ingress-publish",
+    "collect-admission",
+    "decoded",
+    "target-capture",
+    "target-admission",
+    "encoded",
+    "writer-admission",
+    "writer-submit",
+    "policy-result",
+    "policy-store",
+    "policy-read-state",
+    "policy-owner",
+    "policy-activation",
+    "policy-publication",
+    "publication-scope",
+    "publication-route",
+    "publication-binding",
+    "publication-lifetime",
+    "publication-ticket",
+];
+const OUTCOMES: [&str; 8] = [
+    "ok",
+    "not-ready",
+    "metadata-busy",
+    "authority",
+    "deadline",
+    "cancelled",
+    "backpressure",
+    "other",
+];
+const SUMMARY_CAPACITY: usize = 64;
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static MISSED: AtomicU64 = AtomicU64::new(0);
+static CURRENT: OnceLock<Mutex<Weak<Pair>>> = OnceLock::new();
+struct Counts {
+    attempts: [AtomicU64; 8],
+    marked: [AtomicU64; 8],
+    samples: AtomicU64,
+}
+impl Default for Counts {
+    fn default() -> Self {
+        Self {
+            attempts: std::array::from_fn(|_| AtomicU64::new(0)),
+            marked: std::array::from_fn(|_| AtomicU64::new(0)),
+            samples: AtomicU64::new(0),
+        }
+    }
+}
+struct Entry {
+    connection: ConnectionId,
+    owner: Weak<StreamController>,
+    initial_revision: u64,
+    initial_origin_binding_generation: u64,
+    initial_audio_ports: Vec<(String, u64, u64, bool, bool)>,
+    stages: [Counts; 21],
+    summary_events: [AtomicU64; SUMMARY_CAPACITY],
+    summary_samples: [AtomicU64; SUMMARY_CAPACITY],
+}
+struct Pair {
+    entries: Vec<Entry>,
+}
+/// Sole observation owner. Dropping this handle disables collection and releases
+/// only numeric metadata. It never closes or keeps alive any media owner.
+pub struct AudioDiagnostics {
+    pair: Arc<Pair>,
+}
+#[derive(serde::Serialize)]
+pub struct Snapshot {
+    pub missed_observations: u64,
+    pub outcome_names: [&'static str; 8],
+    pub entries: Vec<EntrySnapshot>,
+}
+#[derive(serde::Serialize)]
+pub struct EntrySnapshot {
+    pub connection: String,
+    pub controller_alive: bool,
+    pub initial_revision: u64,
+    pub initial_origin_binding_generation: u64,
+    pub initial_audio_ports: Vec<(String, u64, u64, bool, bool)>,
+    pub stages: Vec<(&'static str, [u64; 8], [u64; 8], u64)>,
+    pub audio_summary: Vec<(&'static str, u64, u64)>,
+}
+pub fn arm(controllers: &[Arc<StreamController>]) -> ControlResult<AudioDiagnostics> {
+    if controllers.len() != 2 || controllers[0].connection == controllers[1].connection {
+        return Err(StreamControlError::Authority);
+    }
+    let slot = CURRENT.get_or_init(|| Mutex::new(Weak::new()));
+    let mut current = slot
+        .try_lock()
+        .map_err(|_| StreamControlError::MetadataBusy)?;
+    if current.strong_count() != 0 {
+        return Err(StreamControlError::Authority);
+    }
+    let mut entries = Vec::with_capacity(2);
+    for controller in controllers {
+        let state = controller
+            .state
+            .try_lock()
+            .map_err(|_| StreamControlError::MetadataBusy)?;
+        let ports = state
+            .active
+            .values()
+            .filter(|port| port.kind() == StreamKind::Audio)
+            .map(|port| {
+                let binding = &port.binding;
+                (
+                    binding.negotiated.requested.logical_id.as_str().to_owned(),
+                    binding.connection_generation,
+                    binding.generation,
+                    binding.source_ready,
+                    binding.sink_ready,
+                )
+            })
+            .collect();
+        entries.push(Entry {
+            connection: controller.connection.clone(),
+            owner: Arc::downgrade(controller),
+            initial_revision: state.model.revision(),
+            initial_origin_binding_generation: controller.origin_binding.generation(),
+            initial_audio_ports: ports,
+            stages: std::array::from_fn(|_| Counts::default()),
+            summary_events: std::array::from_fn(|_| AtomicU64::new(0)),
+            summary_samples: std::array::from_fn(|_| AtomicU64::new(0)),
+        });
+    }
+    let pair = Arc::new(Pair { entries });
+    *current = Arc::downgrade(&pair);
+    MISSED.store(0, Ordering::Relaxed);
+    ACTIVE.store(true, Ordering::Release);
+    Ok(AudioDiagnostics { pair })
+}
+impl AudioDiagnostics {
+    pub fn snapshot(&self) -> Snapshot {
+        Snapshot {
+            missed_observations: MISSED.load(Ordering::Relaxed),
+            outcome_names: OUTCOMES,
+            entries: self
+                .pair
+                .entries
+                .iter()
+                .map(|entry| EntrySnapshot {
+                    connection: entry.connection.as_str().to_owned(),
+                    controller_alive: entry.owner.strong_count() != 0,
+                    initial_revision: entry.initial_revision,
+                    initial_origin_binding_generation: entry.initial_origin_binding_generation,
+                    initial_audio_ports: entry.initial_audio_ports.clone(),
+                    stages: entry
+                        .stages
+                        .iter()
+                        .enumerate()
+                        .map(|(i, counts)| {
+                            (
+                                NAMES[i],
+                                std::array::from_fn(|j| counts.attempts[j].load(Ordering::Relaxed)),
+                                std::array::from_fn(|j| counts.marked[j].load(Ordering::Relaxed)),
+                                counts.samples.load(Ordering::Relaxed),
+                            )
+                        })
+                        .collect(),
+                    audio_summary: guarded_audio::audio_summary_names_for_test()
+                        .iter()
+                        .enumerate()
+                        .filter_map(|(i, name)| {
+                            let events = entry.summary_events[i].load(Ordering::Relaxed);
+                            (events != 0).then(|| {
+                                (
+                                    *name,
+                                    events,
+                                    entry.summary_samples[i].load(Ordering::Relaxed),
+                                )
+                            })
+                        })
+                        .collect(),
+                })
+                .collect(),
+        }
+    }
+}
+impl Drop for AudioDiagnostics {
+    fn drop(&mut self) {
+        ACTIVE.store(false, Ordering::Release);
+    }
+}
+fn with_entry(
+    connection: &ConnectionId,
+    owner: Option<&StreamController>,
+    observe: impl FnOnce(&Entry),
+) {
+    if !ACTIVE.load(Ordering::Acquire) {
+        return;
+    }
+    let Some(slot) = CURRENT.get() else {
+        return;
+    };
+    let Ok(current) = slot.try_lock() else {
+        MISSED.fetch_add(1, Ordering::Relaxed);
+        return;
+    };
+    let pair = current.upgrade();
+    drop(current);
+    let Some(pair) = pair else {
+        return;
+    };
+    let Some(entry) = pair.entries.iter().find(|entry| {
+        &entry.connection == connection
+            && owner.is_none_or(|owner| std::ptr::eq(entry.owner.as_ptr(), owner))
+    }) else {
+        return;
+    };
+    observe(entry);
+}
+fn outcome(error: Option<&StreamControlError>) -> usize {
+    match error {
+        None => 0,
+        Some(StreamControlError::NotReady) => 1,
+        Some(StreamControlError::MetadataBusy) => 2,
+        Some(StreamControlError::Authority) => 3,
+        Some(StreamControlError::Deadline) => 4,
+        Some(StreamControlError::Cancelled) => 5,
+        Some(StreamControlError::Backpressure) => 6,
+        _ => 7,
+    }
+}
+fn record(
+    entry: &Entry,
+    stage: Stage,
+    error: Option<&StreamControlError>,
+    marked: bool,
+    samples: usize,
+) {
+    let code = outcome(error);
+    let counts = &entry.stages[stage as usize];
+    counts.attempts[code].fetch_add(1, Ordering::Relaxed);
+    if marked {
+        counts.marked[code].fetch_add(1, Ordering::Relaxed);
+    }
+    counts.samples.fetch_add(samples as u64, Ordering::Relaxed);
+}
+pub fn result(connection: &ConnectionId, stage: Stage, error: Option<&StreamControlError>) {
+    with_entry(connection, None, |entry| {
+        record(entry, stage, error, false, 0)
+    });
+}
+pub(super) fn frame(
+    owner: &StreamController,
+    stage: Stage,
+    frame: &MediaFrame,
+    error: Option<&StreamControlError>,
+) {
+    if frame.kind != StreamKind::Audio {
+        return;
+    }
+    with_entry(&owner.connection, Some(owner), |entry| {
+        // Only explicit G.711 mu-law is classified before decode. Unknown
+        // encodings never become fabricated decoded/non-silent evidence.
+        let marked = marked_pcmu(frame);
+        record(entry, stage, error, marked, 0);
+    });
+}
+pub(super) fn pcm(
+    owner: &StreamController,
+    stage: Stage,
+    samples: &[i16],
+    error: Option<&StreamControlError>,
+) {
+    with_entry(&owner.connection, Some(owner), |entry| {
+        record(
+            entry,
+            stage,
+            error,
+            samples.iter().any(|s| s.unsigned_abs() > 1000),
+            samples.len(),
+        )
+    });
+}
+pub(super) fn summary(connection: &ConnectionId, index: usize, samples: usize) {
+    with_entry(connection, None, |entry| {
+        if index < SUMMARY_CAPACITY {
+            entry.summary_events[index].fetch_add(1, Ordering::Relaxed);
+            entry.summary_samples[index].fetch_add(samples as u64, Ordering::Relaxed);
+        } else {
+            MISSED.fetch_add(1, Ordering::Relaxed);
+        }
+    });
+}
+
+/// Numeric metadata captured before an owned frame moves. Completing the
+/// observation does not keep its controller or any authorization alive.
+pub(super) struct FrameObservation {
+    pair: Weak<Pair>,
+    index: usize,
+    marked: bool,
+}
+pub(super) fn original_frame(port: &Port, frame: &MediaFrame) -> Option<FrameObservation> {
+    if frame.kind != StreamKind::Audio || !ACTIVE.load(Ordering::Acquire) {
+        return None;
+    }
+    let slot = CURRENT.get()?;
+    let Ok(current) = slot.try_lock() else {
+        MISSED.fetch_add(1, Ordering::Relaxed);
+        return None;
+    };
+    let pair = current.upgrade()?;
+    drop(current);
+    let index = pair
+        .entries
+        .iter()
+        .position(|entry| Weak::ptr_eq(&entry.owner, &port.owner))?;
+    Some(FrameObservation {
+        pair: Arc::downgrade(&pair),
+        index,
+        marked: marked_pcmu(frame),
+    })
+}
+impl FrameObservation {
+    pub(super) fn finish(self, stage: Stage, error: Option<&StreamControlError>) {
+        if let Some(pair) = self.pair.upgrade() {
+            record(&pair.entries[self.index], stage, error, self.marked, 0);
+        }
+    }
+}
+
+// PCMU payload classification uses the same 1000-amplitude threshold as the
+// existing fixture. This is distinct from Stage::Decoded, which observes the
+// actual production decoder output. No inferred samples become media input.
+fn marked_pcmu(frame: &MediaFrame) -> bool {
+    frame.payload_type == Some(0)
+        && frame.payload.iter().any(|byte| {
+            let value = !*byte;
+            let magnitude = ((i32::from(value & 15) << 3) + 0x84) << ((value >> 4) & 7);
+            magnitude - 0x84 > 1000
+        })
+}
