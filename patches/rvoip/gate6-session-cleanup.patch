+#[tokio::test]
+async fn ending_session_rejects_legacy_route_probe_and_both_commit_paths() {
+    let f = Fixture::new().await;
+    let sid = f
+        .orch
+        .start_session(f.conversation.clone(), SessionMedium::Voice, vec![])
+        .await
+        .unwrap();
+    let (conn, _) = f.connection("alice", true).await;
+    let ticket = f
+        .orch
+        .capture_connection_lifecycles(std::slice::from_ref(&conn))
+        .unwrap()
+        .remove(0);
+    f.orch.session(&sid).unwrap().write().unwrap().state = SessionState::Ending;
+    assert!(matches!(
+        f.orch.bind_connection_to_session_probe(&sid),
+        Err(RvoipError::InvalidState(_))
+    ));
+    f.orch
+        .connections
+        .get_mut(&conn)
+        .unwrap()
+        .inbound_publication = InboundPublicationState::Published;
+    assert!(matches!(
+        f.orch
+            .bind_published_connection_to_session(&ticket, &sid, participant("alice")),
+        Err(RvoipError::InvalidState(_))
+    ));
+    {
+        let mut entry = f.orch.connections.get_mut(&conn).unwrap();
+        entry.direction = Direction::Outbound;
+        entry.inbound_publication = InboundPublicationState::NotInbound;
+    }
+    assert!(matches!(
+        f.orch
+            .commit_outbound_connection(&ticket, Transport::Sip, &sid, participant("alice")),
+        Err(RvoipError::InvalidState(_))
+    ));
+    assert_eq!(f.orch.session_of(&conn), None);
+    assert!(f
+        .orch
+        .session(&sid)
+        .unwrap()
+        .read()
+        .unwrap()
+        .connections
+        .is_empty());
+    f.orch.end_session(sid, EndReason::Normal).await.unwrap();
+}
