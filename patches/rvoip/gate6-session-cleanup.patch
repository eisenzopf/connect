+#[tokio::test]
+async fn concurrent_session_end_keeps_first_reason_and_emits_one_completion() {
+    let f = Fixture::new().await;
+    let (live, _) = f.connection("alice", true).await;
+    f.join(&f.session, "alice", &live).await;
+    let runtime = f.orch.participant_runtime(&f.session).unwrap();
+    let before = f.orch.participant_revision(&f.session).unwrap();
+    let held = runtime.mixer.members.clone().lock_owned().await;
+    let mut events = f.orch.subscribe_events();
+    let first = start_blocked_end(&f, EndReason::Timeout).await;
+    let mut others = vec![];
+    for _ in 0..8 {
+        let owner = f.orch.clone();
+        let sid = f.session.clone();
+        others.push(tokio::spawn(async move {
+            owner.end_session(sid, EndReason::Normal).await
+        }));
+    }
+    tokio::task::yield_now().await;
+    drop(held);
+    first.await.unwrap().unwrap();
+    for task in others {
+        task.await.unwrap().unwrap();
+    }
+    assert_eq!(f.orch.participant_revision(&f.session).unwrap(), before + 1);
+    assert_eq!(ended_events(&mut events, &f.session), 1);
+    assert!(matches!(
+        f.orch
+            .session(&f.session)
+            .unwrap()
+            .read()
+            .unwrap()
+            .end_reason,
+        Some(EndReason::Timeout)
+    ));
+    assert!(runtime.mixer.members.lock().await.is_empty());
+}
