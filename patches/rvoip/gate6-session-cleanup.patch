+use super::*;
+#[allow(dead_code)]
+#[path = "../../../tests/support/participant_control_fixture.rs"]
+mod fixture;
+use fixture::{participant, principal, until, Fixture};
+
+fn ended_events(events: &mut broadcast::Receiver<Event>, session: &SessionId) -> usize {
+    let mut count = 0;
+    while let Ok(event) = events.try_recv() {
+        if matches!(event, Event::SessionEnded { session_id, .. } if &session_id == session) {
+            count += 1;
+        }
+    }
+    count
+}
+
+async fn start_blocked_end(f: &Fixture, reason: EndReason) -> tokio::task::JoinHandle<Result<()>> {
+    let owner = f.orch.clone();
+    let sid = f.session.clone();
+    let task = tokio::spawn(async move { owner.end_session(sid, reason).await });
+    until(|| {
+        matches!(
+            f.orch.session(&f.session).unwrap().read().unwrap().state,
+            SessionState::Ending | SessionState::Ended
+        )
+    })
+    .await;
+    assert!(
+        !task.is_finished(),
+        "mixer lock deliberately holds teardown"
+    );
+    task
+}
+
+#[tokio::test]
+async fn aborted_session_end_fences_media_and_pending_before_wait_and_retry_finishes_once() {
+    let f = Fixture::new().await;
+    let (live, _) = f.connection("alice", true).await;
+    f.join(&f.session, "alice", &live).await;
+    let (pending, _) = f.connection("bob", false).await;
+    let intent = f.intent(
+        &f.session,
+        "bob",
+        "pending-end",
+        ParticipantChange::Admit {
+            connection: pending.clone(),
+            role_override: None,
+        },
+    );
+    let owner = f.orch.clone();
+    let sid = f.session.clone();
+    let admission = tokio::spawn(async move {
+        owner
+            .change_session_participant(
+                &sid,
+                principal("owner"),
+                intent,
+                tokio::time::Instant::now() + Duration::from_secs(5),
+                CancellationToken::new(),
+            )
+            .await
+    });
+    until(|| f.orch.participant_capacity(&f.session).unwrap() == (1, 1)).await;
+    let runtime = f.orch.participant_runtime(&f.session).unwrap();
+    let held = runtime.mixer.members.clone().lock_owned().await;
+    let stream = StreamId::new();
+    let subscriber = ConnectionId::new();
+    f.orch
+        .add_subscription(f.session.clone(), subscriber, live.clone(), stream.clone());
+    assert_eq!(f.orch.subscribers_for(&f.session, &live, &stream).len(), 1);
+    let mut events = f.orch.subscribe_events();
+    let end = start_blocked_end(&f, EndReason::Cancelled).await;
+    assert!(f
+        .orch
+        .subscribers_for(&f.session, &live, &stream)
+        .is_empty());
+    assert_eq!(f.orch.session_of(&live), None);
+    assert!(
+        runtime.state.lock().unwrap().ended,
+        "logical end precedes mixer wait"
+    );
+    assert!(
+        !f.orch
+            .connection_lifecycles
+            .get(&live)
+            .unwrap()
+            .lock()
+            .unwrap()
+            .active
+    );
+    assert!(tokio::time::timeout(Duration::from_secs(1), admission)
+        .await
+        .unwrap()
+        .unwrap()
+        .is_err());
+    end.abort();
+    assert!(end.await.unwrap_err().is_cancelled());
+    assert_eq!(
+        f.orch.session(&f.session).unwrap().read().unwrap().state,
+        SessionState::Ending
+    );
+    assert_eq!(
+        ended_events(&mut events, &f.session),
+        0,
+        "no completed event before cleanup"
+    );
+    assert!(f.orch.bind_connection_to_session_probe(&f.session).is_err());
+    drop(held);
+    f.orch
+        .end_session(f.session.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    assert!(runtime.mixer.members.lock().await.is_empty());
+    assert_eq!(f.orch.participant_capacity(&f.session).unwrap(), (0, 0));
+    let session = f.orch.session(&f.session).unwrap();
+    let session = session.read().unwrap();
+    assert_eq!(session.state, SessionState::Ended);
+    assert!(session.ended_at.is_some());
+    assert!(matches!(session.end_reason, Some(EndReason::Cancelled)));
+    assert_eq!(f.orch.session_of(&live), None);
+    assert_eq!(f.orch.session_of(&pending), None);
+    assert_eq!(ended_events(&mut events, &f.session), 1);
+    drop(session);
+    f.orch
+        .end_session(f.session.clone(), EndReason::Timeout)
+        .await
+        .unwrap();
+    assert_eq!(ended_events(&mut events, &f.session), 0);
+}
