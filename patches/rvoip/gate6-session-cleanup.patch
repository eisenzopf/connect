+#[tokio::test]
+async fn cancelled_force_close_resumes_ending_session_before_closing_conversation() {
+    let f = Fixture::new().await;
+    let (live, _) = f.connection("alice", true).await;
+    f.join(&f.session, "alice", &live).await;
+    let runtime = f.orch.participant_runtime(&f.session).unwrap();
+    let held = runtime.mixer.members.clone().lock_owned().await;
+    let owner = f.orch.clone();
+    let cid = f.conversation.clone();
+    let close = tokio::spawn(async move { owner.close_conversation(cid, true).await });
+    until(|| {
+        matches!(
+            f.orch.session(&f.session).unwrap().read().unwrap().state,
+            SessionState::Ending | SessionState::Ended
+        )
+    })
+    .await;
+    close.abort();
+    assert!(close.await.unwrap_err().is_cancelled());
+    assert_eq!(
+        f.orch
+            .conversation(&f.conversation)
+            .unwrap()
+            .read()
+            .unwrap()
+            .state,
+        ConversationState::Open
+    );
+    assert!(f
+        .orch
+        .close_conversation(f.conversation.clone(), false)
+        .await
+        .is_err());
+    drop(held);
+    f.orch
+        .close_conversation(f.conversation.clone(), true)
+        .await
+        .unwrap();
+    assert!(runtime.mixer.members.lock().await.is_empty());
+    assert_eq!(
+        f.orch.session(&f.session).unwrap().read().unwrap().state,
+        SessionState::Ended
+    );
+    assert_eq!(
+        f.orch
+            .conversation(&f.conversation)
+            .unwrap()
+            .read()
+            .unwrap()
+            .state,
+        ConversationState::Closed
+    );
+}
