+#[tokio::test]
+async fn cancelled_session_end_leaves_other_session_audio_and_membership_live() {
+    let f = Fixture::new().await;
+    let other = f.second_session().await;
+    let (a, _) = f.connection("alice", true).await;
+    f.join(&f.session, "alice", &a).await;
+    let (b, source) = f.connection("bob", true).await;
+    f.join(&other, "bob", &b).await;
+    let (c, sink) = f.connection("carol", true).await;
+    f.join(&other, "carol", &c).await;
+    let (cancel, tone) = source.continuous_tone();
+    sink.assert_receives_audio().await;
+    let runtime = f.orch.participant_runtime(&f.session).unwrap();
+    let held = runtime.mixer.members.clone().lock_owned().await;
+    let end = start_blocked_end(&f, EndReason::Normal).await;
+    end.abort();
+    let _ = end.await;
+    sink.assert_receives_audio().await;
+    assert_eq!(f.orch.session_of(&b), Some(other.clone()));
+    assert_eq!(
+        f.orch
+            .participant_session_role(&other, &participant("bob"))
+            .unwrap(),
+        Some(ParticipantRole::Agent)
+    );
+    drop(held);
+    f.orch
+        .end_session(f.session.clone(), EndReason::Normal)
+        .await
+        .unwrap();
+    sink.assert_receives_audio().await;
+    assert_eq!(f.orch.participant_capacity(&other).unwrap(), (2, 0));
+    cancel.cancel();
+    tone.await.unwrap();
+    f.orch.end_session(other, EndReason::Normal).await.unwrap();
+}
