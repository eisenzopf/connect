+//! Transport custody excludes media changes without retaining domain readers.
+use super::*;
+struct Invocation;
+struct TransportPolicy(Arc<Policy>);
+impl MediaPolicy for TransportPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.0.current(scope)
+    }
+    fn current_transport_update(
+        &self,
+        scope: &MediaScope<'_>,
+        expected: u64,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if !held.is::<Invocation>() || expected != 1 {
+            return Err(StreamControlError::Authority);
+        }
+        self.0.current(scope)
+    }
+}
+fn fixture() -> Fixture {
+    Fixture::with_policy(
+        8,
+        Some(Box::new(|policy| Arc::new(TransportPolicy(policy)))),
+    )
+}
+#[tokio::test]
+async fn ordinary_media_authority_cannot_reserve_a_transport_update() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Audio]).await;
+    assert!(matches!(
+        f.a.reserve_transport_update_with_held(1, deadline(), &Invocation),
+        Err(StreamControlError::Unsupported)
+    ));
+    assert!(f.a.inflight.clone().try_acquire_owned().is_ok());
+    assert_eq!(f.a.revision(), 1);
+}
+#[tokio::test]
+async fn transport_slot_excludes_gate_changes_and_preserves_original_ports() {
+    let f = fixture();
+    f.start(&[Medium::Audio]).await;
+    let id = desired(Medium::Audio).logical_id;
+    let original = f.a.state.lock().unwrap().active.get(&id).unwrap().clone();
+    let binding = original.binding.clone();
+    let slot =
+        f.a.reserve_transport_update_with_held(1, deadline(), &Invocation)
+            .unwrap();
+    assert!(
+        f.a.reserve_transport_update_with_held(1, deadline(), &Invocation)
+            .is_err()
+    );
+    assert!(slot.current_with_held(&()).is_err());
+    drop(slot.current_with_held(&Invocation).unwrap());
+    let ids = [id.clone()].into_iter().collect();
+    let mut gate = Box::pin(f.a.set_media_gate(1, &ids, StreamGateAction::Mute, deadline()));
+    assert!(
+        std::future::poll_fn(|cx| std::task::Poll::Ready(gate.as_mut().poll(cx)))
+            .await
+            .is_pending()
+    );
+    assert_eq!(f.a.revision(), 1);
+    assert_eq!(original.binding.transport_id, binding.transport_id);
+    assert_eq!(original.binding.stream_local_id, binding.stream_local_id);
+    assert!(Arc::ptr_eq(
+        &original,
+        f.a.state.lock().unwrap().active.get(&id).unwrap()
+    ));
+    drop(slot);
+    assert_eq!(gate.await.unwrap().0, 2);
+}
+#[tokio::test]
+async fn idle_transport_slot_does_not_block_current_revocation() {
+    let f = fixture();
+    f.start(&[Medium::Audio]).await;
+    let slot =
+        f.a.reserve_transport_update_with_held(1, deadline(), &Invocation)
+            .unwrap();
+    f.policy
+        .0
+        .try_write()
+        .unwrap()
+        .revoked
+        .insert("alice".into());
+    assert!(matches!(
+        slot.current_with_held(&Invocation),
+        Err(StreamControlError::Authority)
+    ));
+    assert_eq!(f.a.revision(), 1);
+}
+#[tokio::test]
+async fn transport_slot_checks_deadline_shutdown_and_credential_incarnation() {
+    for reason in 0..3 {
+        let f = fixture();
+        f.start(&[Medium::Audio]).await;
+        let bound = if reason == 0 {
+            tokio::time::Instant::now() + Duration::from_millis(20)
+        } else {
+            deadline()
+        };
+        let slot =
+            f.a.reserve_transport_update_with_held(1, bound, &Invocation)
+                .unwrap();
+        match reason {
+            0 => tokio::time::sleep_until(bound).await,
+            1 => f.a.shutdown.cancel(),
+            _ => f.a.credential.lock().unwrap().revision += 1,
+        }
+        assert!(slot.current_with_held(&Invocation).is_err());
+        assert_eq!(f.a.revision(), 1);
+        drop(slot);
+        assert!(f.a.inflight.clone().try_acquire_owned().is_ok());
+    }
+}
