+//! Exclusive transport negotiation custody without changing any media resource.
+//! Holding this slot is not authority and retains no policy/Store reader.
+use super::*;
+
+pub struct TransportUpdateSlot {
+    controller: Weak<StreamController>,
+    expected: u64,
+    credential_revision: u64,
+    deadline: tokio::time::Instant,
+    original: Vec<(StreamId, Weak<Port>)>,
+    _flight: OwnedSemaphorePermit,
+}
+impl TransportUpdateSlot {
+    /// Obtain fresh exact control only for the bounded local operation about to
+    /// run. Drop this reader before any idle/network/remote-answer observation.
+    pub fn current_with_held(
+        &self,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        let controller = self
+            .controller
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        let credential = controller.credential_snapshot();
+        if credential.revision != self.credential_revision || controller.shutdown.is_cancelled() {
+            return Err(StreamControlError::Authority);
+        }
+        let scope = controller.scope(&credential.principal, MediaPurpose::Control);
+        let lease = controller
+            .policy
+            .current_transport_update(&scope, self.expected, held)?;
+        let owner = lease.authority();
+        StreamController::check(&scope, owner)?;
+        if !owner.may_control {
+            return Err(StreamControlError::Authority);
+        }
+        let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.closed
+            || state.model.revision() != self.expected
+            || state.active.len() != self.original.len()
+            || self.original.iter().any(|(id, original)| {
+                state
+                    .active
+                    .get(id)
+                    .is_none_or(|p| !Weak::ptr_eq(original, &Arc::downgrade(p)))
+            })
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        drop(state);
+        controller.check_credential_snapshot(&credential)?;
+        if tokio::time::Instant::now() >= self.deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        Ok(lease)
+    }
+    pub fn deadline(&self) -> tokio::time::Instant {
+        self.deadline
+    }
+}
+impl StreamController {
+    /// Reserve the same slot used by stream/gate/audience/credential changes.
+    /// No proposal, revision, generation, gate, source or port changes here.
+    /// A separate default-deny transport policy must recognize the exact held
+    /// invocation; an ordinary current media owner does not grant this action.
+    pub fn reserve_transport_update_with_held(
+        self: &Arc<Self>,
+        expected: u64,
+        deadline: tokio::time::Instant,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<TransportUpdateSlot> {
+        let credential = self.credential_snapshot();
+        let deadline = Self::command_deadline(&credential.principal, deadline)
+            .min(tokio::time::Instant::now() + Duration::from_secs(30));
+        if deadline <= tokio::time::Instant::now() {
+            return Err(StreamControlError::Deadline);
+        }
+        let flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let original = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            if state.closed || state.model.revision() != expected || state.active.is_empty() {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            state
+                .active
+                .iter()
+                .map(|(id, p)| (id.clone(), Arc::downgrade(p)))
+                .collect()
+        };
+        let slot = TransportUpdateSlot {
+            controller: Arc::downgrade(self),
+            expected,
+            credential_revision: credential.revision,
+            deadline,
+            original,
+            _flight: flight,
+        };
+        drop(slot.current_with_held(held)?);
+        Ok(slot)
+    }
+}
