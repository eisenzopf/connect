+    /// Borrow only the existing allocation bound to this original admitted
+    /// peer and live route. This never constructs/replaces a peer or starts an
+    /// allocation. Recheck the same route and physical lifetime after waiting.
+    pub async fn original_peer(
+        &self,
+        id: &ConnectionId,
+        peer: &Arc<PeerAdmission>,
+        deadline: tokio::time::Instant,
+    ) -> Result<Arc<RvoipPeerConnection>> {
+        let route = self.routes.get(id).map(|r| r.value().clone())
+            .ok_or_else(|| RvoipError::ConnectionNotFound(id.clone()))?;
+        let current = || {
+            !route.cancel.is_cancelled()
+                && Weak::ptr_eq(&route.peer, &Arc::downgrade(peer))
+                && route.binding.current(peer, id)
+                && self.routes.get(id).is_some_and(|r| Arc::ptr_eq(r.value(), &route))
+        };
+        if !current() {
+            return Err(RvoipError::AdmissionRejected("Original WebRTC peer retired"));
+        }
+        let original = route.binding.peer(deadline).await?;
+        if !current() {
+            return Err(RvoipError::AdmissionRejected("Original WebRTC peer retired"));
+        }
+        Ok(original)
+    }
