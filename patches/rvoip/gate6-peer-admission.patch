+fn offer() -> Value {
+    let mut value = envelope(
+        "connection.offer",
+        json!({"by_participant":"asserted-not-authority","substrate":"quic","capabilities":{},"streams_offered":[{"id":"audio","kind":"audio","direction":"sendrecv","codec_preferences":["PCMU"]}]}),
