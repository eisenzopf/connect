+#[async_trait]
+impl AuthenticatedHandler for EngineHandler {
+    async fn handle(&self, authorized: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let peer = authorized
+            .peer_admission()
+            .ok_or(DispatchError::Authority)?
+            .clone();
+        {
+            let mut first = self.peer.lock().unwrap();
+            if let Some(first) = &*first {
+                assert!(Arc::ptr_eq(first, &peer));
+            } else {
+                *first = Some(peer.clone());
+            }
+        }
+        let request = authorized.envelope();
+        if request.kind() != "connection.offer"
+            || request.scope(Scope::Conversation) != Some("conversation")
+            || request.scope(Scope::Session) != Some("session")
+            || request.scope(Scope::Connection) != Some("connection")
+        {
+            return Err(DispatchError::Authority);
+        }
+        let mutation = ParticipantMutation {
+            operation_id: request
+                .scope(Scope::Operation)
+                .ok_or(DispatchError::Authority)?
+                .into(),
+            correlation_id: request.id().into(),
+            expected_revision: request.original()["expected_revision"]
+                .as_u64()
+                .ok_or(DispatchError::Authority)?,
+            participant: core_fixture::participant("alice"),
+            change: ParticipantChange::Admit {
+                connection: self.connection.clone(),
+                role_override: None,
+            },
+        };
+        let mut reply = envelope(
+            "connection.answer",
+            json!({"substrate":"quic","capabilities":{},"streams_answered":[{"id":"audio","kind":"audio","direction":"sendrecv","codec":{"name":"PCMU","clock_rate":8000,"channels":1}}]}),
+        );
+        for field in ["cid", "sid", "connid", "operation_id"] {
+            reply[field] = request.original()[field].clone();
+        }
+        reply["in_reply_to"] = json!(request.id());
+        let reply = Envelope::from_value(reply)?;
+        self.core.orch.admit_peer_session_connection(peer,&self.core.session,authorized.principal().clone(),mutation,deadline(),CancellationToken::new()).await.map_err(|error|match error{rvoip_core::orchestrator::participant_control::ParticipantControlError::Transition(rvoip_core::participant_transitions::ParticipantTransitionError::Capacity)=>DispatchError::Capacity,_=>DispatchError::Authority})?;
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        Ok(reply)
+    }
