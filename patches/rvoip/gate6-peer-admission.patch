+    f.policy.task_requirement.store(true, Ordering::SeqCst);
+    let (_, challenge) = blocked_after_first(&f, &mut peer, &h).await;
+    let output = peer
+        .handle(&f.sign(proof(&challenge, "task")), &h, deadline())
+        .await
+        .unwrap();
