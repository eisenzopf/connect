diff --git a/crates/foundation/rvoip-core/src/peer_admission.rs b/crates/foundation/rvoip-core/src/peer_admission.rs
new file mode 100644
index 0000000..b0878d7
--- /dev/null
+++ b/crates/foundation/rvoip-core/src/peer_admission.rs
@@ -0,0 +1,316 @@
+//! Physical-peer resource ownership, never membership or execution authority.
+//! Keep the unique owner through authentication refresh; dropping it retires
+//! only that physical peer's admitted managed routes. Cleanup retains permits.
+use crate::{
+    connection::Transport,
+    identity::{
+        AuthenticatedPrincipal, AuthenticationMethod, IdentityAssurance, PrincipalOwnershipKey,
+    },
+    ids::{ConnectionId, DeviceId, IdentityId, SessionId},
+    orchestrator::Orchestrator,
+    relationships::{EndpointBinding, IdentityBinding, Membership},
+};
+use std::{
+    collections::{HashMap, HashSet},
+    sync::{Arc, Mutex, Weak},
+};
+use tokio_util::sync::CancellationToken;
+use uuid::Uuid;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PeerAdmissionLimits {
+    pub sessions: usize,
+    pub connections: usize,
+}
+impl Default for PeerAdmissionLimits {
+    fn default() -> Self {
+        Self {
+            sessions: 32,
+            connections: 64,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum PeerAdmissionError {
+    #[error("peer resource owner denied")]
+    Authority,
+    #[error("peer resource capacity exhausted")]
+    Capacity,
+    #[error("peer resource association conflicts")]
+    Conflict,
+    #[error("physical peer retired")]
+    Closed,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PeerAdmissionSnapshot {
+    pub sessions: usize,
+    pub connections: usize,
+    pub limits: PeerAdmissionLimits,
+    pub closed: bool,
+}
+struct Record {
+    session: SessionId,
+    nonce: Uuid,
+}
+struct State {
+    core: Option<Weak<Orchestrator>>,
+    routes: HashMap<ConnectionId, Record>,
+}
+pub struct PeerAdmission {
+    id: Uuid,
+    owner: PrincipalOwnershipKey,
+    identity: IdentityId,
+    device: DeviceId,
+    limits: PeerAdmissionLimits,
+    lifetime: CancellationToken,
+    state: Mutex<State>,
+}
+impl std::fmt::Debug for PeerAdmission {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PeerAdmission")
+            .field("snapshot", &self.snapshot())
+            .finish()
+    }
+}
+/// Unique server-owned retirement responsibility. References handed to handlers
+/// cannot close it or replace its identity/device/physical incarnation.
+pub struct PeerAdmissionOwner {
+    peer: Arc<PeerAdmission>,
+}
+impl PeerAdmissionOwner {
+    pub fn new(
+        principal: &AuthenticatedPrincipal,
+        identity: IdentityId,
+        device: DeviceId,
+        parent: CancellationToken,
+        limits: PeerAdmissionLimits,
+    ) -> Result<Self, PeerAdmissionError> {
+        if limits.sessions == 0
+            || limits.sessions > 4096
+            || limits.connections == 0
+            || limits.connections > 4096
+        {
+            return Err(PeerAdmissionError::Capacity);
+        }
+        if device.as_str().is_empty()
+            || device.as_str().len() > 128
+            || !device
+                .as_str()
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._~-".contains(&b))
+        {
+            return Err(PeerAdmissionError::Authority);
+        }
+        validate(principal, &identity)?;
+        Ok(Self {
+            peer: Arc::new(PeerAdmission {
+                id: Uuid::new_v4(),
+                owner: principal.ownership_key(),
+                identity,
+                device,
+                limits,
+                lifetime: parent.child_token(),
+                state: Mutex::new(State {
+                    core: None,
+                    routes: HashMap::new(),
+                }),
+            }),
+        })
+    }
+    pub fn peer(&self) -> Arc<PeerAdmission> {
+        self.peer.clone()
+    }
+}
+impl Drop for PeerAdmissionOwner {
+    fn drop(&mut self) {
+        self.peer.close();
+    }
+}
+fn validate(
+    principal: &AuthenticatedPrincipal,
+    identity: &IdentityId,
+) -> Result<(), PeerAdmissionError> {
+    let now = chrono::Utc::now();
+    if principal.method == AuthenticationMethod::Anonymous
+        || principal.expires_at.is_none_or(|time| time <= now)
+        || principal.issuer.as_ref().is_none_or(|s| s.is_empty())
+    {
+        return Err(PeerAdmissionError::Authority);
+    }
+    IdentityBinding::from_authenticated(principal, identity.clone(), now)
+        .map_err(|_| PeerAdmissionError::Authority)?;
+    match &principal.assurance {
+        IdentityAssurance::Anonymous | IdentityAssurance::Pseudonymous { .. } => {
+            return Err(PeerAdmissionError::Authority)
+        }
+        IdentityAssurance::TaskScoped {
+            identity: id,
+            expires_at,
+            ..
+        } if id != identity || *expires_at <= now => return Err(PeerAdmissionError::Authority),
+        IdentityAssurance::UserAuthorized { identity: id, .. } if id != identity => {
+            return Err(PeerAdmissionError::Authority)
+        }
+        _ => {}
+    }
+    Ok(())
+}
+impl PeerAdmission {
+    pub(crate) fn incarnation(&self) -> Uuid {
+        self.id
+    }
+    pub fn validate_principal(
+        &self,
+        principal: &AuthenticatedPrincipal,
+    ) -> Result<(), PeerAdmissionError> {
+        if self.is_closed() {
+            return Err(PeerAdmissionError::Closed);
+        }
+        validate(principal, &self.identity)?;
+        if self.owner != principal.ownership_key() {
+            return Err(PeerAdmissionError::Authority);
+        }
+        Ok(())
+    }
+    pub fn validate_binding(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        identity: &IdentityId,
+        device: &DeviceId,
+    ) -> Result<(), PeerAdmissionError> {
+        self.validate_principal(principal)?;
+        if identity != &self.identity || device != &self.device {
+            return Err(PeerAdmissionError::Authority);
+        }
+        Ok(())
+    }
+    pub fn is_closed(&self) -> bool {
+        self.lifetime.is_cancelled()
+    }
+    pub fn snapshot(&self) -> PeerAdmissionSnapshot {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        PeerAdmissionSnapshot {
+            sessions: state
+                .routes
+                .values()
+                .map(|r| &r.session)
+                .collect::<HashSet<_>>()
+                .len(),
+            connections: state.routes.len(),
+            limits: self.limits,
+            closed: self.is_closed(),
+        }
+    }
+    pub(crate) fn cancellation(&self) -> CancellationToken {
+        self.lifetime.clone()
+    }
+    pub(crate) fn check_target(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+    ) -> Result<(), PeerAdmissionError> {
+        self.validate_principal(principal)?;
+        member
+            .revalidate_principal(principal, chrono::Utc::now())
+            .map_err(|_| PeerAdmissionError::Authority)?;
+        if member.identity() != &self.identity
+            || endpoint.device() != &self.device
+            || endpoint.identity() != &self.identity
+        {
+            return Err(PeerAdmissionError::Authority);
+        }
+        Ok(())
+    }
+    pub(crate) fn reserve(
+        self: &Arc<Self>,
+        core: &Arc<Orchestrator>,
+        session: &SessionId,
+        connection: &ConnectionId,
+        transport: Transport,
+    ) -> Result<Arc<PeerRoutePermit>, PeerAdmissionError> {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if self.is_closed() {
+            return Err(PeerAdmissionError::Closed);
+        }
+        let weak = Arc::downgrade(core);
+        if state
+            .core
+            .as_ref()
+            .is_some_and(|old| !Weak::ptr_eq(old, &weak))
+        {
+            return Err(PeerAdmissionError::Authority);
+        }
+        if state.routes.contains_key(connection) {
+            return Err(PeerAdmissionError::Conflict);
+        }
+        let sessions = state
+            .routes
+            .values()
+            .map(|r| &r.session)
+            .collect::<HashSet<_>>();
+        if state.routes.len() >= self.limits.connections
+            || (!sessions.contains(session) && sessions.len() >= self.limits.sessions)
+        {
+            return Err(PeerAdmissionError::Capacity);
+        }
+        let nonce = Uuid::new_v4();
+        state.core = Some(weak);
+        state.routes.insert(
+            connection.clone(),
+            Record {
+                session: session.clone(),
+                nonce,
+            },
+        );
+        Ok(Arc::new(PeerRoutePermit {
+            peer: self.clone(),
+            connection: connection.clone(),
+            nonce,
+            transport,
+        }))
+    }
+    fn close(&self) {
+        self.lifetime.cancel();
+        let (core, routes) = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            (
+                state.core.as_ref().and_then(Weak::upgrade),
+                state.routes.keys().cloned().collect::<Vec<_>>(),
+            )
+        };
+        if let Some(core) = core {
+            for connection in routes {
+                core.retire_peer_admission_route(&connection, self.id);
+            }
+        }
+    }
+}
+pub(crate) struct PeerRoutePermit {
+    pub(crate) peer: Arc<PeerAdmission>,
+    connection: ConnectionId,
+    nonce: Uuid,
+    pub(crate) transport: Transport,
+}
+impl PeerRoutePermit {
+    pub(crate) fn belongs_to(&self, id: Uuid) -> bool {
+        self.peer.id == id
+    }
+}
+impl std::fmt::Debug for PeerRoutePermit {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("PeerRoutePermit(redacted)")
+    }
+}
+impl Drop for PeerRoutePermit {
+    fn drop(&mut self) {
+        let mut state = self.peer.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state
+            .routes
+            .get(&self.connection)
+            .is_some_and(|r| r.nonce == self.nonce)
+        {
+            state.routes.remove(&self.connection);
+        }
+    }
+}
