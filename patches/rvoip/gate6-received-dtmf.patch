+            .ok_or(DtmfWriteError::NotReady)?;
+        let conversation = self
+            .conversation(&session.conversation_id)
+            .ok_or(DtmfWriteError::Refused)?;
+        let conversation = conversation
+            .try_read()
+            .map_err(|_| DtmfWriteError::NotReady)?;
+        if conversation.state != ConversationState::Open {
+            return Err(DtmfWriteError::Refused);
+        }
+        let endpoint = DtmfEndpoint {
+            tenant: conversation.tenant_id.clone(),
+            conversation: session.conversation_id.clone(),
+            session: sid,
+            connection: connection.clone(),
+            participant: binding.participant_id.clone(),
+            transport: entry.transport,
+            generation: live.generation,
+        };
+        let ticket = ConnectionLifecycleTicket {
+            connection_id: connection,
+            generation: live.generation,
+            state: state.clone(),
+        };
+        let slot = live
+            .dtmf_sequence
+            .get_or_init(|| Arc::new(Semaphore::new(1)))
+            .clone();
+        Ok((endpoint, ticket, slot))
+    }
