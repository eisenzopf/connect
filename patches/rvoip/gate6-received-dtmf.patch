+// Core publication and the actual SRTP receive pump, with independent signal
+// authority. The host's logical-operation journal is a controlled fixture.
+async fn core_received_peer(
+    core: &Arc<rvoip_core::Orchestrator>,
+    adapter: &Arc<rvoip_webrtc::WebRtcAdapter>,
+    session: &rvoip_core::SessionId,
+) -> (Arc<RvoipPeerConnection>, rvoip_core::ConnectionId) {
+    use rvoip_core::{adapter::ConnectionAdapter, events::Event};
+    let client = RvoipPeerConnection::new(&WebRtcConfig::loopback(), PeerRole::Offerer)
+        .await
+        .unwrap();
+    let offer = client.create_offer_and_gather().await.unwrap();
+    let mut events = core.subscribe_events();
+    let id = adapter.apply_remote_offer(&offer).await.unwrap();
+    let answer = adapter.local_sdp(&id).unwrap();
+    client.set_remote_answer(&answer).await.unwrap();
+    tokio::time::timeout(Duration::from_secs(5),async{loop{if matches!(events.recv().await.unwrap(),Event::ConnectionInbound{connection_id,..}if connection_id==id){break;}}}).await.unwrap();
+    let (accepted, connected) = tokio::join!(
+        core.route_inbound_connection(
+            id.clone(),
+            rvoip_core::commands::InboundAction::Accept {
+                session_id: session.clone(),
+                participant_id: rvoip_core::ParticipantId::new()
+            }
+        ),
+        client.wait_connected(Duration::from_secs(10))
+    );
+    accepted.unwrap();
+    connected.unwrap();
+    tokio::time::timeout(Duration::from_secs(5),async{loop{if matches!(events.recv().await.unwrap(),Event::ConnectionConnected{connection_id,..} if connection_id==id){break;}}}).await.unwrap();
+    (client, id)
+}
+struct ReceivedPolicy {
+    source: rvoip_core::ConnectionId,
+    target: rvoip_core::ConnectionId,
+    allowed: Arc<tokio::sync::RwLock<bool>>,
+    calls: std::sync::atomic::AtomicUsize,
+}
+#[async_trait::async_trait]
+impl rvoip_core::dtmf::DtmfRoutePolicy for ReceivedPolicy {
+    async fn acquire(
+        &self,
+        route: &rvoip_core::dtmf::DtmfRouteScope<'_>,
+        packet: &rvoip_core::dtmf::DtmfWriteScope<'_>,
+    ) -> std::result::Result<rvoip_core::dtmf::DtmfWriteLease, rvoip_core::dtmf::DtmfWriteError>
+    {
+        use rvoip_core::dtmf::*;
+        assert_eq!(route.source.connection(), &self.source);
+        assert_eq!(route.recipient.connection(), &self.target);
+        assert_eq!(route.observation.kind(), DtmfSourceKind::WebRtcRfc4733);
+        assert_eq!(
+            route.intent.operation_id(),
+            "original-received-webrtc-operation"
+        );
+        assert_eq!(packet.digits, "5");
+        assert_eq!(packet.duration_ms, 121);
+        let guard = self.allowed.clone().read_owned().await;
+        if !*guard {
+            return Err(DtmfWriteError::Refused);
+        }
+        self.calls.fetch_add(1, std::sync::atomic::Ordering::AcqRel);
+        Ok(DtmfWriteLease::new(
+            guard,
+            tokio::time::Instant::now() + Duration::from_millis(200),
+            || true,
+        ))
+    }
+}
+#[tokio::test]
+async fn actual_srtp_received_source_routes_through_core_with_exact_timing_and_fresh_signal_authority(
+) {
+    use rvoip_core::{adapter::ConnectionAdapter, dtmf::*};
+    let _ = rustls::crypto::ring::default_provider().install_default();
+    let core = rvoip_core::Orchestrator::new(rvoip_core::Config::default());
+    let adapter = rvoip_webrtc::WebRtcAdapter::new(WebRtcConfig::loopback());
+    core.register(adapter.clone()).unwrap();
+    let conversation = core
+        .open_conversation(
+            rvoip_core::ids::TenantId::new(),
+            Default::default(),
+            Default::default(),
+        )
+        .await
+        .unwrap();
+    let session = core
+        .start_session(
+            conversation,
+            rvoip_core::session::SessionMedium::Voice,
+            vec![],
+        )
+        .await
+        .unwrap();
+    let (source, source_id) = core_received_peer(&core, &adapter, &session).await;
+    let (target, target_id) = core_received_peer(&core, &adapter, &session).await;
+    let mut sub = adapter
+        .subscribe_dtmf_source(&core, source_id.clone())
+        .unwrap();
+    send_dtmf(&source, "5", 121).await.unwrap();
+    let observed = tokio::time::timeout(Duration::from_secs(4), sub.recv())
+        .await
+        .expect("actual adapter SRTP observation")
+        .unwrap();
+    let facts = observed.input().rtp().unwrap();
+    assert_eq!(facts.ssrc, source.local_audio_ssrc().unwrap());
+    assert_eq!(facts.duration_ms, 121);
+    assert!(facts.start_observed);
+    assert_eq!(
+        facts.duration_samples * 1000,
+        u64::from(facts.clock_rate_hz) * 121
+    );
+    let route = observed
+        .prepare_route(
+            &core,
+            target_id.clone(),
+            "original-received-webrtc-operation".into(),
+            DtmfMethod::Rfc4733,
+        )
+        .unwrap();
+    let policy = Arc::new(ReceivedPolicy {
+        source: source_id.clone(),
+        target: target_id.clone(),
+        allowed: Arc::new(tokio::sync::RwLock::new(false)),
+        calls: Default::default(),
+    });
+    assert!(core
+        .route_dtmf(
+            &route,
+            policy.clone(),
+            Default::default(),
+            tokio::time::Instant::now() + Duration::from_secs(2)
+        )
+        .await
+        .is_err());
+    assert_eq!(policy.calls.load(std::sync::atomic::Ordering::Acquire), 0);
+    *policy.allowed.write().await = true;
+    core.route_dtmf(
+        &route,
+        policy.clone(),
+        Default::default(),
+        tokio::time::Instant::now() + Duration::from_secs(2),
+    )
+    .await
+    .unwrap();
+    assert!(policy.allowed.try_write().is_ok());
+    let track = target
+        .wait_remote_track(Duration::from_secs(3))
+        .await
+        .expect("actual target SRTP track");
+    let mut decoder = DtmfDecoder::new([match target.outbound_dtmf_negotiation() {
+        OutboundDtmfNegotiation::Negotiated(c) => c,
+        _ => panic!("target telephone-event negotiation"),
+    }]);
+    let delivered = tokio::time::timeout(Duration::from_secs(3), async {
+        loop {
+            if let Some(TrackRemoteEvent::OnRtpPacket(packet)) = track.poll().await {
+                if let Some(event) = decoder
+                    .decode_packet(
+                        packet.header.ssrc,
+                        packet.header.timestamp,
+                        packet.header.payload_type,
+                        packet.header.marker,
