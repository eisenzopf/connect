+    fn capture_dtmf_endpoint_locked(
+        &self,
+        connection: ConnectionId,
+    ) -> std::result::Result<
+        (DtmfEndpoint, ConnectionLifecycleTicket, Arc<Semaphore>),
+        DtmfWriteError,
+    > {
+        let entry = self
+            .connections
+            .get(&connection)
+            .ok_or(DtmfWriteError::NotReady)?;
+        if entry.inbound_publication != InboundPublicationState::Published {
+            return Err(DtmfWriteError::NotReady);
+        }
+        let state = self
+            .connection_lifecycles
+            .get(&connection)
+            .map(|v| v.value().clone())
+            .ok_or(DtmfWriteError::NotReady)?;
+        let live = state.try_lock().map_err(|_| DtmfWriteError::NotReady)?;
+        if !live.active || live.retired {
+            return Err(DtmfWriteError::Refused);
+        }
+        let sid = self
+            .session_of(&connection)
+            .ok_or(DtmfWriteError::NotReady)?;
+        let session = self.session(&sid).ok_or(DtmfWriteError::NotReady)?;
+        let session = session.try_read().map_err(|_| DtmfWriteError::NotReady)?;
+        if session.state != SessionState::Active {
+            return Err(DtmfWriteError::NotReady);
+        }
+        let binding = session
+            .connections
