new file mode 100644
--- /dev/null
+++ b/crates/sip/rvoip-sip/src/adapter_dtmf_source.rs
@@ -0,0 +1,118 @@
+//! Sealed actual receive metadata, separate from raw digit hints and effects.
+use super::*;
+use rvoip_core::dtmf::*;
+use std::task::Poll;
+struct Fence {
+    adapter: Weak<SipAdapter>,
+    epoch: SipRouteEpoch,
+    media: Option<rvoip_media_core::DtmfNotification>,
+}
+impl DtmfSourceFence for Fence {
+    fn current(&self) -> bool {
+        matches!(self.poll(&mut || Poll::Ready(Ok(()))), Poll::Ready(Ok(())))
+    }
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        let refuse = || Poll::Ready(Err(DtmfWriteError::Refused));
+        let Some(adapter) = self.adapter.upgrade() else {
+            return refuse();
+        };
+        let Some(handle) = self.epoch.admitted_handle() else {
+            return refuse();
+        };
+        let Ok(_mapping) = adapter.mapping_lock.try_lock() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        if adapter
+            .route_epoch_for_connection_locked(&self.epoch.connection_id)
+            .is_none_or(|actual| actual != self.epoch)
+        {
+            return refuse();
+        }
+        let store = &adapter.coordinator.helpers.state_machine.store;
+        let Some(lane) = store.state_machine_lane_exact(handle) else {
+            return refuse();
+        };
+        let Ok(_lane) = lane.try_lock() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        let Ok(operation) = store.authority().try_operation_exact(
+            handle.key(),
+            crate::session_lifecycle::SessionOperationKind::Signaling,
+        ) else {
+            return refuse();
+        };
+        let result = if operation.ensure_current().is_err() {
+            refuse()
+        } else if let Some(media) = &self.media {
+            media.poll_source(io)
+        } else {
+            io()
+        };
+        operation.finish_rollback();
+        result
+    }
+}
+impl SipAdapter {
+    pub(super) fn observe_info_dtmf(
+        &self,
+        call: &SessionId,
+        request: &crate::api::incoming::IncomingRequest,
+        digits: String,
+        duration: u32,
+    ) {
+        use sha2::{Digest, Sha256};
+        let Some(epoch) = self.existing_mapped_epoch(call) else {
+            return;
+        };
+        let Some(handle) = epoch.admitted_handle() else {
+            return;
+        };
+        if request.lifecycle_handle() != Some(handle) || request.response_transaction.is_none() {
+            return;
+        }
+        let Some(raw) = request.raw_request() else {
+            return;
+        };
+        let id = format!("{:x}", Sha256::digest(raw.to_bytes()));
+        let fence = Arc::new(Fence {
+            adapter: self.self_weak.clone(),
+            epoch: epoch.clone(),
+            media: None,
+        });
+        let at = std::time::SystemTime::now()
+            .checked_sub(request.received_at.elapsed())
+            .unwrap_or(std::time::SystemTime::now());
+        if let Ok(input) =
+            DtmfReceivedInput::info(id, digits, duration, at, request.received_at, fence)
+        {
+            self.dtmf_sources.publish(&epoch.connection_id, input);
+        }
+    }
+    pub(super) fn observe_rfc_dtmf(
+        &self,
+        call: &SessionId,
+        received: rvoip_media_core::DtmfNotification,
+    ) {
+        let Some(epoch) = self.existing_mapped_epoch(call) else {
+            return;
+        };
+        let input = DtmfReceivedInput::rfc4733(
+            DtmfSourceKind::SipRfc4733,
+            received.observation_id().into(),
+            received.received().event.clone(),
+            received.received().received_at,
+            received
+                .received()
+                .started_instant
+                .unwrap_or(received.received().received_instant),
+            Arc::new(Fence {
+                adapter: self.self_weak.clone(),
+                epoch: epoch.clone(),
+                media: Some(received),
+            }),
+        );
+        if let Ok(input) = input {
+            self.dtmf_sources.publish(&epoch.connection_id, input);
+        }
+    }
+}
