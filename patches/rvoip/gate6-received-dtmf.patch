@@ -0,0 +1,104 @@
+//! Exact route and actual track fenced received observations.
+use super::*;
+use rvoip_core::dtmf::*;
+use std::{sync::Weak, task::Poll};
+pub(super) struct Fence {
+    pub routes: Weak<DashMap<ConnectionId, Route>>,
+    pub connection: ConnectionId,
+    pub peer: Weak<RvoipPeerConnection>,
+    pub physical: Arc<dyn DtmfSourceFence>,
+}
+impl DtmfSourceFence for Fence {
+    fn current(&self) -> bool {
+        matches!(self.poll(&mut || Poll::Ready(Ok(()))), Poll::Ready(Ok(())))
+    }
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        poll_route(&self.routes, &self.connection, &self.peer, &mut || {
+            self.physical.poll(io)
+        })
+    }
+}
+fn poll_route(
+    routes_weak: &Weak<DashMap<ConnectionId, Route>>,
+    connection: &ConnectionId,
+    peer: &Weak<RvoipPeerConnection>,
+    io: &mut dyn FnMut() -> DtmfIoPoll,
+) -> DtmfIoPoll {
+    let Some(routes) = routes_weak.upgrade() else {
+        return Poll::Ready(Err(DtmfWriteError::Refused));
+    };
+    let route = match routes.try_get(connection) {
+        dashmap::try_result::TryResult::Present(v) => v,
+        dashmap::try_result::TryResult::Locked => {
+            return Poll::Ready(Err(DtmfWriteError::NotReady))
+        }
+        _ => return Poll::Ready(Err(DtmfWriteError::Refused)),
+    };
+    let Some(failed) = route.failed_at.try_lock() else {
+        return Poll::Ready(Err(DtmfWriteError::NotReady));
+    };
+    if failed.is_some()
+        || *route.data_cancel.borrow()
+        || !route.core_published.load(Ordering::Acquire)
+        || !route.connected_published.load(Ordering::Acquire)
+        || !peer.upgrade().is_some_and(|p| Arc::ptr_eq(&p, &route.peer))
+    {
+        return Poll::Ready(Err(DtmfWriteError::Refused));
+    }
+    io()
+}
+struct TargetFence {
+    routes: Weak<DashMap<ConnectionId, Route>>,
+    connection: ConnectionId,
+    peer: Weak<RvoipPeerConnection>,
+}
+impl DtmfIoFence for TargetFence {
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        poll_route(&self.routes, &self.connection, &self.peer, io)
+    }
+}
+struct TargetPolicy {
+    policy: Arc<dyn DtmfWriteAuthority>,
+    fence: Arc<TargetFence>,
+}
+#[async_trait::async_trait]
+impl DtmfWriteAuthority for TargetPolicy {
+    async fn acquire(
+        &self,
+        scope: &DtmfWriteScope<'_>,
+    ) -> std::result::Result<DtmfWriteLease, DtmfWriteError> {
+        self.policy
+            .acquire(scope)
+            .await?
+            .with_outer_fence(self.fence.clone())
+    }
+}
+impl WebRtcAdapter {
+    pub(super) async fn send_authorized_dtmf(
+        &self,
+        connection: ConnectionId,
+        digits: &str,
+        duration: u32,
+        policy: Arc<dyn DtmfWriteAuthority>,
+    ) -> std::result::Result<(), DtmfWriteError> {
+        let route = self
+            .route(&connection)
+            .map_err(|_| DtmfWriteError::Refused)?;
+        let fence = Arc::new(TargetFence {
+            routes: Arc::downgrade(&self.routes),
+            connection,
+            peer: Arc::downgrade(&route.peer),
+        });
+        crate::media::dtmf::send_dtmf_authorized(
+            &route.peer,
+            digits,
+            duration,
+            Arc::new(TargetPolicy { policy, fence }),
+        )
+        .await
+        .map_err(|error| match error {
+            crate::errors::WebRtcError::DtmfWrite(error) => error,
+            _ => DtmfWriteError::OutcomeUnknown,
+        })
+    }
+}
