+#[cfg(test)]
+mod received_signal_tests {
+    use super::*;
+    use rvoip_core::dtmf::*;
+    use std::task::Poll;
+    #[test]
+    fn signal_fence_rejects_same_ssrc_track_aba_peer_retirement_and_finished_pump_without_primary_clock(
+    ) {
+        for configured in [false, true] {
+            let clock = SourceClock::configured(configured);
+            let old: Arc<dyn Send + Sync> = Arc::new(());
+            let new: Arc<dyn Send + Sync> = Arc::new(());
+            let live = Arc::new(Mutex::new(true));
+            clock.register_signal_track(1, &old);
+            let fence = clock.signal_fence(1, &old, live.clone()).unwrap();
+            assert!(fence.current());
+            clock.register_signal_track(1, &new);
+            assert!(!fence.current());
+            clock.register_signal_track(1, &old);
+            assert!(!fence.current());
+            let current = clock.signal_fence(1, &old, live.clone()).unwrap();
+            assert!(current.current());
+            *live.lock().unwrap() = false;
+            assert!(!current.current());
+            *live.lock().unwrap() = true;
+            clock.retire();
+            assert!(!current.current());
+        }
+    }
+    #[test]
+    fn pending_signal_poll_releases_track_metadata_and_cannot_keep_a_retired_source_alive() {
+        let clock = SourceClock::default();
+        let identity: Arc<dyn Send + Sync> = Arc::new(());
+        clock.register_signal_track(1, &identity);
+        let live = Arc::new(Mutex::new(true));
+        let fence = clock.signal_fence(1, &identity, live.clone()).unwrap();
+        assert!(fence.poll(&mut || Poll::Pending).is_pending());
+        assert!(live.try_lock().is_ok());
+        assert!(clock.0.signals.try_lock().is_ok());
+        drop(identity);
+        let mut polled = false;
+        assert!(matches!(
+            fence.poll(&mut || {
+                polled = true;
+                Poll::Ready(Ok(()))
+            }),
+            Poll::Ready(Err(DtmfWriteError::Refused))
+        ));
+        assert!(!polled);
+    }
+}
