+// Signal custody is independent of the primary sender clock. Telephone-event
+// tracks must never replace audio clock anchors, even when they use another SSRC.
+impl SourceClock {
+    pub(crate) fn register_signal_track(&self, ssrc: u32, identity: &Arc<dyn Send + Sync>) {
+        let mut entries = self.0.signals.lock().unwrap_or_else(|p| p.into_inner());
+        entries.retain(|_, (_, weak)| weak.strong_count() > 0);
+        if !self.0.live.load(Ordering::Acquire)
+            || (!entries.contains_key(&ssrc) && entries.len() >= 64)
+        {
+            return;
+        }
+        if entries
+            .get(&ssrc)
+            .is_some_and(|(_, old)| old.upgrade().is_some_and(|old| Arc::ptr_eq(&old, identity)))
+        {
+            return;
+        }
+        entries.insert(ssrc, (rand::random(), Arc::downgrade(identity)));
+    }
+    pub(crate) fn signal_fence(
+        &self,
+        ssrc: u32,
+        identity: &Arc<dyn Send + Sync>,
+        live: Arc<Mutex<bool>>,
+    ) -> Option<Arc<dyn rvoip_core::dtmf::DtmfSourceFence>> {
+        let entries = self.0.signals.try_lock().ok()?;
+        let (revision, weak) = entries.get(&ssrc)?;
+        if !weak
+            .upgrade()
+            .is_some_and(|old| Arc::ptr_eq(&old, identity))
+        {
+            return None;
+        }
+        Some(Arc::new(SignalFence {
+            clock: self.clone(),
+            ssrc,
+            revision: *revision,
+            identity: Arc::downgrade(identity),
+            live,
+        }))
+    }
+}
+struct SignalFence {
+    clock: SourceClock,
+    ssrc: u32,
+    revision: u128,
+    identity: Weak<dyn Send + Sync>,
+    live: Arc<Mutex<bool>>,
+}
+impl rvoip_core::dtmf::DtmfSourceFence for SignalFence {
+    fn current(&self) -> bool {
+        matches!(
+            self.poll(&mut || std::task::Poll::Ready(Ok(()))),
+            std::task::Poll::Ready(Ok(()))
+        )
+    }
+    fn poll(
+        &self,
+        io: &mut dyn FnMut() -> rvoip_core::dtmf::DtmfIoPoll,
+    ) -> rvoip_core::dtmf::DtmfIoPoll {
+        use rvoip_core::dtmf::DtmfWriteError;
+        use std::task::Poll;
+        let Ok(live) = self.live.try_lock() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        let Ok(entries) = self.clock.0.signals.try_lock() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        if !*live
+            || !self.clock.0.live.load(Ordering::Acquire)
+            || !entries.get(&self.ssrc).is_some_and(|(revision, id)| {
+                *revision == self.revision
+                    && Weak::ptr_eq(id, &self.identity)
+                    && id.strong_count() > 0
+            })
+        {
+            return Poll::Ready(Err(DtmfWriteError::Refused));
+        }
+        io()
+    }
+}
