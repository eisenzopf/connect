+fn received_input(r: &Rig, id: &str, samples: u64, start: bool) -> DtmfReceivedInput {
+    DtmfReceivedInput::rfc4733(
+        DtmfSourceKind::WebRtcRfc4733,
+        id.into(),
+        DecodedDtmfEvent {
+            digit: '5',
+            duration_ms: (samples * 1000 / 8000) as u32,
+            duration_samples: samples,
+            ssrc: 0x12345678,
+            rtp_timestamp: 9000,
+            extended_timestamp: 9000,
+            last_segment_timestamp: 9000,
+            event: 5,
+            payload_type: 101,
+            clock_rate_hz: 8000,
+            start_observed: start,
+        },
+        std::time::SystemTime::now(),
+        std::time::Instant::now(),
+        Arc::new(ControlledSource {
+            adapter: r.origin.clone(),
+            connection: r.source.clone(),
+            stream: r.origin.streams.get(&r.source).unwrap().clone(),
+        }),
+    )
+    .unwrap()
+}
+#[tokio::test]
+async fn received_source_registration_preserves_original_facts_and_requires_fresh_independent_signal_policy(
+) {
+    let r = Rig::new_source(Transport::WebRtc).await;
+    let registry = DtmfSourceRegistry::new(Transport::WebRtc);
+    assert!(!registry.publish(&r.source, received_input(&r, "unregistered", 800, true)));
+    let mut sub = registry
+        .subscribe(&r.core, r.origin.clone(), r.source.clone())
+        .unwrap();
+    assert!(registry.publish(
+        &r.source,
+        received_input(&r, "actual-observation", 800, true)
+    ));
+    let observed = sub.recv().await.unwrap();
+    assert_eq!(observed.input().observation_id(), "actual-observation");
+    assert_eq!(observed.input().rtp().unwrap().ssrc, 0x12345678);
+    let route = observed
+        .prepare_route(
+            &r.core,
+            r.target.clone(),
+            "stable-logical-operation".into(),
+            DtmfMethod::Rfc4733,
+        )
+        .unwrap();
+    assert_eq!(route.observation().kind(), DtmfSourceKind::WebRtcRfc4733);
+    assert_eq!(route.source(), observed.source());
+    let policy = Policy::new(&r);
+    *policy.domain.write().await = false;
+    assert!(r
+        .core
+        .route_dtmf(
+            &route,
+            policy.clone(),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(1)
+        )
+        .await
+        .is_err());
+    r.no_packet().await;
+    *policy.domain.write().await = true;
+    r.core
+        .route_dtmf(
+            &route,
+            policy.clone(),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    let packet = r.receive().await;
+    assert_eq!(packet.payload[0], 5);
+    assert!(policy.domain.try_write().is_ok());
+}
