+//! Explicit bounded source observation ownership, without idle permission.
+use super::*;
+use std::{
+    collections::HashMap,
+    ops::Deref,
+    sync::{atomic::AtomicU64, Mutex},
+    time::{Instant as StdInstant, SystemTime},
+};
+use tokio::sync::mpsc;
+/// All supported binding mutations invalidate registered source epochs, even
+/// if a connection later returns to the same Session/Participant (ABA).
+#[derive(Default)]
+pub(in crate::orchestrator) struct DtmfBindingIndex {
+    map: DashMap<ConnectionId, SessionId>,
+    epochs: Mutex<HashMap<ConnectionId, Weak<AtomicU64>>>,
+}
+impl Deref for DtmfBindingIndex {
+    type Target = DashMap<ConnectionId, SessionId>;
+    fn deref(&self) -> &Self::Target {
+        &self.map
+    }
+}
+impl DtmfBindingIndex {
+    fn invalidate(&self, id: &ConnectionId) {
+        let mut epochs = self.epochs.lock().unwrap_or_else(|p| p.into_inner());
+        if let Some(token) = epochs.get(id).and_then(Weak::upgrade) {
+            let _ = token.fetch_update(Ordering::AcqRel, Ordering::Acquire, |v| v.checked_add(1));
+        } else {
+            epochs.remove(id);
+        }
+    }
+    fn token(&self, id: &ConnectionId) -> std::result::Result<Arc<AtomicU64>, DtmfWriteError> {
+        let mut epochs = self.epochs.lock().unwrap_or_else(|p| p.into_inner());
+        epochs.retain(|_, v| v.strong_count() > 0);
+        if let Some(old) = epochs.get(id).and_then(Weak::upgrade) {
+            return Ok(old);
+        }
+        if epochs.len() >= 1024 {
+            return Err(DtmfWriteError::NotReady);
+        }
+        let token = Arc::new(AtomicU64::new(1));
+        epochs.insert(id.clone(), Arc::downgrade(&token));
+        Ok(token)
+    }
+    pub(in crate::orchestrator) fn insert(
+        &self,
+        id: ConnectionId,
+        sid: SessionId,
+    ) -> Option<SessionId> {
+        self.invalidate(&id);
+        self.map.insert(id, sid)
+    }
+    pub(in crate::orchestrator) fn remove(
+        &self,
+        id: &ConnectionId,
+    ) -> Option<(ConnectionId, SessionId)> {
+        self.invalidate(id);
+        self.map.remove(id)
+    }
+    pub(in crate::orchestrator) fn remove_if(
+        &self,
+        id: &ConnectionId,
+        predicate: impl FnOnce(&ConnectionId, &SessionId) -> bool,
+    ) -> Option<(ConnectionId, SessionId)> {
+        self.map.remove_if(id, |k, v| {
+            let remove = predicate(k, v);
+            if remove {
+                self.invalidate(k);
+            }
+            remove
+        })
+    }
+    pub(in crate::orchestrator) fn retain(
+        &self,
+        mut predicate: impl FnMut(&ConnectionId, &mut SessionId) -> bool,
+    ) {
+        self.map.retain(|k, v| {
+            let old = v.clone();
+            let keep = predicate(k, v);
+            if !keep || *v != old {
+                self.invalidate(k);
+            }
+            keep
+        });
+    }
+}
+struct Stamp {
+    core: Weak<Orchestrator>,
+    adapter: Weak<dyn ConnectionAdapter>,
+    endpoint: DtmfEndpoint,
+    life: Weak<Mutex<ConnectionLifecycleState>>,
+    epoch: Arc<AtomicU64>,
+    revision: u64,
+}
+impl Stamp {
+    fn current(&self) -> bool {
+        let Some(core) = self.core.upgrade() else {
+            return false;
+        };
+        let Ok(_registry) = core.connection_registry_lock.try_lock() else {
+            return false;
+        };
+        let Ok((endpoint, ticket, _)) =
+            core.capture_dtmf_endpoint_locked(self.endpoint.connection.clone())
+        else {
+            return false;
+        };
+        self.epoch.load(Ordering::Acquire) == self.revision
+            && self.revision != u64::MAX
+            && endpoint == self.endpoint
+            && self
+                .life
+                .upgrade()
+                .is_some_and(|s| Arc::ptr_eq(&s, &ticket.state))
+            && self
+                .adapter
+                .upgrade()
+                .zip(core.adapter(endpoint.transport).ok())
+                .is_some_and(|(a, b)| Arc::ptr_eq(&a, &b))
+    }
+}
+/// Actual receive facts, not the caller's original logical operation or a grant.
+#[derive(Clone)]
+pub struct DtmfReceivedInput {
+    kind: DtmfSourceKind,
+    id: String,
+    digits: String,
+    duration_ms: u32,
+    at: chrono::DateTime<chrono::Utc>,
+    instant: StdInstant,
+    rtp: Option<crate::dtmf::DecodedDtmfEvent>,
+    fence: Arc<dyn DtmfSourceFence>,
+}
+impl std::fmt::Debug for DtmfReceivedInput {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfReceivedInput(redacted)")
+    }
+}
+impl DtmfReceivedInput {
+    /// Trusted actual INFO parser/transaction composition, never payload.source.
+    pub fn info(
+        id: String,
+        digits: String,
+        duration_ms: u32,
+        at: SystemTime,
+        instant: StdInstant,
+        fence: Arc<dyn DtmfSourceFence>,
+    ) -> std::result::Result<Self, DtmfWriteError> {
+        if digits.len() != 1 || !(100..=5000).contains(&duration_ms) {
+            return Err(DtmfWriteError::Refused);
+        }
+        validate_dtmf_sequence(&digits, duration_ms, 0).map_err(|_| DtmfWriteError::Refused)?;
+        Self::make(
+            DtmfSourceKind::SipInfo,
+            id,
+            digits,
+            duration_ms,
+            at,
+            instant,
+            None,
+            fence,
+        )
+    }
+    /// Trusted negotiated receiver composition. Preserve incomplete/fractional
+    /// facts honestly; prepare_route refuses to synthesize those as an effect.
+    pub fn rfc4733(
+        kind: DtmfSourceKind,
+        id: String,
+        event: crate::dtmf::DecodedDtmfEvent,
+        at: SystemTime,
+        instant: StdInstant,
+        fence: Arc<dyn DtmfSourceFence>,
+    ) -> std::result::Result<Self, DtmfWriteError> {
+        if !matches!(
+            kind,
+            DtmfSourceKind::SipRfc4733 | DtmfSourceKind::WebRtcRfc4733
+        ) {
+            return Err(DtmfWriteError::Refused);
+        }
+        Self::make(
+            kind,
+            id,
+            event.digit.to_string(),
+            event.duration_ms,
+            at,
+            instant,
+            Some(event),
+            fence,
+        )
+    }
+    fn make(
+        kind: DtmfSourceKind,
+        id: String,
+        digits: String,
+        duration_ms: u32,
+        at: SystemTime,
+        instant: StdInstant,
+        rtp: Option<crate::dtmf::DecodedDtmfEvent>,
+        fence: Arc<dyn DtmfSourceFence>,
+    ) -> std::result::Result<Self, DtmfWriteError> {
+        let _ = DtmfSourceObservation::observed(kind, id.clone(), at.into())?;
+        Ok(Self {
+            kind,
+            id,
+            digits,
+            duration_ms,
+            at: at.into(),
+            instant,
+            rtp,
+            fence,
+        })
+    }
+    pub fn rtp(&self) -> Option<&crate::dtmf::DecodedDtmfEvent> {
+        self.rtp.as_ref()
+    }
+    pub fn kind(&self) -> DtmfSourceKind {
+        self.kind
+    }
+    pub fn observation_id(&self) -> &str {
+        &self.id
+    }
+    pub fn digits(&self) -> &str {
+        &self.digits
+    }
+    pub fn duration_ms(&self) -> u32 {
+        self.duration_ms
+    }
+    pub fn received_at(&self) -> chrono::DateTime<chrono::Utc> {
+        self.at
+    }
+}
+struct Registered {
+    stamp: Stamp,
+    sender: mpsc::Sender<ReceivedDtmfObservation>,
+    cancel: CancellationToken,
+    created: StdInstant,
+    drops: AtomicU64,
+}
+/// One source subscription owns its registration, not permission or a task.
+pub struct DtmfSourceSubscription {
+    registered: Arc<Registered>,
+    receiver: mpsc::Receiver<ReceivedDtmfObservation>,
+}
+impl Drop for DtmfSourceSubscription {
+    fn drop(&mut self) {
+        self.registered.cancel.cancel();
+    }
+}
+impl DtmfSourceSubscription {
+    pub async fn recv(&mut self) -> Option<ReceivedDtmfObservation> {
+        tokio::select! {biased;_=self.registered.cancel.cancelled()=>None,event=self.receiver.recv()=>event}
+    }
+    pub fn dropped(&self) -> u64 {
+        self.registered.drops.load(Ordering::Acquire)
+    }
+}
+#[derive(Clone)]
+pub struct ReceivedDtmfObservation {
+    source: DtmfEndpoint,
+    input: DtmfReceivedInput,
+    registration: Weak<Registered>,
+}
+impl std::fmt::Debug for ReceivedDtmfObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("ReceivedDtmfObservation(redacted)")
+    }
+}
+impl ReceivedDtmfObservation {
+    pub fn source(&self) -> &DtmfEndpoint {
+        &self.source
+    }
+    pub fn input(&self) -> &DtmfReceivedInput {
+        &self.input
+    }
+    /// Host journals/deduplicates the original operation before scheduling; a
+    /// transport observation ID is not an operation ID or a stored permission.
+    pub fn prepare_route(
+        &self,
+        core: &Arc<Orchestrator>,
+        recipient: ConnectionId,
+        operation: String,
+        method: DtmfMethod,
+    ) -> std::result::Result<DtmfRoute, DtmfWriteError> {
+        let registration = self.registration.upgrade().ok_or(DtmfWriteError::Refused)?;
+        if registration.cancel.is_cancelled()
+            || !registration.stamp.current()
+            || registration
+                .stamp
+                .core
+                .upgrade()
+                .is_none_or(|owner| !Arc::ptr_eq(&owner, core))
+        {
+            return Err(DtmfWriteError::Refused);
+        }
+        if self.input.rtp.as_ref().is_some_and(|e| {
+            !e.start_observed
+                || e.clock_rate_hz == 0
+                || e.duration_samples
+                    .checked_mul(1000)
+                    .is_none_or(|v| v % u64::from(e.clock_rate_hz) != 0)
+        }) {
+            return Err(DtmfWriteError::Refused);
+        }
+        let intent = DtmfIntent::new(
+            operation,
+            self.input.digits.clone(),
+            self.input.duration_ms,
+            method,
+        )?;
+        let route = core.prepare_dtmf_route(self.source.connection.clone(), recipient, intent)?;
+        if route.source() != &self.source {
+            return Err(DtmfWriteError::Refused);
+        }
+        struct Fence {
+            registered: Weak<Registered>,
+            physical: Arc<dyn DtmfSourceFence>,
+        }
+        impl DtmfSourceFence for Fence {
+            fn current(&self) -> bool {
+                self.registered.upgrade().is_some_and(|r| {
+                    !r.cancel.is_cancelled()
+                        && r.stamp.epoch.load(Ordering::Acquire) == r.stamp.revision
+                }) && self.physical.current()
+            }
+            fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+                if !self.current() {
+                    return Poll::Ready(Err(DtmfWriteError::Refused));
+                }
+                self.physical.poll(io)
+            }
+        }
+        route
+            .with_source_fence(Arc::new(Fence {
+                registered: self.registration.clone(),
+                physical: self.input.fence.clone(),
+            }))?
+            .with_source_observation(DtmfSourceObservation::observed(
+                self.input.kind,
+                self.input.id.clone(),
+                self.input.at,
+            )?)
+    }
+}
+/// Adapter-owned bounded registry. It carries weak registrations and metadata,
+/// never host permission; unregistered input cannot create source ownership.
+pub struct DtmfSourceRegistry {
+    transport: Transport,
+    entries: Mutex<HashMap<ConnectionId, Weak<Registered>>>,
+    drops: AtomicU64,
+}
+impl DtmfSourceRegistry {
+    pub fn new(transport: Transport) -> Self {
+        Self {
+            transport,
+            entries: Mutex::new(HashMap::new()),
+            drops: AtomicU64::new(0),
+        }
+    }
+    pub fn subscribe(
+        &self,
+        core: &Arc<Orchestrator>,
+        adapter: Arc<dyn ConnectionAdapter>,
+        connection: ConnectionId,
+    ) -> std::result::Result<DtmfSourceSubscription, DtmfWriteError> {
+        let installed = core
+            .adapter(self.transport)
+            .map_err(|_| DtmfWriteError::Refused)?;
+        if adapter.transport() != self.transport || !Arc::ptr_eq(&installed, &adapter) {
+            return Err(DtmfWriteError::Refused);
+        }
+        let _registry = core
+            .connection_registry_lock
+            .try_lock()
+            .map_err(|_| DtmfWriteError::NotReady)?;
+        let (endpoint, ticket, _) = core.capture_dtmf_endpoint_locked(connection.clone())?;
+        if endpoint.transport != self.transport {
+            return Err(DtmfWriteError::Refused);
+        }
+        let epoch = core.sessions_by_connection.token(&connection)?;
+        let revision = epoch.load(Ordering::Acquire);
+        if revision == u64::MAX {
+            return Err(DtmfWriteError::Refused);
+        }
+        let (sender, receiver) = mpsc::channel(32);
+        let registered = Arc::new(Registered {
+            stamp: Stamp {
+                core: Arc::downgrade(core),
+                adapter: Arc::downgrade(&adapter),
+                endpoint,
+                life: Arc::downgrade(&ticket.state),
+                epoch,
+                revision,
+            },
+            sender,
+            cancel: CancellationToken::new(),
+            created: StdInstant::now(),
+            drops: AtomicU64::new(0),
+        });
+        let mut entries = self.entries.lock().unwrap_or_else(|p| p.into_inner());
+        entries.retain(|_, v| v.strong_count() > 0);
+        if entries.len() >= 64 && !entries.contains_key(&connection) {
+            return Err(DtmfWriteError::NotReady);
+        }
+        if let Some(old) = entries
+            .insert(connection, Arc::downgrade(&registered))
+            .and_then(|r| r.upgrade())
+        {
+            old.cancel.cancel();
+        }
+        Ok(DtmfSourceSubscription {
+            registered,
+            receiver,
+        })
+    }
+    pub fn publish(&self, connection: &ConnectionId, input: DtmfReceivedInput) -> bool {
+        let Some(registered) = self
+            .entries
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .get(connection)
+            .and_then(Weak::upgrade)
+        else {
+            return false;
+        };
+        let matches = match input.kind {
+            DtmfSourceKind::SipInfo | DtmfSourceKind::SipRfc4733 => {
+                self.transport == Transport::Sip
+            }
+            DtmfSourceKind::WebRtcRfc4733 => self.transport == Transport::WebRtc,
+            _ => false,
+        };
+        if !matches
+            || registered.cancel.is_cancelled()
+            || input.instant < registered.created
+            || !registered.stamp.current()
+            || !input.fence.current()
+        {
+            self.drops.fetch_add(1, Ordering::Relaxed);
+            registered.drops.fetch_add(1, Ordering::Relaxed);
+            return false;
+        }
+        let observation = ReceivedDtmfObservation {
+            source: registered.stamp.endpoint.clone(),
+            input,
+            registration: Arc::downgrade(&registered),
+        };
+        if registered.sender.try_send(observation).is_err() {
+            self.drops.fetch_add(1, Ordering::Relaxed);
+            registered.drops.fetch_add(1, Ordering::Relaxed);
+            false
+        } else {
+            true
+        }
+    }
+    pub fn dropped(&self) -> u64 {
+        self.drops.load(Ordering::Acquire)
+    }
+}
+#[cfg(test)]
+mod binding_tests {
+    use super::*;
+    #[test]
+    fn binding_epoch_does_not_revive_after_session_aba_and_dead_sources_do_not_accumulate() {
+        let index = DtmfBindingIndex::default();
+        let c = ConnectionId::new();
+        let a = SessionId::new();
+        let b = SessionId::new();
+        index.insert(c.clone(), a.clone());
+        let token = index.token(&c).unwrap();
+        let old = token.load(Ordering::Acquire);
+        index.insert(c.clone(), b);
+        index.insert(c.clone(), a);
+        assert!(token.load(Ordering::Acquire) > old);
+        drop(token);
+        for _ in 0..2000 {
+            let token = index.token(&ConnectionId::new()).unwrap();
+            drop(token);
+        }
+        assert!(index.epochs.lock().unwrap().len() <= 1);
+    }
+}
