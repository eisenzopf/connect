+//! Generation-bound received signal metadata. No signal permission is lent.
+use super::*;
+use crate::dtmf_authority::*;
+use std::{
+    sync::{Mutex, Weak},
+    task::Poll,
+};
+#[derive(Clone)]
+pub struct DtmfNotification {
+    received: rtp_core::telephone_event::ReceivedDtmfEvent,
+    id: String,
+    fence: Arc<dyn DtmfIoFence>,
+}
+impl std::ops::Deref for DtmfNotification {
+    type Target = rtp_core::telephone_event::DecodedDtmfEvent;
+    fn deref(&self) -> &Self::Target {
+        &self.received.event
+    }
+}
+impl std::fmt::Debug for DtmfNotification {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfNotification(redacted)")
+    }
+}
+impl DtmfNotification {
+    pub fn received(&self) -> &rtp_core::telephone_event::ReceivedDtmfEvent {
+        &self.received
+    }
+    pub fn observation_id(&self) -> &str {
+        &self.id
+    }
+    pub fn poll_source(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        self.fence.poll(io)
+    }
+}
+pub(super) struct EpochUpdate {
+    pub _guard: tokio::sync::OwnedRwLockWriteGuard<()>,
+    pub at: Arc<Mutex<std::time::Instant>>,
+}
+impl Drop for EpochUpdate {
+    fn drop(&mut self) {
+        *self.at.lock().unwrap_or_else(|p| p.into_inner()) = std::time::Instant::now();
+    }
+}
+struct SourceFence {
+    sessions: Weak<DashMap<DialogId, RtpSessionWrapper>>,
+    id: DialogId,
+    session: Weak<tokio::sync::Mutex<rtp_core::RtpSession>>,
+    domain: Arc<tokio::sync::RwLock<()>>,
+    generation: Arc<std::sync::atomic::AtomicU64>,
+    expected: u64,
+}
+impl DtmfIoFence for SourceFence {
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        let Ok(_guard) = self.domain.clone().try_read_owned() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        if self.generation.load(std::sync::atomic::Ordering::Acquire) != self.expected {
+            return Poll::Ready(Err(DtmfWriteError::Refused));
+        }
+        let Some(sessions) = self.sessions.upgrade() else {
+            return Poll::Ready(Err(DtmfWriteError::Refused));
+        };
+        let entry = match sessions.try_get(&self.id) {
+            dashmap::try_result::TryResult::Present(entry) => entry,
+            dashmap::try_result::TryResult::Locked => {
+                return Poll::Ready(Err(DtmfWriteError::NotReady))
+            }
+            _ => return Poll::Ready(Err(DtmfWriteError::Refused)),
+        };
+        if !self
+            .session
+            .upgrade()
+            .is_some_and(|s| Arc::ptr_eq(&s, &entry.session))
+        {
+            return Poll::Ready(Err(DtmfWriteError::Refused));
+        }
+        io()
+    }
+}
+pub(super) fn capture(
+    sessions: &Arc<DashMap<DialogId, RtpSessionWrapper>>,
+    id: &DialogId,
+    received: rtp_core::telephone_event::ReceivedDtmfEvent,
+) -> Option<DtmfNotification> {
+    let entry = sessions.try_get(id).try_unwrap()?;
+    let _domain = entry.dtmf_domain.clone().try_read_owned().ok()?;
+    let changed_at = *entry.dtmf_changed_at.lock().ok()?;
+    if received.received_instant < changed_at
+        || received
+            .started_instant
+            .is_some_and(|start| start < changed_at)
+    {
+        return None;
+    }
+    let expected = entry
+        .dtmf_generation
+        .load(std::sync::atomic::Ordering::Acquire);
+    let identity = format!(
+        "{}-{}-{:08x}-{:016x}-{}-{}-{}",
+        entry.dtmf_origin,
+        expected,
+        received.ssrc,
+        received.extended_timestamp,
+        received.event.event,
+        received.payload_type,
+        received.clock_rate_hz
+    );
+    let fence = Arc::new(SourceFence {
+        sessions: Arc::downgrade(sessions),
+        id: id.clone(),
+        session: Arc::downgrade(&entry.session),
+        domain: entry.dtmf_domain.clone(),
+        generation: entry.dtmf_generation.clone(),
+        expected,
+    });
+    Some(DtmfNotification {
+        received,
+        id: identity,
+        fence,
+    })
+}
