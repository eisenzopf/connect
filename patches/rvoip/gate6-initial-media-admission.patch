+#[test]
+fn initial_preparation_requires_verified_origin_and_does_not_activate_before_connection() {
+    let mut f = Fixture::new();
+    f.connection = ConnectionBinding::prepare(
+        &f.member,
+        &f.presence,
+        &f.endpoint,
+        f.connection.connection().clone(),
+    )
+    .unwrap();
+    let mut model = StreamLifecycle::new(&f.authority()).unwrap();
+    assert!(model.is_initial_preparation());
+    assert_eq!(model.revision(), 0);
+    assert!(model.streams().is_empty());
+    let now = Instant::now();
+    let candidate = model
+        .prepare(
+            &f.authority(),
+            0,
+            &profile(),
+            &profile(),
+            &[desired("audio", Medium::Audio)],
+            now,
+            now + Duration::from_secs(1),
+        )
+        .unwrap();
+    let ready = bindings(&candidate);
+    assert_eq!(
+        model.commit(&f.authority(), &candidate, &ready, now),
+        Err(MediaTransitionError::Authority)
+    );
+    assert_eq!(
+        model.authorize_binding(&f.authority()),
+        Err(MediaTransitionError::Authority)
+    );
+    assert_eq!(
+        f.connection
+            .observe_ready(&f.member, &f.presence, &f.endpoint, 2),
+        Err(crate::relationships::RelationshipError::Conflict)
+    );
+    assert_eq!(f.connection.state(), BindingState::Preparing);
+    assert!(model.streams().is_empty());
+    f.connection
+        .observe_ready(&f.member, &f.presence, &f.endpoint, 1)
+        .unwrap();
+    assert_eq!(
+        model.commit(&f.authority(), &candidate, &ready, now),
+        Err(MediaTransitionError::Authority)
+    );
+    f.connection
+        .activate(&f.member, &f.presence, &f.endpoint)
+        .unwrap();
+    model
+        .commit(&f.authority(), &candidate, &ready, now)
+        .unwrap();
+    assert!(!model.is_initial_preparation());
+    assert_eq!(model.revision(), 1);
+    assert_eq!(
+        model.streams()[&StreamId::from_string("audio")].state,
+        LogicalStreamState::Active
+    );
+    // An already active lifecycle never treats a regressed Connection as a
+    // fresh first offer, even when IDs and generation still match.
+    f.connection = ConnectionBinding::prepare(
+        &f.member,
+        &f.presence,
+        &f.endpoint,
+        f.connection.connection().clone(),
+    )
+    .unwrap();
+    assert!(matches!(
+        model.prepare(
+            &f.authority(),
+            1,
+            &profile(),
+            &profile(),
+            &[desired("audio", Medium::Audio)],
+            now,
+            now + Duration::from_secs(1)
+        ),
+        Err(MediaTransitionError::Authority)
+    ));
+    assert_eq!(model.revision(), 1);
+    assert_eq!(model.opened_binding_count(), 1);
+}
+#[test]
+fn initial_preparation_refuses_unverified_revoked_or_foreign_relationships_without_history() {
+    let mut f = Fixture::new();
+    f.connection = ConnectionBinding::prepare(
+        &f.member,
+        &f.presence,
+        &f.endpoint,
+        f.connection.connection().clone(),
+    )
+    .unwrap();
+    let mut denied = f.authority();
+    denied.may_negotiate = false;
+    assert!(matches!(
+        StreamLifecycle::new(&denied),
+        Err(MediaTransitionError::Authority)
+    ));
+    let foreign = Fixture::in_conversation("other");
+    let mut denied = f.authority();
+    denied.member = &foreign.member;
+    assert!(StreamLifecycle::new(&denied).is_err());
+    let mut model = StreamLifecycle::new(&f.authority()).unwrap();
+    let now = Instant::now();
+    assert!(matches!(
+        model.prepare(
+            &f.authority(),
+            0,
+            &profile(),
+            &profile(),
+            &[desired("audio", Medium::Audio)],
+            now,
+            now
+        ),
+        Err(MediaTransitionError::Expired)
+    ));
+    assert_eq!(model.revision(), 0);
+    assert_eq!(model.opened_binding_count(), 0);
+    assert!(model.is_initial_preparation());
+    f.endpoint.revoke();
+    assert!(matches!(
+        StreamLifecycle::new(&f.authority()),
+        Err(MediaTransitionError::Authority)
+    ));
+    assert!(model
+        .prepare(
+            &f.authority(),
+            0,
+            &profile(),
+            &profile(),
+            &[desired("audio", Medium::Audio)],
+            now,
+            now + Duration::from_secs(1)
+        )
+        .is_err());
+    assert_eq!(model.revision(), 0);
+    assert_eq!(model.opened_binding_count(), 0);
+}
