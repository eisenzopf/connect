+#[tokio::test]
+async fn canonical_preparing_connection_rechecks_ready_under_held_grant_without_reader_reentry() {
+    for kind in ["quic", "wt"] {
+        let mut h = Harness::new(kind).await;
+        {
+            let mut grants = h.media.base.0.write().await;
+            let owner = grants.owners.get_mut(&h.id).unwrap();
+            owner.connection = ConnectionBinding::prepare(
+                &owner.member,
+                &owner.presence,
+                &owner.endpoint,
+                h.id.clone(),
+            )
+            .unwrap();
+        }
+        h.readiness.hold.store(true, Ordering::Release);
+        h.wire
+            .send(h.f.sign(h.command("codec-renegotiate", 0)))
+            .await;
+        h.readiness.entered.notified().await;
+        let controller = h.adapter().media_controller(&h.id).unwrap();
+        assert_eq!(controller.revision(), 0);
+        assert_eq!(controller.stream_open_budget(), (1, 16));
+        let binding = h.readiness.offers.lock().unwrap()[0].clone();
+        let media = h.adapter().physical_source(&h.id).unwrap().media().unwrap();
+        let before = media.snapshot().ingress_rejected;
+        send(&h.wire, audio(binding.stream_local_id, 0));
+        core_fixture::until(|| media.snapshot().ingress_rejected > before).await;
+        let store = h.media.base.0.clone();
+        let writer = tokio::spawn(async move { store.write_owned().await });
+        tokio::task::yield_now().await;
+        assert!(h.media.base.0.clone().try_read_owned().is_err());
+        h.media.phase.store(2, Ordering::Release);
+        h.readiness.release.notify_one();
+        let ack = h.wire.read().await;
+        assert_eq!(ack.kind(), "ack");
+        h.f.verify_server(&ack).await;
+        assert_eq!(ack.original()["payload"]["details"]["media_revision"], 1);
+        assert_eq!(h.media.fresh.load(Ordering::Acquire), 0);
+        drop(
+            tokio::time::timeout(Duration::from_secs(1), writer)
+                .await
+                .unwrap()
+                .unwrap(),
+        );
+        let mut input = controller
+            .take_ingress(&StreamId::from_string("audio"))
+            .unwrap();
+        send(&h.wire, audio(binding.stream_local_id, 0));
+        let frame = packet(&mut input).await;
+        frame
+            .try_forward_to(&controller, &StreamId::from_string("audio"))
+            .unwrap();
+        decoded(&received(&h.wire).await);
+        assert_eq!(controller.stream_open_budget(), (1, 16));
+        h.stop().await;
+    }
+}
