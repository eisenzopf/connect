+struct PhasePolicy {
+    base: Arc<Policy>,
+    phase: Arc<AtomicUsize>,
+    current_calls: AtomicUsize,
+    rechecks: Arc<AtomicUsize>,
+}
+fn phase_owner(mut owner: MediaOwner, phase: usize) -> ControlResult<MediaOwner> {
+    if owner.connection.connection().as_str() != "alice" {
+        return Ok(owner);
+    }
+    if phase >= 1 {
+        owner
+            .connection
+            .observe_ready(
+                &owner.member,
+                &owner.presence,
+                &owner.endpoint,
+                owner.connection.generation(),
+            )
+            .map_err(|_| StreamControlError::Authority)?;
+    }
+    if phase >= 2 {
+        owner
+            .connection
+            .activate(&owner.member, &owner.presence, &owner.endpoint)
+            .map_err(|_| StreamControlError::Authority)?;
+    }
+    if phase == 3 {
+        owner.endpoint.revoke();
+    }
+    Ok(owner)
+}
+struct PhaseCurrentLease {
+    owner: MediaOwner,
+    _guard: Box<dyn MediaAuthorityLease>,
+}
+impl MediaAuthorityLease for PhaseCurrentLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+struct PhaseControlLease {
+    owner: MediaOwner,
+    _guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    phase: Arc<AtomicUsize>,
+    rechecks: Arc<AtomicUsize>,
+    cancellation: CancellationToken,
+}
+impl MediaAuthorityLease for PhaseControlLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        self.rechecks.fetch_add(1, Ordering::AcqRel);
+        let phase = self.phase.load(Ordering::Acquire);
+        let owner = phase_owner(self.owner.clone(), phase)?;
+        if phase == 9 {
+            self.cancellation.cancel();
+        }
+        Ok(Box::new(owner))
+    }
+}
+impl MediaPolicy for PhasePolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.current_calls.fetch_add(1, Ordering::AcqRel);
+        let lease = self.base.current(scope)?;
+        Ok(Box::new(PhaseCurrentLease {
+            owner: phase_owner(
+                lease.authority().clone(),
+                self.phase.load(Ordering::Acquire),
+            )?,
+            _guard: lease,
+        }))
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        _: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let held = held
+            .downcast_ref::<HeldControlContext>()
+            .ok_or(StreamControlError::Authority)?;
+        if !Arc::ptr_eq(&self.base, &held.domain)
+            || held.connection != *scope.connection
+            || !held.principal.has_same_owner(scope.principal)
+            || held.guard.revoked.contains(&scope.principal.subject)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let owner = held
+            .guard
+            .owners
+            .get(scope.connection.as_str())
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        MediaControl::new(
+            Box::new(PhaseControlLease {
+                owner,
+                _guard: held.guard.clone(),
+                phase: self.phase.clone(),
+                rechecks: self.rechecks.clone(),
+                cancellation: held.cancellation.clone(),
+            }),
+            held.cancellation.clone(),
+            held.deadline,
+        )
+    }
+}
+impl PhasePolicy {
+    async fn new(f: &Fixture) -> Arc<Self> {
