+use rvoip_uctp::v2::native_dtmf_egress::*;
+impl NativeDtmfEgressPolicy for Installed {
+    fn authorize(
+        &self,
+        scope: &NativeDtmfEgressScope<'_>,
+        source: &NativeDtmfObservation,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let target = scope.recipient;
+        let guard = if let Some(held) = held {
+            let held = held
+                .downcast_ref::<AuthorityLease>()
+                .ok_or(DispatchError::Authority)?;
+            let current = held
+                .authority::<Current>()
+                .ok_or(DispatchError::Authority)?;
+            if !Arc::ptr_eq(&current.domain, &self.domain)
+                || !same_intent(&current.observation, source)
+                || !held.current()
+            {
+                return Err(DispatchError::Authority);
+            }
+            current.guard.clone()
+        } else {
+            Arc::new(
+                self.domain
+                    .0
+                    .clone()
+                    .try_read_owned()
+                    .map_err(|_| DispatchError::AuthorityUnavailable)?,
+            )
+        };
+        if guard.denied
+            || !guard
+                .dtmf_forward_allowed
+                .contains(&(source.connection().clone(), target.media.connection.clone()))
+        {
+            return Err(DispatchError::Authority);
+        }
+        let sender = guard
+            .owners
+            .get(source.connection())
+            .ok_or(DispatchError::Authority)?;
+        let receiver = guard
+            .owners
+            .get(&target.media.connection)
+            .ok_or(DispatchError::Authority)?;
+        sender
+            .member
+            .revalidate_principal(source.principal(), Utc::now())
+            .map_err(|_| DispatchError::Authority)?;
+        receiver
+            .member
+            .revalidate_principal(&target.principal, Utc::now())
+            .map_err(|_| DispatchError::Authority)?;
+        if !sender.may_control
+            || !receiver.may_control
+            || sender.member.conversation() != receiver.member.conversation()
+            || source.conversation() != receiver.member.conversation()
+            || source.session() != receiver.presence.session()
+            || source.identity() != sender.member.identity()
+            || source.participant() != sender.member.participant()
+            || source.membership_epoch() != sender.member.epoch()
+            || source.endpoint() != sender.endpoint.endpoint()
+            || source.device() != sender.endpoint.device()
+            || target.media.session != *receiver.presence.session()
+            || target.participant != *receiver.member.participant()
+            || target.membership_epoch != receiver.member.epoch()
+            || target.identity != *receiver.member.identity()
+            || target.device != *receiver.endpoint.device()
+            || target.endpoint != *receiver.endpoint.endpoint()
+            || sender.endpoint.state() != EndpointState::Verified
+            || receiver.endpoint.state() != EndpointState::Verified
+        {
+            return Err(DispatchError::Authority);
+        }
+        sender
+            .connection
+            .require_current(&sender.member, &sender.presence)
+            .map_err(|_| DispatchError::Authority)?;
+        receiver
+            .connection
+            .require_current(&receiver.member, &receiver.presence)
+            .map_err(|_| DispatchError::Authority)?;
+        if sender.connection.connection() != source.connection()
+            || receiver.connection.connection() != &target.media.connection
+            || source
+                .audio_bindings()
+                .iter()
+                .any(|b| b.connection_generation != sender.connection.generation())
+            || scope
+                .audio_bindings
+                .iter()
+                .any(|b| b.connection_generation != receiver.connection.generation())
+            || scope.audio_bindings.is_empty()
+            || target.media.owner != target.principal.ownership_key()
+            || guard.wires.get(&target.media.wire_connection) != Some(&target.media.connection)
+            || target.media.wire_session != "session"
+            || target.media.wire_conversation.as_deref() != Some("conversation")
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(guard))
+    }
+}
