+//! Attributed native control observations on real signed TLS connections.
+use super::*;
+fn request(digits: &str, duration_ms: u64, method: &str) -> Value {
+    let mut v = envelope(
+        "dtmf.send",
+        json!({"digits":digits,"duration_ms":duration_ms,"method":method,"source":"sip-info"}),
+    );
+    v["cid"] = json!("conversation");
+    v["sid"] = json!("session");
+    v["connid"] = json!("native_0");
+    v["operation_id"] = json!(format!("dtmf_{}", uuid::Uuid::new_v4().simple()));
+    v
+}
+#[tokio::test]
+async fn signed_native_dtmf_is_attributed_to_the_actual_negotiated_connection_and_not_payload_source(
+) {
+    for kind in ["quic", "wt"] {
+        let mut s = Scene::new(kind, false).await;
+        let (_, callback) = s.prepared(s.offer(0, false)).await;
+        s.confirm(&callback).await;
+        s.wait(1).await;
+        s.grants.0.write().await.dtmf_allowed.insert(s.id.clone());
+        let v = request("12#AB", 100, "rfc4733");
+        let started = Utc::now();
+        let op = v["operation_id"].clone();
+        s.wire.send(s.f.sign(v)).await;
+        let result = s.wire.read().await;
+        assert_eq!(
+            result.kind(),
+            "ack",
+            "negotiated signed DTMF should reach its explicit current-authorized observation sink"
+        );
+        s.f.verify_server(&result).await;
+        let observed = &result.original()["payload"]["details"]["local_dtmf_observation"];
+        assert_eq!(observed["connection"], json!(s.id.as_str()));
+        assert_eq!(observed["operation_id"], op);
+        assert_eq!(observed["source"], json!("uctp-native"));
+        assert_eq!(observed["digits"], json!("12#AB"));
+        assert_eq!(observed["duration_ms"], json!(100));
+        assert_eq!(
+            s.controller().revision(),
+            1,
+            "DTMF observation is not a graph mutation or Participant admission"
+        );
+        let seen = s
+            .record
+            .dtmf_seen
+            .lock()
+            .unwrap()
+            .values()
+            .next()
+            .unwrap()
+            .clone();
+        assert!(seen.received_at() >= started && seen.received_at() <= Utc::now());
+        assert!(!format!("{seen:?}").contains("12#AB"));
+        s.wire.server.shutdown().await.unwrap();
+    }
+}
