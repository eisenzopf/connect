+                        event,
+                        end,
+                        samples,
+                        p.header.timestamp,
+                        p.header.ssrc,
+                        p.header.payload_type,
+                        clock,
+                        p.header.marker,
+                    ))
+                })
+                .collect()
+        }
+    }
+    impl Drop for Capture {
+        fn drop(&mut self) {
+            self.task.abort();
+        }
+    }
