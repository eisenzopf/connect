+async fn signed_native_dtmf_egress_uses_the_recipients_own_physical_scope_and_original_operation() {
+    for kind in ["quic", "wt"] {
+        let mut s = Scene::new(kind, false).await;
+        s.record.dtmf_enable.store(true, Ordering::Release);
+        let (_, callback) = s.prepared(s.offer(0, false)).await;
+        s.confirm(&callback).await;
+        s.wait(1).await;
+        let mut target = target(&s).await;
+        {
+            let mut g = s.grants.0.write().await;
+            g.dtmf_allowed.insert(s.id.clone());
+            g.dtmf_forward_allowed
+                .insert((s.id.clone(), s.second_id.clone()));
+        }
+        *s.record.dtmf_target.lock().unwrap() = Some(s.second_id.clone());
+        let v = request("5#", 100, "info");
+        let operation = v["operation_id"].clone();
+        s.wire.send(s.f.sign(v)).await;
+        let received = tokio::time::timeout(Duration::from_secs(2), target.read())
+            .await
+            .expect("authorized DTMF must reach the negotiated recipient");
+        assert_eq!(received.kind(), "dtmf.received");
+        s.f.verify_server(&received).await;
+        assert_eq!(received.scope(Scope::Connection), Some("native_1"));
+        assert_eq!(received.scope(Scope::Session), Some("session"));
+        assert_eq!(received.original()["operation_id"], operation);
+        assert!(received.scope(Scope::Reply).is_none());
+        assert_eq!(received.original()["payload"]["digits"], json!("5#"));
+        assert_eq!(
+            received.original()["payload"]["source"],
+            json!("uctp-native")
+        );
+        let ack = s.wire.read().await;
+        assert_eq!(ack.kind(), "ack");
+        s.f.verify_server(&ack).await;
+        s.wire.server.shutdown().await.unwrap();
+        target.server.shutdown().await.unwrap();
+    }
+}
