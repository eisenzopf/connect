+    #[derive(Debug)]
+    struct PendingSocket(Arc<Probe>);
+    struct PendingIo(Arc<Probe>);
+    impl std::future::Future for PendingIo {
+        type Output = io::Result<usize>;
+        fn poll(
+            self: std::pin::Pin<&mut Self>,
+            _cx: &mut std::task::Context<'_>,
+        ) -> std::task::Poll<Self::Output> {
+            assert!(self.0.live.load(Ordering::Acquire));
+            self.0.polled.store(true, Ordering::Release);
+            self.0.waker.register(_cx.waker());
+            if self.0.ready.load(Ordering::Acquire) {
+                self.0.submitted.fetch_add(1, Ordering::AcqRel);
+                std::task::Poll::Ready(Ok(3))
+            } else {
+                std::task::Poll::Pending
+            }
+        }
+    }
+    impl Drop for PendingIo {
+        fn drop(&mut self) {
+            assert!(
+                self.0.live.load(Ordering::Acquire),
+                "socket IO outlived actual permission"
+            );
+            self.0.dropped.store(true, Ordering::Release);
+        }
+    }
+    impl AsyncUdpSocket for PendingSocket {
+        fn send_to<'a>(
+            &'a self,
+            _: &'a [u8],
+            _: SocketAddr,
+        ) -> std::pin::Pin<Box<dyn std::future::Future<Output = io::Result<usize>> + Send + 'a>>
+        {
+            Box::pin(PendingIo(self.0.clone()))
+        }
+        fn recv_from<'a>(
+            &'a self,
+            _: &'a mut [u8],
+        ) -> std::pin::Pin<
+            Box<dyn std::future::Future<Output = io::Result<(usize, SocketAddr)>> + Send + 'a>,
+        > {
+            Box::pin(std::future::pending())
+        }
+        fn local_addr(&self) -> io::Result<SocketAddr> {
+            Ok((Ipv4Addr::LOCALHOST, 1).into())
+        }
+    }
+    async fn pending_socket_case(cancel: bool, drop_caller: bool, ready_after_cancel: bool) {
+        let probe = Arc::new(Probe::default());
+        let lock = Arc::new(tokio::sync::RwLock::new(()));
+        let control = OwnedDtmfControl::new();
+        assert!(control.claim());
+        let task = tokio::spawn({
+            let probe = probe.clone();
+            let lock = lock.clone();
+            let control = control.clone();
+            async move {
+                let policy = Policy {
+                    probe: probe.clone(),
+                    lock,
+                };
+                let socket = PendingSocket(probe);
+                let packet = rtp::Packet::default();
+                let io = async {
+                    assert!(control.begin());
+                    socket
+                        .send_to(&[1, 2, 3], (Ipv4Addr::LOCALHOST, 2).into())
+                        .await
+                        .map_err(|_| rtc::shared::error::Error::ErrConnectionClosed)?;
+                    Ok(())
+                };
+                complete_owned_dtmf_write(&policy, &packet, 8000, &control, Box::pin(io)).await
+            }
+        });
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while !probe.polled.load(Ordering::Acquire) {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        assert!(
+            lock.try_write().is_err(),
+            "pending physical IO lost its current guard"
+        );
+        if drop_caller {
+            task.abort();
+            assert!(task.await.unwrap_err().is_cancelled());
+        } else {
+            if cancel {
+                assert!(control.cancel());
+                if ready_after_cancel {
+                    probe.ready.store(true, Ordering::Release);
+                    probe.waker.wake();
+                }
+            }
+            assert_eq!(task.await.unwrap(), Err(OwnedDtmfError::OutcomeUnknown));
+        }
+        assert!(probe.dropped.load(Ordering::Acquire));
+        assert!(!probe.live.load(Ordering::Acquire));
+        assert_eq!(probe.acquired.load(Ordering::Acquire), 1);
+        assert_eq!(
+            probe.submitted.load(Ordering::Acquire),
+            0,
+            "cancelled socket was polled to a physical effect"
+        );
+        assert!(lock.try_write().is_ok());
+    }
+    #[tokio::test]
+    async fn cancellation_wins_when_pending_socket_wakes_ready_in_same_turn() {
+        pending_socket_case(true, false, true).await;
+    }
+    #[tokio::test]
+    async fn driver_cancel_aborts_pending_socket_before_permission_release() {
+        pending_socket_case(true, false, false).await;
+    }
+    #[tokio::test]
+    async fn driver_deadline_aborts_pending_socket_before_permission_release() {
+        pending_socket_case(false, false, false).await;
+    }
+    #[tokio::test]
+    async fn driver_drop_aborts_pending_socket_before_permission_release() {
+        pending_socket_case(false, true, false).await;
+    }
+}
