+            .await
+            .is_err(),
+        "old interval escaped onto wire"
+    );
+    let fresh = quality(&mut s.wire).await;
+    s.f.verify_server(&fresh).await;
+    assert!(fresh.original()["payload"]["interval_ms"].as_u64().unwrap() >= 500);
+    s.wire.server.shutdown().await.unwrap();
