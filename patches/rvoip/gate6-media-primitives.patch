diff --git a/crates/media/rtp-core/src/telephone_event.rs b/crates/media/rtp-core/src/telephone_event.rs
new file mode 100644
--- /dev/null
+++ b/crates/media/rtp-core/src/telephone_event.rs
@@ -0,0 +1,654 @@
+//! Negotiated RFC 4733 telephone events and bounded physical-source decoding.
+/// Negotiated RFC4733 payload mapping for one physical audio route.
+///
+/// Dynamic payload types and clock rates are selected by SDP negotiation.
+/// Browsers are not required to use rvoip's preferred PT 101 / 8 kHz pair;
+/// Chromium, for example, commonly offers telephone-event at both 48 kHz and
+/// 8 kHz and may select the former. Receive-side classification must therefore
+/// use this negotiated mapping rather than a process-wide constant.
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq, serde::Serialize, serde::Deserialize)]
+pub struct TelephoneEventCodec {
+    pub payload_type: u8,
+    pub clock_rate_hz: u32,
+    /// Negotiated supported event codes 0..15.
+    pub events: u16,
+}
+
+impl TelephoneEventCodec {
+    pub const fn with_events(mut self, events: u16) -> Self {
+        self.events = events;
+        self
+    }
+    pub fn permits(&self, event: u8) -> bool {
+        event < 16 && self.events & (1u16 << event) != 0
+    }
+    pub fn valid(&self) -> bool {
+        self.payload_type >= 96
+            && self.payload_type <= 127
+            && matches!(self.clock_rate_hz, 8_000 | 16_000 | 48_000)
+            && self.events != 0
+    }
+
+    #[must_use]
+    pub const fn new(payload_type: u8, clock_rate_hz: u32) -> Self {
+        Self {
+            payload_type,
+            clock_rate_hz,
+            events: u16::MAX,
+        }
+    }
+}
+
+impl Default for TelephoneEventCodec {
+    fn default() -> Self {
+        Self::new(101, 8_000)
+    }
+}
+
+pub fn event_to_digit(event: u8) -> Option<char> {
+    match event {
+        0..=9 => Some(char::from(b'0' + event)),
+        10 => Some('*'),
+        11 => Some('#'),
+        12 => Some('A'),
+        13 => Some('B'),
+        14 => Some('C'),
+        15 => Some('D'),
+        _ => None,
+    }
+}
+
+/// Parsed RFC 4733 telephone-event payload.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TelephoneEventFrame {
+    pub event: u8,
+    pub digit: char,
+    pub end_of_event: bool,
+    pub volume: u8,
+    pub duration_samples: u16,
+    pub duration_ms: u32,
+}
+
+/// Decode the 4-byte RFC 4733 telephone-event payload.
+pub fn decode_telephone_event_payload(payload: &[u8]) -> Option<TelephoneEventFrame> {
+    decode_telephone_event_payload_at_clock_rate(payload, 8_000)
+}
+
+/// Decode an RFC 4733 payload using the clock rate negotiated for its dynamic
+/// payload type.
+pub fn decode_telephone_event_payload_at_clock_rate(
+    payload: &[u8],
+    clock_rate_hz: u32,
+) -> Option<TelephoneEventFrame> {
+    if payload.len() != 4 {
+        return None;
+    }
+    if clock_rate_hz == 0 {
+        return None;
+    }
+    let event = payload[0];
+    let digit = event_to_digit(event)?;
+    let end_of_event = payload[1] & 0b1000_0000 != 0;
+    let volume = payload[1] & 0b0011_1111;
+    let duration_samples = u16::from_be_bytes([payload[2], payload[3]]);
+    if duration_samples == 0 {
+        return None;
+    }
+    let duration_ms = ((u64::from(duration_samples) * 1_000
+        + u64::from(clock_rate_hz).saturating_sub(1))
+        / u64::from(clock_rate_hz))
+    .min(u64::from(u32::MAX)) as u32;
+    Some(TelephoneEventFrame {
+        event,
+        digit,
+        end_of_event,
+        volume,
+        duration_samples,
+        duration_ms,
+    })
+}
+
+// Bounded wire observations for one actual RTP pump. These facts contain no
+// authorization, durable receipt, or permission to replay a future effect.
+use std::collections::HashMap;
+
+/// Matches the retained engine's cumulative stream-opening bound. Never evict
+/// a source to make an old replay new again; a new track has a new decoder.
+pub const MAX_DTMF_RECEIVE_SOURCES: usize = 64;
+const MAX_PACKED_EVENTS: usize = 32;
+#[derive(Clone, PartialEq, Eq)]
+pub struct DecodedDtmfEvent {
+    pub digit: char,
+    pub duration_ms: u32,
+    pub duration_samples: u64,
+    pub ssrc: u32,
+    pub rtp_timestamp: u32,
+    /// Serially extended within this decoder's physical track lifetime.
+    pub extended_timestamp: u64,
+    pub last_segment_timestamp: u32,
+    pub event: u8,
+    pub payload_type: u8,
+    pub clock_rate_hz: u32,
+    /// False when the beginning was not observed. Known contiguous segments
+    /// are still reported honestly; an unknown prefix is never fabricated.
+    pub start_observed: bool,
+}
+impl std::fmt::Debug for DecodedDtmfEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DecodedDtmfEvent(redacted)")
+    }
+}
+#[derive(Clone, Default, Debug)]
+pub struct DtmfDecodeSnapshot {
+    pub sources_tracked: usize,
+    pub malformed_packets: u64,
+    pub unnegotiated_packets: u64,
+    pub source_capacity_drops: u64,
+    pub late_events: u64,
+    pub duplicate_events: u64,
+    pub conflicting_events: u64,
+    pub incomplete_events: u64,
+    pub overflow_events: u64,
+}
+#[derive(Clone)]
+struct Source {
+    timestamp: u32,
+    extended: u64,
+    event: u8,
+    payload_type: u8,
+    clock: u32,
+    origin: u32,
+    origin_extended: u64,
+    before: u64,
+    maximum: u16,
+    completed: bool,
+    start_observed: bool,
+}
+impl Source {
+    fn new(
+        timestamp: u32,
+        extended: u64,
+        frame: &TelephoneEventFrame,
+        pt: u8,
+        clock: u32,
+        start: bool,
+    ) -> Self {
+        Self {
+            timestamp,
+            extended,
+            event: frame.event,
+            payload_type: pt,
+            clock,
+            origin: timestamp,
+            origin_extended: extended,
+            before: 0,
+            maximum: 0,
+            completed: false,
+            start_observed: start,
+        }
+    }
+}
+pub struct DtmfDecoder {
+    clocks: HashMap<u8, TelephoneEventCodec>,
+    sources: HashMap<u32, Source>,
+    stats: DtmfDecodeSnapshot,
+}
+impl Default for DtmfDecoder {
+    fn default() -> Self {
+        Self::new([TelephoneEventCodec::default()])
+    }
+}
+impl DtmfDecoder {
+    pub fn new(codecs: impl IntoIterator<Item = TelephoneEventCodec>) -> Self {
+        let clocks = Self::codecs_map(codecs);
+        Self {
+            clocks,
+            sources: HashMap::new(),
+            stats: Default::default(),
+        }
+    }
+    fn codecs_map(
+        codecs: impl IntoIterator<Item = TelephoneEventCodec>,
+    ) -> HashMap<u8, TelephoneEventCodec> {
+        let mut clocks: HashMap<u8, TelephoneEventCodec> = HashMap::new();
+        for c in codecs {
+            if !c.valid() {
+                continue;
+            }
+            let entry = clocks.entry(c.payload_type).or_insert(c);
+            if *entry != c {
+                entry.clock_rate_hz = 0;
+            }
+        }
+        clocks
+    }
+    /// Negotiation changes do not discard the physical source's replay history.
+    pub fn replace_codecs(&mut self, codecs: impl IntoIterator<Item = TelephoneEventCodec>) {
+        self.clocks = Self::codecs_map(codecs);
+    }
+    pub fn accepts_payload_type(&self, pt: u8) -> bool {
+        self.clocks.get(&pt).is_some_and(|c| c.clock_rate_hz != 0)
+    }
+    pub fn snapshot(&self) -> DtmfDecodeSnapshot {
+        let mut s = self.stats.clone();
+        s.sources_tracked = self.sources.len();
+        s
+    }
+    /// Decode all contiguous events/segments in a bounded packet. Validate the
+    /// complete packet before changing replay state or returning any prefix.
+    pub fn decode_packet(
+        &mut self,
+        ssrc: u32,
+        timestamp: u32,
+        pt: u8,
+        marker: bool,
+        payload: &[u8],
+    ) -> Vec<DecodedDtmfEvent> {
+        let Some(codec) = self
+            .clocks
+            .get(&pt)
+            .copied()
+            .filter(|c| c.clock_rate_hz != 0)
+        else {
+            self.stats.unnegotiated_packets = self.stats.unnegotiated_packets.saturating_add(1);
+            return Vec::new();
+        };
+        let clock = codec.clock_rate_hz;
+        let frames = if payload.is_empty()
+            || payload.len() % 4 != 0
+            || payload.len() > 4 * MAX_PACKED_EVENTS
+        {
+            None
+        } else {
+            payload
+                .chunks_exact(4)
+                .map(|p| {
+                    decode_telephone_event_payload_at_clock_rate(p, clock)
+                        .filter(|f| codec.permits(f.event))
+                })
+                .collect::<Option<Vec<_>>>()
+        };
+        let Some(frames) = frames else {
+            self.stats.malformed_packets = self.stats.malformed_packets.saturating_add(1);
+            return Vec::new();
+        };
+        if frames.windows(2).any(|p| {
+            !p[0].end_of_event && (p[0].duration_samples != u16::MAX || p[0].event != p[1].event)
+        }) {
+            self.stats.malformed_packets = self.stats.malformed_packets.saturating_add(1);
+            return Vec::new();
+        }
+        if !self.sources.contains_key(&ssrc) && self.sources.len() >= MAX_DTMF_RECEIVE_SOURCES {
+            self.stats.source_capacity_drops = self.stats.source_capacity_drops.saturating_add(1);
+            return Vec::new();
+        }
+        let mut state = self.sources.get(&ssrc).cloned();
+        let mut timestamp = timestamp;
+        let mut output = Vec::new();
+        for (index, frame) in frames.iter().enumerate() {
+            let start =
+                (marker && frames.len() == 1) || (index > 0 && frames[index - 1].end_of_event);
+            if let Some(s) = state.as_mut() {
+                let delta = timestamp.wrapping_sub(s.timestamp);
+                if delta >= 0x8000_0000 {
+                    self.stats.late_events = self.stats.late_events.saturating_add(1);
+                    timestamp = timestamp.wrapping_add(u32::from(frame.duration_samples));
+                    continue;
+                }
+                if delta > 0 {
+                    let Some(extended) = s.extended.checked_add(u64::from(delta)) else {
+                        self.stats.overflow_events = self.stats.overflow_events.saturating_add(1);
+                        return Vec::new();
+                    };
+                    let continuation = !s.completed
+                        && s.maximum == u16::MAX
+                        && delta == u32::from(u16::MAX)
+                        && s.event == frame.event
+                        && s.clock == clock
+                        && s.payload_type == pt
+                        && !start;
+                    if continuation {
+                        let Some(before) = s.before.checked_add(u64::from(u16::MAX)) else {
+                            self.stats.overflow_events =
+                                self.stats.overflow_events.saturating_add(1);
+                            return Vec::new();
+                        };
+                        s.timestamp = timestamp;
+                        s.extended = extended;
+                        s.before = before;
+                        s.maximum = 0;
+                    } else {
+                        if !s.completed {
+                            self.stats.incomplete_events =
+                                self.stats.incomplete_events.saturating_add(1);
+                        }
+                        *s = Source::new(timestamp, extended, frame, pt, clock, start);
+                    }
+                } else if s.event != frame.event || s.clock != clock || s.payload_type != pt {
+                    self.stats.conflicting_events = self.stats.conflicting_events.saturating_add(1);
+                    timestamp = timestamp.wrapping_add(u32::from(frame.duration_samples));
+                    continue;
+                }
+            } else {
+                state = Some(Source::new(
+                    timestamp,
+                    u64::from(timestamp),
+                    frame,
+                    pt,
+                    clock,
+                    start,
+                ));
+            }
+            let s = state.as_mut().expect("source initialized");
+            if s.completed {
+                if frame.end_of_event && frame.duration_samples != s.maximum {
+                    self.stats.conflicting_events = self.stats.conflicting_events.saturating_add(1);
+                } else {
+                    self.stats.duplicate_events = self.stats.duplicate_events.saturating_add(1);
+                }
+            } else if frame.end_of_event && frame.duration_samples < s.maximum {
+                self.stats.conflicting_events = self.stats.conflicting_events.saturating_add(1);
+            } else {
+                s.maximum = s.maximum.max(frame.duration_samples);
+                s.start_observed |= start;
+                if frame.end_of_event {
+                    s.completed = true;
+                    let total = s.before.checked_add(u64::from(frame.duration_samples));
+                    let millis = total.and_then(|total| {
+                        u32::try_from(
+                            (u128::from(total) * 1000 + u128::from(clock) - 1) / u128::from(clock),
+                        )
+                        .ok()
+                    });
+                    if let (Some(duration_samples), Some(duration_ms)) = (total, millis) {
+                        output.push(DecodedDtmfEvent {
+                            digit: frame.digit,
+                            duration_ms,
+                            duration_samples,
+                            ssrc,
+                            rtp_timestamp: s.origin,
+                            extended_timestamp: s.origin_extended,
+                            last_segment_timestamp: s.timestamp,
+                            event: frame.event,
+                            payload_type: pt,
+                            clock_rate_hz: clock,
+                            start_observed: s.start_observed,
+                        });
+                    } else {
+                        self.stats.overflow_events = self.stats.overflow_events.saturating_add(1);
+                    }
+                }
+            }
+            timestamp = timestamp.wrapping_add(u32::from(frame.duration_samples));
+        }
+        if let Some(s) = state {
+            self.sources.insert(ssrc, s);
+        }
+        output
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn wire(event: u8, end: bool, duration: u16) -> [u8; 4] {
+        let d = duration.to_be_bytes();
+        [event, if end { 0x80 | 10 } else { 10 }, d[0], d[1]]
+    }
+    #[test]
+    fn sources_with_same_timestamp_are_distinct_and_history_is_fixed_size() {
+        let mut d = DtmfDecoder::default();
+        for ssrc in 0..MAX_DTMF_RECEIVE_SOURCES as u32 {
+            let e = d.decode_packet(ssrc, 100, 101, true, &wire(5, true, 800));
+            assert_eq!(e.len(), 1);
+            assert_eq!(e[0].ssrc, ssrc);
+        }
+        for ts in 101..10100 {
+            assert_eq!(
+                d.decode_packet(0, ts, 101, true, &wire(5, true, 800)).len(),
+                1
+            );
+        }
+        assert_eq!(d.snapshot().sources_tracked, MAX_DTMF_RECEIVE_SOURCES);
+        assert!(d
+            .decode_packet(999, 100, 101, true, &wire(5, true, 800))
+            .is_empty());
+        assert_eq!(d.snapshot().source_capacity_drops, 1);
+        assert!(d
+            .decode_packet(1, 100, 101, false, &wire(5, true, 800))
+            .is_empty());
+    }
+    #[test]
+    fn timestamp_wrap_extends_identity_and_old_or_conflicting_events_do_not_replay() {
+        let mut d = DtmfDecoder::default();
+        let first = d
+            .decode_packet(1, u32::MAX - 100, 101, true, &wire(1, true, 800))
+            .pop()
+            .unwrap();
+        let next = d
+            .decode_packet(1, 700, 101, true, &wire(1, true, 800))
+            .pop()
+            .unwrap();
+        assert!(next.extended_timestamp > first.extended_timestamp);
+        assert_eq!(next.extended_timestamp, u64::from(u32::MAX) + 701);
+        assert!(d
+            .decode_packet(1, u32::MAX - 100, 101, false, &wire(1, true, 800))
+            .is_empty());
+        assert!(d
+            .decode_packet(1, 700, 101, false, &wire(2, true, 800))
+            .is_empty());
+        assert_eq!(d.snapshot().late_events, 1);
+        assert_eq!(d.snapshot().conflicting_events, 1);
+    }
+    #[test]
+    fn segmented_48khz_event_has_one_original_identity_and_exact_total_duration() {
+        let mut d = DtmfDecoder::new([TelephoneEventCodec::new(110, 48000)]);
+        assert!(d
+            .decode_packet(7, 1000, 110, true, &wire(6, false, 960))
+            .is_empty());
+        assert!(d
+            .decode_packet(7, 1000, 110, false, &wire(6, false, u16::MAX))
+            .is_empty());
+        let e = d
+            .decode_packet(7, 1000 + 65535, 110, false, &wire(6, true, 30465))
+            .pop()
+            .unwrap();
+        assert_eq!(e.duration_samples, 96000);
+        assert_eq!(e.duration_ms, 2000);
+        assert_eq!(e.rtp_timestamp, 1000);
+        assert!(e.start_observed);
+        assert!(d
+            .decode_packet(7, 1000 + 65535, 110, false, &wire(6, true, 30465))
+            .is_empty());
+        assert!(!format!("{e:?}").contains("2000"));
+    }
+    #[test]
+    fn packed_events_are_all_decoded_and_invalid_suffix_does_not_consume_replay_state() {
+        let mut d = DtmfDecoder::default();
+        let a = wire(1, true, 800);
+        let b = wire(2, true, 400);
+        let mut invalid = a.to_vec();
+        invalid.extend_from_slice(&[255, 0x80, 0, 1]);
+        assert!(d.decode_packet(3, 1000, 101, true, &invalid).is_empty());
+        assert_eq!(d.snapshot().sources_tracked, 0);
+        let mut valid = a.to_vec();
+        valid.extend_from_slice(&b);
+        let events = d.decode_packet(3, 1000, 101, true, &valid);
+        assert_eq!(events.len(), 2);
+        assert_eq!(events[0].rtp_timestamp, 1000);
+        assert_eq!(events[1].rtp_timestamp, 1800);
+        assert_eq!(events[1].duration_ms, 50);
+        assert!(d.decode_packet(3, 1000, 101, true, &valid).is_empty());
+        // An old packed prefix does not hide a new suffix.
+        valid.extend_from_slice(&wire(3, true, 400));
+        assert_eq!(d.decode_packet(3, 1000, 101, true, &valid)[0].digit, '3');
+    }
+    #[test]
+    fn malformed_zero_unnegotiated_and_conflicting_mapping_are_explicitly_refused() {
+        let mut d = DtmfDecoder::default();
+        for p in [
+            vec![],
+            vec![1, 0x80, 0],
+            wire(1, true, 0).to_vec(),
+            vec![1; 132],
+        ] {
+            assert!(d.decode_packet(1, 1, 101, true, &p).is_empty());
+        }
+        assert_eq!(d.snapshot().malformed_packets, 4);
+        assert_eq!(d.snapshot().sources_tracked, 0);
+        assert!(d
+            .decode_packet(1, 1, 110, true, &wire(1, true, 800))
+            .is_empty());
+        let mut ambiguous = DtmfDecoder::new([
+            TelephoneEventCodec::new(101, 8000),
+            TelephoneEventCodec::new(101, 48000),
+        ]);
+        assert!(!ambiguous.accepts_payload_type(101));
+        assert!(ambiguous
+            .decode_packet(1, 1, 101, true, &wire(1, true, 800))
+            .is_empty());
+        let mut reserved = wire(1, true, 800);
+        reserved[1] |= 0x40;
+        assert_eq!(
+            d.decode_packet(1, 1, 101, true, &reserved).len(),
+            1,
+            "RFC4733 R bit must be ignored by receivers"
+        );
+    }
+}
+
+/// RFC4733 events parameter: no whitespace, bounded code/range list. Only
+/// installed DTMF codes 0..15 are selected; malformed suffixes reject all.
+pub fn parse_dtmf_events(value: &str) -> Option<u16> {
+    if value.is_empty() || value.len() > 1024 || value.bytes().any(|b| b.is_ascii_whitespace()) {
+        return None;
+    }
+    let mut mask = 0u16;
+    let mut count = 0;
+    for part in value.split(',') {
+        count += 1;
+        if count > 64 {
+            return None;
+        }
+        let number = |s: &str| -> Option<u8> {
+            if s.is_empty() || s.len() > 3 || !s.bytes().all(|b| b.is_ascii_digit()) {
+                None
+            } else {
+                s.parse().ok()
+            }
+        };
+        let (lo, hi) = match part.split_once('-') {
+            Some((a, b)) => (number(a)?, number(b)?),
+            None => {
+                let n = number(part)?;
+                (n, n)
+            }
+        };
+        if lo > hi {
+            return None;
+        }
+        for event in lo..=hi.min(15) {
+            mask |= 1u16 << event;
+        }
+    }
+    Some(mask)
+}
+pub fn render_dtmf_events(mask: u16) -> String {
+    let mut parts = Vec::new();
+    let mut i = 0;
+    while i < 16 {
+        if mask & (1 << i) == 0 {
+            i += 1;
+            continue;
+        }
+        let start = i;
+        while i + 1 < 16 && mask & (1 << (i + 1)) != 0 {
+            i += 1;
+        }
+        parts.push(if start == i {
+            start.to_string()
+        } else {
+            format!("{start}-{i}")
+        });
+        i += 1;
+    }
+    parts.join(",")
+}
+
+/// Bounded RFC4733 segmentation. Only the final segment ends the event;
+/// every segment has the actual cumulative sample duration and timestamp.
+#[derive(Default)]
+pub struct DtmfSegmentCursor {
+    base: u32,
+    maximum_sent: bool,
+}
+impl DtmfSegmentCursor {
+    pub fn advance(&mut self, samples: u32, end: bool) -> Vec<(u32, u16, bool)> {
+        let mut packets = Vec::new();
+        let maximum = u32::from(u16::MAX);
+        while samples - self.base > maximum {
+            if !self.maximum_sent {
+                packets.push((self.base, u16::MAX, false));
+            }
+            self.base += maximum;
+            self.maximum_sent = false;
+        }
+        let duration = (samples - self.base) as u16;
+        if end {
+            for _ in 0..3 {
+                packets.push((self.base, duration, true));
+            }
+        } else if !self.maximum_sent {
+            packets.push((self.base, duration, false));
+            self.maximum_sent = duration == u16::MAX;
+        }
+        packets
+    }
+}
+
+#[cfg(test)]
+mod negotiated_profile_tests {
+    use super::*;
+    #[test]
+    fn event_list_is_bounded_and_never_accepts_a_malformed_suffix() {
+        for invalid in [
+            "", "0-15,", "0-15;16", "0 -15", "16-0", "0-256", "+1", "1-2-3", "0000",
+        ] {
+            assert_eq!(parse_dtmf_events(invalid), None, "{invalid}");
+        }
+        assert_eq!(
+            parse_dtmf_events("0-9,11,12-15"),
+            Some(u16::MAX & !(1 << 10))
+        );
+        assert_eq!(parse_dtmf_events("16-255"), Some(0));
+        for mask in [1, 0x3ff, 0xa0a0, u16::MAX] {
+            assert_eq!(parse_dtmf_events(&render_dtmf_events(mask)), Some(mask));
+        }
+    }
+    #[test]
+    fn unsupported_packed_suffix_cannot_publish_or_consume_valid_prefix() {
+        let mut d = DtmfDecoder::new([TelephoneEventCodec::new(110, 48000).with_events(0x3ff)]);
+        let mut payload = vec![5, 0x8a, 0x16, 0xb0];
+        payload.extend_from_slice(&[10, 0x8a, 1, 0]);
+        assert!(d.decode_packet(7, 42, 110, true, &payload).is_empty());
+        assert_eq!(d.snapshot().sources_tracked, 0);
+        payload.truncate(4);
+        assert_eq!(
+            d.decode_packet(7, 42, 110, true, &payload)[0].duration_ms,
+            121
+        );
+    }
+    #[test]
+    fn renegotiation_removal_and_readdition_preserve_physical_replay_history() {
+        let codec = TelephoneEventCodec::new(126, 8000);
+        let mut d = DtmfDecoder::new([codec]);
+        let payload = [5, 0x8a, 3, 0x20];
+        assert_eq!(d.decode_packet(7, 1000, 126, true, &payload).len(), 1);
+        d.replace_codecs([]);
+        assert!(!d.accepts_payload_type(126));
+        assert!(d.decode_packet(7, 1000, 126, true, &payload).is_empty());
+        d.replace_codecs([codec]);
+        assert!(d.decode_packet(7, 1000, 126, true, &payload).is_empty());
+        assert_eq!(d.decode_packet(7, 2000, 126, true, &payload).len(), 1);
+    }
+}
