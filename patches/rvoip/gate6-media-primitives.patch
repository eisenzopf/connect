+async fn delivery_pair() -> (Scene, Wire, Arc<NativeDtmfRegistration>) {
+    let mut s = Scene::new("quic", false).await;
+    s.record.dtmf_enable.store(true, Ordering::Release);
+    let (_, callback) = s.prepared(s.offer(0, false)).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let target = target(&s).await;
