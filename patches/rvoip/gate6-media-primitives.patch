+//! Metadata-only queued DTMF writes. The authority callback runs at actual IO.
+use futures::future::BoxFuture;
+use rtc::{rtp, shared::error::Result};
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, AtomicU8, Ordering},
+    },
+    time::{Duration, Instant},
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum OwnedDtmfError {
+    Unsupported,
+    NotReady,
+    Refused,
+    DeadlineBeforeWrite,
+    OutcomeUnknown,
+}
+pub type OwnedDtmfResult = std::result::Result<(), OwnedDtmfError>;
+/// Trusted policy composition must own permission through this IO future and
+/// drop IO before releasing its guard. No detached work and no idle reader.
+#[async_trait::async_trait]
+pub trait OwnedDtmfAuthority: Send + Sync {
+    async fn write<'a>(
+        &'a self,
+        packet: &'a rtp::Packet,
+        clock_rate_hz: u32,
+        io: BoxFuture<'a, Result<()>>,
+    ) -> OwnedDtmfResult;
+}
+pub const OWNED_DTMF_WRITE_LIMIT: Duration = Duration::from_millis(200);
+const PENDING: u8 = 0;
+const STARTED: u8 = 1;
+const CANCELLED: u8 = 2;
+struct State {
+    live: AtomicBool,
+    phase: AtomicU8,
+    claimed: AtomicBool,
+    deadline: Instant,
+    cancelled: tokio::sync::Notify,
+}
+/// One-use cancellation and actual submission phase. Only the driver can start
+/// IO; cancelling a pending ticket wins atomically against that transition.
+#[derive(Clone)]
+pub struct OwnedDtmfControl(Arc<State>);
+impl Default for OwnedDtmfControl {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+impl OwnedDtmfControl {
+    pub fn new() -> Self {
+        Self(Arc::new(State {
+            live: AtomicBool::new(true),
+            phase: AtomicU8::new(PENDING),
+            claimed: AtomicBool::new(false),
+            deadline: Instant::now() + OWNED_DTMF_WRITE_LIMIT,
+            cancelled: tokio::sync::Notify::new(),
+        }))
+    }
+    pub fn deadline(&self) -> Instant {
+        self.0.deadline
+    }
+    pub fn cancel(&self) -> bool {
+        self.0.live.store(false, Ordering::Release);
+        let uncertain = match self.0.phase.compare_exchange(
+            PENDING,
+            CANCELLED,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        ) {
+            Ok(_) => false,
+            Err(v) => v == STARTED,
+        };
+        self.0.cancelled.notify_waiters();
+        uncertain
+    }
+    async fn cancelled(&self) {
+        // Register before checking current state so cancellation cannot fall
+        // between the check and waiter installation. A queued request also
+        // observes cancellation that happened before this future existed.
+        loop {
+            let notified = self.0.cancelled.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            if !self.0.live.load(Ordering::Acquire) {
+                return;
+            }
+            notified.await;
+        }
+    }
+    pub(crate) fn claim(&self) -> bool {
+        self.0
+            .claimed
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+            && self.0.phase.load(Ordering::Acquire) == PENDING
+    }
+    pub(crate) fn begin(&self) -> bool {
+        if !self.current(self.deadline()) {
+            return false;
+        }
+        self.0
+            .phase
+            .compare_exchange(PENDING, STARTED, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+    }
+    pub(crate) fn started(&self) -> bool {
+        self.0.phase.load(Ordering::Acquire) == STARTED
+    }
+    pub(crate) fn current(&self, deadline: Instant) -> bool {
+        self.0.live.load(Ordering::Acquire)
+            && self.0.phase.load(Ordering::Acquire) != CANCELLED
+            && Instant::now() < deadline
+    }
+}
+impl std::fmt::Debug for OwnedDtmfControl {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("OwnedDtmfControl(redacted)")
+    }
+}
+pub(crate) struct OwnedDtmfRequest {
+    pub packet: rtp::Packet,
+    pub authority: Arc<dyn OwnedDtmfAuthority>,
+    pub deadline: Instant,
+    pub control: OwnedDtmfControl,
+    pub completion: tokio::sync::oneshot::Sender<OwnedDtmfResult>,
+}
+impl std::fmt::Debug for OwnedDtmfRequest {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("OwnedDtmfRequest(redacted)")
+    }
+}
+pub(crate) struct Caller(pub OwnedDtmfControl);
+impl Drop for Caller {
+    fn drop(&mut self) {
+        self.0.cancel();
+    }
+}
+pub(crate) fn stopped(control: &OwnedDtmfControl) -> OwnedDtmfError {
+    // Cancellation must win admission before a definitive non-write result.
+    if control.cancel() {
+        OwnedDtmfError::OutcomeUnknown
+    } else {
+        OwnedDtmfError::DeadlineBeforeWrite
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn cancellation_wins_before_submission_and_ticket_is_one_use() {
+        let c = OwnedDtmfControl::new();
+        assert!(c.claim());
+        assert!(!c.claim());
+        assert!(!c.cancel());
+        assert!(!c.begin());
+        assert!(!c.cancel());
+        assert!(!c.current(c.deadline()));
+        assert_eq!(stopped(&c), OwnedDtmfError::DeadlineBeforeWrite);
+    }
+    #[test]
+    fn started_submission_never_becomes_definite_non_write_on_cancel() {
+        let c = OwnedDtmfControl::new();
+        assert!(c.claim());
+        assert!(c.begin());
+        assert!(c.cancel());
+        assert!(c.cancel());
+        assert!(!c.begin());
+        assert_eq!(stopped(&c), OwnedDtmfError::OutcomeUnknown);
+    }
+    #[test]
+    fn concurrent_cancel_and_submit_have_one_monotonic_winner() {
+        for _ in 0..100 {
+            let c = OwnedDtmfControl::new();
+            assert!(c.claim());
+            let start = c.clone();
+            let t = std::thread::spawn(move || start.begin());
+            let uncertain = c.cancel();
+            let started = t.join().unwrap();
+            assert_eq!(uncertain, started);
+            assert_eq!(c.started(), started);
+            assert!(!c.current(c.deadline()));
+        }
+    }
+}
+
+/// Same custody boundary for the driver and controlled pending-socket tests.
+/// The callback future owns IO; discard it before returning any cancellation.
+pub(crate) async fn complete_owned_dtmf_write(
+    authority: &dyn OwnedDtmfAuthority,
+    packet: &rtp::Packet,
+    clock: u32,
+    control: &OwnedDtmfControl,
+    io: BoxFuture<'_, Result<()>>,
+) -> OwnedDtmfResult {
+    let deadline = control.deadline();
+    let mut flight = Box::pin(authority.write(packet, clock, io));
+    let result = loop {
+        tokio::select! {biased;
+            _=tokio::time::sleep_until(tokio::time::Instant::from_std(deadline))=>break Err(stopped(control)),
+            _=control.cancelled()=>break Err(stopped(control)),
+            r=&mut flight=>break r,
+        }
+    };
+    drop(flight);
+    result
+}
+
+#[cfg(test)]
+mod socket_custody_tests {
+    use super::*;
+    use crate::runtime::AsyncUdpSocket;
+    use std::{
+        io,
+        net::{Ipv4Addr, SocketAddr},
+        sync::atomic::AtomicUsize,
+    };
+    #[derive(Debug, Default)]
+    struct Probe {
+        live: AtomicBool,
+        polled: AtomicBool,
+        dropped: AtomicBool,
+        acquired: AtomicUsize,
+        ready: AtomicBool,
+        submitted: AtomicUsize,
+        waker: futures::task::AtomicWaker,
+    }
+    struct Guard {
+        probe: Arc<Probe>,
+        _lock: tokio::sync::OwnedRwLockReadGuard<()>,
+    }
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            assert!(
+                self.probe.dropped.load(Ordering::Acquire),
+                "permission released before socket future was aborted"
+            );
+            self.probe.live.store(false, Ordering::Release);
+        }
+    }
+    struct Policy {
+        probe: Arc<Probe>,
+        lock: Arc<tokio::sync::RwLock<()>>,
+    }
+    #[async_trait::async_trait]
+    impl OwnedDtmfAuthority for Policy {
+        async fn write<'a>(
+            &'a self,
+            _: &'a rtp::Packet,
+            _: u32,
+            io: BoxFuture<'a, Result<()>>,
+        ) -> OwnedDtmfResult {
+            let lock = self.lock.clone().read_owned().await;
+            self.probe.live.store(true, Ordering::Release);
+            self.probe.acquired.fetch_add(1, Ordering::AcqRel);
+            let guard = Guard {
+                probe: self.probe.clone(),
+                _lock: lock,
+            };
+            let mut io = Box::pin(io);
+            let result = (&mut io).await.map_err(|_| OwnedDtmfError::OutcomeUnknown);
