+use rvoip_uctp::v2::native_quality::NativeQualityConfigPolicy;
+struct Config {
+    domain: Arc<Grants>,
+    enabled: bool,
+}
+impl NativeQualityConfigPolicy for Config {
+    fn authorize(
+        &self,
+        s: &NativeLifecycleScope,
+        a: &AuthorizedEnvelope,
+        interval: u64,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let proof = a.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if !self.enabled || !Arc::ptr_eq(&proof.domain, &self.domain) || proof.guard.denied {
+            return Err(DispatchError::Authority);
+        }
+        let owner = credential_owner(
+            proof
+                .guard
+                .owners
+                .get(&s.media.connection)
+                .ok_or(DispatchError::Authority)?
+                .clone(),
+            a.principal(),
+        )
+        .map_err(|_| DispatchError::Authority)?;
+        owner
+            .actor
+            .revalidate_principal(&s.principal, Utc::now())
+            .map_err(|_| DispatchError::Authority)?;
+        owner
+            .connection
+            .require_current(&owner.member, &owner.presence)
+            .map_err(|_| DispatchError::Authority)?;
+        if !owner.may_control
+            || s.participant != *owner.member.participant()
+            || s.membership_epoch != owner.member.epoch()
+            || s.identity != *owner.member.identity()
+            || s.endpoint != *owner.endpoint.endpoint()
+            || s.device != *owner.endpoint.device()
+            || owner.endpoint.state() != EndpointState::Verified
+            || owner.endpoint.identity() != owner.member.identity()
+            || s.media.wire_conversation.as_deref() != a.envelope().scope(Scope::Conversation)
+            || Some(s.media.wire_session.as_str()) != a.envelope().scope(Scope::Session)
+            || Some(s.media.wire_connection.as_str()) != a.envelope().scope(Scope::Connection)
+            || proof.guard.wires.get(&s.media.wire_connection) != Some(&s.media.connection)
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                a.principal(),
+                &s.principal,
+            )
+            || !matches!(a.envelope().payload(),Payload::ConnectionUpdate(u) if u.quality_interval_ms == Some(interval))
+        {
+            return Err(DispatchError::Authority);
+        }
+        Ok(AuthorityLease::holding(proof.guard.clone()))
+    }
+}
+pub(super) async fn configure(
+    h: &OfferHandler,
+    a: Arc<AuthorizedEnvelope>,
+    id: &ConnectionId,
+) -> Result<HandlerReplies, DispatchError> {
+    let adapter = &h.native.adapters[&h.physical.transport()];
+    let config = Config {
+        domain: h.grants.clone(),
+        enabled: h.record.quality_enabled.load(Ordering::Acquire),
+    };
+    struct Missing;
+    impl NativeQualityConfigPolicy for Missing {}
+    let policy: &dyn NativeQualityConfigPolicy =
+        if h.record.quality_default_config.load(Ordering::Acquire) {
+            &Missing
+        } else {
+            &config
+        };
+    let interval = adapter
+        .configure_native_quality(id, &a, policy)
+        .map_err(|_| DispatchError::Authority)?;
+    let mut ack = envelope(
+        "ack",
+        json!({"details":{"local_quality_configuration":{"interval_ms":interval}}}),
+    );
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        ack[field] = a.envelope().original()[field].clone();
+    }
+    ack["in_reply_to"] = json!(a.envelope().id());
+    HandlerReplies::new(vec![Envelope::from_value(ack)?])
+}
+fn tune(interval: u64) -> Value {
+    let mut update = gate_command("quality", 1, None, None);
+    update["payload"]["quality_interval_ms"] = json!(interval);
+    update
+}
