+    let mut s = Scene::new(kind, false).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    s.record.quality_enabled.store(true, Ordering::Release);
+    let (answer, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let handle = answer.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+        .as_u64()
+        .unwrap() as u16;
+    let mut input = s
+        .controller()
+        .take_ingress(&StreamId::from_string("first"))
+        .unwrap();
+    send(&s.wire, audio_sequence(handle, 1));
+    let _received = packet(&mut input).await;
+    ready_opened(&s.f, &mut s.wire, handle).await;
+    (s, handle, input)
