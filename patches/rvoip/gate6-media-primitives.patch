+//! Native quality configuration does not change media bindings or borrow media
+//! authority. Every configured observation still needs current delivery policy.
+use super::{auth_dispatch::*, native_lifecycle::NativeLifecycleScope};
+/// Derive an explicit configuration grant from the actual request's held
+/// domain, including exact current identity/member/endpoint and wire scope.
+/// Do not reenter engine/controller locks or reacquire that domain's reader.
+pub trait NativeQualityConfigPolicy: Send + Sync {
+    fn authorize(
+        &self,
+        _scope: &NativeLifecycleScope,
+        _request: &AuthorizedEnvelope,
+        _interval_ms: u64,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+}
