+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { test } from "node:test";
+import { decodeRtpDatagram } from "../fixtures/uctp_wt_acceptance.mjs";
+const vectors = JSON.parse(fs.readFileSync(new URL("../../../crates/uctp/rvoip-uctp/tests/fixtures/cross_runtime_media.json", import.meta.url)));
+for (const v of vectors.valid) test(v.name, () => {
+  const bytes = Uint8Array.from(Buffer.from(v.hex, "hex"));
+  // Real WebTransport read chunks may be views into a larger allocation.
+  const offsetBytes = new Uint8Array(bytes.length + 13);
+  offsetBytes.set(bytes, 7);
+  for (const wire of [bytes, offsetBytes.subarray(7, 7 + bytes.length)]) {
+    const p = decodeRtpDatagram(wire);
+    assert.ok(p);
+    for (const [field, expected] of Object.entries({flags:v.flags,streamLocalId:v.stream_local_id,sequence:v.datagram_seq,payloadType:v.payload_type,marker:v.marker,sequenceNumber:v.sequence_number,timestamp:v.timestamp,ssrc:v.ssrc,csrc:v.csrc,extensionProfile:v.extension_profile,paddingSize:v.padding_size})) assert.deepEqual(p[field],expected,field);
+    assert.equal(Buffer.from(p.payload).toString("hex"), v.payload_hex);
+  }
+});
+for (const v of vectors.invalid) test(v.name, () => assert.equal(decodeRtpDatagram(Uint8Array.from(Buffer.from(v.hex, "hex"))),null));
