+async fn native_dtmf_egress_cancellation_or_deadline_before_writer_releases_reader_and_keeps_output_usable(
+) {
+    for mode in ["drop", "deadline"] {
+        let (mut s, mut target, registration) = delivery_pair().await;
+        let o = observation(&mut s).await;
+        let installed = Installed {
+            domain: s.grants.clone(),
+            record: s.record.clone(),
+        };
+        s.record.dtmf_pause_delivery.store(true, Ordering::Release);
+        let submission = registration
+            .prepare_delivery(
+                &o,
+                &installed,
+                None,
+                if mode == "deadline" {
+                    Instant::now() + Duration::from_millis(80)
+                } else {
+                    deadline()
+                },
+                CancellationToken::new(),
+            )
+            .unwrap();
+        tokio::time::timeout(
+            Duration::from_secs(1),
+            s.record.dtmf_delivery_entered.notified(),
+        )
+        .await
+        .unwrap();
+        assert!(
+            s.grants.0.try_write().is_err(),
+            "queued write owns the actual current guard"
+        );
+        if mode == "drop" {
+            drop(submission);
+        } else {
+            assert_eq!(submission.written().await, Err(DispatchError::Closed));
+        }
+        tokio::time::timeout(Duration::from_secs(1), async {
+            loop {
+                if s.grants.0.try_write().is_ok() {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        s.record.dtmf_pause_delivery.store(false, Ordering::Release);
+        s.record.dtmf_delivery_release.notify_one();
+        no_signal(&mut target).await;
+        let fresh = observation(&mut s).await;
+        let next = registration
+            .prepare_delivery(
+                &fresh,
+                &installed,
+                None,
+                deadline(),
+                CancellationToken::new(),
+            )
+            .unwrap();
+        let frame = target.read().await;
+        assert_eq!(frame.kind(), "dtmf.received");
+        s.f.verify_server(&frame).await;
+        assert_eq!(next.written().await.unwrap().as_str(), frame.id());
+        s.wire.server.shutdown().await.unwrap();
+        target.server.shutdown().await.unwrap();
+    }
