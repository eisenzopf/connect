+use interceptor::{Interceptor, StreamInfo, TaggedPacket};
+use sansio::Protocol;
+use shared::error::Error;
+use std::time::Instant;
+pub(super) struct OwnedDtmfProfile<I>(I);
+pub(super) fn wrap<I: Interceptor>(inner: I) -> OwnedDtmfProfile<I> {
+    OwnedDtmfProfile(inner)
+}
+impl<I: Interceptor> Protocol<TaggedPacket, TaggedPacket, ()> for OwnedDtmfProfile<I> {
+    type Rout = TaggedPacket;
+    type Wout = TaggedPacket;
+    type Eout = ();
+    type Error = Error;
+    type Time = Instant;
+    fn handle_read(&mut self, p: TaggedPacket) -> Result<(), Error> {
+        self.0.handle_read(p)
+    }
+    fn poll_read(&mut self) -> Option<TaggedPacket> {
+        self.0.poll_read()
+    }
+    fn handle_write(&mut self, p: TaggedPacket) -> Result<(), Error> {
+        self.0.handle_write(p)
+    }
+    fn poll_write(&mut self) -> Option<TaggedPacket> {
+        self.0.poll_write()
+    }
+    fn handle_event(&mut self, e: ()) -> Result<(), Error> {
+        self.0.handle_event(e)
+    }
+    fn poll_event(&mut self) -> Option<()> {
+        self.0.poll_event()
+    }
+    fn handle_timeout(&mut self, t: Instant) -> Result<(), Error> {
+        self.0.handle_timeout(t)
+    }
+    fn poll_timeout(&mut self) -> Option<Instant> {
+        self.0.poll_timeout()
+    }
+    fn close(&mut self) -> Result<(), Error> {
+        self.0.close()
+    }
+}
