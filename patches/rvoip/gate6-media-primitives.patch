+use rvoip_uctp::v2::native_dtmf::*;
+struct Current {
+    domain: Arc<Grants>,
+    guard: Arc<OwnedRwLockReadGuard<State>>,
+    observation: NativeDtmfObservation,
+}
+struct Installed {
+    domain: Arc<Grants>,
+    record: Arc<Record>,
+}
+fn same_intent(a: &NativeDtmfObservation, b: &NativeDtmfObservation) -> bool {
+    a.connection() == b.connection()
+        && a.conversation() == b.conversation()
+        && a.session() == b.session()
+        && a.participant() == b.participant()
+        && a.identity() == b.identity()
+        && a.endpoint() == b.endpoint()
+        && a.device() == b.device()
+        && a.membership_epoch() == b.membership_epoch()
+        && a.operation_id() == b.operation_id()
+        && a.digits() == b.digits()
+        && a.duration_ms() == b.duration_ms()
+        && a.method() == b.method()
+        && a.stream_revision() == b.stream_revision()
+        && a.credential_revision() == b.credential_revision()
+        && rvoip_core::staged_streams::reliable_data::same_credential(a.principal(), b.principal())
+}
+impl NativeDtmfPolicy for Installed {
+    fn authorize(
+        &self,
+        o: &NativeDtmfObservation,
+        a: &AuthorizedEnvelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        let p = a.authority::<Proof>().ok_or(DispatchError::Authority)?;
+        if !Arc::ptr_eq(&p.domain, &self.domain)
+            || !p.guard.dtmf_allowed.contains(o.connection())
+            || p.guard.denied
+        {
+            return Err(DispatchError::Authority);
+        }
+        let wire = p
+            .base
+            .authority::<WireProof>()
+            .ok_or(DispatchError::Authority)?;
+        if a.envelope()
+            .scope(Scope::Connection)
+            .and_then(|id| wire._guard.connections.get(id))
+            != Some(o.connection())
+            || a.envelope().scope(Scope::Operation) != Some(o.operation_id())
+            || !rvoip_core::staged_streams::reliable_data::same_credential(
+                o.principal(),
+                a.principal(),
+            )
+        {
+            return Err(DispatchError::Authority);
+        }
+        let owner = p
+            .guard
+            .owners
+            .get(o.connection())
+            .ok_or(DispatchError::Authority)?;
+        owner
+            .member
+            .revalidate_principal(o.principal(), Utc::now())
+            .map_err(|_| DispatchError::Authority)?;
+        if owner.endpoint.state() != EndpointState::Verified
+            || owner.endpoint.identity() != owner.member.identity()
+        {
+            return Err(DispatchError::Authority);
+        }
+        owner
+            .connection
+            .require_current(&owner.member, &owner.presence)
+            .map_err(|_| DispatchError::Authority)?;
+        if owner.connection.connection() != o.connection()
+            || o.audio_bindings()
+                .iter()
+                .any(|b| b.connection_generation != owner.connection.generation())
+        {
+            return Err(DispatchError::Authority);
+        }
+        if !owner.may_control
+            || owner.member.epoch() != o.membership_epoch()
+            || owner.member.identity() != o.identity()
+            || owner.member.participant() != o.participant()
+            || owner.endpoint.endpoint() != o.endpoint()
+            || owner.endpoint.device() != o.device()
+            || owner.member.conversation() != o.conversation()
+            || owner.presence.session() != o.session()
+        {
+            return Err(DispatchError::Authority);
+        }
+        let current = Current {
+            domain: self.domain.clone(),
+            guard: p.guard.clone(),
+            observation: o.clone(),
+        };
+        Ok(if self.record.dtmf_expired.load(Ordering::Acquire) {
+            AuthorityLease::checking(current, Instant::now() - Duration::from_millis(1), || true)
+        } else {
+            AuthorityLease::holding(current)
+        })
+    }
+}
+impl NativeDtmfSink for Installed {
+    fn observe(
+        &self,
+        o: &NativeDtmfObservation,
+        current: &AuthorityLease,
+    ) -> Result<(), DispatchError> {
+        let p = current
+            .authority::<Current>()
+            .ok_or(DispatchError::Authority)?;
+        if !self.record.dtmf_sink.load(Ordering::Acquire) {
+            return Err(DispatchError::Unsupported);
+        }
+        if !current.current()
+            || !Arc::ptr_eq(&p.domain, &self.domain)
+            || !p.guard.dtmf_allowed.contains(o.connection())
+            || !same_intent(o, &p.observation)
+        {
+            return Err(DispatchError::Authority);
+        }
+        let key = format!("{}/{}", o.connection(), o.operation_id());
+        let mut seen = self.record.dtmf_seen.lock().unwrap();
+        if let Some(old) = seen.get(&key) {
+            if !same_intent(old, o) {
+                return Err(DispatchError::Authority);
+            }
+        } else {
+            let target = self.record.dtmf_target.lock().unwrap().clone();
+            if let Some(target) = target {
+                let registration = self
+                    .record
+                    .dtmf_registrations
+                    .lock()
+                    .unwrap()
+                    .get(&target)
+                    .cloned()
+                    .ok_or(DispatchError::Closed)?;
+                let pending = registration.prepare_delivery(
+                    o,
+                    self,
+                    Some(current),
+                    deadline(),
+                    CancellationToken::new(),
+                )?;
+                self.record
+                    .dtmf_pending
+                    .lock()
+                    .unwrap()
+                    .insert(key.clone(), pending);
+            }
+            seen.insert(key, o.clone());
+            self.record.dtmf_count.fetch_add(1, Ordering::AcqRel);
+        }
+        Ok(())
+    }
+}
+pub(super) struct Writer(tokio::task::JoinHandle<()>);
+impl Drop for Writer {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+pub(super) async fn handle(
+    handler: &OfferHandler,
+    a: Arc<AuthorizedEnvelope>,
+    id: &ConnectionId,
+) -> Result<HandlerReplies, DispatchError> {
+    if handler
+        .record
+        .dtmf_queue_writer
+        .swap(false, Ordering::AcqRel)
+    {
+        let grants = handler.grants.clone();
+        let record = handler.record.clone();
+        let id = id.clone();
+        let job = tokio::spawn(async move {
+            grants.0.write().await.dtmf_allowed.remove(&id);
+            record.dtmf_writer_done.store(true, Ordering::Release);
+        });
+        *handler.record.dtmf_writer.lock().unwrap() = Some(Writer(job));
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert!(!handler.record.dtmf_writer_done.load(Ordering::Acquire));
+    }
+    let installed = Installed {
+        domain: handler.grants.clone(),
+        record: handler.record.clone(),
+    };
+    let policy = handler.record.dtmf_hook.load(Ordering::Acquire);
+    struct Absent;
+    impl NativeDtmfPolicy for Absent {}
+    let o = handler.native.adapters[&handler.physical.transport()]
+        .receive_native_dtmf(
+            id,
+            &a,
+            if policy { &installed } else { &Absent },
+            &installed,
+        )
+        .map_err(|_| DispatchError::Authority)?;
+    let key = format!("{}/{}", o.connection(), o.operation_id());
+    let pending = handler.record.dtmf_pending.lock().unwrap().remove(&key);
+    if let Some(pending) = pending {
+        let _local_submission = pending.written().await?;
+    }
+    let mut reply = envelope(
+        "ack",
+        json!({"details":{"local_dtmf_observation":{"connection":o.connection().as_str(),"operation_id":o.operation_id(),"source":o.source(),"digits":o.digits(),"duration_ms":o.duration_ms()}}}),
+    );
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        reply[field] = a.envelope().original()[field].clone();
+    }
+    reply["in_reply_to"] = json!(a.envelope().id());
+    HandlerReplies::new(vec![Envelope::from_value(reply)?])
+}
