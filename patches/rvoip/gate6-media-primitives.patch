+//! Authenticated native DTMF ingress. This records a bounded current-authorized
+//! observation; it does not dial, synthesize tones, route to another audience,
+//! claim durable operation acceptance or lend permission to a later callback.
+use super::{
+    auth_dispatch::{AuthorityLease, AuthorizedEnvelope, DispatchError},
+    native_negotiation::NativeOfferError,
+    payloads::Payload,
+    Scope,
+};
+use crate::staged_media::StagedRtpScope;
+use chrono::{DateTime, Utc};
+use rvoip_core::{
+    connection::Transport,
+    identity::AuthenticatedPrincipal,
+    ids::*,
+    relationships::{EndpointBinding, Membership},
+    stream_lifecycle::ReadyMediaBinding,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeDtmfMethod {
+    Rfc4733,
+    Info,
+}
+/// Metadata sealed from the actual current signed physical route. Its getters
+/// carry no grant; delayed use requires the host's current policy/journal.
+#[derive(Clone)]
+pub struct NativeDtmfObservation {
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    participant: ParticipantId,
+    identity: IdentityId,
+    endpoint: EndpointId,
+    device: DeviceId,
+    membership_epoch: u64,
+    principal: AuthenticatedPrincipal,
+    transport: Transport,
+    operation_id: String,
+    digits: String,
+    duration_ms: u32,
+    method: NativeDtmfMethod,
+    received_at: DateTime<Utc>,
+    stream_revision: u64,
+    credential_revision: u64,
+    audio: Vec<ReadyMediaBinding>,
+    origin: Option<std::sync::Arc<SourceOrigin>>,
+}
+impl std::fmt::Debug for NativeDtmfObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeDtmfObservation(redacted)")
+    }
+}
+struct SourceOrigin {
+    current: Box<dyn Fn() -> bool + Send + Sync>,
+    cancel: tokio_util::sync::CancellationToken,
+}
+impl NativeDtmfObservation {
+    pub(crate) fn bind_origin(
+        &mut self,
+        current: impl Fn() -> bool + Send + Sync + 'static,
+        cancel: tokio_util::sync::CancellationToken,
+    ) {
+        self.origin = Some(std::sync::Arc::new(SourceOrigin {
+            current: Box::new(current),
+            cancel,
+        }));
+    }
+    pub(crate) fn current_source(&self) -> bool {
+        self.origin
+            .as_ref()
+            .is_some_and(|o| !o.cancel.is_cancelled() && (o.current)())
+    }
+
+    pub fn conversation(&self) -> &ConversationId {
+        &self.conversation
+    }
+    pub fn session(&self) -> &SessionId {
+        &self.session
+    }
+    pub fn connection(&self) -> &ConnectionId {
+        &self.connection
+    }
+    pub fn participant(&self) -> &ParticipantId {
+        &self.participant
+    }
+    pub fn identity(&self) -> &IdentityId {
+        &self.identity
+    }
+    pub fn endpoint(&self) -> &EndpointId {
+        &self.endpoint
+    }
+    pub fn device(&self) -> &DeviceId {
+        &self.device
+    }
+    pub fn membership_epoch(&self) -> u64 {
+        self.membership_epoch
+    }
+    pub fn principal(&self) -> &AuthenticatedPrincipal {
+        &self.principal
+    }
+    pub fn transport(&self) -> Transport {
+        self.transport
+    }
+    pub fn operation_id(&self) -> &str {
+        &self.operation_id
+    }
+    pub fn digits(&self) -> &str {
+        &self.digits
+    }
+    pub fn duration_ms(&self) -> u32 {
+        self.duration_ms
+    }
+    pub fn method(&self) -> NativeDtmfMethod {
+        self.method
+    }
+    /// Derived from this actual native ingress, never payload.source.
+    pub fn source(&self) -> &'static str {
+        "uctp-native"
+    }
+    pub fn received_at(&self) -> DateTime<Utc> {
+        self.received_at
+    }
+    pub fn stream_revision(&self) -> u64 {
+        self.stream_revision
+    }
+    pub fn credential_revision(&self) -> u64 {
+        self.credential_revision
+    }
+    pub fn audio_bindings(&self) -> &[ReadyMediaBinding] {
+        &self.audio
+    }
+    pub(crate) fn capture(
+        a: &AuthorizedEnvelope,
+        scope: &StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+        revision: u64,
+        credential: u64,
+        audio: Vec<ReadyMediaBinding>,
+    ) -> Result<Self, NativeOfferError> {
+        let e = a.envelope();
+        let Payload::DtmfSend(p) = e.payload() else {
+            return Err(NativeOfferError::Unsupported);
+        };
+        if !a.supports_native_negotiation()
+            || e.scope(Scope::Reply).is_some()
+            || scope.wire_conversation.is_none()
+            || e.scope(Scope::Conversation) != scope.wire_conversation.as_deref()
+            || e.scope(Scope::Session) != Some(scope.wire_session.as_str())
+            || e.scope(Scope::Connection) != Some(scope.wire_connection.as_str())
+            || e.expected_revision().is_some_and(|v| v != revision)
+        {
+            return Err(NativeOfferError::Scope);
+        }
+        let operation = e.scope(Scope::Operation).ok_or(NativeOfferError::Invalid)?;
+        let method = match p.method.as_str() {
+            "rfc4733" => NativeDtmfMethod::Rfc4733,
+            "info" => NativeDtmfMethod::Info,
+            _ => return Err(NativeOfferError::Unsupported),
+        };
+        let duration = u32::try_from(p.duration_ms).map_err(|_| NativeOfferError::Invalid)?;
+        use rvoip_media_core::relay::controller::dtmf_transmitter::{
+            validate_dtmf_sequence, DEFAULT_DTMF_INTER_DIGIT_MS,
+        };
+        validate_dtmf_sequence(&p.digits, duration, DEFAULT_DTMF_INTER_DIGIT_MS)
+            .map_err(|_| NativeOfferError::Invalid)?;
+        if audio.is_empty() {
+            return Err(NativeOfferError::NotReady);
+        }
+        Ok(Self {
+            conversation: member.conversation().clone(),
+            session: scope.session.clone(),
+            connection: scope.connection.clone(),
+            participant: member.participant().clone(),
+            identity: member.identity().clone(),
+            endpoint: endpoint.endpoint().clone(),
+            device: endpoint.device().clone(),
+            membership_epoch: member.epoch(),
+            principal: a.principal().clone(),
+            transport: endpoint.transport(),
+            operation_id: operation.into(),
+            digits: p.digits.clone(),
+            duration_ms: duration,
+            method,
+            received_at: Utc::now(),
+            stream_revision: revision,
+            credential_revision: credential,
+            audio,
+            origin: None,
+        })
+    }
+}
+/// Explicit signal permission, independent of codec/routing permission. Derive
+/// it from the same actual invocation's held domain; do not reacquire a reader
+/// behind a queued writer, retain the invocation in idle state, or reenter Core.
+pub trait NativeDtmfPolicy: Send + Sync {
+    fn authorize(
+        &self,
+        _observation: &NativeDtmfObservation,
+        _request: &AuthorizedEnvelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+}
+/// One bounded synchronous local observation decision under the current grant.
+/// A host may record/journal or enqueue metadata here; no detached effects or
+/// engine reentry. A later effect must acquire its own current authority. The
+/// host reconciles/deduplicates the original operation ID; Core never redials.
+pub trait NativeDtmfSink: Send + Sync {
+    fn observe(
+        &self,
+        _observation: &NativeDtmfObservation,
+        _current: &AuthorityLease,
+    ) -> Result<(), DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+}
