+                .is_err()
+        );
+        let domain = Arc::new(tokio::sync::RwLock::new(true));
+        let policy = Policy {
+            domain: domain.clone(),
+            acquisitions: AtomicUsize::new(0),
+            packets: std::sync::Mutex::new(Vec::new()),
+        };
+        assert!(transmitter
+            .send_sequence_authorized("1x", 400, 70, &policy)
+            .await
+            .is_err());
+        assert_eq!(policy.acquisitions.load(Ordering::Acquire), 0);
+        assert!(
+            tokio::time::timeout(Duration::from_millis(30), receive(&receiver))
+                .await
+                .is_err()
+        );
