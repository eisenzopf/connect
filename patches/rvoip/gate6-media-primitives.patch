+            (
+                p.payload[0],
+                p.payload[1] & 0x80 != 0,
+                u16::from_be_bytes([p.payload[2], p.payload[3]]),
+                p.header.timestamp,
+                p.header.ssrc,
+                p.header.payload_type,
+                p.header.marker,
+            )
