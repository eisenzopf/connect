+#[test]
+fn cross_runtime_media_vectors_match_checked_rust_and_browser_boundaries() {
+    let vectors: serde_json::Value =
+        serde_json::from_str(include_str!("fixtures/cross_runtime_media.json")).unwrap();
+    fn unhex(value: &serde_json::Value) -> Vec<u8> {
+        let s = value.as_str().unwrap();
+        s.as_bytes()
+            .chunks_exact(2)
+            .map(|b| u8::from_str_radix(std::str::from_utf8(b).unwrap(), 16).unwrap())
+            .collect()
+    }
+    for v in vectors["valid"].as_array().unwrap() {
+        let bytes = unhex(&v["hex"]);
+        let observed = rvoip_uctp::substrate::observe_rtp_datagram(&bytes)
+            .unwrap_or_else(|_| panic!("{}", v["name"]));
+        let rtp = observed.rtp.packet();
+        assert_eq!(observed.flags as u64, v["flags"].as_u64().unwrap());
+        assert_eq!(
+            observed.stream_local_id as u64,
+            v["stream_local_id"].as_u64().unwrap()
+        );
+        assert_eq!(observed.seq as u64, v["datagram_seq"].as_u64().unwrap());
+        assert_eq!(
+            rtp.header.payload_type as u64,
+            v["payload_type"].as_u64().unwrap()
+        );
+        assert_eq!(rtp.header.marker, v["marker"].as_bool().unwrap());
+        assert_eq!(
+            rtp.header.sequence_number as u64,
+            v["sequence_number"].as_u64().unwrap()
+        );
+        assert_eq!(
+            rtp.header.timestamp as u64,
+            v["timestamp"].as_u64().unwrap()
+        );
+        assert_eq!(rtp.header.ssrc as u64, v["ssrc"].as_u64().unwrap());
+        assert_eq!(
+            rtp.header.csrc,
+            v["csrc"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|x| x.as_u64().unwrap() as u32)
+                .collect::<Vec<_>>()
+        );
+        assert_eq!(
+            rtp.header.extensions.as_ref().map(|e| e.profile_id as u64),
+            v["extension_profile"].as_u64()
+        );
+        assert_eq!(rtp.padding_size as u64, v["padding_size"].as_u64().unwrap());
+        assert_eq!(rtp.payload.as_ref(), unhex(&v["payload_hex"]));
+        assert_eq!(
+            rvoip_uctp::substrate::pack_observed_rtp_datagram(&observed)
+                .unwrap()
+                .as_ref(),
+            bytes
+        );
+        assert_eq!(
+            unpack_rtp_datagram(&bytes).unwrap().rtp.payload.as_ref(),
+            unhex(&v["payload_hex"])
+        );
+    }
+    for v in vectors["invalid"].as_array().unwrap() {
+        let bytes = unhex(&v["hex"]);
+        assert!(
+            rvoip_uctp::substrate::observe_rtp_datagram(&bytes).is_err(),
+            "{}",
+            v["name"]
+        );
+        assert!(unpack_rtp_datagram(&bytes).is_err(), "{}", v["name"]);
+    }
+}
