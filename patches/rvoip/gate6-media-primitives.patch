+                    RtpSessionEvent::DtmfReceived(_) => {
+                        panic!("transport guessed a telephone event")
+                    }
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .unwrap();
+        session
+            .set_telephone_event_codecs(&[TelephoneEventCodec::new(110, 48000)])
+            .unwrap();
+        send(2, 110, 2000, true, vec![5, 0x8a, 3, 0x20, 255, 0x8a, 0, 1]).await;
+        tokio::time::sleep(Duration::from_millis(20)).await;
+        assert_eq!(session.telephone_event_snapshot().sources_tracked, 0);
+        send(3, 110, 2000, true, vec![6, 10, 3, 0xc0]).await;
+        send(4, 110, 2000, false, vec![6, 10, 255, 255]).await;
+        let tail = 30465u16.to_be_bytes();
+        for seq in 5..8 {
+            send(
+                seq,
+                110,
+                2000 + 65535,
+                false,
+                vec![6, 0x8a, tail[0], tail[1]],
+            )
+            .await;
+        }
+        let fact = tokio::time::timeout(Duration::from_secs(1), async {
+            loop {
+                if let RtpSessionEvent::DtmfReceived(fact) = events.recv().await.unwrap() {
+                    return fact;
+                }
+            }
+        })
+        .await
+        .unwrap();
+        assert_eq!(
+            fact.ssrc, 77,
+            "local SSRC must not become remote attribution"
+        );
+        assert_eq!(fact.payload_type, 110);
+        assert_eq!(fact.clock_rate_hz, 48000);
+        assert_eq!(fact.duration_ms, 2000);
+        assert_eq!(fact.duration_samples, 96000);
+        assert!(fact.start_observed);
+        assert_eq!(fact.rtp_timestamp, 2000);
+        assert!(
+            tokio::time::timeout(Duration::from_millis(60), async {
+                loop {
+                    if matches!(
+                        events.recv().await.unwrap(),
+                        RtpSessionEvent::DtmfReceived(_)
+                    ) {
+                        break;
+                    }
+                }
+            })
+            .await
+            .is_err(),
+            "end repeats became new digits"
+        );
+        session.close().await.unwrap();
+    }
+}
