+// Checked UCTP/RTP boundary shared by the browser fixture and Node vectors.
+// The physical peer owns handle attribution; parsed bytes never grant authority.
+export function decodeRtpDatagram(datagram) {
+  if (!(datagram instanceof Uint8Array) || datagram.byteLength < 20) return null;
+  const view = new DataView(datagram.buffer, datagram.byteOffset, datagram.byteLength);
+  const streamLocalId = view.getUint16(2, false);
+  if (datagram[0] !== 1 || streamLocalId === 0 || (datagram[8] >> 6) !== 2) return null;
+  let offset = 20 + (datagram[8] & 15) * 4;
+  if (offset > datagram.byteLength) return null;
+  const csrc = [];
+  for (let i = 20; i < offset; i += 4) csrc.push(view.getUint32(i, false));
+  let extensionProfile = null;
+  let extensionData = new Uint8Array();
+  if (datagram[8] & 16) {
+    if (offset + 4 > datagram.byteLength) return null;
+    extensionProfile = view.getUint16(offset, false);
+    const size = view.getUint16(offset + 2, false) * 4;
+    offset += 4;
+    if (offset + size > datagram.byteLength) return null;
+    extensionData = datagram.subarray(offset, offset + size);
+    // Validate element bounds for the negotiated RFC 8285 layouts. Unknown
+    // extension profiles remain opaque blocks, as in the native RTP parser.
+    if (extensionProfile === 0xbede) {
+      for (let i = 0; i < size;) {
+        const h = extensionData[i++], id = h >> 4;
+        if (id === 15 || (id === 0 && (h & 15) !== 0)) break;
+        if (id === 0) continue;
+        i += (h & 15) + 1;
+        if (i > size) return null;
+      }
+    } else if ((extensionProfile & 0xfff0) === 0x1000) {
+      for (let i = 0; i < size;) {
+        if (extensionData[i++] === 0) continue;
+        if (i >= size) return null;
+        i += 1 + extensionData[i];
+        if (i > size) return null;
+      }
+    }
+    offset += size;
+  }
+  let end = datagram.byteLength, paddingSize = 0;
+  if (datagram[8] & 32) {
+    if (end <= offset) return null;
+    paddingSize = datagram[end - 1];
+    if (paddingSize === 0 || paddingSize > end - offset) return null;
+    end -= paddingSize;
+  }
+  return {
+    flags: datagram[1], streamLocalId, sequence: view.getUint32(4, false),
+    payloadType: datagram[9] & 127, marker: Boolean(datagram[9] & 128),
+    sequenceNumber: view.getUint16(10, false), timestamp: view.getUint32(12, false),
+    ssrc: view.getUint32(16, false), csrc, extensionProfile, extensionData,
+    paddingSize, payload: datagram.subarray(offset, end),
+  };
