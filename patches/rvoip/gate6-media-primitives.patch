+    #[derive(Clone, Debug, PartialEq, Eq)]
+    struct Fact(u8, bool, u16, u32, u32, u8, u32, bool);
+    struct Policy {
+        allowed: Arc<RwLock<bool>>,
+        calls: AtomicUsize,
+        facts: parking_lot::Mutex<Vec<Fact>>,
+    }
+    impl Policy {
+        fn new(allowed: bool) -> Arc<Self> {
+            Arc::new(Self {
+                allowed: Arc::new(RwLock::new(allowed)),
+                calls: AtomicUsize::new(0),
+                facts: parking_lot::Mutex::new(Vec::new()),
+            })
+        }
+    }
+    #[async_trait::async_trait]
+    impl DtmfWriteAuthority for Policy {
+        async fn acquire(
+            &self,
+            scope: &DtmfWriteScope<'_>,
+        ) -> std::result::Result<DtmfWriteLease, DtmfWriteError> {
+            self.calls.fetch_add(1, Ordering::AcqRel);
+            let guard = self.allowed.clone().read_owned().await;
+            if !*guard {
+                return Err(DtmfWriteError::Refused);
+            }
+            self.facts.lock().push(Fact(
+                scope.event,
+                scope.end_of_event,
+                scope.duration_samples,
+                scope.timestamp,
+                scope.ssrc,
+                scope.payload_type,
+                scope.clock_rate_hz,
+                scope.marker,
+            ));
+            Ok(DtmfWriteLease::new(
+                guard,
+                tokio::time::Instant::now() + Duration::from_millis(200),
+                || true,
+            ))
+        }
+    }
+    struct Capture {
+        packets: Arc<parking_lot::Mutex<Vec<rtc::rtp::Packet>>>,
+        task: tokio::task::JoinHandle<()>,
+    }
+    impl Capture {
+        fn start(peer: Arc<RvoipPeerConnection>) -> Self {
+            let packets = Arc::new(parking_lot::Mutex::new(Vec::new()));
+            let output = packets.clone();
+            let task = tokio::spawn(async move {
+                let mut pollers = tokio::task::JoinSet::new();
+                loop {
+                    while let Some(track) = peer.try_recv_remote_track().await {
+                        let output = output.clone();
+                        pollers.spawn(async move {
+                            while let Some(event) = track.poll().await {
+                                if let TrackRemoteEvent::OnRtpPacket(packet) = event {
+                                    output.lock().push(packet);
+                                }
+                            }
+                        });
+                    }
+                    tokio::time::sleep(Duration::from_millis(2)).await;
+                }
+            });
+            Self { packets, task }
+        }
+        async fn wait_for(&self, count: usize) {
+            tokio::time::timeout(Duration::from_secs(3), async {
+                while self.packets.lock().len() < count {
+                    tokio::time::sleep(Duration::from_millis(2)).await;
+                }
+            })
+            .await
+            .expect("actual remote RTP");
+        }
+        fn facts(&self, clock: u32) -> Vec<Fact> {
+            self.packets
