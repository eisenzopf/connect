+    let media = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let media_port = media.local_addr().unwrap().port();
+    let (target_tx, target_rx) = oneshot::channel();
+    let (response_tx, mut response_rx) = mpsc::unbounded_channel();
+    let uas = socket.clone();
+    let responder = tokio::spawn(async move {
+        let mut buffer = vec![0u8; 65536];
+        let mut target = Some(target_tx);
+        loop {
+            let (length, peer) = uas.recv_from(&mut buffer).await.unwrap();
+            let request = match parse_message(&buffer[..length]).unwrap() {
+                Message::Request(request) => request,
+                Message::Response(response) => {
+                    let _ = response_tx.send(response.status().as_u16());
+                    continue;
+                }
+            };
+            let mut response = create_response(&request, StatusCode::Ok);
+            if request.method() == Method::Invite {
+                let sdp = std::str::from_utf8(&request.body).unwrap();
+                let port = sdp
+                    .lines()
+                    .find_map(|line| line.strip_prefix("m=audio "))
