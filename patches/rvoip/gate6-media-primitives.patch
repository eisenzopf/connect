+#[cfg(test)]
+mod dtmf_transaction_tests {
+    use super::*;
+    use rvoip_media_core::dtmf_authority::*;
+    #[tokio::test]
+    async fn pending_sip_transaction_refuses_tone_without_waiting_or_retaining_idle_host_permission(
+    ) {
+        let controller = Arc::new(MediaSessionController::new());
+        let store = Arc::new(SessionStore::new());
+        let id = SessionId("dtmf-sip-transaction-lane".into());
+        store
+            .create_session(id.clone(), crate::state_table::types::Role::UAC, false)
+            .await
+            .unwrap();
+        let adapter = MediaAdapter::new(
+            controller.clone(),
+            store.clone(),
+            "127.0.0.1".parse().unwrap(),
+            23000,
+            23100,
+        );
+        adapter.start_session(&id).await.unwrap();
+        let exact = adapter.current_media(&id).unwrap();
+        let socket = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let mut config = controller
+            .get_session_info(&exact.dialog_id)
+            .await
+            .unwrap()
+            .config;
+        config.remote_addr = Some(socket.local_addr().unwrap());
+        config = config.with_telephone_event_codecs(&[TelephoneEventCodec::new(110, 8000)]);
+        controller
+            .update_media(exact.dialog_id.clone(), config)
+            .await
+            .unwrap();
+        struct Policy(Arc<tokio::sync::RwLock<()>>);
+        #[async_trait::async_trait]
+        impl DtmfWriteAuthority for Policy {
+            async fn acquire(
+                &self,
+                _: &DtmfWriteScope<'_>,
+            ) -> std::result::Result<DtmfWriteLease, DtmfWriteError> {
+                Ok(DtmfWriteLease::new(
+                    self.0.clone().read_owned().await,
+                    tokio::time::Instant::now() + Duration::from_millis(200),
+                    || true,
+                ))
+            }
+        }
+        let host = Arc::new(tokio::sync::RwLock::new(()));
+        let policy = Arc::new(Policy(host.clone()));
+        let lane = store.state_machine_lane_exact(&exact.handle).unwrap();
+        let transaction = lane.clone().lock_owned().await;
+        let result = tokio::time::timeout(
+            Duration::from_millis(100),
+            adapter.send_dtmf_sequence_rfc4733_authorized(&id, "5", 121, 70, policy.clone()),
+        )
+        .await
+        .expect("signal waited on a transaction while holding host authority");
+        assert!(matches!(
+            result,
+            Err(rvoip_media_core::Error::DtmfWrite(DtmfWriteError::NotReady))
+        ));
+        assert!(
+            host.try_write().is_ok(),
+            "busy transaction retained an idle permission reader"
+        );
+        let mut bytes = [0u8; 2048];
+        assert!(
+            tokio::time::timeout(Duration::from_millis(60), socket.recv_from(&mut bytes))
+                .await
+                .is_err()
+        );
+        drop(transaction);
+        adapter
+            .send_dtmf_sequence_rfc4733_authorized(&id, "5", 121, 70, policy)
+            .await
+            .unwrap();
+        let mut ends = 0;
+        while ends < 3 {
+            let (n, _) = tokio::time::timeout(Duration::from_secs(1), socket.recv_from(&mut bytes))
+                .await
+                .unwrap()
+                .unwrap();
+            let packet = rvoip_rtp_core::packet::RtpPacket::parse(&bytes[..n]).unwrap();
+            assert_eq!(packet.header.payload_type, 110);
+            if packet.payload[1] & 128 != 0 {
+                assert_eq!(
+                    u16::from_be_bytes([packet.payload[2], packet.payload[3]]),
+                    968
+                );
+                ends += 1;
+            }
+        }
+        assert!(host.try_write().is_ok());
+        assert!(lane.try_lock().is_ok());
+        store.remove_session_exact(&exact.handle).await.unwrap();
+    }
+}
