+            a,
+            c,
+            media.clone(),
+            member,
+            endpoint,
+            Arc::new(TargetFence {
+                controller: Arc::downgrade(c),
+                flow: Arc::downgrade(&flow),
+            }),
+        )?;
+        let (sender, receiver) = mpsc::channel(16);
+        Ok(Arc::new(Self {
+            origin,
+            controller: Arc::downgrade(c),
+            flow: Arc::downgrade(&flow),
+            scope: NativeLifecycleScope {
+                principal: a.principal().clone(),
+                media,
+                participant: member.participant().clone(),
+                membership_epoch: member.epoch(),
+                device: endpoint.device().clone(),
+                endpoint: endpoint.endpoint().clone(),
+                identity: member.identity().clone(),
+            },
+            sender,
+            receiver: tokio::sync::Mutex::new(receiver),
+        }))
+    }
+    pub fn scope(&self) -> &NativeLifecycleScope {
+        &self.scope
+    }
+    pub fn current(&self) -> bool {
+        self.origin.current()
+    }
+    pub fn prepare_delivery(
+        &self,
+        source: &NativeDtmfObservation,
+        policy: &dyn NativeDtmfEgressPolicy,
+        held: Option<&(dyn std::any::Any + Send + Sync)>,
+        requested: Instant,
+        caller: CancellationToken,
+    ) -> Result<NativeDtmfSubmission, DispatchError> {
+        if caller.is_cancelled()
+            || !self.origin.ready()
+            || !self.origin.current()
+            || !source.current_source()
+        {
+            return Err(DispatchError::Closed);
+        }
+        let reservation = self
+            .sender
+            .clone()
+            .try_reserve_owned()
+            .map_err(|e| match e {
+                mpsc::error::TrySendError::Full(_) => DispatchError::Capacity,
+                mpsc::error::TrySendError::Closed(_) => DispatchError::Closed,
+            })?;
+        let c = self.controller.upgrade().ok_or(DispatchError::Closed)?;
+        let flow = self.flow.upgrade().ok_or(DispatchError::Closed)?;
+        let revision = c.revision();
+        let audio = c
+            .active_bindings()
+            .into_iter()
+            .filter(|b| b.negotiated.requested.medium == Medium::Audio)
+            .collect::<Vec<_>>();
+        let fence = Arc::new(DeliveryFence {
+            controller: Arc::downgrade(&c),
+            flow: Arc::downgrade(&flow),
+            revision,
+            audio,
+            source: source.clone(),
+            epoch: flow.epoch(),
+        });
+        let origin = self.origin.with_fence(fence.clone());
+        if !origin.current() {
+            return Err(DispatchError::Closed);
+        }
+        let scope = NativeDtmfEgressScope {
+            recipient: &self.scope,
+            audio_bindings: &fence.audio,
+            stream_revision: revision,
+            credential_revision: c.credential_revision(),
+        };
+        let authority = policy.authorize(&scope, source, held)?;
+        let deadline = requested.min(Instant::now() + Duration::from_secs(1));
+        if deadline <= Instant::now()
+            || !origin.current()
+            || !authority.current()
+            || caller.is_cancelled()
+        {
+            return Err(DispatchError::Closed);
+        }
+        let permit = AnswerPermit::new(authority, caller.child_token(), deadline);
+        let (done, receipt) = oneshot::channel();
+        let frame = Envelope::from_value(
+            serde_json::json!({"v":2,"type":"dtmf.received","id":format!("dtmf_{}",uuid::Uuid::new_v4().simple()),"ts":chrono::Utc::now(),"cid":self.scope.media.wire_conversation,"sid":self.scope.media.wire_session,"connid":self.scope.media.wire_connection,"operation_id":source.operation_id(),"payload":{"digits":source.digits(),"duration_ms":source.duration_ms(),"received_at":source.received_at(),"source":source.source()}}),
+        )?;
+        let delivery = HandlerDelivery::native_lifecycle(
+            origin.clone(),
+            frame,
+            permit.clone(),
+            done,
+            permit.deadline,
+        )?;
+        let watching = permit.clone();
+        let watch = tokio::spawn(async move {
+            let mut tick = tokio::time::interval(Duration::from_millis(5));
+            tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+            loop {
+                tokio::select! {_=watching.cancel.cancelled()=>break,_=tokio::time::sleep_until(watching.deadline)=>{watching.cancel();break;},_=tick.tick()=>{if !origin.current(){watching.cancel();break;}}}
+            }
+        });
+        reservation.send(delivery);
+        Ok(NativeDtmfSubmission {
+            permit,
+            receipt: Some(receipt),
+            watch,
+        })
+    }
+    pub async fn next_delivery(&self) -> Result<HandlerDelivery, DispatchError> {
+        if !self.origin.current() {
+            return Err(DispatchError::Closed);
+        }
+        let mut receiver = self.receiver.lock().await;
+        tokio::select! {biased;_=self.origin.cancellation().cancelled_owned()=>Err(DispatchError::Closed),delivery=receiver.recv()=>delivery.ok_or(DispatchError::Closed)}
+    }
+}
+/// One mux per actual physical recipient handler. Entries retain metadata only;
+/// every queued delivery already belongs to a cancellable one-use write owner.
+#[derive(Default)]
+pub struct NativeDtmfMux {
+    entries: Mutex<BTreeMap<ConnectionId, Arc<NativeDtmfRegistration>>>,
+    changed: tokio::sync::Notify,
+}
+impl NativeDtmfMux {
+    pub fn register(
+        &self,
+        id: ConnectionId,
+        registration: Arc<NativeDtmfRegistration>,
+    ) -> Result<(), DispatchError> {
+        if registration.scope().media.connection != id {
+            return Err(DispatchError::Authority);
+        }
+        let mut entries = self.entries.lock().unwrap_or_else(|p| p.into_inner());
+        if entries.len() >= 64 && !entries.contains_key(&id) {
+            return Err(DispatchError::Capacity);
+        }
+        entries.insert(id, registration);
+        drop(entries);
+        self.changed.notify_waiters();
+        Ok(())
+    }
+    pub async fn next_delivery(&self) -> Result<HandlerDelivery, DispatchError> {
+        use futures::{stream::FuturesUnordered, StreamExt};
+        loop {
+            let changed = self.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            let snapshot = self
+                .entries
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .iter()
+                .map(|(id, r)| (id.clone(), r.clone()))
+                .collect::<Vec<_>>();
+            let mut waiting = FuturesUnordered::new();
+            for (id, r) in snapshot {
+                waiting.push(async move {
+                    let result = r.next_delivery().await;
+                    (id, r, result)
+                });
+            }
+            let next = async {
+                if waiting.is_empty() {
+                    std::future::pending().await
+                } else {
+                    waiting.next().await.expect("nonempty registrations")
+                }
+            };
+            tokio::select! {_=&mut changed=>continue,(id,r,result)=next=>match result {Ok(delivery)=>return Ok(delivery),Err(_)=>{let mut entries=self.entries.lock().unwrap_or_else(|p|p.into_inner());if entries.get(&id).is_some_and(|now|Arc::ptr_eq(now,&r)){entries.remove(&id);}}}}
+        }
+    }
+}
