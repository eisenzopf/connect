+//! Bounded native DTMF delivery through the recipient's own authenticated
+//! writer. Idle registration and queued source metadata are never authority.
+use super::{
+    auth_dispatch::{
+        lifecycle::{NativeLifecycleFence, NativeLifecycleOrigin},
+        *,
+    },
+    native_dtmf::NativeDtmfObservation,
+    native_lifecycle::NativeLifecycleScope,
+    Envelope, Identifier,
+};
+use crate::{native_flow::NativeFlow, staged_media::StagedRtpScope};
+use rvoip_core::{
+    ids::*,
+    relationships::{EndpointBinding, Membership},
+    staged_streams::StreamController,
+    stream_lifecycle::*,
+};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex, Weak},
+    time::Duration,
+};
+use tokio::{
+    sync::{mpsc, oneshot},
+    time::Instant,
+};
+use tokio_util::sync::CancellationToken;
+/// Must authorize this exact source operation, current source/recipient
+/// relationships, recipient credential/key and event. With `held`, derive from
+/// that actual domain guard; never reacquire its reader or silently fall back.
+pub struct NativeDtmfEgressScope<'a> {
+    pub recipient: &'a NativeLifecycleScope,
+    pub audio_bindings: &'a [ReadyMediaBinding],
+    pub stream_revision: u64,
+    pub credential_revision: u64,
+}
+pub trait NativeDtmfEgressPolicy: Send + Sync {
+    fn authorize(
+        &self,
+        _scope: &NativeDtmfEgressScope<'_>,
+        _source: &NativeDtmfObservation,
+        _held: Option<&(dyn std::any::Any + Send + Sync)>,
+    ) -> Result<AuthorityLease, DispatchError> {
+        Err(DispatchError::Unsupported)
+    }
+}
+struct TargetFence {
+    controller: Weak<StreamController>,
+    flow: Weak<NativeFlow>,
+}
+impl NativeLifecycleFence for TargetFence {
+    fn current(&self) -> bool {
+        self.controller.upgrade().is_some() && self.flow.upgrade().is_some_and(|f| f.current())
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.flow.upgrade().map(|f| f.epoch()).unwrap_or_else(|| {
+            let t = CancellationToken::new();
+            t.cancel();
+            t
+        })
+    }
+}
+struct DeliveryFence {
+    controller: Weak<StreamController>,
+    flow: Weak<NativeFlow>,
+    revision: u64,
+    audio: Vec<ReadyMediaBinding>,
+    source: NativeDtmfObservation,
+    epoch: CancellationToken,
+}
+impl NativeLifecycleFence for DeliveryFence {
+    fn current(&self) -> bool {
+        if self.epoch.is_cancelled() || !self.source.current_source() {
+            return false;
+        }
+        let (Some(c), Some(f)) = (self.controller.upgrade(), self.flow.upgrade()) else {
+            return false;
+        };
+        c.revision() == self.revision
+            && f.confirmed_at(self.revision)
+            && !self.audio.is_empty()
+            && self.audio.iter().all(|old| {
+                c.active_bindings()
+                    .iter()
+                    .any(|new| crate::staged_media::same_binding(old, new))
+            })
+            && !self.epoch.is_cancelled()
+            && self.source.current_source()
+    }
+    fn cancellation(&self) -> CancellationToken {
+        self.epoch.child_token()
+    }
+}
+/// Owns one active bounded write, not a permission snapshot. Drop/cancel stops
+/// pending work; actual IO retains its guard until its sink has been aborted.
+#[must_use = "retain and await local writer completion, or drop to cancel"]
+pub struct NativeDtmfSubmission {
+    permit: Arc<AnswerPermit>,
+    receipt: Option<oneshot::Receiver<Result<Identifier, DispatchError>>>,
+    watch: tokio::task::JoinHandle<()>,
+}
+impl std::fmt::Debug for NativeDtmfSubmission {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeDtmfSubmission(redacted)")
+    }
+}
+impl Drop for NativeDtmfSubmission {
+    fn drop(&mut self) {
+        self.permit.cancel();
+        self.watch.abort();
+    }
+}
+impl NativeDtmfSubmission {
+    pub fn cancel(&self) {
+        self.permit.cancel();
+    }
+    /// Local signed transport submission only. Uncertain IO is never a reason
+    /// to redial or create another logical operation; reconcile the journal.
+    pub async fn written(mut self) -> Result<Identifier, DispatchError> {
+        let receipt = self.receipt.take().ok_or(DispatchError::Closed)?;
+        tokio::select! {biased;r=receipt=>r.unwrap_or_else(|_|Err(self.permit.uncertainty())),_=self.permit.cancel.cancelled()=>Err(self.permit.uncertainty()),_=tokio::time::sleep_until(self.permit.deadline)=>Err(self.permit.uncertainty())}
+    }
+}
+pub struct NativeDtmfRegistration {
+    origin: NativeLifecycleOrigin,
+    controller: Weak<StreamController>,
+    flow: Weak<NativeFlow>,
+    scope: NativeLifecycleScope,
+    sender: mpsc::Sender<HandlerDelivery>,
+    receiver: tokio::sync::Mutex<mpsc::Receiver<HandlerDelivery>>,
+}
+impl Drop for NativeDtmfRegistration {
+    fn drop(&mut self) {
+        self.origin.retire();
+    }
+}
+impl NativeDtmfRegistration {
+    pub(crate) fn new(
