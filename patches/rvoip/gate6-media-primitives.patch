+#[cfg(test)]
+mod telephone_event_negotiation_tests {
+    use super::*;
+    fn sdp(pt: u8, clock: u32, events: &str) -> SdpSession {
+        SdpSession::from_str(&format!("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=test\r\nc=IN IP4 127.0.0.1\r\nt=0 0\r\nm=audio 16000 RTP/AVP 0 {pt}\r\na=rtpmap:0 PCMU/8000\r\na=rtpmap:{pt} telephone-event/{clock}\r\na=fmtp:{pt} {events}\r\n")).unwrap()
+    }
+    #[test]
+    fn dynamic_payload_clock_and_event_subset_are_carried_without_becoming_primary_audio() {
+        for (pt, clock, events, mask) in [
+            (110, 8000, "0-9", 0x3ff),
+            (126, 48000, "0-15", u16::MAX),
+            (99, 16000, "1-3,7", 0x8e),
+        ] {
+            let offer = sdp(pt, clock, events);
+            let formats =
+                compute_answer_formats_with_policy(&offer, &[0, 8, 101], true, false, false, None)
+                    .unwrap();
+            assert_eq!(formats, vec!["0".to_string(), pt.to_string()]);
+            assert_eq!(
+                negotiated_telephone_event_codecs(&offer, &formats).unwrap(),
+                vec![TelephoneEventCodec::new(pt, clock).with_events(mask)]
+            );
+            assert_eq!(select_primary_audio_payload(&formats, &[pt]), Some(0));
+            assert_eq!(
+                answer_fmtp_for_pt(&offer, pt, false).as_deref(),
+                Some(events)
+            );
+        }
+    }
+    #[test]
+    fn changed_auxiliary_clock_and_invalid_event_lists_cannot_negotiate() {
+        let offer = sdp(101, 8000, "0-15");
+        let answer = sdp(101, 48000, "0-15");
+        assert!(validate_uac_audio_answer(&offer, &answer, false).is_err());
+        for value in ["0-15,", "0-999", "1-0", "0-15;16"] {
+            let offer = sdp(110, 8000, value);
+            assert!(telephone_event_codec(&offer, 110).is_err());
+            let formats =
+                compute_answer_formats_with_policy(&offer, &[0, 8, 101], true, false, false, None)
+                    .unwrap();
+            assert_eq!(formats, vec!["0"]);
+        }
+    }
+}
