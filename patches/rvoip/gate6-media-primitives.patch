+        *domain.write().await = true;
+        transmitter
+            .send_sequence_authorized("12", 400, 70, &policy)
+            .await
+            .unwrap();
+        let mut events = Vec::new();
+        while let Ok(p) = tokio::time::timeout(Duration::from_millis(40), receive(&receiver)).await
+        {
+            captured.push(observed(&p));
+            if p.payload[1] & 0x80 != 0 {
+                events.push(p.payload[0]);
+            }
+        }
+        assert!(events.contains(&1) && events.contains(&2));
+        assert_eq!(events.iter().filter(|e| **e == 1).count(), 3);
+        assert_eq!(events.iter().filter(|e| **e == 2).count(), 3);
+        assert_eq!(*policy.packets.lock().unwrap(), captured);
+        assert_eq!(policy.acquisitions.load(Ordering::Acquire), captured.len());
+    }
+    #[tokio::test]
+    async fn completed_first_digit_then_gap_revocation_is_an_uncertain_sequence() {
+        use rvoip_rtp_core::session::RtpSessionConfig;
+        let receiver = tokio::net::UdpSocket::bind("127.0.0.1:0").await.unwrap();
+        let session = RtpSession::new(RtpSessionConfig {
+            local_addr: "127.0.0.1:0".parse().unwrap(),
+            remote_addr: Some(receiver.local_addr().unwrap()),
+            ssrc: Some(0xcafebabe),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+        let transmitter = DtmfTransmitter::new(Arc::new(Mutex::new(session)));
+        let domain = Arc::new(tokio::sync::RwLock::new(true));
+        let policy = Policy {
+            domain: domain.clone(),
+            acquisitions: AtomicUsize::new(0),
+            packets: std::sync::Mutex::new(Vec::new()),
+        };
+        let mut pending = Box::pin(transmitter.send_sequence_authorized("12", 400, 70, &policy));
+        let until = tokio::time::Instant::now() + Duration::from_secs(2);
+        loop {
+            let packet = tokio::select! {r=&mut pending=>panic!("sequence ended before first complete digit:{r:?}"),p=receive(&receiver)=>p,_=tokio::time::sleep_until(until)=>panic!("first digit not observed")};
+            assert_eq!(packet.payload[0], 1);
+            if packet.payload[1] & 0x80 != 0 {
+                break;
+            }
+        }
+        *tokio::time::timeout(Duration::from_millis(30), domain.write())
+            .await
+            .expect("reader retained across interdigit gap") = false;
+        assert!(
+            matches!(
+                pending.await,
+                Err(Error::DtmfWrite(DtmfWriteError::OutcomeUnknown))
+            ),
+            "completed first digit must never become a wholly unsubmitted refusal"
+        );
+        let mut finals = 1;
+        while let Ok(packet) =
+            tokio::time::timeout(Duration::from_millis(40), receive(&receiver)).await
+        {
+            assert_eq!(packet.payload[0], 1, "revoked second digit escaped");
+            if packet.payload[1] & 0x80 != 0 {
+                finals += 1;
+            }
+        }
+        assert_eq!(finals, 3);
+    }
+}
