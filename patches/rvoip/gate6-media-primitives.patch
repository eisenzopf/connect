+                                .send_to(&Message::Response(response).to_bytes(), peer)
+                                .await
+                                .unwrap();
+                        }
+                    }
+                }
+            }
+        });
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        let mut seq = 1u16;
+        let make = |seq: u16, pt: u8, ts: u32, marker: bool, payload: &[u8]| {
+            let mut p = vec![0x80, pt | if marker { 128 } else { 0 }];
+            p.extend_from_slice(&seq.to_be_bytes());
+            p.extend_from_slice(&ts.to_be_bytes());
+            p.extend_from_slice(&0x12345678u32.to_be_bytes());
+            p.extend_from_slice(payload);
+            p
+        };
+        media
+            .send_to(&make(seq, 101, 1000, true, &[5, 0x8a, 0x03, 0x20]), target)
+            .await
+            .unwrap();
+        seq += 1;
+        no_digit(&mut events).await;
+        let mut malformed = vec![5, 0x8a, 0x03, 0x20];
+        malformed.extend_from_slice(&[255, 0x8a, 0, 1]);
+        media
+            .send_to(&make(seq, pt, 2000, true, &malformed), target)
+            .await
+            .unwrap();
+        seq += 1;
+        no_digit(&mut events).await;
+        let samples = (237 * clock / 1000) as u16;
+        for end in [false, true, true, true] {
+            let d = if end { samples } else { (clock / 50) as u16 }.to_be_bytes();
+            media
+                .send_to(
+                    &make(
+                        seq,
+                        pt,
+                        2000,
+                        !end,
+                        &[5, if end { 0x8a } else { 10 }, d[0], d[1]],
+                    ),
+                    target,
+                )
+                .await
+                .unwrap();
+            seq += 1;
+            tokio::time::sleep(Duration::from_millis(3)).await;
+        }
+        assert_eq!(
+            next_digit(&mut events).await,
+            (connection.clone(), "5".into(), 237)
+        );
+        no_digit(&mut events).await;
+        let stream = ConnectionAdapter::streams(adapter.as_ref(), connection.clone())
+            .await
+            .unwrap()
+            .into_iter()
+            .next()
+            .expect("actual live SIP stream");
+        for (index, payload_type) in [101, pt].into_iter().enumerate() {
+            stream
+                .frames_out()
+                .send(rvoip_core::stream::MediaFrame {
+                    stream_id: stream.id(),
+                    kind: rvoip_core::stream::StreamKind::Audio,
+                    payload: Bytes::from_static(&[5, 10, 0, 160]),
+                    timestamp_rtp: 3000 + index as u32 * 160,
+                    captured_at: chrono::Utc::now(),
+                    payload_type: Some(payload_type),
+                    source_clock: None,
+                })
+                .await
+                .unwrap();
+        }
+        assert!(
+            tokio::time::timeout(Duration::from_millis(100), async {
+                loop {
+                    let (n, _) = media.recv_from(&mut buffer).await.unwrap();
+                    if let Ok(packet) = rvoip_rtp_core::packet::RtpPacket::parse(&buffer[..n]) {
+                        if packet.header.payload_type == pt {
+                            break;
+                        }
+                    }
+                }
+            })
+            .await
+            .is_err(),
+            "raw audio payload manufactured a DTMF control effect"
+        );
+        let policy = Arc::new(Policy {
+            allowed: Arc::new(tokio::sync::RwLock::new(false)),
+            calls: AtomicUsize::new(0),
+            facts: std::sync::Mutex::new(Vec::new()),
+        });
+        assert_eq!(
+            ConnectionAdapter::send_dtmf_authorized(
+                adapter.as_ref(),
+                connection.clone(),
+                "5",
+                tone_ms,
+                policy.clone()
+            )
+            .await,
+            Err(DtmfWriteError::Refused)
+        );
+        assert!(policy.facts.lock().unwrap().is_empty());
+        *policy.allowed.write().await = true;
+        if events_param == "0-9" {
+            let before = policy.calls.load(Ordering::Acquire);
+            assert_eq!(
+                ConnectionAdapter::send_dtmf_authorized(
+                    adapter.as_ref(),
+                    connection.clone(),
+                    "5*",
+                    tone_ms,
+                    policy.clone()
+                )
+                .await,
+                Err(DtmfWriteError::Unsupported)
+            );
+            assert_eq!(
+                before,
+                policy.calls.load(Ordering::Acquire),
+                "unsupported suffix must not grant a prefix"
+            );
+        }
+        let sending = tokio::spawn({
+            let adapter = adapter.clone();
+            let conn = connection.clone();
+            let policy = policy.clone();
+            async move {
+                ConnectionAdapter::send_dtmf_authorized(
+                    adapter.as_ref(),
+                    conn,
+                    "6",
+                    tone_ms,
+                    policy,
+                )
+                .await
+            }
+        });
+        let mut actual = Vec::new();
+        loop {
+            let (n, _) = tokio::time::timeout(Duration::from_secs(4), media.recv_from(&mut buffer))
+                .await
+                .unwrap()
+                .unwrap();
+            if let Ok(packet) = rvoip_rtp_core::packet::RtpPacket::parse(&buffer[..n]) {
+                if packet.header.payload_type == pt {
+                    let frame = rvoip_core::dtmf::decode_telephone_event_payload_at_clock_rate(
+                        &packet.payload,
+                        clock,
+                    )
+                    .unwrap();
+                    actual.push((
+                        frame.event,
+                        frame.end_of_event,
+                        frame.duration_samples,
+                        packet.header.timestamp,
+                        packet.header.ssrc,
+                        pt,
+                        clock,
+                        packet.header.marker,
+                    ));
+                    if actual.iter().filter(|f| f.1).count() == 3 {
+                        break;
+                    }
+                }
+            }
+        }
+        sending
+            .await
+            .unwrap()
+            .expect("actual authorized RTP submission");
+        assert_eq!(
+            actual,
+            *policy.facts.lock().unwrap(),
+            "fresh host permission did not match every actual RTP packet"
+        );
+        let mut decoder =
+            rvoip_core::dtmf::DtmfDecoder::new([rvoip_core::dtmf::TelephoneEventCodec::new(
+                pt, clock,
+            )]);
+        let mut decoded = Vec::new();
+        for f in &actual {
+            let d = f.2.to_be_bytes();
+            decoded.extend(decoder.decode_packet(
+                f.4,
+                f.3,
+                pt,
+                f.7,
+                &[f.0, if f.1 { 0x8a } else { 10 }, d[0], d[1]],
+            ));
+        }
+        assert_eq!(decoded.len(), 1);
+        assert_eq!(decoded[0].duration_ms, tone_ms);
+        assert_eq!(
+            decoded[0].duration_samples,
+            u64::from(tone_ms) * u64::from(clock) / 1000
+        );
+        ConnectionAdapter::end(adapter.as_ref(), connection, EndReason::Normal)
+            .await
+            .unwrap();
+        adapter.drain().await.unwrap();
+        coordinator
+            .shutdown_gracefully(Some(Duration::from_secs(1)))
+            .await
+            .unwrap();
+        phone_task.abort();
+        let _ = phone_task.await;
+    }
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn actual_sip_dynamic_pt110_8khz_event_subset_has_fresh_exact_write_authority() {
+        profile(110, 8000, "0-9", 121).await;
+    }
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn actual_sip_dynamic_pt126_48khz_segmented_event_retains_negotiated_clock() {
+        profile(126, 48000, "0-15", 2000).await;
+    }
+}
