+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn native_dtmf_separate_permission_exact_operation_and_queued_writer_do_not_borrow_media_authority(
+) {
+    let mut s = Scene::new("quic", false).await;
+    let (_, callback) = s.prepared(s.offer(0, false)).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let denied = request("1", 100, "info");
+    s.wire.send(s.f.sign(denied)).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.grants.0.write().await.dtmf_allowed.insert(s.id.clone());
+    s.record.dtmf_hook.store(false, Ordering::Release);
+    s.wire.send(s.f.sign(request("1", 100, "info"))).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.record.dtmf_hook.store(true, Ordering::Release);
+    s.record.dtmf_sink.store(false, Ordering::Release);
+    s.wire.send(s.f.sign(request("1", 100, "info"))).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.record.dtmf_sink.store(true, Ordering::Release);
+    s.record.dtmf_expired.store(true, Ordering::Release);
+    s.wire.send(s.f.sign(request("1", 100, "info"))).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.record.dtmf_expired.store(false, Ordering::Release);
+    let original = request("2#", 100, "info");
+    for _ in 0..2 {
+        let mut v = original.clone();
+        v["id"] = json!(format!("wire_{}", uuid::Uuid::new_v4().simple()));
+        s.wire.send(s.f.sign(v)).await;
+        let r = s.wire.read().await;
+        assert_eq!(r.kind(), "ack");
+        s.f.verify_server(&r).await;
+    }
+    assert_eq!(s.record.dtmf_count.load(Ordering::Acquire), 1);
+    let mut changed = original.clone();
+    changed["id"] = json!(format!("wire_{}", uuid::Uuid::new_v4().simple()));
+    changed["payload"]["digits"] = json!("9");
+    s.wire.send(s.f.sign(changed)).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    s.record.dtmf_queue_writer.store(true, Ordering::Release);
+    s.wire.send(s.f.sign(request("3", 100, "rfc4733"))).await;
+    let r = s.wire.read().await;
+    assert_eq!(
+        r.kind(),
+        "ack",
+        "same held source grant must not reacquire behind queued writer"
+    );
+    s.f.verify_server(&r).await;
+    core_fixture::until(|| s.record.dtmf_writer_done.load(Ordering::Acquire)).await;
+    s.wire.send(s.f.sign(request("4", 100, "rfc4733"))).await;
+    assert_eq!(s.wire.read().await.kind(), "error");
+    assert_eq!(s.record.dtmf_count.load(Ordering::Acquire), 2);
+    s.record.dtmf_writer.lock().unwrap().take();
+    s.wire.server.shutdown().await.unwrap();
+}
