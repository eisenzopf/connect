+        let bytes = tokio::select! {r=&mut sequence=>panic!("ended before actual packet:{r:?}"),r=receive(&receiver)=>r};
+        let first = bytes;
+        let mut captured = vec![observed(&first)];
+        assert_eq!(first.header.ssrc, 0xcafebabe);
+        assert_eq!(first.payload[0], 1);
