+            transmitter
+                .send_sequence_authorized("12", 400, 70, &DenyDtmfWriteAuthority)
+                .await,
+            Err(Error::DtmfWrite(DtmfWriteError::Refused))
+        ));
+        assert!(
+            tokio::time::timeout(Duration::from_millis(30), receive(&receiver))
