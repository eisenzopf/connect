+        self.0.bind_local_stream(i)
+    }
+    fn unbind_local_stream(&mut self, i: &StreamInfo) {
+        self.0.unbind_local_stream(i)
+    }
+    fn bind_remote_stream(&mut self, i: &StreamInfo) {
+        self.0.bind_remote_stream(i)
+    }
+    fn unbind_remote_stream(&mut self, i: &StreamInfo) {
+        self.0.unbind_remote_stream(i)
+    }
+}
