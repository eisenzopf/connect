+++ b/crates/media/media-core/src/dtmf_authority.rs
@@ -0,0 +1,336 @@
+//! Fresh authority and bounded custody for one actual DTMF packet write.
+//! A policy instance must bind the exact source, recipient, physical/resource
+//! generations and original logical operation. Packet metadata is not a grant.
+use async_trait::async_trait;
+use std::{any::Any, future::Future, time::Duration};
+use tokio::time::Instant;
+
+pub const DTMF_WRITE_DEADLINE: Duration = Duration::from_millis(200);
+#[derive(Clone, Copy)]
+pub struct DtmfWriteScope<'a> {
+    pub digits: &'a str,
+    pub duration_ms: u32,
+    pub inter_digit_ms: u32,
+    pub digit_index: usize,
+    pub event: u8,
+    pub end_of_event: bool,
+    pub duration_samples: u16,
+    pub timestamp: u32,
+    pub ssrc: u32,
+    pub payload_type: u8,
+    pub clock_rate_hz: u32,
+    pub marker: bool,
+}
+impl std::fmt::Debug for DtmfWriteScope<'_> {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfWriteScope(redacted)")
+    }
+}
+/// These outcomes concern this write only. Earlier packets in the same logical
+/// operation may already have effects. Unknown IO never authorizes a replay.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, thiserror::Error)]
+pub enum DtmfWriteError {
+    #[error("DTMF write profile unsupported")]
+    Unsupported,
+    #[error("DTMF transport not ready before submission")]
+    NotReady,
+    #[error("DTMF write permission refused")]
+    Refused,
+    #[error("DTMF write deadline before submission")]
+    DeadlineBeforeWrite,
+    #[error("DTMF write outcome unknown; reconcile the original operation")]
+    OutcomeUnknown,
+}
+/// One owned current permission, never a cached boolean or an idle schedule
+/// reader. Trusted policy composition supplies the actual store/domain guard.
+pub struct DtmfWriteLease {
+    _guard: Box<dyn Any + Send>,
+    deadline: Instant,
+    current: Box<dyn Fn() -> bool + Send + Sync>,
+}
+impl std::fmt::Debug for DtmfWriteLease {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("DtmfWriteLease(redacted)")
+    }
+}
+impl DtmfWriteLease {
+    pub fn new<T: Any + Send>(
+        guard: T,
+        deadline: Instant,
+        current: impl Fn() -> bool + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            _guard: Box::new(guard),
+            deadline,
+            current: Box::new(current),
+        }
+    }
+    /// Trusted composition retains both actual guards and adds a live fence.
+    /// This cannot widen or extend the original lease's authority/deadline.
+    pub fn restrict<T: Any + Send>(
+        self,
+        guard: T,
+        current: impl Fn() -> bool + Send + Sync + 'static,
+    ) -> Self {
+        let Self {
+            _guard,
+            deadline,
+            current: before,
+        } = self;
+        Self {
+            _guard: Box::new((_guard, guard)),
+            deadline,
+            current: Box::new(move || before() && current()),
+        }
+    }
+    fn valid(&self) -> bool {
+        Instant::now() < self.deadline && (self.current)()
+    }
+}
+#[async_trait]
+pub trait DtmfWriteAuthority: Send + Sync {
+    /// Acquire current independent source/recipient signal permission for this
+    /// exact write. Do not retain a reader between calls or reacquire behind a
+    /// queued writer while the original invocation still owns that reader.
+    async fn acquire(&self, _scope: &DtmfWriteScope<'_>) -> Result<DtmfWriteLease, DtmfWriteError> {
+        Err(DtmfWriteError::Refused)
+    }
+}
+pub struct DenyDtmfWriteAuthority;
+#[async_trait]
+impl DtmfWriteAuthority for DenyDtmfWriteAuthority {}
+
+/// The supplied IO future must own its transport work; dropping it must stop
+/// pending IO. No spawned transport task may outlive this retained guard.
+pub async fn with_dtmf_write_authority<E, F>(
+    policy: &dyn DtmfWriteAuthority,
+    scope: &DtmfWriteScope<'_>,
+    write: F,
+) -> Result<(), DtmfWriteError>
+where
+    F: Future<Output = Result<(), E>>,
+{
+    let deadline = Instant::now() + DTMF_WRITE_DEADLINE;
+    let lease = tokio::time::timeout_at(deadline, policy.acquire(scope))
+        .await
+        .map_err(|_| DtmfWriteError::DeadlineBeforeWrite)??;
+    if !lease.valid() {
+        return Err(DtmfWriteError::Refused);
+    }
+    let deadline = deadline.min(lease.deadline);
+    let mut write = Box::pin(write);
+    let mut probe = tokio::time::interval(Duration::from_millis(5));
+    probe.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    let result = loop {
+        tokio::select! {biased;
+            _=tokio::time::sleep_until(deadline)=>break Err(DtmfWriteError::OutcomeUnknown),
+            _=probe.tick()=>if !lease.valid(){break Err(DtmfWriteError::OutcomeUnknown)},
+            r=&mut write=>break r.map_err(|_|DtmfWriteError::OutcomeUnknown),
+        }
+    };
+    // Keep custody through completion or synchronous abortion of the actual IO
+    // future. Dropping the outer request also drops both IO and this lease.
+    drop(write);
+    drop(lease);
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        pin::Pin,
+        sync::{
+            atomic::{AtomicBool, AtomicUsize, Ordering},
+            Arc,
+        },
+        task::{Context, Poll},
+    };
+    fn scope() -> DtmfWriteScope<'static> {
+        DtmfWriteScope {
+            digits: "12",
+            duration_ms: 100,
+            inter_digit_ms: 70,
+            digit_index: 0,
+            event: 1,
+            end_of_event: false,
+            duration_samples: 160,
+            timestamp: 42,
+            ssrc: 7,
+            payload_type: 101,
+            clock_rate_hz: 8000,
+            marker: true,
+        }
+    }
+    struct Guard(Arc<AtomicBool>);
+    impl Drop for Guard {
+        fn drop(&mut self) {
+            self.0.store(false, Ordering::Release);
+        }
+    }
+    struct Policy {
+        live: Arc<AtomicBool>,
+        valid: Arc<AtomicBool>,
+        deadline: Instant,
+    }
+    #[async_trait]
+    impl DtmfWriteAuthority for Policy {
+        async fn acquire(&self, s: &DtmfWriteScope<'_>) -> Result<DtmfWriteLease, DtmfWriteError> {
+            assert_eq!(s.ssrc, 7);
+            assert_eq!(s.digits, "12");
+            self.live.store(true, Ordering::Release);
+            let valid = self.valid.clone();
+            Ok(DtmfWriteLease::new(
+                Guard(self.live.clone()),
+                self.deadline,
+                move || valid.load(Ordering::Acquire),
+            ))
+        }
+    }
+    struct PendingWrite {
+        live: Arc<AtomicBool>,
+        polled: Arc<AtomicBool>,
+        dropped: Arc<AtomicBool>,
+    }
+    impl Future for PendingWrite {
+        type Output = Result<(), ()>;
+        fn poll(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<Self::Output> {
+            assert!(self.live.load(Ordering::Acquire));
+            self.polled.store(true, Ordering::Release);
+            Poll::Pending
+        }
+    }
+    impl Drop for PendingWrite {
+        fn drop(&mut self) {
+            if self.polled.load(Ordering::Acquire) {
+                assert!(
+                    self.live.load(Ordering::Acquire),
+                    "IO dropped after authority guard"
+                );
+            }
+            self.dropped.store(true, Ordering::Release);
+        }
+    }
+    #[tokio::test]
+    async fn denied_expired_and_stalled_acquisition_never_poll_io() {
+        let count = Arc::new(AtomicUsize::new(0));
+        for expiry in [false, true] {
+            let c = count.clone();
+            let io = async move {
+                c.fetch_add(1, Ordering::AcqRel);
+                Ok::<(), ()>(())
+            };
+            let policy = Policy {
+                live: Arc::new(AtomicBool::new(false)),
+                valid: Arc::new(AtomicBool::new(true)),
+                deadline: Instant::now() - Duration::from_millis(1),
+            };
+            let p: &dyn DtmfWriteAuthority = if expiry {
+                &policy
+            } else {
+                &DenyDtmfWriteAuthority
+            };
+            assert_eq!(
+                with_dtmf_write_authority(p, &scope(), io).await,
+                Err(DtmfWriteError::Refused)
+            );
+        }
+        struct Stalled;
+        #[async_trait]
+        impl DtmfWriteAuthority for Stalled {
+            async fn acquire(
+                &self,
+                _: &DtmfWriteScope<'_>,
+            ) -> Result<DtmfWriteLease, DtmfWriteError> {
+                std::future::pending().await
+            }
+        }
+        let c = count.clone();
+        assert_eq!(
+            with_dtmf_write_authority(&Stalled, &scope(), async move {
+                c.fetch_add(1, Ordering::AcqRel);
+                Ok::<(), ()>(())
+            })
+            .await,
+            Err(DtmfWriteError::DeadlineBeforeWrite)
+        );
+        assert_eq!(count.load(Ordering::Acquire), 0);
+    }
+    #[tokio::test]
+    async fn retirement_and_deadline_abort_owned_io_before_releasing_guard() {
+        for retire in [false, true] {
+            let live = Arc::new(AtomicBool::new(false));
+            let valid = Arc::new(AtomicBool::new(true));
+            let polled = Arc::new(AtomicBool::new(false));
+            let dropped = Arc::new(AtomicBool::new(false));
+            let policy = Policy {
+                live: live.clone(),
+                valid: valid.clone(),
+                deadline: Instant::now() + Duration::from_millis(50),
+            };
+            let io = PendingWrite {
+                live: live.clone(),
+                polled: polled.clone(),
+                dropped: dropped.clone(),
+            };
+            let packet_scope = scope();
+            let result = with_dtmf_write_authority(&policy, &packet_scope, io);
+            if retire {
+                tokio::pin!(result);
+                tokio::select! {r=&mut result=>panic!("ended before retirement: {r:?}"),_=tokio::time::sleep(Duration::from_millis(10))=>{}};
+                valid.store(false, Ordering::Release);
+                assert_eq!(result.await, Err(DtmfWriteError::OutcomeUnknown));
+            } else {
+                assert_eq!(result.await, Err(DtmfWriteError::OutcomeUnknown));
+            }
+            assert!(polled.load(Ordering::Acquire));
+            assert!(dropped.load(Ordering::Acquire));
+            assert!(!live.load(Ordering::Acquire));
+        }
+    }
+    #[tokio::test]
+    async fn dropping_request_aborts_pending_io_before_releasing_owned_guard() {
+        let live = Arc::new(AtomicBool::new(false));
+        let polled = Arc::new(AtomicBool::new(false));
+        let dropped = Arc::new(AtomicBool::new(false));
+        let policy = Policy {
+            live: live.clone(),
+            valid: Arc::new(AtomicBool::new(true)),
+            deadline: Instant::now() + Duration::from_secs(1),
+        };
+        let s = scope();
+        let mut pending = Box::pin(with_dtmf_write_authority(
+            &policy,
+            &s,
+            PendingWrite {
+                live: live.clone(),
+                polled: polled.clone(),
+                dropped: dropped.clone(),
+            },
+        ));
+        tokio::select! {r=&mut pending=>panic!("unexpected completion:{r:?}"),_=tokio::time::sleep(Duration::from_millis(10))=>{}};
+        drop(pending);
+        assert!(polled.load(Ordering::Acquire));
+        assert!(dropped.load(Ordering::Acquire));
+        assert!(!live.load(Ordering::Acquire));
+    }
+    #[tokio::test]
+    async fn transport_failure_is_unknown_and_never_an_automatic_retry() {
+        let live = Arc::new(AtomicBool::new(false));
+        let policy = Policy {
+            live: live.clone(),
+            valid: Arc::new(AtomicBool::new(true)),
+            deadline: Instant::now() + Duration::from_secs(1),
+        };
+        let attempts = AtomicUsize::new(0);
+        let result = with_dtmf_write_authority(&policy, &scope(), async {
+            attempts.fetch_add(1, Ordering::AcqRel);
+            Err::<(), _>("private transport detail")
+        })
+        .await;
+        assert_eq!(result, Err(DtmfWriteError::OutcomeUnknown));
+        assert_eq!(attempts.load(Ordering::Acquire), 1);
+        assert!(!live.load(Ordering::Acquire));
+        assert!(!result.unwrap_err().to_string().contains("private"));
+    }
+}
