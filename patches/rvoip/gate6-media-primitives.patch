+        drop(writer);
+        assert!(matches!(
+            sequence.await,
+            Err(Error::DtmfWrite(DtmfWriteError::OutcomeUnknown))
+        ));
+        while let Ok(p) = tokio::time::timeout(Duration::from_millis(40), receive(&receiver)).await
+        {
+            captured.push(observed(&p));
+            assert_eq!(p.payload[0], 1);
+            assert_eq!(p.payload[1] & 0x80, 0);
+        }
