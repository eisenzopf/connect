@@ -0,0 +1,588 @@
+use super::*;
+use crate::staged_streams::{
+    audio_subscriptions::*, direct_subscriptions::*, media_scene::GuardedMediaScene,
+};
+struct Scene {
+    f: Fixture,
+    scene: Arc<GuardedMediaScene>,
+}
+impl Scene {
+    async fn new(kinds: &[Medium]) -> Self {
+        let f = Fixture::new(16);
+        f.start_unsubscribed(kinds).await;
+        let scene = GuardedMediaScene::new(
+            ConversationId::from_string("conversation"),
+            SessionId::from_string("session"),
+            f.policy.clone(),
+            8000,
+        );
+        for c in [&f.a, &f.b] {
+            let mut member = scene.prepare(c.clone()).unwrap();
+            member
+                .quiesce(deadline(), CancellationToken::new())
+                .await
+                .unwrap();
+            assert!(member.ready());
+            scene.insert(c.connection.clone(), member, true);
+        }
+        Self { f, scene }
+    }
+    async fn subscribe(&self, medium: Medium) {
+        self.scene
+            .change_direct_subscriptions(
+                &self.f.b.connection,
+                self.f.b.revision(),
+                DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                    &self.f.a,
+                    desired(medium).logical_id.clone(),
+                    desired(medium).logical_id,
+                )]),
+                deadline(),
+                CancellationToken::new(),
+                None,
+            )
+            .await
+            .unwrap();
+    }
+    fn publish(&self, medium: Medium, seq: u32) {
+        let port = self.f.aa.port(medium);
+        port.try_publish(&frame(&port, seq)).unwrap();
+    }
+}
+fn current(controller: &StreamController, logical: &str) -> AdapterMediaPort {
+    AdapterMediaPort(
+        controller.state.lock().unwrap().active[&StreamId::from_string(logical)].clone(),
+    )
+}
+fn audio(logical: &str) -> DesiredStream {
+    DesiredStream {
+        logical_id: StreamId::from_string(logical),
+        medium: Medium::Audio,
+        direction: StreamDirection::Both,
+    }
+}
+#[tokio::test]
+async fn owned_scene_admits_video_screen_and_data_without_audio_and_fans_out_only_explicit_routes()
+{
+    let s = Scene::new(&[Medium::Video, Medium::Screen, Medium::Data]).await;
+    for medium in [Medium::Video, Medium::Screen, Medium::Data] {
+        assert!(s.f.a.take_ingress(&desired(medium).logical_id).is_err());
+        let mut out = s.f.ba.port(medium).take_egress().unwrap();
+        s.publish(medium, 10);
+        s.scene.tick();
+        assert!(out.try_recv().is_err());
+        s.subscribe(medium).await;
+        s.publish(medium, 20);
+        s.scene.tick();
+        outgoing(&mut out)
+            .await
+            .deliver(|f| async move {
+                assert_eq!(f.timestamp_rtp, 20);
+                Ok(())
+            })
+            .await
+            .unwrap();
+    }
+}
+#[tokio::test]
+async fn owned_scene_refuses_pre_admission_data_and_keeps_processing_new_publications() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Data]).await;
+    let source = f.aa.port(Medium::Data);
+    source.try_publish(&frame(&source, 0)).unwrap();
+    let scene = GuardedMediaScene::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        f.policy.clone(),
+        8000,
+    );
+    for c in [&f.a, &f.b] {
+        let mut m = scene.prepare(c.clone()).unwrap();
+        if c.connection == f.a.connection {
+            assert!(source.try_publish(&frame(&source, 9)).is_err());
+        } else {
+            // Source is admitted, but this receiver is still inactive.
+            source.try_publish(&frame(&source, 9)).unwrap();
+        }
+        m.quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        scene.insert(c.connection.clone(), m, true);
+    }
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    scene.tick();
+    assert!(out.try_recv().is_err());
+    source.try_publish(&frame(&source, 1)).unwrap();
+    scene.tick();
+    outgoing(&mut out)
+        .await
+        .deliver(|f| async move {
+            assert_eq!(f.timestamp_rtp, 1);
+            Ok(())
+        })
+        .await
+        .unwrap();
+}
+#[tokio::test]
+async fn owned_scene_data_backpressure_preserves_order_while_video_keeps_flowing() {
+    let s = Scene::new(&[Medium::Data, Medium::Video]).await;
+    s.subscribe(Medium::Data).await;
+    s.subscribe(Medium::Video).await;
+    let mut data = s.f.ba.port(Medium::Data).take_egress().unwrap();
+    let mut video = s.f.ba.port(Medium::Video).take_egress().unwrap();
+    for seq in 0..64 {
+        s.publish(Medium::Data, seq);
+    }
+    s.scene.tick();
+    s.scene.tick();
+    s.publish(Medium::Data, 64);
+    s.publish(Medium::Data, 65);
+    s.scene.tick();
+    s.publish(Medium::Video, 9000);
+    s.scene.tick();
+    outgoing(&mut video)
+        .await
+        .deliver(|f| async move {
+            assert_eq!(f.timestamp_rtp, 9000);
+            Ok(())
+        })
+        .await
+        .unwrap();
+    for seq in 0..66 {
+        outgoing(&mut data)
+            .await
+            .deliver(|f| async move {
+                assert_eq!(
+                    serde_json::from_slice::<serde_json::Value>(&f.payload).unwrap()["sequence"],
+                    seq
+                );
+                Ok(())
+            })
+            .await
+            .unwrap();
+        s.scene.tick();
+    }
+}
+#[tokio::test]
+async fn owned_scene_removal_cancels_admitted_data_and_refuses_remaining_publication() {
+    let s = Scene::new(&[Medium::Data]).await;
+    s.subscribe(Medium::Data).await;
+    let mut out = s.f.ba.port(Medium::Data).take_egress().unwrap();
