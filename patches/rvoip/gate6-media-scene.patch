+#[tokio::test]
+async fn owned_scene_admission_drains_non_audio_io_before_activating_its_input_owner() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Data]).await;
+    let mut input = f.a.take_ingress(&desired(Medium::Data).logical_id).unwrap();
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let source = f.aa.port(Medium::Data);
+    source.try_publish(&frame(&source, 0)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Data).logical_id)
+        .unwrap();
+    let queued = outgoing(&mut out).await;
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let sending = tokio::spawn({
+        let entered = entered.clone();
+        let release = release.clone();
+        async move {
+            queued
+                .deliver(|_| async move {
+                    entered.notify_one();
+                    release.notified().await;
+                    Ok(())
+                })
+                .await
+        }
+    });
+    entered.notified().await;
+    let scene = GuardedMediaScene::new(
+        ConversationId::from_string("conversation"),
+        SessionId::from_string("session"),
+        f.policy.clone(),
+        8000,
+    );
+    let mut candidate = scene.prepare(f.b.clone()).unwrap();
+    let mut drain = tokio::spawn(async move {
+        candidate
+            .quiesce(deadline(), CancellationToken::new())
+            .await
+            .unwrap();
+        candidate
+    });
+    assert!(tokio::time::timeout(Duration::from_millis(25), &mut drain)
+        .await
+        .is_err());
+    release.notify_one();
+    sending.await.unwrap().unwrap();
+    let candidate = drain.await.unwrap();
+    assert!(candidate.ready());
+    scene.insert(f.b.connection.clone(), candidate, false);
+    source.try_publish(&frame(&source, 1)).unwrap();
+    assert!(receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Data).logical_id)
+        .is_err());
+}
