+pub(super) struct PreparedAudioSelection {
+    consumer: Arc<AudioConsumer>,
+    previous: ConsumerStamp,
+    next: PeerRouteTicket,
+    logical: Option<StreamId>,
+    _drained: rvoip_core_traits::peer_switch::PeerQuiescenceGuard,
+}
+impl PreparedAudioSelection {
+    pub(super) fn lock(&self) -> ControlResult<std::sync::MutexGuard<'_, ConsumerState>> {
+        let state = self
+            .consumer
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        if self.consumer.cancellation.is_cancelled()
+            || !state.active
+            || state.epoch != self.previous.epoch
+            || !self.previous.ticket.is_current()
+        {
+            return Err(StreamControlError::Cancelled);
+        }
+        state
+            .epoch
+            .checked_add(1)
+            .ok_or(MediaTransitionError::Capacity)?;
+        Ok(state)
+    }
+    pub(super) fn commit(&self, state: &mut ConsumerState) {
+        assert!(
+            self.next.commit_from(&self.previous.ticket),
+            "audio selection changed outside consumer fence"
+        );
+        state.logical = self.logical.clone();
+        state.ticket = self.next.clone();
+        state.epoch += 1;
+        state.started = Instant::now();
+    }
+}
+impl StreamController {
+    pub(super) async fn prepare_audio_selection(
+        &self,
+        logical: Option<StreamId>,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        control_cancel: CancellationToken,
+    ) -> ControlResult<Option<PreparedAudioSelection>> {
+        let consumer = {
+            let slot = self
+                .audio_consumer
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            match &*slot {
+                None => return Ok(None),
+                Some(w) => w.upgrade().ok_or(StreamControlError::NotReady)?,
+            }
+        };
+        if consumer.logical() == logical {
+            return Ok(None);
+        }
+        let previous = consumer.stamp();
+        let next = previous
+            .ticket
+            .stage()
+            .ok_or(MediaTransitionError::Capacity)?;
+        let drained = tokio::select! {biased;
+            _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=control_cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=self.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=consumer.cancellation.cancelled()=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,previous.ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        };
+        Ok(Some(PreparedAudioSelection {
+            consumer,
+            previous,
+            next,
+            logical,
+            _drained: drained,
+        }))
+    }
+}
