+
+fn scene_video(id: u16, sequence: u16, timestamp: u32) -> Bytes {
+    let mut packet = vec![0x80, 0x80 | 96];
+    packet.extend_from_slice(&sequence.to_be_bytes());
+    packet.extend_from_slice(&timestamp.to_be_bytes());
+    packet.extend_from_slice(&7u32.to_be_bytes());
+    packet.extend_from_slice(&[0x10, 1, 2, 3]);
+    pack_observed_rtp_datagram(&ObservedRtpDatagram {
+        flags: 0,
+        stream_local_id: id,
+        seq: sequence.into(),
+        rtp: observe_rtp(packet.into()).unwrap(),
+    })
+    .unwrap()
+}
+
+// Readiness retains historical logical offers; a medium-only search may name
+// the retired audio handle after a successful logical-stream replacement.
+fn logical_binding(leg: &Leg, logical: &str) -> ReadyMediaBinding {
+    let status = leg.controller.cleanup_status();
+    leg.readiness
+        .offers
+        .lock()
+        .unwrap()
+        .iter()
+        .find(|b| {
+            b.negotiated.requested.logical_id.as_str() == logical
+                && status.iter().any(|(id, state)| {
+                    id == &b.transport_id
+                        && matches!(state, PortStatus::Active | PortStatus::Paused)
+                })
+        })
+        .expect("requested logical fixture stream must have a current active transport")
+        .clone()
+}
