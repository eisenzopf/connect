+//! Owned staged scene: optional audio mix and exact guarded direct fan-out.
+use super::audio_consumer::AudioConsumer;
+use super::guarded_audio::{AudioMember, GuardedAudioMixer};
+use super::scene_consumer::SceneConsumer;
+use super::*;
+use rvoip_core_traits::peer_switch::PeerQuiescenceGuard;
+use std::collections::HashMap;
+
+struct Destination {
+    owner: Weak<StreamController>,
+    logical: StreamId,
+}
+struct Pending {
+    packet: MediaPacket,
+    remaining: Vec<Destination>,
+}
+struct Input {
+    port: Arc<Port>,
+    receiver: mpsc::Receiver<MediaPacket>,
+    pending: Option<Pending>,
+}
+pub(crate) struct SceneMember {
+    controller: Arc<StreamController>,
+    consumer: Arc<SceneConsumer>,
+    audio_consumer: Arc<AudioConsumer>,
+    audio: Option<AudioMember>,
+    inputs: BTreeMap<StreamId, Input>,
+    ports: Vec<Arc<Port>>,
+    flight: Option<OwnedSemaphorePermit>,
+    prepared: Option<Vec<PeerQuiescenceGuard>>,
+}
+impl Drop for SceneMember {
+    fn drop(&mut self) {
+        self.consumer.retire();
+        self.audio_consumer.retire();
+    }
+}
+impl SceneMember {
+    pub(crate) async fn quiesce(
+        &mut self,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        let mut guards = Vec::new();
+        for port in &self.ports {
+            let ticket = port.ticket();
+            guards.push(tokio::select! {biased;
+            _=cancel.cancelled()=>return Err(StreamControlError::Cancelled),
+            _=self.controller.shutdown.cancelled()=>return Err(StreamControlError::Cancelled),
+            result=tokio::time::timeout_at(deadline,ticket.quiesce())=>result.map_err(|_|StreamControlError::Deadline)?.ok_or(MediaTransitionError::Conflict)?,
+        });
+        }
+        self.prepared = Some(guards);
+        Ok(())
+    }
+    pub(crate) fn ready(&self) -> bool {
+        let s = self
+            .controller
+            .state
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        self.prepared.is_some()
+            && !s.closed
+            && !self.controller.shutdown.is_cancelled()
+            && self.ports.iter().all(|port| {
+                s.active
+                    .get(&port.binding.negotiated.requested.logical_id)
+                    .is_some_and(|p| Arc::ptr_eq(p, port))
+                    && {
+                        let p = port.state.lock().unwrap_or_else(|p| p.into_inner());
+                        p.ready && matches!(p.status, PortStatus::Active | PortStatus::Paused)
+                    }
+            })
+    }
+    pub(crate) fn bound_to(&self, member: &Membership, endpoint: &EndpointBinding) -> bool {
+        self.controller.is_bound_to(member, endpoint)
+    }
+    pub(crate) fn receives_audio(&self) -> bool {
+        self.ports
+            .iter()
+            .any(|p| p.binding.negotiated.requested.medium == Medium::Audio && p.binding.sink_ready)
+    }
+}
+pub(crate) struct GuardedMediaScene {
+    id: u128,
+    conversation: ConversationId,
+    session: SessionId,
+    policy: Arc<dyn MediaPolicy>,
+    rate: u32,
+    members: Mutex<HashMap<ConnectionId, SceneMember>>,
+    audio: Arc<GuardedAudioMixer>,
+}
+impl GuardedMediaScene {
+    pub(crate) fn new(
+        conversation: ConversationId,
+        session: SessionId,
+        policy: Arc<dyn MediaPolicy>,
+        rate: u32,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            id: uuid::Uuid::new_v4().as_u128(),
+            audio: GuardedAudioMixer::new(rate),
+            conversation,
+            session,
+            policy,
+            rate,
+            members: Mutex::new(HashMap::new()),
+        })
+    }
+    pub(crate) fn prepare(&self, controller: Arc<StreamController>) -> ControlResult<SceneMember> {
+        if controller.conversation != self.conversation
+            || controller.session != self.session
+            || !Arc::ptr_eq(&controller.policy, &self.policy)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let flight = controller
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let state = controller.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.closed || controller.shutdown.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        let ports = state.active.values().cloned().collect::<Vec<_>>();
+        if ports.is_empty() {
+            return Err(StreamControlError::NotReady);
+        }
+        if ports.iter().any(|p| {
+            let s = p.state.lock().unwrap_or_else(|p| p.into_inner());
+            !s.ready || !matches!(s.status, PortStatus::Active | PortStatus::Paused)
+        }) {
+            return Err(StreamControlError::NotReady);
+        }
+        let audio_ports = ports
+            .iter()
+            .filter(|p| p.binding.negotiated.requested.medium == Medium::Audio)
+            .collect::<Vec<_>>();
+        if audio_ports.len() > 1 {
+            return Err(StreamControlError::Unsupported);
+        }
+        if ports
+            .iter()
+            .any(|p| p.input.lock().unwrap_or_else(|p| p.into_inner()).is_none())
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let mut scene_slot = controller
+            .scene_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let mut audio_slot = controller
+            .audio_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        if scene_slot.is_some() || audio_slot.is_some() {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        let consumer = SceneConsumer::new(self.id);
+        let audio_consumer = AudioConsumer::optional(
+            audio_ports
+                .first()
+                .map(|p| p.binding.negotiated.requested.logical_id.clone()),
+            self.rate,
+        );
+        *scene_slot = Some(Arc::downgrade(&consumer));
+        *audio_slot = Some(Arc::downgrade(&audio_consumer));
+        drop(scene_slot);
+        drop(audio_slot);
+        let mut inputs = BTreeMap::new();
+        for p in ports
+            .iter()
+            .filter(|p| p.binding.negotiated.requested.medium != Medium::Audio)
+        {
+            let receiver = p
+                .input
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .take()
+                .ok_or(MediaTransitionError::Conflict)?;
+            inputs.insert(
+                p.binding.negotiated.requested.logical_id.clone(),
+                Input {
+                    port: p.clone(),
+                    receiver,
+                    pending: None,
+                },
+            );
+        }
+        drop(state);
+        let audio = if audio_ports.is_empty() {
+            None
+        } else {
+            Some(
+                self.audio
+                    .prepare_registered(controller.clone(), audio_consumer.clone())?,
+            )
+        };
+        Ok(SceneMember {
+            controller,
+            consumer,
+            audio_consumer,
+            audio,
+            inputs,
+            ports,
+            flight: Some(flight),
+            prepared: None,
+        })
+    }
+    pub(crate) fn insert(&self, id: ConnectionId, mut member: SceneMember, speaks: bool) {
+        assert!(
+            member.prepared.is_some(),
+            "scene member must drain original sends before admission"
+        );
+        member.consumer.activate();
+        member.audio_consumer.activate(speaks);
+        if let Some(mut audio) = member.audio.take() {
+            audio.activate(speaks);
+            self.audio.insert_registered(id.clone(), audio);
+        }
+        // No live-readiness assertion after logical commit: EOF may race here.
+        member.prepared.take();
+        member.ports.clear();
+        member.flight.take();
+        self.members
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .insert(id, member);
+    }
+    pub(crate) fn remove(&self, id: &ConnectionId) {
+        let mut members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        if let Some(member) = members.remove(id) {
+            member.consumer.retire();
+            member.audio_consumer.retire();
+            self.audio.detach(id);
+        }
+    }
+    pub(crate) fn clear(&self) {
+        let mut members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        for (id, member) in members.drain() {
+            member.consumer.retire();
+            member.audio_consumer.retire();
+            self.audio.detach(&id);
+        }
+    }
+    pub(crate) fn needs_audio_receive(
+        &self,
+        mutation: &crate::participant_transitions::ParticipantMutation,
+    ) -> bool {
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        members
+            .iter()
+            .filter(|(id, m)| match &mutation.change {
+                crate::participant_transitions::ParticipantChange::Admit { connection, .. } => {
+                    *id == connection
+                }
+                _ => m.controller.origin_member.participant() == &mutation.participant,
+            })
+            .any(|(_, m)| {
+                m.controller
+                    .state
+                    .lock()
+                    .unwrap_or_else(|p| p.into_inner())
+                    .active
+                    .values()
+                    .any(|p| {
+                        p.binding.negotiated.requested.medium == Medium::Audio
+                            && p.binding.sink_ready
+                    })
+            })
+    }
+    #[cfg(test)]
+    pub(super) fn contains_connection(&self, id: &ConnectionId) -> bool {
+        self.members
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .contains_key(id)
+    }
+    pub(crate) fn role_targets(&self, ids: &[ConnectionId]) -> Vec<Arc<AudioConsumer>> {
+        let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        ids.iter()
+            .filter_map(|id| members.get(id).map(|m| m.audio_consumer.clone()))
+            .collect()
+    }
+    pub(crate) async fn change_subscriptions(
+        &self,
+        target: &ConnectionId,
+        expected: u64,
+        change: audio_subscriptions::AudioSubscriptionChange,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<u64> {
+        self.audio
+            .change_subscriptions(target, expected, change, deadline, cancel, held)
+            .await
+    }
+    pub(crate) async fn change_direct_subscriptions(
+        &self,
+        target: &ConnectionId,
+        expected: u64,
+        change: direct_subscriptions::DirectSubscriptionChange,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+        held: Option<&(dyn Any + Send + Sync)>,
+    ) -> ControlResult<u64> {
+        let controller = {
+            let members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+            let target = members.get(target).ok_or(StreamControlError::NotReady)?;
+            if let direct_subscriptions::DirectSubscriptionChange::Subscribe(items) = &change {
+                for selection in items {
+                    let source = selection.publisher().ok_or(StreamControlError::NotReady)?;
+                    if !members
+                        .get(&selection.source.connection)
+                        .is_some_and(|m| Arc::ptr_eq(&m.controller, &source))
+                    {
+                        return Err(StreamControlError::Authority);
+                    }
+                }
+            }
+            target.controller.clone()
+        };
+        controller
+            .change_direct_subscriptions(expected, change, deadline, cancel, held)
+            .await
+    }
+    pub(crate) fn tick(&self) {
+        let mut members = self.members.lock().unwrap_or_else(|p| p.into_inner());
+        let controllers = members
+            .values()
+            .map(|m| m.controller.clone())
+            .collect::<Vec<_>>();
+        for (id, member) in &mut *members {
+            // A control operation may be suspended with its in-flight permit.
+            // Adoption never reenters that invocation or takes an idle grant.
+            let Ok(_flight) = member.controller.inflight.clone().try_acquire_owned() else {
+                continue;
+            };
+            let state = member
+                .controller
+                .state
+                .lock()
+                .unwrap_or_else(|p| p.into_inner());
+            if state.closed || member.controller.shutdown.is_cancelled() {
+                member.inputs.clear();
+                continue;
+            }
+            member.inputs.retain(|logical, input| {
+                state
+                    .active
+                    .get(logical)
+                    .is_some_and(|p| Arc::ptr_eq(p, &input.port))
+            });
+            for (logical, port) in state
+                .active
+                .iter()
+                .filter(|(_, p)| p.binding.negotiated.requested.medium != Medium::Audio)
+            {
+                if !member.inputs.contains_key(logical) {
+                    if let Some(receiver) =
+                        port.input.lock().unwrap_or_else(|p| p.into_inner()).take()
+                    {
+                        member.inputs.insert(
+                            logical.clone(),
+                            Input {
+                                port: port.clone(),
+                                receiver,
+                                pending: None,
+                            },
+                        );
+                    }
+                }
+            }
+            let has_audio = member
+                .audio_consumer
+                .logical()
+                .is_some_and(|logical| state.active.contains_key(&logical));
+            drop(state);
+            if !has_audio {
+                self.audio.detach(id);
+            } else if !self.audio.contains(id) {
+                if let Ok(audio) = self
+                    .audio
+                    .prepare_registered(member.controller.clone(), member.audio_consumer.clone())
+                {
+                    self.audio.insert_registered(id.clone(), audio);
+                }
+            }
+        }
+        self.audio.tick();
+        for member in members.values_mut() {
+            for (logical, input) in &mut member.inputs {
+                for _ in 0..32 {
+                    if input.pending.is_none() {
+                        let Ok(packet) = input.receiver.try_recv() else {
+                            break;
+                        };
+                        let remaining = controllers
+                            .iter()
+                            .flat_map(|target| {
+                                target
+                                    .direct_subscriptions
+                                    .receivers(&member.controller, logical, packet.admitted_at)
+                                    .into_iter()
+                                    .map(|logical| Destination {
+                                        owner: Arc::downgrade(target),
+                                        logical,
+                                    })
+                            })
+                            .collect();
+                        input.pending = Some(Pending { packet, remaining });
+                    }
+                    let pending = input.pending.as_mut().unwrap();
+                    let data = pending.packet.frame.kind == StreamKind::Data;
+                    if pending
+                        .packet
+                        .scene
+                        .as_ref()
+                        .is_none_or(|s| !member.consumer.accepts(s))
+                        || !pending.packet.ticket.is_current()
+                        || pending
+                            .packet
+                            .scene
+                            .as_ref()
+                            .is_some_and(|s| s.cancel.is_cancelled())
+                        || member.controller.shutdown.is_cancelled()
+                    {
+                        input.pending = None;
+                        continue;
+                    }
+                    pending.remaining.retain(|destination| {
+                        let Some(target) = destination.owner.upgrade() else {
+                            return false;
+                        };
+                        let admitted_to_scene = target
+                            .scene_consumer
+                            .lock()
+                            .unwrap_or_else(|p| p.into_inner())
+                            .as_ref()
+                            .and_then(Weak::upgrade)
+                            .is_some_and(|c| {
+                                c.receives_at(
+                                    pending.packet.scene.as_ref(),
+                                    pending.packet.admitted_at,
+                                )
+                            });
+                        if !admitted_to_scene
+                            || target.shutdown.is_cancelled()
+                            || !target.direct_subscriptions.selected_at(
+                                &member.controller,
+                                logical,
+                                &destination.logical,
+                                pending.packet.admitted_at,
+                            )
+                        {
+                            return false;
+                        }
+                        if StreamController::principal_expiry(
+                            &member.controller.credential_snapshot().principal,
+                        )
+                        .is_some_and(|e| e <= chrono::Utc::now())
+                            || StreamController::principal_expiry(
+                                &target.credential_snapshot().principal,
+                            )
+                            .is_some_and(|e| e <= chrono::Utc::now())
+                        {
+                            return false;
+                        }
+                        match pending.packet.try_forward_to(&target, &destination.logical) {
+                            Ok(()) => false,
+                            Err(_) => data,
+                        }
+                    });
+                    if pending.remaining.is_empty() {
+                        input.pending = None;
+                    } else {
+                        break;
+                    }
+                }
+            }
+        }
+    }
+}
