+        assert!(
+            tokio::time::timeout(Duration::from_millis(100), received(&s.live[1].wire))
+                .await
+                .is_err()
+        );
+        send(
+            &s.live[0].wire,
+            scene_video(binding(source, Medium::Screen).stream_local_id, 2, 18000),
+        );
+        assert_eq!(
+            received(&s.live[1].wire).await.stream_local_id,
+            binding(target, Medium::Screen).stream_local_id
+        );
+        assert_eq!(
+            received(&s.live[2].wire)
+                .await
+                .rtp
+                .packet()
+                .header
+                .timestamp,
+            18000
+        );
+        assert!(s
+            .live
+            .iter()
+            .all(|live| live.peer.snapshot().connections == 1));
+        s.stop().await;
+    }
+}
