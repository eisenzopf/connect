+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_tls_owned_scene_reselects_audio_logical_streams_and_retains_participant_intent() {
+    for kind in ["quic", "wt"] {
+        let s = Scene::new(kind).await;
+        s.tone(0, 1).await;
+        let source = &s.live[0].leg;
+        let mut microphone = desired(Medium::Audio);
+        microphone.logical_id = StreamId::from_string("microphone");
+        source
+            .controller
+            .change(
+                source.controller.revision(),
+                &[microphone],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+        s.tone_streams(0, "microphone", 1, "audio").await;
+        s.tone_streams(0, "microphone", 2, "audio").await;
+        let target = &s.live[1].leg;
+        let budget = target.controller.stream_open_budget();
+        target
+            .controller
+            .end_stream(
+                &desired(Medium::Audio).logical_id,
+                target.controller.revision(),
+                deadline(),
+            )
+            .await
+            .unwrap();
+        let mut speaker = desired(Medium::Audio);
+        speaker.logical_id = StreamId::from_string("speaker-new");
+        target
+            .controller
+            .change(
+                target.controller.revision(),
