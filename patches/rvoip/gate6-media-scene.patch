+++ b/crates/foundation/rvoip-core/src/staged_streams/scene_consumer.rs
@@ -0,0 +1,172 @@
+//! General managed-scene admission, independent of audio speaking permission.
+use super::*;
+use rvoip_core_traits::peer_switch::PeerDeliveryGuard;
+struct SceneState {
+    active: bool,
+    started: Instant,
+    ticket: PeerRouteTicket,
+}
+pub(crate) struct SceneConsumer {
+    pub(super) scene: u128,
+    state: Mutex<SceneState>,
+    pub(super) cancel: CancellationToken,
+}
+impl SceneConsumer {
+    pub(super) fn new(scene: u128) -> Arc<Self> {
+        Arc::new(Self {
+            scene,
+            state: Mutex::new(SceneState {
+                active: false,
+                started: Instant::now(),
+                ticket: PeerRouteTicket::initial(),
+            }),
+            cancel: CancellationToken::new(),
+        })
+    }
+    pub(super) fn activate(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.active = true;
+        state.started = Instant::now();
+    }
+    pub(super) fn retire(&self) {
+        self.cancel.cancel();
+        let mut s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        s.active = false;
+        s.ticket.retire_if_current();
+    }
+    pub(super) fn accepts(self: &Arc<Self>, stamp: &SceneStamp) -> bool {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.active
+            && !self.cancel.is_cancelled()
+            && stamp.ticket.is_current()
+            && Weak::ptr_eq(&stamp.owner, &Arc::downgrade(self))
+    }
+    pub(super) fn receives_at(&self, source: Option<&SceneStamp>, admitted: Instant) -> bool {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.active
+            && !self.cancel.is_cancelled()
+            && admitted >= state.started
+            && source.is_some_and(|s| {
+                s.scene == self.scene && !s.cancel.is_cancelled() && s.ticket.is_current()
+            })
+    }
+    fn stamp(self: &Arc<Self>) -> SceneStamp {
+        let s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        SceneStamp {
+            owner: Arc::downgrade(self),
+            ticket: s.ticket.clone(),
+            scene: self.scene,
+            started: s.started,
+            cancel: self.cancel.clone(),
+        }
+    }
+    fn begin(&self, stamp: &SceneStamp) -> ControlResult<PeerDeliveryGuard> {
+        let s = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if !s.active || self.cancel.is_cancelled() || !stamp.ticket.is_current() {
+            return Err(StreamControlError::NotReady);
+        }
+        stamp
+            .ticket
+            .try_begin_delivery()
+            .ok_or(StreamControlError::NotReady)
+    }
+}
+impl Drop for SceneConsumer {
+    fn drop(&mut self) {
+        self.retire();
+    }
+}
+#[derive(Clone)]
+pub(super) struct SceneStamp {
+    owner: Weak<SceneConsumer>,
+    ticket: PeerRouteTicket,
+    scene: u128,
+    started: Instant,
+    pub(super) cancel: CancellationToken,
+}
+pub(super) struct SceneCheck<'a> {
+    retained: Option<Option<&'a SceneStamp>>,
+    source: Option<Option<&'a SceneStamp>>,
+    admitted: Option<Instant>,
+}
+impl<'a> SceneCheck<'a> {
+    pub(super) fn publish() -> Self {
+        Self {
+            retained: None,
+            source: None,
+            admitted: None,
+        }
+    }
+    pub(super) fn retained_publish(stamp: Option<&'a SceneStamp>) -> Self {
+        Self {
+            retained: Some(stamp),
+            source: None,
+            admitted: None,
+        }
+    }
+    pub(super) fn receive(source: Option<&'a SceneStamp>, admitted: Instant) -> Self {
+        Self {
+            retained: None,
+            source: Some(source),
+            admitted: Some(admitted),
+        }
+    }
+    pub(super) fn retained_receive(
+        target: Option<&'a SceneStamp>,
+        source: Option<&'a SceneStamp>,
+        admitted: Instant,
+    ) -> Self {
+        Self {
+            retained: Some(target),
+            source: Some(source),
+            admitted: Some(admitted),
+        }
+    }
+}
+impl StreamController {
+    pub(super) fn scene_admission(
+        &self,
+        check: SceneCheck<'_>,
+    ) -> ControlResult<(Option<SceneStamp>, Option<PeerDeliveryGuard>)> {
+        let slot = self
+            .scene_consumer
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        let owner = match &*slot {
+            Some(weak) => Some(weak.upgrade().ok_or(StreamControlError::NotReady)?),
+            None => None,
+        };
+        let Some(owner) = owner else {
+            if check.retained.flatten().is_some() || check.source.flatten().is_some() {
+                return Err(StreamControlError::Authority);
+            }
+            return Ok((None, None));
+        };
+        if let Some(source) = check.source {
+            let source = source.ok_or(StreamControlError::Authority)?;
+            if source.scene != owner.scene
+                || source.cancel.is_cancelled()
+                || !source.ticket.is_current()
+                || source.owner.strong_count() == 0
+            {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        let stamp = match check.retained {
+            None => owner.stamp(),
+            Some(Some(stamp)) => stamp.clone(),
+            Some(None) => return Err(StreamControlError::NotReady),
+        };
+        if check
+            .admitted
+            .is_some_and(|admitted| admitted < stamp.started)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        if !Weak::ptr_eq(&stamp.owner, &Arc::downgrade(&owner)) {
+            return Err(StreamControlError::Authority);
+        }
+        let guard = owner.begin(&stamp)?;
+        Ok((Some(stamp), Some(guard)))
+    }
+}
