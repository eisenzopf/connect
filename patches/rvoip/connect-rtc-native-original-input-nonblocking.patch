+//! Actual CheckedMediaIngress -> Core queue custody. This does not model a
+//! signed peer, full replacement, decoder readiness or a transport wire pass.
+use super::*;
+use crate::substrate::CheckedMediaIngress;
+
+fn wanted(medium: Medium) -> DesiredStream {
+    DesiredStream { logical_id: StreamId::from_string("capture"), medium,
+        direction: StreamDirection::Both }
+}
+fn both_owner(name: &str) -> MediaOwner {
+    let mut value = owner(name);
+    let video = MediaCapability { medium: Medium::Video,
+        formats: vec![MediaFormat::Encoded { name: "vp8".into(), clock_rate_hz: 90000,
+            channels: 0, fmtp: None }] };
+    value.local.send.push(video.clone()); value.local.receive.push(video.clone());
+    value.remote.send.push(video.clone()); value.remote.receive.push(video);
+    value.send_media.insert(Medium::Video); value.receive_media.insert(Medium::Video);
+    value
+}
+#[derive(Default)]
+struct CaptureAdapter(Mutex<Option<AdapterMediaPort>>);
+#[async_trait]
+impl StagedMediaAdapter for CaptureAdapter {
+    async fn prepare(&self, ports: Vec<PortPreparation>, _: tokio::time::Instant, _: CancellationToken) -> ControlResult<()> {
+        for p in ports {
+            if p.is_new { p.port.install_cleanup(Arc::new(Cleanup))?; }
+            let pt = if p.port.binding().negotiated.requested.medium == Medium::Audio { 0 } else { 96 };
+            p.port.observe_ready(&p.port.binding().negotiated.format, true, true, Some(pt))?;
+            *self.0.lock().unwrap() = Some(p.port);
+        }
+        Ok(())
+    }
+}
+struct Held {
+    release: Option<std::sync::mpsc::SyncSender<()>>,
+    thread: Option<std::thread::JoinHandle<bool>>,
+}
+impl Held {
+    fn new(port: AdapterMediaPort) -> Self {
+        let (entered, ready) = std::sync::mpsc::sync_channel(0);
+        let (release, done) = std::sync::mpsc::sync_channel(0);
+        let thread = std::thread::spawn(move || port.with_port_state_exclusion_for_test(|| {
+            entered.send(()).unwrap();
+            done.recv_timeout(Duration::from_secs(1)).is_ok()
+        }));
+        ready.recv_timeout(Duration::from_secs(1)).unwrap();
+        Self { release: Some(release), thread: Some(thread) }
+    }
+    fn release(&mut self) -> bool {
+        if let Some(release) = self.release.take() { let _ = release.send(()); }
+        self.thread.take().is_some_and(|thread| thread.join().unwrap())
+    }
+}
+impl Drop for Held {
+    fn drop(&mut self) { if self.thread.is_some() { let _ = self.release(); } }
+}
