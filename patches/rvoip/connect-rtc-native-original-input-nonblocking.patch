+                    ("alice".into(), both_owner("alice")), ("bob".into(), both_owner("bob")),
+                ]))), busy: AtomicUsize::new(0), refused: AtomicUsize::new(0), revoked: AtomicBool::new(false),
+            });
+            let mut controllers = Vec::new();
+            let mut ports = Vec::new();
+            let work = std::panic::AssertUnwindSafe(async {
+                for name in ["alice", "bob"] {
+                    let adapter = Arc::new(CaptureAdapter::default());
+                    let controller = StreamController::new(
+                        ConversationId::from_string("conversation"), SessionId::from_string("session"),
+                        ConnectionId::from_string(name), principal(name), policy.clone(), adapter.clone(),
+                        Arc::new(StreamHandleAllocator::default()), 8,
+                    ).unwrap();
+                    controllers.push(controller.clone());
+                    controller.change(0, &[wanted(medium)], &BTreeSet::new(),
+                        tokio::time::Instant::now() + Duration::from_secs(2), CancellationToken::new()).await.unwrap();
+                    ports.push(adapter.0.lock().unwrap().as_ref().unwrap().clone());
+                }
+                if medium == Medium::Video {
+                    controllers[1].change_direct_subscriptions(controllers[1].revision(),
+                        direct_subscriptions::DirectSubscriptionChange::Subscribe(vec![
+                            direct_subscriptions::DirectSubscription::new(&controllers[0], wanted(medium).logical_id.clone(), wanted(medium).logical_id.clone()),
+                        ]), tokio::time::Instant::now() + Duration::from_secs(2), CancellationToken::new(), None).await.unwrap();
+                }
+                let mut input = controllers[0].take_ingress(&wanted(medium).logical_id).unwrap();
+                let mut output = ports[1].take_egress().unwrap();
+                let group = source_clock::Group::new();
+                let weak = ports[0].downgrade();
+                let clock = group.track(ports[0].binding().stream_local_id,
+                    if medium == Medium::Audio { 8000 } else { 90000 },
+                    Arc::new(move || weak.upgrade().is_some_and(|port| !port.ingress_is_closed()))).unwrap();
+                let counters = Arc::new(StagedRtpCounters::default());
+                let ingress = Arc::new(PortIngress {
+                    #[cfg(feature = "test-support")]
+                    video_diagnostic: None,
+                    feedback: None, clock, flow: None, port: ports[0].downgrade(), counters: counters.clone(),
+                });
+                let payload = if medium == Medium::Audio { Bytes::from(vec![0x80; 160]) } else {
+                    let mut header = rvoip_rtp_core::RtpHeader::new(96, 10, 90000, 777);
+                    header.marker = true;
+                    rvoip_rtp_core::RtpPacket::new(header, Bytes::from_static(&[0x10, 0, 10, 2])).serialize().unwrap()
+                };
+                let frame = MediaFrame { stream_id: ports[0].binding().transport_id.clone(),
+                    kind: if medium == Medium::Audio { StreamKind::Audio } else { StreamKind::Video },
+                    payload: payload.clone(), timestamp_rtp: 90000, captured_at: chrono::Utc::now(),
+                    payload_type: Some(if medium == Medium::Audio { 0 } else { 96 }), source_clock: None };
+                let original_at = std::time::Instant::now();
+                let captured_at = frame.captured_at;
+                let mut held = (phase == "capture").then(|| Held::new(ports[0].clone()));
+                let before = std::time::Instant::now();
+                let mut pending = ingress.clone().retain_rtp_observed_original(frame, 777, payload.len(), 10, original_at, None)
+                    .unwrap().expect("Busy must retain actual native raw custody");
+                assert!(before.elapsed() < Duration::from_millis(80));
+                if phase == "publish" { held = Some(Held::new(ports[0].clone())); }
+                assert_eq!(pending.try_publish(), None);
+                assert!(input.try_recv().is_err());
+                assert_eq!(counters.accepted.load(Ordering::Acquire), 0);
+                tokio::time::sleep(Duration::from_millis(if action == "expire" { 215 } else { 5 })).await;
+                assert!(input.try_recv().is_err());
+                if action == "revoke" { policy.revoked.store(true, Ordering::Release); }
+                assert!(held.as_mut().unwrap().release());
+                let result = pending.try_publish();
+                if action == "resume" {
+                    assert_eq!(result, Some(true));
+                    let packet = input.try_recv().unwrap();
+                    packet.try_forward_to(&controllers[1], &wanted(medium).logical_id).unwrap();
+                    let sent = Arc::new(Mutex::new(None)); let observed = sent.clone();
+                    output.try_recv().unwrap().deliver(move |frame| async move {
+                        *observed.lock().unwrap() = Some(frame); Ok(())
+                    }).await.unwrap();
+                    let delivered = sent.lock().unwrap().take().unwrap();
+                    assert_eq!(delivered.payload, payload);
+                    assert_eq!(delivered.timestamp_rtp, 90000);
+                    assert_eq!(delivered.captured_at, captured_at);
+                    assert_eq!(counters.accepted.load(Ordering::Acquire), 1);
+                    assert_eq!(counters.original_recovered.load(Ordering::Acquire), 1);
+                } else {
+                    assert_eq!(result, Some(false));
+                    assert_eq!(counters.accepted.load(Ordering::Acquire), 0);
+                }
+                drop(pending);
+                assert!(input.try_recv().is_err() && output.try_recv().is_err());
+                assert_eq!(counters.original_abandoned.load(Ordering::Acquire), 0);
+                assert!(counters.original_metadata_deferred.load(Ordering::Acquire)
+                    >= if phase == "capture" { 2 } else { 1 });
+            }).catch_unwind().await;
+            // Exact old holders drop/join on unwind before these actual owners.
+            policy.revoked.store(false, Ordering::Release);
+            for controller in &controllers {
+                assert_eq!(controller.shutdown(tokio::time::Instant::now() + Duration::from_secs(1)).await, 0);
+            }
+            if let Err(error) = work { std::panic::resume_unwind(error); }
+          }
+        }
+    }
+}
