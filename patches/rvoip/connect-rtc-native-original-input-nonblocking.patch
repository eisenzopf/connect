+#[tokio::test(flavor = "current_thread")]
+async fn rtc_held_port_state_keeps_shared_original_fanout_live_and_releases_once() {
+    for medium in [Medium::Audio, Medium::Video] {
+        let mut held = Fixture::new(medium).await;
+        let mut other = Fixture::new(medium).await;
+        other.source = held.source.clone();
+        let ports = Arc::new(DashMap::new());
+        let mut held_owner = BurstPortOwner::new(&held, &ports);
+        let mut other_owner = BurstPortOwner::new(&other, &ports);
+        let mut exclusion = HeldPort::start(held.port.clone());
+        let work = std::panic::AssertUnwindSafe(async {
+            let began = Instant::now();
+            let (bytes, capsule) = publish_exact(&held, &ports, 10, 90000);
+            if medium == Medium::Video { assert!(capsule.is_some()); }
+            assert!(began.elapsed() < Duration::from_millis(80), "shared raw fanout waited on PortState");
+            // This independent worker and actual current Core path must remain
+            // live while the first Port's genuine state is still excluded.
+            let (first, first_capsule) = deliver_exact(&mut other).await;
+            assert_eq!(first.payload, bytes);
+            assert_eq!(first.timestamp_rtp, 90000);
+            assert!(first.source_clock.as_ref().is_some_and(|clock|
+                clock.anchor.is_some_and(|anchor| anchor.ntp_time == 100 << 32) && (clock.is_current)()));
+            assert!(match (capsule.as_ref(), first_capsule.as_ref()) {
+                (None, None) => true,
+                (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+                _ => false,
+            });
+            tokio::time::sleep(Duration::from_millis(5)).await;
+            assert!(held.input.try_recv().is_err(), "held Port admitted original input");
+            assert_eq!(held.policy.original_attempts.load(Ordering::SeqCst), 0,
+                "no source policy grant may be acquired under Port exclusion");
+            assert!(exclusion.release(), "original holder reached its emergency fuse");
+            let (resumed, resumed_capsule) = deliver_exact(&mut held).await;
+            assert_eq!(resumed.payload, bytes);
+            assert_eq!(resumed.timestamp_rtp, 90000);
+            assert!(resumed.source_clock.as_ref().is_some_and(|clock|
+                clock.anchor.is_some_and(|anchor| anchor.ntp_time == 100 << 32) && (clock.is_current)()));
+            assert!(match (capsule.as_ref(), resumed_capsule.as_ref()) {
+                (None, None) => true,
+                (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+                _ => false,
+            });
+            assert!(held.input.try_recv().is_err() && other.input.try_recv().is_err(),
+                "same original was published more than once");
+        }).catch_unwind().await;
+        drop(exclusion); // join actual holder BEFORE cleanup, even on unwind
+        let held_clean = held_owner.close(&held).await;
+        let other_clean = other_owner.close(&other).await;
+        assert!(held_clean && other_clean && ports.is_empty());
+        if let Err(error) = work { std::panic::resume_unwind(error); }
+    }
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn rtc_raw_pending_port_preserves_original_age_and_terminal_refusal() {
+    for medium in [Medium::Audio, Medium::Video] {
+        for terminal in [false, true] {
+            let mut f = Fixture::new(medium).await;
+            let ports = Arc::new(DashMap::new());
+            let mut owner = BurstPortOwner::new(&f, &ports);
+            let mut exclusion = HeldPort::start(f.port.clone());
+            let work = std::panic::AssertUnwindSafe(async {
+                let began = Instant::now();
+                publish_exact(&f, &ports, 10, 90000);
+                assert!(began.elapsed() < Duration::from_millis(80));
+                if !terminal {
+                    // The SAME old input expires while pending; release cannot
+                    // redate it or inherit the first successor's source clock.
+                    tokio::time::sleep(Duration::from_millis(215)).await;
+                }
+                assert!(f.input.try_recv().is_err());
+                assert!(exclusion.release());
+                if terminal {
+                    // current_thread: retire synchronously before the ingress
+                    // task can retry after releasing the actual state holder.
+                    assert!(f.port.report_terminal().unwrap());
+                }
+                tokio::time::sleep(Duration::from_millis(8)).await;
+                assert!(f.input.try_recv().is_err(), "expired/retired raw input became public");
+                if !terminal {
+                    let (bytes, _) = publish_exact(&f, &ports, 20, 180000);
+                    let (fresh, _) = deliver_exact(&mut f).await;
+                    assert_eq!(fresh.timestamp_rtp, 180000);
+                    assert_eq!(fresh.payload, bytes);
+                    assert!(f.input.try_recv().is_err());
+                }
+            }).catch_unwind().await;
+            drop(exclusion);
+            let clean = owner.close(&f).await;
+            assert!(clean && ports.is_empty());
+            if let Err(error) = work { std::panic::resume_unwind(error); }
+        }
+    }
+}
