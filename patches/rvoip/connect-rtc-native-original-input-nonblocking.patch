+//! Real Core PortState exclusion and canonical raw fanout/ingress workers.
+//! No private Ready, final-cut authority or browser quality claim is modeled.
+use super::*;
+use futures::FutureExt as _;
+
+struct HeldPort {
+    release: Option<std::sync::mpsc::SyncSender<()>>,
+    holder: Option<std::thread::JoinHandle<bool>>,
+}
+impl HeldPort {
+    fn start(port: AdapterMediaPort) -> Self {
+        let (entered, ready) = std::sync::mpsc::sync_channel(0);
+        let (release, released) = std::sync::mpsc::sync_channel(0);
+        let holder = std::thread::spawn(move || {
+            port.with_port_state_exclusion_for_test(|| {
+                entered.send(()).unwrap();
+                // A failing implementation cannot leave its original holder
+                // alive indefinitely. Normal assertions use explicit release.
+                released.recv_timeout(Duration::from_secs(1)).is_ok()
+            })
+        });
+        ready.recv_timeout(Duration::from_secs(1)).unwrap();
+        Self { release: Some(release), holder: Some(holder) }
+    }
+    fn release(&mut self) -> bool {
+        if let Some(release) = self.release.take() { let _ = release.send(()); }
+        self.holder.take().is_some_and(|holder| holder.join().unwrap())
+    }
+}
+impl Drop for HeldPort {
+    fn drop(&mut self) {
+        if self.holder.is_some() { let _ = self.release(); }
+    }
+}
+
+async fn deliver_exact(f: &mut Fixture) -> (MediaFrame, Option<Arc<OriginalVideoFrame>>) {
+    let packet = tokio::time::timeout(Duration::from_millis(85), f.input.recv())
+        .await.unwrap().unwrap();
+    let capsule = packet.original_video_frame().cloned();
+    packet.try_forward_to(&f.b, &desired(f.medium).logical_id).unwrap();
+    let queued = f.output.try_recv().unwrap();
+    assert!(match (capsule.as_ref(), queued.original_video_frame()) {
+        (None, None) => true,
+        (Some(original), Some(queued)) => Arc::ptr_eq(original, queued),
+        _ => false,
+    });
+    let sent = Arc::new(Mutex::new(None));
+    let observed = sent.clone();
+    queued.deliver(move |frame| async move {
+        *observed.lock().unwrap() = Some(frame);
+        Ok(())
+    }).await.unwrap();
+    let frame = sent.lock().unwrap().take().unwrap();
+    (frame, capsule)
+}
+
+fn publish_exact(
+    f: &Fixture,
+    ports: &Arc<DashMap<StreamId, Arc<PortIo>>>,
+    sequence: u16,
+    timestamp: u32,
+) -> (Bytes, Option<Arc<OriginalVideoFrame>>) {
+    let (ready, _) = watch::channel(None);
+    let at = Instant::now();
+    let received = f.packet(sequence, timestamp);
+    let bytes = if f.medium == Medium::Audio {
+        received.packet.payload.clone()
+    } else {
+        received.packet.marshal().unwrap().freeze()
+    };
+    let capsule = if f.medium == Medium::Audio {
+        publish_source(received.packet, at, &f.source, ports, &ready);
+        None
+    } else {
+        let mut output = crate::media::video_reorder::ReorderOutput::default();
+        output.packets.push(original_video_packet(f, sequence, timestamp, at, false));
+        let mut mapper = original_video_mapper(&f.source, None);
+        publish_video(output, &mut mapper, &f.source, ports, &ready, &CancellationToken::new());
+        mapper.original_frame().cloned()
+    };
+    (bytes, capsule)
+}
