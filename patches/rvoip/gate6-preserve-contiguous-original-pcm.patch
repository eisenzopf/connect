+#[tokio::test]
+async fn guarded_mixer_contiguous_pcm_is_bounded_and_expired_original_samples_do_not_play() {
+    let s = Scene::new(&four()[..2], 8000).await;
+    s.bind(0, true).await;
+    s.bind(1, true).await;
+    let mut out = s.port(1).take_egress().unwrap();
+    // Three valid100msG711 packets arrive together. Retain at most200ms:
+    // exactly ten20ms outputs, beginning with the second original packet.
+    s.publish_duration(0, 1000, 0, 5);
+    s.publish_duration(0, 3000, 800, 5);
+    s.publish_duration(0, 7000, 1600, 5);
+    for expected in [3000, 3000, 3000, 3000, 3000, 7000, 7000, 7000, 7000, 7000] {
+        s.mixer.tick();
+        heard(out.try_recv().unwrap(), expected).await;
+    }
+    s.mixer.tick();
+    assert!(
+        out.try_recv().is_err(),
+        "PCM exceeded its200msbound or repeated original samples"
+    );
+    s.publish_at(0, 1000, 2400);
+    s.publish_at(0, 7000, 2560);
+    s.mixer.tick();
+    heard(out.try_recv().unwrap(), 1000).await;
+    drop(
+        s.policy
+            .0
+            .try_write()
+            .expect("idle pending PCM retained current authority"),
+    );
+    tokio::time::sleep(Duration::from_millis(210)).await;
+    s.mixer.tick();
+    assert!(out.try_recv().is_err(), "expired original PCM reached IO");
+    s.publish_at(0, 7000, 2720);
+    s.mixer.tick();
+    heard(out.try_recv().unwrap(), 7000).await;
+    s.mixer.tick();
+    assert!(out.try_recv().is_err(), "fresh recovery audio repeated");
+}
