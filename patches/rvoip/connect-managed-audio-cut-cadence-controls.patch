+//! Test-only steps of the ORIGINAL Conference worker/ticker, never a scheduler.
+use crate::ids::ConnectionId;
+use crate::staged_streams::media_scene::GuardedMediaScene;
+use crate::staged_streams::{ControlResult, StreamControlError};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, Weak};
+use tokio::sync::{Notify, Semaphore};
+
+pub(crate) type Slot = Arc<Mutex<Weak<State>>>;
+pub(crate) fn new_slot() -> Slot {
+    Arc::new(Mutex::new(Weak::new()))
+}
+
+pub(crate) struct State {
+    scene: Weak<GuardedMediaScene>,
+    until: tokio::time::Instant,
+    entered: AtomicUsize,
+    issued: AtomicUsize,
+    completed: AtomicUsize,
+    closed: AtomicBool,
+    expired: AtomicBool,
+    changed: Notify,
+    release: Notify,
+    permits: Semaphore,
+}
+/// Sole test owner; Drop releases an entered worker on assertion/unwind too.
+pub(crate) struct ControlledTicks {
+    state: Arc<State>,
+}
+pub(crate) fn arm(
+    slot: &Slot,
+    scene: Weak<GuardedMediaScene>,
+    until: tokio::time::Instant,
+) -> ControlResult<ControlledTicks> {
+    if tokio::time::Instant::now() >= until {
+        return Err(StreamControlError::Deadline);
+    }
+    let mut current = slot.lock().unwrap_or_else(|p| p.into_inner());
+    if current.upgrade().is_some() {
+        return Err(StreamControlError::Authority);
+    }
+    let state = Arc::new(State {
+        scene,
+        until,
+        entered: AtomicUsize::new(0),
+        issued: AtomicUsize::new(0),
+        completed: AtomicUsize::new(0),
+        closed: AtomicBool::new(false),
+        expired: AtomicBool::new(false),
+        changed: Notify::new(),
+        release: Notify::new(),
+        permits: Semaphore::new(0),
+    });
+    *current = Arc::downgrade(&state);
+    Ok(ControlledTicks { state })
+}
+impl ControlledTicks {
+    async fn reached(&self, counter: &AtomicUsize, n: usize) -> ControlResult<()> {
+        loop {
+            let changed = self.state.changed.notified();
+            if self.state.expired.load(Ordering::Acquire) {
+                return Err(StreamControlError::Deadline);
+            }
+            if counter.load(Ordering::Acquire) >= n {
+                return Ok(());
+            }
+            tokio::time::timeout_at(self.state.until, changed)
+                .await
+                .map_err(|_| StreamControlError::Deadline)?;
+        }
+    }
+    pub(crate) async fn entered(&self, n: usize) -> ControlResult<()> {
+        self.reached(&self.state.entered, n).await
+    }
+    pub(crate) async fn completed(&self, n: usize) -> ControlResult<()> {
+        self.reached(&self.state.completed, n).await
+    }
+    pub(crate) fn step(&mut self) -> ControlResult<()> {
+        if self.state.closed.load(Ordering::Acquire)
+            || tokio::time::Instant::now() >= self.state.until
+        {
+            return Err(StreamControlError::Deadline);
+        }
+        let issued = self.state.issued.load(Ordering::Acquire);
+        if self.state.entered.load(Ordering::Acquire) != issued + 1
+            || self.state.completed.load(Ordering::Acquire) != issued
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        let scene = self
+            .state
+            .scene
+            .upgrade()
+            .ok_or(StreamControlError::Cancelled)?;
+        // Same existing test clock: select one quantum, not wall-time/authority.
+        let now = std::time::Instant::now();
+        scene.observe_audio_tick_for_test(now, now);
+        self.state
+            .issued
+            .compare_exchange(issued, issued + 1, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| StreamControlError::NotReady)?;
+        self.state.permits.add_permits(1);
+        Ok(())
+    }
+    pub(crate) fn queues(&self, id: &ConnectionId) -> Option<(usize, bool, usize, usize)> {
+        self.state.scene.upgrade()?.audio_queue_state_for_test(id)
+    }
+    pub(crate) fn snapshot(&self) -> (usize, usize, usize, bool) {
+        (
+            self.state.entered.load(Ordering::Acquire),
+            self.state.issued.load(Ordering::Acquire),
+            self.state.completed.load(Ordering::Acquire),
+            self.state.expired.load(Ordering::Acquire),
+        )
+    }
+}
+impl Drop for ControlledTicks {
+    fn drop(&mut self) {
+        self.state.closed.store(true, Ordering::Release);
+        self.state.release.notify_waiters();
+    }
+}
+pub(crate) struct Completion {
+    state: Arc<State>,
+    ordinal: usize,
+}
+impl Completion {
+    pub(crate) fn complete(self) {
+        self.state.completed.store(self.ordinal, Ordering::Release);
+        self.state.changed.notify_waiters();
+    }
+}
+pub(crate) async fn enter(slot: &Slot) -> Option<Completion> {
+    let state = { slot.lock().unwrap_or_else(|p| p.into_inner()).upgrade() }?;
+    if state.closed.load(Ordering::Acquire) {
+        return None;
+    }
+    let ordinal = state.entered.fetch_add(1, Ordering::AcqRel) + 1;
+    state.changed.notify_waiters();
+    loop {
+        let released = state.release.notified();
+        if state.closed.load(Ordering::Acquire) {
+            break;
+        }
+        tokio::select! {biased;
+            _=released=>{},
+            _=tokio::time::sleep_until(state.until)=>{state.expired.store(true,Ordering::Release);state.closed.store(true,Ordering::Release);state.changed.notify_waiters();break;},
+            permit=state.permits.acquire()=>{permit.ok()?.forget();break;},
+        }
+    }
+    Some(Completion { state, ordinal })
+}
