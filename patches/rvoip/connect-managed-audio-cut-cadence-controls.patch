+async fn managed_tick_pcm_timestamp(
+    room: &mut ManagedRoom,
+    id: &ConnectionId,
+    expected: i16,
+) -> u32 {
+    let queued = room
+        .nodes
+        .get_mut(id)
+        .unwrap()
+        .out
+        .try_recv()
+        .expect("actual original managed output missing");
+    let result = Arc::new(std::sync::Mutex::new(None));
+    let received = result.clone();
+    queued
+        .deliver(move |frame| async move {
+            let mut decoder = rvoip_media_core::codec::factory::CodecFactory::create_codec(
+                0,
+                Some(8000),
+                Some(1),
+            )
+            .unwrap();
+            let pcm = decoder.decode(&frame.payload).unwrap();
+            assert_eq!(pcm.samples.len(), 160);
+            let mean =
+                pcm.samples.iter().map(|s| i32::from(*s)).sum::<i32>() / pcm.samples.len() as i32;
+            assert!(
+                (mean - i32::from(expected)).abs() < 400,
+                "actual source mismatch: expected {expected}, got {mean}"
+            );
+            *received.lock().unwrap() = Some(frame.timestamp_rtp);
+            Ok(())
+        })
+        .await
+        .unwrap();
+    let timestamp = result.lock().unwrap().take().unwrap();
+    timestamp
+}
