+#[tokio::test]
+async fn managed_cut_original_worker_distinguishes_first_fresh_ordinary_quantum_from_private_ready()
+{
+    use crate::orchestrator::participant_control::{
+        ManagedCutPostPublication, ManagedCutPublished,
+    };
+    for fresh_before_first_tick in [true, false] {
+        let mut room = ManagedRoom::new().await;
+        let mut owned_post: Option<ManagedCutPostPublication> = None;
+        let work = catch_original(async {
+            let ready = model_ready(&mut room).await;
+            let prepared = room
+                .orch
+                .prepare_staged_managed_cut(captured(&room, &ready).await)
+                .await
+                .unwrap();
+            let candidate = ready.grant.intent.replacement.clone();
+            let mut ticks = room
+                .orch
+                .control_managed_audio_ticks_for_test(&room.session, ready.grant.until)
+                .unwrap();
+            ticks.entered(1).await.unwrap();
+            for node in room.nodes.values_mut() {
+                node.drain();
+            }
+            room.nodes
+                .get_mut(&ready.old)
+                .unwrap()
+                .publish(800)
+                .unwrap();
+            ticks.step().unwrap();
+            ticks.completed(1).await.unwrap();
+            let before = managed_tick_pcm_timestamp(&mut room, &ready.retained, 800).await;
+            ticks.entered(2).await.unwrap();
+            for node in room.nodes.values_mut() {
+                node.drain();
+            }
+            // Actual candidate ingress still belongs to private preparation.
+            room.nodes
+                .get_mut(&candidate)
+                .unwrap()
+                .publish(5200)
+                .unwrap();
+            let private_sequence = room.nodes[&candidate].sequence;
+            assert!(ready._probe.has_duplex_io() && ready._audio.has_delivered_remote_audio());
+            assert_eq!(ticks.queues(&candidate), Some((0, false, 0, 0)));
+            room.nodes
+                .get_mut(&ready.old)
+                .unwrap()
+                .publish(800)
+                .unwrap();
+            assert_eq!(ticks.queues(&ready.old).unwrap().0, 1);
+            let revision = room.orch.participant_revision(&room.session).unwrap();
+            // This is the same current host-owned candidate view used by the
+            // existing managed successor controls, captured while OLD is live.
+            let actual_candidate = room.world.owner(&candidate).unwrap();
+            assert_eq!(
+                actual_candidate.connection.state(),
+                crate::relationships::BindingState::Active
+            );
+            assert!(
+                actual_candidate
+                    .connection
+                    .same_incarnation(ready.root.prepared_binding().binding())
+            );
+            let published = publish_ready(&room, &ready, prepared).await;
+            let ManagedCutPublished::Replacement { outcome, post, .. } = published else {
+                panic!("wrong managed publication")
+            };
+            owned_post = Some(post); // retain before any following assertion can unwind
+            assert_eq!(outcome.replaced, ready.old);
+            assert_eq!(outcome.admitted, candidate);
+            assert_eq!(
+                room.orch.participant_revision(&room.session).unwrap(),
+                revision + 1
+            );
+            assert!(ready.root.is_committed());
+            assert_eq!(room.orch.session_of(&ready.old), None);
+            assert!(room.nodes[&ready.old].controller.shutdown.is_cancelled());
+            assert!(
+                room.nodes
+                    .get_mut(&ready.old)
+                    .unwrap()
+                    .publish(9000)
+                    .is_err()
+            );
+            assert_eq!(room.nodes[&candidate].sequence, private_sequence);
+            assert_eq!(ticks.queues(&candidate), Some((0, false, 0, 0)));
+            // Finish the SAME real original post; never run a raw scene commit.
+            room.orch
+                .finish_managed_cut_publication(owned_post.take().unwrap())
+                .await
+                .unwrap();
+            // Project the genuine managed result into this controlled host.
+            // The committed model/route already owns the exact incarnation.
+            let mut resources = room.world.resources.lock().unwrap();
+            let resource = resources.get_mut(&candidate).unwrap();
+            let controller = &room.nodes[&candidate].controller;
+            assert!(
+                resource
+                    .owner
+                    .connection
+                    .same_incarnation(&actual_candidate.connection)
+            );
+            assert!(resource.pending.as_ref().is_some_and(|pending| {
+                pending
+                    .binding()
+                    .same_incarnation(&actual_candidate.connection)
+            }));
+            assert!(
+                resource
+                    .proof
+                    .as_ref()
+                    .is_some_and(|proof| proof.is_committed() && proof.belongs_to(controller))
+            );
+            assert!(
+                controller
+                    .origin_binding
+                    .same_incarnation(&actual_candidate.connection)
+            );
+            *resource = Resource {
+                owner: actual_candidate,
+                proof: None,
+                pending: None,
+                probe_operation: None,
+            };
+            drop(resources);
+            if fresh_before_first_tick {
+                room.nodes
+                    .get_mut(&candidate)
+                    .unwrap()
+                    .publish(6800)
+                    .unwrap();
+                assert_eq!(ticks.queues(&candidate).unwrap().0, 1);
+            }
+            ticks.step().unwrap();
+            ticks.completed(2).await.unwrap();
+            if !fresh_before_first_tick {
+                assert!(
+                    room.nodes
+                        .get_mut(&ready.retained)
+                        .unwrap()
+                        .out
+                        .try_recv()
+                        .is_err(),
+                    "private or retired old PCM crossed the actual managed cut"
+                );
+                ticks.entered(3).await.unwrap();
+                room.nodes
+                    .get_mut(&candidate)
+                    .unwrap()
+                    .publish(6800)
+                    .unwrap();
+                assert_eq!(ticks.queues(&candidate).unwrap().0, 1);
+                ticks.step().unwrap();
+                ticks.completed(3).await.unwrap();
+            }
+            let after = managed_tick_pcm_timestamp(&mut room, &ready.retained, 6800).await;
+            assert!(
+                room.nodes
+                    .get_mut(&ready.retained)
+                    .unwrap()
+                    .out
+                    .try_recv()
+                    .is_err()
+            );
+            let observed = ticks.snapshot();
+            assert!(!observed.3, "original tick control expired");
+            drop(ticks); // releases a next entered original worker before shutdown
+            (before, after, fresh_before_first_tick, observed)
+        })
+        .await;
+        let post_joined = if let Some(post) = owned_post.take() {
+            matches!(
+                catch_original(room.orch.finish_managed_cut_publication(post)).await,
+                Ok(Ok(()))
+            )
+        } else {
+            true
+        };
+        let cleanup = room.close_originals().await;
+        assert!(
+            post_joined && cleanup.iter().all(|joined| *joined),
+            "all actual managed originals/post must join: {cleanup:?}"
+        );
+        let (before, after, fresh_before_first_tick, ticks) = match work {
+            Ok(v) => v,
+            Err(error) => resume_unwind(error),
+        };
+        let expected = if fresh_before_first_tick { 160 } else { 320 };
+        assert_eq!(
+            after.wrapping_sub(before),
+            expected,
+            "actual ManagedCut cadence baseline fresh_before_first_tick={fresh_before_first_tick}"
+        );
+        eprintln!(
+            "managed_original_worker_audio_cut fresh_before_first_tick={fresh_before_first_tick} old_rtp={before} new_rtp={after} delta={} controlled_ticks={ticks:?} originals_joined=true",
+            after.wrapping_sub(before)
+        );
+    }
+}
