+pub(in crate::v2) enum DeliveryOrigin {
+    Subscription(SubscriptionOrigin),
+    Data(DataOrigin),
+}
+impl DeliveryOrigin {
+    pub(in crate::v2) fn current(&self) -> bool {
+        match self {
+            Self::Subscription(s) => s.current(),
+            Self::Data(s) => s.current(),
+        }
+    }
+    pub(in crate::v2) fn incarnation(&self) -> uuid::Uuid {
+        match self {
+            Self::Subscription(s) => s.incarnation(),
+            Self::Data(s) => s.origin.incarnation,
+        }
+    }
+    pub(in crate::v2) fn cancellation(&self) -> CancellationToken {
+        match self {
+            Self::Subscription(s) => s.cancellation(),
+            Self::Data(s) => s.origin.lifetime.clone(),
+        }
+    }
+}
+pub(in crate::v2) struct DataPending {
+    pub admission: Arc<AdmittedData>,
+    pub started: Arc<AtomicBool>,
+    _bytes: OwnedSemaphorePermit,
+}
+impl Drop for DataPending {
+    fn drop(&mut self) {
+        self.admission.cancel();
+    }
+}
+/// Local reliable-writer completion only. It is not a durable or remote receipt.
+pub struct DataSubmission {
+    pub envelope_id: Identifier,
+}
+pub struct DataReceipt {
+    receiver: oneshot::Receiver<Result<(), DispatchError>>,
+    admission: Arc<AdmittedData>,
+    started: Arc<AtomicBool>,
+    id: Identifier,
+    _cancel: DataCancellation,
+}
+impl DataReceipt {
+    pub async fn wait(self) -> Result<DataSubmission, DispatchError> {
+        self.wait_or_cancel(CancellationToken::new()).await
+    }
+    pub(crate) async fn wait_or_cancel(
+        mut self,
+        cancel: CancellationToken,
+    ) -> Result<DataSubmission, DispatchError> {
+        let result = tokio::select! {biased;
+            r=&mut self.receiver=>Some(r),
+            _=self.admission.cancelled()=>None,
+            _=cancel.cancelled()=>None,
+        };
+        if !matches!(result, Some(Ok(Ok(())))) {
+            self.admission.cancel();
+        }
+        let unknown = || {
+            if self.started.load(Ordering::Acquire) {
+                DispatchError::SubmissionUnknown
+            } else {
+                DispatchError::Closed
+            }
+        };
+        match result {
+            Some(r) => r.unwrap_or_else(|_| Err(unknown())),
+            None => Err(unknown()),
+        }
+        .map(|_| DataSubmission {
+            envelope_id: self.id.clone(),
+        })
+    }
+}
+
+impl HandlerDelivery {
+    pub(crate) fn new_data(
+        origin: &DataOrigin,
+        admission: Arc<AdmittedData>,
+        budget: Arc<Semaphore>,
+    ) -> Result<(Self, DataReceipt), DispatchError> {
+        let cancellation = admission.cancel_on_drop();
+        if !origin.current()
+            || !origin.is_ready()
+            || !origin.matches(&admission)
+            || !admission.current()
+        {
+            admission.cancel();
+            return Err(DispatchError::Closed);
+        }
+        let envelope = origin.envelope(&admission)?;
+        let cost = serde_json::to_vec(envelope.original())
+            .map_err(|_| DispatchError::Capacity)?
+            .len()
+            .checked_add(4096)
+            .ok_or(DispatchError::Capacity)?;
+        if cost > super::super::MAX_ENVELOPE_BYTES {
+            return Err(DispatchError::Capacity);
+        }
+        let bytes = budget
+            .try_acquire_many_owned(u32::try_from(cost).map_err(|_| DispatchError::Capacity)?)
+            .map_err(|_| DispatchError::Capacity)?;
+        let id = Identifier::try_from(envelope.id().to_owned())?;
+        let frames = HandlerReplies::new(vec![envelope])?;
+        let started = Arc::new(AtomicBool::new(false));
+        let (sender, receiver) = oneshot::channel();
+        let deadline = admission.deadline().min(origin.origin.deadline);
+        let checked = admission.clone();
+        let bound = origin.clone();
+        let authority = AuthorityLease::checking(admission.clone(), deadline, move || {
+            checked.current() && bound.current()
+        });
+        let receipt = DataReceipt {
+            receiver,
+            _cancel: cancellation,
+            admission: admission.clone(),
+            started: started.clone(),
+            id,
+        };
+        Ok((
+            Self {
+                origin: DeliveryOrigin::Data(origin.clone()),
+                frames: Some(frames),
+                authority: Some(authority),
+                completion: Some(sender),
+                data: Some(DataPending {
+                    admission,
+                    started,
+                    _bytes: bytes,
+                }),
+                deadline,
+            },
+            receipt,
+        ))
+    }
+}
