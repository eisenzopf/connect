+//! Canonical reliable data shares the physical writer, quota and lifetime.
+use crate::{
+    staged_media::*,
+    v2::{auth_dispatch::*, Envelope},
+};
+use async_trait::async_trait;
+use futures::{
+    future::{BoxFuture, Shared},
+    FutureExt,
+};
+use rvoip_core::{identity::PrincipalOwnershipKey, ids::*, staged_streams::*, stream_lifecycle::*};
+use std::sync::{
+    atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering},
+    Arc, Mutex, Weak,
+};
+use tokio::sync::{mpsc, OwnedSemaphorePermit, Semaphore};
+use tokio_util::sync::CancellationToken;
+
+const DATA_JOBS: usize = 8;
+const SOURCE_BYTES: usize = 16 * 1024 * 1024;
+const WRITER_BYTES: usize = 8 * 1024 * 1024;
+/// Resource custody only. No authorization is stored in an idle physical queue.
+pub(crate) struct PhysicalData {
+    sender: mpsc::Sender<HandlerDelivery>,
+    receiver: Mutex<Option<mpsc::Receiver<HandlerDelivery>>>,
+    claimed: AtomicBool,
+    pub(crate) source_bytes: Arc<Semaphore>,
+    writer_bytes: Arc<Semaphore>,
+    ports: Arc<Semaphore>,
+    next: AtomicU32,
+}
+impl PhysicalData {
+    pub(crate) fn new() -> Arc<Self> {
+        let (sender, receiver) = mpsc::channel(DATA_JOBS);
+        Arc::new(Self {
+            sender,
+            receiver: Mutex::new(Some(receiver)),
+            claimed: AtomicBool::new(false),
+            source_bytes: Arc::new(Semaphore::new(SOURCE_BYTES)),
+            writer_bytes: Arc::new(Semaphore::new(WRITER_BYTES)),
+            ports: Arc::new(Semaphore::new(16)),
+            next: AtomicU32::new(1),
+        })
+    }
+    pub(crate) fn claimed(&self) -> bool {
+        self.claimed.load(Ordering::Acquire)
+    }
+    pub(crate) fn wrap(
+        self: &Arc<Self>,
+        app: Arc<dyn AuthenticatedHandler>,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        let receiver = self
+            .receiver
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .take()
+            .ok_or(DispatchError::Capacity)?;
+        self.claimed.store(true, Ordering::Release);
+        Ok(Arc::new(DataHandler {
+            app,
+            state: tokio::sync::Mutex::new(DeliveryState {
+                application: None,
+                receiver,
+                prefer_data: false,
+            }),
+        }))
+    }
+    fn submit(
+        &self,
+        origin: &DataOrigin,
+        admission: Arc<rvoip_core::staged_streams::reliable_data::AdmittedData>,
+    ) -> Result<DataReceipt, DispatchError> {
+        let (delivery, receipt) =
+            HandlerDelivery::new_data(origin, admission, self.writer_bytes.clone())?;
+        self.sender.try_send(delivery).map_err(|e| match e {
+            mpsc::error::TrySendError::Full(_) => DispatchError::Capacity,
+            mpsc::error::TrySendError::Closed(_) => DispatchError::Closed,
+        })?;
+        Ok(receipt)
+    }
+    pub(crate) fn handles(
+        self: &Arc<Self>,
+        owner: PrincipalOwnershipKey,
+    ) -> Arc<StreamHandleAllocator> {
+        StreamHandleAllocator::shared(Arc::new(WssAllocator {
+            physical: self.clone(),
+            owner,
+        }))
+    }
+}
+struct DeliveryState {
+    application: Option<BoxFuture<'static, Result<HandlerDelivery, DispatchError>>>,
+    receiver: mpsc::Receiver<HandlerDelivery>,
+    prefer_data: bool,
+}
+struct DataHandler {
+    app: Arc<dyn AuthenticatedHandler>,
+    state: tokio::sync::Mutex<DeliveryState>,
+}
+#[async_trait]
+impl AuthenticatedHandler for DataHandler {
+    async fn handle(&self, e: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        self.app.handle(e).await
+    }
+    async fn handle_replies(&self, e: AuthorizedEnvelope) -> Result<HandlerReplies, DispatchError> {
+        self.app.handle_replies(e).await
+    }
+    async fn next_delivery(&self) -> Result<HandlerDelivery, DispatchError> {
+        let mut state = self.state.lock().await;
+        if state.application.is_none() {
+            let app = self.app.clone();
+            state.application = Some(async move { app.next_delivery().await }.boxed());
+        }
+        let prefer_data = state.prefer_data;
+        let DeliveryState {
+            application,
+            receiver,
+            ..
+        } = &mut *state;
+        // Preserve an unselected in-flight application page, and alternate
+        // ready families so an event backlog cannot starve native data.
+        let (result, from_data) = if prefer_data {
+            tokio::select! {biased;
+                data=receiver.recv()=>(data.ok_or(DispatchError::Closed),true),
+                result=application.as_mut().expect("retained delivery")=>(result,false),
+            }
+        } else {
+            tokio::select! {biased;
+                result=application.as_mut().expect("retained delivery")=>(result,false),
+                data=receiver.recv()=>(data.ok_or(DispatchError::Closed),true),
+            }
+        };
+        if !from_data {
+            state.application = None;
+        }
+        state.prefer_data = !from_data;
+        result
+    }
+}
+struct WssAllocator {
+    physical: Arc<PhysicalData>,
+    owner: PrincipalOwnershipKey,
+}
+struct WssHandle {
+    physical: Weak<PhysicalData>,
+    owner: PrincipalOwnershipKey,
+    id: u16,
+}
+#[async_trait]
+impl MediaPortCleanup for WssHandle {
+    async fn close(&self) -> ControlResult<()> {
+        Ok(())
+    }
+}
+impl StreamHandleReserver for WssAllocator {
+    fn reserve(&self) -> ControlResult<StreamHandleAllocation> {
+        let id = self
+            .physical
+            .next
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| {
+                if n <= u16::MAX as u32 {
+                    Some(n + 1)
+                } else {
+                    None
+                }
+            })
+            .map_err(|_| MediaTransitionError::Capacity)? as u16;
+        let handle = Arc::new(WssHandle {
+            physical: Arc::downgrade(&self.physical),
+            owner: self.owner.clone(),
+            id,
+        });
+        Ok(StreamHandleAllocation::new(id, handle.clone())?.with_unprepared_cleanup(handle))
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DataDisposition {
+    NotStarted,
+    LocalWritten,
+    SubmissionUnknown,
+}
+#[derive(Clone)]
+pub struct NativeDataOutcome {
+    pub operation_id: String,
+    pub message_id: MessageId,
+    pub source: ConnectionId,
+    pub target: ConnectionId,
+    pub disposition: DataDisposition,
+}
+impl std::fmt::Debug for NativeDataOutcome {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("NativeDataOutcome(redacted)")
+    }
+}
+fn flush_outcome(
+    pending: &Mutex<std::collections::VecDeque<NativeDataOutcome>>,
+    observer: &dyn StagedDataNegotiator,
+    scope: &StagedRtpScope,
+) -> ControlResult<()> {
+    loop {
+        let outcome = pending
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .front()
+            .cloned();
+        let Some(outcome) = outcome else {
+            return Ok(());
+        };
+        observer.observe(scope, &outcome)?;
+        pending
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .pop_front();
+    }
+}
+#[async_trait]
+pub trait StagedDataNegotiator: Send + Sync {
+    /// Idempotently record local submission/uncertainty in the installed
+    /// application's existing operation/outbox journal. Never a remote ACK.
+    /// Nonblocking; no engine reentry. Failure retains cleanup ownership/quota
+    /// until this exact stable message/operation observation can be recorded.
+    fn observe(&self, scope: &StagedRtpScope, outcome: &NativeDataOutcome) -> ControlResult<()>;
+    /// Exact scope/correlation/capabilities and observed peer readiness are the
+    /// installed application's responsibility, exactly as for staged RTP.
+    async fn prepare(
+        &self,
+        scope: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<Vec<ReadyMediaBinding>>;
+    async fn confirm(
+        &self,
+        scope: &StagedRtpScope,
+        answers: &[ReadyMediaBinding],
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()>;
+}
+#[derive(Default)]
+pub struct StagedDataCounters {
+    accepted: AtomicU64,
+    submitted: AtomicU64,
+    written: AtomicU64,
+    not_started: AtomicU64,
+    unknown: AtomicU64,
+}
+#[derive(Clone, Copy, Debug)]
+pub struct StagedDataSnapshot {
+    pub ingress_accepted: u64,
+    /// Attempts admitted to the bounded physical data mailbox, before IO.
+    pub writer_submissions: u64,
+    pub local_writes: u64,
+    pub not_started_attempts: u64,
+    pub submission_unknown: u64,
+}
+impl StagedDataCounters {
+    pub fn snapshot(&self) -> StagedDataSnapshot {
+        StagedDataSnapshot {
+            ingress_accepted: self.accepted.load(Ordering::Acquire),
+            writer_submissions: self.submitted.load(Ordering::Acquire),
+            local_writes: self.written.load(Ordering::Acquire),
+            not_started_attempts: self.not_started.load(Ordering::Acquire),
+            submission_unknown: self.unknown.load(Ordering::Acquire),
+        }
+    }
+}
+struct DataResource {
+    allocation: Arc<dyn MediaPortCleanup>,
+    cancel: CancellationToken,
+    task: Mutex<Option<Shared<BoxFuture<'static, Result<(), ()>>>>>,
+    // Exact physical active-data-port quota, retained until cleanup confirms.
+    slot: Mutex<Option<OwnedSemaphorePermit>>,
+    pending: Arc<Mutex<std::collections::VecDeque<NativeDataOutcome>>>,
+    observer: Arc<dyn StagedDataNegotiator>,
+    scope: StagedRtpScope,
+    streams: Arc<dashmap::DashMap<StreamId, Arc<dyn rvoip_core::stream::MediaStream>>>,
+    stream: Mutex<Option<Weak<dyn rvoip_core::stream::MediaStream>>>,
+    stream_id: StreamId,
+}
+#[async_trait]
+impl MediaPortCleanup for DataResource {
+    async fn close(&self) -> ControlResult<()> {
+        self.cancel.cancel();
+        let task = self.task.lock().unwrap_or_else(|p| p.into_inner()).clone();
+        if let Some(task) = task {
+            task.await
+                .map_err(|_| StreamControlError::CleanupUnconfirmed)?;
+            self.task.lock().unwrap_or_else(|p| p.into_inner()).take();
+        }
+        flush_outcome(&self.pending, self.observer.as_ref(), &self.scope)
+            .map_err(|_| StreamControlError::CleanupUnconfirmed)?;
+        self.allocation.close().await?;
+        if let Some(stream) = self
+            .stream
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .and_then(Weak::upgrade)
+        {
+            self.streams
+                .remove_if(&self.stream_id, |_, value| Arc::ptr_eq(value, &stream));
+        }
+        self.stream.lock().unwrap_or_else(|p| p.into_inner()).take();
+        self.slot.lock().unwrap_or_else(|p| p.into_inner()).take();
+        Ok(())
+    }
+}
+pub(crate) struct StagedNativeData {
+    scope: StagedRtpScope,
+    router: Option<Arc<crate::substrate::PeerMediaRouter>>,
+    physical: Arc<PhysicalData>,
+    negotiator: Arc<dyn StagedDataNegotiator>,
+    lifetime: CancellationToken,
+    origin: Arc<Mutex<Option<DataOrigin>>>,
+    ports: Arc<Mutex<std::collections::BTreeMap<StreamId, WeakAdapterMediaPort>>>,
+    counters: Arc<StagedDataCounters>,
+    streams: Arc<dashmap::DashMap<StreamId, Arc<dyn rvoip_core::stream::MediaStream>>>,
+}
+impl StagedNativeData {
+    pub(crate) fn new(
+        scope: StagedRtpScope,
+        router: Option<Arc<crate::substrate::PeerMediaRouter>>,
+        physical: Arc<PhysicalData>,
+        negotiator: Arc<dyn StagedDataNegotiator>,
+        lifetime: CancellationToken,
+        streams: Arc<dashmap::DashMap<StreamId, Arc<dyn rvoip_core::stream::MediaStream>>>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            scope,
+            router,
+            physical,
+            negotiator,
+            lifetime,
+            origin: Arc::new(Mutex::new(None)),
+            ports: Arc::new(Mutex::new(std::collections::BTreeMap::new())),
+            counters: Arc::new(StagedDataCounters::default()),
+            streams,
+        })
+    }
+    pub(crate) fn origin(&self, origin: DataOrigin) {
+        let mut current = self.origin.lock().unwrap_or_else(|p| p.into_inner());
+        if current
+            .as_ref()
+            .is_some_and(|old| old.current() && old.same_binding(&origin))
+        {
+            origin.retire();
+            return;
+        }
+        if let Some(old) = current.replace(origin) {
+            old.retire();
+        }
+    }
+    pub(crate) fn scope(&self) -> &StagedRtpScope {
+        &self.scope
+    }
+    pub(crate) fn queued(&self) -> usize {
+        self.ports
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .values()
+            .filter_map(WeakAdapterMediaPort::upgrade)
+            .filter(|p| p.status() == PortStatus::Active)
+            .map(|p| {
+                let (max, free) = p.egress_capacity();
+                max - free
+            })
+            .sum()
+    }
+    pub(crate) fn counters(&self) -> Arc<StagedDataCounters> {
+        self.counters.clone()
+    }
+    pub(crate) fn publish(
+        &self,
+        data: &rvoip_core::staged_streams::reliable_data::StagedData,
+        held: &AuthorizedEnvelope,
+    ) -> ControlResult<()> {
+        let ports = self
+            .ports
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .values()
+            .filter_map(WeakAdapterMediaPort::upgrade)
+            .filter(|p| {
+                p.status() == PortStatus::Active
+                    && p.binding().negotiated.requested.logical_id.as_str() == data.message().label
+            })
+            .collect::<Vec<_>>();
+        if ports.len() != 1 {
+            return Err(StreamControlError::NotReady);
+        }
+        ports[0].try_publish_data(data, Some(held))?;
+        self.counters.accepted.fetch_add(1, Ordering::AcqRel);
+        Ok(())
+    }
+    fn allocation(&self, port: &AdapterMediaPort) -> ControlResult<Arc<dyn MediaPortCleanup>> {
+        match &self.router {
+            Some(router) => crate::staged_media::data_allocation(port, &self.scope, router),
+            None => {
+                let handle = port
+                    .allocation_owner()?
+                    .downcast::<WssHandle>()
+                    .map_err(|_| StreamControlError::Authority)?;
+                if handle.id != port.binding().stream_local_id
+                    || handle.owner != self.scope.owner
+                    || !Weak::ptr_eq(&handle.physical, &Arc::downgrade(&self.physical))
+                {
+                    return Err(StreamControlError::Authority);
+                }
+                Ok(handle)
+            }
+        }
+    }
+}
+#[async_trait]
+impl StagedMediaAdapter for StagedNativeData {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        if self
+            .origin
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .as_ref()
+            .is_none_or(|origin| !origin.current())
+        {
+            return Err(StreamControlError::NotReady);
+        }
+        if !self.physical.claimed() || self.lifetime.is_cancelled() {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut pending = Vec::new();
+        for preparation in ports {
+            let p = preparation.port;
+            let (_, session, connection) = p.context_ids()?;
+            if session != self.scope.session
+                || connection != self.scope.connection
+                || p.binding().negotiated.requested.medium != Medium::Data
+                || !matches!(
+                    p.binding().negotiated.format,
+                    MediaFormat::ReliableOrdered(_)
+                )
+                || p.binding().negotiated.requested.logical_id.as_str().len()
+                    > rvoip_core::MAX_DATA_LABEL_BYTES
+            {
+                return Err(StreamControlError::Unsupported);
+            }
+            let allocation = self.allocation(&p)?;
+            if !preparation.is_new {
+                continue;
+            }
+            let slot = self
+                .physical
+                .ports
+                .clone()
+                .try_acquire_owned()
+                .map_err(|_| MediaTransitionError::Capacity)?;
+            let resource = Arc::new(DataResource {
+                allocation,
+                cancel: self.lifetime.child_token(),
+                task: Mutex::new(None),
+                slot: Mutex::new(Some(slot)),
+                pending: Arc::new(Mutex::new(std::collections::VecDeque::new())),
+                observer: self.negotiator.clone(),
+                scope: self.scope.clone(),
+                streams: self.streams.clone(),
+                stream: Mutex::new(None),
+                stream_id: p.binding().transport_id.clone(),
+            });
+            p.install_cleanup(resource.clone())?;
+            p.require_data_messages()?;
+            pending.push((p, resource));
+        }
+        if pending.is_empty() {
+            return Ok(());
+        }
+        let offers = pending
+            .iter()
+            .map(|(p, _)| p.binding().clone())
+            .collect::<Vec<_>>();
+        let answers = self
+            .negotiator
+            .prepare(&self.scope, &offers, deadline, cancel.clone())
+            .await?;
+        if answers.len() != offers.len() {
+            return Err(StreamControlError::NotReady);
+        }
+        let mut used = std::collections::HashSet::new();
+        for a in &answers {
+            if !used.insert(a.transport_id.clone())
+                || !offers
+                    .iter()
+                    .any(|o| crate::staged_media::same_binding(o, a))
+            {
+                return Err(StreamControlError::NotReady);
+            }
+        }
+        for (port, resource) in pending {
+            if cancel.is_cancelled() || self.lifetime.is_cancelled() {
+                return Err(StreamControlError::Cancelled);
+            }
+            let binding = answers
+                .iter()
+                .find(|a| a.transport_id == port.binding().transport_id)
+                .ok_or(StreamControlError::NotReady)?;
+            let stream = crate::staged_media::data_stream(port.clone());
+            if self.streams.contains_key(&port.binding().transport_id) {
+                return Err(StreamControlError::NotReady);
+            }
+            *resource.stream.lock().unwrap_or_else(|p| p.into_inner()) =
+                Some(Arc::downgrade(&stream));
+            self.streams
+                .insert(port.binding().transport_id.clone(), stream);
+            let mut receiver = if binding.sink_ready {
+                Some(port.take_egress()?)
+            } else {
+                None
+            };
+            let physical = self.physical.clone();
+            let origin = self.origin.clone();
+            let cancelled = resource.cancel.clone();
+            let weak = port.downgrade();
+            let counters = self.counters.clone();
+            let pending_outcome = resource.pending.clone();
+            let observer = self.negotiator.clone();
+            let scope = self.scope.clone();
+            let task = tokio::spawn(async move {
+                let identify = |q: &QueuedMedia, disposition: DataDisposition| {
+                    q.data_identity().and_then(|id| {
+                        id.operation_id.map(|operation_id| NativeDataOutcome {
+                            operation_id,
+                            message_id: id.message_id,
+                            source: id.source.connection,
+                            target: scope.connection.clone(),
+                            disposition,
+                        })
+                    })
+                };
+                'messages: loop {
+                    let next = async {
+                        match receiver.as_mut() {
+                            Some(rx) => rx.recv().await,
+                            None => std::future::pending().await,
+                        }
+                    };
+                    let queued = tokio::select! {biased;_=cancelled.cancelled()=>break,q=next=>match q{Some(q)=>q,None=>break}};
+                    let Some(mut outcome) = identify(&queued, DataDisposition::NotStarted) else {
+                        break;
+                    };
+                    // Keep original identity under transient permission/queue
+                    // contention. A retired source cannot block later messages.
+                    loop {
+                        if cancelled.is_cancelled() || !queued.data_route_current() {
+                            pending_outcome
+                                .lock()
+                                .unwrap_or_else(|p| p.into_inner())
+                                .push_back(outcome);
+                            break;
+                        }
+                        let current = origin.lock().unwrap_or_else(|p| p.into_inner()).clone();
+                        let result = match current {
+                            Some(origin) if origin.current() && origin.is_ready() => {
+                                match queued.admit_data() {
+                                    Ok(admission) => {
+                                        physical.submit(&origin, admission).inspect(|_| {
+                                            counters.submitted.fetch_add(1, Ordering::AcqRel);
+                                        })
+                                    }
+                                    Err(_) => Err(DispatchError::AuthorityUnavailable),
+                                }
+                            }
+                            _ => Err(DispatchError::AuthorityUnavailable),
+                        };
+                        match result {
+                            Ok(receipt) => match receipt.wait_or_cancel(cancelled.clone()).await {
+                                Ok(_) => {
+                                    counters.written.fetch_add(1, Ordering::AcqRel);
+                                    outcome.disposition = DataDisposition::LocalWritten;
+                                    pending_outcome
+                                        .lock()
+                                        .unwrap_or_else(|p| p.into_inner())
+                                        .push_back(outcome);
+                                    break;
+                                }
+                                Err(DispatchError::SubmissionUnknown) => {
+                                    counters.unknown.fetch_add(1, Ordering::AcqRel);
+                                    outcome.disposition = DataDisposition::SubmissionUnknown;
+                                    pending_outcome
+                                        .lock()
+                                        .unwrap_or_else(|p| p.into_inner())
+                                        .push_back(outcome);
+                                    break;
+                                }
+                                Err(_) => {
+                                    counters.not_started.fetch_add(1, Ordering::AcqRel);
+                                }
+                            },
+                            Err(_) => {
+                                counters.not_started.fetch_add(1, Ordering::AcqRel);
+                            }
+                        }
+                        tokio::select! {_=cancelled.cancelled()=>{},_=tokio::time::sleep(std::time::Duration::from_millis(10))=>{}}
+                    }
+                    while flush_outcome(&pending_outcome, observer.as_ref(), &scope).is_err() {
+                        tokio::select! {_=cancelled.cancelled()=>break 'messages,_=tokio::time::sleep(std::time::Duration::from_millis(10))=>{}}
+                    }
+                }
+                // No payload/grant accessor or fresh policy read is needed to
+                // record cancellation of the bounded remaining receiver queue.
+                if let Some(receiver) = receiver.as_mut() {
+                    while let Ok(queued) = receiver.try_recv() {
+                        if let Some(outcome) = identify(&queued, DataDisposition::NotStarted) {
+                            pending_outcome
+                                .lock()
+                                .unwrap_or_else(|p| p.into_inner())
+                                .push_back(outcome);
+                        }
+                    }
+                }
+                let _ = flush_outcome(&pending_outcome, observer.as_ref(), &scope);
+                if let Some(port) = weak.upgrade() {
+                    let _ = port.report_terminal();
+                }
+            });
+            *resource.task.lock().unwrap_or_else(|p| p.into_inner()) =
+                Some(async move { task.await.map_err(|_| ()) }.boxed().shared());
+            self.ports
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .insert(port.binding().transport_id.clone(), port.downgrade());
+            port.observe_ready(
+                &binding.negotiated.format,
+                binding.source_ready,
+                binding.sink_ready,
+                None,
+            )?;
+        }
+        self.negotiator
+            .confirm(&self.scope, &answers, deadline, cancel.clone())
+            .await?;
+        if cancel.is_cancelled() || self.lifetime.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        Ok(())
+    }
+}
+pub(crate) struct NativeMedia {
+    pub(crate) rtp: Option<Arc<StagedRtpMedia>>,
+    pub(crate) data: Option<Arc<StagedNativeData>>,
+}
+#[async_trait]
+impl StagedMediaAdapter for NativeMedia {
+    async fn prepare(
+        &self,
+        ports: Vec<PortPreparation>,
+        deadline: tokio::time::Instant,
+        cancel: CancellationToken,
+    ) -> ControlResult<()> {
+        // Reject unsupported families before either backend has effects. Core
+        // owns rollback of all partially prepared candidates before commit.
+        if ports.iter().any(|p| {
+            if p.port.binding().negotiated.requested.medium == Medium::Data {
+                self.data.is_none()
+            } else {
+                self.rtp.is_none()
+            }
+        }) {
+            return Err(StreamControlError::Unsupported);
+        }
+        let (data, rtp): (Vec<_>, Vec<_>) = ports
+            .into_iter()
+            .partition(|p| p.port.binding().negotiated.requested.medium == Medium::Data);
+        if let Some(backend) = &self.data {
+            backend.prepare(data, deadline, cancel.clone()).await?;
+        }
+        if let Some(backend) = &self.rtp {
+            backend.prepare(rtp, deadline, cancel).await?;
+        }
+        Ok(())
+    }
+}
