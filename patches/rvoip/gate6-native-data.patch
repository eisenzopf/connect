+async fn actual_quic_pending_data_cancel_releases_guard_behind_blocked_writer_without_late_io() {
+    let mut s = DataScene::with_window("quic", false, Some(2048)).await;
+    s.select(0, 1).await;
+    s.live[1]
+        .record
+        .large_control
+        .store(true, Ordering::Release);
+    let mut control = envelope("conversation.get", json!({}));
+    control["cid"] = json!("conversation");
+    let bytes = s.live[1].f.sign(control);
+    s.live[1].wire.send(bytes).await;
+    let connection = s.server_quic(1);
+    core_fixture::until(|| connection.stats().frame_tx.stream_data_blocked > 0).await;
+    let request = s.request(0, 90, "queued behind control".into(), "utf8");
+    assert_eq!(s.publish(0, request).await.kind(), "ack");
+    // A forwarding reader can be transient. Wait for the actual physical
+    // submission before queuing the authority writer behind its admission.
+    core_fixture::until(|| {
+        s.factory
+            .adapter
+            .data_counters(&s.live[1].id)
+            .unwrap()
+            .snapshot()
+            .writer_submissions
+            > 0
+    })
+    .await;
+    let mut writer = tokio::spawn({
+        let data = s.policy.0.clone();
+        async move { data.write_owned().await }
+    });
+    assert!(tokio::time::timeout(Duration::from_millis(20), &mut writer)
+        .await
+        .is_err());
+    let mut guard = tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    guard.denied.insert(s.live[1].id.clone());
+    drop(guard);
+    let reply = s.live[1].wire.read().await;
+    assert_eq!(reply.kind(), "ack");
+    assert_eq!(
+        reply.original()["payload"]["details"]["bounded_control_fixture"]
+            .as_str()
+            .unwrap()
+            .len(),
+        65536
+    );
+    assert!(
+        tokio::time::timeout(Duration::from_millis(40), s.live[1].wire.read())
+            .await
+            .is_err(),
+        "cancelled pending data performed late IO"
+    );
+    assert_eq!(
+        s.live[1]
+            .record
+            .peer
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .snapshot()
+            .connections,
+        1
+    );
+    s.policy.0.write().await.denied.clear();
+    s.receive(1, 0, 90, "queued behind control", "utf8").await;
+    assert_eq!(
+        s.factory
+            .adapter
+            .data_counters(&s.live[1].id)
+            .unwrap()
+            .snapshot()
+            .submission_unknown,
+        0
+    );
+    s.stop().await;
+}
