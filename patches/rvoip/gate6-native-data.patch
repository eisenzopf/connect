+#[tokio::test]
+async fn queued_data_recovery_identity_survives_authority_loss_without_exposing_payload_or_reentering_store(
+) {
+    let f = fixture(DataProtocol::Json, true).await;
+    let scene = scene(&f).await;
+    let mut out = f.ba.port(Medium::Data).take_egress().unwrap();
+    let data = message(90)
+        .with_operation_id("stable-recovery-operation")
+        .unwrap();
+    let queued = queued(&f, &scene, &mut out, &data).await;
+    let mut writer = f.policy.0.write().await;
+    writer.revoked.insert("alice".into());
+    let identity = queued.data_identity().unwrap();
+    assert_eq!(identity.message_id, data.message().message_id);
+    assert_eq!(
+        identity.operation_id.as_deref(),
+        Some("stable-recovery-operation")
+    );
+    assert!(queued.data_route_current());
+    assert!(queued.admit_data().is_err());
+    drop(writer);
+    scene.remove(&f.a.connection);
+    assert!(!queued.data_route_current());
+    assert_eq!(
+        queued.data_identity().unwrap().message_id,
+        identity.message_id
+    );
+}
