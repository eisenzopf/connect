+use rvoip_uctp::{staged_data::*, v2::auth_dispatch::native_data_message};
+
+struct DataState {
+    owners: HashMap<ConnectionId, MediaOwner>,
+    wires: HashMap<ConnectionId, Arc<RwLock<WireGrants>>>,
+    denied: BTreeSet<ConnectionId>,
+    key_refusals: Arc<std::sync::atomic::AtomicUsize>,
+}
+struct DataPolicy(Arc<RwLock<DataState>>);
+struct DataLease {
+    owner: MediaOwner,
+    _data: Arc<OwnedRwLockReadGuard<DataState>>,
+    _wire: Vec<AuthorityLease>,
+}
+impl MediaAuthorityLease for DataLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+struct DataProof {
+    base: AuthorityLease,
+    data: Option<Arc<OwnedRwLockReadGuard<DataState>>>,
+    domain: Arc<DataPolicy>,
+}
+impl MediaPolicy for DataPolicy {
+    fn current(&self, s: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let data = Arc::new(
+            self.0
+                .clone()
+                .try_read_owned()
+                .map_err(|_| StreamControlError::Authority)?,
+        );
+        let owner = data
+            .owners
+            .get(s.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        Ok(Box::new(DataLease {
+            owner,
+            _data: data,
+            _wire: vec![],
+        }))
+    }
+    fn current_data(
+        &self,
+        s: &MediaScope<'_>,
+        message: &rvoip_core::staged_streams::reliable_data::StagedData,
+        held: Option<&(dyn std::any::Any + Send + Sync)>,
+    ) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let context = native_data_message(message).ok_or(StreamControlError::Authority)?;
+        if !context.matches_source(s) {
+            return Err(StreamControlError::Authority);
+        }
+        let (data, mut wire) = if let Some(held) = held {
+            let a = held
+                .downcast_ref::<AuthorizedEnvelope>()
+                .ok_or(StreamControlError::Authority)?;
+            let proof = a
+                .authority::<DataProof>()
+                .ok_or(StreamControlError::Authority)?;
+            if !matches!(s.purpose, MediaPurpose::Publish)
+                || !Arc::ptr_eq(&self.0, &proof.domain.0)
+                || !rvoip_core::staged_streams::reliable_data::same_credential(
+                    a.principal(),
+                    s.principal,
+                )
+                || a.envelope().original() != context.original().original()
+            {
+                return Err(StreamControlError::Authority);
+            }
+            (
+                proof.data.clone().ok_or(StreamControlError::Authority)?,
+                vec![proof.base.retained()],
+            )
+        } else {
+            (
+                Arc::new(
+                    self.0
+                        .clone()
+                        .try_read_owned()
+                        .map_err(|_| StreamControlError::Authority)?,
+                ),
+                vec![],
+            )
+        };
+        let owner = data
+            .owners
+            .get(s.connection)
+            .ok_or(StreamControlError::Authority)?
+            .clone();
+        if data.denied.contains(s.connection) {
+            return Err(StreamControlError::Authority);
+        }
+        if let MediaPurpose::Receive { source } = s.purpose {
+            if !context.addresses(owner.member.participant()) {
+                return Err(StreamControlError::NotRecipient);
+            }
+            if data.denied.contains(&source.connection) {
+                return Err(StreamControlError::Authority);
+            }
+        }
+        if held.is_none() {
+            let mut ids = vec![s.connection];
+            if let MediaPurpose::Receive { source } = s.purpose {
+                if &source.connection != s.connection {
+                    ids.push(&source.connection)
+                }
+            }
+            for id in ids {
+                let guard = data
+                    .wires
+                    .get(id)
+                    .ok_or(StreamControlError::Authority)?
+                    .clone()
+                    .try_read_owned()
+                    .map_err(|_| StreamControlError::Authority)?;
+                if guard.denied {
+                    data.key_refusals.fetch_add(1, Ordering::AcqRel);
+                    return Err(StreamControlError::Authority);
+                }
+                wire.push(AuthorityLease::holding(guard));
+            }
+        }
+        Ok(Box::new(DataLease {
+            owner,
+            _data: data,
+            _wire: wire,
+        }))
+    }
+}
