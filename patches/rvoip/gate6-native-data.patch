+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_native_data_byte_budget_is_shared_across_logical_ports_and_recovers_on_drain() {
+    let mut s = DataScene::new("quic", false).await;
+    let mut more = desired(Medium::Data);
+    more.logical_id = StreamId::from_string("more");
+    for index in [0, 1] {
+        s.live[index]
+            .controller
+            .change(
+                s.live[index].controller.revision(),
+                &[desired(Medium::Data), more.clone()],
+                &BTreeSet::new(),
+                deadline(),
+                CancellationToken::new(),
+            )
+            .await
+            .unwrap();
+    }
+    s.select(0, 1).await;
+    s.core
+        .orch
+        .change_staged_direct_subscriptions(
+            &s.core.session,
+            &s.live[1].id,
+            s.live[1].controller.revision(),
+            DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+                &s.live[0].controller,
+                more.logical_id.clone(),
+                more.logical_id,
+            )]),
+            deadline(),
+            CancellationToken::new(),
+            None,
+        )
+        .await
+        .unwrap();
+    s.policy.0.write().await.denied.insert(s.live[1].id.clone());
+    let body = base64::Engine::encode(
+        &base64::engine::general_purpose::STANDARD,
+        vec![0x55; 65536],
+    );
+    let mut accepted = BTreeSet::new();
+    let mut capacity = false;
+    for seq in 1000..1128 {
+        let mut request = s.request(0, seq, body.clone(), "base64");
+        request["payload"]["label"] = json!(if seq < 1064 { "data" } else { "more" });
+        let reply = s.publish(0, request).await;
+        if reply.kind() == "error" {
+            capacity = true;
+            break;
+        }
+        assert_eq!(reply.kind(), "ack");
+        accepted.insert(format!("data_message_{seq}"));
+    }
+    assert!(
+        capacity && accepted.len() > 64 && accepted.len() < 128,
+        "shared byte budget must refuse before two per-port slot queues fill"
+    );
+    assert_eq!(
+        s.factory
+            .adapter
+            .data_counters(&s.live[0].id)
+            .unwrap()
+            .snapshot()
+            .ingress_accepted,
+        accepted.len() as u64
+    );
+    assert_eq!(
+        s.factory
+            .adapter
+            .data_counters(&s.live[1].id)
+            .unwrap()
+            .snapshot()
+            .local_writes,
+        0
+    );
+    // Metadata-only queues hold no idle authority reader even at the byte cap.
+    s.policy.0.write().await.denied.clear();
+    while !accepted.is_empty() {
+        let e = s.live[1].wire.read().await;
+        s.live[1].f.verify_server(&e).await;
+        assert_eq!(e.kind(), "message.send");
+        assert_eq!(e.original()["payload"]["body"], body);
+        assert!(accepted.remove(e.original()["payload"]["msg_id"].as_str().unwrap()));
+    }
+    let request = s.request(0, 1200, "after drain".into(), "utf8");
+    assert_eq!(s.publish(0, request).await.kind(), "ack");
+    s.receive(1, 0, 1200, "after drain", "utf8").await;
+    s.stop().await;
+}
