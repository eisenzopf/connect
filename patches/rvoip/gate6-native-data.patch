+// Data has distinct pre-IO cancellation and partial-write uncertainty. The
+// only physical writer claims Core custody here, after its own dequeue.
+async fn write_data<W: Sink<Bytes, Error = DispatchError> + Send + Unpin>(
+    writer: &mut Option<W>,
+    job: &mut WriteJob,
+    data: DataPending,
+    stop: &CancellationToken,
+) -> Result<(), DispatchError> {
+    let ready = || {
+        !stop.is_cancelled()
+            && !job.lifetime.is_cancelled()
+            && job.deadline > Instant::now()
+            && !job
+                .authority
+                .as_ref()
+                .is_some_and(CancellationToken::is_cancelled)
+            && !job
+                .cancel
+                .as_ref()
+                .is_some_and(CancellationToken::is_cancelled)
+            && job
+                .output
+                ._lease
+                .as_ref()
+                .is_some_and(AuthorityLease::current)
+            && data.admission.current()
+    };
+    let prepared = if job.output.envelopes().len() == 1 && ready() {
+        serde_json::to_vec(&job.output.envelopes()[0])
+            .ok()
+            .map(Bytes::from)
+    } else {
+        None
+    };
+    let writing = prepared.as_ref().and_then(|_| {
+        // Publish the conservative claim flag before competing with producer
+        // cancellation in Core. A cancelled pending claim cannot later do IO.
+        data.started.store(true, Ordering::Release);
+        data.admission.begin_write().ok()
+    });
+    let touched = AtomicBool::new(false);
+    let result = if let (Some(bytes), Some(writing)) = (prepared, writing) {
+        let mut io = IoCustody {
+            writer: writer.take(),
+            _guard: writing,
+        };
+        let result = {
+            let sending = io
+                .writer
+                .as_mut()
+                .expect("unique physical writer")
+                .send(bytes);
+            tokio::pin!(sending);
+            let sending = std::future::poll_fn(|cx| {
+                if !ready() {
+                    return std::task::Poll::Ready(Err(DispatchError::Closed));
+                }
+                touched.store(true, Ordering::Release);
+                std::future::Future::poll(sending.as_mut(), cx)
+            });
+            tokio::select! {biased;
+                _=data.admission.cancelled()=>Err(DispatchError::Closed),
+                _=stop.cancelled()=>Err(DispatchError::Closed),
+                _=job.lifetime.cancelled()=>Err(DispatchError::Closed),
+                _=async{match &job.cancel{Some(t)=>t.cancelled().await,None=>std::future::pending().await}}=>Err(DispatchError::Closed),
+                _=async{match &job.authority{Some(t)=>t.cancelled().await,None=>std::future::pending().await}}=>Err(DispatchError::Authority),
+                _=tokio::time::sleep_until(job.deadline)=>Err(DispatchError::Closed),
+                r=sending=>r,
+            }
+        };
+        if result.is_ok() || !touched.load(Ordering::Acquire) {
+            *writer = io.writer.take();
+        } else {
+            job.lifetime.cancel();
+        }
+        // Also holds when the containing drive future is dropped mid-await.
+        drop(io);
+        result
+    } else {
+        Err(DispatchError::Closed)
+    };
+    let started = touched.load(Ordering::Acquire);
+    let result = result.map_err(|_| {
+        if started {
+            DispatchError::SubmissionUnknown
+        } else {
+            DispatchError::Closed
+        }
+    });
+    if let Some(done) = job.delivery.take() {
+        let _ = done.send(result);
+    }
+    // A possibly partial write poisons the reliable stream. A stale item which
+    // never touched IO cannot retire another healthy Connection's physical peer.
+    if started {
+        result
+    } else {
+        Ok(())
+    }
