+//! Native data origins and current one-use writer custody, separate from subscriptions.
+use super::super::payloads::{BodyEncoding, MessageAudience};
+use super::super::{Identifier, Payload};
+use super::*;
+use crate::staged_media::StagedRtpScope;
+use base64::Engine;
+use rvoip_core::{
+    ids::{ConnectionId, ConversationId, DeviceId, IdentityId, ParticipantId, SessionId},
+    relationships::{EndpointBinding, Membership},
+    staged_streams::{reliable_data::*, MediaPurpose, MediaScope, StreamController},
+    DataMessage,
+};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Weak,
+};
+use tokio::sync::{OwnedSemaphorePermit, Semaphore};
+
+/// Private construction from authenticated canonical input; immutable facts,
+/// not an invocation grant. The byte reservation tracks retained payload memory.
+pub struct NativeDataMessage {
+    original: Envelope,
+    message: DataMessage,
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    participant: ParticipantId,
+    _bytes: OwnedSemaphorePermit,
+}
+impl NativeDataMessage {
+    pub fn original(&self) -> &Envelope {
+        &self.original
+    }
+    pub fn matches_source(&self, scope: &MediaScope<'_>) -> bool {
+        self.conversation == *scope.conversation
+            && self.session == *scope.session
+            && match scope.purpose {
+                MediaPurpose::Publish => self.connection == *scope.connection,
+                MediaPurpose::Receive { source } => {
+                    self.connection == source.connection && self.participant == source.participant
+                }
+                _ => false,
+            }
+    }
+    pub fn addresses(&self, participant: &ParticipantId) -> bool {
+        match self.original.payload() {
+            Payload::MessageSend(p) => match &p.to {
+                MessageAudience::All(_) => true,
+                MessageAudience::Participants(ids) => {
+                    ids.iter().any(|id| id.as_str() == participant.as_str())
+                }
+            },
+            _ => false,
+        }
+    }
+    pub(in crate::v2) fn seal(
+        authorized: &AuthorizedEnvelope,
+        scope: &StagedRtpScope,
+        member: &Membership,
+        budget: Arc<Semaphore>,
+    ) -> Result<StagedData, DispatchError> {
+        let e = authorized.envelope();
+        if !authorized._lease.current()
+            || authorized.invocation.is_cancelled()
+            || !scope_matches(e, scope)
+            || e.scope(Scope::Operation).is_none()
+            || e.scope(Scope::Reply).is_some()
+        {
+            return Err(DispatchError::ScopeDenied);
+        }
+        let Payload::MessageSend(p) = e.payload() else {
+            return Err(DispatchError::Unsupported);
+        };
+        if p.attachments.as_ref().is_some_and(|v| !v.is_empty())
+            || p.in_reply_to_msg.is_some()
+            || p.r#from
+                .as_ref()
+                .is_some_and(|id| id.as_str() != member.participant().as_str())
+        {
+            return Err(DispatchError::Unsupported);
+        }
+        let bytes = match p.body_encoding {
+            None | Some(BodyEncoding::Utf8) => bytes::Bytes::copy_from_slice(p.body.as_bytes()),
+            Some(BodyEncoding::Base64) => {
+                let decoded = base64::engine::general_purpose::STANDARD
+                    .decode(&p.body)
+                    .map_err(|_| DispatchError::Unsupported)?;
+                if base64::engine::general_purpose::STANDARD.encode(&decoded) != p.body {
+                    return Err(DispatchError::Unsupported);
+                }
+                decoded.into()
+            }
+        };
+        let message = DataMessage::try_new(
+            p.label.clone().ok_or(DispatchError::Unsupported)?,
+            p.content_type.clone(),
+            bytes,
+            rvoip_core::DataReliability::ReliableOrdered,
+            rvoip_core::ids::MessageId::from_string(p.msg_id.as_str()),
+        )
+        .map_err(|_| DispatchError::Unsupported)?;
+        let cost = serde_json::to_vec(e.original())
+            .map_err(|_| DispatchError::Capacity)?
+            .len()
+            .checked_add(message.bytes.len())
+            .ok_or(DispatchError::Capacity)?;
+        let reservation = budget
+            .try_acquire_many_owned(
+                u32::try_from(cost.max(1)).map_err(|_| DispatchError::Capacity)?,
+            )
+            .map_err(|_| DispatchError::Capacity)?;
+        StagedData::new(
+            message.clone(),
+            Self {
+                original: e.clone(),
+                message,
+                conversation: member.conversation().clone(),
+                session: scope.session.clone(),
+                connection: scope.connection.clone(),
+                participant: member.participant().clone(),
+                _bytes: reservation,
+            },
+        )
+        .map_err(|_| DispatchError::Unsupported)?
+        .with_operation_id(e.scope(Scope::Operation).expect("checked operation"))
+        .map_err(|_| DispatchError::Unsupported)
+    }
+}
+/// Inspect only sealed message facts. Policy must additionally acquire current
+/// exact actor/resource/audience/key authority; these facts are not that grant.
+pub fn native_data_message(data: &StagedData) -> Option<&NativeDataMessage> {
+    data.context::<NativeDataMessage>().filter(|context| {
+        data.message() == &context.message
+            && data.operation_id() == context.original.scope(Scope::Operation)
+    })
+}
+fn scope_matches(e: &Envelope, s: &StagedRtpScope) -> bool {
+    s.wire_conversation.is_some()
+        && e.scope(Scope::Conversation) == s.wire_conversation.as_deref()
+        && e.scope(Scope::Session) == Some(s.wire_session.as_str())
+        && e.scope(Scope::Connection) == Some(s.wire_connection.as_str())
+}
+
+#[derive(Clone)]
+pub struct DataOrigin {
+    origin: RequestOrigin,
+    controller: Weak<StreamController>,
+    principal: Arc<AuthenticatedPrincipal>,
+    revision: u64,
+    scope: StagedRtpScope,
+    conversation: ConversationId,
+    participant: ParticipantId,
+    identity: IdentityId,
+    device: DeviceId,
+    epoch: u64,
+    initial: Weak<dyn std::any::Any + Send + Sync>,
+}
+impl fmt::Debug for DataOrigin {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("DataOrigin(redacted)")
+    }
+}
+impl DataOrigin {
+    pub(in crate::v2) fn seal(
+        a: &AuthorizedEnvelope,
+        controller: &Arc<StreamController>,
+        scope: StagedRtpScope,
+        member: &Membership,
+        endpoint: &EndpointBinding,
+    ) -> Result<Self, DispatchError> {
+        if !matches!(
+            a.envelope.kind(),
+            "connection.offer" | "connection.update" | "stream.open"
+        ) || a.peer.is_none()
+            || !a
+                .exchange
+                .as_ref()
+                .is_some_and(|exchange| exchange.supports_native_data())
+            || !a._lease.current()
+            || a.invocation.is_cancelled()
+            || Instant::now() >= a.origin.deadline
+            || !scope_matches(&a.envelope, &scope)
+            || a.envelope.scope(Scope::Reply).is_some()
+            || !controller.is_bound_to(member, endpoint)
+            || !controller.matches_data_credential(&a.principal)
+            || a.origin.lifetime.is_cancelled()
+        {
+            return Err(DispatchError::Authority);
+        }
+        let expiry = super::super::auth_peer::effective_expiry(&a.principal)?;
+        let deadline = Instant::now()
+            + expiry
+                .signed_duration_since(chrono::Utc::now())
+                .to_std()
+                .map_err(|_| DispatchError::Closed)?;
+        let result = Self {
+            origin: RequestOrigin {
+                incarnation: a.origin.incarnation,
+                lifetime: a.origin.lifetime.child_token(),
+                deadline,
+            },
+            controller: Arc::downgrade(controller),
+            principal: Arc::new(a.principal.clone()),
+            revision: controller.credential_revision(),
+            scope,
+            conversation: member.conversation().clone(),
+            participant: member.participant().clone(),
+            identity: member.identity().clone(),
+            device: endpoint.device().clone(),
+            epoch: member.epoch(),
+            initial: Arc::downgrade(&a._lease._guard),
+        };
+        if !result.current() {
+            return Err(DispatchError::Closed);
+        }
+        Ok(result)
+    }
+    pub(crate) fn same_binding(&self, other: &Self) -> bool {
+        self.origin.incarnation == other.origin.incarnation
+            && self.revision == other.revision
+            && Weak::ptr_eq(&self.controller, &other.controller)
+            && self.scope.connection == other.scope.connection
+            && self.scope.session == other.scope.session
+            && self.scope.owner == other.scope.owner
+            && self.scope.wire_connection == other.scope.wire_connection
+            && self.scope.wire_session == other.scope.wire_session
+            && self.scope.wire_conversation == other.scope.wire_conversation
+            && self.conversation == other.conversation
+            && self.participant == other.participant
+            && self.epoch == other.epoch
+            && self.identity == other.identity
+            && self.device == other.device
+    }
+    pub fn is_ready(&self) -> bool {
+        self.initial.strong_count() == 0
+    }
+    pub fn current(&self) -> bool {
+        !self.origin.lifetime.is_cancelled()
+            && Instant::now() < self.origin.deadline
+            && self.controller.upgrade().is_some_and(|c| {
+                c.credential_revision() == self.revision
+                    && c.matches_data_credential(&self.principal)
+            })
+    }
+    pub fn retire(&self) {
+        self.origin.lifetime.cancel();
+    }
+    pub async fn retired(&self) {
+        tokio::select! {_=self.origin.lifetime.cancelled()=>{},_=tokio::time::sleep_until(self.origin.deadline)=>{}}
+    }
+    fn matches(&self, data: &AdmittedData) -> bool {
+        let t = data.target();
+        self.controller.upgrade().is_some_and(|c| t.belongs_to(&c))
+            && t.conversation == self.conversation
+            && t.session == self.scope.session
+            && t.connection == self.scope.connection
+            && t.participant == self.participant
+            && t.identity == self.identity
+            && t.device == self.device
+            && t.membership_epoch == self.epoch
+            && t.credential_revision == self.revision
+            && same_credential(&t.principal, &self.principal)
+    }
+    fn envelope(&self, data: &AdmittedData) -> Result<Envelope, DispatchError> {
+        let context = native_data_message(data.data()).ok_or(DispatchError::Authority)?;
+        let s = data.source();
+        if s.conversation != context.conversation
+            || s.session != context.session
+            || s.connection != context.connection
+            || s.participant != context.participant
+            || s.logical_id.as_str() != context.message.label
+            || !context.addresses(&data.target().participant)
+        {
+            return Err(DispatchError::Authority);
+        }
+        let mut v = context.original.execution_value();
+        v["v"] = serde_json::json!(super::super::ENVELOPE_VERSION);
+        v.as_object_mut()
+            .ok_or(DispatchError::Unsupported)?
+            .remove("signature");
+        v["id"] = serde_json::json!(format!("data_{}", uuid::Uuid::new_v4().simple()));
+        v["ts"] = serde_json::json!(chrono::Utc::now());
+        v["cid"] = serde_json::json!(self.scope.wire_conversation);
+        v["sid"] = serde_json::json!(self.scope.wire_session);
+        v["connid"] = serde_json::json!(self.scope.wire_connection);
+        v["payload"]["from"] = serde_json::json!(s.participant.as_str());
+        v["payload"]["label"] = serde_json::json!(data
+            .target()
+            .binding
+            .negotiated
+            .requested
+            .logical_id
+            .as_str());
+        Envelope::from_value(v).map_err(DispatchError::from)
+    }
+}
