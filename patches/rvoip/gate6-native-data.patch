+        i: &Identifier,
+        e: &Envelope,
+    ) -> Result<AuthorityLease, DispatchError> {
+        self.acquire(c, d, i, e).await
+    }
+}
+#[derive(Default)]
+struct ReadyData {
+    offers: std::sync::Mutex<Vec<ReadyMediaBinding>>,
+    observations: std::sync::Mutex<Vec<NativeDataOutcome>>,
+    busy: AtomicBool,
+}
+#[async_trait]
+impl StagedDataNegotiator for ReadyData {
+    fn observe(&self, _: &StagedRtpScope, o: &NativeDataOutcome) -> ControlResult<()> {
+        if self.busy.load(Ordering::Acquire) {
+            return Err(StreamControlError::Authority);
+        }
+        let mut rows = self.observations.lock().unwrap();
+        if !rows.iter().any(|r| {
+            r.message_id == o.message_id
+                && r.operation_id == o.operation_id
+                && r.target == o.target
+                && r.disposition == o.disposition
+        }) {
+            assert!(rows.len() < 256);
+            rows.push(o.clone());
+        }
+        Ok(())
+    }
+    async fn prepare(
+        &self,
+        _: &StagedRtpScope,
+        offers: &[ReadyMediaBinding],
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<Vec<ReadyMediaBinding>> {
+        self.offers.lock().unwrap().extend_from_slice(offers);
+        Ok(offers.to_vec())
+    }
+    async fn confirm(
+        &self,
+        _: &StagedRtpScope,
+        _: &[ReadyMediaBinding],
+        _: tokio::time::Instant,
+        _: CancellationToken,
+    ) -> ControlResult<()> {
+        Ok(())
+    }
+}
+#[derive(Default)]
+struct Record {
+    peer: std::sync::Mutex<Option<Arc<PeerAdmission>>>,
+    principal: std::sync::Mutex<Option<AuthenticatedPrincipal>>,
+    id: std::sync::Mutex<Option<ConnectionId>>,
+    hold: AtomicBool,
+    entered: Notify,
+    release: Notify,
+    large_control: AtomicBool,
+    origin_installs: std::sync::atomic::AtomicUsize,
+}
+struct DataFactory {
+    core: Arc<core_fixture::Fixture>,
+    adapter: Arc<CanonicalNativeAdapter>,
+    records: std::sync::Mutex<Vec<Arc<Record>>>,
+}
+struct DataHandler {
+    core: Arc<core_fixture::Fixture>,
+    adapter: Arc<CanonicalNativeAdapter>,
+    physical: Arc<NativePhysicalBinding>,
+    record: Arc<Record>,
+}
+impl PhysicalHandlerFactory for DataFactory {
+    fn handler(
+        &self,
+        context: NativeTransportContext,
+    ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+        let physical = NativePhysicalBinding::new(context);
+        let record = Arc::new(Record::default());
+        self.records.lock().unwrap().push(record.clone());
+        physical.with_data_handler(Arc::new(DataHandler {
+            core: self.core.clone(),
+            adapter: self.adapter.clone(),
+            physical: physical.clone(),
+            record,
+        }))
+    }
+}
+#[async_trait]
+impl AuthenticatedHandler for DataHandler {
+    async fn handle(&self, a: AuthorizedEnvelope) -> Result<Envelope, DispatchError> {
+        let e = a.envelope();
+        let proof = a.authority::<DataProof>().ok_or(DispatchError::Authority)?;
+        let wire = proof
+            .base
+            .authority::<WireProof>()
+            .ok_or(DispatchError::Authority)?;
+        if e.kind() == "connection.offer" {
+            let id = wire
+                .connection
+                .as_ref()
+                .ok_or(DispatchError::Authority)?
+                .clone();
+            if self.adapter.media_controller(&id).is_ok() {
+                self.adapter.install_data_origin(&id, &a)?;
+                self.record.origin_installs.fetch_add(1, Ordering::AcqRel);
+            } else {
+                let kind = self.physical.transport();
+                let peer = a.peer_admission().unwrap().clone();
+                let view = View(&wire.authorities[&kind]);
+                self.core
+                    .orch
+                    .prepare_peer_native_connection(
+                        peer.clone(),
+                        a.principal(),
+                        PeerNativeIntent {
+                            session: self.core.session.clone(),
+                            connection: id.clone(),
+                            transport: kind,
+                        },
+                        &view,
+                        self.physical.clone(),
+                    )
+                    .map_err(|_| DispatchError::Authority)?
+                    .retain(a.principal(), &view)
+                    .map_err(|_| DispatchError::Authority)?;
+                *self.record.peer.lock().unwrap() = Some(peer);
+                *self.record.principal.lock().unwrap() = Some(a.principal().clone());
+                *self.record.id.lock().unwrap() = Some(id);
+            }
+        } else if e.kind() == "message.send" {
+            let id = self
+                .record
+                .id
+                .lock()
+                .unwrap()
+                .clone()
+                .ok_or(DispatchError::Authority)?;
+            if self.record.hold.load(Ordering::Acquire) {
+                self.record.entered.notify_one();
+                self.record.release.notified().await;
+            }
+            self.adapter.publish_data(&id, &a)?;
+        } else if e.kind() != "conversation.get" {
+            return Err(DispatchError::Unsupported);
+        }
+        let mut out = envelope("ack", json!({"details":{"core_queue_admission_only":true}}));
+        for name in ["cid", "sid", "connid", "operation_id"] {
+            if let Some(value) = e.original().get(name) {
+                out[name] = value.clone();
+            }
+        }
+        if e.kind() == "conversation.get" && self.record.large_control.load(Ordering::Acquire) {
+            out["payload"]["details"]["bounded_control_fixture"] = json!("x".repeat(65536));
+        }
+        out["in_reply_to"] = json!(e.id());
+        Envelope::from_value(out).map_err(DispatchError::from)
+    }
+}
