+#[test]
+fn physical_factory_discards_late_or_cancelled_original_handler() {
+    use rvoip_uctp::v2::{
+        reachability::PeerTransport,
+        server::{CanonicalProfile, NativeTransportContext, PhysicalHandlerFactory},
+    };
+    struct Factory {
+        calls: Arc<AtomicUsize>,
+        cancel: bool,
+        made: Arc<std::sync::Mutex<Option<std::sync::Weak<Handler>>>>,
+    }
+    impl PhysicalHandlerFactory for Factory {
+        fn handler(
+            &self,
+            context: NativeTransportContext,
+        ) -> Result<Arc<dyn AuthenticatedHandler>, DispatchError> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            if self.cancel {
+                context.lifetime.cancel();
+            } else {
+                while Instant::now() < context.admission_deadline {
+                    std::thread::yield_now();
+                }
+            }
+            let handler = Arc::new(Handler::default());
+            *self.made.lock().unwrap() = Some(Arc::downgrade(&handler));
+            Ok(handler)
+        }
+    }
+    for cancel in [false, true] {
+        let fixture = Fixture::new();
+        let calls = Arc::new(AtomicUsize::new(0));
+        let made = Arc::new(std::sync::Mutex::new(None));
+        let profile = CanonicalProfile::new(fixture.config, Arc::new(Handler::default()), 4)
+            .unwrap()
+            .with_physical_handlers(Arc::new(Factory {
+                calls: calls.clone(),
+                cancel,
+                made: made.clone(),
+            }));
+        let context = NativeTransportContext::new(
+            PeerTransport::Quic,
+            CancellationToken::new(),
+            Instant::now() - Duration::from_millis(1),
+            (),
+        );
+        assert!(matches!(
+            profile.physical_handler(context),
+            Err(DispatchError::Closed)
+        ));
+        assert_eq!(
+            calls.load(Ordering::SeqCst),
+            0,
+            "already expired admission reached the factory"
+        );
+        let original = CancellationToken::new();
+        let context = NativeTransportContext::new(
+            PeerTransport::Quic,
+            original,
+            Instant::now() + Duration::from_millis(5),
+            (),
+        );
+        assert!(matches!(
+            profile.physical_handler(context),
+            Err(DispatchError::Closed)
+        ));
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert!(
+            made.lock().unwrap().as_ref().unwrap().upgrade().is_none(),
+            "late original handler resource was retained"
+        );
+    }
 }
