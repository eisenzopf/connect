+#[tokio::test]
+async fn original_driver_authentication_deadline_cannot_be_restarted_after_resource_admission() {
+    let fixture = Fixture::new();
+    let handler = Handler::default();
+    let mut expired = CanonicalPeer::new(fixture.config.clone(), CancellationToken::new())
+        .unwrap()
+        .with_original_authentication_deadline(Instant::now() - Duration::from_millis(1))
+        .with_original_authentication_deadline(Instant::now() + Duration::from_secs(60));
+    assert!(matches!(
+        expired
+            .handle(&serde_json::to_vec(&hello()).unwrap(), &handler, deadline())
+            .await,
+        Err(DispatchError::Closed)
+    ));
+    let mut current = CanonicalPeer::new(fixture.config.clone(), CancellationToken::new())
+        .unwrap()
+        .with_original_authentication_deadline(deadline());
+    assert!(current
+        .handle(&serde_json::to_vec(&hello()).unwrap(), &handler, deadline())
+        .await
+        .is_ok());
+}
