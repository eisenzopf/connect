+#[cfg(test)]
+mod canonical_audio_order_tests {
+    use super::OutboundAudioRtpState;
+    use std::time::{Duration, Instant};
+    fn input(seq: u16, at: Instant) -> crate::media::audio_reorder::ReceivedAudio {
+        crate::media::audio_reorder::ReceivedAudio::new(
+            rtc::rtp::Packet {
+                header: rtc::rtp::Header {
+                    sequence_number: seq,
+                    ssrc: 7,
+                    timestamp: u32::from(seq) * 960,
+                    ..Default::default()
+                },
+                payload: vec![0xf8, 0xff, 0xfe].into(),
+            },
+            at,
+        )
+    }
+    #[test]
+    fn original_arrival_order_masks_a_reorder_as_a_clock_reset() {
+        let mut state = OutboundAudioRtpState::default();
+        let wire: Vec<_> = [10, 12, 11, 13]
+            .into_iter()
+            .map(|n| state.allocate_audio_timestamp(n * 960, 960))
+            .collect();
+        assert_eq!(wire, vec![9600, 11520, 12480, 14400]);
+        assert_ne!(wire, vec![9600, 10560, 11520, 12480]);
+    }
+    #[test]
+    fn existing_bounded_reorder_preserves_original_times_and_contiguous_timeline() {
+        let now = Instant::now();
+        let arrivals = [
+            (10, now),
+            (12, now + Duration::from_millis(2)),
+            (11, now + Duration::from_millis(4)),
+            (13, now + Duration::from_millis(6)),
+        ];
+        let mut reorder = crate::media::audio_reorder::AudioReorder::default();
+        let mut output = Vec::new();
+        for (seq, at) in arrivals {
+            output.extend(reorder.push(input(seq, at), at).packets);
+        }
+        assert_eq!(
+            output
+                .iter()
+                .map(|p| p.packet.header.sequence_number)
+                .collect::<Vec<_>>(),
+            vec![10, 11, 12, 13]
+        );
+        for p in &output {
+            assert_eq!(
+                p.inserted,
+                arrivals
+                    .iter()
+                    .find(|(n, _)| *n == p.packet.header.sequence_number)
+                    .unwrap()
+                    .1
+            );
+        }
+        let mut state = OutboundAudioRtpState::default();
+        let wire: Vec<_> = output
+            .iter()
+            .map(|p| state.allocate_audio_timestamp(p.packet.header.timestamp, 960))
+            .collect();
+        assert_eq!(wire, vec![9600, 10560, 11520, 12480]);
+    }
+}
