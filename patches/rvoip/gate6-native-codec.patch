+fn codec_bindings(plan: &NativeOfferPlan) -> Vec<ReadyMediaBinding> {
+    plan.selected
+        .iter()
+        .enumerate()
+        .map(|(index, selected)| ReadyMediaBinding {
+            negotiated: selected.clone(),
+            transport_id: StreamId::new(),
+            stream_local_id: index as u16 + 1,
+            generation: 1,
+            connection_generation: 1,
+            source_ready: selected.requested.direction != StreamDirection::Send,
+            sink_ready: selected.requested.direction != StreamDirection::Receive,
+        })
+        .collect()
+}
+fn codec_request(streams: Option<Vec<&str>>, names: &[&str]) -> ConnectionUpdate {
+    serde_json::from_value(
+        json!({"action":"codec-renegotiate","streams":streams,"codec_preferences":names}),
+    )
+    .unwrap()
+}
+#[test]
+fn native_codec_update_selects_only_targets_and_preserves_complete_unaffected_program() {
+    let profile = profile();
+    let original = NativeOfferPlan::parse(&offer(), &profile, &actor()).unwrap();
+    let bindings = codec_bindings(&original);
+    let update = codec_request(Some(vec!["one"]), &["unsupported", "PCMU"]);
+    let selected =
+        NativeOfferPlan::codec_update(&update, &profile, &original.remote, &bindings).unwrap();
+    assert_eq!(selected.selected[0].format, audio("pcmu"));
+    assert_eq!(
+        selected.selected[0].requested,
+        original.selected[0].requested
+    );
+    assert_eq!(selected.selected[1], original.selected[1]);
+    assert!(selected.rejected.is_empty());
+    assert_eq!(bindings[0].negotiated.format, audio("pcma"));
+}
+#[test]
+fn native_codec_update_validates_all_targets_and_both_directional_catalogs_before_preparation() {
+    let profile = profile();
+    let original = NativeOfferPlan::parse(&offer(), &profile, &actor()).unwrap();
+    let bindings = codec_bindings(&original);
+    for update in [
+        codec_request(Some(vec!["one", "missing"]), &["pcmu"]),
+        codec_request(Some(vec!["one", "one"]), &["pcmu"]),
+        codec_request(None, &["PCMU", "pcmu"]),
+        codec_request(None, &[]),
+        codec_request(None, &["vp9"]),
+    ] {
+        assert!(
+            NativeOfferPlan::codec_update(&update, &profile, &original.remote, &bindings).is_err()
+        );
+    }
+    let mut remote = original.remote.clone();
+    remote.receive[0].formats.retain(|f| f != &audio("pcmu"));
+    assert!(matches!(
+        NativeOfferPlan::codec_update(
+            &codec_request(Some(vec!["one"]), &["pcmu"]),
+            &profile,
+            &remote,
+            &bindings
+        ),
+        Err(NativeOfferError::Unsupported)
+    ));
+}
+#[test]
+fn native_codec_update_keeps_data_parameters_and_never_treats_data_protocols_as_codecs() {
+    let profile = profile();
+    let original = NativeOfferPlan::parse(&offer(), &profile, &actor()).unwrap();
+    let mut bindings = codec_bindings(&original);
+    let mut data = bindings[0].clone();
+    data.negotiated = NegotiatedStream {
+        requested: DesiredStream {
+            logical_id: StreamId::from_string("data"),
+            medium: Medium::Data,
+            direction: StreamDirection::Both,
+        },
+        format: MediaFormat::ReliableOrdered(rvoip_core::capability::DataProtocol::Binary),
+    };
+    data.stream_local_id = 3;
+    bindings.push(data.clone());
+    let selected = NativeOfferPlan::codec_update(
+        &codec_request(None, &["pcmu"]),
+        &profile,
+        &original.remote,
+        &bindings,
+    )
+    .unwrap();
+    assert_eq!(selected.selected[2], data.negotiated);
+    assert!(matches!(
+        NativeOfferPlan::codec_update(
+            &codec_request(Some(vec!["data"]), &["binary"]),
+            &profile,
+            &original.remote,
+            &bindings
+        ),
+        Err(NativeOfferError::Unsupported)
+    ));
+}
