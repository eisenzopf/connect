+
+fn codec_command(revision: u64, names: &[&str]) -> Value {
+    let mut request = gate_command("codec-renegotiate", revision, Some(&["first"]), None);
+    request["payload"]["codec_preferences"] = json!(names);
+    request
+}
+async fn codec_callback(s: &mut Scene, request: Value) -> Envelope {
+    let original = request.clone();
+    s.wire.send(s.f.sign(request)).await;
+    let callback = s.wire.read().await;
+    assert_eq!(callback.kind(), "connection.offer");
+    s.f.verify_server(&callback).await;
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        assert_eq!(callback.original()[field], original[field]);
+    }
+    assert_eq!(
+        callback.original()["payload"]["substrate_setup"]["offer_id"],
+        original["id"]
+    );
+    callback
+}
+async fn codec_ack(s: &mut Scene, request: &Value) {
+    let reply = s.wire.read().await;
+    verify_codec_ack(s, request, &reply).await;
+}
+async fn verify_codec_ack(s: &Scene, request: &Value, reply: &Envelope) {
+    assert_eq!(reply.kind(), "ack");
+    s.f.verify_server(&reply).await;
+    assert_eq!(reply.original()["in_reply_to"], request["id"]);
+    for field in ["cid", "sid", "connid", "operation_id"] {
+        assert_eq!(reply.original()[field], request[field]);
+    }
+    assert_eq!(
+        reply.original()["payload"]["details"]["local_codec_commit"]["revision"],
+        request["expected_revision"].as_u64().unwrap() + 1
+    );
+}
+fn encoded_audio(handle: u16, pt: u8, sequence: u16) -> Bytes {
+    let mut codec =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(pt, Some(8000), Some(1))
+            .unwrap();
+    let payload = codec
+        .encode(&rvoip_media_core::AudioFrame {
+            samples: vec![1800; 160],
+            sample_rate: 8000,
+            channels: 1,
+            duration: Duration::from_millis(20),
+            timestamp: sequence as u32 * 160,
+        })
+        .unwrap()
+        .into();
+    pack_rtp_datagram(&RtpDatagram {
+        flags: 0,
+        stream_local_id: handle,
+        seq: sequence as u32,
+        rtp: RtpMediaPayload {
+            payload,
+            payload_type: pt,
+            sequence_number: sequence,
+            timestamp: sequence as u32 * 160,
+            ssrc: 17,
+        },
+    })
+    .unwrap()
+}
+fn decoded_codec(packet: &ObservedRtpDatagram, pt: u8) {
+    assert_eq!(packet.rtp.packet().header.payload_type, pt);
+    let mut codec =
+        rvoip_media_core::codec::factory::CodecFactory::create_codec(pt, Some(8000), Some(1))
+            .unwrap();
+    assert!(codec
+        .decode(&packet.rtp.packet().payload)
+        .unwrap()
+        .samples
+        .iter()
+        .any(|s| s.unsigned_abs() > 500));
+}
+#[tokio::test]
+async fn actual_native_codec_update_confirms_replacement_and_preserves_decoded_old_audio_until_commit(
+) {
+    for kind in ["quic", "wt"] {
+        let mut p = GatePair::new(kind).await;
+        let first = StreamId::from_string("first");
+        let old_binding = p.s.controller().active_bindings()[0].clone();
+        send(&p.s.wire, audio_sequence(p.ah, 1));
+        let old_packet = packet(&mut p.ai).await;
+        let request = codec_command(1, &["pcma"]);
+        let callback = codec_callback(&mut p.s, request.clone()).await;
+        assert_eq!(p.s.controller().revision(), 1);
+        assert_eq!(
+            p.s.controller().active_bindings()[0].transport_id,
+            old_binding.transport_id
+        );
+        let stale_gate = gate_command("mute", 1, Some(&["first"]), None);
+        p.s.wire.send(p.s.f.sign(stale_gate)).await;
+        p.playback(1).await;
+        p.s.confirm(&callback).await;
+        codec_ack(&mut p.s, &request).await;
+        p.s.wait(3).await;
+        let refused = p.s.wire.read().await;
+        assert_eq!(refused.kind(), "error");
+        p.s.f.verify_server(&refused).await;
+        assert!(matches!(
+            p.s.record.controls.lock().unwrap().last().unwrap(),
+            Err(NativeOfferError::Conflict)
+        ));
+        let current = p.s.controller().active_bindings()[0].clone();
+        assert_eq!(current.negotiated.requested.logical_id, first);
+        assert_ne!(current.transport_id, old_binding.transport_id);
+        assert_ne!(current.stream_local_id, p.ah);
+        assert_eq!(p.s.controller().stream_open_budget().0, 2);
+        assert_eq!(p.bc().revision(), 1);
+        assert!(old_packet.try_forward_to(&p.bc(), &first).is_err());
+        let mut input = p.s.controller().take_ingress(&first).unwrap();
+        send(&p.s.wire, audio_sequence(p.ah, 2));
+        assert!(
+            tokio::time::timeout(Duration::from_millis(40), input.recv())
+                .await
+                .is_err()
+        );
+        send(&p.s.wire, encoded_audio(current.stream_local_id, 8, 2));
+        let changed_packet = packet(&mut input).await;
+        // Ordinary packet forwarding preserves encoding. Managed audio scenes
+        // own transcoding; this isolated relay refuses differing formats.
+        assert!(matches!(
+            changed_packet.try_forward_to(&p.bc(), &first),
+            Err(StreamControlError::Unsupported)
+        ));
+        let mut other_request = codec_command(1, &["pcma"]);
+        other_request["connid"] = json!("native_1");
+        p.other.send(p.s.f.sign(other_request.clone())).await;
+        let other_callback = p.other.read().await;
+        assert_eq!(other_callback.kind(), "connection.offer");
+        p.s.f.verify_server(&other_callback).await;
+        p.other
+            .send(p.s.f.sign(p.s.confirmation(&other_callback)))
+            .await;
+        let other_ack = p.other.read().await;
+        verify_codec_ack(&p.s, &other_request, &other_ack).await;
+        p.s.wait(4).await;
+        let other_binding = p.bc().active_bindings()[0].clone();
+        let mut other_input = p.bc().take_ingress(&first).unwrap();
+        send(&p.s.wire, encoded_audio(current.stream_local_id, 8, 3));
+        packet(&mut input)
+            .await
+            .try_forward_to(&p.bc(), &first)
+            .unwrap();
+        decoded_codec(&received(&p.other).await, 8);
+        send(&p.other, encoded_audio(other_binding.stream_local_id, 8, 3));
+        packet(&mut other_input)
+            .await
+            .try_forward_to(&p.s.controller(), &first)
+            .unwrap();
+        let output = received(&p.s.wire).await;
+        assert_eq!(output.stream_local_id, current.stream_local_id);
+        decoded_codec(&output, 8);
+        p.s.wire.server.shutdown().await.unwrap();
+        p.other.server.shutdown().await.unwrap();
+    }
+}
+#[tokio::test]
+async fn actual_native_codec_update_refuses_stale_unknown_incompatible_and_foreign_requests_without_effect(
+) {
+    let mut p = GatePair::new("quic").await;
+    let original = p.s.controller().active_bindings()[0].clone();
+    let budget = p.s.controller().stream_open_budget();
+    let mut missing = codec_command(1, &["pcma"]);
+    missing["payload"]["streams"] = json!(["first", "missing"]);
+    let mut details = codec_command(1, &["pcma"]);
+    details["payload"]["details"] = json!({"direction":"sendonly"});
+    let mut scope = codec_command(1, &["pcma"]);
+    scope["sid"] = json!("foreign");
+    let requests = vec![
+        codec_command(0, &["pcma"]),
+        codec_command(1, &["vp9"]),
+        codec_command(1, &["pcma", "PCMA"]),
+        missing,
+        details,
+        scope,
+    ];
+    for (index, request) in requests.into_iter().enumerate() {
+        gate_reply(&mut p.s, request, "error").await;
+        assert_eq!(p.s.controller().revision(), 1);
+        assert_eq!(
+            p.s.controller().active_bindings()[0].transport_id,
+            original.transport_id
+        );
+        assert_eq!(p.s.controller().stream_open_budget(), budget);
+        p.playback(index as u16 + 1).await;
+    }
+    p.other.send(p.s.f.sign(codec_command(1, &["pcma"]))).await;
+    let error = p.other.read().await;
+    assert_eq!(error.kind(), "error");
+    p.s.f.verify_server(&error).await;
+    p.s.grants.0.write().await.denied = true;
+    gate_reply(&mut p.s, codec_command(1, &["pcma"]), "error").await;
+    p.s.grants.0.write().await.denied = false;
+    assert_eq!(p.s.controller().revision(), 1);
+    assert_eq!(p.s.controller().stream_open_budget(), budget);
+    p.playback(8).await;
+    let mut foreign_substrate = lifecycle_offer(&p.s, 0, 1, "sendrecv");
+    foreign_substrate["payload"]["substrate"] = json!("websocket+webrtc");
+    p.s.wire.send(p.s.f.sign(foreign_substrate)).await;
+    let error = p.s.wire.read().await;
+    assert_eq!(error.kind(), "error");
+    p.s.f.verify_server(&error).await;
+    assert_eq!(p.s.controller().revision(), 1);
+    assert_eq!(p.s.controller().stream_open_budget(), budget);
+    p.playback(9).await;
+    p.s.wire.server.shutdown().await.unwrap();
+    p.other.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_codec_update_wrong_confirmation_preserves_audio_and_retry_burns_provisional_handle(
+) {
+    let mut p = GatePair::new("quic").await;
+    let request = codec_command(1, &["pcma"]);
+    let callback = codec_callback(&mut p.s, request).await;
+    let old = p.s.controller().active_bindings()[0].clone();
+    let provisional =
+        callback.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"].clone();
+
+    p.playback(1).await;
+    let mut answer = p.s.confirmation(&callback);
+    answer["payload"]["substrate_setup"]["revision"] = json!(99);
+    p.s.wire.send(p.s.f.sign(answer)).await;
+    let error = p.s.wire.read().await;
+    assert_eq!(error.kind(), "error");
+    p.s.f.verify_server(&error).await;
+    p.s.wait(3).await;
+    assert!(matches!(
+        p.s.record.results.lock().unwrap().last().unwrap(),
+        Err(NativeOfferError::Confirmation)
+    ));
+    assert_eq!(p.s.controller().revision(), 1);
+    assert_eq!(
+        p.s.controller().active_bindings()[0].transport_id,
+        old.transport_id
+    );
+    p.playback(2).await;
+    let retry = codec_command(1, &["pcma"]);
+    let callback = codec_callback(&mut p.s, retry.clone()).await;
+    assert_ne!(
+        callback.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"],
+        provisional
+    );
+    p.s.confirm(&callback).await;
+    codec_ack(&mut p.s, &retry).await;
+    p.s.wait(4).await;
+    assert_eq!(p.s.controller().revision(), 2);
+    assert_eq!(p.s.controller().stream_open_budget().0, 3);
+    p.s.wire.server.shutdown().await.unwrap();
+    p.other.server.shutdown().await.unwrap();
+}
+#[tokio::test]
+async fn actual_native_codec_update_lifecycle_requires_fresh_flow_on_confirmed_replacement() {
+    let mut s = Scene::new("quic", false).await;
+    s.record.lifecycle.store(true, Ordering::Release);
+    let (answer, callback) = s.prepared(lifecycle_offer(&s, 0, 0, "sendonly")).await;
+    s.confirm(&callback).await;
+    s.wait(1).await;
+    let first = StreamId::from_string("first");
+    let handle = answer.original()["payload"]["substrate_setup"]["streams"][0]["stream_local_id"]
+        .as_u64()
+        .unwrap() as u16;
+    let mut old = s.controller().take_ingress(&first).unwrap();
+    send(&s.wire, audio_sequence(handle, 1));
+    let _received = packet(&mut old).await;
+    ready_opened(&s.f, &mut s.wire, handle).await;
+    let request = codec_command(1, &["pcma"]);
+    let callback = codec_callback(&mut s, request.clone()).await;
+    s.confirm(&callback).await;
+    codec_ack(&mut s, &request).await;
+    s.wait(2).await;
+    let closed = s.wire.read().await;
+    assert_eq!(closed.kind(), "stream.closed");
+    s.f.verify_server(&closed).await;
+    no_event(&mut s.wire).await;
+    send(&s.wire, audio_sequence(handle, 2));
+    no_event(&mut s.wire).await;
+    let binding = s.controller().active_bindings()[0].clone();
+    let mut input = s.controller().take_ingress(&first).unwrap();
+    send(&s.wire, encoded_audio(binding.stream_local_id, 8, 2));
+    let _fresh = packet(&mut input).await;
+    let opened = s.wire.read().await;
+    assert_eq!(opened.kind(), "stream.opened");
+    s.f.verify_server(&opened).await;
+    assert_eq!(
+        opened.original()["payload"]["stream"]["stream_local_id"],
+        binding.stream_local_id
+    );
+    no_event(&mut s.wire).await;
+    s.wire.server.shutdown().await.unwrap();
+}
