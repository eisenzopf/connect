 impl NativeOfferPlan {
+    /// Select new parameters from the actual update and the last confirmed
+    /// physical peer capabilities. Capability metadata is never a grant.
+    pub(crate) fn codec_update(
+        update: &ConnectionUpdate,
+        profile: &NativeMediaProfile,
+        remote: &EndpointMediaCapabilities,
+        bindings: &[ReadyMediaBinding],
+    ) -> Result<Self, NativeOfferError> {
+        if update.action != ConnectionUpdateAction::CodecRenegotiate {
+            return Err(NativeOfferError::Unsupported);
+        }
+        if update.details.is_some() {
+            return Err(NativeOfferError::Invalid);
+        }
+        let preferences = update
+            .codec_preferences
+            .as_ref()
+            .ok_or(NativeOfferError::Invalid)?;
+        if preferences.is_empty() || preferences.len() > 32 {
+            return Err(NativeOfferError::Invalid);
+        }
+        let mut names = BTreeSet::new();
+        for preference in preferences {
+            if preference.is_empty()
+                || preference.len() > 64
+                || !preference
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"-._/".contains(&b))
+                || !names.insert(normalize(preference))
+            {
+                return Err(NativeOfferError::Invalid);
+            }
+        }
+        let mut targets = BTreeSet::new();
+        match &update.streams {
+            Some(ids) if !ids.is_empty() && ids.len() <= 32 => {
+                for id in ids {
+                    if !bindings
+                        .iter()
+                        .any(|b| b.negotiated.requested.logical_id.as_str() == id)
+                        || !targets.insert(id.as_str())
+                    {
+                        return Err(NativeOfferError::Invalid);
+                    }
+                }
+            }
+            None => targets.extend(
+                bindings
+                    .iter()
+                    .filter(|b| b.negotiated.requested.medium != Medium::Data)
+                    .map(|b| b.negotiated.requested.logical_id.as_str()),
+            ),
+            _ => return Err(NativeOfferError::Invalid),
+        }
+        if targets.is_empty() {
+            return Err(NativeOfferError::NotReady);
+        }
+        let mut selected = Vec::with_capacity(bindings.len());
+        for binding in bindings {
+            let previous = &binding.negotiated;
+            if !targets.contains(previous.requested.logical_id.as_str()) {
+                selected.push(previous.clone());
+                continue;
+            }
+            if previous.requested.medium == Medium::Data {
+                return Err(NativeOfferError::Unsupported);
+            }
+            let mut chosen = None;
+            for name in preferences {
+                for format in remote
+                    .send
+                    .iter()
+                    .chain(&remote.receive)
+                    .filter(|c| c.medium == previous.requested.medium)
+                    .flat_map(|c| &c.formats)
+                {
+                    if format_name(format) != normalize(name) {
+                        continue;
+                    }
+                    let candidate = NegotiatedStream {
+                        requested: previous.requested.clone(),
+                        format: format.clone(),
+                    };
+                    if validate_selected_streams(
+                        &profile.local,
+                        remote,
+                        std::slice::from_ref(&candidate),
+                    )
+                    .is_ok()
+                    {
+                        chosen = Some(candidate);
+                        break;
+                    }
+                }
+                if chosen.is_some() {
+                    break;
+                }
+            }
+            selected.push(chosen.ok_or(NativeOfferError::Unsupported)?);
+        }
+        validate_selected_streams(&profile.local, remote, &selected)
+            .map_err(|_| NativeOfferError::Unsupported)?;
+        Ok(Self {
+            selected,
+            rejected: vec![],
+            remote: remote.clone(),
+        })
+    }
     pub fn selected(&self) -> &[NegotiatedStream] {
         &self.selected
     }
