+    /// Metadata for an unfiltered Participant selector. The installed profile
+    /// and last confirmed/declarative receiver capabilities bound future kinds;
+    /// this neither grants source authority nor allocates a receive port.
+    pub(crate) fn subscription_media(
+        &self,
+    ) -> Result<std::collections::BTreeSet<Medium>, NativeOfferError> {
+        let retained = self.retained.lock().unwrap_or_else(|p| p.into_inner());
+        let retained = retained.as_ref().ok_or(NativeOfferError::NotReady)?;
+        let remote = retained.future_capabilities();
+        Ok(self.profile.local.send.iter().filter(|local| {
+            remote.receive.iter().any(|peer| {
+                peer.medium == local.medium
+                    && local.formats.iter().any(|f| peer.formats.contains(f))
+            })
+        }).map(|c| c.medium).collect())
     }
