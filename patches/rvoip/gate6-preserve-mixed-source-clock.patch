+            Some(crate::stream::MediaClockAnchor {
+                ntp_time: base.wrapping_add_signed(low),
+                rtp_time: timestamp,
+                clock_rate: output_rate,
+            })
+        }
+    } else {
+        None
+    };
+    Some(crate::stream::MediaSourceClock {
+        source_id: if one_source {
+            first.source_id
+        } else {
+            mixed_source
+        },
+        generation: if one_source { first.generation } else { 1 },
+        anchor,
+        supported,
+        rtp_offset: 0,
+        is_current: Arc::new(move || route() && clocks.iter().all(|c| (c.is_current)())),
+    })
