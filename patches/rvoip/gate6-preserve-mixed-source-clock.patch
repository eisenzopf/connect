+struct ClockPoint {
+    clock: Option<crate::stream::MediaSourceClock>,
+    start: Option<u64>,
+    supported: bool,
+}
+impl ClockPoint {
+    fn new(
+        frame: &MediaFrame,
+        consumed: usize,
+        source_rate: u32,
+        mix_rate: u32,
+        offset: usize,
+    ) -> Self {
+        let clock = frame.source_clock.clone();
+        let mut supported = clock.as_ref().is_some_and(|c| c.supported);
+        let start = clock.as_ref().and_then(|c| c.anchor).and_then(|anchor| {
+            if !supported || anchor.clock_rate != source_rate || source_rate == 0 || mix_rate == 0 {
+                supported = false;
+                return None;
+            }
+            let delta = frame
+                .timestamp_rtp
+                .wrapping_sub(clock.as_ref().unwrap().rtp_offset)
+                .wrapping_sub(anchor.rtp_time) as i32;
+            if delta == i32::MIN {
+                supported = false;
+                return None;
+            }
+            // Signed RTP wrap and rational PCM offsets use the original capture
+            // clock; wall time and packet age are intentionally unrelated.
+            let source = ((i128::from(delta) << 32).div_euclid(i128::from(source_rate))) as i64;
+            let samples =
+                ((consumed as i128 - offset as i128) << 32).div_euclid(i128::from(mix_rate));
+            let Ok(samples) = i64::try_from(samples) else {
+                supported = false;
+                return None;
+            };
+            Some(
+                anchor
+                    .ntp_time
+                    .wrapping_add_signed(source)
+                    .wrapping_add_signed(samples),
+            )
+        });
+        Self {
+            clock,
+            start,
+            supported,
+        }
+    }
+}
+fn mixed_clock(
+    points: Vec<ClockPoint>,
+    mix_rate: u32,
+    output_rate: u32,
+    timestamp: u32,
+    mixed_source: u128,
+    route: Arc<dyn Fn() -> bool + Send + Sync>,
+) -> Option<crate::stream::MediaSourceClock> {
+    let clocks = points
+        .iter()
+        .filter_map(|p| p.clock.clone())
+        .collect::<Vec<_>>();
+    let first = clocks.first()?.clone();
+    let one_source = points.len() == clocks.len()
+        && clocks
+            .iter()
+            .all(|c| c.source_id == first.source_id && c.generation == first.generation);
+    let mut supported = mix_rate > 0 && output_rate > 0 && points.iter().all(|p| p.supported);
+    let waiting = points.iter().any(|p| p.start.is_none());
+    let anchor = if supported && !waiting {
+        let base = points[0].start.unwrap();
+        let mut low = 0i64;
+        let mut high = 0i64;
+        for point in &points {
+            let delta = point.start.unwrap().wrapping_sub(base) as i64;
+            low = low.min(delta);
+            high = high.max(delta);
+        }
