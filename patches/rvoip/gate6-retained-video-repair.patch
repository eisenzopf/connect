+//! Bounded repair of one successfully submitted original VP8 RTP packet.
+//! Retention holds metadata and bytes only. Every repair reacquires the original
+//! source/target tickets and current policy through ordinary queued delivery.
+use super::*;
+
+/// Upper bound on explicit repair attempts for one original packet/recipient.
+pub const MAX_VIDEO_REPAIRS: u32 = 4;
+
+/// Issued only after the original guarded send returns success. A transport
+/// binds this opaque handle to that exact sent RTP identity in its bounded
+/// repair cache; it cannot substitute a new source, recipient or packet.
+/// No permission reader survives between repair attempts.
+pub struct VideoRepair {
+    queued: QueuedMedia,
+    remaining: AtomicU32,
+    expires: Instant,
+}
+impl std::fmt::Debug for VideoRepair {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("VideoRepair(redacted)")
+    }
+}
+impl VideoRepair {
+    /// Original age cutoff, never an authorization or readiness observation.
+    pub fn expires_at(&self) -> Instant {
+        self.expires
+    }
+
+    /// One explicit repair request, not an automatic retry of uncertain IO.
+    /// Every call consumes one attempt, even when current admission refuses.
+    /// Dropping the future destroys active IO before releasing its Core guards.
+    pub async fn repair<F, Fut>(&self, send: F) -> ControlResult<()>
+    where
+        F: FnOnce(MediaFrame, Option<MediaDeliveryOrigin>) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        if Instant::now() >= self.expires {
+            return Err(StreamControlError::Deadline);
+        }
+        self.remaining
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |n| n.checked_sub(1))
+            .map_err(|_| StreamControlError::Backpressure)?;
+        self.queued.video_copy().deliver_with_origin(send).await
+    }
+}
+impl QueuedMedia {
+    // Deliberately private; generic queued audio/data must remain one-use.
+    fn video_copy(&self) -> Self {
+        Self {
+            frame: self.frame.clone(),
+            data: None,
+            local: None,
+            sources: self.sources.clone(),
+            target: self.target.clone(),
+            target_ticket: self.target_ticket.clone(),
+            target_consumer: self.target_consumer.clone(),
+            target_scene: self.target_scene.clone(),
+            subscription: self.subscription.clone(),
+            direct: self.direct.clone(),
+            admitted_at: self.admitted_at,
+        }
+    }
+
+    /// Submit one original video packet and retain it for bounded explicit
+    /// repairs only after successful guarded IO. Failed, cancelled or uncertain
+    /// sends return no handle. Original bytes, target, source identity, route
+    /// generations, selection stamp and monotonic arrival time are immutable.
+    pub async fn deliver_video_with_repair<F, Fut>(self, send: F) -> ControlResult<VideoRepair>
+    where
+        F: FnOnce(MediaFrame, Option<MediaDeliveryOrigin>) -> Fut,
+        Fut: Future<Output = ControlResult<()>>,
+    {
+        if self.frame.kind != StreamKind::Video
+            || self.data.is_some()
+            || self.local.is_some()
+            || self.sources.len() != 1
+            || !matches!(&self.target.binding.negotiated.format,
+                MediaFormat::Encoded { name, clock_rate_hz: 90000, channels: 0, fmtp }
+                if name.eq_ignore_ascii_case("vp8") && fmtp.as_ref().is_none_or(|v| v.is_empty()))
+            || self.frame.payload_type.is_none_or(|pt| {
+                crate::video_bridge::normalize_packet(&self.frame, 1, pt).is_none()
+            })
+        {
+            return Err(StreamControlError::Unsupported);
+        }
+        let expires = self.admitted_at + Duration::from_millis(200);
+        let queued = self.video_copy();
+        self.deliver_with_origin(send).await?;
+        if Instant::now() >= expires {
+            return Err(StreamControlError::Deadline);
+        }
+        Ok(VideoRepair {
+            queued,
+            remaining: AtomicU32::new(MAX_VIDEO_REPAIRS),
+            expires,
+        })
+    }
+}
