+#[tokio::test]
+async fn retained_video_rechecks_current_source_target_audience_and_media_grants() {
+    for change in ["source", "target", "audience", "publish", "playback"] {
+        let f = Fixture::new(8);
+        f.start(&[Medium::Video]).await;
+        let repair = retained(&f).await;
+        {
+            let mut policy = f
+                .policy
+                .0
+                .try_write()
+                .expect("retainer held a policy reader");
+            match change {
+                "source" => {
+                    policy.revoked.insert("alice".into());
+                }
+                "target" => {
+                    policy.revoked.insert("bob".into());
+                }
+                "audience" => policy.private = true,
+                "publish" => {
+                    policy
+                        .owners
+                        .get_mut("alice")
+                        .unwrap()
+                        .receive_media
+                        .remove(&Medium::Video);
+                }
+                _ => {
+                    policy
+                        .owners
+                        .get_mut("bob")
+                        .unwrap()
+                        .send_media
+                        .remove(&Medium::Video);
+                }
+            }
+        }
+        assert!(repair
+            .repair(|_, _| async { panic!("withdrawn {change} reached IO") })
+            .await
+            .is_err());
+        assert!(f.policy.0.try_write().is_ok());
+    }
+}
