+//! Retained video bytes never retain current permission or a renewed age budget.
+use super::*;
+use crate::staged_streams::direct_subscriptions::*;
+
+async fn queued(f: &Fixture, medium: Medium) -> QueuedMedia {
+    let source = f.aa.port(medium);
+    let id = desired(medium).logical_id;
+    let mut input = f.a.take_ingress(&id).unwrap();
+    let mut output = f.ba.port(medium).take_egress().unwrap();
+    source.try_publish(&frame(&source, 9000)).unwrap();
+    receive(&mut input).await.try_forward_to(&f.b, &id).unwrap();
+    outgoing(&mut output).await
+}
+async fn retained(f: &Fixture) -> VideoRepair {
+    queued(f, Medium::Video)
+        .await
+        .deliver_video_with_repair(|_, _| async { Ok(()) })
+        .await
+        .unwrap()
+}
+fn selection(f: &Fixture) -> DirectSubscriptionChange {
+    DirectSubscriptionChange::Subscribe(vec![DirectSubscription::new(
+        &f.a,
+        desired(Medium::Video).logical_id.clone(),
+        desired(Medium::Video).logical_id,
+    )])
+}
+
+#[tokio::test]
+async fn successful_video_and_screen_repair_preserve_exact_original_and_bound_attempts() {
+    for medium in [Medium::Video, Medium::Screen] {
+        let f = Fixture::new(8);
+        f.start(&[medium]).await;
+        let original = Arc::new(Mutex::new(None));
+        let saved = original.clone();
+        let repair = queued(&f, medium)
+            .await
+            .deliver_video_with_repair(move |frame, origin| async move {
+                *saved.lock().unwrap() = Some((frame, origin));
+                Ok(())
+            })
+            .await
+            .unwrap();
+        // Retention must not block an unrelated current-policy writer.
+        assert!(f.policy.0.try_write().is_ok());
+        for _ in 0..MAX_VIDEO_REPAIRS {
+            let saved = original.clone();
+            repair
+                .repair(move |frame, origin| async move {
+                    let saved = saved.lock().unwrap();
+                    let (old, old_origin) = saved.as_ref().unwrap();
+                    assert_eq!(frame.payload, old.payload);
+                    assert_eq!(frame.stream_id, old.stream_id);
+                    assert_eq!(frame.timestamp_rtp, old.timestamp_rtp);
+                    assert_eq!(frame.payload_type, old.payload_type);
+                    assert_eq!(frame.captured_at, old.captured_at);
+                    assert!(origin == *old_origin);
+                    Ok(())
+                })
+                .await
+                .unwrap();
+            assert!(f.policy.0.try_write().is_ok());
+        }
+        assert!(matches!(
+            repair
+                .repair(|_, _| async { panic!("repair budget exceeded") })
+                .await,
+            Err(StreamControlError::Backpressure)
+        ));
+    }
+}
