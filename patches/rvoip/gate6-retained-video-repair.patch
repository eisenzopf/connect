+struct IoDrop {
+    policy: Arc<Policy>,
+    observation: Arc<Mutex<Option<bool>>>,
+}
+impl Drop for IoDrop {
+    fn drop(&mut self) {
+        *self.observation.lock().unwrap() = Some(self.policy.0.try_write().is_err());
+    }
+}
+async fn pending_io(f: &Fixture, observed: Arc<Mutex<Option<bool>>>) -> ControlResult<()> {
+    let _io = IoDrop {
+        policy: f.policy.clone(),
+        observation: observed,
+    };
+    std::future::pending().await
+}
+
+async fn aged_pending_io(repair: bool) {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let packet = queued(&f, Medium::Video).await;
+    let expires = packet.admitted_at + Duration::from_millis(200);
+    let mut original = Some(packet);
+    let retained = if repair {
+        Some(
+            original
+                .take()
+                .unwrap()
+                .deliver_video_with_repair(|_, _| async { Ok(()) })
+                .await
+                .unwrap(),
+        )
+    } else {
+        None
+    };
+    tokio::time::sleep_until(tokio::time::Instant::from_std(
+        expires - Duration::from_millis(40),
+    ))
+    .await;
+    let observed = Arc::new(Mutex::new(None));
+    let result = if let Some(retained) = retained {
+        tokio::time::timeout(
+            Duration::from_millis(100),
+            retained.repair(|_, _| pending_io(&f, observed.clone())),
+        )
+        .await
+    } else {
+        tokio::time::timeout(
+            Duration::from_millis(100),
+            original
+                .take()
+                .unwrap()
+                .deliver(|_| pending_io(&f, observed.clone())),
+        )
+        .await
+    };
+    assert!(
+        matches!(result, Ok(Err(StreamControlError::Deadline))),
+        "age budget renewed: {result:?}"
+    );
+    assert_eq!(
+        *observed.lock().unwrap(),
+        Some(true),
+        "IO outlived permission"
+    );
+    assert!(f.policy.0.try_write().is_ok());
+}
+#[tokio::test]
+async fn original_video_pending_io_keeps_original_age() {
+    aged_pending_io(false).await;
+}
+#[tokio::test]
+async fn repair_video_pending_io_keeps_original_age() {
+    aged_pending_io(true).await;
+}
