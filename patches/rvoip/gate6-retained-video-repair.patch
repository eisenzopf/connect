+#[tokio::test]
+async fn source_and_target_pause_resume_invalidate_old_video_repair() {
+    for source in [true, false] {
+        let f = Fixture::new(8);
+        f.start(&[Medium::Video]).await;
+        let repair = retained(&f).await;
+        let c = if source { &f.a } else { &f.b };
+        let ids = [desired(Medium::Video).logical_id].into_iter().collect();
+        for action in [StreamGateAction::Pause, StreamGateAction::Resume] {
+            c.set_media_gate(c.revision(), &ids, action, deadline())
+                .await
+                .unwrap();
+            assert!(repair
+                .repair(|_, _| async { panic!("old gate reached IO") })
+                .await
+                .is_err());
+        }
+    }
+}
