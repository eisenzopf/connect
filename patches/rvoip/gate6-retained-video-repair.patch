+#[tokio::test]
+async fn expired_failed_and_unsupported_originals_never_issue_repair_authority() {
+    for medium in [Medium::Audio, Medium::Data] {
+        let f = Fixture::new(8);
+        f.start(&[medium]).await;
+        // Audio has its own consumer; directly route this controlled fixture.
+        let source = f.aa.port(medium);
+        let id = desired(medium).logical_id;
+        let mut input = f.a.take_ingress(&id).unwrap();
+        let mut output = f.ba.port(medium).take_egress().unwrap();
+        source.try_publish(&frame(&source, 9000)).unwrap();
+        receive(&mut input).await.try_forward_to(&f.b, &id).unwrap();
+        assert!(matches!(
+            outgoing(&mut output)
+                .await
+                .deliver_video_with_repair(|_, _| async { panic!("non-video reached IO") })
+                .await,
+            Err(StreamControlError::Unsupported)
+        ));
+    }
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    assert!(matches!(
+        queued(&f, Medium::Video)
+            .await
+            .deliver_video_with_repair(|_, _| async { Err(StreamControlError::NotReady) })
+            .await,
+        Err(StreamControlError::NotReady)
+    ));
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let repair = retained(&f).await;
+    tokio::time::sleep_until(tokio::time::Instant::from_std(
+        repair.expires_at() + Duration::from_millis(1),
+    ))
+    .await;
+    assert!(matches!(
+        repair
+            .repair(|_, _| async { panic!("expired repair reached IO") })
+            .await,
+        Err(StreamControlError::Deadline)
+    ));
+}
+
+#[tokio::test]
+async fn cancelled_repair_future_destroys_io_before_releasing_current_policy() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let repair = retained(&f).await;
+    let observed = Arc::new(Mutex::new(None));
+    let mut send = Box::pin(repair.repair(|_, _| pending_io(&f, observed.clone())));
+    assert!(
+        std::future::poll_fn(|cx| std::task::Poll::Ready(send.as_mut().poll(cx)))
+            .await
+            .is_pending()
+    );
+    assert!(f.policy.0.try_write().is_err());
+    drop(send);
+    assert_eq!(*observed.lock().unwrap(), Some(true));
+    assert!(f.policy.0.try_write().is_ok());
+}
+
+#[tokio::test]
+async fn concurrent_repair_requests_share_one_atomic_attempt_budget() {
+    let f = Fixture::new(8);
+    f.start(&[Medium::Video]).await;
+    let repair = retained(&f).await;
+    let repair = Arc::new(repair);
+    let writes = Arc::new(AtomicUsize::new(0));
+    let mut jobs = tokio::task::JoinSet::new();
+    for _ in 0..12 {
+        let repair = repair.clone();
+        let writes = writes.clone();
+        jobs.spawn(async move {
+            repair
+                .repair(|_, _| async {
+                    writes.fetch_add(1, Ordering::AcqRel);
+                    tokio::task::yield_now().await;
+                    Ok(())
+                })
+                .await
+        });
+    }
+    let mut results = Vec::new();
+    while let Some(result) = jobs.join_next().await {
+        results.push(result.unwrap());
+    }
+    assert_eq!(
+        results.iter().filter(|r| r.is_ok()).count(),
+        MAX_VIDEO_REPAIRS as usize
+    );
+    assert_eq!(writes.load(Ordering::Acquire), MAX_VIDEO_REPAIRS as usize);
+    assert!(f.policy.0.try_write().is_ok());
+}
+
+type Expiry = Arc<Mutex<Option<(String, chrono::DateTime<chrono::Utc>)>>>;
+struct ExpiringPolicy {
+    inner: Arc<Policy>,
+    expiry: Expiry,
+}
+struct ExpiringLease {
+    inner: Box<dyn MediaAuthorityLease>,
+    expiry: Option<chrono::DateTime<chrono::Utc>>,
+}
+impl MediaAuthorityLease for ExpiringLease {
+    fn authority(&self) -> &MediaOwner {
+        self.inner.authority()
+    }
+    fn expires_at(&self) -> Option<chrono::DateTime<chrono::Utc>> {
+        self.expiry
+    }
+}
+impl MediaPolicy for ExpiringPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        let expiry = self
+            .expiry
+            .lock()
+            .unwrap()
+            .as_ref()
+            .filter(|(name, _)| name == scope.connection.as_str())
+            .map(|(_, at)| *at);
+        Ok(Box::new(ExpiringLease {
+            inner: self.inner.current(scope)?,
+            expiry,
+        }))
+    }
+}
+#[tokio::test]
+async fn repair_obeys_new_shorter_source_and_recipient_grants_without_idle_readers() {
+    for connection in ["alice", "bob"] {
+        let expiry: Expiry = Arc::new(Mutex::new(None));
+        let f = Fixture::with_policy(
+            8,
+            Some(Box::new({
+                let expiry = expiry.clone();
+                move |inner| Arc::new(ExpiringPolicy { inner, expiry })
+            })),
+        );
+        f.start(&[Medium::Video]).await;
+        let repair = retained(&f).await;
+        assert!(f.policy.0.try_write().is_ok());
+        *expiry.lock().unwrap() = Some((
+            connection.into(),
+            chrono::Utc::now() + chrono::Duration::milliseconds(30),
+        ));
+        let observed = Arc::new(Mutex::new(None));
+        let result = tokio::time::timeout(
+            Duration::from_millis(100),
+            repair.repair(|_, _| pending_io(&f, observed.clone())),
+        )
+        .await;
+        assert!(
+            matches!(result, Ok(Err(StreamControlError::Deadline))),
+            "old grant used by repair: {result:?}"
+        );
+        assert_eq!(*observed.lock().unwrap(), Some(true));
+        assert!(f.policy.0.try_write().is_ok());
+    }
+}
