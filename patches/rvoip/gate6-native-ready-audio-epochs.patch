+//! Finite, owned ready-audio epochs. Queues contain metadata, never authority.
+use super::*;
+use tokio::sync::oneshot;
+mod epoch;
+pub(crate) struct ReadyAudioEgress {
+    queue: Arc<epoch::EpochQueue<Job>>,
+}
+pub(super) struct SendRoute {
+    pub binding: ReadyMediaBinding,
+    pub pt: u8,
+    pub transport: Arc<dyn StagedDatagramTransport>,
+    pub flow: Option<Arc<crate::native_flow::NativeFlow>>,
+    pub port: WeakAdapterMediaPort,
+    pub counters: Arc<StagedRtpCounters>,
+    pub cancel: CancellationToken,
+    pub lifetime: CancellationToken,
+}
+struct Job {
+    queued: QueuedMedia,
+    context: SendContext,
+}
+struct SendContext {
+    packetizer: Packetizer,
+    route: Arc<SendRoute>,
+    reply: oneshot::Sender<Completion>,
+}
+struct Completion {
+    packetizer: Packetizer,
+    delivery: ReadyAudioDelivery,
+}
+struct BatchWait {
+    epoch: epoch::EpochWait<Job>,
+    reply: oneshot::Receiver<Completion>,
+}
+impl ReadyAudioEgress {
+    pub(crate) fn new() -> Arc<Self> {
+        Arc::new(Self {
+            queue: epoch::EpochQueue::new(Self::submit_ready),
+        })
+    }
+    fn enqueue(
+        self: &Arc<Self>,
+        queued: QueuedMedia,
+        packetizer: Packetizer,
+        route: Arc<SendRoute>,
+    ) -> Result<BatchWait, (Packetizer, StreamControlError)> {
+        let (reply, response) = oneshot::channel();
+        let job = Job {
+            queued,
+            context: SendContext {
+                packetizer,
+                route,
+                reply,
+            },
+        };
+        match self.queue.enqueue(job) {
+            Ok(epoch) => Ok(BatchWait {
+                epoch,
+                reply: response,
+            }),
+            Err(job) => Err((job.context.packetizer, StreamControlError::Backpressure)),
+        }
+    }
+    fn submit_ready(ready: Vec<Job>) {
+        let mut groups: Vec<Vec<Job>> = Vec::new();
+        for job in ready {
+            if job.context.reply.is_closed() {
+                continue;
+            }
+            if let Some(group) = groups
+                .iter_mut()
+                .find(|group| group[0].queued.same_audio_packet(&job.queued))
+            {
+                group.push(job);
+            } else {
+                groups.push(vec![job]);
+            }
+        }
+        for group in groups {
+            let (frames, mut contexts): (Vec<_>, Vec<_>) = group
+                .into_iter()
+                .map(|job| (job.queued, job.context))
+                .unzip();
+            let delivered =
+                QueuedMedia::deliver_ready_audio_batch(frames, |index, frame, origin| {
+                    let context = &mut contexts[index];
+                    let route = &context.route;
+                    if context.reply.is_closed()
+                        || route.cancel.is_cancelled()
+                        || route.lifetime.is_cancelled()
+                        || route.transport.is_closed()
+                    {
+                        return Err(StreamControlError::Cancelled);
+                    }
+                    context
+                        .packetizer
+                        .send(
+                            frame,
+                            origin,
+                            &route.binding,
+                            route.pt,
+                            route.transport.as_ref(),
+                            |bytes| {
+                                route.counters.local_sends.fetch_add(1, Ordering::AcqRel);
+                                if let (Some(flow), Some(port)) =
+                                    (&route.flow, route.port.upgrade())
+                                {
+                                    flow.sent(&port);
+                                    flow.record_rtp(&port, false, bytes);
+                                }
+                            },
+                        )
+                        .map(|_| ())
+                });
+            assert_eq!(delivered.len(), contexts.len());
+            // Core returned only after every actual reader was released. A
+            // refusal receipt contains the unchanged original metadata alone.
+            for (delivery, context) in delivered.into_iter().zip(contexts) {
+                let _ = context.reply.send(Completion {
+                    packetizer: context.packetizer,
+                    delivery,
+                });
+            }
+        }
+    }
+    pub(super) async fn send(
+        self: &Arc<Self>,
+        mut queued: QueuedMedia,
+        mut packetizer: Packetizer,
+        route: Arc<SendRoute>,
+    ) -> Result<(Packetizer, ControlResult<()>), ()> {
+        loop {
+            if route.cancel.is_cancelled()
+                || route.lifetime.is_cancelled()
+                || route.transport.is_closed()
+            {
+                return Ok((packetizer, Err(StreamControlError::Cancelled)));
+            }
+            let waiting = match self.enqueue(queued, packetizer, route.clone()) {
+                Ok(waiting) => waiting,
+                Err((returned, problem)) => return Ok((returned, Err(problem))),
+            };
+            let completion = waiting.reply.await.map_err(|_| ());
+            // Even cancellation/closed replies must join the actual finite IO
+            // task before the owning port can report successful cleanup.
+            waiting.epoch.join().await?;
+            let completion = completion?;
+            packetizer = completion.packetizer;
+            match completion.delivery {
+                ReadyAudioDelivery::Refused {
+                    queued: original,
+                    problem: StreamControlError::NotReady,
+                } => {
+                    queued = original;
+                    tokio::select! { biased;
+                        _=route.cancel.cancelled()=>return Ok((packetizer,Err(StreamControlError::Cancelled))),
+                        _=route.lifetime.cancelled()=>return Ok((packetizer,Err(StreamControlError::Cancelled))),
+                        _=tokio::time::sleep(std::time::Duration::from_millis(1))=>{}
+                    }
+                }
+                ReadyAudioDelivery::Refused { problem, .. } => {
+                    return Ok((packetizer, Err(problem)))
+                }
+                ReadyAudioDelivery::Submitted(result) => return Ok((packetizer, result)),
+            }
+        }
+    }
+}
