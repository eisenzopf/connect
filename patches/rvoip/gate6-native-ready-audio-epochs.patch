+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let source = f.an.binding(Medium::Audio).stream_local_id;
+    f.b_fault.mode.store(1, Ordering::Release);
+    f.a_peer
+        .remote
+        .send_datagram(audio_datagram(source, 160))
+        .unwrap();
+    incoming(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    let end = tokio::time::Instant::now() + Duration::from_secs(1);
+    while f.ba.counters().snapshot().send_errors == 0 {
+        assert!(tokio::time::Instant::now() < end);
