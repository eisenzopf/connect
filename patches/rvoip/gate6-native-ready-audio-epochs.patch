+    };
+    use tokio::sync::Notify;
+    struct Gate {
+        entered: Notify,
+        open: Mutex<bool>,
+        changed: Condvar,
+    }
+    impl Gate {
+        fn release(&self) {
+            *self.open.lock().unwrap() = true;
+            self.changed.notify_all();
+        }
+    }
+    struct Release(Arc<Gate>);
+    impl Drop for Release {
+        fn drop(&mut self) {
+            self.0.release();
+        }
+    }
+    struct Item {
+        seen: Arc<AtomicUsize>,
+        dropped: Arc<AtomicUsize>,
+        sizes: Arc<Mutex<Vec<usize>>>,
+        panic: bool,
+        hold: Option<Arc<Gate>>,
+    }
+    impl Drop for Item {
+        fn drop(&mut self) {
+            self.dropped.fetch_add(1, Ordering::AcqRel);
+        }
+    }
+    fn dispatch(items: Vec<Item>) {
+        if let Some(first) = items.first() {
+            first.sizes.lock().unwrap().push(items.len());
+        }
+        for item in items {
+            item.seen.fetch_add(1, Ordering::AcqRel);
+            assert!(!item.panic, "controlled finite epoch panic");
+            if let Some(gate) = &item.hold {
+                gate.entered.notify_one();
+                let open = gate.open.lock().unwrap();
+                let (open, _) = gate
+                    .changed
+                    .wait_timeout_while(open, std::time::Duration::from_secs(1), |v| !*v)
+                    .unwrap();
+                assert!(*open, "controlled dispatcher was never released");
+            }
+        }
+    }
+    fn item(
+        seen: &Arc<AtomicUsize>,
+        dropped: &Arc<AtomicUsize>,
+        sizes: &Arc<Mutex<Vec<usize>>>,
+    ) -> Item {
+        Item {
+            seen: seen.clone(),
+            dropped: dropped.clone(),
+            sizes: sizes.clone(),
+            panic: false,
+            hold: None,
+        }
+    }
+    #[tokio::test]
+    async fn full_epoch_queue_returns_unchanged_metadata_without_dispatch_then_recovers() {
+        let (seen, dropped, sizes) = (
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(Mutex::new(Vec::new())),
+        );
+        let queue = EpochQueue::with_bounds(2, 2, dispatch);
+        let one = queue
+            .enqueue(item(&seen, &dropped, &sizes))
+            .unwrap_or_else(|_| panic!("first refused"));
+        let two = queue
+            .enqueue(item(&seen, &dropped, &sizes))
+            .unwrap_or_else(|_| panic!("second refused"));
+        let third = match queue.enqueue(item(&seen, &dropped, &sizes)) {
+            Err(item) => item,
+            Ok(_) => panic!("capacity exceeded"),
+        };
+        assert_eq!(seen.load(Ordering::Acquire), 0);
+        one.join().await.unwrap();
+        two.join().await.unwrap();
+        assert_eq!(seen.load(Ordering::Acquire), 2);
+        assert_eq!(dropped.load(Ordering::Acquire), 2);
+        queue
+            .enqueue(third)
+            .unwrap_or_else(|_| panic!("capacity never returned"))
+            .join()
+            .await
+            .unwrap();
+        assert_eq!(seen.load(Ordering::Acquire), 3);
+        assert_eq!(dropped.load(Ordering::Acquire), 3);
+    }
+    #[tokio::test]
+    async fn epoch_limit_splits_ready_metadata_into_bounded_owned_dispatches() {
+        let (seen, dropped, sizes) = (
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(Mutex::new(Vec::new())),
+        );
+        let queue = EpochQueue::with_bounds(2, 4, dispatch);
+        let waits = (0..3)
+            .map(|_| {
+                queue
+                    .enqueue(item(&seen, &dropped, &sizes))
+                    .unwrap_or_else(|_| panic!("bounded job refused"))
+            })
+            .collect::<Vec<_>>();
+        for wait in waits {
+            wait.join().await.unwrap();
+        }
+        let mut batches = sizes.lock().unwrap().clone();
+        batches.sort_unstable();
+        assert_eq!(batches, vec![1, 2]);
+        assert_eq!(seen.load(Ordering::Acquire), 3);
+        assert_eq!(dropped.load(Ordering::Acquire), 3);
+    }
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn owned_join_waits_for_dispatch_and_serializes_other_epochs() {
+        let (seen, dropped, sizes) = (
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(Mutex::new(Vec::new())),
+        );
+        let gate = Arc::new(Gate {
+            entered: Notify::new(),
+            open: Mutex::new(false),
+            changed: Condvar::new(),
+        });
+        let _release = Release(gate.clone());
+        let queue = EpochQueue::with_bounds(1, 2, dispatch);
+        let mut held = item(&seen, &dropped, &sizes);
+        held.hold = Some(gate.clone());
+        let first = queue
+            .enqueue(held)
+            .unwrap_or_else(|_| panic!("held refused"));
+        tokio::time::timeout(std::time::Duration::from_secs(1), gate.entered.notified())
+            .await
+            .unwrap();
+        let second = queue
+            .enqueue(item(&seen, &dropped, &sizes))
+            .unwrap_or_else(|_| panic!("next refused"));
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(10), first.join())
+                .await
+                .is_err()
+        );
+        assert!(
+            tokio::time::timeout(std::time::Duration::from_millis(10), second.join())
+                .await
+                .is_err()
+        );
+        assert_eq!(seen.load(Ordering::Acquire), 1);
+        gate.release();
+        first.join().await.unwrap();
+        second.join().await.unwrap();
+        assert_eq!(seen.load(Ordering::Acquire), 2);
+        assert_eq!(dropped.load(Ordering::Acquire), 2);
+    }
+    #[tokio::test]
+    async fn dispatcher_panic_is_join_failure_releases_capacity_and_next_epoch_can_run() {
+        let (seen, dropped, sizes) = (
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(Mutex::new(Vec::new())),
+        );
+        let queue = EpochQueue::with_bounds(1, 1, dispatch);
+        let mut bad = item(&seen, &dropped, &sizes);
+        bad.panic = true;
+        assert!(queue
+            .enqueue(bad)
+            .unwrap_or_else(|_| panic!("panic job refused"))
+            .join()
+            .await
+            .is_err());
+        assert_eq!(dropped.load(Ordering::Acquire), 1);
+        queue
+            .enqueue(item(&seen, &dropped, &sizes))
+            .unwrap_or_else(|_| panic!("panic retained capacity"))
+            .join()
+            .await
+            .unwrap();
+        assert_eq!(seen.load(Ordering::Acquire), 2);
+        assert_eq!(dropped.load(Ordering::Acquire), 2);
+    }
+    #[tokio::test]
+    async fn dropped_queue_discards_pending_metadata_before_join_without_dispatch() {
+        let (seen, dropped, sizes) = (
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(AtomicUsize::new(0)),
+            Arc::new(Mutex::new(Vec::new())),
+        );
+        let queue = EpochQueue::with_bounds(1, 1, dispatch);
+        let wait = queue
+            .enqueue(item(&seen, &dropped, &sizes))
+            .unwrap_or_else(|_| panic!("pending refused"));
+        drop(queue);
+        wait.join().await.unwrap();
+        assert_eq!(seen.load(Ordering::Acquire), 0);
+        assert_eq!(dropped.load(Ordering::Acquire), 1);
+    }
+}
