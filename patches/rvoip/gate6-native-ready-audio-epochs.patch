+//! Bounded finite metadata epochs with owned joins. No admission is done here.
+use futures::{
+    future::{BoxFuture, Shared},
+    FutureExt,
+};
+use rvoip_core::staged_streams::MAX_READY_AUDIO_BATCH;
+use std::sync::{Arc, Mutex};
+use tokio::{
+    sync::{Mutex as AsyncMutex, OwnedSemaphorePermit, Semaphore},
+    task::AbortHandle,
+};
+
+const MAX_PENDING: usize = 4096;
+type EpochJoin = Shared<BoxFuture<'static, Result<(), ()>>>;
+
+pub(super) struct EpochQueue<T> {
+    collecting: Mutex<Option<Arc<Epoch<T>>>>,
+    execution: AsyncMutex<()>,
+    slots: Arc<Semaphore>,
+    maximum_epoch: usize,
+    dispatch: fn(Vec<T>),
+}
+struct Epoch<T> {
+    entries: Arc<Mutex<Vec<(T, OwnedSemaphorePermit)>>>,
+    join: EpochJoin,
+    abort: AbortHandle,
+}
+impl<T> Drop for Epoch<T> {
+    fn drop(&mut self) {
+        self.abort.abort();
+    }
+}
+pub(super) struct EpochWait<T>(Arc<Epoch<T>>);
+impl<T> EpochWait<T> {
+    pub(super) async fn join(&self) -> Result<(), ()> {
+        self.0.join.clone().await
+    }
+}
+impl<T: Send + 'static> EpochQueue<T> {
+    pub(super) fn new(dispatch: fn(Vec<T>)) -> Arc<Self> {
+        Self::with_bounds(MAX_READY_AUDIO_BATCH, MAX_PENDING, dispatch)
+    }
+    fn with_bounds(
+        maximum_epoch: usize,
+        maximum_pending: usize,
+        dispatch: fn(Vec<T>),
+    ) -> Arc<Self> {
+        assert!(maximum_epoch > 0 && maximum_epoch <= MAX_READY_AUDIO_BATCH);
+        assert!(maximum_pending > 0 && maximum_pending <= MAX_PENDING);
+        Arc::new(Self {
+            collecting: Mutex::new(None),
+            execution: AsyncMutex::new(()),
+            slots: Arc::new(Semaphore::new(maximum_pending)),
+            maximum_epoch,
+            dispatch,
+        })
+    }
+    pub(super) fn enqueue(self: &Arc<Self>, item: T) -> Result<EpochWait<T>, T> {
+        let slot = match self.slots.clone().try_acquire_owned() {
+            Ok(slot) => slot,
+            Err(_) => return Err(item),
+        };
+        let mut collecting = self.collecting.lock().unwrap_or_else(|p| p.into_inner());
+        let epoch = match collecting.as_ref().filter(|epoch| {
+            epoch
+                .entries
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .len()
+                < self.maximum_epoch
+        }) {
+            Some(epoch) => epoch.clone(),
+            None => {
+                let entries = Arc::new(Mutex::new(Vec::with_capacity(self.maximum_epoch)));
+                let ready = entries.clone();
+                let queue = Arc::downgrade(self);
+                let task = tokio::spawn(async move {
+                    tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+                    let Some(queue) = queue.upgrade() else {
+                        // A successful join also confirms release of metadata,
+                        // including any reply senders and transport resources.
+                        ready.lock().unwrap_or_else(|p| p.into_inner()).clear();
+                        return;
+                    };
+                    {
+                        let mut collecting =
+                            queue.collecting.lock().unwrap_or_else(|p| p.into_inner());
+                        if collecting
+                            .as_ref()
+                            .is_some_and(|epoch| Arc::ptr_eq(&epoch.entries, &ready))
+                        {
+                            collecting.take();
+                        }
+                    }
+                    let pending =
+                        std::mem::take(&mut *ready.lock().unwrap_or_else(|p| p.into_inner()));
+                    let (items, _slots): (Vec<_>, Vec<_>) = pending.into_iter().unzip();
+                    // Only metadata waits here. The synchronous dispatcher must
+                    // finish and release actual IO readers before this join.
+                    let _execution = queue.execution.lock().await;
+                    (queue.dispatch)(items);
+                });
+                let abort = task.abort_handle();
+                let epoch = Arc::new(Epoch {
+                    entries,
+                    join: async move { task.await.map_err(|_| ()) }.boxed().shared(),
+                    abort,
+                });
+                *collecting = Some(epoch.clone());
+                epoch
+            }
+        };
+        epoch
+            .entries
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .push((item, slot));
+        Ok(EpochWait(epoch))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        atomic::{AtomicUsize, Ordering},
