+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn ready_native_close_waits_for_actual_send_continuation_and_joins_epoch() {
+    let mut f = Fixture::new().await;
+    f.start(&[Medium::Audio]).await;
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let source = f.an.binding(Medium::Audio).stream_local_id;
+    let _release = ReleaseCarrier(f.b_fault.clone());
+    f.b_fault.mode.store(2, Ordering::Release);
+    f.a_peer
+        .remote
+        .send_datagram(audio_datagram(source, 160))
+        .unwrap();
+    incoming(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(1), f.b_fault.entered.notified())
+        .await
+        .unwrap();
+    // A wall-clock observer releases the deliberately synchronous callback.
+    // Tokio timers/QUIC polling may share the worker held by that callback.
+    let (closing, started) = std::sync::mpsc::channel();
+    let finished = Arc::new(AtomicBool::new(false));
+    let observed = finished.clone();
+    let fault = f.b_fault.clone();
+    let probe = std::thread::spawn(move || {
+        let _release = ReleaseCarrier(fault);
+        started.recv_timeout(Duration::from_secs(1)).unwrap();
+        std::thread::sleep(Duration::from_millis(10));
+        !observed.load(Ordering::Acquire)
+    });
+    let target = f.b.clone();
+    let close = tokio::spawn(async move {
+        closing.send(()).unwrap();
+        let result = target.shutdown(deadline()).await;
+        finished.store(true, Ordering::Release);
+        result
+    });
+    assert_eq!(close.await.unwrap(), 0);
+    assert!(
+        probe.join().unwrap(),
+        "cleanup completed before the actual IO task joined"
+    );
+    decoded_tone(&wire(&f.b_peer).await);
+    assert_eq!(f.b_fault.calls.load(Ordering::Acquire), 1);
+    drop(
+        f.policy
+            .0
+            .clone()
+            .try_write_owned()
+            .expect("closed epoch retained policy authority"),
+    );
+    f.stop().await;
+}
