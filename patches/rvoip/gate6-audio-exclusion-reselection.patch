diff --git a/crates/foundation/rvoip-core/src/staged_streams/tests/media_scene/subscriptions.rs b/crates/foundation/rvoip-core/src/staged_streams/tests/media_scene/subscriptions.rs
--- a/crates/foundation/rvoip-core/src/staged_streams/tests/media_scene/subscriptions.rs
+++ b/crates/foundation/rvoip-core/src/staged_streams/tests/media_scene/subscriptions.rs
