+#[tokio::test]
+async fn resource_subscription_real_capacity_is_not_metadata_retry() {
+    let (scene, _, held) = data_candidate().await;
+    let calls = scene.f.ba.prepare_calls.load(Ordering::Acquire);
+    let budget = scene.f.b.stream_open_budget();
+    let available = scene.f.b.slots.available_permits() as u32;
+    let occupied = scene
+        .f
+        .b
+        .slots
+        .clone()
+        .try_acquire_many_owned(available)
+        .unwrap();
+    let replace = BTreeSet::new();
+    let mut update = Box::pin(scene.f.b.change_selected_and_subscriptions(
+        held.expected,
+        held.selected.as_ref().unwrap(),
+        &replace,
+        scene.scene.clone(),
+        &held.change,
+        deadline(),
+        CancellationToken::new(),
+        Arc::new(held.clone()),
+    ));
+    let observed = poll_once(update.as_mut()).await;
+    assert!(
+        matches!(
+            observed,
+            Poll::Ready(Err(StreamControlError::Model(
+                MediaTransitionError::Capacity
+            )))
+        ),
+        "real allocation exhaustion must be returned immediately, got {observed:?}"
+    );
+    drop(update);
+    assert_eq!(scene.f.ba.prepare_calls.load(Ordering::Acquire), calls);
+    assert_eq!(scene.f.b.revision(), held.expected);
+    assert_eq!(scene.f.b.stream_open_budget(), budget);
+    drop(occupied);
+    drop(held);
+    joined(&scene).await;
+}
