+/// Only a failed read-only prepared-routing validation can request another
+/// metadata turn. This type cannot carry an engine/adapter/capacity error into
+/// the retry arm, and the actual graph commit never returns MetadataBusy.
+#[derive(Debug)]
+pub(super) enum PreparedCommitError {
+    MetadataBusy,
+    Refused(StreamControlError),
+}
+impl PreparedCommitError {
+    pub(super) fn routing_validation(error: StreamControlError) -> Self {
+        match error {
+            StreamControlError::Backpressure | StreamControlError::MetadataBusy => {
+                Self::MetadataBusy
+            }
+            error => Self::Refused(error),
+        }
+    }
+}
+impl From<StreamControlError> for PreparedCommitError {
+    fn from(error: StreamControlError) -> Self {
+        Self::Refused(error)
+    }
+}
+impl From<MediaTransitionError> for PreparedCommitError {
+    fn from(error: MediaTransitionError) -> Self {
+        Self::Refused(error.into())
+    }
+}
