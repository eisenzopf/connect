+//! Real source-state exclusion after the original adapter has made its new
+//! Data port ready. No synthetic clock, ready receipt, graph commit or rerun.
+use super::*;
+use std::{future::Future, pin::Pin, task::Poll};
+
+async fn poll_once<F: Future>(mut future: Pin<&mut F>) -> Poll<F::Output> {
+    std::future::poll_fn(|cx| Poll::Ready(future.as_mut().poll(cx))).await
+}
+
+async fn data_candidate() -> (Scene, Arc<HeldPolicy>, Arc<Held>) {
+    let (scene, policy) =
+        held_scene_with_source(&[Medium::Audio, Medium::Data], &[Medium::Audio]).await;
+    apply(
+        &scene,
+        MediaSubscriptionChange {
+            selection: None,
+            audio: Some(AudioSubscriptionChange::Subscribe(vec![
+                AudioSubscription::Stream(MediaStreamRef {
+                    connection: scene.f.a.connection.clone(),
+                    logical: desired(Medium::Audio).logical_id,
+                }),
+            ])),
+            direct: None,
+        },
+    )
+    .await
+    .unwrap();
+    let mut selected = scene
+        .f
+        .b
+        .active_bindings()
+        .into_iter()
+        .map(|binding| binding.negotiated)
+        .collect::<Vec<_>>();
+    let mut data = scene.f.aa.port(Medium::Data).binding().negotiated.clone();
+    data.requested.direction = StreamDirection::Send;
+    selected.push(data);
+    let held = Arc::new(Held {
+        domain: scene.f.policy.clone(),
+        guard: Arc::new(scene.f.policy.0.clone().read_owned().await),
+        target: scene.f.b.connection.clone(),
+        expected: scene.f.b.revision(),
+        change: MediaSubscriptionChange {
+            selection: None,
+            audio: None,
+            direct: Some(DirectSubscriptionChange::Subscribe(vec![
+                DirectSubscription::new(
+                    &scene.f.a,
+                    desired(Medium::Data).logical_id.clone(),
+                    desired(Medium::Data).logical_id,
+                ),
+            ])),
+        },
+        selected: Some(selected),
+    });
+    (scene, policy, held)
+}
+
+async fn original_audio(scene: &Scene, output: &mut mpsc::Receiver<QueuedMedia>, sequence: u32) {
+    scene.publish(Medium::Audio, sequence);
+    scene.scene.tick();
+    assert_audio(outgoing(output).await).await;
+}
+
+async fn joined(scene: &Scene) {
+    assert_eq!(
+        scene.f.b.shutdown(deadline()).await,
+        0,
+        "original target cleanup must join"
+    );
+    assert_eq!(
+        scene.f.a.shutdown(deadline()).await,
+        0,
+        "original source cleanup must join"
+    );
+    assert_eq!(scene.f.ba.outstanding.load(Ordering::Acquire), 0);
+    assert_eq!(scene.f.aa.outstanding.load(Ordering::Acquire), 0);
+}
+
+async fn after_ready(mode: &str) {
+    let (scene, policy, held) = data_candidate().await;
+    let original = scene.f.b.active_bindings()[0].clone();
+    let mut audio_output = scene.f.ba.port(Medium::Audio).take_egress().unwrap();
+    original_audio(&scene, &mut audio_output, 811).await;
+    let budget = scene.f.b.stream_open_budget();
+    let calls = scene.f.ba.prepare_calls.load(Ordering::Acquire);
+    let cancel = CancellationToken::new();
+    let until = if mode == "deadline" {
+        tokio::time::Instant::now() + Duration::from_millis(40)
+    } else {
+        deadline()
+    };
+    scene.f.ba.mode.store(1, Ordering::Release);
+    let replace = BTreeSet::new();
+    let mut update = Box::pin(scene.f.b.change_selected_and_subscriptions(
+        held.expected,
+        held.selected.as_ref().unwrap(),
+        &replace,
+        scene.scene.clone(),
+        &held.change,
+        until,
+        cancel.clone(),
+        Arc::new(held.clone()),
+    ));
+    assert!(
+        poll_once(update.as_mut()).await.is_pending(),
+        "the original adapter must await its one release"
+    );
+    tokio::time::timeout(Duration::from_millis(100), scene.f.ba.entered.notified())
+        .await
+        .unwrap();
+    assert_eq!(scene.f.ba.prepare_calls.load(Ordering::Acquire), calls + 1);
+    let prepared = scene.f.ba.port(Medium::Data);
+    assert_eq!(prepared.status(), PortStatus::Prepared);
+    assert!(
+        prepared.0.state.lock().unwrap().ready,
+        "the original adapter actually made this port ready"
+    );
+    let binding = prepared.binding().clone();
+    let mut output = prepared.take_egress().unwrap();
+    let source_state = scene.f.a.state.lock().unwrap();
+    scene.f.ba.release.notify_one();
+    // This poll resumes the same adapter call and reaches the failed source
+    // try_lock synchronously. BEFORE returns Ready(Err(Backpressure)) here;
+    // AFTER yields only the original bounded metadata wait.
+    let observed = poll_once(update.as_mut()).await;
+    assert!(
+        observed.is_pending(),
+        "post-ready source exclusion must retain the original candidate, got {observed:?}"
+    );
+    assert_eq!(scene.f.b.revision(), held.expected);
+    assert_eq!(scene.f.b.active_bindings().len(), 1);
+    assert_eq!(scene.f.b.stream_open_budget(), (budget.0 + 1, budget.1));
+    assert_eq!(scene.f.ba.prepare_calls.load(Ordering::Acquire), calls + 1);
+    assert!(
+        output.try_recv().is_err(),
+        "private preparation must not publish Data"
+    );
+    assert!(
+        scene.scene.members.try_lock().is_ok(),
+        "metadata wait must release scene custody"
+    );
+    assert!(
+        scene.f.b.state.try_lock().is_ok(),
+        "metadata wait must release target metadata"
+    );
+
+    let outcome = match mode {
+        "recover" => {
+            drop(source_state);
+            tokio::time::timeout_at(until, &mut update).await.unwrap()
+        }
+        "cancel" => {
+            cancel.cancel();
+            let result = tokio::time::timeout(Duration::from_millis(100), &mut update)
+                .await
+                .unwrap();
+            drop(source_state);
+            result
+        }
+        "deadline" => {
+            let result = tokio::time::timeout(Duration::from_millis(200), &mut update)
+                .await
+                .unwrap();
+            drop(source_state);
+            result
+        }
+        "revoke" => {
+            policy.collision.denied.store(true, Ordering::Release);
+            drop(source_state);
+            tokio::time::timeout_at(until, &mut update).await.unwrap()
+        }
+        "poison" => {
+            drop(source_state);
+            let source = scene.f.a.clone();
+            assert!(std::thread::spawn(move || {
+                let _guard = source.state.lock().unwrap();
+                panic!("controlled original source metadata poison after endpoint readiness");
+            })
+            .join()
+            .is_err());
+            tokio::time::timeout_at(until, &mut update).await.unwrap()
+        }
+        "drop" => {
+            drop(update);
+            drop(source_state);
+            assert_eq!(scene.f.b.revision(), held.expected);
+            assert_eq!(prepared.status(), PortStatus::Retired);
+            assert_eq!(scene.f.ba.prepare_calls.load(Ordering::Acquire), calls + 1);
+            original_audio(&scene, &mut audio_output, 813).await;
+            drop(held);
+            joined(&scene).await;
+            return;
+        }
+        _ => panic!("unknown fixture mode"),
+    };
+    drop(update);
+    assert_eq!(
+        scene.f.ba.prepare_calls.load(Ordering::Acquire),
+        calls + 1,
+        "no adapter preparation or peer confirmation replay"
+    );
+    assert_eq!(
+        scene.f.b.stream_open_budget(),
+        (budget.0 + 1, budget.1),
+        "cancellation never refunds the original attempted open"
+    );
+    // Only the new Data route participates in this transaction. Exercise the
+    // unchanged, currently authorized original audio route after the same
+    // candidate either commits or rolls back. A poisoned source is a separate
+    // permanent-refusal control and cannot promise subsequent media usability.
+    if mode != "poison" {
+        original_audio(&scene, &mut audio_output, 813).await;
+    }
+    if mode == "recover" {
+        outcome.unwrap();
+        assert_eq!(scene.f.b.revision(), held.expected + 1);
+        let current = scene.f.b.active_bindings();
+        assert_eq!(current.len(), 2);
+        assert!(current
+            .iter()
+            .any(|port| port.transport_id == binding.transport_id
+                && port.stream_local_id == binding.stream_local_id
+                && port.generation == binding.generation));
+        scene.publish(Medium::Data, 812);
+        scene.scene.tick();
+        outgoing(&mut output)
+            .await
+            .deliver(|frame| async move {
+                assert_eq!(frame.timestamp_rtp, 812);
+                assert_eq!(frame.payload.as_ref(), b"{\"sequence\":812}");
+                Ok(())
+            })
+            .await
+            .unwrap();
+        assert!(
+            output.try_recv().is_err(),
+            "the original Data frame is delivered once"
+        );
+    } else {
+        assert!(
+            match mode {
+                "cancel" => matches!(outcome, Err(StreamControlError::Cancelled)),
+                "deadline" => matches!(outcome, Err(StreamControlError::Deadline)),
+                "revoke" => matches!(outcome, Err(StreamControlError::Authority)),
+                "poison" => matches!(
+                    outcome,
+                    Err(StreamControlError::Model(MediaTransitionError::Conflict))
+                ),
+                _ => false,
+            },
+            "current original refusal must be preserved: {outcome:?}"
+        );
+        assert_eq!(scene.f.b.revision(), held.expected);
+        assert_eq!(scene.f.b.active_bindings().len(), 1);
+        assert_eq!(prepared.status(), PortStatus::Retired);
+        assert!(
+            output.try_recv().is_err(),
+            "failed preparation must not publish Data"
+        );
+    }
+    assert!(
+        scene
+            .f
+            .b
+            .active_bindings()
+            .iter()
+            .any(|port| port.transport_id == original.transport_id
+                && port.stream_local_id == original.stream_local_id
+                && port.generation == original.generation),
+        "original working audio allocation must survive the new Data transaction"
+    );
+    drop(held);
+    joined(&scene).await;
+}
