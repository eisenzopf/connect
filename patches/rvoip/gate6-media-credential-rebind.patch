+    assert_eq!(policy.reads.load(Ordering::Acquire), reads);
+    drop(held);
+    tokio::time::timeout(Duration::from_secs(1), writer)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(stale
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .is_err());
+    let sent = Arc::new(AtomicBool::new(false));
+    let seen = sent.clone();
