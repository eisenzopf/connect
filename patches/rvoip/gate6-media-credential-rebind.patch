+use super::*;
+
+struct RenewalPolicy {
+    domain: uuid::Uuid,
+    base: Arc<Policy>,
+    reads: AtomicUsize,
+    receive_delay_ms: AtomicUsize,
+    hooks: AtomicUsize,
+    mode: Arc<AtomicUsize>,
+}
+struct Proof {
+    domain: uuid::Uuid,
+    conversation: ConversationId,
+    session: SessionId,
+    connection: ConnectionId,
+    previous: AuthenticatedPrincipal,
+    next: AuthenticatedPrincipal,
+    credential_revision: u64,
+    stream_revision: u64,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    cancellation: CancellationToken,
+    deadline: tokio::time::Instant,
+}
+fn same(a: &AuthenticatedPrincipal, b: &AuthenticatedPrincipal) -> bool {
+    a.has_same_owner(b)
+        && a.scopes == b.scopes
+        && a.expires_at == b.expires_at
+        && a.method == b.method
+        && match (&a.assurance, &b.assurance) {
+            (IdentityAssurance::Anonymous, IdentityAssurance::Anonymous) => true,
+            (
+                IdentityAssurance::Identified { credential_kind: a },
+                IdentityAssurance::Identified { credential_kind: b },
+            ) => a == b,
+            (
+                IdentityAssurance::TaskScoped {
+                    identity: a,
+                    task_id: at,
+                    scopes: as_,
+                    expires_at: ae,
+                },
+                IdentityAssurance::TaskScoped {
+                    identity: b,
+                    task_id: bt,
+                    scopes: bs,
+                    expires_at: be,
+                },
+            ) => a == b && at == bt && as_ == bs && ae == be,
+            (
+                IdentityAssurance::UserAuthorized {
+                    identity: a,
+                    user_id: au,
+                    scopes: as_,
+                },
+                IdentityAssurance::UserAuthorized {
+                    identity: b,
+                    user_id: bu,
+                    scopes: bs,
+                },
+            ) => a == b && au == bu && as_ == bs,
+            (
+                IdentityAssurance::Pseudonymous { ephemeral_key: a },
+                IdentityAssurance::Pseudonymous { ephemeral_key: b },
+            ) => a.0 == b.0,
+            (
+                IdentityAssurance::DtlsFingerprint {
+                    algorithm: a,
+                    value: av,
+                },
+                IdentityAssurance::DtlsFingerprint {
+                    algorithm: b,
+                    value: bv,
+                },
+            ) => a == b && av == bv,
+            _ => false,
+        }
+}
+fn derive(mut owner: MediaOwner, principal: &AuthenticatedPrincipal) -> ControlResult<MediaOwner> {
+    let binding = IdentityBinding::from_authenticated(
+        principal,
+        owner.actor.identity().clone(),
+        chrono::Utc::now(),
+    )
+    .map_err(|_| StreamControlError::Authority)?;
+    owner.actor = owner
+        .actor
+        .with_authenticated_identity(&binding)
+        .map_err(|_| StreamControlError::Authority)?;
+    if owner.actor.identity() == owner.member.identity() {
+        owner.member = owner
+            .member
+            .with_authenticated_identity(&binding)
+            .map_err(|_| StreamControlError::Authority)?;
+    }
+    Ok(owner)
+}
+struct RenewalLease {
+    owner: MediaOwner,
+    principal: AuthenticatedPrincipal,
+    guard: Arc<OwnedRwLockReadGuard<PolicyState>>,
+    mode: Arc<AtomicUsize>,
+    cancellation: CancellationToken,
+}
+impl MediaAuthorityLease for RenewalLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+    fn control_owner(&self) -> ControlResult<Box<MediaOwner>> {
+        let mut owner = derive(
+            self.guard
+                .owners
+                .get(self.owner.connection.connection().as_str())
+                .unwrap()
+                .clone(),
+            &self.principal,
+        )?;
+        match self.mode.load(Ordering::Acquire) {
+            1 => owner.may_control = false,
+            2 => self.cancellation.cancel(),
+            3 => owner.endpoint.revoke(),
+            4 => {
+                let binding = IdentityBinding::from_authenticated(
+                    &self.principal,
+                    owner.member.identity().clone(),
+                    chrono::Utc::now(),
+                )
+                .unwrap();
+                let mut endpoint = EndpointBinding::provision(
+                    binding.clone(),
+                    owner.endpoint.endpoint().clone(),
+                    owner.endpoint.device().clone(),
+                    Transport::Sip,
+                    "changed-transport".into(),
+                )
+                .unwrap();
+                endpoint
+                    .verify(&binding, "fixture-evidence".into(), chrono::Utc::now())
+                    .unwrap();
+                owner.endpoint = endpoint;
+            }
+            _ => {}
+        }
+        Ok(Box::new(owner))
+    }
+}
+struct CurrentLease {
+    owner: MediaOwner,
+    _guard: Box<dyn MediaAuthorityLease>,
+}
+impl MediaAuthorityLease for CurrentLease {
+    fn authority(&self) -> &MediaOwner {
+        &self.owner
+    }
+}
+impl MediaPolicy for RenewalPolicy {
+    fn current(&self, scope: &MediaScope<'_>) -> ControlResult<Box<dyn MediaAuthorityLease>> {
+        self.reads.fetch_add(1, Ordering::AcqRel);
+        let guard = self.base.current(scope)?;
+        if matches!(&scope.purpose, MediaPurpose::Receive { .. }) {
+            std::thread::sleep(Duration::from_millis(
+                self.receive_delay_ms.load(Ordering::Acquire) as u64,
+            ));
+        }
+        Ok(Box::new(CurrentLease {
+            owner: derive(guard.authority().clone(), scope.principal)?,
+            _guard: guard,
+        }))
+    }
+    fn current_control(
+        &self,
+        scope: &MediaScope<'_>,
+        intent: &MediaControlIntent<'_>,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<MediaControl> {
+        let proof = held
+            .downcast_ref::<Proof>()
+            .ok_or(StreamControlError::Unsupported)?;
+        let MediaControlIntent::RebindCredential {
+            previous,
+            expected_credential_revision,
+            expected_stream_revision,
+        } = intent
+        else {
+            return Err(StreamControlError::Unsupported);
+        };
+        if proof.domain != self.domain
+            || proof.conversation != *scope.conversation
+            || proof.session != *scope.session
+            || proof.connection != *scope.connection
+            || !same(&proof.previous, previous)
+            || !same(&proof.next, scope.principal)
+            || proof.credential_revision != *expected_credential_revision
+            || proof.stream_revision != *expected_stream_revision
+            || proof.guard.revoked.contains(&scope.principal.subject)
+        {
+            return Err(StreamControlError::Authority);
+        }
+        self.hooks.fetch_add(1, Ordering::AcqRel);
+        let owner = derive(
+            proof
+                .guard
+                .owners
+                .get(scope.connection.as_str())
+                .ok_or(StreamControlError::Authority)?
+                .clone(),
+            scope.principal,
+        )?;
+        MediaControl::new(
+            Box::new(RenewalLease {
+                owner,
+                principal: scope.principal.clone(),
+                guard: proof.guard.clone(),
+                mode: self.mode.clone(),
+                cancellation: proof.cancellation.clone(),
+            }),
+            proof.cancellation.clone(),
+            proof.deadline,
+        )
+    }
+}
+fn controller(
+    _f: &Fixture,
+    original: &Arc<StreamController>,
+    adapter: Arc<Adapter>,
+    principal: AuthenticatedPrincipal,
+    policy: Arc<dyn MediaPolicy>,
+) -> Arc<StreamController> {
+    StreamController::new(
+        original.conversation.clone(),
+        original.session.clone(),
+        original.connection.clone(),
+        principal,
+        policy,
+        adapter,
+        original.handles.clone(),
+        8,
+    )
+    .unwrap()
+}
+fn setup(principal: AuthenticatedPrincipal) -> (Fixture, Arc<RenewalPolicy>) {
+    let mut f = Fixture::new(8);
+    let policy = Arc::new(RenewalPolicy {
+        domain: uuid::Uuid::new_v4(),
+        base: f.policy.clone(),
+        reads: AtomicUsize::new(0),
+        receive_delay_ms: AtomicUsize::new(0),
+        hooks: AtomicUsize::new(0),
+        mode: Arc::new(AtomicUsize::new(0)),
+    });
+    f.a = controller(&f, &f.a, f.aa.clone(), principal, policy.clone());
+    f.b = controller(
+        &f,
+        &f.b,
+        f.ba.clone(),
+        super::principal("bob"),
+        policy.clone(),
+    );
+    (f, policy)
+}
+async fn proof(f: &Fixture, policy: &RenewalPolicy, next: AuthenticatedPrincipal) -> Proof {
+    Proof {
+        domain: policy.domain,
+        conversation: f.a.conversation.clone(),
+        session: f.a.session.clone(),
+        connection: f.a.connection.clone(),
+        previous: f.a.credential_snapshot().principal.as_ref().clone(),
+        next,
+        credential_revision: f.a.credential_revision(),
+        stream_revision: f.a.revision(),
+        guard: Arc::new(f.policy.0.clone().read_owned().await),
+        cancellation: CancellationToken::new(),
+        deadline: deadline(),
+    }
+}
+async fn apply(controller: &StreamController, proof: &Proof) -> ControlResult<u64> {
+    controller
+        .rebind_credential_with_held(
+            proof.next.clone(),
+            proof.credential_revision,
+            proof.stream_revision,
+            deadline(),
+            CancellationToken::new(),
+            proof,
+        )
+        .await
+}
+async fn waiting(port: &AdapterMediaPort) {
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while port.0.ticket().is_active() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
