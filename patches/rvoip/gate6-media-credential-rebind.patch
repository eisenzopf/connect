+    /// Reuse one exact physical peer's retained controller after current
+    /// authentication. The policy must validate the exact held rebind proof.
+    pub async fn rebind_media_credential_with_held(
+        &self,
+        id: &ConnectionId,
+        peer: &Arc<PeerAdmission>,
+        principal: AuthenticatedPrincipal,
+        expected_credential_revision: u64,
+        expected_stream_revision: u64,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+        held: &(dyn std::any::Any + Send + Sync),
+    ) -> Result<u64> {
+        let route = self
+            .routes
+            .get(id)
+            .map(|r| r.value().clone())
+            .ok_or_else(|| RvoipError::ConnectionNotFound(id.clone()))?;
+        if !route
+            .peer
+            .upgrade()
+            .is_some_and(|owner| Arc::ptr_eq(&owner, peer))
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "native credential physical owner mismatch",
+            ));
+        }
+        peer.validate_binding(&principal, route.member.identity(), route.endpoint.device())
+            .map_err(|_| RvoipError::AdmissionRejected("native credential owner denied"))?;
+        self.physical_source(id)?;
+        let controller = {
+            let installed = route.rtp.lock().unwrap_or_else(|p| p.into_inner());
+            installed.as_ref().map(|rtp| rtp.controller.clone()).ok_or(
+                RvoipError::NotImplemented("native staged media not configured"),
+            )?
+        };
+        controller
+            .rebind_credential_with_held(
+                principal,
+                expected_credential_revision,
+                expected_stream_revision,
+                deadline,
+                cancellation,
+                held,
+            )
+            .await
+            .map_err(|_| RvoipError::AdmissionRejected("native credential rebind denied"))
     }
     pub fn media_controller(&self, id: &ConnectionId) -> Result<Arc<StreamController>> {
         self.physical_source(id)?;
