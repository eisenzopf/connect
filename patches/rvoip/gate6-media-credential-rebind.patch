+use super::*;
+
+async fn refresh(h: &mut Harness) {
+    h.wire
+        .send(h.f.sign(envelope(
+            "auth.refresh",
+            json!({"method":"bearer","credential":"new"}),
+        )))
+        .await;
+    let authenticated = h.wire.read().await;
+    assert_eq!(authenticated.kind(), "auth.session");
+    h.f.verify_server(&authenticated).await;
+}
+#[tokio::test]
+async fn canonical_refresh_rebinds_same_native_controller_and_decodes_rtp_after_original_expiry() {
+    for kind in ["quic", "wt"] {
+        let mut h = Harness::with_token(kind, "short").await;
+        h.wire
+            .send(h.f.sign(h.command("codec-renegotiate", 0)))
+            .await;
+        assert_eq!(h.wire.read().await.kind(), "ack");
+        let controller = h.adapter().media_controller(&h.id).unwrap();
+        let budget = controller.stream_open_budget();
+        let model = controller.revision();
+        let binding = h.readiness.offers.lock().unwrap()[0].clone();
+        let media = h.adapter().physical_source(&h.id).unwrap().media().unwrap();
+        let handles = media.router().snapshot().issued_local_ids;
+        let peer = h.native.records.lock().unwrap()[0]
+            .peer
+            .lock()
+            .unwrap()
+            .clone()
+            .unwrap();
+        let quota = peer.snapshot();
+        let mut input = controller
+            .take_ingress(&StreamId::from_string("audio"))
+            .unwrap();
+        send(&h.wire, audio(binding.stream_local_id, 0));
+        let stale = packet(&mut input).await;
+        refresh(&mut h).await;
+        h.record.rebind.store(true, Ordering::Release);
+        h.record.save.store(true, Ordering::Release);
+        h.wire
+            .send(h.f.sign(h.command("codec-renegotiate", model)))
+            .await;
+        let observed = h.wire.read().await;
+        assert_eq!(observed.kind(), "ack");
+        h.f.verify_server(&observed).await;
+        assert_eq!(
+            observed.original()["payload"]["details"]["credential_revision"],
+            2
+        );
+        assert_eq!(
+            observed.original()["payload"]["details"]["media_revision"],
+            model
+        );
+        assert!(Arc::ptr_eq(
+            &controller,
+            &h.adapter().media_controller(&h.id).unwrap()
+        ));
+        assert_eq!(controller.stream_open_budget(), budget);
+        assert_eq!(controller.revision(), model);
+        assert_eq!(
+            h.readiness.offers.lock().unwrap()[0].transport_id,
+            binding.transport_id
+        );
+        assert_eq!(media.router().snapshot().issued_local_ids, handles);
+        assert_eq!(peer.snapshot().connections, quota.connections);
+        assert_eq!(peer.snapshot().sessions, quota.sessions);
+        assert!(stale
+            .try_forward_to(&controller, &StreamId::from_string("audio"))
+            .is_err());
+        let (saved, _) = h.record.saved.lock().unwrap().take().unwrap();
+        assert!(saved.cancellation.is_cancelled());
+        assert!(h
+            .adapter()
+            .rebind_media_credential_with_held(
+                &h.id,
+                &peer,
+                saved.principal.clone(),
+                saved.credential_revision,
+                model,
+                deadline(),
+                CancellationToken::new(),
+                saved.as_ref()
+            )
+            .await
+            .is_err());
+        drop(saved);
+        tokio::time::sleep(Duration::from_millis(1100)).await;
+        send(&h.wire, audio(binding.stream_local_id, 0));
+        packet(&mut input)
+            .await
+            .try_forward_to(&controller, &StreamId::from_string("audio"))
+            .unwrap();
+        let delivered = received(&h.wire).await;
+        decoded(&delivered);
+        assert_eq!(delivered.stream_local_id, binding.stream_local_id);
+        assert!(media.snapshot().reader_running);
+        assert_eq!(h.adapter().total_allocations(), 1);
+        h.stop().await;
+    }
+}
