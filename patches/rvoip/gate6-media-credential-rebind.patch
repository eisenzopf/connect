@@ -0,0 +1,184 @@
+use super::*;
+
+impl StreamController {
+    pub(super) fn credential_snapshot(&self) -> CredentialSnapshot {
+        self.credential
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .clone()
+    }
+    pub(super) fn check_credential_snapshot(
+        &self,
+        expected: &CredentialSnapshot,
+    ) -> ControlResult<()> {
+        let current = self.credential_snapshot();
+        if current.revision != expected.revision
+            || !Arc::ptr_eq(&current.principal, &expected.principal)
+        {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        Ok(())
+    }
+    fn rebind_current(
+        &self,
+        control: &MediaControl,
+        cancellation: &CancellationToken,
+        deadline: tokio::time::Instant,
+    ) -> ControlResult<()> {
+        control.valid()?;
+        if cancellation.is_cancelled() || self.shutdown.is_cancelled() {
+            return Err(StreamControlError::Cancelled);
+        }
+        if tokio::time::Instant::now() >= deadline {
+            return Err(StreamControlError::Deadline);
+        }
+        Ok(())
+    }
+    /// Trusted engine metadata, independent of the logical stream revision.
+    pub fn credential_revision(&self) -> u64 {
+        self.credential_snapshot().revision
+    }
+    /// Replace the authenticated credential under the installed policy's exact
+    /// held proof. This cannot replace the policy, route, owner or media model.
+    /// The proof is not retained as packet authority. An old in-flight command
+    /// conflicts rather than borrowing this credential for its pending work.
+    pub async fn rebind_credential_with_held(
+        &self,
+        principal: AuthenticatedPrincipal,
+        expected_credential_revision: u64,
+        expected_stream_revision: u64,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<u64> {
+        let _flight = self
+            .inflight
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| MediaTransitionError::Conflict)?;
+        let previous = self.credential_snapshot();
+        if previous.revision != expected_credential_revision {
+            return Err(MediaTransitionError::Conflict.into());
+        }
+        if previous.revision >= 9_007_199_254_740_991 {
+            return Err(MediaTransitionError::Capacity.into());
+        }
+        if !previous.principal.has_same_owner(&principal)
+            || Self::principal_expiry(&principal).is_some_and(|expiry| expiry <= chrono::Utc::now())
+        {
+            return Err(StreamControlError::Authority);
+        }
+        let scope = self.scope(&principal, MediaPurpose::Control);
+        let control = self.policy.current_control(
+            &scope,
+            &MediaControlIntent::RebindCredential {
+                previous: &previous.principal,
+                expected_credential_revision,
+                expected_stream_revision,
+            },
+            held,
+        )?;
+        let deadline = Self::command_deadline(&principal, deadline).min(control.deadline);
+        let control_cancel = control.cancellation.clone();
+        self.rebind_current(&control, &cancellation, deadline)?;
+        let (ports, retained) = {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            let owner = control.authority()?;
+            Self::check(&scope, &owner)?;
+            if owner.endpoint.transport() != self.origin_endpoint.transport() {
+                return Err(StreamControlError::Authority);
+            }
+            state.model.authorize_preparation(&owner.current())?;
+            if state.closed {
+                return Err(StreamControlError::Cancelled);
+            }
+            if state.model.revision() != expected_stream_revision {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            self.rebind_current(&control, &cancellation, deadline)?;
+            let ports = state.active.values().cloned().collect::<Vec<_>>();
+            let retained = state
+                .all
+                .values()
+                .filter(|port| !ports.iter().any(|active| Arc::ptr_eq(active, port)))
+                .cloned()
+                .collect::<Vec<_>>();
+            (ports, retained)
+        };
+        // A terminal callback can retire a port before its admitted local send
+        // completes. Its cleanup/quota remain owned; do not cross credentials
+        // while that original send is still live either.
+        for port in retained {
+            self.rebind_current(&control, &cancellation, deadline)?;
+            let ticket = port.ticket();
+            let drained = tokio::select! {
+                biased;
+                _ = cancellation.cancelled() => return Err(StreamControlError::Cancelled),
+                _ = control_cancel.cancelled() => return Err(StreamControlError::Cancelled),
+                _ = self.shutdown.cancelled() => return Err(StreamControlError::Cancelled),
+                result = tokio::time::timeout_at(deadline,ticket.wait_retired_drained()) => result.map_err(|_|StreamControlError::Deadline)?,
+            };
+            if !drained {
+                return Err(StreamControlError::NotReady);
+            }
+            self.rebind_current(&control, &cancellation, deadline)?;
+        }
+        let mut changes = Vec::new();
+        let mut drained = Vec::new();
+        for port in &ports {
+            self.rebind_current(&control, &cancellation, deadline)?;
+            let old = port.ticket();
+            let next = old.stage().ok_or(MediaTransitionError::Capacity)?;
+            let guard = tokio::select! {
+                biased;
+                _ = cancellation.cancelled() => return Err(StreamControlError::Cancelled),
+                _ = control_cancel.cancelled() => return Err(StreamControlError::Cancelled),
+                _ = self.shutdown.cancelled() => return Err(StreamControlError::Cancelled),
+                result = tokio::time::timeout_at(deadline, old.quiesce()) => result.map_err(|_|StreamControlError::Deadline)?.ok_or(StreamControlError::NotReady)?,
+            };
+            changes.push((port.clone(), old, next));
+            drained.push(guard);
+        }
+        {
+            let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+            self.check_credential_snapshot(&previous)?;
+            let owner = control.authority()?;
+            Self::check(&scope, &owner)?;
+            if owner.endpoint.transport() != self.origin_endpoint.transport() {
+                return Err(StreamControlError::Authority);
+            }
+            state.model.authorize_preparation(&owner.current())?;
+            if state.closed {
+                return Err(StreamControlError::Cancelled);
+            }
+            if state.model.revision() != expected_stream_revision {
+                return Err(MediaTransitionError::Conflict.into());
+            }
+            if changes.iter().any(|(port, old, _)| {
+                !old.is_current()
+                    || !state
+                        .active
+                        .get(&port.binding.negotiated.requested.logical_id)
+                        .is_some_and(|active| Arc::ptr_eq(active, port))
+            }) {
+                return Err(StreamControlError::NotReady);
+            }
+            self.rebind_current(&control, &cancellation, deadline)?;
+            // All fallible checks precede this commit under the same model and
+            // policy fences. Terminal callbacks also serialize on model state.
+            for (port, old, next) in changes {
+                assert!(
+                    next.commit_from(&old),
+                    "private credential delivery generation changed outside controller"
+                );
+                *port.ticket.lock().unwrap_or_else(|p| p.into_inner()) = next;
+            }
+            *self.credential.lock().unwrap_or_else(|p| p.into_inner()) = CredentialSnapshot {
+                principal: Arc::new(principal.clone()),
+                revision: previous.revision + 1,
+            };
+        }
+        drop(drained);
+        Ok(previous.revision + 1)
+    }
+}
