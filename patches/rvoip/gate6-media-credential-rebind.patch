+#[tokio::test]
+async fn credential_rebind_drains_retired_port_send_without_reactivating_or_refunding_it() {
+    let (f, policy) = setup(principal("alice"));
+    f.start(&[Medium::Audio]).await;
+    let source = f.aa.port(Medium::Audio);
+    let mut input =
+        f.a.take_ingress(&desired(Medium::Audio).logical_id)
+            .unwrap();
+    let mut output = f.ba.port(Medium::Audio).take_egress().unwrap();
+    source.try_publish(&frame(&source, 160)).unwrap();
+    receive(&mut input)
+        .await
+        .try_forward_to(&f.b, &desired(Medium::Audio).logical_id)
+        .unwrap();
+    let queued = outgoing(&mut output).await;
+    let entered = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let signal = entered.clone();
+    let ready = release.clone();
+    let sending = tokio::spawn(async move {
+        queued
+            .deliver(move |_| async move {
+                signal.notify_one();
+                ready.notified().await;
+                Ok(())
+            })
+            .await
+    });
+    entered.notified().await;
+    assert!(source.report_terminal().unwrap());
+    let budget = f.a.stream_open_budget();
+    assert_eq!(f.a.revision(), 2);
+    let held = proof(&f, &policy, principal("alice")).await;
+    let hooks = policy.hooks.load(Ordering::Acquire);
+    let a = f.a.clone();
+    let work = tokio::spawn(async move { apply(&a, &held).await });
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while policy.hooks.load(Ordering::Acquire) == hooks {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+    assert!(
+        !work.is_finished(),
+        "retired route still owns an admitted send"
+    );
+    assert_eq!(f.a.credential_revision(), 1);
+    let other = f.ba.port(Medium::Audio);
+    other.try_publish(&frame(&other, 320)).unwrap();
+    release.notify_one();
+    sending.await.unwrap().unwrap();
+    assert_eq!(work.await.unwrap().unwrap(), 2);
+    assert_eq!(f.a.revision(), 2);
+    assert_eq!(f.a.stream_open_budget(), budget);
+    assert_eq!(source.status(), PortStatus::Retired);
+    assert!(source.try_publish(&frame(&source, 320)).is_err());
+}
