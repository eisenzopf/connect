+    /// Trusted current resolver view after authentication renewal. This changes
+    /// only the credential bound in the view, never membership/epoch/role/grants.
+    pub fn with_authenticated_identity(
+        &self,
+        binding: &IdentityBinding,
+    ) -> Result<Self, RelationshipError> {
+        self.require_active()?;
+        if !self.binding.same_identity(binding) {
+            return Err(RelationshipError::OwnerMismatch);
+        }
+        let mut value = self.clone();
+        value.binding = binding.clone();
+        Ok(value)
+    }
     pub fn identity(&self) -> &IdentityId {
         self.binding.identity()
     }
