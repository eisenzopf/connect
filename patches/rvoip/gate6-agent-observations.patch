+    let mut tick = tokio::time::interval(Duration::from_millis(20));
+    let mut known_gap = None;
+    let gap=tokio::time::timeout(Duration::from_secs(2),async {loop {tokio::select! {
+        _=tick.tick()=>{let _=state.injected.send(Injected::Text(json!({"type":"transcript","transcript":"recovery","transcriptType":"final","callId":"call-mock-1"}).to_string()));}
