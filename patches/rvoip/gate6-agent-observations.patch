+fn normalized_provider_text(
+    text: &str,
+    route: &Route,
+    _global: &broadcast::Sender<VapiEventEnvelope>,
+    target: &mpsc::Sender<AdapterEvent>,
+    emitter: &mut crate::agent_observations::Emitter,
+) -> Option<VapiEvent> {
+    use rvoip_core::agent::{AgentObservationContent, AgentObservationIssue};
+    let call_id = route.call_id.lock().clone()?;
+    let value = if text.len() <= crate::agent_observations::MAX_PROVIDER_EVENT_BYTES {
+        serde_json::from_str::<serde_json::Value>(text).ok()
+    } else {
+        None
+    };
+    let Some(value) = value else {
+        emitter.emit(
+            target,
+            &route.connection_id,
+            &call_id,
+            None,
+            AgentObservationContent::Unavailable {
+                issue: AgentObservationIssue::MalformedEvent,
+            },
+        );
+        return Some(VapiEvent::Malformed {
+            byte_len: text.len(),
+        });
+    };
+    if !crate::agent_observations::belongs_to_call(&value, &call_id) {
+        emitter.emit(
+            target,
+            &route.connection_id,
+            &call_id,
+            None,
+            AgentObservationContent::Unavailable {
+                issue: AgentObservationIssue::MismatchedSession,
+            },
+        );
+        return None;
+    }
+    let event_id = crate::agent_observations::provider_event_id(&value);
+    for content in crate::agent_observations::normalize(&value) {
+        emitter.emit(
+            target,
+            &route.connection_id,
+            &call_id,
+            event_id.clone(),
+            content,
+        );
+    }
+    Some(VapiEvent::parse(text))
 }
 
