+                AdapterEvent::AgentObservation {
+                    connection_id,
+                    observation,
+                } => {
+                    assert_eq!(connection_id, expected);
+                    assert!(!observation.capture_is_complete());
+                    assert!(observation.local_sequence() > previous);
+                    previous = observation.local_sequence();
+                }
