+//! Current Core attribution for agent observations. Model output has no grant.
+use crate::{
+    connection::Transport,
+    ids::{ConnectionId, ConversationId, ParticipantId, SessionId},
+};
+pub use rvoip_core_traits::agent::*;
+use serde::Serialize;
+use std::fmt;
+
+/// Source attribution is derived by Core; provider speaker labels remain inside
+/// the observation and do not identify a Participant in mixed caller audio.
+#[derive(Clone, Eq, PartialEq, Serialize)]
+pub struct AttributedAgentObservation {
+    conversation_id: ConversationId,
+    session_id: SessionId,
+    participant_id: ParticipantId,
+    connection_id: ConnectionId,
+    connection_generation: u64,
+    source: Transport,
+    observation: AgentObservation,
+}
+impl AttributedAgentObservation {
+    pub(crate) fn captured(
+        conversation_id: ConversationId,
+        session_id: SessionId,
+        participant_id: ParticipantId,
+        connection_id: ConnectionId,
+        connection_generation: u64,
+        source: Transport,
+        observation: AgentObservation,
+    ) -> Self {
+        Self {
+            conversation_id,
+            session_id,
+            participant_id,
+            connection_id,
+            connection_generation,
+            source,
+            observation,
+        }
+    }
+    pub fn conversation_id(&self) -> &ConversationId {
+        &self.conversation_id
+    }
+    pub fn session_id(&self) -> &SessionId {
+        &self.session_id
+    }
+    pub fn participant_id(&self) -> &ParticipantId {
+        &self.participant_id
+    }
+    pub fn connection_id(&self) -> &ConnectionId {
+        &self.connection_id
+    }
+    pub fn connection_generation(&self) -> u64 {
+        self.connection_generation
+    }
+    pub fn source(&self) -> Transport {
+        self.source
+    }
+    pub fn observation(&self) -> &AgentObservation {
+        &self.observation
+    }
+}
+impl fmt::Debug for AttributedAgentObservation {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AttributedAgentObservation")
+            .field("source", &self.source)
+            .field("observation", &self.observation)
+            .finish()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn global_projection_and_diagnostics_exclude_private_agent_content() {
+        let secret = "private-agent-canary";
+        let observation = AgentObservation::new(
+            1,
+            Some(secret.into()),
+            Some(secret.into()),
+            AgentObservationContent::Action {
+                name: Some(secret.into()),
+                call_id: Some(secret.into()),
+                phase: AgentActionPhase::Requested,
+                arguments: Some(serde_json::json!({"secret":secret})),
+                result: None,
+                completeness: ObservationCompleteness::Final,
+            },
+        )
+        .unwrap();
+        let observation = AttributedAgentObservation::captured(
+            ConversationId::from_string(secret),
+            SessionId::from_string(secret),
+            ParticipantId::from_string(secret),
+            ConnectionId::new(),
+            1,
+            Transport::Vapi,
+            observation,
+        );
+        assert!(!format!("{observation:?}").contains(secret));
+        let event = crate::events::Event::AgentObservation {
+            observation,
+            at: chrono::Utc::now(),
+        };
+        assert!(!format!("{event:?}").contains(secret));
+        let projection = event.to_cross_crate();
+        assert!(!format!("{projection:?}").contains(secret));
+        assert!(!serde_json::to_string(&projection).unwrap().contains(secret));
+        use rvoip_infra_common::events::cross_crate::{
+            RvoipCoreCrossCrateEvent, RvoipCrossCrateEvent,
+        };
+        match projection {
+            RvoipCrossCrateEvent::Core(RvoipCoreCrossCrateEvent::AgentObservation {
+                kind,
+                local_sequence,
+                ..
+            }) => {
+                assert_eq!(kind, "action");
+                assert_eq!(local_sequence, 1);
+            }
+            _ => panic!("agent observation lost its metadata projection"),
+        }
+    }
+}
