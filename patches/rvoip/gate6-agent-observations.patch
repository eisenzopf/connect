+    /// Prepare data for the initial model messages of a fresh call. The model
+    /// configuration must be explicit: a saved assistant with unknown model
+    /// settings cannot safely be replaced with guessed defaults.
+    pub(crate) fn can_prepare_agent_context(&self) -> bool {
+        let definition = match &self.assistant {
+            VapiAssistant::Transient { definition } => definition,
+            VapiAssistant::Saved {
+                overrides: Some(overrides),
+                ..
+            } => overrides,
+            _ => return false,
+        };
+        definition
+            .get("model")
+            .and_then(Value::as_object)
+            .is_some_and(|m| {
+                ["provider", "model"].iter().all(|key| {
+                    m.get(*key)
+                        .and_then(Value::as_str)
+                        .is_some_and(|v| !v.trim().is_empty())
+                })
+            })
+    }
+
+    pub(crate) fn prepare_agent_context(
+        &mut self,
+        context: &rvoip_core::agent::AgentContextInitialization,
+    ) -> Result<()> {
+        if self.initial_context.is_some() {
+            return Err(VapiError::InvalidCallOptions(
+                "agent context was already prepared",
+            ));
+        }
+        if !self.can_prepare_agent_context() {
+            return Err(VapiError::InvalidCallOptions(
+                "initial model configuration is unavailable",
+            ));
+        }
