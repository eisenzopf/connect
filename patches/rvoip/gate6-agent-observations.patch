diff --git a/crates/extensions/rvoip-vapi/src/agent_observations.rs b/crates/extensions/rvoip-vapi/src/agent_observations.rs
new file mode 100644
--- /dev/null
+++ b/crates/extensions/rvoip-vapi/src/agent_observations.rs
@@ -0,0 +1,393 @@
+//! Bounded normalization. Provider/model content is data, never effect authority.
+use rvoip_core::agent::*;
+use rvoip_core::{adapter::AdapterEvent, ConnectionId};
+use serde_json::Value;
+use tokio::sync::mpsc;
+
+pub(crate) const MAX_PROVIDER_EVENT_BYTES: usize = 1_048_576;
+const MAX_ACTIONS_PER_EVENT: usize = 32;
+
+fn string(value: &Value, key: &str) -> Option<String> {
+    value.get(key).and_then(Value::as_str).map(str::to_owned)
+}
+fn speaker(value: &Value) -> Option<AgentSpeakerRole> {
+    value
+        .get("role")
+        .and_then(Value::as_str)
+        .map(|role| match role {
+            "user" => AgentSpeakerRole::User,
+            "assistant" | "agent" => AgentSpeakerRole::Assistant,
+            "system" => AgentSpeakerRole::System,
+            _ => AgentSpeakerRole::Other,
+        })
+}
+fn unavailable(issue: AgentObservationIssue) -> Vec<AgentObservationContent> {
+    vec![AgentObservationContent::Unavailable { issue }]
+}
+pub(crate) fn belongs_to_call(value: &Value, expected: &str) -> bool {
+    for claimed in [
+        value.get("callId"),
+        value.get("call").and_then(|v| v.get("id")),
+    ]
+    .into_iter()
+    .flatten()
+    {
+        if claimed.as_str() != Some(expected) {
+            return false;
+        }
+    }
+    true
+}
+pub(crate) fn provider_event_id(value: &Value) -> Option<String> {
+    string(value, "eventId")
+}
+
+pub(crate) fn normalize(value: &Value) -> Vec<AgentObservationContent> {
+    let Some(kind) = value.get("type").and_then(Value::as_str) else {
+        return unavailable(AgentObservationIssue::MalformedEvent);
+    };
+    match kind {
+        "transcript" => {
+            let text = string(value, "transcript");
+            let completeness = match value.get("transcriptType").and_then(Value::as_str) {
+                Some("final") if text.is_some() => ObservationCompleteness::Final,
+                Some("partial") if text.is_some() => ObservationCompleteness::Partial,
+                _ => ObservationCompleteness::Unavailable,
+            };
+            vec![AgentObservationContent::Transcript {
+                text,
+                speaker_role: speaker(value),
+                completeness,
+            }]
+        }
+        "speech-update" => {
+            let state = string(value, "status");
+            let turn = value
+                .get("turn")
+                .and_then(Value::as_u64)
+                .filter(|v| *v <= MAX_AGENT_SEQUENCE);
+            let completeness = if state.is_some() {
+                ObservationCompleteness::Final
+            } else {
+                ObservationCompleteness::Unavailable
+            };
+            vec![AgentObservationContent::Speech {
+                state,
+                speaker_role: speaker(value),
+                turn,
+                completeness,
+            }]
+        }
+        "status-update" => string(value, "status")
+            .map(|state| vec![AgentObservationContent::ProviderStatus { state }])
+            .unwrap_or_else(|| unavailable(AgentObservationIssue::MissingFields)),
+        "end-of-call-report" => vec![AgentObservationContent::ProviderStatus {
+            state: "end-report-observed".into(),
+        }],
+        "tool-call"
+        | "tool-calls"
+        | "function-call"
+        | "tool-calls-result"
+        | "function-call-result" => {
+            let phase = if kind.ends_with("result") {
+                AgentActionPhase::ResultObserved
+            } else {
+                AgentActionPhase::Requested
+            };
+            let list = value
+                .get("toolCallList")
+                .or_else(|| value.get("toolCalls"))
+                .or_else(|| value.get("toolCallResults"))
+                .or_else(|| value.get("results"))
+                .and_then(Value::as_array);
+            if list.is_some_and(|v| v.len() > MAX_ACTIONS_PER_EVENT || v.is_empty()) {
+                return unavailable(AgentObservationIssue::MalformedEvent);
+            }
+            let calls: Vec<&Value> = if let Some(list) = list {
+                list.iter().collect()
+            } else if let Some(wrapped) = value.get("toolWithToolCallList") {
+                let Some(wrapped) = wrapped
+                    .as_array()
+                    .filter(|v| !v.is_empty() && v.len() <= MAX_ACTIONS_PER_EVENT)
+                else {
+                    return unavailable(AgentObservationIssue::MalformedEvent);
+                };
+                if wrapped
+                    .iter()
+                    .any(|v| !v.get("toolCall").is_some_and(Value::is_object))
+                {
+                    return unavailable(AgentObservationIssue::MalformedEvent);
+                }
+                wrapped.iter().map(|v| &v["toolCall"]).collect()
+            } else {
+                vec![value
+                    .get("toolCall")
+                    .or_else(|| value.get("functionCall"))
+                    .or_else(|| value.get("functionCallResult"))
+                    .unwrap_or(value)]
+            };
+            calls
+                .into_iter()
+                .map(|call| {
+                    let function = call.get("function").unwrap_or(call);
+                    let name = string(function, "name");
+                    let call_id = string(call, "id").or_else(|| string(call, "toolCallId"));
+                    let arguments = function
+                        .get("arguments")
+                        .or_else(|| function.get("parameters"))
+                        .cloned();
+                    let result = call.get("result").cloned();
+                    let completeness = if (phase == AgentActionPhase::Requested && name.is_some())
+                        || (phase == AgentActionPhase::ResultObserved && result.is_some())
+                    {
+                        ObservationCompleteness::Final
+                    } else {
+                        ObservationCompleteness::Unavailable
+                    };
+                    AgentObservationContent::Action {
+                        name,
+                        call_id,
+                        phase,
+                        arguments,
+                        result,
+                        completeness,
+                    }
+                })
+                .collect()
+        }
+        _ => unavailable(AgentObservationIssue::UnsupportedEvent),
+    }
+}
+
+/// Nonblocking source capture. Known missing intervals are emitted before the
+/// next accepted observation. All observations explicitly declare best-effort
+/// capture; a lost terminal tail is never represented as complete history.
+pub(crate) struct Emitter {
+    next: u64,
+    missing: Option<(u64, u64)>,
+}
+impl Emitter {
+    pub(crate) fn new() -> Self {
+        Self {
+            next: 1,
+            missing: None,
+        }
+    }
+    pub(crate) fn emit(
+        &mut self,
+        tx: &mpsc::Sender<AdapterEvent>,
+        connection: &ConnectionId,
+        session: &str,
+        event_id: Option<String>,
+        content: AgentObservationContent,
+    ) {
+        if self.next > MAX_AGENT_SEQUENCE {
+            return;
+        }
+        let session = (!session.trim().is_empty()
+            && session.len() <= MAX_AGENT_REFERENCE_BYTES
+            && !session.chars().any(char::is_control))
+        .then(|| session.to_owned());
+        let sequence = self.next;
+        self.next += 1;
+        let observation = AgentObservation::new(sequence, session.clone(), event_id, content)
+            .unwrap_or_else(|_| {
+                AgentObservation::new(
+                    sequence,
+                    session.clone(),
+                    None,
+                    AgentObservationContent::Unavailable {
+                        issue: AgentObservationIssue::MalformedEvent,
+                    },
+                )
+                .expect("bounded unavailable")
+            });
+        let observation = if let Some((first, last)) = self.missing {
+            observation
+                .with_missing_before(first, last)
+                .unwrap_or_else(|_| {
+                    AgentObservation::new(
+                        sequence,
+                        session.clone(),
+                        None,
+                        AgentObservationContent::Unavailable {
+                            issue: AgentObservationIssue::MalformedEvent,
+                        },
+                    )
+                    .expect("bounded unavailable")
+                    .with_missing_before(first, last)
+                    .expect("bounded gap metadata")
+                })
+        } else {
+            observation
+        };
+        if tx
+            .try_send(AdapterEvent::AgentObservation {
+                connection_id: connection.clone(),
+                observation,
+            })
+            .is_err()
+        {
+            self.missing = Some((self.missing.map_or(sequence, |v| v.0), sequence));
+            metrics::counter!("rvoip_vapi_agent_observations_dropped_total").increment(1);
+        } else {
+            self.missing = None;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn provider_call_assertions_cannot_borrow_a_current_call_or_terminate_it() {
+        assert!(belongs_to_call(&json!({"type":"transcript"}), "actual"));
+        assert!(belongs_to_call(
+            &json!({"callId":"actual","call":{"id":"actual"}}),
+            "actual"
+        ));
+        assert!(!belongs_to_call(
+            &json!({"type":"status-update","status":"ended","callId":"foreign"}),
+            "actual"
+        ));
+        assert!(!belongs_to_call(
+            &json!({"callId":"actual","call":{"id":"foreign"}}),
+            "actual"
+        ));
+        assert!(!belongs_to_call(&json!({"callId":1}), "actual"));
+    }
+    #[test]
+    fn transcript_speech_and_action_results_keep_their_actual_completeness() {
+        assert!(matches!(
+            &normalize(
+                &json!({"type":"transcript","transcript":"hello","transcriptType":"partial","role":"user"})
+            )[0],
+            AgentObservationContent::Transcript {
+                completeness: ObservationCompleteness::Partial,
+                speaker_role: Some(AgentSpeakerRole::User),
+                ..
+            }
+        ));
+        assert!(matches!(
+            &normalize(&json!({"type":"transcript"}))[0],
+            AgentObservationContent::Transcript {
+                text: None,
+                completeness: ObservationCompleteness::Unavailable,
+                ..
+            }
+        ));
+        assert!(matches!(
+            &normalize(
+                &json!({"type":"tool-call","toolCall":{"id":"tool","function":{"name":"transfer","arguments":{"to":"private"}}}})
+            )[0],
+            AgentObservationContent::Action {
+                phase: AgentActionPhase::Requested,
+                ..
+            }
+        ));
+        assert!(matches!(
+            &normalize(
+                &json!({"type":"tool-calls-result","results":[{"toolCallId":"tool","result":"reported"}]})
+            )[0],
+            AgentObservationContent::Action {
+                phase: AgentActionPhase::ResultObserved,
+                ..
+            }
+        ));
+        assert!(matches!(
+            &normalize(&json!({"type":"speech-update","role":"unknown","status":"started"}))[0],
+            AgentObservationContent::Speech {
+                speaker_role: Some(AgentSpeakerRole::Other),
+                turn: None,
+                ..
+            }
+        ));
+    }
+    #[test]
+    fn documented_tool_call_lists_and_wrapped_calls_are_normalized_once() {
+        let call =
+            json!({"id":"actual-tool","function":{"name":"transfer","arguments":{"to":"private"}}});
+        for value in [
+            json!({"type":"tool-calls","toolCallList":[call.clone()],"toolCalls":[call.clone()]}),
+            json!({"type":"tool-calls","toolWithToolCallList":[{"toolCall":call.clone()}]}),
+        ] {
+            let observations = normalize(&value);
+            assert_eq!(observations.len(), 1);
+            assert!(
+                matches!(&observations[0],AgentObservationContent::Action {name:Some(name),call_id:Some(id),phase:AgentActionPhase::Requested,..} if name=="transfer" && id=="actual-tool")
+            );
+        }
+    }
+    #[tokio::test]
+    async fn one_slot_backpressure_recovers_with_known_gap_instead_of_starving_content() {
+        let (tx, mut rx) = mpsc::channel(1);
+        let connection = ConnectionId::new();
+        let mut emitter = Emitter::new();
+        let text = || AgentObservationContent::Transcript {
+            text: Some("hello".into()),
+            speaker_role: None,
+            completeness: ObservationCompleteness::Final,
+        };
+        for _ in 0..3 {
+            emitter.emit(
+                &tx,
+                &connection,
+                "actual-call",
+                Some("repeated".into()),
+                text(),
+            );
+        }
+        let AdapterEvent::AgentObservation {
+            observation: first, ..
+        } = rx.recv().await.unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(first.local_sequence(), 1);
+        emitter.emit(
+            &tx,
+            &connection,
+            "actual-call",
+            Some("repeated".into()),
+            text(),
+        );
+        let AdapterEvent::AgentObservation {
+            observation: next, ..
+        } = rx.recv().await.unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(next.local_sequence(), 4);
+        assert_eq!(next.missing_before().unwrap().first_sequence, 2);
+        assert_eq!(next.missing_before().unwrap().last_sequence, 3);
+        assert!(matches!(
+            next.content(),
+            AgentObservationContent::Transcript { text: Some(_), .. }
+        ));
+        assert!(!next.capture_is_complete());
+        emitter.emit(&tx, &connection, "actual-call", None, text());
+        let AdapterEvent::AgentObservation {
+            observation: last, ..
+        } = rx.recv().await.unwrap()
+        else {
+            panic!()
+        };
+        assert_eq!(last.local_sequence(), 5);
+        assert!(last.missing_before().is_none());
+    }
+    #[test]
+    fn an_oversized_tool_batch_is_not_truncated_into_a_valid_prefix() {
+        let calls = (0..33)
+            .map(
+                |i| json!({"id":format!("tool-{i}"),"function":{"name":"transfer","arguments":{}}}),
+            )
+            .collect::<Vec<_>>();
+        assert!(matches!(
+            normalize(&json!({"type":"tool-calls","toolCalls":calls})).as_slice(),
+            [AgentObservationContent::Unavailable {
+                issue: AgentObservationIssue::MalformedEvent
+            }]
+        ));
+    }
+}
