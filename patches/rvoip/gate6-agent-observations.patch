+        }}
+    }}}).await.unwrap();
+    assert!(gap.observations > 0);
+    assert!(gap.first_sequence <= gap.last_sequence);
+    let drain = tokio::spawn(async move { while operational.recv().await.is_some() {} });
+    call.end().await.unwrap();
+    drain.abort();
+    server.abort();
+}
