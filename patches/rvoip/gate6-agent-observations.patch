+    /// Prepare immutable initialization metadata for a fresh AI leg. This does
+    /// not retrieve history, allocate a route, authorize provider IO or mutate
+    /// an existing call. The host selects authorized history and owns the later
+    /// effect under its original logical operation.
+    pub fn prepare_agent_context(
+        &self,
+        mut request: OriginateRequest,
+        context: &crate::agent::AgentContextInitialization,
+    ) -> Result<OriginateRequest> {
+        if request.direction != Direction::Outbound
+            || &request.session_id != context.session_id()
+            || &request.participant_id != context.participant_id()
+        {
+            return Err(RvoipError::AdmissionRejected(
+                "agent context scope mismatch",
+            ));
+        }
+        let session = self
+            .session(&request.session_id)
+            .ok_or(RvoipError::AdmissionRejected(
+                "agent context session missing",
+            ))?;
+        {
+            let session = session
+                .read()
+                .map_err(|_| RvoipError::InvalidState("agent context session unavailable"))?;
+            if &session.conversation_id != context.conversation_id()
+                || !session.participants.contains(&request.participant_id)
+                || matches!(
+                    session.state,
+                    SessionState::Ending | SessionState::Ended | SessionState::Failed
+                )
+            {
+                return Err(RvoipError::AdmissionRejected(
+                    "agent context relationship mismatch",
+                ));
+            }
+        }
+        let conversation =
+            self.conversation(context.conversation_id())
+                .ok_or(RvoipError::AdmissionRejected(
+                    "agent context conversation missing",
+                ))?;
+        {
+            let conversation = conversation
+                .read()
+                .map_err(|_| RvoipError::InvalidState("agent context conversation unavailable"))?;
+            if conversation.state != crate::conversation::ConversationState::Open
+                || !conversation.participants.iter().any(|p| {
+                    p.id == request.participant_id
+                        && p.kind == ParticipantKind::Ai
+                        && p.left_at.is_none()
+                })
+            {
+                return Err(RvoipError::AdmissionRejected(
+                    "agent context requires a current AI participant",
+                ));
+            }
+        }
+        let adapter = self.adapter(self.outbound_transport_for(&request)?)?;
+        request.context = adapter.prepare_agent_context(&request, context)?;
+        Ok(request)
+    }
