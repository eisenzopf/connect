+// Agent metadata can precede a lifecycle outcome in the same bounded FIFO.
+// Validate only that new variant; never skip an unexpected lifecycle event.
+async fn next_lifecycle_event(
+    events: &mut mpsc::Receiver<AdapterEvent>,
+    expected: &ConnectionId,
+) -> AdapterEvent {
+    tokio::time::timeout(Duration::from_secs(1), async {
+        let mut previous = 0;
+        loop {
+            let event = events
+                .recv()
+                .await
+                .expect("adapter lifecycle stream closed");
