+
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_info_metadata_wait_preserves_original_deadline_cancel_and_fresh_wire_permission() {
+    for mode in ["submit", "deadline", "cancel"] {
+        let mut r = Rig::new().await;
+        let p = Policy::new(&r);
+        // Delay only metadata admission. No policy reader or transport future
+        // may survive while the current domain writer owns this interval.
+        let writer = p.permission.clone().write_owned().await;
+        let cancel = CancellationToken::new();
+        let start = Instant::now();
+        let deadline = start
+            + if mode == "deadline" {
+                Duration::from_millis(150)
+            } else {
+                Duration::from_secs(2)
+            };
+        let send = r.sending(r.route("5", 160), p.clone(), cancel.clone(), deadline);
+        timeout(Duration::from_secs(1), async {
+            while p.calls.load(Ordering::Acquire) == 0 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        if mode == "cancel" {
+            cancel.cancel();
+        }
+        r.target_peer.no_info(Duration::from_millis(300)).await;
+        assert!(p.facts.lock().unwrap().is_empty());
+        if mode == "submit" {
+            assert!(
+                !send.is_finished(),
+                "metadata wait consumed physical write budget"
+            );
+        }
+        drop(writer);
+        if mode == "submit" {
+            let packet = r.target_peer.next().await;
+            assert_eq!(packet.request.body(), b"Signal=5\r\nDuration=160\r\n");
+            assert_eq!(send.await.unwrap(), Ok(()));
+            assert!(start.elapsed() >= Duration::from_millis(300));
+            let facts = p.facts.lock().unwrap().clone();
+            assert_eq!(facts, vec![(0, packet.bytes, r.target_peer.address())]);
+        } else {
+            assert_eq!(
+                send.await.unwrap(),
+                Err(if mode == "deadline" {
+                    DtmfWriteError::DeadlineBeforeWrite
+                } else {
+                    DtmfWriteError::Refused
+                })
+            );
+            r.target_peer.no_info(Duration::from_millis(100)).await;
+            assert!(p.facts.lock().unwrap().is_empty());
+        }
+        assert_eq!(
+            p.calls.load(Ordering::Acquire),
+            1,
+            "metadata wait must not invoke another adapter or transaction"
+        );
+        assert!(p.permission.try_write().is_ok());
+        r.stop().await;
+    }
+}
