+/// A metadata change clock paired with the existing wake hint. Neither the
+/// generation nor a notification grants authority or proves media readiness.
+pub struct SelectionChangeSignal {
+    generation: std::sync::atomic::AtomicU64,
+    changed: Arc<tokio::sync::Notify>,
+}
+impl Default for SelectionChangeSignal {
+    fn default() -> Self {
+        Self {
+            generation: std::sync::atomic::AtomicU64::new(1),
+            changed: Arc::new(tokio::sync::Notify::new()),
+        }
+    }
+}
+impl SelectionChangeSignal {
+    /// Current metadata generation. Saturation stays permanently dirty.
+    pub fn generation(&self) -> u64 {
+        self.generation.load(std::sync::atomic::Ordering::Acquire)
+    }
+    /// Register before reading the generation; always reread actual metadata.
+    pub fn notifier(&self) -> Arc<tokio::sync::Notify> {
+        self.changed.clone()
+    }
+    /// Publish a metadata hint after the actual state change. No permission is
+    /// inferred from the counter, including a hint issued without a mutation.
+    pub fn notify_waiters(&self) {
+        let _ = self.generation.fetch_update(
+            std::sync::atomic::Ordering::Release,
+            std::sync::atomic::Ordering::Relaxed,
+            |value| Some(value.saturating_add(1)),
+        );
+        self.changed.notify_waiters();
+    }
 }
