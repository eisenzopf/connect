+        assert_eq!(receiver.revision(),4);
+        assert_eq!(policy.attempts.load(Ordering::Acquire),attempts+1);
+        assert_eq!(policy.model_entries.load(Ordering::Acquire),model_entries+1);
+        let actual=policy.operations.lock().unwrap().clone();
+        assert_eq!(actual.len(),operations+1);
+        assert_eq!(actual.iter().filter(|(id,_)|id==&operation).count(),1,"no second logical attempt or duplicate engine commit");
