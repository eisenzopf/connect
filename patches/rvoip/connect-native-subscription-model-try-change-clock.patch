+#[cfg(test)]
+mod selection_clock_tests {
+    use super::SelectionChangeSignal;
+    #[tokio::test]
+    async fn committed_change_clock_survives_notification_registration_and_read_races() {
+        let signal=SelectionChangeSignal::default();
+        let before=signal.generation();
+        // notify_waiters deliberately retains no permit for a later waiter;
+        // the committed generation must still expose this exact lost-hint race.
+        signal.notify_waiters();
+        let notify=signal.notifier();let waiting=notify.notified();tokio::pin!(waiting);
+        waiting.as_mut().enable();
+        assert_ne!(before,signal.generation());
+        let captured=signal.generation();
+        signal.notify_waiters();
+        tokio::time::timeout(std::time::Duration::from_secs(1),&mut waiting).await.unwrap();
+        assert_ne!(captured,signal.generation(),"a read cannot acknowledge a change committed during it");
+        signal.generation.store(u64::MAX,std::sync::atomic::Ordering::Release);
+        signal.notify_waiters();
+        assert_eq!(signal.generation(),u64::MAX,"clock exhaustion must remain dirty rather than alias an old clean generation");
+    }
+}
