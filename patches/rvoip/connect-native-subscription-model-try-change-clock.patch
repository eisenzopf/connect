+// The catalog succeeds first; ONLY THEN does the real model become occupied.
+// This is the race that an immediate mutation-Busy/public-error retry loses.
+#[cfg(feature = "test-support")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn actual_reconciliation_waits_same_operation_when_model_becomes_busy_after_catalog_read() {
+    for kind in ["quic", "wt"] {
+        let (mut s,mut other,policy)=setup(kind).await;
+        let receiver=s.native.adapters[&s.kind].media_controller(&s.second_id).unwrap();
+        other.send(s.f.sign(select(receiver.revision()))).await;
+        assert_eq!(other.read().await.kind(),"ack");
+        let (_,source_callback)=s.prepared(add_video(&s,1,true)).await;
+        let source_video=subscriptions::stream_handle(&source_callback,"future_camera");
+        s.confirm(&source_callback).await;s.wait(3).await;
+        let callback=other.read().await;
+        let target_video=subscriptions::stream_handle(&callback,"future_camera");
+        other.send(s.f.sign(s.confirmation(&callback))).await;
+        core_fixture::until(||receiver.revision()==3).await;
+        core_fixture::until(||policy.operations.lock().unwrap().iter().any(|(_,v)|matches!(v,Ok(3)))).await;
+        send(&s.wire,subscriptions::video_sequence(source_video,1,29001));
+        assert_eq!(received(&other).await.rtp.packet().header.timestamp,29001);
+        let attempts=policy.attempts.load(Ordering::Acquire);
+        let operations=policy.operations.lock().unwrap().len();
+        let model_entries=policy.model_entries.load(Ordering::Acquire);
+        let (entered_tx,entered_rx)=tokio::sync::oneshot::channel();
+        let pause=Arc::new(ReconcileAdmissionPause {entered:Mutex::new(Some(entered_tx)),release:tokio::sync::Notify::new()});
+        assert!(policy.reconcile_pause.set(pause.clone()).is_ok());
+        let until=Instant::now()+Duration::from_secs(3);
+        // End only the screen: the original camera/receiver IO stays live.
+        // Retained compatible receive ports make the real change routing-only.
+        let (_,source_change)=s.prepared(add_video(&s,2,false)).await;
+        s.confirm(&source_change).await;s.wait(4).await;
+        let admitted=tokio::time::timeout_at(until,entered_rx).await;
+        let (operation,resources,expected)=admitted.expect("real changed catalog must enter fresh policy").unwrap();
+        assert!(!resources&&expected==3,"test must exercise actual routing-only post-catalog admission");
+        let orch=s.native.core.orch.clone();let session=s.native.core.session.clone();
+        let held=Arc::new(AtomicBool::new(true));let held_owner=held.clone();
+        let (held_tx,held_rx)=tokio::sync::oneshot::channel();
+        let (release_tx,release_rx)=std::sync::mpsc::sync_channel(1);
+        let owner=std::thread::spawn(move || {
+            let result=orch.with_participant_model_state_exclusion_for_test(&session,||{
+                let _=held_tx.send(());
+                release_rx.recv_timeout(until.saturating_duration_since(Instant::now())).is_ok()
+            });
+            held_owner.store(false,Ordering::Release);result
+        });
+        let entered=tokio::time::timeout_at(until,held_rx).await.is_ok_and(|v|v.is_ok());
+        // Deliver the SAME fresh authority callback to the actual runtime. It
+        // must remain in its original command until the real model is free.
+        pause.release.notify_one();
+        let heartbeat=tokio::time::timeout_at(until,async {
+            tokio::time::sleep(Duration::from_millis(1)).await;
+            held.load(Ordering::Acquire)
+        }).await;
+        send(&s.wire,subscriptions::video_sequence(source_video,2,29002));
+        let delivered=tokio::time::timeout_at(until,received(&other)).await;
+        let while_held=held.load(Ordering::Acquire);
+        let unchanged=(receiver.try_subscription_metadata().map(|v|v.0),
+            policy.attempts.load(Ordering::Acquire),policy.operations.lock().unwrap().len(),
+            policy.model_entries.load(Ordering::Acquire));
+        let release_sent=release_tx.send(()).is_ok();let joined=owner.join();
+        // The only real holder is joined before assertions or panic paths.
+        assert!(entered&&release_sent&&matches!(joined,Ok(Ok(true))));
+        assert!(matches!(heartbeat,Ok(true))&&while_held,"post-catalog model wait stalled the reactor");
+        let packet=delivered.expect("original healthy camera must progress before model release");
+        assert_eq!((packet.stream_local_id,packet.rtp.packet().header.timestamp),(target_video,29002));
+        assert!(matches!(unchanged.0,Ok(3)));
+        assert_eq!((unchanged.1,unchanged.2,unchanged.3),(attempts+1,operations,model_entries),"same command must remain pre-effect with no error observation/readmission while model held");
+        tokio::time::timeout_at(until,async {
+            loop {
+                if policy.operations.lock().unwrap().iter().any(|(id,result)|id==&operation&&matches!(result,Ok(4))) {break;}
+                tokio::time::sleep(Duration::from_millis(1)).await;
