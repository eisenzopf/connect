+//! Linear managed publication: grant-free preparation and one borrowed final turn.
+//!
+//! The public types below are the agreed Service/Core boundary. Implementations
+//! must never put an invocation, authority lease or paused delivery guard in the
+//! two opaque preparation objects.
+use super::*;
+use crate::staged_streams::{MediaControlIntent, MediaScope, MediaSource, MediaParticipantSource, StreamControlError, StreamController};
+use crate::staged_streams::device_replacement::{AudioDeviceReplacementHandle, AudioDeviceReplacementOutcome};
+use crate::staged_streams::handoff::{AudioHandoffHandle, AudioHandoffOutcome};
+
+/// Currentness of the exact purpose-specific final read, not cached role facts.
+/// Every method must be a pure atomic/expiry/scope check. They must not enter the
+/// Store, invoke policy, acquire a media mutex or wait for an authority fence.
+/// There is deliberately no default implementation or optional witness. This
+/// synchronous borrow has no Send/Sync requirement; a real non-Send SIP route
+/// guard stays in its lexical final block and must be dropped before any await.
+pub trait ReplacementFinalCurrent {
+    fn is_current(&self, scope: &ParticipantReplacementScope<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+    fn media_is_current(&self, controller: &Arc<StreamController>, scope: &MediaScope<'_>, intent: &MediaControlIntent<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+    fn source_is_current(&self, controller: &Arc<StreamController>, source: &MediaSource, intent: &MediaControlIntent<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+    fn participant_source_is_current(&self, controller: &Arc<StreamController>, source: &MediaParticipantSource, intent: &MediaControlIntent<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+}
+
+/// Handoff counterpart of the exact final-read witness, with the same purity
+/// and ownership requirements. A replacement witness cannot authorize Handoff.
+pub trait HandoffFinalCurrent {
+    fn is_current(&self, scope: &ParticipantHandoffScope<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+    fn media_is_current(&self, controller: &Arc<StreamController>, scope: &MediaScope<'_>, intent: &MediaControlIntent<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+    fn source_is_current(&self, controller: &Arc<StreamController>, source: &MediaSource, intent: &MediaControlIntent<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+    fn participant_source_is_current(&self, controller: &Arc<StreamController>, source: &MediaParticipantSource, intent: &MediaControlIntent<'_>, attempt: ManagedAttemptBinding<'_>) -> bool;
+}
+
+/// Exact durable attempt metadata. It is not authority and cannot by itself
+/// reconstruct a prepared cut or authorize re-admission.
+#[derive(Clone, Copy)]
+pub struct ManagedAttemptBinding<'a> {
+    pub record: &'a str,
+    pub attempt_id: &'a str,
+    pub effect_id: &'a str,
+}
+#[derive(PartialEq, Eq)]
+pub(crate) struct BoundManagedAttempt {
+    record: String,
+    attempt_id: String,
+    effect_id: String,
+}
+impl BoundManagedAttempt {
+    fn capture(value: ManagedAttemptBinding<'_>) -> Self {
+        Self { record: value.record.to_owned(), attempt_id: value.attempt_id.to_owned(), effect_id: value.effect_id.to_owned() }
+    }
+    fn matches(&self, value: ManagedAttemptBinding<'_>) -> bool {
+        self.record == value.record && self.attempt_id == value.attempt_id && self.effect_id == value.effect_id
+    }
+}
+
+/// Borrowed for precisely one synchronous final attempt. The caller owns the
+/// actual current purpose Writer and every alias of `held` outside this value.
+/// Core may derive temporary owner/receive tuples before acquiring its gates;
+/// none of those leases may escape that attempt or enter a prepared object.
+/// The supported caller also retains its exact grant-free per-turn controller
+/// resource bank OUTSIDE the Writer/final frame: every CONTROL and selected
+/// receive-source Arc is owned before this read and released only after all
+/// read/role/SIP aliases, before any Busy wait. This prevents temporary final
+/// metadata from being a last resource owner; external Weak sources are never
+/// permanently pinned by cold preparation.
+pub enum FinalControlGrant<'a> {
+    Replacement {
+        authority: &'a ParticipantReplacementAuthority,
+        attempt: ManagedAttemptBinding<'a>,
+        held: &'a (dyn Any + Send + Sync),
+        current: &'a dyn ReplacementFinalCurrent,
+        cancellation: &'a CancellationToken,
+        deadline: tokio::time::Instant,
+    },
+    Handoff {
+        authority: &'a ParticipantHandoffAuthority,
+        attempt: ManagedAttemptBinding<'a>,
+        held: &'a (dyn Any + Send + Sync),
+        current: &'a dyn HandoffFinalCurrent,
+        cancellation: &'a CancellationToken,
+        deadline: tokio::time::Instant,
+    },
+}
+impl FinalControlGrant<'_> {
+    pub(crate) fn attempt(&self) -> ManagedAttemptBinding<'_> {
+        match self { Self::Replacement { attempt, .. } | Self::Handoff { attempt, .. } => *attempt }
+    }
+    pub(crate) fn held(&self) -> &(dyn Any + Send + Sync) {
+        match self { Self::Replacement { held, .. } | Self::Handoff { held, .. } => *held }
+    }
+    pub(crate) fn deadline(&self) -> tokio::time::Instant {
+        match self { Self::Replacement { deadline, .. } | Self::Handoff { deadline, .. } => *deadline }
+    }
+    pub(crate) fn cancellation(&self) -> &CancellationToken {
+        match self { Self::Replacement { cancellation, .. } | Self::Handoff { cancellation, .. } => cancellation }
+    }
+    pub(crate) fn check_media_current(&self, controller: &Arc<StreamController>, scope: &MediaScope<'_>, intent: &MediaControlIntent<'_>) -> std::result::Result<(), StreamControlError> {
+        if self.cancellation().is_cancelled() { return Err(StreamControlError::Cancelled); }
+        if tokio::time::Instant::now() >= self.deadline() { return Err(StreamControlError::Deadline); }
+        let current = match self {
+            Self::Replacement { current, .. } => current.media_is_current(controller, scope, intent, self.attempt()),
+            Self::Handoff { current, .. } => current.media_is_current(controller, scope, intent, self.attempt()),
+        };
+        if current { Ok(()) } else { Err(StreamControlError::Authority) }
+    }
+    pub(crate) fn check_source_current(&self, controller: &Arc<StreamController>, source: &MediaSource, intent: &MediaControlIntent<'_>) -> std::result::Result<(), StreamControlError> {
+        if self.cancellation().is_cancelled() { return Err(StreamControlError::Cancelled); }
+        if tokio::time::Instant::now() >= self.deadline() { return Err(StreamControlError::Deadline); }
+        let current = match self {
+            Self::Replacement { current, .. } => current.source_is_current(controller, source, intent, self.attempt()),
+            Self::Handoff { current, .. } => current.source_is_current(controller, source, intent, self.attempt()),
+        };
+        if current { Ok(()) } else { Err(StreamControlError::Authority) }
+    }
+    pub(crate) fn check_participant_source_current(&self, controller: &Arc<StreamController>, source: &MediaParticipantSource, intent: &MediaControlIntent<'_>) -> std::result::Result<(), StreamControlError> {
+        if self.cancellation().is_cancelled() { return Err(StreamControlError::Cancelled); }
+        if tokio::time::Instant::now() >= self.deadline() { return Err(StreamControlError::Deadline); }
+        let current = match self {
+            Self::Replacement { current, .. } => current.participant_source_is_current(controller, source, intent, self.attempt()),
+            Self::Handoff { current, .. } => current.participant_source_is_current(controller, source, intent, self.attempt()),
+        };
+        if current { Ok(()) } else { Err(StreamControlError::Authority) }
