+//! Actual managed model-token controls, sharing the existing World policy.
+use super::*;
+use crate::orchestrator::participant_control::{FinalControlGrant,ManagedAttemptBinding,ReplacementFinalCurrent,ManagedAudioDeviceReplacementPlan};
+
+struct FinalResource {
+    controller:Arc<StreamController>, owner:MediaOwner,
+    bindings:Vec<crate::stream_lifecycle::ReadyMediaBinding>,
+}
+/// Fresh fixture-policy tuples captured before final gates. World and Domain
+/// permission remains live; this does not model a Service purpose Writer.
+pub(super) struct ReplacementCutCurrent {
+    root:ReplacementGrant, plan:ManagedAudioDeviceReplacementPlan,
+    attempt:String, effect:String, resources:BTreeMap<ConnectionId,FinalResource>,
+}
+impl ReplacementCutCurrent {
+    pub(super) fn capture(room:&ManagedRoom,root:&ReplacementGrant,plan:&ManagedAudioDeviceReplacementPlan,attempt:&str,effect:&str)->Self {
+        assert!(Arc::ptr_eq(&room.world,&root.world));
+        let resources=room.nodes.iter().map(|(id,node)|(id.clone(),FinalResource {controller:node.controller.clone(),owner:room.world.owner(id).unwrap(),bindings:node.controller.active_bindings()})).collect();
+        Self {root:root.clone(),plan:plan.clone(),attempt:attempt.to_owned(),effect:effect.to_owned(),resources}
+    }
+    fn capture_for(room:&ManagedRoom,root:&ReplacementGrant,plan:&ManagedAudioDeviceReplacementPlan,prepared:&crate::orchestrator::participant_control::PreparedManagedCut,attempt:&str,effect:&str)->Self {
+        let mut witness=Self::capture(room,root,plan,attempt,effect);
+        for source in prepared.final_receive_source_controllers().unwrap() {
+            witness.resources.entry(source.connection.clone()).or_insert_with(||FinalResource {owner:room.world.owner(&source.connection).unwrap(),bindings:source.active_bindings(),controller:source});
+        }
+        witness
+    }
+    pub(super) fn binding(&self)->ManagedAttemptBinding<'_> {ManagedAttemptBinding {record:&self.root.intent.operation_id,attempt_id:&self.attempt,effect_id:&self.effect}}
+    pub(super) fn grant<'a>(&'a self,authority:&'a ParticipantReplacementAuthority,held:&'a(dyn Any+Send+Sync),cancel:&'a CancellationToken)->FinalControlGrant<'a> {
+        FinalControlGrant::Replacement {authority,attempt:self.binding(),held,current:self,cancellation:cancel,deadline:self.root.until}
+    }
+    fn live(&self,attempt:ManagedAttemptBinding<'_>)->bool {
+        attempt.record==self.root.intent.operation_id&&attempt.attempt_id==self.attempt&&attempt.effect_id==self.effect
+            &&self.root.world.allowed.load(Ordering::Acquire)&&self.root.domain.allowed.load(Ordering::Acquire)
+            &&tokio::time::Instant::now()<self.root.until
+    }
+    fn intent(&self,intent:&MediaControlIntent<'_>)->bool {
+        matches!(intent,MediaControlIntent::DeviceReplacement{plan} if self.plan.media().audience().same_intent(plan))
+    }
+    fn resource(&self,controller:&Arc<StreamController>)->Option<&FinalResource> {
+        self.resources.get(&controller.connection).filter(|resource|Arc::ptr_eq(&resource.controller,controller)&&!controller.shutdown.is_cancelled()
+            &&resource.owner.connection.require_current(&resource.owner.member,&resource.owner.presence).is_ok())
+    }
+}
+impl ReplacementFinalCurrent for ReplacementCutCurrent {
+    fn is_current(&self,scope:&ParticipantReplacementScope<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&scope.phase==ReplacementPhase::Commit
+            &&scope.plan.is_some_and(|plan|self.plan.media().audience().same_intent(plan.audience()))
+            &&scope.conversation==self.root.domain.member.conversation()&&scope.session==&self.root.domain.session
+            &&scope.principal.ownership_key()==self.root.domain.principal.ownership_key()&&scope.principal.expires_at==self.root.domain.principal.expires_at&&scope.intent==&self.root.intent
+    }
+    fn media_is_current(&self,controller:&Arc<StreamController>,scope:&MediaScope<'_>,intent:&MediaControlIntent<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&self.intent(intent)&&self.resource(controller).is_some_and(|resource|matches!(scope.purpose,MediaPurpose::Control)
+            &&scope.connection==resource.owner.connection.connection()&&scope.conversation==resource.owner.member.conversation()
+            &&scope.session==resource.owner.presence.session()&&resource.owner.actor.revalidate_principal(scope.principal,chrono::Utc::now()).is_ok()
+            &&self.plan.media().audience().expected_receiver_revisions().contains_key(scope.connection))
+    }
+    fn source_is_current(&self,controller:&Arc<StreamController>,source:&MediaSource,intent:&MediaControlIntent<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&self.intent(intent)&&self.resource(controller).is_some_and(|resource|source.connection==*resource.owner.connection.connection()
+            &&source.conversation==*resource.owner.member.conversation()&&source.session==*resource.owner.presence.session()
+            &&source.participant==*resource.owner.member.participant()&&source.membership_epoch==resource.owner.member.epoch()
+            &&source.connection_generation==resource.owner.connection.generation()&&resource.bindings.iter().any(|binding|binding.negotiated.requested.logical_id==source.logical_id
+                &&binding.transport_id==source.transport_id&&binding.generation==source.stream_generation))
+    }
+    fn participant_source_is_current(&self,controller:&Arc<StreamController>,source:&MediaParticipantSource,intent:&MediaControlIntent<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&self.intent(intent)&&self.resource(controller).is_some_and(|resource|source.connection==*resource.owner.connection.connection()
+            &&source.conversation==*resource.owner.member.conversation()&&source.session==*resource.owner.presence.session()
+            &&source.identity==*resource.owner.member.identity()&&source.participant==*resource.owner.member.participant()
+            &&source.membership_epoch==resource.owner.member.epoch()&&source.medium==Medium::Audio
+            &&resource.owner.member.revalidate_principal(&source.principal,chrono::Utc::now()).is_ok())
+    }
+}
+
+struct ModelReady {
+    root:Arc<DeviceReplacementPreparation>, grant:ReplacementGrant,
+    plan:ManagedAudioDeviceReplacementPlan, old:ConnectionId, retained:ConnectionId,
+    healthy_source:ConnectionId, healthy_target:ConnectionId,
+    _audio:crate::staged_streams::audio_subscriptions::AudioReplacementPreparation,
+    _probe:crate::staged_streams::endpoint_preparation::AudioEndpointPreparation,
+    _context:crate::staged_streams::audience::AudioAudienceHandle,
+}
+async fn model_ready(room:&mut ManagedRoom)->ModelReady {model_ready_with_future(room,false).await}
+async fn model_ready_with_future(room:&mut ManagedRoom,future:bool)->ModelReady {model_ready_with_external(room,future,None).await}
+async fn model_ready_with_external(room:&mut ManagedRoom,future:bool,external:Option<&Arc<StreamController>>)->ModelReady {
+    let alice=domain(&room.conversation,&room.session,"managed-cut-original","alice");
+    let old=room.initial(alice.clone()).await;
+    let retained=room.initial(domain(&room.conversation,&room.session,"managed-cut-retained","bob")).await;
+    let healthy_source=room.initial(domain(&room.conversation,&room.session,"managed-cut-healthy-source","carol")).await;
+    let healthy_target=room.initial(domain(&room.conversation,&room.session,"managed-cut-healthy-target","dave")).await;
+    room.select(&old,vec![AudioSubscription::Connection(retained.clone())]).await;
+    room.select(&retained,vec![AudioSubscription::Connection(old.clone())]).await;
+    if future {
+        let controller=room.nodes[&healthy_source].controller.clone();
+        let logical=desired(Medium::Audio).logical_id;
+        let held=PortCommand {world:room.world.clone(),connection:healthy_source.clone(),expected:controller.revision(),mutation:PortMutation::End(logical.clone()),until:deadline()};
+        controller.end_stream_with_held(&logical,held.expected,held.until,Arc::new(held)).await.unwrap();
+        room.select(&healthy_target,vec![AudioSubscription::Participant(controller.origin_member.participant().clone())]).await;
+    } else {room.select(&healthy_target,vec![AudioSubscription::Connection(healthy_source.clone())]).await;}
+    if let Some(external)=external {
+        // A real ended unrelated video remains historical in this retained
+        // connection. Audio-only publication must not demand that old worker.
+        let retained_controller=room.nodes[&retained].controller.clone();
+        let logical=desired(Medium::Video).logical_id;
+        let end=PortCommand {world:room.world.clone(),connection:retained.clone(),expected:retained_controller.revision(),mutation:PortMutation::End(logical.clone()),until:deadline()};
+        retained_controller.end_stream_with_held(&logical,end.expected,end.until,Arc::new(end)).await.unwrap();
+        room.select(&healthy_target,vec![AudioSubscription::Connection(retained.clone())]).await;
+        let controller=room.nodes[&healthy_target].controller.clone();
+        let change=crate::staged_streams::direct_subscriptions::DirectSubscriptionChange::Subscribe(vec![crate::staged_streams::direct_subscriptions::DirectSubscription::new(external,desired(Medium::Video).logical_id,desired(Medium::Video).logical_id)]);
+        let held=PortCommand {world:room.world.clone(),connection:healthy_target.clone(),expected:controller.revision(),mutation:PortMutation::Direct(change.clone()),until:deadline()};
+        controller.change_direct_subscriptions(held.expected,change,held.until,CancellationToken::new(),Some(&held)).await.unwrap();
+    }
+    let mut next=domain(&room.conversation,&room.session,"managed-cut-successor","alice");
+    let exact=Arc::get_mut(&mut next).unwrap();exact.principal=alice.principal.clone();exact.member=alice.member.clone();
+    let (root,grant,signal,context,probe)=room.prepare_move(&old,&retained,next).await;
+    let audio=room.prepare_audio(&root,&grant).await;
+    room.nodes.get_mut(&retained).unwrap().publish(6000).unwrap();
+    room.nodes.get_mut(&grant.intent.replacement).unwrap().hear(6000).await;
+    room.nodes.get_mut(&grant.intent.replacement).unwrap().publish(5200).unwrap();
+    assert!(audio.has_delivered_remote_audio()&&probe.has_duplex_io());
+    room.signal(&root,&grant,&signal,DeviceReplacementEndpointEvent::Answered);
+    room.signal(&root,&grant,&signal,DeviceReplacementEndpointEvent::MediaObserved);
+    assert_eq!(room.signal(&root,&grant,&signal,DeviceReplacementEndpointEvent::Dtmf {digits:"7".into()}),EndpointConfirmationObservation::Confirmed);
+    let plan=room.orch.plan_staged_device_replacement(&root,None).unwrap();
