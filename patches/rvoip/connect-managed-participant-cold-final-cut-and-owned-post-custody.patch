+fn command(ready:&ModelReady)->Command {Command::Audience {root:ready.grant.clone(),plan:ready.plan.media().audience().clone()}}
+fn authority(ready:&ModelReady)->ParticipantReplacementAuthority {
+    ReplacementLease(ready.grant.clone()).current(&ParticipantReplacementScope {conversation:ready.grant.domain.member.conversation(),session:&ready.grant.domain.session,principal:&ready.grant.domain.principal,intent:&ready.grant.intent,phase:ReplacementPhase::Commit,plan:Some(ready.plan.media())}).unwrap()
