+enum PortMutation {Initialize,End(StreamId),Change(Vec<DesiredStream>),Direct(crate::staged_streams::direct_subscriptions::DirectSubscriptionChange)}
+pub(super) struct PortCommand {world:Arc<World>,connection:ConnectionId,expected:u64,mutation:PortMutation,until:tokio::time::Instant}
+impl PortCommand {
+    pub(super) fn media_control(&self,world:&Arc<World>,scope:&MediaScope<'_>,intent:&MediaControlIntent<'_>)->ControlResult<MediaControl> {
+        let exact=match (&self.mutation,intent) {
+            (PortMutation::Initialize,MediaControlIntent::Initialize)=>self.expected==0,
+            (PortMutation::End(original),MediaControlIntent::End {logical,expected})=>original==*logical&&self.expected==*expected,
+            (PortMutation::Change(original),MediaControlIntent::Change {desired,expected,replace})=>original.as_slice()==*desired&&self.expected==*expected&&replace.is_empty(),
+            (PortMutation::Direct(original),MediaControlIntent::DirectSubscriptions {change,expected})=>original==*change&&self.expected==*expected,
+            _=>false,
+        };
+        if !Arc::ptr_eq(world,&self.world)||scope.connection!=&self.connection||!matches!(scope.purpose,MediaPurpose::Control)||!exact||tokio::time::Instant::now()>=self.until{return Err(StreamControlError::Authority);}
+        MediaControl::new(world.lease(scope)?,CancellationToken::new(),self.until)
+    }
+}
