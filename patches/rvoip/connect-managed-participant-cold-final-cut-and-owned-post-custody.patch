+        let super::FinalControlGrant::Replacement {authority,current,..}=grant else {return Err(StreamControlError::Authority);};
+        if cancellation.is_cancelled() || grant.cancellation().is_cancelled() {return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=(*deadline).min(grant.deadline()) {return Err(StreamControlError::Deadline);}
+        if !current.is_current(&request,grant.attempt()) {return Err(StreamControlError::Authority);}
+        check_authority(&request,authority).map_err(handoff::media_error)?;
+        if plan.media.old_may_speak()&&!authority.may_send_audio {return Err(StreamControlError::Authority);}
+        // Every final metadata acquisition is immediate. No reader/policy,
+        // transport callback or constructor occurs after taking this mixer.
+        let mixer=runtime.mixer.members.try_lock().map_err(|_|StreamControlError::MetadataBusy)?;
+        let state=try_mutex(&runtime.state)?;
+        let registry=try_mutex(&owner.connection_registry_lock)?;
+        let lifecycles=try_lifecycles(owner,original_lifecycles,&registry)?;
+        let conversation=try_write(conversation)?;
+        let session=try_write(session)?;
+        let pending=try_mutex(&p.state)?;
+        if state.ended || state.controller.revision()!=p.intent.expected_revision
+            || conversation.state!=ConversationState::Open
+            || matches!(session.state,SessionState::Ending|SessionState::Ended|SessionState::Failed)
+            || p.phase.load(Ordering::Acquire)!=ATTACHED
+            || !state.pending.get(&p.intent.replacement).is_some_and(|value|value.replacement_nonce==Some(p.nonce))
+            || pending.context.is_none() || pending.slot.is_none()
+            || !pending.ticket.binding().same_incarnation(plan.media.pending().binding())
+        {return Err(crate::stream_lifecycle::MediaTransitionError::Conflict.into());}
+        for id in [&p.intent.source,&p.intent.retained,&p.intent.replacement] {
+            let expected=if id==&p.intent.replacement {
+                if session.connections.contains_key(id) {return Err(StreamControlError::Authority);}
+                &p.candidate
+            } else {
+                if !session.connections.contains_key(id) {return Err(StreamControlError::NotReady);}
+                &state.routes.get(id).ok_or(StreamControlError::NotReady)?.lifecycle
+            };
+            if !original_lifecycles.iter().any(|ticket|ticket.connection_id==*id&&ticket.generation==expected.generation&&Arc::ptr_eq(&ticket.state,&expected.state)) {return Err(StreamControlError::NotReady);}
+            match owner.connections.try_get(id) {
+                dashmap::try_result::TryResult::Present(actual) if Some(&actual.transport)==transports.get(id)=>{},
+                dashmap::try_result::TryResult::Locked=>return Err(StreamControlError::MetadataBusy),
+                _=>return Err(StreamControlError::NotReady),
+            }
+        }
+        state.controller.validate_prepared_replacement(&authority.actor,&authority.target,&p.intent,&pending.ticket,&authority.endpoint,model.as_ref().ok_or(StreamControlError::Authority)?)
+            .map_err(|error|handoff::media_error(error.into()))?;
