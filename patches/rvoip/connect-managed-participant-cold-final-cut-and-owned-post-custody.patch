+}
+pub(crate) struct PreparedReplacementCut {
+    owner: Arc<Orchestrator>,
+    runtime: Arc<ManagedParticipantSession>,
+    plan: ManagedAudioDeviceReplacementPlan,
+    conversation: Arc<RwLock<Conversation>>,
+    session: Arc<RwLock<Session>>,
+    lifecycles: Vec<ConnectionLifecycleTicket>,
+    deadline: tokio::time::Instant,
+    cancellation: CancellationToken,
+    model: Option<PreparedParticipantReplacementCommit>,
+    next_publication: Option<publication::ManagedRoutePublication>,
+    post: Option<Box<super::ManagedCutPostPublication>>,
+    model_committed: bool,
+    removed_original: Option<LiveRoute>,
+    released_temporary_slot: Option<OwnedSemaphorePermit>,
+    #[cfg(test)] model_panic: Option<super::managed_cut::ManagedModelPanicPoint>,
+    transports: BTreeMap<ConnectionId, Transport>,
+}
+impl ReplacementCutSeed {
+    pub(crate) fn capture(
+        owner: &Arc<Orchestrator>,
+        plan: &ManagedAudioDeviceReplacementPlan,
+        deadline: tokio::time::Instant,
+        cancellation: CancellationToken,
+        held: &(dyn Any + Send + Sync),
+    ) -> ControlResult<Self> {
+        let p = &plan.preparation;
+        owner.owns_replacement(p)?;
+        p.check()?;
+        let request = scope(p, ReplacementPhase::Commit, Some(&plan.media));
+        // The actual short planning grant exists in the caller. These calls
+        // occur before ANY media/model/registry guard, never with a fake held
+        // object. The returned memberships are guidance, not final authority.
+        let control = p.runtime.policy.current_replacement_control(&request, held)?;
+        let guidance = control.current(&request)?;
+        check_authority(&request, &guidance)?;
+        if plan.media.old_may_speak() && !guidance.may_send_audio { return Err(ParticipantControlError::Authority); }
+        let deadline = deadline_for(&p.principal, deadline.min(p.deadline).min(control.deadline));
+        if cancellation.is_cancelled() { return Err(ParticipantControlError::Cancelled); }
+        if tokio::time::Instant::now() >= deadline { return Err(ParticipantControlError::Deadline); }
+        let conversation = super::managed_cut::try_arc(&owner.conversations, &p.runtime.conversation)?
+            .ok_or_else(|| RvoipError::ConversationNotFound(p.runtime.conversation.clone()))?;
+        let session = super::managed_cut::try_arc(&owner.sessions, &p.runtime.session)?
+            .ok_or_else(|| RvoipError::SessionNotFound(p.runtime.session.clone()))?;
+        let mut lifecycles = p.source_lifecycles.clone();
+        lifecycles.push(p.candidate.clone());
+        lifecycles.sort_by(|a,b| a.connection_id.cmp(&b.connection_id));
+        for pair in lifecycles.windows(2) {
+            if pair[0].connection_id == pair[1].connection_id {
+                return Err(ParticipantControlError::Authority);
+            }
+        }
+        let mut transports = BTreeMap::new();
+        for id in [&p.intent.source, &p.intent.retained, &p.intent.replacement] {
+            if !lifecycles.iter().any(|ticket| &ticket.connection_id == id) { return Err(ParticipantControlError::Authority); }
+            match owner.connections.try_get(id) {
+                dashmap::try_result::TryResult::Present(entry) if entry.inbound_publication == InboundPublicationState::Published => {transports.insert(id.clone(), entry.transport);},
+                dashmap::try_result::TryResult::Locked => return Err(StreamControlError::MetadataBusy.into()),
+                _ => return Err(StreamControlError::NotReady.into()),
+            }
+        }
+        drop(control);
+        Ok(Self { owner: owner.clone(), runtime: p.runtime.clone(), plan: plan.clone(), guidance,
+            conversation, session, lifecycles, deadline, cancellation, transports })
+    }
+    pub(crate) fn scene(&self) -> ControlResult<Arc<crate::staged_streams::media_scene::GuardedMediaScene>> {
+        self.runtime.mixer.staged.clone().ok_or(ParticipantControlError::Unsupported)
+    }
+    pub(crate) fn audience(&self) -> AudioAudiencePlan { self.plan.media.audience().clone() }
+    pub(crate) fn deadline(&self) -> tokio::time::Instant { self.deadline }
+    pub(crate) fn cancellation(&self) -> CancellationToken { self.cancellation.clone() }
+    // Called only AFTER the complete synchronous audience metadata capture
+    // succeeds. No async work follows until the caller drops its planning read.
+    pub(crate) fn stage_once(self) -> ControlResult<PreparedReplacementCut> {
+        let p = &self.plan.preparation;
+        p.check()?;
+        if self.cancellation.is_cancelled() { return Err(ParticipantControlError::Cancelled); }
+        if tokio::time::Instant::now() >= self.deadline { return Err(ParticipantControlError::Deadline); }
+        let state = super::managed_cut::try_mutex(&self.runtime.state)?;
+        let pending = super::managed_cut::try_mutex(&p.state)?;
+        let conversation = super::managed_cut::try_read(&self.conversation)?;
+        let session = super::managed_cut::try_read(&self.session)?;
+        if conversation.state != ConversationState::Open
+            || matches!(session.state, SessionState::Ending | SessionState::Ended | SessionState::Failed)
+            || session.connections.contains_key(&p.intent.replacement)
+            || !session.connections.contains_key(&p.intent.source)
+            || !session.connections.contains_key(&p.intent.retained)
+            || state.ended || state.controller.revision() != p.intent.expected_revision
+            || p.phase.load(Ordering::Acquire) != ATTACHED
+            || !state.pending.get(&p.intent.replacement).is_some_and(|value|value.replacement_nonce == Some(p.nonce))
+            || pending.context.is_none() || pending.slot.is_none()
+            || !pending.ticket.binding().same_incarnation(self.plan.media.pending().binding())
+        { return Err(ParticipantTransitionError::Conflict.into()); }
+        let model = state.controller.stage_replacement(&self.guidance.actor,&self.guidance.target,p.intent.clone(),&pending.ticket,&self.guidance.endpoint)?;
+        let observation = model.observation();
+        let old = self.lifecycles.iter().find(|ticket| ticket.connection_id == p.intent.source).expect("captured original lifecycle").clone();
+        #[cfg(feature = "vcon")]
+        let records = vec![
+            (self.runtime.session.clone(), crate::records::RecordConnectionFact {participant:observation.participant.clone(),connection:observation.replaced.clone(),generation:old.generation,transport:self.transports[&observation.replaced],phase:crate::records::RecordConnectionPhase::LocallyRetired,correlation:Some(observation.operation_id.clone()),at:Utc::now()}),
+            (self.runtime.session.clone(), crate::records::RecordConnectionFact {participant:observation.participant.clone(),connection:observation.admitted.clone(),generation:p.candidate.generation,transport:self.transports[&observation.admitted],phase:crate::records::RecordConnectionPhase::LocallyAdmitted,correlation:Some(observation.operation_id.clone()),at:Utc::now()}),
+        ];
+        let post = super::managed_cut::ManagedModelPostFacts {owner:Arc::downgrade(&self.owner),
+            #[cfg(feature = "vcon")] records,
+            retiring:vec![old], events:vec![(self.runtime.events.clone(),ParticipantRuntimeEvent::ConnectionReplaced(observation.clone()))]};
+        drop(session);drop(conversation);drop(pending);drop(state);
+        Ok(PreparedReplacementCut { owner:self.owner, runtime:self.runtime, plan:self.plan,
+            conversation:self.conversation, session:self.session, lifecycles:self.lifecycles,
+            deadline:self.deadline, cancellation:self.cancellation, model:Some(model),
+            next_publication:Some(publication::ManagedRoutePublication::prepared()), post:Some(post.prebuild()), model_committed:false, removed_original:None, released_temporary_slot:None, #[cfg(test)] model_panic:None, transports:self.transports })
+    }
+}
