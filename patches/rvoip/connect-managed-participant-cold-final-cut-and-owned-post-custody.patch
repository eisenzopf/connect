+/// The audience backend derives ALL final reads before this model guard is
+/// acquired. It then combines these exact model/publication tickets with its
+/// own complete guard set. No policy or ordinary ticket lookup is allowed in
+/// check/commit; the final grant witness is pure and already purpose-scoped.
+pub(crate) trait ManagedAudiencePublication {
+    fn tickets(&self) -> Vec<rvoip_core_traits::peer_switch::PeerRouteTicket>;
+    /// Only ORIGINAL published model routes, never cold successor tickets.
+    fn quiescence_tickets(&self) -> Vec<rvoip_core_traits::peer_switch::PeerRouteTicket>;
+    fn empty_post(&mut self) -> ManagedCutPostPublication;
+    fn model_committed(&self) -> bool;
+    fn check(&self, plan: &crate::staged_streams::audience::AudioAudiencePlan, routes: &rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>) -> std::result::Result<(), StreamControlError>;
+    fn commit(&mut self, routes: &mut rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>) -> (replacement::ManagedAudienceObservation, ManagedCutPostPublication);
+}
+
+pub(super) fn try_mutex<T>(mutex: &Mutex<T>) -> std::result::Result<std::sync::MutexGuard<'_, T>, StreamControlError> {
+    match mutex.try_lock() {
+        Ok(value) => Ok(value),
+        Err(std::sync::TryLockError::Poisoned(error)) => Ok(error.into_inner()),
+        Err(std::sync::TryLockError::WouldBlock) => Err(StreamControlError::MetadataBusy),
+    }
+}
+pub(super) fn try_write<T>(lock: &RwLock<T>) -> std::result::Result<std::sync::RwLockWriteGuard<'_, T>, StreamControlError> {
+    match lock.try_write() {
+        Ok(value) => Ok(value),
+        Err(std::sync::TryLockError::Poisoned(error)) => Ok(error.into_inner()),
+        Err(std::sync::TryLockError::WouldBlock) => Err(StreamControlError::MetadataBusy),
+    }
+}
+pub(super) fn try_arc<K: Eq + std::hash::Hash, T>(map: &dashmap::DashMap<K, Arc<T>>, key: &K) -> std::result::Result<Option<Arc<T>>, StreamControlError> {
+    match map.try_get(key) {
+        dashmap::try_result::TryResult::Present(value) => Ok(Some(Arc::clone(value.value()))),
+        dashmap::try_result::TryResult::Absent => Ok(None),
+        dashmap::try_result::TryResult::Locked => Err(StreamControlError::MetadataBusy),
+    }
+}
+
+
+pub(super) fn try_lifecycles<'a>(
+    owner: &Orchestrator,
+    tickets: &'a [ConnectionLifecycleTicket],
+    _registry: &std::sync::MutexGuard<'_, ()>,
+) -> std::result::Result<Vec<std::sync::MutexGuard<'a, ConnectionLifecycleState>>, StreamControlError> {
+    let mut states = Vec::with_capacity(tickets.len());
+    for ticket in tickets { states.push(try_mutex(&ticket.state)?); }
+    for (ticket, state) in tickets.iter().zip(&states) {
+        if !state.active || state.retired || state.generation != ticket.generation
+            || state.peer_admission.as_ref().is_some_and(|permit| permit.peer.is_closed())
+        { return Err(StreamControlError::Cancelled); }
+        match owner.connection_lifecycles.try_get(&ticket.connection_id) {
+            dashmap::try_result::TryResult::Present(actual) if Arc::ptr_eq(actual.value(), &ticket.state) => {},
+            dashmap::try_result::TryResult::Locked => return Err(StreamControlError::MetadataBusy),
+            _ => return Err(StreamControlError::NotReady),
+        }
+        match owner.connections.try_get(&ticket.connection_id) {
+            dashmap::try_result::TryResult::Present(actual) if actual.inbound_publication == InboundPublicationState::Published => {},
+            dashmap::try_result::TryResult::Locked => return Err(StreamControlError::MetadataBusy),
+            _ => return Err(StreamControlError::NotReady),
+        }
+    }
+    Ok(states)
+}
+
+pub(super) fn try_read<T>(lock: &RwLock<T>) -> std::result::Result<std::sync::RwLockReadGuard<'_, T>, StreamControlError> {
+    match lock.try_read() {
+        Ok(value) => Ok(value),
+        Err(std::sync::TryLockError::Poisoned(error)) => Ok(error.into_inner()),
+        Err(std::sync::TryLockError::WouldBlock) => Err(StreamControlError::MetadataBusy),
+    }
+}
