+    model: &'a mut Option<PreparedParticipantReplacementCommit>,
+    next_publication: &'a mut Option<publication::ManagedRoutePublication>,
+    post: &'a mut Option<Box<super::ManagedCutPostPublication>>,
+    model_committed: &'a mut bool,
+    removed_original: &'a mut Option<LiveRoute>,
+    released_temporary_slot: &'a mut Option<OwnedSemaphorePermit>,
