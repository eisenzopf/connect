+        let before=room.orch.participant_revision(&room.session).unwrap();
+        let witness=ReplacementCutCurrent::capture(&room,&ready.grant,&ready.plan,"actual-attempt","actual-effect");
+        let role=authority(&ready);let held=command(&ready);let cancel=CancellationToken::new();
+        let panicking=PanicBeforeEffect(&witness);
+        let grant=FinalControlGrant::Replacement {authority:&role,attempt:witness.binding(),held:&held,current:&panicking,cancellation:&cancel,deadline:ready.grant.until};
+        let result=room.orch.try_commit_prepared_managed_cut(prepared,grant);
+        // The panic was caught before model publication; no linear retry token
+        // or success can be manufactured from the error. Cleanup is deferred.
+        let ManagedCutAttempt::Refused {post,..}=result else {panic!("preeffect unwind must be a terminal no-effect refusal")};
+        assert!(!ready.root.is_committed());assert_eq!(room.orch.participant_revision(&room.session).unwrap(),before);
+        drop(panicking);drop(witness);drop(role);drop(held);
+        room.orch.finish_managed_cut_publication(post).await.unwrap();
+        assert_eq!(room.orch.session_of(&ready.old),Some(room.session.clone()));
+        room.nodes.get_mut(&ready.healthy_source).unwrap().publish(7200).unwrap();
+        room.nodes.get_mut(&ready.healthy_target).unwrap().hear(7200).await;
+    }).await;
+    let clean=room.close_originals().await.into_iter().all(|value|value);
+    if let Err(error)=work {resume_unwind(error)}assert!(clean);
+}
