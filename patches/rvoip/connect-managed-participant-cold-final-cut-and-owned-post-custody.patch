+    }
+}
+impl super::ManagedAudiencePublication for PreparedReplacementGuard<'_, '_, '_> {
+    fn tickets(&self)->Vec<rvoip_core_traits::peer_switch::PeerRouteTicket> {
+        self.state.routes.get(&self.plan.preparation.intent.source).map(|route|route.publication.ticket()).into_iter().collect()
+    }
+    fn quiescence_tickets(&self)->Vec<rvoip_core_traits::peer_switch::PeerRouteTicket> {self.tickets()}
+    fn model_committed(&self)->bool {*self.model_committed}
+    fn empty_post(&mut self)->super::ManagedCutPostPublication {
+        if *self.model_committed{return *self.post.take().expect("actual model commit retained its prebuilt post");}
+        super::ManagedCutPostPublication {cleanup:None,owner:Arc::downgrade(self.owner),
+            #[cfg(feature="vcon")] records:Vec::new(),
+            retiring:Vec::new(),events:Vec::new(),model_cleanup:None,audience:None}
+    }
+    fn check(&self,plan:&AudioAudiencePlan,routes:&rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>)->std::result::Result<(),StreamControlError> {
+        let p=&self.plan.preparation;
+        p.check().map_err(handoff::media_error)?;
+        if !self.plan.media.audience().same_intent(plan) {return Err(StreamControlError::Authority);}
+        if self.cancellation.is_cancelled()||self.grant.cancellation().is_cancelled(){return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=self.deadline.min(self.grant.deadline()){return Err(StreamControlError::Deadline);}
+        let request=scope(p,ReplacementPhase::Commit,Some(&self.plan.media));
+        let super::FinalControlGrant::Replacement{authority,current,..}=self.grant else{return Err(StreamControlError::Authority);};
+        if !current.is_current(&request,self.grant.attempt()){return Err(StreamControlError::Authority);}
+        check_authority(&request,authority).map_err(handoff::media_error)?;
+        if self.plan.media.old_may_speak()&&!authority.may_send_audio{return Err(StreamControlError::Authority);}
+        let old=self.state.routes.get(&p.intent.source).ok_or(StreamControlError::NotReady)?;
+        if !routes.is_current(&old.publication.ticket()){return Err(StreamControlError::NotReady);}
+        Ok(())
+    }
+    fn commit(&mut self,routes:&mut rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>)->(ManagedAudienceObservation,super::ManagedCutPostPublication) {
+        let observation=self.state.controller.commit_replacement(self.model.take().expect("same one-shot prepared replacement model"));
+        // The prebuilt actual post remains OUTER-owned before any routing
+        // tail can unwind. No allocation/Reader/IO is introduced here.
+        #[cfg(feature="vcon")]
+        for (_,fact) in &mut self.post.as_mut().expect("prevalidated cold post").records {fact.at=Utc::now();}
+        *self.model_committed=true;
+        *self.released_temporary_slot=self.pending.slot.take();
+        #[cfg(test)] if matches!(self.model_panic,Some(super::managed_cut::ManagedModelPanicPoint::AfterCommit)){panic!("controlled actual managed model committed unwind");}
+        self.index.take().expect("preflighted actual index guards").commit();
+        self.session.connections.remove(&observation.replaced);
+        *self.removed_original=self.state.routes.remove(&observation.replaced);
+        self.removed_original.as_mut().expect("validated original route").publication.retire_held(routes);
+        #[cfg(test)] if matches!(self.model_panic,Some(super::managed_cut::ManagedModelPanicPoint::AfterOriginalRemoval)){panic!("controlled original route retained outside final guards");}
+        let old=&mut self.lifecycles[self.old_index];old.active=false;old.retired=true;
+        if let Some(permit)=&old.peer_admission {permit.retire_delivery();}
+        old.generation=old.generation.saturating_add(1);
+        self.session.connections.insert(observation.admitted.clone(),ConnectionRef{id:observation.admitted.clone(),participant_id:observation.participant.clone()});
+        // All invariant checks/ticket work precede the single infallible slot
+        // transfer expression. No callback or unwind rendezvous sits between
+        // taking the retained route and inserting its SAME admitted permit.
+        let publication=self.next_publication.take().expect("prevalidated cold publication ticket").arm();
+        self.state.routes.insert(observation.admitted.clone(),{
+            let original=self.removed_original.take().expect("outer-owned original admitted slot");
+            LiveRoute {_slot:original._slot,lifecycle:self.plan.preparation.candidate.clone(),publication}
+        });
+        self.lifecycles[self.candidate_index].replacement_reservation=None;
+        self.state.pending.remove(&observation.admitted);
+        self.plan.preparation.phase.store(COMMITTED,Ordering::Release);
+        self.conversation.last_activity_at=Utc::now();
+        let post=*self.post.take().expect("actual same model publication post");
+        (ManagedAudienceObservation{handoff:None,replacement:Some(observation)},post)
+    }
+}
+
+impl PreparedReplacementCut {
+    pub(crate) fn map_published(&self,outcome:crate::staged_streams::audience::AudioAudienceOutcome,handle:crate::staged_streams::audience::AudioAudienceHandle)->super::managed_cut::ManagedPublishedValue {
+        let (outcome,handle)=self.plan.media.finish_managed_audience(outcome,handle);
+        super::managed_cut::ManagedPublishedValue::Replacement(outcome,handle)
+    }
+}
+
+#[cfg(test)]
+impl PreparedReplacementCut {
+    pub(crate) fn model_panic_for_test(&mut self,point:super::managed_cut::ManagedModelPanicPoint){self.model_panic=Some(point);}
+    pub(crate) fn retained_model_resources_for_test(&self)->(bool,bool,bool){(self.model_committed,self.removed_original.is_some(),self.released_temporary_slot.is_some())}
+}
