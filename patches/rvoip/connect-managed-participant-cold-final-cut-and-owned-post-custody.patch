+#[derive(Clone)]
+enum HandoffApproval {
+    Audience(crate::staged_streams::audience::AudioAudiencePlan),
+    Cut(ManagedAudioHandoffPlan),
+}
+#[derive(Clone)]
+pub(super) struct HandoffCommand {
+    world:Arc<World>, actor:Arc<Domain>, outgoing:Arc<Domain>, incoming:Arc<Domain>,
+    approval:HandoffApproval, until:tokio::time::Instant,
+}
+impl HandoffCommand {
+    fn live(&self)->bool {self.world.allowed.load(Ordering::Acquire)&&self.actor.allowed.load(Ordering::Acquire)&&self.outgoing.allowed.load(Ordering::Acquire)&&self.incoming.allowed.load(Ordering::Acquire)&&tokio::time::Instant::now()<self.until}
+    fn matches(&self,intent:&MediaControlIntent<'_>)->bool {
+        match (&self.approval,intent) {
+            (HandoffApproval::Audience(expected),MediaControlIntent::AudioAudience {plan})=>expected.same_intent(plan)&&plan.handoff_request().is_none()&&plan.replacement_request().is_none(),
+            (HandoffApproval::Cut(expected),MediaControlIntent::Handoff {plan})=>expected.media().audience().same_intent(plan),
+            _=>false,
+        }
+    }
+    pub(super) fn media_control(&self,world:&Arc<World>,scope:&MediaScope<'_>,intent:&MediaControlIntent<'_>)->ControlResult<MediaControl> {
+        let plan=match &self.approval {HandoffApproval::Audience(plan)=>plan,HandoffApproval::Cut(plan)=>plan.media().audience()};
+        if !Arc::ptr_eq(world,&self.world)||!self.live()||!self.matches(intent)||!plan.expected_receiver_revisions().contains_key(scope.connection){return Err(StreamControlError::Authority);}
+        MediaControl::new(world.lease(scope)?,CancellationToken::new(),self.until)
+    }
+    fn scope_current(&self,scope:&ParticipantHandoffScope<'_>)->bool {
+        let HandoffApproval::Cut(plan)=&self.approval else {return false;};
+        self.live()&&scope.conversation==self.actor.member.conversation()&&scope.session==&self.actor.session
+            &&scope.principal.ownership_key()==self.actor.principal.ownership_key()&&scope.principal.expires_at==self.actor.principal.expires_at&&plan.same_intent(scope.plan)
+    }
+    fn authority(&self,scope:&ParticipantHandoffScope<'_>)->std::result::Result<ParticipantHandoffAuthority,ParticipantControlError> {
+        if !self.scope_current(scope){return Err(ParticipantControlError::Authority);}
+        Ok(ParticipantHandoffAuthority {actor:self.actor.member.clone(),outgoing:self.outgoing.member.clone(),incoming:self.incoming.member.clone(),incoming_may_send_audio:true,outgoing_may_receive_audio:true})
+    }
+}
+struct HandoffLease(HandoffCommand);
+impl ParticipantHandoffLease for HandoffLease {
+    fn current(&self,scope:&ParticipantHandoffScope<'_>)->std::result::Result<ParticipantHandoffAuthority,ParticipantControlError> {self.0.authority(scope)}
+}
+pub(super) fn handoff_control(world:&World,scope:&ParticipantHandoffScope<'_>,held:&(dyn Any+Send+Sync))->std::result::Result<ParticipantHandoffControl,ParticipantControlError> {
+    let command=held.downcast_ref::<HandoffCommand>().ok_or(ParticipantControlError::Authority)?;
+    if !std::ptr::eq(world,command.world.as_ref()){return Err(ParticipantControlError::Authority);}
+    command.authority(scope)?;
+    ParticipantHandoffControl::new(Box::new(HandoffLease(command.clone())),CancellationToken::new(),command.until)
+}
+struct HandoffCurrent {command:HandoffCommand,resources:BTreeMap<ConnectionId,FinalResource>,attempt:String,effect:String,record:String}
+impl HandoffCurrent {
+    fn capture(room:&ManagedRoom,command:&HandoffCommand)->Self {
+        let HandoffApproval::Cut(plan)=&command.approval else {panic!("actual handoff plan required")};
+        Self {command:command.clone(),resources:room.nodes.iter().map(|(id,node)|(id.clone(),FinalResource {controller:node.controller.clone(),owner:room.world.owner(id).unwrap(),bindings:node.controller.active_bindings()})).collect(),attempt:"actual-handoff-attempt".into(),effect:"actual-handoff-effect".into(),record:plan.media().request().operation_id.clone()}
+    }
+    fn binding(&self)->ManagedAttemptBinding<'_> {ManagedAttemptBinding {record:&self.record,attempt_id:&self.attempt,effect_id:&self.effect}}
+    fn live(&self,attempt:ManagedAttemptBinding<'_>)->bool {self.command.live()&&attempt.record==self.record&&attempt.attempt_id==self.attempt&&attempt.effect_id==self.effect}
+    fn resource(&self,controller:&Arc<StreamController>)->Option<&FinalResource> {self.resources.get(&controller.connection).filter(|resource|Arc::ptr_eq(&resource.controller,controller)&&!controller.shutdown.is_cancelled()&&resource.owner.connection.require_current(&resource.owner.member,&resource.owner.presence).is_ok())}
+    fn grant<'a>(&'a self,role:&'a ParticipantHandoffAuthority,cancel:&'a CancellationToken)->FinalControlGrant<'a> {FinalControlGrant::Handoff {authority:role,attempt:self.binding(),held:&self.command,current:self,cancellation:cancel,deadline:self.command.until}}
+}
+impl crate::orchestrator::participant_control::HandoffFinalCurrent for HandoffCurrent {
+    fn is_current(&self,scope:&ParticipantHandoffScope<'_>,attempt:ManagedAttemptBinding<'_>)->bool {self.live(attempt)&&self.command.scope_current(scope)}
+    fn media_is_current(&self,controller:&Arc<StreamController>,scope:&MediaScope<'_>,intent:&MediaControlIntent<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&self.command.matches(intent)&&self.resource(controller).is_some_and(|resource|matches!(scope.purpose,MediaPurpose::Control)&&scope.connection==resource.owner.connection.connection()&&scope.conversation==resource.owner.member.conversation()&&scope.session==resource.owner.presence.session()&&resource.owner.actor.revalidate_principal(scope.principal,chrono::Utc::now()).is_ok())
+    }
+    fn source_is_current(&self,controller:&Arc<StreamController>,source:&MediaSource,intent:&MediaControlIntent<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&self.command.matches(intent)&&self.resource(controller).is_some_and(|resource|source.connection==*resource.owner.connection.connection()&&source.conversation==*resource.owner.member.conversation()&&source.session==*resource.owner.presence.session()&&source.participant==*resource.owner.member.participant()&&source.membership_epoch==resource.owner.member.epoch()&&source.connection_generation==resource.owner.connection.generation()&&resource.bindings.iter().any(|binding|binding.negotiated.requested.logical_id==source.logical_id&&binding.transport_id==source.transport_id&&binding.generation==source.stream_generation))
+    }
+    fn participant_source_is_current(&self,controller:&Arc<StreamController>,source:&MediaParticipantSource,intent:&MediaControlIntent<'_>,attempt:ManagedAttemptBinding<'_>)->bool {
+        self.live(attempt)&&self.command.matches(intent)&&self.resource(controller).is_some_and(|resource|source.connection==*resource.owner.connection.connection()&&source.conversation==*resource.owner.member.conversation()&&source.session==*resource.owner.presence.session()&&source.identity==*resource.owner.member.identity()&&source.participant==*resource.owner.member.participant()&&source.membership_epoch==resource.owner.member.epoch()&&source.medium==Medium::Audio&&resource.owner.member.revalidate_principal(&source.principal,chrono::Utc::now()).is_ok())
+    }
