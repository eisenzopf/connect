+        // logical identity; ended IDs are never reused.
+        let fresh=DesiredStream {logical_id:StreamId::from_string("managed-future-audio"),medium:Medium::Audio,direction:StreamDirection::Both};
+        let held=PortCommand {world:room.world.clone(),connection:ready.healthy_source.clone(),expected:source.revision(),mutation:PortMutation::Change(vec![fresh.clone()]),until:deadline()};
+        source.change_with_held(held.expected,&[fresh.clone()],&BTreeSet::new(),held.until,CancellationToken::new(),Arc::new(held)).await.unwrap();
