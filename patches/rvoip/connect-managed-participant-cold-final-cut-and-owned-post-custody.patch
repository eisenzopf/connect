+        let Self {owner,runtime,plan,conversation,session,lifecycles:original_lifecycles,deadline,cancellation,model,next_publication,post,model_committed,removed_original,released_temporary_slot,#[cfg(test)] model_panic,transports}=self;
+        let p=&plan.preparation;
