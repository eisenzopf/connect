+impl Orchestrator {
+    fn reserve_managed_cut_cleanup(&self)->ControlResult<ManagedCleanupReservation> {
+        let (sender,work)=tokio::sync::oneshot::channel::<ManagedCleanupWork>();
+        let (completed,completion)=tokio::sync::oneshot::channel();
+        self.connection_lifecycle_tasks.spawn_terminal(async move {
+            // No Core/route/current authority owner is retained while cold.
+            // Cold abandonment is no effect: no payload was ever published.
+            let result=match work.await {
+                Ok(ManagedCleanupWork {owner,post})=>owner.finish_managed_cut_post_owned(post).await,
+                Err(_)=>Ok(()),
+            };
+            let _=completed.send(result);
+        }).map_err(|_|ParticipantControlError::Core(RvoipError::AdmissionRejected("managed cut terminal cleanup capacity unavailable")))?;
+        Ok(ManagedCleanupReservation {sender,completion})
+    }
+    /// SYNCHRONOUS handoff for the actual Service operation-owner Drop path.
+    /// Its nested final frame (including all Writer/read/role/SIP aliases) MUST
+    /// already have ended. This does not infer release from a timer/Post Drop.
+    /// Sending transfers a strong original Core with the actual work once.
+    pub fn start_managed_cut_publication(self:&Arc<Self>,mut post:ManagedCutPostPublication)->std::result::Result<ManagedCutPostCompletion,ManagedCutPostFinishError> {
+        if !post.owner.upgrade().is_some_and(|owner|Arc::ptr_eq(&owner,self)) {
+            return Err(ManagedCutPostFinishError::SubmissionFailed {error:ParticipantControlError::Authority,post});
+        }
+        let Some(ManagedCleanupReservation {sender,completion})=post.cleanup.take() else {
+            return Err(ManagedCutPostFinishError::SubmissionFailed {error:RvoipError::InvalidState("managed cut lacks original cleanup reservation").into(),post});
+        };
+        match sender.send(ManagedCleanupWork {owner:self.clone(),post}) {
+            Ok(())=>Ok(ManagedCutPostCompletion {completion}),
+            Err(mut work)=> {
+                // The worker's original join is retained by the terminal
+                // supervisor. No second task or Core publication is admitted.
+                work.post.cleanup=None;
+                Err(ManagedCutPostFinishError::SubmissionFailed {error:RvoipError::InvalidState("pre-admitted managed cleanup worker closed before submission").into(),post:work.post})
+            }
+        }
+    }
+    pub async fn finish_managed_cut_publication(self:&Arc<Self>,post:ManagedCutPostPublication)->std::result::Result<(),ManagedCutPostFinishError> {
+        self.start_managed_cut_publication(post)?.wait().await
+    }
+    async fn finish_managed_cut_post_owned(self:&Arc<Self>,mut post:ManagedCutPostPublication)->ControlResult<()> {
+        // The capture policy may enter Store/application code. It is called
+        // only here, after ALL final model/media/authority aliases have gone.
+        let mut custody_error=None;
+        #[cfg(feature="vcon")]
+        for (session,fact) in std::mem::take(&mut post.records) {
+            if std::panic::catch_unwind(std::panic::AssertUnwindSafe(||self.capture_record_connection_fact(&session,fact))).is_err(){custody_error=Some(StreamControlError::CleanupUnconfirmed.into());}
+        }
+        for (sender,event) in std::mem::take(&mut post.events) {let _=sender.send(event);}
+        if let Some(audience)=post.audience.take(){if let Err(error)=audience.finish().await {custody_error=Some(error.into());}}
+        // Refusal cleanup drops inactive reservations here too. The protocol
+        // still owns its original F plan; a noncommitted audience never marks
+        // that original freeze committed merely to perform cleanup.
+        drop(post.model_cleanup.take());
+        for ticket in std::mem::take(&mut post.retiring) {
+            // Connection IDs are non-reusable. Still verify actual custody so
+            // a foreign lifecycle cannot be retired from stale metadata.
+            let exact=self.connection_lifecycles.get(&ticket.connection_id).is_some_and(|actual|Arc::ptr_eq(actual.value(),&ticket.state));
+            if !exact{custody_error=Some(ParticipantControlError::Authority);continue;}
+            let adapter=self.adapter_for_cleanup(&ticket.connection_id).ok();
+            let forgotten=self.begin_connection_teardown(&ticket.connection_id,InboundAdmissionTermination::Cancelled);
+            let _=self.finish_connection_teardown(&ticket.connection_id,forgotten).await;
+            if let Some(adapter)=adapter {
+                let transport=adapter.transport();
+                if adapter.is_connection_live(&ticket.connection_id) {
+                    // Same existing bounded end/quarantine behavior as the
+                    // original owned participant-route retirement path.
+                    self.cleanup_failed_adapter_route(adapter.clone(),transport,&ticket.connection_id,"participant route retired").await;
+                    if adapter.is_connection_live(&ticket.connection_id){custody_error=Some(StreamControlError::CleanupUnconfirmed.into());}
+                }
+            } else {custody_error=Some(StreamControlError::CleanupUnconfirmed.into());}
+        }
+        match custody_error {Some(error)=>Err(error),None=>Ok(())}
+    }
+}
