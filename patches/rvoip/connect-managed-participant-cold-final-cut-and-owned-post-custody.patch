+pub(crate) struct PreparedHandoffCut {
+    owner: Arc<Orchestrator>,
+    runtime: Arc<ManagedParticipantSession>,
+    plan: ManagedAudioHandoffPlan,
+    principal: AuthenticatedPrincipal,
+    mutation: ParticipantHandoffMutation,
+    conversation: Arc<RwLock<Conversation>>,
+    session: Arc<RwLock<Session>>,
+    lifecycles: Vec<ConnectionLifecycleTicket>,
+    deadline: tokio::time::Instant,
+    cancellation: CancellationToken,
+    model: Option<PreparedParticipantHandoff>,
+    post: Option<Box<super::ManagedCutPostPublication>>,
+    model_committed: bool,
+    removed_originals: Vec<LiveRoute>,
+}
+impl HandoffCutSeed {
+    pub(crate) fn capture(owner:&Arc<Orchestrator>,session:&SessionId,principal:AuthenticatedPrincipal,plan:&ManagedAudioHandoffPlan,deadline:tokio::time::Instant,cancellation:CancellationToken,held:&(dyn Any+Send+Sync))->ControlResult<Self> {
+        use super::managed_cut::{try_arc,try_mutex};
+        let runtime=try_arc(&owner.participant_sessions,session)?.ok_or(ParticipantControlError::Authority)?;
+        let request=ParticipantHandoffScope {conversation:&runtime.conversation,session,principal:&principal,plan};
+        let control=runtime.policy.current_handoff_control(&request,held)?;
+        let guidance=control.current(&request)?;
+        check_handoff_authority(&runtime,&principal,plan,&guidance)?;
+        let deadline=principal_expiry(&principal).map_or(deadline.min(control.deadline),|expiry|deadline.min(control.deadline).min(tokio::time::Instant::now()+(expiry-Utc::now()).to_std().unwrap_or_default()));
+        if cancellation.is_cancelled(){return Err(ParticipantControlError::Cancelled);}
+        if tokio::time::Instant::now()>=deadline{return Err(ParticipantControlError::Deadline);}
+        let conversation=try_arc(&owner.conversations,&runtime.conversation)?.ok_or(ParticipantControlError::Authority)?;
+        let session_value=try_arc(&owner.sessions,session)?.ok_or(ParticipantControlError::Authority)?;
+        let ids=plan.media.outgoing_connections().into_iter().chain([plan.media.request().retained.clone(),plan.media.request().admitted.clone()]).collect::<std::collections::BTreeSet<_>>();
+        let state=try_mutex(&runtime.state)?;
+        if state.ended||state.controller.revision()!=plan.expected_revision{return Err(ParticipantTransitionError::Conflict.into());}
+        let lifecycles=ids.iter().map(|id|state.routes.get(id).map(|route|route.lifecycle.clone()).ok_or(ParticipantControlError::Authority)).collect::<ControlResult<Vec<_>>>()?;
+        drop(state);drop(control);
+        Ok(Self {owner:owner.clone(),runtime,plan:plan.clone(),principal,guidance,conversation,session:session_value,lifecycles,deadline,cancellation})
+    }
+    pub(crate) fn scene(&self)->ControlResult<Arc<crate::staged_streams::media_scene::GuardedMediaScene>> {self.runtime.mixer.staged.clone().ok_or(ParticipantControlError::Unsupported)}
+    pub(crate) fn audience(&self)->AudioAudiencePlan {self.plan.media.audience().clone()}
+    pub(crate) fn deadline(&self)->tokio::time::Instant {self.deadline}
+    pub(crate) fn cancellation(&self)->CancellationToken {self.cancellation.clone()}
+    pub(crate) fn stage_once(self)->ControlResult<PreparedHandoffCut> {
+        use super::managed_cut::{try_mutex,try_read};
+        if self.cancellation.is_cancelled(){return Err(ParticipantControlError::Cancelled);}
+        if tokio::time::Instant::now()>=self.deadline{return Err(ParticipantControlError::Deadline);}
+        let state=try_mutex(&self.runtime.state)?;let conversation=try_read(&self.conversation)?;let session=try_read(&self.session)?;
+        if state.ended||state.controller.revision()!=self.plan.expected_revision||conversation.state!=ConversationState::Open||matches!(session.state,SessionState::Ending|SessionState::Ended|SessionState::Failed){return Err(ParticipantTransitionError::Conflict.into());}
+        let outgoing=state.controller.connections(self.guidance.outgoing.participant()).into_iter().collect::<std::collections::BTreeSet<_>>();
+        if outgoing!=self.plan.media.outgoing_connections(){return Err(ParticipantTransitionError::Conflict.into());}
+        let request=self.plan.media.request();
+        for id in outgoing.iter().chain([&request.retained,&request.admitted]) {
+            if !session.connections.contains_key(id)||!state.routes.get(id).is_some_and(|route|self.lifecycles.iter().any(|ticket|ticket.connection_id==*id&&ticket.generation==route.lifecycle.generation&&Arc::ptr_eq(&ticket.state,&route.lifecycle.state))){return Err(StreamControlError::NotReady.into());}
+        }
+        let mutation=ParticipantHandoffMutation {operation_id:request.operation_id.clone(),correlation_id:self.plan.correlation_id.clone(),expected_revision:self.plan.expected_revision,outgoing:self.guidance.outgoing.participant().clone(),incoming:self.guidance.incoming.participant().clone(),retained:request.retained.clone(),admitted:request.admitted.clone(),incoming_role:self.plan.incoming_role.clone(),outgoing_disposition:match request.old_disposition {OldHandoffDisposition::Observer=>ParticipantHandoffDisposition::Observe,OldHandoffDisposition::Leave=>ParticipantHandoffDisposition::Leave}};
+        let model=state.controller.prepare_handoff(&self.guidance.actor,&self.guidance.outgoing,&self.guidance.incoming,mutation.clone())?;
+        let observation=model.observation();
+        let retiring=observation.retired.iter().map(|id|self.lifecycles.iter().find(|ticket|&ticket.connection_id==id).expect("captured outgoing lifecycle").clone()).collect();
+        let post=super::managed_cut::ManagedModelPostFacts {owner:Arc::downgrade(&self.owner),
+            #[cfg(feature="vcon")] records:Vec::new(),
+            retiring,events:vec![(self.runtime.events.clone(),ParticipantRuntimeEvent::HandoffCommitted(observation.clone()))]};
+        let removed_originals=Vec::with_capacity(observation.retired.len());
+        drop(session);drop(conversation);drop(state);
+        Ok(PreparedHandoffCut {owner:self.owner,runtime:self.runtime,plan:self.plan,principal:self.principal,mutation,conversation:self.conversation,session:self.session,lifecycles:self.lifecycles,deadline:self.deadline,cancellation:self.cancellation,model:Some(model),post:Some(post.prebuild()),model_committed:false,removed_originals})
+    }
+}
