+#[tokio::test]
+async fn managed_actual_model_and_removed_route_unwind_keep_original_slots_until_deferred_post_once() {
+    use crate::orchestrator::participant_control::{ManagedCutAttempt,ManagedModelPanicPoint};
+    for (point,removed) in [(ManagedModelPanicPoint::AfterCommit,false),(ManagedModelPanicPoint::AfterOriginalRemoval,true)] {
+        let mut room=ManagedRoom::new().await;
+        let work=catch_original(async {
+            let ready=model_ready(&mut room).await;
+            let mut prepared=room.orch.prepare_staged_managed_cut(captured(&room,&ready).await).await.unwrap();
+            prepared.model_panic_for_test(point);
+            let capacity=room.orch.managed_capacity_for_test(&room.session).unwrap();
+            let before=room.orch.participant_revision(&room.session).unwrap();
+            let witness=ReplacementCutCurrent::capture(&room,&ready.grant,&ready.plan,"actual-attempt","actual-effect");
+            let role=authority(&ready);let held=command(&ready);let cancel=CancellationToken::new();
+            let result=room.orch.try_commit_prepared_managed_cut(prepared,witness.grant(&role,&held,&cancel));
+            let ManagedCutAttempt::EffectPossible {post,..}=result else {panic!("actual model publication unwind must consume retry custody")};
+            // These are the actual semaphore permits and original route, not
+            // a copied observer bit. Final caller aliases still exist here.
+            assert_eq!(post.retained_model_resources_for_test(),(true,removed,true));
+            assert_eq!(room.orch.managed_capacity_for_test(&room.session).unwrap(),capacity,"no original/temp slot destructor ran beneath final aliases");
+            assert_eq!(room.orch.participant_revision(&room.session).unwrap(),before+1,"the actual one-shot model commit occurred once");
+            assert_eq!(room.route.ends.load(Ordering::Acquire),0,"terminal retirement must not start before alias release");
+            drop(held);drop(role);drop(witness);
+            let receipt=room.orch.start_managed_cut_publication(post).unwrap();
+            receipt.wait().await.unwrap();
+            assert_eq!(room.route.ends.load(Ordering::Acquire),1,"the same original retirement was consumed once");
+            assert_eq!(room.orch.managed_capacity_for_test(&room.session).unwrap().1,capacity.1+1,"temporary reservation retired by its original owned post");
+        }).await;
+        let clean=room.close_originals().await.into_iter().all(|value|value);
+        if let Err(error)=work {resume_unwind(error)}assert!(clean);
+    }
+}
