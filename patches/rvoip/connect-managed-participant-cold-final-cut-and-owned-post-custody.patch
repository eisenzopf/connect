+pub(crate) struct PreparedHandoffGuard<'a,'b,'c> {
+    owner: &'a Arc<Orchestrator>,
+    runtime: &'a Arc<ManagedParticipantSession>,
+    plan: &'a ManagedAudioHandoffPlan,
+    principal: &'a AuthenticatedPrincipal,
+    original_lifecycles: &'a [ConnectionLifecycleTicket],
+    deadline: tokio::time::Instant,
+    cancellation: &'a CancellationToken,
+    grant: &'b super::FinalControlGrant<'c>,
+    model: &'a mut Option<PreparedParticipantHandoff>,
+    post: &'a mut Option<Box<super::ManagedCutPostPublication>>,
+    model_committed: &'a mut bool,
+    removed_originals: &'a mut Vec<LiveRoute>,
+    retiring_indices: Vec<(ConnectionId,usize)>,
+    _mixer: tokio::sync::MutexGuard<'a,HashMap<ConnectionId,ConferenceMember>>,
+    state: std::sync::MutexGuard<'a,ManagedState>,
+    _registry: std::sync::MutexGuard<'a,()>,
+    lifecycles: Vec<std::sync::MutexGuard<'a,ConnectionLifecycleState>>,
+    conversation: std::sync::RwLockWriteGuard<'a,Conversation>,
+    session: std::sync::RwLockWriteGuard<'a,Session>,
+    index: Option<crate::orchestrator::dtmf_routing::BindingCommit<'a>>,
+}
+impl PreparedHandoffCut {
+    pub(crate) fn scene(&self)->ControlResult<Arc<crate::staged_streams::media_scene::GuardedMediaScene>> {self.runtime.mixer.staged.clone().ok_or(ParticipantControlError::Unsupported)}
+    pub(crate) fn deadline(&self)->tokio::time::Instant {self.deadline}
+    pub(crate) fn cancellation(&self)->&CancellationToken {&self.cancellation}
+    pub(crate) fn record(&self)->&str {&self.plan.media.request().operation_id}
+    pub(crate) fn owner(&self)->&Arc<Orchestrator> {&self.owner}
+    pub(crate) fn try_guard<'a,'b,'c>(&'a mut self,grant:&'b super::FinalControlGrant<'c>)->std::result::Result<PreparedHandoffGuard<'a,'b,'c>,StreamControlError> {
+        use super::managed_cut::{try_mutex,try_write,try_lifecycles};
+        use crate::orchestrator::dtmf_routing::BindingChange;
+        let Self {owner,runtime,plan,principal,mutation,conversation,session,lifecycles:original_lifecycles,deadline,cancellation,model,post,model_committed,removed_originals}=self;
+        let request=ParticipantHandoffScope {conversation:&runtime.conversation,session:&runtime.session,principal,plan};
+        let super::FinalControlGrant::Handoff {authority,current,..}=grant else {return Err(StreamControlError::Authority);};
+        if cancellation.is_cancelled()||grant.cancellation().is_cancelled(){return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=(*deadline).min(grant.deadline()){return Err(StreamControlError::Deadline);}
+        if !current.is_current(&request,grant.attempt()){return Err(StreamControlError::Authority);}
+        check_handoff_authority(runtime,principal,plan,authority)?;
+        let mixer=runtime.mixer.members.try_lock().map_err(|_|StreamControlError::MetadataBusy)?;
+        let state=try_mutex(&runtime.state)?;
+        let registry=try_mutex(&owner.connection_registry_lock)?;
+        let lifecycles=try_lifecycles(owner,original_lifecycles,&registry)?;
+        let conversation=try_write(conversation)?;
+        let session=try_write(session)?;
+        if state.ended||state.controller.revision()!=plan.expected_revision||conversation.state!=ConversationState::Open||matches!(session.state,SessionState::Ending|SessionState::Ended|SessionState::Failed){return Err(crate::stream_lifecycle::MediaTransitionError::Conflict.into());}
+        let outgoing=state.controller.connections(authority.outgoing.participant()).into_iter().collect::<std::collections::BTreeSet<_>>();
+        if outgoing!=plan.media.outgoing_connections(){return Err(crate::stream_lifecycle::MediaTransitionError::Conflict.into());}
+        for id in outgoing.iter().chain([&plan.media.request().retained,&plan.media.request().admitted]) {
+            if !session.connections.contains_key(id)||!state.routes.get(id).is_some_and(|route|original_lifecycles.iter().any(|ticket|ticket.connection_id==*id&&ticket.generation==route.lifecycle.generation&&Arc::ptr_eq(&ticket.state,&route.lifecycle.state))){return Err(StreamControlError::NotReady);}
+        }
+        state.controller.validate_prepared_handoff(&authority.actor,&authority.outgoing,&authority.incoming,mutation,model.as_ref().ok_or(StreamControlError::Authority)?).map_err(|error|media_error(error.into()))?;
+        // Observe has no retired index key. Leave removes exactly the original
+        // model observation's keys; sorted unique shards are acquired once.
+        if *model_committed||model.is_none()||post.is_none()||!removed_originals.is_empty(){return Err(StreamControlError::Authority);}
+        let retiring_indices=model.as_ref().expect("validated original model token").observation().retired.iter().map(|id|Ok((id.clone(),original_lifecycles.iter().position(|ticket|ticket.connection_id==*id).ok_or(StreamControlError::Authority)?))).collect::<std::result::Result<Vec<_>,StreamControlError>>()?;
+        let changes=model.as_ref().expect("validated original model token").observation().retired.iter().map(|id|BindingChange{connection:id.clone(),before:Some(runtime.session.clone()),after:None}).collect::<Vec<_>>();
+        let index=owner.sessions_by_connection.try_compound_change(&changes)?;
+        if cancellation.is_cancelled()||grant.cancellation().is_cancelled(){return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=(*deadline).min(grant.deadline()){return Err(StreamControlError::Deadline);}
+        if !current.is_current(&request,grant.attempt()){return Err(StreamControlError::Authority);}
+        Ok(PreparedHandoffGuard {owner,runtime,plan,principal,original_lifecycles,deadline:*deadline,cancellation,grant,model,post,model_committed,removed_originals,retiring_indices,_mixer:mixer,state,_registry:registry,lifecycles,conversation,session,index:Some(index)})
+    }
+}
+impl super::ManagedAudiencePublication for PreparedHandoffGuard<'_, '_, '_> {
+    fn tickets(&self)->Vec<rvoip_core_traits::peer_switch::PeerRouteTicket> {
+        // Observe changes the original outgoing role too: its existing
+        // publication deliveries join the same final drain even though only
+        // Leave retires those original route tickets.
+        self.plan.media.outgoing_connections().iter().filter_map(|id|self.state.routes.get(id).map(|route|route.publication.ticket())).collect()
+    }
+    fn quiescence_tickets(&self)->Vec<rvoip_core_traits::peer_switch::PeerRouteTicket> {self.tickets()}
+    fn model_committed(&self)->bool {*self.model_committed}
+    fn empty_post(&mut self)->super::ManagedCutPostPublication {
+        if *self.model_committed{return *self.post.take().expect("actual handoff commit retained its prebuilt post");}
+        super::ManagedCutPostPublication {cleanup:None,owner:Arc::downgrade(self.owner),
+            #[cfg(feature="vcon")] records:Vec::new(),
+            retiring:Vec::new(),events:Vec::new(),model_cleanup:None,audience:None}
+    }
+    fn check(&self,plan:&AudioAudiencePlan,routes:&rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>)->std::result::Result<(),StreamControlError> {
+        if !self.plan.media.audience().same_intent(plan){return Err(StreamControlError::Authority);}
+        if self.cancellation.is_cancelled()||self.grant.cancellation().is_cancelled(){return Err(StreamControlError::Cancelled);}
+        if tokio::time::Instant::now()>=self.deadline.min(self.grant.deadline()){return Err(StreamControlError::Deadline);}
+        let request=ParticipantHandoffScope {conversation:&self.runtime.conversation,session:&self.runtime.session,principal:self.principal,plan:self.plan};
+        let super::FinalControlGrant::Handoff {authority,current,..}=self.grant else {return Err(StreamControlError::Authority);};
+        if !current.is_current(&request,self.grant.attempt()){return Err(StreamControlError::Authority);}
+        check_handoff_authority(self.runtime,self.principal,self.plan,authority)?;
+        for ticket in self.tickets() {if !routes.is_current(&ticket){return Err(StreamControlError::NotReady);}}
+        Ok(())
+    }
+    fn commit(&mut self,routes:&mut rvoip_core_traits::peer_switch::PeerRouteGuardSet<'_>)->(super::replacement::ManagedAudienceObservation,super::ManagedCutPostPublication) {
+        let observation=self.state.controller.commit_handoff(self.model.take().expect("same one-shot prepared handoff model"));
+        *self.model_committed=true;
+        self.index.take().expect("preflighted original index guards").commit();
+        for (id,index) in &self.retiring_indices {
+            self.session.connections.remove(id);
+            self.removed_originals.push(self.state.routes.remove(id).expect("validated retiring original route"));
+            self.removed_originals.last_mut().expect("outer-owned removed route").publication.retire_held(routes);
+            let state=&mut self.lifecycles[*index];state.active=false;state.retired=true;
+            if let Some(permit)=&state.peer_admission{permit.retire_delivery();}
+            state.generation=state.generation.saturating_add(1);
+        }
+        if observation.outgoing_role.is_none(){
+            self.session.participants.remove(&observation.outgoing);
+            for pending in self.state.pending.values().filter(|pending|pending.participant==observation.outgoing){pending.cancellation.cancel();}
+        }
+        self.conversation.last_activity_at=Utc::now();
+        let post=*self.post.take().expect("actual same handoff model post");
+        (super::replacement::ManagedAudienceObservation {handoff:Some(observation),replacement:None},post)
+    }
+}
