+        let intent=MediaControlIntent::DeviceReplacement {plan:ready.plan.media().audience()};
+        assert!(witness.participant_source_is_current(&source,&descriptor,&intent,witness.binding()));
+        let mut wrong_epoch=descriptor.clone();wrong_epoch.membership_epoch+=1;
+        assert!(!witness.participant_source_is_current(&source,&wrong_epoch,&intent,witness.binding()));
+        // A second real controller with the SAME logical ID/current owner is
+        // still foreign resource identity, not a second registered model root.
+        let held=PortCommand {world:room.world.clone(),connection:ready.healthy_source.clone(),expected:0,mutation:PortMutation::Initialize,until:ready.grant.until};
