+async fn standalone_video_publisher(room:&mut ManagedRoom)->Arc<StreamController> {
+    // This is a real standalone StreamController under the same current
+    // fixture policy/session. It intentionally has NO managed SceneMember or
+    // participant-model token. That is a supported Direct publisher contract.
+    let domain=domain(&room.conversation,&room.session,"external-publisher","external");
+    let presence=crate::relationships::SessionAppearance::admit(&domain.member,room.session.clone(),None).unwrap();
+    let id=ConnectionId::from_string("actual-external-video-publisher");
+    let mut connection=crate::relationships::ConnectionBinding::prepare(&domain.member,&presence,&domain.endpoint,id.clone()).unwrap();
+    connection.observe_ready(&domain.member,&presence,&domain.endpoint,1).unwrap();connection.activate(&domain.member,&presence,&domain.endpoint).unwrap();
+    let owner=MediaOwner {actor:domain.member.clone(),member:domain.member.clone(),presence,endpoint:domain.endpoint.clone(),connection,may_control:true,may_route_source:true,send_media:BTreeSet::from([Medium::Video]),receive_media:BTreeSet::from([Medium::Video]),local:profile(),remote:profile()};
+    room.world.resources.lock().unwrap().insert(id.clone(),Resource {owner,proof:None,pending:None,probe_operation:None});
+    let held=PortCommand {world:room.world.clone(),connection:id.clone(),expected:0,mutation:PortMutation::Initialize,until:deadline()};
+    let backend=Adapter::new();
+    let controller=StreamController::with_held_control(room.conversation.clone(),room.session.clone(),id.clone(),domain.principal.clone(),room.policy.clone(),backend.clone(),Arc::new(StreamHandleAllocator::default()),4,8,CancellationToken::new(),&held).unwrap();
+    // Own it before any fallible setup, exactly like ManagedRoom.initial.
+    room.original_owners.lock().unwrap().push((controller.clone(),backend));
+    let held=PortCommand {world:room.world.clone(),connection:id,expected:0,mutation:PortMutation::Change(vec![desired(Medium::Video)]),until:deadline()};
+    controller.change_with_held(0,&[desired(Medium::Video)],&BTreeSet::new(),held.until,CancellationToken::new(),Arc::new(held)).await.unwrap();
+    controller
+}
