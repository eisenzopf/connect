+async fn captured(room:&ManagedRoom,ready:&ModelReady)->crate::orchestrator::participant_control::ManagedCutPreparationFacts {
+    let held=command(ready);
+    loop {
+        match room.orch.capture_staged_replacement_cut_facts(&ready.plan,ready.grant.until,CancellationToken::new(),&held) {
+            Ok(facts)=>return facts,
+            Err(ParticipantControlError::Media(StreamControlError::MetadataBusy))=> {
+                assert!(tokio::time::Instant::now()<ready.grant.until);
+                tokio::time::sleep_until((tokio::time::Instant::now()+Duration::from_millis(1)).min(ready.grant.until)).await;
