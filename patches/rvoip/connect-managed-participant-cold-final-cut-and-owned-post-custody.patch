+struct ModelHold {release:Option<std::sync::mpsc::Sender<()>>,joined:Option<std::thread::JoinHandle<()>>}
+impl Drop for ModelHold {fn drop(&mut self){if let Some(release)=self.release.take(){let _=release.send(());}if let Some(joined)=self.joined.take(){let _=joined.join();}}}
+fn hold_model(room:&ManagedRoom)->ModelHold {
+    let owner=room.orch.clone();let session=room.session.clone();
+    let (release,released)=std::sync::mpsc::channel();let (ready,entered)=std::sync::mpsc::channel();
+    let joined=std::thread::spawn(move ||owner.with_managed_model_metadata_for_test(&session,|| {ready.send(()).unwrap();let _=released.recv_timeout(Duration::from_secs(3));}).unwrap());
+    entered.recv_timeout(Duration::from_secs(3)).unwrap();
+    ModelHold {release:Some(release),joined:Some(joined)}
+}
+async fn publish_ready(room:&ManagedRoom,ready:&ModelReady,mut prepared:crate::orchestrator::participant_control::PreparedManagedCut)->crate::orchestrator::participant_control::ManagedCutPublished {
+    use crate::orchestrator::participant_control::ManagedCutAttempt;
+    loop {
+        let witness=ReplacementCutCurrent::capture_for(room,&ready.grant,&ready.plan,&prepared,"actual-attempt","actual-effect");
+        let authority=authority(ready);let held=command(ready);let cancel=CancellationToken::new();
+        let attempt=room.orch.try_commit_prepared_managed_cut(prepared,witness.grant(&authority,&held,&cancel));
+        drop(held);drop(authority);drop(witness);
+        match attempt {
+            ManagedCutAttempt::StillUnpublished(returned)=> {assert!(tokio::time::Instant::now()<ready.grant.until);prepared=returned.into_prepared();tokio::time::sleep_until((tokio::time::Instant::now()+Duration::from_millis(1)).min(ready.grant.until)).await;}
+            ManagedCutAttempt::Published(published)=>return published,
+            ManagedCutAttempt::Refused {error,post}|ManagedCutAttempt::EffectPossible {error,post}=> {room.orch.finish_managed_cut_publication(post).await.unwrap();panic!("final managed publication refused: {error:?}");}
+        }
+    }
+}
