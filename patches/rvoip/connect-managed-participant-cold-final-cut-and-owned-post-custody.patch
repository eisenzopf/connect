+        self.runtime.mixer.staged.clone().ok_or(ParticipantControlError::Unsupported)
+    }
+    pub(crate) fn deadline(&self) -> tokio::time::Instant {self.deadline}
+    pub(crate) fn cancellation(&self) -> &CancellationToken {&self.cancellation}
+    pub(crate) fn record(&self) -> &str {&self.plan.preparation.intent.operation_id}
+    pub(crate) fn owner(&self) -> &Arc<Orchestrator> {&self.owner}
+    pub(crate) fn try_guard<'a,'b,'c>(&'a mut self, grant:&'b super::FinalControlGrant<'c>) -> std::result::Result<PreparedReplacementGuard<'a,'b,'c>,StreamControlError> {
+        use super::managed_cut::{try_mutex,try_write,try_lifecycles};
