+impl Orchestrator {
+    pub fn capture_staged_replacement_cut_facts(self:&Arc<Self>,plan:&ManagedAudioDeviceReplacementPlan,deadline:tokio::time::Instant,cancel:CancellationToken,held:&(dyn Any+Send+Sync))->ControlResult<ManagedCutPreparationFacts> {
+        let seed=replacement::ReplacementCutSeed::capture(self,plan,deadline,cancel,held)?;
+        let scene=seed.scene()?;
+        let audience=scene.capture_audience_cut_facts(seed.audience(),seed.deadline(),seed.cancellation(),held)?;
+        // Stage exactly once, only after the complete metadata capture. No
+        // authority lease is moved into either result object.
+        let model=PreparedManagedModel::Replacement(seed.stage_once()?);
+        Ok(ManagedCutPreparationFacts {model,audience})
+    }
+    pub fn capture_staged_handoff_cut_facts(self:&Arc<Self>,session:&SessionId,principal:AuthenticatedPrincipal,plan:&ManagedAudioHandoffPlan,deadline:tokio::time::Instant,cancel:CancellationToken,held:&(dyn Any+Send+Sync))->ControlResult<ManagedCutPreparationFacts> {
+        let seed=handoff::HandoffCutSeed::capture(self,session,principal,plan,deadline,cancel,held)?;
+        let scene=seed.scene()?;
+        let audience=scene.capture_audience_cut_facts(seed.audience(),seed.deadline(),seed.cancellation(),held)?;
+        let model=PreparedManagedModel::Handoff(seed.stage_once()?);
+        Ok(ManagedCutPreparationFacts {model,audience})
+    }
+    /// Called only after the caller drops EVERY planning-read alias. Cold
+    /// transport/codec reservations retain the same model token without a
+    /// purpose Writer or a delivery pause across their awaits.
+    pub async fn prepare_staged_managed_cut(self:&Arc<Self>,facts:ManagedCutPreparationFacts)->ControlResult<PreparedManagedCut> {
+        let ManagedCutPreparationFacts {model,audience}=facts;
+        if !Arc::ptr_eq(self,model.owner()){return Err(ParticipantControlError::Authority);}
+        let scene=model.scene()?;
+        // Reserve original terminal custody BEFORE any final publication.
+        // The cold worker owns no Core/grant/resources while waiting.
+        let cleanup=self.reserve_managed_cut_cleanup()?;
+        let audience=scene.prepare_audience_cut(audience).await?;
+        Ok(PreparedManagedCut {cleanup,bound_attempt:None,model,audience})
+    }
+    /// One synchronous final turn. StillUnpublished is the only reusable
+    /// result and owns the SAME model/adoption/attempt token. All local final
+    /// controls and all Core guards drop before it can reach a caller await.
+    pub fn try_commit_prepared_managed_cut(self:&Arc<Self>,mut prepared:PreparedManagedCut,grant:FinalControlGrant<'_>)->ManagedCutAttempt {
+        let record=prepared.model.record().to_owned();
+        let identity=Arc::ptr_eq(self,prepared.model.owner());
+        let scene=prepared.model.scene();
+        let same_purpose=matches!((&prepared.model,&grant),(PreparedManagedModel::Replacement(_),FinalControlGrant::Replacement{..})|(PreparedManagedModel::Handoff(_),FinalControlGrant::Handoff{..}));
+        let precheck=if !identity||!same_purpose {Err(StreamControlError::Authority)} else if grant.cancellation().is_cancelled(){Err(StreamControlError::Cancelled)} else if tokio::time::Instant::now()>=grant.deadline(){Err(StreamControlError::Deadline)} else {prepared.bind_attempt(grant.attempt(),&record)};
+        let scene=match (precheck,scene) {
+            (Ok(()),Ok(scene))=>scene,
+            (Err(error),_)=>return ManagedCutAttempt::Refused {error:error.into(),post:ManagedCutPostPublication::refused(prepared.model,prepared.audience,prepared.cleanup)},
+            (_,Err(error))=>return ManagedCutAttempt::Refused {error,post:ManagedCutPostPublication::refused(prepared.model,prepared.audience,prepared.cleanup)},
+        };
+        if prepared.cleanup.sender.is_closed(){return ManagedCutAttempt::Refused {error:StreamControlError::CleanupUnconfirmed.into(),post:ManagedCutPostPublication::refused(prepared.model,prepared.audience,prepared.cleanup)};}
+        let turn=match std::panic::catch_unwind(std::panic::AssertUnwindSafe(||scene.begin_audience_final_turn(&prepared.audience,&grant))) {
+            Ok(Ok(turn))=>turn,
+            Ok(Err(reason)) if retryable_metadata(&reason)=>return ManagedCutAttempt::StillUnpublished(StillUnpublishedManagedCut {prepared,reason}),
+            Ok(Err(error))=>return ManagedCutAttempt::Refused {error:error.into(),post:ManagedCutPostPublication::refused(prepared.model,prepared.audience,prepared.cleanup)},
+            Err(_)=>return ManagedCutAttempt::Refused {error:StreamControlError::CleanupUnconfirmed.into(),post:ManagedCutPostPublication::refused(prepared.model,prepared.audience,prepared.cleanup)},
+        };
+        let PreparedManagedCut {cleanup,bound_attempt,mut model,audience}=prepared;
+        let attempt={
+            let model_ref=&mut model;
+            let grant_ref=&grant;
+            match std::panic::catch_unwind(std::panic::AssertUnwindSafe(move ||{let original=model_ref;original.try_guard(grant_ref)})) {
+                Ok(Ok(mut guard))=>Ok(scene.try_commit_audience_cut(audience,turn,&grant,&mut guard)),
+                Ok(Err(error))=>Err((audience,turn,error)),
+                Err(_)=>Err((audience,turn,StreamControlError::CleanupUnconfirmed)),
+            }
+        };
+        match attempt {
+            Err((audience,turn,reason))=> {
+                drop(turn);
+                if retryable_metadata(&reason) {ManagedCutAttempt::StillUnpublished(StillUnpublishedManagedCut {prepared:PreparedManagedCut {cleanup,bound_attempt,model,audience},reason})}
+                else {ManagedCutAttempt::Refused {error:reason.into(),post:ManagedCutPostPublication::refused(model,audience,cleanup)}}
+            }
+            Ok(crate::staged_streams::audience::AudienceCutAttempt::StillUnpublished {prepared:audience,reason})=>ManagedCutAttempt::StillUnpublished(StillUnpublishedManagedCut {prepared:PreparedManagedCut {cleanup,bound_attempt,model,audience},reason}),
+            Ok(crate::staged_streams::audience::AudienceCutAttempt::Published {outcome,handle,mut post})=> {
+                // Only grant-free result metadata is mapped here. Any resource
+                // retirement/F cleanup remains in the linear post obligation.
+                let published=match &model {
+                    PreparedManagedModel::Replacement(value)=>value.map_published(outcome,handle),
+                    PreparedManagedModel::Handoff(value)=>value.map_published(outcome,handle),
+                };
+                post.model_cleanup=Some(model);post.cleanup=Some(cleanup);
+                match published {
+                    ManagedPublishedValue::Replacement(outcome,handle)=>ManagedCutAttempt::Published(ManagedCutPublished::Replacement {outcome,handle,post}),
+                    ManagedPublishedValue::Handoff(outcome,handle)=>ManagedCutAttempt::Published(ManagedCutPublished::Handoff {outcome,handle,post}),
+                }
+            }
+            Ok(crate::staged_streams::audience::AudienceCutAttempt::Refused {error,mut post})=> {post.model_cleanup=Some(model);post.cleanup=Some(cleanup);ManagedCutAttempt::Refused {error:error.into(),post}},
+            Ok(crate::staged_streams::audience::AudienceCutAttempt::EffectPossible {error,mut post})=> {post.model_cleanup=Some(model);post.cleanup=Some(cleanup);ManagedCutAttempt::EffectPossible {error:error.into(),post}},
+        }
+    }
+}
