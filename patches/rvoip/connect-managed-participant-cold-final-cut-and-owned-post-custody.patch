+pub struct ManagedCutPostCompletion {completion:tokio::sync::oneshot::Receiver<ControlResult<()>>}
+impl ManagedCutPostCompletion {
+    pub async fn wait(self)->std::result::Result<(),ManagedCutPostFinishError> {
+        match self.completion.await {
+            Ok(Ok(()))=>Ok(()),
+            Ok(Err(error))=>Err(ManagedCutPostFinishError::AcceptedUnconfirmed {error}),
+            Err(_)=>Err(ManagedCutPostFinishError::AcceptedUnconfirmed {error:RvoipError::InvalidState("accepted managed cleanup lost completion").into()}),
+        }
