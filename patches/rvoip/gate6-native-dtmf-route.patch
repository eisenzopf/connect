+#[tokio::test]
+async fn actual_signed_native_dtmf_reaches_negotiated_rfc4733_without_info_fallback() {
+    for kind in ["quic", "wt"] {
+        let mut r = RouteRig::new(kind).await;
+        let o = r.observation("12#", 60, "rfc4733").await;
+        let p = SignalPolicy::new(&r, &o);
+        let job = r.start(&o, p.clone());
+        let mut seen = BTreeSet::new();
+        let mut ends = BTreeMap::<u8, usize>::new();
+        timeout(Duration::from_secs(3), async {
+            loop {
+                let mut b = [0; 2048];
+                let n = r.peer.media.recv(&mut b).await.unwrap();
+                if n >= 16 && b[1] & 127 == 101 {
+                    seen.insert(b[12]);
+                    if b[13] & 128 != 0 {
+                        *ends.entry(b[12]).or_default() += 1;
+                    }
+                    if ends.get(&11).copied().unwrap_or(0) >= 3 {
+                        break;
+                    }
+                }
+            }
+        })
+        .await
+        .expect("real negotiated RTP telephone-event sequence");
+        assert_eq!(job.await.unwrap(), Ok(()));
+        assert_eq!(seen, BTreeSet::from([1, 2, 11]));
+        assert!(ends.values().all(|n| *n >= 3));
+        r.peer.no_info(Duration::from_millis(80)).await;
+        assert!(p.calls.load(Ordering::Acquire) >= 9);
+        r.stop().await;
+    }
+}
