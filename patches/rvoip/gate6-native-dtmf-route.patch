+#[tokio::test]
+async fn source_metadata_hint_without_a_physical_poll_fence_cannot_authorize_signal_io() {
+    struct HintOnly;
+    impl rvoip_core::dtmf::DtmfSourceFence for HintOnly {
+        fn current(&self) -> bool {
+            true
+        }
+    }
+    let r = Rig::new().await;
+    let route = r
+        .route("1", 60, DtmfMethod::Rfc4733)
+        .with_source_fence(Arc::new(HintOnly))
+        .unwrap();
+    let policy = Policy::new(&r);
+    assert_eq!(
+        r.core
+            .route_dtmf(
+                &route,
+                policy.clone(),
+                CancellationToken::new(),
+                Instant::now() + Duration::from_secs(1)
+            )
+            .await,
+        Err(DtmfWriteError::Refused),
+        "a metadata-only source hint admitted actual RTP writes without a physical source fence"
+    );
+    r.no_packet().await;
+    assert_eq!(policy.calls.load(Ordering::SeqCst), 0);
+}
+
+// This fixture owns a controlled adapter source, not a real native ingress.
+// Hold its exact stream-map entry through a bounded physical poll; actual
+// signed native stream/credential/flow custody is qualified in rvoip-uctp.
+struct ControlledSource {
+    adapter: Arc<RecordingAdapter>,
+    connection: ConnectionId,
+    stream: Arc<StreamHandle>,
+}
+impl DtmfSourceFence for ControlledSource {
+    fn current(&self) -> bool {
+        self.adapter
+            .streams
+            .get(&self.connection)
+            .is_some_and(|v| Arc::ptr_eq(v.value(), &self.stream))
+    }
+    fn poll(
+        &self,
+        io: &mut dyn FnMut() -> rvoip_core::dtmf::DtmfIoPoll,
+    ) -> rvoip_core::dtmf::DtmfIoPoll {
+        use dashmap::try_result::TryResult;
+        use std::task::Poll;
+        match self.adapter.streams.try_get(&self.connection) {
+            TryResult::Present(v) if Arc::ptr_eq(v.value(), &self.stream) => io(),
+            TryResult::Locked => Poll::Ready(Err(DtmfWriteError::NotReady)),
+            _ => Poll::Ready(Err(DtmfWriteError::Refused)),
+        }
+    }
+}
