+    assert_eq!(job.await.unwrap(), Err(DtmfWriteError::Refused));
+    r.peer.no_info(Duration::from_millis(150)).await;
+    r.peer.no_rtp_tone().await;
+    r.stop().await;
+}
+#[tokio::test]
+async fn native_source_pending_poll_releases_controller_credential_and_port_metadata_custody() {
+    let mut r = RouteRig::new("quic").await;
+    let o = r.observation("1", 100, "info").await;
+    let c = r.scene.controller();
+    let mut calls = 0;
+    assert!(matches!(
+        c.poll_dtmf_source_io(
+            o.principal(),
+            o.stream_revision(),
+            o.credential_revision(),
+            o.audio_bindings(),
+            &mut || {
+                calls += 1;
+                std::task::Poll::Pending
+            }
+        ),
+        std::task::Poll::Pending
+    ));
+    assert_eq!(calls, 1);
+    assert_eq!(c.revision(), o.stream_revision());
+    assert_eq!(c.credential_revision(), o.credential_revision());
+    assert!(!c.active_bindings().is_empty());
+    c.retire();
+    assert_eq!(
+        c.poll_dtmf_source_io(
+            o.principal(),
+            o.stream_revision(),
+            o.credential_revision(),
+            o.audio_bindings(),
+            &mut || { panic!("retired source reached IO") }
+        ),
+        std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+    );
+    r.stop().await;
+}
+#[tokio::test]
+async fn actual_native_physical_peer_close_stops_info_suffix_under_original_operation() {
+    let mut r = RouteRig::new("wt").await;
+    let o = r.observation("12", 500, "info").await;
+    let p = SignalPolicy::new(&r, &o);
+    let job = r.start(&o, p);
+    r.peer.next().await;
+    r.scene.wire.server.shutdown().await.unwrap();
+    assert_eq!(job.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown));
+    r.peer.no_info(Duration::from_millis(100)).await;
+    r.stop().await;
+}
