@@ -0,0 +1,70 @@
+//! Exact source metadata custody for a synchronous signal IO poll. This
+//! supplies no signal or media permission; the host must own that separately.
+use super::*;
+use rvoip_media_core::dtmf_authority::{DtmfIoPoll, DtmfWriteError};
+use std::task::Poll;
+impl StreamController {
+    /// Serialize a bounded signal IO poll with this controller's stream,
+    /// credential and physical audio-port retirement/rebind commits. No guard
+    /// survives Pending; `io` must not reenter this controller or Core.
+    pub fn poll_dtmf_source_io(
+        &self,
+        principal: &AuthenticatedPrincipal,
+        revision: u64,
+        credential_revision: u64,
+        audio: &[ReadyMediaBinding],
+        io: &mut dyn FnMut() -> DtmfIoPoll,
+    ) -> DtmfIoPoll {
+        let refuse = || Poll::Ready(Err(DtmfWriteError::Refused));
+        let Ok(state) = self.state.try_lock() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        let Ok(credential) = self.credential.try_lock() else {
+            return Poll::Ready(Err(DtmfWriteError::NotReady));
+        };
+        if self.shutdown.is_cancelled()
+            || state.closed
+            || state.model.revision() != revision
+            || credential.revision != credential_revision
+            || !reliable_data::same_credential(&credential.principal, principal)
+            || audio.is_empty()
+            || audio.len() > 64
+        {
+            return refuse();
+        }
+        let mut guards = Vec::with_capacity(audio.len());
+        let mut keys = BTreeSet::new();
+        for expected in audio {
+            if expected.negotiated.requested.medium != Medium::Audio
+                || !keys.insert(&expected.negotiated.requested.logical_id)
+            {
+                return refuse();
+            }
+            let Some(port) = state.active.get(&expected.negotiated.requested.logical_id) else {
+                return refuse();
+            };
+            let actual = &port.binding;
+            if actual.negotiated != expected.negotiated
+                || actual.transport_id != expected.transport_id
+                || actual.stream_local_id != expected.stream_local_id
+                || actual.generation != expected.generation
+                || actual.connection_generation != expected.connection_generation
+                || (expected.source_ready && !actual.source_ready)
+                || (expected.sink_ready && !actual.sink_ready)
+            {
+                return refuse();
+            }
+            let Ok(guard) = port.state.try_lock() else {
+                return Poll::Ready(Err(DtmfWriteError::NotReady));
+            };
+            if guard.status != PortStatus::Active {
+                return refuse();
+            }
+            guards.push(guard);
+        }
+        if self.shutdown.is_cancelled() {
+            return refuse();
+        }
+        io()
+    }
+}
