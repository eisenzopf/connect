+struct PauseWrite {
+    release: AtomicBool,
+    entered: tokio::sync::Notify,
+}
+impl DtmfIoFence for PauseWrite {
+    fn poll(&self, io: &mut dyn FnMut() -> DtmfIoPoll) -> DtmfIoPoll {
+        if !self.release.load(Ordering::Acquire) {
+            self.entered.notify_one();
+            std::task::Poll::Pending
+        } else {
+            io()
+        }
+    }
+}
+#[tokio::test]
+async fn native_source_retirement_after_signal_grant_but_before_socket_poll_prevents_all_effects() {
+    let mut r = RouteRig::new("quic").await;
+    let o = r.observation("1", 100, "info").await;
+    let p = SignalPolicy::new(&r, &o);
+    let pause = Arc::new(PauseWrite {
+        release: AtomicBool::new(false),
+        entered: tokio::sync::Notify::new(),
+    });
+    *p.pause.lock().unwrap() = Some(pause.clone());
+    let job = r.start(&o, p.clone());
+    timeout(Duration::from_secs(1), pause.entered.notified())
+        .await
+        .expect("actual owned IO reached after fresh permission");
+    assert_eq!(p.calls.load(Ordering::Acquire), 1);
+    r.scene.controller().retire();
