+            .unwrap(),
+        )
+        .unwrap();
+    assert_eq!(
+        core.route_dtmf(
+            &route,
+            p.clone(),
+            CancellationToken::new(),
+            Instant::now() + Duration::from_secs(1)
+        )
+        .await,
+        Err(DtmfWriteError::Refused)
+    );
+    assert_eq!(p.calls.load(Ordering::Acquire), 0);
+    r.peer.no_info(Duration::from_millis(100)).await;
+    r.stop().await;
+}
