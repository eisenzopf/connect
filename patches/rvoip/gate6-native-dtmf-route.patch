+struct RouteRig {
+    scene: Scene,
+    peer: Peer,
+    coordinator: Arc<UnifiedCoordinator>,
+    adapter: Arc<SipAdapter>,
+    target: ConnectionId,
+    target_session: SessionId,
+    target_participant: ParticipantId,
+}
+impl RouteRig {
+    async fn new(kind: &str) -> Self {
+        let mut scene = Scene::new_gateway(kind).await;
+        let (_, callback) = scene
+            .prepared(lifecycle_offer(&scene, 0, 0, "sendonly"))
+            .await;
+        scene.confirm(&callback).await;
+        core_fixture::until(|| {
+            scene
+                .native
+                .core
+                .orch
+                .session(&scene.native.core.session)
+                .unwrap()
+                .read()
+                .unwrap()
+                .connections
+                .contains_key(&scene.id)
+        })
+        .await;
+        let peer = Peer::new().await;
+        let coordinator = UnifiedCoordinator::new(Config::local("native-signal-fixture", 0))
+            .await
+            .unwrap();
+        let adapter = SipAdapter::new(coordinator.clone()).await.unwrap();
+        let core = &scene.native.core.orch;
+        core.register(adapter.clone()).unwrap();
+        // Keep the native managed admission and SIP outbound call in explicit
+        // separate Sessions of the same Conversation. General unmanaged
+        // origination cannot bypass checked Participant admission in a managed
+        // Session; the signal policy binds both exact Session/Participant IDs.
+        let target_session = core
+            .start_session(
+                scene.native.core.conversation.clone(),
+                rvoip_core::session::SessionMedium::Voice,
+                vec![],
+            )
+            .await
+            .unwrap();
+        let target_participant = ParticipantId::new();
+        let mut events = core.subscribe_events();
+        let target = core
+            .originate_connection(
+                OriginateRequest::new(
+                    target_session.clone(),
+                    target_participant.clone(),
+                    format!("sip:peer@{}", peer.address()),
+                    Direction::Outbound,
+                    rvoip_core::capability::CapabilityDescriptor::default(),
+                )
+                .with_transport(Transport::Sip),
+            )
+            .await
+            .unwrap()
+            .connection
+            .id;
+        timeout(Duration::from_secs(5), async {
+            loop {
+                if let rvoip_core::events::Event::ConnectionConnected { connection_id, .. } =
+                    events.recv().await.unwrap()
+                {
+                    if connection_id == target {
+                        break;
+                    }
+                }
+            }
+        })
+        .await
+        .expect("actual SIP final answer");
+        timeout(Duration::from_secs(2), peer.ack.notified())
+            .await
+            .expect("actual INVITE ACK");
+        {
+            let mut state = scene.grants.0.write().await;
+            state.dtmf_allowed.insert(scene.id.clone());
+            state
+                .dtmf_forward_allowed
+                .insert((scene.id.clone(), target.clone()));
+        }
+        Self {
+            scene,
+            peer,
+            coordinator,
+            adapter,
+            target,
+            target_session,
+            target_participant,
+        }
+    }
+    async fn observation(
+        &mut self,
+        digits: &str,
+        duration: u32,
+        method: &str,
+    ) -> NativeDtmfObservation {
+        let mut v = envelope(
+            "dtmf.send",
+            json!({"digits":digits,"duration_ms":duration,"method":method,"source":"sip-info"}),
+        );
+        v["cid"] = json!("conversation");
+        v["sid"] = json!("session");
+        v["connid"] = json!("native_0");
+        v["operation_id"] = json!(format!("native_route_{}", uuid::Uuid::new_v4().simple()));
+        let op = v["operation_id"].as_str().unwrap().to_owned();
+        self.scene.wire.send(self.scene.f.sign(v)).await;
+        let reply = self.scene.wire.read().await;
+        assert_eq!(reply.kind(), "ack", "actual signed native DTMF ingress");
+        self.scene.f.verify_server(&reply).await;
+        // The prior invocation and its store readers must be gone before scheduling.
+        drop(
+            timeout(Duration::from_secs(1), self.scene.grants.0.write())
+                .await
+                .expect("no retained source invocation reader"),
+        );
+        drop(
+            timeout(
+                Duration::from_secs(1),
+                self.scene.wire_policy.grants.write(),
+            )
+            .await
+            .expect("no retained wire invocation reader"),
+        );
+        let observation = self.scene.record.dtmf_seen.lock().unwrap()
+            [&format!("{}/{}", self.scene.id, op)]
+            .clone();
+        assert_eq!(observation.operation_id(), op);
+        assert_eq!(observation.source(), "uctp-native");
+        assert_eq!(observation.signing_key_id(), "client");
+        assert_eq!(
+            observation.signing_algorithm(),
+            rvoip_uctp::v2::payloads::SignatureAlg::EdDSA
+        );
+        observation
+    }
+    fn start(
+        &self,
+        o: &NativeDtmfObservation,
+        p: Arc<dyn DtmfRoutePolicy>,
+    ) -> tokio::task::JoinHandle<Result<(), DtmfWriteError>> {
+        let core = self.scene.native.core.orch.clone();
+        let route = o
+            .prepare_core_route(&core, self.target.clone())
+            .expect("sealed actual native source binds to published Core metadata");
+        assert_eq!(route.source().connection(), o.connection());
+        assert_eq!(route.source().transport(), self.scene.kind);
+        tokio::spawn(async move {
+            core.route_dtmf(
+                &route,
+                p,
+                CancellationToken::new(),
+                Instant::now() + Duration::from_secs(3),
+            )
+            .await
+        })
+    }
+    async fn stop(self) {
+        let _ = self
+            .scene
+            .native
+            .core
+            .orch
+            .end_connection(self.target.clone(), EndReason::Normal)
+            .await;
+        self.scene.wire.server.shutdown().await.unwrap();
+        self.scene
+            .native
+            .core
+            .orch
+            .drain_connection_lifecycle_tasks()
+            .await;
+        self.adapter.drain().await.unwrap();
+        self.coordinator
+            .shutdown_gracefully(Some(Duration::from_secs(1)))
+            .await
+            .unwrap();
+        self.peer.task.abort();
+    }
+}
+struct SignalPolicy {
+    source: NativeDtmfObservation,
+    target: ConnectionId,
+    target_session: SessionId,
+    target_participant: ParticipantId,
+    domain: Arc<Grants>,
+    wire: Arc<WirePolicy>,
+    target_allowed: Arc<RwLock<bool>>,
+    calls: AtomicUsize,
+    pause: Mutex<Option<Arc<PauseWrite>>>,
+}
+impl SignalPolicy {
+    fn new(r: &RouteRig, o: &NativeDtmfObservation) -> Arc<Self> {
+        Arc::new(Self {
+            source: o.clone(),
+            target: r.target.clone(),
+            target_session: r.target_session.clone(),
+            target_participant: r.target_participant.clone(),
+            domain: r.scene.grants.clone(),
+            wire: r.scene.wire_policy.clone(),
+            target_allowed: Arc::new(RwLock::new(true)),
+            calls: AtomicUsize::new(0),
+            pause: Mutex::new(None),
+        })
+    }
+    async fn lease(&self, s: &DtmfRouteScope<'_>) -> Result<DtmfWriteLease, DtmfWriteError> {
+        let refuse = || DtmfWriteError::Refused;
+        let wire = self.wire.grants.clone().read_owned().await;
+        let source = self.domain.0.clone().read_owned().await;
+        let target = self.target_allowed.clone().read_owned().await;
+        let o = &self.source;
+        let owner = source.owners.get(o.connection()).ok_or_else(refuse)?;
+        let owner = credential_owner(owner.clone(), o.principal()).map_err(|_| refuse())?;
+        owner
+            .member
+            .revalidate_principal(o.principal(), Utc::now())
+            .map_err(|_| refuse())?;
+        if source.denied
+            || wire.denied
+            || source.key.revoked
+            || source.key.algorithm != "EdDSA"
+            || o.signing_key_id() != "client"
+            || !*target
+            || !source.dtmf_allowed.contains(o.connection())
+            || !source
+                .dtmf_forward_allowed
+                .contains(&(o.connection().clone(), self.target.clone()))
+            || wire.connections.get("native_0") != Some(o.connection())
+            || wire.member.identity() != o.identity()
+            || owner.member.conversation() != o.conversation()
+            || owner.member.participant() != o.participant()
+            || owner.member.identity() != o.identity()
+            || owner.member.epoch() != o.membership_epoch()
+            || owner.endpoint.endpoint() != o.endpoint()
+            || owner.endpoint.device() != o.device()
+            || owner.presence.session() != o.session()
+            || s.source.connection() != o.connection()
+            || s.source.conversation() != o.conversation()
+            || s.source.session() != o.session()
+            || s.source.participant() != o.participant()
+            || s.source.transport() != o.transport()
+            || s.recipient.connection() != &self.target
+            || s.recipient.session() != &self.target_session
+            || s.recipient.participant() != &self.target_participant
+            || s.recipient.transport() != Transport::Sip
+            || s.source.tenant() != s.recipient.tenant()
+            || s.source.conversation() != s.recipient.conversation()
+            || s.intent.operation_id() != o.operation_id()
+            || s.intent.digits() != o.digits()
+            || s.intent.duration_ms() != o.duration_ms()
+        {
+            return Err(refuse());
+        }
+        self.calls.fetch_add(1, Ordering::AcqRel);
+        let lease = DtmfWriteLease::new(
+            (wire, source, target),
+            Instant::now() + Duration::from_millis(200),
+            || true,
+        );
+        match self.pause.lock().unwrap().clone() {
+            Some(pause) => lease.with_fence(pause),
+            None => Ok(lease),
+        }
+    }
+}
+#[async_trait]
+impl DtmfRoutePolicy for SignalPolicy {
+    async fn acquire(
+        &self,
+        s: &DtmfRouteScope<'_>,
+        p: &DtmfWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        assert_eq!(s.intent.method(), DtmfMethod::Rfc4733);
+        assert_eq!(
+            self.source.method(),
+            rvoip_uctp::v2::native_dtmf::NativeDtmfMethod::Rfc4733
+        );
+        assert_eq!(p.digits, self.source.digits());
+        assert_eq!(p.duration_ms, self.source.duration_ms());
+        assert_eq!(p.payload_type, 101);
+        assert_eq!(p.clock_rate_hz, 8000);
+        self.lease(s).await
+    }
+    async fn acquire_info(
+        &self,
+        s: &DtmfRouteScope<'_>,
+        p: &DtmfInfoWriteScope<'_>,
+    ) -> Result<DtmfWriteLease, DtmfWriteError> {
+        assert_eq!(s.intent.method(), DtmfMethod::Info);
+        assert_eq!(
+            self.source.method(),
+            rvoip_uctp::v2::native_dtmf::NativeDtmfMethod::Info
+        );
+        assert_eq!(p.digits, self.source.digits());
+        assert_eq!(p.duration_ms, self.source.duration_ms());
+        let Message::Request(request) = parse_message(p.wire_request).unwrap() else {
+            panic!("INFO request")
+        };
+        assert_eq!(request.method(), Method::Info);
+        assert_eq!(
+            request.body(),
+            format!(
+                "Signal={}\r\nDuration={}\r\n",
+                p.digits.as_bytes()[p.digit_index] as char,
+                p.duration_ms
+            )
+            .as_bytes()
+        );
+        self.lease(s).await
+    }
+}
