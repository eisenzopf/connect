+            return Err(DispatchError::Authority);
+        }
+        let cancellation = self.invocation.child_token();
+        let current = cancellation.clone();
+        let resource = ResourcePreparation {
+            kind: PreparationKind::ReplacementReady,
+            marker: Arc::new(()),
+            original: self.envelope.clone(),
+            participant: String::new(),
+            streams: BTreeSet::new(),
+            cancellation,
+            deadline,
+        };
+        let mut reply = resource.clone();
+        reply.cancellation = self.origin.lifetime.child_token();
