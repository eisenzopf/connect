+    /// It grants no parameter exchange, media, ACK or application result.
+    pub fn into_replacement_ready_wait(
+        mut self,
+        requested: Option<Instant>,
+    ) -> Result<(Self, Instant), DispatchError> {
+        let exact = self.replacement_ready_binding();
+        let deadline = self.resource_preparation_cutoff(requested.unwrap_or(self.origin.deadline));
+        if exact {
+            // Refused/expired conversion also releases the shared reply alias.
+            // The consumed original application lease drops on every error.
+            let cancellation = self.origin.lifetime.child_token();
+            let current = cancellation.clone();
+            let reply = ResourcePreparation {
+                kind: PreparationKind::ReplacementReady,
+                marker: Arc::new(()),
+                original: self.envelope.clone(),
+                participant: String::new(),
+                streams: BTreeSet::new(),
+                cancellation,
+                deadline,
+            };
+            self.reply_authority.note_resource_preparation();
+            self.reply_authority
+                .replace(AuthorityLease::checking(reply, deadline, move || {
+                    !current.is_cancelled()
+                }));
+        }
