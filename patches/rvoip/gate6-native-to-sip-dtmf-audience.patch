+// Explicit SIP controller fixtures; these are scene/IO-callback boundaries,
+// never actual SIP packets, independent signal permission or socket evidence.
+async fn add_sip_dtmf_node(room: &mut Room, name: &str, alias: Option<&str>, private: bool) {
+    let subject = alias.unwrap_or(name);
+    let mut o = owner(subject);
+    let identity = IdentityBinding::from_authenticated(
+        &principal(subject),
+        o.member.identity().clone(),
+        chrono::Utc::now(),
+    )
+    .unwrap();
+    let mut endpoint = EndpointBinding::provision(
+        identity.clone(),
+        EndpointId::from_string(format!("sip-endpoint-{name}")),
+        DeviceId::from_string(format!("sip-device-{name}")),
+        Transport::Sip,
+        format!("sip:{name}@fixture"),
+    )
+    .unwrap();
+    endpoint
+        .verify(
+            &identity,
+            "controlled-sip-evidence".into(),
+            chrono::Utc::now(),
+        )
+        .unwrap();
+    let mut connection = ConnectionBinding::prepare(
+        &o.member,
+        &o.presence,
+        &endpoint,
+        ConnectionId::from_string(name),
+    )
+    .unwrap();
+    connection
+        .observe_ready(&o.member, &o.presence, &endpoint, 1)
+        .unwrap();
+    connection
+        .activate(&o.member, &o.presence, &endpoint)
+        .unwrap();
+    o.endpoint = endpoint;
+    o.connection = connection;
+    room.add_owned(name, subject, o, private, None).await;
+}
+fn original_dtmf_scene(
+    room: &Room,
+    source: &Arc<StreamController>,
+) -> super::super::capability_disclosure::SceneCapabilityDisclosure {
+    let credential = source.credential_snapshot();
+    room.scene
+        .commit_capability_declaration(
+            &source.connection,
+            source,
+            &credential.principal,
+            source.revision(),
+            || (),
+        )
+        .unwrap()
+        .1
+}
+#[tokio::test]
+async fn sip_dtmf_audience_owns_actual_target_credential_inside_native_source_io() {
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "phone", None, false).await;
+    let alice = room.nodes["alice"].controller.clone();
+    let phone = room.nodes["phone"].controller.clone();
+    let source = native_dtmf_recipient(&alice);
+    let disclosure = original_dtmf_scene(&room, &alice);
+    let audience = room
+        .scene
+        .sip_dtmf_audience(
+            &disclosure,
+            &phone.connection,
+            &phone,
+            &phone.credential_snapshot().principal,
+        )
+        .unwrap();
+    let calls = AtomicUsize::new(0);
+    let mut effect = || {
+        assert!(alice.state.try_lock().is_err());
+        assert!(alice.credential.try_lock().is_err());
+        assert!(phone.state.try_lock().is_err());
+        assert!(phone.credential.try_lock().is_err());
+        assert!(room.scene.members.try_lock().is_err());
+        assert!(room.scene.audiences.try_lock().is_err());
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    let result = alice.poll_dtmf_source_io(
+        &source.principal,
+        source.stream_revision,
+        source.credential_revision,
+        &source.audio_bindings,
+        &mut || audience.poll(&mut effect),
+    );
+    assert_eq!(result, std::task::Poll::Ready(Ok(())));
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(alice.state.try_lock().is_ok());
+    assert!(alice.credential.try_lock().is_ok());
+    assert!(phone.state.try_lock().is_ok());
+    assert!(phone.credential.try_lock().is_ok());
+}
+#[tokio::test]
+async fn sip_dtmf_audience_pending_releases_source_target_and_registry_guards() {
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "phone", None, false).await;
+    let alice = room.nodes["alice"].controller.clone();
+    let phone = room.nodes["phone"].controller.clone();
+    let source = native_dtmf_recipient(&alice);
+    let disclosure = original_dtmf_scene(&room, &alice);
+    let audience = room
+        .scene
+        .sip_dtmf_audience(
+            &disclosure,
+            &phone.connection,
+            &phone,
+            &phone.credential_snapshot().principal,
+        )
+        .unwrap();
+    let calls = AtomicUsize::new(0);
+    let mut effect = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    let mut poll = || {
+        alice.poll_dtmf_source_io(
+            &source.principal,
+            source.stream_revision,
+            source.credential_revision,
+            &source.audio_bindings,
+            &mut || audience.poll(&mut effect),
+        )
+    };
+    let held = phone.credential.lock().unwrap();
+    assert_eq!(poll(), std::task::Poll::Pending);
+    assert!(alice.state.try_lock().is_ok());
+    assert!(alice.credential.try_lock().is_ok());
+    assert!(phone.state.try_lock().is_ok());
+    drop(held);
+    let held = room.scene.audiences.lock().unwrap();
+    assert_eq!(poll(), std::task::Poll::Pending);
+    assert!(alice.state.try_lock().is_ok());
+    assert!(alice.credential.try_lock().is_ok());
+    assert!(phone.state.try_lock().is_ok());
+    assert!(phone.credential.try_lock().is_ok());
+    assert!(room.scene.members.try_lock().is_ok());
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    drop(held);
+    assert_eq!(poll(), std::task::Poll::Ready(Ok(())));
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+}
+#[tokio::test]
+async fn sip_dtmf_audience_refuses_rebound_or_retired_actual_target_before_io() {
+    use crate::dtmf::*;
+    for retired in [false, true] {
+        let mut room = Room::new().await;
+        add_sip_dtmf_node(&mut room, "phone", None, false).await;
+        let alice = room.nodes["alice"].controller.clone();
+        let phone = room.nodes["phone"].controller.clone();
+        let disclosure = original_dtmf_scene(&room, &alice);
+        let audience = room
+            .scene
+            .sip_dtmf_audience(
+                &disclosure,
+                &phone.connection,
+                &phone,
+                &phone.credential_snapshot().principal,
+            )
+            .unwrap();
+        if retired {
+            phone.retire();
+        } else {
+            phone.credential.lock().unwrap().revision += 1;
+        }
+        let calls = AtomicUsize::new(0);
+        let mut effect = || {
+            calls.fetch_add(1, Ordering::SeqCst);
+            std::task::Poll::Ready(Ok(()))
+        };
+        assert_eq!(
+            audience.poll(&mut effect),
+            std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+        );
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+    }
+}
