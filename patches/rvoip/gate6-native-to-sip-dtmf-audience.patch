+#[tokio::test]
+async fn sip_dtmf_original_and_current_audiences_survive_private_return_without_leaks() {
+    use crate::dtmf::*;
+    let mut room = Room::new().await;
+    add_sip_dtmf_node(&mut room, "phone", Some("bob"), false).await;
+    let alice = room.nodes["alice"].controller.clone();
+    let phone = room.nodes["phone"].controller.clone();
+    let public_source = original_dtmf_scene(&room, &alice);
+    let public_to_phone = room
+        .scene
+        .sip_dtmf_audience(
+            &public_source,
+            &phone.connection,
+            &phone,
+            &phone.credential_snapshot().principal,
+        )
+        .unwrap();
+    let calls = AtomicUsize::new(0);
+    let mut effect = || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        std::task::Poll::Ready(Ok(()))
+    };
+    assert_eq!(
+        public_to_phone.poll(&mut effect),
+        std::task::Poll::Ready(Ok(()))
+    );
+    add_sip_dtmf_node(&mut room, "consult", Some("public"), true).await;
+    let consult = room.nodes["consult"].controller.clone();
+    let (_, handle) = room.apply(room.begin_plan()).await.unwrap();
+    let private_source = original_dtmf_scene(&room, &alice);
+    let private_to_phone = room
+        .scene
+        .sip_dtmf_audience(
+            &private_source,
+            &phone.connection,
+            &phone,
+            &phone.credential_snapshot().principal,
+        )
+        .unwrap();
+    let private_to_consult = room
+        .scene
+        .sip_dtmf_audience(
+            &private_source,
+            &consult.connection,
+            &consult,
+            &consult.credential_snapshot().principal,
+        )
+        .unwrap();
+    assert_eq!(
+        private_to_consult.poll(&mut effect),
+        std::task::Poll::Ready(Ok(()))
+    );
+    for audience in [&public_to_phone, &private_to_phone] {
+        assert_eq!(
+            audience.poll(&mut effect),
+            std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+        );
+    }
+    let restore = room
+        .scene
+        .plan_restore_audio_audience(
+            &handle,
+            "sip-dtmf-return".into(),
+            room.scene.audience_revision(),
+        )
+        .unwrap();
+    room.apply(restore).await.unwrap();
+    assert_eq!(
+        public_to_phone.poll(&mut effect),
+        std::task::Poll::Ready(Ok(()))
+    );
+    for audience in [&private_to_phone, &private_to_consult] {
+        assert_eq!(
+            audience.poll(&mut effect),
+            std::task::Poll::Ready(Err(DtmfWriteError::Refused))
+        );
+    }
+    assert_eq!(calls.load(Ordering::SeqCst), 3);
+}
