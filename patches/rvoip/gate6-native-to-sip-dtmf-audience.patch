+    /// Bind the actual managed SIP recipient controller/principal to this
+    /// original native source audience. No native descriptor is manufactured.
+    /// The returned fence owns the SIP controller credential during each IO
+    /// poll; actual Core source/recipient route/dialog fences and fresh host
+    /// signal permission must additionally surround that poll. This captures
+    /// metadata only and must run outside physical IO/engine locks.
+    pub fn native_sip_dtmf_audience_fence(
+        &self,
+        disclosure: &NativeDtmfDisclosure,
+        recipient: &ConnectionId,
+        controller: &Arc<StreamController>,
+        principal: &AuthenticatedPrincipal,
+    ) -> ControlResult<Arc<dyn crate::dtmf::DtmfIoFence>> {
+        let source = &disclosure.0;
+        if source.source == *recipient {
+            return Err(ParticipantControlError::Authority);
+        }
+        let runtime = self.participant_runtime(&source.session)?;
+        if !Weak::ptr_eq(&source.runtime, &Arc::downgrade(&runtime)) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let state = runtime.state.try_lock().map_err(|_| busy())?;
+        if state.ended {
+            return Err(ParticipantControlError::Authority);
+        }
+        let origin = state
+            .routes
+            .get(&source.source)
+            .ok_or(ParticipantControlError::Authority)?;
+        let target = state
+            .routes
+            .get(recipient)
+            .ok_or(ParticipantControlError::Authority)?;
+        if !source.life.matches(&origin.lifecycle) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let tickets = if source.source < *recipient {
+            [&origin.lifecycle, &target.lifecycle]
+        } else {
+            [&target.lifecycle, &origin.lifecycle]
+        };
+        let lives = tickets
+            .iter()
+            .map(|t| t.state.try_lock().map_err(|_| busy()))
+            .collect::<ControlResult<Vec<_>>>()?;
+        if tickets.iter().zip(&lives).any(|(t, l)| !live(t, l)) {
+            return Err(ParticipantControlError::Authority);
+        }
+        let scene = runtime
+            .mixer
+            .staged
+            .as_ref()
+            .ok_or(ParticipantControlError::Unsupported)?;
+        Ok(Arc::new(DtmfAudienceFence(scene.sip_dtmf_audience(
+            &source.scene,
+            recipient,
+            controller,
+            principal,
+        )?)))
+    }
+}
