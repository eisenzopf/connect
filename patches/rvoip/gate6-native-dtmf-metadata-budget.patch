+    struct DelayedPolicy(Arc<Policy>);
+    #[async_trait::async_trait]
+    impl DtmfNativeWriteAuthority for DelayedPolicy {
+        async fn acquire_native(
+            &self,
+            scope: &DtmfNativeWriteScope<'_>,
+        ) -> Result<DtmfWriteLease, DtmfWriteError> {
+            tokio::time::sleep(Duration::from_millis(300)).await;
+            self.0.acquire_native(scope).await
+        }
+    }
+    #[tokio::test]
+    async fn native_metadata_wait_preserves_short_physical_budget_and_holds_no_permission() {
+        for stall in [false, true] {
+            let p = policy();
+            let (mut writer, polls, dropped) = sink(&p, stall);
+            let (frame, mut pending, receipt) = test_pending(
+                p.clone(),
+                Arc::new(AtomicBool::new(true)),
+                CancellationToken::new(),
+            );
+            pending.policy = Arc::new(DelayedPolicy(p.clone()));
+            let physical = CancellationToken::new();
+            let stop = CancellationToken::new();
+            let start = Instant::now();
+            let writing = write_owned(
+                &mut writer,
+                &frame,
+                pending,
+                &|| true,
+                &physical,
+                None,
+                &stop,
+                start + Duration::from_secs(1),
+            );
+            tokio::pin!(writing);
+            tokio::select! { r=&mut writing=>panic!("metadata wait ended early: {r:?}"), _=tokio::time::sleep(Duration::from_millis(250))=>{} }
+            assert_eq!(polls.load(Ordering::Acquire), 0);
+            assert!(!p.live.load(Ordering::Acquire));
+            assert!(p.domain.try_write().is_ok());
+            if stall {
+                assert_eq!(writing.await, Err(DispatchError::SubmissionUnknown));
+                assert_eq!(receipt.await.unwrap(), Err(DtmfWriteError::OutcomeUnknown));
+                assert!(start.elapsed() >= Duration::from_millis(500));
+                assert!(dropped.load(Ordering::Acquire));
+                assert!(physical.is_cancelled());
+            } else {
+                assert_eq!(writing.await, Ok(()));
+                assert_eq!(receipt.await.unwrap(), Ok(()));
+                assert!(start.elapsed() >= Duration::from_millis(300));
+                assert!(!physical.is_cancelled());
+            }
+            assert!(start.elapsed() < Duration::from_secs(1));
+            assert!(!p.live.load(Ordering::Acquire));
+            assert!(p.domain.try_write().is_ok());
+        }
+    }
