+use super::*;
+fn clock() -> SourceClock {
+    let c = SourceClock::default();
+    c.bind(ClockTrack::Audio, 1, 48_000);
+    c.bind(ClockTrack::Video, 2, 90_000);
+    c
+}
+fn anchor(c: &SourceClock, ssrc: u32) -> Option<(u64, u32)> {
+    c.snapshot(ssrc)
+        .and_then(|s| s.anchor)
+        .map(|a| (a.ntp_time, a.rtp_time))
+}
+#[test]
+fn source_clock_initial_report_newest_preserves_original_receipt_and_shared_offset() {
+    let c = clock();
+    assert!(!c.sender_report(1, 100 << 32, 1, 1, 500 << 32));
+    assert!(!c.sender_report(1, 101 << 32, 2, 2, 503 << 32));
+    assert!(!c.sender_report(1, 100 << 32, 3, 1, 900 << 32));
+    assert!(!c.sender_report(1, 101 << 32, 4, 2, 901 << 32));
+    assert!(anchor(&c, 1).is_none());
+    c.cname(1, b"common");
+    assert_eq!(anchor(&c, 1), Some((503 << 32, 2)));
+    assert!(!c.sender_report(2, 101 << 32, 90_000, 1, 999 << 32));
+    c.cname(2, b"common");
+    assert_eq!(anchor(&c, 2), Some((503 << 32, 90_000)));
+    assert!(c.sender_report(1, 102 << 32, 48_002, 3, 1000 << 32));
+    c.cname(1, b"common");
+    assert_eq!(anchor(&c, 1), Some((504 << 32, 48_002)));
+}
+#[test]
+fn source_clock_initial_report_rejects_unknown_zero_and_invalid_cname() {
+    let c = clock();
+    assert!(!c.sender_report(999, 100 << 32, 1, 1, 500 << 32));
+    c.cname(999, b"common");
+    assert!(c.snapshot(999).is_none());
+    assert!(!c.sender_report(1, 0, 1, 1, 500 << 32));
+    assert!(!c.sender_report(1, 100 << 32, 1, 0, 500 << 32));
+    c.cname(1, b"common");
+    assert!(anchor(&c, 1).is_none());
+    assert!(!c.sender_report(2, 100 << 32, 2, 1, 500 << 32));
+    c.cname(2, b"");
+    c.cname(2, &[1; 256]);
+    assert!(anchor(&c, 2).is_none());
+    c.cname(2, b"common");
+    assert_eq!(anchor(&c, 2), Some((500 << 32, 2)));
+}
+#[test]
+fn source_clock_initial_report_zero_packet_wrap_requires_observed_media() {
+    let c = clock();
+    c.observe_rtp(1);
+    assert!(!c.sender_report(1, 100 << 32, 9, 0, 500 << 32));
+    c.cname(1, b"common");
+    assert_eq!(anchor(&c, 1), Some((500 << 32, 9)));
+}
+#[test]
+fn source_clock_initial_report_conflicting_first_cname_clears_both_pending_domains() {
+    let c = clock();
+    c.sender_report(1, 100 << 32, 1, 1, 500 << 32);
+    c.sender_report(2, 100 << 32, 2, 1, 500 << 32);
+    c.cname(1, b"A");
+    let old = c.snapshot(1).unwrap();
+    c.cname(2, b"B");
+    assert!(!(old.is_current)());
+    assert!(anchor(&c, 1).is_none() && anchor(&c, 2).is_none());
+    c.cname(1, b"B");
+    assert!(anchor(&c, 1).is_none() && anchor(&c, 2).is_none());
+    assert!(c.sender_report(2, 101 << 32, 3, 2, 600 << 32));
+    assert_eq!(anchor(&c, 2), Some((600 << 32, 3)));
+}
+#[test]
+fn source_clock_initial_report_changed_cname_discards_other_track_pending() {
+    let c = clock();
+    c.cname(1, b"A");
+    c.sender_report(2, 100 << 32, 2, 1, 500 << 32);
+    c.cname(1, b"B");
+    c.cname(2, b"B");
+    assert!(anchor(&c, 2).is_none());
+}
+#[test]
+fn source_clock_initial_report_same_identity_preserves_replacement_discards() {
+    let c = SourceClock::default();
+    let first: Arc<dyn Send + Sync> = Arc::new(());
+    let second: Arc<dyn Send + Sync> = Arc::new(());
+    c.bind_identity(ClockTrack::Audio, 1, 48000, &first);
+    c.sender_report(1, 100 << 32, 1, 1, 500 << 32);
+    c.bind_identity(ClockTrack::Audio, 1, 48000, &first);
+    c.cname(1, b"A");
+    assert_eq!(anchor(&c, 1), Some((500 << 32, 1)));
+    c.bind_identity(ClockTrack::Audio, 1, 48000, &second);
+    c.sender_report(1, 101 << 32, 2, 2, 501 << 32);
+    c.bind_identity(ClockTrack::Audio, 1, 48000, &first);
+    c.cname(1, b"A");
+    assert!(anchor(&c, 1).is_none());
+}
+#[test]
+fn source_clock_initial_report_dead_identity_lease_retirement_and_peer_retirement_discard() {
+    let c = SourceClock::default();
+    let id: Arc<dyn Send + Sync> = Arc::new(());
+    c.bind_identity(ClockTrack::Audio, 1, 48000, &id);
+    c.sender_report(1, 100 << 32, 1, 1, 500 << 32);
+    drop(id);
+    c.cname(1, b"A");
+    assert!(anchor(&c, 1).is_none());
+    c.bind(ClockTrack::Audio, 1, 48000);
+    let lease = c.lease(&[1]);
+    c.sender_report(1, 100 << 32, 2, 1, 500 << 32);
+    drop(lease);
+    c.bind(ClockTrack::Audio, 1, 48000);
+    c.cname(1, b"A");
+    assert!(anchor(&c, 1).is_none());
+    c.bind(ClockTrack::Audio, 1, 48000);
+    c.sender_report(1, 100 << 32, 3, 1, 500 << 32);
+    c.retire();
+    c.cname(1, b"A");
+    assert!(c.snapshot(1).is_none());
+    assert!(!c.sender_report(1, 101 << 32, 4, 1, 501 << 32));
+}
