+//! Actual UDP/SRTCP -> hop interceptors -> endpoint -> callback -> SourceClock.
+use super::*;
+use rtc::rtcp::{
+    Packet,
+    reception_report::ReceptionReport,
+    sender_report::SenderReport,
+    source_description::{
+        SdesType, SourceDescription, SourceDescriptionChunk, SourceDescriptionItem,
+    },
+};
+fn chunk(ssrc: u32, cname: &str) -> SourceDescriptionChunk {
+    SourceDescriptionChunk {
+        source: ssrc,
+        items: vec![SourceDescriptionItem {
+            sdes_type: SdesType::SdesCname,
+            text: cname.as_bytes().to_vec().into(),
+        }],
+    }
+}
+fn sr(ssrc: u32, ntp: u64, rtp: u32) -> Box<dyn Packet> {
+    Box::new(SenderReport {
+        ssrc,
+        ntp_time: ntp,
+        rtp_time: rtp,
+        packet_count: 1,
+        octet_count: 160,
+        // A foreign reception report must not override the source identity.
+        reports: vec![ReceptionReport {
+            ssrc: 0xdeadbeef,
+            ..Default::default()
+        }],
+        ..Default::default()
+    })
+}
+#[tokio::test]
+async fn source_clock_initial_report_real_srtcp_sr_before_sdes_activates_both_tracks() {
+    let mut config = WebRtcConfig::loopback();
+    config.require_vp8_audio_video_profile = true;
+    let a = RvoipPeerConnection::new(&config, PeerRole::Offerer)
+        .await
+        .unwrap();
+    let b = RvoipPeerConnection::new(&config, PeerRole::Answerer)
+        .await
+        .unwrap();
+    a.add_local_audio_track().await.unwrap();
+    a.add_local_video_track().await.unwrap();
+    let offer = a.create_offer_and_gather().await.unwrap();
+    let answer = b.accept_offer_and_gather(&offer).await.unwrap();
+    a.set_remote_answer(&answer).await.unwrap();
+    tokio::try_join!(
+        a.wait_connected(Duration::from_secs(3)),
+        b.wait_connected(Duration::from_secs(3))
+    )
+    .unwrap();
+    let (audio, video) =
+        RvoipPeerConnection::prime_remote_media(&a, &b, true, Duration::from_secs(3)).await;
+    let audio_ssrc = a.local_audio_ssrc().unwrap();
+    let video_ssrc = a.local_video_ssrc().unwrap();
+    let unknown = 0xfacebeef;
+    let ntp = 4_100_000_000u64 << 32;
+    let track = a.local_audio_track().unwrap();
+    b.source_clock.assert_initial_metadata(audio_ssrc);
+    b.source_clock.assert_initial_metadata(video_ssrc);
+    // Normal compound order: the known sender report precedes its CNAME.
+    // A distinct RTP anchor proves this exact report was consumed.
+    track
+        .write_rtcp(vec![
+            sr(audio_ssrc, ntp, 48_000),
+            sr(unknown, ntp, 77),
+            Box::new(SourceDescription {
+                chunks: vec![
+                    chunk(unknown, "unrelated"),
+                    chunk(audio_ssrc, "shared-clock"),
+                ],
+            }),
+        ])
+        .await
+        .unwrap();
+    let audio_anchor = tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            if let Some(c) = b.source_clock.snapshot(audio_ssrc) {
+                if c.anchor
+                    .is_some_and(|a| a.rtp_time == 48_000 && a.clock_rate == 48_000)
+                {
+                    break c;
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .ok();
+    // Arrival jitter for the other track must not re-anchor the common domain.
+    tokio::time::sleep(Duration::from_millis(40)).await;
+    track
+        .write_rtcp(vec![
+            sr(video_ssrc, ntp, 90_000),
+            Box::new(SourceDescription {
+                chunks: vec![
+                    chunk(unknown, "another-unrelated"),
+                    chunk(video_ssrc, "shared-clock"),
+                ],
+            }),
+        ])
+        .await
+        .unwrap();
+    let video_anchor = tokio::time::timeout(Duration::from_secs(2), async {
+        loop {
+            if let Some(c) = b.source_clock.snapshot(video_ssrc) {
+                if c.anchor
+                    .is_some_and(|a| a.rtp_time == 90_000 && a.clock_rate == 90_000)
+                {
+                    break c;
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .ok();
+    let unknown_bound = b.source_clock.snapshot(unknown).is_some();
+    let active = audio_anchor.as_ref().is_some_and(|c| (c.is_current)())
+        && video_anchor.as_ref().is_some_and(|c| (c.is_current)());
+    a.close().await.unwrap();
+    b.close().await.unwrap();
+    assert!(
+        audio.is_some() && video.is_some(),
+        "actual RTP must establish both negotiated source tracks"
+    );
+    assert!(
+        !unknown_bound,
+        "foreign RTCP source must not allocate a clock"
+    );
+    assert!(
+        active,
+        "authenticated source SR/SDES must reach the current clock callback"
+    );
+    let aa = audio_anchor.unwrap().anchor.unwrap();
+    let va = video_anchor.unwrap().anchor.unwrap();
+    assert_eq!((aa.clock_rate, aa.rtp_time), (48_000, 48_000));
+    assert_eq!((va.clock_rate, va.rtp_time), (90_000, 90_000));
+    assert_eq!(
+        aa.ntp_time, va.ntp_time,
+        "one fixed common offset despite later video SR arrival"
+    );
+}
