+    /// This grants no Core media permission or readiness. The staged adapter
+    /// must install exact-port cleanup first and retain every original write.
+    pub async fn core_audio_egress(
+        self: &Arc<Self>,
+        port: &rvoip_core::staged_streams::AdapterMediaPort,
+        deadline: std::time::Instant,
+    ) -> rvoip_core::staged_streams::ControlResult<crate::media::core_audio::CoreAudioEgress> {
+        use rvoip_core::staged_streams::StreamControlError as E;
+        let mapping = tokio::time::timeout_at(tokio::time::Instant::from_std(deadline), async {
+            if !self.connected_flag.load(Ordering::Acquire)
+                || self.failed_flag.load(Ordering::Acquire)
+                || !self.signaling_is_stable().await
+            {
+                return Err(E::NotReady);
+            }
+            let local = self.pc.local_description().await.ok_or(E::NotReady)?;
+            let remote = self.pc.remote_description().await.ok_or(E::NotReady)?;
+            for sdp in [&local.sdp, &remote.sdp] {
+                let parsed = sdp
+                    .parse::<rvoip_sip_core::types::sdp::SdpSession>()
+                    .map_err(|_| E::Unsupported)?;
+                if parsed
+                    .media_descriptions
+                    .iter()
+                    .filter(|m| m.media == "audio" && m.port != 0)
+                    .count()
+                    != 1
+                {
+                    return Err(E::Unsupported);
+                }
+            }
+            let (offer, answer) = match (local.sdp_type, remote.sdp_type) {
+                (RTCSdpType::Offer, RTCSdpType::Answer) => (&local.sdp, &remote.sdp),
+                (RTCSdpType::Answer, RTCSdpType::Offer) => (&remote.sdp, &local.sdp),
+                _ => return Err(E::NotReady),
+            };
+            let mapping = crate::sdp::negotiated_single_audio_payload(offer, answer)
+                .map_err(|_| E::Unsupported)?;
+            if !self.signaling_is_stable().await {
+                return Err(E::NotReady);
+            }
+            Ok(mapping)
+        })
+        .await
+        .map_err(|_| E::Deadline)??;
+        let rvoip_core::stream_lifecycle::MediaFormat::Encoded {
+            name,
+            clock_rate_hz,
+            channels,
+            ..
+        } = &port.binding().negotiated.format
