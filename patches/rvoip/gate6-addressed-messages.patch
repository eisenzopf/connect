+    /// Participant-scoped history/download projection. Metadata-only removes
+    /// bytes and attachment URLs before the result leaves the engine.
+    pub async fn message_for_participant(
+        &self,
+        id: MessageId,
+        participant: ParticipantId,
+        metadata_only: bool,
+    ) -> Result<Message> {
+        let mut message = self
+            .config
+            .message_store
+            .get(&id)
+            .await?
+            .ok_or_else(addressed_messages::denied)?;
+        if !self
+            .message_access(&message, &participant, MessageAccess::History)
+            .await?
+        {
+            return Err(addressed_messages::denied());
+        }
+        if let Some(reply) = &message.in_reply_to {
+            let visible = match self.config.message_store.get(reply).await? {
+                Some(original) => {
+                    self.message_access(&original, &participant, MessageAccess::History)
+                        .await?
+                }
+                None => false,
+            };
+            if !visible {
+                message.in_reply_to = None;
+            }
+        }
+        if metadata_only {
+            message.body = Bytes::new();
+            for attachment in &mut message.attachments {
+                attachment.url.clear();
+            }
+        }
+        Ok(message)
+    }
