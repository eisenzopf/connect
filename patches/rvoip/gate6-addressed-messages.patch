+    assert!(orch
+        .mark_message_read(id, participants[1].clone())
+        .await
+        .is_err());
+    let history = orch
+        .list_messages_for_participant(cid, participants[1].clone(), MessageFilter::default(), None)
+        .await
+        .unwrap();
+    assert!(history.messages.is_empty());
