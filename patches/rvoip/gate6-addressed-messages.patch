+        .await
+        .unwrap();
+    let receipts = policy.receipts.lock().unwrap();
+    let receipt = receipts.last().unwrap();
+    assert_eq!(receipt.stage, MessageDeliveryStage::Read);
+    assert!(!receipt.viewers.contains(&participants[2]));
+    drop(receipts);
+    policy
+        .revoked
+        .lock()
+        .unwrap()
