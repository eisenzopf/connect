+#[tokio::test]
+async fn gate6_one_many_all_dispatch_preserves_metadata_and_excludes_other_peers() {
+    let (orch, adapter, policy, cid, participants, connections) = addressed_fixture().await;
+    for count in [1, 2, 3] {
+        let mut message = msg(cid.clone(), "private typed body");
+        message.from_participant = participants[0].clone();
+        message.content_type = ContentType::Json;
+        message.attachments.push(Attachment {
+            url: "https://private.invalid/file".into(),
+            content_type: ContentType::Binary,
+            size_bytes: 37,
+        });
+        message.to = if count == 3 {
+            MessageRecipients::All
+        } else {
+            MessageRecipients::Participants(participants[..count].to_vec())
+        };
+        let mid = orch
+            .send_message_to_conversation(cid.clone(), message.clone())
+            .await
+            .unwrap();
+        let deliveries = std::mem::take(&mut *adapter.deliveries.lock().unwrap());
+        assert_eq!(deliveries.len(), count);
+        for (connection, copy) in deliveries {
+            assert!(connections[..count].contains(&connection));
+            assert_eq!(copy.id, mid);
+            assert_eq!(copy.body, message.body);
+            assert_eq!(copy.content_type, ContentType::Json);
+            assert_eq!(copy.attachments[0].url, message.attachments[0].url);
+            assert!(
+                matches!(copy.to, MessageRecipients::Participants(ref ids) if ids.len() == count)
+            );
+        }
+    }
+    for receipt in policy.receipts.lock().unwrap().iter() {
+        assert_eq!(receipt.stage, MessageDeliveryStage::Accepted);
+        assert!(receipt
+            .viewers
+            .iter()
+            .all(|id| id == &participants[0] || id == &receipt.participant_id));
+        assert!(receipt.connection_id.is_some());
+    }
+}
