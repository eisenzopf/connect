+//! Audience-preserving message admission, projections and adapter dispatch.
+//!
+//! The orchestrator is a trusted in-process API. Applications authenticate its
+//! callers and implement `MessagePolicy` against their current durable grants,
+//! membership epochs and retention rules. Transport fields are never authority.
+//! Raw MessageStore access and the orchestrator event bus are internal surfaces;
+//! public gateways must use the participant-scoped projections here.
+use crate::{
+    error::{Result, RvoipError},
+    ids::{ConnectionId, MessageId, ParticipantId},
+    message::{Message, MessageRecipients},
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MessageAccess {
+    Send,
+    Deliver,
+    History,
+    Receipt,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MessageDeliveryStage {
+    /// The adapter accepted the message. This does not assert remote delivery.
+    Accepted,
+    Failed,
+    Read,
+}
+
+/// Internal attributed observation. Route only to `viewers`, after checking
+/// current policy again. Neither adapter acceptance nor this fact means a human
+/// received/read the message. Provider-specific confirmations remain separate.
+#[derive(Clone)]
+pub struct MessageReceipt {
+    pub message_id: MessageId,
+    pub participant_id: ParticipantId,
+    pub connection_id: Option<ConnectionId>,
+    pub stage: MessageDeliveryStage,
+    pub viewers: Vec<ParticipantId>,
+}
+
+impl std::fmt::Debug for MessageReceipt {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("MessageReceipt")
+            .field("stage", &self.stage)
+            .field("viewer_count", &self.viewers.len())
+            .finish()
+    }
+}
+
+#[async_trait::async_trait]
+pub trait MessagePolicy: Send + Sync {
+    /// Additional application authority after intrinsic audience checks. Called
+    /// again for each dispatch/projection/receipt; failures are fail-closed.
+    /// Applications must bound this call and perform final external-dispatch
+    /// fencing in their adapter if revocation can race an external submission.
+    async fn authorize(
+        &self,
+        message: &Message,
+        participant: &ParticipantId,
+        access: MessageAccess,
+    ) -> Result<bool>;
+
+    /// Internal hook, never a broadcast to public peers. Implementations enqueue
+    /// only to currently authorized viewers and preserve bounded queues.
+    async fn observe_receipt(&self, _receipt: MessageReceipt) -> Result<()> {
+        Ok(())
+    }
+}
+
+/// No extra application restrictions; intrinsic audience/membership checks still
+/// apply. Public services must supply a policy that checks current credentials,
+/// membership epochs and content grants instead of treating IDs as credentials.
+pub struct IntrinsicMessagePolicy;
+#[async_trait::async_trait]
+impl MessagePolicy for IntrinsicMessagePolicy {
+    async fn authorize(&self, _: &Message, _: &ParticipantId, _: MessageAccess) -> Result<bool> {
+        Ok(true)
+    }
+}
+
+pub(crate) fn denied() -> RvoipError {
+    // The same failure for missing, inaccessible and cross-conversation data.
+    RvoipError::AdmissionRejected("message access denied".into())
+}
+
+pub(crate) fn addressed_to(message: &Message, participant: &ParticipantId) -> bool {
+    match &message.to {
+        MessageRecipients::Participants(ids) => ids.contains(participant),
+        // All must be resolved at admission. Never expand during history/replay.
+        MessageRecipients::All => false,
+    }
+}
+
+pub(crate) fn visible_to(message: &Message, participant: &ParticipantId) -> bool {
+    &message.from_participant == participant || addressed_to(message, participant)
+}
+
+/// Resolve all at acceptance and validate the complete set before any effect.
+/// An empty conversation may still retain an internal System message; explicit
+/// empty/unknown recipients are rejected, never interpreted as broadcast.
+pub(crate) fn freeze_audience(message: &mut Message, members: &[ParticipantId]) -> Result<()> {
+    let recipients = match &message.to {
+        MessageRecipients::All => members.to_vec(),
+        MessageRecipients::Participants(ids) => {
+            if ids.is_empty() || ids.len() > 256 || ids.iter().any(|id| !members.contains(id)) {
+                return Err(denied());
+            }
+            ids.clone()
+        }
+    };
+    let mut unique = Vec::with_capacity(recipients.len());
+    for id in recipients {
+        if !unique.contains(&id) {
+            unique.push(id);
+        }
+    }
+    if unique.len() > 256 {
+        return Err(denied());
+    }
+    message.to = MessageRecipients::Participants(unique);
+    Ok(())
+}
+
+/// Reply visibility alone is insufficient: its whole new audience must fit in
+/// the original sender+recipients. Explicit sharing belongs to the application.
+pub(crate) fn check_reply(message: &Message, original: &Message) -> Result<()> {
+    if message.conversation_id != original.conversation_id
+        || !visible_to(original, &message.from_participant)
+    {
+        return Err(denied());
+    }
+    let MessageRecipients::Participants(ids) = &message.to else {
+        return Err(denied());
+    };
+    if ids.iter().any(|id| !visible_to(original, id)) {
+        return Err(denied());
+    }
+    Ok(())
+}
