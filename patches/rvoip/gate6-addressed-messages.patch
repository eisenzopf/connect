+#[derive(Default)]
+struct AudiencePolicy {
+    revoked: Mutex<HashSet<ParticipantId>>,
+    receipts: Mutex<Vec<MessageReceipt>>,
+}
+#[async_trait::async_trait]
+impl MessagePolicy for AudiencePolicy {
+    async fn authorize(
+        &self,
+        _: &Message,
+        participant: &ParticipantId,
+        _: MessageAccess,
+    ) -> RvResult<bool> {
+        Ok(!self.revoked.lock().unwrap().contains(participant))
+    }
+    async fn observe_receipt(&self, receipt: MessageReceipt) -> RvResult<()> {
+        self.receipts.lock().unwrap().push(receipt);
+        Ok(())
+    }
+}
