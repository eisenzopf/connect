+//! Test-support-only synchronous wire identity. No payload, grant or owner is
+//! retained. This context never crosses await and cannot authorize admission.
+use super::*;
+use std::cell::RefCell;
+
+#[derive(Clone)]
+pub struct Owner(pub(super) Weak<()>);
+#[derive(Clone)]
+pub struct Frame {
+    pub(super) owner: Owner,
+    pub connection: ConnectionId,
+    pub stream_local_id: u16,
+    pub connection_generation: u64,
+    pub stream_generation: u64,
+    /// Outer native datagram sequence; distinct from inner RTP u16 sequence.
+    pub sequence: u32,
+    pub ssrc: u32,
+    pub timestamp: u32,
+}
+impl Frame {
+    pub fn matches(
+        &self, owner: &Owner, connection: &ConnectionId,
+        stream_local_id: u16, sequence: u32, ssrc: u32, timestamp: u32,
+    ) -> bool {
+        Weak::ptr_eq(&self.owner.0, &owner.0) && self.owner.0.strong_count() > 0
+            && &self.connection == connection && self.stream_local_id == stream_local_id
+            && self.sequence == sequence && self.ssrc == ssrc && self.timestamp == timestamp
+    }
+}
+thread_local! {
+    static CURRENT: RefCell<Option<Frame>> = const { RefCell::new(None) };
+}
+struct Restore(Option<Frame>);
+impl Drop for Restore {
+    fn drop(&mut self) { CURRENT.with(|current| *current.borrow_mut() = self.0.take()); }
+}
+pub(super) fn with_frame<T>(frame: Option<Frame>, body: impl FnOnce() -> T) -> T {
+    // Replacing with None is deliberate: unrelated nested original ingress
+    // cannot borrow the surrounding native frame's diagnostic identity.
+    let _restore = Restore(CURRENT.with(|current| current.replace(frame)));
+    body()
+}
+pub fn current() -> Option<Frame> { CURRENT.with(|current| current.borrow().clone()) }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn frame(owner: &Arc<()>, sequence: u32) -> Frame {
+        Frame { owner: Owner(Arc::downgrade(owner)),
+            connection: ConnectionId::from_string("native-exact-marker"),
+            stream_local_id: 7, connection_generation: 2, stream_generation: 3,
+            sequence, ssrc: 0x4736_8e01, timestamp: 123456 }
+    }
+    #[test]
+    fn native_marker_requires_exact_numbers_and_live_original_controller() {
+        let owner = Arc::new(());
+        let other = Arc::new(());
+        let expected = frame(&owner, 42);
+        let identity = expected.owner.clone();
+        let yes = |owner: &Owner, handle, sequence, ssrc, timestamp| {
+            expected.matches(owner, &expected.connection, handle, sequence, ssrc, timestamp)
+        };
+        assert!(yes(&identity, 7, 42, 0x4736_8e01, 123456));
+        assert!(!yes(&Owner(Arc::downgrade(&other)), 7, 42, 0x4736_8e01, 123456));
+        assert!(!yes(&identity, 8, 42, 0x4736_8e01, 123456));
+        assert!(!yes(&identity, 7, 41, 0x4736_8e01, 123456));
+        assert!(!yes(&identity, 7, 42, 0x4736_8002, 123456));
+        assert!(!yes(&identity, 7, 42, 0x4736_8e01, 123455));
+        drop(owner);
+        assert!(!yes(&identity, 7, 42, 0x4736_8e01, 123456));
+    }
+    #[test]
+    fn native_context_clears_nested_none_and_restores_after_panic() {
+        let owner = Arc::new(());
+        let outer = frame(&owner, 10);
+        let nested = frame(&owner, 11);
+        assert!(current().is_none());
+        with_frame(Some(outer), || {
+            assert_eq!(current().unwrap().sequence, 10);
+            with_frame(None, || assert!(current().is_none()));
+            assert_eq!(current().unwrap().sequence, 10);
+            let result = std::panic::catch_unwind(|| {
+                with_frame(Some(nested), || panic!("observation-only unwind"));
+            });
+            assert!(result.is_err());
+            assert_eq!(current().unwrap().sequence, 10);
+        });
+        assert!(current().is_none());
+    }
+}
