+#[cfg(test)]
+mod connect_bbr_regressions {
+    use super::*;
+    fn sample(
+        est: &mut BandwidthEstimation,
+        start: Instant,
+        tick: u64,
+        bytes: u64,
+        round: u64,
+        limited: bool,
+    ) {
+        let sent = start + Duration::from_millis(tick * 10);
+        est.on_sent(sent, bytes);
+        est.on_ack(
+            sent + Duration::from_millis(50),
+            sent,
+            bytes,
+            round,
+            limited,
+        );
+    }
+    #[test]
+    fn higher_app_limited_samples_establish_and_raise_bandwidth() {
+        let mut est = BandwidthEstimation::default();
+        let now = Instant::now();
+        sample(&mut est, now, 0, 1000, 0, true);
+        sample(&mut est, now, 1, 1000, 1, true);
+        assert_eq!(est.get_estimate(), 100_000);
+        sample(&mut est, now, 2, 2000, 2, true);
+        assert_eq!(est.get_estimate(), 200_000);
+    }
+    #[test]
+    fn lower_app_limited_sample_does_not_age_or_reduce_bandwidth() {
+        let mut est = BandwidthEstimation::default();
+        let now = Instant::now();
+        sample(&mut est, now, 0, 1000, 0, false);
+        sample(&mut est, now, 1, 1000, 1, false);
+        sample(&mut est, now, 2, 100, 100, true);
+        assert_eq!(est.get_estimate(), 100_000);
+    }
+    #[test]
+    fn lower_non_app_limited_samples_age_the_windowed_maximum() {
+        let mut est = BandwidthEstimation::default();
+        let now = Instant::now();
+        sample(&mut est, now, 0, 1000, 0, false);
+        sample(&mut est, now, 1, 1000, 1, false);
+        for round in 2..=12 {
+            sample(&mut est, now, round, 100, round, false);
+        }
+        assert_eq!(est.get_estimate(), 10_000);
+    }
+    #[test]
+    fn equal_app_limited_sample_refreshes_the_maximum_timestamp() {
+        let mut est = BandwidthEstimation::default();
+        let now = Instant::now();
+        sample(&mut est, now, 0, 1000, 0, false);
+        sample(&mut est, now, 1, 1000, 1, false);
+        sample(&mut est, now, 2, 1000, 9, true);
+        sample(&mut est, now, 3, 100, 12, false);
+        assert_eq!(est.get_estimate(), 100_000);
+        sample(&mut est, now, 4, 100, 20, false);
+        assert_eq!(est.get_estimate(), 10_000);
+    }
+}
