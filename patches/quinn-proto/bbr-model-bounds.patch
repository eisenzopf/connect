+#[cfg(test)]
+mod connect_bbr_regressions {
+    use super::*;
+    #[test]
+    fn startup_at_target_stops_ack_driven_cwnd_growth_after_initial_delivery() {
+        let mut bbr = Bbr::new(Arc::new(BbrConfig::default()), 1200);
+        bbr.acked_bytes = bbr.init_cwnd;
+        let initial = bbr.cwnd;
+        assert_eq!(initial, bbr.get_target_cwnd(bbr.cwnd_gain));
+        for _ in 0..1000 {
+            bbr.calculate_cwnd(1200, 0);
+        }
+        assert_eq!(
+            bbr.cwnd, initial,
+            "startup must compare current cwnd bytes with target bytes"
+        );
+    }
+    #[test]
+    fn startup_below_target_and_initial_delivery_still_allow_growth() {
+        let mut bbr = Bbr::new(Arc::new(BbrConfig::default()), 1200);
+        bbr.acked_bytes = bbr.init_cwnd;
+        bbr.cwnd = bbr.init_cwnd - 1200;
+        bbr.calculate_cwnd(1200, 0);
+        assert_eq!(bbr.cwnd, bbr.init_cwnd);
+        bbr.acked_bytes = bbr.init_cwnd - 1;
+        bbr.calculate_cwnd(1200, 0);
+        assert_eq!(bbr.cwnd, bbr.init_cwnd + 1200);
+        bbr.acked_bytes = bbr.init_cwnd;
+        bbr.calculate_cwnd(1200, 0);
+        assert_eq!(
+            bbr.cwnd,
+            bbr.init_cwnd + 1200,
+            "startup does not shrink an existing excess but must not keep growing it"
+        );
+    }
+    #[test]
+    fn full_pipe_cwnd_remains_bounded_by_current_target() {
+        let mut bbr = Bbr::new(Arc::new(BbrConfig::default()), 1200);
+        bbr.is_at_full_bandwidth = true;
+        bbr.cwnd = bbr.init_cwnd * 4;
+        bbr.calculate_cwnd(1200, 0);
+        assert_eq!(bbr.cwnd, bbr.get_target_cwnd(bbr.cwnd_gain));
+    }
+    #[test]
+    fn application_limited_delivery_establishes_positive_pacing() {
+        let mut bbr = Bbr::new(Arc::new(BbrConfig::default()), 1200);
+        let now = Instant::now();
+        for tick in 0..2 {
+            let sent = now + Duration::from_millis(tick * 10);
+            bbr.max_bandwidth.on_sent(sent, 1200);
+            bbr.max_bandwidth
+                .on_ack(sent + Duration::from_millis(50), sent, 1200, tick, true);
+        }
+        bbr.min_rtt = Duration::from_millis(50);
+        bbr.calculate_pacing_rate();
+        assert!(bbr.pacing_rate > 0);
+    }
+}
