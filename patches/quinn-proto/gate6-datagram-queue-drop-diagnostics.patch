+// Actual state destruction is the terminal observation. Missing summaries
+// (forced process exit, leaked state or incomplete capture) remain unknown.
+// Pending teardown queues are not overflow/loss verdicts.
+impl Drop for DatagramState {
+    fn drop(&mut self) {
+        let Some(connection_tag) = self.diagnostic_tag else { return; };
+        debug!(target: "quinn_proto::datagram_queue",
+            connection_tag,
+            server_side = self.diagnostic_server_side,
+            outgoing_overflow_packets = self.outgoing_overflow_packets,
+            outgoing_overflow_payload_bytes = self.outgoing_overflow_payload_bytes,
+            incoming_overflow_packets = self.incoming_overflow_packets,
+            incoming_overflow_payload_bytes = self.incoming_overflow_payload_bytes,
+            outgoing_mtu_packets = self.outgoing_mtu_packets,
+            outgoing_mtu_payload_bytes = self.outgoing_mtu_payload_bytes,
+            teardown_unsent_datagrams = self.outgoing.queue.len(),
+            teardown_unsent_payload_bytes = self.outgoing.payload_bytes,
+            teardown_unread_datagrams = self.incoming.queue.len(),
+            teardown_unread_payload_bytes = self.incoming.payload_bytes,
+            "QUIC datagram queue retired");
+    }
+}
