+    #[test]
+    fn terminal_summary_includes_zero_drops_and_distinct_pending_teardown_queues() {
+        use std::io::Write;
+        use std::sync::{Arc, Mutex};
+        #[derive(Clone)]
+        struct Log(Arc<Mutex<Vec<u8>>>);
+        impl Write for Log {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                self.0.lock().unwrap().extend_from_slice(bytes);
+                Ok(bytes.len())
+            }
+            fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
+        }
+        let bytes = Arc::new(Mutex::new(Vec::new()));
+        let output = bytes.clone();
+        let subscriber = tracing_subscriber::fmt()
+            .with_max_level(tracing::Level::DEBUG)
+            .with_ansi(false).without_time()
+            .with_writer(move || Log(output.clone())).finish();
+        tracing::subscriber::with_default(subscriber, || {
+            let mut state = DatagramState::new(crate::ConnectionId::new(b"fixture"), true);
+            state.outgoing.push_back(Datagram { data: Bytes::from_static(b"abc") });
+            state.incoming.push_back(Datagram { data: Bytes::from_static(b"de") });
+            // Moving queue items by the normal API remains legal with Drop.
+            let pending = state.outgoing.pop_front().unwrap();
+            state.outgoing.push_back(pending);
+        });
+        let log = String::from_utf8(bytes.lock().unwrap().clone()).unwrap();
+        assert_eq!(log.matches("QUIC datagram queue created").count(), 1);
+        assert_eq!(log.matches("QUIC datagram queue retired").count(), 1);
+        for field in ["outgoing_overflow_packets=0", "outgoing_overflow_payload_bytes=0",
+            "incoming_overflow_packets=0", "incoming_overflow_payload_bytes=0",
+            "outgoing_mtu_packets=0", "outgoing_mtu_payload_bytes=0",
+            "teardown_unsent_datagrams=1", "teardown_unsent_payload_bytes=3",
+            "teardown_unread_datagrams=1", "teardown_unread_payload_bytes=2"] {
+            assert!(log.contains(field), "missing terminal field {field}");
+        }
+        assert!(!log.contains("fixture"), "raw diagnostic CID leaked");
     }
