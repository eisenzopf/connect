+#[cfg(test)]
+mod connect_retransmission_tests {
+    use super::*;
+    use crate::cipher_suite::CipherSuiteId;
+    use crate::config::ConfigBuilder;
+    use std::time::Duration;
+
+    fn endpoint(client: bool, address: SocketAddr) -> Endpoint {
+        let config = Arc::new(ConfigBuilder::default()
+            .with_psk(Some(Arc::new(|_| Ok(vec![0xab, 0xc1, 0x23]))))
+            .with_psk_identity_hint(Some(b"local-regression".to_vec()))
+            .with_cipher_suites(vec![CipherSuiteId::Tls_Psk_With_Aes_128_Gcm_Sha256])
+            .with_flight_interval(Duration::from_millis(100))
+            .build(client, None).unwrap());
+        let mut endpoint = Endpoint::new(address, TransportProtocol::UDP,
+            if client { None } else { Some(config.clone()) });
+        if client {
+            endpoint.connect("127.0.0.1:42002".parse().unwrap(), config, None).unwrap();
+        }
+        endpoint
+    }
+
+    fn transfer(from: &mut Endpoint, to: &mut Endpoint, source: SocketAddr) -> usize {
+        let mut count = 0;
+        while let Some(packet) = from.poll_transmit() {
+            to.read(Instant::now(), source, None, packet.message).unwrap();
+            count += 1;
+        }
+        count
+    }
+
+    #[test]
+    fn lost_server_flight_duplicate_client_hello_retains_retransmission_and_completes() {
+        let client_addr: SocketAddr = "127.0.0.1:42001".parse().unwrap();
+        let server_addr: SocketAddr = "127.0.0.1:42002".parse().unwrap();
+        let mut client = endpoint(true, client_addr);
+        let mut server = endpoint(false, server_addr);
+        // Exchange initial ClientHello and HelloVerifyRequest, then the cookie ClientHello.
+        assert!(transfer(&mut client, &mut server, client_addr) > 0);
+        assert!(transfer(&mut server, &mut client, server_addr) > 0);
+        assert!(transfer(&mut client, &mut server, client_addr) > 0);
+        let original_deadline = server.connections[&client_addr].current_retransmit_timer
+            .expect("server response flight must arm retransmission");
+        let mut dropped = 0;
+        while server.poll_transmit().is_some() { dropped += 1; }
+        assert!(dropped > 0, "drop the real serialized server response flight");
+        // Fire the client's existing timer. New record sequence, same handshake flight.
+        let client_deadline = client.connections[&server_addr].current_retransmit_timer.unwrap();
+        client.handle_timeout(server_addr, client_deadline).unwrap();
+        assert!(transfer(&mut client, &mut server, client_addr) > 0);
+        assert_eq!(server.connections[&client_addr].current_retransmit_timer,
+            Some(original_deadline), "incomplete/old handshake input must not cancel the pending server flight");
+        // The unchanged timer retransmits without changing a timeout or retry limit.
+        server.handle_timeout(client_addr, original_deadline).unwrap();
+        assert!(transfer(&mut server, &mut client, server_addr) > 0);
+        for _ in 0..8 {
+            transfer(&mut client, &mut server, client_addr);
+            transfer(&mut server, &mut client, server_addr);
+            if client.connections[&server_addr].is_handshake_completed()
+                && server.connections[&client_addr].is_handshake_completed() { break; }
+        }
+        assert!(client.connections[&server_addr].is_handshake_completed());
+        assert!(server.connections[&client_addr].is_handshake_completed());
+        // Completion must establish useful keys, not merely a reported FSM state.
+        client.write(server_addr, b"after lost server flight").unwrap();
+        let packet = client.poll_transmit().expect("encrypted application record");
+        let events = server.read(Instant::now(), client_addr, None, packet.message).unwrap();
+        assert!(events.iter().any(|event| matches!(event, EndpointEvent::ApplicationData(bytes)
+            if bytes.as_ref() == b"after lost server flight")));
+    }
+
+    #[derive(Debug)]
+    struct ParseFailure { alert: bool, error: bool }
+
+    impl std::fmt::Display for ParseFailure {
+        fn fmt(&self, output: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            write!(output, "terminal parse regression")
+        }
+    }
+
+    impl crate::flight::Flight for ParseFailure {
+        fn parse(&self, _: &mut State, _: &crate::handshake::handshake_cache::HandshakeCache,
+            _: &HandshakeConfig) -> std::result::Result<Box<dyn crate::flight::Flight>,
+                (Option<crate::alert::Alert>, Option<Error>)> {
+            Err((self.alert.then_some(crate::alert::Alert {
+                alert_level: crate::alert::AlertLevel::Fatal,
+                alert_description: crate::alert::AlertDescription::HandshakeFailure,
+            }), self.error.then_some(Error::ErrInvalidFsmTransition)))
+        }
+
+        fn generate(&self, _: &mut State, _: &crate::handshake::handshake_cache::HandshakeCache,
+            _: &HandshakeConfig) -> std::result::Result<Vec<crate::flight::Packet>,
+                (Option<crate::alert::Alert>, Option<Error>)> {
+            panic!("terminal parse failure must not generate another flight")
+        }
+    }
+
+    #[test]
+    fn terminal_parse_alert_or_error_cancels_timer_without_key_completion() {
+        let client_addr: SocketAddr = "127.0.0.1:42001".parse().unwrap();
+        let server_addr: SocketAddr = "127.0.0.1:42002".parse().unwrap();
+        for (alert, error) in [(true, false), (false, true), (true, true)] {
+            let mut client = endpoint(true, client_addr);
+            while client.poll_transmit().is_some() {}
+            let connection = client.connections.get_mut(&server_addr).unwrap();
+            let original_deadline = connection.current_retransmit_timer.unwrap();
+            connection.current_flight = Box::new(ParseFailure { alert, error });
+            connection.handshake_rx = Some(());
+            assert_eq!(connection.handshake().is_err(), error);
+            assert!(connection.current_retransmit_timer.is_none());
+            assert!(!connection.is_handshake_completed());
+            assert!(connection.state.master_secret.is_empty());
+            // Consume any alert once; firing the old deadline must not resend it
+            // or resurrect the preceding handshake flight.
+            while connection.outgoing_raw_packet().is_some() {}
+            client.handle_timeout(server_addr, original_deadline).unwrap();
+            assert!(client.poll_transmit().is_none());
+            let connection = &client.connections[&server_addr];
+            assert!(connection.current_retransmit_timer.is_none());
+            assert!(!connection.is_handshake_completed());
+            assert!(connection.state.master_secret.is_empty());
+        }
+    }
+}
